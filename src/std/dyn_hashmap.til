mode lib

import("hashmap")
import("dyn_vec")

// DynHashMap preserves the current type-erased HashMap implementation while
// HashMap is migrated toward a templated, monomorphized API.
//
// Each entry's full 64-bit hash is stored (`hashes`), as in HashMap /
// HashSet / DynHashSet: rehash() re-links without hashing a single key
// again, find()/set() reject chain collisions with a U64 compare before
// the dynamic key_cmp call (an indirect call per comparison here, so the
// filter buys the most in this container), and stored_hash() hands back
// the map's own hash of a key.
DynHashMap := struct {
    keys : DynVec = DynVec.new(Dynamic)
    values : DynVec = DynVec.new(Dynamic)
    buckets : DynVec = DynVec.new(I64)  // bucket head entry index, -1 if empty
    nexts : DynVec = DynVec.new(I64)    // per-entry next-in-chain index, -1 if end
    hashes : DynVec = DynVec.new(U64)   // per-entry full hash, computed once at insert
    key_hash : TypeHashFn = default_type_hash
    key_cmp  : CmpFn      = default_cmp

namespace:
    mut hasher : HashFn = fnv1a

    new_type_names := func(key_type: Str, val_type: Str) returns DynHashMap {
        if key_type.is_empty() {
            panic("DynHashMap.new: key_type required")
        }
        if val_type.is_empty() {
            panic("DynHashMap.new: val_type required")
        }
        if dyn_has_method(key_type, "hash").not() {
            panic("DynHashMap.new: type ", key_type, " must implement hash")
        }
        if dyn_has_method(key_type, "cmp").not() {
            panic("DynHashMap.new: type ", key_type, " must implement cmp")
        }
        mut m := DynHashMap()
        m.keys = DynVec.new_type_name(key_type)
        m.values = DynVec.new_type_name(val_type)
        m.buckets = DynVec.new(I64)
        m.nexts = DynVec.new(I64)
        m.hashes = DynVec.new(U64)
        m.key_hash = dyn_fn(key_type, "hash")
        m.key_cmp  = dyn_fn(key_type, "cmp")
        // Buckets are seeded on the first insert, as in HashMap.new --
        // an unused table pays nothing for them (#323).
        return m
    }

    new := func(K: Type, V: Type) returns DynHashMap {
        key_type := dyn_type_to_str(K)
        val_type := dyn_type_to_str(V)
        return DynHashMap.new_type_names(key_type, val_type)
    }

    /// Create an empty DynHashMap pre-sized for ~n~ entries
    /// (HashMap.with_capacity's counterpart; the key/value types are
    /// runtime arguments here, as for ~new~). Sizes the dense
    /// keys/values/nexts arrays and grows the bucket array by doubling
    /// until ~n~ fits under the 0.75 load factor, so inserting up to ~n~
    /// never rehashes.
    with_capacity := func(K: Type, V: Type, n: USize) returns DynHashMap {
        mut m := DynHashMap.new(K, V)
        if n == 0 { return m }
        mut nb : USize = HASHMAP_INIT_BUCKETS
        while n * 4 > nb * 3 { nb = nb * 2 }
        m.keys.data = realloc(own m.keys.data, n.mul(m.keys.elem_size))
        m.keys.cap = n
        m.values.data = realloc(own m.values.data, n.mul(m.values.elem_size))
        m.values.cap = n
        m.nexts.data = realloc(own m.nexts.data, n.mul(m.nexts.elem_size))
        m.nexts.cap = n
        m.hashes.data = realloc(own m.hashes.data, n.mul(m.hashes.elem_size))
        m.hashes.cap = n
        for _ in 0..nb {
            m.buckets.push(own -1)
        }
        return m
    }

    len := func(self: DynHashMap) returns USize { return self.keys.count }

    /// Drop all live keys and values but keep the allocated storage and
    /// type metadata so the table can be reused (DynMap.clear's
    /// counterpart). The bucket array is reset to empty, not freed.
    clear := func(mut self: DynHashMap) {
        DynVec.clear(self.keys)
        DynVec.clear(self.values)
        DynVec.clear(self.nexts)
        DynVec.clear(self.hashes)
        for i in 0..self.buckets.count {
            self.buckets.unsafe_set(i, own -1)
        }
    }

    /// Deep copy. Cloning the dense keys/values/nexts vecs and the
    /// bucket array preserves every chain link, so the copy needs no
    /// rehash (DynMap.clone's counterpart).
    clone := func(self: DynHashMap) returns DynHashMap {
        mut m := DynHashMap()
        m.keys = DynVec.clone(self.keys)
        m.values = DynVec.clone(self.values)
        m.buckets = DynVec.clone(self.buckets)
        m.nexts = DynVec.clone(self.nexts)
        m.hashes = DynVec.clone(self.hashes)
        m.key_hash = self.key_hash
        m.key_cmp = self.key_cmp
        return m
    }

    hash_key := func(self: DynHashMap, key: Dynamic) returns U64 {
        return self.key_hash(key, DynHashMap.hasher)
    }

    keys_equal := func(self: DynHashMap, a: Dynamic, b: Dynamic) returns Bool {
        return self.key_cmp(a, b) == 0
    }

    find := func(self: DynHashMap, key: Dynamic) returns I64 {
        if self.keys.count == 0 { return -1 }
        h := self.hash_key(to_ptr(key))
        bi := bucket(h, self.buckets.count)
        ref head : I64 = self.buckets.unsafe_get(bi)
        mut entry : I64 = head.clone()
        while entry >= 0 {
            entry_u : USize = entry.to_usize()
            // Stored-hash pre-filter: a chain neighbor with a different
            // full hash cannot be this key, so skip the indirect key_cmp.
            ref eh : U64 = self.hashes.unsafe_get(entry_u)
            if eh == h {
                ref k : Dynamic = self.keys.unsafe_get(entry_u)
                if self.keys_equal(to_ptr(key), to_ptr(k)) { return entry }
            }
            ref nxt : I64 = self.nexts.unsafe_get(entry_u)
            entry = nxt.clone()
        }
        return -1
    }

    has := func(self: DynHashMap, key: Dynamic) returns Bool {
        return self.find(key) >= 0
    }

    /// Return a ref to the value for ~key~. Throws KeyNotFound if
    /// ~key~ is absent; call as ~map.get(k)!~ to panic on a missing
    /// key. Same contract as DynMap.get.
    get := func(self: DynHashMap, key: Dynamic) returns ref Dynamic throws KeyNotFound {
        idx := self.find(key)
        if idx < 0 { throw KeyNotFound() }
        return self.values.unsafe_get(idx.to_usize())
    }

    /// The map's own stored hash of ~key~ -- the exact value hash_key
    /// computed when the entry was inserted, retrieved rather than
    /// recomputed. Throws KeyNotFound if ~key~ is absent.
    stored_hash := func(self: DynHashMap, key: Dynamic) returns U64 throws KeyNotFound {
        idx := self.find(key)
        if idx < 0 { throw KeyNotFound() }
        ref h : U64 = self.hashes.unsafe_get(idx.to_usize())
        return h.clone()
    }

    set := func(mut self: DynHashMap, key: Dynamic, own val: Dynamic) {
        // Seed the bucket array on first insert (see new_type_names).
        // bucket() takes a modulo, so this precedes any bucket index.
        if self.buckets.count == 0 {
            for _ in 0..HASHMAP_INIT_BUCKETS {
                self.buckets.push(own -1)
            }
        }
        h := self.hash_key(to_ptr(key))
        bi := bucket(h, self.buckets.count)
        ref head : I64 = self.buckets.unsafe_get(bi)
        mut entry : I64 = head.clone()
        mut existing : I64 = -1
        while entry >= 0 {
            entry_u : USize = entry.to_usize()
            ref eh : U64 = self.hashes.unsafe_get(entry_u)
            if eh == h {
                ref k : Dynamic = self.keys.unsafe_get(entry_u)
                if self.keys_equal(to_ptr(key), to_ptr(k)) {
                    existing = entry.clone()
                    break
                }
            }
            ref nxt : I64 = self.nexts.unsafe_get(entry_u)
            entry = nxt.clone()
        }
        if existing >= 0 {
            slot_idx : USize = existing.to_usize()
            self.values.unsafe_set(slot_idx, own val)
        } else {
            new_idx : I64 = self.keys.count.to_i64()
            ref head2 : I64 = self.buckets.unsafe_get(bi)
            head_val : I64 = head2.clone()
            self.nexts.push(own head_val)
            self.hashes.push(own h.clone())
            cloned_key : U8 = malloc(self.keys.elem_size)
            if self.keys.elem_kind == ELEM_BOXED {
                key_copy : Dynamic = self.keys.elem_clone(key)
                memcpy(cloned_key, key_copy, self.keys.elem_size)
                free(own key_copy)
            } else {
                memcpy(cloned_key, key, self.keys.elem_size)
            }
            self.keys.push(own cloned_key)
            self.values.push(own val)
            self.buckets.unsafe_set(bi, own new_idx)
            if self.keys.count * 4 > self.buckets.count * 3 {
                self.rehash()
            }
        }
    }

    rehash := func(mut self: DynHashMap) {
        new_count : USize = self.buckets.count * 2
        for i in 0..self.buckets.count {
            self.buckets.unsafe_set(i, own -1)
        }
        while self.buckets.count < new_count {
            self.buckets.push(own -1)
        }
        // The stored hash makes this pure pointer surgery: no key is
        // re-hashed, which for a type-erased map also means no indirect
        // hash call per entry.
        for i in 0..self.keys.count {
            ref eh : U64 = self.hashes.unsafe_get(i)
            bi := bucket(eh.clone(), self.buckets.count)
            ref head : I64 = self.buckets.unsafe_get(bi)
            head_val : I64 = head.clone()
            self.nexts.unsafe_set(i, own head_val)
            self.buckets.unsafe_set(bi, own i.to_i64())
        }
    }

    delete := func(own self: DynHashMap, call_free: Bool = true) {
        DynVec.delete(own self.keys, false)
        DynVec.delete(own self.values, false)
        DynVec.delete(own self.buckets, false)
        DynVec.delete(own self.nexts, false)
        DynVec.delete(own self.hashes, false)
        if call_free { free(own self) }
    }

    /// Remove ~key~, dropping its key and value. Returns false if
    /// absent (same contract as DynMap.remove / core Map.remove).
    remove := func(mut self: DynHashMap, key: Dynamic) returns Bool {
        if self.keys.count == 0 { return false }
        h := self.hash_key(key)
        bi := bucket(h, self.buckets.count)

        ref head : I64 = self.buckets.unsafe_get(bi)
        mut prev : I64 = -1
        mut entry : I64 = head.clone()
        mut found := false
        while entry >= 0 {
            entry_u : USize = entry.to_usize()
            ref eh : U64 = self.hashes.unsafe_get(entry_u)
            if eh == h {
                ref k : Dynamic = self.keys.unsafe_get(entry_u)
                if self.keys_equal(key, k) {
                    found = true
                    break
                }
            }
            prev = entry.clone()
            ref nxt : I64 = self.nexts.unsafe_get(entry_u)
            entry = nxt.clone()
        }
        if found.not() { return false }

        idx_u : USize = entry.to_usize()
        keys_off : USize = idx_u * self.keys.elem_size
        values_off : USize = idx_u * self.values.elem_size

        self.keys.elem_delete(ptr_add(self.keys.data, keys_off), false)
        if self.values.elem_kind == ELEM_FN {
            til_closure_slot_delete(ptr_add(self.values.data, values_off))
        } else if self.values.elem_kind == ELEM_BOXED {
            self.values.elem_delete(ptr_add(self.values.data, values_off), false)
        }

        ref nxt_of_idx : I64 = self.nexts.unsafe_get(idx_u)
        nxt_val : I64 = nxt_of_idx.clone()
        if prev < 0 {
            self.buckets.unsafe_set(bi, own nxt_val)
        } else {
            self.nexts.unsafe_set(prev.to_usize(), own nxt_val)
        }

        last_idx : I64 = self.keys.count.to_i64() - 1
        if entry.eq(last_idx).not() {
            last_u : USize = last_idx.to_usize()
            ref last_h : U64 = self.hashes.unsafe_get(last_u)
            last_bi := bucket(last_h.clone(), self.buckets.count)
            ref last_head : I64 = self.buckets.unsafe_get(last_bi)
            if last_head == last_idx {
                self.buckets.unsafe_set(last_bi, own entry.clone())
            } else {
                mut walker : I64 = last_head.clone()
                while walker >= 0 {
                    walker_u : USize = walker.to_usize()
                    ref walker_nxt : I64 = self.nexts.unsafe_get(walker_u)
                    if walker_nxt == last_idx {
                        self.nexts.unsafe_set(walker_u, own entry.clone())
                        break
                    }
                    walker = walker_nxt.clone()
                }
            }

            last_keys_off : USize = last_u * self.keys.elem_size
            last_values_off : USize = last_u * self.values.elem_size
            memcpy(ptr_add(self.keys.data, keys_off),
                   ptr_add(self.keys.data, last_keys_off), self.keys.elem_size)
            memcpy(ptr_add(self.values.data, values_off),
                   ptr_add(self.values.data, last_values_off), self.values.elem_size)
            ref last_nxt : I64 = self.nexts.unsafe_get(last_u)
            self.nexts.unsafe_set(idx_u, own last_nxt.clone())
            ref last_hh : U64 = self.hashes.unsafe_get(last_u)
            self.hashes.unsafe_set(idx_u, own last_hh.clone())
        }

        self.keys.count = self.keys.count - 1
        self.values.count = self.values.count - 1
        self.nexts.count = self.nexts.count - 1
        self.hashes.count = self.hashes.count - 1
        return true
    }
}
