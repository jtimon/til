mode lib

// File handle I/O, moved out of core (issue #216's structural principle:
// host-facing side-effect surfaces live in std, NOT core, so a restricted
// mode like safe_script can ban the whole subtree by refusing the import).
// The print/stdin primitives stay in src/core/io.til because core's panic
// depends on them and the compiler knows their names.

// Every primitive that touches the file system is an ext_proc, per the
// doc/ffi.org audit rule ("does the C function read or modify global
// state ... file system? then ext_proc"): opening creates/truncates,
// reading observes bytes that change between compile time and run time
// and advances the handle's cursor, and telling observes that cursor.
// ext_func would mark them foldable, so a constant-argument call could
// be evaluated by the constfolder and its result baked into the binary.
cfile_open := ext_proc(path: Str, shallow is_write: Bool) returns ref Dynamic {}
cfile_open_update := ext_proc(path: Str) returns ref Dynamic {}
cfile_open_append := ext_proc(path: Str) returns ref Dynamic {}
cfile_exists := ext_proc(path: Str) returns shallow Bool {}
// The one exception: declared ext_func (not ext_proc) so File.delete --
// which the garbager inserts into arbitrary func bodies -- can release
// the handle. Same rationale as `free` being an ext_func despite
// freeing memory. Folding it would need a compile-time handle, and a
// handle can only come from cfile_open, which no longer folds.
cfile_close := ext_func(handle: Dynamic) {}
cfile_write_str := ext_proc(handle: Dynamic, s: Str) {}
cfile_read_all := ext_proc(handle: Dynamic) returns Str {}
cfile_tell := ext_proc(handle: Dynamic) returns shallow I64 {}
cfile_seek := ext_proc(handle: Dynamic, shallow pos: I64) {}
cfile_seek_cur := ext_proc(handle: Dynamic, shallow delta: I64) {}
cfile_seek_end := ext_proc(handle: Dynamic, shallow delta: I64) {}
cfile_read_n := ext_proc(handle: Dynamic, shallow count: I64) returns Str {}
// Removing a directory entry: a file-system write like any other. Named
// for the cfile_* family rather than for the unlink(2) syscall it calls
// (rm removes a file the same way; "unlink" is just what the syscall has
// been called since early Unix). Files only -- unlink refuses
// directories, unlike C's remove(3).
cfile_remove := ext_proc(path: Str) {}

// Directory reading and the whole-tree operations a build program needs
// (issue #345). cdir_* is a handle iterator like cfile_*: cdir_next
// answers "" once the directory is exhausted and never reports "." or
// "..". The rest are one-shot: what a path IS, removing a tree, and
// replacing one path with another.
cdir_open := ext_proc(path: Str) returns ref Dynamic {}
cdir_next := ext_proc(handle: Dynamic) returns Str {}
cdir_close := ext_func(handle: Dynamic) {}
cpath_is_dir := ext_proc(path: Str) returns shallow Bool {}
cpath_is_file := ext_proc(path: Str) returns shallow Bool {}
cremove_tree := ext_proc(path: Str) returns shallow I32 {}
crename_path := ext_proc(src: Str, dst: Str) returns shallow I32 {}

/// File handle for reading or writing on disk.
File := struct {
    // No default: a File without a live handle is not a state (#321);
    // cfile_open exit(1)s on failure, so every constructor site has one.
    ref handle : U8
    is_write := false
    // Opened for in-place update ("r+b"): both reads and writes are
    // allowed and the cursor can be moved with `seek`.
    is_update := false

namespace:
    /// Read the entire file at ~path~ into a Str. Exits with an error if
    /// the file cannot be opened.
    readfile := proc(path: Str) returns Str {
        f := File.new(path, false)
        return f.read_all()
    }

    /// Write ~content~ to the file at ~path~, replacing any previous
    /// contents. Exits with an error if the file cannot be opened.
    writefile := proc(path: Str, content: Str) {
        f := File.new(path, true)
        f.write(content)
    }

    /// Append ~content~ to the file at ~path~, keeping what is already
    /// there. The file is created when it does not exist.
    appendfile := proc(path: Str, content: Str) {
        f := File.append(path)
        f.write(content)
    }

    /// Delete the file at ~path~, like ~rm~. Removing a file the process
    /// still has open is allowed on POSIX (the handle keeps working until
    /// it is closed); a missing path is not an error. Directories are
    /// not removed -- pointing this at one is an error.
    remove := proc(path: Str) {
        cfile_remove(path)
    }

    /// True when ~path~ names an existing directory entry. A directory,
    /// or a file the process has no permission to read, still exists.
    exists := proc(path: Str) returns Bool {
        return cfile_exists(path)
    }

    /// True when ~path~ names a directory. False for a regular file, and
    /// false for a path that does not exist -- "is a directory" is one
    /// question, "exists" is another, and ~File.exists~ answers that one.
    is_dir := proc(path: Str) returns Bool {
        return cpath_is_dir(path)
    }

    /// True when ~path~ names a regular file -- not a directory, and not
    /// a device, fifo or socket either.
    is_file := proc(path: Str) returns Bool {
        return cpath_is_file(path)
    }

    /// True when ~path~ is ROOTED -- one that must be used as it stands
    /// rather than joined to a base directory. POSIX spells that with a
    /// leading "/", Windows with a drive-letter root (~D:/...~ or
    /// ~D:\...~). A bare ~D:~ is the process's current directory on that
    /// drive, so it is relative and the separator is required.
    ///
    /// Unlike its neighbours this asks about the STRING, hence ~func~: it
    /// never touches the file system, and says nothing about whether the
    /// path exists.
    ///
    /// Issue #347: this used to be a private ~starts_with("/")~ in the
    /// loader, which no windows absolute path satisfies -- so every one of
    /// them read as relative and got a base directory glued in front.
    /// ~til.exe repl~ could not start at all, because the REPL is the only
    /// thing that injects an ABSOLUTE import. ext.c's ~mkdir_p_cstr~ had
    /// known about drive letters all along.
    is_absolute := func(path: Str) returns Bool {
        if path.starts_with("/") { return true }
        if path.len() < 3 { return false }
        if path.get(1).neq(':') { return false }
        if path.get(2).neq('/').and(path.get(2).neq('\\')) { return false }
        ref c : I8 = path.get(0)
        if c.gte('A').and(c.lte('Z')) { return true }
        return c.gte('a').and(c.lte('z'))
    }

    /// Remove ~path~ and everything under it, like ~rm -rf~: a file, or a
    /// directory with its whole subtree. A path that does not exist is
    /// already removed and reports success; a symlink is unlinked, never
    /// followed. Any other failure is fatal.
    remove_tree := proc(path: Str) {
        if cremove_tree(path) != 0 {
            panic("File.remove_tree: could not remove '", path, "'")
        }
    }

    /// Move ~src~ onto ~dst~, replacing whatever ~dst~ was. On POSIX the
    /// replacement is atomic, which is what makes it safe to build a new
    /// executable beside the running one and swap it in. Fatal on
    /// failure -- notably when the two paths are on different file
    /// systems, where a rename cannot happen and a copy is the answer.
    rename := proc(src: Str, dst: Str) {
        if crename_path(src, dst) != 0 {
            panic("File.rename: could not move '", src, "' to '", dst, "'")
        }
    }

    /// Open a file at ~path~ for reading or writing.
    new := proc(path: Str, is_write: Bool) returns File {
        ref h : Dynamic = cfile_open(path, is_write)
        return File(handle = h, is_write = is_write)
    }

    /// Open a file at ~path~ for in-place update: reads and writes are
    /// both allowed and the cursor can be moved with ~seek~, so small
    /// regions can be patched without rewriting the whole file. The file
    /// must already exist.
    update := proc(path: Str) returns File {
        ref h : Dynamic = cfile_open_update(path)
        return File(handle = h, is_update = true)
    }

    /// Open a file at ~path~ for appending: writes always land at the end
    /// and existing contents are kept, where ~File.new(path, true)~
    /// truncates. The file is created when it does not exist. Reads are
    /// rejected, and ~seek~ does not move where a write lands -- "ab"
    /// appends regardless of the cursor.
    append := proc(path: Str) returns File {
        ref h : Dynamic = cfile_open_append(path)
        return File(handle = h, is_write = true)
    }

    /// Write a string to the file and return ~self~ so writes chain via
    /// UFCS: ~f.write("a").write("b").write("c")~. Panics unless opened
    /// for writing or update.
    write := proc(self: File, s: Str) returns ref File {
        if self.is_write.or(self.is_update).not() {
            panic("File.write: file not opened for writing")
        }
        cfile_write_str(self.handle, s)
        return self
    }

    /// Read the entire file contents into a Str. Panics if opened
    /// write-only.
    read_all := proc(self: File) returns Str {
        if self.is_write {
            panic("File.read_all: file opened for writing")
        }
        return cfile_read_all(self.handle)
    }

    /// Read up to ~count~ bytes starting at the current cursor position
    /// and advance the cursor. The result is shorter than ~count~ near
    /// end-of-file. Panics if opened write-only.
    read := proc(self: File, count: I64) returns Str {
        if self.is_write {
            panic("File.read: file opened for writing")
        }
        return cfile_read_n(self.handle, count)
    }

    /// Return the current cursor position as a byte offset from the start
    /// of the file.
    tell := proc(self: File) returns I64 {
        return cfile_tell(self.handle)
    }

    /// Move the cursor to an absolute byte offset from the start of the
    /// file. Returns ~self~ so calls chain via UFCS.
    seek := proc(self: File, pos: I64) returns ref File {
        cfile_seek(self.handle, pos)
        return self
    }

    /// Move the cursor by ~delta~ bytes relative to its current position
    /// (~delta~ may be negative). Returns ~self~ so calls chain via UFCS.
    seek_cur := proc(self: File, delta: I64) returns ref File {
        cfile_seek_cur(self.handle, delta)
        return self
    }

    /// Move the cursor to ~delta~ bytes relative to the end of the file
    /// (~delta~ is typically <= 0). ~f.seek_end(0)~ followed by ~f.tell()~
    /// yields the file size. Returns ~self~ so calls chain via UFCS.
    seek_end := proc(self: File, delta: I64) returns ref File {
        cfile_seek_end(self.handle, delta)
        return self
    }

    /// Close the underlying file handle. Private: invoked only from
    /// ~delete~, which the garbager inserts after a File local's last
    /// use, so nothing reads the handle afterwards.
    priv close := func(self: File) {
        cfile_close(self.handle)
    }

    /// Release the File: close the handle, then free the struct shell
    /// unless the caller still owns it (~call_free = false~ for a
    /// stack/value local). The garbager inserts this call right after the
    /// File's last use.
    delete := func(own self: File, call_free: Bool = true) {
        File.close(self)
        if call_free { free(own self) }
    }

    fwrite := proc(self: File, parts: ..Str) returns ref File {
        return self.write(format(..parts))
    }
}

/// A directory being read, entry by entry.
Dir := struct {
    // Same shape as File: the handle is a live C-side iterator (a DIR*
    // on POSIX, a find handle on Windows), so a Dir without one is not
    // a state -- cdir_open exits when the directory cannot be read.
    ref handle : U8

namespace:
    /// Start reading the directory at ~path~. Exits with an error if it
    /// cannot be opened.
    open := proc(path: Str) returns Dir {
        ref h : Dynamic = cdir_open(path)
        return Dir(handle = h)
    }

    /// The next entry's name (not its path), "" once every entry has
    /// been reported. "." and ".." are never returned. The order is
    /// whatever the file system gives -- sort if you need a stable one.
    next := proc(self: Dir) returns Str {
        return cdir_next(self.handle)
    }

    /// Every entry in the directory at ~path~, in file-system order.
    /// The whole listing at once, for callers that want to sort or
    /// filter it rather than stream it.
    list := proc(path: Str) returns Vec(Str) {
        mut names := Vec(Str).new()
        d := Dir.open(path)
        while true {
            name := d.next()
            if name.is_empty() { break }
            names.push(own name)
        }
        return names
    }

    /// Close the underlying handle. Private: invoked only from ~delete~,
    /// which the garbager inserts after a Dir local's last use.
    priv close := func(self: Dir) {
        cdir_close(self.handle)
    }

    /// Release the Dir: close the handle, then free the struct shell
    /// unless the caller still owns it.
    delete := func(own self: Dir, call_free: Bool = true) {
        Dir.close(self)
        if call_free { free(own self) }
    }
}
