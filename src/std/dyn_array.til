mode lib

import("dyn_vec")

/// Fixed-capacity array of typed elements.
DynArray := struct {
    own data : U8 = 0
    const cap : USize = 0
    const elem_size : USize = 0
    const elem_kind : USize = ELEM_POD
    const elem_clone : CloneFn = default_clone
    const elem_delete : DeleteFn = default_delete

namespace:
    priv new_type_name_kind := func(elem_type: Str, elem_kind: USize, cap: USize) returns DynArray {
        if elem_kind == ELEM_FN {
            return DynArray(data = calloc(cap, 8), cap = cap,
                         elem_size = 8, elem_kind = ELEM_FN)
        }
        elem_size : USize = dyn_size_of(elem_type)
        if elem_kind == ELEM_POD {
            return DynArray(data = calloc(cap, elem_size), cap = cap,
                         elem_size = elem_size, elem_kind = ELEM_POD)
        }
        return DynArray(data = calloc(cap, elem_size), cap = cap,
                     elem_size = elem_size, elem_kind = ELEM_BOXED,
                     elem_clone = dyn_fn(elem_type, "clone"),
                     elem_delete = dyn_fn(elem_type, "delete"))
    }

    /// Create a zero-initialized DynArray with the given element type and capacity.
    new_type_name := func(elem_type: Str, cap: USize) returns DynArray {
        if elem_type.is_empty() { panic("DynArray.new: elem_type required") }
        return DynArray.new_type_name_kind(elem_type, type_name_storage_kind(elem_type), cap)
    }

    new := func(T: Type, cap: USize) returns DynArray {
        elem_type := dyn_type_to_str(T)
        return DynArray.new_type_name_kind(elem_type, type_storage_kind(T), cap)
    }

    len := func(self: DynArray) returns USize { return self.cap }

    /// Unchecked ref to the element at index ~i~. Caller guarantees
    /// ~i < self.cap~; the unchecked core that ~get~ wraps (issue #284).
    unsafe_get := func(self: DynArray, i: USize) returns ref Dynamic {
        return ptr_add(self.data, i.mul(self.elem_size))
    }

    /// Ref to the element at index ~i~. Throws OutOfBounds if ~i~ is
    /// past the end; call as ~arr.get(i)!~ to panic on a bad index.
    get := func(self: DynArray, i: USize) returns ref Dynamic throws OutOfBounds {
        if i >= self.cap {
            throw OutOfBounds()
        }
        return self.unsafe_get(i)
    }

    /// Overwrite the element at index ~i~ without a bounds check, dropping
    /// the old value. Caller guarantees ~i < self.cap~; the write-side
    /// mirror of unsafe_get (issue #284).
    unsafe_set := func(mut self: DynArray, i: USize, own val: Dynamic) {
        if self.elem_kind == ELEM_BOXED {
            self.elem_delete(self.unsafe_get(i), false)
        } else if self.elem_kind == ELEM_FN {
            til_closure_slot_delete(self.unsafe_get(i))
            til_closure_slot_take(self.unsafe_get(i), val)
            return
        }
        memcpy(self.unsafe_get(i), val, self.elem_size)
        free(own val)
    }

    /// Overwrite the element at index ~i~. Drops the old value. ~val~ is
    /// owned. Throws OutOfBounds if ~i~ is past the end; call as
    /// ~dynarr[i] = val~ (or ~dynarr.set(i, own val)!~) to panic on a bad index.
    set := func(mut self: DynArray, i: USize, own val: Dynamic) throws OutOfBounds {
        if i >= self.cap {
            // val is not stored on the error path: drop its content and box.
            // (if/else so the owned `val` is consumed on exactly one path.)
            if self.elem_kind == ELEM_BOXED {
                self.elem_delete(val, false)
                free(own val)
            } else if self.elem_kind == ELEM_FN {
                til_closure_delete(val)
            } else {
                free(own val)
            }
            throw OutOfBounds()
        } else {
            self.unsafe_set(i, own val)
        }
    }

    delete := func(own self: DynArray, call_free: Bool = true) {
        if self.elem_kind == ELEM_BOXED {
            for i in 0..self.cap {
                self.elem_delete(ptr_add(self.data, i.mul(self.elem_size)), false)
            }
        } else if self.elem_kind == ELEM_FN {
            for i in 0..self.cap {
                til_closure_slot_delete(ptr_add(self.data, i.mul(self.elem_size)))
            }
        }
        free(own self.data)
        if call_free { free(own self) }
    }

    /// Clone every element of ~self~ into ~dst~ starting at element index
    /// ~dst_index~. ~dst~ must have room for self.cap elements from there.
    priv clone_into := func(self: DynArray, dst: Dynamic, dst_index: USize) {
        base := dst_index.mul(self.elem_size)
        if self.elem_kind == ELEM_POD {
            memcpy(ptr_add(dst, base), self.data, self.cap.mul(self.elem_size))
            return
        }
        for i in 0..self.cap {
            off := base.add(i.mul(self.elem_size))
            if self.elem_kind == ELEM_BOXED {
                cloned : Dynamic = self.elem_clone(ptr_add(self.data, i.mul(self.elem_size)))
                memcpy(ptr_add(dst, off), cloned, self.elem_size)
                free(own cloned)
            } else {
                cloned_fn : Dynamic = til_closure_slot_clone(ptr_add(self.data, i.mul(self.elem_size)))
                memcpy(ptr_add(dst, off), cloned_fn, self.elem_size)
                free(own cloned_fn)
            }
        }
    }

    /// A fresh DynArray holding ~self~'s elements followed by ~other~'s.
    /// Both sources keep theirs -- every element is cloned, exactly as
    /// ~clone~ does. Array.concat's counterpart; the element type is
    /// runtime data here, so mismatched operands panic instead of being
    /// rejected by the typer.
    concat := func(self: DynArray, other: DynArray) returns DynArray {
        if self.elem_size.eq(other.elem_size).not().or(self.elem_kind.eq(other.elem_kind).not()) {
            panic("DynArray.concat: incompatible arrays")
        }
        total : USize = self.cap.add(other.cap)
        new_data : U8 = malloc(total.mul(self.elem_size))
        self.clone_into(new_data, 0)
        other.clone_into(new_data, self.cap)
        return DynArray(data = new_data, cap = total,
                     elem_size = self.elem_size, elem_kind = self.elem_kind,
                     elem_clone = self.elem_clone, elem_delete = self.elem_delete)
    }

    /// A fresh DynVec holding a clone of every element, ~self~ intact.
    /// Array.to_vec's counterpart.
    to_vec := func(self: DynArray) returns DynVec {
        mut out := DynVec.new_like(self.elem_size, self.elem_kind,
                                   self.elem_clone, self.elem_delete, self.cap)
        self.clone_into(out.data, 0)
        out.count = self.cap
        return out
    }

    clone := func(self: DynArray) returns DynArray {
        new_data : U8 = malloc(self.cap.mul(self.elem_size))
        if self.elem_kind == ELEM_BOXED {
            for i in 0..self.cap {
                cloned : Dynamic = self.elem_clone(ptr_add(self.data, i.mul(self.elem_size)))
                memcpy(ptr_add(new_data, i.mul(self.elem_size)), cloned, self.elem_size)
                free(own cloned)
            }
        } else if self.elem_kind == ELEM_FN {
            for i in 0..self.cap {
                cloned_fn : Dynamic = til_closure_slot_clone(ptr_add(self.data, i.mul(self.elem_size)))
                memcpy(ptr_add(new_data, i.mul(self.elem_size)), cloned_fn, self.elem_size)
                free(own cloned_fn)
            }
        } else {
            memcpy(new_data, self.data, self.cap.mul(self.elem_size))
        }
        return DynArray(data = new_data, cap = self.cap,
                     elem_size = self.elem_size, elem_kind = self.elem_kind,
                     elem_clone = self.elem_clone, elem_delete = self.elem_delete)
    }
}
