mode lib

import("../self/interpreter")

priv tilvm_error := func(phase: Str, ctx: Context) returns TilVmError {
    return TilVmError(phase = phase.clone(), diagnostics = ctx.diagnostics.clone(),
        exit_status = ctx.eval.exit_status.clone())
}

/// An independent interpreter session. Serialize all VM use on one thread.
/// The session owns all guest globals, code and strings. Destroy it to release
/// them: ASAP calls delete after the last use, or use own vm.delete() explicitly.
TilVm := struct {
    priv support_root := ""
    priv session := InterpSession()
namespace:
    /// support_root names the installed lib/til SDK directory, not a compiler
    /// executable. It must match the SDK used to compile the host.
    new := func(support_root: Str) returns TilVm {
        mut vm := TilVm(support_root = support_root.clone())
        interp_session_start(vm.session, Vec(Str).new())
        return vm
    }

    /// Load one mode lib module and evaluate its initializers in this process.
    /// A failed load can be retried on the same VM. A successful load seals the
    /// first-slice session; reload uses a fresh VM. No compiler is run.
    /// Imports may link prebuilt native libraries; loading errors are returned.
    /// Native libraries remain loaded for the process lifetime, across VM reloads.
    /// Supply all three prelude arguments together. Empty source means no
    /// prelude; name/base without source is an error. The name is a logical
    /// module identity, not a path. The base resolves its imports and links.
    /// The loaded program owns the supplied strings until VM destruction.
    load_file := proc(mut self: TilVm, path: Str, prelude_source: Str = "",
        prelude_name: Str = "", prelude_base: Str = "") throws TilVmError {
        if self.session.retained_programs.len() > 0 {
            mut err := TilVmError(phase = "load")
            err.diagnostics.push(own TilVmDiagnostic(path = path.clone(), message = "session already has a module; reload in a new TilVm"))
            throw err
        }
        root := realpath_str(self.support_root)
        if root.len().eq(0).or(File.is_file(format(root, "/src/core/modes.til")).not()) {
            mut err := TilVmError(phase = "load")
            err.diagnostics.push(own TilVmDiagnostic(path = self.support_root.clone(), message = "TilVm support_root is not an installed Til SDK"))
            throw err
        }
        mut lp := load_program(path, root, realpath_str("."), format(root, "/src/c/ext.c"), Vec(Str).new(), "", true,
            prelude_source, prelude_name, prelude_base)
        if lp.load_errors > 0 { throw tilvm_error("load", lp.ctx) }
        if lp.link_c_paths.len() > 0 {
            if prelude_source.len() == 0 {
                type_error_at(path, 1, 1, "TilVm cannot compile link_c; link a prebuilt native library instead", lp.ctx)
            } else {
                for unit : ProgramUnit in lp.units {
                    for directive : Expr in lp.ctx.imported[unit.path].link_directives {
                        if ident_of(directive.children[0]).ident_name(lp.ctx.symbols.names) == "link_c" {
                            type_error_at(unit.path, directive.line, directive.col,
                                "TilVm cannot compile link_c; link a prebuilt native library instead", lp.ctx)
                        }
                    }
                }
            }
        }
        if lp.ctx.errors > 0 { throw tilvm_error("load", lp.ctx) }
        if init_and_type_program_errors(lp, false) > 0 { throw tilvm_error("type", lp.ctx) }

        // Bindings borrow the program's Context and AST. Move it to its stable
        // address BEFORE creating any runtime binding, including on abort paths.
        mut raw : Dynamic = interp_program_to_heap(own lp)
        ref mut program : LoadedProgram = to_ptr(raw)
        interp_session_retain_program(self.session, raw)
        rc := interp_session_prepare_context(self.session, program, "")
        if rc != 0 {
            err := tilvm_error("load", program.ctx)
            interp_session_free(self.session)
            interp_session_start(self.session, Vec(Str).new())
            throw err
        }
        interp_session_eval_core_once(self.session, program)
        if program.ctx.eval.eval_aborted.not() {
            interp_session_eval_user_units(self.session, program)
        }
        if program.ctx.eval.eval_aborted {
            err := tilvm_error("eval", program.ctx)
            interp_session_free(self.session)
            interp_session_start(self.session, Vec(Str).new())
            throw err
        }
    }

    /// Retain a guest func/proc, checking an ordinary named signature type.
    /// Omitting signature retains the zero-argument, no-result contract.
    /// The handle owns its callable/captures and borrows this VM's code.
    lookup := proc(mut self: TilVm, name: Str, signature: Type = Type.None) returns TilVmCallback throws TilVmError {
        return TilVmCallback.lookup(self.session, name, signature)?
    }

    // Keep resource teardown in one helper, independently readable/testable.
    // Only delete invokes it: there is no public closed-but-live VM state.
    priv close := func(mut self: TilVm) {
        interp_session_free(self.session)
    }

    // A VM is a unique resource, not a snapshot. Suppress the generated
    // fieldwise clone, which would duplicate raw program owners. Privacy
    // rejects application copies; reaching this internally is a bug.
    priv clone := func(self: TilVm) returns TilVm {
        panic("cannot clone a TilVm; create an independent session for ", self.support_root)
    }

    delete := func(own self: TilVm, call_free: Bool = true) {
        TilVm.close(self)
        own self.session.delete(false)
        own self.support_root.delete(false)
        if call_free { free(own self) }
    }
}
