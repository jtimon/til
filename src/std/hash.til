mode lib

// Cheap, dependency-free NON-CRYPTOGRAPHIC hash primitives for hash-based
// collections. These functions provide deterministic distribution, not
// collision resistance, preimage resistance, authentication, or password
// hashing. Never use them where an attacker controls input and collisions
// have a security impact.
//
// Returns U64 so callers can do `bucket(h, cap)` for any cap, or fold the low
// bits themselves. Keep algorithms and constants centralized here: small
// transcription or signedness mistakes silently produce a different hash.
//
// "Cheap" means a small constant amount of arithmetic per input byte
// (or per fixed-width input) and no allocations. til exposes mul and
// the bitwise methods bxor / band / bor on U64 but not shl / shr, so
// multiplicative hashes (Knuth, FNV-1a) are the natural fit;
// bit-rotation hashes would need an ext_func.

// Knuth's 64-bit golden-ratio multiplier (2^64 / phi). Materialised
// via `0.sub(N)` because the unsigned constant 11400714819323198485
// overflows I64 literals; the typed `: U64` decl coerces both operands
// so the sub itself returns U64.
// 2^64 - 11400714819323198485 = 7046029254386353131.
KNUTH_MULT : U64 = 0.sub(7046029254386353131)

// FNV-1a 64-bit basis and prime. The basis (14695981039346656037)
// likewise exceeds I64 max and is materialised via the sub-from-zero
// idiom. 2^64 - 14695981039346656037 = 3750763034362895579.
FNV_OFFSET : U64 = 0.sub(3750763034362895579)
FNV_PRIME  : U64 = 1099511628211
priv FNV_UNROLL : USize = 4

// Hash an I64 by Knuth's multiplicative hash. One multiply, bit-cast
// through U64 so negative inputs don't panic and so the wrap-around is
// well-defined.
hash_i64 := func(x: I64) returns U64 {
    return x.cast(U64).mul(KNUTH_MULT)
}

// Same multiplicative hash for U64.
hash_u64 := func(x: U64) returns U64 {
    return x.mul(KNUTH_MULT)
}

// FNV-1a over `n` raw bytes pointed to by `data`. FNV-1a xors each unsigned
// octet into the state BEFORE multiplying by FNV_PRIME, with arithmetic modulo
// 2^64. The explicit four-byte unroll preserves that order while amortizing
// loop control; test/hashes.til pins standard vectors on both sides of the
// unroll boundary and a high-bit byte.
//
// Used as the default hash for any HashMap key whose in-memory bytes ARE the
// value (primitives, POD structs, enums) -- everything that doesn't carry a
// heap pointer the way Str does.
fnv1a := func(data: Dynamic, n: USize) returns U64 {
    mut h : U64 = FNV_OFFSET
    mut i : USize = 0
    while n - i >= FNV_UNROLL {
        ref b0 : U8 = ptr_add(data, i.to_uptr())
        h = h.bxor(b0.cast(U64)).mul(FNV_PRIME)
        ref b1 : U8 = ptr_add(data, (i + 1).to_uptr())
        h = h.bxor(b1.cast(U64)).mul(FNV_PRIME)
        ref b2 : U8 = ptr_add(data, (i + 2).to_uptr())
        h = h.bxor(b2.cast(U64)).mul(FNV_PRIME)
        ref b3 : U8 = ptr_add(data, (i + 3).to_uptr())
        h = h.bxor(b3.cast(U64)).mul(FNV_PRIME)
        i = i + FNV_UNROLL
    }
    while i < n {
        ref b : U8 = ptr_add(data, i.to_uptr())
        h = h.bxor(b.cast(U64)).mul(FNV_PRIME)
        i++
    }
    return h
}

// FNV-1a over the content bytes of a Str. This delegates to the raw-byte
// implementation so strings and hash containers cannot drift to subtly
// different FNV variants.
hash_str := func(s: Str) returns U64 {
    return fnv1a(s.c_str, s.count)
}

// djb2 (Bernstein): h = h*33 + b, seed 5381. One multiply-add per
// byte, no xor. This is the algorithm the #101 literal-pool namer
// started with (builder-local, before it moved here); it measured
// faster than fnv1a in that role, at the cost of weaker mixing on
// short inputs (single-character strings hash to small values). Fine
// wherever the consumer tolerates that -- the pool namer pads to
// fixed-width hex and resolves collisions explicitly.
//
// examples/bench_hashmap.til puts all three side by side, and the
// trade shows up as a crossover rather than a winner: on 100,000 Str
// keys djb2 leads every column (ins 36ms vs fnv1a's 41ms, get 10ms vs
// 14ms), while on the small-N lookup rows it draws level up to ~128
// entries and then falls behind (1024 entries: 116ms vs 102ms) as the
// weaker mixing turns into longer chains. I64 keys stay fnv1a's.
djb2 := func(data: Dynamic, n: USize) returns U64 {
    mut h : U64 = 5381
    for i in 0..n {
        ref b : U8 = ptr_add(data, i.to_uptr())
        h = h.mul(33).add(b.cast(U64))
    }
    return h
}

// Same xor-then-mul shape as fnv1a but with Knuth's golden-ratio
// multiplier (KNUTH_MULT) and a zero seed. FNV's constants are tuned
// specifically for byte-level mixing; Knuth's are tuned for single-
// word integer hashing. Keeping the loop shape identical isolates
// the choice of constants -- swap HashMap.hasher between fnv1a and
// knuth_bytes in examples/bench_hashmap.til to see whether either
// wins on the workloads we actually run.
knuth_bytes := func(data: Dynamic, n: USize) returns U64 {
    mut h : U64 = 0
    for i in 0..n {
        ref b : U8 = ptr_add(data, i.to_uptr())
        h = h.bxor(b.cast(U64)).mul(KNUTH_MULT)
    }
    return h
}

// Reduce a hash to a bucket index. Plain modulo works for any cap;
// callers that pick a power-of-two cap can replace this with
// `h.to_usize().band(cap.sub(1))` to drop the divide.
bucket := func(h: U64, cap: USize) returns USize {
    return h.to_usize().mod(cap)
}
