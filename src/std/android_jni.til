mode lib

link_c("android_jni.c")

// Bridge symbols (the API is AndroidJni below).
til_android_jni_enter := ext_proc() {}
til_android_jni_leave := ext_proc() {}
til_android_jni_activity := ext_proc() returns shallow U64 {}
til_android_jni_find_class := ext_proc(name: I8) returns shallow U64 {}
til_android_jni_new_string := ext_proc(value: Str) returns shallow U64 {}
til_android_jni_read_string := ext_proc(shallow token: U64) returns Str {}
til_android_jni_static_int := ext_proc(shallow cls: U64, name: I8) returns shallow I32 {}
til_android_jni_call_object := ext_proc(shallow receiver: U64, name: I8, sig: I8, shallow arg: U64) returns shallow U64 {}
til_android_jni_call_int := ext_proc(shallow receiver: U64, name: I8, sig: I8, shallow arg: I32) returns shallow I32 {}

/// A Java local reference. Use it only on the thread and inside the
/// AndroidJni.with_frame call that created it. A zero token represents Java null.
AndroidJavaRef := struct {
    token : U64 = 0
namespace:
    is_null := func(self: AndroidJavaRef) returns Bool { return self.token == 0 }
}

AndroidJniBody := proc()

/// Calls into Android's framework from the native thread of a mode gui APK.
/// JNI descriptors use slash-separated class names, e.g. (I)I. Lookup
/// failures and Java exceptions are logged and terminate the app.
AndroidJni := struct {
namespace:
    /// Attach to ART if necessary and release all Java refs on return.
    /// Frames cannot be nested. This does not switch to the Android UI thread.
    with_frame := proc(body: AndroidJniBody) {
        til_android_jni_enter()
        body()
        til_android_jni_leave()
    }

    /// The current android.app.NativeActivity as a Java reference.
    activity := proc() returns AndroidJavaRef {
        return AndroidJavaRef(token = til_android_jni_activity())
    }

    /// Look up a framework class by its slash-separated binary name.
    find_class := proc(name: Str) returns AndroidJavaRef {
        cname := name.clone()
        return AndroidJavaRef(token = til_android_jni_find_class(cname.c_str))
    }

    /// Read a static Java int field (descriptor I).
    static_int := proc(cls: AndroidJavaRef, name: Str) returns I32 {
        cname := name.clone()
        return til_android_jni_static_int(cls.token, cname.c_str)
    }

    /// Copy UTF-8 text into a frame-local Java String.
    new_string := proc(value: Str) returns AndroidJavaRef {
        return AndroidJavaRef(token = til_android_jni_new_string(value))
    }

    /// Copy a non-null Java String to UTF-8 text that can outlive the frame.
    read_string := proc(value: AndroidJavaRef) returns Str {
        return til_android_jni_read_string(value.token)
    }

    /// Invoke an instance method taking zero or one object and returning an object.
    /// For a one-argument descriptor the default reference passes Java null.
    /// The returned reference can be null.
    call_object := proc(receiver: AndroidJavaRef, name: Str, sig: Str, arg: AndroidJavaRef = AndroidJavaRef()) returns AndroidJavaRef {
        cname := name.clone()
        descriptor := sig.clone()
        return AndroidJavaRef(token = til_android_jni_call_object(receiver.token, cname.c_str, descriptor.c_str, arg.token))
    }

    /// Invoke an instance method taking one Java int and returning an int.
    call_int := proc(receiver: AndroidJavaRef, name: Str, sig: Str, arg: I32) returns I32 {
        cname := name.clone()
        descriptor := sig.clone()
        return til_android_jni_call_int(receiver.token, cname.c_str, descriptor.c_str, arg)
    }
}
