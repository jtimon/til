mode lib

/// Unordered collection of unique typed elements.
DynSet := struct {
    own data : U8 = 0
    count : USize = 0
    cap : USize = 0
    const elem_size : USize = 0
    const elem_clone : CloneFn = default_clone
    const elem_delete : DeleteFn = default_delete
    const elem_cmp : CmpFn = default_cmp

namespace:
    /// Create an empty DynSet. elem_type must implement ~cmp~.
    new := func(T: Type) returns DynSet {
        elem_type := dyn_type_to_str(T)
        if elem_type.is_empty() { panic("DynSet.new: elem_type required") }
        if dyn_has_method(elem_type, "cmp").not() {
            panic("DynSet.new: type ", elem_type, " must implement cmp")
        }
        sz : USize = dyn_size_of(elem_type)
        // Lazy-empty (cap 0) like Set.new / Vec.new: `add` seeds the
        // first slot, so an unused DynSet allocates nothing.
        return DynSet(cap = 0,
                   elem_size = sz,
                   elem_clone = dyn_fn(elem_type, "clone"),
                   elem_delete = dyn_fn(elem_type, "delete"),
                   elem_cmp = dyn_fn(elem_type, "cmp"))
    }

    /// Create an empty DynSet pre-sized for ~n~ elements, so adding up
    /// to ~n~ reallocs zero times (Set.with_capacity's counterpart; the
    /// element type is a runtime argument here, as for ~new~).
    with_capacity := func(T: Type, n: USize) returns DynSet {
        mut s := DynSet.new(T)
        if n > s.cap {
            s.data = realloc(own s.data, n.to_uptr().mul(s.elem_size.to_uptr()))
            s.cap = n
        }
        return s
    }

    len := func(self: DynSet) returns USize { return self.count }

    /// Drop all live elements via elem_delete but keep the allocated
    /// storage and element-type metadata so the DynSet can be reused.
    clear := func(mut self: DynSet) {
        for i in 0..self.count {
            self.elem_delete(
                      ptr_add(self.data, i.to_uptr().mul(self.elem_size.to_uptr())), false)
        }
        self.count = 0
    }

    /// True if the set contains an element equal to ~val~.
    has := func(self: DynSet, val: Dynamic) returns Bool {
        mut lo : USize = 0
        mut hi := self.count
        while lo < hi {
            mid := lo.add(hi.sub(lo) / 2)
            c : I64 = self.elem_cmp(
                          ptr_add(self.data, mid.to_uptr().mul(self.elem_size.to_uptr())), val)
            if c < 0 { lo = mid + 1 }
            else {
                if c > 0 { hi = mid }
                else { return true }
            }
        }
        return false
    }

    /// Insert ~val~ into the set (sorted order). If an equal element
    /// already exists, ~val~ is dropped. ~val~ is owned.
    add := func(mut self: DynSet, own val: Dynamic) {
        mut lo : USize = 0
        mut hi := self.count
        mut found := false
        while lo < hi {
            mid := lo.add(hi.sub(lo) / 2)
            c : I64 = self.elem_cmp(
                          ptr_add(self.data, mid.to_uptr().mul(self.elem_size.to_uptr())), val)
            if c < 0 { lo = mid + 1 }
            else {
                if c > 0 { hi = mid }
                else { found = true; lo = mid; hi = mid }
            }
        }
        if found {
            self.elem_delete(val, false)
            free(own val)
        } else {
            if self.count == self.cap {
                // cap 0 (lazy-empty) doubles to 0; seed the first grow to 1.
                mut new_cap := self.cap * 2
                if self.cap == 0 { new_cap = 1 }
                self.data = realloc(own self.data, new_cap.to_uptr().mul(self.elem_size.to_uptr()))
                self.cap = new_cap
            }
            memmove(ptr_add(self.data, lo.add(1).to_uptr().mul(self.elem_size.to_uptr())),
                    ptr_add(self.data, lo.to_uptr().mul(self.elem_size.to_uptr())),
                    self.count.sub(lo).to_uptr().mul(self.elem_size.to_uptr()))
            memcpy(ptr_add(self.data, lo.to_uptr().mul(self.elem_size.to_uptr())), val, self.elem_size.to_uptr())
            free(own val)
            self.count = self.count + 1
        }
    }

    /// Remove the element equal to ~val~, dropping it. Returns false if
    /// absent (Set.remove's counterpart). Later elements shift left to
    /// keep the storage sorted and dense.
    remove := func(mut self: DynSet, val: Dynamic) returns Bool {
        mut lo : USize = 0
        mut hi := self.count
        while lo < hi {
            mid := lo.add(hi.sub(lo) / 2)
            c : I64 = self.elem_cmp(
                          ptr_add(self.data, mid.to_uptr().mul(self.elem_size.to_uptr())), val)
            if c < 0 { lo = mid + 1 }
            else {
                if c > 0 { hi = mid }
                else {
                    self.elem_delete(
                        ptr_add(self.data, mid.to_uptr().mul(self.elem_size.to_uptr())), false)
                    tail := self.count.sub(mid).sub(1)
                    if tail > 0 {
                        memmove(ptr_add(self.data, mid.to_uptr().mul(self.elem_size.to_uptr())),
                                ptr_add(self.data, mid.add(1).to_uptr().mul(self.elem_size.to_uptr())),
                                tail.to_uptr().mul(self.elem_size.to_uptr()))
                    }
                    self.count = self.count - 1
                    memset(ptr_add(self.data, self.count.to_uptr().mul(self.elem_size.to_uptr())), 0, self.elem_size.to_uptr())
                    return true
                }
            }
        }
        return false
    }

    delete := func(own self: DynSet, call_free: Bool = true) {
        DynSet.clear(self)
        free(own self.data)
        if call_free { free(own self) }
    }

    clone := func(self: DynSet) returns DynSet {
        // A lazy-empty source clones to another lazy-empty DynSet.
        if self.cap == 0 {
            return DynSet(cap = 0, elem_size = self.elem_size,
                       elem_clone = self.elem_clone, elem_delete = self.elem_delete,
                       elem_cmp = self.elem_cmp)
        }
        mut new_data : U8 = malloc(self.cap.to_uptr().mul(self.elem_size.to_uptr()))
        for i in 0..self.count {
            cloned : Dynamic = self.elem_clone(
                         ptr_add(self.data, i.to_uptr().mul(self.elem_size.to_uptr())))
            memcpy(ptr_add(new_data, i.to_uptr().mul(self.elem_size.to_uptr())), cloned, self.elem_size.to_uptr())
            free(own cloned)
        }
        return DynSet(data = new_data, count = self.count, cap = self.cap,
                   elem_size = self.elem_size,
                   elem_clone = self.elem_clone, elem_delete = self.elem_delete,
                   elem_cmp = self.elem_cmp)
    }
}
