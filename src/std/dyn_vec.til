mode lib

/// Dynamic array of typed elements.
DynVec := struct {
    own data : U8 = 0
    count : USize = 0
    cap : USize = 0
    const elem_size : USize = 0
    const elem_kind : USize = ELEM_POD
    const elem_clone : CloneFn = default_clone
    const elem_delete : DeleteFn = default_delete

namespace:
    priv new_type_name_kind := func(elem_type: Str, elem_kind: USize) returns DynVec {
        if elem_kind == ELEM_FN {
            return DynVec(data = malloc(8), cap = 1,
                        elem_size = 8, elem_kind = ELEM_FN)
        }
        sz : USize = dyn_size_of(elem_type)
        if elem_kind == ELEM_POD {
            return DynVec(data = malloc(sz.to_uptr()), cap = 1,
                       elem_size = sz, elem_kind = ELEM_POD)
        }
        return DynVec(data = malloc(sz.to_uptr()), cap = 1,
                    elem_size = sz, elem_kind = ELEM_BOXED,
                    elem_clone = dyn_fn(elem_type, "clone"),
                    elem_delete = dyn_fn(elem_type, "delete"))
    }

    /// Create a new empty DynVec for elements of the given type.
    new_type_name := func(elem_type: Str) returns DynVec {
        if elem_type.is_empty() {
            panic("DynVec.new: elem_type required")
        }
        return DynVec.new_type_name_kind(elem_type, type_name_storage_kind(elem_type))
    }

    new := func(T: Type) returns DynVec {
        elem_type := dyn_type_to_str(T)
        return DynVec.new_type_name_kind(elem_type, type_storage_kind(T))
    }

    /// Create an empty DynVec with room for ~n~ elements, so filling it
    /// with n items reallocs zero times (Vec.with_capacity's counterpart;
    /// the element type is a runtime argument here, as for ~new~).
    with_capacity := func(T: Type, n: USize) returns DynVec {
        mut v := DynVec.new(T)
        if n > v.cap {
            v.data = realloc(own v.data, n.to_uptr().mul(v.elem_size.to_uptr()))
            v.cap = n
        }
        return v
    }

    /// Create an empty DynVec with room for ~n~ elements, taking its
    /// element metadata from a container that already has it instead of
    /// from a Type or a type name. DynArray.to_vec is why this exists: a
    /// DynArray carries the element size / kind / clone / delete fns but
    /// not the type name ~new_type_name~ wants, and a DynVec record can
    /// only be built directly inside this file.
    new_like := func(elem_size: USize, elem_kind: USize, elem_clone: CloneFn,
                     elem_delete: DeleteFn, n: USize) returns DynVec {
        mut c : USize = 1
        if n > 0 { c = n }
        return DynVec(data = malloc(c.to_uptr().mul(elem_size.to_uptr())), cap = c,
                    elem_size = elem_size, elem_kind = elem_kind,
                    elem_clone = elem_clone, elem_delete = elem_delete)
    }

    len := func(self: DynVec) returns USize { return self.count }

    /// Drop all live elements via elem_delete but keep the allocated
    /// storage and element-type metadata so the DynVec can be reused.
    clear := func(mut self: DynVec) {
        if self.elem_kind == ELEM_BOXED {
            for i in 0..self.count {
                self.elem_delete(ptr_add(self.data, i.to_uptr().mul(self.elem_size.to_uptr())), false)
            }
        } else if self.elem_kind == ELEM_FN {
            for i in 0..self.count {
                til_closure_slot_delete(ptr_add(self.data, i.to_uptr().mul(self.elem_size.to_uptr())))
            }
        }
        self.count = 0
    }

    /// Drop the elements flagged in ~marks~ (a byte-per-element buffer,
    /// nonzero = drop, at least self.count entries), then compact the
    /// survivors forward and update count. Vec.delete_marked's
    /// counterpart.
    delete_marked := func(mut self: DynVec, marks: Dynamic) {
        n := self.count
        mut i : USize = 0
        while i < n {
            ref mark : Bool = ptr_add(marks, i.to_uptr())
            if mark {
                ref mut slot : Dynamic = ptr_add(self.data, i.to_uptr().mul(self.elem_size.to_uptr()))
                if self.elem_kind == ELEM_BOXED {
                    self.elem_delete(slot, false)
                } else if self.elem_kind == ELEM_FN {
                    til_closure_slot_delete(slot)
                }
                memset(slot, 0, self.elem_size.to_uptr())
            }
            i++
        }
        mut w : USize = 0
        mut r : USize = 0
        while r < n {
            ref mark : Bool = ptr_add(marks, r.to_uptr())
            if mark.not() {
                if w != r {
                    memcpy(ptr_add(self.data, w.to_uptr().mul(self.elem_size.to_uptr())),
                           ptr_add(self.data, r.to_uptr().mul(self.elem_size.to_uptr())), self.elem_size.to_uptr())
                }
                w++
            }
            r++
        }
        self.count = w
    }

    /// Append an element to the end. ~val~ is owned: after this call the
    /// caller must not use the value passed -- clone it first if needed.
    push := func(mut self: DynVec, own val: Dynamic) {
        if self.count == self.cap {
            new_cap := self.cap * 2
            self.data = realloc(own self.data, new_cap.to_uptr().mul(self.elem_size.to_uptr()))
            self.cap = new_cap
        }
        // Move the callable box into the slot; the interpreter's owning
        // Dynamic parameter must not reclaim the transferred box on return.
        if self.elem_kind == ELEM_FN {
            til_closure_slot_take(ptr_add(self.data, self.count.to_uptr().mul(self.elem_size.to_uptr())), val)
            self.count = self.count + 1
            return
        }
        memcpy(ptr_add(self.data, self.count.to_uptr().mul(self.elem_size.to_uptr())), val, self.elem_size.to_uptr())
        free(own val)
        self.count = self.count + 1
    }

    /// Consume the contents of ~other~ by appending them to ~self~.
    /// ~other~ is taken by ownership and will be empty after the call.
    append := func(mut self: DynVec, own other: DynVec) {
        if self.elem_size.eq(other.elem_size).and(self.elem_kind.eq(other.elem_kind)).not() {
            panic("DynVec.append: incompatible vecs")
        }
        if other.count == 0 {
            return
        }
        needed := self.count + other.count
        if needed > self.cap {
            mut new_cap := self.cap
            while needed > new_cap {
                new_cap = new_cap * 2
            }
            self.data = realloc(own self.data, new_cap.to_uptr().mul(self.elem_size.to_uptr()))
            self.cap = new_cap
        }
        memcpy(ptr_add(self.data, self.count.to_uptr().mul(self.elem_size.to_uptr())), other.data, other.count.to_uptr().mul(self.elem_size.to_uptr()))
        self.count = needed
        other.count = 0
    }

    /// Replace self's contents with other's via memcpy (no per-elem clone).
    /// Avoids the Vec_clone + extra Vec_delete that plain ~self = other~ emits.
    /// Takes ~mut~ (not ~own~) so caller retains ownership of other; its
    /// natural scope-end auto-delete frees other.data. Setting other.count = 0
    /// prevents that auto-delete from re-running elem_delete on items whose
    /// bytes were moved into self.
    move_from := func(mut self: DynVec, mut other: DynVec) {
        if self.elem_size.eq(other.elem_size).and(self.elem_kind.eq(other.elem_kind)).not() {
            panic("DynVec.move_from: incompatible vecs")
        }
        if self.elem_kind == ELEM_BOXED {
            for i in 0..self.count {
                self.elem_delete(ptr_add(self.data, i.to_uptr().mul(self.elem_size.to_uptr())), false)
            }
        } else if self.elem_kind == ELEM_FN {
            for i in 0..self.count {
                til_closure_slot_delete(ptr_add(self.data, i.to_uptr().mul(self.elem_size.to_uptr())))
            }
        }
        needed := other.count
        if needed > self.cap {
            mut new_cap := self.cap
            while needed > new_cap {
                new_cap = new_cap * 2
            }
            self.data = realloc(own self.data, new_cap.to_uptr().mul(self.elem_size.to_uptr()))
            self.cap = new_cap
        }
        if needed > 0 {
            memcpy(self.data, other.data, needed.to_uptr().mul(self.elem_size.to_uptr()))
        }
        self.count = needed
        other.count = 0
    }

    /// Give self's contents to ~dest~, which drops whatever it held.
    /// Vec.move_to's counterpart, and the argument-flipped spelling of
    /// ~dest.move_from(self)~. Both sides are ~mut~ here rather than one
    /// of them ~own~, because the values these moves exist for are struct
    /// FIELDS, and a field cannot be an owned argument or receiver.
    move_to := func(mut self: DynVec, mut dest: DynVec) {
        dest.move_from(self)
    }

    /// Unchecked ref to the element at index ~i~. Caller guarantees
    /// ~i < self.count~; bypasses get's throwing bounds check. for-in
    /// and the DynMap binary search use this directly (issue #284/#287).
    unsafe_get := func(self: DynVec, i: USize) returns ref Dynamic {
        return ptr_add(self.data, i.to_uptr().mul(self.elem_size.to_uptr()))
    }

    /// Return a reference to the element at index ~i~. Throws
    /// OutOfBounds if ~i~ is past the end; call as ~vec[i]~
    /// to panic on a bad index. The reference is valid until the
    /// next mutation.
    get := func(self: DynVec, i: USize) returns ref Dynamic throws OutOfBounds {
        if i >= self.count {
            throw OutOfBounds()
        }
        return self.unsafe_get(i)
    }

    /// Remove and return the last element. Panics if empty. The caller
    /// takes ownership of the returned value.
    pop := func(mut self: DynVec) returns Dynamic {
        if self.count == 0 {
            panic("DynVec.pop: empty vec")
        }
        last := self.count - 1
        if self.elem_kind == ELEM_FN {
            self.count = last
            return til_closure_slot_pop(self.unsafe_get(last))
        }
        mut out : U8 = malloc(self.elem_size.to_uptr())
        memcpy(out, ptr_add(self.data, last.to_uptr().mul(self.elem_size.to_uptr())), self.elem_size.to_uptr())
        self.count = last
        return out
    }

    /// Remove and drop the element at ~i~, shifting later elements left.
    /// Vec.remove_at's counterpart.
    remove_at := func(mut self: DynVec, i: USize) throws OutOfBounds {
        if i >= self.count {
            throw OutOfBounds()
        }
        if self.elem_kind == ELEM_BOXED {
            self.elem_delete(self.unsafe_get(i), false)
        } else if self.elem_kind == ELEM_FN {
            til_closure_slot_delete(self.unsafe_get(i))
        }
        tail := self.count.sub(i).sub(1)
        if tail > 0 {
            memmove(self.unsafe_get(i), self.unsafe_get(i.add(1)), tail.to_uptr().mul(self.elem_size.to_uptr()))
        }
        self.count = self.count - 1
        memset(self.unsafe_get(self.count), 0, self.elem_size.to_uptr())
    }

    /// Drop the elements from index ~n~ to the end and set count to ~n~
    /// (the survivors [0, n) are left untouched). Panics if ~n~ exceeds
    /// len. Vec.truncate's counterpart.
    truncate := func(mut self: DynVec, n: USize) {
        if n > self.count {
            panic("DynVec.truncate: count ", n.to_str(), " out of bounds (len ", self.count.to_str(), ")")
        }
        if self.elem_kind == ELEM_BOXED {
            for i in n..self.count {
                self.elem_delete(ptr_add(self.data, i.to_uptr().mul(self.elem_size.to_uptr())), false)
            }
        } else if self.elem_kind == ELEM_FN {
            for i in n..self.count {
                til_closure_slot_delete(ptr_add(self.data, i.to_uptr().mul(self.elem_size.to_uptr())))
            }
        }
        self.count = n
    }

    /// Split off the first ~n~ elements into a new DynVec. Panics if ~n~
    /// exceeds self.len(). The remaining elements shift to the front.
    take_prefix := func(mut self: DynVec, n: USize) returns DynVec {
        if n > self.count {
            panic("DynVec.take_prefix: count ", n.to_str(), " out of bounds (len ", self.count.to_str(), ")")
        }
        mut prefix_cap : USize = 1
        if n > 0 {
            prefix_cap = n
        }
        mut prefix_data : U8 = malloc(prefix_cap.to_uptr().mul(self.elem_size.to_uptr()))
        if n > 0 {
            memcpy(prefix_data, self.data, n.to_uptr().mul(self.elem_size.to_uptr()))
        }
        tail_count := self.count - n
        if tail_count > 0 {
            memmove(self.data, ptr_add(self.data, n.to_uptr().mul(self.elem_size.to_uptr())), tail_count.to_uptr().mul(self.elem_size.to_uptr()))
        }
        self.count = tail_count
        return DynVec(data = prefix_data, count = n, cap = prefix_cap,
                   elem_size = self.elem_size, elem_kind = self.elem_kind,
                   elem_clone = self.elem_clone, elem_delete = self.elem_delete)
    }

    /// Take the contents out: the returned DynVec holds self's elements
    /// and self is left empty. Vec.take hands its BUFFER over and blanks
    /// itself; a DynVec cannot, because elem_size/elem_kind/elem_clone/
    /// elem_delete are runtime values rather than type parameters, and a
    /// blanked DynVec would no longer know how to grow or free itself.
    /// The elements move as bytes into a fresh buffer instead -- which is
    /// take_prefix of the whole vec.
    take := func(mut self: DynVec) returns DynVec {
        return self.take_prefix(self.count)
    }

    /// Overwrite the element at index ~i~ without a bounds check, dropping
    /// the old value. Caller guarantees ~i < self.count~; the write-side
    /// mirror of unsafe_get (issue #284).
    unsafe_set := func(mut self: DynVec, i: USize, own val: Dynamic) {
        if self.elem_kind == ELEM_BOXED {
            self.elem_delete(self.unsafe_get(i), false)
        } else if self.elem_kind == ELEM_FN {
            til_closure_slot_delete(self.unsafe_get(i))
            til_closure_slot_take(self.unsafe_get(i), val)
            return
        }
        memcpy(self.unsafe_get(i), val, self.elem_size.to_uptr())
        free(own val)
    }

    /// Overwrite the element at index ~i~. ~val~ is owned. Throws
    /// OutOfBounds if ~i~ is past the end; call as ~dynvec[i] = val~
    /// (or ~dynvec.set(i, own val)!~) to panic on a bad index.
    set := func(mut self: DynVec, i: USize, own val: Dynamic) throws OutOfBounds {
        if i >= self.count {
            // val is not stored on the error path: drop its element
            // content (if boxed) and free the box so it does not leak.
            // (if/else so the owned `val` is consumed on exactly one path.)
            if self.elem_kind == ELEM_BOXED {
                self.elem_delete(val, false)
                free(own val)
            } else if self.elem_kind == ELEM_FN {
                til_closure_delete(val)
            } else {
                free(own val)
            }
            throw OutOfBounds()
        } else {
            self.unsafe_set(i, own val)
        }
    }

    /// Move bytes of src[i] into self (push). Source slot is zeroed so that
    /// src's eventual elem_delete on it is a no-op (relies on the same
    /// count==0/data==NULL convention used by take_children and DynVec.delete).
    push_take := func(mut self: DynVec, mut src: DynVec, i: USize) {
        if i >= src.count {
            panic("DynVec.push_take: index ", i.to_str(), " out of bounds (len ", src.count.to_str(), ")")
        }
        if self.elem_size.eq(src.elem_size).and(self.elem_kind.eq(src.elem_kind)).not() {
            panic("DynVec.push_take: incompatible vecs")
        }
        if self.count == self.cap {
            new_cap := self.cap * 2
            self.data = realloc(own self.data, new_cap.to_uptr().mul(self.elem_size.to_uptr()))
            self.cap = new_cap
        }
        adopt_from(ptr_add(self.data, self.count.to_uptr().mul(self.elem_size.to_uptr())),
                   ptr_add(src.data, i.to_uptr().mul(src.elem_size.to_uptr())), self.elem_size.to_uptr())
        self.count = self.count + 1
    }

    /// Drop each element via elem_delete, free storage, then free self
    /// unless ~call_free~ is false.
    delete := func(own self: DynVec, call_free: Bool = true) {
        DynVec.clear(self)
        free(own self.data)
        if call_free { free(own self) }
    }

    /// Deep-copy the DynVec and all its elements via elem_clone.
    clone := func(self: DynVec) returns DynVec {
        mut new_data : U8 = malloc(self.cap.to_uptr().mul(self.elem_size.to_uptr()))
        if self.elem_kind == ELEM_BOXED {
            for i in 0..self.count {
                cloned : Dynamic = self.elem_clone(ptr_add(self.data, i.to_uptr().mul(self.elem_size.to_uptr())))
                memcpy(ptr_add(new_data, i.to_uptr().mul(self.elem_size.to_uptr())), cloned, self.elem_size.to_uptr())
                free(own cloned)
            }
        } else if self.elem_kind == ELEM_FN {
            for i in 0..self.count {
                cloned_fn : Dynamic = til_closure_slot_clone(ptr_add(self.data, i.to_uptr().mul(self.elem_size.to_uptr())))
                memcpy(ptr_add(new_data, i.to_uptr().mul(self.elem_size.to_uptr())), cloned_fn, self.elem_size.to_uptr())
                free(own cloned_fn)
            }
        } else {
            memcpy(new_data, self.data, self.count.to_uptr().mul(self.elem_size.to_uptr()))
        }
        return DynVec(data = new_data, count = self.count, cap = self.cap,
                   elem_size = self.elem_size, elem_kind = self.elem_kind,
                   elem_clone = self.elem_clone, elem_delete = self.elem_delete)
    }
}
