mode lib

import("file")

// System primitives that cause (or observe) side effects on the host.
//
// These live in std -- NOT core -- so that a restricted mode like
// safe_script can ban the whole subtree by refusing any import of it.
// noop_proc (the one syscall-ish primitive with no host side effect)
// stays in core/core.til.
// Run a shell command and block until it finishes, returning its exit
// status. spawn_cmd is the non-blocking counterpart (pair it with
// wait_cmd below).
system_cmd := ext_proc(cmd: Str) returns shallow I32 {}
spawn_cmd := ext_proc(cmd: Str) returns I64 {}
check_cmd_status := ext_proc(shallow pid: I64) returns shallow I64 {}
sleep_ms := ext_proc(shallow ms: I64) {}
file_mtime := ext_proc(path: Str) returns shallow I64 {}
clock_ms := ext_proc() returns shallow I64 {}
get_thread_count := ext_proc() returns shallow I64 {}
peak_rss_bytes := ext_proc() returns shallow U64 {}
current_rss_bytes := ext_proc(shallow pid: I64) returns shallow U64 {}
// getpid(). Callers use it to make per-process temp paths unique
// (the REPL's tmp/repl_<pid>.til, the interpreter's tmp/ffi_<pid>.so).
process_id := ext_proc() returns shallow I32 {}
host_os := ext_proc() returns Str {}
host_arch := ext_proc() returns Str {}
// libc getenv, bound directly -- no C wrapper in ext.c. The binding name
// is the C symbol (priv would mangle it), so this one keeps libc's
// spelling; I8 is char, so the emitted prototype matches stdlib.h's (the
// #176 machinery). NULL when unset, otherwise a borrowed pointer into
// libc's environ block, which the next setenv may move. Callers use
// get_env below.
getenv := ext_proc(name: I8) returns ref I8 {}

/// Read an environment variable, "" when unset. NOT view-compatible:
/// `name` reaches C as a NUL-terminated string, so it must be a literal
/// or an owned Str, never a substr view (a view's bytes end at its count,
/// with no NUL there, and getenv would read past it). Pass
/// `view.clone()` at the call site if you have one -- since #343 the
/// boundary panics on a view here rather than reading past it, but the
/// caller still owns the choice. The result is owned:
/// the bytes are copied out of the environ block, so the Str stays valid
/// however the environment changes later. A host observation, hence proc:
/// the same call can answer differently twice in one run.
get_env := proc(name: Str) returns Str {
    ref val : I8 = getenv(name.c_str)
    if is_null(val) { return "" }
    return Str.from_c_str(val).clone()
}
mkdir_p := ext_proc(path: Str) returns shallow I32 {}
copy_file := ext_proc(src: Str, dst: Str) returns shallow I32 {}
copy_tree := ext_proc(src: Str, dst: Str) returns shallow I32 {}
stdio_capture_begin := ext_proc(path: Str) {}
stdio_capture_end := ext_proc() {}
// Read one line from stdin (host input observation; moved from core/io.til).
in_read_line := ext_proc(mut line: Str) returns shallow Bool {}

wait_cmd := proc(pid: I64) returns I64 {
    while true {
        status := check_cmd_status(pid)
        if status != -1 { return status }
        sleep_ms(50)
    }
}

// Argv-based process execution (issue #345). The raw handle API behind
// the Cmd struct below; see the header comment in src/c/ext.c for why a
// command is accumulated on the C side instead of passed as a Vec.
ccmd_new := ext_proc() returns ref Dynamic {}
ccmd_arg := ext_proc(handle: Dynamic, arg: Str) {}
ccmd_cwd := ext_proc(handle: Dynamic, dir: Str) {}
ccmd_env := ext_proc(handle: Dynamic, name: Str, value: Str) {}
ccmd_stdout_file := ext_proc(handle: Dynamic, path: Str) {}
ccmd_stderr_file := ext_proc(handle: Dynamic, path: Str) {}
ccmd_stderr_to_stdout := ext_proc(handle: Dynamic) {}
ccmd_capture := ext_proc(handle: Dynamic, shallow out: Bool, shallow err: Bool) {}
ccmd_render := ext_proc(handle: Dynamic) returns Str {}
ccmd_start := ext_proc(handle: Dynamic) returns shallow I64 {}
ccmd_wait := ext_proc(handle: Dynamic) returns shallow I64 {}
ccmd_poll := ext_proc(handle: Dynamic) returns shallow Bool {}
ccmd_status := ext_proc(handle: Dynamic) returns shallow I64 {}
ccmd_out := ext_proc(handle: Dynamic) returns Str {}
ccmd_err := ext_proc(handle: Dynamic) returns Str {}
ccmd_free := ext_func(handle: Dynamic) {}

/// A command to run, built from argv elements -- never from shell text.
///
/// `system_cmd` / `spawn_cmd` / `run_cmd` above hand a STRING to
/// /bin/sh or cmd.exe, which re-splits it on whitespace, expands $VAR
/// and globs it; every caller then has to quote its arguments back out
/// of that, differently per host. A Cmd passes its elements straight to
/// execvp / CreateProcess, so an argument means exactly the bytes it
/// holds -- spaces, quotes, dollars and all. A shell is still reachable
/// by asking for one: `Cmd.new("sh", "-c", script)`.
///
/// Output is inherited by default (the child writes to this process's
/// stdout/stderr as it goes). `capture()` collects it instead, and
/// `stdout_to`/`stderr_to` send it to files:
///
///     c := Cmd.new("echo", "a b")
///     c.capture()
///     if c.run() != 0 { panic("echo failed") }
///     print(c.out())
Cmd := struct {
    // Same shape as File: the handle is a live C-side command, and
    // ccmd_new exits rather than answering without one.
    ref handle : U8

namespace:
    /// A command from its program name and arguments. The program is
    /// looked up in PATH unless the name contains a separator.
    new := proc(args: ..Str) returns Cmd {
        ref h : Dynamic = ccmd_new()
        mut i : USize = 0
        while i < args.len() {
            ref a : Str = args[i]
            ccmd_arg(h, a)
            i++
        }
        return Cmd(handle = h)
    }

    /// Append one argument. Returns `self` so calls chain via UFCS.
    arg := proc(self: Cmd, a: Str) returns ref Cmd {
        ccmd_arg(self.handle, a)
        return self
    }

    /// Append several arguments at once.
    args := proc(self: Cmd, more: ..Str) returns ref Cmd {
        mut i : USize = 0
        while i < more.len() {
            ref a : Str = more[i]
            ccmd_arg(self.handle, a)
            i++
        }
        return self
    }

    /// Run the command in `dir` instead of this process's working
    /// directory. Only the child moves; this process stays put.
    cwd := proc(self: Cmd, dir: Str) returns ref Cmd {
        ccmd_cwd(self.handle, dir)
        return self
    }

    /// Set an environment variable for the child only. The rest of the
    /// environment is inherited; this process's own is never touched.
    env := proc(self: Cmd, name: Str, value: Str) returns ref Cmd {
        ccmd_env(self.handle, name, value)
        return self
    }

    /// Send the child's stdout to `path`, truncating it first.
    stdout_to := proc(self: Cmd, path: Str) returns ref Cmd {
        ccmd_stdout_file(self.handle, path)
        return self
    }

    /// Send the child's stderr to `path`, truncating it first.
    stderr_to := proc(self: Cmd, path: Str) returns ref Cmd {
        ccmd_stderr_file(self.handle, path)
        return self
    }

    /// Merge the child's stderr into wherever its stdout goes -- the
    /// `2>&1` of build logs, without a shell.
    stderr_to_stdout := proc(self: Cmd) returns ref Cmd {
        ccmd_stderr_to_stdout(self.handle)
        return self
    }

    /// Collect the child's output instead of letting it through, for
    /// reading with `out()` and `err()` once it has finished. The two
    /// streams stay separate; each command captures into its own spool
    /// file, so concurrent captures never mix.
    capture := proc(self: Cmd) returns ref Cmd {
        ccmd_capture(self.handle, true, true)
        return self
    }

    /// Collect stdout only, leaving stderr on this process's stderr so
    /// a compiler's diagnostics still reach the terminal live.
    capture_out := proc(self: Cmd) returns ref Cmd {
        ccmd_capture(self.handle, true, false)
        return self
    }

    /// The command as a human would type it, for logs and error
    /// messages. NOTHING executes this string -- it is a rendering, not
    /// the command.
    render := proc(self: Cmd) returns Str {
        return ccmd_render(self.handle)
    }

    /// Start the child without waiting, returning its pid (POSIX) or
    /// process handle (Windows). Pair with `wait` or `poll`.
    start := proc(self: Cmd) returns I64 {
        return ccmd_start(self.handle)
    }

    /// Block until the child finishes and return its status: the exit
    /// code, or MINUS the signal number when a signal killed it (so a
    /// compiler the OOM killer took reads as -9, not as an ordinary
    /// exit 137).
    wait := proc(self: Cmd) returns I64 {
        return ccmd_wait(self.handle)
    }

    /// True once the child has finished, false while it is still
    /// running. Deliberately not a status: every I64 is a legal status.
    poll := proc(self: Cmd) returns Bool {
        return ccmd_poll(self.handle)
    }

    /// The status of a child that has already finished. Use after
    /// `poll` reports true; `wait` returns the same value directly.
    status := proc(self: Cmd) returns I64 {
        return ccmd_status(self.handle)
    }

    /// Start the command and block until it finishes, returning its
    /// status. The lower-level runner: a non-zero status is a value
    /// here, not a failure. Use `run_checked` when it is one.
    run := proc(self: Cmd) returns I64 {
        ccmd_start(self.handle)
        return ccmd_wait(self.handle)
    }

    /// Run the command, printing it first, and stop the program if it
    /// fails. The build-script runner: what ran is visible in the log
    /// and a failure is reported at the command that caused it, with
    /// its exact status, instead of surfacing later as a missing file.
    run_checked := proc(self: Cmd) {
        println(self.render())
        status := self.run()
        if status != 0 {
            mut why := format("exited with ", status.to_str())
            if status < 0 {
                why = format("was killed by signal ", (0 - status).to_str())
            }
            panic("command failed (", why, "): ", self.render())
        }
    }

    /// The child's captured stdout. Requires `capture()` (or
    /// `capture_out()`) before the run, and a finished child.
    out := proc(self: Cmd) returns Str {
        return ccmd_out(self.handle)
    }

    /// The child's captured stderr. Requires `capture()` before the
    /// run, and a finished child.
    err := proc(self: Cmd) returns Str {
        return ccmd_err(self.handle)
    }

    /// Release the command. A child still running is waited for first:
    /// dropping it would leave a process nobody reaps.
    priv close := func(self: Cmd) {
        ccmd_free(self.handle)
    }

    delete := func(own self: Cmd, call_free: Bool = true) {
        Cmd.close(self)
        if call_free { free(own self) }
    }
}

run_cmd := proc(mut output: Str, args: ..Str) returns I64 {
    mut cmd := ""
    mut i : USize = 0
    while i < args.len() {
        ref arg: Str = args[i]
        if i > 0 {
            cmd = cmd.format(" '", arg, "'")
        } else {
            cmd = arg.clone()
        }
        i++
    }
    if host_os() == "windows" {
        _mk := spawn_cmd("if not exist tmp mkdir tmp >NUL 2>&1")
        _ec := wait_cmd(_mk)
        if _ec < 0 { }
    } else {
        _mk := spawn_cmd("mkdir -p tmp >/dev/null 2>&1")
        _ec := wait_cmd(_mk)
        if _ec < 0 { }
    }
    tmpf := "tmp/_run_cmd_out"
    pid := spawn_cmd(cmd.format(" > ", tmpf, " 2>&1"))
    ec := wait_cmd(pid)
    content := File.readfile(tmpf)
    // Plain assignment: the builder deletes output's old value before the
    // write (save_old_delete), and the asap pass moves `content` in at its
    // last use instead of cloning. The old raw move() spelling leaked
    // output's previous c_str whenever the caller passed a non-empty Str.
    output = content
    return ec
}
