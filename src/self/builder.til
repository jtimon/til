mode lib
import("context")

import("loader")
import("c_codegen")
import("jvm_codegen")
import("targets")
import("../std/sys")
import("../std/file")


priv compile_lib := proc(c_path: Str, lib_name: Str, ext_c_path: Str, user_c_path: Str, link_flags: Str, include_flags: Str, target: Target, cc_override: Str, asan: Bool, usize64: Bool) returns I32 {
    mut uc := user_c_path
    mut lf := link_flags
    mut ifl := include_flags
    if uc.len() == 0 { uc = "" }
    if lf.len() == 0 { lf = "" }
    if ifl.len() == 0 { ifl = "" }

    mut compiler := cc_override
    if compiler.len() == 0 { compiler = toolchain_command(target, Lang.C) }
    extra := toolchain_extra_args(target)

    // ASAN builds run under the same full -Werror as non-ASAN. Historically
    // -fsanitize=address inserted __asan_* hooks that mutated the CFG enough
    // that GCC could no longer prove an exhaustive switch/if never falls off
    // the end of a non-void function, mis-firing -Werror=return-type (issue
    // #240 demoted just that check with -Wno-error=return-type). The emitter
    // now closes every diverging non-void body with __builtin_unreachable()
    // (see stmt_always_diverges / emit_diverge_terminator), so GCC no longer needs
    // to prove it and the false positive is gone -- return-type is a real
    // error again under ASAN too, still catching a genuinely missing return.
    werr := " -Werror"
    mut asan_flags := ""
    if asan {
        asan_flags = " -fsanitize=address -fno-omit-frame-pointer"
    }
    // --usize=64 (issue #309): opt back into U64 container fields in the
    // emitted C (U32 is the default). No flag needed for the U32 default.
    mut usize_flags := ""
    if usize64 { usize_flags = " -DTIL_USIZE64" }

    // Extract directory from ext_c_path for -I flag
    mut ext_dir := "."
    slash := ext_c_path.rfind("/")
    if slash >= 0 { ext_dir = ext_c_path.substr(0, slash.to_usize()).clone() }

    // Compile library .c to object
    obj_path := format("gen/lib/", lib_name, ".o")
    mut cmd := compiler.format(extra, werr, asan_flags, usize_flags, " -fPIC -I", ext_dir,
        " -c ", c_path, " -o ", obj_path)
    mut result := system_cmd(cmd)
    if result != 0 {
        println("error: library compilation failed")
        return 1
    }

    // Compile ext.c to object
    ext_obj := "gen/lib/ext.o"
    cmd = compiler.format(extra, werr, asan_flags, usize_flags, " -fPIC -I", ext_dir,
        " -c ", ext_c_path, " -o ", ext_obj)
    result = system_cmd(cmd)
    if result != 0 {
        println("error: ext.c compilation failed")
        return 1
    }

    // Compile user .c to object if present
    mut user_obj := ""
    if uc.len() > 0 {
        user_obj = "gen/lib/user.o"
        cmd = compiler.format(extra, werr, asan_flags, usize_flags, " -fPIC -I", ext_dir, ifl,
            " -c ", uc, " -o ", user_obj)
        result = system_cmd(cmd)
        if result != 0 {
            println("error: user .c compilation failed")
            return 1
        }
    }

    // Create shared library
    so_path := format("gen/lib/lib", lib_name, shared_lib_extension(target))
    // extra carries the -target triple: without it the -shared link
    // drives the HOST toolchain and (for mac cross) ELF lld rejects the
    // Mach-O objects with "unknown file type". No -Werror here, so the
    // compile-only flags inside extra are harmless on this link line.
    cmd = compiler.format(extra, asan_flags, target_link_extra_args(target), " -shared -o ", so_path,
        " ", obj_path, " ", ext_obj,
        " ", user_obj, lf)
    result = system_cmd(cmd)
    if result != 0 {
        println("error: shared library creation failed")
        return 1
    }

    // Create static library
    a_path := format("gen/lib/lib", lib_name, ".a")
    cmd = format("ar rcs ", a_path,
        " ", obj_path, " ", ext_obj,
        " ", user_obj)
    result = system_cmd(cmd)
    if result != 0 {
        println("error: static library creation failed")
        return 1
    }

    return 0
}

priv is_gui_auto_import := func(auto_import: Str) returns Bool {
    return auto_import.eq("gui").or(auto_import.eq("src/modes/gui")).or(auto_import.ends_with("/gui"))
}

// Resolve the archive paths in a target-data flag string (issue #348).
// targets.til spells its archives cwd-relative ("vendor/raylib/src/
// libraylib.a"), which is only a real place inside a repo checkout; an
// INSTALLED til runs from the user's project directory, where those
// tokens reach the linker unresolved. Same candidate order as the
// loader's resolve_link_path: the cwd spelling wins when it exists (a
// checkout's vendor/ keeps shadowing any installed one), then the
// compiler root (<prefix>/lib/til, derived from ext_c_path exactly like
// the loader's root_dir), and an archive found in neither keeps its
// name and fails loudly at link. Only ".a" tokens are touched: -l /
// -framework / -s flags and the shell-expanded *.tbd glob pass through.
priv resolve_target_archives := proc(flags: Str, ext_c_path: Str) returns Str {
    if flags.find(".a").lt(0) { return flags }
    root := ext_c_path.strip_suffix("/src/c/ext.c")
    mut out := ""
    for tok : Str in flags.split(" ") {
        if tok.len() == 0 { continue }
        mut resolved := tok.clone()
        if tok.ends_with(".a").and(File.is_absolute(tok).not()) {
            if realpath_str(tok).len() == 0 {
                root_candidate := format(root, "/", tok)
                if realpath_str(root_candidate).len() > 0 { resolved = root_candidate }
            }
        }
        if out.len() > 0 { out = format(out, " ") }
        out = format(out, resolved)
    }
    return out
}

priv compile_c := proc(c_path: Str, bin_path: Str, ext_c_path: Str, user_c_path: Str, link_flags: Str, include_flags: Str, target: Target, cc_override: Str, mode_auto_import: Str, asan: Bool, prof: Bool, usize64: Bool) returns I32 {
    mut uc := user_c_path
    mut lf := link_flags
    mut ifl := include_flags
    if uc.len() == 0 { uc = "" }
    if lf.len() == 0 { lf = "" }
    if ifl.len() == 0 { ifl = "" }

    wasm_gui := target.is(Target.Wasm32).and(is_gui_auto_import(mode_auto_import))
    mut compiler := cc_override
    if compiler.len() == 0 {
        if wasm_gui { compiler = "emcc" }
        else { compiler = toolchain_command(target, Lang.C) }
    }
    mut extra := toolchain_extra_args(target)
    if wasm_gui {
        // emcc (clang-based) needs the emscripten -s link/runtime flags on
        // top of the warning flags; no -Wno-* suppressions here either.
        extra = " -Wall -Wextra -sUSE_GLFW=3 -sASYNCIFY -sALLOW_MEMORY_GROWTH=1"
    }

    // ASAN builds run under the same full -Werror as non-ASAN (single cc
    // invocation, so the flags cover compile and link in one go).
    // -fsanitize=address used to mutate the CFG enough that GCC mis-fired
    // -Werror=return-type on exhaustive non-void functions (issue #240
    // demoted it with -Wno-error=return-type). The emitter now terminates
    // every diverging non-void body with __builtin_unreachable() (see
    // stmt_always_diverges / emit_diverge_terminator), so the false positive is
    // gone and return-type stays a hard error under ASAN too.
    werr := " -Werror"
    mut asan_flags := ""
    if asan {
        asan_flags = " -fsanitize=address -fno-omit-frame-pointer"
    }

    // --prof: -finstrument-functions makes gcc emit __cyg_profile_func_enter/
    // exit hooks at every function boundary; the runtime that accumulates and
    // reports per-function counts/time lives in src/c/ext.c. Linux/-rdynamic
    // only (the ext.c runtime is #ifndef _WIN32), so skip it for Windows.
    // The exit hook is appended on the return path, which used to make gcc
    // mis-fire -Werror=return-type ("control reaches end of non-void
    // function") the same way ASAN did. The emitter now closes every diverging
    // non-void body with __builtin_unreachable() (see stmt_always_diverges /
    // emit_diverge_terminator), so gcc no longer needs to prove it and prof
    // builds keep the full -Werror -- return-type stays a hard error.
    //
    // For the allocation profile, -DTIL_PROF_ALLOC turns on the wrap hooks in
    // ext.c and -Wl,--wrap=malloc/calloc/realloc (link-only) routes heap
    // allocation through them. asan owns malloc, so the wrap is skipped when
    // both are set; CPU profiling still works.
    mut prof_flags := ""
    mut prof_link_flags := ""
    if prof.and(is_windows_target(target).not()) {
        prof_flags = " -finstrument-functions"
        if asan.not() {
            prof_flags = format(prof_flags, " -DTIL_PROF_ALLOC")
            prof_link_flags = " -Wl,--wrap=malloc -Wl,--wrap=calloc -Wl,--wrap=realloc"
        }
    }

    // --usize=64 (issue #309): -DTIL_USIZE64 makes ext.h typedef USize as
    // U64 (opting out of the U32 default), so the emitted program's container
    // fields match the U64 layout the compiler used at typecheck/constfold.
    // The generated .c and ext.c are compiled in one cc invocation below, so
    // a single define covers both. The U32 default needs no flag.
    mut usize_flags := ""
    if usize64 { usize_flags = " -DTIL_USIZE64" }

    // Extract directory from ext_c_path for -I flag
    mut ext_dir := "."
    slash := ext_c_path.rfind("/")
    if slash >= 0 { ext_dir = ext_c_path.substr(0, slash.to_usize()).clone() }

    // If link_c files present, compile each to .o separately with -include forward.h
    mut user_part := ""
    if uc.len() > 0 {
        c_slash := c_path.rfind("/")
        mut c_dir := "."
        if c_slash >= 0 { c_dir = c_path.substr(0, c_slash.to_usize()).clone() }
        c_dot := c_path.rfind(".")
        mut c_base := c_path
        if c_dot > c_slash { c_base = c_path.substr(0, c_dot.to_usize()) }
        fwd_path := c_base.format("_forward.h")

        // Split space-separated link_c files and compile each individually
        files : Vec(Str) = uc.split(" ")
        mut all_objs := ""
        for fi in 0..files.len() {
            ref file : Str = files[fi]
            if file.len() == 0 { continue }
            user_obj := c_dir.format("/user_", fi.to_str(), ".o")

            // Skip -include forward.h for src/c/ files
            mut fwd_flag := format(" -include ", fwd_path)
            if file.starts_with("src/c/") { fwd_flag = " -Isrc/c -Iboot" }
            obj_cmd := compiler.format(extra, werr, asan_flags, prof_flags, usize_flags, " -I", ext_dir,
                fwd_flag, ifl, " -c ", file,
                " -o ", user_obj)

            obj_result := system_cmd(obj_cmd)
            if obj_result != 0 {
                println(format("error: link_c compilation failed for ", file))
                return 1
            }
            all_objs = all_objs.format(" ", user_obj)
        }
        user_part = all_objs
    }

    // -rdynamic (Linux/ELF) puts every symbol in the dynamic symbol
    // table so the interpreter's ffi_global_symbol can dlsym(RTLD_DEFAULT)
    // the exe's own statically-linked symbols (the libffi ffi_type_*
    // globals, the ext.c primitives, the libc bindings) at runtime.
    // mingw's equivalent is -Wl,--export-all-symbols: without it a PE has
    // NO export table, GetProcAddress finds nothing, ffi_type_ref returns
    // NULL and ffi_prep_cif faults -- which is exactly what blocked
    // windows AS A HOST (til.exe running the interpreter/constfolder) and
    // any cross-built program that calls ext_func at runtime (issue #25).
    // wasm has no runtime symbol table / FFI, so it stays bare.
    mut dyn_flag := " -rdynamic"
    if is_windows_target(target) { dyn_flag = " -Wl,--export-all-symbols" }
    if target.is(Target.Wasm32) { dyn_flag = "" }

    // For Windows/wasm and 32-bit-linux cross-compiles, rewrite
    // link_flags inherited from vendor/bindings/{raylib,tinyfd}.til
    // link() directives: they carry HOST-arch archive paths (and, for
    // windows, POSIX-only -l flags; mingw doesn't ship -ldl/-lrt and
    // can't load Linux ELF .a files -- a 32-bit linux link can't load
    // the 64-bit archives either). The per-target variants are added
    // via target_gui_libs / target_ffi_lib / target_system_libs below.
    // For macOS targets the vendored .a paths are correct as-is on a
    // mac host (native archives at the same paths) and loudly
    // wrong-arch on cross hosts, so they stay; every -l flag the tree
    // uses is a libSystem alias on darwin (m, pthread, dl) or does not
    // exist there (rt, atomic).
    //
    // The rewrite is TOKEN-level, never substring replace: the loader
    // resolves link() paths importer-relative, so lf can carry the
    // same archive as an ABSOLUTE path (that is how til.til's own
    // windows cross-link got a dangling "/repo/root/" token when the
    // relative substring was stripped out of it, and how a dangling
    // ./src/self/ token once reached the mac linker). Matching whole
    // tokens by suffix drops both spellings; anything unrecognized is
    // kept and fails loudly at link with its real name.
    // 32-bit linux targets cross-compiled from a 64-bit host: the
    // inherited 64-bit archives must go (target_gui_libs supplies the
    // -x86/-arm32 variants); the dropped -l flags come back via
    // target_system_libs, which lists them all for linux targets.
    is_linux32 := target.is(Target.LinuxX86).or(target.is(Target.LinuxArm32)).or(target.is(Target.LinuxRiscv32))
    if is_windows_target(target).or(target.is(Target.Wasm32)).or(is_linux32)
        .or(target.is(Target.MacosX64)).or(target.is(Target.MacosArm64)) {
        // On macos the archive paths stay (native archives live at the
        // same paths on a mac host) and -latomic must go (no such lib
        // on darwin). On windows/wasm the linux archives go and
        // -latomic stays (mingw ships libatomic); 32-bit linux keeps
        // -latomic too (multilib ships it).
        is_macos := target.is(Target.MacosX64).or(target.is(Target.MacosArm64))
        is_win := is_windows_target(target)
        tokens := lf.split(" ")
        mut new_lf := ""
        mut has_nng := false
        for t : Str in tokens {
            if t.len() == 0 { continue }
            if t.eq("-ldl").or(t.eq("-lrt")).or(t.eq("-lpthread")).or(t.eq("-lm")) { continue }
            // -latomic: nonexistent on darwin, and nng's linux-only dep
            // that the mingw nng build does not need either.
            if is_macos.or(is_win).and(t.eq("-latomic")) { continue }
            if is_macos.not() {
                if t.ends_with("libraylib.a").or(t.ends_with("libtinyfd.a")) { continue }
            }
            // Windows nng: swap the linux libnng.a (from nng_base.til's
            // link()) for the mingw cross-build; remember to append the
            // winsock libs. nng needs the C11 timespec_get, which msvcrt
            // lacks -- but we build nng against msvcrt anyway and supply
            // timespec_get from ext.c's shim (see the Makefile NNG_WIN_LIB
            // rule). We must NOT add -lucrtbase here: it would pull
            // ucrtbase.dll in beside mingw's msvcrt.dll startup, and that
            // dual-CRT binary fails to load on real Windows (issue #25 --
            // the windows-host exit-127 that wine masked).
            if is_win.and(t.ends_with("libnng.a")) {
                has_nng = true
                new_lf = new_lf.format(" vendor/nng/build-win64/libnng.a")
                continue
            }
            new_lf = new_lf.format(" ", t)
        }
        if has_nng { new_lf = new_lf.format(" -lws2_32 -lmswsock -ladvapi32") }
        lf = new_lf
    }
    if wasm_gui { lf = "" }

    // Per-target system + ffi + (gui) link flags. Tables in
    // src/self/targets.til. mode_auto_import points at gui iff the program
    // declared mode gui.
    sys_libs := target_system_libs(target)
    // Per-target libffi archives exist only where a matching host built
    // them (the Makefile keeps stable-path copies on native mac and
    // native arm64-linux hosts). Cross hosts do not have them, and
    // programs that never call ext_func at runtime do not need them, so
    // link the archive only when it is actually present. Whether the
    // PROGRAM needs it is decided by the generated C itself: nothing in
    // src/c/ext.c references libffi, so ffi_* calls appear only when
    // the emitted code carries runtime FFI dispatch (the compiler's own
    // interpreter, or a program importing the libffi binding). A
    // missing archive such a program needs used to be dropped silently
    // here and surface as a screenful of unresolved-ffi_* linker
    // errors; now it is checked BEFORE the link and reported with the
    // path and the command that builds it. The scan only runs on the
    // missing-archive path, so ordinary builds read nothing extra.
    mut ffi_lib := resolve_target_archives(target_ffi_lib(target), ext_c_path)
    if ffi_lib.len().gt(0).and(realpath_str(ffi_lib).len().eq(0)) {
        if File.readfile(c_path).contains("ffi_prep_cif") {
            println(format("error: the generated C calls libffi (runtime ext_func dispatch), and this target's libffi archive is not built: ", ffi_lib))
            println(format("  build it first: ", target_ffi_build_hint(target)))
            return 1
        }
        ffi_lib = ""
    }
    mut gui_part := ""
    if is_gui_auto_import(mode_auto_import) {
        gui_part = format(" ", resolve_target_archives(target_gui_libs(target), ext_c_path))
    }

    cmd := compiler.format(extra, werr, asan_flags, prof_flags, usize_flags, prof_link_flags, target_link_extra_args(target), " -g", dyn_flag, " -I", ext_dir,
        " -o ", bin_path, " ", c_path,
        " ", ext_c_path, user_part, lf,
        " ", ffi_lib, gui_part, " ", sys_libs)

    result := system_cmd(cmd)
    if result != 0 {
        println("error: C compilation failed")
        return 1
    }
    return 0
}

priv check_jdk17 := proc(root: Str, classes_dir: Str) returns I32 {
    probe_source := format(root, "/src/TilJdk17Probe.java")
    probe_class := format(classes_dir, "/TilJdk17Probe.class")
    probe_jar := format(root, "/jdk17-probe.jar")
    File.writefile(probe_source, format(
        "public final class TilJdk17Probe {\n",
        "    private TilJdk17Probe() {}\n",
        "    public static void main(String[] args) {}\n",
        "}\n"))

    mut result := system_cmd(format("javac --release 17 -encoding UTF-8 -g -proc:none -Xlint:all -Werror -d '", classes_dir, "' '", probe_source, "'"))
    File.remove(probe_source)
    if result != 0 {
        println("error: JVM target requires 'javac' with Java 17 --release support")
        return 1
    }

    result = system_cmd(format("jar --create --file '", probe_jar, "' -C '", classes_dir, "' TilJdk17Probe.class"))
    if result != 0 {
        File.remove(probe_class)
        println("error: JVM target requires the Java 17 'jar' tool")
        return 1
    }

    result = system_cmd(format("java -Xverify:all -cp '", probe_jar, "' TilJdk17Probe"))
    File.remove(probe_class)
    File.remove(probe_jar)
    if result != 0 {
        println("error: JVM target requires a Java 17 or newer 'java' runtime")
        return 1
    }
    return 0
}

priv compile_jvm := proc(root: Str, args_path: Str, classes_dir: Str,
    jar_path: Str, entry_class: Str) returns I32 {
        File.remove_tree(classes_dir)
        if mkdir_p(classes_dir) != 0 { panic("failed to create JVM classes output dir") }
        mut result := check_jdk17(root, classes_dir)
        if result != 0 { return result }

        result = system_cmd(format("javac --release 17 -encoding UTF-8 -g -proc:none -Xlint:all -Werror -d '", classes_dir, "' @'", args_path, "'"))
        if result != 0 {
            println("error: Java compilation failed")
            return 1
        }
        result = system_cmd(format("jar --create --file '", jar_path,
            "' --main-class '", entry_class, "' -C '", classes_dir, "' ."))
        if result != 0 {
            println("error: JAR creation failed")
            return 1
        }
        return 0
}

priv BuildPaths := struct {
    name := ""
    c_path := ""
    bin_path := ""
    fwd_path := ""
    h_path := ""
    til_path := ""
    py_path := ""
    jvm_root := ""
    jvm_source_path := ""
    jvm_classes_dir := ""
    jvm_args_path := ""
    jvm_package := ""
    jvm_entry_class := ""
    do_lib := false
}

priv derive_build_paths := func(lp: LoadedProgram, custom_bin: Str, custom_c: Str, target: Target) returns BuildPaths {
    mut paths := BuildPaths()

    last_slash := lp.path.rfind("/")
    mut basename := lp.path
    if last_slash >= 0 {
        last_slash_u : USize = last_slash.to_usize()
        basename = lp.path.substr(last_slash_u + 1, lp.path.len().sub(last_slash_u) - 1)
    }
    mut name_len := basename.len()
    if basename.ends_with(".til") {
        name_len = name_len - 4
    }
    name := basename.substr(0, name_len)
    paths.name = name.clone()

    if target.is(Target.Jvm) {
        segment := jvm_package_segment(name)
        paths.jvm_root = format("gen/jvm/", name)
        paths.jvm_package = format("til.generated.", segment)
        paths.jvm_source_path = format(paths.jvm_root,
            "/src/til/generated/", segment, "/Main.java")
        paths.jvm_classes_dir = format(paths.jvm_root, "/classes")
        paths.jvm_args_path = format(paths.jvm_root, "/sources.args")
        paths.jvm_entry_class = format(paths.jvm_package, ".Main")
        paths.bin_path = format("bin/", name, ".jar")
        if custom_bin.len() > 0 { paths.bin_path = custom_bin.clone() }
        paths.do_lib = lp.cur_mode.is_library
        return paths
    }

    mut source_ext := ".c"
    if target_lang(target).is(Lang.HolyC) { source_ext = ".HC" }
    mut c_path := format("gen/til/", name, source_ext)
    if custom_c.len() > 0 { c_path = custom_c.clone() }
    mut ext := executable_extension(target)
    if target.is(Target.Wasm32).and(is_gui_auto_import(lp.cur_mode.auto_import)) { ext = ".html" }
    mut bin_path := format("bin/", name, ext)
    if custom_bin.len() > 0 { bin_path = custom_bin.clone() }

    paths.c_path = c_path
    paths.bin_path = bin_path
    if target_lang(target).is(Lang.C) { paths.fwd_path = forward_header_path(c_path) }
    paths.h_path = format("gen/til/", name, ".h")
    paths.til_path = format("gen/til/", name, ".til")
    paths.py_path = format("gen/til/", name, ".py")
    paths.do_lib = lp.cur_mode.is_library
    return paths
}

priv make_build_dirs := proc(paths: BuildPaths, target: Target) {
    if target.is(Target.Jvm) {
        src_slash := paths.jvm_source_path.rfind("/")
        src_dir := paths.jvm_source_path.substr(0, src_slash.to_usize())
        if mkdir_p(src_dir) != 0 { panic("failed to create JVM source output dir") }
        if mkdir_p(paths.jvm_classes_dir) != 0 { panic("failed to create JVM classes output dir") }
        if paths.do_lib.not() {
            bin_slash := paths.bin_path.rfind("/")
            mut bin_dir := "bin"
            if bin_slash > 0 { bin_dir = paths.bin_path.substr(0, bin_slash.to_usize()) }
            if mkdir_p(bin_dir) != 0 { panic("failed to create JAR output dir") }
        }
        return
    }
    // The .c / _forward.h pair is written for EVERY mode, to c_path and to
    // the fwd_path derived from it, so its directory has to exist whatever
    // the mode is. The library branch used to create only gen/til + gen/lib
    // and skip this, so `translate -c gen/c/x.c <a library>` died on
    // `cfile_open: could not open 'gen/c/x_forward.h'` unless some other
    // build had already made gen/c. In the suite that is a scheduling
    // accident: pure_no_unbuilt_variant_ctor (library) passes only when a
    // non-library `-c gen/c/...` test happens to run first.
    cp_slash := paths.c_path.rfind("/")
    mut cp_dir := "gen/til"
    if cp_slash > 0 {
        cp_slash_u : USize = cp_slash.to_usize()
        cp_dir = paths.c_path.substr(0, cp_slash_u)
    }
    if mkdir_p(cp_dir) != 0 { panic("failed to create build output dir") }
    if paths.do_lib {
        if mkdir_p("gen/til") != 0 { panic("failed to create gen/til") }
        if mkdir_p("gen/lib") != 0 { panic("failed to create gen/lib") }
    } else {
        bp_slash := paths.bin_path.rfind("/")
        mut bp_dir := "bin"
        if bp_slash > 0 {
            bp_slash_u : USize = bp_slash.to_usize()
            bp_dir = paths.bin_path.substr(0, bp_slash_u)
        }
        if mkdir_p(bp_dir) != 0 { panic("failed to create binary output dir") }
    }
}

priv translate_ast := proc(mut lp: LoadedProgram, paths: BuildPaths, target: Target) returns I32 {
    lang := target_lang(target)
    if lang.is(Lang.Java) {
        return jvm_codegen_translate(lp, paths.jvm_source_path,
            paths.jvm_args_path, paths.jvm_package)
    }
    if lang.is(Lang.HolyC) {
        return c_codegen_translate_holyc(lp, paths.c_path)
    }
    return c_codegen_translate_outputs(lp, paths.c_path, paths.fwd_path,
        paths.h_path, paths.til_path, paths.py_path, paths.name, paths.do_lib)
}

priv print_translate_success := proc(paths: BuildPaths, target: Target) {
    if target.is(Target.Jvm) {
        println(format("Generated: ", paths.jvm_source_path))
        println(format("Generated: ", paths.jvm_args_path))
        return
    }
    println(format("Generated: ", paths.c_path))
    if paths.fwd_path.len() > 0 { println(format("Generated: ", paths.fwd_path)) }
    if paths.do_lib {
        println(format("Generated: ", paths.h_path))
        println(format("Generated: ", paths.til_path))
        println(format("Generated: ", paths.py_path))
    }
}

priv compile_ast := proc(lp: LoadedProgram, paths: BuildPaths, target: Target, cc_override: Str, asan: Bool, prof: Bool) returns I32 {
    lang := target_lang(target)
    if lang.is(Lang.Java) {
        return compile_jvm(paths.jvm_root, paths.jvm_args_path,
            paths.jvm_classes_dir, paths.bin_path, paths.jvm_entry_class)
    }
    if lang.is(Lang.HolyC) {
        println("error: HolyC output must be compiled and run inside TempleOS; use 'translate --target=templeos'")
        return 1
    }
    // --usize=64 (issue #309): pass -DTIL_USIZE64 to cc so the emitted C's
    // container widths match the U64 alias width used at typecheck/constfold
    // (the opt-out from the U32 default; the default needs no flag).
    usize64 := lp.usize_override_bits.eq(64)
    if paths.do_lib {
        return compile_lib(paths.c_path, paths.name, lp.ext_c_path, lp.link_c_paths, lp.link_flags, lp.include_flags, target, cc_override, asan, usize64)
    }
    return compile_c(paths.c_path, paths.bin_path, lp.ext_c_path, lp.link_c_paths, lp.link_flags, lp.include_flags, target, cc_override, lp.cur_mode.auto_import, asan, prof, usize64)
}

cmd_translate := proc(mut lp: LoadedProgram, custom_c: Str, target: Target) returns I32 {
    paths := derive_build_paths(lp, "", custom_c, target)
    make_build_dirs(paths, target)
    result := translate_ast(lp, paths, target)
    if result == 0 { print_translate_success(paths, target) }
    return result
}

cmd_build := proc(mut lp: LoadedProgram, custom_bin: Str, custom_c: Str, target: Target, cc_override: Str, asan: Bool, prof: Bool) returns I32 {
    paths := derive_build_paths(lp, custom_bin, custom_c, target)
    make_build_dirs(paths, target)
    mut result := translate_ast(lp, paths, target)
    if result == 0 { result = compile_ast(lp, paths, target, cc_override, asan, prof) }
    if result.eq(0).and(paths.do_lib) {
        print_translate_success(paths, target)
        println(format("Generated: gen/lib/lib", paths.name, shared_lib_extension(target)))
        println(format("Generated: gen/lib/lib", paths.name, ".a"))
    }
    return result
}

priv default_install_prefix := proc() returns Str {
    if host_os() == "windows" {
        return "C:/Program Files/til"
    }
    return "/usr/local"
}

priv check_install_rc := proc(rc: I32, what: Str) returns I32 {
    if rc != 0 {
        println(format("error: failed to ", what))
        return 1
    }
    return 0
}

priv builder_compiler_root := func(lp: LoadedProgram) returns Str {
    return lp.ext_c_path.strip_suffix("/src/c/ext.c")
}

priv support_root := func(prefix: Str) returns Str {
    return format(prefix, "/lib/til")
}

priv install_file := proc(src: Str, dst: Str, what: Str) returns I32 {
    return check_install_rc(copy_file(src, dst), what)
}

priv install_tree := proc(src: Str, dst: Str, what: Str) returns I32 {
    return check_install_rc(copy_tree(src, dst), what)
}

priv is_compiler_install := func(lp: LoadedProgram, paths: BuildPaths) returns Bool {
    if paths.name.eq("til").not() { return false }
    if lp.path.eq("src/til.til").or(lp.path.eq("./src/til.til")) { return true }
    return lp.path.ends_with("/src/til.til")
}

priv install_compiler_support := proc(lp: LoadedProgram, prefix: Str) returns I32 {
    root := builder_compiler_root(lp)
    dst_root := support_root(prefix)
    mut rc := install_tree(format(root, "/src/core"), format(dst_root, "/src/core"), "install compiler core sources")
    if rc != 0 { return rc }
    rc = install_tree(format(root, "/src/std"), format(dst_root, "/src/std"), "install compiler std sources")
    if rc != 0 { return rc }
    // There is no top-level lib/ to install. It held six example-only
    // modules (alphabeta, cell, fonts, music, svg, the custom_modes
    // preludes) and moved to examples/lib/ -- nothing in src/ ever
    // imported them, so the installed compiler needs neither the old
    // path nor the new one. The move updated the Makefile, the tests and
    // the examples but not this line, and copy_tree of a directory that
    // does not exist fails, so every `make install` since has stopped
    // here with "failed to install compiler library sources" AFTER
    // planting the binary. What an installed til actually needs is the
    // source it compiles against: core, std, modes, the C runtime and
    // boot.
    rc = install_tree(format(root, "/src/modes"), format(dst_root, "/src/modes"), "install compiler mode sources")
    if rc != 0 { return rc }
    rc = install_tree(format(root, "/src/c"), format(dst_root, "/src/c"), "install compiler C sources")
    if rc != 0 { return rc }
    rc = install_tree(format(root, "/boot"), format(dst_root, "/boot"), "install compiler boot files")
    if rc != 0 { return rc }
    // What `mode gui` stands on (issue #348). src/modes/gui.til imports
    // ../../vendor/bindings/{raylib,tinyfd} and links the vendored
    // archives, and resolve_link_path's compiler-root candidate already
    // finds both under dst_root -- IF they are installed at their
    // source-relative paths. The bindings are the whole directory (small
    // text, and a custom mode may import any of them); the archives are
    // exactly the two gui links, each with the .so twin the interpreter
    // dlopens for repl/interpreted FFI. The archives are build products,
    // so require them prebuilt and fail loudly pointing at the build --
    // installing a compiler whose gui mode cannot load is how this issue
    // happened.
    rc = install_tree(format(root, "/vendor/bindings"), format(dst_root, "/vendor/bindings"), "install compiler FFI bindings")
    if rc != 0 { return rc }
    for lib : Str in gui_link_artifacts() {
        src_path := format(root, "/", lib)
        if cfile_exists(src_path).not() {
            println(format("error: '", src_path, "' is missing -- mode gui needs it; build the vendored libraries first (make, or bin/make vendor)"))
            return 1
        }
        rc = install_file(src_path, format(dst_root, "/", lib), format("install ", lib))
        if rc != 0 { return rc }
    }
    rc = install_tree(format(root, "/doc/gen"), format(dst_root, "/doc/gen"), "install generated compiler documentation")
    if rc != 0 { return rc }
    return 0
}

// The vendored artifacts an installed `mode gui` build/interpret needs,
// at their source-relative paths: each linked archive plus its
// dlopen-able twin (see ffi_load_archive_twin -- the twin sits beside
// the archive, and resolve_link_path finds both under the install
// root). nng stays out: the server modes are --extra-modes user files
// (examples/custom_modes.til), not installed built-ins.
priv gui_link_artifacts := func() returns Vec(Str) {
    mut out := Vec(Str).new()
    out.push(own "vendor/raylib/src/libraylib.a")
    out.push(own "vendor/raylib/src/libraylib.so")
    out.push(own "vendor/tinyfiledialogs/libtinyfd.a")
    out.push(own "vendor/tinyfiledialogs/libtinyfd.so")
    return out
}

priv print_install_success := proc(path: Str) {
    println(format("Installed: ", path))
}

cmd_install := proc(mut lp: LoadedProgram, install_prefix_in: Str, target: Target, cc_override: Str, asan: Bool, prof: Bool) returns I32 {
    mut install_prefix := install_prefix_in
    if install_prefix.len() == 0 {
        install_prefix = default_install_prefix()
    }

    paths := derive_build_paths(lp, "", "", target)
    make_build_dirs(paths, target)
    mut result := translate_ast(lp, paths, target)
    if result == 0 { result = compile_ast(lp, paths, target, cc_override, asan, prof) }
    if result != 0 { return result }

    if target.is(Target.Jvm) {
        jar_dst := format(install_prefix, "/bin/", paths.name, ".jar")
        result = install_file(paths.bin_path, jar_dst, "install JAR")
        if result == 0 { print_install_success(jar_dst) }
        return result
    }

    if paths.do_lib {
        so_dst := format(install_prefix, "/lib/lib", paths.name, shared_lib_extension(target))
        a_dst := format(install_prefix, "/lib/lib", paths.name, ".a")
        h_dst := format(install_prefix, "/include/", paths.name, ".h")
        til_dst := format(support_root(install_prefix), "/lib/", paths.name, ".til")
        py_dst := format(support_root(install_prefix), "/lib/", paths.name, ".py")

        result = install_file(format("gen/lib/lib", paths.name, shared_lib_extension(target)), so_dst, "install shared library")
        if result == 0 { result = install_file(format("gen/lib/lib", paths.name, ".a"), a_dst, "install static library") }
        if result == 0 { result = install_file(paths.h_path, h_dst, "install C header") }
        if result == 0 { result = install_file(paths.til_path, til_dst, "install til binding") }
        if result == 0 { result = install_file(paths.py_path, py_dst, "install Python binding") }
        if result == 0 {
            print_install_success(so_dst)
            print_install_success(a_dst)
            print_install_success(h_dst)
            print_install_success(til_dst)
            print_install_success(py_dst)
        }
        return result
    }

    bin_dst := format(install_prefix, "/bin/", paths.name, executable_extension(target))
    result = install_file(paths.bin_path, bin_dst, "install executable")
    if result != 0 { return result }
    print_install_success(bin_dst)

    if is_compiler_install(lp, paths) {
        result = install_compiler_support(lp, install_prefix)
        if result != 0 { return result }
        print_install_success(support_root(install_prefix))
    }
    return 0
}

// Prefix used when spawning a child binary that was just built with --asan.
// til may itself be running under ASAN with detect_leaks=0 (the asan_safe_cmd
// wrap in tests.til, used to suppress the compiler's own known leaks). Without
// this override the child process tree inherits detect_leaks=0 and the
// compiled binary's leak check is silently skipped. Forcing detect_leaks=1
// keeps the child's leak detection on regardless of how the compiler was
// invoked, so `til run --asan` / `til test --asan` are self-contained.
// Apple's ASAN runtime has no LeakSanitizer: a process started with
// detect_leaks=1 dies in __asan::InitializeFlags() before reaching main
// (SIGABRT at dyld init -- this killed every run-phase test of the first
// mac ASAN suite, issue #25). Pass an explicit =0 there so children still
// get a deterministic setting; leak checking on darwin needs Apple's
// `leaks` tooling instead.
priv asan_child_prefix := proc(asan: Bool) returns Str {
    if asan {
        if host_os() == "macos" { return "ASAN_OPTIONS=detect_leaks=0 " }
        return "ASAN_OPTIONS=detect_leaks=1 "
    }
    return ""
}

priv run_artifact := proc(paths: BuildPaths, user_argv: Vec(Str),
    target: Target, asan: Bool) returns I32 {
        mut cmd := ""
        if target.is(Target.Jvm) {
            cmd = format("java -Xverify:all -jar '", paths.bin_path, "'")
        } else {
            cmd = format(asan_child_prefix(asan), paths.bin_path)
        }
        for uarg : Str in user_argv {
            cmd = cmd.format(" '", uarg, "'")
        }
        return system_cmd(cmd)
}

cmd_run := proc(mut lp: LoadedProgram, custom_bin: Str, custom_c: Str, user_argv: Vec(Str), target: Target, cc_override: Str, asan: Bool, prof: Bool) returns I32 {
    if lp.cur_mode.is_library {
        panic("cannot run a library -- use translate or build")
    }
    paths := derive_build_paths(lp, custom_bin, custom_c, target)
    make_build_dirs(paths, target)
    mut result := translate_ast(lp, paths, target)
    if result == 0 { result = compile_ast(lp, paths, target, cc_override, asan, prof) }
    if result == 0 {
        result = run_artifact(paths, user_argv, target, asan)
    }
    return result
}

// Compile and run a test binary. Forces do_lib=false so library-mode
// files still produce an executable -- emit_test_main is gated on
// lp.run_tests, so the C output has a real main().
cmd_test_build_run := proc(mut lp: LoadedProgram, custom_bin: Str, custom_c: Str, target: Target, cc_override: Str, asan: Bool, prof: Bool) returns I32 {
    mut paths := derive_build_paths(lp, custom_bin, custom_c, target)
    paths.do_lib = false
    make_build_dirs(paths, target)
    mut result := translate_ast(lp, paths, target)
    if result == 0 { result = compile_ast(lp, paths, target, cc_override, asan, prof) }
    if result == 0 {
        empty_argv := Vec(Str).new()
        result = run_artifact(paths, empty_argv, target, asan)
    }
    return result
}

// --- til doc <path> -- documentation generator ---

DocEntry := struct {
    name := ""
    id := ""
    unit_path := ""
    group := ""
    page := ""
    body := ""
    info := ""
    since := ""
    deprecated := ""
}

DocCatalog := struct {
    entries := Vec(DocEntry).new()
}

priv doc_decl_hidden := func(dd: Declaration, meta: DocMeta) returns Bool {
    return dd.name.starts_with("hoisted__")
        .or(dd.name.starts_with("priv___"))
        .or(dd.is_priv)
        .or(meta.hidden)
}

priv doc_index_link_path := func(out_path: Str) returns Str {
    if out_path.starts_with("doc/gen/") { return out_path.strip_prefix("doc/gen/").clone() }
    return out_path.clone()
}

priv doc_unit_path_normalized := func(unit_path: Str) returns Str {
    mut path := unit_path.clone()
    if path.starts_with("./") { path = path.strip_prefix("./").clone() }
    return path
}

priv doc_unit_key := func(unit_path: Str) returns Str {
    mut key := doc_unit_path_normalized(unit_path)
    if key.ends_with(".til") { key = key.strip_suffix(".til").clone() }
    key = key.replace("/", ".")
    return key
}

priv doc_entry_id := func(unit_path: Str, name: Str) returns Str {
    return format("til.", doc_unit_key(unit_path), ".", name)
}

priv doc_default_group := func(unit_path: Str) returns Str {
    path := doc_unit_path_normalized(unit_path)
    if path.starts_with("src/core/") { return "Core" }
    if path.starts_with("src/std/") { return "Standard library" }
    if path == "src/til.til" { return "CLI" }
    if path.starts_with("vendor/bindings/") { return "Vendor bindings" }
    return match path {
    case "src/self/lexer.til", "src/self/parser.til", "src/self/context.til",
         "src/self/modes.til", "src/self/loader.til", "src/self/initer.til",
         "src/self/desugarer.til", "src/self/typer.til": "Compiler frontend"
    case "src/self/garbager.til", "src/self/constfolder.til",
         "src/self/scavenger.til", "src/self/targets.til",
         "src/self/c_codegen.til", "src/self/builder.til": "Compiler backend"
    case "src/self/interpreter.til", "src/self/binder.til",
         "src/self/eval_heap.til": "Compiler tools"
    case: ""
    }
}

priv doc_effective_group := func(unit_path: Str, meta: DocMeta) returns Str {
    if meta.group.is_empty().not() { return meta.group.clone() }
    return doc_default_group(unit_path)
}

priv append_doc_catalog_entry := func(mut catalog: DocCatalog, unit_path: Str, page: Str, name: Str, doc: Str, info: Str) {
    meta := parse_doc_meta(doc)
    if meta.hidden { return }
    catalog.entries.push(own DocEntry(
        name = name.clone(),
        id = doc_entry_id(unit_path, name),
        unit_path = unit_path.clone(),
        group = doc_effective_group(unit_path, meta),
        page = page.clone(),
        body = meta.body.clone(),
        info = info.clone(),
        since = meta.since.clone(),
        deprecated = meta.deprecated.clone()))
}

priv collect_struct_doc_members := func(unit_path: Str, page: Str, type_name: Str, sdef: StructDef, mut catalog: DocCatalog) {
    mut field_i : USize = 0
    for field : Declaration in sdef.fields {
        ref field_name : Str = sdef.field_name_at(field_i)
        if field.doc.is_empty().not() {
            qual := type_name.format(".", field_name)
            append_doc_catalog_entry(catalog, unit_path, page, qual, field.doc, format_field_info(type_name, field_name, field))
        }
        field_i++
    }
    mut member_i : USize = 0
    for member : Declaration in sdef.ns_decls {
        ref member_name : Str = sdef.member_name_at(member_i)
        if member.doc.is_empty().not() {
            qual := type_name.format(".", member_name)
            append_doc_catalog_entry(catalog, unit_path, page, qual, member.doc, format_member_info(type_name, member_name, member))
        }
        member_i++
    }
}

priv collect_enum_doc_members := func(unit_path: Str, page: Str, type_name: Str, edef: EnumDef, mut catalog: DocCatalog) {
    for variant : VariantDef in edef.variants {
        if variant.doc.is_empty().not() {
            qual := type_name.format(".", variant.name)
            append_doc_catalog_entry(catalog, unit_path, page, qual, variant.doc, format_variant_info(type_name, variant))
        }
    }
    mut member_i : USize = 0
    for member : Declaration in edef.ns_decls {
        ref member_name : Str = edef.member_name_at(member_i)
        if member.doc.is_empty().not() {
            qual := type_name.format(".", member_name)
            append_doc_catalog_entry(catalog, unit_path, page, qual, member.doc, format_member_info(type_name, member_name, member))
        }
        member_i++
    }
}

priv collect_unit_doc_catalog := func(u: ProgramUnit, ctx: Context, mut catalog: DocCatalog) {
    ref iu : ImportUnit = ctx.imported[u.path]
    page := doc_index_link_path(til_doc_out_path(u.path))
    for stmt : Expr in iu.ast.children {
        if stmt.node_type.is(NodeType.Decl) {
            ref dd : Declaration = decl_of(stmt)
            meta := parse_doc_meta(dd.doc)
            if doc_decl_hidden(dd, meta).not() {
                info := format_decl_info(stmt, ctx.scope, ctx.symbols)
                append_doc_catalog_entry(catalog, u.path, page, dd.name, dd.doc, info)
                if stmt.children.len() > 0 {
                    switch stmt.children[0].node_type {
                    case .StructDef(sdef): collect_struct_doc_members(u.path, page, dd.name, sdef, catalog)
                    case .EnumDef(edef): collect_enum_doc_members(u.path, page, dd.name, edef, catalog)
                    case:
                    }
                }
            }
        }
    }
}

priv doc_display_info := func(e: DocEntry) returns Str {
    name_pos := e.info.find(e.name)
    if name_pos < 0 { return e.info.clone() }
    name_pos_u := name_pos.to_usize()
    before := e.info.substr(0, name_pos_u)
    after := e.info.substr(name_pos_u + e.name.len(), e.info.len() - name_pos_u - e.name.len())
    mut after_start : USize = 0
    if before.ends_with(" ").and(after.starts_with(" ")) { after_start = 1 }
    mut out := Str.with_capacity(e.info.len())
    out.push_str(before)
    out.push_str(after.substr(after_start, after.len() - after_start))
    return out
}

priv doc_catalog_lookup := func(catalog: DocCatalog, name: Str, loc: Str) returns DocEntry {
    for e : DocEntry in catalog.entries {
        if e.name == name { return e.clone() }
    }
    panic("unresolved til doc link '", name, "' in ", loc)
    return DocEntry()
}

priv doc_entry_org_link := func(e: DocEntry, label: Str) returns Str {
    return format("[[file:", e.page, "::#", e.id, "][", label, "]]")
}

priv doc_find_link_end := func(body: Str, start: USize, loc: Str) returns USize {
    mut i := start
    while i + 1 < body.len() {
        if body.substr(i, 2) == "]]" { return i }
        i++
    }
    panic("unterminated til doc link in ", loc)
    return body.len()
}

priv doc_line_end := func(body: Str, pos: USize) returns USize {
    rest := body.substr(pos, body.len() - pos)
    line_rel := rest.find("\n")
    if line_rel < 0 { return body.len() }
    return pos + line_rel.to_usize()
}

priv doc_next_line_pos := func(body: Str, line_end: USize) returns USize {
    if line_end >= body.len() { return body.len() }
    return line_end + 1
}

priv doc_is_src_begin := func(line: Str) returns Bool {
    return line.trim().starts_with("#+begin_src")
}

priv doc_is_src_end := func(line: Str) returns Bool {
    return line.trim().starts_with("#+end_src")
}

priv doc_is_example_begin := func(line: Str) returns Bool {
    return line.trim().starts_with("#+begin_example")
}

priv doc_expand_til_links := func(body: Str, catalog: DocCatalog, loc: Str) returns Str {
    mut out := ""
    mut pos : USize = 0
    while pos < body.len() {
        rest := body.substr(pos, body.len() - pos)
        link_rel := rest.find("[[til:")
        if link_rel < 0 {
            out = format(out, rest)
            return out
        }

        link_start := pos + link_rel.to_usize()
        if link_start > pos { out = format(out, body.substr(pos, link_start - pos)) }

        content_start := link_start + 6
        link_end := doc_find_link_end(body, content_start, loc)
        content := body.substr(content_start, link_end - content_start)
        sep := content.find("][")
        mut target := ""
        mut label := ""
        if sep < 0 {
            target = content.clone()
            label = content.clone()
        } else {
            sep_u := sep.to_usize()
            target = content.substr(0, sep_u).clone()
            label = content.substr(sep_u + 2, content.len() - sep_u - 2).clone()
        }
        if target.is_empty() { panic("empty til doc link target in ", loc) }
        if label.is_empty() { panic("empty til doc link label in ", loc) }
        entry := doc_catalog_lookup(catalog, target, loc)
        out = format(out, doc_entry_org_link(entry, label))
        pos = link_end + 2
    }
    return out
}

priv expand_doc_catalog_links := func(mut catalog: DocCatalog) {
    mut expanded := Vec(Str).new()
    for e : DocEntry in catalog.entries {
        expanded.push(own doc_expand_til_links(e.body, catalog, e.name))
    }
    for i in 0..expanded.len() {
        ref mut e : DocEntry = catalog.entries[i]
        ref body : Str = expanded[i]
        e.body = body.clone()
    }
}

priv build_doc_catalog := func(lp: LoadedProgram) returns DocCatalog {
    mut catalog := DocCatalog()
    if lp.skip_core.not() {
        for u : ProgramUnit in lp.core_units { collect_unit_doc_catalog(u, lp.ctx, catalog) }
    }
    for u : ProgramUnit in lp.units { collect_unit_doc_catalog(u, lp.ctx, catalog) }
    expand_doc_catalog_links(catalog)
    return catalog
}

priv append_doc_properties := func(mut out: Str, e: DocEntry, include_group: Bool, include_id: Bool) {
    has_group := include_group.and(e.group.is_empty().not())
    has_id := include_id.and(e.id.is_empty().not())
    if e.since.is_empty().not().or(e.deprecated.is_empty().not()).or(has_group).or(has_id) {
        out.push_str(":PROPERTIES:\n")
        if has_id {
            out.push_str(":CUSTOM_ID: "); out.push_str(e.id); out.push_str("\n")
        }
        if e.since.is_empty().not() {
            out.push_str(":since: "); out.push_str(e.since); out.push_str("\n")
        }
        if e.deprecated.is_empty().not() {
            out.push_str(":deprecated: "); out.push_str(e.deprecated); out.push_str("\n")
        }
        if has_group {
            out.push_str(":group: "); out.push_str(e.group); out.push_str("\n")
        }
        out.push_str(":END:\n")
    }
}

priv doc_unit_entry_capacity := func(e: DocEntry) returns USize {
    return e.name.len()
        .add(e.id.len())
        .add(e.body.len())
        .add(e.since.len())
        .add(e.deprecated.len())
        .add(e.group.len())
        .add(e.info.len())
         + 160
}

priv append_doc_unit_entry := func(mut out: Str, e: DocEntry) {
    out.push_str("* ")
    out.push_str(e.name)
    out.push_str("\n")
    append_doc_properties(out, e, true, true)
    if e.since.is_empty().not().or(e.deprecated.is_empty().not()).or(e.group.is_empty().not()).or(e.id.is_empty().not()) {
        out.push_str("\n")
    }
    if e.body.is_empty().not() {
        out.push_str(e.body)
        if e.body.ends_with("\n").not() { out.push_str("\n") }
        out.push_str("\n")
    }
    if e.info.is_empty().not() {
        out.push_str("#+begin_src til\n")
        out.push_str(e.info)
        if e.info.ends_with("\n").not() { out.push_str("\n") }
        out.push_str("#+end_src\n\n")
    }
}

// Render one source file's catalog entries as an org-mode page.
// One headline per public Decl, with the /// doc text and a kind/signature
// info block collected from the typed AST.
priv format_unit_doc_org := func(unit_path: Str, catalog: DocCatalog, version: Str) returns Str {
    // Strip a leading "./" via a self-reassign from a substring of `title`.
    // This (`title = title.strip_prefix(...).clone()`) is compiled correctly:
    // #238 fixed the asap-destruction delete-ordering, and #258 keeps the
    // clone of any Str whose defs are not provably owning.
    mut title := unit_path.clone()
    if title.starts_with("./") {
        title = title.strip_prefix("./").clone()
    }
    mut total : USize = title.len() + 64
    for e : DocEntry in catalog.entries {
        if e.unit_path == unit_path { total = total + doc_unit_entry_capacity(e) }
    }
    mut buf := Str.with_capacity(total)
    buf.push_str("#+TITLE: ")
    buf.push_str(title)
    buf.push_str("\n#+SUBTITLE: til ")
    buf.push_str(version)
    buf.push_str("\n#+OPTIONS: toc:t\n\n")
    for e : DocEntry in catalog.entries {
        if e.unit_path == unit_path { append_doc_unit_entry(buf, e) }
    }
    if buf.ends_with("\n\n") { buf = buf.strip_suffix("\n").clone() }
    return buf
}

priv doc_index_has_group := func(groups: Vec(Str), group: Str) returns Bool {
    for existing : Str in groups {
        if existing == group { return true }
    }
    return false
}

priv append_doc_index_entry := func(mut out: Str, e: DocEntry) {
    out.push_str("** [[file:")
    out.push_str(e.page)
    out.push_str("::#")
    out.push_str(e.id)
    out.push_str("][")
    out.push_str(e.name)
    out.push_str("]]\n")
    append_doc_properties(out, e, false, false)
    if e.info.is_empty().not() {
        out.push_str("#+begin_src til\n")
        out.push_str(e.info)
        if e.info.ends_with("\n").not() { out.push_str("\n") }
        out.push_str("#+end_src\n")
    }
    out.push_str("\n")
}

priv doc_index_entry_capacity := func(e: DocEntry) returns USize {
    return e.name.len().mul(2)
        .add(e.page.len())
        .add(e.id.len())
        .add(e.info.len())
        .add(e.since.len())
        .add(e.deprecated.len())
         + 160
}

priv doc_index_add_group_if_present := func(mut groups: Vec(Str), catalog: DocCatalog, group: Str) {
    if doc_index_has_group(groups, group) { return }
    for e : DocEntry in catalog.entries {
        if e.group == group {
            groups.push(own group.clone())
            return
        }
    }
}

priv doc_index_collect_groups := func(catalog: DocCatalog) returns Vec(Str) {
    mut groups := Vec(Str).new()
    doc_index_add_group_if_present(groups, catalog, "Core")
    doc_index_add_group_if_present(groups, catalog, "Standard library")
    doc_index_add_group_if_present(groups, catalog, "Compiler frontend")
    doc_index_add_group_if_present(groups, catalog, "Compiler backend")
    doc_index_add_group_if_present(groups, catalog, "Compiler tools")
    doc_index_add_group_if_present(groups, catalog, "CLI")
    doc_index_add_group_if_present(groups, catalog, "Vendor bindings")
    for e : DocEntry in catalog.entries {
        if e.group.is_empty().not().and(doc_index_has_group(groups, e.group).not()) {
            groups.push(own e.group.clone())
        }
    }
    return groups
}

priv format_doc_index_org := func(catalog: DocCatalog, version: Str) returns Str {
    groups := doc_index_collect_groups(catalog)
    mut has_ungrouped := false
    mut total : USize = 128
    for group : Str in groups { total = total.add(group.len()) + 8 }
    for e : DocEntry in catalog.entries {
        total = total + doc_index_entry_capacity(e)
        if e.group.is_empty() {
            has_ungrouped = true
        }
    }
    if has_ungrouped { total = total + 16 }

    mut out := Str.with_capacity(total)
    out.push_str("#+TITLE: til documentation index\n#+SUBTITLE: til ")
    out.push_str(version)
    out.push_str("\n#+OPTIONS: toc:t\n\n")

    for group : Str in groups {
        out.push_str("* ")
        out.push_str(group)
        out.push_str("\n\n")
        for e : DocEntry in catalog.entries {
            if e.group == group { append_doc_index_entry(out, e) }
        }
    }

    if has_ungrouped {
        out.push_str("* Ungrouped\n\n")
        for e : DocEntry in catalog.entries {
            if e.group.is_empty() { append_doc_index_entry(out, e) }
        }
    }
    if out.ends_with("\n\n") { out = out.strip_suffix("\n").clone() }
    return out
}

priv doc_html_escape := func(s: Str) returns Str {
    mut out := s.replace("&", "&amp;")
    out = out.replace("<", "&lt;")
    out = out.replace(">", "&gt;")
    out = out.replace("\"", "&quot;")
    return out
}

priv doc_js_escape := func(s: Str) returns Str {
    mut out := s.replace("\\", "\\\\")
    out = out.replace("\"", "\\\"")
    out = out.replace("\n", "\\n")
    out = out.replace("\r", "\\r")
    out = out.replace("\t", "\\t")
    return out
}

priv doc_html_path := func(org_path: Str) returns Str {
    if org_path.ends_with(".org").not() { panic("doc HTML path source is not .org: ", org_path) }
    return format(org_path.strip_suffix(".org"), ".html")
}

priv doc_html_relative_prefix := func(from_page: Str) returns Str {
    mut depth : USize = 0
    for i in 0..from_page.len() {
        ref ch : I8 = from_page.unsafe_get(i)
        if ch.eq('/') { depth++ }
    }
    mut out := Str.with_capacity(depth.mul(3))
    for _ in 0..depth { out.push_str("../") }
    return out
}

priv doc_html_href := func(from_page: Str, to_org_page: Str, anchor: Str) returns Str {
    return format(doc_html_relative_prefix(from_page), doc_html_path(to_org_page), "#", anchor)
}

priv doc_search_href := func(e: DocEntry) returns Str {
    return format(doc_html_path(e.page), "#", e.id)
}

priv append_doc_html_file_link := func(mut out: Str, content: Str, current_page: Str, loc: Str) {
    sep := content.find("][")
    if sep < 0 { panic("HTML doc link missing label in ", loc) }
    sep_u := sep.to_usize()
    target := content.substr(0, sep_u)
    label := content.substr(sep_u + 2, content.len() - sep_u - 2)
    if target.is_empty() { panic("HTML doc link target is empty in ", loc) }
    if label.is_empty() { panic("HTML doc link label is empty in ", loc) }

    anchor_sep := target.find("::#")
    if anchor_sep < 0 { panic("HTML doc file link missing anchor in ", loc) }
    anchor_sep_u := anchor_sep.to_usize()
    org_page := target.substr(0, anchor_sep_u)
    anchor := target.substr(anchor_sep_u + 3, target.len() - anchor_sep_u - 3)
    if org_page.is_empty() { panic("HTML doc file link page is empty in ", loc) }
    if anchor.is_empty() { panic("HTML doc file link anchor is empty in ", loc) }

    href := doc_html_href(current_page, org_page, anchor)
    out.push_str("<a href=\"")
    out.push_str(doc_html_escape(href))
    out.push_str("\">")
    out.push_str(doc_html_escape(label))
    out.push_str("</a>")
}

priv append_doc_html_inline := func(mut out: Str, text: Str, current_page: Str, loc: Str) {
    mut pos : USize = 0
    while pos < text.len() {
        rest := text.substr(pos, text.len() - pos)
        link_rel := rest.find("[[file:")
        tilde_rel := rest.find("~")
        equals_rel := rest.find("=")
        mut token_rel := link_rel
        mut token_kind : I32 = 1
        if token_rel < 0 { token_rel = tilde_rel; token_kind = 2 }
        if tilde_rel >= 0 { if token_rel < 0 { token_rel = tilde_rel; token_kind = 2 } else if tilde_rel < token_rel { token_rel = tilde_rel; token_kind = 2 } }
        if equals_rel >= 0 { if token_rel < 0 { token_rel = equals_rel; token_kind = 3 } else if equals_rel < token_rel { token_rel = equals_rel; token_kind = 3 } }
        if token_rel < 0 {
            out.push_str(doc_html_escape(rest))
            return
        }

        token_start := pos + token_rel.to_usize()
        if token_start > pos { out.push_str(doc_html_escape(text.substr(pos, token_start - pos))) }

        if token_kind != 1 {
            mut marker := "~"
            if token_kind == 3 { marker = "=" }
            content_start := token_start + 1
            content_rest := text.substr(content_start, text.len() - content_start)
            close_rel := content_rest.find(marker)
            if close_rel < 0 {
                out.push_str(doc_html_escape(text.substr(token_start, text.len() - token_start)))
                return
            }
            close_pos := content_start + close_rel.to_usize()
            out.push_str("<code>")
            out.push_str(doc_html_escape(text.substr(content_start, close_pos - content_start)))
            out.push_str("</code>")
            pos = close_pos + 1
            continue
        }

        content_start := token_start + 7
        link_end := doc_find_link_end(text, content_start, loc)
        content := text.substr(content_start, link_end - content_start)
        append_doc_html_file_link(out, content, current_page, loc)
        pos = link_end + 2
    }
}

priv doc_html_close_para := func(mut out: Str, mut in_para: Bool) {
    if in_para {
        out.push_str("</p>\n")
        in_para = false
    }
}

priv doc_html_close_list := func(mut out: Str, mut list_kind: I32) {
    if list_kind == 1 { out.push_str("</ul>\n") }
    if list_kind == 2 { out.push_str("</ol>\n") }
    list_kind = 0
}

priv doc_heading_depth := func(line: Str) returns USize {
    trimmed := line.trim()
    mut depth : USize = 0
    while depth < trimmed.len() {
        if trimmed.get(depth).neq('*') { break }
        depth++
    }
    if depth == 0 { return 0 }
    if depth >= trimmed.len() { return 0 }
    if trimmed.get(depth).neq(' ') { return 0 }
    return depth
}

priv doc_ordered_item_start := func(line: Str) returns I64 {
    trimmed := line.trim()
    mut pos : USize = 0
    while pos < trimmed.len() {
        ref ch : I8 = trimmed.get(pos)
        if ch.lt('0').or(ch.gt('9')) { break }
        pos++
    }
    if pos == 0 { return -1 }
    if pos + 1 >= trimmed.len() { return -1 }
    if trimmed.get(pos).neq('.').or(trimmed.get(pos + 1).neq(' ')) { return -1 }
    return (pos + 2).to_i64()
}

priv append_doc_html_verbatim_block := func(mut out: Str, body: Str, mut pos: USize, end_marker: Str, loc: Str) returns USize {
    out.push_str("<pre>")
    mut found_end := false
    while pos < body.len() {
        line_end := doc_line_end(body, pos)
        line := body.substr(pos, line_end - pos)
        if line.trim().starts_with(end_marker) {
            found_end = true
            pos = doc_next_line_pos(body, line_end)
            break
        }
        out.push_str(doc_html_escape(line))
        out.push_str("\n")
        pos = doc_next_line_pos(body, line_end)
    }
    if found_end.not() { panic("unterminated doc block in ", loc) }
    out.push_str("</pre>\n")
    return pos
}

priv append_doc_html_body := func(mut out: Str, body: Str, current_page: Str, loc: Str) {
    mut pos : USize = 0
    mut in_para := false
    mut list_kind : I32 = 0
    while pos < body.len() {
        line_end := doc_line_end(body, pos)
        line := body.substr(pos, line_end - pos)
        if doc_is_src_begin(line) {
            doc_html_close_para(out, in_para)
            doc_html_close_list(out, list_kind)
            begin := line.trim().strip_prefix("#+begin_src").trim()
            mut language := "text"
            if begin.is_empty().not() {
                space := begin.find(" ")
                if space < 0 { language = begin.clone() } else { language = begin.substr(0, space.to_usize()).clone() }
            }
            out.push_str("<pre><code class=\"language-")
            out.push_str(doc_html_escape(language))
            out.push_str("\">")
            pos = doc_next_line_pos(body, line_end)
            mut found_end := false
            while pos < body.len() {
                src_line_end := doc_line_end(body, pos)
                src_line := body.substr(pos, src_line_end - pos)
                if doc_is_src_end(src_line) {
                    found_end = true
                    pos = doc_next_line_pos(body, src_line_end)
                    break
                }
                out.push_str(doc_html_escape(src_line))
                out.push_str("\n")
                pos = doc_next_line_pos(body, src_line_end)
            }
            if found_end.not() { panic("unterminated doc source block in ", loc) }
            out.push_str("</code></pre>\n")
            continue
        } else if doc_is_example_begin(line) {
            doc_html_close_para(out, in_para)
            doc_html_close_list(out, list_kind)
            pos = doc_next_line_pos(body, line_end)
            pos = append_doc_html_verbatim_block(out, body, pos, "#+end_example", loc)
            continue
        } else if line.trim().is_empty() {
            doc_html_close_para(out, in_para)
            doc_html_close_list(out, list_kind)
        } else {
            trimmed := line.trim()
            heading_depth := doc_heading_depth(trimmed)
            ordered_start := doc_ordered_item_start(trimmed)
            unordered := trimmed.starts_with("- ").or(trimmed.starts_with("+ "))
            if heading_depth > 0 {
                doc_html_close_para(out, in_para)
                doc_html_close_list(out, list_kind)
                mut level := heading_depth + 2
                if level > 6 { level = 6 }
                tag := level.to_str()
                out.push_str("<h"); out.push_str(tag); out.push_str(">")
                append_doc_html_inline(out, trimmed.substr(heading_depth + 1, trimmed.len() - heading_depth - 1), current_page, loc)
                out.push_str("</h"); out.push_str(tag); out.push_str(">\n")
            } else if unordered.or(ordered_start >= 0) {
                doc_html_close_para(out, in_para)
                mut wanted_kind : I32 = 1
                mut item_start : USize = 2
                if ordered_start >= 0 { wanted_kind = 2; item_start = ordered_start.to_usize() }
                if list_kind != wanted_kind {
                    doc_html_close_list(out, list_kind)
                    if wanted_kind == 1 { out.push_str("<ul>\n") } else { out.push_str("<ol>\n") }
                    list_kind = wanted_kind
                }
                out.push_str("<li>")
                append_doc_html_inline(out, trimmed.substr(item_start, trimmed.len() - item_start), current_page, loc)
                out.push_str("</li>\n")
            } else {
                doc_html_close_list(out, list_kind)
                if in_para { out.push_str("\n") } else { out.push_str("<p>"); in_para = true }
                append_doc_html_inline(out, line, current_page, loc)
            }
        }
        pos = doc_next_line_pos(body, line_end)
    }
    doc_html_close_para(out, in_para)
    doc_html_close_list(out, list_kind)
}

priv require_doc_output := func(output: Str, expected: Str, loc: Str) {
    if output.contains(expected).not() { panic("doc output missing ", expected, " in ", loc) }
}

priv verify_doc_html_body_renderer := func() {
    body := "* Heading\n\n- one\n- ~two~\n\n1. first\n2. second\n\n#+begin_example\nraw <text>\n#+end_example\n\n#+begin_src til :doctest\nassert(true)\n#+end_src\n\nSee [[file:src/core/str.org::#til.src.core.str.Str][Str]]."
    mut output := Str.with_capacity(2048)
    append_doc_html_body(output, body, "test/page.html", "doc renderer regression")
    require_doc_output(output, "<h3>Heading</h3>", "doc renderer regression")
    require_doc_output(output, "<ul>", "doc renderer regression")
    require_doc_output(output, "<code>two</code>", "doc renderer regression")
    require_doc_output(output, "<ol>", "doc renderer regression")
    require_doc_output(output, "raw &lt;text&gt;", "doc renderer regression")
    require_doc_output(output, "class=\"language-til\"", "doc renderer regression")
    require_doc_output(output, "../src/core/str.html#til.src.core.str.Str", "doc renderer regression")
    display := doc_display_info(DocEntry(name = "vec", info = "ext_func vec(T: Type, elements: ..Dynamic) returns Vec"))
    if display != "ext_func (T: Type, elements: ..Dynamic) returns Vec" { panic("doc display signature regression: ", display) }
}

priv append_doc_html_meta := func(mut out: Str, e: DocEntry, include_group: Bool) {
    has_group := include_group.and(e.group.is_empty().not())
    if e.since.is_empty().not().or(e.deprecated.is_empty().not()).or(has_group) {
        out.push_str("<dl class=\"meta\">")
        if has_group {
            out.push_str("<dt>Group</dt><dd>")
            out.push_str(doc_html_escape(e.group))
            out.push_str("</dd>")
        }
        if e.since.is_empty().not() {
            out.push_str("<dt>Since</dt><dd>")
            out.push_str(doc_html_escape(e.since))
            out.push_str("</dd>")
        }
        if e.deprecated.is_empty().not() {
            out.push_str("<dt>Deprecated</dt><dd>")
            out.push_str(doc_html_escape(e.deprecated))
            out.push_str("</dd>")
        }
        out.push_str("</dl>\n")
    }
}

priv append_doc_html_head := func(mut out: Str, title: Str, current_page: Str) {
    out.push_str("<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n")
    out.push_str("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n")
    out.push_str("<title>")
    out.push_str(doc_html_escape(title))
    out.push_str("</title>\n")
    out.push_str("<style>\n")
    out.push_str(":root{color-scheme:light dark;--bg:#f8f5ef;--fg:#191714;--muted:#6f665b;--card:#fffdf8;--line:#ded6c9;--link:#7a3e14}\n")
    out.push_str("@media (prefers-color-scheme:dark){:root{--bg:#171512;--fg:#efe7da;--muted:#b8ad9d;--card:#211e1a;--line:#40382f;--link:#f0ad6d}}\n")
    out.push_str("body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.55 ui-sans-serif,system-ui,sans-serif}\n")
    out.push_str(".doc-layout{display:grid;grid-template-columns:minmax(240px,300px) minmax(0,980px);justify-content:center;min-height:100vh}.doc-sidebar{position:sticky;top:0;align-self:start;box-sizing:border-box;height:100vh;overflow:auto;border-right:1px solid var(--line);padding:1.5rem 1rem}.doc-sidebar h1{font-size:1.2rem;margin:0}.doc-version{color:var(--muted);font-size:.85rem}.doc-sidebar h2{font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;margin:1.4rem 0 .3rem}.doc-sidebar ul{list-style:none;margin:0;padding:0}.doc-sidebar ul ul{padding-left:.8rem}.doc-sidebar li{margin:.2rem 0}.doc-sidebar a{display:block;padding:.15rem .35rem;border-radius:5px;text-decoration:none}.doc-sidebar a.current{background:var(--line);font-weight:700}main{box-sizing:border-box;width:100%;padding:2rem 1.25rem 4rem}\n")
    out.push_str("a{color:var(--link)}nav{margin-bottom:1.5rem}.doc-entry{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:1rem 1.25rem;margin:1rem 0}\n")
    out.push_str("h1,h2{line-height:1.2}pre{overflow:auto;background:#111;color:#eee;border-radius:8px;padding:1rem}code{font-family:ui-monospace,monospace}\n")
    out.push_str(".meta{display:flex;flex-wrap:wrap;gap:.35rem .75rem;color:var(--muted);font-size:.9rem}.meta dt{font-weight:700}.meta dd{margin:0}\n")
    out.push_str(".doc-index{list-style:none;padding:0}.doc-index li{margin:.75rem 0}\n")
    out.push_str(".doc-search{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:1rem 1.25rem;margin:0 0 1.5rem}.doc-search label{display:block;font-weight:700;margin-bottom:.35rem}.doc-search input{box-sizing:border-box;width:100%;padding:.55rem .65rem;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--fg);font:inherit}.doc-search-results{margin:.75rem 0 0;padding-left:1.5rem}.doc-search-group{color:var(--muted);font-size:.9rem}\n")
    out.push_str("@media(max-width:760px){.doc-layout{display:block}.doc-sidebar{position:static;width:auto;height:auto;border-right:0;border-bottom:1px solid var(--line);max-height:45vh}.doc-sidebar nav{columns:2;column-gap:1rem}main{padding-top:1.25rem}}@media(max-width:480px){.doc-sidebar nav{columns:1}}\n")
    out.push_str("</style>\n<script src=\"")
    out.push_str(doc_html_escape(format(doc_html_relative_prefix(current_page), "search.js")))
    out.push_str("\" defer></script>\n</head>\n<body>\n")
}

priv doc_catalog_page_first := func(catalog: DocCatalog, index: USize) returns Bool {
    ref entry : DocEntry = catalog.entries[index]
    for prior_i in 0..index {
        ref prior : DocEntry = catalog.entries[prior_i]
        if prior.page == entry.page { return false }
    }
    return true
}

priv doc_html_page_href := func(current_page: Str, org_page: Str) returns Str {
    return format(doc_html_relative_prefix(current_page), doc_html_path(org_page))
}

priv append_doc_html_sidebar_page := func(mut out: Str, catalog: DocCatalog, entry_index: USize, current_page: Str) {
    ref entry : DocEntry = catalog.entries[entry_index]
    page_html := doc_html_path(entry.page)
    is_current := page_html == current_page
    out.push_str("<li><a")
    if is_current { out.push_str(" class=\"current\"") }
    out.push_str(" href=\"")
    out.push_str(doc_html_escape(doc_html_page_href(current_page, entry.page)))
    out.push_str("\">")
    out.push_str(doc_html_escape(doc_unit_path_normalized(entry.unit_path)))
    out.push_str("</a>")
    if is_current {
        out.push_str("<ul>")
        for declaration : DocEntry in catalog.entries {
            if declaration.page == entry.page {
                out.push_str("<li><a href=\"#")
                out.push_str(doc_html_escape(declaration.id))
                out.push_str("\">")
                out.push_str(doc_html_escape(declaration.name))
                out.push_str("</a></li>")
            }
        }
        out.push_str("</ul>")
    }
    out.push_str("</li>\n")
}

priv append_doc_html_sidebar_group := func(mut out: Str, catalog: DocCatalog, group: Str, current_page: Str) {
    out.push_str("<h2>")
    if group.is_empty() { out.push_str("Ungrouped") } else { out.push_str(doc_html_escape(group)) }
    out.push_str("</h2><ul>\n")
    for i in 0..catalog.entries.len() {
        ref entry : DocEntry = catalog.entries[i]
        if entry.group == group {
            if doc_catalog_page_first(catalog, i) { append_doc_html_sidebar_page(out, catalog, i, current_page) }
        }
    }
    out.push_str("</ul>\n")
}

priv append_doc_html_page_start := func(mut out: Str, catalog: DocCatalog, current_page: Str, version: Str) {
    groups := doc_index_collect_groups(catalog)
    mut has_ungrouped := false
    for entry : DocEntry in catalog.entries { if entry.group.is_empty() { has_ungrouped = true } }
    out.push_str("<div class=\"doc-layout\"><aside class=\"doc-sidebar\"><h1><a href=\"")
    out.push_str(doc_html_escape(format(doc_html_relative_prefix(current_page), "index.html")))
    out.push_str("\">til docs</a></h1><div class=\"doc-version\">Version ")
    out.push_str(doc_html_escape(version))
    out.push_str("</div><nav aria-label=\"Documentation\">")
    for group : Str in groups { append_doc_html_sidebar_group(out, catalog, group, current_page) }
    if has_ungrouped { append_doc_html_sidebar_group(out, catalog, "", current_page) }
    out.push_str("</nav></aside><main>\n")
    out.push_str("<section class=\"doc-search\" aria-label=\"Documentation search\">\n<label for=\"til-doc-search\">Search docs</label>\n<input id=\"til-doc-search\" type=\"search\" placeholder=\"Type a name or phrase\" autocomplete=\"off\">\n<ol id=\"til-doc-search-results\" class=\"doc-search-results\"></ol>\n</section>\n")
}

priv append_doc_html_tail := func(mut out: Str) {
    out.push_str("</main></div>\n</body>\n</html>\n")
}

priv doc_html_entry_capacity := func(e: DocEntry) returns USize {
    return e.name.len()
        .add(e.id.len())
        .add(e.page.len())
        .add(e.group.len())
        .add(e.since.len())
        .add(e.deprecated.len())
        .add(e.body.len())
        .add(e.info.len())
        .mul(6)
        + 1024
}

priv append_doc_html_unit_entry := func(mut out: Str, e: DocEntry, current_page: Str) {
    out.push_str("<article class=\"doc-entry\" id=\"")
    out.push_str(doc_html_escape(e.id))
    out.push_str("\">\n<h2>")
    out.push_str(doc_html_escape(e.name))
    out.push_str("</h2>\n")
    append_doc_html_meta(out, e, true)
    if e.body.is_empty().not() {
        out.push_str("<div class=\"doc-body\">\n")
        append_doc_html_body(out, e.body, current_page, e.name)
        out.push_str("</div>\n")
    }
    if e.info.is_empty().not() {
        display_info := doc_display_info(e)
        out.push_str("<pre><code class=\"language-til\">")
        out.push_str(doc_html_escape(display_info))
        if display_info.ends_with("\n").not() { out.push_str("\n") }
        out.push_str("</code></pre>\n")
    }
    out.push_str("</article>\n")
}

priv format_unit_doc_html := func(unit_path: Str, catalog: DocCatalog, version: Str) returns Str {
    mut title := unit_path.clone()
    if title.starts_with("./") { title = title.strip_prefix("./").clone() }

    current_page := doc_index_link_path(doc_html_path(til_doc_out_path(unit_path)))
    mut total : USize = title.len().mul(6) + 8192
    for e : DocEntry in catalog.entries {
        if e.unit_path == unit_path { total = total + doc_html_entry_capacity(e) }
    }

    mut out := Str.with_capacity(total)
    append_doc_html_head(out, title, current_page)
    append_doc_html_page_start(out, catalog, current_page, version)
    out.push_str("<nav><a href=\"")
    out.push_str(doc_html_escape(format(doc_html_relative_prefix(current_page), "index.html")))
    out.push_str("\">Index</a></nav>\n")
    out.push_str("<h1>")
    out.push_str(doc_html_escape(title))
    out.push_str("</h1>\n")
    for e : DocEntry in catalog.entries {
        if e.unit_path == unit_path { append_doc_html_unit_entry(out, e, current_page) }
    }
    append_doc_html_tail(out)
    return out
}

priv append_doc_html_index_entry := func(mut out: Str, e: DocEntry, current_page: Str) {
    out.push_str("<li><a href=\"")
    out.push_str(doc_html_escape(doc_html_href(current_page, e.page, e.id)))
    out.push_str("\">")
    out.push_str(doc_html_escape(e.name))
    out.push_str("</a>\n")
    append_doc_html_meta(out, e, false)
    if e.info.is_empty().not() {
        display_info := doc_display_info(e)
        out.push_str("<pre><code class=\"language-til\">")
        out.push_str(doc_html_escape(display_info))
        if display_info.ends_with("\n").not() { out.push_str("\n") }
        out.push_str("</code></pre>\n")
    }
    out.push_str("</li>\n")
}

priv format_doc_index_html := func(catalog: DocCatalog, version: Str) returns Str {
    groups := doc_index_collect_groups(catalog)
    mut has_ungrouped := false
    mut total : USize = 8192
    for group : Str in groups { total = total + group.len().mul(6) + 128 }
    for e : DocEntry in catalog.entries {
        total = total + doc_html_entry_capacity(e)
        if e.group.is_empty() { has_ungrouped = true }
    }

    mut out := Str.with_capacity(total)
    current_page := "index.html"
    append_doc_html_head(out, "til documentation index", current_page)
    append_doc_html_page_start(out, catalog, current_page, version)
    out.push_str("<h1>til documentation index</h1>\n")
    for group : Str in groups {
        out.push_str("<section>\n<h2>")
        out.push_str(doc_html_escape(group))
        out.push_str("</h2>\n<ul class=\"doc-index\">\n")
        for e : DocEntry in catalog.entries {
            if e.group == group { append_doc_html_index_entry(out, e, current_page) }
        }
        out.push_str("</ul>\n</section>\n")
    }

    if has_ungrouped {
        out.push_str("<section>\n<h2>Ungrouped</h2>\n<ul class=\"doc-index\">\n")
        for e : DocEntry in catalog.entries {
            if e.group.is_empty() { append_doc_html_index_entry(out, e, current_page) }
        }
        out.push_str("</ul>\n</section>\n")
    }
    append_doc_html_tail(out)
    return out
}

priv doc_search_entry_capacity := func(e: DocEntry) returns USize {
    return e.name.len()
        .add(e.group.len())
        .add(e.page.len())
        .add(e.id.len())
        .add(e.body.len())
        .add(e.info.len())
        .mul(12)
        + 512
}

priv append_doc_search_js_entry := func(mut out: Str, e: DocEntry) {
    out.push_str("  {name:\"")
    out.push_str(doc_js_escape(e.name))
    out.push_str("\",group:\"")
    out.push_str(doc_js_escape(e.group))
    out.push_str("\",href:\"")
    out.push_str(doc_js_escape(doc_search_href(e)))
    out.push_str("\",body:\"")
    out.push_str(doc_js_escape(e.body))
    out.push_str("\",info:\"")
    out.push_str(doc_js_escape(e.info))
    out.push_str("\"},\n")
}

priv format_doc_search_js := func(catalog: DocCatalog) returns Str {
    mut total : USize = 8192
    for e : DocEntry in catalog.entries { total = total + doc_search_entry_capacity(e) }

    mut out := Str.with_capacity(total)
    out.push_str("\"use strict\";\n")
    out.push_str("window.tilDocSearchEntries = [\n")
    for e : DocEntry in catalog.entries { append_doc_search_js_entry(out, e) }
    out.push_str("];\n")
    out.push_str("(function(){\n")
    out.push_str("var script=document.currentScript;\n")
    out.push_str("var base=script&&script.src?script.src.replace(/search\\.js(?:[?#].*)?$/,''):'';\n")
    out.push_str("function ready(fn){if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',fn);}else{fn();}}\n")
    out.push_str("ready(function(){\n")
    out.push_str("var input=document.getElementById('til-doc-search');\n")
    out.push_str("var list=document.getElementById('til-doc-search-results');\n")
    out.push_str("if(!input||!list){return;}\n")
    out.push_str("function textFor(e){return(e.name+' '+e.group+' '+e.body+' '+e.info).toLowerCase();}\n")
    out.push_str("function clear(){while(list.firstChild){list.removeChild(list.firstChild);}}\n")
    out.push_str("function render(){\n")
    out.push_str("var q=input.value.trim().toLowerCase();\n")
    out.push_str("clear();\n")
    out.push_str("if(!q){return;}\n")
    out.push_str("var terms=q.split(/\\s+/);\n")
    out.push_str("var shown=0;\n")
    out.push_str("for(var i=0;i<window.tilDocSearchEntries.length&&shown<20;i++){\n")
    out.push_str("var e=window.tilDocSearchEntries[i];\n")
    out.push_str("var text=textFor(e);\n")
    out.push_str("var ok=true;\n")
    out.push_str("for(var j=0;j<terms.length;j++){if(text.indexOf(terms[j])<0){ok=false;break;}}\n")
    out.push_str("if(!ok){continue;}\n")
    out.push_str("var li=document.createElement('li');\n")
    out.push_str("var a=document.createElement('a');\n")
    out.push_str("a.href=base+e.href;\n")
    out.push_str("a.textContent=e.name;\n")
    out.push_str("li.appendChild(a);\n")
    out.push_str("if(e.group){var g=document.createElement('span');g.className='doc-search-group';g.textContent=' '+e.group;li.appendChild(g);}\n")
    out.push_str("list.appendChild(li);\n")
    out.push_str("shown++;\n")
    out.push_str("}\n")
    out.push_str("if(shown===0){var empty=document.createElement('li');empty.textContent='No matches';list.appendChild(empty);}\n")
    out.push_str("}\n")
    out.push_str("input.addEventListener('input',render);\n")
    out.push_str("});\n")
    out.push_str("}());\n")
    return out
}

priv emit_doc_search := proc(catalog: DocCatalog) {
    out := "doc/gen/search.js"
    ensure_parent_dir(out)
    page := format_doc_search_js(catalog)
    File.writefile(out, page)
    println(format("Generated: ", out))
}

priv emit_doc_index := proc(catalog: DocCatalog, version: Str) {
    out := "doc/gen/index.org"
    ensure_parent_dir(out)
    page := format_doc_index_org(catalog, version)
    require_doc_output(page, format("#+SUBTITLE: til ", version), "doc org index")
    File.writefile(out, page)
    println(format("Generated: ", out))

    html_out := "doc/gen/index.html"
    html_page := format_doc_index_html(catalog, version)
    require_doc_output(html_page, "class=\"doc-sidebar\"", "doc HTML index")
    require_doc_output(html_page, format("Version ", version), "doc HTML index")
    File.writefile(html_out, html_page)
    println(format("Generated: ", html_out))
}

// "src/core/vec.til" -> "doc/gen/src/core/vec.org"
priv til_doc_out_path := func(unit_path: Str) returns Str {
    // Trim a leading "./" and a trailing ".til" via self-reassigns from
    // substrings of `name`. `name = name.strip_prefix(...).clone()` is compiled
    // correctly: #238 fixed the asap-destruction delete-ordering (the typer
    // hoists the view-returning substr into a temp aliasing the local, and
    // the old-value delete is ordered after the clone), and #258 keeps the
    // clone of any Str whose defs are not provably owning.
    mut name := unit_path.clone()
    if name.starts_with("./") { name = name.strip_prefix("./").clone() }
    if name.ends_with(".til") { name = name.strip_suffix(".til").clone() }
    return format("doc/gen/", name, ".org")
}

priv til_doc_html_out_path := func(unit_path: Str) returns Str {
    return doc_html_path(til_doc_out_path(unit_path))
}

// Ensure the parent directory of `path` exists (mkdir -p).
priv ensure_parent_dir := proc(path: Str) {
    last_slash := path.rfind("/")
    if last_slash < 0 { return }
    last_slash_u : USize = last_slash.to_usize()
    dir := path.substr(0, last_slash_u).clone()
    if mkdir_p(dir) != 0 { panic("failed to create parent dir for ", path) }
}

priv emit_unit_doc := proc(u: ProgramUnit, catalog: DocCatalog, version: Str) {
    out := til_doc_out_path(u.path)
    ensure_parent_dir(out)
    page := format_unit_doc_org(u.path, catalog, version)
    File.writefile(out, page)
    println(format("Generated: ", out))

    html_out := til_doc_html_out_path(u.path)
    html_page := format_unit_doc_html(u.path, catalog, version)
    File.writefile(html_out, html_page)
    println(format("Generated: ", html_out))
}

cmd_doc := proc(lp: LoadedProgram, version: Str) returns I32 {
    verify_doc_html_body_renderer()
    catalog := build_doc_catalog(lp)
    if lp.skip_core.not() {
        for u : ProgramUnit in lp.core_units { emit_unit_doc(u, catalog, version) }
    }
    for u : ProgramUnit in lp.units { emit_unit_doc(u, catalog, version) }
    emit_doc_index(catalog, version)
    emit_doc_search(catalog)
    return 0
}
