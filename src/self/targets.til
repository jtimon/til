mode lib

import("../std/sys")

// Target and Lang definitions for cross-compilation support.
// Mirrors rstil's src/rs/target.rs.

// ---------- Lang enum - codegen backend languages

Lang := enum {
    C,
    HolyC,
    TIL,
    Java,
}

priv lang_to_str := func(lang: Lang) returns Str {
    switch lang {
    case .C:     return "c"
    case .HolyC: return "holyc"
    case .TIL:   return "til"
    case .Java:  return "java"
    }
    return ""
}

// ---------- Target enum - supported platforms

Target := enum {
    LinuxX64,
    LinuxArm64,
    LinuxRiscv64,
    LinuxX86,
    LinuxArm32,
    LinuxRiscv32,
    WindowsX64,
    WindowsX86,
    MacosX64,
    MacosArm64,
    Wasm32,
    TempleosX86,
    Jvm,
}

target_from_str := func(s: Str) returns Target {
    switch s {
    case "linux-x64", "linux-x86_64", "linux-amd64": return Target.LinuxX64
    case "linux-arm64", "linux-aarch64": return Target.LinuxArm64
    case "linux-riscv64", "linux-riscv", "riscv64": return Target.LinuxRiscv64
    case "linux-x86", "linux-i386", "linux-i686", "linux-32": return Target.LinuxX86
    case "linux-arm32", "linux-armhf", "linux-arm", "arm32": return Target.LinuxArm32
    case "linux-riscv32", "riscv32": return Target.LinuxRiscv32
    case "windows-x64", "windows-x86_64", "win64": return Target.WindowsX64
    case "windows-x86", "windows-i686", "windows-i386", "win32": return Target.WindowsX86
    case "macos-x64", "macos-x86_64", "darwin-x64": return Target.MacosX64
    case "macos-arm64", "macos-aarch64", "darwin-arm64": return Target.MacosArm64
    case "wasm32", "wasm", "webassembly": return Target.Wasm32
    case "templeos-x86", "templeos": return Target.TempleosX86
    case "jvm": return Target.Jvm
    }
    panic("Unknown target '", s, "'. Supported targets: linux-x64, linux-arm64, linux-riscv64, linux-x86, linux-arm32, linux-riscv32, windows-x64, windows-x86, macos-x64, macos-arm64, wasm32, templeos-x86, jvm")
    return Target.LinuxX64
}

priv target_to_str := func(target: Target) returns Str {
    switch target {
    case .LinuxX64:     return "linux-x64"
    case .LinuxArm64:   return "linux-arm64"
    case .LinuxRiscv64: return "linux-riscv64"
    case .LinuxX86:     return "linux-x86"
    case .LinuxArm32:   return "linux-arm32"
    case .LinuxRiscv32: return "linux-riscv32"
    case .WindowsX64:   return "windows-x64"
    case .WindowsX86:   return "windows-x86"
    case .MacosX64:     return "macos-x64"
    case .MacosArm64:   return "macos-arm64"
    case .Wasm32:       return "wasm32"
    case .TempleosX86:  return "templeos-x86"
    case .Jvm:           return "jvm"
    }
    return ""
}

priv target_is_32bit := func(target: Target) returns Bool {
    switch target {
    case .LinuxX86, .LinuxArm32, .LinuxRiscv32, .WindowsX86,
         .Wasm32: return true
    case .Jvm: return false
    case: return false
    }
}

// True for any Windows target (x64 or x86). The builder uses it to gate
// the mingw-specific link handling (--export-all-symbols, the linux->win
// link-flag rewrite, the nng swap) on all Windows targets at once.
is_windows_target := func(target: Target) returns Bool {
    return target.is(Target.WindowsX64).or(target.is(Target.WindowsX86))
}

target_uptr_name := func(target: Target) returns Str {
    if target_is_32bit(target) { return "U32" }
    return "U64"
}

// USize is the target-width unsigned integer used by container APIs
// (lengths, capacities, indices, element sizes), mirroring UPtr's
// target-width selection for raw pointer arithmetic.
target_usize_name := func(target: Target) returns Str {
    if target_is_32bit(target) { return "U32" }
    return "U64"
}

// ---------- Target/Lang compatibility

target_simd_bits := func(target: Target) returns USize {
    switch target {
    case .LinuxX64, .WindowsX64, .MacosX64, .LinuxArm64, .MacosArm64:
        return 128
    case .LinuxX86, .WindowsX86, .LinuxArm32, .LinuxRiscv32, .LinuxRiscv64,
         .Wasm32, .TempleosX86, .Jvm:
        return 0
    }
}

// One resolved selection drives both frontend width queries and C flags.
// It describes the target, never the CPU running the compiler.
TargetCpu := struct {
    name := "baseline"
    simd_bits : USize = 0
    c_flags := ""
}

resolve_target_cpu := func(target: Target, name: Str) returns TargetCpu {
    mut selected := TargetCpu(name = name.clone(), simd_bits = target_simd_bits(target))
    x64 := target.is(Target.LinuxX64).or(target.is(Target.WindowsX64)).or(target.is(Target.MacosX64))
    if name == "baseline" {
        if x64 { selected.c_flags = " -march=x86-64 -mtune=generic" }
        else if target.is(Target.LinuxArm64).or(target.is(Target.MacosArm64)) {
            selected.c_flags = " -march=armv8-a -mtune=generic"
        }
    } else if name.eq("x86-64-v3").or(name.eq("x86-64-v4")) {
        if x64.not() { panic("CPU profile '", name, "' requires an x86-64 C target") }
        selected.simd_bits = 256
        if name == "x86-64-v4" { selected.simd_bits = 512 }
        selected.c_flags = format(" -march=", name, " -mtune=generic")
    } else {
        panic("unknown CPU profile '", name, "'; expected baseline, x86-64-v3 or x86-64-v4")
    }
    return selected
}

target_lang := func(target: Target) returns Lang {
    switch target {
    case .TempleosX86: return Lang.HolyC
    case .Jvm: return Lang.Java
    case: return Lang.C
    }
}

priv is_lang_supported_for_target := func(lang: Lang, target: Target) returns Bool {
    // TIL is always supported (for debugging)
    if lang.is(Lang.TIL) { return true }
    return target_lang(target) == lang
}

priv validate_lang_for_target := func(lang: Lang, target: Target) {
    if is_lang_supported_for_target(lang, target).not() {
        panic("Lang '", lang_to_str(lang), "' is not supported for target '", target_to_str(target), "'")
    }
}

// ---------- Toolchain commands

// proc, not func: the WindowsX64 case is host-dependent (host_os() is a
// proc), so the whole thing must be a proc. Its two callers (compile_c,
// compile_lib) are already procs.
toolchain_command := proc(target: Target, lang: Lang) returns Str {
    validate_lang_for_target(lang, target)
    switch target {
    case .LinuxX64:     return "gcc"
    case .LinuxArm64:   return "aarch64-linux-gnu-gcc"
    case .LinuxRiscv64: return "riscv64-linux-gnu-gcc"
    case .LinuxX86:     return "gcc"
    case .LinuxArm32:   return "arm-linux-gnueabihf-gcc"
    case .LinuxRiscv32: return "riscv32-linux-gnu-gcc"
    // mingw's gcc is the cross-prefixed x86_64-w64-mingw32-gcc when
    // building windows FROM another host, but plain "gcc" when running
    // natively ON windows (mingw installs it unprefixed in PATH).
    case .WindowsX64:
        if host_os() == "windows" { return "gcc" }
        return "x86_64-w64-mingw32-gcc"
    case .WindowsX86:
        if host_os() == "windows" { return "gcc" }
        return "i686-w64-mingw32-gcc"
    case .MacosX64, .MacosArm64: return "clang"
    // emscripten (issue #424): every til program includes src/c/ext.c,
    // which needs a libc, and bare clang --target=wasm32 has none. emcc
    // brings emscripten's; the vendored emsdk's emcc goes in with --cc, as
    // for the mode gui browser build.
    case .Wasm32: return "emcc"
    case .TempleosX86:  return "holyc"
    case .Jvm: panic("JVM target has no C toolchain command")
    }
    return ""
}

priv target_prefix_args := func(target: Target) returns Str {
    switch target {
    // The 64-bit multiarch dir supplies the arch headers only
    // gcc-multilib's /usr/include/asm link would (asm/types.h), so it goes
    // LAST (issue #436): as a -I it came first and shadowed any header it
    // also holds -- the program's own, or a vendored library's ffi.h.
    case .LinuxX86:     return " -m32 -idirafter /usr/include/x86_64-linux-gnu"
    case .MacosArm64: return " -target arm64-apple-macos11"
    case .MacosX64:   return " -target x86_64-apple-macos10.12"
    case .Jvm: panic("JVM target has no C compiler prefix arguments")
    case: return ""
    }
}

// Cross-compiling to macOS from a non-mac host uses the vendored
// SDK-less toolchain pieces (issue #25 phase 2, replicating what zig
// does): zig's curated darwin libc headers plus the libSystem.tbd
// linker stub under vendor/macos/, compiled by the host's clang and
// linked with lld (which ad-hoc code-signs arm64 Mach-O). Native mac
// builds keep the real SDK: no -nostdlibinc, system linker.
priv macos_is_cross := proc(target: Target) returns Bool {
    if target.is(Target.MacosX64).or(target.is(Target.MacosArm64)).not() {
        return false
    }
    return host_os().eq("macos").not()
}

priv macos_cross_args := proc(target: Target) returns Str {
    if macos_is_cross(target).not() { return "" }
    return " -nostdlibinc -isystem vendor/macos/include"
}

// Link-only companion to macos_cross_args: -fuse-ld=lld and -L mean
// nothing on -c compiles and clang -Werror rejects them as unused
// arguments there, so the builder appends these only to command lines
// that actually link.
target_link_extra_args := proc(target: Target) returns Str {
    if target.is(Target.Jvm) { panic("JVM target has no C linker arguments") }
    if macos_is_cross(target).not() { return "" }
    return " -fuse-ld=lld -Lvendor/macos"
}

toolchain_extra_args := proc(target: Target) returns Str {
    if target.is(Target.Jvm) {
        panic("JVM target has no C compiler arguments")
    }
    if target.is(Target.TempleosX86) {
        panic("HolyC doesn't support these flags")
    }
    prefix := target_prefix_args(target)
    mut out := prefix
    // -fsigned-char: til's I8 is plain C char (it must match libc
    // prototypes in ext_func bindings), and plain char is unsigned on
    // aarch64/arm Linux ABIs -- this flag pins it signed everywhere
    // (no-op on x86/darwin, the semantics fix on ARM Linux; issue #25).
    out = out.format(" ", "-Wall -Wextra -fsigned-char")
    // No warning suppressions: the generated C compiles clean under
    // -Wall -Wextra -Werror on every toolchain -- native gcc, native clang
    // (since the NULL-base ptr_add reinterpret emits a standard
    // (void *)(UPtr) cast, issue #25), and the cross compilers the CI
    // exercises (mingw-w64, aarch64/riscv64/arm gcc). The -Wno-* set that
    // used to ride along for clang/cross builds suppressed nothing.
    out = out.format(macos_cross_args(target))
    return out
}

executable_extension := func(target: Target) returns Str {
    switch target {
    case .WindowsX64, .WindowsX86: return ".exe"
    // A single node-runnable .js with the wasm embedded (issue #424); a
    // mode gui program is a single .html instead (builder.til).
    case .Wasm32:     return ".js"
    case .Jvm:        return ".jar"
    case: return ""
    }
}

shared_lib_extension := func(target: Target) returns Str {
    switch target {
    case .WindowsX64, .WindowsX86: return ".dll"
    case .MacosX64, .MacosArm64: return ".dylib"
    case .Jvm: panic("JVM target does not produce native shared libraries")
    case: return ".so"
    }
}

// CRT/system libraries always linked for this target. POSIX needs
// dl + rt + m + pthread; Windows ext.c uses GetProcessMemoryInfo /
// EnumProcessModules from psapi; mingw's CRT provides the rest inline.
target_system_libs := func(target: Target) returns Str {
    switch target {
    case .LinuxX64, .LinuxArm64, .LinuxRiscv64, .LinuxX86,
         .LinuxArm32, .LinuxRiscv32: return "-ldl -lrt -lm -lpthread"
    case .WindowsX64, .WindowsX86: return "-lpsapi"
    // On darwin, libm/libpthread are pure aliases of libSystem, which
    // clang's darwin driver always links implicitly -- and the vendored
    // cross toolchain (vendor/macos) ships ONLY libSystem.tbd, so the
    // aliases must not be requested: empty works for native and cross.
    case .MacosX64, .MacosArm64, .Wasm32, .TempleosX86: return ""
    case .Jvm: panic("JVM target has no C system libraries")
    }
    return ""
}

// libffi static library path per target. til-the-compiler links it for
// ext_func dispatch; user programs link it only when they call ext_func
// at runtime. A proc because linux-arm64 is host-aware (target_is_host).
target_ffi_lib := proc(target: Target) returns Str {
    switch target {
    case .LinuxX64:     return "vendor/libffi/x86_64-pc-linux-gnu/.libs/libffi.a"
    // The linux cross targets (issue #420): make.til's out-of-tree
    // builds, one fixed build-linux-<name> directory each (its
    // libffi_cross_targets; keep the two in step). A native arm64 host
    // keeps the bootstrap's own archive, below.
    case .LinuxArm64:
        if target_is_host(target) {
            // Native: configure names its build dir with the host
            // triple, so the Makefile copies the result to this stable
            // path, as for the mac entry below.
            return "vendor/libffi/libffi-linux-arm64.a"
        }
        return "vendor/libffi/build-linux-arm64/.libs/libffi.a"
    case .LinuxRiscv64: return "vendor/libffi/build-linux-riscv64/.libs/libffi.a"
    case .LinuxX86:     return "vendor/libffi/build-linux-x86/.libs/libffi.a"
    case .LinuxArm32:   return "vendor/libffi/build-linux-arm32/.libs/libffi.a"
    case .LinuxRiscv32: return "vendor/libffi/build-linux-riscv32/.libs/libffi.a"
    // A mac host keeps the bootstrap's own archive: configure names the
    // build dir with a version-suffixed triple, so the Makefile copies
    // the result to this stable path. Any other host -- the other mac
    // arch included, since that archive is the host's arch only --
    // links make.til's out-of-tree build (SDK-less off a mac).
    case .MacosX64:
        if target_is_host(target) { return "vendor/libffi/libffi-macos.a" }
        return "vendor/libffi/build-macos-x64/.libs/libffi.a"
    case .MacosArm64:
        if target_is_host(target) { return "vendor/libffi/libffi-macos.a" }
        return "vendor/libffi/build-macos-arm64/.libs/libffi.a"
    // mingw's target triple is fixed (no version suffix), so this path
    // is stable and usable from any host that has the win64 libffi
    // built -- unlike the mac/arm64 stable-path copies. This unlocks
    // windows AS A HOST (til.exe links libffi for its ext_func
    // interpreter dispatch) and runtime ext_func in cross-built user
    // programs (issue #25).
    case .WindowsX64:   return "vendor/libffi/x86_64-w64-mingw32/.libs/libffi.a"
    case .WindowsX86:   return "vendor/libffi/i686-w64-mingw32/.libs/libffi.a"
    case .Jvm: panic("JVM target has no C libffi archive")
    case: return ""
    }
    return ""
}

// The command that produces target_ffi_lib's archive, for the loud
// missing-archive report in compile_c. Kept beside the path table so
// the two cannot drift: the windows triples and the linux cross builds
// are bin/make path goals, the native stable-path copies come out of
// the bootstrap on a matching host.
target_ffi_build_hint := proc(target: Target) returns Str {
    switch target {
    case .WindowsX64:   return "bin/make vendor/libffi/x86_64-w64-mingw32/.libs/libffi.a"
    case .WindowsX86:   return "bin/make vendor/libffi/i686-w64-mingw32/.libs/libffi.a"
    case .LinuxX64:     return "make (the bootstrap builds the native libffi)"
    case .LinuxArm64:
        if target_is_host(target) {
            return "make (the bootstrap builds the native libffi and stable-copies the archive)"
        }
        return "bin/make vendor/libffi/build-linux-arm64/.libs/libffi.a"
    case .LinuxRiscv64: return "bin/make vendor/libffi/build-linux-riscv64/.libs/libffi.a"
    case .LinuxX86:     return "bin/make vendor/libffi/build-linux-x86/.libs/libffi.a"
    case .LinuxArm32:   return "bin/make vendor/libffi/build-linux-arm32/.libs/libffi.a"
    case .LinuxRiscv32: return "bin/make --riscv32-cc=<path to riscv32 gcc> vendor/libffi/build-linux-riscv32/.libs/libffi.a"
    case .MacosX64:
        if target_is_host(target) {
            return "make (the bootstrap builds the native libffi and stable-copies the archive)"
        }
        return "bin/make vendor/libffi/build-macos-x64/.libs/libffi.a"
    case .MacosArm64:
        if target_is_host(target) {
            return "make (the bootstrap builds the native libffi and stable-copies the archive)"
        }
        return "bin/make vendor/libffi/build-macos-arm64/.libs/libffi.a"
    case .Jvm: panic("JVM target has no C libffi build")
    case: return "this target has no vendored libffi build"
    }
    return ""
}

// Is `target` the platform this compiler itself runs on? The vendored
// archives at their canonical paths are built for the host, so they are
// the right archives exactly when this holds.
target_is_host := proc(target: Target) returns Bool {
    return target_to_str(target) == target_to_str(detect_current_target())
}

// The libsecp256k1 archive a program importing std/crypto links when
// built for `target` from a different host (issue #235). The canonical
// vendor/secp256k1/libsecp256k1.a is the HOST's own archive -- make builds
// it natively, and a windows host's tree lays its win64 archive out there
// too -- so the builder consults this table only when `target` is not
// the host (target_is_host). Each path is a bin/make goal (make.til's
// secp256k1_cross_targets builds them; keep the two in step). "" means no
// cross archive exists for the target, which the builder reports instead
// of linking the host's archive.
target_secp256k1_lib := func(target: Target) returns Str {
    switch target {
    case .WindowsX64:   return "vendor/secp256k1/build-win64/lib/libsecp256k1.a"
    case .WindowsX86:   return "vendor/secp256k1/build-win32/lib/libsecp256k1.a"
    case .LinuxArm64:   return "vendor/secp256k1/build-linux-arm64/lib/libsecp256k1.a"
    case .LinuxRiscv64: return "vendor/secp256k1/build-linux-riscv64/lib/libsecp256k1.a"
    case .LinuxX86:     return "vendor/secp256k1/build-linux-x86/lib/libsecp256k1.a"
    case .LinuxArm32:   return "vendor/secp256k1/build-linux-arm32/lib/libsecp256k1.a"
    case .LinuxRiscv32: return "vendor/secp256k1/build-linux-riscv32/lib/libsecp256k1.a"
    case .MacosX64:     return "vendor/secp256k1/build-macos-x64/lib/libsecp256k1.a"
    case .MacosArm64:   return "vendor/secp256k1/build-macos-arm64/lib/libsecp256k1.a"
    // Built with emcc (issue #420), so it links where wasm32 programs
    // link with emscripten's libc: the mode gui path.
    case .Wasm32:       return "vendor/secp256k1/build-wasm32/lib/libsecp256k1.a"
    // linux-x64 from another host (a mac, an arm64 linux): built with that
    // host's linux-x64 cross gcc (bin/make --linux-x64-cc=, issue #420).
    case .LinuxX64:     return "vendor/secp256k1/build-linux-x64/lib/libsecp256k1.a"
    // TempleOS, JVM: none.
    case: return ""
    }
    return ""
}

// The command that builds target_secp256k1_lib's archive, for the
// builder's missing-archive report (issue #435): its bin/make path goal,
// plus the option that names the compiler where the default cannot be
// relied on -- riscv32 has none, and linux-x64's x86_64-linux-gnu-gcc
// is the distro cross gcc, which a mac does not have.
target_secp256k1_build_hint := func(target: Target) returns Str {
    lib := target_secp256k1_lib(target)
    switch target {
    case .LinuxRiscv32: return format("bin/make --riscv32-cc=<path to riscv32 gcc> ", lib)
    case .LinuxX64:
        return format("bin/make ", lib, " (with --linux-x64-cc=<path> unless x86_64-linux-gnu-gcc is this host's linux-x64 cross gcc)")
    case: return format("bin/make ", lib)
    }
    return ""
}

// raylib + tinyfd + windowing-system libs when src/modes/gui.til is loaded.
// Builder checks the resolved import graph. A proc because the macOS
// case is host-aware (macos_is_cross). Empty on targets where GUI
// cross-builds don't exist yet.
target_gui_libs := proc(target: Target) returns Str {
    switch target {
    case .LinuxX64:
        return "vendor/raylib/src/libraylib.a vendor/tinyfiledialogs/libtinyfd.a"
    // Native arm64 linux hosts build the same vendor paths natively,
    // exactly like the macos entries below (issue #25); any other host
    // cross-links the -arm64 archives make.til builds with the distro
    // cross gcc (issue #420). Same for riscv64, which had no entry.
    case .LinuxArm64:
        if target_is_host(target) {
            return "vendor/raylib/src/libraylib.a vendor/tinyfiledialogs/libtinyfd.a"
        }
        return "vendor/raylib/src/libraylib-arm64.a vendor/tinyfiledialogs/libtinyfd-arm64.a"
    case .LinuxRiscv64:
        if target_is_host(target) {
            return "vendor/raylib/src/libraylib.a vendor/tinyfiledialogs/libtinyfd.a"
        }
        return "vendor/raylib/src/libraylib-riscv64.a vendor/tinyfiledialogs/libtinyfd-riscv64.a"
    case .LinuxX86:
        return "vendor/raylib/src/libraylib-x86.a vendor/tinyfiledialogs/libtinyfd-x86.a"
    case .LinuxArm32:
        return "vendor/raylib/src/libraylib-arm32.a vendor/tinyfiledialogs/libtinyfd-arm32.a"
    case .LinuxRiscv32:
        return "vendor/raylib/src/libraylib-riscv32.a vendor/tinyfiledialogs/libtinyfd-riscv32.a"
    case .WindowsX64:
        return "vendor/raylib/src/libraylib-win64.a vendor/tinyfiledialogs/libtinyfd-win64.a -lgdi32 -lopengl32 -lwinmm -lole32 -luuid -lcomdlg32 -limm32"
    case .WindowsX86:
        return "vendor/raylib/src/libraylib-win32.a vendor/tinyfiledialogs/libtinyfd-win32.a -lgdi32 -lopengl32 -lwinmm -lole32 -luuid -lcomdlg32 -limm32"
    case .Wasm32:
        return "vendor/raylib/src/libraylib-web.a -sUSE_GLFW=3 -sASYNCIFY -sALLOW_MEMORY_GROWTH=1 -sSINGLE_FILE --shell-file vendor/raylib/src/shell.html"
    // macOS. On a mac HOST (native) the vendored raylib/tinyfd recipes
    // produce mac-native .a files at the same paths as on Linux, and the
    // real Apple frameworks satisfy the final link. A NON-mac host
    // CROSS-links instead against the vendored mac raylib archive
    // (libraylib-macos-<arch>.a, built on the mac CI) + a mac tinyfd
    // (cross-built on any host -- it only needs libc) + the framework
    // .tbd stubs (vendor/macos/frameworks/*.tbd, generated from raylib.a's
    // undefined symbols). The stubs make the linker resolve Cocoa/OpenGL/
    // ... symbols the same way libSystem.tbd does; the real frameworks
    // bind at runtime on the target mac (issue #25 phase 3). The *.tbd
    // glob is expanded by the shell (system_cmd runs the link via
    // system()).
    case .MacosX64:
        if macos_is_cross(target) {
            return "vendor/raylib/src/libraylib-macos-x64.a vendor/tinyfiledialogs/libtinyfd-macos-x64.a vendor/macos/frameworks/*.tbd"
        }
        return "vendor/raylib/src/libraylib.a vendor/tinyfiledialogs/libtinyfd.a -framework OpenGL -framework Cocoa -framework IOKit -framework CoreAudio -framework CoreVideo"
    case .MacosArm64:
        if macos_is_cross(target) {
            return "vendor/raylib/src/libraylib-macos-arm64.a vendor/tinyfiledialogs/libtinyfd-macos-arm64.a vendor/macos/frameworks/*.tbd"
        }
        return "vendor/raylib/src/libraylib.a vendor/tinyfiledialogs/libtinyfd.a -framework OpenGL -framework Cocoa -framework IOKit -framework CoreAudio -framework CoreVideo"
    case .Jvm: panic("JVM target has no C GUI libraries")
    case: return ""
    }
    return ""
}

// ---------- Detect current platform

// The default build/run target: the platform this binary itself was
// compiled for, read from host_os()/host_arch() (compile-time string
// literals) rather than uname. uname is wrong for a self-hosting
// compiler on two counts: it does not exist on a Windows host (til.exe
// would fall back to LinuxX64 and emit linux link flags -- the bug that
// blocked windows AS A HOST, issue #25), and under emulation (wine,
// qemu-user) it reports the KERNEL's platform while this binary, and
// the toolchain/libffi linked into it, are the compiled platform, which
// is what the default target must match. It is also free: the old
// version spawned two uname subprocesses on every invocation.
detect_current_target := proc() returns Target {
    os := host_os()
    arch := host_arch()
    switch os {
    case "macos":
        if arch == "arm64" { return Target.MacosArm64 }
        return Target.MacosX64
    case "windows":
        if arch == "x86" { return Target.WindowsX86 }
        return Target.WindowsX64
    case "linux":
        switch arch {
        case "arm64":   return Target.LinuxArm64
        case "riscv64": return Target.LinuxRiscv64
        case "arm32":   return Target.LinuxArm32
        case "riscv32": return Target.LinuxRiscv32
        case "x86":     return Target.LinuxX86
        case:
        }
        return Target.LinuxX64
    case:
    }
    return Target.LinuxX64
}
