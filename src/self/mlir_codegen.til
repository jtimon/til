mode lib
import("loader")
import("../std/file")

// Value/control-flow MLIR slice, with the Linux x86-64
// SysV ABI used by the C backend. Vector registers are not the public ABI.
priv MlirBinding := struct {
    value := ""
    type_name := ""
    is_mut := false
    is_signed := false
    is_ref := false
}

priv MlirState := struct {
    text := ""
    allocations := ""
    globals := ""
    symbol_prefix := ""
    needs_panic := false
    next : USize = 0
    next_block : USize = 0
    terminated := false
    break_label := ""
    continue_label := ""
    has_break := false
    values := Map(Str, MlirBinding).new()
    functions := Set(Str).new()
    error_parameter := ""
    error_known_clear := false
    error_version : USize = 0
    clear_conditions := Set(Str).new()
    set_conditions := Set(Str).new()
    bang_conditions := Set(Str).new()
    // Compile-time values used by lane indices and lowered bounds-error checks.
    integers := Map(Str, U64).new()
    booleans := Map(Str, Bool).new()
}

priv mlir_f4_type := func() returns Str {
    return "!llvm.struct<(vector<2xf32>, vector<2xf32>)>"
}

priv mlir_type := func(shallow t: Type, lp: LoadedProgram) returns Str {
    switch t {
    case .Primitive(p):
        switch p {
        case .Bool: return "i1"
        case .I32, .U32: return "i32"
        case .I64, .U64: return "i64"
        case:
        }
    case:
    }
    if t == Type.Primitive(Primitive.F32) { return "f32" }
    ref name : Str = type_name_ref(t, lp.ctx.symbols)
    if name == "Array__F32" { return "!llvm.ptr" }
    if name == "F32" { return "f32" }
    if t.is(Type.None) { return "void" }
    definition := lp.ctx.scope.get_struct(name, lp.ctx.symbols)
    if definition.is_some() {
        if definition.unwrap().node_type.is(NodeType.StructDef) {
            ref sd : StructDef = structdef_of(definition.unwrap())
            if sd.simd_width == 4 {
                if decl_type_name_ref(sd.fields[0], lp.ctx.symbols) == "F32" { return "vector<4xf32>" }
                if decl_type_name_ref(sd.fields[0], lp.ctx.symbols) == "Bool" { return "vector<4xi1>" }
            }
        }
    }
    return ""
}

priv mlir_error := proc(e: Expr, message: Str, mut lp: LoadedProgram) returns Str {
    e.type_error(format("MLIR backend: ", message), lp.ctx)
    return ""
}

priv mlir_value := func(mut state: MlirState, expression: Str) returns Str {
    name := format("%v", state.next.to_str())
    state.next++
    state.text = format(state.text, "    ", name, " = ", expression, "\n")
    return name
}

priv mlir_alignment := func(t: Str) returns Str {
    if t == "i1" { return "1" }
    if t == "i64" || t == "!llvm.ptr" { return "8" }
    return "4"
}

priv mlir_slot := func(t: Str, mut state: MlirState) returns Str {
    name := format("%v", state.next.to_str())
    state.next++
    state.allocations = format(state.allocations, "    ", name,
        " = llvm.alloca %alloc_count x ", t, " {alignment = ", mlir_alignment(t),
        " : i64} : (i64) -> !llvm.ptr\n")
    return name
}

priv mlir_store := func(pointer: Str, value: Str, t: Str, mut state: MlirState) {
    state.text = format(state.text, "    llvm.store ", value, ", ", pointer,
        " {alignment = ", mlir_alignment(t), " : i64} : ", t, ", !llvm.ptr\n")
}

priv mlir_label := func(mut state: MlirState) returns Str {
    name := format("block", state.next_block.to_str())
    state.next_block++
    return name
}

priv mlir_block := func(name: Str, mut state: MlirState) {
    state.text = format(state.text, "  ^", name, ":\n")
    state.terminated = false
}

priv mlir_branch := func(name: Str, mut state: MlirState) {
    state.text = format(state.text, "    llvm.br ^", name, "\n")
    state.terminated = true
}

priv mlir_signed := func(shallow t: Type) returns Bool {
    return t.eq(Type.Primitive(Primitive.I32)).or(t.eq(Type.Primitive(Primitive.I64)))
}

priv mlir_convert := proc(value: Str, from: Str, target: Str, signed_value: Bool, source: Expr, mut state: MlirState, mut lp: LoadedProgram) returns Str {
    if from == target { return value.clone() }
    if from == "i32" && target == "i64" {
        mut operation := "extui"
        if signed_value { operation = "extsi" }
        return mlir_value(state, format("arith.", operation, " ", value, " : i32 to i64"))
    }
    return mlir_error(source, format("unsupported value conversion from ", from, " to ", target), lp)
}

priv mlir_coerce := proc(value: Str, source: Expr, target: Str, mut state: MlirState, mut lp: LoadedProgram) returns Str {
    return mlir_convert(value, mlir_type(source.til_type(), lp), target,
        mlir_signed(source.til_type()), source, state, lp)
}

priv mlir_join := func(lo: Str, hi: Str, mut state: MlirState) returns Str {
    return mlir_value(state, format("vector.shuffle ", lo, ", ", hi,
        " [0, 1, 2, 3] : vector<2xf32>, vector<2xf32>"))
}

priv mlir_half := func(value: Str, high: Bool, mut state: MlirState) returns Str {
    mut lanes := "0, 1"
    if high { lanes = "2, 3" }
    return mlir_value(state, format("vector.shuffle ", value, ", ", value,
        " [", lanes, "] : vector<4xf32>, vector<4xf32>"))
}

priv mlir_lane := func(value: Str, index: U64, mut state: MlirState) returns Str {
    return mlir_value(state, format("vector.extract ", value, "[", index.to_str(), "] : f32 from vector<4xf32>"))
}

priv mlir_integer_type := func(shallow t: Type) returns Bool {
    switch t {
    case .Primitive(p):
        switch p {
        case .I32, .U32, .I64, .U64: return true
        case: return false
        }
    case: return false
    }
}

priv mlir_integer := func(e: Expr, state: MlirState, lp: LoadedProgram) returns Option(U64) {
    switch e.node_type {
    case .Literal(Literal.Num(n)):
        if mlir_integer_type(e.til_type()) {
            mut value := n.to_u64()
            // Compare the typed bit pattern, including signed 32-bit literals.
            if e.til_type() == Type.Primitive(Primitive.I32) || e.til_type() == Type.Primitive(Primitive.U32) {
                value = value.band(0xffffffff)
            }
            return Option(U64).Some(value)
        }
    case .Ident(id):
        ref name : Str = id.ident_name(lp.ctx.symbols.names)
        if name == state.error_parameter {
            if state.error_known_clear { return Option(U64).Some(0) }
            return Option(U64).None
        }
        if state.integers.has(name) { return Option(U64).Some(state.integers[name]) }
    case:
    }
    return Option(U64).None
}

priv mlir_error_write := func(mut state: MlirState) {
    state.error_known_clear = false
    state.error_version++
    state.clear_conditions.clear()
    state.set_conditions.clear()
}

priv mlir_tests_error_value := func(e: Expr, expected: U64, state: MlirState, lp: LoadedProgram) returns Bool {
    if state.error_parameter.len() == 0 { return false }
    switch e.node_type {
    case .Ident(id):
        if expected == 0 { return state.clear_conditions.has(id.ident_name(lp.ctx.symbols.names)) }
        return state.set_conditions.has(id.ident_name(lp.ctx.symbols.names))
    case .FCall:
        if e.children.len() != 3 { return false }
        switch e.children[0].node_type {
        case .FieldAccess(field):
            if field.field_access_name(lp.ctx.symbols.names) != "eq" { return false }
            switch e.children[1].node_type {
            case .Ident(id):
                if id.ident_name(lp.ctx.symbols.names) != state.error_parameter { return false }
                zero := mlir_integer(e.children[2], state, lp)
                return zero.is_some().and(zero.unwrap() == expected)
            case: return false
            }
        case: return false
        }
    case: return false
    }
}

priv mlir_boolean := func(e: Expr, state: MlirState, lp: LoadedProgram) returns Option(Bool) {
    switch e.node_type {
    case .Literal(Literal.Bool(value)): return Option(Bool).Some(value)
    case .Ident(id):
        ref name : Str = id.ident_name(lp.ctx.symbols.names)
        if state.booleans.has(name) { return Option(Bool).Some(state.booleans[name]) }
    case .FCall:
        if e.children.len() == 3 {
            ref callee : Expr = e.children[0]
            switch callee.node_type {
            case .FieldAccess(field):
                if callee.children.len() == 1 {
                    switch callee.children[0].node_type {
                    case .Ident(id):
                        owner := type_from_name_init_name(id.ident_name(lp.ctx.symbols.names), lp.ctx.scope, lp.ctx.symbols)
                        if mlir_integer_type(owner) {
                            a := mlir_integer(e.children[1], state, lp)
                            b := mlir_integer(e.children[2], state, lp)
                            ref op : Str = field.field_access_name(lp.ctx.symbols.names)
                            if a.is_some() && b.is_some() && op == "eq" { return Option(Bool).Some(a.unwrap() == b.unwrap()) }
                        }
                    case:
                    }
                }
            case:
            }
        }
    case:
    }
    return Option(Bool).None
}

priv mlir_construct := proc(e: Expr, mut state: MlirState, mut lp: LoadedProgram) returns Str {
    t := mlir_type(e.til_type(), lp)
    mut scalar := "f32"
    if t == "vector<4xi1>" { scalar = "i1" }
    mut vector := mlir_value(state, format("llvm.mlir.undef : ", t))
    for i in 0..4 {
        lane := mlir_expr(e.children[(i + 1).to_usize()], state, lp)
        vector = mlir_value(state, format("vector.insert ", lane, ", ", vector,
            "[", i.to_str(), "] : ", scalar, " into ", t))
    }
    return vector
}

// The C mask is four normalized Bool bytes, classified as one SysV INTEGER
// chunk. Register predicates remain i1 lanes; never expose their packed bits.
priv mlir_pack_mask := func(value: Str, mut state: MlirState) returns Str {
    bytes := mlir_value(state, format("arith.extui ", value, " : vector<4xi1> to vector<4xi8>"))
    return mlir_value(state, format("llvm.bitcast ", bytes, " : vector<4xi8> to i32"))
}

priv mlir_unpack_mask := func(value: Str, mut state: MlirState) returns Str {
    bytes := mlir_value(state, format("llvm.bitcast ", value, " : i32 to vector<4xi8>"))
    zero := mlir_value(state, "arith.constant dense<0> : vector<4xi8>")
    return mlir_value(state, format("arith.cmpi ne, ", bytes, ", ", zero, " : vector<4xi8>"))
}

priv mlir_pack_return := func(value: Str, mut state: MlirState) returns Str {
    lo := mlir_half(value, false, state)
    hi := mlir_half(value, true, state)
    empty := mlir_value(state, format("llvm.mlir.undef : ", mlir_f4_type()))
    first := mlir_value(state, format("llvm.insertvalue ", lo, ", ", empty, "[0] : ", mlir_f4_type()))
    return mlir_value(state, format("llvm.insertvalue ", hi, ", ", first, "[1] : ", mlir_f4_type()))
}

priv mlir_root := func(lp: LoadedProgram) returns ref Expr {
    return lp.ctx.imported[lp.units[lp.units.len() - 1].path].ast
}

// Capture source declarations before preparation appends generic core helpers
// (including helpers referenced only by generated type namespaces).
mlir_source_declarations := func(lp: LoadedProgram) returns Set(Str) {
    mut names := Set(Str).new()
    for stmt : Expr in mlir_root(lp).children {
        if stmt.node_type.is(NodeType.Decl) {
            names.add(own decl_of(stmt).name.clone())
        }
    }
    return names
}

priv mlir_find_function := func(name: Str, lp: LoadedProgram) returns Option(ref Expr) {
    for stmt : Expr in mlir_root(lp).children {
        switch stmt.node_type {
        case .Decl(dd):
            if dd.name == name && stmt.children.len() == 1 {
                if stmt.children[0].node_type.is(NodeType.FuncDef) { return safe_ref(stmt.children[0]) }
            }
        case:
        }
    }
    return Option(ref Expr).None
}

priv mlir_count_type := func(lp: LoadedProgram) returns Str {
    return mlir_type(type_from_name_init_name("USize", lp.ctx.scope, lp.ctx.symbols), lp)
}

priv mlir_buffer_length := func(buffer: Str, mut state: MlirState, lp: LoadedProgram) returns Str {
    count_type := mlir_count_type(lp)
    field := mlir_value(state, format("llvm.getelementptr ", buffer,
        "[0, 1] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(!llvm.ptr, ", count_type, ")>"))
    return mlir_value(state, format("llvm.load ", field, " {alignment = ",
        mlir_alignment(count_type), " : i64} : !llvm.ptr -> ", count_type))
}

priv mlir_checked_memory := proc(e: Expr, vector: Bool, store: Bool, mut state: MlirState, mut lp: LoadedProgram) returns Str {
    if state.error_parameter.len() == 0 {
        return mlir_error(e, "checked buffer operation has no lowered error slot", lp)
    }
    mut arguments := Vec(Str).new()
    for i in 1..e.children.len() - 1 { arguments.push(own mlir_expr(e.children[i], state, lp)) }
    error := mlir_expr(e.children[e.children.len() - 1], state, lp, true)
    mlir_error_write(state)
    mut buffer_index : USize = 0
    mut index_index : USize = 1
    mut value_index : USize = 2
    if vector && store { buffer_index = 1; index_index = 2; value_index = 0 }
    ref buffer : Str = arguments[buffer_index]
    ref index : Str = arguments[index_index]
    count := mlir_buffer_length(buffer, state, lp)
    count_type := mlir_count_type(lp)
    success := mlir_label(state)
    failure := mlir_label(state)
    done := mlir_label(state)
    mut result_type := "!llvm.ptr"
    if vector { result_type = "vector<4xf32>" }
    mut result_slot := ""
    if store.not() { result_slot = mlir_slot(result_type, state) }
    if vector {
        span := mlir_label(state)
        start_ok := mlir_value(state, format("arith.cmpi ule, ", index, ", ", count, " : ", count_type))
        state.text = format(state.text, "    llvm.cond_br ", start_ok, ", ^", span, ", ^", failure, "\n")
        mlir_block(span, state)
        remaining := mlir_value(state, format("arith.subi ", count, ", ", index, " : ", count_type))
        width := mlir_value(state, format("arith.constant 4 : ", count_type))
        fits := mlir_value(state, format("arith.cmpi uge, ", remaining, ", ", width, " : ", count_type))
        state.text = format(state.text, "    llvm.cond_br ", fits, ", ^", success, ", ^", failure, "\n")
    } else {
        fits := mlir_value(state, format("arith.cmpi ult, ", index, ", ", count, " : ", count_type))
        state.text = format(state.text, "    llvm.cond_br ", fits, ", ^", success, ", ^", failure, "\n")
    }
    mlir_block(success, state)
    // Form no data address until the whole access has passed its check.
    data_field := mlir_value(state, format("llvm.getelementptr ", buffer,
        "[0, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(!llvm.ptr, ", count_type, ")>"))
    data := mlir_value(state, format("llvm.load ", data_field, " {alignment = 8 : i64} : !llvm.ptr -> !llvm.ptr"))
    mut wide_index := index.clone()
    if count_type == "i32" { wide_index = mlir_value(state, format("arith.extui ", index, " : i32 to i64")) }
    address := mlir_value(state, format("llvm.getelementptr ", data, "[", wide_index,
        "] : (!llvm.ptr, i64) -> !llvm.ptr, f32"))
    if store {
        mut value_type := "f32"
        if vector { value_type = "vector<4xf32>" }
        mlir_store(address, arguments[value_index], value_type, state)
    } else if vector {
        value := mlir_value(state, format("llvm.load ", address, " {alignment = 4 : i64} : !llvm.ptr -> vector<4xf32>"))
        mlir_store(result_slot, value, result_type, state)
    } else { mlir_store(result_slot, address, result_type, state) }
    mlir_branch(done, state)
    mlir_block(failure, state)
    kind := mlir_value(state, "arith.constant 1 : i64")
    mlir_store(error, kind, "i64", state)
    if store.not() {
        mut fallback := ""
        if vector { fallback = mlir_value(state, "arith.constant dense<0.0> : vector<4xf32>") }
        else {
            zero := mlir_value(state, "arith.constant 0 : i64")
            fallback = mlir_value(state, format("llvm.inttoptr ", zero, " : i64 to !llvm.ptr"))
        }
        mlir_store(result_slot, fallback, result_type, state)
    }
    mlir_branch(done, state)
    mlir_block(done, state)
    if store { return "" }
    return mlir_value(state, format("llvm.load ", result_slot, " {alignment = ",
        mlir_alignment(result_type), " : i64} : !llvm.ptr -> ", result_type))
}

priv mlir_expr := proc(e: Expr, mut state: MlirState, mut lp: LoadedProgram, borrow: Bool = false) returns Str {
    switch e.node_type {
    case .Ident(id):
        ref name : Str = id.ident_name(lp.ctx.symbols.names)
        if state.values.has(name) {
            ref binding : MlirBinding = state.values[name]
            if borrow && binding.type_name != "!llvm.ptr" {
                if binding.is_ref.or(binding.is_mut).not() { return mlir_error(e, "address requires a stored local or borrowed value", lp) }
                return binding.value.clone()
            }
            mut value := binding.value.clone()
            if binding.is_mut || binding.is_ref {
                t := binding.type_name.clone()
                value = mlir_value(state, format("llvm.load ", binding.value,
                    " {alignment = ", mlir_alignment(t), " : i64} : !llvm.ptr -> ", t))
            }
            // Alias elimination can leave a wider type on this identifier.
            // Convert the actual binding value, not an imagined wider load.
            return mlir_convert(value, binding.type_name, mlir_type(e.til_type(), lp), binding.is_signed, e, state, lp)
        }
        return mlir_error(e, format("unsupported global or value '", name, "'"), lp)
    case .Literal(Literal.Bool(value)):
        mut literal := "0"
        if value { literal = "1" }
        return mlir_value(state, format("arith.constant ", literal, " : i1"))
    case .Literal(Literal.Num(num)):
        if mlir_integer_type(e.til_type()) {
            value := mlir_integer(e, state, lp).unwrap()
            return mlir_value(state, format("arith.constant ", value.to_str(), " : ", mlir_type(e.til_type(), lp)))
        }
        if mlir_type(e.til_type(), lp) != "f32" { return mlir_error(e, "only F32 numeric literals are supported", lp) }
        value := num.to_f32()
        mut bits : U32 = 0
        memcpy(to_ptr(bits), to_ptr(value), 4)
        mut hex := ""
        digits := "0123456789ABCDEF"
        for i in 0..8 {
            digit := bits.shr(((7 - i) * 4).to_u32()).band(15)
            hex = format(hex, digits.substr(digit.to_usize(), 1))
        }
        return mlir_value(state, format("arith.constant 0x", hex, " : f32"))
    case .FCall:
        ref callee : Expr = e.children[0]
        switch callee.node_type {
        case .FieldAccess(field):
            if callee.children.len() != 1 { return mlir_error(e, "unsupported method receiver", lp) }
            ref owner : Expr = callee.children[0]
            switch owner.node_type {
            case .Ident(id):
                owner_type := type_from_name_init_name(id.ident_name(lp.ctx.symbols.names), lp.ctx.scope, lp.ctx.symbols)
                t := mlir_type(owner_type, lp)
                ref op : Str = field.field_access_name(lp.ctx.symbols.names)
                if t.len() == 0 { return mlir_error(e, "unsupported operation type", lp) }
                if t == "!llvm.ptr" {
                    if op == "len" && e.children.len() == 2 {
                        buffer := mlir_expr(e.children[1], state, lp)
                        return mlir_buffer_length(buffer, state, lp)
                    }
                    if op == "get" && e.children.len() == 4 {
                        address := mlir_checked_memory(e, false, false, state, lp)
                        if borrow { return address }
                        return mlir_value(state, format("llvm.load ", address, " {alignment = 4 : i64} : !llvm.ptr -> f32"))
                    }
                    if op == "set" && e.children.len() == 5 { return mlir_checked_memory(e, false, true, state, lp) }
                    return mlir_error(e, format("unsupported borrowed-buffer operation '", op, "'"), lp)
                }
                if op.eq("inc").or(op.eq("dec")) && e.children.len() == 2 && mlir_integer_type(owner_type) {
                    switch e.children[1].node_type {
                    case .Ident(id):
                        ref name : Str = id.ident_name(lp.ctx.symbols.names)
                        if state.values.has(name).not() { return mlir_error(e, "increment requires a local", lp) }
                        ref binding : MlirBinding = state.values[name]
                        if binding.is_mut.not() { return mlir_error(e, "increment requires mutable storage", lp) }
                        value := mlir_expr(e.children[1], state, lp)
                        one := mlir_value(state, format("arith.constant 1 : ", t))
                        mut operation := "addi"
                        if op == "dec" { operation = "subi" }
                        result := mlir_value(state, format("arith.", operation, " ", value, ", ", one, " : ", t))
                        mlir_store(binding.value, result, t, state)
                        return ""
                    case: return mlir_error(e, "increment requires a local identifier", lp)
                    }
                }
                if op.eq("add").or(op.eq("mul")).or(op.eq("sub")) && e.children.len() == 3 {
                    a_value := mlir_expr(e.children[1], state, lp)
                    a := mlir_coerce(a_value, e.children[1], t, state, lp)
                    b_value := mlir_expr(e.children[2], state, lp)
                    b := mlir_coerce(b_value, e.children[2], t, state, lp)
                    mut suffix := "f"
                    if mlir_integer_type(owner_type) { suffix = "i" }
                    if t == "i1" { return mlir_error(e, "Boolean arithmetic is not supported", lp) }
                    return mlir_value(state, format("arith.", op, suffix, " ", a, ", ", b, " : ", t))
                }
                if t == "i1" && op == "not" && e.children.len() == 2 {
                    a := mlir_expr(e.children[1], state, lp)
                    one := mlir_value(state, "arith.constant 1 : i1")
                    return mlir_value(state, format("arith.xori ", a, ", ", one, " : i1"))
                }
                if e.children.len() == 3 {
                    mut predicate := ""
                    switch op {
                    case "eq": predicate = "eq"
                    case "neq": predicate = "ne"
                    case "lt": predicate = "lt"
                    case "lte": predicate = "le"
                    case "gt": predicate = "gt"
                    case "gte": predicate = "ge"
                    case:
                    }
                    if predicate.len() > 0 {
                        a_value := mlir_expr(e.children[1], state, lp)
                        a := mlir_coerce(a_value, e.children[1], t, state, lp)
                        b_value := mlir_expr(e.children[2], state, lp)
                        b := mlir_coerce(b_value, e.children[2], t, state, lp)
                        if t == "f32" || t == "vector<4xf32>" {
                            if predicate == "ne" { predicate = "une" }
                            else { predicate = format("o", predicate) }
                            return mlir_value(state, format("arith.cmpf ", predicate, ", ", a, ", ", b, " : ", t))
                        }
                        if predicate != "eq" && predicate != "ne" {
                            mut sign := "s"
                            if owner_type == Type.Primitive(Primitive.U32) || owner_type == Type.Primitive(Primitive.U64) || t == "i1" { sign = "u" }
                            predicate = format(sign, predicate)
                        }
                        return mlir_value(state, format("arith.cmpi ", predicate, ", ", a, ", ", b, " : ", t))
                    }
                }
                if t == "vector<4xi1>" || t == "vector<4xf32>" {
                    if op == "select" && e.children.len() == 4 {
                        mask := mlir_expr(e.children[1], state, lp)
                        a := mlir_expr(e.children[2], state, lp)
                        b := mlir_expr(e.children[3], state, lp)
                        return mlir_value(state, format("arith.select ", mask, ", ", a, ", ", b, " : vector<4xi1>, ", t))
                    }
                }
                if t == "vector<4xi1>" {
                    if op == "new" && e.children.len() == 5 { return mlir_construct(e, state, lp) }
                    if op == "zero" && e.children.len() == 1 { return mlir_value(state, "arith.constant dense<false> : vector<4xi1>") }
                    if op == "splat" && e.children.len() == 2 {
                        value := mlir_expr(e.children[1], state, lp)
                        return mlir_value(state, format("vector.broadcast ", value, " : i1 to vector<4xi1>"))
                    }
                    if op.eq("band").or(op.eq("bor")).or(op.eq("bxor")) && e.children.len() == 3 {
                        a := mlir_expr(e.children[1], state, lp)
                        b := mlir_expr(e.children[2], state, lp)
                        mut operation := "andi"
                        if op == "bor" { operation = "ori" }
                        if op == "bxor" { operation = "xori" }
                        return mlir_value(state, format("arith.", operation, " ", a, ", ", b, " : ", t))
                    }
                    if op == "bnot" && e.children.len() == 2 {
                        value := mlir_expr(e.children[1], state, lp)
                        ones := mlir_value(state, "arith.constant dense<true> : vector<4xi1>")
                        return mlir_value(state, format("arith.xori ", value, ", ", ones, " : ", t))
                    }
                    if op.eq("all").or(op.eq("any")) && e.children.len() == 2 {
                        value := mlir_expr(e.children[1], state, lp)
                        mut operation := "and"
                        if op == "any" { operation = "or" }
                        return mlir_value(state, format("vector.reduction <", operation, ">, ", value, " : vector<4xi1> into i1"))
                    }
                    if op == "get" && e.children.len() == 4 {
                        index := mlir_integer(e.children[2], state, lp)
                        if index.is_none() { return mlir_error(e, "SIMD lane index must be statically known and in 0..3", lp) }
                        if index.unwrap() >= 4 { return mlir_error(e, "SIMD lane index must be statically known and in 0..3", lp) }
                        value := mlir_expr(e.children[1], state, lp)
                        return mlir_value(state, format("vector.extract ", value, "[", index.unwrap().to_str(), "] : i1 from vector<4xi1>"))
                    }
                }
                if t == "vector<4xf32>" {
                    if op == "load" && e.children.len() == 4 { return mlir_checked_memory(e, true, false, state, lp) }
                    if op == "store" && e.children.len() == 5 { return mlir_checked_memory(e, true, true, state, lp) }
                    if op == "new" && e.children.len() == 5 { return mlir_construct(e, state, lp) }
                    if op == "splat" && e.children.len() == 2 {
                        value := mlir_expr(e.children[1], state, lp)
                        return mlir_value(state, format("vector.broadcast ", value, " : f32 to vector<4xf32>"))
                    }
                    if op == "zero" && e.children.len() == 1 { return mlir_value(state, "arith.constant dense<0.0> : vector<4xf32>") }
                    if op == "reduce_add" && e.children.len() == 2 {
                        value := mlir_expr(e.children[1], state, lp)
                        a := mlir_lane(value, 0, state)
                        b := mlir_lane(value, 1, state)
                        c := mlir_lane(value, 2, state)
                        d := mlir_lane(value, 3, state)
                        // No vector.reduction or initial +0: til's exact tree,
                        // including the sign of an all-negative-zero sum.
                        even := mlir_value(state, format("arith.addf ", a, ", ", c, " : f32"))
                        odd := mlir_value(state, format("arith.addf ", b, ", ", d, " : f32"))
                        return mlir_value(state, format("arith.addf ", even, ", ", odd, " : f32"))
                    }
                    if op == "get" && e.children.len() == 4 {
                        index := mlir_integer(e.children[2], state, lp)
                        if index.is_none() { return mlir_error(e, "SIMD lane index must be statically known and in 0..3", lp) }
                        if index.unwrap() >= 4 { return mlir_error(e, "SIMD lane index must be statically known and in 0..3", lp) }
                        value := mlir_expr(e.children[1], state, lp)
                        // An in-range get cannot throw and leaves its error
                        // argument untouched, exactly like the C/interpreter path.
                        return mlir_lane(value, index.unwrap(), state)
                    }
                }
                if op == "clone" && e.children.len() == 2 {
                    // The typer also uses clone for a widened declaration,
                    // e.g. I64.clone(an_i32); it is not always an identity.
                    value := mlir_expr(e.children[1], state, lp)
                    return mlir_coerce(value, e.children[1], t, state, lp)
                }
                if op == "delete" && e.children.len() == 3 {
                    // POD stack-value cleanup inserted by the ownership pass.
                    // Heap destruction is outside this value-only backend.
                    switch e.children[2].node_type {
                    case .Literal(Literal.Bool(free_storage)):
                        if free_storage.not() { return mlir_expr(e.children[1], state, lp) }
                    case:
                    }
                }
                return mlir_error(e, format("unsupported operation '", op, "'"), lp)
            case: return mlir_error(e, "unsupported method receiver", lp)
            }
        case .Ident(id):
            ref name : Str = id.ident_name(lp.ctx.symbols.names)
            primitive := resolve_direct_fcall(e, lp.ctx.scope, lp.ctx.symbols)
            if primitive.is_some() {
                if funcdef_of(primitive.unwrap()).sig.func_type.is_core() {
                    if name == "not" && e.children.len() == 2 {
                        value := mlir_expr(e.children[1], state, lp)
                        one := mlir_value(state, "arith.constant 1 : i1")
                        return mlir_value(state, format("arith.xori ", value, ", ", one, " : i1"))
                    }
                    if name.eq("and").or(name.eq("or")) && e.children.len() == 3 {
                        // Residual post-typing lazy primitives must keep the
                        // RHS conditional, just like the frontend's match form.
                        first := mlir_expr(e.children[1], state, lp)
                        result := mlir_slot("i1", state)
                        mlir_store(result, first, "i1", state)
                        rhs := mlir_label(state)
                        done := mlir_label(state)
                        if name == "and" { state.text = format(state.text, "    llvm.cond_br ", first, ", ^", rhs, ", ^", done, "\n") }
                        else { state.text = format(state.text, "    llvm.cond_br ", first, ", ^", done, ", ^", rhs, "\n") }
                        mlir_block(rhs, state)
                        second := mlir_expr(e.children[2], state, lp)
                        mlir_store(result, second, "i1", state)
                        mlir_branch(done, state)
                        mlir_block(done, state)
                        return mlir_value(state, format("llvm.load ", result, " {alignment = 1 : i64} : !llvm.ptr -> i1"))
                    }
                }
            }
            constructor_type := type_from_name_init_name(name, lp.ctx.scope, lp.ctx.symbols)
            constructor_mlir_type := mlir_type(constructor_type, lp)
            if constructor_mlir_type.eq("vector<4xf32>").or(constructor_mlir_type.eq("vector<4xi1>")) && e.children.len() == 5 {
                // The constant folder materializes SIMD values as positional
                // struct constructors, rather than calls to .new/.splat.
                return mlir_construct(e, state, lp)
            }
            if state.functions.has(name).not() { return mlir_error(e, format("unsupported call '", name, "'"), lp) }
            found := mlir_find_function(name, lp)
            if found.is_none() { return mlir_error(e, format("unsupported call '", name, "'"), lp) }
            ref fd : FunctionDef = funcdef_of(found.unwrap())
            if fd.sig.throw_types.len() > 0 && state.error_parameter.len() == 0 {
                return mlir_error(e, "throwing call has no lowered error slot", lp)
            }
            mut call_name := name.clone()
            if name == "main" { call_name = "til.mlir.main" }
            mut args := ""
            mut types := ""
            for i in 0..fd.sig.params.len() {
                t := mlir_type(declaration_resolved_type(fd.sig.params[i], lp.ctx.scope, lp.ctx.symbols), lp)
                if fd.sig.params[i].own_type.is(OwnType.Ref) && t != "!llvm.ptr" {
                    address := mlir_expr(e.children[i + 1], state, lp, true)
                    if i > 0 { args = format(args, ", "); types = format(types, ", ") }
                    args = format(args, address)
                    types = format(types, "!llvm.ptr")
                    continue
                }
                mut value := mlir_expr(e.children[i + 1], state, lp)
                value = mlir_coerce(value, e.children[i + 1], t, state, lp)
                if i > 0 { args = format(args, ", "); types = format(types, ", ") }
                if t == "vector<4xf32>" {
                    lo := mlir_half(value, false, state)
                    hi := mlir_half(value, true, state)
                    args = format(args, lo, ", ", hi)
                    types = format(types, "vector<2xf32>, vector<2xf32>")
                } else if t == "vector<4xi1>" {
                    value = mlir_pack_mask(value, state)
                    args = format(args, value)
                    types = format(types, "i32")
                } else if t == "i1" {
                    value = mlir_value(state, format("arith.extui ", value, " : i1 to i8"))
                    args = format(args, value)
                    types = format(types, "i8")
                } else { args = format(args, value); types = format(types, t) }
            }
            mut ret := "void"
            if fd.sig.return_type.len() > 0 {
                ret = mlir_type(type_from_name_init_name(fd.sig.return_type, lp.ctx.scope, lp.ctx.symbols), lp)
            }
            mut abi_ret := ret.clone()
            if ret == "vector<4xf32>" { abi_ret = mlir_f4_type() }
            if ret == "i1" { abi_ret = "i8" }
            if ret == "vector<4xi1>" { abi_ret = "i32" }
            mut result := ""
            if fd.sig.throw_types.len() > 0 { mlir_error_write(state) }
            if ret == "void" {
                state.text = format(state.text, "    llvm.call @\"", call_name, "\"(", args, ") : (", types, ") -> ()\n")
            } else {
                result = mlir_value(state, format("llvm.call @\"", call_name, "\"(", args, ") : (", types, ") -> ", abi_ret))
                if ret == "vector<4xf32>" {
                    lo := mlir_value(state, format("llvm.extractvalue ", result, "[0] : ", abi_ret))
                    hi := mlir_value(state, format("llvm.extractvalue ", result, "[1] : ", abi_ret))
                    result = mlir_join(lo, hi, state)
                } else if ret == "vector<4xi1>" { result = mlir_unpack_mask(result, state) }
                else if ret == "i1" {
                    result = mlir_value(state, format("arith.trunci ", result, " : i8 to i1"))
                }
            }
            return result
        case: return mlir_error(e, "indirect calls are not supported", lp)
        }
    case: return mlir_error(e, "unsupported expression", lp)
    }
}

priv mlir_literal_text := func(e: Expr, texts: Map(Str, Str), lp: LoadedProgram) returns Option(Str) {
    switch e.node_type {
    case .Literal(Literal.Str(text)): return Option(Str).Some(text.clone())
    case .Ident(id):
        ref name : Str = id.ident_name(lp.ctx.symbols.names)
        if texts.has(name) { return Option(Str).Some(texts[name].clone()) }
    case:
    }
    return Option(Str).None
}

priv mlir_literal_number := func(e: Expr, numbers: Map(Str, U64), lp: LoadedProgram) returns Option(U64) {
    switch e.node_type {
    case .Literal(Literal.Num(n)): return Option(U64).Some(n.to_u64())
    case .Ident(id):
        ref name : Str = id.ident_name(lp.ctx.symbols.names)
        if numbers.has(name) { return Option(U64).Some(numbers[name]) }
    case:
    }
    return Option(U64).None
}

// Recognize only the compiler's one-part OutOfBounds bang diagnostic. General
// strings, user panic calls and heap cleanup are not silently discarded here.
priv mlir_bang_text := func(body: Expr, lp: LoadedProgram) returns Option(Str) {
    mut texts := Map(Str, Str).new()
    mut numbers := Map(Str, U64).new()
    mut parts := Map(Str, Str).new()
    for stmt : Expr in body.children {
        switch stmt.node_type {
        case .Decl(dd):
            if stmt.children.len() != 1 { return Option(Str).None }
            ref value : Expr = stmt.children[0]
            switch value.node_type {
            case .Literal(Literal.Str(text)): texts.set(dd.name, own text.clone())
            case .Literal(Literal.Num(n)): numbers.set(dd.name, own n.to_u64())
            case .FCall:
                if value.children.len() != 2 { return Option(Str).None }
                switch value.children[0].node_type {
                case .FieldAccess(method):
                    if method.field_access_name(lp.ctx.symbols.names) != "new" { return Option(Str).None }
                    if value.children[0].children.len() != 1 { return Option(Str).None }
                    switch value.children[0].children[0].node_type {
                    case .Ident(owner): if owner.ident_name(lp.ctx.symbols.names) != "Array__Str" { return Option(Str).None }
                    case: return Option(Str).None
                    }
                    switch value.children[1].node_type {
                    case .Ident(size):
                        ref name : Str = size.ident_name(lp.ctx.symbols.names)
                        if numbers.has(name).not() { return Option(Str).None }
                        if numbers[name] != 1 { return Option(Str).None }
                    case .Literal(Literal.Num(n)): if n.to_u64() != 1 { return Option(Str).None }
                    case: return Option(Str).None
                    }
                    parts.set(dd.name, own "")
                case: return Option(Str).None
                }
            case: return Option(Str).None
            }
        case .Assign(ad):
            if ad.name != "_err_kind" { return Option(Str).None }
            value := mlir_literal_number(stmt.children[0], numbers, lp)
            if value.is_none() { return Option(Str).None }
            if value.unwrap() != 0 { return Option(Str).None }
        case .FCall:
            switch stmt.children[0].node_type {
            case .FieldAccess(method):
                if method.field_access_name(lp.ctx.symbols.names) != "set" || stmt.children.len() != 5 { return Option(Str).None }
                if stmt.children[0].children.len() != 1 { return Option(Str).None }
                switch stmt.children[0].children[0].node_type {
                case .Ident(owner): if owner.ident_name(lp.ctx.symbols.names) != "Array__Str" { return Option(Str).None }
                case: return Option(Str).None
                }
                index := mlir_literal_number(stmt.children[2], numbers, lp)
                if index.is_none() { return Option(Str).None }
                if index.unwrap() != 0 { return Option(Str).None }
                switch stmt.children[1].node_type {
                case .Ident(array_id):
                    ref name : Str = array_id.ident_name(lp.ctx.symbols.names)
                    if parts.has(name).not() { return Option(Str).None }
                    text := mlir_literal_text(stmt.children[3], texts, lp)
                    if text.is_none() { return Option(Str).None }
                    parts.set(name, own text.unwrap().clone())
                case: return Option(Str).None
                }
            case .Ident(callee):
                if callee.ident_name(lp.ctx.symbols.names) != "panic" || stmt.children.len() != 3 { return Option(Str).None }
                location := mlir_literal_text(stmt.children[2], texts, lp)
                if location.is_none() { return Option(Str).None }
                switch stmt.children[1].node_type {
                case .Ident(array_id):
                    ref name : Str = array_id.ident_name(lp.ctx.symbols.names)
                    if parts.has(name).not() { return Option(Str).None }
                    if parts[name] != "uncaught throw 'OutOfBounds'" { return Option(Str).None }
                    return Option(Str).Some(format(location.unwrap(), ": panic: ", parts[name]))
                case: return Option(Str).None
                }
            case: return Option(Str).None
            }
        case: return Option(Str).None
        }
    }
    return Option(Str).None
}

priv mlir_emit_bang := proc(body: Expr, mut state: MlirState, mut lp: LoadedProgram) {
    diagnostic := mlir_bang_text(body, lp)
    if diagnostic.is_none() { mlir_error(body, "unsupported generated panic shape", lp); return }
    text := format(diagnostic.unwrap(), "\n")
    mut escaped := ""
    digits := "0123456789ABCDEF"
    for i in 0..text.len() {
        byte := text.unsafe_get(i).cast(U8).cast(U32)
        escaped = format(escaped, "\\", digits.substr(byte.shr(4).to_usize(), 1), digits.substr(byte.band(15).to_usize(), 1))
    }
    symbol := format("til.mlir.panic.", state.symbol_prefix, ".", state.next.to_str())
    state.globals = format(state.globals, "  llvm.mlir.global private constant @\"", symbol,
        "\"(\"", escaped, "\") : !llvm.array<", text.len().to_str(), " x i8>\n")
    state.needs_panic = true
    zero := mlir_value(state, "arith.constant 0 : i64")
    mlir_store(state.values[state.error_parameter].value, zero, "i64", state)
    mlir_error_write(state)
    state.error_known_clear = true
    address := mlir_value(state, format("llvm.mlir.addressof @\"", symbol, "\" : !llvm.ptr"))
    stream_slot := mlir_value(state, "llvm.mlir.addressof @stdout : !llvm.ptr")
    stream := mlir_value(state, format("llvm.load ", stream_slot, " : !llvm.ptr -> !llvm.ptr"))
    one := mlir_value(state, "arith.constant 1 : i64")
    count := mlir_value(state, format("arith.constant ", text.len().to_str(), " : i64"))
    mlir_value(state, format("llvm.call @fwrite(", address, ", ", one, ", ", count, ", ", stream, ") : (!llvm.ptr, i64, i64, !llvm.ptr) -> i64"))
    status := mlir_value(state, "arith.constant 1 : i32")
    state.text = format(state.text, "    llvm.call @exit(", status, ") : (i32) -> ()\n    llvm.unreachable\n")
    state.terminated = true
}

priv mlir_is_bang_condition := func(e: Expr, state: MlirState, lp: LoadedProgram) returns Bool {
    switch e.node_type {
    case .FCall(fcd): return fcd.is_bang_check
    case .Ident(id): return state.bang_conditions.has(id.ident_name(lp.ctx.symbols.names))
    case: return false
    }
}

priv mlir_has_local_error := func(e: Expr) returns Bool {
    switch e.node_type {
    case .Decl(dd): if dd.name == "_err_kind" { return true }
    case .FuncDef, .StructDef, .EnumDef: return false
    case:
    }
    for child : Expr in e.children { if mlir_has_local_error(child) { return true } }
    return false
}

priv mlir_body := proc(body: Expr, ret: Str, mut state: MlirState, mut lp: LoadedProgram) {
    // Restore lexical bindings, not their runtime contents. An assignment to
    // an outer local stores through the same entry-block slot in either arm.
    saved_values := state.values.clone()
    saved_integers := state.integers.clone()
    saved_booleans := state.booleans.clone()
    saved_conditions := state.clear_conditions.clone()
    saved_set_conditions := state.set_conditions.clone()
    saved_bangs := state.bang_conditions.clone()
    saved_error_version := state.error_version
    for stmt : Expr in body.children {
        if state.terminated { break }
        switch stmt.node_type {
        case .Decl(local):
            if stmt.children.len() != 1 {
                mlir_error(stmt, "only initialized value locals are supported", lp)
                break
            }
            local_type := declaration_resolved_type(local, lp.ctx.scope, lp.ctx.symbols)
            t := mlir_type(local_type, lp)
            if t.len() == 0 || t == "void" { mlir_error(stmt, "unsupported local type", lp); break }
            if local.own_type.is(OwnType.Ref) {
                if t != "f32" && t != "!llvm.ptr" { mlir_error(stmt, "only borrowed F32 elements and Array(F32) aliases are supported", lp); break }
                address := mlir_expr(stmt.children[0], state, lp, true)
                state.values.set(local.name, own MlirBinding(value = address, type_name = t.clone(),
                    is_mut = local.is_mut && t != "!llvm.ptr", is_ref = t != "!llvm.ptr"))
                continue
            }
            if t == "!llvm.ptr" { mlir_error(stmt, "Array(F32) locals must borrow existing storage", lp); break }
            integer := mlir_integer(stmt.children[0], state, lp)
            boolean := mlir_boolean(stmt.children[0], state, lp)
            raw_value := mlir_expr(stmt.children[0], state, lp)
            value := mlir_coerce(raw_value, stmt.children[0], t, state, lp)
            clear_test := mlir_tests_error_value(stmt.children[0], 0, state, lp)
            set_test := mlir_tests_error_value(stmt.children[0], 1, state, lp)
            bang_test := mlir_is_bang_condition(stmt.children[0], state, lp)
            state.clear_conditions.remove(local.name)
            state.set_conditions.remove(local.name)
            state.bang_conditions.remove(local.name)
            if clear_test && local.is_mut.not() { state.clear_conditions.add(own local.name.clone()) }
            if set_test && local.is_mut.not() { state.set_conditions.add(own local.name.clone()) }
            if bang_test && local.is_mut.not() { state.bang_conditions.add(own local.name.clone()) }
            if local.name == state.error_parameter {
                if integer.is_none() { mlir_error(stmt, "error slot must start at zero", lp); break }
                if integer.unwrap() != 0 { mlir_error(stmt, "error slot must start at zero", lp); break }
                state.error_known_clear = true
            }
            state.integers.remove(local.name)
            state.booleans.remove(local.name)
            if local.is_mut.not() {
                if integer.is_some() { state.integers.set(local.name, own integer.unwrap().clone()) }
                if boolean.is_some() { state.booleans.set(local.name, own boolean.unwrap().clone()) }
            }
            if local.is_mut {
                slot := mlir_slot(t, state)
                mlir_store(slot, value, t, state)
                state.values.set(local.name, own MlirBinding(value = slot, type_name = t.clone(), is_mut = true, is_signed = mlir_signed(local_type)))
            } else { state.values.set(local.name, own MlirBinding(value = value, type_name = t.clone(), is_signed = mlir_signed(local_type))) }
        case .Assign(assignment):
            if state.values.has(assignment.name).not() { mlir_error(stmt, "assignment requires a local", lp); break }
            ref binding : MlirBinding = state.values[assignment.name]
            if binding.is_mut.not() { mlir_error(stmt, "assignment requires mutable storage", lp); break }
            raw_value := mlir_expr(stmt.children[0], state, lp)
            value := mlir_coerce(raw_value, stmt.children[0], binding.type_name, state, lp)
            mlir_store(binding.value, value, binding.type_name, state)
            if assignment.name == state.error_parameter {
                zero := mlir_integer(stmt.children[0], state, lp)
                if zero.is_none() { mlir_error(stmt, "only OutOfBounds error tags are supported", lp); break }
                if zero.unwrap() > 1 { mlir_error(stmt, "only OutOfBounds error tags are supported", lp); break }
                mlir_error_write(state)
                state.error_known_clear = zero.is_some().and(zero.unwrap() == 0)
            }
        case .Return:
            if stmt.children.len() == 0 { state.text = format(state.text, "    llvm.return\n") }
            else {
                mut value := mlir_expr(stmt.children[0], state, lp)
                value = mlir_coerce(value, stmt.children[0], ret, state, lp)
                mut abi_ret := ret.clone()
                if ret == "vector<4xf32>" { value = mlir_pack_return(value, state); abi_ret = mlir_f4_type() }
                else if ret == "vector<4xi1>" { value = mlir_pack_mask(value, state); abi_ret = "i32" }
                else if ret == "i1" { value = mlir_value(state, format("arith.extui ", value, " : i1 to i8")); abi_ret = "i8" }
                state.text = format(state.text, "    llvm.return ", value, " : ", abi_ret, "\n")
            }
            state.terminated = true
        case .FCall: mlir_expr(stmt, state, lp, true)
        case .Body: mlir_body(stmt, ret, state, lp)
        case .If:
            known := mlir_boolean(stmt.children[0], state, lp)
            clear_test := mlir_tests_error_value(stmt.children[0], 0, state, lp)
            set_test := mlir_tests_error_value(stmt.children[0], 1, state, lp)
            bang_test := mlir_is_bang_condition(stmt.children[0], state, lp)
            if known.is_some() {
                if known.unwrap() {
                    if clear_test { state.error_known_clear = true }
                    if bang_test { mlir_emit_bang(stmt.children[1], state, lp) }
                    else { mlir_body(stmt.children[1], ret, state, lp) }
                }
                else if stmt.children.len() == 3 { mlir_body(stmt.children[2], ret, state, lp) }
            } else {
                condition := mlir_expr(stmt.children[0], state, lp)
                before_clear := state.error_known_clear
                before_conditions := state.clear_conditions.clone()
                before_set_conditions := state.set_conditions.clone()
                yes := mlir_label(state)
                no := mlir_label(state)
                merge := mlir_label(state)
                state.text = format(state.text, "    llvm.cond_br ", condition, ", ^", yes, ", ^", no, "\n")
                mlir_block(yes, state)
                if clear_test { state.error_known_clear = true }
                if bang_test { mlir_emit_bang(stmt.children[1], state, lp) }
                else { mlir_body(stmt.children[1], ret, state, lp) }
                yes_ends := state.terminated
                yes_clear := state.error_known_clear
                if yes_ends.not() { mlir_branch(merge, state) }
                mlir_block(no, state)
                state.error_known_clear = before_clear
                if set_test { state.error_known_clear = true }
                state.clear_conditions = before_conditions
                state.set_conditions = before_set_conditions
                if stmt.children.len() == 3 { mlir_body(stmt.children[2], ret, state, lp) }
                no_ends := state.terminated
                no_clear := state.error_known_clear
                if no_ends.not() { mlir_branch(merge, state) }
                mlir_block(merge, state)
                state.error_known_clear = yes_ends.or(yes_clear).and(no_ends.or(no_clear))
                state.clear_conditions.clear()
                state.set_conditions.clear()
                if yes_ends && no_ends { state.text = format(state.text, "    llvm.unreachable\n"); state.terminated = true }
            }
        case .While:
            known := mlir_boolean(stmt.children[0], state, lp)
            if known.is_some() { if known.unwrap().not() { continue } }
            check := mlir_label(state)
            loop := mlir_label(state)
            done := mlir_label(state)
            saved_break := state.break_label.clone()
            saved_continue := state.continue_label.clone()
            saved_has_break := state.has_break
            before_clear := state.error_known_clear
            before_version := state.error_version
            state.break_label = done.clone()
            state.continue_label = check.clone()
            state.has_break = false
            mlir_branch(check, state)
            mlir_block(check, state)
            condition := mlir_expr(stmt.children[0], state, lp)
            state.text = format(state.text, "    llvm.cond_br ", condition, ", ^", loop, ", ^", done, "\n")
            mlir_block(loop, state)
            mlir_body(stmt.children[1], ret, state, lp)
            if state.terminated.not() { mlir_branch(check, state) }
            loop_breaks := state.has_break
            state.break_label = saved_break
            state.continue_label = saved_continue
            state.has_break = saved_has_break
            mlir_block(done, state)
            // A failing iteration can leave through a break before the
            // fall-through body's final proof. Never export that proof.
            if state.error_version != before_version { mlir_error_write(state) }
            else { state.error_known_clear = before_clear }
            if known.is_some() && loop_breaks.not() {
                state.text = format(state.text, "    llvm.unreachable\n")
                state.terminated = true
            }
        case .Break, .Continue:
            if state.break_label.len() == 0 { mlir_error(stmt, "loop transfer outside a loop", lp); break }
            if stmt.node_type.is(NodeType.Break) { state.has_break = true; mlir_branch(state.break_label, state) }
            else { mlir_branch(state.continue_label, state) }
        case: mlir_error(stmt, "unsupported statement", lp)
        }
    }
    state.values = saved_values
    state.integers = saved_integers
    state.booleans = saved_booleans
    state.bang_conditions = saved_bangs
    if state.error_version == saved_error_version {
        state.clear_conditions = saved_conditions
        state.set_conditions = saved_set_conditions
    } else { state.clear_conditions.clear(); state.set_conditions.clear() }
}

priv mlir_function := proc(decl: Expr, functions: Set(Str), mut needs_panic: Bool, mut lp: LoadedProgram) returns Str {
    ref dd : Declaration = decl_of(decl)
    ref fexpr : Expr = decl.children[0]
    ref fd : FunctionDef = funcdef_of(fexpr)
    if fd.sig.func_type.is_bodyless() || fd.sig.func_type.is(FuncType.Macro)
        || fd.captures.len() > 0
        || fd.sig.variadic_index >= 0 || fd.sig.kwargs_index >= 0 {
        return mlir_error(decl, "only ordinary non-capturing functions are supported", lp)
    }
    for error_type : Str in fd.sig.throw_types {
        if error_type != "OutOfBounds" { return mlir_error(decl, "only OutOfBounds propagation is supported", lp) }
    }
    if fd.sig.return_own_type.is(OwnType.Ref) { return mlir_error(decl, "borrowed returns are not supported", lp) }
    mut state := MlirState()
    state.functions = functions.clone()
    state.symbol_prefix = dd.name.clone()
    if fd.sig.throw_types.len() > 0 {
        state.error_parameter = "_err_kind"
        // The existing caller ABI starts each error-out transaction at zero.
        state.error_known_clear = true
    }
    mut signature := ""
    mut slots : USize = 0
    for i in 0..fd.sig.params.len() {
        ref p : Declaration = fd.sig.params[i]
        t := mlir_type(declaration_resolved_type(p, lp.ctx.scope, lp.ctx.symbols), lp)
        if t == "!llvm.ptr" && p.own_type.is(OwnType.Ref) {
            if i > 0 { signature = format(signature, ", ") }
            arg := format("%p", i.to_str())
            signature = format(signature, arg, ": !llvm.ptr")
            state.values.set(p.name, own MlirBinding(value = arg, type_name = t.clone()))
            continue
        }
        if p.name == state.error_parameter && t == "i64" && p.own_type.is(OwnType.Ref) && p.is_mut {
            if i > 0 { signature = format(signature, ", ") }
            arg := format("%p", i.to_str())
            signature = format(signature, arg, ": !llvm.ptr")
            state.values.set(p.name, own MlirBinding(value = arg, type_name = t.clone(), is_mut = true, is_ref = true, is_signed = true))
            continue
        }
        if t == "!llvm.ptr" { return mlir_error(decl, "Array(F32) parameters must be borrowed, not own or shallow", lp) }
        if t.len() == 0 || t == "void" || p.is_mut || p.own_type.is(OwnType.Ref).or(p.own_type.is(OwnType.Own)) {
            return mlir_error(decl, format("parameters of '", dd.name, "' must be supported immutable values"), lp)
        }
        if i > 0 { signature = format(signature, ", ") }
        arg := format("%p", i.to_str())
        if t == "vector<4xf32>" {
            signature = format(signature, arg, "lo: vector<2xf32>, ", arg, "hi: vector<2xf32>")
            state.values.set(p.name, own MlirBinding(value = mlir_join(format(arg, "lo"), format(arg, "hi"), state), type_name = t.clone()))
            slots = slots + 2
        } else {
            mut value := arg.clone()
            mut abi_t := t.clone()
            if t == "i1" {
                abi_t = "i8"
                value = mlir_value(state, format("arith.trunci ", arg, " : i8 to i1"))
            }
            if t == "vector<4xi1>" {
                abi_t = "i32"
                value = mlir_unpack_mask(arg, state)
            }
            signature = format(signature, arg, ": ", abi_t)
            state.values.set(p.name, own MlirBinding(value = value, type_name = t.clone(), is_signed = mlir_signed(declaration_resolved_type(p, lp.ctx.scope, lp.ctx.symbols))))
            if t == "f32" { slots++ }
        }
    }
    // SysV spills aggregates as a whole when SSE argument registers run out.
    // That ABI case is deliberately outside this first value-only slice.
    if slots > 8 { return mlir_error(decl, "more than eight SSE argument slots are not supported", lp) }
    mut ret := "void"
    if fd.sig.return_type.len() > 0 {
        ret = mlir_type(type_from_name_init_name(fd.sig.return_type, lp.ctx.scope, lp.ctx.symbols), lp)
    }
    if ret.len() == 0 || ret == "!llvm.ptr" { return mlir_error(decl, "unsupported return type", lp) }
    if dd.name == "main" && (ret != "void" || fd.sig.params.len() > 0) {
        return mlir_error(decl, "main must take no arguments and return no value", lp)
    }
    if state.error_parameter.len() == 0 && mlir_has_local_error(fexpr.children[0]) { state.error_parameter = "_err_kind" }
    mlir_body(fexpr.children[0], ret, state, lp)
    if state.terminated.not() {
        if ret != "void" { return mlir_error(decl, "missing value return", lp) }
        state.text = format(state.text, "    llvm.return\n")
    }
    mut name := dd.name.clone()
    if name == "main" { name = "til.mlir.main" }
    mut linkage := ""
    if dd.is_priv || dd.name == "main" { linkage = "internal " }
    mut result := format("  llvm.func ", linkage, "@\"", name, "\"(", signature, ")")
    if ret == "vector<4xf32>" { result = format(result, " -> ", mlir_f4_type()) }
    else if ret == "i1" { result = format(result, " -> i8") }
    else if ret == "vector<4xi1>" { result = format(result, " -> i32") }
    else if ret != "void" { result = format(result, " -> ", ret) }
    mut entry := ""
    if state.allocations.len() > 0 { entry = format("    %alloc_count = llvm.mlir.constant(1 : i64) : i64\n", state.allocations) }
    if state.needs_panic { needs_panic = true }
    return format(state.globals, result, " {\n", entry, state.text, "  }\n")
}

mlir_codegen_translate := proc(mut lp: LoadedProgram, path: Str, source_functions: Set(Str)) returns I32 {
    mut text := "module attributes {llvm.target_triple = \"x86_64-pc-linux-gnu\"} {\n"
    context_enter_file(lp.ctx, lp.units[lp.units.len() - 1].path)
    mut has_main := false
    mut needs_panic := false
    mut functions := Set(Str).new()
    for stmt : Expr in mlir_root(lp).children {
        if stmt.node_type.is(NodeType.Decl) {
            ref dd : Declaration = decl_of(stmt)
            if source_functions.has(dd.name) || (dd.orig_name.len() > 0 && source_functions.has(dd.orig_name)) {
                functions.add(own dd.name.clone())
            }
        }
    }
    for stmt : Expr in mlir_root(lp).children {
        switch stmt.node_type {
        case .Decl(dd):
            if functions.has(dd.name).not() { continue }
            if stmt.children.len() == 1 {
                if stmt.children[0].node_type.is(NodeType.FuncDef) {
                    if functions.has(dd.name).not() { continue }
                    if funcdef_of(stmt.children[0]).auto_generated || funcdef_of(stmt.children[0]).sig.func_type.is(FuncType.Macro) { continue }
                    text = format(text, mlir_function(stmt, functions, needs_panic, lp))
                    if dd.name == "main" { has_main = true }
                } else {
                    alias_type := mlir_type(type_from_name_init_name(dd.name, lp.ctx.scope, lp.ctx.symbols), lp)
                    if alias_type.len() == 0 || alias_type == "void" {
                        mlir_error(stmt, format("unsupported module declaration '", dd.name, "'"), lp)
                    }
                }
            } else { mlir_error(stmt, "unsupported top-level declaration", lp) }
        case: mlir_error(stmt, "unsupported top-level statement", lp)
        }
    }
    if lp.cur_mode.is_library.not() {
        if has_main.not() { println("error: MLIR backend requires a no-argument main"); return 1 }
        text = format(text, "  llvm.func @main() -> i32 {\n    llvm.call @\"til.mlir.main\"() : () -> ()\n    %zero = llvm.mlir.constant(0 : i32) : i32\n    llvm.return %zero : i32\n  }\n")
    }
    if needs_panic {
        if mlir_find_function("fwrite", lp).is_some() || mlir_find_function("exit", lp).is_some() || mlir_find_function("stdout", lp).is_some() {
            mlir_error(mlir_root(lp), "generated panic conflicts with a user fwrite/exit/stdout symbol", lp)
        }
        text = format(text, "  llvm.mlir.global external @stdout() : !llvm.ptr\n  llvm.func @fwrite(!llvm.ptr, i64, i64, !llvm.ptr) -> i64\n  llvm.func @exit(i32)\n")
    }
    if lp.ctx.errors > 0 { return 1 }
    File.writefile(path, format(text, "}\n"))
    return 0
}
