// --- External C bridges used by the loader ---

// realpath_str resolves a path against the live filesystem/CWD, so its result
// is not a pure function of its argument -- folding it would bake a
// CWD-dependent path at build time. It is ext_proc (not ext_func) so the
// const-folder never folds it; see #283. Its func callers below are procs too.
realpath_str := ext_proc(path: Str) returns Str {}

// --- Leaf helpers ---

REPL_DOC_INDEX := "doc/gen/index.org"

priv normalize_mode_name := func(mode_name: Str) returns Str {
    if mode_name.len() > 0 {
        return mode_name
    }
    return "script"
}

// Strip CWD prefix so embedded file:line:col strings are repo-relative,
// not absolute. Prepend "./" so emacs recognizes the path as relative.
priv display_path := func(p: Str, cwd: Str) returns Str {
    prefix := format(cwd, "/")
    rel := p.strip_prefix(prefix)
    if rel.starts_with("/") {
        return rel
    }
    if rel.starts_with("./") {
        return rel
    }
    return format("./", rel)
}

priv require_mode := func(ctx: Context, path: Str, mode_name: Str) returns ref Mode {
    switch mode_resolve(ctx, mode_name) {
    case .Some(resolved): return resolved
    case .None:
        panic(": unknown mode '", mode_name, "'", loc = path)
    }
}

forward_header_path := func(path: Str) returns Str {
    slash := path.rfind("/")
    dot := path.rfind(".")
    if dot > slash {
        return format(path.substr(0, dot.to_usize()), "_forward.h")
    }
    return format(path, "_forward.h")
}

// Directory part of an absolute path (no trailing slash).
priv dir_of := func(abs: Str) returns Str {
    if abs.len() == 0 { return "." }
    mut last_slash := abs.len() - 1
    while last_slash.gt(0).and(abs.get(last_slash).neq('/')) {
        last_slash--
    }
    return abs.substr(0, last_slash).clone()
}

priv resolve_link_path := proc(base_dir: Str, root_dir: Str, path: Str) returns Str {
    if path.starts_with("/") {
        return path
    }
    rel_candidate := base_dir.format("/", path)
    if realpath_str(rel_candidate).len() > 0 {
        return rel_candidate
    }
    if root_dir.len() > 0 {
        root_candidate := root_dir.format("/", path)
        if realpath_str(root_candidate).len() > 0 {
            return root_candidate
        }
    }
    return rel_candidate
}

// --- Import resolution ---

ProgramUnit := struct {
    path := ""
    mode := Mode()
    imports := Vec(Str).new()
}

// Resolve a file's direct import paths to display paths.
priv resolve_import_disps := proc(import_paths: Vec(Str), base_dir: Str, lib_dir: Str, cwd: Str) returns Vec(Str) {
    mut out := Vec(Str).new()
    for import_path : Str in import_paths {
        // An absolute import path is used as-is (the REPL injects one for
        // std/doc, since its tmp file's directory floats with the cwd).
        mut abs := ""
        if import_path.starts_with("/") {
            abs = realpath_str(import_path)
        } else {
            mut try_path := base_dir.format("/", import_path)
            abs = realpath_str(try_path)
            if abs.eq("").and(lib_dir.len().gt(0)) {
                try_path = lib_dir.format("/", import_path)
                abs = realpath_str(try_path)
            }
        }
        if abs == "" { continue }
        out.push(own display_path(abs, cwd))
    }
    return out
}

// Extract import("path") calls from AST body, returning paths as Vec of Str*.
// The .til suffix is appended internally; paths already ending in ".til" are
// rejected with a helpful error suggesting the bare-name form.
priv extract_one_import := func(mut imp_stmt: Expr, path: Str, mut paths: Vec(Str)) {
    if imp_stmt.children.len() >= 2 {
        switch imp_stmt.children[0].node_type {
        case .Ident(c0id):
            if c0id.ident_name() == "import" {
                switch imp_stmt.children[1].node_type {
                case .Literal(Literal.Str(p)):
                    if p.ends_with(".til") {
                        bare := p.strip_suffix(".til")
                        loc := path.format(":", imp_stmt.line.to_str(), ":", imp_stmt.col.to_str())
                        panic("import path must not end in '.til' (got \"", p,
                            "\"); use import(\"", bare, "\") instead", loc = loc)
                    }
                    paths.push(own format(p, ".til"))
                case:
                }
            }
        case:
        }
    }
}

priv extract_imports := func(mut body: Expr, path: Str) returns Vec(Str) {
    mut paths := Vec(Str).new()
    for mut stmt : Expr in body.children {
        mut is_imp := false
        mut is_decl_rhs := false
        if stmt.node_type.is(NodeType.FCall) {
            is_imp = true
        } else if stmt.node_type.is(NodeType.Decl).and(stmt.children.len().gt(0)) {
            if stmt.children[0].node_type.is(NodeType.FCall) {
                is_imp = true
                is_decl_rhs = true
            }
        }

        if is_imp {
            if is_decl_rhs {
                extract_one_import(stmt.children[0], path, paths)
            } else {
                extract_one_import(stmt, path, paths)
            }
        }
    }
    return paths
}

// Recursively resolve imports.
priv resolve_imports := proc(import_paths: Vec(Str), base_dir: Str,
    mut resolved_set: Set(Str), mut stack: Vec(Expr),
    mut units: Vec(ProgramUnit), lib_dir: Str,
    mut ctx: Context, default_mode: Str, cwd: Str) returns I32 {
        for import_path : Str in import_paths {
            // Absolute paths are used as-is (REPL std/doc injection); else
            // try relative to the importing file's directory, then lib_dir
            mut abs := ""
            if import_path.starts_with("/") {
                abs = realpath_str(import_path)
            } else {
                mut try_path := base_dir.format("/", import_path)
                abs = realpath_str(try_path)
                if abs.eq("").and(lib_dir.len().gt(0)) {
                    try_path = lib_dir.format("/", import_path)
                    abs = realpath_str(try_path)
                }
            }
            if abs == "" {
                println(format("error: could not find import '", import_path, "' (from ", base_dir, "/)"))
                return 1
            }

            // Dedup (also handles circular imports -- files are added to
            // resolved_set when they start processing)
            if resolved_set.has(abs) {
                continue
            }
            resolved_set.add(own abs.clone())

            // Load, lex, parse the imported file. Use display_path for the
            // path strings that get embedded in the AST / generated C, so the
            // boot/ files don't carry absolute paths.
            disp := display_path(abs, cwd)
            source := File.readfile(abs)
            tokens := tokenize(source, disp)
            mut sub_mode := ""
            mut parse_errors_sub_ast : I32 = 0
            mut sub_ast := parse(tokens, source, disp, sub_mode, ctx.anon_type_counter, parse_errors_sub_ast)
            // A syntax error in an imported file must stop the load: parse
            // reports it and returns a PARTIAL ast, and carrying on would bury
            // that message under downstream type errors. Reported as a failed
            // resolution rather than exit(1), so the caller decides -- a file
            // compile still exits, the REPL drops the turn.
            if parse_errors_sub_ast > 0 { return 1 }
            sub_mode = normalize_mode_name(sub_mode)
            ref sub_mode_def : Mode = require_mode(ctx, disp, sub_mode)
            context_register_path_mode(ctx, disp, sub_mode_def)
            sub_imports := extract_imports(sub_ast, disp)

            // Get imported file's directory for recursive resolution
            sub_dir := dir_of(abs)

            sub_import_disps := resolve_import_disps(sub_imports, sub_dir, lib_dir, cwd)

            // Recurse for sub-imports
            if sub_imports.len() > 0 {
                err := resolve_imports(sub_imports, sub_dir, resolved_set, stack, units, lib_dir,
                    ctx, default_mode, cwd)
                if err > 0 {
                    return err
                }
            }

            // Store canonical import unit in ctx (rstil-style).
            mut iu := ImportUnit(mode = sub_mode_def.clone())
            iu.ast.take_children(sub_ast)
            iu.imports = sub_import_disps.clone()
            ctx.imported.set(disp, own iu)

            // Record ordering metadata as a ProgramUnit.
            mut unit := ProgramUnit(path = disp.clone(), mode = sub_mode_def.clone())
            unit.imports = sub_import_disps
            units.push(own unit)

        }
        return 0
    }

// --- LoadedProgram ---

LoadedProgram := struct {
    own core_units := Vec(ProgramUnit).new()
    own units := Vec(ProgramUnit).new()
    mode_files := Vec(Str).new()

    target := Target.LinuxX64
    cur_mode := Mode()
    ctx := Context()
    skip_core := false
    mode_str := ""
    path := ""
    ext_c_path := ""
    link_flags := ""
    include_flags := ""
    link_c_paths := ""
    run_tests := false
    // Non-zero when load_program gave up on a user import (missing file, or a
    // syntax error inside one). The program is unusable; the caller decides
    // whether that ends the process (a file compile) or just the turn (the
    // REPL).
    load_errors : I32 = 0
    // --usize override (issue #309): 0 = follow the source alias (default
    // U32), 32 = force the USize alias to U32, 64 = force it back to U64
    // (the opt-out from the U32 default) even on a 64-bit host. UPtr is
    // never affected. Set from the CLI in src/til.til before prepare_program
    // stamps the alias widths.
    usize_override_bits : I64 = 0
namespace:
    // Every unit path a pass should walk: the core units first, unless this
    // program skips core, then the program's own units.
    //
    // Passes used to spell this out as two loops -- `if skip_core.not() { for
    // core_units ... }` followed by `for units ...` -- with the body pasted
    // into both and skip_core re-tested at each site. Nothing in those bodies
    // wanted the ProgramUnit itself; every one of them immediately looked up
    // ctx.imported[u.path], so the sequence of paths is the whole interface.
    unit_paths := func(self: LoadedProgram) returns Vec(Str) {
        mut paths := Vec(Str).new()
        if self.skip_core.not() {
            for u : ProgramUnit in self.core_units { paths.push(own u.path.clone()) }
        }
        for u : ProgramUnit in self.units { paths.push(own u.path.clone()) }
        return paths
    }
    delete := func(own self: LoadedProgram, call_free: Bool = true) {
        // Raw-address probes through the to_ptr launder (#321 step 3):
        // the #302 drain contract hands deletes zeroed/moved-out slots.
        if to_ptr(self).is_null() { return }
        if to_ptr(self.core_units).is_null().not() { own self.core_units.delete(true) }
        if to_ptr(self.units).is_null().not() { own self.units.delete(true) }
        own self.mode_files.delete(false)
        Target.delete(own self.target, false)
        Mode.delete(own self.cur_mode, false)
        Context.delete(own self.ctx, false)
        Str.delete(own self.mode_str, false)
        Str.delete(own self.path, false)
        Str.delete(own self.ext_c_path, false)
        Str.delete(own self.link_flags, false)
        Str.delete(own self.include_flags, false)
        Str.delete(own self.link_c_paths, false)
        if call_free { free(own self) }
    }
}

// #192: find the RHS type name of a top-level `alias_name := <Ident>` decl in
// a parsed file body. Used to make USize/UPtr resolution SOURCE-DRIVEN: the
// width comes from src/core/usize.til (read fresh from the parsed AST every
// build) rather than a value baked into target_usize_name and thus into
// boot/til.c. Without this, flipping the source alias and the boot-baked width
// can never happen in one commit (a one-build lag), because the C ABI in
// ext.h has no such lag and the two would disagree at pass 1.
priv find_alias_rhs_in_ast := func(ast: Expr, name: Str) returns Str {
    for i in 0..ast.children.len() {
        ref stmt : Expr = ast.children[i]
        mut is_match := false
        switch stmt.node_type {
        case .Decl(d):
            if d.name == name { is_match = true }
        case:
        }
        if is_match {
            if stmt.children.len() > 0 {
                switch stmt.children[0].node_type {
                // #192: clone -- ident_name() borrows the parsed AST node's name
                // Str (its bytes live in the Expr tree). Returning it as-is hands
                // the caller a view it then frees, freeing into the AST buffer
                // (ASAN: "free on address which was not malloc()-ed"). The clone
                // is an owned heap Str the caller can free safely.
                case .Ident(tn): return tn.ident_name().clone()
                case:
                }
            }
        }
    }
    return ""
}

// Resolve the target-width primitive name for a source-level int alias
// (USize/UPtr). 32-bit targets are always U32. On 64-bit, read the width
// from the source alias decl (lag-free); fall back to the baked
// target_*_name only if the source decl can't be found.
priv target_int_alias_name := func(lp: LoadedProgram, alias_name: Str, target_fallback: Str) returns Str {
    // --usize (issue #309): force the USize alias to a specific width on any
    // host, independent of the target's pointer width. 32 pins it to U32, 64
    // pins it back to U64 (the opt-out from the U32 default). UPtr is never
    // forced here, so it keeps following target_uptr_name (pointer width).
    if alias_name.eq("USize").and(lp.usize_override_bits.eq(32)) { return "U32" }
    if alias_name.eq("USize").and(lp.usize_override_bits.eq(64)) { return "U64" }
    // 32-bit targets narrow this alias to U32. Use the per-alias width the
    // caller resolved (target_fallback = target_usize_name / target_uptr_name)
    // rather than always gating on UPtr's width, so USize and UPtr can differ.
    if target_fallback == "U32" { return "U32" }
    if lp.skip_core.not() {
        for u : ProgramUnit in lp.core_units {
            ref iu : ImportUnit = lp.ctx.imported[u.path]
            rhs := find_alias_rhs_in_ast(iu.ast, alias_name)
            if rhs.len() > 0 { return rhs }
        }
    }
    return target_fallback
}

repl_clone_loaded_program := func(src: LoadedProgram) returns LoadedProgram {
    mut cloned := src.clone()
    repl_reregister_scope_defs_loaded(cloned)
    return cloned
}

priv retarget_alias_binding := func(mut scope: TypeScope, alias_name: Str, target_name: Str) {
    mut alias_binding_o := scope.get_binding(alias_name)
    if alias_binding_o.is_none() { return }
    ref mut alias_binding : TypeBinding = alias_binding_o.unwrap()
    target_binding_o := scope.get_binding(target_name)
    if target_binding_o.is_none() { return }
    ref target_binding : TypeBinding = target_binding_o.unwrap()
    alias_binding.type = target_binding.type.clone()
    target_sd_o := scope.struct_def_of(target_name)
    if target_sd_o.is_some() { scope.set_struct_def(alias_name, target_sd_o.unwrap()) }
    target_fd_o := scope.lookup_func(target_name)
    if target_fd_o.is_some() {
        scope.set_func_def(alias_name, target_fd_o.unwrap())
    }
    alias_binding.is_func_decl = target_binding.is_func_decl
    alias_binding.is_builtin = target_binding.is_builtin
    alias_binding.is_type_alias = true
    alias_binding.alias_target = target_name.clone()
}

retarget_loaded_aliases := func(mut lp: LoadedProgram) {
    retarget_alias_binding(lp.ctx.scope, "UPtr", target_int_alias_name(lp, "UPtr", target_uptr_name(lp.target)))
    retarget_alias_binding(lp.ctx.scope, "USize", target_int_alias_name(lp, "USize", target_usize_name(lp.target)))
}

// Constfolder across per-file units (rstil-style): fold macros/pure funcs in the
// canonical ASTs stored in lp.ctx.imported.
priv constfolder_imported := proc(mut lp: LoadedProgram) {
    // Make codegen_lp() available so raw dispatch helpers can read Context
    // fields (cached_str_name) populated by interpreter_init_ns below.
    // Only reset the fold-results scope here; the foldable-name table
    // (constfolder_foldables) was populated upstream by the typer
    // (constfolder_classify_stmt) and must survive into this phase.
    constfolder_clear_known(lp.ctx)
    lp.ctx.constfolder_known = Option(Scope).Some(own scope_new_owned(Option(ref Scope).None))
    // Issue #109: populate ctx.cached_str_name BEFORE
    // constfolder_register_fold_scope, so the raw Str path inside the
    // fold-scope walk has the field layout needed to clone and drop strings.
    for upath : Str in lp.unit_paths() {
        populate_cached_aggregate_defs(lp.ctx, lp.ctx.imported[upath].ast)
    }
    // Issue #158: one walk per unit builds the runtime fold scope
    // (struct/enum/func defs + literal global constants). Name
    // classification is no longer done here -- it was shared from the
    // typer's walk and lives on Context.
    mut global := scope_new(Option(ref Scope).None)
    for upath : Str in lp.unit_paths() {
        ref iu : ImportUnit = lp.ctx.imported[upath]
        constfolder_register_fold_scope(global, iu.ast, lp.ctx)
    }
    // Nothing to fold? Skip the FFI/fold setup, but still free the
    // (near-empty) scope built above via the single cleanup at the end.
    // til's ownership checker is flow-insensitive, so we keep exactly one
    // scope_free(own global) rather than an early-return that moves it.
    has_fold := lp.ctx.constfolder_foldables.len() > 0
    if has_fold {
        // Issue #191: core constants registered after the defs walk so they
        // win over any like-named definition (e.g. CAP_VIEW for Str ops).
        constfolder_register_core_constants(global, lp.ctx.target_usize_pname, lp.ctx)

        for upath : Str in lp.unit_paths() {
            interpreter_init_ns(lp.ctx, global, lp.ctx.imported[upath].ast)
        }

        // 2b) Init FFI for the interpreter used by constfolder.
        // Scan per-file ASTs directly to avoid merged-AST cloning.
        ffi_reset(lp.ctx)
        for upath : Str in lp.unit_paths() {
            ref iu : ImportUnit = lp.ctx.imported[upath]
            ffi_init_struct_defs_append(iu.ast, lp.ctx)
            ffi_init_scan_program(iu.ast, lp.ctx)
        }
        // Mark FFI loaded so ext_dispatch_ffi will dispatch the entries we
        // just registered. Built-in ext_funcs (I64_add etc.) are statically
        // linked, so no .so needs dlopen'ing for constfolder's eval-based fold
        // to call them.
        lp.ctx.ffi_loaded = true

        // 3) Fold calls in every file. The known-fold map lives on ctx
        // (ctx.constfolder_known); constfolder_reset_state below clears it.
        for upath : Str in lp.unit_paths() {
            context_enter_file(lp.ctx, upath)
            process_body(global, lp.ctx.imported[upath].ast, lp.ctx, true)
        }
    }

    scope_drop_owned_bindings(global)
    scope_free(own global)
    interpreter_free_ns(lp.ctx)
    constfolder_reset_state(lp.ctx)
    constfolder_clear_known(lp.ctx)
    // The fold pass is over; release the Scope boxes it parked in the pool
    // (the build path never reaches interp_session_free's drain).
    scope_pool_drain()
}

priv repl_classify_foldables_program := func(mut ctx: Context, program: Expr) {
    for stmt : Expr in program.children {
        constfolder_classify_stmt(stmt, ctx)
    }
}

priv repl_classify_foldables_loaded := func(mut lp: LoadedProgram) {
    for upath : Str in lp.unit_paths() {
        repl_classify_foldables_program(lp.ctx, lp.ctx.imported[upath].ast)
    }
    for mf : Str in lp.mode_files {
        repl_classify_foldables_program(lp.ctx, lp.ctx.imported[mf].ast)
    }
}

priv repl_reregister_scope_defs_loaded := func(mut lp: LoadedProgram) {
    for upath : Str in lp.unit_paths() {
        reregister_repl_scope_defs(lp.ctx.imported[upath].ast, lp.ctx.scope)
    }
    for mf : Str in lp.mode_files {
        reregister_repl_scope_defs(lp.ctx.imported[mf].ast, lp.ctx.scope)
    }
}

priv constfolder_repl_delta := proc(mut lp: LoadedProgram, mut delta: Expr) {
    constfolder_clear_known(lp.ctx)
    lp.ctx.constfolder_known = Option(Scope).Some(own scope_new_owned(Option(ref Scope).None))
    for upath : Str in lp.unit_paths() {
        populate_cached_aggregate_defs(lp.ctx, lp.ctx.imported[upath].ast)
    }
    populate_cached_aggregate_defs(lp.ctx, delta)

    mut global := scope_new(Option(ref Scope).None)
    for upath : Str in lp.unit_paths() {
        ref iu2 : ImportUnit = lp.ctx.imported[upath]
        constfolder_register_fold_scope(global, iu2.ast, lp.ctx)
    }
    constfolder_register_fold_scope(global, delta, lp.ctx)

    has_fold := lp.ctx.constfolder_foldables.len() > 0
    if has_fold {
        constfolder_register_core_constants(global, lp.ctx.target_usize_pname, lp.ctx)

        for upath : Str in lp.unit_paths() {
            interpreter_init_ns(lp.ctx, global, lp.ctx.imported[upath].ast)
        }
        interpreter_init_ns(lp.ctx, global, delta)

        ffi_reset(lp.ctx)
        for upath : Str in lp.unit_paths() {
            ref iu6 : ImportUnit = lp.ctx.imported[upath]
            ffi_init_struct_defs_append(iu6.ast, lp.ctx)
            ffi_init_scan_program(iu6.ast, lp.ctx)
        }
        ffi_init_struct_defs_append(delta, lp.ctx)
        ffi_init_scan_program(delta, lp.ctx)
        lp.ctx.ffi_loaded = true

        ref root : ProgramUnit = lp.units[lp.units.len() - 1]
        context_enter_file(lp.ctx, root.path)
        process_body(global, delta, lp.ctx, true)
    }

    scope_drop_owned_bindings(global)
    scope_free(own global)
    // Same pool release as the full fold pass above (REPL delta pass).
    scope_pool_drain()
    constfolder_clear_known(lp.ctx)
}

// #303 / #321: seed the noreturn chain BEFORE any body is type-checked.
//
// noreturn is inferred bottom-up at the END of typing each Func/Proc body
// (infer_func_def_expr), so a call only counts as diverging once its
// CALLEE has already been typed. That is an ORDER dependency, and it is
// wrong for any unit typed before core/exit.til: there `panic` carries no
// stamp yet, so a `case: panic(...)` arm does not count as diverging and
// check_all_paths_return rejects the function. core.til imports ast before
// exit, which is exactly why src/core/ast.til could not instantiate
// Option -- Option.unwrap ends in that arm.
//
// The whole chain lives in one file (exit is the ext_func seed; panic,
// TODO, UNREACHABLE, assert, expect and assert_eq are defined there and
// call each other), so the fixpoint below runs over that file alone and
// resolves callees against its OWN top-level decls -- no scope lookup, so
// a local shadowing a noreturn global cannot fool it. Same shape as the
// extend_throwing_func_sigs sweep below, and idempotent for the same
// reason: the typer redoes the stamping later and reaches the same answer.
priv seed_noreturn_chain := proc(mut ast: Expr) {
    mut noreturn_names := Set(Str).new()
    // The one primitive that cannot be inferred: an ext_func with no til
    // body, bound to libc exit.
    for mut stmt : Expr in ast.children {
        if stmt.children.len() == 0 { continue }
        switch stmt.node_type {
        case .Decl(dd):
            ref mut rhs : Expr = stmt.children[0]
            switch rhs.node_type {
            case .FuncDef(fd):
                if fd.func_type.is(FuncType.ExtFunc) {
                    fd.noreturn = true
                    noreturn_names.add(own dd.name.clone())
                }
            case:
            }
        case:
        }
    }
    // Fixpoint: each round stamps the calls whose callee is already known
    // noreturn, then re-asks fn_never_returns. A chain of length N settles
    // in N rounds; the guard is the round that adds nothing.
    mut changed := true
    while changed {
        changed = false
        for mut stmt : Expr in ast.children {
            if stmt.children.len() == 0 { continue }
            switch stmt.node_type {
            case .Decl(dd):
                ref mut rhs : Expr = stmt.children[0]
                switch rhs.node_type {
                case .FuncDef(fd):
                    if fd.func_type.is_plain().not() { continue }
                    if noreturn_names.has(dd.name) { continue }
                    if rhs.children.len() == 0 { continue }
                    ref mut body : Expr = rhs.children[0]
                    stamp_noreturn_calls(body, noreturn_names)
                    if fn_never_returns(body) {
                        fd.noreturn = true
                        noreturn_names.add(own dd.name.clone())
                        changed = true
                    }
                case:
                }
            case:
            }
        }
    }
    // One last stamping pass so calls inside the functions that settled
    // early also carry the bit the typer would set later.
    for mut stmt : Expr in ast.children {
        if stmt.children.len() == 0 { continue }
        switch stmt.node_type {
        case .Decl:
            ref mut rhs : Expr = stmt.children[0]
            switch rhs.node_type {
            case .FuncDef:
                if rhs.children.len() > 0 { stamp_noreturn_calls(rhs.children[0], noreturn_names) }
            case:
            }
        case:
        }
    }
}

// Mark every FCall in `e` whose callee names one of `noreturn_names`.
// The typer stamps the same bit from the callee's FunctionDef later; this
// only makes it available earlier.
priv stamp_noreturn_calls := proc(mut e: Expr, noreturn_names: Set(Str)) {
    switch e.node_type {
    case .FCall(fcd):
        if e.children.len() > 0 {
            switch e.children[0].node_type {
            case .Ident(cn):
                if noreturn_names.has(cn.ident_name()) { fcd.noreturn_call = true }
            case:
            }
        }
    case:
    }
    for mut c : Expr in e.children {
        stamp_noreturn_calls(c, noreturn_names)
    }
}

// Types that a CLI argument can be parsed into. Must match the builder's
// cli_box_expr (codegen) and the interpreter's parse_cli_arg -- keep the
// three in sync when adding a type.
// Reject a main() whose parameters can't be parsed from CLI arguments, with a
// clear up-front error. Without this the builder emits C that references an
// undeclared param (a cryptic -Werror=unused-parameter failure) instead of a
// usable message. The variadic param is checked by its element type, which is
// what the builder parses. Runs on the compile path (prepare_program, just
// before the scavenge); the
// interpreter additionally guards at runtime in parse_cli_arg.
priv validate_cli_main := func(lp: LoadedProgram) {
    if lp.cur_mode.needs_main.not() { return }
    if lp.run_tests { return }
    for u : ProgramUnit in lp.units {
        for stmt : Expr in lp.ctx.imported[u.path].ast.children {
            if stmt.node_type.is(NodeType.Decl).not() { continue }
            if stmt.children.len() == 0 { continue }
            mut is_main_decl := false
            switch stmt.node_type {
            case .Decl(d):
                if d.name == "main" { is_main_decl = true }
            case:
            }
            if is_main_decl.not() { continue }
            switch stmt.children[0].node_type {
            case .FuncDef(fdef):
                for p : Declaration in fdef.params {
                    if or(p.explicit_type.eq("Str"),
                          p.explicit_type.eq("I64"),
                          p.explicit_type.eq("U8"),
                          p.explicit_type.eq("I8"),
                          p.explicit_type.eq("I16"),
                          p.explicit_type.eq("U16"),
                          p.explicit_type.eq("I32"),
                          p.explicit_type.eq("U32"),
                          p.explicit_type.eq("U64"),
                          p.explicit_type.eq("USize"),
                          p.explicit_type.eq("UPtr"),
                          p.explicit_type.eq("Bool"),
                          p.explicit_type.eq("F32"),
                          p.explicit_type.eq("F64")).not() {
                        loc := format(u.path, ":", stmt.line.to_str(), ":", stmt.col.to_str())
                        panic("main parameter '", p.name, "': type '", p.explicit_type,
                            "' cannot be parsed from a CLI argument (supported: Str, Bool, F32, F64, I8/U8/I16/U16/I32/U32/I64/U64/USize/UPtr)", loc = loc)
                    }
                }
            case:
            }
        }
    }
}

// Scan program AST for link()/link_c() directives; fill link_flags,
// include_flags, link_c_paths on the given LoadedProgram.
priv extract_link_info := proc(mut lp: LoadedProgram) {
    root_dir := lp.ext_c_path.strip_suffix("/src/c/ext.c")
    // Remove link()/link_c() directives in-place from every user file so the
    // interpreter never evaluates them. Move iu.ast.children into a local Vec
    // and push_take kept stmts (no clone); old_children's garbager-inserted
    // delete after the loop drops the dropped link directives (#302).
    for u : ProgramUnit in lp.units {
        ref mut iu : ImportUnit = lp.ctx.imported[u.path]
        base_dir := dir_of(u.path)
        mut old_children := iu.ast.children.take()
        mut new_children := Vec(Expr).new()
        for idx in 0..old_children.count {
            ref stmt : Expr = old_children[idx]
            mut keep := true
            if stmt.node_type.is(NodeType.FCall).and(stmt.children.len().eq(2)) {
                switch stmt.children[0].node_type {
                case .Ident(fname):
                    switch stmt.children[1].node_type {
                    case .Literal(Literal.Str(arg)):
                        if fname.ident_name() == "link" {
                            keep = false
                            if arg.find("/") >= 0 {
                                resolved := resolve_link_path(base_dir, root_dir, arg)
                                lp.link_flags = lp.link_flags.format(" ", resolved)
                                last_slash := resolved.rfind("/")
                                if last_slash >= 0 {
                                    parent_dir := resolved.substr(0, last_slash.to_usize())
                                    parent_slash := parent_dir.rfind("/")
                                    if parent_slash >= 0 {
                                        inc_dir := parent_dir.substr(0, parent_slash.to_usize()).format("/include")
                                        lp.include_flags = lp.include_flags.format(" -I", inc_dir)
                                    }
                                }
                            } else {
                                lp.link_flags = lp.link_flags.format(" -l", arg)
                            }
                        } else if fname.ident_name() == "link_c" {
                            keep = false
                            if lp.link_c_paths.len() > 0 {
                                lp.link_c_paths = format(lp.link_c_paths, " ")
                            }
                            lp.link_c_paths = format(lp.link_c_paths, resolve_link_path(base_dir, root_dir, arg))
                        }
                    case:
                    }
                case:
                }
            }
            if keep { new_children.push_take(old_children, idx) }
        }
        iu.ast.children = new_children
    }
}

priv load_mode_file := proc(mut lp: LoadedProgram, path: Str, cwd: Str) {
    abs_path := realpath_str(path)
    if abs_path == "" { return }
    disp := display_path(abs_path, cwd)
    source := File.readfile(abs_path)
    tokens := tokenize(source, disp)
    mut mode_str := ""
    mut parse_errors_ast : I32 = 0
    mut ast := parse(tokens, source, disp, mode_str, lp.ctx.anon_type_counter, parse_errors_ast)
    // A syntax error must stop the build here. parse reports it and returns
    // a PARTIAL ast so the REPL can survive a bad turn; a file compile that
    // carried on would bury that message under downstream type errors.
    if parse_errors_ast > 0 { exit(1) }
    mode_str = normalize_mode_name(mode_str)
    if mode_str.eq("mode").not() {
        panic("file '", disp, "' is not a 'mode mode' file")
    }
    for stmt : Expr in ast.children {
        mut is_valid := false
        if stmt.node_type.is(NodeType.Decl) {
            switch stmt.node_type {
            case .Decl(decl):
                if stmt.children.len() > 0 {
                    ref val : Expr = stmt.children[0]
                    if val.node_type.is(NodeType.FCall).and(val.children.len().gt(0)) {
                        ref callee : Expr = val.children[0]
                        switch callee.node_type {
                        case .Ident(id):
                            if id.ident_name() == "Mode" {
                                is_valid = true
                                mut m := Mode()
                                for i in 1..val.children.len() {
                                    ref arg : Expr = val.children[i]
                                    switch arg.node_type {
                                    case .NamedArg(arg_name):
                                        switch arg.children[0].node_type {
                                        case .Literal(Literal.Bool(b)):
                                            if arg_name == "needs_main" { m.needs_main = b }
                                            else if arg_name == "decls_only" { m.decls_only = b }
                                            else if arg_name == "is_library" { m.is_library = b }
                                            else if arg_name == "is_pure" { m.is_pure = b }
                                            else if arg_name == "run_tests" { m.run_tests = b }
                                            else if arg_name == "debug_prints" { m.debug_prints = b }
                                            else { panic(": unknown bool argument '", arg_name, "'", loc = disp) }
                                        case .Literal(Literal.Str(s)):
                                            if arg_name == "auto_import" { m.auto_import = s.clone() }
                                            else { panic(": unknown string argument '", arg_name, "'", loc = disp) }
                                        case:
                                            panic(": argument '", arg_name, "' must be a literal", loc = disp)
                                        }
                                    case:
                                        panic(": Mode arguments must be named (e.g. needs_main = true)", loc = disp)
                                    }
                                }
                                lp.ctx.mode_registry.set(decl.name, own m.clone())
                            }
                        case:
                        }
                    }
                }
            case:
            }
        }
        if is_valid.not() {
            loc := disp.format(":", stmt.line.to_str(), ":", stmt.col.to_str())
            panic(": only Mode(...) declarations are allowed in 'mode mode' files", loc = loc)
        }
    }

    // Store in lp.ctx.imported so it can be typechecked.
    mut iu := ImportUnit(mode_str = mode_str.clone())
    switch mode_resolve(lp.ctx, mode_str) {
    case .Some(mode_mode_def): iu.mode = mode_mode_def.clone()
    case .None:
        panic("unknown mode '", mode_str, "' for mode file")
    }
    iu.ast.take_children(ast)
    context_register_path_mode(lp.ctx, disp, iu.mode)
    lp.ctx.imported.set(disp, own iu)
    lp.mode_files.push(own disp.clone())
}

// Load core.til + user file + imports + mode auto_import. Returns a
// LoadedProgram with the merged ASTs and link info populated.
// import_base overrides the directory user imports resolve against. Empty
// (every file compile) means the entrypoint's own directory, as always; the
// REPL passes the user's cwd so its tmp/ scratch file does not leak into the
// paths the user types. Check `load_errors` on the result: non-zero means the
// program is unusable because an import could not be resolved or parsed.
load_program := proc(path: Str, bin_dir: Str, cwd: Str, ext_c_path: Str, extra_modes: Vec(Str), import_base: Str = "") returns LoadedProgram {
    mut lp := LoadedProgram()
    context_init_mode_registry(lp.ctx)
    lp.path = path.clone()
    lp.ext_c_path = ext_c_path.clone()
    lp.target = detect_current_target()

    core_path := format(bin_dir, "/src/core/core.til")
    core_disp := display_path(core_path, cwd)

    load_mode_file(lp, format(bin_dir, "/src/core/modes.til"), cwd)
    for extra_mode : Str in extra_modes {
        load_mode_file(lp, extra_mode, cwd)
    }

    // Single resolved set for all imports (core + user), so no file is loaded twice
    mut resolved := Set(Str).new()
    mut resolve_stack := Vec(Expr).new()

    // Resolve mode files' imports
    mut core_units := Vec(ProgramUnit).new()
    for mode_file : Str in lp.mode_files {
        ref mut miu_temp : ImportUnit = lp.ctx.imported[mode_file]
        mode_imports := extract_imports(miu_temp.ast, mode_file)
        mut auto_disp := ""
        if miu_temp.mode.auto_import.len() > 0 {
            mut auto_path := bin_dir.format("/", miu_temp.mode.auto_import, ".til")
            if realpath_str(auto_path) == "" {
                // If it fails relative to bin_dir, maybe it's relative to the CWD (for custom modes in other projects)
                auto_path = cwd.format("/", miu_temp.mode.auto_import, ".til")
            }
            abs_auto := realpath_str(auto_path)
            if abs_auto.len() > 0 {
                if resolved.has(abs_auto).not() {
                    resolved.add(own abs_auto.clone())
                    disp_auto := display_path(abs_auto, cwd)
                    source_auto := File.readfile(abs_auto)
                    tokens_auto := tokenize(source_auto, disp_auto)
                    mut mode_auto := ""
                    mut parse_errors_ast_auto : I32 = 0
                    mut ast_auto := parse(tokens_auto, source_auto, disp_auto, mode_auto, lp.ctx.anon_type_counter, parse_errors_ast_auto)
                    // A syntax error must stop the build here. parse reports it and returns
                    // a PARTIAL ast so the REPL can survive a bad turn; a file compile that
                    // carried on would bury that message under downstream type errors.
                    if parse_errors_ast_auto > 0 { exit(1) }
                    mode_auto = normalize_mode_name(mode_auto)
                    ref mode_auto_def : Mode = require_mode(lp.ctx, disp_auto, mode_auto)
                    context_register_path_mode(lp.ctx, disp_auto, mode_auto_def)

                    mut iu_auto := ImportUnit(mode_str = mode_auto.clone())
                    iu_auto.mode = mode_auto_def.clone()
                    iu_auto.ast.take_children(ast_auto)
                    lp.ctx.imported.set(disp_auto, own iu_auto)

                    mut unit_auto := ProgramUnit(path = disp_auto.clone(), mode = mode_auto_def.clone())
                    core_units.push(own unit_auto)
                }
                auto_disp = display_path(abs_auto, cwd)
            }
        }
        if mode_imports.len() > 0 {
            mode_dir := dir_of(realpath_str(mode_file))
            err := resolve_imports(mode_imports, mode_dir, resolved, resolve_stack,
                core_units, "", lp.ctx, "lib", cwd)
            if err > 0 {
                panic("failed to resolve imports for mode file ", mode_file)
            }
            ref mut miu : ImportUnit = lp.ctx.imported[mode_file]
            miu.imports = resolve_import_disps(mode_imports, mode_dir, "", cwd)
        }
        if auto_disp.len() > 0 {
            lp.ctx.imported[mode_file].imports.push(own auto_disp)
        }
    }

    // Add user file to resolved set early (so core imports skip it if it overlaps)
    abs_path := realpath_str(path)
    mut user_dir := "."
    if abs_path.len() > 0 {
        user_dir = dir_of(abs_path)
        resolved.add(own abs_path.clone())
    }

    // Load core.til
    core_source := File.readfile(core_path)
    core_tokens := tokenize(core_source, core_disp)
    mut core_mode_str := ""
    mut parse_errors_core_ast : I32 = 0
    mut core_ast := parse(core_tokens, core_source, core_disp, core_mode_str, lp.ctx.anon_type_counter, parse_errors_core_ast)
    // A syntax error must stop the build here. parse reports it and returns
    // a PARTIAL ast so the REPL can survive a bad turn; a file compile that
    // carried on would bury that message under downstream type errors.
    if parse_errors_core_ast > 0 { exit(1) }
    ref core_mode : Mode = require_mode(lp.ctx, core_disp, core_mode_str)
    context_register_path_mode(lp.ctx, core_disp, core_mode)

    // Add core.til to resolved set; skip prepending if user file IS core.til
    mut skip_core := false
    core_abs := realpath_str(core_path)
    if core_abs.len() > 0 {
        if resolved.has(core_abs) {
            skip_core = true
        }
        resolved.add(own core_abs.clone())
    }

    // Resolve core imports
    core_imports := extract_imports(core_ast, core_disp)
    if core_imports.len().gt(0).and(skip_core.not()) {
        core_dir := format(bin_dir, "/src/core")
        err := resolve_imports(core_imports, core_dir, resolved, resolve_stack,
            core_units, "", lp.ctx, "lib", cwd)
        if err > 0 {
            panic("failed to resolve core imports")
        }
    }

    // Load user file
    source := File.readfile(path)
    tokens := tokenize(source, path)
    mut mode_str := ""
    mut parse_errors_user_ast : I32 = 0
    mut user_ast := parse(tokens, source, path, mode_str, lp.ctx.anon_type_counter, parse_errors_user_ast)
    // A syntax error must stop the load here. parse reports it and returns a
    // PARTIAL ast, and carrying on would bury that message under downstream
    // type errors. Recorded rather than exit(1): the entrypoint is the REPL's
    // own scratch file on every full-load turn, so exiting killed the session
    // whenever a line reached this path -- a bare `sys` after any import, for
    // one, since an import makes every later turn a full load.
    if parse_errors_user_ast > 0 {
        lp.load_errors = parse_errors_user_ast
        return lp
    }
    imports := extract_imports(user_ast, path)
    mode_str = normalize_mode_name(mode_str)
    ref cur_mode : Mode = require_mode(lp.ctx, path, mode_str)
    context_register_path_mode(lp.ctx, path, cur_mode)
    lp.ctx.mode = cur_mode.clone()

    // If mode has auto_import, load its .til declarations
    auto_import := cur_mode.auto_import

    // Resolve user imports (using same resolved set -- skips files already loaded by core)
    mut units := Vec(ProgramUnit).new()
    lib_dir := format(bin_dir, "/lib")
    // An import is resolved relative to the importing FILE's directory. The
    // REPL's entrypoint is a scratch file under tmp/, which is an
    // implementation detail the user never typed: `import("src/std/sys")` at
    // the prompt looked for tmp/src/std/sys.til and only `../src/std/sys`
    // worked. import_base lets the REPL say "resolve as if the prompt were a
    // file in the user's cwd", which is where the user thinks he is.
    mut import_dir := user_dir.clone()
    if import_base.len() > 0 { import_dir = import_base.clone() }
    user_import_disps := resolve_import_disps(imports, import_dir, lib_dir, cwd)
    if imports.len() > 0 {
        err := resolve_imports(imports, import_dir, resolved, resolve_stack,
            units, lib_dir, lp.ctx, "", cwd)
        // A missing or unparsable import is USER error -- a typo at the REPL
        // prompt is enough -- so it is recorded, not fatal. cmd_* exits on it;
        // the REPL drops the turn and keeps the session. (Core and mode-file
        // resolution still panic above: those failing means a broken install.)
        if err > 0 {
            lp.load_errors = err
            return lp
        }
    }

    // Core entrypoint import unit.
    mut core_iu := ImportUnit(mode = core_mode.clone())
    core_iu.ast.take_children(core_ast)
    core_iu.imports = resolve_import_disps(core_imports, format(bin_dir, "/src/core"), "", cwd)
    lp.ctx.imported.set(core_disp, own core_iu)

    // Core entrypoint unit (after its imports).
    mut core_unit := ProgramUnit(path = core_disp.clone(), mode = core_mode.clone())
    core_unit.imports = lp.ctx.imported[core_disp].imports.clone()
    core_units.push(own core_unit)

    // Mode auto-import is represented as the first unit (if present),
    // followed by imported files, with the user entrypoint unit last.
    mut mode_disp := ""
    if auto_import.len() > 0 {
        mut mode_til_path := bin_dir.format("/", auto_import, ".til")
        if realpath_str(mode_til_path) == "" {
            mode_til_path = user_dir.format("/", auto_import, ".til")
        }
        if realpath_str(mode_til_path) == "" {
            mode_til_path = bin_dir.format("/src/modes/", auto_import, ".til")
        }
        mode_disp = display_path(mode_til_path, cwd)
        mode_source := File.readfile(mode_til_path)
        mode_tokens := tokenize(mode_source, mode_disp)
        mut mode_mode := ""
        mut parse_errors_mode_ast : I32 = 0
        mut mode_ast := parse(mode_tokens, mode_source, mode_disp, mode_mode, lp.ctx.anon_type_counter, parse_errors_mode_ast)
        // A syntax error must stop the build here. parse reports it and returns
        // a PARTIAL ast so the REPL can survive a bad turn; a file compile that
        // carried on would bury that message under downstream type errors.
        if parse_errors_mode_ast > 0 { exit(1) }
        mode_mode = normalize_mode_name(mode_mode)
        ref mode_mode_def : Mode = require_mode(lp.ctx, mode_disp, mode_mode)
        context_register_path_mode(lp.ctx, mode_disp, mode_mode_def)

        // Resolve the auto-import file's own imports (mirrors core.til).
        mode_imports := extract_imports(mode_ast, mode_disp)
        mode_dir := dir_of(realpath_str(mode_til_path))
        if mode_imports.len() > 0 {
            err := resolve_imports(mode_imports, mode_dir, resolved, resolve_stack,
                units, lib_dir, lp.ctx, "", cwd)
            if err > 0 {
                panic("failed to resolve mode auto-import imports")
            }
        }

        // Mode auto-import import unit.
        mut mode_iu := ImportUnit(mode = mode_mode_def.clone())
        mode_iu.ast.take_children(mode_ast)
        mode_iu.imports = resolve_import_disps(mode_imports, mode_dir, lib_dir, cwd)
        lp.ctx.imported.set(mode_disp, own mode_iu)

        // Mode auto-import unit.
        mut mode_unit := ProgramUnit(path = mode_disp.clone(), mode = mode_mode_def.clone())
        mode_unit.imports = lp.ctx.imported[mode_disp].imports.clone()
        units.push(own mode_unit)

    }

    // User entrypoint import unit.
    mut user_iu := ImportUnit(mode = cur_mode.clone())
    user_iu.ast.take_children(user_ast)
    // Ensure mode auto-import runs before the file's explicit imports.
    // This matches the merged AST order and keeps per-file init/type in sync.
    if mode_disp.len() > 0 {
        mut all_imports := Vec(Str).new()
        all_imports.push(own mode_disp.clone())
        for dep : Str in user_import_disps { all_imports.push(own dep.clone()) }
        user_iu.imports = all_imports
    } else {
        user_iu.imports = user_import_disps.clone()
    }
    lp.ctx.imported.set(path, own user_iu)

    // User entrypoint unit.
    mut user_unit := ProgramUnit(path = path.clone(), mode = cur_mode.clone())
    if mode_disp.len() > 0 {
        mut all_imports2 := Vec(Str).new()
        all_imports2.push(own mode_disp)
        for dep : Str in user_import_disps { all_imports2.push(own dep.clone()) }
        user_unit.imports = all_imports2
    } else {
        user_unit.imports = user_import_disps
    }
    units.push(own user_unit)

    lp.core_units = core_units
    lp.units = units
    lp.cur_mode = cur_mode.clone()

    // lp.ctx.imported is populated during import resolution and for the
    // entrypoint files above.

    lp.skip_core = skip_core
    lp.mode_str = mode_str

    extract_link_info(lp)
    return lp
}

// --- Doc registry synthesis ---

// Escape raw bytes for use as a NodeType.Literal(Literal.Str) text. The interpreter
// (eval_expr_raw in interpreter.til) and the C codegen (Str_lit in builder.til)
// both expect the source-level form: \\, \", \n, \t. Escaping here keeps
// both paths happy when synthesised doc text contains newlines or quotes.
priv escape_doc_for_literal_str := func(raw: Str) returns Str {
    mut out := ""
    for c : I8 in raw {
        if c == '\\' {
            out = format(out, "\\\\")
        } else if c == '"' {
            out = format(out, "\\\"")
        } else if c == 10 {
            out = format(out, "\\n")
        } else if c == 9 {
            out = format(out, "\\t")
        } else {
            out = format(out, Str.from_byte(c.cast(U8)))
        }
    }
    return out
}

// Classify a top-level Decl's FuncType into a kind string.
priv func_kind := func(ft: FuncType) returns Str {
    switch ft {
    case .Proc:    return "proc"
    case .Test:    return "test"
    case .Macro:   return "macro"
    case .ExtFunc: return "ext_func"
    case .ExtProc: return "ext_proc"
    case .CoreFunc: return "core_func"
    case .CoreProc: return "core_proc"
    case: return "func"
    }
}

// User-facing Type name for help() info strings. "" for Unknown/None.
priv til_type_user := func(t: Type) returns Str {
    switch t {
    case .Primitive(Primitive.I64):       return "I64"
    case .Primitive(Primitive.U8):        return "U8"
    case .Primitive(Primitive.I8):        return "I8"
    case .Primitive(Primitive.I16):       return "I16"
    case .Primitive(Primitive.U16):       return "U16"
    case .Primitive(Primitive.I32):       return "I32"
    case .Primitive(Primitive.U32):       return "U32"
    case .Primitive(Primitive.U64):       return "U64"
    case .Primitive(Primitive.F32):       return "F32"
    case .Primitive(Primitive.F64):       return "F64"
    case .Primitive(Primitive.Bool):      return "Bool"
    case .Struct(name):    return name.clone()
    case .StructDef:       return "StructDef"
    case .Enum(name):      return name.clone()
    case .EnumDef:         return "EnumDef"
    case .FuncDef:         return "FunctionDef"
    case .FuncPtr:         return "Fn"
    case .Dynamic:         return "Dynamic"
    case .Custom(name):    return name.clone()
    case: return ""
    }
}

// Append "name<0x01>value<0x02>" to packed. 0x01/0x02 are control bytes
// that won't appear in identifiers or /// doc text, so they make safe
// field/record separators for doc_blob_lookup, which std/doc.til's help()
// scans them with.
priv append_packed_entry := func(mut packed: Str, name: Str, value: Str) {
    packed.push_str(name)
    packed.push_str(Str.from_byte(1))
    packed.push_str(value)
    packed.push_str(Str.from_byte(2))
}

// Append "[own |ref |shallow ][mut ]" prefix for d, omitting whichever
// ownership the surrounding context already implies.
priv append_qualifier_prefix := func(mut out: Str, d: Declaration, default_own: OwnType) {
    if d.own_type.is(default_own).not() {
        switch d.own_type {
        case .Own:     out.push_str("own ")
        case .Ref:     out.push_str("ref ")
        case .Shallow: out.push_str("shallow ")
        }
    }
    if d.is_mut { out.push_str("mut ") }
}

// Append "(p1: T1, name: ..TN)" plus optional " returns [shallow|ref ]T".
priv append_fn_signature := func(mut out: Str, fd: FunctionDef) {
    out.push_str("(")
    var_idx_i64 : I64 = fd.variadic_index.cast(I64)
    for i in 0..fd.params.len() {
        if i > 0 { out.push_str(", ") }
        ref p : Declaration = fd.params[i]
        is_variadic := i.to_i64() == var_idx_i64
        if is_variadic.not() { append_qualifier_prefix(out, p, OwnType.Ref) }
        out.push_str(p.name)
        if p.explicit_type.len() > 0 {
            out.push_str(": ")
            if is_variadic { out.push_str("..") }
            out.push_str(p.explicit_type)
        }
    }
    out.push_str(")")
    if fd.return_type.len() > 0 {
        out.push_str(" returns ")
        switch fd.return_own_type {
        case .Shallow: out.push_str("shallow ")
        case .Ref:     out.push_str("ref ")
        case .Own:
        }
        out.push_str(fd.return_type)
    }
}

// Append "<indent>/// <line>\n" for each line of doc.
priv append_doc_lines_indented := func(mut out: Str, doc: Str, indent: Str) {
    if doc.is_empty() { return }
    mut start : USize = 0
    for i in 0..doc.len() {
        ref c : I8 = doc.unsafe_get(i)
        if c == 10 {
            out.push_str(indent)
            out.push_str("/// ")
            if i > start { out.push_str(doc.substr(start, i - start)) }
            out.push_str("\n")
            start = i + 1
        }
    }
    out.push_str(indent)
    out.push_str("/// ")
    if start < doc.len() { out.push_str(doc.substr(start, doc.len() - start)) }
    out.push_str("\n")
}

DocMeta := struct {
    body := ""
    group := ""
    since := ""
    deprecated := ""
    hidden := false
}

doc_keyword_value := func(line: Str, key: Str) returns Str {
    trimmed := line.trim()
    if trimmed.starts_with(key).not() { return "" }
    return trimmed.substr(key.len(), trimmed.len() - key.len()).trim().clone()
}

doc_false_value := func(value: Str) returns Bool {
    trimmed := value.trim()
    return trimmed.eq("false").or(trimmed.eq("nil")).or(trimmed.eq("no"))
}

doc_meta_line := func(line: Str, mut meta: DocMeta) returns Bool {
    trimmed := line.trim()
    if trimmed.starts_with("#+doc:") {
        value := doc_keyword_value(trimmed, "#+doc:")
        if doc_false_value(value) { meta.hidden = true }
        return true
    }
    if trimmed.starts_with("#+group:") {
        meta.group = doc_keyword_value(trimmed, "#+group:")
        return true
    }
    if trimmed.starts_with("#+since:") {
        meta.since = doc_keyword_value(trimmed, "#+since:")
        return true
    }
    if trimmed.starts_with("#+deprecated:") {
        meta.deprecated = doc_keyword_value(trimmed, "#+deprecated:")
        return true
    }
    return false
}

parse_doc_meta := func(doc: Str) returns DocMeta {
    mut meta := DocMeta()
    mut body := Str.with_capacity(doc.len())
    mut start : USize = 0
    for i in 0..doc.len() {
        ref c : I8 = doc.unsafe_get(i)
        if c == 10 {
            line := doc.substr(start, i - start)
            if doc_meta_line(line, meta).not() {
                if body.is_empty().not() { body.push_str("\n") }
                body.push_str(line)
            }
            start = i + 1
        }
    }
    if start < doc.len() {
        line := doc.substr(start, doc.len() - start)
        if doc_meta_line(line, meta).not() {
            if body.is_empty().not() { body.push_str("\n") }
            body.push_str(line)
        }
    }
    meta.body = body
    return meta
}

format_doc_for_help := func(doc: Str) returns Str {
    meta := parse_doc_meta(doc)
    if meta.hidden { return "" }
    cap := meta.body.len().add(meta.group.len()).add(meta.since.len()).add(meta.deprecated.len()) + 64
    mut out := Str.with_capacity(cap)
    if meta.since.is_empty().not() { out.push_str("Since: "); out.push_str(meta.since); out.push_str("\n") }
    if meta.deprecated.is_empty().not() { out.push_str("Deprecated: "); out.push_str(meta.deprecated); out.push_str("\n") }
    if meta.group.is_empty().not() { out.push_str("Group: "); out.push_str(meta.group); out.push_str("\n") }
    if out.is_empty().not().and(meta.body.is_empty().not()) { out.push_str("\n") }
    out.push_str(meta.body)
    return out
}

// Append "    [own |ref |shallow ][mut ]name : Type" for a struct field.
priv append_field_indented := func(mut out: Str, dname: Str, d: Declaration) {
    append_doc_lines_indented(out, d.doc, "    ")
    out.push_str("    ")
    append_qualifier_prefix(out, d, OwnType.Shallow)
    out.push_str(dname)
    if d.explicit_type.len() > 0 {
        out.push_str(" : ")
        out.push_str(d.explicit_type)
    }
}

// Append "    [kind ]name(sig) returns T" for a namespace method.
priv append_ns_method_indented := func(mut out: Str, dname: Str, d: Declaration) {
    append_doc_lines_indented(out, d.doc, "    ")
    out.push_str("    ")
    mut handled := false
    if d.default_value.is_some() {
        switch d.default_expr().node_type {
        case .FuncDef(fd):
            out.push_str(func_kind(fd.func_type))
            out.push_str(" ")
            out.push_str(dname)
            append_fn_signature(out, fd)
            handled = true
        case:
        }
    }
    if handled.not() {
        out.push_str(dname)
        if d.explicit_type.len() > 0 {
            out.push_str(" : ")
            out.push_str(d.explicit_type)
        }
    }
}

priv format_var_info := func(name: Str, dd: Declaration, scope: TypeScope) returns Str {
    mut t := dd.til_type.clone()
    if t.is(Type.Unknown) { t = scope.get_type(name) }
    type_str := til_type_user(t)
    if type_str.is_empty().not() {
        return name.format(" is a ", type_str)
    }
    if dd.explicit_type.len() > 0 {
        return format(name, " is a ", dd.explicit_type)
    }
    return name
}

priv format_func_info := func(name: Str, fd: FunctionDef) returns Str {
    mut cap : USize = name.len().add(fd.return_type.len()) + 64
    for p : Declaration in fd.params {
        cap = cap.add(p.name.len()).add(p.explicit_type.len()) + 48
    }
    mut out := Str.with_capacity(cap)
    out.push_str(func_kind(fd.func_type))
    out.push_str(" ")
    out.push_str(name)
    append_fn_signature(out, fd)
    return out
}

// Capacity a namespace method contributes to a format_*_info buffer: its
// return type plus each parameter's name and type. format_struct_info and
// format_enum_info size their buffers identically.
priv add_ns_method_capacity := func(d: Declaration, mut cap: USize) {
    if d.default_value.is_none() { return }
    switch d.default_expr().node_type {
    case .FuncDef(fd):
        cap = cap.add(fd.return_type.len()) + 48
        for p : Declaration in fd.params {
            cap = cap.add(p.name.len()).add(p.explicit_type.len()) + 48
        }
    case:
    }
}

priv format_struct_info := func(name: Str, sdef: StructDef) returns Str {
    mut cap : USize = name.len() + 128
    mut cfi : USize = 0
    for f : Declaration in sdef.fields {
        cap = cap.add(sdef.field_name_at(cfi).len()).add(f.explicit_type.len()).add(f.doc.len() * 2) + 128
        cfi = cfi + 1
    }
    mut cni : USize = 0
    for d : Declaration in sdef.ns_decls {
        cap = cap.add(sdef.member_name_at(cni).len()).add(d.doc.len() * 2) + 192
        cni = cni + 1
        add_ns_method_capacity(d, cap)
    }
    cap = cap * 2
    mut out := Str.with_capacity(cap)
    out.push_str("struct ")
    out.push_str(name)
    out.push_str(" {")
    mut ffr : USize = 0
    for f2 : Declaration in sdef.fields {
        out.push_str("\n")
        append_field_indented(out, sdef.field_name_at(ffr), f2)
        ffr = ffr + 1
    }
    if sdef.ns_decls.len() > 0 {
        out.push_str("\nnamespace:")
        mut fnr : USize = 0
        for d2 : Declaration in sdef.ns_decls {
            out.push_str("\n")
            append_ns_method_indented(out, sdef.member_name_at(fnr), d2)
            fnr = fnr + 1
        }
    }
    out.push_str("\n}")
    return out
}

priv format_enum_info := func(name: Str, edef: EnumDef) returns Str {
    mut cap : USize = name.len() + 128
    for v : VariantDef in edef.variants {
        cap = cap.add(v.name.len()).add(v.doc.len() * 2) + 96
    }
    mut eni : USize = 0
    for d : Declaration in edef.ns_decls {
        cap = cap.add(edef.member_name_at(eni).len()).add(d.doc.len() * 2) + 192
        eni = eni + 1
        add_ns_method_capacity(d, cap)
    }
    cap = cap * 2
    mut out := Str.with_capacity(cap)
    out.push_str("enum ")
    out.push_str(name)
    out.push_str(" {")
    for vd : VariantDef in edef.variants {
        out.push_str("\n")
        append_doc_lines_indented(out, vd.doc, "    ")
        out.push_str("    ")
        out.push_str(vd.name)
        if vd.payload_type.len() > 0 {
            out.push_str(": ")
            out.push_str(vd.payload_type)
        }
    }
    if edef.ns_decls.len() > 0 {
        out.push_str("\nnamespace:")
        mut enr : USize = 0
        for d2 : Declaration in edef.ns_decls {
            out.push_str("\n")
            append_ns_method_indented(out, edef.member_name_at(enr), d2)
            enr = enr + 1
        }
    }
    out.push_str("\n}")
    return out
}

// Build the rich info string for a top-level Decl.
format_decl_info := func(stmt: Expr, scope: TypeScope) returns Str {
    switch stmt.node_type {
    case .Decl(dd):
        if stmt.children.len() == 0 {
            return format_var_info(dd.name, dd, scope)
        }
        ref rhs : Expr = stmt.children[0]
        switch rhs.node_type {
        case .StructDef(sdef): return format_struct_info(dd.name, sdef)
        case .EnumDef(edef):   return format_enum_info(dd.name, edef)
        case .FuncDef(fd):     return format_func_info(dd.name, fd)
        case:                          return format_var_info(dd.name, dd, scope)
        }
    case:
        return ""
    }
}

// Append "Type.method" qualified entry for a single namespace method.
priv collect_member_method_packed := func(type_name: Str, dname: Str, d: Declaration, mut info: Str, mut docs: Str) {
    qual := type_name.format(".", dname)
    mut info_cap : USize = qual.len() + 64
    mut is_func := false
    if d.default_value.is_some() {
        switch d.default_expr().node_type {
        case .FuncDef(fd):
            is_func = true
            info_cap = info_cap.add(fd.return_type.len()) + 48
            for p : Declaration in fd.params {
                info_cap = info_cap.add(p.name.len()).add(p.explicit_type.len()) + 48
            }
        case:
        }
    }
    if is_func.not() {
        info_cap = info_cap.add(d.explicit_type.len()) + 8
    }
    mut method_info := Str.with_capacity(info_cap)
    if is_func {
        switch d.default_expr().node_type {
        case .FuncDef(fd):
            method_info.push_str(func_kind(fd.func_type))
            method_info.push_str(" ")
            method_info.push_str(qual)
            append_fn_signature(method_info, fd)
        case:
        }
    } else {
        method_info.push_str("member ")
        method_info.push_str(qual)
        if d.explicit_type.len() > 0 {
            method_info.push_str(" : ")
            method_info.push_str(d.explicit_type)
        }
    }
    append_packed_entry(info, qual, method_info)
    if d.doc.is_empty().not() {
        help_doc := format_doc_for_help(d.doc)
        if help_doc.is_empty().not() {
            append_packed_entry(docs, qual, help_doc)
        }
    }
}

// Register "Type.field" entries for each struct field, plus "Type.method"
// entries for each namespace method.
priv collect_struct_members_packed := func(type_name: Str, sdef: StructDef, mut info: Str, mut docs: Str) {
    mut pfr : USize = 0
    for f : Declaration in sdef.fields {
        ref pf_name : Str = sdef.field_name_at(pfr)
        pfr = pfr + 1
        qual := type_name.format(".", pf_name)
        mut field_info := Str.with_capacity(qual.len().add(f.explicit_type.len()) + 64)
        field_info.push_str("field ")
        append_qualifier_prefix(field_info, f, OwnType.Shallow)
        field_info.push_str(qual)
        if f.explicit_type.len() > 0 {
            field_info.push_str(" : ")
            field_info.push_str(f.explicit_type)
        }
        append_packed_entry(info, qual, field_info)
        if f.doc.is_empty().not() {
            help_doc := format_doc_for_help(f.doc)
            if help_doc.is_empty().not() {
                append_packed_entry(docs, qual, help_doc)
            }
        }
    }
    mut pnr : USize = 0
    for nd : Declaration in sdef.ns_decls {
        collect_member_method_packed(type_name, sdef.member_name_at(pnr), nd, info, docs)
        pnr = pnr + 1
    }
}

// Register "Type.Variant" entries for each enum variant, plus
// "Type.method" entries for each namespace method.
priv collect_enum_members_packed := func(type_name: Str, edef: EnumDef, mut info: Str, mut docs: Str) {
    for vd : VariantDef in edef.variants {
        qual := type_name.format(".", vd.name)
        mut variant_info := Str.with_capacity(qual.len() + 64)
        variant_info.push_str("variant ")
        variant_info.push_str(qual)
        if vd.payload_type.len() > 0 {
            variant_info.push_str(": ")
            variant_info.push_str(vd.payload_type)
        }
        append_packed_entry(info, qual, variant_info)
        if vd.doc.is_empty().not() {
            help_doc := format_doc_for_help(vd.doc)
            if help_doc.is_empty().not() {
                append_packed_entry(docs, qual, help_doc)
            }
        }
    }
    mut pnr2 : USize = 0
    for nd : Declaration in edef.ns_decls {
        collect_member_method_packed(type_name, edef.member_name_at(pnr2), nd, info, docs)
        pnr2 = pnr2 + 1
    }
}

// Walk a Body's top-level Decls. For each Decl append (name, info) into
// `info` and (name, doc) into `docs` if Declaration.doc is non-empty.
// Struct/enum members are also registered under qualified names.
collect_decl_packed := func(body: Expr, scope: TypeScope, mut info: Str, mut docs: Str) {
    for stmt : Expr in body.children {
        switch stmt.node_type {
        case .Decl(dd):
            entry_info := format_decl_info(stmt, scope)
            if entry_info.is_empty().not() {
                append_packed_entry(info, dd.name, entry_info)
            }
            if dd.doc.is_empty().not() {
                help_doc := format_doc_for_help(dd.doc)
                if help_doc.is_empty().not() {
                    append_packed_entry(docs, dd.name, help_doc)
                }
            }
            if stmt.children.len() > 0 {
                switch stmt.children[0].node_type {
                case .StructDef(sdef):
                    collect_struct_members_packed(dd.name, sdef, info, docs)
                case .EnumDef(edef):
                    collect_enum_members_packed(dd.name, edef, info, docs)
                case:
                }
            }
        case:
        }
    }
}

// Wrap pre-built packed info/docs blobs into a __doc_init__("...","...")
// source line. Returns "" if both blobs are empty.
build_doc_init_line := func(packed_info: Str, packed_docs: Str) returns Str {
    if packed_info.is_empty().and(packed_docs.is_empty()) { return "" }
    esc_info := escape_doc_for_literal_str(packed_info)
    esc_docs := escape_doc_for_literal_str(packed_docs)
    return format("__doc_init__(\"", esc_info, "\", \"", esc_docs, "\")\n")
}

build_doc_init_line_org_files := func(index_path: Str, packed_user_info: Str, packed_user_docs: Str) returns Str {
    esc_index_path := escape_doc_for_literal_str(index_path)
    esc_user_info := escape_doc_for_literal_str(packed_user_info)
    esc_user_docs := escape_doc_for_literal_str(packed_user_docs)
    return format("doc_init_org_files(\"", esc_index_path, "\", \"", esc_user_info, "\", \"", esc_user_docs, "\")\n")
}

// Run init/typecheck/constfolder/scavenge on the loaded program. Sets
// lp.run_tests and exits with code 1 if the typer reports any errors.
// Run init + typer + field-struct resolution. Stops short of constfolder and
// scavenge so callers that only need a typed AST (e.g. `til doc`) don't pay
// the codegen-prep cost.
// Namespace import decl form: `name := import("x")` makes `name` a
// QUALIFIED ALIAS for x's public top-level decls -- every `name.sym`
// use in the importing unit is rewritten (rewrite_ns_alias_uses) into a
// direct reference to the original `sym`, and the decl itself is
// dropped. The previous implementation instead synthesized a local ns
// struct holding CLONES of every pub decl; the clones were typed in the
// IMPORTING file, so a pub decl whose body referenced a priv sibling of
// its own file broke (priv names are file-keyed), and every alias
// duplicated the imported bodies in the binary. With an explicit symbol
// list (`name := import("x", a, b)`) only the listed symbols are
// rewritable; each listed symbol is validated to exist in x.
priv desugar_one_import := func(mut imp_stmt: Expr, decl_name: Str, ctx: Context, resolved_path: Str, mut ns_alias_names: Set(Str), mut ns_alias_members: Set(Str), mut ns_alias_paths: Map(Str, Str)) returns Bool {
    mut handled := false
    if imp_stmt.children.len() >= 1 {
        switch imp_stmt.children[0].node_type {
        case .Ident(id):
            if id.ident_name() == "import" {
                if imp_stmt.children.len() > 1 {
                    mut path := ""
                    switch imp_stmt.children[1].node_type {
                    case .Literal(Literal.Str(p)):
                        path = format(p, ".til")
                    case:
                    }

                    if path.len() > 0 {
                        mut exp_symbols := Vec(Str).new()
                        if imp_stmt.children.len() > 2 {
                            for arg_i in 2..imp_stmt.children.len() {
                                switch imp_stmt.children[arg_i].node_type {
                                case .Ident(sym_id):
                                    exp_symbols.push(own Str.clone(sym_id.ident_name()))
                                case:
                                }
                            }
                        } else {
                            if ctx.imported.has(resolved_path) {
                                ref iu : ImportUnit = ctx.imported[resolved_path]
                                for child : Expr in iu.ast.children {
                                    if child.node_type.is(NodeType.Decl) {
                                        switch child.node_type {
                                        case .Decl(dd):
                                            if dd.is_priv.not() {
                                                exp_symbols.push(own dd.name.clone())
                                            }
                                        case:
                                        }
                                    }
                                }
                            }
                        }

                        handled = true
                        if ctx.imported.has(resolved_path) {
                            ref iu : ImportUnit = ctx.imported[resolved_path]
                            for sym : Str in exp_symbols {
                                mut found := false
                                for dd : Expr in iu.ast.children {
                                    switch dd.node_type {
                                    case .Decl(cd):
                                        if cd.name == sym { found = true }
                                    case:
                                    }
                                    if found { break }
                                }
                                if found.not() {
                                    imp_stmt.error(resolved_path, format("symbol '", sym, "' not found in '", resolved_path, "'"))
                                    return false
                                }
                                // Members keyed "alias|member" (til's
                                // parser rejects nested generics like
                                // Map(Str, Set(Str)) in param types).
                                ns_alias_members.add(own format(decl_name, "|", sym))
                            }
                        }
                        ns_alias_names.add(own decl_name.clone())
                        ns_alias_paths.set(decl_name, own resolved_path.clone())
                    }
                }
            }
        case:
        }
    }
    return handled
}

// Collect the binder names a switch-case pattern introduces for its
// body: the plain-Ident payload args of (possibly nested) FCall
// patterns, e.g. `p` in `case NodeType.Literal(Literal.Str(p)):`.
priv collect_case_pattern_binders := func(pat: Expr, mut out: Set(Str)) {
    if pat.node_type.is(NodeType.FCall).not() { return }
    for ai in 1..pat.children.len() {
        ref a : Expr = pat.children[ai]
        switch a.node_type {
        case .Ident(bid):
            out.add(own Str.clone(bid.ident_name()))
        case .FCall:
            collect_case_pattern_binders(a, out)
        case:
        }
    }
}

// Rewrite-or-recurse for one child slot: if it is an `alias.sym`
// FieldAccess whose base names a (non-shadowed) namespace-import alias,
// replace it with a direct `sym` Ident; a member outside the alias's
// public set is a load-time error (same stage as the selective-import
// symbol-not-found error). Anything else recurses.
priv ns_alias_rewrite_child := proc(mut e: Expr, i: USize, alias_names: Set(Str), alias_members: Set(Str), alias_paths: Map(Str, Str), path: Str, shadowed: Set(Str), mut ctx: Context) {
    ref mut c : Expr = e.children[i]
    mut alias_name := ""
    mut member := ""
    switch c.node_type {
    case .FieldAccess(fan):
        if c.children.len() > 0 {
            switch c.children[0].node_type {
            case .Ident(base_id):
                if alias_names.has(base_id.ident_name()).and(shadowed.has(base_id.ident_name()).not()) {
                    alias_name = Str.clone(base_id.ident_name())
                    member = Str.clone(fan.field_access_name())
                }
            case:
            }
        }
    case:
    }
    if alias_name.len() > 0 {
        if alias_members.has(format(alias_name, "|", member)).not() {
            // A member the alias does not export is ordinary user error: a
            // typo is enough, and the REPL's auto-echo reaches it just by
            // echoing the alias (`sys` wraps to `sys.to_str`). This used to
            // panic, which ended the process -- and with it the whole REPL
            // session. Report it like any other type error and leave the node
            // alone; type_program_errors returns before the initer walks it.
            type_error_at(path, c.line, c.col,
                format("no public symbol '", member, "' in namespace import '",
                    alias_name, "' of '", alias_paths[alias_name], "'"), ctx)
            return
        }
        mut idn := Expr.new(ident_node(member), c.line, c.col)
        // Vec.set deep-deletes the replaced FieldAccess subtree.
        e.children[i] = idn
    } else {
        rewrite_ns_alias_uses(c, alias_names, alias_members, alias_paths, path, shadowed, ctx)
    }
}

// Rewrite every `alias.sym` FieldAccess whose base is a namespace-import
// alias into a direct `sym` reference. Walks ns_decls / field defaults /
// param defaults explicitly since those Exprs live outside e.children.
// `shadowed` tracks names rebound by an enclosing binder -- function
// params/captures, body locals (from their decl point onward), for-in
// loop vars, switch-case payload binders, and catch vars -- so a local
// that shadows the alias name is left alone.
priv rewrite_ns_alias_uses := proc(mut e: Expr, alias_names: Set(Str), alias_members: Set(Str), alias_paths: Map(Str, Str), path: Str, shadowed: Set(Str), mut ctx: Context) {
    switch e.node_type {
    case .StructDef(sdd):
        for mut fd : Declaration in sdd.fields {
            if fd.default_value.is_some() {
                rewrite_ns_alias_uses(fd.default_expr(), alias_names, alias_members, alias_paths, path, shadowed, ctx)
            }
        }
        for mut nd : Declaration in sdd.ns_decls {
            if nd.default_value.is_some() {
                rewrite_ns_alias_uses(nd.default_expr(), alias_names, alias_members, alias_paths, path, shadowed, ctx)
            }
        }
        return
    case .EnumDef(edd):
        for mut nd2 : Declaration in edd.ns_decls {
            if nd2.default_value.is_some() {
                rewrite_ns_alias_uses(nd2.default_expr(), alias_names, alias_members, alias_paths, path, shadowed, ctx)
            }
        }
        return
    case .FuncDef(fdd):
        for mut pd : Declaration in fdd.params {
            if pd.default_value.is_some() {
                rewrite_ns_alias_uses(pd.default_expr(), alias_names, alias_members, alias_paths, path, shadowed, ctx)
            }
        }
        mut fn_shadow := shadowed.clone()
        for pd2 : Declaration in fdd.params {
            fn_shadow.add(own pd2.name.clone())
        }
        for cap : Declaration in fdd.captures {
            fn_shadow.add(own cap.name.clone())
        }
        for fi in 0..e.children.len() {
            ns_alias_rewrite_child(e, fi, alias_names, alias_members, alias_paths, path, fn_shadow, ctx)
        }
        return
    case .Body:
        // Locals shadow from their decl point onward, so extend the set
        // AFTER each Decl child is walked (its RHS still sees the alias).
        mut body_shadow := shadowed.clone()
        for bi in 0..e.children.len() {
            ns_alias_rewrite_child(e, bi, alias_names, alias_members, alias_paths, path, body_shadow, ctx)
            switch e.children[bi].node_type {
            case .Decl(bd):
                body_shadow.add(own bd.name.clone())
            case:
            }
        }
        return
    case .ForIn(fid):
        if e.children.len() >= 2 {
            ns_alias_rewrite_child(e, 0, alias_names, alias_members, alias_paths, path, shadowed, ctx)
            mut loop_shadow := shadowed.clone()
            loop_shadow.add(own fid.name.clone())
            if fid.name2.len() > 0 { loop_shadow.add(own fid.name2.clone()) }
            ns_alias_rewrite_child(e, 1, alias_names, alias_members, alias_paths, path, loop_shadow, ctx)
            return
        }
    case .Case:
        // [pattern x N, body]: payload binders in the patterns shadow the
        // body. Guarded cases keep falling through to the generic recursion
        // below, exactly as they did before #334's pattern lists.
        if case_has_guard(e).not().and(case_pattern_count(e).gte(1)) {
            pc := case_pattern_count(e)
            mut case_shadow := shadowed.clone()
            for pi in 0..pc {
                ns_alias_rewrite_child(e, pi, alias_names, alias_members, alias_paths, path, shadowed, ctx)
                collect_case_pattern_binders(e.children[pi], case_shadow)
            }
            ns_alias_rewrite_child(e, pc, alias_names, alias_members, alias_paths, path, case_shadow, ctx)
            return
        }
    case .Catch:
        // [var Ident, type Ident, body]: the err var shadows the body.
        if e.children.len() >= 3 {
            mut catch_shadow := shadowed.clone()
            switch e.children[0].node_type {
            case .Ident(cvid):
                catch_shadow.add(own Str.clone(cvid.ident_name()))
            case:
            }
            ns_alias_rewrite_child(e, 2, alias_names, alias_members, alias_paths, path, catch_shadow, ctx)
            return
        }
    case:
    }
    for i in 0..e.children.len() {
        ns_alias_rewrite_child(e, i, alias_names, alias_members, alias_paths, path, shadowed, ctx)
    }
}

// An `import("path")` call: callee named `import`, first argument a string
// literal. The two callers differ only in where the call sits -- as a Decl's
// RHS or as a bare statement -- so both hand the call here.
priv is_valid_import_call := func(imp_stmt_ref: Expr) returns Bool {
    if imp_stmt_ref.children.len() < 2 { return false }
    switch imp_stmt_ref.children[0].node_type {
    case .Ident(id):
        if id.ident_name() == "import" {
            switch imp_stmt_ref.children[1].node_type {
            case .Literal(Literal.Str(_p)):
                return true
            case:
            }
        }
    case:
    }
    return false
}

priv desugar_namespace_imports := proc(path: Str, mut iu: ImportUnit, mut ctx: Context) {
    mut old := iu.ast.children.take()
    mut new_ch := Vec(Expr).new()
    mut imp_idx : USize = 0
    mut ns_alias_names := Set(Str).new()
    mut ns_alias_members := Set(Str).new()
    mut ns_alias_paths := Map(Str, Str).new()

    for i in 0..old.len() {
        ref mut stmt : Expr = old[i]

        mut is_imp := false
        mut is_decl_rhs := false
        mut decl_name := ""

        if stmt.node_type.is(NodeType.FCall) {
            is_imp = true
        } else if stmt.node_type.is(NodeType.Decl).and(stmt.children.len().gt(0)) {
            if stmt.children[0].node_type.is(NodeType.FCall) {
                is_imp = true
                is_decl_rhs = true
                switch stmt.node_type {
                case .Decl(dd):
                    decl_name = dd.name.clone()
                case:
                }
            }
        }

        mut handled := false
        if is_imp {
            mut is_valid_import := false
            if is_decl_rhs { is_valid_import = is_valid_import_call(stmt.children[0]) }
            else { is_valid_import = is_valid_import_call(stmt) }

            if is_valid_import {
                mut resolved := ""
                if imp_idx < iu.imports.len() {
                    resolved = iu.imports[imp_idx].clone()
                }
                imp_idx++
                if is_decl_rhs.and(decl_name.starts_with("_")) {
                    // #154: `_name := import(...)` is the unused-import
                    // opt-out. The alias is deliberately never read, so
                    // no rewrite map entry is needed. The file itself
                    // stays loaded (the loader resolved it already); only
                    // the decl is dropped.
                    handled = true
                } else if is_decl_rhs {
                    handled = desugar_one_import(stmt.children[0], decl_name, ctx, resolved, ns_alias_names, ns_alias_members, ns_alias_paths)
                }
                // Bare import stmts are kept as-is; the loader already
                // resolved them and the typer walks them for recursion.
            }
        }

        if handled.not() {
            new_ch.push_take(old, i)
        }
    }

    // Second pass: rewrite `alias.sym` uses in the kept statements into
    // direct references to the original decls.
    if ns_alias_names.len() > 0 {
        no_shadows := Set(Str).new()
        for j in 0..new_ch.len() {
            rewrite_ns_alias_uses(new_ch[j], ns_alias_names, ns_alias_members, ns_alias_paths, path, no_shadows, ctx)
        }
    }

    iu.ast.children.move_from(own new_ch)
}

// Issue #262: lazy_func / lazy_proc inlining.
//
// A lazy callable's body is a single `return <expr>`. A call f(a1..an), or
// UFCS-style a1.f(a2..an), is rewritten here -- before type-checking -- by
// cloning <expr> and substituting each parameter Ident with the matching
// argument expression (call-by-name). When <expr> is a `match` (the
// short-circuit form), only the taken arm is evaluated at run time, so unused
// arguments never run.
// The lazy defs themselves are left in place: the typer checks them and
// (being uncalled after inlining) they emit as ordinary dead functions,
// exactly like macros.
//
// Scope: top-level lazy callables, called by bare name or UFCS method
// syntax, non-recursive. Fixed-arity calls inline directly; a binary lazy
// callable (and/or) called with more than two args right-folds into nested
// binary calls first (Lisp-style N-ary and/or). Declared-variadic, first-
// class, and recursive lazy callables are deferred (issue #262). A call that
// does not match a supported shape is left un-inlined and types as an
// ordinary (eager) call.

priv lazy_substitute_idents := func(mut e: Expr, subs: Map(Str, Expr)) {
    for i in 0..e.children.len() {
        ref mut c : Expr = e.children[i]
        mut replaced := false
        switch c.node_type {
        case .Ident(idn):
            ref nm : Str = idn.ident_name()
            if subs.has(nm) {
                // Substitute through the parent slot: Vec.set deep-deletes
                // the old Ident (issue #272; replaces Expr.replace_with).
                ref repl : Expr = subs[nm]
                e.children[i] = repl.clone()
                replaced = true
            }
        case:
        }
        if replaced.not() { lazy_substitute_idents(c, subs) }
    }
}

// The value of a single-`return` body `{ return <expr> }`, else None.
priv lazy_single_return_value := func(body: Expr) returns Option(Expr) {
    if body.node_type.is(NodeType.Body).not() { return Option(Expr).None }
    if body.children.len().eq(1).not() { return Option(Expr).None }
    ref ret : Expr = body.children[0]
    if ret.node_type.is(NodeType.Return).not() { return Option(Expr).None }
    if ret.children.len() < 1 { return Option(Expr).None }
    return Option(Expr).Some(ret.children[0].clone())
}

// Build `match cond { case true: x case: y }`. Takes ownership of cond/x/y.
priv lazy_make_bool_match := func(own cond: Expr, own x: Expr, own y: Expr, line: U32, col: U32) returns Expr {
    mut m := Expr.new(NodeType.Match(MatchData()), line, col)
    m.add_child(own cond)                                    // subject
    // case true: x
    mut c1 := Expr.new(NodeType.Case(CaseData()), line, col)
    c1.add_child(own Expr.new(NodeType.Literal(Literal.Bool(true)), line, col))
    mut b1 := Expr.new(NodeType.Body, line, col)
    b1.add_child(own x)
    c1.add_child(own b1)
    m.add_child(own c1)
    // case: y  (default arm catches false)
    mut c2 := Expr.new(NodeType.Case(CaseData(pattern_count = 0)), line, col)
    mut b2 := Expr.new(NodeType.Body, line, col)
    b2.add_child(own y)
    c2.add_child(own b2)
    m.add_child(own c2)
    return m
}

// Fold a guard chain `if c_i { return X_i } ... return Y` into nested matches,
// from guard i to the trailing return at n-1. Recursive so no loop-carried
// ownership transfer is needed.
priv lazy_build_guard_chain := func(body: Expr, i: USize, n: USize) returns Expr {
    if i.eq(n - 1) {
        // the trailing `return Y`
        return body.children[n - 1].children[0].clone()
    }
    ref g : Expr = body.children[i]               // `if cond { return X }`
    // A guard is `if cond { return X }` by construction (lazy_body_inlinable
    // vetted the shape), so take() panicking on None is the right contract.
    gx_o := lazy_single_return_value(g.children[1])
    inner := lazy_build_guard_chain(body, i + 1, n)
    return lazy_make_bool_match(own g.children[0].clone(), own Option(Expr).take(own gx_o), own inner, g.line, g.col)
}

// The expression a lazy body inlines to, freshly owned, or NULL when the body
// shape is not inlinable. Mirrors lazy_body_inlinable (src/self/context.til):
//   { return <expr> }                          -> <expr>
//   { if cond { return X } else { return Y } }  -> match cond { true: X : Y }
//   { if c1 {return X1} ... if ck {return Xk} return Y }  -> nested match
// The if/else and guard-chain forms become `match` so they inline and
// short-circuit (til's `if` is a statement, not a value-expression). Other
// shapes (locals, loops, ...) return None; those need the thunk fallback.
priv lazy_body_as_expr := func(body: Expr) returns Option(Expr) {
    if lazy_body_inlinable(body).not() { return Option(Expr).None }
    n := body.children.len()
    ref last : Expr = body.children[n - 1]
    if n.eq(1) {
        switch last.node_type {
        case .Return:
            return Option(Expr).Some(last.children[0].clone())
        case .If:
            // Both arms are single-return bodies here for the same reason as
            // in lazy_build_guard_chain: lazy_body_inlinable vetted the shape.
            x_o := lazy_single_return_value(last.children[1])
            y_o := lazy_single_return_value(last.children[2])
            return Option(Expr).Some(lazy_make_bool_match(own last.children[0].clone(), own Option(Expr).take(own x_o), own Option(Expr).take(own y_o), last.line, last.col))
        case:
            return Option(Expr).None
        }
    }
    return Option(Expr).Some(lazy_build_guard_chain(body, 0, n))
}

// Returns true if the call was inlined. Leaves `call` untouched (and
// returns false) for any shape v1 does not handle, so the residual call
// types as an ordinary eager call.
priv inline_lazy_call := func(mut parent: Expr, call_idx: USize, fdef: Expr) returns Bool {
    ref call : Expr = parent.children[call_idx]
    if fdef.children.len() == 0 { return false }
    ref body : Expr = fdef.children[0]

    mut subs := Map(Str, Expr).new()
    mut ok := false
    mut is_method_call := false
    ref call_callee : Expr = call.children[0]
    switch call_callee.node_type {
    case .FieldAccess:
        is_method_call = call_callee.children.len() == 1
    case:
    }
    switch fdef.node_type {
    case .FuncDef(fd):
        if fd.variadic_index < 0 {
            mut nargs := call.children.len() - 1
            if is_method_call { nargs = call.children.len() }
            if nargs == fd.params.len() {
                for j in 0..fd.params.len() {
                    ref param : Declaration = fd.params[j]
                    if is_method_call.and(j.eq(0)) {
                        subs.set(param.name, own call_callee.children[0].clone())
                    } else {
                        mut arg_idx := j + 1
                        if is_method_call { arg_idx = j }
                        subs.set(param.name, own call.children[arg_idx].clone())
                    }
                }
                ok = true
            }
        }
    case:
    }
    if ok.not() { return false }

    mut cloned_o := lazy_body_as_expr(body)
    if cloned_o.is_none() { return false }
    mut cloned := Option(Expr).take(own cloned_o)
    // A bare-Ident body (`return x`) is the whole expression: the walk
    // below only substitutes CHILDREN, so swap the root here. Plain
    // assignment reclaims the first clone (save_old_delete).
    mut root_name := ""
    switch cloned.node_type {
    case .Ident(root_idn): root_name = Str.clone(root_idn.ident_name())
    case:
    }
    if root_name.len().gt(0).and(subs.has(root_name)) {
        cloned = subs[root_name].clone()
    } else {
        lazy_substitute_idents(cloned, subs)
    }
    parent.children[call_idx] = cloned
    return true
}

// Clone the k-th effective argument of a (possibly UFCS) call. For a method
// call the receiver is effective arg 0 and the explicit args follow; for a
// bare call the explicit args are the effective args.
priv lazy_eff_arg_clone := func(call: Expr, is_method: Bool, k: USize) returns Expr {
    if is_method {
        if k == 0 { return call.children[0].children[0].clone() }
        return call.children[k].clone()
    }
    return call.children[k + 1].clone()
}

// Substitution map for one unrolled statement of a variadic lazy call: the
// fixed params (before the variadic) map to their call-site argument
// expressions, and -- when `loop_var` is non-empty -- the loop variable maps
// to effective operand `k`. Built fresh per statement from the call, so each
// spliced expression is an independent clone and a single substitution pass
// suffices (no second walk that could capture names inside spliced operands).
priv lazy_variadic_subs := func(call: Expr, is_method: Bool, fdef: Expr,
        nfixed: USize, loop_var: Str, k: USize) returns Map(Str, Expr) {
    mut subs := Map(Str, Expr).new()
    switch fdef.node_type {
    case .FuncDef(fd):
        for j in 0..nfixed {
            ref param : Declaration = fd.params[j]
            subs.set(param.name, own lazy_eff_arg_clone(call, is_method, j))
        }
    case:
    }
    if loop_var.len() > 0 {
        subs.set(loop_var, own lazy_eff_arg_clone(call, is_method, k))
    }
    return subs
}

// Issue #262: genuinely-variadic lazy callables (vand/vor). A lazy def with a
// trailing variadic param whose body passes lazy_variadic_body_unrollable
// (src/self/context.til: the param is consumed only by `for <v> in xs { <guards> }`
// loops) is unrolled at each call site over the compile-time-known operand
// list: every such loop becomes its guard statements repeated once per
// operand with <v> substituted by the operand expression (call-by-name), and
// the resulting guard chain is spliced as nested short-circuit matches via
// lazy_body_as_expr -- exactly like any other inlinable lazy body. A later
// operand is therefore evaluated only if every earlier guard fell through.
// Zero runtime cost: no thunks, and no operand collection is ever built.
// Returns true if the call was replaced; false leaves it untouched (e.g. too
// few fixed args), where the residual call fails arity checking in the typer.
priv inline_variadic_lazy_call := func(mut parent: Expr, call_idx: USize, fdef: Expr) returns Bool {
    ref call : Expr = parent.children[call_idx]
    if fdef.children.len() == 0 { return false }
    ref body : Expr = fdef.children[0]

    mut vidx : I32 = -1
    mut nparams : USize = 0
    mut vname := ""
    switch fdef.node_type {
    case .FuncDef(fd):
        if fd.kwargs_index >= 0 { return false }
        vidx = fd.variadic_index
        nparams = fd.params.len()
        if vidx >= 0 { vname = fd.params[vidx.to_usize()].name.clone() }
    case:
        return false
    }
    if vidx < 0 { return false }
    if vidx.to_usize() != nparams - 1 { return false }   // variadic must be last
    if lazy_variadic_body_unrollable(body, vname).not() { return false }

    mut is_method := false
    ref call_callee : Expr = call.children[0]
    switch call_callee.node_type {
    case .FieldAccess:
        is_method = call_callee.children.len() == 1
    case:
    }
    mut eff_count : USize = call.children.len() - 1
    if is_method { eff_count = call.children.len() }
    nfixed := nparams - 1
    if eff_count < nfixed { return false }

    // Unroll: each `for <v> in <vname>` loop becomes its guards once per
    // operand; other statements (guards, the final return) pass through.
    // All substitution happens here, per cloned statement, so lazy_body_as_expr
    // gets a fully-substituted guard chain and no further walk is needed.
    mut unrolled := Expr.new(NodeType.Body, call.line, call.col)
    for si in 0..body.children.len() {
        ref stmt : Expr = body.children[si]
        mut handled := false
        switch stmt.node_type {
        case .ForIn(fid):
            for k in nfixed..eff_count {
                opnd_subs := lazy_variadic_subs(call, is_method, fdef, nfixed, fid.name, k)
                for gj in 0..stmt.children[1].children.len() {
                    mut guard := stmt.children[1].children[gj].clone()
                    lazy_substitute_idents(guard, opnd_subs)
                    unrolled.add_child(own guard)
                }
            }
            handled = true
        case:
        }
        if handled.not() {
            fixed_subs := lazy_variadic_subs(call, is_method, fdef, nfixed, "", 0)
            mut cst := stmt.clone()
            lazy_substitute_idents(cst, fixed_subs)
            unrolled.add_child(own cst)
        }
    }

    cloned_o := lazy_body_as_expr(unrolled)
    expect(cloned_o.is_some(),
        "variadic lazy unroll produced a non-inlinable body despite lazy_variadic_body_unrollable")
    parent.children[call_idx] = Option(Expr).take(own cloned_o)
    return true
}

// Issue #262: the RECURSIVE (Haskell-style) form of a variadic lazy callable.
// GHC's Prelude defines `and (x:xs) = x && and xs`; til's equivalent is
//   vand := lazy_func(xs: ..Bool) returns Bool {
//       return match xs {
//       case []:        true
//       case [x, ..tl]: match x { case true: and(..tl) case: false }
//       }
//   }
// The body is a single `return match <xs> { ... }` with exactly two arms: an
// empty-list-pattern base case and a head/tail cons case whose value contains
// exactly one recursive tail call `self(..tl)` (an is_splat FCall of the tail
// ident). Each call site is unrolled bottom-up over its compile-time-known
// operands: expand(k) = base-arm value at k == N, else the cons-arm value with
// head -> operand k and the tail call replaced by expand(k+1). Call-by-name,
// zero runtime cost, and the author -- not the compiler -- defines the fold
// shape and base case, so nothing assumes associativity.

// Count value-uses of identifier `name` in `e` (Ident reads + Assign targets).
priv lazy_count_ident_uses := func(e: Expr, name: Str) returns USize {
    mut n : USize = 0
    switch e.node_type {
    case .Ident(idd):  if idd.ident_name() == name { n = n.add(1) }
    case .Assign(ad):  if ad.name == name { n = n.add(1) }
    case:
    }
    for c : Expr in e.children {
        n = n.add(lazy_count_ident_uses(c, name))
    }
    return n
}

// True if `e` is a recursive tail splat call `<callee>(..tail_name)`: an
// is_splat FCall with exactly one argument, the bare Ident `tail_name`.
priv lazy_is_tail_splat_call := func(e: Expr, tail_name: Str) returns Bool {
    switch e.node_type {
    case .FCall(fcd):
        if fcd.is_splat.not() { return false }
        if e.children.len() != 2 { return false }
        switch e.children[1].node_type {
        case .Ident(arg_id): return arg_id.ident_name() == tail_name
        case: return false
        }
    case: return false
    }
}

priv lazy_count_tail_splat_calls := func(e: Expr, tail_name: Str) returns USize {
    mut n : USize = 0
    if lazy_is_tail_splat_call(e, tail_name) { n = 1 }
    for c : Expr in e.children {
        n = n.add(lazy_count_tail_splat_calls(c, tail_name))
    }
    return n
}

// The Match node of a recursive variadic lazy body `{ return match <vname>
// { ... } }`, or NULL when the body does not have that outer shape.
priv lazy_recursive_body_match := func(body: Expr, vname: Str) returns Option(ref Expr) {
    if body.node_type.is(NodeType.Body).not() { return Option(ref Expr).None }
    if body.children.len() != 1 { return Option(ref Expr).None }
    ref ret : Expr = body.children[0]
    if ret.node_type.is(NodeType.Return).not().or(ret.children.len() != 1) { return Option(ref Expr).None }
    ref m : Expr = ret.children[0]
    if m.node_type.is(NodeType.Match).not() { return Option(ref Expr).None }
    if m.children.len() != 3 { return Option(ref Expr).None }   // scrutinee + exactly 2 cases
    switch m.children[0].node_type {
    case .Ident(scrn):
        if scrn.ident_name().eq(vname).not() { return Option(ref Expr).None }
    case: return Option(ref Expr).None
    }
    return Option(ref Expr).Some(m)
}

// The Case child of `m` whose pattern is a ListPattern with `arity` children
// (0 = the `[]` base case, 2 = the `[h, ..t]` cons case), or NULL. A guard
// (3-child Case) disqualifies the arm, as does an arm body that is not the
// parser's single-value Body wrapper (match arms parse as [pattern,
// Body(value)] -- see parse_case_head's caller in parse_primary).
priv lazy_recursive_arm := func(m: Expr, arity: USize) returns Option(ref Expr) {
    for i in 1..m.children.len() {
        ref cs : Expr = m.children[i]
        if cs.node_type.is(NodeType.Case).not() { continue }
        if cs.children.len() != 2 { continue }
        ref pat : Expr = cs.children[0]
        if pat.node_type.is(NodeType.ListPattern).and(pat.children.len().eq(arity)) {
            ref ab : Expr = cs.children[1]
            if ab.node_type.is(NodeType.Body).and(ab.children.len().eq(1)) {
                return Option(ref Expr).Some(cs)
            }
        }
    }
    return Option(ref Expr).None
}

// The value expression of a recursive arm: unwrap the parser's single-value
// Body wrapper (splicing the Body itself would put a statement list in
// expression position).
priv lazy_recursive_arm_value := func(arm: Expr) returns ref Expr {
    return arm.children[1].children[0]
}

// The Switch node of the STATEMENT (if/else) recursive form `{ switch <vname>
// { ... } }`, or NULL. Same []/[h, ..t] discrimination as the match form, but
// the arms are statement bodies (guards + returns) instead of single value
// expressions -- the til-native if/else spelling, since `if` is a statement:
//   switch xs {
//   case []: return true
//   case [x, ..tl]:
//       if x.not() { return false }
//       return and(..tl)
//   }
priv lazy_recursive_body_switch := func(body: Expr, vname: Str) returns Option(ref Expr) {
    if body.node_type.is(NodeType.Body).not() { return Option(ref Expr).None }
    if body.children.len() != 1 { return Option(ref Expr).None }
    ref sw : Expr = body.children[0]
    if sw.node_type.is(NodeType.Switch).not() { return Option(ref Expr).None }
    if sw.children.len() != 3 { return Option(ref Expr).None }   // scrutinee + exactly 2 cases
    switch sw.children[0].node_type {
    case .Ident(scrn):
        if scrn.ident_name().eq(vname).not() { return Option(ref Expr).None }
    case: return Option(ref Expr).None
    }
    return Option(ref Expr).Some(sw)
}

// The Case child of switch `sw` whose pattern is a ListPattern with `arity`
// children. Unlike the match form, the arm body is a statement list: the base
// arm must be a single `return <expr>` and the cons arm an inlinable guard
// chain -- both enforced by the callers.
priv lazy_recursive_switch_arm := func(sw: Expr, arity: USize) returns Option(ref Expr) {
    for i in 1..sw.children.len() {
        ref cs : Expr = sw.children[i]
        if cs.node_type.is(NodeType.Case).not() { continue }
        if cs.children.len() != 2 { continue }
        ref pat : Expr = cs.children[0]
        if pat.node_type.is(NodeType.ListPattern).and(pat.children.len().eq(arity)) {
            if cs.children[1].node_type.is(NodeType.Body) { return Option(ref Expr).Some(cs) }
        }
    }
    return Option(ref Expr).None
}

// The single `return <expr>` value of a switch-form base arm, else NULL.
priv lazy_recursive_switch_base_value := func(arm: Expr) returns Option(ref Expr) {
    ref b : Expr = arm.children[1]
    if b.children.len() != 1 { return Option(ref Expr).None }
    ref ret : Expr = b.children[0]
    if ret.node_type.is(NodeType.Return).not().or(ret.children.len() != 1) { return Option(ref Expr).None }
    ref bv : Expr = ret.children[0]
    return Option(ref Expr).Some(bv)
}

// Shared head/tail + hygiene rules for both recursive forms: distinct
// head/tail names (also distinct from the variadic and any fixed param), the
// base value mentions none of them, and the cons region never mentions the
// variadic and uses the tail EXACTLY once -- as the single recursive tail
// splat call `self(..tail)`.
priv lazy_recursive_hygiene_ok := func(cons_pat: Expr, vname: Str,
        fixed_names: Vec(Str), base_val: Expr, cons_region: Expr) returns Bool {
    mut head := ""
    mut tail := ""
    switch cons_pat.children[0].node_type {
    case .Ident(hn): head = Str.clone(hn.ident_name())
    case: return false
    }
    switch cons_pat.children[1].node_type {
    case .Ident(tn): tail = Str.clone(tn.ident_name())
    case: return false
    }
    if head.eq(tail).or(head.eq(vname)).or(tail.eq(vname)) { return false }
    for fx : Str in fixed_names {
        if fx.eq(head).or(fx.eq(tail)) { return false }
    }
    if lazy_count_ident_uses(base_val, vname).gt(0) { return false }
    if lazy_count_ident_uses(base_val, head).gt(0) { return false }
    if lazy_count_ident_uses(base_val, tail).gt(0) { return false }
    if lazy_count_ident_uses(cons_region, vname).gt(0) { return false }
    if lazy_count_ident_uses(cons_region, tail) != 1 { return false }
    if lazy_count_tail_splat_calls(cons_region, tail) != 1 { return false }
    return true
}

// Issue #262: shape check for the recursive variadic lazy form, shared by the
// typer (def-site acceptance + body-typing skip: the ListPattern arms cannot
// type as ordinary code), the builder (emission skip: the def is fully
// consumed at compile time), and the loader's unroll. Requirements beyond the
// outer shape: distinct head/tail names (both distinct from the variadic
// param and any fixed param), the base arm mentions neither the variadic nor
// head/tail, and the cons arm uses the tail EXACTLY once -- as the one
// recursive tail splat call `self(..tail)`.
lazy_recursive_variadic_def := func(fdef: Expr) returns Bool {
    if fdef.node_type.is(NodeType.FuncDef).not() { return false }
    if fdef.children.len() == 0 { return false }
    mut vname := ""
    mut fixed_names := Vec(Str).new()
    switch fdef.node_type {
    case .FuncDef(fd):
        if fd.func_type.is_lazy().not() { return false }
        if fd.kwargs_index >= 0 { return false }
        if fd.variadic_index < 0 { return false }
        if fd.variadic_index.to_usize() != fd.params.len() - 1 { return false }
        vname = fd.params[fd.variadic_index.to_usize()].name.clone()
        for j in 0..fd.params.len() - 1 { fixed_names.push(own fd.params[j].name.clone()) }
    case: return false
    }
    m_o := lazy_recursive_body_match(fdef.children[0], vname)
    if m_o.is_some() {
        ref m : Expr = m_o.unwrap()
        base_arm_o := lazy_recursive_arm(m, 0)
        cons_arm_o := lazy_recursive_arm(m, 2)
        if base_arm_o.is_none().or(cons_arm_o.is_none()) { return false }
        ref base_arm : Expr = base_arm_o.unwrap()
        ref cons_arm : Expr = cons_arm_o.unwrap()
        return lazy_recursive_hygiene_ok(cons_arm.children[0], vname, fixed_names,
            lazy_recursive_arm_value(base_arm), lazy_recursive_arm_value(cons_arm))
    }
    // The statement (if/else) form: `switch xs { case []: ... case [h, ..t]:
    // ... }` with a single-return base arm and an inlinable-guard-chain cons
    // arm (the guards splice as nested short-circuit matches at unroll time).
    sw_o := lazy_recursive_body_switch(fdef.children[0], vname)
    if sw_o.is_none() { return false }
    ref sw : Expr = sw_o.unwrap()
    sbase_o := lazy_recursive_switch_arm(sw, 0)
    scons_o := lazy_recursive_switch_arm(sw, 2)
    if sbase_o.is_none().or(scons_o.is_none()) { return false }
    ref scons : Expr = scons_o.unwrap()
    sbase_val_o := lazy_recursive_switch_base_value(sbase_o.unwrap())
    if sbase_val_o.is_none() { return false }
    ref sbase_val : Expr = sbase_val_o.unwrap()
    if lazy_body_inlinable(scons.children[1]).not() { return false }
    return lazy_recursive_hygiene_ok(scons.children[0], vname, fixed_names,
        sbase_val, scons.children[1])
}

// Clone `e`, replacing the (unique) recursive tail splat call `self(..tail)`
// with a clone of `repl`. The callee must name the def itself -- a tail splat
// call targeting anything else is a lie about the recursion and panics.
priv lazy_clone_replacing_tail := func(e: Expr, tail_name: Str, self_name: Str, repl: Expr) returns Expr {
    if lazy_is_tail_splat_call(e, tail_name) {
        mut cname := ""
        switch e.children[0].node_type {
        case .Ident(cn): cname = Str.clone(cn.ident_name())
        case:
        }
        expect(cname == self_name,
            "recursive variadic lazy: the tail splat call must target the def itself")
        return repl.clone()
    }
    mut out := Expr.new(e.node_type, e.line, e.col)
    for c : Expr in e.children {
        out.add_child(own lazy_clone_replacing_tail(c, tail_name, self_name, repl))
    }
    return out
}

// Substitute `subs` into a cloned arm value, handling the bare-Ident-root
// case (the walk only substitutes children; a root Ident swaps wholesale).
priv lazy_subst_arm_clone := func(own arm: Expr, subs: Map(Str, Expr)) returns Expr {
    mut root_name := ""
    switch arm.node_type {
    case .Ident(rn): root_name = Str.clone(rn.ident_name())
    case:
    }
    if root_name.len().gt(0).and(subs.has(root_name)) {
        return subs[root_name].clone()
    }
    lazy_substitute_idents(arm, subs)
    return arm
}

// expand(k): the expression for effective operands [k, eff_count). At
// k == eff_count the base arm; otherwise the cons arm with head -> operand k
// and the recursive tail call replaced by expand(k + 1). Fixed params
// substitute at every level. `cons_is_body` selects the form: false = the
// match form (cons_src is the arm's value expression), true = the switch
// (if/else) form (cons_src is the arm's statement Body -- an inlinable guard
// chain, spliced to a nested short-circuit match via lazy_body_as_expr).
priv lazy_expand_recursive := func(call: Expr, is_method: Bool, fdef: Expr,
        nfixed: USize, eff_count: USize, k: USize, base_val: Expr, cons_src: Expr,
        cons_is_body: Bool, head: Str, tail: Str, self_name: Str) returns Expr {
    if k == eff_count {
        base_subs := lazy_variadic_subs(call, is_method, fdef, nfixed, "", 0)
        return lazy_subst_arm_clone(own base_val.clone(), base_subs)
    }
    inner := lazy_expand_recursive(call, is_method, fdef, nfixed, eff_count,
        k + 1, base_val, cons_src, cons_is_body, head, tail, self_name)
    cons_subs := lazy_variadic_subs(call, is_method, fdef, nfixed, head, k)
    mut substituted := lazy_subst_arm_clone(own cons_src.clone(), cons_subs)
    if cons_is_body {
        spliced_o := lazy_body_as_expr(substituted)
        expect(spliced_o.is_some(),
            "switch-form recursive arm failed to splice despite lazy_body_inlinable")
        substituted = Option(Expr).take(own spliced_o)
    }
    return lazy_clone_replacing_tail(substituted, tail, self_name, inner)
}

// Extract head/tail from the cons pattern, run the expansion, and splice the
// result over the call node. Shared tail of inline_recursive_variadic_lazy_call
// for both recursive forms.
priv lazy_finish_recursive_inline := func(mut parent: Expr, call_idx: USize,
        fdef: Expr, self_name: Str, is_method: Bool, eff_count: USize,
        nfixed: USize, base_val: Expr, cons_src: Expr, cons_is_body: Bool,
        cons_pat: Expr) {
    mut head := ""
    mut tail := ""
    switch cons_pat.children[0].node_type {
    case .Ident(hn): head = Str.clone(hn.ident_name())
    case:
    }
    switch cons_pat.children[1].node_type {
    case .Ident(tn): tail = Str.clone(tn.ident_name())
    case:
    }
    expanded := lazy_expand_recursive(parent.children[call_idx], is_method, fdef,
        nfixed, eff_count, nfixed, base_val, cons_src, cons_is_body, head, tail, self_name)
    parent.children[call_idx] = expanded
}

// Inline one call to a recursive variadic lazy def (shape pre-checked by
// lazy_recursive_variadic_def). Returns false only on a fixed-arity shortfall,
// where the residual call fails arity checking in the typer.
priv inline_recursive_variadic_lazy_call := func(mut parent: Expr, call_idx: USize,
        fdef: Expr, self_name: Str) returns Bool {
    ref call : Expr = parent.children[call_idx]
    mut vname := ""
    mut nfixed : USize = 0
    switch fdef.node_type {
    case .FuncDef(fd):
        vname = fd.params[fd.variadic_index.to_usize()].name.clone()
        nfixed = fd.params.len() - 1
    case: return false
    }
    mut is_method := false
    switch call.children[0].node_type {
    case .FieldAccess:
        is_method = call.children[0].children.len() == 1
    case:
    }
    mut eff_count : USize = call.children.len() - 1
    if is_method { eff_count = call.children.len() }
    if eff_count < nfixed { return false }

    // Both forms share the expansion; they differ only in where the base
    // value and cons region live (match arm values vs switch arm bodies).
    // lazy_recursive_variadic_def already matched one of the two shapes
    // and checked both arms, so every lookup below hits.
    m_o := lazy_recursive_body_match(fdef.children[0], vname)
    if m_o.is_some() {
        ref m : Expr = m_o.unwrap()
        ref base_arm : Expr = lazy_recursive_arm(m, 0).unwrap()
        ref cons_arm : Expr = lazy_recursive_arm(m, 2).unwrap()
        lazy_finish_recursive_inline(parent, call_idx, fdef, self_name, is_method,
            eff_count, nfixed, lazy_recursive_arm_value(base_arm),
            lazy_recursive_arm_value(cons_arm), false, cons_arm.children[0])
        return true
    }
    ref sw : Expr = lazy_recursive_body_switch(fdef.children[0], vname).unwrap()
    ref sbase : Expr = lazy_recursive_switch_arm(sw, 0).unwrap()
    ref scons : Expr = lazy_recursive_switch_arm(sw, 2).unwrap()
    lazy_finish_recursive_inline(parent, call_idx, fdef, self_name, is_method,
        eff_count, nfixed, lazy_recursive_switch_base_value(sbase).unwrap(),
        scons.children[1], true, scons.children[0])
    return true
}

// Issue #262: statement-inlining for non-inlinable-but-single-exit lazy
// bodies. A body `{ <safe prelude statements> <inlinable tail> }` (e.g.
// `x := f(a); return x.and(b)`) cannot become a single expression, so at a
// statement-position call (a Decl RHS or a Return operand) we splice the
// prelude into a fresh block and route the tail through a result temp:
//   r := lazyf(p, q)
// becomes
//   mut _lzr_N : R = <default>
//   { x := f(p); _lzr_N = <tail expr> }
//   r := _lzr_N
// The block scopes the body's locals (so repeated calls don't collide), the
// prelude runs unconditionally (matching the body), and the tail expr is
// short-circuited by the expression inliner below. Call-by-name, zero runtime
// cost. First-class / loop / early-return bodies are NOT handled here.
// The `N` suffix comes from ctx.lazy_stmt_temp_counter (#101): program-owned,
// so a fresh LoadedProgram always mints `_lzr_0` first.

// core_lazy_func inlining: a bodyless lazy core primitive has no body to
// splice -- its expansion is compiler-known, exactly like a core_func's
// backend lowering. `and` and `or` are the only core lazy ops; an unknown
// name is a hard error, the loader-side twin of the C backend's
// unknown-core-op panic. The spliced match keeps every argument in a
// statement context (an arm), so arbitrarily complex second operands
// lower with full ownership/cleanup machinery, same as lazy_func bodies.
// Calls the loader misses (the desugarer synthesizes .and()/.or() chains
// post-typer) reach the builder as residual calls and lower to C's
// natively short-circuiting && / || there.
priv inline_core_lazy_call := func(mut parent: Expr, call_idx: USize, fdef: Expr, name: Str) returns Bool {
    ref call : Expr = parent.children[call_idx]
    if lazy_call_arity_ok(call, fdef).not() { return false }
    mut is_method := false
    switch call.children[0].node_type {
    case .FieldAccess: is_method = call.children[0].children.len() == 1
    case:
    }
    if name == "and" {
        // and(a, b) == match a { case true: b case: false }
        a0 := lazy_eff_arg_clone(call, is_method, 0)
        a1 := lazy_eff_arg_clone(call, is_method, 1)
        parent.children[call_idx] = lazy_make_bool_match(own a0, own a1,
            own Expr.new(NodeType.Literal(Literal.Bool(false)), call.line, call.col), call.line, call.col)
        return true
    }
    if name == "or" {
        // or(a, b) == match a { case true: true case: b }
        a0 := lazy_eff_arg_clone(call, is_method, 0)
        a1 := lazy_eff_arg_clone(call, is_method, 1)
        parent.children[call_idx] = lazy_make_bool_match(own a0,
            own Expr.new(NodeType.Literal(Literal.Bool(true)), call.line, call.col), own a1, call.line, call.col)
        return true
    }
    panic(__LOC__, ": core_lazy_func loader expansion: unknown op '", name, "'")
    return false
}

priv lazy_call_arity_ok := func(call: Expr, fdef: Expr) returns Bool {
    mut is_method := false
    switch call.children[0].node_type {
    case .FieldAccess: is_method = call.children[0].children.len() == 1
    case:
    }
    switch fdef.node_type {
    case .FuncDef(fd):
        if fd.variadic_index >= 0 { return false }
        mut nargs := call.children.len().sub(1)
        if is_method { nargs = call.children.len() }
        return nargs == fd.params.len()
    case: return false
    }
}

priv lazy_build_subs := func(call: Expr, fdef: Expr) returns Map(Str, Expr) {
    mut subs := Map(Str, Expr).new()
    mut is_method := false
    ref callee : Expr = call.children[0]
    switch callee.node_type {
    case .FieldAccess: is_method = callee.children.len() == 1
    case:
    }
    switch fdef.node_type {
    case .FuncDef(fd):
        for j in 0..fd.params.len() {
            ref param : Declaration = fd.params[j]
            if is_method.and(j.eq(0)) {
                subs.set(param.name, own callee.children[0].clone())
            } else {
                mut arg_idx := j.add(1)
                if is_method { arg_idx = j }
                subs.set(param.name, own call.children[arg_idx].clone())
            }
        }
    case:
    }
    return subs
}

priv lazy_make_temp_decl := func(name: Str, type_name: Str, own init: Expr, line: U32, col: U32) returns Expr {
    mut dd := decl_typed(name = name, explicit_type = type_name, is_mut = true)
    mut decl := Expr.new(NodeType.Decl(dd), line, col)
    decl.add_child(own init)
    return decl
}

priv lazy_make_assign := func(name: Str, own rhs: Expr, line: U32, col: U32) returns Expr {
    mut a := Expr.new(NodeType.Assign(AssignData(name = name.clone())), line, col)
    a.add_child(own rhs)
    return a
}

// The fdef of a statement-inlinable lazy call at `call`, else NULL: a call to
// a lazy callable whose body is NOT expression-inlinable but IS statement-
// inlinable, with matching arity.
priv lazy_stmt_inlinable_call := func(call: Expr, scope: TypeScope, ctx: Context) returns Option(ref Expr) {
    if call.node_type.is(NodeType.FCall).not() { return Option(ref Expr).None }
    if call.children.len() == 0 { return Option(ref Expr).None }
    mut lname := ""
    switch call.children[0].node_type {
    case .Ident(idn): lname = Str.clone(idn.ident_name())
    case .FieldAccess(fa): lname = Str.clone(fa.field_access_name())
    case:
    }
    if lname.len() == 0 { return Option(ref Expr).None }
    // A name in ctx.generic_funcs is a monomorphized-and-DROPPED top-level
    // generic: init_expand_generic_funcs freed its FuncDef, so
    // scope.lookup_func(name) hands back a dangling pointer -- the same
    // documented guard init_lookup_type_gen_macro carries. Reached here via
    // a METHOD call sharing a generic's name (p.swap() vs core swap, #302:
    // heap-use-after-free in func_def_type).
    if ctx.generic_funcs.has(lname) { return Option(ref Expr).None }
    fdef_o := scope.lookup_func(lname)
    if fdef_o.is_none() { return Option(ref Expr).None }
    ref fdef : Expr = fdef_o.unwrap()
    ft := func_def_type(fdef)
    if ft.is_lazy().not() { return Option(ref Expr).None }
    if fdef.children.len() == 0 { return Option(ref Expr).None }
    ref body : Expr = fdef.children[0]
    if lazy_body_inlinable(body) { return Option(ref Expr).None }
    if lazy_body_stmt_inlinable(body).not() { return Option(ref Expr).None }
    if lazy_call_arity_ok(call, fdef).not() { return Option(ref Expr).None }
    return fdef_o
}

// Build `mut _lzr_N : R = default` + `{ <prelude>; _lzr_N = <tail> }`, push
// both into `new`, and return the result Ident `_lzr_N`. None on failure.
priv lazy_build_prelude := func(call: Expr, fdef: Expr, mut new: Vec(Expr), mut ctx: Context) returns Option(Expr) {
    ref body : Expr = fdef.children[0]
    split := lazy_body_split_point(body)
    if split < 0 { return Option(Expr).None }
    sp : USize = split.to_usize()
    mut ret_type := ""
    switch fdef.node_type {
    case .FuncDef(fd): ret_type = fd.return_type.clone()
    case:
    }
    if ret_type.len() == 0 { return Option(Expr).None }
    line := call.line
    col := call.col

    subs := lazy_build_subs(call, fdef)
    mut bclone := body.clone()
    lazy_substitute_idents(bclone, subs)
    nstmts := bclone.children.len()

    // Tail expression from the substituted suffix [sp, nstmts).
    mut tailb := Expr.new(NodeType.Body, line, col)
    for i in sp..nstmts { tailb.add_child(own bclone.children[i].clone()) }
    tail_expr_o := lazy_body_as_expr(tailb)
    if tail_expr_o.is_none() { return Option(Expr).None }
    tail_expr := Option(Expr).take(own tail_expr_o)

    name := format("_lzr_", synth_suffix(ctx, ctx.lazy_stmt_temp_counter.to_str()))
    ctx.lazy_stmt_temp_counter++

    // The block: substituted prelude [0, sp) + `_lzr_N = tail`.
    mut blk := Expr.new(NodeType.Body, line, col)
    for i in 0..sp { blk.add_child(own bclone.children[i].clone()) }
    blk.add_child(own lazy_make_assign(name, own tail_expr, line, col))

    deflt := make_default_value_expr(ret_type, line, col)
    new.push(own lazy_make_temp_decl(name, ret_type, own deflt, line, col))
    new.push(own blk)
    return Option(Expr).Some(Expr.new(ident_node(name), line, col))
}

// The value-position child of a statement that could hold a lazy call (a
// Decl RHS or a Return operand), else NULL.
priv lazy_stmt_value_slot := func(s: Expr) returns Option(ref Expr) {
    switch s.node_type {
    case .Decl:   if s.children.len() > 0 { ref d0 : Expr = s.children[0] return Option(ref Expr).Some(d0) }
    case .Return: if s.children.len() > 0 { ref r0 : Expr = s.children[0] return Option(ref Expr).Some(r0) }
    case:
    }
    return Option(ref Expr).None
}

priv lazy_stmt_inline_body := func(mut body: Expr, scope: TypeScope, mut ctx: Context) {
    mut old := body.children.take()
    mut new := Vec(Expr).new()
    for idx in 0..old.len() {
        ref mut s : Expr = old[idx]
        slot_call_o := lazy_stmt_value_slot(s)
        mut handled := false
        if slot_call_o.is_some() {
            ref slot_call : Expr = slot_call_o.unwrap()
            fdef_o := lazy_stmt_inlinable_call(slot_call, scope, ctx)
            if fdef_o.is_some() {
                result_o := lazy_build_prelude(slot_call, fdef_o.unwrap(), new, ctx)
                if result_o.is_some() {
                    s.children[0] = Option(Expr).take(own result_o)
                    new.push_take(old, idx)
                    handled = true
                }
            }
        }
        if handled.not() { new.push_take(old, idx) }
    }
    body.children = new
}

priv lazy_stmt_inline_walk := func(mut e: Expr, scope: TypeScope, depth: I32, mut ctx: Context) {
    if depth > 256 { return }
    // #101: a top-level function definition opens the `_lzr_` window --
    // this pass runs before the typer, so the typer's synth_owner windows
    // do not exist yet and the walk opens its own. Inside one the counter
    // restarts and lazy_build_prelude mints the bare per-definition
    // `_lzr_<n>` (a C local of that function); module-level mints keep the
    // outer never-restarted sequence with its `g` marker. Guarded on an
    // EMPTY owner so nested named defs keep sharing the enclosing
    // definition's sequence, like every other temp family.
    mut lzr_window := false
    mut saved_lzr_ctr : I64 = 0
    if ctx.synth_owner.len() == 0 {
        switch e.node_type {
        case .Decl(dd):
            if e.children.len() > 0 {
                if e.children[0].node_type.is(NodeType.FuncDef) {
                    ctx.synth_owner = dd.name.clone()
                    saved_lzr_ctr = ctx.lazy_stmt_temp_counter
                    ctx.lazy_stmt_temp_counter = 0
                    lzr_window = true
                }
            }
        case:
        }
    }
    if e.node_type.is(NodeType.Body) { lazy_stmt_inline_body(e, scope, ctx) }
    for i in 0..e.children.len() {
        lazy_stmt_inline_walk(e.children[i], scope, depth.add(1), ctx)
    }
    if lzr_window {
        ctx.synth_owner = ""
        ctx.lazy_stmt_temp_counter = saved_lzr_ctr
    }
}

priv expand_lazy_in_expr := func(mut e: Expr, scope: TypeScope, depth: I32, ctx: Context) {
    if depth > 256 { return }
    for i in 0..e.children.len() {
        ref mut c : Expr = e.children[i]
        mut inlined := false
        if c.node_type.is(NodeType.FCall).and(c.children.len().gt(0)) {
            mut lname := ""
            switch c.children[0].node_type {
            case .Ident(idn): lname = Str.clone(idn.ident_name())
            case .FieldAccess(fa): lname = Str.clone(fa.field_access_name())
            case:
            }
            // Same dropped-generic guard as lazy_stmt_inlinable_call: a
            // name in ctx.generic_funcs points at a freed FuncDef.
            if lname.len().gt(0).and(ctx.generic_funcs.has(lname).not()) {
                fdef_o := scope.lookup_func(lname)
                if fdef_o.is_some() {
                    ref fdef : Expr = fdef_o.unwrap()
                    ft := func_def_type(fdef)
                    if ft.is_lazy() {
                        // Variadic lazy defs unroll over the call's operands
                        // (the recursive Haskell-style form first, then the
                        // iterative for-in form); fixed-arity defs inline
                        // directly.
                        mut done := false
                        if lazy_recursive_variadic_def(fdef) {
                            done = inline_recursive_variadic_lazy_call(e, i, fdef, lname)
                        }
                        if done.not() { done = inline_variadic_lazy_call(e, i, fdef) }
                        if done.not() { done = inline_lazy_call(e, i, fdef) }
                        if done {
                            // The spliced body may contain further lazy
                            // calls (in the body or substituted args).
                            expand_lazy_in_expr(e.children[i], scope, depth + 1, ctx)
                            inlined = true
                        }
                    } else if ft.is(FuncType.CoreLazyFunc) {
                        // Bodyless lazy core primitive: splice the
                        // compiler-known match expansion.
                        if inline_core_lazy_call(e, i, fdef, lname) {
                            expand_lazy_in_expr(e.children[i], scope, depth + 1, ctx)
                            inlined = true
                        }
                    }
                }
            }
        }
        // A recursive variadic lazy def body is a compile-time TEMPLATE: its
        // self-call `self(..tl)` is the recursion point the per-call-site
        // unroll consumes, not a call to expand here -- expanding it in place
        // would destroy the template. Skip descending into such defs.
        mut recursive_template := false
        switch c.node_type {
        case .FuncDef: recursive_template = lazy_recursive_variadic_def(c)
        case:
        }
        if inlined.not().and(recursive_template.not()) { expand_lazy_in_expr(c, scope, depth + 1, ctx) }
    }
}

// Issue #262 thunk fallback. A top-level lazy_func / lazy_proc whose body is
// NEITHER expression-inlinable NOR statement-inlinable (loops, early returns
// inside control flow) is lowered to an ordinary closure-taking function: each
// param `p: T` becomes a zero-arg funcptr `p: func() returns T`, every
// value-use of `p` in the body is auto-forced to `p()`, and at each call site
// the argument expression `e` is wrapped in a synthesized capturing closure
// `func() returns T { return e }` (call-by-name). The synthetic funcptr type is
// named `_Fn_ret_<T>`, registered through register_funcsig_alias_for_stmt so the
// builder emits the typedef. Scope: top-level defs, bare-name calls, exact
// (non-variadic) arity. Shadowed param names are handled scope-aware
// (lazy_autoforce_body); the residual walls are assigning a param /
// field-assigning through one / case patterns binding a param name
// (lazy_thunk_blocked), which stay hard errors.

// Collect into `bound` every name a case FCall pattern BINDS (enum payload
// binding `Type.Variant(x)` or struct pattern `Point(x = nx)`) that equals a
// lazy param name. Binder idents are not uses -- forcing one would destroy the
// binding -- so the auto-force pass treats them as shadowing the param inside
// the arm (guard + body), the same scope-aware handling for-in and catch get.
priv lazy_collect_case_bound := func(pat: Expr, pnames: Set(Str), mut bound: Set(Str)) {
    if pat.node_type.is(NodeType.FCall).not() { return }
    for i in 1..pat.children.len() {
        ref a : Expr = pat.children[i]
        switch a.node_type {
        case .Ident(bn):
            if pnames.has(bn.ident_name()) { bound.add(own Str.clone(bn.ident_name())) }
        case .NamedArg:
            if a.children.len() > 0 {
                switch a.children[0].node_type {
                case .Ident(nbn):
                    if pnames.has(nbn.ident_name()) { bound.add(own Str.clone(nbn.ident_name())) }
                case .FCall:
                    lazy_collect_case_bound(a.children[0], pnames, bound)
                case:
                }
            }
        case .FCall:
            lazy_collect_case_bound(a, pnames, bound)
        case:
        }
    }
}

// The root receiver of a FieldAccess chain (`p.x.f` -> `p`), else NULL.
priv lazy_fieldaccess_root := func(e: Expr) returns ref Expr {
    if e.node_type.is(NodeType.FieldAccess).and(e.children.len().gt(0)) {
        return lazy_fieldaccess_root(e.children[0])
    }
    return e
}

// True when the body contains a construct the thunk lowering cannot rewrite
// faithfully, so the def is left lazy and the typer's hard error names it:
//   - an ASSIGN whose target names a param (a thunk cannot be assigned; the
//     by-name splice would write into the caller's argument, which a forced
//     temporary cannot express). Conservatively includes assigns to a local
//     SHADOWING the param -- rename the local instead.
//   - a FIELD-ASSIGN whose receiver chain roots in a param (`p.f = x`: the
//     forced call yields a temporary, so the write would be lost).
// A case pattern that BINDS a param name is NOT blocked: the binding shadows
// the param inside its arm, handled scope-aware by lazy_autoforce_match_switch.
priv lazy_thunk_blocked := func(e: Expr, pnames: Set(Str), depth: I32) returns Bool {
    if depth > 256 { return true }
    switch e.node_type {
    case .FuncDef: return false        // nested closure: its own scope
    case .Assign(ad):
        if pnames.has(ad.name) { return true }
    case .FieldAssign:
        if e.children.len() > 0 {
            ref root : Expr = lazy_fieldaccess_root(e.children[0])
            switch root.node_type {
            case .Ident(rn):
                if pnames.has(rn.ident_name()) { return true }
            case:
            }
        }
    case:
    }
    for c : Expr in e.children {
        if lazy_thunk_blocked(c, pnames, depth + 1) { return true }
    }
    return false
}

// Scope-aware auto-force: rewrite every value-use of a LIVE lazy param `p`
// (in `pnames` and not in `shadowed`) into a zero-arg force call `p()`.
// Shadowing rules: a Decl of the name shadows it for the REST of its
// enclosing Body (the Decl's own initializer still sees the param); a for-in
// loop variable shadows it inside the loop body only; a catch binding shadows
// it inside the catch body. A nested FuncDef is its own scope: never
// descended. lazy_autoforce_node processes ONE child slot (so a bare-Ident
// slot can be replaced through its parent); lazy_autoforce_body runs a
// statement list, threading Decl shadows to the following statements.
priv lazy_autoforce_node := func(mut parent: Expr, idx: USize, pnames: Set(Str),
        shadowed: Set(Str), memo: Map(Str, Str), depth: I32) {
    if depth > 256 { return }
    ref mut c : Expr = parent.children[idx]
    switch c.node_type {
    case .FuncDef: return
    case .Ident(idn):
        ref nm : Str = idn.ident_name()
        if pnames.has(nm).and(shadowed.has(nm).not()) {
            line := c.line
            col := c.col
            if memo.has(nm) {
                // A param used more than once (#262 call-by-need): force it
                // through its per-type memo helper so the arg expression runs
                // at most once. `_force_once_T(_memo_<nm>_done, _memo_<nm>_v,
                // <thunk>)` -- the done/cache cells are body locals injected by
                // lazy_thunk_lower_def.
                ref fo : Str = memo.get(nm)!
                mut call := Expr.new(NodeType.FCall(FCallData()), line, col)
                call.add_child(own Expr.new(ident_node(fo), line, col))
                call.add_child(own Expr.new(ident_node(format("_memo_", nm, "_done")), line, col))
                call.add_child(own Expr.new(ident_node(format("_memo_", nm, "_v")), line, col))
                call.add_child(own Expr.new(ident_node(nm), line, col))
                parent.children[idx] = call
            } else {
                // Single-use param: a plain force `<thunk>()` (call-by-name and
                // call-by-need coincide at one use).
                mut call := Expr.new(NodeType.FCall(FCallData()), line, col)
                call.add_child(own Expr.new(ident_node(nm), line, col))
                parent.children[idx] = call
            }
        }
        return
    case .Body:
        lazy_autoforce_body(c, pnames, shadowed, memo, depth + 1)
        return
    case .ForIn(fid):
        // The iterated expression sees the current scope; the loop body sees
        // the loop variable(s) shadowing any same-named param.
        if c.children.len() >= 1 { lazy_autoforce_node(c, 0, pnames, shadowed, memo, depth + 1) }
        mut loop_shadowed := shadowed.clone()
        if pnames.has(fid.name) { loop_shadowed.add(own fid.name.clone()) }
        if fid.name2.len().gt(0).and(pnames.has(fid.name2)) {
            loop_shadowed.add(own fid.name2.clone())
        }
        if c.children.len() >= 2 {
            lazy_autoforce_body(c.children[1], pnames, loop_shadowed, memo, depth + 1)
        }
        return
    case .Catch:
        // children: [Ident var, Ident type, Body]. The binder idents are not
        // uses; the caught var shadows a same-named param in the catch body.
        mut catch_shadowed := shadowed.clone()
        switch c.children[0].node_type {
        case .Ident(cvn):
            if pnames.has(cvn.ident_name()) { catch_shadowed.add(own Str.clone(cvn.ident_name())) }
        case:
        }
        if c.children.len() >= 3 {
            lazy_autoforce_body(c.children[2], pnames, catch_shadowed, memo, depth + 1)
        }
        return
    case .Match, .Switch:
        lazy_autoforce_match_switch(c, pnames, shadowed, memo, depth + 1)
        return
    case:
    }
    for j in 0..c.children.len() {
        lazy_autoforce_node(c, j, pnames, shadowed, memo, depth + 1)
    }
}

// Auto-force a match/switch: children[0] is the subject (forced with the outer
// shadow set), children[1..] are Case arms. Each arm's pattern may BIND names
// equal to a param; those bindings shadow the param inside that arm only (its
// pattern's non-binder value-uses, guard, and body). A binder Ident sits in
// the shadow set, so it is left as-is while a genuine param value-use in the
// same arm still forces -- the same scope-aware rule for-in / catch use.
priv lazy_autoforce_match_switch := func(mut node: Expr, pnames: Set(Str),
        shadowed: Set(Str), memo: Map(Str, Str), depth: I32) {
    if depth > 256 { return }
    if node.children.len() >= 1 {
        lazy_autoforce_node(node, 0, pnames, shadowed, memo, depth + 1)
    }
    for ci in 1..node.children.len() {
        ref mut arm : Expr = node.children[ci]
        if arm.node_type.is(NodeType.Case).not() { continue }
        mut arm_shadowed := shadowed.clone()
        if arm.children.len() >= 1 {
            lazy_collect_case_bound(arm.children[0], pnames, arm_shadowed)
        }
        for k in 0..arm.children.len() {
            lazy_autoforce_node(arm, k, pnames, arm_shadowed, memo, depth + 1)
        }
    }
}

priv lazy_autoforce_body := func(mut body: Expr, pnames: Set(Str),
        outer_shadowed: Set(Str), memo: Map(Str, Str), depth: I32) {
    if depth > 256 { return }
    mut shadowed := outer_shadowed.clone()
    for i in 0..body.children.len() {
        // Clone the Decl name ONLY when it shadows a param (the clone is
        // consumed by the Set add below); a conditionally-moved clone for a
        // non-param Decl would leak (surfaced when call-by-need started
        // routing bodies with non-param Decls through this pass).
        mut decl_name := ""
        switch body.children[i].node_type {
        case .Decl(dd):
            if pnames.has(dd.name) { decl_name = dd.name.clone() }
        case:
        }
        lazy_autoforce_node(body, i, pnames, shadowed, memo, depth + 1)
        // A Decl shadows its name for the statements AFTER it (its own
        // initializer, walked above, still saw the param).
        if decl_name.len() > 0 {
            shadowed.add(own decl_name)
        }
    }
}

// Build the bodyless `_Fn_ret_<T>` funcsig Decl (mirrors parser.til
// parse_fn_signature) and queue it in `pending`. NOT appended to the unit AST
// here: the lowering pass holds live refs into that AST's children Vec, and an
// append that reallocs it turns them into use-after-free. The caller flushes
// `pending` (append + scope registration) at unit end, when no refs are live.
// Deduped per name through `seen` and the existing scope binding.
priv lazy_register_fn_ret_alias := func(lp: LoadedProgram,
        ret_type: Str, line: U32, col: U32, mut seen: Set(Str), mut pending: Vec(Expr)) {
    name := format("_Fn_ret_", ret_type)
    if seen.has(name) { return }
    seen.add(own name.clone())
    // Reuse a hand-written `func() returns T` alias if one already exists.
    if lp.ctx.scope.get_binding(name).is_some() { return }

    mut fd := FunctionDef()
    fd.func_type = FuncType.Func
    fd.return_type = ret_type.clone()
    fd.return_own_type = OwnType.Own
    fd.variadic_index = -1
    fd.kwargs_index = -1
    mut sig := Expr.new(NodeType.FuncDef(fd), line, col)
    mut decl := Expr.new(NodeType.Decl(Declaration(name = name.clone(), is_priv = true)), line, col)
    decl.add_child(own sig)
    pending.push(own decl)
}

// Count LIVE value-uses of each param (#262 call-by-need memoization) into
// `counts`, scope-aware exactly like the auto-force pass: a Decl / for-in var /
// catch var / case-pattern binder that shadows a param name is NOT a use of the
// param. This must match auto-force's notion of a "force site" -- a param
// counted >=2 here is one whose thunk auto-force would force more than once, so
// it (and only it) needs memoization.
priv lazy_count_live_bump := func(nm: Str, mut counts: Map(Str, I64)) {
    mut prev : I64 = 0
    if counts.has(nm) { prev = counts.get(nm)! }
    counts.set(nm, own prev.add(1))
}
priv lazy_count_live := func(e: Expr, pnames: Set(Str), shadowed: Set(Str), mut counts: Map(Str, I64), depth: I32) {
    if depth > 512 { return }
    switch e.node_type {
    case .FuncDef: return
    case .Ident(idn):
        ref nm : Str = idn.ident_name()
        if pnames.has(nm).and(shadowed.has(nm).not()) { lazy_count_live_bump(nm, counts) }
        return
    case .ForIn(fid):
        if e.children.len() >= 1 { lazy_count_live(e.children[0], pnames, shadowed, counts, depth + 1) }
        mut ls := shadowed.clone()
        if pnames.has(fid.name) { ls.add(own fid.name.clone()) }
        if fid.name2.len().gt(0).and(pnames.has(fid.name2)) { ls.add(own fid.name2.clone()) }
        if e.children.len() >= 2 { lazy_count_live(e.children[1], pnames, ls, counts, depth + 1) }
        return
    case .Catch:
        mut cs := shadowed.clone()
        switch e.children[0].node_type {
        case .Ident(cvn):
            if pnames.has(cvn.ident_name()) { cs.add(own Str.clone(cvn.ident_name())) }
        case:
        }
        if e.children.len() >= 3 { lazy_count_live(e.children[2], pnames, cs, counts, depth + 1) }
        return
    case .Match, .Switch:
        lazy_count_live_ms(e, pnames, shadowed, counts, depth + 1)
        return
    case .Body:
        lazy_count_live_body(e, pnames, shadowed, counts, depth + 1)
        return
    case:
    }
    for ch : Expr in e.children { lazy_count_live(ch, pnames, shadowed, counts, depth + 1) }
}
priv lazy_count_live_ms := func(node: Expr, pnames: Set(Str), shadowed: Set(Str), mut counts: Map(Str, I64), depth: I32) {
    if node.children.len() >= 1 { lazy_count_live(node.children[0], pnames, shadowed, counts, depth + 1) }
    for ci in 1..node.children.len() {
        ref arm : Expr = node.children[ci]
        if arm.node_type.is(NodeType.Case).not() { continue }
        mut arm_shadowed := shadowed.clone()
        if arm.children.len() >= 1 { lazy_collect_case_bound(arm.children[0], pnames, arm_shadowed) }
        // Skip the pattern (children[0]) -- its binder idents are not uses; count
        // the guard/body under the arm's shadow set.
        for k in 1..arm.children.len() {
            lazy_count_live(arm.children[k], pnames, arm_shadowed, counts, depth + 1)
        }
    }
}
priv lazy_count_live_body := func(body: Expr, pnames: Set(Str), outer_shadowed: Set(Str), mut counts: Map(Str, I64), depth: I32) {
    mut shadowed := outer_shadowed.clone()
    for i in 0..body.children.len() {
        // Clone the Decl name ONLY when it shadows a param (the clone is
        // consumed by the Set add below); a conditionally-moved clone for a
        // non-param Decl would leak.
        mut decl_name := ""
        switch body.children[i].node_type {
        case .Decl(dd):
            if pnames.has(dd.name) { decl_name = dd.name.clone() }
        case:
        }
        lazy_count_live(body.children[i], pnames, shadowed, counts, depth + 1)
        if decl_name.len() > 0 { shadowed.add(own decl_name) }
    }
}

// True when any param of `fdef` is forced more than once in `body`. Such a def
// must thunk-lower (with memo helpers) rather than inline, so its multi-use
// arguments evaluate at most once (call-by-need).
priv lazy_has_multiuse_param := func(fdef: Expr, body: Expr) returns Bool {
    switch fdef.node_type {
    case .FuncDef(fd):
        if fd.variadic_index >= 0 { return false }
        mut pnames := Set(Str).new()
        for p : Declaration in fd.params { pnames.add(own p.name.clone()) }
        mut counts := Map(Str, I64).new()
        no_shadow := Set(Str).new()
        lazy_count_live_body(body, pnames, no_shadow, counts, 0)
        for p : Declaration in fd.params {
            if counts.has(p.name) {
                if counts.get(p.name)! >= 2 { return true }
            }
        }
    case:
    }
    return false
}

// Build the top-level monomorphic memo helper Decl for return type T:
//   _force_once_T := func(mut done: Bool, mut cache: T, th: _Fn_ret_T) returns T {
//       if done.not() { cache = th(); done = true }
//       return cache
//   }
priv lazy_build_force_once_def := func(ret_type: Str, line: U32, col: U32) returns Expr {
    fn_ret := format("_Fn_ret_", ret_type)
    mut fd := FunctionDef()
    fd.func_type = FuncType.Func
    fd.return_type = ret_type.clone()
    fd.return_own_type = OwnType.Own
    fd.variadic_index = -1
    fd.kwargs_index = -1
    fd.params.push(own decl_typed(name = "done", explicit_type = "Bool", own_type = OwnType.Ref, is_mut = true))
    fd.params.push(own decl_typed(name = "cache", explicit_type = ret_type, own_type = OwnType.Ref, is_mut = true))
    fd.params.push(own decl_typed(name = "th", explicit_type = fn_ret, own_type = OwnType.Ref, is_mut = false))

    // then: cache = th() ; done = true
    mut th_call := Expr.new(NodeType.FCall(FCallData()), line, col)
    th_call.add_child(own Expr.new(ident_node("th"), line, col))
    mut asg_cache := Expr.new(NodeType.Assign(AssignData(name = "cache")), line, col)
    asg_cache.add_child(own th_call)
    mut asg_done := Expr.new(NodeType.Assign(AssignData(name = "done")), line, col)
    asg_done.add_child(own Expr.new(NodeType.Literal(Literal.Bool(true)), line, col))
    mut then_body := Expr.new(NodeType.Body, line, col)
    then_body.add_child(own asg_cache)
    then_body.add_child(own asg_done)

    mut if_node := Expr.new(NodeType.If, line, col)
    if_node.add_child(own make_method_call_fcall(own Expr.new(ident_node("done"), line, col), "not", line, col))
    if_node.add_child(own then_body)

    mut ret := Expr.new(NodeType.Return, line, col)
    ret.add_child(own Expr.new(ident_node("cache"), line, col))

    mut body := Expr.new(NodeType.Body, line, col)
    body.add_child(own if_node)
    body.add_child(own ret)

    mut def := Expr.new(NodeType.FuncDef(fd), line, col)
    def.add_child(own body)

    name := format("_force_once_", ret_type)
    mut decl := Expr.new(NodeType.Decl(Declaration(name = name.clone(), is_priv = true)), line, col)
    decl.add_child(own def)
    return decl
}

// Queue (once) the per-type memo helper in `pending`; the caller's unit-end
// flush appends it to the unit AST and registers the scope binding against the
// PUSHED node -- see lazy_register_fn_ret_alias for why appending mid-pass is
// forbidden (use-after-free through the pass's live refs).
priv lazy_register_force_once := func(lp: LoadedProgram,
        ret_type: Str, line: U32, col: U32, mut seen_fo: Set(Str), mut pending: Vec(Expr)) {
    name := format("_force_once_", ret_type)
    if seen_fo.has(name) { return }
    seen_fo.add(own name.clone())
    if lp.ctx.scope.get_binding(name).is_some() { return }
    pending.push(own lazy_build_force_once_def(ret_type, line, col))
}

// Flush the pending loader-generated decls (thunk funcsig aliases + memo
// helpers) into the unit AST and register each against its PUSHED node
// (set_func_def stores a raw pointer that must live in the AST).
// init_declarations_global has already run, so an unregistered decl would be
// invisible to the typer. Runs at unit end when no refs into the children Vec
// are live; the appends can still realloc the Vec and dangle EARLIER
// registrations, which the caller repairs via init_refresh_seeded_scope_defs.
priv lazy_flush_pending_decls := func(mut lp: LoadedProgram, unit_path: Str, pending: Vec(Expr)) {
    if pending.len() == 0 { return }
    ref mut unit_ast : Expr = lp.ctx.imported[unit_path].ast
    for i in 0..pending.len() {
        mut name := ""
        line := pending[i].line
        col := pending[i].col
        switch pending[i].node_type {
        case .Decl(pd): name = pd.name.clone()
        case:
        }
        unit_ast.add_child(own pending[i].clone())
        ref pushed : Expr = unit_ast.children[unit_ast.children.len() - 1]
        if name.starts_with("_force_once_") {
            // The binding TYPE is the helper's RETURN type (not None) -- a call
            // resolves its result type from here (register_function_def_for_stmt).
            ret_type := name.strip_prefix("_force_once_")
            rt := til_type_from_explicit_type(ret_type)
            lp.ctx.scope.set(name, rt, false, unit_path, line, col, false, OwnType.Shallow)
            lp.ctx.scope.set_func_def(name, pushed.children[0])
            ref mut fb : TypeBinding = lp.ctx.scope.get_binding(name).unwrap()
            fb.is_func_decl = true
            fb.is_priv = true
        } else {
            register_funcsig_alias_for_stmt(lp.ctx, pushed, lp.ctx.scope)
        }
    }
}

// The two body-local cache cells a memoized param needs:
//   mut _memo_<p>_done := false
//   mut _memo_<p>_v : T = <default>
// prepended to the body; force_once mutates them by reference.
priv lazy_make_memo_decls := func(pname: Str, ret_type: Str, line: U32, col: U32) returns Vec(Expr) {
    mut out := Vec(Expr).new()
    mut d := Expr.new(NodeType.Decl(Declaration(name = format("_memo_", pname, "_done"), is_mut = true)), line, col)
    d.add_child(own Expr.new(NodeType.Literal(Literal.Bool(false)), line, col))
    out.push(own d)
    mut v := Expr.new(NodeType.Decl(decl_typed(name = format("_memo_", pname, "_v"), explicit_type = ret_type, own_type = OwnType.Shallow, is_mut = true)), line, col)
    v.add_child(own make_default_value_expr(ret_type, line, col))
    out.push(own v)
    return out
}

// Lower one non-inlinable top-level lazy def in place: LazyFunc->Func /
// LazyProc->Proc, retype each param `p: T` to `p: _Fn_ret_T`, auto-force the
// body, and register the funcptr aliases. Records the lowered name in `lowered`.
priv lazy_thunk_lower_def := func(mut lp: LoadedProgram,
        name: Str, mut fdef: Expr, mut lowered: Set(Str), mut seen: Set(Str), mut seen_fo: Set(Str), mut pending: Vec(Expr)) {
    if fdef.children.len() == 0 { return }
    ref mut body : Expr = fdef.children[0]
    mut pnames := Set(Str).new()
    switch fdef.node_type {
    case .FuncDef(fd):
        if fd.variadic_index >= 0 { return }   // variadic: out of scope
        for p : Declaration in fd.params { pnames.add(own p.name.clone()) }
    case:
        return
    }
    // Constructs the thunk rewrite cannot express (assigning a param,
    // field-assigning through one, case patterns binding a param name):
    // leave the def lazy so the typer's hard error names it.
    if lazy_thunk_blocked(body, pnames, 0) { return }

    // #262 call-by-need: a param used more than once memoizes its argument so
    // it evaluates at most once. Decide this BEFORE retyping (need the original
    // T), collect the per-param memo helper name + inject its two cache locals.
    mut memo := Map(Str, Str).new()
    mut cache_decls := Vec(Expr).new()
    mut use_counts := Map(Str, I64).new()
    lazy_count_live_body(body, pnames, Set(Str).new(), use_counts, 0)
    switch fdef.node_type {
    case .FuncDef(fd):
        for i in 0..fd.params.len() {
            ref p : Declaration = fd.params[i]
            mut cnt : I64 = 0
            if use_counts.has(p.name) { cnt = use_counts.get(p.name)! }
            if cnt >= 2 {
                orig_t := p.explicit_type.clone()
                lazy_register_force_once(lp, orig_t, fdef.line, fdef.col, seen_fo, pending)
                memo.set(p.name, own format("_force_once_", orig_t))
                mut decls := lazy_make_memo_decls(p.name, orig_t, fdef.line, fdef.col)
                for di in 0..decls.len() { cache_decls.push_take(decls, di) }
            }
        }
    case:
        return
    }

    switch fdef.node_type {
    case .FuncDef(fd):
        if fd.func_type.is(FuncType.LazyFunc) { fd.func_type = FuncType.Func }
        else { fd.func_type = FuncType.Proc }
        for i in 0..fd.params.len() {
            ref mut param : Declaration = fd.params[i]
            ret_type := param.explicit_type.clone()
            lazy_register_fn_ret_alias(lp, ret_type, fdef.line, fdef.col, seen, pending)
            param.explicit_type = format("_Fn_ret_", ret_type)
            param.til_type = til_type_from_explicit_type(param.explicit_type)
        }
    case:
        return
    }

    // Prepend the memo cache locals so they are in scope before any force.
    if cache_decls.len() > 0 {
        mut new_ch := Vec(Expr).new()
        for cd in 0..cache_decls.len() { new_ch.push_take(cache_decls, cd) }
        for bi in 0..body.children.len() { new_ch.push_take(body.children, bi) }
        body.children.move_from(own new_ch)
    }

    no_shadow := Set(Str).new()
    lazy_autoforce_body(body, pnames, no_shadow, memo, 0)
    lowered.add(own name.clone())
    lp.ctx.scope.set_func_def(name, fdef)
}

// Issue #262 first-class: lower a bodyless `Sig := lazy_func(T, ...) returns R`
// funcsig type in place. Like a thunk-lowered def's params, each param `T`
// becomes `_Fn_ret_T` and the func_type flips LazyFunc->Func / LazyProc->Proc,
// so the funcsig's C typedef (`TilClosure *Sig`) is emitted and its resolved
// signature matches a thunk-lowered def assigned/returned as that type. The
// name is recorded in `lazy_sigs`; a call through any value of that type gets
// its args thunk-wrapped by lazy_wrap_thunk_calls.
priv lazy_lower_funcsig := func(mut lp: LoadedProgram,
        name: Str, mut fdef: Expr, mut lazy_sigs: Set(Str), mut seen: Set(Str), mut pending: Vec(Expr)) {
    switch fdef.node_type {
    case .FuncDef(fd):
        if fd.variadic_index >= 0 { return }   // variadic funcsig: out of scope
        if fd.func_type.is(FuncType.LazyFunc) { fd.func_type = FuncType.Func }
        else if fd.func_type.is(FuncType.LazyProc) { fd.func_type = FuncType.Proc }
        else { return }
        for i in 0..fd.params.len() {
            ref mut param : Declaration = fd.params[i]
            ret_type := param.explicit_type.clone()
            lazy_register_fn_ret_alias(lp, ret_type, fdef.line, fdef.col, seen, pending)
            param.explicit_type = format("_Fn_ret_", ret_type)
            param.til_type = til_type_from_explicit_type(param.explicit_type)
        }
    case:
        return
    }
    lazy_sigs.add(own name.clone())
    lp.ctx.scope.set_func_def(name, fdef)
}

// If `call` (an FCall / UFCS method call) targets a function whose declared
// return type is a lazy funcsig, return that funcsig name, else "". Lets a
// `g := returns_a_lazy_func()` decl mark `g` first-class so its own calls wrap.
priv lazy_call_returns_sig := func(call: Expr, scope: TypeScope, lazy_sigs: Set(Str)) returns Str {
    if call.node_type.is(NodeType.FCall).not() { return "" }
    if call.children.len() == 0 { return "" }
    mut callee_name := ""
    switch call.children[0].node_type {
    case .Ident(idn): callee_name = Str.clone(idn.ident_name())
    case .FieldAccess(fa): callee_name = Str.clone(fa.field_access_name())
    case:
    }
    if callee_name.len() == 0 { return "" }
    cfd_o := scope.lookup_func(callee_name)
    if cfd_o.is_none() { return "" }
    switch cfd_o.unwrap().node_type {
    case .FuncDef(fd):
        if lazy_sigs.has(fd.return_type) { return fd.return_type.clone() }
    case:
    }
    return ""
}

// If `call` builds a struct value -- a constructor `S(...)` (callee is a struct
// name) or a call to a struct-returning function -- return that struct's name,
// else "". Lets `h := S(...)` mark `h` so a later `h.fn(...)` field call can
// resolve its lazy-funcsig field.
priv lazy_call_struct_type := func(call: Expr, scope: TypeScope) returns Str {
    if call.node_type.is(NodeType.FCall).not() { return "" }
    if call.children.len() == 0 { return "" }
    mut name := ""
    switch call.children[0].node_type {
    case .Ident(idn): name = Str.clone(idn.ident_name())
    case .FieldAccess(fa): name = Str.clone(fa.field_access_name())
    case:
    }
    if name.len() == 0 { return "" }
    if scope.get_struct(name).is_some() { return name.clone() }
    cfd_o := scope.lookup_func(name)
    if cfd_o.is_none() { return "" }
    switch cfd_o.unwrap().node_type {
    case .FuncDef(fd):
        if scope.get_struct(fd.return_type).is_some() { return fd.return_type.clone() }
    case:
    }
    return ""
}

// Classify one name referenced inside a thunk arg expression against the
// program ROOT scope (lp.ctx.scope at this phase). A name is a CAPTURE iff it
// is not bound inside the thunk body and is not resolvable at root scope: at
// this phase only globals / top-level funcs / builtins are in scope, so any
// other name is an enclosing local the thunk must capture by reference (#54).
priv lazy_thunk_classify_capture := func(name: Str, scope: TypeScope,
        bound: Set(Str), mut caps: Vec(Declaration)) {
    if bound.has(name) { return }                  // bound inside the thunk body
    if scope.get_binding(name).is_some() { return } // global / top-level func / builtin
    for existing : Declaration in caps {
        if existing.name == name { return }
    }
    caps.push(own Declaration(name = name.clone(), own_type = OwnType.Ref))
}

// Free-variable analysis over a thunk arg expression: collect every Ident /
// Assign-target that resolves to an enclosing local into `caps`. Names bound
// inside the expression (a Decl, a for-loop variable) are tracked in `bound`
// so they are not mistaken for captures. Stops at nested FuncDef / CaptureBlock
// boundaries (those carry their own capture rules).
priv lazy_thunk_collect_captures := func(e: Expr, scope: TypeScope,
        mut bound: Set(Str), mut caps: Vec(Declaration)) {
    switch e.node_type {
    case .FuncDef, .CaptureBlock: return
    case .Decl(dd):
        if dd.name.len() > 0 { bound.add(own dd.name.clone()) }
    case .ForIn(fd):
        if fd.name.len() > 0 { bound.add(own fd.name.clone()) }
        if fd.name2.len() > 0 { bound.add(own fd.name2.clone()) }
    case .Ident(idd):
        lazy_thunk_classify_capture(idd.name, scope, bound, caps)
    case .Assign(ad):
        lazy_thunk_classify_capture(ad.name, scope, bound, caps)
    case:
    }
    for c : Expr in e.children {
        lazy_thunk_collect_captures(c, scope, bound, caps)
    }
}

// Wrap each argument of a call to a thunk-lowered def in a synthesized closure
// `func() returns T [caps] { return <arg> }` (call-by-name). `T` is the param's
// ORIGINAL return type, recovered from the param's `_Fn_ret_<T>` explicit_type;
// `caps` is the arg expression's enclosing-local free variables (by reference).
// A thunk with no captures is left non-capturing, so the lambda lifter hoists
// it to a plain top-level function -- exactly like any other non-capturing
// lambda. The typer's #54 closure-escape checks then gate any captured local
// that would escape its defining call (first-class / infinite uses await #54).
// Build a thunk closure `func() returns ret_type [caps] { return <eff> }` over
// the (owned) effective argument expression `eff`. `caps` is eff's enclosing-
// local free variables; a no-capture thunk is lifted to a plain top-level
// lambda, a capturing one reuses the #54 machinery.
priv lazy_make_thunk := func(own eff: Expr, ret_type: Str, scope: TypeScope) returns Expr {
    line := eff.line
    col := eff.col
    mut caps := Vec(Declaration).new()
    mut bound := Set(Str).new()
    lazy_thunk_collect_captures(eff, scope, bound, caps)
    mut cfd := FunctionDef()
    cfd.func_type = FuncType.Func
    cfd.return_type = ret_type.clone()
    cfd.variadic_index = -1
    cfd.kwargs_index = -1
    cfd.captures = caps
    mut ret := Expr.new(NodeType.Return, line, col)
    ret.add_child(own eff)
    mut cbody := Expr.new(NodeType.Body, line, col)
    cbody.add_child(own ret)
    mut clos := Expr.new(NodeType.FuncDef(cfd), line, col)
    clos.add_child(own cbody)
    return clos
}

// Build a fresh BARE call `name(thunk(eff_0), thunk(eff_1), ...)` to a thunk-
// lowered def, wrapping each effective argument in a thunk closure. Both bare
// `f(a, b)` and UFCS `a.f(b)` calls reduce to the same bare form (the receiver
// is effective arg 0), so a thunk -- which is not a UFCS receiver -- is never
// left in receiver position. `ret_type` per param is recovered from its
// `_Fn_ret_<T>` explicit_type. Mirrors lazy_build_fold's bare-normalization.
priv lazy_build_thunk_call := func(call: Expr, fdef: Expr, name: Str, is_method: Bool, scope: TypeScope) returns Expr {
    line := call.line
    col := call.col
    mut nc := Expr.new(NodeType.FCall(FCallData()), line, col)
    nc.add_child(own Expr.new(ident_node(name), line, col))
    switch fdef.node_type {
    case .FuncDef(fd):
        for j in 0..fd.params.len() {
            ref param : Declaration = fd.params[j]
            ret_type := param.explicit_type.strip_prefix("_Fn_ret_")
            nc.add_child(own lazy_make_thunk(own lazy_eff_arg_clone(call, is_method, j), ret_type, scope))
        }
    case:
    }
    return nc
}

// Build a call through a FIELD funcptr `recv.fn(thunk(a0), thunk(a1), ...)`
// (a lazy-funcsig struct field, #262 first-class). Unlike lazy_build_thunk_call
// the callee is the original FieldAccess (`recv.fn`), NOT a bare name, and the
// receiver is NOT an effective arg -- the field IS the funcptr, so args are just
// children[1..]. Per-param ret_type recovered from the sig's `_Fn_ret_T`.
priv lazy_build_field_thunk_call := func(call: Expr, sig_fdef: Expr, scope: TypeScope) returns Expr {
    line := call.line
    col := call.col
    mut nc := Expr.new(NodeType.FCall(FCallData()), line, col)
    nc.add_child(own call.children[0].clone())
    switch sig_fdef.node_type {
    case .FuncDef(fd):
        for j in 0..fd.params.len() {
            ref param : Declaration = fd.params[j]
            ret_type := param.explicit_type.strip_prefix("_Fn_ret_")
            nc.add_child(own lazy_make_thunk(own call.children[j + 1].clone(), ret_type, scope))
        }
    case:
    }
    return nc
}

// For a subscript-callee call `v[i](...)` -- at this phase already desugared to
// `FCall(FCall(FieldAccess(get, v), i), args...)` -- where `v` is a local
// tracked in `dynvec_of` as a DynVec of a lazy funcsig, return that sig name,
// else "". (`ops := DynVec.new(Sig)` records the elem sig syntactically.)
priv lazy_subscript_call_sig := func(call: Expr, dynvec_of: Map(Str, Str)) returns Str {
    if call.children.len() == 0 { return "" }
    ref callee : Expr = call.children[0]
    if callee.node_type.is(NodeType.FCall).not() { return "" }
    if callee.children.len() == 0 { return "" }
    ref inner : Expr = callee.children[0]
    if inner.node_type.is(NodeType.FieldAccess).not() { return "" }
    switch inner.node_type {
    case .FieldAccess(fa):
        ref mname : Str = fa.field_access_name()
        if mname.eq("get").or(mname.eq("unsafe_get")).or(mname.eq("pop")).not() { return "" }
    case:
        return ""
    }
    if inner.children.len() == 0 { return "" }
    switch inner.children[0].node_type {
    case .Ident(rn):
        if dynvec_of.has(rn.ident_name()) {
            return dynvec_of.get(rn.ident_name())!.clone()
        }
    case:
    }
    return ""
}

// If `rhs` is `DynVec.new(T)` with T a literal Ident naming a lazy funcsig,
// return T, else "".
priv lazy_dynvec_new_sig := func(rhs: Expr, lazy_sigs: Set(Str)) returns Str {
    if rhs.node_type.is(NodeType.FCall).not() { return "" }
    if rhs.children.len() != 2 { return "" }
    ref callee : Expr = rhs.children[0]
    if callee.node_type.is(NodeType.FieldAccess).not() { return "" }
    if callee.children.len() == 0 { return "" }
    switch callee.node_type {
    case .FieldAccess(fa):
        if fa.field_access_name().eq("new").not() { return "" }
    case:
    }
    switch callee.children[0].node_type {
    case .Ident(rn):
        if rn.ident_name().eq("DynVec").not() { return "" }
    case:
        return ""
    }
    switch rhs.children[1].node_type {
    case .Ident(tn):
        if lazy_sigs.has(tn.ident_name()) { return Str.clone(tn.ident_name()) }
    case:
    }
    return ""
}

// For a cast-callee call `cast(<expr>, Sig)(...)` where Sig names a lazy
// funcsig, return that sig name, else "". The sig is written literally in the
// cast (child 2 of the callee FCall, kept verbatim by the parser for #58), so
// no type inference is needed to resolve it.
priv lazy_cast_call_sig := func(call: Expr, lazy_sigs: Set(Str)) returns Str {
    if call.children.len() == 0 { return "" }
    ref callee : Expr = call.children[0]
    if callee.node_type.is(NodeType.FCall).not() { return "" }
    if callee.children.len() != 3 { return "" }
    switch callee.children[0].node_type {
    case .Ident(hn):
        if hn.ident_name().eq("cast").not() { return "" }
    case:
        return ""
    }
    switch callee.children[2].node_type {
    case .Ident(tn):
        if lazy_sigs.has(tn.ident_name()) { return Str.clone(tn.ident_name()) }
    case:
    }
    return ""
}

// For a field call `recv.fn(...)`, return the lazy funcsig name of field `fn`
// when `recv` is a local of a known struct type (tracked in `struct_of`) whose
// `fn` field is typed as a lazy funcsig, else "".
priv lazy_field_call_sig := func(call: Expr, struct_of: Map(Str, Str), scope: TypeScope, lazy_sigs: Set(Str)) returns Str {
    if call.children.len() == 0 { return "" }
    ref callee : Expr = call.children[0]
    if callee.node_type.is(NodeType.FieldAccess).not() { return "" }
    if callee.children.len() == 0 { return "" }
    mut field_name := ""
    switch callee.node_type {
    case .FieldAccess(fa): field_name = Str.clone(fa.field_access_name())
    case:
    }
    mut recv_name := ""
    switch callee.children[0].node_type {
    case .Ident(rn): recv_name = Str.clone(rn.ident_name())
    case:
    }
    if recv_name.len().eq(0).or(field_name.len().eq(0)) { return "" }
    if struct_of.has(recv_name).not() { return "" }
    ref sname : Str = struct_of.get(recv_name)!
    if sname.len() == 0 { return "" }
    sdef_o := scope.get_struct(sname)
    if sdef_o.is_none() { return "" }
    ref sdef : Expr = sdef_o.unwrap()
    switch sdef.node_type {
    case .StructDef(sdd):
        fld_o := member_get(sdd.fields_index, sdd.fields, field_name)
        if fld_o.is_some() {
            ref fld : Declaration = fld_o.unwrap()
            if lazy_sigs.has(fld.explicit_type) { return fld.explicit_type.clone() }
            return ""
        }
    case:
    }
    return ""
}

// Resolve a call-site name through the local alias map to the canonical
// thunk-lowered def it stands for. Returns the name unchanged when it is not an
// alias (or is a shadow, stored as ""). Aliases are stored fully resolved, so a
// single lookup suffices (transitive `h := g := f` chains are flattened when
// each Decl is recorded).
priv lazy_alias_resolve := func(name: Str, aliases: Map(Str, Str)) returns Str {
    if aliases.has(name) {
        ref v : Str = aliases.get(name)!
        if v.len() > 0 { return v.clone() }
    }
    return name.clone()
}

// Walk all exprs; for every FCall (bare `f(a, b)` or UFCS `a.f(b)`) naming a
// thunk-lowered def -- directly, or through a local value alias `g := f`
// (first-class #262) -- rebuild it as a bare call with each effective argument
// wrapped in a thunk closure. `aliases` maps a local name to the canonical
// lowered def it stands for (or "" once a later decl shadows an inherited alias
// with a non-lazy value). It is cloned on descent so a nested block's aliases
// never leak to an outer sibling -- e.g. a different function that reuses the
// name for an unrelated value.
priv lazy_wrap_thunk_calls := func(mut e: Expr, scope: TypeScope, lowered: Set(Str), lazy_sigs: Set(Str), mut aliases: Map(Str, Str), mut struct_of: Map(Str, Str), mut dynvec_of: Map(Str, Str), depth: I32) {
    if depth > 256 { return }
    // Entering a FuncDef: seed its params. A param typed as a lazy funcsig is a
    // first-class lazy value (alias -> sig); a param typed as a struct lets a
    // `p.fn(...)` field call resolve its lazy-sig field. `aliases`/`struct_of`
    // are per-subtree clones from the parent, so this does not leak out.
    switch e.node_type {
    case .FuncDef(efd):
        for p : Declaration in efd.params {
            if p.explicit_type.len() == 0 { continue }
            if lazy_sigs.has(p.explicit_type) {
                aliases.set(p.name, own p.explicit_type.clone())
            } else if scope.get_struct(p.explicit_type).is_some() {
                struct_of.set(p.name, own p.explicit_type.clone())
            }
        }
    case:
    }
    for i in 0..e.children.len() {
        ref mut c : Expr = e.children[i]
        if c.node_type.is(NodeType.FCall).and(c.children.len().gt(0)) {
            // First-class EXPRESSION callee: a struct-field call `recv.fn(...)`
            // where `fn` is a lazy-funcsig field (the field IS the funcptr, so
            // the receiver is not an effective arg), or a cast-callee call
            // `cast(x, Sig)(...)` naming a lazy funcsig. Both keep the callee
            // expression and wrap just the args.
            mut fsig := lazy_field_call_sig(c, struct_of, scope, lazy_sigs)
            if fsig.len() == 0 { fsig = lazy_cast_call_sig(c, lazy_sigs) }
            if fsig.len() == 0 {
                ssig := lazy_subscript_call_sig(c, dynvec_of)
                if ssig.len() > 0 {
                    // Rewrite the SUBSCRIPT callee `ops[i]` (already `ops.get(i)!`
                    // here) into `cast(ops[i], Sig)` so the call flows through the
                    // cast-callee machinery end to end -- the typer, interpreter
                    // (slot rehydration) and builder all already resolve a cast
                    // callee's sig; only then wrap the args below like any other
                    // first-class lazy call.
                    line := c.line
                    col := c.col
                    mut cast_callee := Expr.new(NodeType.FCall(FCallData()), line, col)
                    cast_callee.add_child(own Expr.new(ident_node("cast"), line, col))
                    cast_callee.add_child(own c.children[0].clone())
                    cast_callee.add_child(own Expr.new(ident_node(ssig), line, col))
                    c.children[0] = cast_callee
                    fsig = ssig.clone()
                }
            }
            if fsig.len() > 0 {
                sfd_o := scope.lookup_func(fsig)
                if sfd_o.is_some() {
                    ref sfd : Expr = sfd_o.unwrap()
                    mut fnparams : USize = 0
                    switch sfd.node_type {
                    case .FuncDef(fd): fnparams = fd.params.len()
                    case:
                    }
                    if c.children.len().sub(1).eq(fnparams) {
                        e.children[i] = lazy_build_field_thunk_call(c, sfd, scope)
                    }
                }
            } else {
                mut lname := ""
                mut is_method := false
                switch c.children[0].node_type {
                case .Ident(idn): lname = Str.clone(idn.ident_name())
                case .FieldAccess(fa):
                    lname = Str.clone(fa.field_access_name())
                    is_method = true
                case:
                }
                if lname.len() > 0 {
                    canon := lazy_alias_resolve(lname, aliases)
                    // A thunk-lowered def called directly / through a local alias
                    // (`lowered`), or a value of a lazy funcsig type (`lazy_sigs`,
                    // #262 first-class). Both resolve their lowered signature --
                    // `_Fn_ret_T` params -- through scope.lookup_func(canon); emit
                    // the call through the call-site name so the funcptr value keeps
                    // dispatching.
                    if lowered.has(canon).or(lazy_sigs.has(canon)) {
                        fdef_o := scope.lookup_func(canon)
                        if fdef_o.is_some() {
                            ref fdef : Expr = fdef_o.unwrap()
                            mut nparams : USize = 0
                            switch fdef.node_type {
                            case .FuncDef(fd): nparams = fd.params.len()
                            case:
                            }
                            // Effective args: bare `f(a, b)` has children.len()-1 args;
                            // UFCS `a.f(b)` adds the receiver, so children.len().
                            mut eff_count : USize = c.children.len().sub(1)
                            if is_method { eff_count = c.children.len() }
                            if eff_count.eq(nparams) {
                                e.children[i] = lazy_build_thunk_call(c, fdef, lname, is_method, scope)
                            }
                        }
                    }
                }
            }
        }
        mut child_aliases := aliases.clone()
        mut child_struct := struct_of.clone()
        mut child_dynvec := dynvec_of.clone()
        lazy_wrap_thunk_calls(e.children[i], scope, lowered, lazy_sigs, child_aliases, child_struct, child_dynvec, depth + 1)
        // Record first-class bindings a Decl introduces for later siblings:
        //   - an explicit lazy-funcsig type `x: Sig` (alias); or an explicit
        //     struct type `x: S` (struct_of);
        //   - `x := y` where `y` resolves to a lowered def or a lazy-sig value;
        //   - `x := f(...)` where `f` returns a lazy funcsig (alias) or a struct
        //     -- a struct constructor `S(...)` or a struct-returning call.
        // Any other Decl of `x` shadows an inherited alias (recorded as "").
        ref cc : Expr = e.children[i]
        switch cc.node_type {
        case .Decl(dd):
            if dd.name.len() > 0 {
                if dd.explicit_type.len().gt(0).and(lazy_sigs.has(dd.explicit_type)) {
                    aliases.set(dd.name, own dd.explicit_type.clone())
                } else if dd.explicit_type.len().gt(0).and(scope.get_struct(dd.explicit_type).is_some()) {
                    struct_of.set(dd.name, own dd.explicit_type.clone())
                } else if cc.children.len() > 0 {
                    switch cc.children[0].node_type {
                    case .Ident(rid):
                        ycanon := lazy_alias_resolve(rid.ident_name(), aliases)
                        if lowered.has(ycanon).or(lazy_sigs.has(ycanon)) {
                            aliases.set(dd.name, own ycanon)
                        } else if struct_of.has(rid.ident_name()) {
                            aliases.set(dd.name, own "")
                            struct_of.set(dd.name, own struct_of.get(rid.ident_name())!.clone())
                        } else {
                            aliases.set(dd.name, own "")
                        }
                    case .FCall:
                        sig := lazy_call_returns_sig(cc.children[0], scope, lazy_sigs)
                        if sig.len() > 0 {
                            aliases.set(dd.name, own sig)
                        } else {
                            dvsig := lazy_dynvec_new_sig(cc.children[0], lazy_sigs)
                            if dvsig.len() > 0 {
                                aliases.set(dd.name, own "")
                                dynvec_of.set(dd.name, own dvsig)
                            } else {
                                st := lazy_call_struct_type(cc.children[0], scope)
                                if st.len() > 0 { struct_of.set(dd.name, own st) }
                                else { aliases.set(dd.name, own "") }
                            }
                        }
                    case:
                        aliases.set(dd.name, own "")
                    }
                }
            }
        case:
        }
    }
}

// Find and lower every non-inlinable top-level lazy def in one unit AST, then
// collect the lowered names. Defs are the direct top-level Decl children.
priv lazy_thunk_lower_unit := func(mut lp: LoadedProgram, unit_path: Str,
        mut lowered: Set(Str), mut lazy_sigs: Set(Str), mut seen: Set(Str), mut seen_fo: Set(Str)) {
    mut pending := Vec(Expr).new()
    ref mut unit_ast : Expr = lp.ctx.imported[unit_path].ast
    n := unit_ast.children.len()
    for i in 0..n {
        ref mut stmt : Expr = unit_ast.children[i]
        if is_func_decl(stmt).not() { continue }
        mut lname := ""
        switch stmt.node_type {
        case .Decl(dd): lname = dd.name.clone()
        case:
        }
        if lname.len() == 0 { continue }
        ref mut fdef : Expr = stmt.children[0]
        ft := func_def_type(fdef)
        if ft.is_lazy().not() { continue }
        // A bodyless lazy funcsig `Sig := lazy_func(T, ...) returns R` (#262
        // first-class): lower the TYPE, not a def.
        if fdef.children.len() == 0 {
            lazy_lower_funcsig(lp, lname, fdef, lazy_sigs, seen, pending)
            continue
        }
        ref body : Expr = fdef.children[0]
        // Inlinable bodies normally stay lazy for the inline pass -- EXCEPT when
        // a param is used more than once: call-by-need (#262) needs the memo
        // thunk lowering so the argument evaluates at most once, which inlining
        // (splice-per-use) cannot express.
        if lazy_body_inlinable(body).or(lazy_body_stmt_inlinable(body)) {
            if lazy_has_multiuse_param(fdef, body).not() { continue }
        }
        lazy_thunk_lower_def(lp, lname, fdef, lowered, seen, seen_fo, pending)
    }
    // Append + register the queued decls now that no refs into the unit's
    // children Vec are live (see lazy_register_fn_ret_alias).
    lazy_flush_pending_decls(lp, unit_path, pending)
}

// Issue #262: the thunk-fallback pass. Lower all non-inlinable top-level lazy
// defs, then wrap their bare-name call arguments in thunk closures. Runs BEFORE
// the inline passes; once a def's func_type flips to Func/Proc the inline
// passes skip its calls (they gate on LazyFunc/LazyProc), which is correct --
// the call-wrapping here already handled them.
priv expand_lazy_thunks_in_program := func(mut lp: LoadedProgram) {
    mut lowered := Set(Str).new()
    mut lazy_sigs := Set(Str).new()
    mut seen := Set(Str).new()
    mut seen_fo := Set(Str).new()
    for upath : Str in lp.unit_paths() {
        lazy_thunk_lower_unit(lp, upath, lowered, lazy_sigs, seen, seen_fo)
    }
    for mf : Str in lp.mode_files {
        lazy_thunk_lower_unit(lp, mf, lowered, lazy_sigs, seen, seen_fo)
    }
    if lowered.len().eq(0).and(lazy_sigs.len().eq(0)) { return }
    // The lowering above APPENDED top-level decls (thunk funcsig aliases, memo
    // helpers) to unit ASTs; if an append realloc'd a children Vec, every
    // func_def/struct_def pointer registered into that AST now dangles.
    // Re-point them before anything (the wrap phase's scope.lookup_func, the
    // typer) reads through them.
    for upath : Str in lp.unit_paths() {
        init_refresh_seeded_scope_defs(lp.ctx.imported[upath].ast, lp.ctx.scope)
    }
    for mfr : Str in lp.mode_files {
        init_refresh_seeded_scope_defs(lp.ctx.imported[mfr].ast, lp.ctx.scope)
    }
    if lp.skip_core.not() {
        for cu : ProgramUnit in lp.core_units {
            mut ca := Map(Str, Str).new()
            mut cs := Map(Str, Str).new()
            mut cv := Map(Str, Str).new()
            lazy_wrap_thunk_calls(lp.ctx.imported[cu.path].ast, lp.ctx.scope, lowered, lazy_sigs, ca, cs, cv, 0)
        }
    }
    for uu : ProgramUnit in lp.units {
        mut ua := Map(Str, Str).new()
        mut us := Map(Str, Str).new()
        mut uv := Map(Str, Str).new()
        lazy_wrap_thunk_calls(lp.ctx.imported[uu.path].ast, lp.ctx.scope, lowered, lazy_sigs, ua, us, uv, 0)
    }
    for mf : Str in lp.mode_files {
        mut ma := Map(Str, Str).new()
        mut ms := Map(Str, Str).new()
        mut mv := Map(Str, Str).new()
        lazy_wrap_thunk_calls(lp.ctx.imported[mf].ast, lp.ctx.scope, lowered, lazy_sigs, ma, ms, mv, 0)
    }
}

priv expand_lazy_calls_in_program := func(mut lp: LoadedProgram) {
    // Issue #262: thunk-lower non-inlinable lazy defs + wrap their calls FIRST,
    // so the inline passes below only see the still-Lazy inlinable defs/calls.
    expand_lazy_thunks_in_program(lp)
    // Pass 1: statement-inline non-inlinable (local-binding) lazy bodies so
    // their inlinable tails are left for pass 2.
    for upath : Str in lp.unit_paths() {
        lazy_stmt_inline_walk(lp.ctx.imported[upath].ast, lp.ctx.scope, 0, lp.ctx)
    }
    for mf : Str in lp.mode_files {
        lazy_stmt_inline_walk(lp.ctx.imported[mf].ast, lp.ctx.scope, 0, lp.ctx)
    }
    // Pass 2: expression inlining of (now exposed) inlinable lazy calls.
    for upath : Str in lp.unit_paths() {
        expand_lazy_in_expr(lp.ctx.imported[upath].ast, lp.ctx.scope, 0, lp.ctx)
    }
    for mf : Str in lp.mode_files {
        expand_lazy_in_expr(lp.ctx.imported[mf].ast, lp.ctx.scope, 0, lp.ctx)
    }
}

// --- #154 prototype: unused-import check (--check-unused-imports) ---
//
// One entry per explicit import stmt in a user unit, snapshotted BEFORE
// desugar_namespace_imports rewrites `name := import(...)` decls into
// local ns structs -- the AST-position -> iu.imports mapping is only
// 1:1 while both forms are still in the AST.
priv ImportCheckEntry := struct {
    path := ""       // importing unit's display path
    line : U32 = 0
    col : U32 = 0
    label := ""      // import path literal as written, for the message
    dep := ""        // resolved display path of the imported file
    decl_name := ""  // non-empty for `name := import(...)` form
}

// True when imp_stmt is an import FCall of the exact shape that
// count_ast_imports counts (so the caller's import_idx stays in step
// with iu.imports); writes the path literal into label on success.
priv import_stmt_label := func(imp_stmt: Expr, mut label: Str) returns Bool {
    if imp_stmt.children.len() < 2 { return false }
    if imp_stmt.children[1].node_type.is_literal_str().not() { return false }
    mut is_imp := false
    switch imp_stmt.children[0].node_type {
    case .Ident(id):
        if id.ident_name() == "import" { is_imp = true }
    case:
    }
    if is_imp.not() { return false }
    switch imp_stmt.children[1].node_type {
    case .Literal(Literal.Str(p)):
        label = p.clone()
    case:
    }
    return true
}

priv collect_import_check_entries := func(unit_path: Str, iu: ImportUnit, mut entries: Vec(ImportCheckEntry)) {
    // Leading iu.imports entries with no matching AST stmt are
    // loader-injected (mode auto-imports); skip them, mirroring
    // type_bodies_file's auto_count logic.
    ast_count : USize = count_ast_imports(iu.ast)
    mut import_idx : USize = iu.imports.len() - ast_count
    for stmt : Expr in iu.ast.children {
        mut decl_name := ""
        mut label := ""
        mut is_imp := false
        if stmt.node_type.is(NodeType.Decl).and(stmt.children.len().gt(0)) {
            if stmt.children[0].node_type.is(NodeType.FCall) {
                is_imp = import_stmt_label(stmt.children[0], label)
                if is_imp {
                    switch stmt.node_type {
                    case .Decl(dd):
                        decl_name = dd.name.clone()
                    case:
                    }
                }
            }
        } else if stmt.node_type.is(NodeType.FCall) {
            is_imp = import_stmt_label(stmt, label)
        }
        if is_imp.not() { continue }
        ref dep : Str = iu.imports[import_idx]
        import_idx++
        entries.push(own ImportCheckEntry(path = unit_path.clone(),
            line = stmt.line, col = stmt.col, label = label.clone(),
            dep = dep.clone(), decl_name = decl_name.clone()))
    }
}

// An explicit import whose file contributed no symbol read from the
// importing file is flagged. `_name := import(...)` opts out -- the
// same _-prefix convention as unused params/locals (#86). A used
// `name := import(...)` alias needs no special case: its `name.sym`
// uses are rewritten to direct references at desugar time, so they
// produce ordinary cross-file use edges.
priv check_unused_imports_collected := proc(entries: Vec(ImportCheckEntry), mut ctx: Context) returns I32 {
    mut found : I32 = 0
    for ent : ImportCheckEntry in entries {
        if ent.decl_name.starts_with("_") { continue }
        is_used := ctx.import_use_edges.has(format(ent.path, "|", ent.dep))
        if is_used.not() {
            type_error_at(ent.path, ent.line, ent.col,
                format("unused import '", ent.label, "'"), ctx)
            found++
        }
    }
    return found
}

type_program_errors := proc(mut lp: LoadedProgram, run_tests: Bool) returns I32 {
    lp.run_tests = run_tests.or(lp.cur_mode.run_tests)

    // #192: register target-dependent USize/UPtr widths before any
    // init/typer resolution, so every position resolves them uniformly
    // to the per-target primitive. lp.target is final here (after any
    // --target override).
    context_register_target_int_alias_types(lp.ctx, target_int_alias_name(lp, "USize", target_usize_name(lp.target)), target_int_alias_name(lp, "UPtr", target_uptr_name(lp.target)))

    // #154 prototype: snapshot every explicit import stmt per user unit
    // before the namespace-import desugar below rewrites the decl form
    // away. Core units are exempt -- aggregators like core.til import
    // to re-export by design.
    mut import_check_entries := Vec(ImportCheckEntry).new()
    if lp.ctx.check_unused_imports {
        for icu : ProgramUnit in lp.units {
            collect_import_check_entries(icu.path, lp.ctx.imported[icu.path], import_check_entries)
        }
    }

    // Desugar namespace imports BEFORE init_file runs, so the initer
    // only ever sees direct references to the original decls.
    for upath : Str in lp.unit_paths() {
        desugar_namespace_imports(upath, lp.ctx.imported[upath], lp.ctx)
    }
    // An `alias.member` the alias does not export is left unrewritten, so the
    // initer would walk a FieldAccess whose base names no value. Stop here:
    // the message is already out, and one error beats a cascade of confused
    // follow-ups.
    if lp.ctx.errors > 0 { return lp.ctx.errors }

    // Issue #158: the typer populates the foldable-name sets via
    // constfolder_classify_stmt, called inline from type_decls_file's
    // per-decl walk (and the lifted-lambda tail in type_check_unit), which
    // finish for the whole import graph before any body is typed -- see
    // #315. Clear any stale state up front so a fresh build (or REPL
    // re-eval reusing this Context) starts clean.
    constfolder_reset_state(lp.ctx)

    // Init phase (rstil-style): recursive imports per file.
    context_reset_type_scope(lp.ctx)
    if lp.skip_core.not() {
        init_file(lp.core_units[lp.core_units.len() - 1].path, lp.ctx)
    }
    ref user_root : ProgramUnit = lp.units[lp.units.len() - 1]
    init_file(user_root.path, lp.ctx)
    for mode_file : Str in lp.mode_files {
        init_file(mode_file, lp.ctx)
    }

    // Global init steps: these generate methods/layouts that later phases
    // assume exist (e.g. comparison helpers on USize).
    for upath : Str in lp.unit_paths() {
        ref mut iu : ImportUnit = lp.ctx.imported[upath]
        lp.ctx.mode = iu.mode.clone()
        context_enter_file(lp.ctx, upath)
        init_declarations_global(lp.ctx, iu.ast, lp.ctx.scope)
    }

    retarget_loaded_aliases(lp)

    // Ensure ctx.path is set to the user entrypoint by default.
    if lp.units.len() > 0 {
        context_enter_file(lp.ctx, lp.units[lp.units.len() - 1].path)
    }

    // #165 step 1: resolve any Type.Custom(name) bindings (written by
    // initer's scope-free registration helpers) to Struct/Enum now that
    // every name is in scope.
    normalize_scope_bindings(lp.ctx.scope)

    // Issue #262: inline lazy_func / lazy_proc calls before type-checking so
    // the spliced bodies (and the short-circuit `match` inside them) are
    // typed and lowered as ordinary code.
    expand_lazy_calls_in_program(lp)

    // Register + extend every throwing function's signature across ALL
    // units BEFORE any body type-checking. The per-file pass inside
    // type_check_unit runs during the bodies sweep in import-topological
    // order, which is too late for a caller whose throwing callee lives
    // in a unit typed later: e.g. constfolder.til (typed before
    // interpreter.til, since loader imports constfolder and interpreter
    // imports loader) catching interpreter's `scope_get`. Doing it here
    // makes ctx.throws_global complete -- and every throwing callee's
    // params already err-out-extended -- for every call site in the
    // program. extend_throwing_func_sigs is idempotent, so the
    // per-unit call in the bodies sweep is a no-op re-walk.
    for upath : Str in lp.unit_paths() {
        extend_throwing_func_sigs(lp.ctx, lp.ctx.imported[upath].ast)
    }

    // #303 / #321: settle core/exit.til's noreturn chain first (see
    // seed_noreturn_chain) so units typed before it still see panic as
    // diverging.
    if lp.skip_core.not() {
        for u : ProgramUnit in lp.core_units {
            if u.path.ends_with("core/exit.til") {
                seed_noreturn_chain(lp.ctx.imported[u.path].ast)
            }
        }
    }

    // Type checking (rstil-style): recursive imports per file.
    mut type_errors : I32 = 0
    if lp.skip_core.not() {
        type_errors = type_errors.add(type_file(lp.core_units[lp.core_units.len() - 1].path, lp.ctx))
    }
    type_errors = type_errors + type_file(user_root.path, lp.ctx)
    // Issue #187 step 1: priv top-level decls that nothing in the
    // file references are dead code -- no importer can reach them.
    type_errors = type_errors + check_unused_priv_top_level(lp.ctx.scope, lp.ctx)
    // Issue #187 steps 2-3: priv struct fields and namespace members
    // that no code in the struct's own namespace ever reads. Walk
    // every loaded unit's AST.
    for upath : Str in lp.unit_paths() {
        type_errors = type_errors + check_unused_priv_members_in_program(lp.ctx.imported[upath].ast, upath, lp.ctx)
    }
    for mode_file : Str in lp.mode_files {
        type_errors = type_errors + type_file(mode_file, lp.ctx)
    }

    // Issue #328: prove the invariant the retirement below depends on --
    // no call is still bound to a generic source. Only when nothing else
    // failed: a rejected inference leaves its callee generic on purpose,
    // and reporting it twice would bury the focused diagnostic.
    if type_errors == 0 {
        for upath : Str in lp.unit_paths() {
            context_enter_file(lp.ctx, upath)
            type_errors = type_errors + init_scan_unresolved_generic_calls(lp.ctx.imported[upath].ast, lp.ctx.scope, lp.ctx)
        }
        for mfs : Str in lp.mode_files {
            context_enter_file(lp.ctx, mfs)
            type_errors = type_errors + init_scan_unresolved_generic_calls(lp.ctx.imported[mfs].ast, lp.ctx.scope, lp.ctx)
        }
    }

    // Issue #328: every body -- including the mode files -- is typed, so
    // no call can still be bound to a generic source. Retire the source
    // templates (AST declaration plus scope entries) before the pointer
    // refresh below, so the backends only ever see concrete declarations.
    // All units share the root TypeScope, so rebuild its lookup filters once
    // after the whole retirement batch rather than once per unit.
    mut retired_generic_sources := false
    for upath : Str in lp.unit_paths() {
        if init_retire_generic_sources(lp.ctx.imported[upath].ast, lp.ctx.scope) {
            retired_generic_sources = true
        }
    }
    for mfg : Str in lp.mode_files {
        if init_retire_generic_sources(lp.ctx.imported[mfg].ast, lp.ctx.scope) {
            retired_generic_sources = true
        }
    }
    if retired_generic_sources { lp.ctx.scope.refresh_lookup_filters() }

    // Typing can APPEND top-level decls to unit ASTs (lifted lambdas,
    // monomorphized Array__T/Vec__T defs); an append that reallocs a
    // children Vec moves every node in it, dangling the func_def /
    // struct_def pointers the scope registered against the old storage.
    // Re-point them all so the builder's emit-time lookups are fresh.
    for upath : Str in lp.unit_paths() {
        init_refresh_seeded_scope_defs(lp.ctx.imported[upath].ast, lp.ctx.scope)
    }
    for mfr : Str in lp.mode_files {
        init_refresh_seeded_scope_defs(lp.ctx.imported[mfr].ast, lp.ctx.scope)
    }

    // #154 prototype: flag user-unit imports that contributed no used
    // symbol (opt-in via --check-unused-imports).
    if lp.ctx.check_unused_imports {
        type_errors = type_errors + check_unused_imports_collected(import_check_entries, lp.ctx)
    }

    if type_errors > 0 {
        return type_errors
    }

    return 0
}

finish_init_and_type_program := proc(mut lp: LoadedProgram) {
    // Asap-destruction phase. Walks every imported file's program
    // body and inserts the Type.delete() / free() calls for owned
    // globals. Sub-body asap (function bodies + nested if/while/
    // block/catch scopes) still runs inline from the typer's
    // scope-management sites because per-body scopes are stack
    // locals; issue #204 step 3b covers lifting those too.
    garbager_destroy(lp.ctx)
    // All typing (and with it every constfold eval) is done; no more
    // interpreter scopes are created on the compile paths, so release the
    // Scope boxes the constfold evals parked in the pool. The interpret
    // path drains again in interp_session_free.
    constfolder_clear_known(lp.ctx)
    scope_pool_drain()
}

init_and_type_program_errors := proc(mut lp: LoadedProgram, run_tests: Bool) returns I32 {
    type_errors := type_program_errors(lp, run_tests)
    if type_errors > 0 { return type_errors }
    finish_init_and_type_program(lp)
    return 0
}

init_and_type_program := proc(mut lp: LoadedProgram, run_tests: Bool) {
    type_errors := init_and_type_program_errors(lp, run_tests)
    if type_errors > 0 {
        println(type_errors.to_str(), " type error(s) found")
        exit(1)
    }
}

finish_prepare_program := proc(mut lp: LoadedProgram) {
    constfolder_imported(lp)
    // #326: libraries are scavenged like every other mode. They used to be
    // skipped entirely, which is why a 20-line `mode pure` file emitted the
    // whole of core and std -- 21,264 lines of C, 724 functions, 445 of
    // them never called, including the compiler's own Expr/NodeType model.
    // Their roots are their EXPORTED declarations (seed_library_roots): a
    // consumer can call any of them and there is no main to reach them
    // from, so the public ABI is preserved exactly while priv declarations
    // and untouched core/std are swept.
    validate_cli_main(lp)
    scavenge_imported(lp)
}

// #326: a REPL full-load turn must NOT scavenge. A session is an open
// world -- the next turn can name anything -- and
// interp_session_eval_imported_once runs an imported unit's top-level
// exactly once per session, keyed by path: if the turn that first evals
// std/doc is one with no help() in sight, scavenging would have swept the
// (statically dead) __til_info_blob__/__til_docs_blob__ globals from its
// AST, the once-only eval declares nothing, and the later help() turn's
// __doc_init__ assignment finds no binding. Same reasoning as the cached
// base in repl_init_cached_program.
repl_finish_prepare_program := proc(mut lp: LoadedProgram) {
    constfolder_imported(lp)
}

repl_init_cached_program := proc(mut lp: LoadedProgram) returns I32 {
    type_errors := type_program_errors(lp, false)
    if type_errors > 0 { return type_errors }
    finish_init_and_type_program(lp)
    // The cached empty REPL base must keep core/user definitions alive for
    // later deltas; full prepare would scavenge them as unused in the empty
    // root and leave scope.func_defs pointing at deleted AST nodes.
    constfolder_imported(lp)
    repl_reregister_scope_defs_loaded(lp)
    repl_classify_foldables_loaded(lp)
    return 0
}

repl_type_delta_program := proc(mut lp: LoadedProgram, mut delta: Expr) returns I32 {
    lp.run_tests = lp.cur_mode.run_tests
    context_register_target_int_alias_types(lp.ctx, target_int_alias_name(lp, "USize", target_usize_name(lp.target)), target_int_alias_name(lp, "UPtr", target_uptr_name(lp.target)))
    ref root : ProgramUnit = lp.units[lp.units.len() - 1]
    ref iu : ImportUnit = lp.ctx.imported[root.path]
    lp.ctx.mode = iu.mode.clone()
    context_enter_file(lp.ctx, root.path)

    init_errors := init_repl_delta(root.path, delta, lp.ctx)
    if init_errors > 0 { return init_errors }

    retarget_loaded_aliases(lp)
    normalize_scope_bindings(lp.ctx.scope)
    lazy_stmt_inline_walk(delta, lp.ctx.scope, 0, lp.ctx)
    expand_lazy_in_expr(delta, lp.ctx.scope, 0, lp.ctx)

    type_errors := type_repl_delta(root.path, delta, lp.ctx)
    if type_errors > 0 { return type_errors }
    // Same follow-up infer_body does after the pre-passes: RE-REGISTER the
    // scope defs, do not re-type. body_pre_passes desugars and hoists the
    // body it just walked, and the typer is not idempotent over its own
    // output -- a struct ctor's `NamedArg(f) -> value` children are rewritten
    // into hoisted temps, so a second pass sees bare positional args and
    // reports "struct instantiation requires named arguments" for code that
    // typed cleanly the first time. That is why `c := Color(r = 255, g = 0,
    // b = 0, a = 255)` failed at the REPL but worked in a file: only this
    // delta path re-typed, and only turns that skip the full load reach it.
    if body_pre_passes(lp.ctx, delta, lp.ctx.scope, 1) {
        reregister_repl_scope_defs(delta, lp.ctx.scope)
    }
    garbager_destroy_body(lp.ctx, delta, lp.ctx.scope)
    return 0
}

repl_prepare_delta_program := proc(mut lp: LoadedProgram, mut delta: Expr) {
    constfolder_repl_delta(lp, delta)
    dce_program_bodies(delta)
}

prepare_program := proc(mut lp: LoadedProgram, run_tests: Bool) {
    init_and_type_program(lp, run_tests)
    finish_prepare_program(lp)
}

// --- Commands ---

cmd_ast := proc(lp: LoadedProgram) {
    println(format("mode: ", lp.mode_str))
    for u : ProgramUnit in lp.units {
        println(format("file: ", u.path))
        ref iu : ImportUnit = lp.ctx.imported[u.path]
        println(iu.ast.to_str())
    }
}
