mode lib

import("context")
import("loader")
import("c_codegen")
import("../std/sys")
import("../std/file")
import("../../vendor/bindings/libffi")
// No link() here: the libffi static lib is host-dependent (the
// configure triple dir only exists for the build host), so the builder
// appends the right archive per target via target_ffi_lib instead. A
// hardcoded Linux path made resolve_link_path fall back to a bogus
// src/self/-relative candidate on mac hosts (issue #25).

priv interp_error_path := func(ctx: Context) returns Str {
    return ctx.path.clone()
}

priv interp_error := proc(e: Expr, msg: Str, ctx: Context) {
    println(interp_error_path(ctx), ":", e.line.to_str(), ":", e.col.to_str(), ": error: ", msg)
}

priv interp_lang_error := proc(e: Expr, msg: Str, ctx: Context) {
    interp_error(e, msg, ctx)
    println("  note: this is a bug in the language, please report it")
}

// True when a struct has a byte layout that a raw memcpy clones correctly --
// i.e. no field contains an owned heap pointer that would alias. This is the
// interpreter-side POD predicate; it is
// strictly more conservative than initer's is_pod_type_for_clone
// because enum payload bytes can themselves own nested heap.
// Issue #147 step 4: replaces dd.field_struct_def reads. Returns the
// nested struct/enum def Expr for a field, or NULL when the field's
// type is a primitive (primitives are registered as ~Type := struct {}~
// in core, so a bare lookup_interp_type_def would return the primitive's
// struct shell and downstream callers would try to clone its bytes
// as a nested struct).
priv field_nested_def := func(dd: Declaration, ctx: Context) returns Option(ref Expr) {
    resolved := declaration_resolved_type(dd, ctx.scope, ctx.symbols)
    if is_primitive(resolved) { return Option(ref Expr).None }
    return lookup_interp_type_def(resolved_type_name(resolved, ctx.symbols), ctx)
}

priv decl_is_funcsig := func(dd: Declaration, ctx: Context) returns Bool {
    resolved := declaration_resolved_type(dd, ctx.scope, ctx.symbols)
    if type_is_callable_storage(resolved) { return true }
    tdef_o := lookup_interp_type_def(resolved_type_name(resolved, ctx.symbols), ctx)
    if tdef_o.is_none() { return false }
    ref tdef : Expr = tdef_o.unwrap()
    if tdef.node_type.is(NodeType.FuncDef) {
        return tdef.children.len() == 0
    }
    return false
}

priv struct_def_shallow_safe := func(sdef_data: StructDef, ctx: Context) returns Bool {
    for dd : Declaration in sdef_data.fields {
        if dd.own_type.is(OwnType.Own) { return false }
        if dd.own_type.is(OwnType.Ref) { continue }
        if decl_is_funcsig(dd, ctx) { return false }
        if decl_type_name(dd, ctx.symbols) == "Str" { return false }
        fsd_o := field_nested_def(dd, ctx)
        if fsd_o.is_some() {
            ref fsd : Expr = fsd_o.unwrap()
            switch fsd.node_type {
            case .EnumDef:
                if enum_has_payloads(fsd) { return false }
            case .StructDef(nested_sdef):
                if struct_def_shallow_safe(nested_sdef, ctx).not() { return false }
            case:
            }
        }
    }
    return true
}

// #343: the interpreter half of the compiled TIL_CSTR macro, same
// discriminator and same message so a view reaching a C string parameter
// dies identically on both backends. Reading the byte at [count] is always
// in bounds -- every allocating Str path reserves count+1, and a view's end
// never passes its base's.
priv check_c_string_terminator := func(s_base: Dynamic, ctx: Context) {
    ref s : Str = to_ptr(s_base)
    if s.c_str.is_null() {
        panic("Str is not NUL-terminated; a C string parameter would read past its end -- clone the view first")
    }
    ref b : I8 = ptr_add(s.c_str, str_count_at(s_base, ctx).cast(U64))
    if b != 0 {
        panic("Str is not NUL-terminated; a C string parameter would read past its end -- clone the view first")
    }
}

priv str_owns_c_str := func(s_base: Dynamic, ctx: Context) returns Bool {
    ref s : Str = to_ptr(s_base)
    return s.c_str.is_null().not().and(str_cap_at(s_base, ctx).lt(CAP_VIEW)).and(str_cap_at(s_base, ctx).gt(0))
}

priv str_has_owned_storage := func(ptr: Dynamic, ctx: Context) returns Bool {
    ref s : Str = to_ptr(ptr)
    return s.c_str.is_null().not().and(str_cap_at(ptr, ctx).lt(CAP_VIEW)).and(str_cap_at(ptr, ctx).gt(0))
}

priv free_str_owned_storage := func(ptr: Dynamic, ctx: Context) {
    ref s : Str = to_ptr(ptr)
    if str_has_owned_storage(ptr, ctx) { free(own s.c_str) }
}

priv clone_str_storage_into := func(mut dst: Dynamic, src: Dynamic, ctx: Context) {
    ref s : Str = to_ptr(src)
    if str_has_owned_storage(src, ctx).not() { return }
    cnt := str_count_at(src, ctx)
    cap := str_cap_at(src, ctx)
    mut copy : I8 = malloc(cap.add(1).cast(U64))
    if cnt.gt(0) { memcpy(copy, s.c_str, cnt.cast(U64)) }
    memset(ptr_add(copy, cnt.cast(U64)), 0, 1)
    write_ptr(dst, copy)
    str_write_count_cap(dst, cnt, cap, ctx)
}

// Byte-level deep clone of a struct value at `data` of type `struct_name`.
// Returns a fresh allocation with an independent copy of every owned-pointer
// field (Str c_strs, owned struct/container fields).
priv heap_clone := func(struct_name: Str, data: Dynamic, ctx: Context) returns Dynamic {
    // Look the def up by name while the interpreted AST is live.
    ref struct_def : Expr = lookup_interp_type_def(struct_name, ctx).unwrap()
    ref sdef_data : StructDef = structdef_of(struct_def)
    sz := ctx_total_size(struct_name, ctx)
    mut dst_data : Dynamic = EvalHeap.heap_alloc(sz)
    memcpy(dst_data, data, sz)
    if struct_name == "Str" {
        clone_str_storage_into(dst_data, data, ctx)
    } else if struct_name == "DynVec" {
        clone_dyn_vec_buffer(data, dst_data, ctx)
    } else if struct_name == "DynArray" {
        clone_dyn_array_buffer(data, dst_data, ctx)
    } else if struct_name == "DynSet" {
        clone_dyn_set_buffer(data, dst_data, ctx)
    } else if container_elem_type(struct_name, ctx).len() > 0 {
        clone_container_buffer(struct_name, data, dst_data, ctx)
    } else if struct_def_shallow_safe(sdef_data, ctx) {
    } else {
        // sl.fields is positionally parallel to sdef_data.fields
        // (compute_struct_layout walks the same vec in the same order),
        // so the layout row comes straight from the field's position --
        // no per-field name probe.
        ref hc_sl : StructLayout = ctx.struct_layouts[struct_name]
        mut cfi : USize = 0
        for dd : Declaration in sdef_data.fields {
            ref hc_fl : FieldLayout = hc_sl.fields.unsafe_get(cfi)
            foff := hc_fl.offset
            cfi = cfi + 1
            ftype := resolved_type_name(declaration_resolved_type(dd, ctx.scope, ctx.symbols), ctx.symbols)
            nested_def_o := field_nested_def(dd, ctx)
            if dd.own_type.is(OwnType.Own) {
                if decl_is_funcsig(dd, ctx) {
                    ref src_callable : Dynamic = deref(ptr_add(data, foff))
                    if src_callable.is_null().not() {
                        write_ptr(ptr_add(dst_data, foff), callable_storage_clone(src_callable))
                    }
                    continue
                }
                ref src_ptr : Dynamic = deref(ptr_add(data, foff))
                if src_ptr.is_null().not() {
                    if nested_def_o.is_some() {
                        ref nested_def : Expr = nested_def_o.unwrap()
                        if nested_def.node_type.is(NodeType.EnumDef) {
                            cloned_enum : Dynamic = heap_clone_enum(ftype, src_ptr, ctx_total_size(ftype, ctx), ctx)
                            write_ptr(ptr_add(dst_data, foff), cloned_enum)
                        } else {
                            cloned_struct : Dynamic = heap_clone(ftype, src_ptr, ctx)
                            write_ptr(ptr_add(dst_data, foff), cloned_struct)
                        }
                    }
                }
                continue
            }
            if dd.own_type.is(OwnType.Ref) { continue }
            if decl_is_funcsig(dd, ctx) {
                ref src_callable2 : Dynamic = deref(ptr_add(data, foff))
                if src_callable2.is_null().not() {
                    write_ptr(ptr_add(dst_data, foff), callable_storage_clone(src_callable2))
                }
                continue
            }
            if ftype == "Str" {
                clone_str_storage_into(ptr_add(dst_data, foff), ptr_add(data, foff), ctx)
                continue
            }
            if nested_def_o.is_some() {
                ref nested_def : Expr = nested_def_o.unwrap()
                if nested_def.node_type.is(NodeType.EnumDef) {
                    if enum_has_payloads(nested_def) {
                        enum_payload_deep_clone(ftype, ptr_add(dst_data, foff), ctx)
                        continue
                    }
                }
            }
            if nested_def_o.is_some() {
                ref nested_def : Expr = nested_def_o.unwrap()
                if nested_def.node_type.is(NodeType.EnumDef).not() {
                    switch nested_def.node_type {
                    case .StructDef:
                        cloned_ptr2 : Dynamic = heap_clone(ftype, ptr_add(data, foff), ctx)
                        memcpy(ptr_add(dst_data, foff), cloned_ptr2, ctx_total_size(ftype, ctx))
                        EvalHeap.heap_free(own cloned_ptr2)
                    case:
                        UNREACHABLE("expected StructDef, got ", nested_def.node_type.head_str(ctx.symbols.names))
                    }
                }
            }
        }
    }
    if sdef_data.is_interface {
        ref owned_fl : FieldLayout = ctx_field_layout(struct_name, "iface_owned", ctx)
        ref owned : Bool = ptr_add(data, owned_fl.offset)
        if owned {
            ref type_fl : FieldLayout = ctx_field_layout(struct_name, "iface_type_name", ctx)
            ref type_name : Str = ptr_add(data, type_fl.offset)
            ref val_fl : FieldLayout = ctx_field_layout(struct_name, "iface_val", ctx)
            ref src_val : Dynamic = deref(ptr_add(data, val_fl.offset))
            cloned_val : Dynamic = heap_clone_by_type(type_from_name_init_name(type_name, ctx.scope, ctx.symbols), src_val, ctx)
            write_ptr(ptr_add(dst_data, val_fl.offset), cloned_val)
        }
    }
    if struct_name == "Tuple" {
        // The field walk above cloned type_names/type_sizes but left the
        // packed `own data: U8` element buffer aliased to src. Give dst its
        // own deep copy so free_tuple_data can reclaim it independently.
        clone_tuple_buffer(data, dst_data, ctx)
    }
    return dst_data
}

CALLABLE_BOX_MAGIC : U64 = 1414745932

// Only ever built raw on the EvalHeap (heap_alloc + field writes); the
// ctor never runs. func_def borrows the parse tree; env is OWNED
// (#321/#324) -- allocated by scope_new_owned, freed by
// callable_box_free -- and heap_alloc's zeroed block IS the niche's None,
// so a raw-built box starts honestly absent with no write at all.
InterpCallableBox := struct {
    magic : U64 = 0
    ref func_def : Expr
    env := Option(Scope).None
}

// Typed view of a binding's borrowed canonical type (see the
// til_type_p field comment). Not priv: the constfolder reads it too.
hb_type := func(hb: HeapBinding) returns ref Type {
    return to_ptr(hb.til_type_p)
}

HeapBinding := struct {
    // Non-owning address of the raw value block; ownership is described by
    // the flags below and discharged explicitly by scope teardown.
    // No default (#321): the one ctor site always passes ptr and ctx.
    // ptr is still NULLed at move-out/teardown -- that runtime state is
    // step-2 material (Option or the moved_out flag alone).
    ref ptr : U8
    // Borrowed canonical type, read via hb_type(). Points at a
    // Context-interned Type block (interp_intern_type), an ast.til TYPE_*
    // const, or another binding's (itself canonical) type -- NEVER at a
    // local, a TypeScope binding value, or an Expr stamp: those move or
    // die under map inserts and constfold rewrites. Bindings never own or
    // delete it. REM: stored as a pointer word (the `ref ptr : U8` idiom)
    // because the builder does not emit enum-typed `ref` FIELDS at arg /
    // switch sites yet; if it learns to, this can become `ref t : Type`
    // and hb_type() can go away.
    ref til_type_p : U8
    own_type := OwnType.Shallow
    ref ctx : Context
    is_local := false
    is_borrowed := false
    is_erased_dynamic := false
    is_static_callable := false
    moved_out := false
    // #302: an own-primitive binding whose ptr is a BARE raw-allocation
    // pointer (malloc family), not a boxed value block. Readers that
    // collapse prim blocks to words must skip these.
    is_raw_alloc := false
    // #275: an interpreted `<Type>.delete(x, ...)` already ran this
    // binding's destructor, so its PAYLOAD is gone. Session teardown must
    // then reclaim only the interpreter's own slot: dropping by type again
    // runs the destructor twice and frees the container's buffer twice.
    // The garbager puts exactly such a delete in the AST for every
    // script-scope binding (`Vec.delete(v, false)` -- drop the innards,
    // leave the box), which is what the compiled backend emits too.
    payload_released := false
}

Scope := struct {
    // Name -> raw value block pointer plus its type and ownership metadata.
    heap_bindings := Map(Str, HeapBinding).new()
    // Borrowed parameters name their source binding for write-through.
    heap_aliases := Map(Str, Str).new()
    // #321: None at the root scope; the chain walks outward until it
    // runs out. A genuine borrow -- scope teardown never frees the
    // parent, it only walks to it.
    parent := Option(ref Scope).None
    is_call_scope := false
}

InterpSession := struct {
    // #321/#324: the session's root scope, OWNED. It was `ref ... = NULL`
    // -- an owned pointer wearing a borrow label, freed through the #324
    // hole. One word via the owned niche; None IS the not-started state,
    // and teardown moves the scope out before scope_free.
    global := Option(Scope).None
    core_evaluated := false
    // #192: USize, not U32 -- user_argc is a count compared/combined with
    // nparam/fixed (USize) and assigned from user_argv.len() (USize). At U32
    // that matched only because USize was U32; target-dependent USize makes the
    // width mismatch a hard type error on 64-bit.
    user_argc : USize = 0
    retained_programs := Vec(DynPtrBox).new()
    // Set by the REPL driver. Copied onto each turn's Context by
    // interp_session_prepare_context so h_exit can unwind a failing turn
    // instead of terminating the session.
    is_repl := false
    // Display paths of imported (non-entry) units whose top-level globals
    // have already been evaluated into `global`. The REPL evaluates the
    // entry root incrementally but must run an imported unit's global
    // initializers once (e.g. std/doc's __til_*_blob__), the same role
    // core_evaluated plays for core_units. Keyed by path so a mid-session
    // import (added via the full-load path) is picked up on its first turn.
    evaluated_units := Set(Str).new()
}

// Return-value / control-flow state, namespace fields, and the canonical Str
// cache live in Context.eval. During has_return, return_value is a non-owning
// pointer to the raw call result.

// --- Type-def registry: maps struct/enum names to their AST def Expr.
// Populated by interpreter_init_ns from every struct/enum decl seen in core+user
// programs. Replaces dangerous Declaration.field_struct_def reads at use sites.
// (#147 anti-pattern catalog: layout cache on AST nodes / dangerous refs.)
// The map itself lives on Context (ctx.interp_type_defs); this reader
// reaches it through codegen_lp(), which interpret_units installs
// before any eval runs.
lookup_interp_type_def := func(name: Str, ctx: Context) returns Option(ref Expr) {
    ref slot : Dynamic = ctx.interp_type_defs.get(name)?
    catch (e: KeyNotFound) { return Option(ref Expr).None }
    ref td : Expr = deref(slot)
    return safe_ref(td)
}


priv enum_variant_index_for_tag_key := func(enum_name: Str, etag: I64, ctx: Context) returns I32 {
    edef_o := lookup_interp_type_def(enum_name, ctx)
    if edef_o.is_none() { return -1 }
    ref edef : Expr = edef_o.unwrap()
    return enum_variant_index_for_tag(edef, etag)
}


// Issue #272: the enum's Str payload (at ENUM_PAYLOAD_OFFSET) holds a c_str
// pointer that, post-memcpy, aliases the source Str. Replace it with an
// owned deep copy so the enum no longer shares the source's buffer.
priv enum_clone_str_payload := func(mut data: Dynamic, ctx: Context) {
    ref mut payload : Dynamic = ptr_add(data, ENUM_PAYLOAD_OFFSET)
    clone_str_storage_into(payload, payload, ctx)
}

// #286 Stage 2: byte-level enum payload clone. The enum name/context supply
// payload ownership metadata; value bytes stay raw.
priv heap_clone_enum := func(enum_name: Str, data: Dynamic, data_size: USize, ctx: Context) returns Dynamic {
    mut pdata : Dynamic = EvalHeap.heap_alloc(data_size)
    memcpy(pdata, data, data_size.cast(U64))
    enum_payload_deep_clone(enum_name, pdata, ctx)
    return pdata
}

// Free the owned Str-payload c_str (set up by enum_clone_str_payload).
priv enum_free_str_payload := func(data: Dynamic, ctx: Context) {
    free_str_owned_storage(ptr_add(data, ENUM_PAYLOAD_OFFSET), ctx)
}

// Shared with constfolder's typed raw-to-AST reconstruction.
enum_data_tag_key := func(data: Dynamic, enum_def: Expr) returns I64 {
    // #320 niche: no tag is stored -- the discriminant IS whether the
    // single pointer is null, so derive the tag value from that.
    if enum_is_niche(enum_def) {
        some_idx := enum_niche_some_index(enum_def)
        // LOAD the stored pointer (deref), do not alias the slot address:
        // `ref p : Dynamic = data` would bind the address itself, which is
        // never null, so every value would read as the payload variant.
        ref stored : Dynamic = deref(data)
        mut want_idx := some_idx
        if stored.is_null() {
            want_idx = 0
            if some_idx == 0 { want_idx = 1 }
        }
        return enum_variant_tag_at(enum_def, want_idx)
    }
    tag_w := enum_tag_size(enum_def)
    if tag_w == 1 { ref t : U8 = data; return t.to_i64() }
    if tag_w == 2 { ref t : U16 = data; return t.to_i64() }
    if tag_w == 8 { ref t : I64 = data; return t.clone() }
    ref t : I32 = data
    return t.cast(I64)
}

// #321 step 2: "this variant carries no payload" is a real, expected
// state -- the walkers below branch on it -- so it is an Option, not a
// null ref.
priv enum_payload_type_ref := func(enum_name: Str, data: Dynamic, ctx: Context) returns Option(ref Str) {
    edef_o := lookup_interp_type_def(enum_name, ctx)
    if edef_o.is_none() { return Option(ref Str).None }
    ref edef : Expr = edef_o.unwrap()
    switch edef.node_type {
    case .EnumDef(edd):
        idx := enum_variant_index_for_tag_key(enum_name, enum_data_tag_key(data, edef), ctx)
        if idx < 0 { return Option(ref Str).None }
        ref vd : VariantDef = edd.variants[idx.to_usize()]
        if vd.payload_type.len() > 0 { return safe_ref(vd.payload_type) }
    case:
    }
    return Option(ref Str).None
}

// #320: true when the CURRENT variant (by the tag stored in `data`) carries
// a ref payload -- a borrowed pointer the enum does not own, which the
// deep-clone/deep-free walkers must skip.
priv enum_payload_is_ref := func(enum_name: Str, data: Dynamic, ctx: Context) returns Bool {
    edef_o := lookup_interp_type_def(enum_name, ctx)
    if edef_o.is_none() { return false }
    ref edef : Expr = edef_o.unwrap()
    idx := enum_variant_index_for_tag_key(enum_name, enum_data_tag_key(data, edef), ctx)
    if idx < 0 { return false }
    return enum_variant_payload_ref(edef, idx)
}

// #321: is this enum laid out as a niche, by NAME? The raw-layer walkers
// carry the enum's name rather than its def, and a niche's payload does not
// sit at ENUM_PAYLOAD_OFFSET -- the enum stores a POINTER to it at offset 0.
priv enum_name_is_niche := func(enum_name: Str, ctx: Context) returns Bool {
    edef_o := lookup_interp_type_def(enum_name, ctx)
    if edef_o.is_none() { return false }
    return enum_is_niche(edef_o.unwrap())
}

priv enum_payload_deep_free := func(enum_name: Str, mut data: Dynamic, ctx: Context) {
    mut payload_type := ""
    switch enum_payload_type_ref(enum_name, data, ctx) {
    case .Some(pt): payload_type = pt.clone()
    case .None: return
    }
    // #320: a ref payload is a borrowed pointer -- nothing to free.
    if enum_payload_is_ref(enum_name, data, ctx) { return }
    if payload_type == "Str" { enum_free_str_payload(data, ctx); return }
    resolved := type_from_name_init_name(payload_type, ctx.scope, ctx.symbols)
    if resolved.is(Type.Primitive).or(resolved.is(Type.Dynamic)).or(resolved.is_funcptr()).or(resolved.is(Type.Body)) { return }
    payload_def_o := lookup_interp_type_def(payload_type, ctx)
    if payload_def_o.is_none() { panic("enum payload has no registered type def: ", payload_type) }
    ref payload_def : Expr = payload_def_o.unwrap()
    // #321: an OWNED payload of a niche enum is its own box hanging off the
    // stored pointer, not bytes inside the enum. Free the box too -- a
    // tagged payload's storage IS the enum's, so there is nothing extra to
    // reclaim there. (A BORROWED slot payload already returned above.)
    if enum_name_is_niche(enum_name, ctx) {
        ref niche_slot : Dynamic = deref(data)
        if niche_slot.is_null() { return }
        // Rebind by value: heap_free takes the box as `own`, and a ref
        // binding cannot be handed to an own parameter.
        mut niche_box : Dynamic = niche_slot
        switch payload_def.node_type {
        case .StructDef:
            heap_drop_struct(payload_type, niche_box, ctx)
        case .EnumDef:
            enum_payload_deep_free(payload_type, niche_box, ctx)
        case:
            panic("enum payload is not a struct or enum: ", payload_type)
        }
        EvalHeap.heap_free(own niche_box)
        write_ptr(data, bits_word(0))
        return
    }
    ref mut payload_data : Dynamic = ptr_add(data, ENUM_PAYLOAD_OFFSET)
    switch payload_def.node_type {
    case .StructDef:
        heap_drop_struct(payload_type, payload_data, ctx)
    case .EnumDef:
        enum_payload_deep_free(payload_type, payload_data, ctx)
    case:
        panic("enum payload is not a struct or enum: ", payload_type)
    }
}

priv enum_payload_deep_clone := func(enum_name: Str, mut data: Dynamic, ctx: Context) {
    mut payload_type := ""
    switch enum_payload_type_ref(enum_name, data, ctx) {
    case .Some(pt): payload_type = pt.clone()
    case .None: return
    }
    // #320: a ref payload is a borrowed pointer -- the copy shares the
    // pointee; never deep-clone it.
    if enum_payload_is_ref(enum_name, data, ctx) { return }
    if payload_type == "Str" { enum_clone_str_payload(data, ctx); return }
    resolved := type_from_name_init_name(payload_type, ctx.scope, ctx.symbols)
    if resolved.is(Type.Primitive).or(resolved.is(Type.Dynamic)).or(resolved.is_funcptr()).or(resolved.is(Type.Body)) { return }
    payload_def_o := lookup_interp_type_def(payload_type, ctx)
    if payload_def_o.is_none() { panic("enum payload has no registered type def: ", payload_type) }
    ref payload_def : Expr = payload_def_o.unwrap()
    // #321: the copy of a niche enum needs its OWN box -- the clone stores a
    // fresh pointer rather than copying bytes into shared storage. Sharing
    // the original's box would double-free it.
    if enum_name_is_niche(enum_name, ctx) {
        ref niche_src : Dynamic = deref(data)
        if niche_src.is_null() { return }
        cloned_box : Dynamic = heap_clone_by_type(resolved, niche_src, ctx)
        write_ptr(data, cloned_box)
        return
    }
    ref mut payload_data : Dynamic = ptr_add(data, ENUM_PAYLOAD_OFFSET)
    switch payload_def.node_type {
    case .StructDef:
        cloned_payload : Dynamic = heap_clone(payload_type, payload_data, ctx)
        memcpy(payload_data, cloned_payload, ctx_total_size(payload_type, ctx))
        EvalHeap.heap_free(own cloned_payload)
    case .EnumDef:
        enum_payload_deep_clone(payload_type, payload_data, ctx)
    case:
        panic("enum payload is not a struct or enum: ", payload_type)
    }
}

// #286 Stage 2: drop nested heap owned by an enum payload.
priv heap_drop_enum := func(enum_name: Str, mut data: Dynamic, ctx: Context) {
    if data.is_null() { return }
    enum_payload_deep_free(enum_name, data, ctx)
}

priv write_enum_flat := func(mut data: Dynamic, enum_name: Str, etag: I64, mut payload_data: Dynamic, payload_size: USize, str_payload: Bool, move_src: Bool, ctx: Context) {
    // The interpreter's flat enum value places the payload at the fixed
    // ENUM_PAYLOAD_OFFSET (8), independent of the C struct's tighter layout.
    // dispatch_result_alloc reserves that flat layout for every enum result.
    // #264 follow-up: write the enum's full tag width (1/2/4/8 bytes) so a
    // >32-bit U64 tag is stored intact. til's memcpy(dest, value, n) copies
    // the n low bytes of `etag`. REM: an anon / macro-generated enum is not
    // name-registered, so the lookup legitimately misses -- such enums are the
    // historical default width (4 bytes).
    tedef_o := lookup_interp_type_def(enum_name, ctx)
    // #320 niche: the value IS one pointer at offset 0 -- no tag to write,
    // and the payload-less variant is written as null. The ctor path fills
    // the Some pointer itself (see the ref-payload branch in
    // enum_method_dispatch), so here None just zeroes the slot.
    mut tag_w : USize = 4
    switch tedef_o {
    case .Some(tedef):
        if enum_is_niche(tedef) {
            write_ptr(data, bits_word(0))
            return
        }
        tag_w = enum_tag_size(tedef)
    case .None:
    }
    memcpy(data, etag, tag_w.cast(UPtr))
    if payload_data.is_null().not() {
        if payload_size > 0 {
            memcpy(ptr_add(data, ENUM_PAYLOAD_OFFSET), payload_data, payload_size)
            // move_src (construction): MOVE nested ownership into the enum.
            // Non-move reads clone nested payload storage so source and value
            // each own independent buffers.
            if move_src {
                if str_payload { write_ptr(payload_data, bits_word(0)) }
            } else {
                enum_payload_deep_clone(enum_name, data, ctx)
            }
        }
    }
}

priv elem_size_for_type := func(type_name: Str, ctx: Context) returns USize {
    return raw_type_size(type_from_name_init_name(type_name, ctx.scope, ctx.symbols), ctx)
}

// Parse a single CLI argument string into raw storage of the named type. Kept in
// lockstep with the builder's cli_box_expr (src/self/builder.til): same type
// set, same reject-non-true/false Bool handling, and a non-zero exit on a bad
// value or unsupported type, so `til interpret` and compiled binaries agree.
// (panic exits 1 like the compiled backend's exit(1); the diagnostic stream
// differs -- interpreter via panic, compiled via stderr -- but both bail.)
priv parse_cli_arg := func(s: Str, type_name: Str, ctx: Context) returns Dynamic {
    t := type_from_name_init_name(type_name, ctx.scope, ctx.symbols)
    mut result : Dynamic = dispatch_result_alloc(t, ctx)
    switch type_name {
    case "Str": dispatch_write_str(result, s.c_str, s.count, ctx); return result
    case "I64": write_i64(result, s.to_i64()); return result
    case "U8":  write_u8(result, s.to_u8()); return result
    case "I8":  write_i8(result, s.to_i8()); return result
    case "I16": write_i16(result, s.to_i16()); return result
    case "U16": write_u16(result, s.to_u16()); return result
    case "I32": write_i32(result, s.to_i32()); return result
    case "U32": write_u32(result, s.to_u32()); return result
    case "U64": write_u64(result, s.to_u64()); return result
    case "USize":
        ref width : Str = resolve_type_alias(ctx.scope, "USize", ctx.symbols)
        if width == "U32" { write_u32(result, s.to_u32()) }
        else { write_u64(result, s.to_u64()) }
        return result
    case "UPtr":
        ref width : Str = resolve_type_alias(ctx.scope, "UPtr", ctx.symbols)
        if width == "U32" { write_u32(result, s.to_u32()) }
        else { write_u64(result, s.to_u64()) }
        return result
    case "F32": write_f32(result, s.to_f32()); return result
    case "F64": write_u64(result, str_parse_f64_bits(s)); return result
    case "Bool":
        if s == "true" { write_bool(result, true); return result }
        if s == "false" { write_bool(result, false); return result }
        panic("cannot parse '", s, "' as Bool (expected true/false)")
    case:
    }
    panic("unsupported CLI argument type '", type_name, "'")
    return result
}

// #321: an ext function's ref-Str result is a COPY only when the callee
// actually DECLARES a Str return -- that is the C-buffer case this rule
// exists for. A callee declaring `returns ref Dynamic` (deref, to_ptr) is
// laundering a pointer into memory the program already owns, and the
// stamped Str comes from the CALLER (make_payload_ref_decl pre-types the
// deref wrapper with the payload type). Treating those as copies made the
// interpreter free a BORROWED Str payload: `Option(ref Str)` corrupted the
// heap in interpreted mode while compiling and running fine.
// An ext callee hands back a C-owned Str buffer
// only when it declares one. `returns ref Dynamic` is pointer laundering.
priv ext_fdef_copies_str := func(fd: FunctionDef) returns Bool {
    if fd.sig.func_type.is_ext().not() { return false }
    return fd.sig.return_type == "Str"
}

priv resolved_call_result_is_ref := func(shallow result_type: Type, fn_def: Expr, ctx: Context) returns Bool {
    switch fn_def.node_type {
    case .FuncDef(fd):
        if fd.sig.return_own_type.is(OwnType.Ref).not() { return false }
        if is_struct_type(result_type) {
            if (type_name_of(result_type, ctx.symbols).unwrap() == "Str").and(ext_fdef_copies_str(fd)) { return false }
        }
        return true
    case:
        return false
    }
}

// --- Inline-scalar value words ------------------------------------------
// A raw value word for a PRIMITIVE-typed expression holds the scalar's
// bytes zero-extended in the word itself (canonical: unused high bits
// zero, Bool is 0/1); with is_ref it holds the BARE storage ADDRESS
// instead. A None-typed result is the null word. Aggregates, Dynamic,
// and callables keep heap-pointer words. BINDINGS always keep a real
// heap block (hb.ptr) so refs share stable storage and FFI sees real
// addresses; words exist only between evals. This restores the old
// Value box's inline scalars (reads/temps/results allocate nothing)
// while aggregates stay raw.

raw_type_is_prim := func(shallow t: Type, ctx: Context) returns Bool {
    switch t {
    case .Primitive: return true
    case .Custom(name): return raw_type_is_prim(type_from_name_init_name(name, ctx.scope, ctx.symbols), ctx)
    case .CustomSym(csym): return raw_type_is_prim(type_from_sym_init(csym, ctx.scope, ctx.symbols), ctx)
    case:
    }
    return false
}

// Canonicalize integer bits into a value word for primitive type `t`:
// mask to the type's width (Bool to 0/1) so compares and unsigned reads
// can trust the high bits.
priv scalar_word_encode := func(shallow t: Type, bits: U64, ctx: Context) returns Dynamic {
    switch t {
    case .Primitive(prim):
        switch prim {
        case .U8:  return bits_word(bits.cast(I64).to_u8().cast(U64))
        case .I8:  return bits_word(bits.cast(I64).to_u8().cast(U64))
        case .I16: return bits_word(bits.cast(I64).to_u16().cast(U64))
        case .U16: return bits_word(bits.cast(I64).to_u16().cast(U64))
        case .I32: return bits_word(bits.to_u32().cast(U64))
        case .U32: return bits_word(bits.to_u32().cast(U64))
        case .F32: return bits_word(bits.to_u32().cast(U64))
        case .Bool:
            if bits == 0 { return bits_word(0) }
            return bits_word(1)
        case: return bits_word(bits)
        }
    case .Custom(name): return scalar_word_encode(type_from_name_init_name(name, ctx.scope, ctx.symbols), bits, ctx)
    case .CustomSym(csym): return scalar_word_encode(type_from_sym_init(csym, ctx.scope, ctx.symbols), bits, ctx)
    case:
    }
    panic("scalar_word_encode on non-primitive: ", til_type_name_c(t))
    return bits_word(0)
}

// Load a scalar's bytes at `addr` into a canonical inline word.
scalar_word_load := func(shallow t: Type, addr: Dynamic, ctx: Context) returns Dynamic {
    switch t {
    case .Primitive(prim):
        switch prim {
        case .U8:   ref v : U8 = addr;  return bits_word(v.cast(U64))
        case .I8:   ref v : U8 = addr;  return bits_word(v.cast(U64))
        case .I16:  ref v : U16 = addr; return bits_word(v.cast(U64))
        case .U16:  ref v : U16 = addr; return bits_word(v.cast(U64))
        case .I32:  ref v : U32 = addr; return bits_word(v.cast(U64))
        case .U32:  ref v : U32 = addr; return bits_word(v.cast(U64))
        case .F32:  ref v : U32 = addr; return bits_word(v.cast(U64))
        case .Bool: ref v : U8 = addr;  return bits_word(v.cast(U64))
        case: ref v : U64 = addr; return bits_word(v.clone())
        }
    case .Custom(name): return scalar_word_load(type_from_name_init_name(name, ctx.scope, ctx.symbols), addr, ctx)
    case .CustomSym(csym): return scalar_word_load(type_from_sym_init(csym, ctx.scope, ctx.symbols), addr, ctx)
    case:
    }
    panic("scalar_word_load on non-primitive: ", til_type_name_c(t))
    return bits_word(0)
}

// ctx.struct_layouts is deliberately HOST width (initer #192: the
// compile-time interpreter operates on host-laid-out struct bytes), while
// a USize/UPtr field's til_type resolves to the TARGET primitive. Field
// scalar accesses must use the LAYOUT width: an 8-byte access at a 4-byte
// host slot merges the neighbouring field (--usize=64 count/cap pairs).
// USize/UPtr are the only width-varying prims and both are unsigned, so
// the substitute type is U32/U64 by the layout size.
field_word_type := func(shallow ft: Type, field_size: USize, ctx: Context) returns Type {
    if raw_type_size(ft, ctx) == field_size { return ft.clone() }
    if field_size == 4 { return Type.Primitive(Primitive.U32) }
    if field_size == 8 { return Type.Primitive(Primitive.U64) }
    return ft.clone()
}

// Store an inline word's scalar at `addr` (the type's exact width).
priv scalar_word_store := func(shallow t: Type, mut addr: Dynamic, w: Dynamic, ctx: Context) {
    bits := word_bits(w)
    switch t {
    case .Primitive(prim):
        switch prim {
        case .U8:   write_u8(addr, bits.cast(I64).to_u8())
        case .I8:   write_u8(addr, bits.cast(I64).to_u8())
        case .I16:  write_u16(addr, bits.cast(I64).to_u16())
        case .U16:  write_u16(addr, bits.cast(I64).to_u16())
        case .I32:  write_u32(addr, bits.to_u32())
        case .U32:  write_u32(addr, bits.to_u32())
        case .F32:  write_u32(addr, bits.to_u32())
        case .Bool: write_u8(addr, bits.cast(I64).to_u8())
        case: write_u64(addr, bits)
        }
        return
    case .Custom(name): scalar_word_store(type_from_name_init_name(name, ctx.scope, ctx.symbols), addr, w, ctx); return
    case .CustomSym(csym): scalar_word_store(type_from_sym_init(csym, ctx.scope, ctx.symbols), addr, w, ctx); return
    case:
    }
    panic("scalar_word_store on non-primitive: ", til_type_name_c(t))
}

// Result placeholder for intercepts and value-less falls: primitive,
// None, and Unknown-typed results are the null word (no allocation);
// aggregates still get a zeroed block of their size.
priv raw_unit_result := func(shallow t: Type, ctx: Context) returns Dynamic {
    if t.is(Type.None).or(t.is(Type.Unknown)) { return bits_word(0) }
    if raw_type_is_prim(t, ctx) { return bits_word(0) }
    return dispatch_result_alloc(t, ctx)
}

// Fresh binding block holding the word's scalar: bindings need stable
// heap storage even though transient values ride inline.
scalar_block_from_word := func(shallow t: Type, w: Dynamic, ctx: Context) returns Dynamic {
    mut block : Dynamic = dispatch_result_alloc(t, ctx)
    scalar_word_store(t, block, w, ctx)
    return block
}

// Value-word -> binding-slot boundary: primitive VALUES box into a fresh
// block; a #302 raw-alloc POINTER (an allocator call, whatever the decl's
// own-ness, or an own-consumed rhs still stamped Dynamic) already IS a
// bare pointer and stays the slot itself. An own-consumed prim VALUE
// local (`x := 42` later passed `own`) is still a value: decide by the
// RHS, not own_type alone.
priv binding_block_from_word := func(shallow t: Type, w: Dynamic, rhs_is_pointer: Bool, ctx: Context) returns Dynamic {
    if raw_type_is_prim(t, ctx).and(rhs_is_pointer.not()) { return scalar_block_from_word(t, w, ctx) }
    return w
}

// Depth-stack of 8-byte result slots for ext/builtin dispatch with a
// primitive or None result type: handlers keep their write-into-buffer
// contract, but the buffer is a reusable stack slot instead of a heap
// block per call. Push/pop are balanced inside the dispatching frame,
// so arbitrarily nested dispatches each see their own live slot.
// The slot arenas live in fixed C-side static storage (ext.c): slot
// addresses are immortal, so no allocation, growth, or teardown can
// invalidate one while a dispatch is in flight.
DISPATCH_SCRATCH_SLOTS : USize = 4096
priv mut dispatch_scratch_depth : USize = 0

priv dispatch_scratch_push := func() returns Dynamic {
    if dispatch_scratch_depth == DISPATCH_SCRATCH_SLOTS { panic("dispatch scratch overflow") }
    off := dispatch_scratch_depth.mul(8)
    dispatch_scratch_depth = dispatch_scratch_depth + 1
    return ptr_add(dispatch_scratch_base(), off)
}

priv dispatch_scratch_pop := func() {
    dispatch_scratch_depth = dispatch_scratch_depth - 1
}

// Rotating ring of 8-byte slots that give a WORD a real address for the
// raw-memory builtins (memcmp operands, enum payload sources). Slots stay
// valid until the ring wraps; callers must take their pointers only after
// every nested eval of the same call is done (evaluate size args first).
WORD_RING_SLOTS : USize = 4096
priv mut word_ring_idx : USize = 0

priv word_ring_slot := func(shallow t: Type, w: Dynamic, ctx: Context) returns Dynamic {
    off := word_ring_idx.mul(8)
    word_ring_idx = word_ring_idx + 1
    if word_ring_idx == WORD_RING_SLOTS { word_ring_idx = 0 }
    write_u64(ptr_add(word_ring_base(), off), 0)
    scalar_word_store(t, ptr_add(word_ring_base(), off), w, ctx)
    return ptr_add(word_ring_base(), off)
}

priv RawResultInfo := struct {
    ref source_type_p : U8
    is_ref := false
    is_word := false
    arg_deref := false
}

priv raw_result_info_new := func() returns RawResultInfo {
    return RawResultInfo(source_type_p = to_ptr(TYPE_UNKNOWN))
}

priv raw_result_source_type := func(info: RawResultInfo) returns ref Type {
    return to_ptr(info.source_type_p)
}

priv set_resolved_call_result_info := func(shallow result_type: Type, fn_def: Expr, destination: Dynamic, mut info: RawResultInfo, ctx: Context) {
    info.is_ref = resolved_call_result_is_ref(result_type, fn_def, ctx)
    info.is_word = info.is_ref.not().and(destination.is_null()).and(raw_type_is_prim(result_type, ctx))
}

// Collapse an already-evaluated raw for the scalar-typed expr `e` into an
// inline word, whatever the eval produced: a word passes through, a ref
// (a BARE borrowed target address) or an erased Dynamic slot loads
// through its address. Frees an owned block raw; refs stay borrowed.
priv scalar_word_of_raw := func(raw: Dynamic, is_ref: Bool, is_word: Bool, shallow decode_type: Type, ctx: Context) returns Dynamic {
    if is_ref {
        // A ref raw is the bare target address: load through it; the
        // target still owns its storage.
        return scalar_word_load(decode_type, raw, ctx)
    }
    if is_word.not() {
        // A non-ref non-word prim-decoded eval is a Dynamic slot (a
        // prim-stamped erased result): load through its pointer and
        // reclaim the slot. (Idents never reach here -- they are refs.)
        ref addr : Dynamic = deref(raw)
        loaded : Dynamic = scalar_word_load(decode_type, addr, ctx)
        mut owned_raw : Dynamic = raw
        EvalHeap.heap_free(own owned_raw)
        return loaded
    }
    return raw
}

priv eval_scalar_arg_word_info := proc(mut s: Scope, mut e: Expr, mut info: RawResultInfo, mut ctx: Context) returns Dynamic {
    raw : Dynamic = eval_expr_raw_info(s, e, ctx, info)
    return scalar_word_of_raw(raw, info.is_ref, info.is_word, raw_result_source_type(info), ctx)
}

// Evaluate a Bool-typed argument to a til-level truth value.
priv eval_bool_arg := proc(mut s: Scope, mut e: Expr, mut ctx: Context) returns Bool {
    mut info := raw_result_info_new()
    return word_bits(eval_scalar_arg_word_info(s, e, info, ctx)) != 0
}

priv raw_block_free := func(raw: Dynamic) {
    mut owned_raw : Dynamic = raw
    EvalHeap.heap_free(own owned_raw)
}

priv raw_result_reframe := func(shallow t: Type, raw: Dynamic, from_ref: Bool, to_ref: Bool, ctx: Context) returns Dynamic {
    if from_ref == to_ref { return raw }
    if from_ref {
        // A ref result is a BARE target address; converting to a value
        // loads the primitive inline instead of cloning a block.
        if raw_type_is_prim(t, ctx) { return scalar_word_load(t, raw, ctx) }
        return heap_clone_by_type(t, raw, ctx)
    }
    if raw_type_is_prim(t, ctx) { panic("cannot reframe a primitive value as a ref: ", til_type_name_c(t)) }
    return raw
}

priv raw_result_move_into := proc(shallow t: Type, mut dst: Dynamic, src: Dynamic, return_is_ref: Bool, ctx: Context) {
    mut size : USize = 0
    switch t {
    case .None: return
    case .Primitive(prim):
        // A ref result is a BARE target address: deref-copy the scalar
        // out; the target still owns its block. A value result is the
        // inline word itself.
        if return_is_ref {
            mut align : USize = 0
            builtin_primitive_size_align(prim, size, align)
            memcpy(dst, src, size)
            return
        }
        scalar_word_store(t, dst, src, ctx)
        return
    case .Struct(name):
        if return_is_ref { size = Dynamic.size() }
        else { size = ctx_total_size(name, ctx) }
    case .StructSym(s_sym):
        if return_is_ref { size = Dynamic.size() }
        else { size = ctx_total_size(ctx.symbols.resolve(s_sym), ctx) }
    case .Enum(name):
        if return_is_ref { size = Dynamic.size() }
        else { size = dispatch_enum_size(name, ctx) }
    case .EnumSym(e_sym):
        if return_is_ref { size = Dynamic.size() }
        else { size = dispatch_enum_size(ctx.symbols.resolve(e_sym), ctx) }
    case .Dynamic, .FuncPtr, .FuncPtrSig, .FuncPtrSigSym, .Body: size = Dynamic.size()
    case .Custom(name):
        raw_result_move_into(type_from_name_init_name(name, ctx.scope, ctx.symbols), dst, src, return_is_ref, ctx)
        return
    case .CustomSym(csym):
        raw_result_move_into(type_from_sym_init(csym, ctx.scope, ctx.symbols), dst, src, return_is_ref, ctx)
        return
    case:
        panic("cannot move raw call result for type ", til_type_name_c(t))
    }
    memcpy(dst, src, size)
    raw_block_free(src)
}

priv raw_result_finish := proc(shallow t: Type, raw: Dynamic, mut destination: Dynamic, return_is_ref: Bool, ctx: Context) returns Dynamic {
    if destination.is_null().or(return_is_ref).or(raw.ptr_eq(destination)) { return raw }
    raw_result_move_into(t, destination, raw, false, ctx)
    return destination
}

priv raw_result_drop_nested := proc(shallow t: Type, mut raw: Dynamic, return_is_ref: Bool, ctx: Context) {
    switch t {
    case .Struct(name):
        if return_is_ref.not() { heap_drop_struct(name, raw, ctx) }
    case .StructSym(s_sym):
        if return_is_ref.not() { heap_drop_struct(ctx.symbols.resolve(s_sym), raw, ctx) }
    case .Enum(name):
        if return_is_ref.not() { heap_drop_enum(name, raw, ctx) }
    case .EnumSym(e_sym):
        if return_is_ref.not() { heap_drop_enum(ctx.symbols.resolve(e_sym), raw, ctx) }
    case .FuncPtr, .FuncPtrSig, .FuncPtrSigSym, .Body:
        heap_drop_by_type(t, raw, ctx)
    case .Custom(name):
        raw_result_drop_nested(type_from_name_init_name(name, ctx.scope, ctx.symbols), raw, return_is_ref, ctx)
    case .CustomSym(csym):
        raw_result_drop_nested(type_from_sym_init(csym, ctx.scope, ctx.symbols), raw, return_is_ref, ctx)
    case:
    }
}

raw_result_drop := proc(shallow t: Type, mut raw: Dynamic, return_is_ref: Bool, ctx: Context) {
    if return_is_ref { return }
    // A non-ref primitive or None result is an inline word: nothing was
    // allocated, nothing to free.
    if raw_type_is_prim(t, ctx).or(t.is(Type.None)) { return }
    raw_result_drop_nested(t, raw, return_is_ref, ctx)
    mut owned_raw : Dynamic = raw
    EvalHeap.heap_free(own owned_raw)
}

priv raw_result_drop_ptr := proc(shallow t: Type, raw: Dynamic, return_is_ref: Bool, ctx: Context) {
    mut owned_raw : Dynamic = raw
    raw_result_drop(t, owned_raw, return_is_ref, ctx)
}

// t_w is the canonical Type as a raw pointer word (interp_intern_type /
// another binding's til_type_p): the binding will borrow it.
scope_set_raw_owned := func(mut scope: Scope, name: Str, raw: Dynamic, t_w: Dynamic, own_type: OwnType, ctx: Context, borrowed: Bool = false) {
    ref t : Type = to_ptr(t_w)
    if t.is(Type.Unknown) { panic("cannot bind raw value with unknown type: ", name) }
    scope_set_heap_owned(scope, name, raw, t_w, own_type, ctx, true, borrowed)
}

priv raw_widen_numeric := func(raw: Dynamic, shallow source_type: Type, target_name: Str, ctx: Context) returns Dynamic {
    if target_name.len() == 0 { return raw }
    source_name := til_type_name_c(source_type)
    ref resolved_target : Str = resolve_type_alias(ctx.scope, target_name, ctx.symbols)
    if resolved_target == source_name { return raw }
    // Pure word-to-word conversion: decode the source scalar (with sign
    // extension) from the inline word, re-encode at the target's width.
    mut signed_value : I64 = 0
    mut unsigned_value : U64 = 0
    bits := word_bits(raw)
    mut is_unsigned := false
    switch source_type {
    case .Primitive(prim):
        switch prim {
        case .U8: unsigned_value = bits; is_unsigned = true
        case .I8: signed_value = bits.cast(I64).to_u8().cast(I8).cast(I64)
        case .I16: signed_value = bits.cast(I64).to_u16().cast(I16).cast(I64)
        case .U16: unsigned_value = bits; is_unsigned = true
        case .I32: signed_value = bits.cast(I64).to_u32().cast(I32).cast(I64)
        case .U32: unsigned_value = bits; is_unsigned = true
        case:
            return raw
        }
    case:
        return raw
    }
    if is_unsigned.not() { unsigned_value = signed_value.cast(U64) }
    else { signed_value = unsigned_value.cast(I64) }
    if resolved_target == "I64" { return bits_word(signed_value.cast(U64)) }
    if resolved_target == "U64" { return bits_word(unsigned_value) }
    if resolved_target == "I32" { return scalar_word_encode(Type.Primitive(Primitive.I32), signed_value.cast(U64), ctx) }
    if resolved_target == "U32" { return scalar_word_encode(Type.Primitive(Primitive.U32), unsigned_value, ctx) }
    return raw
}

priv raw_coerce_value := func(raw: Dynamic, shallow source_type: Type, shallow target_type: Type, ctx: Context, target_own_type: OwnType = OwnType.Shallow) returns Dynamic {
    if target_type.is(Type.Dynamic).and(source_type.is(Type.Dynamic).not()) {
        if heap_type_is_callable(source_type) { return raw }
        // A primitive word has no storage yet: box the scalar into a real
        // block first so the Dynamic slot can point at bytes (C's &x).
        mut boxed : Dynamic = raw
        if raw_type_is_prim(source_type, ctx) { boxed = scalar_block_from_word(source_type, raw, ctx) }
        mut wrapper : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
        write_ptr(wrapper, boxed)
        return wrapper
    }
    switch source_type {
    case .Custom(name):
        return raw_coerce_value(raw, type_from_name_init_name(name, ctx.scope, ctx.symbols), target_type, ctx, target_own_type)
    case .CustomSym(csym):
        return raw_coerce_value(raw, type_from_sym_init(csym, ctx.scope, ctx.symbols), target_type, ctx, target_own_type)
    case .Dynamic:
        if target_type.is(Type.Dynamic).not() {
            if heap_type_is_callable(target_type).and(callable_box_is(deref(raw))) { return raw }
            ref pointed : Dynamic = deref(raw)
            // Unboxing to a SHALLOW primitive loads the scalar inline; the
            // pointed block stays owned by whoever boxed it. An own/ref
            // primitive target keeps the pointer-transfer below (#302
            // raw-alloc params take the block pointer itself as the datum).
            if raw_type_is_prim(target_type, ctx).and(target_own_type.is(OwnType.Shallow)) {
                loaded : Dynamic = scalar_word_load(target_type, pointed, ctx)
                raw_block_free(raw)
                return loaded
            }
            mut result : Dynamic = pointed
            if target_own_type.is(OwnType.Shallow) {
                result = heap_clone_by_type(target_type, pointed, ctx)
            }
            raw_block_free(raw)
            return result
        }
    case:
    }
    return raw_widen_numeric(raw, source_type, til_type_name_c(target_type), ctx)
}

priv raw_type_size := func(shallow t: Type, ctx: Context) returns USize {
    switch t {
    case .None: return 1
    case .Primitive(prim):
        mut size : USize = 0
        mut align : USize = 0
        builtin_primitive_size_align(prim, size, align)
        return size
    case .Struct(name): return ctx_total_size(name, ctx)
    case .StructSym(s_sym): return ctx_total_size(ctx.symbols.resolve(s_sym), ctx)
    case .Enum(name): return dispatch_enum_size(name, ctx)
    case .EnumSym(e_sym): return dispatch_enum_size(ctx.symbols.resolve(e_sym), ctx)
    case .Dynamic, .FuncPtr, .FuncPtrSig, .FuncPtrSigSym, .Body: return Dynamic.size()
    case .Custom(name): return raw_type_size(type_from_name_init_name(name, ctx.scope, ctx.symbols), ctx)
    case .CustomSym(csym): return raw_type_size(type_from_sym_init(csym, ctx.scope, ctx.symbols), ctx)
    case:
        panic("cannot size raw type ", til_type_name_c(t))
        return 0
    }
}

priv raw_to_u64 := func(shallow t: Type, raw: Dynamic, ctx: Context) returns U64 {
    // The scalar rides inline in the word (canonical, zero-extended);
    // signed types re-extend from their width.
    bits := word_bits(raw)
    switch t {
    case .Primitive(prim):
        switch prim {
        case .I64: return bits
        case .U8: return bits
        case .I8: return bits.cast(I64).to_u8().cast(I8).cast(I64).cast(U64)
        case .I16: return bits.cast(I64).to_u16().cast(I16).cast(I64).cast(U64)
        case .U16: return bits
        case .I32: return bits.cast(I64).to_u32().cast(I32).cast(I64).cast(U64)
        case .U32: return bits
        case .U64: return bits
        case .F32: panic("cannot convert F32 raw bits to U64")
        case .F64: panic("cannot convert F64 raw bits to U64")
        case .Bool: return bits
        }
    case .Custom(name): return raw_to_u64(type_from_name_init_name(name, ctx.scope, ctx.symbols), raw, ctx)
    case .CustomSym(csym): return raw_to_u64(type_from_sym_init(csym, ctx.scope, ctx.symbols), raw, ctx)
    case:
    }
    panic("raw value is not numeric: ", til_type_name_c(t))
    return 0
}

priv raw_to_i64 := func(shallow t: Type, raw: Dynamic, ctx: Context) returns I64 {
    return raw_to_u64(t, raw, ctx).cast(I64)
}

priv raw_to_f32 := func(shallow t: Type, raw: Dynamic, ctx: Context) returns F32 {
    switch t {
    case .Primitive(Primitive.F32): return word_f32(word_bits(raw))
    case:
        return raw_to_i64(t, raw, ctx).to_f32()
    }
}

priv raw_arg_pointer := func(raw: Dynamic, info: RawResultInfo, ctx: Context) returns Dynamic {
    // A Dynamic null literal and a null ref-Dynamic binding are null
    // pointer values. Scalar zero is word-shaped and must still get storage.
    if raw.is_null().and(info.is_word.not()) { return bits_word(0) }
    if info.is_ref {
        if info.arg_deref { return deref(raw) }
        return raw
    }
    ref value_type : Type = raw_result_source_type(info)
    // A primitive temp's word has no storage: park the scalar in a ring
    // slot so raw-memory builtins get a real address.
    if info.is_word { return word_ring_slot(value_type, raw, ctx) }
    switch value_type {
    case .Dynamic, .FuncPtr, .FuncPtrSig, .FuncPtrSigSym, .Body: return deref(raw)
    case .CustomSym(ring_csym):
        alias_type_sym := type_from_sym_init(ring_csym, ctx.scope, ctx.symbols)
        switch alias_type_sym {
        case .Dynamic: return deref(raw)
        case .FuncPtr: return deref(raw)
        case .FuncPtrSig, .FuncPtrSigSym: return deref(raw)
        case .Body: return deref(raw)
        case:
        }
        return raw
    case .Custom(name):
        alias_type := type_from_name_init_name(name, ctx.scope, ctx.symbols)
        switch alias_type {
        case .Dynamic: return deref(raw)
        case .FuncPtr: return deref(raw)
        case .FuncPtrSig, .FuncPtrSigSym: return deref(raw)
        case .Body: return deref(raw)
        case:
        }
        return raw
    case:
        return raw
    }
}

priv callable_storage_func_def := func(stored: Dynamic) returns ref Expr {
    if callable_box_is(stored) {
        ref box : InterpCallableBox = to_ptr(stored)
        return box.func_def
    }
    return to_ptr(stored)
}

priv callable_raw_func_def := func(raw: Dynamic) returns ref Expr {
    return callable_storage_func_def(deref(raw))
}

priv callable_raw_env := func(raw: Dynamic, fallback: Scope) returns ref Scope {
    ref stored : Dynamic = deref(raw)
    if callable_box_is(stored) {
        ref box : InterpCallableBox = to_ptr(stored)
        return callable_env(box)
    }
    return fallback
}

priv callable_raw_free := func(mut raw: Dynamic, ctx: Context) {
    heap_drop_by_type(Type.FuncPtr, raw, ctx)
    raw_block_free(raw)
}

priv eval_callable_callee_raw := proc(mut scope: Scope, mut callee: Expr,
        mut owned: Bool, mut ctx: Context) returns Dynamic {
    switch callee.node_type {
    case .Ident(id):
        hb_o := scope_lookup_heap_binding(scope, id.ident_name(ctx.symbols.names))
        if hb_o.is_some() {
            ref hb : HeapBinding = hb_o.unwrap()
            if heap_type_is_callable(hb_type(hb)) {
                if hb.moved_out { panic("call of moved binding: ", id.ident_name(ctx.symbols.names)) }
                owned = false
                return to_ptr(hb.ptr)
            }
        }
    case:
    }
    owned = true
    return eval_expr_raw(scope, callee, ctx)
}

priv eval_callable_cast_callee_raw := proc(mut scope: Scope, mut cast_expr: Expr,
        mut owned: Bool, mut ctx: Context) returns Dynamic {
    ref mut src_expr : Expr = cast_expr.children[1]
    mut src_info := raw_result_info_new()
    mut src : Dynamic = eval_expr_raw_info(scope, src_expr, ctx, src_info)
    // Generated C calls through a ref Dynamic slot without cloning it. Borrow
    // the same slot here so private closure state persists across calls.
    if src_info.is_ref {
        owned = false
        return src
    }
    ref stored_ref : Dynamic = deref(src)
    mut stored : Dynamic = stored_ref
    if raw_result_source_type(src_info).is(Type.Dynamic) {
        stored = callable_storage_clone(stored)
    } else {
        write_ptr(src, bits_word(0))
    }
    mut result : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
    write_ptr(result, stored)
    raw_result_drop(src_expr.til_type(), src, false, ctx)
    owned = true
    return result
}

priv init_field_raw := func(mut inst_data: Dynamic, dd: Declaration, field_offset: USize, field_size: USize, mut raw: Dynamic, shallow raw_type: Type, raw_is_ref: Bool, raw_is_place: Bool, ctx: Context) {
    ref mut dst : Dynamic = ptr_add(inst_data, field_offset)
    if decl_is_funcsig(dd, ctx) {
        ref stored : Dynamic = deref(raw)
        if raw_is_ref.or(raw_is_place) {
            write_ptr(dst, callable_storage_clone(stored))
        } else {
            write_ptr(dst, stored)
            write_ptr(raw, bits_word(0))
            raw_block_free(raw)
        }
        return
    }
    // #397: family-predicate form of the old .Struct/.Enum payload switch,
    // so the Sym twins take the same paths with a resolved name.
    if is_struct_type(dd.til_type) {
        ref name : Str = type_name_ref(dd.til_type, ctx.symbols)
        if dd.own_type.is(OwnType.Own) {
            if raw_is_ref.or(raw_is_place) {
                write_ptr(dst, heap_clone(name, raw, ctx))
            } else {
                write_ptr(dst, raw)
            }
        } else if dd.own_type.is(OwnType.Ref) {
            write_ptr(dst, raw)
        } else {
            if raw_is_ref.or(raw_is_place) {
                copied : Dynamic = heap_clone(name, raw, ctx)
                memcpy(dst, copied, field_size)
                raw_block_free(copied)
            } else {
                memcpy(dst, raw, field_size)
                raw_block_free(raw)
            }
        }
        return
    }
    if is_enum_type(dd.til_type) {
        ref ename : Str = type_name_ref(dd.til_type, ctx.symbols)
        if dd.own_type.is(OwnType.Own) {
            if raw_is_ref.or(raw_is_place) {
                write_ptr(dst, heap_clone_enum(ename, raw, dispatch_enum_size(ename, ctx), ctx))
            } else {
                write_ptr(dst, raw)
            }
        } else if dd.own_type.is(OwnType.Ref) {
            write_ptr(dst, raw)
        } else {
            // dispatch_enum_size is the interpreter carrier capacity (at
            // least one word), not the inline C field width. Compact tag-only
            // enums may occupy only 1/2/4 bytes in a struct.
            if raw_is_ref.or(raw_is_place) {
                copied : Dynamic = heap_clone_enum(ename, raw, field_size, ctx)
                memcpy(dst, copied, field_size)
                raw_block_free(copied)
            } else {
                memcpy(dst, raw, field_size)
                raw_block_free(raw)
            }
        }
        return
    }
    if dd.own_type.is(OwnType.Own).or(dd.own_type.is(OwnType.Ref)) {
        if raw_is_ref {
            write_ptr(dst, raw)
        } else if raw_is_place.or(raw_type.is(Type.Dynamic)) {
            // #321: a null-literal value IS the null word, not a block
            // holding one -- raw_arg_pointer states the same rule for
            // arguments. An `own data : U8 = 0` field initialises
            // straight to null, and there is nothing to load through.
            if raw.is_null() {
                write_ptr(dst, raw)
                return
            }
            ref pointed : Dynamic = deref(raw)
            write_ptr(dst, pointed)
            if raw_is_place.not() { raw_block_free(raw) }
        } else {
            write_ptr(dst, raw)
        }
        return
    }
    // Shallow primitive field init from an inline word, at the layout
    // width (host struct bytes; see field_word_type). A ref or place
    // arg is a BARE address into the source's storage (an Ident eval,
    // a field ref): load the scalar out at the SOURCE type's width
    // first.
    if raw_type_is_prim(dd.til_type, ctx) {
        mut field_w : Dynamic = raw
        if raw_is_ref.or(raw_is_place) { field_w = scalar_word_load(raw_type, raw, ctx) }
        scalar_word_store(field_word_type(dd.til_type, field_size, ctx), dst, field_w, ctx)
        return
    }
    memcpy(dst, raw, field_size)
    if raw_is_place.not() { raw_block_free(raw) }
}

priv context_return_set := func(mut ctx: Context, raw: Dynamic) {
    if ctx.eval.has_return { panic("return result already set") }
    ctx.eval.return_value = raw
    ctx.eval.has_return = true
}

priv context_return_take := func(mut ctx: Context) returns Dynamic {
    if ctx.eval.has_return.not() { panic("return result is not set") }
    result : Dynamic = ctx.eval.return_value
    ctx.eval.return_value = 0
    ctx.eval.has_return = false
    return result
}

priv field_access_sname := func(e: Expr, mut fallback: Str, symbols: SymbolPool) returns ref Str {
    sname_o := expr_type_name_ref(e.children[0], symbols)
    if sname_o.is_some() {
        ref sname : Str = sname_o.unwrap()
        return sname
    }
    switch e.children[0].node_type {
    case .Ident(id): return id.ident_name(symbols.names)
    case:
        fallback = til_type_name_c(e.children[0].til_type())
        return fallback
    }
}

priv field_access_decl := func(e: Expr, sname: Str, ctx: Context) returns Option(ref Declaration) {
    sdef_o := lookup_interp_type_def(sname, ctx)
    if sdef_o.is_none() { return Option(ref Declaration).None }
    ref sdef : Expr = sdef_o.unwrap()
    switch e.node_type {
    case .FieldAccess(fa): return find_field_decl(sdef, fa.field_access_name(ctx.symbols.names))
    case: return Option(ref Declaration).None
    }
}

// Resolve storage for an identifier-rooted struct field chain without
// evaluating or copying its intermediate aggregates.
priv field_access_base := proc(mut scope: Scope, mut obj: Expr, mut ctx: Context) returns Option(ref Dynamic) {
    switch obj.node_type {
    case .Ident: return resolve_field_assign_base(scope, obj, ctx.symbols)
    case .FieldAccess(fa):
        // Aggregate namespace data is stable storage in ns_fields, so a
        // chained read such as `Point.origin.x` can borrow that value as its
        // field base. Enum variants have no ns binding and fall through.
        mut ns_fallback := ""
        ref ns_sname : Str = field_access_sname(obj, ns_fallback, ctx.symbols)
        ns_def_o := interp_fa_namespace_def_with_name(scope, obj, ns_sname, ns_fallback.len() > 0, ctx)
        if ns_def_o.is_some() {
            ns_hb_o := scope_lookup_ns_binding(ns_scope(ctx), ns_sname, fa.field_access_name(ctx.symbols.names))
            if ns_hb_o.is_some() {
                ref ns_hb : HeapBinding = ns_hb_o.unwrap()
                ref ns_stored : Dynamic = to_ptr(ns_hb.ptr)
                return safe_ref(Dynamic, ns_stored)
            }
        }
        parent_o := field_access_base(scope, obj.children[0], ctx)
        if parent_o.is_none() { return Option(ref Dynamic).None }
        ref parent : Dynamic = parent_o.unwrap()
        mut fallback_sname := ""
        ref sname : Str = field_access_sname(obj, fallback_sname, ctx.symbols)
        fdecl_o := field_access_decl(obj, sname, ctx)
        if fdecl_o.is_none() { return Option(ref Dynamic).None }
        ref fdecl : Declaration = fdecl_o.unwrap()
        ref fl : FieldLayout = ctx_field_layout(sname, fa.field_access_name(ctx.symbols.names), ctx)
        ref slot : Dynamic = ptr_add(parent, fl.offset)
        if fdecl.own_type.is(OwnType.Shallow) { return safe_ref(Dynamic, slot) }
        // REM: a non-shallow field yields the STORED pointer. A field
        // declared `ref x : T = NULL` still stores a real null here, and the
        // niche cannot spell Some(null) -- it reads back as None. Callers
        // already treat both as "no base" and error out, so nothing changes
        // today, and step 1's forbid removes the case entirely.
        ref stored : Dynamic = deref(slot)
        return safe_ref(Dynamic, stored)
    case .FCall:
        mut info := raw_result_info_new()
        raw_base : Dynamic = eval_expr_raw_info(scope, obj, ctx, info)
        if info.is_ref {
            ref call_base : Dynamic = to_ptr(raw_base)
            return safe_ref(Dynamic, call_base)
        }
        panic("field access call base is not a reference")
    case: return Option(ref Dynamic).None
    }
}

priv eval_expr_field_raw := proc(mut scope: Scope, mut e: Expr, shallow expr_type: Type, mut ctx: Context, mut info: RawResultInfo, mut destination: Dynamic = bits_word(0)) returns Dynamic {
    info.is_ref = false
    info.is_word = false
    // #343: consume the ext-argument mark HERE, before the receiver is
    // resolved -- resolving it can evaluate a call (`name.clone().c_str`),
    // and a `.c_str` inside that callee is an ordinary borrowed read.
    cstr_arg := ctx.eval.interp_cstr_arg
    ctx.eval.interp_cstr_arg = false
    switch e.node_type {
    case .FieldAccess(fa):
        mut fallback_sname := ""
        ref sname : Str = field_access_sname(e, fallback_sname, ctx.symbols)
        namespace_def_o := interp_fa_namespace_def_with_name(scope, e, sname, fallback_sname.len() > 0, ctx)
        if namespace_def_o.is_some() {
            info.is_word = destination.is_null().and(raw_type_is_prim(expr_type, ctx))
            ref namespace_def : Expr = namespace_def_o.unwrap()
            if namespace_def.node_type.is(NodeType.EnumDef) {
                variant_idx := enum_variant_index(namespace_def, fa.field_access_name(ctx.symbols.names))
                if variant_idx >= 0 {
                    mut result : Dynamic = destination
                    if result.is_null() { result = dispatch_result_alloc(Type.Enum(sname.clone()), ctx) }
                    // #320 niche: a payload-less variant read as a VALUE is
                    // the null pointer, not a tag byte -- writing a 1-byte
                    // tag into the 8-byte slot would leave the rest garbage
                    // and read back as Some.
                    if enum_is_niche(namespace_def) {
                        write_ptr(result, bits_word(0))
                        return result
                    }
                    tag := enum_variant_tag(namespace_def, fa.field_access_name(ctx.symbols.names))
                    memcpy(result, tag, enum_tag_size(namespace_def))
                    return result
                }
            }
            stored_hb_o := scope_lookup_ns_binding(ns_scope(ctx), sname, fa.field_access_name(ctx.symbols.names))
            if stored_hb_o.is_none() {
                static_fdef_o := def_static_ns_func_def(namespace_def, fa.field_access_name(ctx.symbols.names))
                if static_fdef_o.is_some() {
                    mut result : Dynamic = destination
                    if result.is_null() { result = EvalHeap.heap_alloc(Dynamic.size()) }
                    write_ptr(result, static_fdef_o.unwrap())
                    info.source_type_p = to_ptr(interp_intern_type(Type.Body, ctx))
                    return result
                }
                interp_error(e, format("no namespace field '", Str.clone(fa.field_access_name(ctx.symbols.names)), "'"), ctx)
                exit(1)
            }
            ref stored_hb : HeapBinding = stored_hb_o.unwrap()
            ref stored : Dynamic = to_ptr(stored_hb.ptr)
            info.source_type_p = stored_hb.til_type_p
            ref stored_type : Type = hb_type(stored_hb)
            if raw_type_is_prim(stored_type, ctx) {
                ns_word : Dynamic = scalar_word_load(stored_type, stored, ctx)
                return raw_result_finish(stored_type, ns_word, destination, false, ctx)
            }
            if type_is_callable_storage(stored_type) {
                mut result : Dynamic = destination
                if result.is_null() { result = dispatch_result_alloc(stored_type, ctx) }
                ref stored_callable : Dynamic = deref(stored)
                write_ptr(result, stored_callable)
                return result
            }
            cloned : Dynamic = heap_clone_by_type(stored_type, stored, ctx)
            return raw_result_finish(stored_type, cloned, destination, false, ctx)
        }
        fdecl_o := field_access_decl(e, sname, ctx)
        if fdecl_o.is_none() {
            interp_error(e, format("no field '", Str.clone(fa.field_access_name(ctx.symbols.names)), "'"), ctx)
            exit(1)
        }
        ref fdecl : Declaration = fdecl_o.unwrap()
        info.source_type_p = to_ptr(interp_intern_type(declaration_resolved_type(fdecl, ctx.scope, ctx.symbols), ctx))
        info.is_ref = decl_is_funcsig(fdecl, ctx).not()
        if e.children[0].node_type.is_literal_str().and(fdecl.own_type.is(OwnType.Shallow)) { info.is_ref = false }
        info.is_word = info.is_ref.not().and(destination.is_null()).and(raw_type_is_prim(expr_type, ctx))
        ref fl : FieldLayout = ctx_field_layout(sname, fa.field_access_name(ctx.symbols.names), ctx)
        if (decl_type_name(fdecl, ctx.symbols) == "USize").or(decl_type_name(fdecl, ctx.symbols) == "UPtr") {
            mut field_type := field_word_type(fdecl.til_type, fl.size, ctx)
            if (sname == ctx.eval.cached_str_name).and(fa.field_access_name(ctx.symbols.names) == "cap").and(fl.size == 4) {
                field_type = Type.Primitive(Primitive.I32)
            }
            info.source_type_p = to_ptr(interp_intern_type(field_type, ctx))
        }
        base_o := field_access_base(scope, e.children[0], ctx)
        if base_o.is_some() {
            ref base : Dynamic = base_o.unwrap()
            if cstr_arg { check_c_string_terminator(base, ctx) }
            if info.is_ref {
                if fdecl.own_type.is(OwnType.Shallow).not() { return deref(ptr_add(base, fl.offset)) }
                return ptr_add(base, fl.offset)
            }
            return read_field(base, fdecl, fl.offset, fl.size, ctx)
        }

        // A literal base is a VALUE, not a place: `"hi".c_str` has no storage
        // for field_access_base to point into, so it returned NULL and every
        // interpreted literal field access died here -- while the SAME source
        // compiled fine, which is why the gui examples and the suite never
        // caught it. It surfaced as `til repl` exiting silently on
        // `InitWindow(800, 600, "hi".c_str)`, the idiom every gui example uses.
        //
        // Materialize the literal into a temporary and read the field out of
        // that. The read stays valid after the temporary goes away for exactly
        // the reason the compiled form does: the Literal.Str arm INTERNS the
        // bytes in ctx.builder_str_lit_values and hands back a CAP_LIT view of
        // the pooled buffer, so the field word is either an inline scalar
        // (count/cap, loaded by read_field) or a pointer into the pool
        // (c_str) -- never into the temporary's own three words, which is all
        // this frees. field_access_returns_ref reports false for the Shallow
        // fields precisely so they take the read_field branch here.
        if e.children[0].node_type.is_literal_str() {
            tmp_base : Dynamic = eval_expr_raw(scope, e.children[0], ctx)
            mut field_word : Dynamic = 0
            if info.is_ref {
                field_word = deref(ptr_add(tmp_base, fl.offset))
            } else {
                field_word = read_field(tmp_base, fdecl, fl.offset, fl.size, ctx)
            }
            raw_block_free(tmp_base)
            return field_word
        }

        panic("field access base is not a place")
        return bits_word(0)
    case:
        interp_lang_error(e, "cannot evaluate node as field expression", ctx)
        exit(1)
        return bits_word(0)
    }
}

priv write_runtime_type := func(mut result: Dynamic, shallow t: Type, ctx: Context) {
    type_def_o := lookup_interp_type_def("Type", ctx)
    if type_def_o.is_none() { panic("runtime Type definition not registered") }
    ref type_def : Expr = type_def_o.unwrap()
    mut variant := ""
    switch t {
    case .Unknown: variant = "Unknown"
    case .None: variant = "None"
    case .Struct(name):
        variant = "Struct"
        dispatch_write_str(ptr_add(result, ENUM_PAYLOAD_OFFSET), name.c_str, name.count, ctx)
    case .StructSym(marshal_ssym):
        variant = "Struct"
        ref marshal_sname : Str = ctx.symbols.resolve(marshal_ssym)
        dispatch_write_str(ptr_add(result, ENUM_PAYLOAD_OFFSET), marshal_sname.c_str, marshal_sname.count, ctx)
    case .StructDef: variant = "StructDef"
    case .Enum(name):
        variant = "Enum"
        dispatch_write_str(ptr_add(result, ENUM_PAYLOAD_OFFSET), name.c_str, name.count, ctx)
    case .EnumSym(marshal_esym):
        variant = "Enum"
        ref marshal_ename : Str = ctx.symbols.resolve(marshal_esym)
        dispatch_write_str(ptr_add(result, ENUM_PAYLOAD_OFFSET), marshal_ename.c_str, marshal_ename.count, ctx)
    case .EnumDef: variant = "EnumDef"
    case .FuncDef: variant = "FuncDef"
    case .FuncPtr: variant = "FuncPtr"
    case .Dynamic: variant = "Dynamic"
    case .Custom(name):
        variant = "Custom"
        dispatch_write_str(ptr_add(result, ENUM_PAYLOAD_OFFSET), name.c_str, name.count, ctx)
    case .CustomSym(marshal_csym):
        variant = "Custom"
        ref marshal_cname : Str = ctx.symbols.resolve(marshal_csym)
        dispatch_write_str(ptr_add(result, ENUM_PAYLOAD_OFFSET), marshal_cname.c_str, marshal_cname.count, ctx)
    case .Primitive(prim):
        variant = "Primitive"
        primitive_def_o := lookup_interp_type_def("Primitive", ctx)
        if primitive_def_o.is_none() { panic("runtime Primitive definition not registered") }
        ref primitive_def : Expr = primitive_def_o.unwrap()
        mut primitive_variant := ""
        switch prim {
        case .I16: primitive_variant = "I16"
        case .U16: primitive_variant = "U16"
        case .I8: primitive_variant = "I8"
        case .U8: primitive_variant = "U8"
        case .U32: primitive_variant = "U32"
        case .I32: primitive_variant = "I32"
        case .U64: primitive_variant = "U64"
        case .I64: primitive_variant = "I64"
        case .F32: primitive_variant = "F32"
        case .F64: primitive_variant = "F64"
        case .Bool: primitive_variant = "Bool"
        }
        write_i32(ptr_add(result, ENUM_PAYLOAD_OFFSET), enum_variant_tag(primitive_def, primitive_variant).to_i32())
    case .FuncPtrSig(name):
        variant = "FuncPtrSig"
        dispatch_write_str(ptr_add(result, ENUM_PAYLOAD_OFFSET), name.c_str, name.count, ctx)
    // #397 step 3: the compile-time Sym form marshals as the RUNTIME
    // form -- the spelling, resolved from the pool -- so the user-visible
    // Type ABI does not change with the internal representation.
    case .FuncPtrSigSym(marshal_fsig_sym):
        variant = "FuncPtrSig"
        ref marshal_fsig_name : Str = ctx.symbols.resolve(marshal_fsig_sym)
        dispatch_write_str(ptr_add(result, ENUM_PAYLOAD_OFFSET), marshal_fsig_name.c_str, marshal_fsig_name.count, ctx)
    case .Body: variant = "Body"
    }
    write_i32(result, enum_variant_tag(type_def, variant).to_i32())
}

priv eval_precomputed_sequence := proc(mut scope: Scope, mut e: Expr, data: PrecomputedSequenceData, mut ctx: Context, mut info: RawResultInfo, destination: Dynamic) returns Dynamic {
    ref seq_name : Str = type_name_ref(data.til_type, ctx.symbols)
    is_vec := seq_name.eq("Vec").or(seq_name.starts_with("Vec__"))
    is_array := seq_name.eq("Array").or(seq_name.starts_with("Array__"))
    if is_vec.not().and(is_array.not()) { panic("precomputed sequence has non-sequence type: ", seq_name) }
    if e.children.len() > data.capacity { panic("precomputed sequence count exceeds capacity") }
    if is_array.and(e.children.len() != data.capacity) { panic("precomputed Array count differs from capacity") }

    elem_name := container_elem_type(seq_name, ctx)
    if elem_name.len() == 0 { panic("precomputed sequence has unnamed element type") }
    elem_size := container_elem_size(elem_name, ctx)
    mut result : Dynamic = destination
    if result.is_null() { result = dispatch_result_alloc(data.til_type, ctx) }
    mut elements : Dynamic = 0
    if data.capacity > 0 { elements = EvalHeap.heap_alloc(data.capacity.mul(elem_size)) }

    ref data_fl : FieldLayout = ctx_field_layout(seq_name, "data", ctx)
    ref cap_fl : FieldLayout = ctx_field_layout(seq_name, "cap", ctx)
    write_ptr(ptr_add(result, data_fl.offset), elements)
    if cap_fl.size == 4 { write_u32(ptr_add(result, cap_fl.offset), data.capacity.to_u32()) }
    else { write_u64(ptr_add(result, cap_fl.offset), data.capacity.to_u64()) }
    if is_vec {
        ref count_fl : FieldLayout = ctx_field_layout(seq_name, "count", ctx)
        if count_fl.size == 4 { write_u32(ptr_add(result, count_fl.offset), e.children.len().to_u32()) }
        else { write_u64(ptr_add(result, count_fl.offset), e.children.len().to_u64()) }
    }

    for i in 0..e.children.len() {
        ref mut element : Expr = e.children[i]
        if element.til_type().eq(data.element_type).not() { panic("precomputed sequence element type mismatch") }
        mut element_info := raw_result_info_new()
        ref mut slot : Dynamic = ptr_add(elements, i.mul(elem_size))
        element_raw : Dynamic = eval_expr_raw_info(scope, element, ctx, element_info, slot)
        if element_info.is_ref { panic("precomputed sequence element evaluated as a reference") }
        if element_raw.ptr_eq(slot).not() { panic("precomputed sequence element ignored its destination") }
    }
    info.is_ref = false
    info.is_word = false
    return result
}

priv eval_expr_raw_info := proc(mut scope: Scope, mut e: Expr, mut ctx: Context, mut info: RawResultInfo, mut destination: Dynamic = bits_word(0)) returns Dynamic {
    ref expr_type : Type = e.til_type()
    info.source_type_p = to_ptr(interp_intern_type(expr_type, ctx))
    info.is_ref = false
    info.is_word = false
    info.arg_deref = false
    switch e.node_type {
    case .Literal(Literal.Str(text)):
        mut result : Dynamic = destination
        if result.is_null() { result = dispatch_result_alloc(expr_type, ctx) }
        mut buf : I8 = malloc(text.count.add(1))
        mut j : USize = 0
        mut i : USize = 0
        while i < text.count {
            ref ch : I8 = text.unsafe_get(i)
            if ch == 92 {
                if i + 1 < text.count {
                    ref next : I8 = text.unsafe_get(i + 1)
                    if next == 110 { memset(ptr_add(buf, j), 10, 1); j = j + 1; i = i + 2; continue }
                    if next == 114 { memset(ptr_add(buf, j), 13, 1); j = j + 1; i = i + 2; continue }
                    if next == 116 { memset(ptr_add(buf, j), 9, 1); j = j + 1; i = i + 2; continue }
                    if next == 92 { memset(ptr_add(buf, j), 92, 1); j = j + 1; i = i + 2; continue }
                    if next == 34 { memset(ptr_add(buf, j), 34, 1); j = j + 1; i = i + 2; continue }
                    if next == 39 { memset(ptr_add(buf, j), 39, 1); j = j + 1; i = i + 2; continue }
                    if next == 48 { memset(ptr_add(buf, j), 0, 1); j = j + 1; i = i + 2; continue }
                    // `\xNN`. The compiled backend gets this for free (the
                    // literal is emitted into C, whose lexer decodes it), and
                    // constfolder's str_to_source_form WRITES this form for
                    // any folded byte a til literal cannot spell, so an
                    // interpreter that did not decode it saw four source
                    // characters where the compiled program saw one byte --
                    // the same expression meaning different things on the two
                    // backends.
                    if next == 120 {
                        if i + 3 < text.count {
                            hi := digit_value(text.unsafe_get(i + 2))
                            lo := digit_value(text.unsafe_get(i + 3))
                            if hi.gte(0).and(lo.gte(0)) {
                                memset(ptr_add(buf, j), hi.mul(16).add(lo).to_i32(), 1)
                                j = j + 1
                                i = i + 4
                                continue
                            }
                        }
                    }
                }
            }
            // The `""` (close-quote + open-quote) that str_to_source_form
            // emits after a `\xNN` so the C lexer cannot read the next
            // character as a further hex digit. C concatenates the adjacent
            // literals and it contributes no byte, so drop it here too --
            // exactly what the builder's c_lit_byte_count and constfolder's
            // from_source_form already do. A real quote byte is stored as
            // `\"` and was consumed by the branch above.
            if ch == 34 { i = i + 1; continue }
            memcpy(ptr_add(buf, j), ptr_add(text.c_str, i), 1)
            j++
            i++
        }
        // NUL-terminate: the buffer is malloc'd with the +1 for it, and every
        // other Str producer (with_capacity, clone, substr's callers) writes
        // it. Without it `.c_str` hands C code a buffer with no terminator --
        // the compiled backend's literals are C string constants, so only the
        // interpreter was affected, and only once a literal's c_str could
        // actually be reached (`InitWindow(800, 600, "hi".c_str)` read past
        // the end for its window title).
        memset(ptr_add(buf, j), 0, 1)
        mut pooled_i : USize = 0
        mut found_literal := false
        for lit_i in 0..ctx.builder_str_lit_values.len() {
            ref pooled : Str = ctx.builder_str_lit_values[lit_i]
            if pooled.count == j {
                if j == 0 { found_literal = true }
                else if memcmp(pooled.c_str, buf, j) == 0 { found_literal = true }
                if found_literal { pooled_i = lit_i; break }
            }
        }
        if found_literal.not() {
            ctx.builder_str_lit_values.push(own Str(c_str = to_ptr(buf), count = j, cap = j))
            pooled_i = ctx.builder_str_lit_values.len().sub(1)
        } else {
            free(own buf)
        }
        ref pooled2 : Str = ctx.builder_str_lit_values[pooled_i]
        write_ptr(result, pooled2.c_str)
        str_write_count_cap(result, j, CAP_LIT, ctx)
        return result
    case .Literal(Literal.Num(num_str)):
        // Numeric literals are inline words: parse, canonicalize, done --
        // no allocation. A caller-provided destination gets the scalar
        // stored at its width instead.
        mut num_word : Dynamic = 0
        switch expr_type {
        case .Primitive(Primitive.U8):  num_word = bits_word(num_str.to_u8().cast(U64))
        case .Primitive(Primitive.I8):  num_word = scalar_word_encode(expr_type, num_str.to_i8().cast(U8).cast(U64), ctx)
        case .Primitive(Primitive.I16): num_word = scalar_word_encode(expr_type, num_str.to_i16().cast(U16).cast(U64), ctx)
        case .Primitive(Primitive.U16): num_word = bits_word(num_str.to_u16().cast(U64))
        case .Primitive(Primitive.I32): num_word = scalar_word_encode(expr_type, num_str.to_i32().cast(U32).cast(U64), ctx)
        case .Primitive(Primitive.U32): num_word = bits_word(num_str.to_u32().cast(U64))
        case .Primitive(Primitive.U64): num_word = bits_word(num_str.to_u64())
        case .Primitive(Primitive.F32): num_word = bits_word(f32_word(num_str.to_f32()))
        case .Primitive(Primitive.F64): num_word = bits_word(str_parse_f64_bits(num_str.text))
        case: num_word = bits_word(num_str.to_i64().cast(U64))
        }
        if destination.is_null() { info.is_word = true; return num_word }
        scalar_word_store(expr_type, destination, num_word, ctx)
        return destination
    case .Literal(Literal.Bool(b)):
        if destination.is_null().not() {
            write_bool(destination, b)
            return destination
        }
        info.is_word = true
        if b { return bits_word(1) }
        return bits_word(0)
    case .Literal(Literal.Null):
        // A primitive-typed null is the zero word -- and so is a
        // DYNAMIC-typed one (#321: the typer rewrites literal 0 to this
        // node for Dynamic targets; the null IS the word, allocating a
        // block for it leaked 8 bytes per evaluation). Other classes
        // keep a zeroed block of the type's size (a zeroed aggregate).
        if destination.is_null().not() { return destination }
        if raw_type_is_prim(expr_type, ctx).or(expr_type.is(Type.Dynamic)) {
            info.is_word = raw_type_is_prim(expr_type, ctx)
            return bits_word(0)
        }
        return raw_unit_result(expr_type, ctx)
    case .Ident(ident):
        hb_o := scope_lookup_heap_binding(scope, ident.ident_name(ctx.symbols.names))
        if hb_o.is_none() { panic("expression binding not found: ", ident.ident_name(ctx.symbols.names)) }
        ref hb : HeapBinding = hb_o.unwrap()
        if hb_type(hb).is(Type.Dynamic).and(expr_type.is(Type.Dynamic).not()).not() {
            info.source_type_p = hb.til_type_p
        }
        info.arg_deref = hb_type(hb).is(Type.Dynamic).and(hb.is_erased_dynamic.not())
        mut resolved_type := expr_type.clone()
        switch resolved_type {
        case .Custom(expr_type_name): resolved_type = type_from_name_init_name(expr_type_name, ctx.scope, ctx.symbols)
        case .CustomSym(expr_type_csym): resolved_type = type_from_sym_init(expr_type_csym, ctx.scope, ctx.symbols)
        case:
        }
        if is_enum_type(resolved_type) {
            type_name_metatype_o := type_name_of(resolved_type, ctx.symbols)
            if (type_name_metatype_o.unwrap() == "Type").and(hb.is_static_callable) {
                mut result : Dynamic = destination
                if result.is_null() { result = dispatch_result_alloc(expr_type, ctx) }
                mut runtime_type_name := ident.ident_name(ctx.symbols.names).clone()
                ref binding_scope : Scope = scope_get_binding_scope(scope, ident.ident_name(ctx.symbols.names))
                if binding_scope.heap_aliases.has(ident.ident_name(ctx.symbols.names)) {
                    runtime_type_name = binding_scope.heap_aliases[ident.ident_name(ctx.symbols.names)].clone()
                }
                write_runtime_type(result, type_from_name_init_name(runtime_type_name, ctx.scope, ctx.symbols), ctx)
                return result
            }
        }
        ref place : Dynamic = to_ptr(hb.ptr)
        if heap_type_is_callable(hb_type(hb)) {
            cloned : Dynamic = heap_clone_by_type(hb_type(hb), place, hb.ctx)
            return raw_result_finish(hb_type(hb), cloned, destination, false, ctx)
        }
        info.is_ref = true
        result : Dynamic = place
        return result
    case .FCall:
        return eval_call_info(scope, e, expr_type, ctx, info, destination)
    case .FuncDef(fd):
        if fd.captures.len().gt(0) {
            closure : Dynamic = make_interp_closure(e, scope, ctx)
            return raw_result_finish(expr_type, closure, destination, false, ctx)
        }
        mut result : Dynamic = destination
        if result.is_null() { result = EvalHeap.heap_alloc(Dynamic.size()) }
        write_ptr(result, e)
        return result
    case .BodyValue:
        closure : Dynamic = make_interp_closure(e, scope, ctx)
        return raw_result_finish(expr_type, closure, destination, false, ctx)
    case .PrecomputedSequence(data):
        return eval_precomputed_sequence(scope, e, data, ctx, info, destination)
    case .StructDef, .EnumDef:
        mut result : Dynamic = destination
        if result.is_null() { result = EvalHeap.heap_alloc(Dynamic.size()) }
        write_ptr(result, e)
        return result
    case .FieldAccess:
        return eval_expr_field_raw(scope, e, expr_type, ctx, info, destination)
    case:
        interp_lang_error(e, "cannot evaluate node as expression", ctx)
        exit(1)
        return raw_unit_result(expr_type, ctx)
    }
}

eval_expr_raw := proc(mut scope: Scope, mut e: Expr, mut ctx: Context, mut destination: Dynamic = bits_word(0)) returns Dynamic {
    mut info := raw_result_info_new()
    return eval_expr_raw_info(scope, e, ctx, info, destination)
}

priv lookup_type_def_helper := func(type_name: Str, mut scope: Scope, ctx: Context) returns Option(ref Expr) {
    // Probe: type_name is empty for a primitive scrutinee (switch on I64)
    // and unbound for a builtin; the absent case falls through to the
    // interp type-def registry, which answers None for those. A binding
    // that is not callable holds no def either (hb_func_def), and takes
    // the same fallback rather than being read as an Expr.
    hb_o := scope_lookup_heap_binding(scope, type_name)
    if hb_o.is_none() { return lookup_interp_type_def(type_name, ctx) }
    fd_o := hb_func_def(hb_o.unwrap())
    if fd_o.is_none() { return lookup_interp_type_def(type_name, ctx) }
    return fd_o
}

priv resolve_field_assign_base := func(mut scope: Scope, obj_expr: Expr, symbols: SymbolPool) returns Option(ref Dynamic) {
    switch obj_expr.node_type {
    case .Ident(ident):
        hb_o := scope_lookup_heap_binding(scope, ident.ident_name(symbols.names))
        if hb_o.is_none() { return Option(ref Dynamic).None }
        ref hb : HeapBinding = hb_o.unwrap()
        switch hb_type(hb) {
        case .Struct, .StructSym:
            if hb.moved_out { panic("field assign on moved binding: ", ident.ident_name(symbols.names)) }
            ref base : Dynamic = to_ptr(hb.ptr)
            return safe_ref(Dynamic, base)
        case: return Option(ref Dynamic).None
        }
    case:
        return Option(ref Dynamic).None
    }
}

priv resolve_field_assign_sname := func(mut scope: Scope, obj_expr: Expr, symbols: SymbolPool) returns Str {
    switch obj_expr.node_type {
    case .Ident(ident):
        hb_o := scope_lookup_heap_binding(scope, ident.ident_name(symbols.names))
        if hb_o.is_none() { return "" }
        ref hb : HeapBinding = hb_o.unwrap()
        if is_struct_type(hb_type(hb)) {
            if hb.moved_out { panic("field assign on moved binding: ", ident.ident_name(symbols.names)) }
            return Str.clone(type_name_of(hb_type(hb), symbols).unwrap())
        }
        return ""
        
    case:
        return ""
    }
}

priv resolve_field_assign_sdef := func(mut scope: Scope, obj_expr: Expr, ctx: Context) returns Option(ref Expr) {
    sname := resolve_field_assign_sname(scope, obj_expr, ctx.symbols)
    if sname.len() == 0 { return Option(ref Expr).None }
    return lookup_interp_type_def(sname, ctx)
}

priv raw_switch_key := proc(mut scope: Scope, mut e: Expr, mut ctx: Context) returns I64 {
    mut info := raw_result_info_new()
    mut raw : Dynamic = eval_expr_raw_info(scope, e, ctx, info)
    mut raw_type := raw_result_source_type(info).clone()
    switch raw_type {
    case .Custom(name):
        raw_type = type_from_name_init_name(name, ctx.scope, ctx.symbols)
    case .CustomSym(csym):
        raw_type = type_from_sym_init(csym, ctx.scope, ctx.symbols)
    case:
    }
    switch raw_type {
    case .EnumSym(switch_esym):
        tag_ptr_sym : Dynamic = raw_arg_pointer(raw, info, ctx)
        enum_def_sym_o := lookup_interp_type_def(ctx.symbols.resolve(switch_esym), ctx)
        if enum_def_sym_o.is_none() { panic("switch enum definition not found: ", ctx.symbols.resolve(switch_esym)) }
        ref enum_def_sym : Expr = enum_def_sym_o.unwrap()
        result_sym := enum_data_tag_key(tag_ptr_sym, enum_def_sym)
        raw_result_drop(raw_type, raw, info.is_ref, ctx)
        return result_sym
    case .Enum(enum_name):
        tag_ptr : Dynamic = raw_arg_pointer(raw, info, ctx)
        enum_def_o := lookup_interp_type_def(enum_name, ctx)
        if enum_def_o.is_none() { panic("switch enum definition not found: ", enum_name) }
        ref enum_def : Expr = enum_def_o.unwrap()
        result := enum_data_tag_key(tag_ptr, enum_def)
        raw_result_drop(raw_type, raw, info.is_ref, ctx)
        return result
    case .Primitive:
        return raw_to_i64(raw_type, scalar_word_of_raw(raw, info.is_ref, info.is_word, raw_type, ctx), ctx)
    case .Dynamic:
        // An erased scalar subject: the value is a Dynamic slot; read the
        // pointed scalar as I64 (the pre-word behavior read through the
        // arg pointer the same way).
        result := raw_to_i64(Type.Primitive(Primitive.I64), scalar_word_load(Type.Primitive(Primitive.I64), raw_arg_pointer(raw, info, ctx), ctx), ctx)
        raw_result_drop(raw_type, raw, info.is_ref, ctx)
        return result
    case:
        panic("unsupported switch key type ", til_type_name_c(raw_type))
    }
    return 0
}

// #254: execute a switch the typer left un-desugared (C-like). Evaluate the
// scrutinee once, run the first case whose constant label compares equal, else
// the default. break/continue/return propagate via Context flags (eval_body
// returns early when one is set), so a case-body `continue`/`return` reaches
// the enclosing loop/function unchanged.
// #276: the variant name of a case pattern -- a bare `Type.V` (FieldAccess) or
// a payload binding `Type.V(x)` (FCall whose FieldAccess callee names V).
priv clike_case_variant_name := func(pat: Expr, symbols: SymbolPool) returns Str {
    switch pat.node_type {
    case .FieldAccess(fa): return Str.clone(fa.field_access_name(symbols.names))
    case .FCall:
        if pat.children.len() > 0 {
            switch pat.children[0].node_type {
            case .FieldAccess(fa2): return Str.clone(fa2.field_access_name(symbols.names))
            case:
            }
        }
        return ""
    case: return ""
    }
}

priv eval_switch := proc(mut scope: Scope, mut stmt: Expr, mut ctx: Context) {
    subj_i := raw_switch_key(scope, stmt.children[0], ctx)
    // For an enum scrutinee, resolve each case label by its variant TAG via the
    // enum def: a bare payload variant (`Type.V`) evaluates to its constructor,
    // not a tagged value, so it can't be eval'd for the key. int/char/bool
    // labels are constant expressions and evaluate directly.
    is_enum_subj := is_enum_type(stmt.children[0].til_type())
    mut enum_def_o := Option(ref Expr).None
    sname_o := expr_type_name_ref(stmt.children[0], ctx.symbols)
    if sname_o.is_some() {
        ref sname : Str = sname_o.unwrap()
        enum_def_o = lookup_type_def_helper(sname, scope, ctx)
    }
    mut has_default := false
    mut default_idx : USize = 0
    for ci in 1..stmt.children.len() {
        ref mut cn : Expr = stmt.children[ci]
        pc := case_pattern_count(cn)
        if pc == 0 {
            has_default = true
            default_idx = ci
            continue
        }
        // #334: the arm matches when ANY of its patterns does.
        mut matched := false
        for pi in 0..pc {
            ref mut pat : Expr = cn.children[pi]
            if is_enum_subj.and(enum_def_o.is_some()) {
                matched = enum_variant_tag(enum_def_o.unwrap(), clike_case_variant_name(pat, ctx.symbols)) == subj_i
            } else if is_range_new_call(pat, ctx.symbols) {
                // #254 range case `lo..hi`: match lo <= subj <= hi.
                lo := raw_switch_key(scope, pat.children[1], ctx)
                hi := raw_switch_key(scope, pat.children[2], ctx)
                matched = subj_i.gte(lo).and(subj_i.lte(hi))
            } else {
                matched = raw_switch_key(scope, pat, ctx) == subj_i
            }
            if matched { break }
        }
        if matched {
        mut case_scope := scope_new(safe_ref(scope))
            eval_body(case_scope, cn.children[cn.children.len() - 1], ctx)
            scope_free(own case_scope)
            return
        }
    }
    if has_default {
        mut def_scope := scope_new(safe_ref(scope))
        eval_body(def_scope, stmt.children[default_idx].children[0], ctx)
        scope_free(own def_scope)
    }
}

priv eval_declaration := proc(mut scope: Scope, mut stmt: Expr, dd: Declaration, mut ctx: Context) {
    ref mut rhs : Expr = stmt.children[0]
    if dd.external_symbol.len() > 0 {
        // Compile-time folding has no loaded user library. The declaration is
        // deliberately absent from the known-value scope, which prevents any
        // function reading it from being folded as a constant.
        if ctx.ffi.loaded.not() { return }
        ref address : U8 = ffi_dlsym(dd.external_symbol)
        if address.is_null() { panic("external global symbol not found: ", dd.external_symbol) }
        external_type := declaration_resolved_type(dd, ctx.scope, ctx.symbols)
        scope_set_heap_owned(scope, dd.name, address, interp_intern_type(external_type, ctx),
            OwnType.Shallow, ctx, false, true)
        return
    }
    if stmt.til_type().is(Type.None) {
        if rhs.node_type.is(NodeType.Ident) { return }
    }
    mut rhs_info := raw_result_info_new()
    mut rhs_raw : Dynamic = 0
    mut source_hb_o := Option(ref HeapBinding).None
    switch rhs.node_type {
    case .Ident(rhs_ident):
        source_hb_o = scope_lookup_heap_binding(scope, rhs_ident.ident_name(ctx.symbols.names))
        if source_hb_o.is_none() { panic("declaration source not found: ", rhs_ident.ident_name(ctx.symbols.names)) }
        ref source_hb : HeapBinding = source_hb_o.unwrap()
        rhs_info.source_type_p = source_hb.til_type_p
        if hb_type(source_hb).is(Type.Dynamic).and(rhs.til_type().is(Type.Dynamic).not()) {
            rhs_info.source_type_p = to_ptr(interp_intern_type(rhs.til_type(), ctx))
        }
    case:
        rhs_raw = eval_expr_raw_info(scope, rhs, ctx, rhs_info)
    }
    ref rhs_type : Type = raw_result_source_type(rhs_info)
    mut decl_type := rhs_type.clone()
    declared_name := decl_type_name(dd, ctx.symbols)
    if dd.til_type.is(Type.Unknown).not() { decl_type = declaration_resolved_type(dd, ctx.scope, ctx.symbols) }
    if decl_type.is(Type.Body).and(is_enum_type(rhs_type)) { decl_type = rhs_type.clone() }
    if rhs.node_type.is(NodeType.FuncDef).or(rhs.node_type.is(NodeType.StructDef)).or(rhs.node_type.is(NodeType.EnumDef)) {
        decl_type = Type.Body
    }
    // Canonical block (as a raw word) for the binding to borrow;
    // decl_type stays the owned working copy for the value logic below.
    bind_type_w : Dynamic = interp_intern_type(decl_type, ctx)
    switch rhs.node_type {
    case .Ident(rhs_ident):
        ref mut source_hb : HeapBinding = source_hb_o.unwrap()
        if source_hb.moved_out { panic("declaration from moved binding: ", rhs_ident.ident_name(ctx.symbols.names)) }
        ref mut source_scope : Scope = scope_get_binding_scope(scope, rhs_ident.ident_name(ctx.symbols.names))
        ref source_raw : Dynamic = to_ptr(source_hb.ptr)
        if is_enum_type(decl_type) {
            if (type_name_of(decl_type, ctx.symbols).unwrap() == "Type").and(source_hb.is_static_callable) {
                runtime_type : Dynamic = eval_expr_raw(scope, rhs, ctx)
                scope_set_raw_owned(scope, dd.name, runtime_type, bind_type_w, dd.own_type, ctx)
                return
            }
        }
        if dd.own_type.is(OwnType.Ref) {
            if hb_type(source_hb).is(Type.Dynamic).and(decl_type.is(Type.Dynamic).not()) {
                mut pointed : Dynamic = source_raw
                if source_hb.is_erased_dynamic.not() { pointed = deref(source_raw) }
                scope_set_heap_owned(scope, dd.name, pointed, bind_type_w, dd.own_type, source_hb.ctx, false, true)
            } else {
                scope_set_borrowed(scope, dd.name, bind_type_w, dd.own_type, rhs_ident.ident_name(ctx.symbols.names), source_scope)
            }
            return
        }
        // A SHALLOW primitive source COPIES by value (C scalar semantics):
        // load the scalar (through the Dynamic box for an erased source),
        // widen, and give the new binding its own block. The source
        // binding keeps its storage untouched. Own-primitive sources
        // (#302 raw allocations) keep the block-transfer paths below.
        mut prim_value_type := hb_type(source_hb).clone()
        if hb_type(source_hb).is(Type.Dynamic) { prim_value_type = decl_type.clone() }
        if source_hb.own_type.is(OwnType.Shallow).not().and(hb_type(source_hb).is(Type.Dynamic).not()) { prim_value_type = Type.Unknown }
        if raw_type_is_prim(prim_value_type, ctx).and(decl_type.is(Type.Dynamic).not()).and(dd.own_type.is(OwnType.Own).not()) {
            mut prim_src : Dynamic = source_raw
            if hb_type(source_hb).is(Type.Dynamic) { prim_src = deref(source_raw) }
            mut w : Dynamic = scalar_word_load(prim_value_type, prim_src, ctx)
            w = raw_widen_numeric(w, prim_value_type, declared_name, ctx)
            scope_set_raw_owned(scope, dd.name, scalar_block_from_word(decl_type, w, ctx), bind_type_w, dd.own_type, ctx)
            return
        }
        // Mirror of the pointer-FIELD arm below: a `ref`/`own` binding to a
        // scalar IS a pointer, so `p : Dynamic = c` must carry that pointer.
        // Every path below copies the POINTEE instead -- one byte for an I8 --
        // leaving `p` aimed at a one-byte clone, so offset 0 read correctly
        // and every later offset read zero (#357).
        if decl_type.is(Type.Dynamic).and(hb_type(source_hb).is(Type.Dynamic).not())
            .and(source_hb.own_type.is(OwnType.Shallow).not())
            .and(hb_type(source_hb).is(Type.Primitive)) {
            scope_set_heap_owned(scope, dd.name, source_raw, bind_type_w, dd.own_type, ctx, false, true, true)
            return
        }
        if dd.name.starts_with("hoisted__").or(source_hb.is_borrowed).or(heap_slot_is_static_callable(hb_type(source_hb), source_raw)) {
            mut copied : Dynamic = source_raw
            if hb_type(source_hb).is(Type.Dynamic).and(decl_type.is(Type.Dynamic).not()) {
                mut dynamic_data : Dynamic = source_raw
                if source_hb.is_erased_dynamic.not() { dynamic_data = deref(source_raw) }
                copied = heap_clone_by_type(decl_type, dynamic_data, source_hb.ctx)
            } else if hb_type(source_hb).is(Type.Dynamic).and(source_hb.is_erased_dynamic) {
                // Erased-dynamic source: hb.ptr IS the pointer word, not a
                // boxed slot. Box the word so the owned copy matches h_free's
                // two-level Dynamic layout; heap_clone_by_type's Dynamic arm
                // derefs, which here reads the pointed block's bytes as a
                // pointer.
                copied = EvalHeap.heap_alloc(Dynamic.size())
                write_ptr(copied, source_raw)
            } else {
                copied = heap_clone_by_type(hb_type(source_hb), source_raw, source_hb.ctx)
            }
            if hb_type(source_hb).is(Type.Dynamic).not().and(decl_type.is(Type.Dynamic)) {
                if heap_type_is_callable(hb_type(source_hb)).not() {
                    // Box the cloned BLOCK into a Dynamic slot directly
                    // (raw_coerce_value's boxing arm now takes value words).
                    mut wrapper : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
                    write_ptr(wrapper, copied)
                    copied = wrapper
                }
                scope_set_heap_owned(scope, dd.name, copied, bind_type_w, dd.own_type, source_hb.ctx, true)
                return
            }
            copied = raw_widen_numeric(copied, hb_type(source_hb), declared_name, ctx)
            scope_set_raw_owned(scope, dd.name, copied, bind_type_w, dd.own_type, source_hb.ctx)
        } else {
            mut moved : Dynamic = source_raw
            if hb_type(source_hb).is(Type.Dynamic).and(decl_type.is(Type.Dynamic).not()) {
                ref dynamic_data2 : Dynamic = deref(source_raw)
                moved = dynamic_data2
                owned_holder : Dynamic = source_raw
                EvalHeap.heap_free(own owned_holder)
            }
            source_hb.ptr = bits_word(0)
            source_hb.moved_out = true
            if hb_type(source_hb).is(Type.Dynamic).not().and(decl_type.is(Type.Dynamic)) {
                if heap_type_is_callable(hb_type(source_hb)).not() {
                    // Box the moved BLOCK into a Dynamic slot directly
                    // (raw_coerce_value's boxing arm now takes value words).
                    mut wrapper : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
                    write_ptr(wrapper, moved)
                    moved = wrapper
                }
                scope_set_heap_owned(scope, dd.name, moved, bind_type_w, dd.own_type, source_hb.ctx, true)
                return
            }
            moved = raw_widen_numeric(moved, hb_type(source_hb), declared_name, ctx)
            scope_set_raw_owned(scope, dd.name, moved, bind_type_w, dd.own_type, source_hb.ctx)
        }
        return
    case:
        is_ref := rhs_info.is_ref
        mut raw : Dynamic = rhs_raw
        if is_ref {
            pointed : Dynamic = raw
            mut borrowed_pointer_field := false
            switch rhs.node_type {
            case .FieldAccess:
                mut fallback_source_name := ""
                ref source_name : Str = field_access_sname(rhs, fallback_source_name, ctx.symbols)
                source_field_o := field_access_decl(rhs, source_name, ctx)
                if source_field_o.is_some() {
                    ref source_field : Declaration = source_field_o.unwrap()
                    borrowed_pointer_field = source_field.own_type.is(OwnType.Shallow).not().and(source_field.til_type.is(Type.Primitive))
                }
            case:
            }
            if borrowed_pointer_field {
                // `p : Dynamic = s.c_str` -- a pointer-to-scalar FIELD is
                // already the value the Dynamic wants, so the binding holds
                // the pointer word itself and must SAY so: without the
                // erased-dynamic flag every later read of `p` treated the
                // word as a boxed slot and dereferenced it once more,
                // handing back the bytes AT the string instead of the
                // string's address (#357).
                scope_set_heap_owned(scope, dd.name, pointed, bind_type_w, dd.own_type, ctx, false, true, decl_type.is(Type.Dynamic))
            } else if dd.own_type.is(OwnType.Ref) {
                scope_set_heap_owned(scope, dd.name, pointed, bind_type_w, dd.own_type, ctx, false, true, decl_type.is(Type.Dynamic))
            } else if decl_type.is(Type.Dynamic) {
                mut dynamic_slot : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
                write_ptr(dynamic_slot, pointed)
                scope_set_raw_owned(scope, dd.name, dynamic_slot, bind_type_w, dd.own_type, ctx)
            } else if raw_type_is_prim(rhs_type, ctx) {
                // A ref prim rhs is a bare source address: load the scalar
                // word, widen, and give the binding its own block.
                prim_w : Dynamic = raw_widen_numeric(scalar_word_load(rhs_type, pointed, ctx), rhs_type, declared_name, ctx)
                scope_set_raw_owned(scope, dd.name, scalar_block_from_word(decl_type, prim_w, ctx), bind_type_w, dd.own_type, ctx)
            } else if dd.name.starts_with("_steal_") {
                // #321: the typer's niche move-out temp is the one owned decl
                // whose ref-returning RHS hands over an ORPHAN: get_payload
                // loaded the payload box out of an enum the same block is
                // about to shell-free, so nothing else owns it. The general
                // rule below CLONES, which is value-correct but orphans the
                // box -- a 24-byte leak per taken payload, interp-only,
                // because the compiled backend hands the pointer on with zero
                // copies. Adopting the box IS the interpreter's mirror of
                // that hand-over. The gate is the same compiler-internal
                // `_steal_` prefix the typer's own-result exemption uses, so
                // no user-writable spelling reaches this arm.
                scope_set_raw_owned(scope, dd.name, pointed, bind_type_w, dd.own_type, ctx)
            } else {
                mut copied : Dynamic = heap_clone_by_type(rhs_type, pointed, ctx)
                copied = raw_coerce_value(copied, rhs_type, decl_type, ctx, dd.own_type)
                scope_set_raw_owned(scope, dd.name, copied, bind_type_w, dd.own_type, ctx)
            }
        } else {
            if dd.own_type.is(OwnType.Ref).and(decl_type.is(Type.Dynamic)) {
                ref pointed : Dynamic = deref(raw)
                scope_set_heap_owned(scope, dd.name, pointed, bind_type_w, dd.own_type, ctx, false, true, true)
                EvalHeap.heap_free(own raw)
                return
            }
            // GcStorage is the settled outer representation. HeapBox means
            // the eval result is already the pointer datum (raw allocation or
            // narrowed Dynamic return), not an inline scalar word to re-box.
            rhs_is_pointer := dd.gc_storage.is(GcStorage.HeapBox)
            if rhs_is_pointer.and(rhs_type.is(Type.Dynamic)).and(raw_type_is_prim(decl_type, ctx)) {
                // #302 raw-alloc bind from a Dynamic-slot eval: the POINTER
                // is the binding datum -- raw_coerce_value's shallow value
                // unbox would read the box's bytes as the value and drop
                // the allocation on the floor.
                ref alloc_pointed : Dynamic = deref(raw)
                alloc_ptr : Dynamic = alloc_pointed
                EvalHeap.heap_free(own raw)
                raw = alloc_ptr
            } else {
                raw = raw_coerce_value(raw, rhs_type, decl_type, ctx, dd.own_type)
            }
            raw = binding_block_from_word(decl_type, raw, rhs_is_pointer, ctx)
            scope_set_raw_owned(scope, dd.name, raw, bind_type_w, dd.own_type, ctx)
            if raw_type_is_prim(decl_type, ctx).and(rhs_is_pointer) {
                    ref mut pointer_hb : HeapBinding = scope_lookup_heap_binding(scope, dd.name).unwrap()
                pointer_hb.is_raw_alloc = true
            }
        }
    }
}

priv eval_fcall := proc(mut scope: Scope, mut stmt: Expr, fcd: FCallData, mut ctx: Context) {
    // #272 step 3: a swap_replace FCall is hoist_param_swap_assign's
    // lowering of `param = rhs` for a mut aggregate param. The
    // compiled backend emits delete-copy-free (a MOVE: delete the
    // target's old value, value-copy the temp in, free the temp
    // wrapper; the garbager sees the swap_replace transfer and stands
    // its delete down). Running the literal byte swap here
    // instead left the target and the temp aliasing one payload,
    // which blocks deep scope teardown (UAF). Mirror the move:
    // deep-delete the target's old raw value, move the temp's bytes in, and
    // null the temp slot so its teardown is a no-op.
    mut did_swap_replace := false
    if fcd.swap_replace.and(stmt.children.len().gte(3)) {
        mut sw_target := ""
        mut sw_src := ""
        switch stmt.children[1].node_type {
        case .Ident(sw_t): sw_target = Str.clone(sw_t.ident_name(ctx.symbols.names))
        case:
        }
        switch stmt.children[2].node_type {
        case .Ident(sw_s): sw_src = Str.clone(sw_s.ident_name(ctx.symbols.names))
        case:
        }
        if sw_target.len().gt(0).and(sw_src.len().gt(0)) {
                mut sw_hb_o := scope_lookup_heap_binding(scope, sw_target)
                mut sw_src_hb_o := scope_lookup_heap_binding(scope, sw_src)
                if sw_hb_o.is_none().or(sw_src_hb_o.is_none()) { panic("swap_replace binding not found") }
                ref mut sw_hb : HeapBinding = sw_hb_o.unwrap()
                ref mut sw_src_hb : HeapBinding = sw_src_hb_o.unwrap()
            if sw_src_hb.moved_out { panic("swap_replace from moved source: ", sw_src) }
            if sw_src_hb.is_borrowed { panic("swap_replace from borrowed source: ", sw_src) }
            ref mut sw_data : Dynamic = to_ptr(sw_hb.ptr)
            ref mut sw_src_data : Dynamic = to_ptr(sw_src_hb.ptr)
            _ := heap_move_ptr_into_slot(hb_type(sw_hb), sw_data, sw_src_data, sw_hb.ctx)
            sw_src_hb.ptr = bits_word(0)
            sw_src_hb.moved_out = true
            did_swap_replace = true
        }
    }
    if did_swap_replace { return }
    // A bare call-statement discards its typed raw result.
    mut discard_info := raw_result_info_new()
    ref discard_type : Type = stmt.til_type()
    mut discard : Dynamic = eval_call_info(scope, stmt, discard_type, ctx, discard_info)
    raw_result_drop(discard_type, discard, discard_info.is_ref, ctx)
    // #275: the destructor just ran against a NAMED binding, so its payload
    // is gone -- record that, or session teardown drops the same value a
    // second time (ASAN: double-free through free_container_data). This is
    // bookkeeping about a call the interpreter already dispatched, not a
    // reimplementation of it: the body ran, as it must.
    mark_deleted_receiver(scope, stmt, ctx.symbols)
}

// True when this statement is a `<Type>.delete(...)` call; the receiver is
// the first argument (UFCS put it there).
priv mark_deleted_receiver := func(mut scope: Scope, stmt: Expr, symbols: SymbolPool) {
    if stmt.children.len() < 2 { return }
    mut is_delete := false
    switch stmt.children[0].node_type {
    case .FieldAccess(mfa): is_delete = mfa.field_access_name(symbols.names).eq("delete")
    case .Ident(mid): is_delete = mid.ident_name(symbols.names).ends_with("_delete")
    case:
    }
    if is_delete.not() { return }
    switch stmt.children[1].node_type {
    case .Ident(recv_id):
        mut hb_o := scope_lookup_heap_binding(scope, recv_id.ident_name(symbols.names))
        if hb_o.is_none() { return }
        ref mut hb : HeapBinding = hb_o.unwrap()
        hb.payload_released = true
    case:
    }
}

priv eval_if := proc(mut scope: Scope, mut stmt: Expr, mut ctx: Context) {
    cv := eval_bool_arg(scope, stmt.children[0], ctx)
    if cv {
        mut then_scope := scope_new(safe_ref(scope))
        eval_body(then_scope, stmt.children[1], ctx)
        scope_free(own then_scope)
    } else if stmt.children.len() > 2 {
        mut else_scope := scope_new(safe_ref(scope))
        eval_body(else_scope, stmt.children[2], ctx)
        scope_free(own else_scope)
    }
}

priv eval_while := proc(mut scope: Scope, mut stmt: Expr, mut ctx: Context) {
    ref mut c : Context = ctx
    while true {
        if c.eval.has_return { break }
        // A const-folder abort inside the loop body stops iteration (the
        // body's eval_body already bailed); don't re-evaluate the condition.
        if c.eval.eval_aborted { break }
        cv := eval_bool_arg(scope, stmt.children[0], ctx)
        if cv.not() { break }
        mut while_scope := scope_new(safe_ref(scope))
        eval_body(while_scope, stmt.children[1], ctx)
        scope_free(own while_scope)
        if c.eval.has_break { c.eval.has_break = false; break }
        if c.eval.has_continue { c.eval.has_continue = false }
    }
}

priv eval_body := proc(mut scope: Scope, mut body: Expr, mut ctx: Context) {
    ref mut c : Context = ctx
    for mut e_i : Expr in body.children {
        if c.eval.has_return { return }
        if c.eval.has_break { return }
        if c.eval.has_continue { return }
        // A const-folder abort unwinds every enclosing body like an early
        // return until try_eval_call observes it.
        if c.eval.eval_aborted { return }
        ref mut stmt : Expr = e_i
        switch stmt.node_type {
        case .Decl(dd):
            eval_declaration(scope, stmt, dd, ctx)
        case .Assign(ad):
            ref mut rhs : Expr = stmt.children[0]
            mut assign_hb_o := scope_lookup_heap_binding(scope, ad.name)
            if assign_hb_o.is_none() { panic("assignment binding not found: ", ad.name) }
            ref mut assign_hb : HeapBinding = assign_hb_o.unwrap()
            mut new_raw : Dynamic = 0
            if stmt.til_type().is(Type.Dynamic).and(rhs.node_type.is(NodeType.Ident)) {
                switch rhs.node_type {
                case .Ident(rhs_ident): new_raw = scope_move_bound_raw(scope, rhs_ident.ident_name(ctx.symbols.names), ctx)
                case:
                }
            } else {
                mut new_info := raw_result_info_new()
                new_raw = eval_expr_raw_info(scope, rhs, ctx, new_info)
                if new_info.is_ref {
                    // A ref raw is the bare target address: load the scalar
                    // inline / clone the aggregate; the target keeps its
                    // storage.
                    if raw_type_is_prim(hb_type(assign_hb), ctx) {
                        new_raw = scalar_word_load(hb_type(assign_hb), new_raw, ctx)
                    } else {
                        copied : Dynamic = heap_clone_by_type(hb_type(assign_hb), new_raw, assign_hb.ctx)
                        new_raw = copied
                    }
                } else {
                    new_raw = raw_coerce_value(new_raw, raw_result_source_type(new_info), hb_type(assign_hb), ctx, assign_hb.own_type)
                }
            }
            if raw_type_is_prim(hb_type(assign_hb), ctx).and(assign_hb.is_raw_alloc.not()).and(stmt.til_type().is(Type.Dynamic).not()) {
                // Primitive assignment writes the scalar into the existing
                // block in place (C's x = v) -- for a ref/borrowed binding
                // or an owned closure capture the block IS the target storage,
                // so this is write-through. No drop, no allocation. Only
                // #302 raw-allocation pointers keep the transfer path below. A
                // consumed raw-alloc binding (own-arg freed + reassigned)
                // has no block left -- give it a fresh one.
                if assign_hb.ptr.is_null() {
                    fresh_block : Dynamic = scalar_block_from_word(hb_type(assign_hb), new_raw, ctx)
                    assign_hb.ptr = to_ptr(fresh_block)
                }
                else { scalar_word_store(hb_type(assign_hb), to_ptr(assign_hb.ptr), new_raw, ctx) }
            } else if assign_hb.is_borrowed {
                // Write THROUGH the borrow into the referent's storage. The
                // old value's teardown follows save_old_delete exactly as the
                // owning path below does; without that the garbager's own
                // delete and this drop both free it.
                ref mut assign_data : Dynamic = to_ptr(assign_hb.ptr)
                _ := heap_move_ptr_into_slot(hb_type(assign_hb), assign_data, new_raw, assign_hb.ctx, ad.save_old_delete)
            } else {
                scope_drop_existing_heap_slot(scope_get_binding_scope(scope, ad.name), ad.name, ad.save_old_delete)
                assign_hb.ptr = to_ptr(new_raw)
            }
            assign_hb.moved_out = false
        case .FieldAssign(fad):
            fname := fad.name
            ref mut val_expr : Expr = stmt.children[1]
            // #302 stage 4: a marked move consumes the clone's ARG -- the
            // same substitution the builder does at consumption. Without
            // it the transfers_own Ident-move path below would instead
            // evaluate the kept clone (a deep copy) and the moved-from
            // binding's teardown would double-account (bug256's interp
            // leak, caught by the suite when the AST rewrite retired).
            if fad.is_move.and(rhs_is_clone_fcall(val_expr, ctx.symbols)).and(val_expr.children.len().gte(2)) {
                val_expr = val_expr.children[1]
            }
            mut val_raw : Dynamic = 0
            mut val_is_ref := false
            mut val_source_type := val_expr.til_type().clone()
            if fad.transfers_own {
                switch val_expr.node_type {
                case .Ident(val_id):
                    val_raw = scope_move_bound_raw(scope, val_id.ident_name(ctx.symbols.names), ctx)
                case:
                    mut val_info := raw_result_info_new()
                    val_raw = eval_expr_raw_info(scope, val_expr, ctx, val_info)
                    val_is_ref = val_info.is_ref
                    val_source_type = raw_result_source_type(val_info).clone()
                }
            } else {
                switch val_expr.node_type {
                case .Ident(val_id):
                    source_hb_o := scope_lookup_heap_binding(scope, val_id.ident_name(ctx.symbols.names))
                    if source_hb_o.is_none() { panic("field assignment source not found: ", val_id.ident_name(ctx.symbols.names)) }
                    ref source_hb : HeapBinding = source_hb_o.unwrap()
                    if source_hb.moved_out { panic("field assignment source moved: ", val_id.ident_name(ctx.symbols.names)) }
                    ref source_raw : Dynamic = to_ptr(source_hb.ptr)
                    val_raw = source_raw
                    val_is_ref = true
                    val_source_type = hb_type(source_hb).clone()
                case:
                    mut val_info := raw_result_info_new()
                    val_raw = eval_expr_raw_info(scope, val_expr, ctx, val_info)
                    val_is_ref = val_info.is_ref
                    val_source_type = raw_result_source_type(val_info).clone()
                }
            }
            if interp_fa_namespace_def(scope, stmt, ctx).is_some() {
                mut sname_o := expr_type_name_ref(stmt.children[0], ctx.symbols)
                if sname_o.is_none() {
                    switch stmt.children[0].node_type {
                    case .Ident(oi): sname_o = safe_ref(oi.ident_name(ctx.symbols.names))
                    case:
                    }
                }
                if sname_o.is_some() {
                    ref sname : Str = sname_o.unwrap()
                    target_type := ns_field_type(sname, fname, ctx)
                    if val_is_ref {
                        owned : Dynamic = heap_clone_by_type(target_type, val_raw, ctx)
                        val_raw = owned
                    } else {
                        val_raw = raw_coerce_value(val_raw, val_source_type, target_type, ctx)
                        // ns storage is a binding: a scalar word needs a block.
                        val_raw = binding_block_from_word(target_type, val_raw, false, ctx)
                    }
                    ns_set(sname, fname, val_raw, target_type, ctx)
                } else {
                    target_type := ns_field_type("", fname, ctx)
                    if val_is_ref {
                        owned : Dynamic = heap_clone_by_type(target_type, val_raw, ctx)
                        val_raw = owned
                    } else {
                        val_raw = raw_coerce_value(val_raw, val_source_type, target_type, ctx)
                    }
                    // ns storage is a binding: a scalar word needs a block.
                    val_raw = binding_block_from_word(target_type, val_raw, false, ctx)
                    ns_set("", fname, val_raw, target_type, ctx)
                }
            } else {
                // The chain walk below reassigns `base` through raw pointer
                // arithmetic (ptr_add / deref), so it is a raw Dynamic from
                // here on; the Option only answers "did the root resolve".
                base_root_o := resolve_field_assign_base(scope, stmt.children[0], ctx.symbols)
                mut base : Dynamic = 0
                if base_root_o.is_some() { base = base_root_o.unwrap() }
                mut cur_sdef_o := resolve_field_assign_sdef(scope, stmt.children[0], ctx)
                mut cur_sname : Str = resolve_field_assign_sname(scope, stmt.children[0], ctx.symbols)
                // Chain walking for nested field access (e.g. a.b.c = val).
                // Collect the chain's field names outer-to-inner (for
                // `c.b.a`: [a, b]) while descending to the root Ident, then
                // apply them root-to-leaf so `base` ends at the struct whose
                // field `fname` is assigned. Previously only depth==1 was
                // handled, so `c.b.a.x = 42` left base/cur_sdef pointing at
                // `c`/C; find_field_decl(C, "x") then returned NULL and
                // write_field dereferenced the null Declaration (a segfault
                // in field_nested_def -> is_primitive).
                if stmt.children[0].node_type.is(NodeType.FieldAccess) {
                    mut chain_names := Vec(Str).new()
                    ref mut cur : Expr = stmt.children[0]
                    while cur.node_type.is(NodeType.FieldAccess) {
                        switch cur.node_type {
                        case .FieldAccess(fa_link):
                            chain_names.push(own Str.clone(fa_link.field_access_name(ctx.symbols.names)))
                        case:
                        }
                        cur = cur.children[0]
                    }
                    switch cur.node_type {
                    case .Ident:
                        // A root that does not resolve leaves `base` as the
                        // caller found it; the is_null check below reports it.
                        base_ident_o := resolve_field_assign_base(scope, cur, ctx.symbols)
                        if base_ident_o.is_some() {
                            base = base_ident_o.unwrap()
                            cur_sdef_o = resolve_field_assign_sdef(scope, cur, ctx)
                            cur_sname = resolve_field_assign_sname(scope, cur, ctx.symbols)
                            mut step_i : USize = chain_names.len()
                            while step_i > 0 {
                                step_i--
                                ref step_name : Str = chain_names[step_i]
                                if cur_sdef_o.is_none() { break }
                                step_fd_o := find_field_decl(cur_sdef_o.unwrap(), step_name)
                                if step_fd_o.is_none() { break }
                                ref step_fd : Declaration = step_fd_o.unwrap()
                                step_off := ctx_field_layout(cur_sname, step_name, ctx).offset
                                if step_fd.own_type.is(OwnType.Shallow).not() {
                                    base = deref(ptr_add(base, step_off))
                                } else {
                                    base = ptr_add(base, step_off)
                                }
                                cur_sdef_o = field_nested_def(step_fd, ctx)
                                cur_sname = resolved_type_name(declaration_resolved_type(step_fd, ctx.scope, ctx.symbols), ctx.symbols)
                            }
                        }
                    case:
                    }
                }
                if base.is_null() {
                    interp_error(stmt, "field assign on non-struct", ctx)
                    exit(1)
                }
                if cur_sdef_o.is_none() {
                    interp_error(stmt, "field assign on non-struct", ctx)
                    exit(1)
                }
                ref cur_sdef : Expr = cur_sdef_o.unwrap()
                // cur_sdef was resolved from cur_sname above and the
                // field name comes from the same assign node, so a miss
                // here is a broken layout, not a state.
                ref fdecl : Declaration = find_field_decl(cur_sdef, fname).unwrap()
                ref wf_fl : FieldLayout = ctx_field_layout(cur_sname, fname, ctx)
                write_field(base, fdecl, wf_fl.offset, wf_fl.size, val_raw, val_source_type, val_is_ref, fad.save_old_delete, ctx)
            }
        case .FCall(fcd):
            eval_fcall(scope, stmt, fcd, ctx)
        case .Body:
            mut block_scope := scope_new(safe_ref(scope))
            eval_body(block_scope, stmt, ctx)
            scope_free(own block_scope)
        case .CaptureBlock:
            // Issue #54: a capture block runs its body inline -- the typer
            // already enforced the capture restriction, so at runtime it
            // behaves exactly like a bare `{ ... }` block.
            mut cb_scope := scope_new(safe_ref(scope))
            eval_body(cb_scope, stmt.children[0], ctx)
            scope_free(own cb_scope)
        case .If:
            eval_if(scope, stmt, ctx)
        case .While:
            eval_while(scope, stmt, ctx)
        case .Break:
            c.eval.has_break = true
        case .Continue:
            c.eval.has_continue = true
        case .Return:
            if stmt.children.len() > 0 {
                ref mut ret_expr : Expr = stmt.children[0]
                mut return_raw : Dynamic = 0
                mut return_source_type := ret_expr.til_type().clone()
                mut return_source_is_ref := false
                switch ret_expr.node_type {
                case .Ident(ret_ident):
                    return_hb_o := scope_lookup_heap_binding(scope, ret_ident.ident_name(ctx.symbols.names))
                    if return_hb_o.is_none() { panic("return binding not found: ", ret_ident.ident_name(ctx.symbols.names)) }
                    ref return_hb : HeapBinding = return_hb_o.unwrap()
                    return_source_type = hb_type(return_hb).clone()
                    // A callable-typed binding never reads back as a borrow --
                    // a static callable comes
                    // out as a fresh OWNED box, a closure as a clone. Deriving
                    // ref-ness from own_type alone made `return v` on a
                    // FuncSig-typed Ref param reframe that owned box as if
                    // borrowed: clone it and orphan the original, 8 leaked
                    // bytes per call.
                    return_source_is_ref = return_hb.own_type.is(OwnType.Ref).and(heap_type_is_callable(hb_type(return_hb)).not())
                    // A SHALLOW primitive return reads the scalar word; the
                    // binding keeps its block (nothing inner to move).
                    if scope_return_move_is_local(scope, ret_ident.ident_name(ctx.symbols.names))
                    .and(return_hb.is_raw_alloc.or(raw_type_is_prim(hb_type(return_hb), ctx).and(return_hb.own_type.is(OwnType.Shallow)).not())) {
                        return_raw = scope_move_bound_raw(scope, ret_ident.ident_name(ctx.symbols.names), ctx)
                        // An own-prim VALUE binding's moved block collapses to
                        // the inline word callers expect from a prim-stamped
                        // call; a #302 raw-alloc POINTER binding keeps its
                        // bare pointer (which already travels as word bits) --
                        // unless the fn's declared return type is Dynamic, in
                        // which case callers expect the Dynamic wrapper shape
                        // (slot -> value storage): box the bare pointer.
                        if raw_type_is_prim(hb_type(return_hb), ctx).and(return_source_is_ref.not()) {
                            if return_hb.is_raw_alloc.and(type_from_name_init_name(interp_ret_type_name(c), ctx.scope, ctx.symbols).is(Type.Dynamic)) {
                                // A #302 raw-alloc pointer returned at a
                                // Dynamic-declared type: callers expect the
                                // Dynamic wrapper shape (slot -> value
                                // storage), so box the bare pointer.
                                mut alloc_wrap : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
                                write_ptr(alloc_wrap, return_raw)
                                return_raw = alloc_wrap
                                // The value is now Dynamic-shaped; the prim
                                // source stamp would make raw_result_reframe
                                // re-read the wrapper's low bytes.
                                return_source_type = Type.Dynamic
                            } else {
                                // The moved block (an own-prim VALUE binding's
                                // block, or a #302 raw-alloc VALUE box such as
                                // Vec.pop's malloc'd `out`) collapses to the
                                // inline word callers expect from a
                                // prim-stamped call, and the block is
                                // reclaimed here -- the block model's
                                // move_into copied-and-freed the same way.
                                moved_word : Dynamic = scalar_word_load(hb_type(return_hb), return_raw, ctx)
                                EvalHeap.heap_free(own return_raw)
                                return_raw = moved_word
                            }
                        }
                    } else {
                        return_raw = scope_read_bound_raw(scope, ret_ident.ident_name(ctx.symbols.names), ctx)
                    }
                    return_raw = raw_result_reframe(return_source_type, return_raw, return_source_is_ref, c.eval.interp_ret_is_ref, ctx)
                case .FCall:
                    mut inner_info := raw_result_info_new()
                    return_raw = eval_expr_raw_info(scope, ret_expr, ctx, inner_info, c.eval.interp_ret_dest)
                    return_raw = raw_result_reframe(ret_expr.til_type(), return_raw, inner_info.is_ref, c.eval.interp_ret_is_ref, ctx)
                case .FieldAccess:
                    if c.eval.interp_ret_is_ref {
                        // field_access_returns_ref gated this branch, so the
                        // base resolves.
                        return_raw = field_access_base(scope, ret_expr, ctx).unwrap()
                        return_source_is_ref = true
                    } else {
                        mut inner_info := raw_result_info_new()
                        return_raw = eval_expr_raw_info(scope, ret_expr, ctx, inner_info, c.eval.interp_ret_dest)
                        return_source_type = raw_result_source_type(inner_info).clone()
                        return_raw = raw_result_reframe(return_source_type, return_raw, inner_info.is_ref, false, ctx)
                    }
                case:
                    if ret_expr.node_type.is_literal_null().and(c.eval.interp_ret_is_ref) {
                        return_raw = 0
                        return_source_is_ref = true
                    } else {
                        mut inner_info := raw_result_info_new()
                        return_raw = eval_expr_raw_info(scope, ret_expr, ctx, inner_info, c.eval.interp_ret_dest)
                        return_raw = raw_result_reframe(ret_expr.til_type(), return_raw, inner_info.is_ref, c.eval.interp_ret_is_ref, ctx)
                    }
                }
                target_return_type := type_from_name_init_name(interp_ret_type_name(c), ctx.scope, ctx.symbols)
                if c.eval.interp_ret_is_ref.not() {
                    return_raw = raw_coerce_value(return_raw, return_source_type, target_return_type, ctx, c.eval.interp_ret_own_type)
                    return_raw = raw_result_finish(target_return_type, return_raw, c.eval.interp_ret_dest, false, ctx)
                }
                context_return_set(c, return_raw)
            } else {
                // A bare return carries the null None word: no allocation.
                context_return_set(c, bits_word(0))
            }
        case .Switch:
            eval_switch(scope, stmt, ctx)
        case:
            interp_lang_error(stmt, "unexpected statement type", ctx)
            exit(1)
        }
    }
}

priv interp_param_bind_type := func(param: Declaration, source_type_w: Dynamic, is_variadic: Bool, mut ctx: Context) returns Dynamic {
    if is_variadic { return source_type_w }
    return interp_intern_type(declaration_resolved_type(param, ctx.scope, ctx.symbols), ctx)
}

priv eval_user_func_call := proc(mut caller_scope: Scope, mut e: Expr, mut func_def: Expr, parent_scope: Scope, mut ctx: Context, mut destination: Dynamic = bits_word(0)) returns Dynamic {
    ref mut c : Context = ctx
    if func_def.children.len() == 0 {
        interp_error(e, "cannot call an interface method through the interface: it has no implementation", ctx)
        exit(1)
    }
    ref mut body : Expr = func_def.children[0]

    mut call_scope := scope_new(safe_ref(parent_scope))
    call_scope.is_call_scope = true
    dynamic_type_w : Dynamic = interp_intern_type(Type.Dynamic, ctx)
    ref fdef_params : FunctionDef = funcdef_of(func_def)
    for pi in 0..fdef_params.sig.params.len() {
        ref param : Declaration = fdef_params.sig.params[pi]
        ref mut arg_expr : Expr = e.children[pi + 1]
        // The call-site OWN BIT decides the transfer here, deliberately, and
        // NOT the callee's `own` parameter -- the two answer different
        // questions and are not meant to agree:
        //
        //   - `param.own_type == Own` is the callee's CONTRACT: it may
        //     consume what it is given. The garbager reads exactly this for
        //     delete placement (check_own_args), which is the right
        //     conservative approximation for a static pass.
        //   - the bit is THIS call site's decision. A call may invoke an
        //     own-taking function without handing over the caller's binding,
        //     and the garbager emits that shape on purpose:
        //     make_delete_call passes `arg_is_own = local.is_heap`, so a
        //     non-heap local (a script global's value binding) gets
        //     `T.delete(x, false)` with NO own bit -- drop the contents,
        //     keep the box, matching what the compiled backend emits.
        //
        // So an `own` parameter whose call-site bit is unset is normal, not a
        // bug: measured on the #275 0b repro, 3 such calls, all the `own
        // self` of a destructor. Do NOT "unify" this by reading the
        // parameter -- that was tried and it moves bindings the interpreter
        // still has to free, failing dyn_vecs / dyn_sets / hashsets /
        // dyn_arrays under ASAN teardown (387/391). Teardown correctness
        // rests on HeapBinding.payload_released instead, which records that
        // an interpreted delete already ran (#275 item 0b).
        arg_transfers := get_own_arg(e, pi + 1).and(get_keep_outer_arg(e, pi + 1).not())
        is_variadic_param := fdef_params.sig.variadic_index == pi.to_i32()
        switch arg_expr.node_type {
        case .Ident(arg_ident):
            mut source_hb_o := scope_lookup_heap_binding(caller_scope, arg_ident.ident_name(ctx.symbols.names))
            if source_hb_o.is_none() { panic("argument binding not found: ", arg_ident.ident_name(ctx.symbols.names)) }
            ref mut source_hb : HeapBinding = source_hb_o.unwrap()
            if source_hb.moved_out { panic("argument from moved binding: ", arg_ident.ident_name(ctx.symbols.names)) }
            ref source_raw : Dynamic = to_ptr(source_hb.ptr)
            if is_variadic_param.not().and(param.til_type.is(Type.Dynamic)).and(hb_type(source_hb).is(Type.Dynamic).not()) {
                mut dynamic_data : Dynamic = source_raw
                if arg_transfers {
                    if source_hb.is_borrowed {
                        // Dynamic cannot own or deep-delete the typed pointee.
                        // Own a wrapper while retaining the source borrow; an
                        // adopt can then free the wrapper without consuming the
                        // typed owner behind it.
                        mut borrowed_dynamic_slot : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
                        write_ptr(borrowed_dynamic_slot, dynamic_data)
                        scope_set_heap_owned(call_scope, param.name, borrowed_dynamic_slot, dynamic_type_w, param.own_type, ctx, true, false, true)
                        continue
                    } else if heap_slot_is_static_callable(hb_type(source_hb), source_raw) {
                        dynamic_data = heap_clone_by_type(hb_type(source_hb), source_raw, source_hb.ctx)
                    } else {
                        source_hb.ptr = bits_word(0)
                        source_hb.moved_out = true
                    }
                    if raw_type_is_prim(hb_type(source_hb), ctx) {
                        // The moved/cloned prim BLOCK is already the value
                        // storage: the Dynamic slot points AT it. The
                        // word-based prim->Dynamic coerce would box the
                        // block ADDRESS as the scalar.
                        mut prim_dyn_slot : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
                        write_ptr(prim_dyn_slot, dynamic_data)
                        dynamic_data = prim_dyn_slot
                    } else {
                        dynamic_data = raw_coerce_value(dynamic_data, hb_type(source_hb), Type.Dynamic, ctx, param.own_type)
                    }
                    scope_set_heap_owned(call_scope, param.name, dynamic_data, dynamic_type_w, param.own_type, ctx, true)
                } else if param.own_type.is(OwnType.Ref) {
                    scope_set_heap_owned(call_scope, param.name, dynamic_data, dynamic_type_w, param.own_type, ctx, false, true, true)
                } else {
                    mut dynamic_slot : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
                    write_ptr(dynamic_slot, dynamic_data)
                    scope_set_heap_owned(call_scope, param.name, dynamic_slot, dynamic_type_w, param.own_type, ctx, true)
                }
            } else if arg_transfers {
                mut owned_raw : Dynamic = source_raw
                bind_type_w : Dynamic = interp_param_bind_type(param, source_hb.til_type_p, is_variadic_param, ctx)
                ref bind_type : Type = to_ptr(bind_type_w)
                if source_hb.is_borrowed {
                    scope_set_heap_owned(call_scope, param.name, owned_raw, bind_type_w, param.own_type, source_hb.ctx, false, true, source_hb.is_erased_dynamic)
                    continue
                } else if heap_slot_is_static_callable(hb_type(source_hb), source_raw) {
                    owned_raw = heap_clone_by_type(hb_type(source_hb), source_raw, source_hb.ctx)
                } else {
                    source_hb.ptr = bits_word(0)
                    source_hb.moved_out = true
                }
                if raw_type_is_prim(hb_type(source_hb), ctx).and(source_hb.is_raw_alloc.not()).and(til_type_name_c(hb_type(source_hb)) != til_type_name_c(bind_type)) {
                    // Width-converting prim move: re-box at the param
                    // width (a narrow block bound under a wider type
                    // over-reads on the word load).
                    own_src_w : Dynamic = scalar_word_load(hb_type(source_hb), owned_raw, ctx)
                    EvalHeap.heap_free(own owned_raw)
                    owned_raw = scalar_block_from_word(bind_type, raw_widen_numeric(own_src_w, hb_type(source_hb), decl_type_name(param, ctx.symbols), ctx), ctx)
                } else {
                    owned_raw = raw_coerce_value(owned_raw, hb_type(source_hb), bind_type, ctx, param.own_type)
                }
                scope_set_heap_owned(call_scope, param.name, owned_raw, bind_type_w, param.own_type, ctx, true, false, source_hb.is_erased_dynamic)
            } else {
                bind_type_w : Dynamic = interp_param_bind_type(param, source_hb.til_type_p, is_variadic_param, ctx)
                ref bind_type : Type = to_ptr(bind_type_w)
                if hb_type(source_hb).is(Type.Dynamic).and(bind_type.is(Type.Dynamic).not()) {
                    mut pointed : Dynamic = source_raw
                    if source_hb.is_erased_dynamic.not() { pointed = deref(source_raw) }
                    scope_set_heap_owned(call_scope, param.name, pointed, bind_type_w, param.own_type, source_hb.ctx, false, true)
                } else if heap_type_is_callable(hb_type(source_hb)).and(heap_type_is_callable(bind_type)) {
                    ref mut arg_source_scope : Scope = scope_get_binding_scope(caller_scope, arg_ident.ident_name(ctx.symbols.names))
                    scope_set_borrowed(call_scope, param.name, bind_type_w, param.own_type, arg_ident.ident_name(ctx.symbols.names), arg_source_scope)
                } else if til_type_name_c(hb_type(source_hb)) != til_type_name_c(bind_type) {
                    if raw_type_is_prim(hb_type(source_hb), ctx).and(raw_type_is_prim(bind_type, ctx)).and(source_hb.is_raw_alloc.not()) {
                        // Width-converting prim copy: load the scalar at
                        // the SOURCE width, widen, and box at the param
                        // width (a narrow clone bound under a wider type
                        // over-reads on the word load).
                        src_w : Dynamic = scalar_word_load(hb_type(source_hb), source_raw, ctx)
                        widened_w : Dynamic = raw_widen_numeric(src_w, hb_type(source_hb), decl_type_name(param, ctx.symbols), ctx)
                        scope_set_raw_owned(call_scope, param.name, scalar_block_from_word(bind_type, widened_w, ctx), bind_type_w, param.own_type, ctx)
                    } else {
                        mut converted : Dynamic = heap_clone_by_type(hb_type(source_hb), source_raw, source_hb.ctx)
                        converted = raw_coerce_value(converted, hb_type(source_hb), bind_type, ctx, param.own_type)
                        scope_set_raw_owned(call_scope, param.name, converted, bind_type_w, param.own_type, ctx)
                    }
                } else if param.own_type.is(OwnType.Shallow).and(raw_type_is_prim(bind_type, ctx)) {
                    // Issue #353: a by-value prim parameter is a COPY in
                    // the emitted C, so borrowing the caller's storage
                    // here let a write to the source DURING the call (a
                    // global the callee assigns) change what the callee's
                    // parameter reads. Copy the scalar instead. `mut`
                    // prim params never reach this arm: auto-shallow
                    // (#223) skips them, so they stay OwnType.Ref and
                    // keep the borrow that makes them in/out, matching
                    // the pointer the C emit passes for them.
                    if source_hb.is_raw_alloc {
                        // #302 raw-alloc storage: clone the block as-is,
                        // the word load is for plain scalar blocks.
                        scope_set_raw_owned(call_scope, param.name, heap_clone_by_type(hb_type(source_hb), source_raw, source_hb.ctx), bind_type_w, param.own_type, ctx)
                    } else {
                        src_w : Dynamic = scalar_word_load(hb_type(source_hb), source_raw, ctx)
                        scope_set_raw_owned(call_scope, param.name, scalar_block_from_word(bind_type, src_w, ctx), bind_type_w, param.own_type, ctx)
                    }
                } else {
                    ref mut arg_source_scope : Scope = scope_get_binding_scope(caller_scope, arg_ident.ident_name(ctx.symbols.names))
                    scope_set_borrowed(call_scope, param.name, bind_type_w, param.own_type, arg_ident.ident_name(ctx.symbols.names), arg_source_scope)
                }
            }
        case:
            mut arg_info := raw_result_info_new()
            mut arg_raw : Dynamic = eval_expr_raw_info(caller_scope, arg_expr, ctx, arg_info)
            ref arg_source_type : Type = raw_result_source_type(arg_info)
            if is_variadic_param.not().and(param.til_type.is(Type.Dynamic)) {
                if arg_source_type.is(Type.Dynamic) {
                    if param.own_type.is(OwnType.Ref) {
                        scope_set_heap_owned(call_scope, param.name, arg_raw, dynamic_type_w, param.own_type, ctx, false, true, true)
                    } else {
                        scope_set_heap_owned(call_scope, param.name, arg_raw, dynamic_type_w, param.own_type, ctx, true)
                    }
                } else if param.own_type.is(OwnType.Ref) {
                    mut pointed : Dynamic = arg_raw
                    if arg_info.is_ref.not().and(arg_info.is_word) {
                        // A scalar word has no storage: box it so the
                        // borrowed Dynamic view has bytes to point at.
                        pointed = scalar_block_from_word(arg_source_type, arg_raw, ctx)
                    }
                    scope_set_heap_owned(call_scope, param.name, pointed, dynamic_type_w, param.own_type, ctx, false, true, true)
                } else {
                    mut dynamic_slot : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
                    if arg_info.is_ref { write_ptr(dynamic_slot, arg_raw) }
                    else if arg_info.is_word {
                        // Box the scalar word: the Dynamic slot points at
                        // real bytes (C's &x), as the block model did.
                        write_ptr(dynamic_slot, scalar_block_from_word(arg_source_type, arg_raw, ctx))
                    }
                    else { write_ptr(dynamic_slot, arg_raw) }
                    scope_set_heap_owned(call_scope, param.name, dynamic_slot, dynamic_type_w, param.own_type, ctx, true)
                }
            } else {
                bind_type_w : Dynamic = interp_param_bind_type(param, interp_intern_type(param.til_type, ctx), is_variadic_param, ctx)
                ref bind_type : Type = to_ptr(bind_type_w)
                mut borrowed := false
                if arg_info.is_ref {
                    // A by-value PRIM parameter is a copy in C -- only
                    // structs travel as pointers, scalars go by value.
                    // Borrowing the source storage for one lets a later
                    // write through the caller's binding change the
                    // parameter mid-call: `self.take_prefix(self.count)`
                    // read 0 for `n` because take_prefix zeroes
                    // self.count before building its result, while the
                    // compiled build read 2. Copy the scalar instead.
                    if param.own_type.is(OwnType.Shallow).and(raw_type_is_prim(arg_source_type, ctx)).and(raw_type_is_prim(bind_type, ctx)) {
                        src_w : Dynamic = scalar_word_load(arg_source_type, arg_raw, ctx)
                        arg_raw = scalar_block_from_word(bind_type, raw_widen_numeric(src_w, arg_source_type, decl_type_name(param, ctx.symbols), ctx), ctx)
                    } else {
                        borrowed = true
                    }
                } else {
                    arg_raw = raw_coerce_value(arg_raw, arg_source_type, bind_type, ctx, param.own_type)
                    if param.own_type.is(OwnType.Ref) {
                        switch arg_expr.node_type {
                        case .Literal(Literal.Null): borrowed = true
                        case:
                        }
                    }
                    // A scalar word needs real storage to become a
                    // binding slot. The Dynamic-source own/ref-target
                    // coercion transfers a pointer (#302) and stays.
                    mut arg_word := raw_type_is_prim(bind_type, ctx).and(borrowed.not())
                    if arg_source_type.is(Type.Dynamic).and(param.own_type.is(OwnType.Shallow).not()) { arg_word = false }
                    // A prim-stamped eval can still be a BLOCK (an Own-prim
                    // binding read: a #302 raw-alloc pointer datum). That is
                    // already storage-shaped; boxing it would store the
                    // block ADDRESS as the scalar.
                    if raw_type_is_prim(arg_source_type, ctx).and(arg_info.is_word.not()) { arg_word = false }
                    if arg_word { arg_raw = scalar_block_from_word(bind_type, arg_raw, ctx) }
                }
                scope_set_raw_owned(call_scope, param.name, arg_raw, bind_type_w, param.own_type, ctx, borrowed)
            }
        }
    }
    c.eval.has_return = false
    c.eval.return_value = 0
    saved_ret_is_ref := c.eval.interp_ret_is_ref
    ref saved_ret_dest : Dynamic = c.eval.interp_ret_dest
    saved_ret_type := c.eval.interp_ret_type
    saved_ret_own_type := c.eval.interp_ret_own_type
    mut callee_ret_is_ref := false
    mut use_return_destination := true
    switch func_def.node_type {
    case .FuncDef(ret_fd):
        callee_ret_is_ref = ret_fd.sig.return_own_type.is(OwnType.Ref)
        c.eval.interp_ret_type = safe_ref(ret_fd.sig.return_type)
        c.eval.interp_ret_own_type = ret_fd.sig.return_own_type
        if ret_fd.sig.return_type.len() > 0 {
            ref declared_return_name : Str = resolve_type_alias(ctx.scope, ret_fd.sig.return_type, ctx.symbols)
            if declared_return_name != til_type_name_c(e.til_type()) { use_return_destination = false }
        }
        if e.til_type().is(Type.Unknown).and(ret_fd.sig.return_type.len() > 0) {
            e.set_til_type(type_from_name_init_name(ret_fd.sig.return_type, ctx.scope, ctx.symbols))
        }
    case:
    }
    c.eval.interp_ret_is_ref = callee_ret_is_ref
    c.eval.interp_ret_dest = destination
    if use_return_destination.not() { c.eval.interp_ret_dest = 0 }
    eval_body(call_scope, body, ctx)
    c.eval.interp_ret_is_ref = saved_ret_is_ref
    c.eval.interp_ret_dest = saved_ret_dest
    c.eval.interp_ret_type = saved_ret_type
    c.eval.interp_ret_own_type = saved_ret_own_type
    mut result : Dynamic = 0
    if c.eval.has_return {
        result = context_return_take(c)
    } else {
        result = destination
        if result.is_null() { result = raw_unit_result(e.til_type(), ctx) }
    }
    switch func_def.node_type {
    case .FuncDef(result_fd):
        if result_fd.sig.return_type.len() > 0 {
            source_result_type := type_from_name_init_name(result_fd.sig.return_type, ctx.scope, ctx.symbols)
            if callee_ret_is_ref.not() {
                if source_result_type.is(Type.Dynamic).and(raw_type_is_prim(e.til_type(), ctx)) {
                    // A Dynamic-declared result re-stamped primitive either
                    // stays an owned pointer block (Dynamic quarantine) or
                    // collapses to the transient scalar word.
                    ref unbox_pointed : Dynamic = deref(result)
                    if fcall_returns_dynamic_storage(e, ctx.scope, ctx.symbols) {
                        EvalHeap.heap_free(own result)
                        result = unbox_pointed
                    } else {
                        unboxed_w : Dynamic = scalar_word_load(e.til_type(), unbox_pointed, ctx)
                        if result_fd.sig.return_own_type.is(OwnType.Own) {
                            mut owned_pointed : Dynamic = unbox_pointed
                            EvalHeap.heap_free(own owned_pointed)
                        }
                        EvalHeap.heap_free(own result)
                        result = unboxed_w
                    }
                } else {
                    result = raw_coerce_value(result, source_result_type, e.til_type(), ctx, result_fd.sig.return_own_type)
                }
            }
        }
    case:
    }
    result = raw_result_finish(e.til_type(), result, destination, callee_ret_is_ref, ctx)
    scope_free(own call_scope)
    return result
}

priv eval_callable_call := proc(mut caller_scope: Scope, mut e: Expr, mut callable: Dynamic, mut ctx: Context, mut destination: Dynamic = bits_word(0)) returns Dynamic {
    ref mut func_def : Expr = callable_raw_func_def(callable)
    ref parent_scope : Scope = callable_raw_env(callable, caller_scope)
    switch func_def.node_type {
    case .BodyValue:
        mut body_scope := scope_new(safe_ref(parent_scope))
        eval_body(body_scope, func_def.children[0], ctx)
        scope_free(own body_scope)
        if destination.is_null().not() { return destination }
        return raw_unit_result(e.til_type(), ctx)
    case .FuncDef:
        return eval_user_func_call(caller_scope, e, func_def, parent_scope, ctx, destination)
    case:
        interp_error(e, "callee did not evaluate to a function", ctx)
        exit(1)
        return raw_unit_result(e.til_type(), ctx)
    }
}

priv eval_call_info := proc(mut scope: Scope, mut e: Expr, shallow call_type: Type, mut ctx: Context, mut info: RawResultInfo, mut destination: Dynamic = bits_word(0)) returns Dynamic {
    ref mut callee_expr : Expr = e.children[0]
    info.is_ref = false
    info.is_word = destination.is_null().and(raw_type_is_prim(call_type, ctx))

    // Namespace method call: Struct.method(args)
    if callee_expr.node_type.is(NodeType.FieldAccess) {
        switch callee_expr.node_type {
        case .FieldAccess(callee_field):
            enum_dispatch_shape := is_enum_type(call_type).or(callee_field.field_access_name(ctx.symbols.names) == "is")
            if enum_dispatch_shape {
                mut fallback_enum_name := ""
                ref enum_name : Str = field_access_sname(callee_expr, fallback_enum_name, ctx.symbols)
                enum_def_o := lookup_interp_type_def(enum_name, ctx)
                if enum_def_o.is_some().and(enum_def_o.unwrap().node_type.is(NodeType.EnumDef)) {
                    ref enum_def : Expr = enum_def_o.unwrap()
                    mut enum_raw : Dynamic = destination
                    if enum_raw.is_null() { enum_raw = dispatch_result_alloc(call_type, ctx) }
                    if enum_method_dispatch(callee_field.field_access_name(ctx.symbols.names), scope, enum_def, enum_name, e, enum_raw, ctx) {
                        if raw_type_is_prim(call_type, ctx) {
                            prim_w : Dynamic = scalar_word_load(call_type, enum_raw, ctx)
                            if destination.is_null() { EvalHeap.heap_free(own enum_raw) }
                            return prim_w
                        }
                        return enum_raw
                    }
                    if destination.is_null() { EvalHeap.heap_free(own enum_raw) }
                }
            }
        case:
        }
        mut fn_raw_owned := true
        mut fn_raw : Dynamic = 0
        if fcall_is_direct(e) {
            ref mut root_scope : Scope = scope_root_ref(scope)
            fn_raw = eval_callable_callee_raw(root_scope, callee_expr, fn_raw_owned, ctx)
        } else {
            fn_raw = eval_callable_callee_raw(scope, callee_expr, fn_raw_owned, ctx)
        }
        if callable_box_is(deref(fn_raw)) {
            ref boxed_func_def : Expr = callable_raw_func_def(fn_raw)
            set_resolved_call_result_info(call_type, boxed_func_def, destination, info, ctx)
            result : Dynamic = eval_callable_call(scope, e, fn_raw, ctx, destination)
            if fn_raw_owned { callable_raw_free(fn_raw, ctx) }
            return result
        }
        ref func_def : Expr = callable_raw_func_def(fn_raw)
        set_resolved_call_result_info(call_type, func_def, destination, info, ctx)

            // FuncPtr field: stored function may be ext_func from another type
            if callee_expr.til_type().is_funcptr() {
                mut fp_func_type := FuncType.Func
                ref fp_fdef : FunctionDef = funcdef_of(func_def)
                fp_func_type = fp_fdef.sig.func_type
                if fp_func_type.is_ext() {
                    qn := namespace_func_qname(func_def, "", ctx)
                    if qn.len() > 0 {
                        fp_flat := qn.replace(".", "_")
                        orig_result_type := call_type.clone()
                        mut concrete_result_type := Type.None
                        concrete_return_own_type := fp_fdef.sig.return_own_type
                        if fp_fdef.sig.return_type.len() > 0 { concrete_result_type = type_from_name_init_name(fp_fdef.sig.return_type, ctx.scope, ctx.symbols) }
                        // Swapped in, not cloned: the dispatch only needs the
                        // callee slot to hold a flat Ident for this call.
                        mut flat_ident := Expr.new(ident_node(ctx.symbols.intern(fp_flat)), callee_expr.line, callee_expr.col)
                        flat_ident.set_til_type(Type.FuncDef)
                        swap(Expr, e.children[0], flat_ident)
                        e.set_til_type(concrete_result_type)
                        mut concrete_destination : Dynamic = 0
                        if til_type_name_c(concrete_result_type) == til_type_name_c(orig_result_type) { concrete_destination = destination }
                        mut result : Dynamic = eval_call(scope, e, ctx, concrete_destination)
                        e.set_til_type(orig_result_type)
                        swap(Expr, e.children[0], flat_ident)
                        if fn_raw_owned { callable_raw_free(fn_raw, ctx) }
                        if concrete_return_own_type.is(OwnType.Ref).not() {
                            result = raw_coerce_value(result, concrete_result_type, orig_result_type, ctx, concrete_return_own_type)
                            result = raw_result_finish(orig_result_type, result, destination, false, ctx)
                        }
                        return result
                    }
                }
            }
            // Direct ext_func namespace method -- dispatch by flat name
            mut fdef_func_type := FuncType.Func
            mut direct_result_type := Type.None
            mut direct_return_own_type := OwnType.Shallow
            ref fdef_ns : FunctionDef = funcdef_of(func_def)
            fdef_func_type = fdef_ns.sig.func_type
            direct_return_own_type = fdef_ns.sig.return_own_type
            if fdef_ns.sig.return_type.len() > 0 { direct_result_type = type_from_name_init_name(fdef_ns.sig.return_type, ctx.scope, ctx.symbols) }
            if fdef_func_type.is_bodyless() {
                ref fn_name : FieldAccessData = fieldaccess_of(callee_expr)
                enum_dispatch_shape2 := is_enum_type(call_type).or(fn_name.field_access_name(ctx.symbols.names) == "is")
                if enum_dispatch_shape2 {
                    parent_sname_o := expr_type_name_ref(callee_expr.children[0], ctx.symbols)
                    if parent_sname_o.is_some() {
                        ref parent_sname : Str = parent_sname_o.unwrap()
                        // REM: an unbound parent_sname -- or one bound to a VALUE,
                        // which holds no def to read (hb_func_def) -- is an
                        // expected miss: namespace-method dispatch is skipped and
                        // control falls through to the flat-name dispatch.
                        mut tc_edef_o := Option(ref Expr).None
                        tc_hb_o := scope_lookup_heap_binding(scope, parent_sname)
                        if tc_hb_o.is_some() { tc_edef_o = hb_func_def(tc_hb_o.unwrap()) }
                        if tc_edef_o.is_some() {
                            ref tc_edef : Expr = tc_edef_o.unwrap()
                            if tc_edef.node_type.is(NodeType.EnumDef) {
                                mut enum_raw : Dynamic = destination
                                if enum_raw.is_null() { enum_raw = dispatch_result_alloc(call_type, ctx) }
                                if enum_method_dispatch(fn_name.field_access_name(ctx.symbols.names), scope, tc_edef, parent_sname, e, enum_raw, ctx) {
                                    if fn_raw_owned { callable_raw_free(fn_raw, ctx) }
                                    // A prim-stamped result (is() -> Bool)
                                    // collapses to an inline word.
                                    if raw_type_is_prim(call_type, ctx) {
                                        prim_w2 : Dynamic = scalar_word_load(call_type, enum_raw, ctx)
                                        EvalHeap.heap_free(own enum_raw)
                                        return prim_w2
                                    }
                                    return enum_raw
                                }
                                if destination.is_null() { EvalHeap.heap_free(own enum_raw) }
                            }
                        }
                    }
                }
                mut flat_str := Str.clone(fn_name.field_access_name(ctx.symbols.names))
                sn_o := expr_type_name_ref(callee_expr.children[0], ctx.symbols)
                // til_type_name returns "" for primitives. For ext_func
                // dispatch on a primitive receiver (e.g. `0.sub(1)` ->
                // `I64_sub(0, 1)`), fall back to til_type_name_c.
                if sn_o.is_some() {
                    ref sn : Str = sn_o.unwrap()
                    flat_str = sn.concat3("_", fn_name.field_access_name(ctx.symbols.names))
                } else {
                    tn := til_type_name_c(callee_expr.children[0].til_type())
                    if tn.eq("unknown").not().and(tn.eq("?").not()).and(tn.eq("Dynamic").not()) {
                        flat_str = tn.concat3("_", fn_name.field_access_name(ctx.symbols.names))
                    }
                }
                // If the receiver type is unknown (eg Dynamic), fall back to
                // the unqualified top-level name. Required for and/or/not.
                orig_direct_result_type := call_type.clone()
                mut flat_ident2 := Expr.new(ident_node(ctx.symbols.intern(flat_str)), callee_expr.line, callee_expr.col)
                flat_ident2.set_til_type(Type.FuncDef)
                swap(Expr, e.children[0], flat_ident2)
                e.set_til_type(direct_result_type)
                mut direct_destination : Dynamic = 0
                if til_type_name_c(direct_result_type) == til_type_name_c(orig_direct_result_type) { direct_destination = destination }
                mut result : Dynamic = eval_call(scope, e, ctx, direct_destination)
                e.set_til_type(orig_direct_result_type)
                swap(Expr, e.children[0], flat_ident2)
                if fn_raw_owned { callable_raw_free(fn_raw, ctx) }
                if direct_return_own_type.is(OwnType.Ref).not() {
                    result = raw_coerce_value(result, direct_result_type, orig_direct_result_type, ctx, direct_return_own_type)
                    result = raw_result_finish(orig_direct_result_type, result, destination, false, ctx)
                }
                return result
            }

        result : Dynamic = eval_callable_call(scope, e, fn_raw, ctx, destination)
        if fn_raw_owned { callable_raw_free(fn_raw, ctx) }
        return result
    }

    // A typed Ident callee not stamped direct is a runtime callable value,
    // regardless of whether its spelling matches a global or builtin.
    if fcall_is_direct(e).not().and(callee_expr.node_type.is(NodeType.Ident))
    .and(callee_expr.til_type().is_funcptr().or(callee_expr.til_type().is(Type.Body))) {
        mut callable_owned := true
        mut callable : Dynamic = eval_callable_callee_raw(scope, callee_expr, callable_owned, ctx)
        ref callable_fdef : Expr = callable_raw_func_def(callable)
        set_resolved_call_result_info(call_type, callable_fdef, destination, info, ctx)
        result : Dynamic = eval_callable_call(scope, e, callable, ctx, destination)
        if callable_owned { callable_raw_free(callable, ctx) }
        return result
    }

    // Direct ident call
    switch callee_expr.node_type {
    case .Ident(name):

        // Ext/core dispatch writes raw bytes sized by this call's result Type.
        ref mut root_scope : Scope = scope_root_ref(scope)
        ext_hb_o := scope_lookup_heap_binding(root_scope, name.ident_name(ctx.symbols.names))
        mut ext_slot : Dynamic = 0
        if ext_hb_o.is_some() { ext_slot = to_ptr(ext_hb_o.unwrap().ptr) }
        mut ext_result_type := call_type.clone()
        mut ext_return_own_type := OwnType.Shallow
        mut ext_variadic_index : I32 = -1
        // The binding must be callable to carry a def: a name bound to a
        // VALUE leaves the signature defaults in place instead of having its
        // slot read as an Expr (see hb_func_def).
        mut ext_def_o := Option(ref Expr).None
        if ext_slot.is_null().not() {
            ext_def_o = hb_func_def(ext_hb_o.unwrap())
        }
        if ext_def_o.is_some() {
            ref ext_def : Expr = ext_def_o.unwrap()
            set_resolved_call_result_info(call_type, ext_def, destination, info, ctx)
            switch ext_def.node_type {
            case .FuncDef(ext_fd):
                if ext_fd.sig.return_type.len() == 0 { ext_result_type = Type.None }
                else { ext_result_type = type_from_name_init_name(ext_fd.sig.return_type, ctx.scope, ctx.symbols) }
                ext_return_own_type = ext_fd.sig.return_own_type
                ext_variadic_index = ext_fd.sig.variadic_index
            case .BodyValue:
                ext_result_type = Type.None
            case .StructDef:
            case .EnumDef:
            case:
                UNREACHABLE("unexpected ", ext_def.node_type.head_str(ctx.symbols.names))
            }
        }
        ext_result_is_ref := info.is_ref
        // `cast(e, T)` and dyn_call_ret declare Dynamic because til has no
        // dependent return types; the typer places the concrete result on the
        // call expression. Allocate dispatch storage at that contextual type.
        contextual_dynamic_result := ext_return_own_type.is(OwnType.Shallow).or(name.ident_name(ctx.symbols.names) == "dyn_call_ret")
        if ext_result_type.is(Type.Dynamic).and(contextual_dynamic_result).and(call_type.is(Type.Dynamic).not()) {
            ext_result_type = call_type.clone()
        }
        mut ext_storage_type := ext_result_type.clone()
        if ext_result_is_ref { ext_storage_type = Type.Dynamic }
        // Primitive/None dispatch results use a reusable scratch slot and
        // come back as inline words: no allocation per scalar op.
        ext_prim_result := raw_type_is_prim(ext_storage_type, ctx).or(ext_storage_type.is(Type.None))
        mut ext_raw : Dynamic = 0
        if ext_prim_result { ext_raw = dispatch_scratch_push() }
        else if ext_result_is_ref.not().and(destination.is_null().not()).and(til_type_name_c(ext_result_type) == til_type_name_c(call_type)) {
            ext_raw = destination
        } else {
            ext_raw = dispatch_result_alloc(ext_storage_type, ctx)
        }
        if ext_function_dispatch(name.ident_name(ctx.symbols.names), scope, e, ext_raw, ctx) {
            for oi in 1..e.children.len() {
                if get_own_arg(e, oi) {
                    if oi.sub(1).to_i32() == ext_variadic_index { continue }
                    switch e.children[oi].node_type {
                    case .Ident(oa_ident):
                        mut arg_hb_o := scope_lookup_heap_binding(scope, oa_ident.ident_name(ctx.symbols.names))
                        if arg_hb_o.is_some() {
                            ref mut arg_hb : HeapBinding = arg_hb_o.unwrap()
                            // An own arg whose CALLEE PARAM is `own` was genuinely
                            // handed to C, which owns (and may free) its buffer:
                            // The typed AST's own-argument bit is the transfer
                            // decision. Dispatch consumes the value; scope teardown
                            // must not reclaim it a second time.
                            arg_hb.ptr = bits_word(0)
                            arg_hb.moved_out = true
                        }
                    case:
                    }
                }
            }
            if ext_prim_result {
                mut ext_word : Dynamic = 0
                if ext_storage_type.is(Type.None).not() { ext_word = scalar_word_load(ext_storage_type, ext_raw, ctx) }
                dispatch_scratch_pop()
                // The scratch slot is borrowed storage: consume the local
                // without freeing.
                word_drop(own ext_raw)
                ext_word = raw_coerce_value(ext_word, ext_result_type, call_type, ctx, ext_return_own_type)
                return ext_word
            }
            if ext_result_is_ref {
                ref ext_ref_result : Dynamic = deref(ext_raw)
                direct_ref_result : Dynamic = ext_ref_result
                EvalHeap.heap_free(own ext_raw)
                return direct_ref_result
            }
            ext_raw = raw_coerce_value(ext_raw, ext_result_type, call_type, ctx, ext_return_own_type)
            ext_raw = raw_result_finish(call_type, ext_raw, destination, false, ctx)
            return ext_raw
        }
        if ext_prim_result { dispatch_scratch_pop(); word_drop(own ext_raw) }
        else if ext_raw.ptr_eq(destination).not() { EvalHeap.heap_free(own ext_raw) }

        // User-defined function or struct instantiation
        // A miss means the callee name is bound nowhere -- undefined. The typer
        // rejects undefined names, so this only fires under the constfolder's
        // speculative eval, where the exit is caught via ctx.eval.constfold_active in
        // h_exit. The ext dispatch probe above already resolved the binding;
        // reuse its slot and metadata instead of walking the scope again.
        if ext_slot.is_null() {
            interp_error(e, format(Str.clone(name.ident_name(ctx.symbols.names)), " is undefined"), ctx)
            exit(1)
        }
        ref ext_hb : HeapBinding = ext_hb_o.unwrap()
        mut fn_raw_owned := false
        mut fn_raw : Dynamic = ext_slot
        if heap_type_is_callable(hb_type(ext_hb)).not() {
            fn_raw = eval_callable_callee_raw(scope, callee_expr, fn_raw_owned, ctx)
        }
        ref fn_def : Expr = callable_raw_func_def(fn_raw)

        // An ext_func reaching here did not dispatch above (not a builtin and
        // not FFI-registered -- e.g. a user .so not dlopen'd at constfolder time).
        // It has no body to execute. During speculative folding, mark the
        // evaluation aborted so try_eval_call leaves the call for runtime;
        // outside constfold, reaching an unregistered ext_func is invalid.
        switch fn_def.node_type {
            case .FuncDef(ext_fd):
                // ExtProc gets the same treatment as ExtFunc. It used to fall
                // through and run as an ordinary body-less function, which
                // silently produced a zero result -- so an unresolved
                // `InitWindow(...)` "succeeded" and simply opened no window,
                // and `GetRandomValue(5, 5)` returned 0 instead of 5. A
                // missing symbol has to say so.
                if ext_fd.sig.func_type.is_ext() {
                    if fn_raw_owned { callable_raw_free(fn_raw, ctx) }
                    if ctx.eval.constfold_active.not() {
                        panic("ext function is not registered (symbol missing, or its signature is not supported by the interpreter's libffi bridge): ", name.ident_name(ctx.symbols.names))
                    }
                    ctx.eval.eval_aborted = true
                    if destination.is_null().not() { return destination }
                    return raw_unit_result(call_type, ctx)
                }
            case:
        }

        // Struct instantiation
        if fn_def.node_type.is(NodeType.StructDef) {
                ref sdd : StructDef = structdef_of(fn_def)
                mut inst_data : Dynamic = destination
                if inst_data.is_null() { inst_data = EvalHeap.heap_alloc(ctx_total_size(name.ident_name(ctx.symbols.names), ctx)) }
                    // sl.fields is positionally parallel to sdd.fields, so
                    // each arg's layout row comes from its position -- no
                    // per-field name probe. Interface ctors also locate
                    // iface_val/iface_owned once, up front, by index probe.
                    ref ctor_sl : StructLayout = ctx.struct_layouts[name.ident_name(ctx.symbols.names)]
                    mut iface_val_pos : USize = sdd.fields.len()
                    mut iface_owned_pos : USize = sdd.fields.len()
                    if sdd.is_interface {
                        if sdd.fields_index.has("iface_val") { iface_val_pos = sdd.fields_index["iface_val"] }
                        if sdd.fields_index.has("iface_owned") { iface_owned_pos = sdd.fields_index["iface_owned"] }
                    }
                    mut arg_idx : USize = 1
                    mut ctr : USize = 0
                    for fdd : Declaration in sdd.fields {
                        cur_fpos := ctr
                        ctr = ctr + 1
                        cur_idx := arg_idx
                        ref mut arg : Expr = e.children[cur_idx]
                        arg_idx++
                        mut arg_raw : Dynamic = 0
                        mut arg_is_ref := false
                        mut arg_is_place := false
                        mut arg_source_type := arg.til_type().clone()
                        switch arg.node_type {
                        case .Ident(arg_ident):
                            ref mut source_hb : HeapBinding = scope_lookup_heap_binding(scope, arg_ident.ident_name(ctx.symbols.names)).unwrap()
                            if hb_type(source_hb).is(Type.Dynamic).and(arg.til_type().is(Type.Dynamic).not()).not() {
                                arg_source_type = hb_type(source_hb).clone()
                            }
                            mut move_iface_val := false
                            if cur_fpos == iface_val_pos {
                                if iface_owned_pos < sdd.fields.len() {
                                    switch e.children[iface_owned_pos + 1].node_type {
                                    case .Literal(Literal.Bool(owned_flag)): move_iface_val = owned_flag
                                    case .Ident(owned_id):
                                        ref owned_hb : HeapBinding = scope_lookup_heap_binding(scope, owned_id.ident_name(ctx.symbols.names)).unwrap()
                                        ref owned_raw : Dynamic = to_ptr(owned_hb.ptr)
                                        ref owned_flag2 : Bool = owned_raw
                                        move_iface_val = owned_flag2
                                    case:
                                    }
                                }
                            }
                            if get_own_arg(e, cur_idx).or(move_iface_val) {
                                if source_hb.moved_out { panic("struct init from moved heap binding: ", arg_ident.ident_name(ctx.symbols.names)) }
                                ref source_ptr : Dynamic = to_ptr(source_hb.ptr)
                                mut preserve_outer := get_keep_outer_arg(e, cur_idx)
                                if fdd.own_type.is(OwnType.Shallow) {
                                    switch hb_type(source_hb) {
                                    case .Struct, .StructSym: preserve_outer = true
                                    case .Enum, .EnumSym: preserve_outer = true
                                    case:
                                    }
                                }
                                if fdd.own_type.is(OwnType.Own).and(raw_type_is_prim(fdd.til_type, ctx))
                                    .and(source_hb.own_type.is(OwnType.Ref)) {
                                    // A pointer-to-scalar FIELD taking a
                                    // pointer-to-scalar BINDING: the value is
                                    // the address, so hand it over as the
                                    // compiled backend does (`view->c_str =
                                    // start`). The borrow-clone below copies
                                    // the POINTEE instead -- one byte for I8 --
                                    // so `Str(c_str = start, count = 5, ...)`
                                    // built a view over a 1-byte copy and read
                                    // back "h\0\0\0\0" (#357).
                                    arg_raw = source_ptr
                                    arg_is_ref = true
                                    arg_is_place = true
                                } else if preserve_outer {
                                    arg_raw = EvalHeap.heap_alloc(raw_type_size(hb_type(source_hb), ctx))
                                    memcpy(arg_raw, source_ptr, raw_type_size(hb_type(source_hb), ctx))
                                } else if source_hb.is_borrowed.and(source_hb.is_erased_dynamic) {
                                    arg_raw = EvalHeap.heap_alloc(Dynamic.size())
                                    write_ptr(arg_raw, source_ptr)
                                } else {
                                    mut clone_source := source_hb.is_borrowed.or(heap_slot_is_static_callable(hb_type(source_hb), source_ptr))
                                    mut promote_str_view := false
                                    if is_struct_type(hb_type(source_hb)) {
                                        if (type_name_of(hb_type(source_hb), ctx.symbols).unwrap() == "Str").and(str_cap_at(source_ptr, ctx).gte(CAP_VIEW)) {
                                            clone_source = true
                                            promote_str_view = true
                                        }
                                    }
                                    if clone_source {
                                        arg_raw = heap_clone_by_type(hb_type(source_hb), source_ptr, source_hb.ctx)
                                        if is_struct_type(hb_type(source_hb)) {
                                            if (type_name_of(hb_type(source_hb), ctx.symbols).unwrap() == "Str").and(promote_str_view) {
                                                cnt := str_count_at(source_ptr, ctx)
                                                if cnt == 0 {
                                                    str_write_count_cap(arg_raw, 0, CAP_VIEW, ctx)
                                                } else {
                                                    ref source_str : Str = to_ptr(source_ptr)
                                                    mut copy : I8 = malloc(cnt.add(1).cast(U64))
                                                    memcpy(copy, source_str.c_str, cnt.cast(U64))
                                                    memset(ptr_add(copy, cnt.cast(U64)), 0, 1)
                                                    write_ptr(arg_raw, copy)
                                                    str_write_count_cap(arg_raw, cnt, cnt, ctx)
                                                }
                                            }
                                        }
                                    } else {
                                        arg_raw = source_ptr
                                        source_hb.ptr = bits_word(0)
                                        source_hb.moved_out = true
                                    }
                                }
                                // An own-prim VALUE binding's moved/cloned
                                // block collapses to its inline word; the
                                // field writer would store the block
                                // ADDRESS as the scalar. #302 raw-alloc
                                // pointer bindings keep the bare pointer.
                                // OWN, not merely non-Shallow: a `ref b : I8`
                                // binding holds a POINTER to the scalar, the
                                // same shape #302's raw allocations do, so
                                // collapsing it to its inline word stored the
                                // pointee BYTE in a pointer field --
                                // `Str(c_str = start, ...)` kept 'h' where the
                                // address belonged, and every later read of
                                // that field dereferenced 0x68 (#357).
                                if raw_type_is_prim(hb_type(source_hb), ctx).and(source_hb.own_type.is(OwnType.Own)).and(source_hb.is_raw_alloc.not()).and(arg_is_ref.not()) {
                                    ctor_prim_word : Dynamic = scalar_word_load(hb_type(source_hb), arg_raw, ctx)
                                    EvalHeap.heap_free(own arg_raw)
                                    arg_raw = ctor_prim_word
                                }
                            } else if fdd.own_type.is(OwnType.Ref) {
                                ref source_ptr : Dynamic = to_ptr(source_hb.ptr)
                                arg_raw = source_ptr
                                arg_is_ref = true
                                arg_is_place = true
                            } else {
                                arg_raw = eval_expr_raw(scope, arg, ctx)
                                arg_is_ref = source_hb.own_type.is(OwnType.Ref)
                                arg_is_place = heap_type_is_callable(hb_type(source_hb)).not()
                            }
                        case:
                            mut arg_info := raw_result_info_new()
                            arg_raw = eval_expr_raw_info(scope, arg, ctx, arg_info)
                            arg_is_ref = arg_info.is_ref
                            arg_source_type = raw_result_source_type(arg_info).clone()
                            arg_is_place = arg_is_ref
                        }
                        // A SHALLOW prim field takes a value WORD: a
                        // ref/place arg is a bare source address, so load
                        // the scalar out first (the source keeps its
                        // storage), then widen like any value word.
                        if raw_type_is_prim(fdd.til_type, ctx).and(fdd.own_type.is(OwnType.Shallow)).and(arg_is_ref.or(arg_is_place)) {
                            arg_raw = scalar_word_load(arg_source_type, arg_raw, ctx)
                            arg_is_ref = false
                            arg_is_place = false
                        }
                        arg_raw = raw_widen_numeric(arg_raw, arg_source_type, decl_type_name(fdd, ctx.symbols), ctx)
                        ref ctor_fl : FieldLayout = ctor_sl.fields.unsafe_get(cur_fpos)
                        mut arg_is_null := false
                        switch arg.node_type {
                        case .Literal(Literal.Null): arg_is_null = true
                        case:
                        }
                        if fdd.own_type.is(OwnType.Ref).and(arg_is_null) {
                            raw_block_free(arg_raw)
                            write_ptr(ptr_add(inst_data, ctor_fl.offset), bits_word(0))
                            continue
                        }
                        init_field_raw(inst_data, fdd, ctor_fl.offset, ctor_fl.size, arg_raw, arg_source_type, arg_is_ref, arg_is_place, ctx)
                    }
                if fn_raw_owned { callable_raw_free(fn_raw, ctx) }
                return inst_data
        }

        result : Dynamic = eval_callable_call(scope, e, fn_raw, ctx, destination)
        if fn_raw_owned { callable_raw_free(fn_raw, ctx) }
        return result
    case .FCall:
        // Issue #58: postfix call on a sub-expression callee, e.g.
        // `cast(raw, BinaryOp)(3, 4)`. Eval the callee (the cast) to
        // get the function pointer, then dispatch with the call's args.
        mut cast_raw_owned := true
        mut cast_raw : Dynamic = 0
        mut inline_callable_cast := false
        switch callee_expr.children[0].node_type {
        case .Ident(cast_name):
            inline_callable_cast = cast_name.ident_name(ctx.symbols.names).eq("cast")
                .and(callee_expr.til_type().is_funcptr().or(callee_expr.til_type().is(Type.Body)))
        case:
        }
        if inline_callable_cast {
            cast_raw = eval_callable_cast_callee_raw(scope, callee_expr, cast_raw_owned, ctx)
        } else {
            cast_raw = eval_expr_raw(scope, callee_expr, ctx)
        }
        ref cast_func_def : Expr = callable_raw_func_def(cast_raw)
        set_resolved_call_result_info(call_type, cast_func_def, destination, info, ctx)
        result : Dynamic = eval_callable_call(scope, e, cast_raw, ctx, destination)
        if cast_raw_owned { callable_raw_free(cast_raw, ctx) }
        return result
    case:
        UNREACHABLE("unexpected ", callee_expr.node_type.head_str(ctx.symbols.names))
        if destination.is_null().not() { return destination }
        return raw_unit_result(call_type, ctx)
    }
}

priv eval_call := proc(mut scope: Scope, mut e: Expr, mut ctx: Context, mut destination: Dynamic = bits_word(0)) returns Dynamic {
    mut info := raw_result_info_new()
    ref call_type : Type = e.til_type()
    return eval_call_info(scope, e, call_type, ctx, info, destination)
}

// Single owning-pointer box for side tables that need to own raw Dynamic
// pointers.
priv DynPtrBox := struct {
    own p : U8 = 0
}

// Issue #275, generalized after #58: Array/Vec/Set keep elements in an
// `own data` heap buffer. heap_drop_struct skips the `own data : U8` field
// itself, and heap_clone's initial memcpy only shallow-copies the data pointer.
// Clone/free the backing buffer here so interpreted containers have
// the same ownership as their generated delete/clone methods.

// Element type of a monomorphized container ("Array__Str" -> "Str",
// "Vec__I64" -> "I64"); "" for a non-container struct name.
container_elem_type := func(struct_name: Str, ctx: Context) returns Str {
    array_prefix := "Array__"
    if struct_name.starts_with(array_prefix) {
        return struct_name.substr(array_prefix.count, struct_name.count - array_prefix.count)
    }
    vec_prefix := "Vec__"
    if struct_name.starts_with(vec_prefix) {
        return struct_name.substr(vec_prefix.count, struct_name.count - vec_prefix.count)
    }
    set_prefix := "Set__"
    if struct_name.starts_with(set_prefix) {
        return struct_name.substr(set_prefix.count, struct_name.count - set_prefix.count)
    }
    sep := struct_name.find("__")
    if sep >= 0 {
        ref data_fl : FieldLayout = ctx_field_layout(struct_name, "data", ctx)
        ref count_fl : FieldLayout = ctx_field_layout(struct_name, "count", ctx)
        ref cap_fl : FieldLayout = ctx_field_layout(struct_name, "cap", ctx)
        if data_fl.size.gt(0).and(count_fl.size.gt(0)).and(cap_fl.size.gt(0)) {
            if data_fl.own_type.is(OwnType.Own).and(data_fl.struct_name.len().eq(0)).and(data_fl.is_enum.not()).and(data_fl.is_funcptr.not()) {
                start := sep.add(2).to_usize()
                rest := struct_name.substr(start, struct_name.count.sub(start))
                next_sep := rest.find("__")
                if next_sep >= 0 { return rest.substr(0, next_sep.to_usize()) }
                return rest
            }
        }
    }
    return ""
}

container_elem_size := func(elem_type: Str, ctx: Context) returns USize {
    resolved := type_from_name_init_name(elem_type, ctx.scope, ctx.symbols)
    if type_is_callable_storage(resolved) { return 8 }
    switch resolved {
    case .Primitive(p):
        mut sz : USize = 0
        mut al : USize = 0
        builtin_primitive_size_align(p, sz, al)
        return sz
    case .Dynamic:
        return 8
    case:
    }
    sz2 := ctx_total_size(elem_type, ctx)
    if sz2 == 0 { panic("container element has no registered size: ", elem_type) }
    return sz2
}

priv type_name_is_callable_storage := func(type_name: Str, ctx: Context) returns Bool {
    if type_is_callable_storage(type_from_name_init_name(type_name, ctx.scope, ctx.symbols)) { return true }
    tdef_o := lookup_interp_type_def(type_name, ctx)
    if tdef_o.is_none() { return false }
    ref tdef : Expr = tdef_o.unwrap()
    if tdef.node_type.is(NodeType.FuncDef) {
        return tdef.children.len() == 0
    }
    return false
}

container_live_count := func(struct_name: Str, data: Dynamic, ctx: Context) returns USize {
    mut count_field := "count"
    if struct_name.starts_with("Array__") { count_field = "cap" }
    ref fl : FieldLayout = ctx_field_layout(struct_name, count_field, ctx)
    return str_usize_field_at(data, fl.offset, str_usize_read_width(fl.size, ctx))
}

container_capacity := func(struct_name: Str, data: Dynamic, ctx: Context) returns USize {
    ref fl : FieldLayout = ctx_field_layout(struct_name, "cap", ctx)
    return str_usize_field_at(data, fl.offset, str_usize_read_width(fl.size, ctx))
}

priv container_elem_deep_free := func(elem_type: Str, mut slot: Dynamic, ctx: Context) {
    if type_name_is_callable_storage(elem_type, ctx) {
        ref mut stored_callable : Dynamic = deref(slot)
        if stored_callable.is_null().not() { callable_storage_free(stored_callable) }
        return
    }
    resolved := type_from_name_init_name(elem_type, ctx.scope, ctx.symbols)
    if resolved.is(Type.Primitive).or(resolved.is(Type.Dynamic)) { return }
    elem_def_o := lookup_interp_type_def(elem_type, ctx)
    if elem_def_o.is_none() { panic("container element has no registered type def: ", elem_type) }
    ref elem_def : Expr = elem_def_o.unwrap()
    switch elem_def.node_type {
    case .StructDef:
        heap_drop_struct(elem_type, slot, ctx)
    case .EnumDef:
        if enum_has_payloads(elem_def) {
            enum_payload_deep_free(elem_type, slot, ctx)
        }
    case:
        panic("container element is not a struct or enum: ", elem_type)
    }
}

priv container_elem_clone_into := func(elem_type: Str, mut dst: Dynamic, src: Dynamic, elem_size: USize, ctx: Context) {
    if type_name_is_callable_storage(elem_type, ctx) {
        ref stored_callable : Dynamic = deref(src)
        if stored_callable.is_null().not() { write_ptr(dst, callable_storage_clone(stored_callable)) }
        return
    }
    resolved := type_from_name_init_name(elem_type, ctx.scope, ctx.symbols)
    if resolved.is(Type.Primitive).or(resolved.is(Type.Dynamic)) {
        memcpy(dst, src, elem_size)
        return
    }
    elem_def_o := lookup_interp_type_def(elem_type, ctx)
    if elem_def_o.is_none() { panic("container element has no registered type def: ", elem_type) }
    ref elem_def : Expr = elem_def_o.unwrap()
    switch elem_def.node_type {
    case .StructDef:
        cloned_ptr : Dynamic = heap_clone(elem_type, src, ctx)
        memcpy(dst, cloned_ptr, elem_size)
        EvalHeap.heap_free(own cloned_ptr)
    case .EnumDef:
        memcpy(dst, src, elem_size)
        if enum_has_payloads(elem_def) {
            enum_payload_deep_clone(elem_type, dst, ctx)
        }
    case:
        panic("container element is not a struct or enum: ", elem_type)
    }
}

priv free_tuple_data := func(mut data: Dynamic, ctx: Context) {
    ref data_fl : FieldLayout = ctx_field_layout("Tuple", "data", ctx)
    ref type_names_fl : FieldLayout = ctx_field_layout("Tuple", "type_names", ctx)
    ref type_sizes_fl : FieldLayout = ctx_field_layout("Tuple", "type_sizes", ctx)
    ref mut hdr : DynPtrBox = ptr_add(data, data_fl.offset)
    if hdr.p.is_null() { return }
    ref type_names : Vec(Str) = ptr_add(data, type_names_fl.offset)
    ref type_sizes : Vec(USize) = ptr_add(data, type_sizes_fl.offset)
    mut offset : USize = 0
    for i in 0..type_names.len() {
        ref elem_type : Str = type_names[i]
        ref elem_size : USize = type_sizes[i]
        container_elem_deep_free(elem_type, ptr_add(hdr.p, offset), ctx)
        offset = offset + elem_size
    }
    free(own hdr.p)
}

// Symmetric to free_tuple_data: heap_clone's generic field walk deep-clones a
// Tuple's type_names/type_sizes Vecs but leaves the packed `own data: U8`
// buffer SHARED -- a primitive field has no nested_def, so the walk's own-field
// branch skips it and dst keeps src's data pointer (the shallow struct memcpy).
// Without this, a cloned Tuple aliases the original's element buffer, so freeing
// either (free_tuple_data) dangles the other. Allocate a fresh buffer and
// deep-copy each heterogeneous element by its parallel type metadata (mirroring
// Tuple.clone's dyn_call loop), then repoint dst's data field at it.
priv clone_tuple_buffer := func(src_tuple: Dynamic, mut dst_tuple: Dynamic, ctx: Context) {
    ref data_fl : FieldLayout = ctx_field_layout("Tuple", "data", ctx)
    ref names_fl : FieldLayout = ctx_field_layout("Tuple", "type_names", ctx)
    ref sizes_fl : FieldLayout = ctx_field_layout("Tuple", "type_sizes", ctx)
    ref cap_fl : FieldLayout = ctx_field_layout("Tuple", "cap", ctx)
    ref src_hdr : DynPtrBox = ptr_add(src_tuple, data_fl.offset)
    if src_hdr.p.is_null() { return }
    ref cap : USize = ptr_add(src_tuple, cap_fl.offset)
    ref names : Vec(Str) = ptr_add(src_tuple, names_fl.offset)
    ref sizes : Vec(USize) = ptr_add(src_tuple, sizes_fl.offset)
    mut alloc_cap := cap.clone()
    if alloc_cap == 0 { alloc_cap = 8 }
    mut new_buf : U8 = malloc(alloc_cap)
    mut off : USize = 0
    for i in 0..names.len() {
        ref tn : Str = names[i]
        ref ts : USize = sizes[i]
        container_elem_clone_into(tn, ptr_add(new_buf, off), ptr_add(src_hdr.p, off), ts.clone(), ctx)
        off = off + ts
    }
    write_ptr(ptr_add(dst_tuple, data_fl.offset), new_buf)
}

// #286: cache-driven deep free of a struct value's nested heap. Reads
// ctx.struct_layouts (a name-keyed cache that outlives the AST) instead of the
// dangling struct_def, so it is safe at scope teardown. Frees own struct
// fields' blocks (recursing first), Str fields' c_strs, recurses into inline
// nested structs, and reclaims container data buffers. Enum
// fields and own non-struct pointers stay shallow (their construction can
// share a pointer, so freeing here would risk a double-free).
priv heap_drop_struct := func(struct_name: Str, mut data: Dynamic, ctx: Context) {
    if data.is_null() { return }
    if struct_name == "Str" {
        ref s_str : Str = to_ptr(data)
        if str_owns_c_str(data, ctx) {
            if s_str.c_str.is_null().not() { free(own s_str.c_str) }
        }
        return
    }
    if ctx.struct_layouts.has(struct_name).not() { return }
    if struct_name == "Expr" {
        ref node_fl : FieldLayout = ctx_field_layout("Expr", "node_type", ctx)
        if node_fl.size.eq(0) { panic("struct_deep_free Expr missing node_type layout") }
        NodeType.delete(own ptr_add(data, node_fl.offset), false)
        ref children_fl : FieldLayout = ctx_field_layout("Expr", "children", ctx)
        if children_fl.size.eq(0).or(children_fl.struct_name.len().eq(0)) {
            panic("struct_deep_free Expr missing children layout")
        }
        heap_drop_struct(children_fl.struct_name, ptr_add(data, children_fl.offset.cast(U64)), ctx)
        return
    }
    if struct_name == "Tuple" {
        // Free the packed heterogeneous element heap + the `own data: U8`
        // buffer BEFORE the field loop reclaims the type_names/type_sizes
        // metadata that walk reads. Both standalone owned Tuples and Tuples
        // nested in a container (reached via
        // container_elem_deep_free) funnel through here, so this is the single
        // Tuple teardown path -- the cache walk never runs Tuple.delete's
        // custom dyn_call body, and the type-erased U8 buffer is invisible to
        // a generic field walk.
        free_tuple_data(data, ctx)
    }
    ref sl : StructLayout = ctx.struct_layouts[struct_name]
    if sl.is_interface {
        ref owned_fl : FieldLayout = ctx_field_layout(struct_name, "iface_owned", ctx)
        ref owned : Bool = ptr_add(data, owned_fl.offset)
        if owned {
            ref type_fl : FieldLayout = ctx_field_layout(struct_name, "iface_type_name", ctx)
            ref type_name : Str = ptr_add(data, type_fl.offset)
            ref val_fl : FieldLayout = ctx_field_layout(struct_name, "iface_val", ctx)
            ref mut iface_val : Dynamic = deref(ptr_add(data, val_fl.offset))
            heap_drop_by_type(type_from_name_init_name(type_name, ctx.scope, ctx.symbols), iface_val, ctx)
            mut owned_iface_val : Dynamic = iface_val
            EvalHeap.heap_free(own owned_iface_val)
            write_ptr(ptr_add(data, val_fl.offset), bits_word(0))
        }
    }
    for fl : FieldLayout in sl.fields {
        if fl.own_type.is(OwnType.Ref) { continue }
        foff := fl.offset
        if fl.is_funcptr {
            ref mut stored_callable : Dynamic = deref(ptr_add(data, foff))
            if stored_callable.is_null().not() { callable_storage_free(stored_callable) }
            continue
        }
        if fl.own_type.is(OwnType.Own) {
            if fl.is_enum {
                free_owned_enum_slot(ptr_add(data, foff), fl.struct_name, ctx)
                continue
            }
            if fl.struct_name.len().gt(0).and(fl.is_enum.not()) {
                ref mut own_hdr : DynPtrBox = ptr_add(data, foff)
                if own_hdr.p.is_null().not() {
                    heap_drop_struct(fl.struct_name, own_hdr.p, ctx)
                    EvalHeap.heap_free(own own_hdr.p)
                }
            }
            continue
        }
        if fl.is_str {
            ref s : Str = ptr_add(data, foff.cast(U64))
            if str_owns_c_str(ptr_add(data, foff.cast(U64)), ctx) {
                if s.c_str.is_null().not() { free(own s.c_str) }
            }
            continue
        }
        // Inline (shallow) enum field: the payload buffer lives in the
        // struct bytes and owns its nested heap (write_field deep-clones
        // it in); free any nested Str storage by tag. Skipping this
        // orphaned the payload once write_field stopped aliasing the
        // ctor temp's storage.
        if fl.is_enum {
            enum_payload_deep_free(fl.struct_name, ptr_add(data, foff), ctx)
            continue
        }
        if fl.struct_name.len().gt(0).and(fl.is_enum.not()) {
            heap_drop_struct(fl.struct_name, ptr_add(data, foff.cast(U64)), ctx)
        }
    }
    if struct_name == "DynVec" {
        free_dyn_vec_buffer(data, ctx)
    } else if struct_name == "DynArray" {
        free_dyn_array_buffer(data, ctx)
    } else if struct_name == "DynSet" {
        free_dyn_set_buffer(data, ctx)
    } else if container_elem_type(struct_name, ctx).len() > 0 {
        free_container_data(struct_name, data, ctx)
    }
}

priv free_container_data := func(struct_name: Str, mut data: Dynamic, ctx: Context) {
    elem_type := container_elem_type(struct_name, ctx)
    if elem_type.len() == 0 { panic("free_container_data: not a container: ", struct_name) }
    ref data_fl : FieldLayout = ctx_field_layout(struct_name, "data", ctx)
    ref mut hdr : DynPtrBox = ptr_add(data, data_fl.offset)
    if hdr.p.is_null() { return }
    n := container_live_count(struct_name, data, ctx)
    esz := container_elem_size(elem_type, ctx)
    for i in 0..n {
        container_elem_deep_free(elem_type, ptr_add(hdr.p, i.mul(esz)), ctx)
    }
    EvalHeap.heap_free(own hdr.p)
}

priv clone_container_buffer := func(struct_name: Str, src_data: Dynamic, mut dst_data: Dynamic, ctx: Context) {
    elem_type := container_elem_type(struct_name, ctx)
    if elem_type.len() == 0 { panic("clone_container_buffer: not a container: ", struct_name) }
    ref data_fl : FieldLayout = ctx_field_layout(struct_name, "data", ctx)
    ref src_hdr : DynPtrBox = ptr_add(src_data, data_fl.offset)
    if src_hdr.p.is_null() { return }
    cap := container_capacity(struct_name, src_data, ctx)
    esz := container_elem_size(elem_type, ctx)
    mut new_buf : Dynamic = EvalHeap.heap_alloc(cap.mul(esz))
    n := container_live_count(struct_name, src_data, ctx)
    for i in 0..n {
        elem_off := i.mul(esz)
        container_elem_clone_into(elem_type, ptr_add(new_buf, elem_off), ptr_add(src_hdr.p, elem_off), esz, ctx)
    }
    write_ptr(ptr_add(dst_data, data_fl.offset), new_buf)
}

priv dyn_vec_count := func(data: Dynamic, ctx: Context) returns USize {
    ref fl : FieldLayout = ctx_field_layout("DynVec", "count", ctx)
    ref n : USize = ptr_add(data, fl.offset)
    return n.clone()
}

priv dyn_vec_cap := func(data: Dynamic, ctx: Context) returns USize {
    ref fl : FieldLayout = ctx_field_layout("DynVec", "cap", ctx)
    ref n : USize = ptr_add(data, fl.offset)
    return n.clone()
}

priv dyn_vec_elem_size := func(data: Dynamic, ctx: Context) returns USize {
    ref fl : FieldLayout = ctx_field_layout("DynVec", "elem_size", ctx)
    ref n : USize = ptr_add(data, fl.offset)
    return n.clone()
}

priv dyn_vec_elem_kind := func(data: Dynamic, ctx: Context) returns USize {
    ref fl : FieldLayout = ctx_field_layout("DynVec", "elem_kind", ctx)
    ref n : USize = ptr_add(data, fl.offset)
    return n.clone()
}

priv dyn_array_elem_kind := func(data: Dynamic, ctx: Context) returns USize {
    ref fl : FieldLayout = ctx_field_layout("DynArray", "elem_kind", ctx)
    ref n : USize = ptr_add(data, fl.offset)
    return n.clone()
}

priv erased_elem_delete_type := func(struct_name: Str, data: Dynamic, ctx: Context) returns Str {
    ref fl : FieldLayout = ctx_field_layout(struct_name, "elem_delete", ctx)
    ref stored : Dynamic = deref(ptr_add(data, fl.offset))
    ref func_def : Expr = callable_storage_func_def(stored)
    qn := namespace_func_qname(func_def, "delete", ctx)
    if qn.len() > 0 { return qn.substr(0, qn.len() - ".delete".len()).clone() }
    panic("erased elem_delete type not found for ", struct_name)
    return ""
}

priv free_dyn_vec_buffer := func(mut data: Dynamic, ctx: Context) {
    ref data_fl : FieldLayout = ctx_field_layout("DynVec", "data", ctx)
    ref mut hdr : DynPtrBox = ptr_add(data, data_fl.offset)
    if hdr.p.is_null() { return }
    count := dyn_vec_count(data, ctx)
    elem_size := dyn_vec_elem_size(data, ctx)
    elem_kind := dyn_vec_elem_kind(data, ctx)
    if elem_kind == ELEM_FN {
        for i in 0..count {
            ref mut stored : Dynamic = deref(ptr_add(hdr.p, i.mul(elem_size)))
            if stored.is_null().not() { callable_storage_free(stored) }
        }
    } else if elem_kind == ELEM_BOXED {
        elem_type := erased_elem_delete_type("DynVec", data, ctx)
        for i in 0..count {
            container_elem_deep_free(elem_type, ptr_add(hdr.p, i.mul(elem_size)), ctx)
        }
    }
    EvalHeap.heap_free(own hdr.p)
}

priv free_dyn_array_buffer := func(mut data: Dynamic, ctx: Context) {
    ref data_fl : FieldLayout = ctx_field_layout("DynArray", "data", ctx)
    ref mut hdr : DynPtrBox = ptr_add(data, data_fl.offset)
    if hdr.p.is_null() { return }
    ref cap_fl : FieldLayout = ctx_field_layout("DynArray", "cap", ctx)
    ref elem_size_fl : FieldLayout = ctx_field_layout("DynArray", "elem_size", ctx)
    ref cap : USize = ptr_add(data, cap_fl.offset)
    ref elem_size : USize = ptr_add(data, elem_size_fl.offset)
    elem_kind := dyn_array_elem_kind(data, ctx)
    if elem_kind == ELEM_FN {
        for i in 0..cap {
            ref mut stored : Dynamic = deref(ptr_add(hdr.p, i.mul(elem_size)))
            if stored.is_null().not() { callable_storage_free(stored) }
        }
    } else if elem_kind == ELEM_BOXED {
        elem_type := erased_elem_delete_type("DynArray", data, ctx)
        for i in 0..cap {
            container_elem_deep_free(elem_type, ptr_add(hdr.p, i.mul(elem_size)), ctx)
        }
    }
    EvalHeap.heap_free(own hdr.p)
}

priv free_dyn_set_buffer := func(mut data: Dynamic, ctx: Context) {
    ref data_fl : FieldLayout = ctx_field_layout("DynSet", "data", ctx)
    ref mut hdr : DynPtrBox = ptr_add(data, data_fl.offset)
    if hdr.p.is_null() { return }
    ref count_fl : FieldLayout = ctx_field_layout("DynSet", "count", ctx)
    ref elem_size_fl : FieldLayout = ctx_field_layout("DynSet", "elem_size", ctx)
    ref count : USize = ptr_add(data, count_fl.offset)
    ref elem_size : USize = ptr_add(data, elem_size_fl.offset)
    elem_type := erased_elem_delete_type("DynSet", data, ctx)
    for i in 0..count {
        container_elem_deep_free(elem_type, ptr_add(hdr.p, i.mul(elem_size)), ctx)
    }
    EvalHeap.heap_free(own hdr.p)
