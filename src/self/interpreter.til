priv dyn_type_to_str_raw := func(type_data: Dynamic, mut r: Dynamic, ctx: Context) returns Bool {
        til_type_def_o := lookup_interp_type_def("Type", ctx)
        if til_type_def_o.is_none() {
            panic("dyn_type_to_str: Type definition not registered")
        }
        ref til_type_def : Expr = til_type_def_o.unwrap()
        ref tag_ptr : Dynamic = type_data
        ref tag_ref : I32 = tag_ptr
        tag := tag_ref.cast(I64)
        // Case patterns are enum_variant_tag calls, not constants, so
        // switch_is_clike leaves this to the if/elif desugar -- the same N
        // calls as the old chain, in the shape the dispatch actually has.
        switch tag {
        case enum_variant_tag(til_type_def, "Unknown"):
            dispatch_write_str(r, "".c_str, 0, ctx)
            return true
        case enum_variant_tag(til_type_def, "None"):
            dispatch_write_str(r, "".c_str, 0, ctx)
            return true
        case enum_variant_tag(til_type_def, "I64"):
            dispatch_write_str(r, "I64".c_str, 3, ctx)
            return true
        case enum_variant_tag(til_type_def, "U8"):
            dispatch_write_str(r, "U8".c_str, 2, ctx)
            return true
        case enum_variant_tag(til_type_def, "I8"):
            dispatch_write_str(r, "I8".c_str, 2, ctx)
            return true
        case enum_variant_tag(til_type_def, "I16"):
            dispatch_write_str(r, "I16".c_str, 3, ctx)
            return true
        case enum_variant_tag(til_type_def, "U16"):
            dispatch_write_str(r, "U16".c_str, 3, ctx)
            return true
        case enum_variant_tag(til_type_def, "I32"):
            dispatch_write_str(r, "I32".c_str, 3, ctx)
            return true
        case enum_variant_tag(til_type_def, "U32"):
            dispatch_write_str(r, "U32".c_str, 3, ctx)
            return true
        case enum_variant_tag(til_type_def, "U64"):
            dispatch_write_str(r, "U64".c_str, 3, ctx)
            return true
        case enum_variant_tag(til_type_def, "F32"):
            dispatch_write_str(r, "F32".c_str, 3, ctx)
            return true
        case enum_variant_tag(til_type_def, "Bool"):
            dispatch_write_str(r, "Bool".c_str, 4, ctx)
            return true
        case enum_variant_tag(til_type_def, "Struct"):
            ref payload : Str = ptr_add(type_data, ENUM_PAYLOAD_OFFSET)
            dispatch_write_str(r, payload.c_str, str_count_at(ptr_add(type_data, ENUM_PAYLOAD_OFFSET), ctx), ctx)
            return true
        case enum_variant_tag(til_type_def, "StructDef"):
            dispatch_write_str(r, "StructDef".c_str, 9, ctx)
            return true
        case enum_variant_tag(til_type_def, "Enum"):
            ref payload2 : Str = ptr_add(type_data, ENUM_PAYLOAD_OFFSET)
            dispatch_write_str(r, payload2.c_str, str_count_at(ptr_add(type_data, ENUM_PAYLOAD_OFFSET), ctx), ctx)
            return true
        case enum_variant_tag(til_type_def, "EnumDef"):
            dispatch_write_str(r, "EnumDef".c_str, 7, ctx)
            return true
        case enum_variant_tag(til_type_def, "FuncDef"):
            dispatch_write_str(r, "FunctionDef".c_str, 11, ctx)
            return true
        case enum_variant_tag(til_type_def, "FuncPtr"):
            dispatch_write_str(r, "Fn".c_str, 2, ctx)
            return true
        case enum_variant_tag(til_type_def, "Body"):
            dispatch_write_str(r, "Body".c_str, 4, ctx)
            return true
        case enum_variant_tag(til_type_def, "Dynamic"):
            dispatch_write_str(r, "Dynamic".c_str, 7, ctx)
            return true
        case enum_variant_tag(til_type_def, "Custom"):
            ref payload3 : Str = ptr_add(type_data, ENUM_PAYLOAD_OFFSET)
            dispatch_write_str(r, payload3.c_str, str_count_at(ptr_add(type_data, ENUM_PAYLOAD_OFFSET), ctx), ctx)
            return true
        case enum_variant_tag(til_type_def, "Primitive"):
            // Type.Primitive(p) carries a Primitive enum value inline at
            // ENUM_PAYLOAD_OFFSET (its tag is the first I32). Decode it to
            // the primitive's name -- mirrors the data-driven nested switch
            // that emit_dyn_type_to_str_body generates for compiled code.
            prim_def_o := lookup_interp_type_def("Primitive", ctx)
            if prim_def_o.is_none() {
                panic("dyn_type_to_str: Primitive definition not registered")
            }
            ref prim_def : Expr = prim_def_o.unwrap()
            ref prim_tag_ref : I32 = ptr_add(type_data, ENUM_PAYLOAD_OFFSET)
            ptag := prim_tag_ref.cast(I64)
            switch ptag {
            case enum_variant_tag(prim_def, "I16"):  dispatch_write_str(r, "I16".c_str, 3, ctx); return true
            case enum_variant_tag(prim_def, "U16"):  dispatch_write_str(r, "U16".c_str, 3, ctx); return true
            case enum_variant_tag(prim_def, "I8"):   dispatch_write_str(r, "I8".c_str, 2, ctx); return true
            case enum_variant_tag(prim_def, "U8"):   dispatch_write_str(r, "U8".c_str, 2, ctx); return true
            case enum_variant_tag(prim_def, "U32"):  dispatch_write_str(r, "U32".c_str, 3, ctx); return true
            case enum_variant_tag(prim_def, "I32"):  dispatch_write_str(r, "I32".c_str, 3, ctx); return true
            case enum_variant_tag(prim_def, "U64"):  dispatch_write_str(r, "U64".c_str, 3, ctx); return true
            case enum_variant_tag(prim_def, "I64"):  dispatch_write_str(r, "I64".c_str, 3, ctx); return true
            case enum_variant_tag(prim_def, "F32"):  dispatch_write_str(r, "F32".c_str, 3, ctx); return true
            case enum_variant_tag(prim_def, "F64"):  dispatch_write_str(r, "F64".c_str, 3, ctx); return true
            case enum_variant_tag(prim_def, "Bool"): dispatch_write_str(r, "Bool".c_str, 4, ctx); return true
            case:
            }
            panic("dyn_type_to_str: unknown Primitive tag")
        case:
        }
        return false
}

priv h_dyn_type_to_str := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    ref mut arg : Expr = e.children[1]
    mut info := raw_result_info_new()
    mut raw : Dynamic = eval_expr_raw_info(s, arg, ctx, info)
    type_data : Dynamic = raw_arg_pointer(raw, info, ctx)
    result := dyn_type_to_str_raw(type_data, r, ctx)
    if result.not() {
        ref type_tag : I32 = to_ptr(type_data)
        switch arg.node_type {
        case .Ident(type_arg_id):
            ref type_arg_hb : HeapBinding = scope_lookup_heap_binding(s, type_arg_id.ident_name(ctx.symbols.names)).unwrap()
            panic("dyn_type_to_str: invalid Type for ", type_arg_id.ident_name(ctx.symbols.names), ": tag=", type_tag.to_str(), " binding=", til_type_name_c(hb_type(type_arg_hb)), " ref=", type_arg_hb.own_type.is(OwnType.Ref).to_str(), " borrowed=", type_arg_hb.is_borrowed.to_str())
        case:
            panic("dyn_type_to_str: invalid Type expression tag=", type_tag.to_str())
        }
    }
    raw_result_drop(arg.til_type(), raw, info.is_ref, ctx)
    return result
}

