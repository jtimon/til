// #321: the declared return type of the call being evaluated. Every
// reader runs while evaluating a `return` INSIDE a call, where
// eval_user_func_call has set it -- a None here is a broken invariant.
priv interp_ret_type_name := func(ctx: Context) returns ref Str {
    switch ctx.eval.interp_ret_type {
    case .Some(rt): return rt
    case .None:
        panic(__LOC__, "return type read outside a call")
    }
}

// Resolve `name` to its raw value block, walking inner to outer.
scope_get := func(mut s: Scope, name: Str) returns ref Dynamic throws KeyNotFound {
    // REM: the SCOPE ARGUMENT is still nullable (callers pass tables that
    // may not be built yet, e.g. ctx.eval.ns_fields before interpreter_init_ns)
    // -- that is a nullable ref PARAM, #321 step 2 material, distinct from
    // the parent chain's own None terminator below.
    if to_ptr(s).is_null() { throw KeyNotFound() }
    ref mut cur : Scope = s
    mut walking := true
    while walking {
        ref hb : HeapBinding = cur.heap_bindings.get(name)?
        catch (e: KeyNotFound) {
            switch cur.parent {
            case .Some(p): cur = p
            case .None: walking = false
            }
            continue
        }
        return to_ptr(hb.ptr)
    }
    throw KeyNotFound()
}

priv scope_return_move_is_local := func(mut s: Scope, name: Str) returns Bool {
    if to_ptr(s).is_null() { return false }   // REM: nullable scope ARG, see scope_get
    ref mut cur : Scope = s
    mut walking := true
    while walking {
        ref hb : HeapBinding = cur.heap_bindings.get(name)?
        catch (e: KeyNotFound) {
            if cur.is_call_scope { return false }
            switch cur.parent {
            case .Some(p): cur = p
            case .None: walking = false
            }
            continue
        }
        return hb.is_local
    }
    return false
}

// Pool of dead Scope boxes for reuse. scope_free memsets a scope to zero
// and parks it here instead of freeing; scope_new / scope_new_boxed pop
// instead of mallocing. An all-zero Scope IS a valid empty scope now that
// Vec.new is lazy (every Map/Vec field's zero state is lazy-empty), so
// recycling needs no re-init beyond setting parent. Module-level because
// scope_new/scope_free do not see the InterpSession; every creator's
// teardown path calls scope_pool_drain (interp_session_free for the
// interpreter, the loader's fold passes after their scope_free(global)).
priv mut scope_pool := Vec(DynPtrBox).new()

priv scope_pool_put := func(own p: Dynamic) {
    scope_pool.push(own DynPtrBox(p = p))
}

// Free every parked box and release the pool's storage, leaving the pool
// a valid lazy-empty Vec for a later session/fold pass.
scope_pool_drain := func() {
    for pe : DynPtrBox in scope_pool {
        if pe.p.is_null().not() { free(own pe.p) }
    }
    free(own scope_pool.data)
    memset(scope_pool, 0, Vec(DynPtrBox).size())
}

// #321 step 2: every caller looks this up AFTER finding the binding
// itself and then dereferences the result unchecked, so "not found" was
// never a real state here -- it is a broken invariant. Fail loudly at
// the source instead of handing back a null ref for the caller to
// segfault on.
priv scope_get_binding_scope := func(mut s: Scope, name: Str) returns ref Scope {
    ref mut cur : Scope = s
    mut walking := true
    while walking {
        cur.heap_bindings.get(name)?
        catch (e: KeyNotFound) {
            switch cur.parent {
            case .Some(p): cur = p
            case .None: walking = false
            }
            continue
        }
        return cur
    }
    panic(__LOC__, "binding scope not found: ", name)
}

scope_new := func(parent: Option(ref Scope)) returns Scope {
    if scope_pool.len() > 0 {
        // Steal the last parked box: decrementing count makes the slot dead
        // (its own p is never elem-deleted), so ownership moves to the
        // returned scope with no double-free.
        ref mut e : DynPtrBox = scope_pool.unsafe_get(scope_pool.len() - 1)
        scope_pool.count = scope_pool.count - 1
        ref mut s : Scope = to_ptr(e.p)
        s.parent = parent
        mut out : Scope = malloc(Scope.size())
        memcpy(out, e.p, Scope.size())
        free(own e.p)
        return out
    }
    return Scope(parent = parent)
}

// Look up the type/ownership metadata for a raw binding.
scope_lookup_heap_binding := func(mut s: Scope, name: Str) returns Option(ref HeapBinding) {
    if to_ptr(s).is_null() { return Option(ref HeapBinding).None }   // REM: nullable scope ARG, see scope_get
    ref mut cur : Scope = s
    mut walking := true
    while walking {
        ref b : HeapBinding = cur.heap_bindings.get(name)?
        catch (e: KeyNotFound) {
            switch cur.parent {
            case .Some(p): cur = p
            case .None: walking = false
            }
            continue
        }
        return safe_ref(b)
    }
    return Option(ref HeapBinding).None
}

// Identify callable raw slots from their Type metadata.
priv heap_type_is_callable := func(shallow til_type: Type) returns Bool {
    return til_type.is_funcptr().or(til_type.is(Type.Body))
}

priv heap_slot_is_static_callable := func(shallow til_type: Type, ptr: Dynamic) returns Bool {
    if heap_type_is_callable(til_type).not() { return false }
    ref stored : Dynamic = deref(ptr)
    if stored.is_null() { panic("callable heap slot is empty") }
    return callable_box_is(stored).not()
}

// The FuncDef Expr a binding stands for, or None when it holds a VALUE.
// Not priv: the constfolder reads it, like hb_type.
//
// A scope slot is a raw value block, so reading one as an Expr is only
// sound once the binding's TYPE says it is callable. The constfolder used
// to `deref` any slot it found and hand the result straight to
// `fdef.node_type`: for a global constant like `ELEM_FN : USize = 2` that
// is the wild pointer 0x2, and the first field read segfaults. Both
// callable shapes end at a FuncDef -- a static one stores the Expr
// address itself, a closure stores an InterpCallableBox that borrows it.
hb_func_def := func(hb: HeapBinding) returns Option(ref Expr) {
    ref slot : Dynamic = to_ptr(hb.ptr)
    // REM: a moved-out or torn-down binding NULLs ptr; nothing to read.
    if slot.is_null() { return Option(ref Expr).None }
    if heap_type_is_callable(hb_type(hb)).not() { return Option(ref Expr).None }
    ref stored : Dynamic = deref(slot)
    if stored.is_null() { panic(__LOC__, "callable heap slot is empty") }
    if callable_box_is(stored) {
        ref box : InterpCallableBox = to_ptr(stored)
        return safe_ref(Expr, to_ptr(box.func_def))
    }
    return safe_ref(Expr, to_ptr(stored))
}

// Immutable namespace FuncDefs need no runtime slot: their AST node is the
// callable value. Mutable methods and closures retain storage for assignment
// and captured state, like rstil's heap_index values.
priv decl_static_ns_func_def := func(d: Declaration) returns Option(ref Expr) {
    if d.is_mut.or(d.default_value.is_none()) { return Option(ref Expr).None }
    ref value : Expr = d.default_expr()
    switch value.node_type {
    case .FuncDef(fd):
        if fd.captures.len() == 0 { return safe_ref(value) }
    case:
    }
    return Option(ref Expr).None
}

priv def_static_ns_func_def := func(def: Expr, fname: Str) returns Option(ref Expr) {
    d_o := def_ns_get(def, fname)
    if d_o.is_none() { return Option(ref Expr).None }
    return decl_static_ns_func_def(d_o.unwrap())
}

priv static_ns_func_def := func(sname: Str, fname: Str, ctx: Context) returns Option(ref Expr) {
    def_o := ctx.scope.get_struct(sname, ctx.symbols)
    if def_o.is_none() { return Option(ref Expr).None }
    return def_static_ns_func_def(def_o.unwrap(), fname)
}

// #397: the receiver's symbol, for callers holding an Ident (which has
// carried a Sym since #292) rather than a spelling. Skips resolving the
// symbol to a name just so get_struct can hash it back.
priv static_ns_func_def_sym := func(sname: Sym, fname: Str, ctx: Context) returns Option(ref Expr) {
    def_o := ctx.scope.get_struct_by_sym(sname)
    if def_o.is_none() { return Option(ref Expr).None }
    return def_static_ns_func_def(def_o.unwrap(), fname)
}

// The FuncDef behind a namespace member (`Str.size`), or None when the
// member holds a value. Same slot-is-not-an-Expr reasoning as hb_func_def.
ns_func_def := func(sname: Str, fname: Str, mut ctx: Context) returns Option(ref Expr) {
    ref mut c : Context = ctx
    if c.eval.ns_fields.is_some() {
        hb_o := scope_lookup_ns_binding(ns_scope(c), sname, fname)
        if hb_o.is_some() { return hb_func_def(hb_o.unwrap()) }
    }
    return static_ns_func_def(sname, fname, ctx)
}

// Sym-taking twin: same two steps, but the static lookup skips the hash
// for a caller that already holds the receiver's symbol. The dynamic
// ns_fields probe still needs the spelling, so it resolves -- one
// resolve (a vector index) beats one hash of the whole name.
ns_func_def_sym := func(sname: Sym, fname: Str, mut ctx: Context) returns Option(ref Expr) {
    ref mut c : Context = ctx
    if c.eval.ns_fields.is_some() {
        hb_o := scope_lookup_ns_binding(ns_scope(c), c.symbols.resolve(sname), fname)
        if hb_o.is_some() { return hb_func_def(hb_o.unwrap()) }
    }
    return static_ns_func_def_sym(sname, fname, ctx)
}

// Recover the qualified identity of a first-class namespace callable. A
// namespace FuncDef carries its owning declaration; callable-valued data that
// was initialized from another expression remains discoverable in ns_fields.
priv namespace_func_qname := func(func_def: Expr, member: Str, ctx: Context) returns Str {
    ref fd : FunctionDef = funcdef_of(func_def)
    if fd.namespace_decl.is_some() {
        ref owner : Declaration = fd.namespace_decl.unwrap()
        def_o := lookup_interp_type_def(owner.name, ctx)
        if def_o.is_none() { panic(__LOC__, "namespace callable owner is not registered: ", owner.name) }
        ref def : Expr = def_o.unwrap()
        ref decls : Vec(Declaration) = def_ns_decls(def)
        mut i : USize = 0
        for d : Declaration in decls {
            ref fname : Str = def_ns_name_at(def, i)
            i = i + 1
            if member.len() > 0 {
                if fname != member { continue }
            }
            candidate_o := decl_static_ns_func_def(d)
            if candidate_o.is_none() { continue }
            if candidate_o.unwrap().ptr_eq(func_def) {
                return concat3(owner.name, ".", fname)
            }
        }
    }
    if ctx.eval.ns_fields.is_none() { return "" }
    mut suffix := ""
    if member.len() > 0 { suffix = concat3(".", member, "") }
    for qn, hb in ns_scope(ctx).heap_bindings {
        if member.len() > 0 {
            if qn.ends_with(suffix).not() { continue }
        }
        if heap_type_is_callable(hb_type(hb)).not() { continue }
        ref raw : Dynamic = to_ptr(hb.ptr)
        if callable_storage_func_def(deref(raw)).ptr_eq(func_def) { return qn.clone() }
    }
    return ""
}

// Stamp every namespace FuncDef before any namespace value initializer runs.
// Generic and inherited definitions can arrive as clones of another method,
// so overwrite a different inherited spelling with this aggregate's name.
priv set_namespace_func_identity := func(owner: Option(ref Declaration), mut def: Expr) {
    ref mut decls : Vec(Declaration) = def_ns_decls(def)
    for mut d : Declaration in decls {
        if d.default_value.is_none() { continue }
        ref mut value : Expr = d.default_expr()
        switch value.node_type {
        case .FuncDef(fd):
            fd.namespace_decl = owner
        case:
        }
    }
}

priv heap_drop_by_type := func(shallow til_type: Type, mut ptr: Dynamic, ctx: Context) {
    if ptr.is_null() { return }
    switch til_type {
    case .Primitive:
    case .Struct(sname):
        heap_drop_struct(sname, ptr, ctx)
    case .StructSym(s_sym):
        heap_drop_struct(ctx.symbols.resolve(s_sym), ptr, ctx)
    case .Enum(ename):
        heap_drop_enum(ename, ptr, ctx)
    case .EnumSym(e_sym):
        heap_drop_enum(ctx.symbols.resolve(e_sym), ptr, ctx)
    case .FuncPtr:
        ref mut stored_callable : Dynamic = deref(ptr)
        if stored_callable.is_null().not() { callable_storage_free(stored_callable) }
    case .FuncPtrSig, .FuncPtrSigSym:
        ref mut stored_callable2 : Dynamic = deref(ptr)
        if stored_callable2.is_null().not() { callable_storage_free(stored_callable2) }
    case .Body:
        ref mut stored_callable3 : Dynamic = deref(ptr)
        if stored_callable3.is_null().not() { callable_storage_free(stored_callable3) }
    case .Custom(name):
        heap_drop_by_type(type_from_name_init_name(name, ctx.scope, ctx.symbols), ptr, ctx)
    case .CustomSym(csym):
        heap_drop_by_type(type_from_sym_init(csym, ctx.scope, ctx.symbols), ptr, ctx)
    case:
    }
}

priv primitive_heap_clone := func(prim: Primitive, ptr: Dynamic) returns Dynamic {
    mut sz : USize = 0
    mut al : USize = 0
    builtin_primitive_size_align(prim, sz, al)
    mut dst : Dynamic = EvalHeap.heap_alloc(sz)
    memcpy(dst, ptr, sz.cast(U64))
    return dst
}

priv heap_clone_by_type := func(shallow til_type: Type, ptr: Dynamic, ctx: Context) returns Dynamic {
    switch til_type {
    case .Primitive(prim):
        return primitive_heap_clone(prim, ptr)
    case .Dynamic:
        mut dst0 : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
        ref dynamic_value : Dynamic = deref(ptr)
        write_ptr(dst0, dynamic_value)
        return dst0
    case .Struct(sname):
        return heap_clone(sname, ptr, ctx)
    case .StructSym(s_sym):
        return heap_clone(ctx.symbols.resolve(s_sym), ptr, ctx)
    case .Enum(ename):
        // Interpreter enum values use the flat dispatch layout, not the
        // compact generated-C struct layout. A payload-less enum can be one
        // C byte but still occupies the dispatch tag word.
        total : USize = dispatch_enum_size(ename, ctx)
        return heap_clone_enum(ename, ptr, total, ctx)
    case .EnumSym(e_sym):
        ref clone_ename : Str = ctx.symbols.resolve(e_sym)
        total_sym : USize = dispatch_enum_size(clone_ename, ctx)
        return heap_clone_enum(clone_ename, ptr, total_sym, ctx)
    case .FuncPtr:
        mut dst : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
        ref stored_callable : Dynamic = deref(ptr)
        if stored_callable.is_null().not() { write_ptr(dst, callable_storage_clone(stored_callable)) }
        return dst
    case .FuncPtrSig, .FuncPtrSigSym:
        mut dst2 : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
        ref stored_callable2 : Dynamic = deref(ptr)
        if stored_callable2.is_null().not() { write_ptr(dst2, callable_storage_clone(stored_callable2)) }
        return dst2
    case .Body:
        mut dst3 : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
        ref stored_callable3 : Dynamic = deref(ptr)
        if stored_callable3.is_null().not() { write_ptr(dst3, callable_storage_clone(stored_callable3)) }
        return dst3
    case .Custom(name):
        return heap_clone_by_type(type_from_name_init_name(name, ctx.scope, ctx.symbols), ptr, ctx)
    case .CustomSym(csym):
        return heap_clone_by_type(type_from_sym_init(csym, ctx.scope, ctx.symbols), ptr, ctx)
    case:
        panic("cannot clone raw binding of type ", til_type_name_c(til_type))
        return bits_word(0)
    }
}

// drop_old mirrors scope_drop_existing_heap_slot's drop_nested: the old
// value at `dst` is dropped here ONLY when the assignment itself owns that
// teardown (Assign.save_old_delete). When the garbager instead emitted a
// standalone delete for the old value, dropping here too frees its innards a
// second time -- an interpreter-only double free, since the builder already
// routes both cases through the same flag.
priv heap_move_ptr_into_slot := func(shallow til_type: Type, mut dst: Dynamic, mut src: Dynamic, ctx: Context, drop_old: Bool = true) returns Bool {
    switch til_type {
    case .Primitive(prim):
        mut sz : USize = 0
        mut al : USize = 0
        builtin_primitive_size_align(prim, sz, al)
        memcpy(dst, src, sz.cast(U64))
        owned_src : Dynamic = src
        EvalHeap.heap_free(own owned_src)
        return true
    case .Struct(sname):
        if drop_old { heap_drop_struct(sname, dst, ctx) }
        memcpy(dst, src, ctx_total_size(sname, ctx).cast(U64))
        owned_src2 : Dynamic = src
        EvalHeap.heap_free(own owned_src2)
        return true
    case .StructSym(s_sym):
        ref move_sname : Str = ctx.symbols.resolve(s_sym)
        if drop_old { heap_drop_struct(move_sname, dst, ctx) }
        memcpy(dst, src, ctx_total_size(move_sname, ctx).cast(U64))
        owned_src2s : Dynamic = src
        EvalHeap.heap_free(own owned_src2s)
        return true
    case .Enum(ename):
        if drop_old { heap_drop_enum(ename, dst, ctx) }
        mut total : USize = ctx_total_size(ename, ctx)
        if total < 8 { total = 8 }
        memcpy(dst, src, total.cast(U64))
        owned_src3 : Dynamic = src
        EvalHeap.heap_free(own owned_src3)
        return true
    case .EnumSym(e_sym):
        ref move_ename : Str = ctx.symbols.resolve(e_sym)
        if drop_old { heap_drop_enum(move_ename, dst, ctx) }
        mut total_sym : USize = ctx_total_size(move_ename, ctx)
        if total_sym < 8 { total_sym = 8 }
        memcpy(dst, src, total_sym.cast(U64))
        owned_src3s : Dynamic = src
        EvalHeap.heap_free(own owned_src3s)
        return true
    case .FuncPtr:
        ref mut old_callable : Dynamic = deref(dst)
        if old_callable.is_null().not() { callable_storage_free(old_callable) }
        ref moved_callable : Dynamic = deref(src)
        write_ptr(dst, moved_callable)
        write_ptr(src, bits_word(0))
        owned_src4 : Dynamic = src
        EvalHeap.heap_free(own owned_src4)
        return true
    case .FuncPtrSig, .FuncPtrSigSym:
        ref mut old_callable2 : Dynamic = deref(dst)
        if old_callable2.is_null().not() { callable_storage_free(old_callable2) }
        ref moved_callable2 : Dynamic = deref(src)
        write_ptr(dst, moved_callable2)
        write_ptr(src, bits_word(0))
        owned_src5 : Dynamic = src
        EvalHeap.heap_free(own owned_src5)
        return true
    case .Body:
        ref mut old_callable3 : Dynamic = deref(dst)
        if old_callable3.is_null().not() { callable_storage_free(old_callable3) }
        ref moved_callable3 : Dynamic = deref(src)
        write_ptr(dst, moved_callable3)
        write_ptr(src, bits_word(0))
        owned_src6 : Dynamic = src
        EvalHeap.heap_free(own owned_src6)
        return true
    case:
        panic("heap slot move to unsupported type")
    }
    return false
}

priv scope_read_heap_binding_raw := func(hb: HeapBinding, name: Str, ctx: Context) returns Dynamic {
    if hb.moved_out { panic("read of moved binding: ", name, " type ", til_type_name_c(hb_type(hb))) }
    ref heap_data : Dynamic = to_ptr(hb.ptr)
    if hb_type(hb).is(Type.Unknown) { panic("binding has unknown raw type: ", name) }
    if hb.is_static_callable {
        mut result : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
        write_ptr(result, deref(heap_data))
        return result
    }
    if heap_type_is_callable(hb_type(hb)) { return heap_clone_by_type(hb_type(hb), heap_data, hb.ctx) }
    if heap_data.is_null() { panic("binding has null raw storage: ", name) }
    if hb.own_type.is(OwnType.Ref) {
        result : Dynamic = heap_data
        return result
    }
    // A SHALLOW primitive read loads the scalar straight into an inline
    // word -- no clone, no allocation (the old Value box's inline-scalar
    // read). Own-primitive bindings (#302 raw allocations) carry the
    // pointer as their datum and keep the block path.
    if raw_type_is_prim(hb_type(hb), ctx).and(hb.own_type.is(OwnType.Shallow)) { return scalar_word_load(hb_type(hb), heap_data, ctx) }
    return heap_clone_by_type(hb_type(hb), heap_data, ctx)
}

scope_read_bound_raw := func(mut scope: Scope, name: Str, ctx: Context) returns Dynamic {
    hb_o := scope_lookup_heap_binding(scope, name)
    if hb_o.is_none() { panic("scope read binding not found: ", name) }
    ref hb : HeapBinding = hb_o.unwrap()
    return scope_read_heap_binding_raw(hb, name, ctx)
}

priv scope_move_bound_raw := func(mut scope: Scope, name: Str, ctx: Context) returns Dynamic {
    mut hb_o := scope_lookup_heap_binding(scope, name)
    if hb_o.is_none() { panic("scope move binding not found: ", name) }
    ref mut hb : HeapBinding = hb_o.unwrap()
    if hb.moved_out { panic("move of moved binding: ", name) }
    ref heap_data : Dynamic = to_ptr(hb.ptr)
    if heap_data.is_null() { panic("binding with null raw storage: ", name) }
    if hb.is_static_callable { return heap_clone_by_type(hb_type(hb), heap_data, ctx) }
    if hb.is_borrowed {
        if hb.own_type.is(OwnType.Ref) {
            borrowed_result : Dynamic = heap_data
            return borrowed_result
        }
        return heap_clone_by_type(hb_type(hb), heap_data, ctx)
    }
    result : Dynamic = heap_data
    hb.ptr = bits_word(0)
    hb.moved_out = true
    return result
}

// --- Type interning (#286 follow-up) ---
// HeapBinding.til_type is a borrow; these helpers provide the stable
// storage it points into (ctx.interned_types, see InternedTypes in
// context.til). Everything that flows a NEW Type value into a binding
// interns it first; binding-to-binding flows just copy the pointer.

// Fixed slot per payload-less Type variant in InternedTypes.simples.
priv intern_simple_index := func(shallow t: Type) returns USize {
    switch t {
    case .Unknown: return 0
    case .None: return 1
    case .StructDef: return 2
    case .EnumDef: return 3
    case .FuncDef: return 4
    case .FuncPtr: return 5
    case .Dynamic: return 6
    case .Body: return 7
    case:
        panic("intern_simple_index: variant carries a payload")
    }
}

// Fixed slot per Primitive in InternedTypes.prims.
priv intern_prim_index := func(p: Primitive) returns USize {
    switch p {
    case .I16: return 0
    case .U16: return 1
    case .I8: return 2
    case .U8: return 3
    case .U32: return 4
    case .I32: return 5
    case .U64: return 6
    case .I64: return 7
    case .F32: return 8
    case .Bool: return 9
    case .F64: return 10
    }
}

// Clone t into its own heap block (the interp_program_to_heap pattern:
// transfer the clone's bits, zero the shell so its scope-exit delete
// frees nothing nested).
priv intern_type_box := func(shallow t: Type) returns Dynamic {
    mut raw : Dynamic = malloc(Type.size())
    mut cloned := t.clone()
    adopt_from(raw, cloned, Type.size())
    return raw
}

priv intern_named := func(mut m: Map(Str, Dynamic), name: Str, shallow t: Type) returns Dynamic {
    ref slot : Dynamic = m.get(name)?
    catch (e: KeyNotFound) {
        raw : Dynamic = intern_type_box(t)
        mut cell : UPtr = malloc(UPtr.size())
        write_ptr(cell, raw)
        m.set(name, own cell)
        return raw
    }
    return deref(slot)
}

priv intern_slot := func(mut v: Vec(Dynamic), idx: USize, shallow t: Type) returns Dynamic {
    // Vec(Dynamic).push takes an allocated 8-byte temp, copies the pointer
    // bytes, then frees the temp (see topo_emit_struct_enum_defs_lp).
    while v.len() <= idx {
        mut empty_cell : UPtr = malloc(UPtr.size())
        memset(empty_cell, 0, UPtr.size())
        v.push(own empty_cell)
    }
    ref mut slot : Dynamic = v.unsafe_get(idx)
    ref existing : Dynamic = deref(slot)
    if existing.is_null().not() {
        found : Dynamic = existing
        return found
    }
    raw : Dynamic = intern_type_box(t)
    write_ptr(slot, raw)
    return raw
}

// Canonical, address-stable heap Type block for t (returned as the raw
// pointer word -- hop through to_ptr for a typed view); lives until
// Context teardown.
interp_intern_type := func(shallow t: Type, mut ctx: Context) returns Dynamic {
    switch t {
    case .Struct(name): return intern_named(ctx.interned_types.structs, name, t)
    case .StructSym(s_sym): return intern_named(ctx.interned_types.structs, ctx.symbols.resolve(s_sym), t)
    case .Enum(name): return intern_named(ctx.interned_types.enums, name, t)
    case .EnumSym(e_sym): return intern_named(ctx.interned_types.enums, ctx.symbols.resolve(e_sym), t)
    case .Custom(name): return intern_named(ctx.interned_types.customs, name, t)
    case .CustomSym(c_sym): return intern_named(ctx.interned_types.customs, ctx.symbols.resolve(c_sym), t)
    case .FuncPtrSig(name): return intern_named(ctx.interned_types.funcsigs, name, t)
    case .FuncPtrSigSym(fsig_sym): return intern_named(ctx.interned_types.funcsigs, ctx.symbols.resolve(fsig_sym), t)
    case .Primitive(p): return intern_slot(ctx.interned_types.prims, intern_prim_index(p), t)
    case: return intern_slot(ctx.interned_types.simples, intern_simple_index(t), t)
    }
}

priv scope_drop_existing_heap_slot := func(mut s: Scope, name: Str, drop_nested: Bool = true) {
    ref mut hb : HeapBinding = s.heap_bindings.get(name)?
    catch (e: KeyNotFound) { return }
    if hb.is_local.not() { return }
    if hb.is_borrowed { return }
    if hb.moved_out { return }
    mut old_ptr : Dynamic = hb.ptr
    if old_ptr.is_null() { return }
    if drop_nested.and(hb.is_static_callable.not()) { heap_drop_by_type(hb_type(hb), old_ptr, hb.ctx) }
    EvalHeap.heap_free(own old_ptr)
    hb.ptr = bits_word(0)
    hb.moved_out = true
}

// til_type_w is the canonical Type as a raw pointer word (from
// interp_intern_type or another binding's til_type_p -- storage that
// outlives every scope): the binding BORROWS it for its whole lifetime.
scope_set_heap_owned := func(mut s: Scope, name: Str, ptr: Dynamic, til_type_w: Dynamic, own_type: OwnType, ctx: Context, is_local: Bool, is_borrowed: Bool = false, is_erased_dynamic: Bool = false) {
    ref til_type : Type = to_ptr(til_type_w)
    if ptr.is_null() {
        if is_borrowed.not().and(is_struct_type(til_type).or(is_enum_type(til_type))) { panic("null aggregate heap binding: ", name) }
    }
    is_static_callable := heap_slot_is_static_callable(til_type, ptr)
    scope_drop_existing_heap_slot(s, name)
    meta := HeapBinding(ptr = to_ptr(ptr), til_type_p = til_type_w, own_type = own_type, ctx = ctx, is_local = is_local, is_borrowed = is_borrowed, is_erased_dynamic = is_erased_dynamic, is_static_callable = is_static_callable, moved_out = false)
    s.heap_bindings.set(name, own meta)
}

// #286 Stage 1: mark a heap slot as moved out without deleting its metadata.
// Move sites need this separate from removing the map entry so later reads can
// fail at the source instead of silently falling back to a stale parent binding.
scope_set_heap_moved := func(mut s: Scope, name: Str, moved_out: Bool) {
    mut b_o := scope_lookup_heap_binding(s, name)
    if b_o.is_none() { panic("scope_set_heap_moved: heap binding not found: ", name) }
    ref mut b : HeapBinding = b_o.unwrap()
    b.moved_out = moved_out
}

// #324: the OWNED sibling of scope_new_boxed, for the scopes a field holds
// as Option(Scope). The pool is skipped on purpose: these are the three
// long-lived roots (constfolder_known, eval.ns_fields, session global), not the
// per-frame scopes the pool exists for, and an owned return cannot launder a
// recycled ref out of the pool anyway. malloc binds the raw allocation to an
// owned local (the fcall_is_raw_alloc form), so `Some(own ...)` accepts the
// result and ownership is real from birth.
scope_new_owned := func(parent: Option(ref Scope)) returns Scope {
    mut raw : Scope = malloc(Scope.size())
    memset(raw, 0, Scope.size())
    raw.heap_bindings = Map(Str, HeapBinding).new()
    raw.heap_aliases = Map(Str, Str).new()
    raw.parent = parent
    return raw
}

scope_new_boxed := func(parent: Option(ref Scope)) returns ref Scope {
    if scope_pool.len() > 0 {
        // Same steal-the-dead-slot recycle as scope_new above.
        ref mut e : DynPtrBox = scope_pool.unsafe_get(scope_pool.len() - 1)
        scope_pool.count = scope_pool.count - 1
        ref mut pooled : Scope = to_ptr(e.p)
        pooled.parent = parent
        return pooled
    }
    mut raw : Scope = malloc(Scope.size())
    memset(raw, 0, Scope.size())
    ref mut s : Scope = to_ptr(raw)
    s.heap_bindings = Map(Str, HeapBinding).new()
    s.heap_aliases = Map(Str, Str).new()
    s.parent = parent
    return s
}

scope_drop_owned_bindings := func(mut s: Scope) {
    for _, mut hb in s.heap_bindings {
        if hb.is_local.not().or(hb.is_borrowed).or(hb.moved_out).or(hb.ptr.is_null()) { continue }
        // #275: a #302 raw allocation (`b : I8 = malloc(n)`) binds the
        // BLOCK ITSELF as its datum, not an interpreter-owned slot, and the
        // compiled backend never auto-frees one -- the program's own
        // `free(own b)` is the sole authority. Freeing it here manufactures
        // a second owner: an alias that reaches the same block through a
        // stored pointer frees it via the AST, and this loop then freed it
        // again (ASAN: attempting double-free), a divergence from compiled
        // mode. Leave raw allocations to the interpreted free.
        if hb.is_raw_alloc { continue }
        mut owned_ptr : Dynamic = hb.ptr
        if hb.is_static_callable.not().and(hb.payload_released.not()) { heap_drop_by_type(hb_type(hb), owned_ptr, hb.ctx) }
        EvalHeap.heap_free(own owned_ptr)
        hb.ptr = bits_word(0)
        hb.moved_out = true
    }
}

priv scope_set_borrowed := func(mut s: Scope, name: Str, til_type_w: Dynamic, own_type: OwnType, source_name: Str, mut source_scope: Scope) {
    ref til_type : Type = to_ptr(til_type_w)
    if source_name.len() == 0 { panic("borrowed binding without source name: ", name) }
    if source_name.len() > 0 { s.heap_aliases.set(name, own source_name.clone()) }
    if to_ptr(source_scope).is_null() {
        switch s.parent {
        case .Some(p): source_scope = p
        case .None: panic("borrowed binding without source scope: ", name)
        }
    }
    source_hb_o := scope_lookup_heap_binding(source_scope, source_name)
    if source_hb_o.is_none() { panic("borrow source not found: ", source_name) }
    ref source_hb : HeapBinding = source_hb_o.unwrap()
    if source_hb.ptr.is_null() { panic("borrow source not found: ", source_name) }
    if source_hb.moved_out { panic("borrow of moved binding: ", source_name) }
    ref source_ptr : Dynamic = to_ptr(source_hb.ptr)
    is_erased_dynamic := source_hb.is_erased_dynamic.or(til_type.is(Type.Dynamic).and(hb_type(source_hb).is(Type.Dynamic).not()))
    scope_set_heap_owned(s, name, source_ptr, til_type_w, own_type, source_hb.ctx, false, true, is_erased_dynamic)
}
scope_free := func(own s: Scope) {
    // Runtime slots represent compiled stack storage. Reclaim the outer slot,
    // but never drop nested payloads here; generated delete/free calls own that.
    for _, hb in s.heap_bindings {
        if hb.is_local.not().or(hb.is_borrowed).or(hb.moved_out).or(hb.ptr.is_null()) { continue }
        // Same #275 rule as scope_drop_owned_bindings: a raw allocation's
        // datum is the program's own block, not the interpreter's slot.
        if hb.is_raw_alloc { continue }
        slot : Dynamic = hb.ptr
        EvalHeap.heap_free(own slot)
    }
    own s.heap_aliases.delete(false)
    memset(s.heap_aliases, 0, Map(Str, Str).size().cast(U64))
    // The binding map owns metadata and keys, not nested program payloads.
    own s.heap_bindings.delete(false)
    memset(s.heap_bindings, 0, Map(Str, HeapBinding).size())
    // Recycle the box through the pool instead of freeing: zero the whole
    // struct (parent, is_call_scope and the already-emptied containers) so
    // the pooled box is a valid empty scope for the next scope_new.
    memset(s, 0, Scope.size())
    scope_pool_put(own s)
}

priv scope_root_ref := func(s: Scope) returns ref Scope {
    switch s.parent {
    case .Some(p): return scope_root_ref(p)
    case .None: return s
    }
}

priv closure_env_clone := func(env: Scope) returns Scope {
    mut cloned := scope_new_owned(env.parent)
    for name, hb in env.heap_bindings {
        if hb.moved_out { panic("closure clone from moved binding: ", name) }
        ref src : Dynamic = to_ptr(hb.ptr)
        if src.is_null() { panic("closure clone from null binding: ", name) }
        if hb.is_borrowed {
            scope_set_heap_owned(cloned, name, src, hb.til_type_p, hb.own_type, hb.ctx, false, true, hb.is_erased_dynamic)
            if env.heap_aliases.has(name) { cloned.heap_aliases.set(name, own env.heap_aliases[name].clone()) }
        } else {
            copied : Dynamic = heap_clone_by_type(hb_type(hb), src, hb.ctx)
            scope_set_raw_owned(cloned, name, copied, hb.til_type_p, hb.own_type, hb.ctx)
        }
    }
    return cloned
}

priv capture_raw_binding := func(mut env: Scope, mut source: Scope, cap: Declaration, ctx: Context) {
    mut hb_o := scope_lookup_heap_binding(source, cap.name)
    if hb_o.is_none() { panic("closure capture binding not found: ", cap.name) }
    ref mut hb : HeapBinding = hb_o.unwrap()
    if hb.moved_out { panic("closure capture from moved binding: ", cap.name) }
    ref mut source_scope : Scope = scope_get_binding_scope(source, cap.name)
    ref raw : Dynamic = to_ptr(hb.ptr)
    if raw.is_null() { panic("closure capture from null binding: ", cap.name) }
    if cap.own_type.is(OwnType.Ref) {
        scope_set_borrowed(env, cap.name, hb.til_type_p, cap.own_type, cap.name, source_scope)
        return
    }
    if cap.own_type.is(OwnType.Shallow).or(hb.is_borrowed).or(heap_slot_is_static_callable(hb_type(hb), raw)) {
        copied : Dynamic = heap_clone_by_type(hb_type(hb), raw, ctx)
        scope_set_raw_owned(env, cap.name, copied, hb.til_type_p, cap.own_type, ctx)
        return
    }
    scope_set_raw_owned(env, cap.name, raw, hb.til_type_p, cap.own_type, ctx)
    hb.ptr = bits_word(0)
    hb.moved_out = true
}

priv make_interp_closure := func(func_def: Expr, mut scope: Scope, ctx: Context) returns Dynamic {
    mut env := scope_new_owned(safe_ref(scope_root_ref(scope)))
    switch func_def.node_type {
    case .FuncDef(fd):
        for cap : Declaration in fd.captures {
            capture_raw_binding(env, scope, cap, ctx)
        }
    case .BodyValue(bd):
        for cap2 : Declaration in bd.captures {
            capture_raw_binding(env, scope, cap2, ctx)
        }
    case:
        UNREACHABLE("unexpected ", func_def.node_type.head_str(ctx.symbols.names))
    }
    mut box : Dynamic = EvalHeap.heap_alloc(InterpCallableBox.size())
    ref mut callable : InterpCallableBox = to_ptr(box)
    callable.magic = CALLABLE_BOX_MAGIC
    callable.func_def = func_def
    callable.env = Option(Scope).Some(own env)
    mut result : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
    write_ptr(result, box)
    return result
}

// #324: a live callable box's env, borrowed. PANICS on None: env is set at
// make_interp_closure and cleared only inside callable_box_free, so an
// absent env on a magic-checked box is a broken invariant.
priv callable_env := func(b: InterpCallableBox) returns ref Scope {
    switch b.env {
    case .Some(e): return e
    case .None: panic(__LOC__, "callable box env absent")
    }
}

priv callable_box_is := func(ptr: Dynamic) returns Bool {
    if ptr.is_null() { return false }
    ref magic : U64 = ptr
    return magic == CALLABLE_BOX_MAGIC
}

priv callable_storage_clone := func(ptr: Dynamic) returns Dynamic {
    if callable_box_is(ptr).not() { return ptr }
    ref src : InterpCallableBox = to_ptr(ptr)
    mut dst : Dynamic = EvalHeap.heap_alloc(InterpCallableBox.size())
    ref mut cloned : InterpCallableBox = to_ptr(dst)
    cloned.magic = CALLABLE_BOX_MAGIC
    cloned.func_def = src.func_def
    cloned.env = Option(Scope).Some(own closure_env_clone(callable_env(src)))
    return dst
}

priv callable_storage_free := func(mut ptr: Dynamic) {
    if callable_box_is(ptr) { callable_box_free(ptr) }
}

priv callable_box_free := func(mut ptr: Dynamic) {
    if callable_box_is(ptr).not() { return }
    ref mut b : InterpCallableBox = to_ptr(ptr)
    scope_drop_owned_bindings(callable_env(b))
    mut env_old := Option(Scope).None
    swap(Option(Scope), b.env, env_old)
    scope_free(own Option(Scope).take(own env_old))
    mut owned_ptr : Dynamic = ptr
    EvalHeap.heap_free(own owned_ptr)
}

// Shared namespace test so both FieldAccess and
// FieldAssign cases (which share an Str payload) can switch-destructure
// `e.node_type` without duplicating ~50 lines of logic.
priv interp_fa_is_ns_with_fname := func(obj_expr: Expr, sname: Str, sdef: Expr, fname: Str, symbols: SymbolPool) returns Bool {
    mut has_inst := false
    has_ns := def_ns_has(sdef, fname)
    switch sdef.node_type {
    case .StructDef(ins_sdd):
        has_inst = ins_sdd.fields_index.has(fname)
    case .EnumDef(ins_edd):
        for vd : VariantDef in ins_edd.variants {
            if vd.name == fname { has_inst = true }
        }
    case:
    }
    // Issue: variant access on an enum *instance* (e.g. `v.Some` where v
    // is an Opt value, Some is a variant of Opt) is a namespace-style
    // access -- it produces the variant constructor / tag value, matching
    // what `Opt.Some` does and what the typer accepts in compile mode.
    // The existing uppercase-receiver heuristic below only catches type-
    // name receivers (`Opt.Some`); add the enum-instance case here.
    if has_inst {
        if sdef.node_type.is(NodeType.EnumDef) {
            return true
        }
    }
    if has_ns {
        if has_inst.not() { return true }
    }
    if has_ns.not() {
        if has_inst.not() {
            switch obj_expr.node_type {
            case .Ident(ident):
                ref ident_text : Str = ident.ident_name(symbols.names)
                if ident_text == sname { return true }
                if ident_text.len() > 0 {
                    if ident_text.unsafe_get(0) >= 65 {
                        if ident_text.unsafe_get(0) <= 90 { return true }
                    }
                }
            case:
            }
            return false
        }
    }
    if has_ns {
        if has_inst {
            switch obj_expr.node_type {
            case .Ident(ident):
                ref ident_text2 : Str = ident.ident_name(symbols.names)
                if ident_text2 == sname { return true }
                if ident_text2.len() > 0 {
                    if ident_text2.unsafe_get(0) >= 65 {
                        if ident_text2.unsafe_get(0) <= 90 { return true }
                    }
                }
            case:
                return false
            }
        }
    }
    return false
}

priv interp_fa_namespace_def_inner := func(mut scope: Scope, e: Expr, sname: Str, ctx: Context) returns Option(ref Expr) {
    ref obj_expr : Expr = e.children[0]
    // The ctx type registry answers "is sname a struct/enum" in ONE map
    // get; the old scope_get(sname) walked the whole scope chain to
    // global (a Str-keyed map probe per level) on every field access.
    // Builtin primitive namespaces (I64.neq, ...) are not registered
    // there, so a miss still falls back to the scope walk.
    registry_def_o := lookup_interp_type_def(sname, ctx)
    if registry_def_o.is_some() {
        ref registry_def : Expr = registry_def_o.unwrap()
        return interp_fa_namespace_def_for(obj_expr, e, sname, registry_def, ctx.symbols)
    }
    // Same type gate as interp_fa_namespace_def below: only a callable binding
    // carries a def, and a value binding's slot is not an Expr to read.
    hb_o := scope_lookup_heap_binding(scope, sname)
    if hb_o.is_none() { return Option(ref Expr).None }
    walked_o := hb_func_def(hb_o.unwrap())
    if walked_o.is_none() { return Option(ref Expr).None }
    return interp_fa_namespace_def_for(obj_expr, e, sname, walked_o.unwrap(), ctx.symbols)
}

priv interp_fa_namespace_def_for := func(obj_expr: Expr, e: Expr, sname: Str, sdef: Expr, symbols: SymbolPool) returns Option(ref Expr) {
    if sdef.node_type.is(NodeType.StructDef).not() {
        if sdef.node_type.is(NodeType.EnumDef).not() { return Option(ref Expr).None }
    }
    mut is_namespace := false
    switch e.node_type {
    case .FieldAccess(fname):
        is_namespace = interp_fa_is_ns_with_fname(obj_expr, sname, sdef, fname.field_access_name(symbols.names), symbols)
    case .FieldAssign(fad):
        is_namespace = interp_fa_is_ns_with_fname(obj_expr, sname, sdef, fad.name, symbols)
    case:
    }
    if is_namespace { return safe_ref(sdef) }
    return Option(ref Expr).None
}

priv interp_fa_namespace_def_with_name := func(mut scope: Scope, e: Expr, sname: Str, fallback_name: Bool, ctx: Context) returns Option(ref Expr) {
    ref obj_expr : Expr = e.children[0]
    switch obj_expr.node_type {
    case .Ident(type_ident):
        type_hb_o := scope_lookup_heap_binding(scope, type_ident.ident_name(ctx.symbols.names))
        if type_hb_o.is_some().and(heap_type_is_callable(hb_type(type_hb_o.unwrap()))) {
            ref type_hb : HeapBinding = type_hb_o.unwrap()
            ref type_def : Expr = callable_raw_func_def(to_ptr(type_hb.ptr))
            if type_def.node_type.is(NodeType.StructDef).or(type_def.node_type.is(NodeType.EnumDef)) {
                // The scope walk just resolved the def; hand it straight to
                // the decision leaf instead of re-resolving the name through
                // the registry (and, for alias names the registry lacks, a
                // SECOND full scope walk) inside interp_fa_namespace_def_inner. The
                // walked def also respects shadowing, which the registry
                // probe by name cannot.
                return interp_fa_namespace_def_for(obj_expr, e, type_ident.ident_name(ctx.symbols.names), type_def, ctx.symbols)
            }
        }
    case:
    }
    if fallback_name {
        if sname.eq("unknown").or(sname.eq("?")).or(sname.eq("Dynamic")) { return Option(ref Expr).None }
    }
    return interp_fa_namespace_def_inner(scope, e, sname, ctx)
}

priv interp_fa_namespace_def := func(mut scope: Scope, e: Expr, ctx: Context) returns Option(ref Expr) {
    ref obj_expr : Expr = e.children[0]
    sname_o := expr_type_name_ref(obj_expr, ctx.symbols)
    if sname_o.is_some() {
        ref sname : Str = sname_o.unwrap()
        return interp_fa_namespace_def_with_name(scope, e, sname, false, ctx)
    }
    switch obj_expr.node_type {
    case .Ident(ident): return interp_fa_namespace_def_with_name(scope, e, ident.ident_name(ctx.symbols.names), false, ctx)
    case:
    }
    // Primitive receivers (`0.sub(1)`, recv = LiteralNum I64): til_type_name
    // returns "" for I64/U8/etc, fall back to til_type_name_c.
    tn := til_type_name_c(obj_expr.til_type())
    if tn.eq("unknown").not().and(tn.eq("?").not()).and(tn.eq("Dynamic").not()) {
        return interp_fa_namespace_def_with_name(scope, e, tn, false, ctx)
    }
    return Option(ref Expr).None
}

priv build_argv_array := func(argv: Vec(Str), offset: USize, count: USize, elem_type: Str, ctx: Context) returns Dynamic {
    esz := elem_size_for_type(elem_type, ctx)
    mut alloc_count := count
    if alloc_count == 0 { alloc_count = 1 }
    mut data : Dynamic = EvalHeap.heap_alloc(alloc_count.mul(esz))
    for i in 0..count {
        raw : Dynamic = parse_cli_arg(argv[offset + i], elem_type, ctx)
        memcpy(ptr_add(data, i * esz), raw, esz)
        EvalHeap.heap_free(own raw)
    }
    array_name := format("Array__", elem_type)
    array_binding_o := ctx.scope.get_binding_name(array_name, ctx.symbols)
    if array_binding_o.is_none() { panic("missing Array type '", array_name, "'") }
    ref array_binding : TypeBinding = array_binding_o.unwrap()
    ref array_canon_name : Str = array_binding.name
    sz := ctx_total_size(array_canon_name, ctx)
    mut inst_data : Dynamic = EvalHeap.heap_alloc(sz)
    ref ba_data_fl : FieldLayout = ctx_field_layout(array_canon_name, "data", ctx)
    write_ptr(ptr_add(inst_data, ba_data_fl.offset), data)
    ref ba_cap_fl : FieldLayout = ctx_field_layout(array_canon_name, "cap", ctx)
    memcpy(ptr_add(inst_data, ba_cap_fl.offset), count, ba_cap_fl.size)
    return inst_data
}

// Cache-only pass: populate ctx.eval.cached_str_name (and the type-def map)
// before raw allocation and layout helpers need the canonical Str name.
populate_cached_aggregate_defs := func(mut ctx: Context, mut program: Expr) {
    for mut stmt : Expr in program.children {
        switch stmt.node_type {
        case .Decl(dd):
            if stmt.children.len() == 0 { continue }
            ref mut sdef : Expr = stmt.children[0]
            if sdef.node_type.is(NodeType.StructDef).not() {
                if sdef.node_type.is(NodeType.EnumDef).not() { continue }
            }
            if sdef.node_type.is(NodeType.StructDef) {
                if dd.name == "Str" { ctx.eval.cached_str_name = dd.name.clone() }
            }
            set_namespace_func_identity(safe_ref(dd), sdef)
            mut tdv : UPtr = malloc(UPtr.size())
            write_ptr(tdv, sdef)
            ctx.interp_type_defs.set(dd.name, own tdv)
        case:
        }
    }
}

interpreter_init_ns := proc(mut ctx: Context, mut global: Scope, mut program: Expr) {
    if ctx.eval.ns_fields.is_none() {
        ctx.eval.ns_fields = Option(Scope).Some(own scope_new_owned(Option(ref Scope).None))
    }
    for mut stmt : Expr in program.children {
        switch stmt.node_type {
        case .Decl(dd):
            if stmt.children.len() == 0 { continue }
            ref mut sdef : Expr = stmt.children[0]
            if sdef.node_type.is(NodeType.StructDef).not() {
                if sdef.node_type.is(NodeType.EnumDef).not() { continue }
            }
            if sdef.node_type.is(NodeType.StructDef) {
                if dd.name == "Str" { ctx.eval.cached_str_name = dd.name.clone() }
            }
            // Register every struct/enum AST in the comprehensive type-def map;
            // layout readers resolve nested definitions by name through it.
            // Clone the name for owned-key safety -- a CAP_VIEW key dangles if the
            // AST gets rebuilt later in the run. The map value is a malloc'd cell
            // holding the Expr pointer (same encoding as TypeScope.struct_defs).
            mut tdv : UPtr = malloc(UPtr.size())
            write_ptr(tdv, sdef)
            ctx.interp_type_defs.set(dd.name, own tdv)
            // #307: two passes so registration order does not depend on
            // declaration order. A namespace CONSTANT's initializer may
            // reference a sibling method (`MAX : U64 = U64.bnot(0)`);
            // register every function member first (their eval needs no
            // siblings), then evaluate the constants.
            ref mut reg_ns : Vec(Declaration) = def_ns_decls(sdef)
            mut nfi : USize = 0
            for mut nsf : Declaration in reg_ns {
                cur_nfi := nfi
                nfi = nfi + 1
                if nsf.default_value.is_none() { continue }
                if nsf.default_expr().node_type.is(NodeType.FuncDef).not() { continue }
                if decl_static_ns_func_def(nsf).is_some() { continue }
                fraw : Dynamic = eval_expr_raw(global, nsf.default_expr(), ctx)
                ns_set(dd.name, def_ns_name_at(sdef, cur_nfi), fraw, Type.Body, ctx)
            }
            // #307 follow-up: constants evaluate in sibling-dependency
            // order (ns_const_eval_order), not declaration order, so an
            // initializer may reference a sibling constant declared
            // later (`c : I64 = Bar.d + 1` before `d`).
            const_order := ns_const_eval_order(dd.name, sdef, ctx.symbols)
            for nci_pos : I64 in const_order {
                cur_nci := nci_pos.to_usize()
                ref mut nsd : Declaration = reg_ns.unsafe_get(cur_nci)
                if nsd.external_symbol.len() > 0 {
                    if ctx.ffi.loaded.not() { continue }
                    ref address : U8 = ffi_dlsym(nsd.external_symbol)
                    if address.is_null() { panic("external global symbol not found: ", nsd.external_symbol) }
                    qname := ns_qname(dd.name, def_ns_name_at(sdef, cur_nci))
                    external_type := declaration_resolved_type(nsd, ctx.scope, ctx.symbols)
                    scope_set_heap_owned(ns_scope(ctx), qname, address,
                        interp_intern_type(external_type, ctx), OwnType.Shallow,
                        ctx, false, true)
                    continue
                }
                mut info := raw_result_info_new()
                mut raw : Dynamic = eval_expr_raw_info(global, nsd.default_expr(), ctx, info)
                if info.is_ref {
                    owned : Dynamic = heap_clone_by_type(ns_decl_raw_type(nsd), raw, ctx)
                    raw = owned
                } else if info.is_word {
                    // ns storage is a binding: a scalar word needs a block.
                    raw = scalar_block_from_word(ns_decl_raw_type(nsd), raw, ctx)
                }
                ns_set(dd.name, def_ns_name_at(sdef, cur_nci), raw, ns_decl_raw_type(nsd), ctx)
            }
        case:
        }
    }
}

priv ns_qname := func(sname: Str, fname: Str) returns Str {
    return sname.concat3(".", fname)
}

// #324: the ns table, borrowed. PANICS on None: callers on this accessor
// run only after interpreter_init_ns built the table, so an absent one is
// a broken invariant. Callers for which absence is a REAL state (the
// lookup-shaped ones -- a miss and an un-built table answer the same)
// switch on the field instead.
priv ns_scope := func(ctx: Context) returns ref Scope {
    switch ctx.eval.ns_fields {
    case .Some(nsf): return nsf
    case .None: panic(__LOC__, "ns_fields read before interpreter_init_ns")
    }
}

// scope_lookup_heap_binding for a `sname.fname` key, without building
// it: the ns tables are the interpreter's hottest joined-key probe
// (29.7K per first_class translate), and the join was allocated and
// dropped on every one.
priv scope_lookup_ns_binding := func(mut s: Scope, sname: Str, fname: Str) returns Option(ref HeapBinding) {
    if to_ptr(s).is_null() { return Option(ref HeapBinding).None }   // REM: nullable scope ARG, see scope_get
    ref mut cur : Scope = s
    mut walking := true
    while walking {
        at := qname_keys_index(cur.heap_bindings.keys, sname, ".", fname)
        if at >= 0 {
            ref b : HeapBinding = cur.heap_bindings.values.unsafe_get(at.to_usize())
            return safe_ref(b)
        }
        switch cur.parent {
        case .Some(p): cur = p
        case .None: walking = false
        }
    }
    return Option(ref HeapBinding).None
}

ns_get := func(sname: Str, fname: Str, mut ctx: Context) returns Option(ref Dynamic) {
    ref mut c : Context = ctx
    // An un-built table and a miss answer the same here: absence is a real
    // state for lookups, so no ns_scope panic.
    if c.eval.ns_fields.is_none() { return Option(ref Dynamic).None }
    hb_o := scope_lookup_ns_binding(ns_scope(c), sname, fname)
    if hb_o.is_none() { return Option(ref Dynamic).None }
    ref hb : HeapBinding = hb_o.unwrap()
    ref slot : Dynamic = to_ptr(hb.ptr)
    return safe_ref(Dynamic, slot)
}


priv ns_set := func(sname: Str, fname: Str, raw: Dynamic, shallow supplied_type: Type, mut ctx: Context) {
    ref mut c : Context = ctx
    qn := ns_qname(sname, fname)
    mut incoming : Dynamic = raw
    mut hb_o := scope_lookup_heap_binding(ns_scope(c), qn)
    // An existing binding's type is already canonical; a fresh one interns
    // the supplied type. scope_set_raw_owned panics on Unknown either way.
    if hb_o.is_some() {
        ref mut hb : HeapBinding = hb_o.unwrap()
        if hb.is_borrowed {
            ref mut target : Dynamic = to_ptr(hb.ptr)
            if raw_type_is_prim(hb_type(hb), ctx) {
                word : Dynamic = scalar_word_load(hb_type(hb), incoming, ctx)
                scalar_word_store(hb_type(hb), target, word, ctx)
                raw_block_free(incoming)
            } else {
                _ := heap_move_ptr_into_slot(hb_type(hb), target, incoming, hb.ctx, true)
            }
            return
        }
        scope_set_raw_owned(ns_scope(c), qn, raw, hb_o.unwrap().til_type_p, OwnType.Own, ctx)
        return
    }
    if supplied_type.is(Type.Unknown) { panic("namespace field type not found: ", qn) }
    scope_set_raw_owned(ns_scope(c), qn, raw, interp_intern_type(supplied_type, ctx), OwnType.Own, ctx)
}

priv ns_decl_raw_type := func(decl: Declaration) returns Type {
    if decl.default_expr().node_type.is(NodeType.FuncDef) { return Type.Body }
    return decl.default_expr().til_type().clone()
}

priv ns_field_type := func(sname: Str, fname: Str, mut ctx: Context) returns Type {
    namespace_def_o := lookup_interp_type_def(sname, ctx)
    if namespace_def_o.is_some().and(namespace_def_o.unwrap().node_type.is(NodeType.EnumDef)) {
        ref namespace_def : Expr = namespace_def_o.unwrap()
        variant_idx := enum_variant_index(namespace_def, fname)
        if variant_idx >= 0 {
            if enum_variant_type(namespace_def, variant_idx).len() == 0 { return Type.Enum(sname.clone()) }
        }
    }
    if ctx.eval.ns_fields.is_none() { panic("namespace field type not found: ", ns_qname(sname, fname)) }
    hb_o := scope_lookup_ns_binding(ns_scope(ctx), sname, fname)
    if hb_o.is_none() { panic("namespace field type not found: ", ns_qname(sname, fname)) }
    ref hb : HeapBinding = hb_o.unwrap()
    return hb_type(hb).clone()
}

interpreter_free_ns := func(mut ctx: Context) {
    if ctx.eval.ns_fields.is_none() { return }
    scope_drop_owned_bindings(ns_scope(ctx))
    // Move the table OUT of the field before freeing: the field is None the
    // moment the free runs, and no later reassignment drains a dead value.
    mut nsf_old := Option(Scope).None
    swap(Option(Scope), ctx.eval.ns_fields, nsf_old)
    scope_free(own Option(Scope).take(own nsf_old))
}

// #192: write the count/cap USize fields of a freshly-malloc'd Str instance
// using the CTX layout (offset + size), not a hardcoded width. This keeps the
// compile-time interpreter (constfolder) correct when the compiler it runs
// inside was built at a different USize width than the source it compiles:
// the bytes are laid out the same way struct_deep_free later reads them.
priv str_write_count_cap := func(mut inst_data: Dynamic, count_val: USize, cap_val: USize, ctx: Context) {
    ref count_fl : FieldLayout = ctx_field_layout(ctx.eval.cached_str_name, "count", ctx)
    ref cap_fl : FieldLayout = ctx_field_layout(ctx.eval.cached_str_name, "cap", ctx)
    if count_fl.size == 4 { write_u32(ptr_add(inst_data, count_fl.offset), count_val.to_u32()) }
    else { write_u64(ptr_add(inst_data, count_fl.offset), count_val.to_u64()) }
    if cap_fl.size == 4 { write_u32(ptr_add(inst_data, cap_fl.offset), cap_val.to_u32()) }
    else { write_u64(ptr_add(inst_data, cap_fl.offset), cap_val.to_u64()) }
}

// #192/#309: the byte width at which a Str's USize field (count/cap) must be
// read. ctx.struct_layouts lays Str out at the HOST width (initer.til's
// compute_struct_layout: the interpreter runs host-compiled Str helpers and
// must match their ABI), so the field's slot is host-sized (8 on a 64-bit
// host). But INTERPRETED core code (substr, from_c_str, ...) writes its USize
// scalars -- including the CAP_VIEW/CAP_LIT sentinels -- at the TARGET width,
// landing the value in the field's low target-width bytes. Reading the full
// host slot then ZERO-extends a U32-target sentinel (0xFFFFFFFE) instead of
// recovering the host sentinel (0xFF..FE), so str_has_owned_storage mistakes a
// view for owned storage and frees a shared c_str (heap-use-after-free). Read
// exactly the low target-width bytes (never more than the slot) and let
// str_usize_field_at sign-extend so both host-written and target-written
// sentinels map back to the full-width host sentinel.
priv str_usize_read_width := func(field_size: USize, ctx: Context) returns USize {
    // ctx.target_usize_bytes (a SCALAR mirror of target_usize_pname) -- NOT the
    // owned target_usize_pname Str: this runs during Context teardown too, where
    // that Str is already freed (#309).
    tw := ctx.target_usize_bytes
    if tw < field_size { return tw }
    return field_size
}

// #192: read a Str instance's `cap` field at the ctx layout offset. The Str
// type the compiler is built with may put cap at a different offset than the
// source it compiles (cap@12 for U32, cap@16 for U64), so the compiled
// `str.cap` access reads the wrong bytes when folding cross-width core. Read
// it at the ctx offset instead (low bytes carry the value / the CAP_VIEW /
// CAP_LIT sentinels, which fit in 32 bits).
str_cap_at := func(str_base: Dynamic, ctx: Context) returns USize {
    ref cap_fl : FieldLayout = ctx_field_layout(ctx.eval.cached_str_name, "cap", ctx)
    return str_usize_field_at(str_base, cap_fl.offset, str_usize_read_width(cap_fl.size, ctx))
}

// #192: read a Str's `count` field at the CTX layout, honouring the TARGET
// width -- the mirror of str_cap_at for the count offset. `ref s : Str;
// s.count` reads count at the HOST Str width (8 bytes on a U64-built
// compiler); when the target USize is narrower (U32), those 8 bytes span
// count@8 AND the neighbouring cap@12, so count comes back with cap in its
// high word -- a garbage huge value that crashes the buffer clone's memcpy.
str_count_at := func(str_base: Dynamic, ctx: Context) returns USize {
    ref count_fl : FieldLayout = ctx_field_layout(ctx.eval.cached_str_name, "count", ctx)
    return str_usize_field_at(str_base, count_fl.offset, str_usize_read_width(count_fl.size, ctx))
}

// #192: read a USize-typed field (Str count/cap) at exactly the CTX field
// width. `ref v : USize` would read the host USize width; a U64 host
// cross-compiling a U32 target must read only the 4 target bytes (and a U32
// host building a U64 target must read all 8), else the high word picks up
// the neighbouring field / out-of-bounds bytes. Mirrors read_field's USize
// branch.
priv str_usize_field_at := func(str_base: Dynamic, offset: USize, size: USize) returns USize {
    ref p : Dynamic = ptr_add(str_base, offset)
    // #192: SIGN-extend the narrow field. cap carries the CAP_VIEW/CAP_LIT
    // sentinels (host -2/-1 = 0xFF..FE/FF); a U32 target stores only their low
    // 32 bits (0xFFFFFFFE/FF). I32.to_usize sign-extends ((USize)(int32)) so
    // those map back to the full-width host sentinels, while real small
    // counts/caps (high bit clear) are unchanged.
    if size == 4 { ref v : I32 = p; return v.to_usize() }
    ref v : U64 = p
    return v.to_usize()
}

priv find_field_decl := func(struct_def: Expr, fname: Str) returns Option(ref Declaration) {
    switch struct_def.node_type {
    case .StructDef(ffd_sdd):
        return member_get(ffd_sdd.fields_index, ffd_sdd.fields, fname)
    case:
        return Option(ref Declaration).None
    }
}


read_field := func(inst_data: Dynamic, dd: Declaration, field_offset: USize, field_size: USize, ctx: Context) returns Dynamic {
    ref ptr : Dynamic = ptr_add(inst_data, field_offset)
    if decl_is_funcsig(dd, ctx) {
        ref stored_callable : Dynamic = deref(ptr)
        mut result : Dynamic = dispatch_result_alloc(dd.til_type, ctx)
        write_ptr(result, callable_storage_clone(stored_callable))
        return result
    }
    if dd.own_type.is(OwnType.Shallow).not() {
        mut result : Dynamic = dispatch_result_alloc(Type.Dynamic, ctx)
        ref pointed : Dynamic = deref(ptr)
        write_ptr(result, pointed)
        return result
    }
    if is_struct_type(dd.til_type).or(is_enum_type(dd.til_type)).or(field_nested_def(dd, ctx).is_some()) {
        mut result : Dynamic = dispatch_result_alloc(Type.Dynamic, ctx)
        write_ptr(result, ptr)
        return result
    }
    // A shallow primitive field reads straight into an inline word, at the
    // layout width (host struct bytes; see field_word_type).
    if raw_type_is_prim(dd.til_type, ctx) { return scalar_word_load(field_word_type(dd.til_type, field_size, ctx), ptr, ctx) }
    mut result : Dynamic = dispatch_result_alloc(dd.til_type, ctx)
    mut copy_size := raw_type_size(dd.til_type, ctx)
    if field_size < copy_size { copy_size = field_size }
    memcpy(result, ptr, copy_size)
    return result
}

priv free_owned_struct_slot := func(ptr: Dynamic, struct_name: Str, ctx: Context) {
    ref old_owned_ref : Dynamic = deref(ptr)
    if old_owned_ref.is_null() { return }
    mut old_owned : Dynamic = old_owned_ref
    heap_drop_struct(struct_name, old_owned, ctx)
    EvalHeap.heap_free(own old_owned)
}

priv free_inline_struct_slot := func(mut ptr: Dynamic, struct_name: Str, ctx: Context) {
    heap_drop_struct(struct_name, ptr, ctx)
}

priv free_owned_enum_slot := func(ptr: Dynamic, enum_name: Str, ctx: Context) {
    ref old_data_ref : Dynamic = deref(ptr)
    if old_data_ref.is_null() { return }
    mut old_data : Dynamic = old_data_ref
    heap_drop_enum(enum_name, old_data, ctx)
    EvalHeap.heap_free(own old_data)
}

priv write_field := proc(mut inst_data: Dynamic, dd: Declaration, field_offset: USize, field_size: USize, mut raw: Dynamic, shallow raw_type: Type, raw_is_ref: Bool, drop_old: Bool, ctx: Context) {
    ref mut dst : Dynamic = ptr_add(inst_data, field_offset)
    if decl_is_funcsig(dd, ctx) {
        ref mut old_callable : Dynamic = deref(dst)
        if drop_old.and(old_callable.is_null().not()) { callable_storage_free(old_callable) }
        mut source : Dynamic = raw
        ref stored : Dynamic = deref(source)
        if raw_is_ref { write_ptr(dst, callable_storage_clone(stored)) }
        else { write_ptr(dst, stored); write_ptr(raw, bits_word(0)) }
        raw_result_drop_ptr(raw_type, raw, raw_is_ref, ctx)
        return
    }
    // #397: family-predicate form of the old .Struct/.Enum payload switch,
    // so the Sym twins take the same paths with a resolved name.
    if is_struct_type(dd.til_type) {
        ref name : Str = type_name_ref(dd.til_type, ctx.symbols)
        mut source : Dynamic = raw
        if dd.own_type.is(OwnType.Own) {
            if drop_old { free_owned_struct_slot(dst, name, ctx) }
            if raw_is_ref { write_ptr(dst, heap_clone(name, source, ctx)) }
            else { write_ptr(dst, source); return }
        } else if dd.own_type.is(OwnType.Ref) {
            write_ptr(dst, source)
        } else {
            if drop_old { free_inline_struct_slot(dst, name, ctx) }
            cloned : Dynamic = heap_clone(name, source, ctx)
            memcpy(dst, cloned, field_size)
            EvalHeap.heap_free(own cloned)
        }
        raw_result_drop_ptr(raw_type, raw, raw_is_ref, ctx)
        return
    }
    if is_enum_type(dd.til_type) {
        ref ename : Str = type_name_ref(dd.til_type, ctx.symbols)
        mut source : Dynamic = raw
        if dd.own_type.is(OwnType.Own) {
            if drop_old { free_owned_enum_slot(dst, ename, ctx) }
            if raw_is_ref { write_ptr(dst, heap_clone_enum(ename, source, dispatch_enum_size(ename, ctx), ctx)) }
            else { write_ptr(dst, source); return }
        } else if dd.own_type.is(OwnType.Ref) {
            write_ptr(dst, source)
        } else {
            if drop_old { heap_drop_enum(ename, dst, ctx) }
            // Raw enum results use a word-sized carrier even when their
            // inline host representation is a 1/2/4-byte tag. Copy only the
            // destination field width or the carrier overwrites its neighbour.
            memcpy(dst, source, field_size)
            enum_payload_deep_clone(ename, dst, ctx)
        }
        raw_result_drop_ptr(raw_type, raw, raw_is_ref, ctx)
        return
    }
    if dd.own_type.is(OwnType.Own).or(dd.own_type.is(OwnType.Ref)) {
        // The field stores a POINTER, so the value written is the source
        // ADDRESS. Only a Dynamic source hides it one level down (the slot
        // holds the pointer word). This started at 0 and was filled in for
        // the Dynamic case alone, so assigning a concrete raw pointer --
        // `bx.p = b` for `ref p : U8` with `b : U8 = malloc(n)` -- wrote
        // NULL into the field: the next `ptr_add(bx.p, 1)` handed 0x1 to
        // the FFI marshaller and the interpreter segfaulted, while the
        // compiled backend stored the address and read it back fine.
        mut source : Dynamic = raw
        if raw_type.is(Type.Dynamic) { source = deref(raw) }
        if dd.own_type.is(OwnType.Own) {
            ref old : Dynamic = deref(dst)
            if drop_old.and(old.is_null().not()) { mut owned_old : Dynamic = old; free(own owned_old) }
            write_ptr(raw, bits_word(0))
        }
        write_ptr(dst, source)
        raw_result_drop_ptr(raw_type, raw, raw_is_ref, ctx)
        return
    }
    // Shallow primitive field: the value is an inline word (a ref value
    // is the BARE source address -- load the scalar through it; the
    // source keeps its storage). The store uses the layout width (host
    // struct bytes; see field_word_type).
    if raw_type_is_prim(raw_type, ctx) {
        mut w : Dynamic = raw
        if raw_is_ref { w = scalar_word_load(raw_type, raw, ctx) }
        scalar_word_store(field_word_type(raw_type, field_size, ctx), dst, w, ctx)
        return
    }
    mut copy_size := raw_type_size(raw_type, ctx)
    if field_size < copy_size { copy_size = field_size }
    mut source : Dynamic = raw
    memcpy(dst, source, copy_size)
    raw_result_drop_ptr(raw_type, raw, raw_is_ref, ctx)
}

priv interpret_register_defs := func(mut global: Scope, mut prog: Expr, mut ctx: Context) {
    for mut stmt : Expr in prog.children {
        if stmt.node_type.is(NodeType.Decl).and(stmt.children.len().gt(0)) {
            ref mut decl_value : Expr = stmt.children[0]
            if decl_value.node_type.is(NodeType.FuncDef)
            .or(decl_value.node_type.is(NodeType.StructDef))
            .or(decl_value.node_type.is(NodeType.EnumDef)) {
                switch stmt.node_type {
                case .Decl(dd):
                    if decl_value.node_type.is(NodeType.StructDef).or(decl_value.node_type.is(NodeType.EnumDef)) {
                        set_namespace_func_identity(safe_ref(dd), decl_value)
                    }
                    mut raw : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
                    write_ptr(raw, stmt.children[0])
                    scope_set_raw_owned(global, dd.name, raw, interp_intern_type(Type.Body, ctx), dd.own_type, ctx)
                case:
                }
            }
        }
    }
}

// Issue #158: one type alias (`Foo := Bar` where Bar names a struct or
// enum), recorded by interpret_register_aliases so interpret_copy_alias_ns
// does not have to re-derive the same set. Both names are borrowed from the
// AST Decl, which outlives the prepare-context sequence; interpreter_init_ns
// runs between the two phases but only reads and evaluates -- it never
// restructures a unit's top-level children.
priv InterpAlias := struct {
    ref name : Str
    ref target : Str
}

// Appends one entry to `aliases` per alias actually registered, in walk
// order, so interpret_copy_alias_ns can iterate that (tiny) list instead of
// re-walking every top-level statement of every unit to re-apply this exact
// predicate. Aliases are rare; the walk this saves is over the whole program.
priv interpret_register_aliases := func(mut global: Scope, prog: Expr, mut ctx: Context, mut aliases: Vec(InterpAlias)) {
    for stmt : Expr in prog.children {
        if stmt.node_type.is(NodeType.Decl).not() { }
        else if stmt.til_type().is(Type.None).not() { }
        else if stmt.children.len() == 0 { }
        else {
            switch stmt.children[0].node_type {
            case .Ident(rhs_ident):
                // A value RHS is not a type alias: it carries no def, and
                // reading its slot as one is the wild-pointer bug hb_func_def
                // exists to stop.
                ref src_hb : HeapBinding = scope_lookup_heap_binding(global, rhs_ident.ident_name(ctx.symbols.names)).unwrap()
                sdef_o := hb_func_def(src_hb)
                if sdef_o.is_some() {
                    ref sdef : Expr = sdef_o.unwrap()
                    if sdef.node_type.is(NodeType.StructDef).or(sdef.node_type.is(NodeType.EnumDef)) {
                        switch stmt.node_type {
                        case .Decl(dd):
                            mut raw : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
                            write_ptr(raw, sdef)
                            scope_set_raw_owned(global, dd.name, raw, interp_intern_type(Type.Body, ctx), dd.own_type, ctx)
                            mut ia := InterpAlias(name = dd.name, target = rhs_ident.ident_name(ctx.symbols.names))
                            aliases.push(own ia)
                        case:
                        }
                    }
                }
            case:
            }
        }
    }
}

// The target is re-resolved through `global` here rather than carried over
// from registration: interpreter_init_ns ran in between and is what filled
// the namespaces this copies, so the lookup must happen now -- exactly as
// it did when this walked the AST itself.
priv interpret_copy_alias_ns := func(aliases: Vec(InterpAlias), mut global: Scope, mut ctx: Context) {
    for al : InterpAlias in aliases {
        // The target was registered as a struct/enum def above, so a
        // non-callable binding here would mean the global was rebound in
        // between -- ask, don't assume, and skip if so.
        ref tc_hb : HeapBinding = scope_lookup_heap_binding(global, al.target).unwrap()
        sdef_o := hb_func_def(tc_hb)
        if sdef_o.is_none() { continue }
        ref sdef : Expr = sdef_o.unwrap()
        if sdef.node_type.is(NodeType.StructDef).or(sdef.node_type.is(NodeType.EnumDef)) {
            ref ini_ns : Vec(Declaration) = def_ns_decls(sdef)
            mut ini : USize = 0
            for nsd : Declaration in ini_ns {
                ref in_name : Str = def_ns_name_at(sdef, ini)
                ini = ini + 1
                raw_o := ns_get(al.target, in_name, ctx)
                if raw_o.is_some() {
                    cloned : Dynamic = heap_clone_by_type(ns_decl_raw_type(nsd), raw_o.unwrap(), ctx)
                    ns_set(al.name, in_name, cloned, ns_decl_raw_type(nsd), ctx)
                }
            }
        }
    }
}

// #324: the session's root scope, borrowed. PANICS on None: every caller
// runs between interp_session_start and interp_session_free, so an absent
// global is a broken invariant, not a state to absorb.
priv session_global := func(session: InterpSession) returns ref Scope {
    switch session.global {
    case .Some(g): return g
    case .None: panic(__LOC__, "session global read outside start/free")
    }
}

interp_session_start := func(mut session: InterpSession, user_argv: Vec(Str)) {
    if session.global.is_some() {
        scope_drop_owned_bindings(session_global(session))
        mut sg_stale := Option(Scope).None
        swap(Option(Scope), session.global, sg_stale)
        scope_free(own Option(Scope).take(own sg_stale))
    }
    session.global = Option(Scope).Some(own scope_new_owned(Option(ref Scope).None))
    session.core_evaluated = false
    session.user_argc = 0
    session.retained_programs = Vec(DynPtrBox).new()
    session.evaluated_units = Set(Str).new()
    session.user_argc = user_argv.len()
}

interp_session_free := func(mut session: InterpSession) {
    if session.global.is_some() {
        scope_drop_owned_bindings(session_global(session))
        // Move the scope OUT of the field before freeing, so the field is
        // None the moment the free runs.
        mut sg_old := Option(Scope).None
        swap(Option(Scope), session.global, sg_old)
        scope_free(own Option(Scope).take(own sg_old))
    }
    for box : DynPtrBox in session.retained_programs {
        if box.p.is_null().not() {
            LoadedProgram.delete(own to_ptr(box.p), true)
        }
    }
    free(own session.retained_programs.data)
    memset(session.retained_programs, 0, Vec(DynPtrBox).size())
    own session.evaluated_units.delete(false)
    memset(session.evaluated_units, 0, Set(Str).size())
    session.core_evaluated = false
    session.user_argc = 0
    // All scopes are dead by now (global freed above, eval scopes freed
    // during eval); release their pooled boxes.
    scope_pool_drain()
}

interp_program_to_heap := func(own lp: LoadedProgram) returns Dynamic {
    mut raw : Dynamic = malloc(LoadedProgram.size())
    memcpy(raw, lp, LoadedProgram.size())
    memset(lp, 0, LoadedProgram.size())
    return raw
}

interp_program_free := func(raw: Dynamic) {
    LoadedProgram.delete(own to_ptr(raw), true)
}

interp_session_retain_program := func(mut session: InterpSession, raw: Dynamic) {
    session.retained_programs.push(own DynPtrBox(p = raw))
}

priv interp_reset_control_flow := func(mut ctx: Context) {
    if ctx.eval.has_return {
        raw : Dynamic = context_return_take(ctx)
        EvalHeap.heap_free(own raw)
    }
    ctx.eval.has_return = false
    ctx.eval.has_break = false
    ctx.eval.has_continue = false
    ctx.eval.eval_aborted = false
}

interp_session_prepare_context := proc(mut session: InterpSession, mut lp: LoadedProgram, fwd_path: Str) returns I32 {
    // Every REPL turn interprets a freshly loaded/cloned program, so the flag
    // has to be restamped on each turn's Context.
    lp.ctx.eval.repl_session = session.is_repl
    // Ensure builtin dispatch table is initialized deterministically.
    if lp.ctx.ffi.dispatch_inited.not() { dispatch_init(lp.ctx) }

    // FFI init: reset, load the shared lib, then scan per-file ASTs.
    ffi_reset(lp.ctx)
    empty := Expr.new(NodeType.Body, 0, 0)
    ffi_rc := ffi_init(empty, fwd_path, lp.link_c_paths, lp.ext_c_path, lp.link_flags, lp.ctx)
    if ffi_rc.eq(0).not() { return ffi_rc }
    for upath : Str in lp.unit_paths() {
        ref iu : ImportUnit = lp.ctx.imported[upath]
        ffi_init_struct_defs_append(iu.ast, lp.ctx)
        ffi_init_scan_program(iu.ast, lp.ctx)
    }

    // Refresh definition pointers and namespace state against this turn's AST.
    for upath : Str in lp.unit_paths() {
        ref mut iu2 : ImportUnit = lp.ctx.imported[upath]
        interpret_register_defs(session_global(session), iu2.ast, lp.ctx)
    }

    // Issue #158: the alias set is derived once, here, and reused after the
    // init_ns barrier. The barrier itself is real -- a namespace default may
    // name a type by its alias, so every alias must be registered before any
    // ns member is evaluated, and copy_alias_ns reads what init_ns filled --
    // but re-deriving WHICH statements are aliases cost a second full walk
    // of every unit's top level to find the handful that qualify.
    mut aliases := Vec(InterpAlias).new()
    for upath : Str in lp.unit_paths() {
        ref iu4 : ImportUnit = lp.ctx.imported[upath]
        interpret_register_aliases(session_global(session), iu4.ast, lp.ctx, aliases)
    }

    for upath : Str in lp.unit_paths() {
        ref mut iu6 : ImportUnit = lp.ctx.imported[upath]
        interpreter_init_ns(lp.ctx, session_global(session), iu6.ast)
    }

    interpret_copy_alias_ns(aliases, session_global(session), lp.ctx)
    return 0
}

interp_session_finish_context := proc(mut lp: LoadedProgram) {
    interpreter_free_ns(lp.ctx)
    ffi_cleanup(lp.ctx)
}

interp_session_eval_core_once := proc(mut session: InterpSession, mut lp: LoadedProgram) {
    if session.core_evaluated { return }
    if lp.skip_core.not() {
        for u : ProgramUnit in lp.core_units {
            ref mut iu : ImportUnit = lp.ctx.imported[u.path]
            context_enter_file(lp.ctx, u.path)
            eval_body(session_global(session), iu.ast, lp.ctx)
        }
    }
    session.core_evaluated = true
    interp_reset_control_flow(lp.ctx)
}

interp_session_eval_user_units := proc(mut session: InterpSession, mut lp: LoadedProgram) {
    for u : ProgramUnit in lp.units {
        ref mut iu : ImportUnit = lp.ctx.imported[u.path]
        context_enter_file(lp.ctx, u.path)
        eval_body(session_global(session), iu.ast, lp.ctx)
    }
    interp_reset_control_flow(lp.ctx)
}

// REPL-only: run the top-level global initializers of every imported unit
// (all units except the last, which is the entry root the REPL evaluates
// incrementally) exactly once per session. Without this an imported unit's
// globals -- e.g. std/doc's __til_info_blob__/__til_docs_blob__, which the
// injected help() import brings in -- are never declared in `global`, so the
// doc-init assignment hits an undefined variable. Keyed by path so a unit
// added mid-session (a user import via the full-load path) runs on its first
// appearance and never re-runs.
interp_session_eval_imported_once := proc(mut session: InterpSession, mut lp: LoadedProgram) {
    if lp.units.len() < 2 { return }
    for i in 0..lp.units.len().sub(1) {
        ref u : ProgramUnit = lp.units[i]
        if session.evaluated_units.has(u.path) { continue }
        ref mut iu : ImportUnit = lp.ctx.imported[u.path]
        context_enter_file(lp.ctx, u.path)
        eval_body(session_global(session), iu.ast, lp.ctx)
        session.evaluated_units.add(own u.path.clone())
    }
    interp_reset_control_flow(lp.ctx)
}

priv interp_body_slice := func(mut program: Expr, start_idx: USize, count: USize, mut out: Expr) {
    free(own out.children.data)
    out.children.data = ptr_add(program.children.data, start_idx.mul(Expr.size()))
    out.children.count = count
    out.children.cap = count
}

priv interp_body_slice_clear := func(mut body: Expr) {
    body.children.data = bits_word(0)
    body.children.count = 0
    body.children.cap = 0
}

priv interp_eval_program_slice := proc(mut session: InterpSession, mut lp: LoadedProgram, mut program: Expr, start_idx: USize, count: USize) {
    if count == 0 { return }
    mut body := Expr.new(NodeType.Body, 0, 0)
    interp_body_slice(program, start_idx, count, body)
    eval_body(session_global(session), body, lp.ctx)
    interp_body_slice_clear(body)
}

priv interp_first_stmt_at_line := func(program: Expr, min_line: U32) returns USize {
    mut i : USize = 0
    while i < program.children.len() {
        if program.children[i].line >= min_line { return i }
        i++
    }
    return program.children.len()
}

priv interp_eval_exact_line := proc(mut session: InterpSession, mut lp: LoadedProgram, mut program: Expr, line: U32) {
    mut start : USize = program.children.len()
    mut count : USize = 0
    mut i : USize = 0
    while i < program.children.len() {
        if program.children[i].line == line {
            if count == 0 { start = i }
            count++
        } else if count > 0 {
            break
        }
        i++
    }
    if count == 0 { panic("REPL doc init line missing") }
    interp_eval_program_slice(session, lp, program, start, count)
}

// The throw lowering PREPENDS a body's error-slot decls -- `_err_kind` plus
// one `_err_<T>` per payload-bearing throw type -- at the head of the body it
// lowers, carrying the body's own line. They are body preamble, not user
// statements, so the line-based slice below leaves them behind: a REPL turn
// whose new statement throws (`println(v[0].to_str())`, which lowers to a
// `get` call taking `_err_kind` as an out-arg) died with "argument binding not
// found: _err_kind". Count the leading run so the caller can evaluate it. The
// full load re-lowers the whole accumulated program every turn, so the
// preamble always belongs to the statements about to run.
priv interp_lowering_preamble_count := func(program: Expr, limit: USize) returns USize {
    mut n : USize = 0
    while n < limit {
        mut is_slot := false
        switch program.children[n].node_type {
        case .Decl(dd): is_slot = dd.name.starts_with("_err_")
        case:
        }
        if is_slot.not() { return n }
        n++
    }
    return n
}

// doc_init_line is the source line of the REPL's injected doc-init call
// (doc_init_cache_files, which populates the help() blobs). It sits above
// block_start_line so the normal slice skips it; when eval_doc_line is set
// it is evaluated by exact line. The caller owns the preamble layout and
// passes the line, so this stays correct if that layout changes.
// Both return true when the turn was ABANDONED mid-way: h_exit saw a failing
// exit (panic and friends) in a REPL session and unwound instead of killing
// the process. The caller must not commit such a line to the accumulated
// source -- replaying it would panic again on every later full load.
// interp_reset_control_flow clears the flag, so read it before that.
interp_session_eval_current_root := proc(mut session: InterpSession, mut lp: LoadedProgram, block_start_line: U32, eval_doc_line: Bool, doc_init_line: U32) returns Bool {
    ref root : ProgramUnit = lp.units[lp.units.len() - 1]
    ref mut iu : ImportUnit = lp.ctx.imported[root.path]
    start_idx := interp_first_stmt_at_line(iu.ast, block_start_line)
    interp_eval_program_slice(session, lp, iu.ast, 0, interp_lowering_preamble_count(iu.ast, start_idx))
    if eval_doc_line { interp_eval_exact_line(session, lp, iu.ast, doc_init_line) }
    interp_eval_program_slice(session, lp, iu.ast, start_idx, iu.ast.children.len().sub(start_idx))
    aborted := lp.ctx.eval.eval_aborted
    interp_reset_control_flow(lp.ctx)
    return aborted
}

interp_session_eval_current_tail := proc(mut session: InterpSession, mut lp: LoadedProgram, start_idx: USize, count: USize) returns Bool {
    ref root : ProgramUnit = lp.units[lp.units.len() - 1]
    ref mut iu : ImportUnit = lp.ctx.imported[root.path]
    interp_eval_program_slice(session, lp, iu.ast, start_idx, count)
    aborted := lp.ctx.eval.eval_aborted
    interp_reset_control_flow(lp.ctx)
    return aborted
}

// Per-file interpreter entrypoint (rstil-style): uses the canonical per-file
// ASTs stored in lp.ctx.imported, but preserves the original overall
// registration/eval ordering.
priv interpret_units := proc(mut lp: LoadedProgram, user_argv: Vec(Str), fwd_path: Str) returns I32 {
    // Ensure codegen_lp() is available throughout interpretation so
    // interpreter helpers can read shared Context fields (#177/#178).
    mut session := InterpSession()
    interp_session_start(session, user_argv)
    start_rc := interp_session_prepare_context(session, lp, fwd_path)
    if start_rc.eq(0).not() {
        interp_session_free(session)
        return start_rc
    }
    interp_session_eval_core_once(session, lp)
    interp_session_eval_user_units(session, lp)

    // Run tests (scan per-file user ASTs).  Picks up both top-level
    // test() decls and test() decls inside struct/enum namespaces so
    // tests can live next to the code they exercise.
    if lp.run_tests {
        mut test_count : I32 = 0
        mut pass_count : I32 = 0
        for u : ProgramUnit in lp.units {
            ref mut iu : ImportUnit = lp.ctx.imported[u.path]
            for mut stmt : Expr in iu.ast.children {
                if is_func_decl(stmt) {
                    switch stmt.children[0].node_type {
                    case .FuncDef(fd):
                        if fd.sig.func_type.is(FuncType.Test) {
                            switch stmt.node_type {
                            case .Decl(dd):
                                test_count++
                                mut test_scope := scope_new(safe_ref(session_global(session)))
                                context_enter_file(lp.ctx, u.path)
                                eval_body(test_scope, stmt.children[0].children[0], lp.ctx)
                                scope_free(own test_scope)
                                pass_count++
                                eprint_single("  pass: ")
                                eprint_single(dd.name)
                                eprint_single("\n")
                            case:
                            }
                        }
                    case:
                    }
                }
                if stmt.node_type.is(NodeType.Decl).and(stmt.children.len().gt(0)) {
                    ref mut rhs : Expr = stmt.children[0]
                    if rhs.node_type.is(NodeType.StructDef).or(rhs.node_type.is(NodeType.EnumDef)) {
                        switch stmt.node_type {
                        case .Decl(sdd):
                            ref mut tni_ns : Vec(Declaration) = def_ns_decls(rhs)
                            mut tni : USize = 0
                            for mut nsd : Declaration in tni_ns {
                                cur_tni := tni
                                tni = tni + 1
                                if nsd.default_value.is_none() { continue }
                                ref mut nsfdef : Expr = nsd.default_expr()
                                switch nsfdef.node_type {
                                case .FuncDef(nsfd):
                                    if nsfd.sig.func_type.is(FuncType.Test).not() { continue }
                                    test_count++
                                    mut test_scope := scope_new(safe_ref(session_global(session)))
                                    context_enter_file(lp.ctx, u.path)
                                    eval_body(test_scope, nsfdef.children[0], lp.ctx)
                                    scope_free(own test_scope)
                                    pass_count++
                                    eprint_single("  pass: ")
                                    eprint_single(sdd.name)
                                    eprint_single(".")
                                    eprint_single(def_ns_name_at(rhs, cur_tni))
                                    eprint_single("\n")
                                case:
                                }
                            }
                        case:
                        }
                    }
                }
            }
        }
        if test_count == 0 {
            eprint_single("no tests found\n")
        } else {
            eprint_single(pass_count.to_str())
            eprint_single("/")
            eprint_single(test_count.to_str())
            eprint_single(" tests passed\n")
        }
        if pass_count.eq(test_count).not() { exit(1) }
    }

    // In needs_main mode, call main() (same logic as interpret()).  When
    // run_tests is set, tests are the entry points -- skip main() so a
    // mode cli/gui file with inline test() decls runs only its tests.
    if lp.run_tests.not() { if lp.cur_mode.needs_main {
        // A `main` bound to a VALUE (`main : I64 = 5`) is not a main proc:
        // it has no def to read, and its slot deref'd as one used to be a
        // wild pointer instead of this error.
        main_hb_o := scope_lookup_heap_binding(session_global(session), "main")
        mut main_def_o := Option(ref Expr).None
        if main_hb_o.is_some() { main_def_o = hb_func_def(main_hb_o.unwrap()) }
        if main_def_o.is_none() {
            eprint_single(lp.path)
            eprint_single(": error: this mode requires a 'main' proc\n")
            exit(1)
        }
        ref mut func_def : Expr = main_def_o.unwrap()
            ref fd : FunctionDef = funcdef_of(func_def)
            nparam := fd.sig.params.len()
            vi := fd.sig.variadic_index
            ref mut body : Expr = func_def.children[0]
            mut main_scope := scope_new(safe_ref(session_global(session)))

            if nparam > 0 {
                mut fixed := nparam
                if vi >= 0 {
                    fixed = nparam - 1
                    if session.user_argc < fixed {
                        eprint_single("error: main expects at least ")
                        eprint_single(fixed.to_str())
                        eprint_single(" argument(s), got ")
                        eprint_single(session.user_argc.to_str())
                        eprint_single("\n")
                        exit(1)
                    }
                } else {
                    if session.user_argc.eq(nparam).not() {
                        eprint_single("error: main expects ")
                        eprint_single(nparam.to_str())
                        eprint_single(" argument(s), got ")
                        eprint_single(session.user_argc.to_str())
                        eprint_single("\n")
                        exit(1)
                    }
                }
                mut argi : I32 = 0
                for pi in 0..nparam {
                    ref param : Declaration = fd.sig.params[pi]
                    if pi.to_i64() == vi.cast(I64) {
                        va_count := session.user_argc - fixed
                        // Instance names keep width aliases
                        // (resolve_type_alias_for_name): the Array__<elem>
                        // binding below and inside build_argv_array is
                        // keyed on the alias spelling, while the element
                        // stride and CLI parsing resolve the width
                        // themselves (elem_size_for_type/parse_cli_arg
                        // both handle USize/UPtr).
                        va_elem := resolve_type_alias_for_name(lp.ctx.scope, decl_type_name(fd.sig.params[vi.to_usize()], lp.ctx.symbols), lp.ctx.symbols).clone()
                        arr : Dynamic = build_argv_array(user_argv, argi.to_usize(), va_count, va_elem, lp.ctx)
                        va_array_binding_o := lp.ctx.scope.get_binding_name(format("Array__", va_elem), lp.ctx.symbols)
                        if va_array_binding_o.is_none() { panic("missing variadic Array type for ", va_elem) }
                        ref va_array_binding : TypeBinding = va_array_binding_o.unwrap()
                        scope_set_raw_owned(main_scope, param.name, arr, interp_intern_type(Type.Struct(va_array_binding.name.clone()), lp.ctx), param.own_type, lp.ctx)
                        argi = argi + va_count.to_i32()
                    } else {
                        raw : Dynamic = parse_cli_arg(user_argv[argi.to_usize()], decl_type_name(param, lp.ctx.symbols), lp.ctx)
                        scope_set_raw_owned(main_scope, param.name, raw, interp_intern_type(declaration_resolved_type(param, lp.ctx.scope, lp.ctx.symbols), lp.ctx), param.own_type, lp.ctx)
                        argi++
                    }
                }
            } else if session.user_argc > 0 {
                eprint_single("error: main expects no arguments, got ")
                eprint_single(session.user_argc.to_str())
                eprint_single("\n")
                exit(1)
            }

            // main is a CALL, so its body has to run with the same
            // return context eval_user_func_call installs: a `return
            // <v>` reads ctx.eval.interp_ret_type to coerce the value to the
            // declared type. Evaluating the body bare left that None,
            // and interp_ret_type_name's #321 invariant panicked with
            // "return type read outside a call" -- on EVERY interpreted
            // `main` that returns something, `{ return 0 }` included.
            // Nothing caught it because the suite's mode-cli programs
            // either return nothing or are only ever compiled.
            ref mut mc : Context = lp.ctx
            saved_ret_is_ref := mc.eval.interp_ret_is_ref
            ref saved_ret_dest : Dynamic = mc.eval.interp_ret_dest
            saved_ret_type := mc.eval.interp_ret_type
            saved_ret_own_type := mc.eval.interp_ret_own_type
            mc.eval.interp_ret_type = safe_ref(fd.sig.return_type)
            mc.eval.interp_ret_own_type = fd.sig.return_own_type
            mc.eval.interp_ret_is_ref = fd.sig.return_own_type.is(OwnType.Ref)
            mc.eval.interp_ret_dest = 0

            eval_body(main_scope, body, lp.ctx)

            // A declared return is this process's exit status, exactly
            // as the compiled program's `int main` returns it -- the
            // two backends must not disagree about what a program's
            // result is.
            mut main_status : I32 = 0
            if mc.eval.has_return {
                mut ret_raw : Dynamic = context_return_take(mc)
                if fd.sig.return_type.len() > 0 {
                    ret_type := type_from_name_init_name(fd.sig.return_type, lp.ctx.scope, lp.ctx.symbols)
                    main_status = raw_to_i64(ret_type, ret_raw, lp.ctx).to_i32()
                    // raw_result_drop, not heap_free: a non-ref prim
                    // return IS the inline word, never a block, so
                    // freeing it walks off the value itself (`return 3`
                    // segfaulted on address 3; `return 0` only survived
                    // because free(NULL) is a no-op).
                    raw_result_drop(ret_type, ret_raw, mc.eval.interp_ret_is_ref, lp.ctx)
                }
            }
            mc.eval.interp_ret_is_ref = saved_ret_is_ref
            mc.eval.interp_ret_dest = saved_ret_dest
            mc.eval.interp_ret_type = saved_ret_type
            mc.eval.interp_ret_own_type = saved_ret_own_type
            scope_free(own main_scope)

            if main_status != 0 {
                interp_session_finish_context(lp)
                interp_session_free(session)
                return main_status
            }
    } }

    interp_session_finish_context(lp)
    interp_session_free(session)
    return 0
}

cmd_interpret := proc(mut lp: LoadedProgram, user_argv: Vec(Str)) returns I32 {
    mut interpret_fwd_path := ""
    mut result : I32 = 0
    if lp.link_c_paths.len() > 0 {
        _mk := mkdir_p("tmp")
        // PID-keyed like the shared object this header describes; concurrent
        // interpreters can start in the same millisecond.
        interpret_fwd_path = format("tmp/ffi_", process_id().to_str(), "_forward.h")
        // The header's emitters gate on the inventories builder_prepare_emit
        // settles (#326); translate_ast runs it before ITS header for the
        // same reason. Without it every typedef gates out and the linked C
        // fails on unknown type names.
        builder_prepare_emit(lp)
        result = build_forward_header_lp(interpret_fwd_path, lp)
    }
    if result == 0 {
        result = interpret_units(lp, user_argv, interpret_fwd_path)
    }
    return result
}

// --- FFI dispatch and ext-function call handling (moved here from
// src/self/dispatch.til). Routes interpreter calls to builtins
// (the dispatch_map) and to libffi-backed ext_func/ext_proc calls. ---

// Raw marshal mirror of the C Str layout; never built via the ctor.
priv ExtStr := struct {
    ref data : U8
    count : USize = 0
    cap : USize = 0
}

FFIEntry := struct {
    // #321: fn / cif / arg_types are assigned by the one constructor site
    // immediately after building, so their NULL defaults were dead -- the
    // ctor passes them now and #242 makes them mandatory.
    ref fn : U8
    // A void ext function has no return type: a real absent state.
    return_type := Option(ref Str).None
    nparam : USize = 0
    // #321/#324: these four are raw C allocations the entry OWNS -- they
    // wore `ref` labels while ffi_cleanup hand-freed them, the exact hole
    // #324 tracks. With `own`, the map's ordinary value drain reclaims
    // them (ffi_cleanup, the re-register path). The U8 label is the
    // Vec.data raw-buffer form: param_shallows / param_dynamics are
    // nparam byte-flag arrays, arg_types is an nparam pointer array.
    // param_shallows stays null unless the signature has a shallow param
    // (a real absence; delete no-ops on null).
    own param_shallows : U8 = 0
    own param_dynamics : U8 = 0
    return_is_shallow := false
    return_is_ref := false
    own cif : ffi_cif
    own arg_types : U8 = 0
namespace:
    // The REPL clones the whole LoadedProgram -- Context and ffi.entries
    // included -- on every turn (repl_clone_loaded_program), and
    // interp_session_prepare_context ffi_reset()s the clone before any
    // call goes through it, so a cloned entry only ever lives to be
    // drained. The clone still has to be correct: the generated one sees
    // `own U8` and copies a single byte, but these are nparam-sized raw
    // buffers and param_shallows is legally null -- a null deref the
    // moment a REPL session cloned a program. Copy each buffer at its
    // real length and repoint the copied cif at the copied arg_types so
    // no cross-entry borrow survives the copy.
    clone := func(self: FFIEntry) returns FFIEntry {
        np := self.nparam
        mut alloc_np := np
        if alloc_np == 0 { alloc_np = 1 }
        mut atypes : Dynamic = malloc(alloc_np.mul(8))
        memcpy(atypes, self.arg_types, alloc_np.mul(8))
        mut pdynamics : Dynamic = malloc(alloc_np)
        memcpy(pdynamics, self.param_dynamics, alloc_np)
        mut pshallows : Dynamic = 0
        if self.param_shallows.is_null().not() {
            pshallows = malloc(np)
            memcpy(pshallows, self.param_shallows, np)
        }
        mut cif : Dynamic = malloc(ffi_cif.size())
        memcpy(cif, self.cif, ffi_cif.size())
        mut entry := FFIEntry(fn = self.fn, cif = cif, arg_types = atypes,
            param_shallows = pshallows, param_dynamics = pdynamics,
            return_type = self.return_type, nparam = np,
            return_is_shallow = self.return_is_shallow,
            return_is_ref = self.return_is_ref)
        // Patch AFTER the ctor adopts the buffers, and through the entry's
        // own fields: stashing the bare local into the cif first would add
        // a garbager borrow edge (FieldAssign to a ref field pins the
        // source to end of body) that collides with the ctor's transfer.
        ref mut ccif : ffi_cif = to_ptr(entry.cif)
        ccif.arg_types = to_ptr(entry.arg_types)
        return entry
    }
}

ExprPtrBox := struct {
    ref ptr : Expr
}

FFITypePtrBox := struct {
    // #324: the box OWNS its descriptor -- build_struct_ffi_type mallocs
    // it and cache teardown frees it. With `own` here (and on
    // ffi_type.elements), resetting the cache Vec reclaims everything
    // through ordinary drains; the manual free loop is gone.
    own ptr : ffi_type
namespace:
    // Same REPL-clone story as FFIEntry.clone above: cloned boxes only
    // live to be drained (ffi_reset runs before use), but the clone must
    // still copy the elements array at its real length -- it is a
    // null-terminated ffi_type* array (build_struct_ffi_type writes the
    // terminator), which the generated clone would copy as one byte.
    clone := func(self: FFITypePtrBox) returns FFITypePtrBox {
        ref src : ffi_type = self.ptr
        mut n : USize = 0
        while true {
            ref slot : Dynamic = ptr_add(src.elements, n.mul(Dynamic.size()))
            ref p : Dynamic = deref(slot)
            if p.is_null() { break }
            n = n + 1
        }
        bytes := n.add(1).mul(Dynamic.size())
        mut elements : Dynamic = malloc(bytes)
        memcpy(elements, src.elements, bytes)
        mut st : ffi_type = malloc(ffi_type.size())
        memset(st, 0, ffi_type.size())
        st.size = src.size
        st.alignment = src.alignment
        st.type = src.type
        st.elements = elements
        return FFITypePtrBox(ptr = st)
    }
}

// Reset all FFI state so a fresh scan can run.
ffi_reset := proc(mut ctx: Context) {
    if ctx.ffi.loaded.or(ctx.ffi.entries_inited).or(ctx.ffi.type_cache_inited) {
        ffi_cleanup(ctx)
    }
    // Always ensure struct defs map exists.
    ctx.ffi.struct_defs = Map(Str, ExprPtrBox).new()
}

// libffi exposes its primitive ffi_type descriptors as global symbols
// (ffi_type_uint8, ffi_type_sint64, ...). Resolve one by name into a
// ref. Replaces a former family of ten near-identical
// ffi_type_<t>_ref() one-liner accessors.
priv ffi_type_ref := func(name: Str) returns ref ffi_type {
    return to_ptr(ffi_global_symbol(name))
}

priv ffi_alloc_cif := func() returns Dynamic { return malloc(ffi_cif.size()) }

// ffi_abi is a per-architecture C enum and FFI_DEFAULT_ABI's VALUE
// differs per arch (vendor/libffi/src/*/ffitarget.h). The binding
// constant FFI_DEFAULT_ABI=2 is only correct for the x86-64 family
// (linux/mac FFI_UNIX64=2, mingw FFI_GNUW64=2). On aarch64 the enum
// is FFI_SYSV=1, FFI_WIN64=2 -- so passing 2 selected the
// Windows-on-ARM calling convention for every interpreter FFI call: a
// near-miss on linux-arm64 (til's pointer-heavy signatures happen to
// marshal identically) and memory corruption on darwin-arm64, whose
// variadic/stack rules diverge from WIN64 (issue #25). Resolve the
// abi from host_arch() -- the compile-time arch of THIS binary, which
// is what its linked libffi was built for (and, unlike uname or
// detect_current_target, free: this runs once per ext_func
// registration, and detect_current_target's two uname spawns here
// doubled the whole suite's wall time). Panic on arches whose value
// has not been audited against ffitarget.h yet, so a new native host
// cannot silently inherit a wrong ABI.
priv ffi_host_default_abi := proc() returns I32 {
    arch := host_arch()
    if arch == "x64" { return FFI_DEFAULT_ABI }
    if arch == "arm64" { return 1 }
    panic(__LOC__, "FFI_DEFAULT_ABI not audited for this arch; add its value from vendor/libffi/src/<arch>/ffitarget.h")
    return 0
}

priv ffi_cif_rtype_is_struct := func(cif: ffi_cif) returns Bool {
    ref rt : ffi_type = cif.rtype
    return rt.type == FFI_TYPE_STRUCT.to_u16()
}

// These are side-effecting (dlopen mutates the loader, dlerror clears
// pending state) so they MUST be ext_proc, not ext_func: the constfolder
// folds ext_funcs (issue #136) but never procs, and folding a
// side-effecting call runs the effect at COMPILE time. When
// ffi_init_user_so's `eprint_single(format("error: dlopen failed: ",
// ffi_last_error(), "\n"))` was declared with ext_funcs the constfolder
// evaluated it during a normal build -- printing a bogus
// "error: dlopen failed:" and then baking the empty ffi_last_error() in,
// dropping the real runtime diagnostic (issue #283). The same reasoning
// covers eprint_single itself (src/core/io.til).
// ffi_user_symbol/ffi_global_symbol stay ext_func: their `ref U8` return is
// already never folded (try_eval_call bails on ref returns).
ffi_load_global_lib := ext_proc(soname: Str) returns shallow Bool {}
ffi_open_user_so := ext_proc(path: Str) returns shallow Bool {}
ffi_close_user_so := ext_proc() {}
ffi_user_symbol := ext_func(name: Str) returns ref U8 {}
ffi_global_symbol := ext_func(name: Str) returns ref U8 {}
ffi_last_error := ext_proc() returns Str {}
// ext_proc, NOT ext_func: this reads a build-time property of the RUNNING
// binary, so it must be evaluated at runtime. As an ext_func the constfolder
// folds it -- and bin/til_asan is built by the non-ASAN bin/til, so the fold
// bakes in `false` and the ASAN flag never reaches the FFI compile (#299).
til_built_with_asan := ext_proc() returns shallow Bool {}

priv ffi_dlsym := func(name: Str) returns ref U8 {
    ref fn : U8 = ffi_user_symbol(name)
    if fn.is_null().not() {
        return fn
    }
    return ffi_global_symbol(name)
}

// `link("vendor/raylib/src/libraylib.a")` puts a PATH in link_flags. A
// COMPILED program links that archive and stays self-contained, but an
// INTERPRETED one calls through libffi, which needs the function's ADDRESS at
// runtime -- and a static archive can never give one. It cannot be dlopen'd,
// and it contributes nothing to bin/til either, since a linker keeps only the
// members the compiler itself references and the compiler never calls raylib.
// So every raylib call from the interpreter resolved to nothing: `InitWindow`
// opened no window, `GetRandomValue(5, 5)` returned 0.
//
// The Makefile builds a loadable twin beside each archive (libraylib.a ->
// libraylib.so, force-linked with --whole-archive so every member is kept);
// dlopen that. Its symbols then resolve globally, exactly like the -lfoo case
// below. Failing to load one is fatal: the program asked to link it, so
// carrying on would put us back to silently answering 0 for every call.
priv ffi_load_archive_twin := proc(archive_path: Str) {
    if archive_path.len() == 0 { return }
    so_path := archive_path.strip_suffix(".a").format(".so")
    if ffi_load_global_lib(so_path).not() {
        panic("cannot load '", so_path, "' for interpreted calls into '", archive_path,
              "' (built by the Makefile beside the archive): ", ffi_last_error())
    }
}

priv ffi_init_link_libs := proc(link_flags: Str) {
    // Two kinds of entry: `-lfoo` sonames dlopen'd by name, and archive PATHS
    // whose loadable twin sits beside them (see ffi_load_archive_twin).
    // dlopen resolves "-lfoo" flags by soname; the shared-lib suffix is
    // host-dependent (this runs in the compiler, on the build host).
    mut so_ext := ".so"
    if host_os() == "macos" { so_ext = ".dylib" }
    mut i : USize = 0
    while i < link_flags.len() {
        if link_flags.unsafe_get(i) == 32 { i++; continue }
        start := i
        while i < link_flags.len() {
            if link_flags.unsafe_get(i) == 32 { break }
            i++
        }
        tok := link_flags.substr(start, i - start)
        if tok.starts_with("-l") {
            lib := tok.substr(2, tok.len() - 2)
            if lib.len() > 0 {
                soname := format("lib", lib, so_ext)
                ffi_load_global_lib(soname)
            }
        } else if tok.ends_with(".a") {
            ffi_load_archive_twin(tok)
        }
    }
}

priv ffi_init_user_so := proc(fwd_path: Str, user_c_path: Str, ext_c_path: Str, link_flags: Str, mut so_path_out: Str) returns I32 {
    so_path_out = Str(c_str = bits_word(0), count = 0, cap = 0)
    if user_c_path.len() == 0 { return 0 }

    dot_str := "."
    slash := ext_c_path.rfind("/")
    mut ext_dir := dot_str
    if slash >= 0 {
        ext_dir = ext_c_path.substr(0, slash.to_usize())
    }

    so_path_out = format("tmp/ffi_", process_id().to_str(), ".so")
    _mk := mkdir_p("tmp")

    lf := link_flags.clone()
    // #299: match the interpreter's own sanitizer. Under bin/til_asan the user
    // .so must be ASAN-instrumented too, so its libc allocator IS the ASAN
    // allocator -- otherwise an interpreter-side calloc that libffi routes to
    // this .so's (non-ASAN) calloc returns brk-heap memory that the
    // interpreter's ASAN free() then rejects as a bad-free.
    mut san := ""
    if til_built_with_asan() { san = " -fsanitize=address -fno-omit-frame-pointer" }
    // -fsigned-char: same plain-char-is-signed contract as every other
    // til compile (see ext.h's I8 note; issue #25).
    cmd := format("cc -Wall -Wextra -fsigned-char -shared -fPIC", san, " -I", ext_dir,
        " -include ", fwd_path,
        " -o ", so_path_out,
        " ", user_c_path, lf)
    rc := system_cmd(cmd)
    if rc != 0 {
        eprint_single(format("error: failed to compile FFI library '", user_c_path, "'\n"))
        return 1
    }
    if ffi_open_user_so(so_path_out).not() {
        eprint_single(format("error: dlopen failed for '", so_path_out, "': ", ffi_last_error(), "\n"))
        return 1
    }
    return 0
}

priv ffi_init_struct_defs := func(program: Expr, mut ctx: Context) {
    ctx.ffi.struct_defs = Map(Str, ExprPtrBox).new()
    ffi_init_struct_defs_append(program, ctx)
}

// Append struct defs found in program into ctx.ffi.struct_defs (does not reset).
ffi_init_struct_defs_append := func(program: Expr, mut ctx: Context) {
    for stmt : Expr in program.children {
        if stmt.node_type.is(NodeType.Decl).not().or(stmt.children.len().eq(0)) {
            continue
        }
        ref sdef : Expr = stmt.children[0]
        if sdef.node_type.is(NodeType.StructDef).not() {
            continue
        }
        switch stmt.node_type {
        case .Decl(dd):
            key := Str(c_str = dd.name.c_str, count = dd.name.count, cap = CAP_VIEW)
            box := ExprPtrBox(ptr = sdef)
            ctx.ffi.struct_defs.set(key, own box)
        case:
        }
    }
}

// Width-driven libffi type for an unsigned primitive name: the single
// mapping through unsigned_prim_width_for_name, so USize/UPtr at any
// per-build width (and future ones) pick the matching ffi type or fail
// loudly instead of silently defaulting to uint64.
priv unsigned_ffi_type_for_name := func(name: Str) returns ref ffi_type {
    w := unsigned_prim_width_for_name(name)
    if w == U16.size() { return ffi_type_ref("ffi_type_uint16") }
    if w == U32.size() { return ffi_type_ref("ffi_type_uint32") }
    if w == U64.size() { return ffi_type_ref("ffi_type_uint64") }
    panic("unsigned_ffi_type_for_name: no ffi type for ", w.to_str(), "-byte '", name, "'")
    return ffi_type_ref("ffi_type_uint64")
}

priv uptr_ffi_type := func(ctx: Context) returns ref ffi_type {
    return unsigned_ffi_type_for_name(resolve_type_alias(ctx.scope, "UPtr", ctx.symbols))
}

priv usize_ffi_type := func(ctx: Context) returns ref ffi_type {
    return unsigned_ffi_type_for_name(resolve_type_alias(ctx.scope, "USize", ctx.symbols))
}

priv narrow_bool_arg := proc(mut s: Scope, mut e: Expr, mut ctx: Context) returns Bool {
    return eval_bool_arg(s, e, ctx)
}

priv eval_i64_arg := proc(mut s: Scope, mut e: Expr, mut ctx: Context) returns I64 {
    mut info := raw_result_info_new()
    raw : Dynamic = eval_scalar_arg_word_info(s, e, info, ctx)
    return raw_to_i64(raw_result_source_type(info), raw, ctx)
}

priv eval_u64_arg := proc(mut s: Scope, mut e: Expr, mut ctx: Context) returns U64 {
    mut info := raw_result_info_new()
    raw : Dynamic = eval_scalar_arg_word_info(s, e, info, ctx)
    return raw_to_u64(raw_result_source_type(info), raw, ctx)
}

// Dispatch and call results are raw value bytes.
priv dispatch_enum_size := func(name: Str, ctx: Context) returns USize {
    mut size : USize = ctx_total_size(name, ctx)
    if size < 8 { size = 8 }
    ref enum_def : Expr = lookup_interp_type_def(name, ctx).unwrap()
    switch enum_def.node_type {
    case .EnumDef(ed):
        for i in 0..ed.variants.len() {
            payload_type := enum_variant_type(enum_def, i.to_i32())
            if payload_type.len() > 0 {
                // #320: a `ref` payload stores a bare POINTER, not the
                // pointee, so it must be sized at pointer width. Sizing it
                // by the pointee overflows the enum's real slot -- masked
                // whenever the pointee happens to be <= 8 bytes, exposed by
                // a self-referential Option(ref T) field (a 16-byte enum
                // sized as 8 + sizeof(T)).
                if enum_is_niche(enum_def) { return UPtr.size() }
                mut payload_w : USize = UPtr.size()
                if enum_variant_payload_ref(enum_def, i.to_i32()).not() {
                    payload_w = container_elem_size(payload_type, ctx)
                }
                payload_end : USize = ENUM_PAYLOAD_OFFSET + payload_w
                if size < payload_end { size = payload_end }
            }
        }
    case:
        panic("dispatch enum type is not registered: ", name)
    }
    return size
}

// #361: a boxed scalar always gets at least a WORD of storage, however
// narrow the type is. A value crossing into a Dynamic slot is copied at
// Dynamic's width -- `adopt(T, dest, own src)` with T = Dynamic memcpy's
// T.size() from the box -- and every word-based reader here (scalar_word_load,
// the prim->Dynamic coerce) assumes the same. Sized at the type's own width, a
// Bool box was 1 byte and an I32 box 4, so that copy read past the end of the
// allocation: harmless in practice, since malloc's smallest chunk is far
// larger, but real UB that ASAN reports the moment such a value reaches a
// container of Dynamic. The slack bytes are never interpreted -- readers load
// at the value's own width.
dispatch_result_alloc := func(t: Type, ctx: Context) returns Dynamic {
    mut size : USize = 0
    switch t {
    case .None:
        size = 1
    case .Primitive(prim):
        mut align : USize = 0
        builtin_primitive_size_align(prim, size, align)
        if size < Dynamic.size() { size = Dynamic.size() }
    case .Struct(name):
        size = ctx_total_size(name, ctx)
    case .StructSym(s_sym):
        size = ctx_total_size(ctx.symbols.resolve(s_sym), ctx)
    case .Enum(name):
        size = dispatch_enum_size(name, ctx)
    case .EnumSym(e_sym):
        size = dispatch_enum_size(ctx.symbols.resolve(e_sym), ctx)
    case .Dynamic, .FuncPtr, .FuncPtrSig, .FuncPtrSigSym, .Body:
        size = Dynamic.size()
    case .Custom(name):
        return dispatch_result_alloc(type_from_name_init_name(name, ctx.scope, ctx.symbols), ctx)
    case .CustomSym(csym):
        return dispatch_result_alloc(type_from_sym_init(csym, ctx.scope, ctx.symbols), ctx)
    case:
        panic("cannot allocate dispatch result for type ", til_type_name_c(t))
    }
    mut raw : Dynamic = EvalHeap.heap_alloc(size)
    memset(raw, 0, size)
    return raw
}

priv dispatch_write_str := func(mut result: Dynamic, data: Dynamic, len: USize, ctx: Context) {
    if len == 0 {
        write_ptr(result, "".c_str)
        str_write_count_cap(result, 0, CAP_LIT, ctx)
        return
    }
    mut copy : Dynamic = EvalHeap.heap_alloc(len.add(1))
    memcpy(copy, data, len)
    memset(ptr_add(copy, len), 0, 1)
    write_ptr(result, copy)
    str_write_count_cap(result, len, len, ctx)
}

// and/or are core_lazy_funcs: the handler drives argument evaluation, so
// laziness is direct -- the second operand is only evaluated when the first
// does not already decide the result. (Parse-time calls were spliced to
// matches by the loader; what dispatches here are residual calls, e.g. the
// desugarer's synthesized chains under the interpreter.)
priv h_Bool_and := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    av := narrow_bool_arg(s, e.children[1], ctx)
    if av.not() {
        write_bool(r, false)
        return true
    }
    write_bool(r, narrow_bool_arg(s, e.children[2], ctx))
    return true
}

priv h_Bool_or := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    av := narrow_bool_arg(s, e.children[1], ctx)
    if av {
        write_bool(r, true)
        return true
    }
    write_bool(r, narrow_bool_arg(s, e.children[2], ctx))
    return true
}

priv h_Bool_not := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    bv := narrow_bool_arg(s, e.children[1], ctx)
    write_bool(r, not(bv))
    return true
}

// Bool.eq core_func handler (dispatch name is the flat "Bool_eq"): a
// core_func is not FFI-registered, so the interpreter evaluates it here.
// The inner .eq() is itself the core_func, lowered inline in this compiled
// handler -- no handler recursion.
priv h_Bool_eq := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    av := narrow_bool_arg(s, e.children[1], ctx)
    bv := narrow_bool_arg(s, e.children[2], ctx)
    write_bool(r, av.eq(bv))
    return true
}

priv h_U8_from_i64 := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    write_u8(r, eval_i64_arg(s, e.children[1], ctx).to_u8())
    return true
}

priv h_I16_from_i64 := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    write_i16(r, eval_i64_arg(s, e.children[1], ctx).to_i16())
    return true
}

priv h_U16_from_i64 := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    write_u16(r, eval_i64_arg(s, e.children[1], ctx).to_u16())
    return true
}

priv h_I32_from_i64 := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    write_i32(r, eval_i64_arg(s, e.children[1], ctx).to_i32())
    return true
}

priv h_F32_from_i64 := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    write_f32(r, eval_i64_arg(s, e.children[1], ctx).to_f32())
    return true
}

priv h_U32_from_i64 := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    write_u32(r, eval_i64_arg(s, e.children[1], ctx).to_u32())
    return true
}

// Issue #212: integer reinterpret or same-signedness widening cast. The
// typer set this FCall's til_type to the target type T; read the operand's
// raw bits and write them at the target width.
priv h_cast := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    ref mut src_expr : Expr = e.children[1]
    mut src_info := raw_result_info_new()
    mut src : Dynamic = eval_expr_raw_info(s, src_expr, ctx, src_info)
    tn := til_type_name_c(e.til_type())
    if (tn == "Fn").or(tn == "Body") {
        ref stored_ref : Dynamic = deref(src)
        mut stored : Dynamic = stored_ref
        if raw_result_source_type(src_info).is(Type.Dynamic) {
            stored = callable_storage_clone(stored)
        } else {
            write_ptr(src, bits_word(0))
        }
        write_ptr(r, stored)
        raw_result_drop(src_expr.til_type(), src, src_info.is_ref, ctx)
        return true
    }
    ref src_type : Type = raw_result_source_type(src_info)
    // Collapse the eval to an inline word first: raw_to_u64 is word-based,
    // and the pre-word raw_arg_pointer form fed it an ADDRESS.
    raw := raw_to_u64(src_type, scalar_word_of_raw(src, src_info.is_ref, src_info.is_word, src_type, ctx), ctx)
    switch tn {
    case "I8":  write_i8(r, raw.cast(I64).to_i8()); return true
    case "U8":  write_u8(r, raw.cast(I64).to_u8()); return true
    case "I16": write_i16(r, raw.cast(I64).to_i16()); return true
    case "U16": write_u16(r, raw.cast(I64).to_u16()); return true
    case "I32": write_i32(r, raw.to_i32()); return true
    case "U32": write_u32(r, raw.to_u32()); return true
    case "I64": write_i64(r, raw.cast(I64)); return true
    case "U64": write_u64(r, raw); return true
    case: UNREACHABLE("unexpected scalar type name '", tn, "'")
    }
    return false
}

priv h_print_single := proc(mut s: Scope, mut e: Expr, _r: Dynamic, mut ctx: Context) returns Bool {
    arg := eval_str_owned(s, e.children[1], ctx)
    // A const-fold eval is speculative and must emit no program output: if a
    // fold candidate reaches a print (e.g. through panic's message on a
    // failure branch the comptime inputs hit), swallow it. The fold itself is
    // abandoned via the abort in h_exit and the call is left for runtime.
    if ctx.eval.constfold_active.not() { print_single(arg) }
    return true
}

priv h_print_flush := proc(_s: Scope, _e: Expr, _r: Dynamic, ctx: Context) returns Bool {
    if ctx.eval.constfold_active.not() { print_flush() }
    return true
}

priv h_exit := proc(mut s: Scope, mut e: Expr, _r: Dynamic, mut ctx: Context) returns Bool {
    // exit is the single primitive that terminates the process, so it is the
    // single interception point for the const-folder. When a fold eval reaches
    // it (panic/TODO/UNREACHABLE all route here, as does a bare exit), don't
    // kill the build: set eval_aborted and unwind like an early return
    // (propagated through eval_body/eval_while). try_eval_call then leaves the
    // call for runtime, or reports it for a macro. No name list required.
    if ctx.eval.constfold_active {
        ctx.eval.eval_aborted = true
        return true
    }
    code := eval_i64_arg(s, e.children[1], ctx)
    // A REPL session takes the same road for a FAILING exit. panic / TODO /
    // UNREACHABLE / assert all end in exit(1) after printing their message, so
    // before this one typo -- or an uncaught throw, or an out-of-bounds index
    // -- terminated the whole process and threw away every binding the user
    // had built up. The message is already on the captured stream; unwinding
    // drops the turn and prompts again. exit(0) still terminates: that is a
    // deliberate quit, not a failure.
    if ctx.eval.repl_session.and(code.neq(0)) {
        ctx.eval.eval_aborted = true
        return true
    }
    exit(code)
    return true
}

priv h_spawn_cmd := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    cmd := eval_str_owned(s, e.children[1], ctx)
    write_i64(r, spawn_cmd(cmd))
    return true
}

priv h_dyn_has_method := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    type_name := eval_str_owned(s, e.children[1], ctx)
    method := eval_str_owned(s, e.children[2], ctx)
    // A METHOD, not any namespace member: the ns_get arm said yes for a
    // value one too (`limit : I64 = 7`), and the only thing a caller does
    // with a yes is indirect it -- dyn_fn, which cannot. ns_func_def asks
    // the runtime slot for its FuncDef (None for a value binding) and
    // falls through to the static member table, so it covers exactly the
    // two homes a method can have. DynHashMap.new_type_name is the real
    // caller: it asks whether the key type has `hash`, and a type whose
    // `hash` is a constant used to pass the check and die inside dyn_fn
    // instead of throwing its own MissingMethod.
    write_bool(r, ns_func_def(type_name, method, ctx).is_some())
    return true
}

priv h_dyn_fn := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    type_name := eval_str_owned(s, e.children[1], ctx)
    method := eval_str_owned(s, e.children[2], ctx)
    stored_o := ns_get(type_name, method, ctx)
    if stored_o.is_some() {
        if ns_func_def(type_name, method, ctx).is_none() {
            interp_error(e, format("dyn_fn: no method ", type_name, ".", method), ctx)
            exit(1)
        }
        write_ptr(r, callable_storage_clone(deref(stored_o.unwrap())))
        return true
    }
    static_o := static_ns_func_def(type_name, method, ctx)
    if static_o.is_none() {
        interp_error(e, format("dyn_fn: no method ", type_name, ".", method), ctx)
        exit(1)
    }
    write_ptr(r, static_o.unwrap())
    return true
}

priv h_dyn_size_of := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    // Resolve width aliases: USize/UPtr name a per-build primitive and have
    // no size() of their own, so dyn_size_of("USize") used to die with
    // "USize has no size() method" while every concrete name worked.
    type_name := resolve_type_alias(ctx.scope, eval_str_owned(s, e.children[1], ctx), ctx.symbols).clone()
    mut sz : USize = 8
    if type_name_is_callable_storage(type_name, ctx).not() {
        // The emitted dispatcher is one `if (name == T) return sizeof(T);`
        // per known type and says "dyn_size_of: unknown type T" when it
        // runs off the end. Say the same here instead of get_elem_size's
        // "T has no size() method", which is about a different question
        // and left the two backends wording the same miss differently.
        if ns_func_def(type_name, "size", ctx).is_none() {
            interp_error(e, format("dyn_size_of: unknown type ", type_name), ctx)
            exit(1)
        }
        sz = get_elem_size(s, type_name, e, ctx)
    }
    // The result is a USize, so it must be written at the TARGET USize
    // width -- one arm per width rather than a 4-else-8 assumption, and a
    // loud failure for a width with no writer yet.
    tw := ctx.target_usize_bytes
    switch tw {
    case 2: write_u16(r, sz.to_i64().to_u16())
    case 4: write_u32(r, sz.to_u32())
    case 8: write_u64(r, sz.to_u64())
    case: panic("h_dyn_size_of: no writer for a ", tw.to_str(), "-byte USize")
    }
    return true
}

// The caller's Expr comes in so an unknown name is reported the way the
// emitted dispatcher reports it -- same text, at the call site -- rather
// than as a panic naming the line of interpreter.til that noticed.
priv storage_kind_for_type_name := proc(type_name: Str, src: Expr, ctx: Context) returns USize {
    resolved := type_from_name_init_name(type_name, ctx.scope, ctx.symbols)
    if is_primitive(resolved).or(resolved.is(Type.Dynamic)) { return ELEM_POD }
    if type_is_callable_storage(resolved) { return ELEM_FN }
    if is_struct_type(resolved).or(is_enum_type(resolved)) { return ELEM_BOXED }
    tdef_o := lookup_interp_type_def(type_name, ctx)
    if tdef_o.is_some() {
        ref tdef : Expr = tdef_o.unwrap()
        if tdef.node_type.is(NodeType.FuncDef) {
            if tdef.children.len() == 0 { return ELEM_FN }
        }
    }
    interp_error(src, format("dyn_storage_kind: unknown type ", type_name), ctx)
    exit(1)
    return ELEM_POD
}

priv h_dyn_storage_kind := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    type_name := eval_str_owned(s, e.children[1], ctx)
    kind := storage_kind_for_type_name(type_name, e, ctx)
    tw := ctx.target_usize_bytes
    switch tw {
    case 2: write_u16(r, kind.to_i64().to_u16())
    case 4: write_u32(r, kind.to_u32())
    case 8: write_u64(r, kind.to_u64())
    case: panic("h_dyn_storage_kind: no writer for a ", tw.to_str(), "-byte USize")
    }
    return true
}

// Write an owned raw Str copying `src`'s bytes. Used by the
// struct_field_* handlers: a borrowed view into the AST does not survive
// being stored into a Declaration field and pushed into a Vec (the
// header is copied but the bytes must outlive the AST borrow), so the
// introspection primitives hand back owned copies. Issue #56/#58.
str_copy_into := func(mut result: Dynamic, src: Str, ctx: Context) {
    n := src.count
    if n == 0 {
        // A normalized empty Str uses CAP_LIT and no owned buffer.
        dispatch_write_str(result, src.c_str, 0, ctx)
        return
    }
    mut buf : I8 = malloc(n.add(1))
    memcpy(buf, src.c_str, n)
    ref mut term : U8 = ptr_add(buf, n)
    term = 0
    write_ptr(result, buf)
    str_write_count_cap(result, n, n, ctx)
}

priv eval_str_owned := proc(mut s: Scope, mut arg: Expr, mut ctx: Context) returns Str {
    mut info := raw_result_info_new()
    mut raw : Dynamic = eval_expr_raw_info(s, arg, ctx, info)
    value_raw : Dynamic = raw_arg_pointer(raw, info, ctx)
    ref value : Str = to_ptr(value_raw)
    view := Str(c_str = value.c_str, count = str_count_at(value_raw, ctx), cap = CAP_VIEW)
    result := view.clone()
    raw_result_drop(arg.til_type(), raw, info.is_ref, ctx)
    return result
}

// Look up a registered struct type's AST node by name, erroring out if
// the name is unknown or not a struct. Shared by the struct_field_*
// introspection handlers (issue #56/#58).
// "That type is not here" is the answer to two different questions, and a
// reflection caller cannot tell them apart from the name alone: the name may
// be nobody's type, or it may be a real type the sweep took because nothing
// kept it. The second is the one that surprises, and it is invisible -- the
// program mentions the type, just not in a way rooting can see (the literal
// is what roots it; a name computed at runtime cannot be). Both backends say
// the same two lines.
priv interp_reflect_type_not_found := proc(e: Expr, who: Str, type_name: Str, ctx: Context) {
    interp_error(e, format(who, ": type '", type_name, "' not found"), ctx)
    println("  note: unknown type, or dropped as unused -- reflection keeps a type when its name is a literal here, or the type is used elsewhere")
}

// The out-of-range twin, worded exactly as the emitted dispatcher words it
// (type and index both named) so the two backends read the same.
priv interp_reflect_index_out_of_range := proc(e: Expr, who: Str, type_name: Str, idx: USize, ctx: Context) {
    interp_error(e, format(who, ": type '", type_name, "' index ", idx.to_str(), " out of range"), ctx)
}

priv interp_lookup_struct := proc(mut s: Scope, e: Expr, type_name: Str, who: Str, ctx: Context) returns ref Expr {
    // A miss means `who` asked to introspect a type name with no registered
    // def -- a not-found error. The name is a RUNTIME string, so it can also
    // name an ordinary value (`struct_field_count("x")` with `x := 5`): that
    // binding carries no def (hb_func_def), and is reported as "not a struct"
    // rather than being read as one.
    hb_o := scope_lookup_heap_binding(s, type_name)
    if hb_o.is_none() {
        interp_reflect_type_not_found(e, who, type_name, ctx)
        exit(1)
    }
    node_o := hb_func_def(hb_o.unwrap())
    mut is_struct := false
    if node_o.is_some() { is_struct = node_o.unwrap().node_type.is(NodeType.StructDef) }
    if is_struct.not() {
        interp_error(e, format(who, ": '", type_name, "' is not a struct"), ctx)
        exit(1)
    }
    return node_o.unwrap()
}

priv h_struct_field_count := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    type_name := eval_str_owned(s, e.children[1], ctx)
    ref node : Expr = interp_lookup_struct(s, e, type_name, "struct_field_count", ctx)
    ref sd : StructDef = structdef_of(node)
    write_i64(r, sd.fields.len().to_i64())
    return true
}

// Decode e.children[2] (the index argument shared by every struct_field_*
// / enum_variant_* / func_sig_* handler) as a USize. The arg is a
// til-side integer value (commonly an I64 literal); take the low 32
// bits as the slot index.
priv eval_index_arg := proc(mut s: Scope, mut e: Expr, mut ctx: Context) returns USize {
    return eval_u64_arg(s, e.children[2], ctx).to_u32()
}

priv h_struct_field_name := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    type_name := eval_str_owned(s, e.children[1], ctx)
    idx := eval_index_arg(s, e, ctx)
    ref node : Expr = interp_lookup_struct(s, e, type_name, "struct_field_name", ctx)
    ref sd : StructDef = structdef_of(node)
    if idx >= sd.fields.len() {
        interp_reflect_index_out_of_range(e, "struct_field_name", type_name, idx, ctx)
        exit(1)
    }
    str_copy_into(r, sd.field_name_at(idx), ctx)
    return true
}

priv h_struct_field_is_mut := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    type_name := eval_str_owned(s, e.children[1], ctx)
    idx := eval_index_arg(s, e, ctx)
    ref node : Expr = interp_lookup_struct(s, e, type_name, "struct_field_is_mut", ctx)
    ref sd : StructDef = structdef_of(node)
    if idx >= sd.fields.len() {
        interp_reflect_index_out_of_range(e, "struct_field_is_mut", type_name, idx, ctx)
        exit(1)
    }
    ref fd : Declaration = sd.field_at(idx)
    if fd.is_mut { write_i64(r, 1) } else { write_i64(r, 0) }
    return true
}

priv h_struct_field_type := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    type_name := eval_str_owned(s, e.children[1], ctx)
    idx := eval_index_arg(s, e, ctx)
    ref node : Expr = interp_lookup_struct(s, e, type_name, "struct_field_type", ctx)
    ref sd : StructDef = structdef_of(node)
    if idx >= sd.fields.len() {
        interp_reflect_index_out_of_range(e, "struct_field_type", type_name, idx, ctx)
        exit(1)
    }
    ref fd : Declaration = sd.field_at(idx)
    str_copy_into(r, decl_type_name(fd, ctx.symbols), ctx)
    return true
}

// Look up a registered enum type's AST node by name, erroring out if
// the name is unknown or not an enum. Shared by the enum_variant_*
// introspection handlers (issue #57/#58).
priv interp_lookup_enum := proc(mut s: Scope, e: Expr, type_name: Str, who: Str, ctx: Context) returns ref Expr {
    // Same runtime-string exposure as interp_lookup_struct: a name that is
    // bound to a value carries no def, and is reported as "not an enum".
    hb_o := scope_lookup_heap_binding(s, type_name)
    if hb_o.is_none() {
        interp_reflect_type_not_found(e, who, type_name, ctx)
        exit(1)
    }
    node_o := hb_func_def(hb_o.unwrap())
    mut is_enum := false
    if node_o.is_some() { is_enum = node_o.unwrap().node_type.is(NodeType.EnumDef) }
    if is_enum.not() {
        interp_error(e, format(who, ": '", type_name, "' is not an enum"), ctx)
        exit(1)
    }
    return node_o.unwrap()
}

priv h_enum_variant_count := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    type_name := eval_str_owned(s, e.children[1], ctx)
    ref node : Expr = interp_lookup_enum(s, e, type_name, "enum_variant_count", ctx)
    ref ed : EnumDef = enumdef_of(node)
    write_i64(r, ed.variants.len().to_i64())
    return true
}

priv h_enum_variant_name := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    type_name := eval_str_owned(s, e.children[1], ctx)
    idx := eval_index_arg(s, e, ctx)
    ref node : Expr = interp_lookup_enum(s, e, type_name, "enum_variant_name", ctx)
    ref ed : EnumDef = enumdef_of(node)
    if idx >= ed.variants.len() {
        interp_reflect_index_out_of_range(e, "enum_variant_name", type_name, idx, ctx)
        exit(1)
    }
    ref vd : VariantDef = ed.variants[idx]
    str_copy_into(r, vd.name, ctx)
    return true
}

