priv h_cfile_open := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    path := eval_str_owned(s, e.children[1], ctx)
    is_write := narrow_bool_arg(s, e.children[2], ctx)
    // FILE* handle: closed via cfile_close (fclose), never free()'d,
    // so it is a borrowed view from the runtime's perspective.
    write_ptr(r, cfile_open(path, is_write))
    return true
}

// til primitive/struct type name -> ffi_type, or NULL when `type_name`
// is neither a known primitive nor a registered struct.  Shared by
// shallow_ffi_type and field_ffi_type, which differ only in the
// fallback they pick for an unknown type.
priv known_ffi_type := func(type_name: Str, mut ctx: Context) returns Option(ref ffi_type) {
    switch type_name {
    case "I64":   return safe_ref(ffi_type_ref("ffi_type_sint64"))
    case "U8":    return safe_ref(ffi_type_ref("ffi_type_uint8"))
    case "I8":    return safe_ref(ffi_type_ref("ffi_type_sint8"))
    case "I16":   return safe_ref(ffi_type_ref("ffi_type_sint16"))
    case "U16":   return safe_ref(ffi_type_ref("ffi_type_uint16"))
    case "I32":   return safe_ref(ffi_type_ref("ffi_type_sint32"))
    case "U32":   return safe_ref(ffi_type_ref("ffi_type_uint32"))
    case "U64":   return safe_ref(ffi_type_ref("ffi_type_uint64"))
    case "USize": return safe_ref(usize_ffi_type(ctx))
    case "UPtr":  return safe_ref(uptr_ffi_type(ctx))
    case "F32":   return safe_ref(ffi_type_ref("ffi_type_float"))
    case "F64":   return safe_ref(ffi_type_ref("ffi_type_double"))
    case "Bool":  return safe_ref(ffi_type_ref("ffi_type_uint8"))
    // Dynamic IS the opaque pointer type. Its reflection def in
    // src/core/dyn.til is a zero-field `Dynamic : StructDef = struct`,
    // which the struct probe below would turn into a size-0 by-value
    // struct ffi_type (FFI_BAD_TYPEDEF at prep); the first
    // `shallow Dynamic` ext signatures (#286's word helpers) hit that
    // and broke the arm CI hosts.
    case "Dynamic": return safe_ref(ffi_type_ref("ffi_type_pointer"))
    case:
    }
    if ctx.ffi.struct_defs.has(type_name) {
        ref box : ExprPtrBox = ctx.ffi.struct_defs[type_name]
        return safe_ref(build_struct_ffi_type(box.ptr, ctx))
    }
    return Option(ref ffi_type).None
}

// type_name -> ffi_type. Inverse mapping in ffi_shallow_type_info; keep
// the two in sync if a new shallow primitive type lands.  Unknown
// types are passed as opaque pointers.
priv shallow_ffi_type := func(type_name: Str, mut ctx: Context) returns ref ffi_type {
    t_o := known_ffi_type(type_name, ctx)
    if t_o.is_some() { return t_o.unwrap() }
    return ffi_type_ref("ffi_type_pointer")
}

priv field_ffi_type := func(dd: Declaration, mut ctx: Context) returns ref ffi_type {
    if dd.own_type.is(OwnType.Shallow).not() { return ffi_type_ref("ffi_type_pointer") }
    if dd.til_type.is(Type.Unknown) { return ffi_type_ref("ffi_type_sint64") }
    t_o := known_ffi_type(decl_type_name(dd, ctx.symbols), ctx)
    if t_o.is_some() { return t_o.unwrap() }
    return ffi_type_ref("ffi_type_sint64")
}

priv build_struct_ffi_type := func(struct_def: Expr, mut ctx: Context) returns ref ffi_type {
    if ctx.ffi.type_cache_inited.not() {
        ctx.ffi.type_cache = Vec(FFITypePtrBox).new()
        ctx.ffi.type_cache_inited = true
    }
    switch struct_def.node_type {
    case .StructDef(bsf_sdd):
        nfields := bsf_sdd.fields.len()
        mut elements : Dynamic = malloc(nfields.add(1) * Dynamic.size())
        mut i : USize = 0
        for fd : Declaration in bsf_sdd.fields {
            ref ft : ffi_type = field_ffi_type(fd, ctx)
            // The elements array holds ffi_type POINTERS; the old memcpy
            // copied the pointed struct's first 8 bytes (its size field)
            // instead, so libffi walked (ffi_type*)1-style garbage.
            write_ptr(ptr_add(elements, i * Dynamic.size()), ft)
            i = i + 1
        }
        memset(ptr_add(elements, nfields * Dynamic.size()), 0, Dynamic.size())
        mut st : ffi_type = malloc(ffi_type.size())
        // Zero before any field assign: st's fields are OWNED now, so an
        // assign drains the old value -- on unzeroed malloc garbage that is
        // free(<garbage>), a heap corruption. Zeroed, the drain sees null
        // and no-ops.
        memset(st, 0, ffi_type.size())
        st.size = 0
        st.alignment = 0
        st.type = FFI_TYPE_STRUCT.to_u16()
        st.elements = elements
        box := FFITypePtrBox(ptr = st)
        ctx.ffi.type_cache.push(own box)
        ref cached : FFITypePtrBox = ctx.ffi.type_cache[ctx.ffi.type_cache.len() - 1]
        return cached.ptr
    case:
        panic(__LOC__, "build_struct_ffi_type: node is not a StructDef")
    }
}

priv h_free := proc(mut s: Scope, mut e: Expr, _r: Dynamic, mut ctx: Context) returns Bool {
    switch e.children[1].node_type {
    case .Ident(ident):
        hb_o := scope_lookup_heap_binding(s, ident.ident_name(ctx.symbols.names))
        if hb_o.is_none() { panic("free binding not found: ", ident.ident_name(ctx.symbols.names)) }
        ref hb : HeapBinding = hb_o.unwrap()
        if hb.moved_out { panic("free of moved binding: ", ident.ident_name(ctx.symbols.names)) }
        heap_data : Dynamic = hb.ptr
        if hb_type(hb).is(Type.Dynamic).and(hb.is_erased_dynamic.not()) {
            ref pointed : Dynamic = deref(heap_data)
            if pointed.is_null().not() {
                mut owned_pointed : Dynamic = pointed
                EvalHeap.heap_free(own owned_pointed)
            }
            mut owned_slot : Dynamic = heap_data
            EvalHeap.heap_free(own owned_slot)
        } else {
            mut owned_heap_data : Dynamic = heap_data
            EvalHeap.heap_free(own owned_heap_data)
        }
    case:
        ref mut arg : Expr = e.children[1]
        mut info := raw_result_info_new()
        mut raw : Dynamic = eval_expr_raw_info(s, arg, ctx, info)
        ptr : Dynamic = raw_arg_pointer(raw, info, ctx)
        if ptr.is_null().not() {
            mut owned_ptr : Dynamic = ptr
            EvalHeap.heap_free(own owned_ptr)
        }
        raw_result_drop(arg.til_type(), raw, info.is_ref, ctx)
    }
    return true
}

priv h_til_closure_delete := proc(mut s: Scope, mut e: Expr, _r: Dynamic, mut ctx: Context) returns Bool {
    switch e.children[1].node_type {
    case .Ident(id):
        mut hb_o := scope_lookup_heap_binding(s, id.ident_name(ctx.symbols.names))
        if hb_o.is_none() { panic("til_closure_delete: non-callable ", id.ident_name(ctx.symbols.names)) }
        ref mut hb : HeapBinding = hb_o.unwrap()
        if hb_type(hb).is(Type.Dynamic).and(hb.is_erased_dynamic.not()) {
            if hb.moved_out.not() {
                ref mut stored : Dynamic = deref(hb.ptr)
                if stored.is_null().not() { callable_storage_free(stored) }
                mut owned_slot : Dynamic = hb.ptr
                EvalHeap.heap_free(own owned_slot)
                hb.ptr = bits_word(0)
                hb.moved_out = true
            }
            return true
        }
        if heap_type_is_callable(hb_type(hb)).not() { panic("til_closure_delete: non-callable ", id.ident_name(ctx.symbols.names)) }
        if hb.moved_out.not() {
            ref mut heap_data : Dynamic = to_ptr(hb.ptr)
            if hb.is_borrowed.not() {
                heap_drop_by_type(hb_type(hb), heap_data, hb.ctx)
                mut owned_heap_data : Dynamic = heap_data
                EvalHeap.heap_free(own owned_heap_data)
            }
            hb.ptr = bits_word(0)
            hb.moved_out = true
        }
    case .FieldAccess(fa):
        if e.children[1].children.len().gt(0) {
            ref obj_expr : Expr = e.children[1].children[0]
            switch obj_expr.node_type {
            case .Ident:
                mut base_o := resolve_field_assign_base(s, obj_expr, ctx.symbols)
                if base_o.is_some() {
                    ref mut base : Dynamic = base_o.unwrap()
                    sdef_o := resolve_field_assign_sdef(s, obj_expr, ctx)
                    if sdef_o.is_some() {
                        ref sdef : Expr = sdef_o.unwrap()
                        sname := resolve_field_assign_sname(s, obj_expr, ctx.symbols)
                        fdecl_o := find_field_decl(sdef, fa.field_access_name(ctx.symbols.names))
                        if fdecl_o.is_some() {
                            ref fdecl : Declaration = fdecl_o.unwrap()
                            if decl_is_funcsig(fdecl, ctx) {
                                ref fl : FieldLayout = ctx_field_layout(sname, fa.field_access_name(ctx.symbols.names), ctx)
                                ref mut slot : Dynamic = ptr_add(base, fl.offset.cast(U64))
                                ref mut stored : Dynamic = deref(slot)
                                if stored.is_null().not() { callable_storage_free(stored) }
                                write_ptr(slot, bits_word(0))
                                return true
                            }
                        }
                    }
                }
            case:
            }
        }
        ref mut arg : Expr = e.children[1]
        mut info := raw_result_info_new()
        mut raw : Dynamic = eval_expr_raw_info(s, arg, ctx, info)
        ref mut stored : Dynamic = deref(raw)
        if stored.is_null().not() { callable_storage_free(stored); write_ptr(raw, bits_word(0)) }
        raw_result_drop(arg.til_type(), raw, info.is_ref, ctx)
    case:
        ref mut arg : Expr = e.children[1]
        mut info := raw_result_info_new()
        mut raw : Dynamic = eval_expr_raw_info(s, arg, ctx, info)
        ref mut stored : Dynamic = deref(raw)
        if stored.is_null().not() { callable_storage_free(stored); write_ptr(raw, bits_word(0)) }
        raw_result_drop(arg.til_type(), raw, info.is_ref, ctx)
    }
    return true
}

priv h_til_closure_slot_delete := proc(mut s: Scope, mut e: Expr, _r: Dynamic, mut ctx: Context) returns Bool {
    ref mut arg : Expr = e.children[1]
    mut info := raw_result_info_new()
    mut raw : Dynamic = eval_expr_raw_info(s, arg, ctx, info)
    mut slot : Dynamic = raw_arg_pointer(raw, info, ctx)
    ref mut stored : Dynamic = deref(slot)
    if stored.is_null().not() {
        callable_storage_free(stored)
        write_ptr(slot, bits_word(0))
    }
    raw_result_drop(arg.til_type(), raw, info.is_ref, ctx)
    return true
}

priv h_til_closure_slot_clone := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    ref mut arg : Expr = e.children[1]
    mut info := raw_result_info_new()
    mut raw : Dynamic = eval_expr_raw_info(s, arg, ctx, info)
    slot : Dynamic = raw_arg_pointer(raw, info, ctx)
    mut holder : Dynamic = EvalHeap.heap_alloc(Dynamic.size())
    write_ptr(holder, callable_storage_clone(deref(slot)))
    write_ptr(r, holder)
    raw_result_drop(arg.til_type(), raw, info.is_ref, ctx)
    return true
}

priv h_til_closure_slot_pop := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    ref mut arg : Expr = e.children[1]
    mut info := raw_result_info_new()
    mut raw : Dynamic = eval_expr_raw_info(s, arg, ctx, info)
    mut slot : Dynamic = raw_arg_pointer(raw, info, ctx)
    write_ptr(r, deref(slot))
    write_ptr(slot, bits_word(0))
    raw_result_drop(arg.til_type(), raw, info.is_ref, ctx)
    return true
}

priv h_til_closure_slot_take := proc(mut s: Scope, mut e: Expr, _r: Dynamic, mut ctx: Context) returns Bool {
    ref mut slot_expr : Expr = e.children[1]
    mut slot_info := raw_result_info_new()
    mut slot_raw : Dynamic = eval_expr_raw_info(s, slot_expr, ctx, slot_info)
    mut dst : Dynamic = raw_arg_pointer(slot_raw, slot_info, ctx)
    ref source_expr : Expr = e.children[2]
    switch source_expr.node_type {
    case .Ident(id):
        mut source_hb_o := scope_lookup_heap_binding(s, id.ident_name(ctx.symbols.names))
        if source_hb_o.is_none() { panic("til_closure_slot_take: source binding not found: ", id.ident_name(ctx.symbols.names)) }
        ref mut source_hb : HeapBinding = source_hb_o.unwrap()
        if source_hb.moved_out { panic("til_closure_slot_take: source binding already moved: ", id.ident_name(ctx.symbols.names)) }
        if hb_type(source_hb).is(Type.Dynamic).not().or(source_hb.is_erased_dynamic) {
            panic("til_closure_slot_take: source is not an owned callable Dynamic: ", id.ident_name(ctx.symbols.names))
        }
        source_slot : Dynamic = source_hb.ptr
        ref stored : Dynamic = deref(source_slot)
        write_ptr(dst, stored)
        mut owned_source_slot : Dynamic = source_slot
        EvalHeap.heap_free(own owned_source_slot)
        source_hb.ptr = bits_word(0)
        source_hb.moved_out = true
    case:
        panic("til_closure_slot_take: callable source must be a binding")
    }
    raw_result_drop(slot_expr.til_type(), slot_raw, slot_info.is_ref, ctx)
    return true
}

priv h_cfile_close := proc(mut s: Scope, mut e: Expr, _r: Dynamic, mut ctx: Context) returns Bool {
    ref mut handle_expr : Expr = e.children[1]
    mut handle_info := raw_result_info_new()
    mut handle_raw : Dynamic = eval_expr_raw_info(s, handle_expr, ctx, handle_info)
    cfile_close(raw_arg_pointer(handle_raw, handle_info, ctx))
    raw_result_drop(handle_expr.til_type(), handle_raw, handle_info.is_ref, ctx)
    return true
}

priv h_cfile_write_str := proc(mut s: Scope, mut e: Expr, _r: Dynamic, mut ctx: Context) returns Bool {
    ref mut handle_expr : Expr = e.children[1]
    mut handle_info := raw_result_info_new()
    mut handle_raw : Dynamic = eval_expr_raw_info(s, handle_expr, ctx, handle_info)
    sv := eval_str_owned(s, e.children[2], ctx)
    cfile_write_str(raw_arg_pointer(handle_raw, handle_info, ctx), sv)
    raw_result_drop(handle_expr.til_type(), handle_raw, handle_info.is_ref, ctx)
    return true
}

priv h_ptr_add := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    ref mut buf_expr : Expr = e.children[1]
    mut buf_info := raw_result_info_new()
    mut buf_raw : Dynamic = eval_expr_raw_info(s, buf_expr, ctx, buf_info)
    write_ptr(r, ptr_add(raw_arg_pointer(buf_raw, buf_info, ctx), eval_u64_arg(s, e.children[2], ctx)))
    raw_result_drop(buf_expr.til_type(), buf_raw, buf_info.is_ref, ctx)
    return true
}

// is_null core_func handler: a core_func has no body to run and is not
// FFI-registered, so the interpreter evaluates p.is_null() here, testing the
// pointer value the raw arg represents -- exactly what the old
// `p.ptr_eq(NULL)` FFI marshalled. Testing a slot's own address instead would
// wrongly report a NULL-holding ref field as non-null (test/ref.til,
// test/aliases.til). The inner .is_null() is itself the core_func, lowered
// inline in this compiled handler -- no handler recursion.
priv h_is_null := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    ref mut arg : Expr = e.children[1]
    mut info := raw_result_info_new()
    mut raw : Dynamic = eval_expr_raw_info(s, arg, ctx, info)
    write_bool(r, raw_arg_pointer(raw, info, ctx).is_null())
    raw_result_drop(arg.til_type(), raw, info.is_ref, ctx)
    return true
}

// is_n core_func handler: the width-aware enum-tag compare (see dyn.til).
// Comparing the first `size` raw bytes with memcmp is equivalent to ext.c's
// width-switched typed compare: both read exactly the tag (offset 0,
// `size` = tag width in bytes) of each operand for equality.
priv h_is_n := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    ref mut ae : Expr = e.children[1]
    ref mut be : Expr = e.children[2]
    mut a_info := raw_result_info_new()
    mut a : Dynamic = eval_expr_raw_info(s, ae, ctx, a_info)
    switch be.node_type {
    case .FieldAccess(variant):
        mut fallback_enum_name := ""
        ref enum_name : Str = field_access_sname(be, fallback_enum_name, ctx.symbols)
        enum_def_o := lookup_interp_type_def(enum_name, ctx)
        if enum_def_o.is_some().and(enum_def_o.unwrap().node_type.is(NodeType.EnumDef)) {
            ref enum_def : Expr = enum_def_o.unwrap()
            write_bool(r, enum_data_tag_key(raw_arg_pointer(a, a_info, ctx), enum_def) == enum_variant_tag(enum_def, variant.field_access_name(ctx.symbols.names)))
            raw_result_drop(ae.til_type(), a, a_info.is_ref, ctx)
            return true
        }
    case .Ident(other_id):
        other_hb_o := scope_lookup_heap_binding(s, other_id.ident_name(ctx.symbols.names))
        if other_hb_o.is_some().and(other_hb_o.unwrap().is_static_callable) {
            ref other_hb : HeapBinding = other_hb_o.unwrap()
            ref other_raw : Dynamic = to_ptr(other_hb.ptr)
            ref other_def : Expr = callable_raw_func_def(other_raw)
            qn := namespace_func_qname(other_def, "", ctx)
            dot := qn.find(".")
            if dot > 0 {
                zero : USize = 0
                enum_name := qn.substr(zero, dot.to_usize())
                variant_start := dot.to_usize().add(1)
                variant_name := qn.substr(variant_start, qn.len().sub(variant_start))
                enum_def_o := lookup_interp_type_def(enum_name, ctx)
                if enum_def_o.is_some().and(enum_def_o.unwrap().node_type.is(NodeType.EnumDef)) {
                    ref enum_def : Expr = enum_def_o.unwrap()
                    write_bool(r, enum_data_tag_key(raw_arg_pointer(a, a_info, ctx), enum_def) == enum_variant_tag(enum_def, variant_name))
                    raw_result_drop(ae.til_type(), a, a_info.is_ref, ctx)
                    return true
                }
            }
        }
    case:
    }
    mut b_info := raw_result_info_new()
    mut b : Dynamic = eval_expr_raw_info(s, be, ctx, b_info)
    write_bool(r, memcmp(raw_arg_pointer(a, a_info, ctx), raw_arg_pointer(b, b_info, ctx), eval_u64_arg(s, e.children[3], ctx)) == 0)
    raw_result_drop(ae.til_type(), a, a_info.is_ref, ctx)
    raw_result_drop(be.til_type(), b, b_info.is_ref, ctx)
    return true
}

// For a FIELD-ACCESS get_payload argument (`get_payload(def.nt)`, the
// switch lowering's shape when the subject is an enum field), resolve
// the real enum storage inside the base struct: eval_expr_raw would return
// a detached COPY of the field, so a payload ref taken from it could
// not write back -- the parser mutates parsed defs exactly that way
// (`ref sdd : StructDef = structdef_of(def)` then sdd.push_field),
// and interpreted parses read back StructDefs with 0 fields. Returns
// the enum data buffer (tag at +0), or NULL when the shape doesn't
// match (non-Ident receiver, non-enum field), letting the caller fall
// back to the copying path.
priv get_payload_field_addr := func(mut s: Scope, arg: Expr, mut ctx: Context) returns Dynamic {
    if arg.node_type.is(NodeType.FieldAccess).not() { return bits_word(0) }
    if arg.children.len() != 1 { return bits_word(0) }
    mut fname := ""
    switch arg.node_type {
    case .FieldAccess(fan):
        fname = Str.clone(fan.field_access_name(ctx.symbols.names))
    case:
    }
    mut ns_fallback := ""
    ref ns_sname : Str = field_access_sname(arg, ns_fallback, ctx.symbols)
    ns_def_o := interp_fa_namespace_def_with_name(s, arg, ns_sname, ns_fallback.len() > 0, ctx)
    if ns_def_o.is_some() {
        ns_hb_o := scope_lookup_ns_binding(ns_scope(ctx), ns_sname, fname)
        if ns_hb_o.is_some() {
            ref ns_hb : HeapBinding = ns_hb_o.unwrap()
            switch hb_type(ns_hb) {
            case .Enum, .EnumSym: return to_ptr(ns_hb.ptr)
            case:
            }
        }
    }
    switch arg.children[0].node_type {
    case .Ident(base_id):
        hb_o := scope_lookup_heap_binding(s, base_id.ident_name(ctx.symbols.names))
        if hb_o.is_none() { return bits_word(0) }
        ref hb : HeapBinding = hb_o.unwrap()
        if is_struct_type(hb_type(hb)).not() { return bits_word(0) }
        {
            ref sname : Str = type_name_ref(hb_type(hb), ctx.symbols)
            ref data : Dynamic = to_ptr(hb.ptr)
            ref fl : FieldLayout = ctx_field_layout(sname, fname, ctx)
            if fl.is_enum.not() { return bits_word(0) }
            if fl.own_type.is(OwnType.Own).or(fl.own_type.is(OwnType.Ref)) {
                // Own/Ref enum fields store a pointer to the raw enum bytes.
                ref heap_enum : Dynamic = deref(ptr_add(data, fl.offset))
                if heap_enum.is_null() { return bits_word(0) }
                return ptr_add(heap_enum, 0)
            }
            // Shallow enum field: the tag+payload bytes live inline.
            return ptr_add(data, fl.offset)
        }
    case:
        return bits_word(0)
    }
}

// get_payload core_func handler: a core_func has no body to run and is not
// FFI-registered, so the interpreter evaluates the desugarer's payload
// accessor here. Bare get_payload calls are rejected by the typer (this
// handler included), so compute the address the way the interp already does
// for payload aliasing: the payload storage sits ENUM_PAYLOAD_OFFSET bytes
// past the tag (see the #211 payload-alias machinery).
priv h_get_payload := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    // #320 niche: the payload IS the whole value, at offset 0.
    mut gp_off : USize = ENUM_PAYLOAD_OFFSET
    mut gp_is_niche := false
    mut gp_def_o := Option(ref Expr).None
    gp_tname_o := expr_type_name_ref(e.children[1], ctx.symbols)
    if gp_tname_o.is_some() {
        ref gp_tname : Str = gp_tname_o.unwrap()
        gp_def_o = lookup_interp_type_def(gp_tname, ctx)
    }
    if gp_def_o.is_some() {
        ref gp_def : Expr = gp_def_o.unwrap()
        if gp_def.node_type.is(NodeType.EnumDef) {
            if enum_is_niche(gp_def) { gp_off = 0 gp_is_niche = true }
        }
    }
    fa_payload : Dynamic = get_payload_field_addr(s, e.children[1], ctx)
    if fa_payload.is_null().not() {
        // #321: for a niche the slot HOLDS the payload's address, so load it.
        if gp_is_niche { write_ptr(r, deref(fa_payload)) return true }
        write_ptr(r, ptr_add(fa_payload, gp_off))
        return true
    }
    ref mut arg : Expr = e.children[1]
    mut info := raw_result_info_new()
    mut raw : Dynamic = eval_expr_raw_info(s, arg, ctx, info)
    if gp_is_niche { write_ptr(r, deref(raw_arg_pointer(raw, info, ctx))) return true }
    write_ptr(r, ptr_add(raw_arg_pointer(raw, info, ctx), gp_off))
    raw_result_drop(arg.til_type(), raw, info.is_ref, ctx)
    return true
}

priv h_cfile_read_all := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    ref mut handle_expr : Expr = e.children[1]
    mut handle_info := raw_result_info_new()
    mut handle_raw : Dynamic = eval_expr_raw_info(s, handle_expr, ctx, handle_info)
    content := cfile_read_all(raw_arg_pointer(handle_raw, handle_info, ctx))
    raw_result_drop(handle_expr.til_type(), handle_raw, handle_info.is_ref, ctx)
    dispatch_write_str(r, content.c_str, content.count, ctx)
    return true
}

priv h_cfile_open_update := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    path := eval_str_owned(s, e.children[1], ctx)
    // FILE* is closed via cfile_close (fclose), never free()'d here.
    write_ptr(r, cfile_open_update(path))
    return true
}

priv h_cfile_open_append := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    path := eval_str_owned(s, e.children[1], ctx)
    // FILE* is closed via cfile_close (fclose), never free()'d here.
    write_ptr(r, cfile_open_append(path))
    return true
}

priv h_cfile_exists := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    path := eval_str_owned(s, e.children[1], ctx)
    write_bool(r, cfile_exists(path))
    return true
}

priv h_cfile_tell := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    ref mut handle_expr : Expr = e.children[1]
    mut handle_info := raw_result_info_new()
    mut handle_raw : Dynamic = eval_expr_raw_info(s, handle_expr, ctx, handle_info)
    write_i64(r, cfile_tell(raw_arg_pointer(handle_raw, handle_info, ctx)))
    raw_result_drop(handle_expr.til_type(), handle_raw, handle_info.is_ref, ctx)
    return true
}

priv h_cfile_seek := proc(mut s: Scope, mut e: Expr, _r: Dynamic, mut ctx: Context) returns Bool {
    ref mut handle_expr : Expr = e.children[1]
    mut handle_info := raw_result_info_new()
    mut handle_raw : Dynamic = eval_expr_raw_info(s, handle_expr, ctx, handle_info)
    cfile_seek(raw_arg_pointer(handle_raw, handle_info, ctx), eval_u64_arg(s, e.children[2], ctx).cast(I64))
    raw_result_drop(handle_expr.til_type(), handle_raw, handle_info.is_ref, ctx)
    return true
}

