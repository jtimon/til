priv ext_dispatch_builtin := func(name: Str, scope: Scope, e: Expr, result: Dynamic, ctx: Context) returns Bool {
    ref dm : Map(Str, Dynamic) = ctx.ffi.dispatch_map
    if dm.has(name) {
        ref slot : Dynamic = dm[name]
        ref fp : DispatchFn = to_ptr(slot)
        return fp(scope, e, result, ctx)
    }
    return false
}

priv h_dyn_call := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    type_name := eval_str_owned(s, e.children[1], ctx)
    method := eval_str_owned(s, e.children[2], ctx)

    // Build fake AST: Type.method(args...)
    mut type_ident := Expr.new(ident_node(ctx.symbols.intern(type_name)), e.line, e.col)
    type_ident.set_til_type(Type.Struct(type_name.clone()))

    mut field_access := Expr.new(field_access_node(ctx.symbols.intern(method)), e.line, e.col)
    field_access.add_child(own type_ident)
    // Critical: NodeType.FCall must have an initialized FCallData payload.
    mut fake_call := Expr.new(NodeType.FCall(FCallData()), e.line, e.col)
    fake_call.set_til_type(e.til_type())
    fake_call.add_child(own field_access)
    mark_fcall_direct(fake_call)

    // child 3 is arity literal, actual args start at child 4
    ref arity_expr : Expr = e.children[3]
    mut nargs : USize = 0
    switch arity_expr.node_type {
    case .Literal(Literal.Num(arity_str)): nargs = arity_str.literal_num_text().to_u32()
    case:
        UNREACHABLE("expected LiteralNum, got ", arity_expr.node_type.head_str(ctx.symbols.names))
    }
    // #275: `delete` takes the SAME fake-call path as every other method.
    // It used to short-circuit here -- heap_drop_by_type + heap_free plus a
    // hand-rolled field-slot null -- which reimplemented the destructor
    // instead of interpreting it: a user-defined delete with any behaviour
    // beyond releasing fields never ran (the compiled backend runs it), and
    // dropping the fields here AND in the body double-freed. Memory
    // management is the AST's job; this path only dispatches.
    for ai in 0..nargs {
        fake_call.push_child_clone(e.children[ai + 4])
    }

    mut call_info := raw_result_info_new()
    ref result_type : Type = e.til_type()
    raw : Dynamic = eval_call_info(s, fake_call, result_type, ctx, call_info)
    raw_result_move_into(result_type, r, raw, call_info.is_ref, ctx)
    return true
}

priv get_elem_size := proc(mut s: Scope, type_name: Str, src: Expr, mut ctx: Context) returns USize {
    if ns_func_def(type_name, "size", ctx).is_none() {
        interp_error(src, format(type_name, " has no size() method"), ctx)
        exit(1)
    }
    // Build fake call: Type.size()
    mut type_ident := Expr.new(ident_node(ctx.symbols.intern(type_name)), src.line, src.col)
    type_ident.set_til_type(Type.Struct(type_name.clone()))

    mut field_access := Expr.new(field_access_node(ctx.symbols.intern("size")), src.line, src.col)
    field_access.add_child(own type_ident)

    // Critical: NodeType.FCall must have an initialized FCallData payload.
    mut fake_call := Expr.new(NodeType.FCall(FCallData()), src.line, src.col)
    fake_call.set_til_type(type_from_name_init_name("USize", ctx.scope, ctx.symbols))
    fake_call.add_child(own field_access)
    mark_fcall_direct(fake_call)

    mut result : Dynamic = eval_call(s, fake_call, ctx)
    // A prim-stamped call result is an inline word (canonical
    // zero-extended, so one decode covers both USize widths).
    size := word_bits(result).to_usize()
    raw_result_drop(fake_call.til_type(), result, false, ctx)
    return size
}

priv enum_method_dispatch := proc(method: Str, mut scope: Scope, enum_def: Expr, enum_name: Str, mut e: Expr, mut result: Dynamic, mut ctx: Context) returns Bool {
    if method == "is" {
        switch e.children[2].node_type {
        case .FieldAccess(variant):
            ref mut subject : Expr = e.children[1]
            mut subject_info := raw_result_info_new()
            mut subject_raw : Dynamic = eval_expr_raw_info(scope, subject, ctx, subject_info)
            write_bool(result, enum_data_tag_key(raw_arg_pointer(subject_raw, subject_info, ctx), enum_def) == enum_variant_tag(enum_def, variant.field_access_name(ctx.symbols.names)))
            raw_result_drop(subject.til_type(), subject_raw, subject_info.is_ref, ctx)
            return true
        case:
        }
    }
    if enum_has_payloads(enum_def) {
        ctor_tag := enum_variant_tag(enum_def, method)
        // Payload lookup is index-keyed; construction needs the tag VALUE --
        // keep both distinct.
        ctor_idx := enum_variant_index(enum_def, method)
        if ctor_tag >= 0 {
            vtype := enum_variant_type(enum_def, ctor_idx)
            has_payload := vtype.len() > 0
            if has_payload.and(enum_variant_payload_ref(enum_def, ctor_idx)) {
                // #320: ref payload -- the payload word is the SOURCE's
                // address (a borrow): no clone, no move, no ownership.
                ref mut borrow_expr : Expr = e.children[1]
                mut borrow_info := raw_result_info_new()
                borrow_raw : Dynamic = eval_expr_raw_info(scope, borrow_expr, ctx, borrow_info)
                write_enum_flat(result, enum_name, ctor_tag, bits_word(0), 0, false, false, ctx)
                // #320 niche: the borrow IS the whole value (offset 0);
                // a tagged enum keeps it at the flat payload offset.
                mut borrow_off : USize = ENUM_PAYLOAD_OFFSET
                if enum_is_niche(enum_def) { borrow_off = 0 }
                write_ptr(ptr_add(result, borrow_off), raw_arg_pointer(borrow_raw, borrow_info, ctx))
                return true
            }
            if has_payload {
                ref mut payload_expr : Expr = e.children[1]
                mut pdata : Dynamic = 0
                mut pdata_is_ref := false
                payload_transfers := get_own_arg(e, 1)
                mut transferred_ident := false
                if payload_transfers {
                    switch payload_expr.node_type {
                    case .Ident(payload_id):
                        mut payload_hb_o := scope_lookup_heap_binding(scope, payload_id.ident_name(ctx.symbols.names))
                        if payload_hb_o.is_none() { panic("enum payload binding not found: ", payload_id.ident_name(ctx.symbols.names)) }
                        ref mut payload_hb : HeapBinding = payload_hb_o.unwrap()
                        if payload_hb.moved_out { panic("enum payload binding already moved: ", payload_id.ident_name(ctx.symbols.names)) }
                        ref mut payload_place : Dynamic = to_ptr(payload_hb.ptr)
                        if payload_hb.is_borrowed {
                            payload_size := raw_type_size(payload_expr.til_type(), ctx)
                            pdata = dispatch_result_alloc(payload_expr.til_type(), ctx)
                            adopt_from(pdata, payload_place, payload_size)
                        } else {
                            pdata = payload_place
                            payload_hb.ptr = bits_word(0)
                        }
                        payload_hb.moved_out = true
                        transferred_ident = true
                    case:
                    }
                }
                mut pdata_info := raw_result_info_new()
                if transferred_ident.not() {
                    pdata = eval_expr_raw_info(scope, payload_expr, ctx, pdata_info)
                    pdata_is_ref = pdata_info.is_ref
                }
                mut pdata_is_word := false
                if payload_transfers.not().and(pdata_is_ref) {
                    pdata = heap_clone_by_type(payload_expr.til_type(), pdata, ctx)
                } else if transferred_ident.not().and(pdata_info.is_word) {
                    // A scalar payload word: park it in a ring slot so the
                    // flat-enum writer has bytes to copy from.
                    pdata = word_ring_slot(payload_expr.til_type(), pdata, ctx)
                    pdata_is_word = true
                }
                psz := raw_type_size(payload_expr.til_type(), ctx)
                // #321: an OWNED payload of a niche enum is stored as the
                // POINTER, exactly like the borrowed one above -- what differs
                // is ownership, not layout. write_enum_flat only ZEROES a
                // niche slot (it expects the ctor to fill it, which until now
                // only the ref arm did), so write the payload box here, and do
                // NOT free it: the enum has adopted it.
                if enum_is_niche(enum_def) {
                    write_enum_flat(result, enum_name, ctor_tag, bits_word(0), 0, false, false, ctx)
                    write_ptr(result, pdata)
                    return true
                }
                write_enum_flat(result, enum_name, ctor_tag, pdata, psz, vtype == "Str", true, ctx)
                // write_enum_flat moved nested ownership into the enum bytes.
                if pdata_is_word { word_drop(own pdata) }
                else { EvalHeap.heap_free(own pdata) }
            } else {
                write_enum_flat(result, enum_name, ctor_tag, bits_word(0), 0, false, false, ctx)
            }
            return true
        }
    }
    return false
}

priv ffi_decode_scalar := func(rtype: Str, p: Dynamic, mut result: Dynamic, ctx: Context) returns Bool {
    switch rtype {
    case "I64": memcpy(result, p, I64.size()); return true
    case "U8":  memcpy(result, p, U8.size()); return true
    case "I8":  memcpy(result, p, I8.size()); return true
    case "I16": memcpy(result, p, I16.size()); return true
    case "U16": memcpy(result, p, U16.size()); return true
    case "I32": memcpy(result, p, I32.size()); return true
    case "U32": memcpy(result, p, U32.size()); return true
    case "U64": memcpy(result, p, U64.size()); return true
    case "USize":
        ref usize_name : Str = resolve_type_alias(ctx.scope, "USize", ctx.symbols)
        memcpy(result, p, unsigned_prim_width_for_name(usize_name))
        return true
    case "UPtr":
        ref uptr_name : Str = resolve_type_alias(ctx.scope, "UPtr", ctx.symbols)
        memcpy(result, p, unsigned_prim_width_for_name(uptr_name))
        return true
    case "F32":  memcpy(result, p, F32.size()); return true
    // U64.size(): F64 is 8 bytes, but `F64.size()` cannot be spelled here --
    // this file is compiled by the previous bootstrap compiler, which does
    // not know the F64 type yet. The bytes are the double's; only the width
    // matters to memcpy.
    case "F64":  memcpy(result, p, U64.size()); return true
    case "Bool": memcpy(result, p, Bool.size()); return true
    case:
    }
    return false
}

// Look up the StructDef Expr for fe's shallow-struct return type, or
// NULL if the return type isn't a known shallow struct.
priv ffi_call_ret_struct_def := func(fe: FFIEntry, ctx: Context) returns Option(ref Expr) {
    if fe.return_is_shallow.not() { return Option(ref Expr).None }
    if ffi_cif_rtype_is_struct(fe.cif).not() { return Option(ref Expr).None }
    if fe.return_type.is_none() { return Option(ref Expr).None }
    ref fe_rt : Str = fe.return_type.unwrap()
    if ctx.ffi.struct_defs.has(fe_rt).not() { return Option(ref Expr).None }
    ref box : ExprPtrBox = ctx.ffi.struct_defs[fe_rt]
    return safe_ref(box.ptr)
}

// ffi_type -> (type_name, size). Inverse mapping of shallow_ffi_type;
// keep the two in sync if a new shallow primitive type lands. Returns
// false for ffi_types that don't correspond to a primitive shallow
// value (struct/pointer/etc., caller falls back to the Ptr-default
// path). type_name identifies the primitive conversion to apply.
priv ffi_shallow_type_info := func(atype: Dynamic, mut type_name: Str, mut size: USize) returns Bool {
    if atype.ptr_eq(ffi_type_ref("ffi_type_sint64")) { type_name = "I64"; size = 8; return true }
    if atype.ptr_eq(ffi_type_ref("ffi_type_uint8"))  { type_name = "U8";  size = 1; return true }
    if atype.ptr_eq(ffi_type_ref("ffi_type_sint8"))  { type_name = "I8";  size = 1; return true }
    if atype.ptr_eq(ffi_type_ref("ffi_type_sint16")) { type_name = "I16"; size = 2; return true }
    if atype.ptr_eq(ffi_type_ref("ffi_type_uint16")) { type_name = "U16"; size = 2; return true }
    if atype.ptr_eq(ffi_type_ref("ffi_type_sint32")) { type_name = "I32"; size = 4; return true }
    if atype.ptr_eq(ffi_type_ref("ffi_type_uint32")) { type_name = "U32"; size = 4; return true }
    if atype.ptr_eq(ffi_type_ref("ffi_type_uint64")) { type_name = "U64"; size = 8; return true }
    if atype.ptr_eq(ffi_type_ref("ffi_type_float"))  { type_name = "F32"; size = 4; return true }
    if atype.ptr_eq(ffi_type_ref("ffi_type_double")) { type_name = "F64"; size = 8; return true }
    return false
}

// Write a shallow primitive arg into the FFI args buffer at `dst`.
priv ffi_write_shallow_arg := func(source: Dynamic, info: RawResultInfo, atype: Dynamic, mut dst: Dynamic, ctx: Context) returns Bool {
    mut tn := ""
    mut sz : USize = 0
    if ffi_shallow_type_info(atype, tn, sz).not() { return false }
    mut source_type := raw_result_source_type(info).clone()
    if source_type.is(Type.Dynamic) {
        source_type = type_from_name_init_name(tn, ctx.scope, ctx.symbols)
    }
    // `source` is an ADDRESS (raw_arg_pointer materializes words); load
    // the scalar into a word before decoding.
    if tn == "F32" {
        tmp : F32 = raw_to_f32(source_type, scalar_word_load(source_type, source, ctx), ctx)
        memcpy(dst, tmp, 4)
    } else if tn == "F64" {
        // The scalar word IS the double's bits; copy them out verbatim.
        tmp : U64 = word_bits(scalar_word_load(source_type, source, ctx))
        memcpy(dst, tmp, 8)
    } else {
        tmp : U64 = raw_to_u64(source_type, scalar_word_load(source_type, source, ctx), ctx)
        memcpy(dst, tmp, sz)
    }
    return true
}

// #343: the interpreter's copy of the builder's ext-argument test, split so
// the cheap half runs first -- an ordinary FFI call with no `.c_str`
// argument at all (every DrawRectangle in a frame loop) never pays for the
// scope walk that resolves the binding's parameter list. A string-literal
// receiver is skipped for the reason the builder skips it: the literal IS
// the C string, terminator included.
priv interp_c_str_arg_shape := func(arg_expr: Expr, symbols: SymbolPool) returns Bool {
    switch arg_expr.node_type {
    case .FieldAccess(fname):
        if fname.field_access_name(symbols.names).eq("c_str").not() { return false }
        if arg_expr.children.len() == 0 { return false }
        return arg_expr.children[0].node_type.is_literal_str().not()
    case:
        return false
    }
}

priv interp_ext_c_string_param := func(mut scope: Scope, name: Str, arg_index: USize, symbols: SymbolPool) returns Bool {
    ref ext_slot : Dynamic = scope_get(scope, name)?
    catch (knf: KeyNotFound) { return false }
    ref ext_def : Expr = callable_raw_func_def(ext_slot)
    switch ext_def.node_type {
    case .FuncDef(fd):
        if arg_index >= fd.sig.params.len() { return false }
        ref p : Declaration = fd.sig.params[arg_index]
        if decl_type_name(p, symbols).eq("I8").not() { return false }
        return p.own_type.is(OwnType.Ref).and(p.is_mut.not())
    case:
        return false
    }
}

priv ext_dispatch_ffi := proc(name: Str, mut scope: Scope, mut e: Expr, mut result: Dynamic, mut ctx: Context) returns Bool {
    if ctx.ffi.loaded.not() { return false }
    if ctx.ffi.entries.has(name).not() { return false }

    ref mut fe : FFIEntry = ctx.ffi.entries[name]
    nargs := e.children.len() - 1
    mut alloc_n := nargs
    if alloc_n == 0 { alloc_n = 1 }
    // args[i] = void* for each arg, arg_ptrs[i] = &args[i]
    mut args : UPtr = malloc(alloc_n.mul(UPtr.size()))
    mut arg_ptrs : UPtr = malloc(alloc_n.mul(UPtr.size()))
    // Per-arg flag: true when args[i] holds a scalar box WE malloc'd on
    // the deep path below. No ext callee takes `own` scalars (the C side
    // only borrows these boxes), so they must be freed after ffi_call --
    // skipping that leaked one box per non-shallow scalar arg per call.
    boxed_flags : U8 = calloc(alloc_n, 1)
    // Keep each raw result alive until ffi_call finishes because arg_ptrs may
    // point directly into aggregate storage.
    mut arg_raws : UPtr = malloc(alloc_n.mul(UPtr.size()).mul(2))

    for i in 0..nargs {
        ref mut arg_expr : Expr = e.children[i + 1]
        mut arg_info := raw_result_info_new()
        if interp_c_str_arg_shape(arg_expr, ctx.symbols).and(interp_ext_c_string_param(scope, name, i, ctx.symbols)) {
            ctx.eval.interp_cstr_arg = true
        }
        arg_raw : Dynamic = eval_expr_raw_info(scope, arg_expr, ctx, arg_info)
        ctx.eval.interp_cstr_arg = false
        arg_pointer : Dynamic = raw_arg_pointer(arg_raw, arg_info, ctx)
        arg_raw_off := i.mul(16)
        write_ptr(ptr_add(arg_raws, arg_raw_off), arg_raw)
        write_bool(ptr_add(arg_raws, arg_raw_off.add(8)), arg_info.is_ref)
        write_bool(ptr_add(arg_raws, arg_raw_off.add(9)), arg_pointer.ptr_eq(arg_raw))
        arg_is_callable := heap_type_is_callable(raw_result_source_type(arg_info))
        mut is_shallow := fe.param_shallows.is_null().not()
        .and(i.lt(fe.nparam))
        if is_shallow {
            ref ps : Bool = ptr_add(fe.param_shallows, i)
            is_shallow = ps
        }
        if is_shallow {
            ref at : Dynamic = ptr_add(fe.arg_types, i.mul(8))
            ref atype : Dynamic = deref(at)
            ref ffi_arg_type : ffi_type = to_ptr(atype)
            if ffi_arg_type.type == FFI_TYPE_STRUCT.to_u16() {
                write_ptr(ptr_add(arg_ptrs, i.mul(8)), arg_pointer)
            } else {
                ref mut dst : Dynamic = ptr_add(args, i.mul(8))
                if ffi_write_shallow_arg(arg_pointer, arg_info, atype, dst, ctx).not() {
                    if arg_is_callable.and(callable_box_is(arg_pointer)) { panic("FFI cannot receive captured closures") }
                    write_ptr(dst, arg_pointer)
                }
                write_ptr(ptr_add(arg_ptrs, i.mul(8)), dst)
            }
        } else {
            // Deep: pass heap-allocated pointer (FFI callee may free it)
            mut dp : Dynamic = 0
            mut pass_pointer := arg_info.is_ref
            if i.lt(fe.nparam) {
                ref param_dynamic : Bool = ptr_add(fe.param_dynamics, i)
                if param_dynamic { pass_pointer = true }
            }
            switch arg_expr.node_type {
            case .Ident(arg_id):
                arg_hb_o := scope_lookup_heap_binding(scope, arg_id.ident_name(ctx.symbols.names))
                if arg_hb_o.is_none() { panic("FFI argument binding not found: ", arg_id.ident_name(ctx.symbols.names)) }
                ref arg_hb : HeapBinding = arg_hb_o.unwrap()
                if arg_hb.own_type.is(OwnType.Own) { pass_pointer = true }
            case:
            }
            if pass_pointer {
                if arg_is_callable.and(callable_box_is(arg_pointer)) { panic("FFI cannot receive captured closures") }
                write_ptr(ptr_add(args, i.mul(8)), arg_pointer)
            } else {
                switch raw_result_source_type(arg_info) {
                case .Primitive:
                    size := raw_type_size(raw_result_source_type(arg_info), ctx)
                    dp = malloc(size)
                    memcpy(dp, arg_pointer, size)
                case .CustomSym(ffi_csym):
                    alias_type_sym := type_from_sym_init(ffi_csym, ctx.scope, ctx.symbols)
                    switch alias_type_sym {
                    case .Primitive:
                        size := raw_type_size(alias_type_sym, ctx)
                        dp = malloc(size)
                        memcpy(dp, arg_pointer, size)
                    case:
                        if arg_is_callable.and(callable_box_is(arg_pointer)) { panic("FFI cannot receive captured closures") }
                        write_ptr(ptr_add(args, i.mul(8)), arg_pointer)
                    }
                case .Custom(name):
                    alias_type := type_from_name_init_name(name, ctx.scope, ctx.symbols)
                    switch alias_type {
                    case .Primitive:
                        size := raw_type_size(alias_type, ctx)
                        dp = malloc(size)
                        memcpy(dp, arg_pointer, size)
                    case:
                        if arg_is_callable.and(callable_box_is(arg_pointer)) { panic("FFI cannot receive captured closures") }
                        write_ptr(ptr_add(args, i.mul(8)), arg_pointer)
                    }
                case:
                    if arg_is_callable.and(callable_box_is(arg_pointer)) { panic("FFI cannot receive captured closures") }
                    write_ptr(ptr_add(args, i.mul(8)), arg_pointer)
                }
            }
            if dp.is_null().not() {
                write_ptr(ptr_add(args, i.mul(8)), dp)
                ref mut bf : Bool = ptr_add(boxed_flags, i)
                bf = true
            }
            write_ptr(ptr_add(arg_ptrs, i.mul(8)), ptr_add(args, i.mul(8)))
        }
    }

    // Check if return is a shallow struct
    ret_sdef_o := ffi_call_ret_struct_def(fe, ctx)

    // raw: 16-byte buffer for return value
    mut raw : Dynamic = calloc(1, 16)
    if ret_sdef_o.is_some() {
        ref ret_sdef : Expr = ret_sdef_o.unwrap()
        switch ret_sdef.node_type {
        case .StructDef:
            ffi_call(fe.cif, fe.fn, result, arg_ptrs)
        case:
            ffi_call(fe.cif, fe.fn, raw, arg_ptrs)
        }
    } else {
        ffi_call(fe.cif, fe.fn, raw, arg_ptrs)
    }

    // Decode return value
    if fe.return_type.is_none() {
    } else if ret_sdef_o.is_some() {
    } else if fe.return_is_shallow {
        if ffi_decode_scalar(fe.return_type.unwrap(), to_ptr(raw), result, ctx).not() {
            panic("unsupported shallow FFI return type: ", fe.return_type.unwrap())
        }
    } else {
        ref rtype : Str = fe.return_type.unwrap()
        ref raw_ptr : Dynamic = deref(raw)
        if rtype == "Str" {
            ref sp : ExtStr = raw_ptr
            // A `returns ref Str` borrows the C buffer; copy it into independent
            // owned raw Str storage.
            if fe.return_is_ref { dispatch_write_str(result, sp.data, sp.count, ctx) }
            else {
                // Adopt the ext_func's Str* contents into the raw result AT
                // THE TARGET LAYOUT: the C-side Str is host-layout, so copy
                // the buffer pointer and rewrite count/cap at the ctx width.
                // Preserve CAP_VIEW/CAP_LIT (they say whether the returned
                // c_str is owned; the sentinels survive width truncation),
                // else cap=count so typed teardown reclaims the c_str. The
                // old whole-struct memcpy fused the host count+cap pair into
                // the target count under --usize=64.
                write_ptr(result, sp.data)
                mut adopted_cap : USize = sp.count
                if sp.cap >= CAP_VIEW { adopted_cap = sp.cap }
                str_write_count_cap(result, sp.count, adopted_cap, ctx)
                mut owned_str_wrapper : Dynamic = raw_ptr
                EvalHeap.heap_free(own owned_str_wrapper)
            }
        } else if rtype == "Dynamic" {
            write_ptr(result, raw_ptr)
        } else if fe.return_is_ref {
            write_ptr(result, raw_ptr)
        } else if ffi_decode_scalar(rtype, raw_ptr, result, ctx) {
            // A non-shallow `returns <scalar>` (C signature `T *f(...)`) hands
            // back an OWNED malloc'd buffer holding the value. ffi_decode_scalar
            // copied the scalar into `result`, so the buffer is ours to reclaim
            // -- leaving it leaked one alloc per such call (sum_all / Pair_sum
            // return I64*). The compiled backend frees it too. A `returns ref`
            // scalar instead borrows a foreign pointer the runtime never
            // malloc'd (e.g. into a C array), so never free that one.
            if raw_ptr.is_null().not() {
                mut owned_ret : Dynamic = raw_ptr
                free(own owned_ret)
            }
        } else if ctx.ffi.struct_defs.has(fe.return_type.unwrap()) {
            // `returns ref T` hands back a borrowed pointer into foreign / C
            // memory; flag the wrapper borrowed so the garbager's deep delete
            // does not free a buffer the runtime never malloc'd (ext_libc:
            // getenv returns a pointer into libc's environ).
            if fe.return_is_ref {
                write_ptr(result, raw_ptr)
            } else {
                memcpy(result, raw_ptr, ctx_total_size(fe.return_type.unwrap(), ctx))
                mut owned_struct_wrapper : Dynamic = raw_ptr
                EvalHeap.heap_free(own owned_struct_wrapper)
            }
        } else {
            panic("unsupported FFI return type: ", fe.return_type.unwrap())
        }
    }
    for i in 0..nargs {
        ref bf : Bool = ptr_add(boxed_flags, i)
        if bf {
            mut box_ptr : Dynamic = 0
            box_ptr = deref(ptr_add(args, i.mul(8)))
            free(own box_ptr)
        }
    }
    for i in 0..nargs {
        ref arg_expr : Expr = e.children[i + 1]
        arg_raw_off := i.mul(16)
        ref arg_raw : Dynamic = deref(ptr_add(arg_raws, arg_raw_off))
        mut owned_arg_raw : Dynamic = arg_raw
        ref arg_is_ref : Bool = ptr_add(arg_raws, arg_raw_off.add(8))
        ref raw_was_passed : Bool = ptr_add(arg_raws, arg_raw_off.add(9))
        if (name == "memcpy").and(i == 1).and(arg_is_ref.not()).and(raw_was_passed) {
            // memcpy transferred the temporary aggregate's nested ownership.
            raw_block_free(owned_arg_raw)
        } else {
            raw_result_drop(arg_expr.til_type(), owned_arg_raw, arg_is_ref, ctx)
        }
    }
    free(own arg_raws)
    free(own boxed_flags)
    free(own args)
    free(own arg_ptrs)
    free(own raw)
    return true
}

// #288 Stage 4: native interpreter evaluation of the scalar primitive ISA.
// A scalar op call like `a.mul(b)` reaches ext_function_dispatch as the flat
// name "U32_mul". Rather than dlsym'ing the ext.c symbol (a slow libffi round
// trip) we compute the result directly on the operands' raw bytes, matching the
// exact C semantics in src/c/ext.c: modular wrapping at the type width and
// signed-vs-unsigned shifts. This is the interpreter half of the core_func
// ISA -- once src/core's scalar ops migrate ext_func -> core_func and their
// ext.c symbols are deleted, this is the ONLY path. It is already live for the
// ext_func ops, so the whole suite (interpret + both-mode compare) proves it
// matches ext.c. div/mod (zero-guarded), the to_* conversions, cmp and clone
// are NOT handled here and keep dispatching to their ext.c symbols.

// Category of a scalar type name: "u" unsigned int, "i" signed int, "f" F32;
// "" for anything that is not one of the nine numeric primitives.
priv scalar_op_cat := func(t: Str) returns Str {
    switch t {
    case "U8", "U16", "U32", "U64": return "u"
    case "I8", "I16", "I32", "I64": return "i"
    case "F32": return "f"
    case "F64": return "d"
    }
    return ""
}

priv scalar_is_binop := func(op: Str) returns Bool {
    switch op {
    case "add", "sub", "mul", "band", "bor", "bxor", "shl", "shr", "div", "mod": return true
    }
    return false
}

// Compute the binary op at U64 width (unsigned ops: the low bits are correct
// for every narrower unsigned type after truncation in scalar_build).
priv scalar_apply_u64 := func(op: Str, a: U64, b: U64) returns U64 {
    switch op {
    case "add": return a.add(b)
    case "sub": return a.sub(b)
    case "mul": return a.mul(b)
    case "band": return a.band(b)
    case "bor": return a.bor(b)
    case "bxor": return a.bxor(b)
    case "shl": return a.shl(b)
    case "shr": return a.shr(b)
    case "div": return a.div(b)
    case "mod": return a.mod(b)
    }
    panic(__LOC__, ": scalar_apply_u64: unhandled op ", op)
    return a
}

// Compute the binary op at I64 width (signed: arithmetic shr sign-extends;
// scalar_build truncates to the narrower signed type).
priv scalar_apply_i64 := func(op: Str, a: I64, b: I64) returns I64 {
    switch op {
    case "add": return a.add(b)
    case "sub": return a.sub(b)
    case "mul": return a.mul(b)
    case "band": return a.band(b)
    case "bor": return a.bor(b)
    case "bxor": return a.bxor(b)
    case "shl": return a.shl(b)
    case "shr": return a.shr(b)
    case "div": return a.div(b)
    case "mod": return a.mod(b)
    }
    panic(__LOC__, ": scalar_apply_i64: unhandled op ", op)
    return a
}

// F64 binop on U64 bit words (see the cat == "d" arms): dispatch the op
// name to the ext.c f64_bits_* helper that does the double math.
priv f64_bits_apply := func(op: Str, a: U64, b: U64) returns U64 {
    switch op {
    case "add": return f64_bits_add(a, b)
    case "sub": return f64_bits_sub(a, b)
    case "mul": return f64_bits_mul(a, b)
    case "div": return f64_bits_div(a, b)
    }
    panic("f64_bits_apply: unsupported F64 op '", op, "'")
    return 0
}

priv scalar_apply_f32 := func(op: Str, a: F32, b: F32) returns F32 {
    switch op {
    case "add": return a.add(b)
    case "sub": return a.sub(b)
    case "mul": return a.mul(b)
    case "div": return a.div(b)
    }
    panic(__LOC__, ": scalar_apply_f32: unhandled op ", op)
    return a
}

// True for the six comparison ops that return Bool (eq/neq + the four
// ordering ops). Separate from scalar_is_binop because these write Bool.
priv scalar_is_cmp := func(op: Str) returns Bool {
    switch op {
    case "eq", "neq", "lt", "gt", "lte", "gte": return true
    }
    return false
}

// Apply a comparison at U64 width (unsigned operands: eq/neq are bit-equal,
// the ordering ops use unsigned comparison).
priv scalar_cmp_u64 := func(op: Str, a: U64, b: U64) returns Bool {
    switch op {
    case "eq":  return a.eq(b)
    case "neq": return a.neq(b)
    case "lt":  return a.lt(b)
    case "gt":  return a.gt(b)
    case "lte": return a.lte(b)
    case "gte": return a.gte(b)
    }
    panic(__LOC__, ": scalar_cmp_u64: unhandled op ", op)
    return false
}

// Apply a comparison at I64 width (signed operands).
priv scalar_cmp_i64 := func(op: Str, a: I64, b: I64) returns Bool {
    switch op {
    case "eq":  return a.eq(b)
    case "neq": return a.neq(b)
    case "lt":  return a.lt(b)
    case "gt":  return a.gt(b)
    case "lte": return a.lte(b)
    case "gte": return a.gte(b)
    }
    panic(__LOC__, ": scalar_cmp_i64: unhandled op ", op)
    return false
}

// Apply a comparison on F32 operands.
priv scalar_cmp_f32 := func(op: Str, a: F32, b: F32) returns Bool {
    switch op {
    case "eq":  return a.eq(b)
    case "neq": return a.neq(b)
    case "lt":  return a.lt(b)
    case "gt":  return a.gt(b)
    case "lte": return a.lte(b)
    case "gte": return a.gte(b)
    }
    panic(__LOC__, ": scalar_cmp_f32: unhandled op ", op)
    return false
}

priv scalar_write_raw := func(t: Str, mut result: Dynamic, v: I64) {
    switch t {
    case "U8":  write_u8(result, v.to_u8())
    case "I8":  write_i8(result, v.to_i8())
    case "U16": write_u16(result, v.to_u16())
    case "I16": write_i16(result, v.to_i16())
    case "U32": write_u32(result, v.to_u32())
    case "I32": write_i32(result, v.to_i32())
    case "U64": write_u64(result, v.cast(U64))
    case "I64": write_i64(result, v)
    case:
        panic("cannot write raw scalar result for ", t)
    }
}

priv scalar_read_arg := proc(mut scope: Scope, mut arg: Expr, shallow target_type: Type, mut ctx: Context) returns Dynamic {
    mut info := raw_result_info_new()
    raw : Dynamic = eval_scalar_arg_word_info(scope, arg, info, ctx)
    return raw_coerce_value(raw, raw_result_source_type(info), target_type, ctx)
}

// Step a mut-local scalar in place by delta (+1 for inc, -1 for dec) -- the
// interp side of the inc/dec core_funcs. Reads the receiver's current scalar,
// adds delta, and writes the new value back into its binding. raw_to_i64 reads
// integer bytes bit-exactly; two's-complement add gives the correct wrap for
// both signednesses, and scalar_write_raw narrows to the receiver's type. The
// receiver is always a plain mut-local Ident (a range-loop counter from the
// `for x in a..b` desugaring, the only numeric inc/dec caller), so no ref-mut
// or payload-alias mirror is needed. A
// non-Ident receiver would be a compiler bug and fails loud.
priv scalar_step_cell := proc(mut scope: Scope, mut e: Expr, type_str: Str, delta: I64, mut ctx: Context) {
    ref mut arg : Expr = e.children[1]
    scalar_type := type_from_name_init_name(type_str, ctx.scope, ctx.symbols)
    cur : Dynamic = scalar_read_arg(scope, arg, scalar_type, ctx)
    nv := raw_to_i64(scalar_type, cur, ctx).add(delta)
    switch e.children[1].node_type {
    case .Ident(id):
        mut hb_o := scope_lookup_heap_binding(scope, id.ident_name(ctx.symbols.names))
        if hb_o.is_none() { panic(__LOC__, ": inc/dec target undefined: ", id.ident_name(ctx.symbols.names)) }
        ref hb : HeapBinding = hb_o.unwrap()
        if hb.moved_out { panic(__LOC__, ": inc/dec target moved: ", id.ident_name(ctx.symbols.names)) }
        ref mut heap_data : Dynamic = to_ptr(hb.ptr)
        if hb_type(hb).is(Type.Primitive).not() { panic(__LOC__, ": inc/dec target has non-primitive type: ", id.ident_name(ctx.symbols.names)) }
        scalar_write_raw(type_str, heap_data, nv)
    case:
        panic(__LOC__, ": inc/dec receiver is not an Ident")
    }
}

priv scalar_core_op_eval := proc(name: Str, mut scope: Scope, mut e: Expr, mut result: Dynamic, mut ctx: Context) returns Bool {
    // Cheap reject: every scalar primitive type name starts with U, I or F.
    // This skips the find/substr parse for the common non-scalar dispatch
    // names (Str_*, Vec_*, Map_*, ...) before any allocation.
    if name.len() == 0 { return false }
    ref c0 : I8 = name.unsafe_get(0)
    if (c0 == 'U').not().and((c0 == 'I').not()).and((c0 == 'F').not()) { return false }
    us := name.find("_")
    if us < 0 { return false }
    u_pos : USize = us.to_usize()
    zero : USize = 0
    type_str := name.substr(zero, u_pos)
    cat := scalar_op_cat(type_str)
    if cat == "" { return false }
    scalar_type := type_from_name_init_name(type_str, ctx.scope, ctx.symbols)
    op_start := u_pos.add(1)
    op_str := name.substr(op_start, name.len().sub(op_start))

    // eq/neq/lt/gt/lte/gte: binary comparison -> Bool. eq/neq are bit-equal
    // for both signednesses; the ordering ops use the category's signed,
    // unsigned, or float comparison.
    if scalar_is_cmp(op_str) {
        ref mut ae : Expr = e.children[1]
        ref mut be : Expr = e.children[2]
        av : Dynamic = scalar_read_arg(scope, ae, scalar_type, ctx)
        bv : Dynamic = scalar_read_arg(scope, be, scalar_type, ctx)
        mut cmp_result := false
        if cat == "u" { cmp_result = scalar_cmp_u64(op_str, raw_to_u64(scalar_type, av, ctx), raw_to_u64(scalar_type, bv, ctx)) }
        else if cat == "i" { cmp_result = scalar_cmp_i64(op_str, raw_to_i64(scalar_type, av, ctx), raw_to_i64(scalar_type, bv, ctx)) }
        else if cat == "d" {
            // F64 operands stay U64 bit words (this source predates the F64
            // type in its own bootstrap); ext.c compares the doubles and
            // returns the three-way sign, ordered like scalar_cmp_i64's input.
            cmp_result = scalar_cmp_i64(op_str, f64_bits_cmp(word_bits(av), word_bits(bv)), 0)
        }
        else { cmp_result = scalar_cmp_f32(op_str, raw_to_f32(scalar_type, av, ctx), raw_to_f32(scalar_type, bv, ctx)) }
        write_bool(result, cmp_result)
        return true
    }

    // bnot: unary bitwise complement (integer only -- F32 declares no bnot,
    // so the signed path is the unconditional tail, same shape as the cmp
    // arm; no dead cat guard).
    if op_str == "bnot" {
        ref mut arg : Expr = e.children[1]
        av : Dynamic = scalar_read_arg(scope, arg, scalar_type, ctx)
        if cat == "u" { scalar_write_raw(type_str, result, raw_to_u64(scalar_type, av, ctx).bnot().cast(I64)) }
        else { scalar_write_raw(type_str, result, raw_to_i64(scalar_type, av, ctx).bnot()) }
        return true
    }

    // inc/dec: the sole self-mutating core ops, one arm each (delta +1/-1);
    // scalar_step_cell holds the shared read-compute-writeback.
    if op_str == "inc" { scalar_step_cell(scope, e, type_str, 1, ctx); return true }
    if op_str == "dec" { scalar_step_cell(scope, e, type_str, -1, ctx); return true }

    if scalar_is_binop(op_str) {
        ref mut ae : Expr = e.children[1]
        ref mut be : Expr = e.children[2]
        av : Dynamic = scalar_read_arg(scope, ae, scalar_type, ctx)
        bv : Dynamic = scalar_read_arg(scope, be, scalar_type, ctx)
        if cat == "u" {
            scalar_write_raw(type_str, result, scalar_apply_u64(op_str, raw_to_u64(scalar_type, av, ctx), raw_to_u64(scalar_type, bv, ctx)).cast(I64))
            return true
        }
        if cat == "i" {
            scalar_write_raw(type_str, result, scalar_apply_i64(op_str, raw_to_i64(scalar_type, av, ctx), raw_to_i64(scalar_type, bv, ctx)))
            return true
        }
        if cat == "d" {
            // F64: same four ops as F32, computed on the U64 bit words in
            // ext.c; the result bits are written back at full width.
            if (op_str == "add").or(op_str == "sub").or(op_str == "mul").or(op_str == "div") {
                write_u64(result, f64_bits_apply(op_str, word_bits(av), word_bits(bv)))
                return true
            }
            return false
        }
        // cat == "f": only add/sub/mul/div exist on F32 (no bitwise/shift/mod).
        if (op_str == "add").or(op_str == "sub").or(op_str == "mul").or(op_str == "div") {
            write_f32(result, scalar_apply_f32(op_str, raw_to_f32(scalar_type, av, ctx), raw_to_f32(scalar_type, bv, ctx)))
            return true
        }
        return false
    }

    return false
}

// The auto-generated enum `is` core_funcs dispatch by their flat name
// ("NodeType_is", "Type_is", ...): strip the "_is" suffix, confirm the
// prefix is a registered enum, and compare the first tag-width bytes of
// each operand -- the same equality h_is_n computes (the tag sits at
// offset 0). Per-enum names cannot be reg_dispatch'd statically, hence
// the name-shape parse, mirroring scalar_core_op_eval's approach.
priv enum_core_is_eval := proc(name: Str, mut scope: Scope, mut e: Expr, mut result: Dynamic, mut ctx: Context) returns Bool {
    if name.ends_with("_is").not() { return false }
    if e.children.len() != 3 { return false }
    tlen := name.len().sub(3)
    type_str := name.substr(0, tlen)
    edef_o := lookup_interp_type_def(type_str, ctx)
    if edef_o.is_none() { return false }
    ref edef : Expr = edef_o.unwrap()
    if edef.node_type.is(NodeType.EnumDef).not() { return false }
    ref mut ae : Expr = e.children[1]
    ref mut be : Expr = e.children[2]
    mut a_info := raw_result_info_new()
    mut b_info := raw_result_info_new()
    mut a : Dynamic = eval_expr_raw_info(scope, ae, ctx, a_info)
    mut b : Dynamic = eval_expr_raw_info(scope, be, ctx, b_info)
    write_bool(result, memcmp(raw_arg_pointer(a, a_info, ctx), raw_arg_pointer(b, b_info, ctx), enum_tag_size(edef)) == 0)
    raw_result_drop(ae.til_type(), a, a_info.is_ref, ctx)
    raw_result_drop(be.til_type(), b, b_info.is_ref, ctx)
    return true
}

priv ext_function_dispatch := proc(name: Str, mut scope: Scope, mut e: Expr, mut result: Dynamic, mut ctx: Context) returns Bool {
    if ctx.ffi.dispatch_inited.not() { dispatch_init(ctx) }
    if ext_dispatch_builtin(name, scope, e, result, ctx) { return true }
    if scalar_core_op_eval(name, scope, e, result, ctx) { return true }
    if enum_core_is_eval(name, scope, e, result, ctx) { return true }
    return ext_dispatch_ffi(name, scope, e, result, ctx)
}
priv ffi_register := proc(name: Str, fn: Dynamic, fdef: Expr, mut ctx: Context) {
    ref fd : FunctionDef = funcdef_of(fdef)
    np := fd.sig.params.len()
    mut alloc_np := np
    if alloc_np == 0 { alloc_np = 1 }
    // Build ffi_type* array (each element is a pointer = 8 bytes)
    mut atypes : Dynamic = malloc(alloc_np.mul(8))
    pdynamics : Dynamic = calloc(alloc_np, 1)
    mut pshallows : Dynamic = 0
    mut has_shallow := false
    for k in 0..np {
        ref pk : Declaration = fd.sig.params[k]
        ref mut dynamic_slot : Bool = ptr_add(pdynamics, k)
        dynamic_slot = declaration_resolved_type(pk, ctx.scope, ctx.symbols).is(Type.Dynamic)
        if pk.own_type.is(OwnType.Shallow) {
            write_ptr(ptr_add(atypes, k.mul(8)), shallow_ffi_type(decl_type_name(pk, ctx.symbols), ctx))
            has_shallow = true
        } else {
            write_ptr(ptr_add(atypes, k.mul(8)), ffi_type_ref("ffi_type_pointer"))
        }
    }
    if has_shallow {
        pshallows = malloc(np)
        for k in 0..np {
            ref pk : Declaration = fd.sig.params[k]
            ref mut slot : Bool = ptr_add(pshallows, k)
            slot = pk.own_type.is(OwnType.Shallow)
        }
    }
    ret_shallow := fd.sig.return_own_type.is(OwnType.Shallow)
    mut cif : Dynamic = ffi_alloc_cif()

    // #324: resolve the return ffi_type and PREP before any of the four
    // allocations transfers into an entry -- the fields are `own` now, so
    // the failure path must free the locals while they are still the
    // owners, and constructing first would leave it holding moved names.
    mut ret_type_o := Option(ref Str).None
    if fd.sig.return_type.len() > 0 { ret_type_o = safe_ref(fd.sig.return_type) }
    ref mut rtype : Dynamic = ffi_type_ref("ffi_type_void")
    if ret_type_o.is_some() {
        if ret_shallow {
            rtype = to_ptr(shallow_ffi_type(ret_type_o.unwrap(), ctx))
        } else {
            rtype = to_ptr(ffi_type_ref("ffi_type_pointer"))
        }
    }
    ref mut prep_cif : ffi_cif = to_ptr(cif)
    prep_status := ffi_prep_cif(prep_cif, ffi_host_default_abi(), np.to_u32(), rtype, atypes)
    if prep_status.eq(FFI_OK).not() {
        // A failed prep leaves the cif garbage, so this entry must never
        // reach ffi_call -- but it must NOT take the program down either.
        // Registration walks EVERY ext decl a program imports, and libffi
        // rejects any signature passing a struct by value (no ffi_type
        // descriptor is built for those yet), which is 266 of raylib's 588
        // bindings. Panicking here meant merely importing the bindings --
        // what `mode gui` does -- killed the process on whichever
        // unsupported function came first, regardless of what the program
        // actually called.
        //
        // Drop the entry instead and leave the name unregistered. Calling
        // it then fails loudly at the call site (see ext_dispatch_ffi's
        // caller), naming the function the program actually used.
        // Same four allocations ffi_cleanup reclaims for a live entry.
        free(own pshallows)
        free(own pdynamics)
        free(own atypes)
        free(own cif)
        return
    }

    // Build the entry; the four allocations transfer into its `own` fields.
    // All four ride the CTOR call: an `own U8 = 0` field default would
    // otherwise materialize as a malloc'd one-byte box that the island's
    // raw field-writes overwrite without a drain -- 2 leaked bytes per
    // entry, found by ASAN the moment the fields stopped being `ref`.
    mut entry := FFIEntry(fn = fn, cif = cif, arg_types = atypes,
        param_shallows = pshallows, param_dynamics = pdynamics)
    entry.return_type = ret_type_o
    entry.nparam = np
    entry.return_is_shallow = ret_shallow
    entry.return_is_ref = fd.sig.return_own_type.is(OwnType.Ref)

    // Store in ctx.ffi.entries. Map.set borrows the key and deep-clones it
    // internally (ELEM_BOXED), so `name` can be passed directly; the
    // old clone+box dance here leaked both the box and the cloned Str.
    // The value box is a transient that Map.set consumes.
    // Re-registering a name overwrites its FFIEntry, but the entry's cif /
    // arg_types / parameter flags are `ref` raw C pointers Map.set's delete
    // does NOT reclaim. ffi_init_scan_program scans every import unit in a
    // loop and also descends into nested function bodies, so a name seen
    // twice orphaned the previous entry's libffi cif + arg-type array --
    // a translate-time leak ffi_cleanup never saw (the stale pointers had
    // already left the entries map). Free them first, exactly as ffi_cleanup does
    // for each live entry.
    // Re-registering a name overwrites its FFIEntry. Map.set's overwrite
    // path does NOT run the typed value delete, so drop the old entry
    // explicitly first: remove's value drop runs FFIEntry.delete, whose
    // `own` fields free the four raw allocations. The manual quad-free
    // this replaces was #324's hole (own-passing ref fields).
    if ctx.ffi.entries.has(name) { ctx.ffi.entries.remove(name) }
    mut val : FFIEntry = malloc(FFIEntry.size())
    // #275: the byte-move goes through core's `adopt_from` rather than a
    // hand-rolled memcpy+memset pair. Same two instructions, but it says
    // MOVE at the call site instead of leaving a bare copy of a managed
    // aggregate's bytes for a reader (or the typer) to have to prove safe.
    adopt_from(val, entry, FFIEntry.size())
    ctx.ffi.entries.set(name, own val)
}


ffi_init_scan_program := proc(program: Expr, mut ctx: Context) {
    if ctx.ffi.entries_inited.not() {
        ctx.ffi.entries = Map(Str, FFIEntry).new()
        ctx.ffi.entries_inited = true
    }
    for stmt : Expr in program.children {
        if stmt.node_type.is(NodeType.Decl).not() { }
        else if stmt.children.len() == 0 { }
        else {
            // Top-level ext_func/ext_proc
            if stmt.children[0].node_type.is(NodeType.FuncDef) {
                ref fdef : Expr = stmt.children[0]
                switch fdef.node_type {
                case .FuncDef(fd):
                    if fd.sig.func_type.is_ext() {
                        switch stmt.node_type {
                        case .Decl(dname):
                            ref fn_ptr : U8 = ffi_dlsym(dname.name)
                            if fn_ptr.is_null().not() {
                                ffi_register(dname.name, fn_ptr, fdef, ctx)
                            }
                        case:
                        }
                    }
                case:
                }
            }
            // Struct namespace ext_func/ext_proc
            if stmt.children[0].node_type.is(NodeType.StructDef) {
                ref sdd : Declaration = decl_of(stmt)
                ref sdd_data : StructDef = structdef_of(stmt.children[0])
                mut fni : USize = 0
                for fdd : Declaration in sdd_data.ns_decls {
                    cur_ni := fni
                    fni = fni + 1
                    if fdd.default_value.is_none() { continue }
                    ref fdef : Expr = fdd.default_expr()
                    mut fd_func_type := FuncType.Func
                    switch fdef.node_type {
                    case .FuncDef(fd):
                        fd_func_type = fd.sig.func_type
                    case:
                        continue
                    }
                    if fd_func_type.is_ext() {
                        flat_name := sdd.name.concat3("_", sdd_data.member_name_at(cur_ni))
                        ref fn_ptr : U8 = ffi_dlsym(flat_name)
                        if fn_ptr.is_null().not() {
                            ffi_register(flat_name, fn_ptr, fdef, ctx)
                        }
                    } else if fd_func_type.is_plain() {
                        // Scan function body for nested ext_func/ext_proc.
                        // A bodyless namespace signature (interface
                        // method, issue #251) has no body to scan.
                        if fdef.children.len() == 0 { continue }
                        ref fbody : Expr = fdef.children[0]
                        for inner : Expr in fbody.children {
                            if inner.node_type.is(NodeType.Decl).and(inner.children.len().gt(0)) {
                                ref idef : Expr = inner.children[0]
                                switch idef.node_type {
                                case .FuncDef(ifd):
                                    if ifd.sig.func_type.is_ext() {
                                        ref iname : Declaration = decl_of(inner)
                                        ref ifn : U8 = ffi_dlsym(iname.name)
                                        if ifn.is_null().not() {
                                            ffi_register(iname.name, ifn, idef, ctx)
                                        }
                                    }
                                case:
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

priv ffi_init := proc(program: Expr, fwd_path: Str, user_c_path: Str, ext_c_path: Str, link_flags: Str, mut ctx: Context) returns I32 {
    if ctx.ffi.loaded {
        ffi_cleanup(ctx)
        ctx.ffi.entries_inited = false
    }
    mut so_path := ""
    if ffi_init_user_so(fwd_path, user_c_path, ext_c_path, link_flags, so_path).eq(0).not() {
        return 1
    }
    ffi_init_link_libs(link_flags)
    ffi_init_struct_defs(program, ctx)
    ffi_init_scan_program(program, ctx)
    ctx.ffi.loaded = true
    if so_path.len() > 0 { File.remove(so_path) }
    return 0
}
ffi_cleanup := proc(mut ctx: Context) {
    if ctx.ffi.loaded { ffi_close_user_so() }
    if ctx.ffi.entries_inited {
        // The reset's drain runs FFIEntry.delete per entry, whose `own`
        // fields free the four raw allocations -- the manual per-entry
        // quad-free this replaces was #324's hole and, with owned fields,
        // a double free (ASAN caught it via Map delete -> FFIEntry_delete).
        ctx.ffi.entries = Map(Str, FFIEntry).new()
        ctx.ffi.struct_defs = Map(Str, ExprPtrBox).new()
        ctx.ffi.entries_inited = false
    }
    ctx.ffi.loaded = false
    if ctx.ffi.type_cache_inited {
        // The reset's drain runs FFITypePtrBox.delete per entry, which owns
        // its descriptor, which owns its elements array -- the manual free
        // loop this replaces was #324's hole (own-passing ref fields).
        ctx.ffi.type_cache = Vec(FFITypePtrBox).new()
        ctx.ffi.type_cache_inited = false
    }
}
