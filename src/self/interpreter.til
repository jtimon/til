// Look up a registered FuncSig type's bodyless FuncDef node by name,
// erroring out if the name is unknown or not a function signature.
// Shared by the func_sig_* introspection handlers (issue #58).
priv interp_lookup_funcsig := proc(mut s: Scope, e: Expr, type_name: Str, who: Str, ctx: Context) returns ref Expr {
    // Same runtime-string exposure as interp_lookup_struct: a name that is
    // bound to a value carries no def, and is reported as "not a function
    // signature".
    hb_o := scope_lookup_heap_binding(s, type_name)
    if hb_o.is_none() {
        interp_reflect_type_not_found(e, who, type_name, ctx)
        exit(1)
    }
    node_o := hb_func_def(hb_o.unwrap())
    mut is_funcdef := false
    if node_o.is_some() { is_funcdef = node_o.unwrap().node_type.is(NodeType.FuncDef) }
    if is_funcdef.not() {
        interp_error(e, format(who, ": '", type_name, "' is not a function signature"), ctx)
        exit(1)
    }
    return node_o.unwrap()
}

// Throw lowering appends ABI-only `_err_kind` / payload parameters. Reflection
// exposes the source callable contract, not that synthetic tail.
priv interp_funcsig_param_count := func(fd: FunctionDef) returns USize {
    for i in 0..fd.sig.params.len() {
        if fd.sig.params[i].name == "_err_kind" { return i }
    }
    return fd.sig.params.len()
}

