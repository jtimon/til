priv h_cfile_read_n := proc(mut s: Scope, mut e: Expr, mut r: Dynamic, mut ctx: Context) returns Bool {
    ref mut handle_expr : Expr = e.children[1]
    mut handle_info := raw_result_info_new()
    mut handle_raw : Dynamic = eval_expr_raw_info(s, handle_expr, ctx, handle_info)
    content := cfile_read_n(raw_arg_pointer(handle_raw, handle_info, ctx), eval_u64_arg(s, e.children[2], ctx).cast(I64))
    raw_result_drop(handle_expr.til_type(), handle_raw, handle_info.is_ref, ctx)
    dispatch_write_str(r, content.c_str, content.count, ctx)
    return true
}

priv DispatchFn := proc(Scope, Expr, Dynamic, Context) returns Bool

priv reg_dispatch := func(name: Str, handler: DispatchFn, mut ctx: Context) {
    mut v : UPtr = malloc(UPtr.size())
    write_ptr(v, handler)
    ctx.ffi.dispatch_map.set(name, own v)
}

