mode lib
import("../loader")
import("../../std/file")

// Value/control-flow MLIR slice, with the Linux x86-64
// SysV ABI used by the C backend. Vector registers are not the public ABI.
priv MlirBinding := struct {
    value := ""
    type_name := ""
    is_mut := false
    is_signed := false
    is_ref := false
    is_stack := false
    is_local_ref := false
    is_dynamic := false
    reference_slot := ""
    owns_wrapper := false
    // Read-only AST identity. Mutable lexical bindings must not carry an AST
    // loan; resolution borrows the canonical declaration without copying it.
    native_definition_id : U64 = 0
}

priv MlirCallable := struct {
    path := ""
    source_path := ""
    declaration : USize = 0
    member : I64 = -1
    name := ""
    symbol := ""
    exported := false
}

priv MlirState := struct {
    text := ""
    allocations := ""
    globals := ""
    symbol_prefix := ""
    externals := Map(Str, Str).new()
    next : USize = 0
    next_block : USize = 0
    terminated := false
    break_label := ""
    continue_label := ""
    has_break := false
    values := Map(Str, MlirBinding).new()
    functions := Map(UPtr,MlirCallable).new()
    error_parameter := ""
    error_known_clear := false
    error_version : USize = 0
    clear_conditions := Set(Str).new()
    set_conditions := Set(Str).new()
    return_borrow := false
    // Compile-time values used by lane indices and lowered bounds-error checks.
    integers := Map(Str, U64).new()
    booleans := Map(Str, Bool).new()
}

priv mlir_f4_type := func() returns Str {
    return "!llvm.struct<(vector<2xf32>, vector<2xf32>)>"
}

priv mlir_resolve_call := func(e:Expr,state:MlirState,lp:LoadedProgram) returns Option(ref Expr) {
    switch e.children[0].node_type {
    case .Ident(id):
        ref name:Str=id.ident_name(lp.ctx.symbols.names)
        if state.values.has(name) {
            ref binding:MlirBinding=state.values[name]
            if binding.native_definition_id!=0 {
                ref definition:Expr=to_ptr(bits_word(binding.native_definition_id))
                return safe_ref(definition)
            }
        }
    case:
    }
    return resolve_direct_fcall(e,lp.ctx.scope,lp.ctx.symbols)
}

priv mlir_i4_type := func() returns Str { return "!llvm.struct<(i64, i64)>" }

priv mlir_vector := func(t: Str) returns Bool {
    return t.eq("vector<4xf32>").or(t.eq("vector<4xi32>")).or(t.eq("vector<4xi1>"))
}

priv mlir_vector_scalar := func(t: Str) returns Str {
    if t == "vector<4xf32>" { return "f32" }
    if t == "vector<4xi32>" { return "i32" }
    if t == "vector<4xi1>" { return "i1" }
    panic("unsupported MLIR vector type: ", t)
}

priv mlir_unsigned_vector := func(shallow t: Type, lp: LoadedProgram) returns Bool {
    ref definition : Expr = lp.ctx.scope.get_struct(type_name_ref(t, lp.ctx.symbols), lp.ctx.symbols).unwrap()
    return decl_type_name_ref(structdef_of(definition).fields[0], lp.ctx.symbols) == "U32"
}

priv mlir_type := func(shallow t: Type, lp: LoadedProgram) returns Str {
    switch t {
    case .Dynamic: return "!llvm.ptr"
    case .Primitive(p):
        switch p {
        case .Bool: return "i1"
        case .I8, .U8: return "i8"
        case .I16, .U16: return "i16"
        case .I32, .U32: return "i32"
        case .I64, .U64: return "i64"
        case .F64: return "f64"
        case:
        }
    case:
    }
    if t == Type.Primitive(Primitive.F32) { return "f32" }
    ref name : Str = type_name_ref(t, lp.ctx.symbols)
    if name == "Dynamic" { return "!llvm.ptr" }
    if mlir_array_element(t,lp).is(Type.None).not() { return "!llvm.ptr" }
    if name == "Str" { return format("!llvm.struct<(!llvm.ptr, ", mlir_count_type(lp), ", ", mlir_count_type(lp), ")>") }
    if name == "Array__Str" { return format("!llvm.struct<(!llvm.ptr, ", mlir_count_type(lp), ")>") }
    if name == "F32" { return "f32" }
    if name == "F64" { return "f64" }
    if t.is(Type.None) { return "void" }
    definition := lp.ctx.scope.get_struct(name, lp.ctx.symbols)
    if definition.is_some() {
        if definition.unwrap().node_type.is(NodeType.StructDef) {
            ref sd : StructDef = structdef_of(definition.unwrap())
            if sd.simd_width == 4 {
                if decl_type_name_ref(sd.fields[0], lp.ctx.symbols) == "F32" { return "vector<4xf32>" }
                if decl_type_name_ref(sd.fields[0], lp.ctx.symbols) == "Bool" { return "vector<4xi1>" }
                ref lane : Str = decl_type_name_ref(sd.fields[0], lp.ctx.symbols)
                if lane == "I32" || lane == "U32" { return "vector<4xi32>" }
            }
            if sd.simd_width > 0 || sd.is_interface || sd.fields.len() == 0 { return "" }
            if init_delete_is_noop(name, lp.ctx.scope, lp.ctx.symbols).not() { return "" }
            mut fields := ""
            for i in 0..sd.fields.len() {
                ref field : Declaration = sd.fields[i]
                if field.own_type.is(OwnType.Own) { return "" }
                mut ft:="!llvm.ptr"
                if field.own_type.is(OwnType.Ref).not() {
                    ft=mlir_type(declaration_resolved_type(field, lp.ctx.scope, lp.ctx.symbols), lp)
                    if mlir_scalar(ft).or(mlir_pod(ft)).or(mlir_vector(ft)).not() { return "" }
                }
                if i > 0 { fields = format(fields, ", ") }
                fields = format(fields, mlir_field_storage(ft))
            }
            return format("!llvm.struct<\"til.mlir.pod.", name, "\", (", fields, ")>")
        }
    }
    return ""
}

priv mlir_array_element := func(shallow t:Type,lp:LoadedProgram) returns Type {
    ref name:Str=type_name_ref(t,lp.ctx.symbols)
    if name.starts_with("Array__").not() {return Type.None}
    element:=type_from_name_init_name(name.strip_prefix("Array__"),lp.ctx.scope,lp.ctx.symbols)
    // A ref-element array has pointer slots, not densely stored scalars. Its
    // qualified element name does not resolve to a primitive here.
    if element.is(Type.Primitive) {return element}
    return Type.None
}

priv mlir_error := proc(e: Expr, message: Str, mut lp: LoadedProgram) returns Str {
    e.type_error(format("MLIR backend: ", message), lp.ctx)
    return ""
}

priv mlir_value := func(mut state: MlirState, expression: Str) returns Str {
    name := format("%v", state.next.to_str())
    state.next++
    state.text = format(state.text, "    ", name, " = ", expression, "\n")
    return name
}

priv mlir_alignment := func(t: Str) returns Str {
    // A borrowed POD can have only scalar alignment (including nested values
    // in arrays). Do not promise the stronger alignment of our own slots.
    if mlir_pod(t) { return "1" }
    if t == "i1" || t == "i8" || t=="vector<4xi1>" { return "1" }
    if t == "i16" { return "2" }
    if t == "i64" || t == "f64" || t == "!llvm.ptr" || mlir_record(t) { return "8" }
    return "4"
}

priv mlir_record := func(t: Str) returns Bool { return t.starts_with("!llvm.struct<(!llvm.ptr,") }

priv mlir_sret := func(t: Str) returns Bool { return t == "!llvm.struct<(!llvm.ptr, i64, i64)>" }

priv mlir_pod := func(t: Str) returns Bool { return t.starts_with("!llvm.struct<\"til.mlir.pod.") }

priv mlir_pod_name := func(t: Str) returns Str {
    rest := t.strip_prefix("!llvm.struct<\"til.mlir.pod.")
    return rest.substr(0, rest.find("\"").to_usize())
}

priv mlir_return_sret := func(t: Str, lp: LoadedProgram) returns Bool {
    if mlir_sret(t) { return true }
    if mlir_pod(t) { return target_emitted_size(mlir_pod_name(t), lp.ctx.scope, lp.ctx) > 16 }
    return false
}

// SysV's INTEGER class dominates SSE within each eightbyte, including nested
// fields, including scalar-layout SIMD lanes and native pointer/reference slots.
// Packed fields, native-vector fields and x87 classes are outside this subset.
priv mlir_pod_classify := func(t: Str, offset: USize, mut parts: Vec(Str), lp: LoadedProgram) {
    name := mlir_pod_name(t)
    ref sd : StructDef = structdef_of(lp.ctx.scope.get_struct(name, lp.ctx.symbols).unwrap())
    mut cursor:USize=0
    for i in 0..sd.fields.len() {
        ref field:Declaration=sd.fields[i]
        mut ft:="!llvm.ptr"
        mut size:USize=8
        mut alignment:USize=8
        if field.own_type.is(OwnType.Ref).not() {
            ft=mlir_type(declaration_resolved_type(field, lp.ctx.scope, lp.ctx.symbols), lp)
            target_value_size_align(decl_type_name_ref(field,lp.ctx.symbols),lp.ctx.scope,lp.ctx,size,alignment)
        }
        cursor=align_up(cursor,alignment)
        position := offset+cursor
        cursor=cursor+size
        if mlir_pod(ft) { mlir_pod_classify(ft, position, parts, lp) }
        else if mlir_vector(ft) {
            scalar:=mlir_vector_scalar(ft)
            mut stride:USize=4
            if scalar=="i1" {stride=1}
            for lane in 0..4 {
                chunk:=(position+lane.to_usize()*stride)/8
                if scalar=="f32" {if parts[chunk].len()==0 {parts.set(chunk,own "vector<2xf32>")!}}
                else {parts.set(chunk,own "i64")!}
            }
        }
        else {
            chunk := position/8
            if mlir_float(ft) { if parts[chunk].len() == 0 { parts.set(chunk, own "vector<2xf32>")! } }
            else { parts.set(chunk, own "i64")! }
        }
    }
}

priv mlir_pod_parts := func(t: Str, lp: LoadedProgram) returns Vec(Str) {
    size := target_emitted_size(mlir_pod_name(t), lp.ctx.scope, lp.ctx)
    mut parts := Vec(Str).new()
    if size > 16 { return parts }
    for _ in 0..(size+7)/8 { parts.push(own "") }
    mlir_pod_classify(t, 0, parts, lp)
    return parts
}

priv mlir_pod_abi := func(t: Str, lp: LoadedProgram) returns Str {
    parts := mlir_pod_parts(t, lp)
    if parts.len() == 1 { return parts[0].clone() }
    return format("!llvm.struct<(", parts[0], ", ", parts[1], ")>")
}

priv mlir_pod_pack := func(value: Str, t: Str, mut state: MlirState, lp: LoadedProgram) returns Str {
    abi := mlir_pod_abi(t, lp)
    // Coercion chunks can include trailing padding. Allocate the full ABI
    // width, not the smaller source struct, before loading those chunks.
    slot := mlir_slot(abi, state, "8")
    mlir_store(slot, value, t, state)
    return mlir_value(state, format("llvm.load ", slot, " {alignment = 8 : i64} : !llvm.ptr -> ", abi))
}

priv mlir_pod_unpack := func(value: Str, t: Str, mut state: MlirState, lp: LoadedProgram) returns Str {
    abi := mlir_pod_abi(t, lp)
    slot := mlir_slot(abi, state, "8")
    mlir_store(slot, value, abi, state)
    return mlir_value(state, format("llvm.load ", slot, " {alignment = 1 : i64} : !llvm.ptr -> ", t))
}

priv mlir_byval_type := func(t: Str) returns Str {
    if mlir_pod(t) { return t.clone() }
    scalar := mlir_vector_scalar(t)
    return format("!llvm.struct<(", scalar, ", ", scalar, ", ", scalar, ", ", scalar, ")>")
}

// SysV allocates each two-eightbyte aggregate atomically. If its register
// bank cannot hold BOTH chunks, pass it on the stack and roll back that bank:
// a later scalar (or an aggregate in the other bank) can still use registers.
// Scalar stack placement is left to LLVM. Both definitions and direct calls
// consume this same plan, including the leading sret and trailing error args.
priv mlir_parameter_type := func(fd:FunctionDef,index:USize,lp:LoadedProgram) returns Type {
    ref p:Declaration=fd.sig.params[index]
    if fd.sig.variadic_index==index.to_i32() && decl_type_name_ref(p,lp.ctx.symbols)=="Str" {
        return type_from_name_init_name("Array__Str",lp.ctx.scope,lp.ctx.symbols)
    }
    return declaration_resolved_type(p,lp.ctx.scope,lp.ctx.symbols)
}

priv mlir_stack_arguments := func(fd: FunctionDef, lp: LoadedProgram) returns Vec(Bool) {
    mut integer_slots : USize = 0
    mut sse_slots : USize = 0
    if fd.sig.return_type.len() > 0 {
        ret := mlir_type(type_from_name_init_name(fd.sig.return_type, lp.ctx.scope, lp.ctx.symbols), lp)
        if fd.sig.return_own_type.is(OwnType.Ref).not() && mlir_return_sret(ret, lp) { integer_slots = 1 }
    }
    mut stack := Vec(Bool).new()
    for i in 0..fd.sig.params.len() {
        ref p:Declaration=fd.sig.params[i]
        t := mlir_type(mlir_parameter_type(fd,i,lp), lp)
        mut spilled := false
        if p.own_type.is(OwnType.Ref) || mlir_record(t) || t == "!llvm.ptr" {
            if integer_slots < 6 { integer_slots++ }
        } else if mlir_pod(t) {
            parts := mlir_pod_parts(t, lp)
            mut integers : USize = 0
            mut floats : USize = 0
            for part : Str in parts { if part == "i64" { integers++ } else { floats++ } }
            if parts.len() == 0 || integer_slots+integers > 6 || sse_slots+floats > 8 { spilled = true }
            else { integer_slots=integer_slots+integers; sse_slots=sse_slots+floats }
        } else if t == "vector<4xf32>" {
            if sse_slots <= 6 { sse_slots = sse_slots+2 }
            else { spilled = true }
        } else if t == "vector<4xi32>" {
            if integer_slots <= 4 { integer_slots = integer_slots+2 }
            else { spilled = true }
        } else if mlir_float(t) {
            if sse_slots < 8 { sse_slots++ }
        } else {
            // Supported integer scalars and the one-eightbyte Bool mask.
            if integer_slots < 6 { integer_slots++ }
        }
        stack.push(own spilled)
    }
    return stack
}

priv mlir_record_abi := func(t: Str) returns Str {
    if t == "!llvm.struct<(!llvm.ptr, i32, i32)>" { return "!llvm.struct<(!llvm.ptr, i64)>" }
    return t.clone()
}

priv mlir_record_cast := func(value: Str, from: Str, target: Str, mut state: MlirState) returns Str {
    if from == target { return value.clone() }
    slot := mlir_slot(from, state)
    mlir_store(slot, value, from, state)
    return mlir_value(state, format("llvm.load ", slot, " {alignment = 8 : i64} : !llvm.ptr -> ", target))
}

priv mlir_owned_record := func(value: Str, t: Str, mut state: MlirState) returns Str {
    // Match C's value-return/own-box boundary: CAP_LIT protects a static
    // wrapper, whereas a copied wrapper must be releasable as CAP_VIEW.
    if t == "!llvm.struct<(!llvm.ptr, i32, i32)>" || mlir_sret(t) {
        mut count := "i32"
        if mlir_sret(t) { count = "i64" }
        cap := mlir_value(state, format("llvm.extractvalue ", value, "[2] : ", t))
        literal := mlir_value(state, format("arith.constant -1 : ", count))
        view := mlir_value(state, format("arith.constant -2 : ", count))
        is_literal := mlir_value(state, format("arith.cmpi eq, ", cap, ", ", literal, " : ", count))
        owned_cap := mlir_value(state, format("arith.select ", is_literal, ", ", view, ", ", cap, " : ", count))
        return mlir_value(state, format("llvm.insertvalue ", owned_cap, ", ", value, "[2] : ", t))
    }
    return value.clone()
}

priv mlir_record_arg := proc(e: Expr, i: USize, t: Str, mut state: MlirState, mut lp: LoadedProgram) returns Str {
    if get_own_arg(e, i).and(get_keep_outer_arg(e, i).not()) {
        switch e.children[i].node_type {
        case .Ident(id):
            ref name : Str = id.ident_name(lp.ctx.symbols.names)
            if state.values.has(name) { if state.values[name].owns_wrapper { return state.values[name].value.clone() } }
        case:
        }
        raw := mlir_expr(e.children[i], state, lp)
        value := mlir_owned_record(raw, t, state)
        mut bytes : USize = 16
        if mlir_sret(t) { bytes = 24 }
        size := mlir_value(state, format("arith.constant ", bytes.to_str(), " : i64"))
        state.externals.set("malloc", own "  llvm.func @malloc(i64) -> !llvm.ptr\n")
        box := mlir_value(state, format("llvm.call @malloc(", size, ") : (i64) -> !llvm.ptr"))
        mlir_store(box, value, t, state)
        return box
    }
    return mlir_expr(e.children[i], state, lp, true)
}

priv mlir_string_literal := func(text: Str, mut state: MlirState, lp: LoadedProgram) returns Str {
    mut escaped := ""
    digits := "0123456789ABCDEF"
    for i in 0..text.len() {
        byte := text.unsafe_get(i).cast(U8).cast(U32)
        escaped = format(escaped, "\\", digits.substr(byte.shr(4).to_usize(), 1), digits.substr(byte.band(15).to_usize(), 1))
    }
    symbol := format("til.mlir.string.", state.symbol_prefix, ".", state.next.to_str())
    state.globals = format(state.globals, "  llvm.mlir.global private constant @\"", symbol,
        "\"(\"", escaped, "\\00\") : !llvm.array<", (text.len()+1).to_str(), " x i8>\n")
    address := mlir_value(state, format("llvm.mlir.addressof @\"", symbol, "\" : !llvm.ptr"))
    count := mlir_count_type(lp)
    length := mlir_value(state, format("arith.constant ", text.len().to_str(), " : ", count))
    cap := mlir_value(state, format("arith.constant -1 : ", count))
    t := mlir_type(type_from_name_init_name("Str", lp.ctx.scope, lp.ctx.symbols), lp)
    empty := mlir_value(state, format("llvm.mlir.undef : ", t))
    data := mlir_value(state, format("llvm.insertvalue ", address, ", ", empty, "[0] : ", t))
    sized := mlir_value(state, format("llvm.insertvalue ", length, ", ", data, "[1] : ", t))
    return mlir_value(state, format("llvm.insertvalue ", cap, ", ", sized, "[2] : ", t))
}

priv mlir_runtime_call := proc(e: Expr, name: Str, fd: FunctionDef, mut state: MlirState, mut lp: LoadedProgram, borrow: Bool) returns Str {
    mut symbol := name.clone()
    if lp.ctx.builder_core_c_names.has(name) { symbol = format(lp.ctx.builder_core_c_prefix, lp.ctx.builder_core_c_names[name]) }
    else if lp.ctx.builder_runtime_c_names.has(name) { symbol = format(lp.ctx.builder_runtime_c_prefix, name) }
    else { return mlir_error(e, format("unsupported runtime symbol '", name, "'"), lp) }
    mut ret := "void"
    if fd.sig.return_type.len() > 0 { ret = mlir_type(type_from_name_init_name(fd.sig.return_type, lp.ctx.scope, lp.ctx.symbols), lp) }
    if ret.len() == 0 { return mlir_error(e, "unsupported runtime return type", lp) }
    boxed_return := mlir_record(ret).and(fd.sig.func_type.is_bodyless()).and(fd.sig.return_own_type.is(OwnType.Shallow).or(fd.sig.return_own_type.is(OwnType.Ref)).not())
    sret := mlir_sret(ret).and(boxed_return.not()).and(fd.sig.return_own_type.is(OwnType.Ref).not())
    mut args := ""
    mut types := ""
    mut declaration := ""
    mut result_slot := ""
    if sret {
        result_slot = mlir_slot(ret, state)
        args = result_slot.clone()
        types = "!llvm.ptr"
        declaration = format("!llvm.ptr {llvm.sret = ", ret, "}")
    }
    for i in 0..fd.sig.params.len() {
        ref p : Declaration = fd.sig.params[i]
        mut t := mlir_type(declaration_resolved_type(p, lp.ctx.scope, lp.ctx.symbols), lp)
        if fd.sig.variadic_index >= 0 && i == fd.sig.variadic_index.to_usize() {
            if decl_type_name_ref(p, lp.ctx.symbols) != "Str" { return mlir_error(e, "only Str runtime variadics are supported", lp) }
            t = mlir_type(type_from_name_init_name("Array__Str", lp.ctx.scope, lp.ctx.symbols), lp)
        }
        if t.len() == 0 { return mlir_error(e, "unsupported runtime argument type", lp) }
        mut value := ""
        mut abi := t.clone()
        if mlir_record(t) {
            if p.own_type.is(OwnType.Shallow) { return mlir_error(e, "shallow runtime record parameters are unsupported", lp) }
            value = mlir_record_arg(e, i+1, t, state, lp)
            abi = "!llvm.ptr"
        } else if p.own_type.is(OwnType.Ref) {
            value = mlir_expr(e.children[i+1], state, lp, true)
            abi = "!llvm.ptr"
        } else {
            raw := mlir_expr(e.children[i+1], state, lp)
            value = mlir_coerce(raw, e.children[i+1], t, state, lp)
            if t == "i1" { value = mlir_value(state, format("arith.extui ", value, " : i1 to i8")); abi = "i8" }
        }
        if types.len() > 0 { args = format(args, ", "); types = format(types, ", "); declaration = format(declaration, ", ") }
        args = format(args, value); types = format(types, abi); declaration = format(declaration, abi)
        if abi != "!llvm.ptr" {
            extension := mlir_integer_extension(declaration_resolved_type(p,lp.ctx.scope,lp.ctx.symbols))
            if extension.len()>0 {declaration=format(declaration," {llvm.",extension,"}")}
        }
    }
    mut abi_ret := ret.clone()
    if ret == "i1" { abi_ret = "i8" }
    if mlir_record(ret) { abi_ret = mlir_record_abi(ret) }
    if boxed_return || fd.sig.return_own_type.is(OwnType.Ref) { abi_ret = "!llvm.ptr" }
    if sret { abi_ret = "void" }
    mut signature := format("  llvm.func @\"", symbol, "\"(", declaration, ")")
    if abi_ret != "void" {
        mut extension := ""
        if fd.sig.return_type.len()>0 && fd.sig.return_own_type.is(OwnType.Ref).not() && boxed_return.not() {
            extension=mlir_integer_extension(type_from_name_init_name(fd.sig.return_type,lp.ctx.scope,lp.ctx.symbols))
        }
        if extension.len()>0 {signature=format(signature," -> (",abi_ret," {llvm.",extension,"})")}
        else {signature = format(signature, " -> ", abi_ret)}
    }
    state.externals.set(symbol, own format(signature, "\n"))
    mut result := ""
    if abi_ret == "void" { state.text = format(state.text, "    llvm.call @\"", symbol, "\"(", args, ") : (", types, ") -> ()\n") }
    else { result = mlir_value(state, format("llvm.call @\"", symbol, "\"(", args, ") : (", types, ") -> ", abi_ret)) }
    if sret { result = mlir_value(state, format("llvm.load ", result_slot, " {alignment = 8 : i64} : !llvm.ptr -> ", ret)) }
    else if boxed_return {
        box := result.clone()
        result = mlir_value(state, format("llvm.load ", box, " {alignment = 8 : i64} : !llvm.ptr -> ", ret))
        state.externals.set("free", own "  llvm.func @free(!llvm.ptr)\n")
        state.text = format(state.text, "    llvm.call @free(", box, ") : (!llvm.ptr) -> ()\n")
    } else if mlir_record(ret).and(fd.sig.return_own_type.is(OwnType.Ref).not()) { result = mlir_record_cast(result, abi_ret, ret, state) }
    else if fd.sig.return_own_type.is(OwnType.Ref) {
        result = mlir_pointer_result(result,e,borrow,state,lp,ret,mlir_signed(type_from_name_init_name(fd.sig.return_type,lp.ctx.scope,lp.ctx.symbols)))
    } else if ret == "i1" { result = mlir_value(state, format("arith.trunci ", result, " : i8 to i1")) }
    // Array(Str).set has its own generated packing-error slot. Only invalidate
    // the enclosing OutOfBounds proof when that exact slot is passed.
    if fd.sig.throw_types.len() > 0 {
        switch e.children[e.children.len()-1].node_type {
        case .Ident(id): if id.ident_name(lp.ctx.symbols.names) == state.error_parameter { mlir_error_write(state) }
        case:
        }
    }
    if fd.noreturn { state.text = format(state.text, "    llvm.unreachable\n"); state.terminated = true }
    return result
}

priv mlir_slot := func(t: Str, mut state: MlirState, alignment: Str = "") returns Str {
    name := format("%v", state.next.to_str())
    state.next++
    mut actual_alignment := alignment.clone()
    if actual_alignment.len() == 0 { actual_alignment = mlir_alignment(t) }
    if mlir_pod(t) && alignment.len() == 0 { actual_alignment = "8" }
    state.allocations = format(state.allocations, "    ", name,
        " = llvm.alloca %alloc_count x ", mlir_storage_type(t), " {alignment = ", actual_alignment,
        " : i64} : (i64) -> !llvm.ptr\n")
    return name
}

priv mlir_store := func(pointer: Str, value: Str, t: Str, mut state: MlirState, alignment:Str="") {
    mut actual:=alignment.clone()
    if actual.len()==0 {actual=mlir_alignment(t)}
    mut stored:=value.clone()
    if t=="i1" {stored=mlir_value(state,format("arith.extui ",value," : i1 to i8"))}
    if t=="vector<4xi1>" {stored=mlir_pack_mask(value,state)}
    state.text = format(state.text, "    llvm.store ", stored, ", ", pointer,
        " {alignment = ", actual, " : i64} : ", mlir_storage_type(t), ", !llvm.ptr\n")
}

priv mlir_storage_type := func(t: Str) returns Str {
    if t=="i1" {return "i8"}
    if t=="vector<4xi1>" {return "i32"}
    return t.clone()
}

priv mlir_field_storage := func(t:Str) returns Str {
    if mlir_vector(t) {
        scalar:=mlir_storage_type(mlir_vector_scalar(t))
        return format("!llvm.struct<(",scalar,", ",scalar,", ",scalar,", ",scalar,")>")
    }
    return mlir_storage_type(t)
}

priv mlir_load := func(pointer: Str,t: Str,mut state: MlirState,alignment:Str="") returns Str {
    mut actual:=alignment.clone()
    if actual.len()==0 {actual=mlir_alignment(t)}
    value:=mlir_value(state,format("llvm.load ",pointer," {alignment = ",actual," : i64} : !llvm.ptr -> ",mlir_storage_type(t)))
    if t=="i1" {return mlir_value(state,format("arith.trunci ",value," : i8 to i1"))}
    if t=="vector<4xi1>" {return mlir_unpack_mask(value,state)}
    return value
}

priv mlir_binding_address := func(binding:MlirBinding,mut state:MlirState) returns Str {
    if binding.reference_slot.len()>0 {return mlir_load(binding.reference_slot,"!llvm.ptr",state)}
    return binding.value.clone()
}

// Mirror the shared reference_assignment_rebinds contract for the locals the
// emitter owns. Parameters remain write-through; namespace constants are values.
priv mlir_reference_rhs := func(rhs:Expr,state:MlirState,lp:LoadedProgram) returns Bool {
    switch rhs.node_type {
    case .Ident(id):
        ref name:Str=id.ident_name(lp.ctx.symbols.names)
        return state.values.has(name).and(state.values[name].is_local_ref)
    case .FieldAccess:
        t:=mlir_type(rhs.children[0].til_type(),lp)
        return mlir_pod(t).or(mlir_record(t))
    case .FCall:
        target:=mlir_resolve_call(rhs,state,lp)
        return target.is_some().and(funcdef_of(target.unwrap()).sig.return_own_type.is(OwnType.Ref))
    case: return false
    }
}

priv mlir_label := func(mut state: MlirState) returns Str {
    name := format("block", state.next_block.to_str())
    state.next_block++
    return name
}

priv mlir_block := func(name: Str, mut state: MlirState) {
    state.text = format(state.text, "  ^", name, ":\n")
    state.terminated = false
}

priv mlir_branch := func(name: Str, mut state: MlirState) {
    state.text = format(state.text, "    llvm.br ^", name, "\n")
    state.terminated = true
}

priv mlir_signed := func(shallow t: Type) returns Bool {
    return t.eq(Type.Primitive(Primitive.I8)).or(t.eq(Type.Primitive(Primitive.I16)))
        .or(t.eq(Type.Primitive(Primitive.I32))).or(t.eq(Type.Primitive(Primitive.I64)))
}

priv mlir_float := func(t: Str) returns Bool { return t.eq("f32").or(t.eq("f64")) }

priv mlir_integer_bits := func(t: Str) returns USize {
    switch t {
    case "i8": return 8
    case "i16": return 16
    case "i32": return 32
    case "i64": return 64
    case: return 0
    }
}

priv mlir_scalar := func(t: Str) returns Bool { return t.eq("i1").or(mlir_integer_bits(t)>0).or(mlir_float(t)) }

priv mlir_integer_extension := func(shallow t: Type) returns Str {
    switch t {
    case .Primitive(p):
        switch p {
        case .I8, .I16: return "signext"
        case .U8, .U16, .Bool: return "zeroext"
        case: return ""
        }
    case: return ""
    }
}

priv mlir_hex_literal := func(bits: U64, nibbles: USize) returns Str {
    mut hex := "0x"
    digits := "0123456789ABCDEF"
    for i in 0..nibbles {
        digit := bits.shr(((nibbles-1-i)*4).cast(U64)).band(15)
        hex=format(hex,digits.substr(digit.to_usize(),1))
    }
    return hex
}

priv mlir_convert := proc(value: Str, from: Str, target: Str, signed_value: Bool, source: Expr, mut state: MlirState, mut lp: LoadedProgram) returns Str {
    if from == target { return value.clone() }
    from_bits := mlir_integer_bits(from)
    target_bits := mlir_integer_bits(target)
    if from_bits > 0 && target_bits > 0 {
        if from_bits > target_bits { return mlir_value(state,format("arith.trunci ",value," : ",from," to ",target)) }
        mut operation := "extui"
        if signed_value { operation = "extsi" }
        return mlir_value(state, format("arith.", operation, " ", value, " : ",from," to ",target))
    }
    if mlir_float(from).and(mlir_float(target)) {
        mut operation := "extf"
        if target == "f32" { operation = "truncf" }
        return mlir_value(state,format("arith.",operation," ",value," : ",from," to ",target))
    }
    return mlir_error(source, format("unsupported value conversion from ", from, " to ", target), lp)
}

priv mlir_coerce := proc(value: Str, source: Expr, target: Str, mut state: MlirState, mut lp: LoadedProgram) returns Str {
    return mlir_convert(value, mlir_type(source.til_type(), lp), target,
        mlir_signed(source.til_type()), source, state, lp)
}

priv mlir_join := func(lo: Str, hi: Str, mut state: MlirState) returns Str {
    return mlir_value(state, format("vector.shuffle ", lo, ", ", hi,
        " [0, 1, 2, 3] : vector<2xf32>, vector<2xf32>"))
}

priv mlir_half := func(value: Str, high: Bool, mut state: MlirState) returns Str {
    mut lanes := "0, 1"
    if high { lanes = "2, 3" }
    return mlir_value(state, format("vector.shuffle ", value, ", ", value,
        " [", lanes, "] : vector<4xf32>, vector<4xf32>"))
}

priv mlir_lane := func(value: Str, index: U64, mut state: MlirState) returns Str {
    return mlir_value(state, format("vector.extract ", value, "[", index.to_str(), "] : f32 from vector<4xf32>"))
}

priv mlir_integer_type := func(shallow t: Type) returns Bool {
    switch t {
    case .Primitive(p):
        switch p {
        case .I8, .U8, .I16, .U16, .I32, .U32, .I64, .U64: return true
        case: return false
        }
    case: return false
    }
}

priv mlir_integer := func(e: Expr, state: MlirState, lp: LoadedProgram) returns Option(U64) {
    switch e.node_type {
    case .Literal(Literal.Num(n)):
        if mlir_integer_type(e.til_type()) {
            mut value := n.to_u64()
            // Compare the declared-width bit pattern, including negative literals.
            bits := mlir_integer_bits(mlir_type(e.til_type(),lp))
            mut shift:USize=64
            shift=shift-bits
            value = value.band(U64.MAX.shr(shift.cast(U64)))
            return Option(U64).Some(value)
        }
    case .Ident(id):
        ref name : Str = id.ident_name(lp.ctx.symbols.names)
        if name == state.error_parameter {
            if state.error_known_clear { return Option(U64).Some(0) }
            return Option(U64).None
        }
        if state.integers.has(name) { return Option(U64).Some(state.integers[name]) }
    case:
    }
    return Option(U64).None
}

priv mlir_error_write := func(mut state: MlirState) {
    state.error_known_clear = false
    state.error_version++
    state.clear_conditions.clear()
    state.set_conditions.clear()
}

priv mlir_tests_error_value := func(e: Expr, expected: U64, state: MlirState, lp: LoadedProgram) returns Bool {
    if state.error_parameter.len() == 0 { return false }
    switch e.node_type {
    case .Ident(id):
        if expected == 0 { return state.clear_conditions.has(id.ident_name(lp.ctx.symbols.names)) }
        return state.set_conditions.has(id.ident_name(lp.ctx.symbols.names))
    case .FCall:
        if e.children.len() != 3 { return false }
        switch e.children[0].node_type {
        case .FieldAccess(field):
            if field.field_access_name(lp.ctx.symbols.names) != "eq" { return false }
            switch e.children[1].node_type {
            case .Ident(id):
                if id.ident_name(lp.ctx.symbols.names) != state.error_parameter { return false }
                zero := mlir_integer(e.children[2], state, lp)
                return zero.is_some().and(zero.unwrap() == expected)
            case: return false
            }
        case: return false
        }
    case: return false
    }
}

priv mlir_boolean := func(e: Expr, state: MlirState, lp: LoadedProgram) returns Option(Bool) {
    switch e.node_type {
    case .Literal(Literal.Bool(value)): return Option(Bool).Some(value)
    case .Ident(id):
        ref name : Str = id.ident_name(lp.ctx.symbols.names)
        if state.booleans.has(name) { return Option(Bool).Some(state.booleans[name]) }
    case .FCall:
        if e.children.len() == 3 {
            ref callee : Expr = e.children[0]
            switch callee.node_type {
            case .FieldAccess(field):
                if callee.children.len() == 1 {
                    switch callee.children[0].node_type {
                    case .Ident(id):
                        owner := type_from_name_init_name(id.ident_name(lp.ctx.symbols.names), lp.ctx.scope, lp.ctx.symbols)
                        if mlir_integer_type(owner) {
                            a := mlir_integer(e.children[1], state, lp)
                            b := mlir_integer(e.children[2], state, lp)
                            ref op : Str = field.field_access_name(lp.ctx.symbols.names)
                            if a.is_some() && b.is_some() && op == "eq" { return Option(Bool).Some(a.unwrap() == b.unwrap()) }
                        }
                    case:
                    }
                }
            case:
            }
        }
    case:
    }
    return Option(Bool).None
}

priv mlir_construct := proc(e: Expr, mut state: MlirState, mut lp: LoadedProgram) returns Str {
    t := mlir_type(e.til_type(), lp)
    scalar := mlir_vector_scalar(t)
    mut vector := mlir_value(state, format("llvm.mlir.undef : ", t))
    for i in 0..4 {
        lane := mlir_expr(e.children[(i + 1).to_usize()], state, lp)
        vector = mlir_value(state, format("vector.insert ", lane, ", ", vector,
            "[", i.to_str(), "] : ", scalar, " into ", t))
    }
    return vector
}

// Four scalar i32 fields are two SysV INTEGER chunks, not an SSE vector.
priv mlir_i4_half := func(value: Str, high: Bool, mut state: MlirState) returns Str {
    chunks := mlir_value(state, format("llvm.bitcast ", value, " : vector<4xi32> to vector<2xi64>"))
    mut index := "0"
    if high { index = "1" }
    return mlir_value(state, format("vector.extract ", chunks, "[", index, "] : i64 from vector<2xi64>"))
}

priv mlir_i4_join := func(lo: Str, hi: Str, mut state: MlirState) returns Str {
    empty := mlir_value(state, "llvm.mlir.undef : vector<2xi64>")
    first := mlir_value(state, format("vector.insert ", lo, ", ", empty, "[0] : i64 into vector<2xi64>"))
    both := mlir_value(state, format("vector.insert ", hi, ", ", first, "[1] : i64 into vector<2xi64>"))
    return mlir_value(state, format("llvm.bitcast ", both, " : vector<2xi64> to vector<4xi32>"))
}

priv mlir_pack_i4 := func(value: Str, mut state: MlirState) returns Str {
    lo := mlir_i4_half(value, false, state)
    hi := mlir_i4_half(value, true, state)
    empty := mlir_value(state, format("llvm.mlir.undef : ", mlir_i4_type()))
    first := mlir_value(state, format("llvm.insertvalue ", lo, ", ", empty, "[0] : ", mlir_i4_type()))
    return mlir_value(state, format("llvm.insertvalue ", hi, ", ", first, "[1] : ", mlir_i4_type()))
}

priv mlir_i4_div := func(a: Str, b: Str, unsigned_lanes: Bool, mut state: MlirState) returns Str {
    t := "vector<4xi32>"
    zero := mlir_value(state, format("arith.constant dense<0> : ", t))
    one := mlir_value(state, format("arith.constant dense<1> : ", t))
    is_zero := mlir_value(state, format("arith.cmpi eq, ", b, ", ", zero, " : ", t))
    mut exceptional := is_zero.clone()
    mut overflow := ""
    mut operation := "divui"
    if unsigned_lanes.not() {
        operation = "divsi"
        minimum := mlir_value(state, format("arith.constant dense<-2147483648> : ", t))
        minus_one := mlir_value(state, format("arith.constant dense<-1> : ", t))
        is_min := mlir_value(state, format("arith.cmpi eq, ", a, ", ", minimum, " : ", t))
        is_minus_one := mlir_value(state, format("arith.cmpi eq, ", b, ", ", minus_one, " : ", t))
        overflow = mlir_value(state, format("arith.andi ", is_min, ", ", is_minus_one, " : vector<4xi1>"))
        exceptional = mlir_value(state, format("arith.ori ", is_zero, ", ", overflow, " : vector<4xi1>"))
    }
    // LLVM division must never see zero or MIN/-1, even in a discarded lane.
    // til's SIMD div_lane defines these results as zero and MIN respectively.
    divisor := mlir_value(state, format("arith.select ", exceptional, ", ", one, ", ", b, " : vector<4xi1>, ", t))
    mut result := mlir_value(state, format("arith.", operation, " ", a, ", ", divisor, " : ", t))
    if unsigned_lanes.not() { result = mlir_value(state, format("arith.select ", overflow, ", ", a, ", ", result, " : vector<4xi1>, ", t)) }
    return mlir_value(state, format("arith.select ", is_zero, ", ", zero, ", ", result, " : vector<4xi1>, ", t))
}

priv mlir_scalar_divmod := func(a:Str,b:Str,t:Str,signed_value:Bool,remainder:Bool,mut state:MlirState) returns Str {
    zero:=mlir_value(state,format("arith.constant 0 : ",t))
    one:=mlir_value(state,format("arith.constant 1 : ",t))
    is_zero:=mlir_value(state,format("arith.cmpi eq, ",b,", ",zero," : ",t))
    mut exceptional:=is_zero.clone()
    mut overflow:=""
    mut operation:="divui"
    if remainder {operation="remui"}
    if signed_value {
        if remainder {operation="remsi"}else{operation="divsi"}
        mut bits:U64=1
        bits=bits.shl((mlir_integer_bits(t)-1).cast(U64))
        minimum:=mlir_value(state,format("arith.constant ",bits.to_str()," : ",t))
        minus_one:=mlir_value(state,format("arith.constant -1 : ",t))
        is_min:=mlir_value(state,format("arith.cmpi eq, ",a,", ",minimum," : ",t))
        is_minus_one:=mlir_value(state,format("arith.cmpi eq, ",b,", ",minus_one," : ",t))
        overflow=mlir_value(state,format("arith.andi ",is_min,", ",is_minus_one," : i1"))
        exceptional=mlir_value(state,format("arith.ori ",is_zero,", ",overflow," : i1"))
    }
    // Neither div nor rem may see an exceptional operand, even if a later
    // select would discard its result: LLVM would already have made poison.
    divisor:=mlir_value(state,format("arith.select ",exceptional,", ",one,", ",b," : ",t))
    mut result:=mlir_value(state,format("arith.",operation," ",a,", ",divisor," : ",t))
    if signed_value {
        mut wrapped:=a.clone()
        if remainder {wrapped=zero.clone()}
        result=mlir_value(state,format("arith.select ",overflow,", ",wrapped,", ",result," : ",t))
    }
    return mlir_value(state,format("arith.select ",is_zero,", ",zero,", ",result," : ",t))
}

priv mlir_scalar_shift := func(a:Str,b:Str,t:Str,signed_value:Bool,right:Bool,mut state:MlirState) returns Str {
    bits:=mlir_integer_bits(t)
    zero:=mlir_value(state,format("arith.constant 0 : ",t))
    width:=mlir_value(state,format("arith.constant ",bits.to_str()," : ",t))
    // An unsigned full-width count comparison rejects negative signed counts.
    invalid:=mlir_value(state,format("arith.cmpi uge, ",b,", ",width," : ",t))
    count:=mlir_value(state,format("arith.select ",invalid,", ",zero,", ",b," : ",t))
    mut operation:="shli"
    mut outside:=zero.clone()
    if right {
        operation="shrui"
        if signed_value {
            operation="shrsi"
            last:=mlir_value(state,format("arith.constant ",(bits-1).to_str()," : ",t))
            outside=mlir_value(state,format("arith.shrsi ",a,", ",last," : ",t))
        }
    }
    value:=mlir_value(state,format("arith.",operation," ",a,", ",count," : ",t))
    return mlir_value(state,format("arith.select ",invalid,", ",outside,", ",value," : ",t))
}

priv mlir_minmax_pair := func(a: Str, b: Str, scalar: Str, unsigned_lanes: Bool, maximum: Bool, mut state: MlirState) returns Str {
    mut comparison := "lt"
    if maximum { comparison = "gt" }
    mut choose := ""
    if scalar == "f32" {
        rhs_nan := mlir_value(state, format("arith.cmpf uno, ", b, ", ", b, " : f32"))
        lhs_number := mlir_value(state, format("arith.cmpf ord, ", a, ", ", a, " : f32"))
        better := mlir_value(state, format("arith.cmpf o", comparison, ", ", b, ", ", a, " : f32"))
        zero := mlir_value(state, "arith.constant 0.0 : f32")
        lhs_zero := mlir_value(state, format("arith.cmpf oeq, ", a, ", ", zero, " : f32"))
        rhs_zero := mlir_value(state, format("arith.cmpf oeq, ", b, ", ", zero, " : f32"))
        both_zero := mlir_value(state, format("arith.andi ", lhs_zero, ", ", rhs_zero, " : i1"))
        bits := mlir_value(state, format("arith.bitcast ", b, " : f32 to i32"))
        integer_zero := mlir_value(state, "arith.constant 0 : i32")
        mut sign_test := "slt"
        if maximum { sign_test = "sge" }
        desired_sign := mlir_value(state, format("arith.cmpi ", sign_test, ", ", bits, ", ", integer_zero, " : i32"))
        zero_choice := mlir_value(state, format("arith.andi ", both_zero, ", ", desired_sign, " : i1"))
        number_choice := mlir_value(state, format("arith.ori ", better, ", ", zero_choice, " : i1"))
        ordered_choice := mlir_value(state, format("arith.andi ", lhs_number, ", ", number_choice, " : i1"))
        choose = mlir_value(state, format("arith.ori ", rhs_nan, ", ", ordered_choice, " : i1"))
    } else {
        mut sign := "s"
        if unsigned_lanes { sign = "u" }
        choose = mlir_value(state, format("arith.cmpi ", sign, comparison, ", ", b, ", ", a, " : i32"))
    }
    // Select the original bits: do not quiet NaNs or replace their payload.
    return mlir_value(state, format("arith.select ", choose, ", ", b, ", ", a, " : ", scalar))
}

priv mlir_reduce_minmax := proc(e: Expr, t: Str, unsigned_lanes: Bool, maximum: Bool, mut state: MlirState, mut lp: LoadedProgram) returns Str {
    value := mlir_expr(e.children[1], state, lp)
    scalar := mlir_vector_scalar(t)
    mut lanes := Vec(Str).new()
    for i in 0..4 { lanes.push(own mlir_value(state, format("vector.extract ", value, "[", i.to_str(), "] : ", scalar, " from ", t))) }
    // Preserve core's halving tree, including which NaN wins when both sides
    // are NaNs: pair (0,2), pair (1,3), then combine those two results.
    even := mlir_minmax_pair(lanes[0], lanes[2], scalar, unsigned_lanes, maximum, state)
    odd := mlir_minmax_pair(lanes[1], lanes[3], scalar, unsigned_lanes, maximum, state)
    return mlir_minmax_pair(even, odd, scalar, unsigned_lanes, maximum, state)
}

// The C mask is four normalized Bool bytes, classified as one SysV INTEGER
// chunk. Register predicates remain i1 lanes; never expose their packed bits.
priv mlir_pack_mask := func(value: Str, mut state: MlirState) returns Str {
    bytes := mlir_value(state, format("arith.extui ", value, " : vector<4xi1> to vector<4xi8>"))
    return mlir_value(state, format("llvm.bitcast ", bytes, " : vector<4xi8> to i32"))
}

priv mlir_unpack_mask := func(value: Str, mut state: MlirState) returns Str {
    bytes := mlir_value(state, format("llvm.bitcast ", value, " : i32 to vector<4xi8>"))
    zero := mlir_value(state, "arith.constant dense<0> : vector<4xi8>")
    return mlir_value(state, format("arith.cmpi ne, ", bytes, ", ", zero, " : vector<4xi8>"))
}

priv mlir_pack_return := func(value: Str, mut state: MlirState) returns Str {
    lo := mlir_half(value, false, state)
    hi := mlir_half(value, true, state)
    empty := mlir_value(state, format("llvm.mlir.undef : ", mlir_f4_type()))
    first := mlir_value(state, format("llvm.insertvalue ", lo, ", ", empty, "[0] : ", mlir_f4_type()))
    return mlir_value(state, format("llvm.insertvalue ", hi, ", ", first, "[1] : ", mlir_f4_type()))
}

// Capture source declarations before preparation appends generic core helpers
// (including helpers referenced only by generated type namespaces).
mlir_source_declarations := func(lp: LoadedProgram) returns Set(Str) {
    mut names := Set(Str).new()
    for unit : ProgramUnit in lp.units {
        for stmt : Expr in lp.ctx.imported[unit.path].ast.children {
            if stmt.node_type.is(NodeType.Decl).not() { continue }
            ref dd : Declaration = decl_of(stmt)
            names.add(own format(unit.path,"\n",dd.name))
            if is_struct_or_enum(stmt) {
                ref definition : Expr = stmt.children[0]
                for i in 0..def_ns_decls(definition).len() {
                    names.add(own format(unit.path,"\n",dd.name,".",def_ns_name_at(definition,i)))
                }
            }
        }
    }
    return names
}

priv mlir_source_name := func(path: Str, dd: Declaration, names: Set(Str)) returns Bool {
    return names.has(format(path,"\n",dd.name)).or(dd.orig_name.len()>0 && names.has(format(path,"\n",dd.orig_name)))
}

priv mlir_source_member := func(path: Str, owner: Declaration, member: Str, names: Set(Str)) returns Bool {
    return names.has(format(path,"\n",owner.name,".",member))
        .or(owner.orig_name.len()>0 && names.has(format(path,"\n",owner.orig_name,".",member)))
}

priv mlir_callable_expr := func(callable: MlirCallable, lp: LoadedProgram) returns ref Expr {
    ref unit : ImportUnit = lp.ctx.imported.get(callable.path)!
    ref declaration : Expr = unit.ast.children.unsafe_get(callable.declaration)
    if callable.member < 0 { return declaration.children[0] }
    return def_ns_decls(declaration.children[0])[callable.member.to_usize()].default_expr()
}

priv mlir_callable_id := func(function: Expr) returns UPtr { return word_bits(to_ptr(function)).cast(UPtr) }

priv mlir_generic_source := func(dd: Declaration, lp: LoadedProgram) returns Str {
    for key : Str in lp.ctx.generic_func_synths {
        separator := key.rfind("#")
        if separator < 0 { panic("concrete generic identity has no declaring unit") }
        path := key.substr(0,separator.to_usize())
        name := key.substr(separator.to_usize()+1,key.len()-separator.to_usize()-1)
        if name == dd.name || (dd.is_priv && priv_c_name(path,name)==dd.name) { return path }
    }
    panic("MLIR concrete generic has no declaring unit: ",dd.name)
}

// Direct-core scalar slice. Compatibility
// conversions and size queries already have dedicated lowering; core_func and
// ext_func declarations remain at their intrinsic/native boundaries.
priv mlir_scalar_core_body := func(name:Str,fd:FunctionDef,lp:LoadedProgram) returns Bool {
    if fd.auto_generated || fd.sig.func_type.is(FuncType.Func).not() || fd.captures.len()>0 {return false}
    if name.starts_with("to_").or(name=="from_i64").or(name=="size").or(name=="size_for_target") {return false}
    if fd.sig.throw_types.len()>0 || fd.sig.variadic_index>=0 || fd.sig.kwargs_index>=0 {return false}
    if fd.sig.return_type.len()==0 {return false}
    if is_primitive(type_from_name_init_name(fd.sig.return_type,lp.ctx.scope,lp.ctx.symbols)).not() {return false}
    for p:Declaration in fd.sig.params {
        if p.is_mut {return false}
        t:=declaration_resolved_type(p,lp.ctx.scope,lp.ctx.symbols)
        if is_primitive(t) {
            if p.own_type.is(OwnType.Shallow).or(p.own_type.is(OwnType.Ref)).not() {return false}
        // Borrow the descriptor; an owning Str body needs lifecycle lowering.
        } else if type_name_ref(t,lp.ctx.symbols).eq("Str").and(p.own_type.is(OwnType.Ref)).not() {return false}
    }
    return true
}

priv mlir_string_array_member := func(name:Str) returns Bool {
    switch name {
    case "new", "len", "unsafe_get", "get", "unsafe_set", "set", "delete", "clone", "concat": return true
    case: return false
    }
}

priv mlir_callable_inventory := func(lp: LoadedProgram, names: Set(Str)) returns Vec(MlirCallable) {
    mut functions := Vec(MlirCallable).new()
    for unit : ProgramUnit in lp.units {
        ref root : Expr = lp.ctx.imported[unit.path].ast
        for i in 0..root.children.len() {
            ref stmt : Expr = root.children[i]
            if stmt.node_type.is(NodeType.Decl).not().or(stmt.children.len()!=1) { continue }
            ref dd : Declaration = decl_of(stmt)
            if stmt.children[0].node_type.is(NodeType.FuncDef) {
                // A FuncSig declaration is represented by a FuncDef without a
                // Body. It names a callable type, not a function to emit.
                if stmt.children[0].children.len() == 0 { continue }
                ref fd : FunctionDef = funcdef_of(stmt.children[0])
                if fd.auto_generated || fd.sig.func_type.is_bodyless() || fd.sig.func_type.is(FuncType.Macro) { continue }
                synthetic := lp.ctx.generic_func_synth_names.has(dd.name)
                if mlir_source_name(unit.path,dd,names).or(synthetic).not() { continue }
                mut symbol := dd.name.clone()
                if dd.name == "main" { symbol = "til.mlir.main" }
                mut source_path := unit.path.clone()
                if synthetic { source_path=mlir_generic_source(dd,lp) }
                functions.push(own MlirCallable(path=unit.path.clone(),source_path=source_path,declaration=i,name=dd.name.clone(),symbol=symbol,
                    exported=dd.is_priv.or(synthetic).not()))
            } else if is_struct_or_enum(stmt) {
                ref definition : Expr = stmt.children[0]
                ref members : Vec(Declaration) = def_ns_decls(definition)
                for j in 0..members.len() {
                    ref member : Declaration = members[j]
                    ref name : Str = def_ns_name_at(definition,j)
                    core_array:=dd.name=="Array__Str" && mlir_string_array_member(name)
                    if mlir_source_member(unit.path,dd,name,names).or(core_array).not().or(member.default_value.is_none()) { continue }
                    ref value : Expr = member.default_expr()
                    if value.node_type.is(NodeType.FuncDef).not() { continue }
                    if value.children.len() == 0 { continue }
                    ref fd : FunctionDef = funcdef_of(value)
                    if fd.auto_generated || fd.sig.func_type.is_bodyless() || fd.sig.func_type.is(FuncType.Macro) { continue }
                    mut symbol:=format(dd.name,"_",name)
                    if core_array {symbol=format("til.mlir.core.",dd.name,".",name)}
                    functions.push(own MlirCallable(path=unit.path.clone(),source_path=unit.path.clone(),declaration=i,member=j.to_i64(),
                        name=format(dd.name,".",name),symbol=symbol,exported=dd.is_priv.or(member.is_priv).or(core_array).not()))
                }
            }
        }
    }
    for unit:ProgramUnit in lp.core_units {
        ref root:Expr=lp.ctx.imported[unit.path].ast
        for i in 0..root.children.len() {
            ref stmt:Expr=root.children[i]
            if stmt.node_type.is(NodeType.Decl) && stmt.children.len()==1 && stmt.children[0].node_type.is(NodeType.FuncDef) {
                ref dd:Declaration=decl_of(stmt)
                synthetic:=lp.ctx.generic_func_synth_names.has(dd.name)
                if dd.name=="concat3" || dd.name=="format" || dd.name=="swap_bytes" || dd.name=="print" || dd.name=="println"
                    || dd.name=="panic" || dd.name=="assert" || dd.name=="expect"
                    || dd.name=="TODO" || dd.name=="UNREACHABLE" || synthetic {
                    mut source_path:=unit.path.clone()
                    if synthetic {source_path=mlir_generic_source(dd,lp)}
                    functions.push(own MlirCallable(path=unit.path.clone(),source_path=source_path,declaration=i,
                        name=dd.name.clone(),symbol=format("til.mlir.core.",dd.name),exported=false))
                }
                continue
            }
            if is_struct_or_enum(stmt).not() {continue}
            ref dd:Declaration=decl_of(stmt)
            if is_primitive(type_from_name_init_name(dd.name,lp.ctx.scope,lp.ctx.symbols)).or(dd.name=="Str").or(dd.name=="Array__Str").not() {continue}
            ref definition:Expr=stmt.children[0]
            ref members:Vec(Declaration)=def_ns_decls(definition)
            for j in 0..members.len() {
                ref member:Declaration=members[j]
                if member.default_value.is_none() {continue}
                ref value:Expr=member.default_expr()
                if value.node_type.is(NodeType.FuncDef).not() || value.children.len()==0 {continue}
                ref name:Str=def_ns_name_at(definition,j)
                if dd.name=="Str" {
                    // These ordinary bodies use the same aggregate ABI and
                    // prepared ownership/cleanup as user functions.
                    switch name {
                    case "len", "unsafe_get", "cmp", "eq", "get", "is_empty",
                        "starts_with", "ends_with", "find", "rfind", "contains",
                        "read_utf8", "is_valid_utf8", "borrowed_view", "substr",
                        "trim_start", "trim", "with_capacity", "push_str", "clone", "delete",
                        "from_byte", "from_codepoint", "get_char", "strip_prefix", "strip_suffix", "replace":
                    case: continue
                    }
                } else if dd.name=="Array__Str" {
                    if mlir_string_array_member(name).not() {continue}
                } else if name=="to_str" && mlir_integer_type(type_from_name_init_name(dd.name,lp.ctx.scope,lp.ctx.symbols)) {
                    if funcdef_of(value).sig.func_type.is(FuncType.Func).not() {continue}
                } else if mlir_scalar_core_body(name,funcdef_of(value),lp).not() {continue}
                functions.push(own MlirCallable(path=unit.path.clone(),source_path=unit.path.clone(),declaration=i,member=j.to_i64(),
                    name=format(dd.name,".",name),symbol=format("til.mlir.core.",dd.name,".",name),exported=false))
            }
        }
    }
    return functions
}

priv mlir_require_function := func(symbol:Str,functions:Map(UPtr,MlirCallable),mut selected:Set(UPtr),mut pending:Vec(UPtr)) {
    for id:UPtr in functions.keys {
        if functions[id].symbol!=symbol {continue}
        if selected.has(id).not() {selected.add(own id.clone());pending.push(own id.clone())}
        return
    }
    panic("MLIR required core function is absent: ",symbol)
}

priv mlir_collect_calls := func(e: Expr, functions: Map(UPtr,MlirCallable), mut selected: Set(UPtr), mut pending: Vec(UPtr), lp: LoadedProgram) {
    if e.node_type.is(NodeType.FuncDef) { return }
    switch e.node_type {
    case .Assign(assignment):
        if assignment.save_old_delete {
            t:=mlir_type(e.til_type(),lp)
            if mlir_record(t) {
                mut symbol:="til.mlir.core.Array__Str.delete"
                if t=="!llvm.struct<(!llvm.ptr, i32, i32)>" || mlir_sret(t) {symbol="til.mlir.core.Str.delete"}
                mlir_require_function(symbol,functions,selected,pending)
            }
        }
    case:
    }
    if e.node_type.is(NodeType.FCall) {
        // The frontend's mut-parameter replacement carries cleanup in this
        // mark, not in a separate delete AST call. Root its real core body.
        replacement:=fcall_of(e).swap_replace && type_name_ref(e.children[1].til_type(),lp.ctx.symbols)=="Str"
        if replacement {
            ref owner:Expr=lp.ctx.scope.get_struct("Str",lp.ctx.symbols).unwrap()
            id:=mlir_callable_id(def_ns_get(owner,"delete").unwrap().default_expr())
            if selected.has(id).not() {selected.add(own id.clone());pending.push(own id.clone())}
        }
        target := resolve_direct_fcall(e,lp.ctx.scope,lp.ctx.symbols)
        if target.is_some().and(replacement.not()) {
            // Checked floating casts synthesize a panic edge during emission.
            // Root its ordinary helpers without pulling diagnostics into
            // modules containing only infallible integer/float conversions.
            ref callee:Expr=e.children[0]
            if e.children.len()==3 && callee.node_type.is(NodeType.Ident)
                && ident_of(callee).ident_name(lp.ctx.symbols.names)=="cast"
                && funcdef_of(target.unwrap()).sig.func_type.is_bodyless() {
                source:=mlir_type(e.children[1].til_type(),lp)
                cast_type:=type_from_name_init_name(ident_of(e.children[2]).ident_name(lp.ctx.symbols.names),lp.ctx.scope,lp.ctx.symbols)
                cast_target:=mlir_type(cast_type,lp)
                if mlir_float(source).or(source=="vector<4xf32>")
                    && (mlir_integer_bits(cast_target)>0 || cast_target=="vector<4xi32>") {
                    mlir_require_function("til.mlir.core.Array__Str.new",functions,selected,pending)
                    mlir_require_function("til.mlir.core.Array__Str.set",functions,selected,pending)
                    mlir_require_function("til.mlir.core.panic",functions,selected,pending)
                }
            }
            id := mlir_callable_id(target.unwrap())
            if functions.has(id).and(selected.has(id).not()) { selected.add(own id.clone());pending.push(own id.clone()) }
        }
    }
    for child : Expr in e.children { mlir_collect_calls(child,functions,selected,pending,lp) }
}

priv mlir_count_type := func(lp: LoadedProgram) returns Str {
    return mlir_type(type_from_name_init_name("USize", lp.ctx.scope, lp.ctx.symbols), lp)
}

priv mlir_buffer_length := func(buffer: Str, mut state: MlirState, lp: LoadedProgram) returns Str {
    count_type := mlir_count_type(lp)
    field := mlir_value(state, format("llvm.getelementptr ", buffer,
        "[0, 1] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(!llvm.ptr, ", count_type, ")>"))
    return mlir_value(state, format("llvm.load ", field, " {alignment = ",
        mlir_alignment(count_type), " : i64} : !llvm.ptr -> ", count_type))
}

priv mlir_checked_memory := proc(e: Expr, vector: Bool, store: Bool, scalar: Str, mut state: MlirState, mut lp: LoadedProgram) returns Str {
    if state.error_parameter.len() == 0 {
        return mlir_error(e, "checked buffer operation has no lowered error slot", lp)
    }
    mut arguments := Vec(Str).new()
    for i in 1..e.children.len() - 1 { arguments.push(own mlir_expr(e.children[i], state, lp)) }
    error := mlir_expr(e.children[e.children.len() - 1], state, lp, true)
    mlir_error_write(state)
    mut buffer_index : USize = 0
    mut index_index : USize = 1
    mut value_index : USize = 2
    if vector && store { buffer_index = 1; index_index = 2; value_index = 0 }
    ref buffer : Str = arguments[buffer_index]
    ref index : Str = arguments[index_index]
    count := mlir_buffer_length(buffer, state, lp)
    count_type := mlir_count_type(lp)
    success := mlir_label(state)
    failure := mlir_label(state)
    done := mlir_label(state)
    mut result_type := "!llvm.ptr"
    if vector { result_type = format("vector<4x", scalar, ">") }
    mut result_slot := ""
    if store.not() { result_slot = mlir_slot(result_type, state) }
    if vector {
        span := mlir_label(state)
        start_ok := mlir_value(state, format("arith.cmpi ule, ", index, ", ", count, " : ", count_type))
        state.text = format(state.text, "    llvm.cond_br ", start_ok, ", ^", span, ", ^", failure, "\n")
        mlir_block(span, state)
        remaining := mlir_value(state, format("arith.subi ", count, ", ", index, " : ", count_type))
        width := mlir_value(state, format("arith.constant 4 : ", count_type))
        fits := mlir_value(state, format("arith.cmpi uge, ", remaining, ", ", width, " : ", count_type))
        state.text = format(state.text, "    llvm.cond_br ", fits, ", ^", success, ", ^", failure, "\n")
    } else {
        fits := mlir_value(state, format("arith.cmpi ult, ", index, ", ", count, " : ", count_type))
        state.text = format(state.text, "    llvm.cond_br ", fits, ", ^", success, ", ^", failure, "\n")
    }
    mlir_block(success, state)
    // Form no data address until the whole access has passed its check.
    data_field := mlir_value(state, format("llvm.getelementptr ", buffer,
        "[0, 0] : (!llvm.ptr) -> !llvm.ptr, !llvm.struct<(!llvm.ptr, ", count_type, ")>"))
    data := mlir_value(state, format("llvm.load ", data_field, " {alignment = 8 : i64} : !llvm.ptr -> !llvm.ptr"))
    mut wide_index := index.clone()
    if count_type == "i32" { wide_index = mlir_value(state, format("arith.extui ", index, " : i32 to i64")) }
    address := mlir_value(state, format("llvm.getelementptr ", data, "[", wide_index,
        "] : (!llvm.ptr, i64) -> !llvm.ptr, ", mlir_storage_type(scalar)))
    if store {
        mut value_type := scalar.clone()
        if vector { value_type = result_type.clone() }
        mut value:=arguments[value_index].clone()
        mut alignment:="4"
        if vector.not() {value=mlir_coerce(value,e.children[value_index+1],scalar,state,lp);alignment="1"}
        mlir_store(address, value, value_type, state,alignment)
    } else if vector {
        value := mlir_value(state, format("llvm.load ", address, " {alignment = 4 : i64} : !llvm.ptr -> ", result_type))
        mlir_store(result_slot, value, result_type, state)
    } else { mlir_store(result_slot, address, result_type, state) }
    mlir_branch(done, state)
    mlir_block(failure, state)
    kind := mlir_value(state, "arith.constant 1 : i64")
    mlir_store(error, kind, "i64", state)
    if store.not() {
        mut fallback := ""
        if vector {
            mut literal := "0"
            if scalar == "f32" { literal = "0.0" }
            fallback = mlir_value(state, format("arith.constant dense<", literal, "> : ", result_type))
        }
        else {
            zero := mlir_value(state, "arith.constant 0 : i64")
            fallback = mlir_value(state, format("llvm.inttoptr ", zero, " : i64 to !llvm.ptr"))
        }
        mlir_store(result_slot, fallback, result_type, state)
    }
    mlir_branch(done, state)
    mlir_block(done, state)
    if store { return "" }
    return mlir_value(state, format("llvm.load ", result_slot, " {alignment = ",
        mlir_alignment(result_type), " : i64} : !llvm.ptr -> ", result_type))
}

priv mlir_checked_lane := proc(e: Expr, t: Str, store: Bool, mut state: MlirState, mut lp: LoadedProgram) returns Str {
    scalar := mlir_vector_scalar(t)
    known := mlir_integer(e.children[2], state, lp)
    receiver := mlir_expr(e.children[1], state, lp, store)
    index := mlir_expr(e.children[2], state, lp)
    mut replacement := ""
    if store { replacement = mlir_expr(e.children[3], state, lp) }
    count_type := mlir_count_type(lp)
    checked := known.is_none().or(known.unwrap() >= 4)
    mut failure := ""
    mut done := ""
    mut result_slot := ""
    mut error := ""
    if checked {
        error = mlir_expr(e.children[e.children.len() - 1], state, lp, true)
        mlir_error_write(state)
        success := mlir_label(state)
        failure = mlir_label(state)
        done = mlir_label(state)
        if store.not() { result_slot = mlir_slot(scalar, state) }
        width := mlir_value(state, format("arith.constant 4 : ", count_type))
        fits := mlir_value(state, format("arith.cmpi ult, ", index, ", ", width, " : ", count_type))
        state.text = format(state.text, "    llvm.cond_br ", fits, ", ^", success, ", ^", failure, "\n")
        mlir_block(success, state)
    }
    mut value := receiver.clone()
    if store {
        value = mlir_load(receiver,t,state,"1")
        updated := mlir_value(state, format("llvm.insertelement ", replacement, ", ", value, "[", index, " : ", count_type, "] : ", t))
        mlir_store(receiver, updated, t, state,"1")
    } else {
        value = mlir_value(state, format("llvm.extractelement ", value, "[", index, " : ", count_type, "] : ", t))
        if checked { mlir_store(result_slot, value, scalar, state) }
    }
    if checked {
        mlir_branch(done, state)
        mlir_block(failure, state)
        kind := mlir_value(state, "arith.constant 1 : i64")
        mlir_store(error, kind, "i64", state)
        if store.not() {
            mut literal := "0.0"
            if scalar != "f32" { literal = "0" }
            // An unused ABI placeholder; lowered error guards skip consumers.
            zero := mlir_value(state, format("arith.constant ", literal, " : ", scalar))
            mlir_store(result_slot, zero, scalar, state)
        }
        mlir_branch(done, state)
        mlir_block(done, state)
        if store.not() { value = mlir_value(state, format("llvm.load ", result_slot, " {alignment = ", mlir_alignment(scalar), " : i64} : !llvm.ptr -> ", scalar)) }
    }
    if store { return "" }
    return value
}

priv mlir_cast_failure := func(e: Expr, mut state: MlirState, lp: LoadedProgram) {
    str_type := mlir_type(type_from_name_init_name("Str", lp.ctx.scope, lp.ctx.symbols), lp)
    array_type := mlir_type(type_from_name_init_name("Array__Str", lp.ctx.scope, lp.ctx.symbols), lp)
    count_type := mlir_count_type(lp)
    new_name := "til.mlir.core.Array__Str.new"
    set_name := "til.mlir.core.Array__Str.set"
    panic_name := "til.mlir.core.panic"
    state.externals.set("malloc", own "  llvm.func @malloc(i64) -> !llvm.ptr\n")
    one := mlir_value(state, format("arith.constant 1 : ", count_type))
    array := mlir_value(state, format("llvm.call @\"", new_name, "\"(", one, ") : (", count_type, ") -> ", array_type))
    wrapper_size := mlir_value(state, "arith.constant 16 : i64")
    parts := mlir_value(state, format("llvm.call @malloc(", wrapper_size, ") : (i64) -> !llvm.ptr"))
    mlir_store(parts, array, array_type, state)
    message := mlir_string_literal("invalid numeric cast", state, lp)
    owned_message := mlir_owned_record(message, str_type, state)
    mut bytes := "16"
    if mlir_sret(str_type) { bytes = "24" }
    size := mlir_value(state, format("arith.constant ", bytes, " : i64"))
    message_box := mlir_value(state, format("llvm.call @malloc(", size, ") : (i64) -> !llvm.ptr"))
    mlir_store(message_box, owned_message, str_type, state)
    index := mlir_value(state, format("arith.constant 0 : ", count_type))
    error := mlir_slot("i64", state)
    zero := mlir_value(state, "arith.constant 0 : i64")
    mlir_store(error, zero, "i64", state)
    state.text = format(state.text, "    llvm.call @\"", set_name, "\"(", parts, ", ", index, ", ", message_box, ", ", error, ") : (!llvm.ptr, ", count_type, ", !llvm.ptr, !llvm.ptr) -> ()\n")
    location := mlir_string_literal(numeric_cast_location(e, lp.ctx), state, lp)
    location_slot := mlir_slot(str_type, state)
    mlir_store(location_slot, location, str_type, state)
    state.text = format(state.text, "    llvm.call @\"", panic_name, "\"(", parts, ", ", location_slot, ") : (!llvm.ptr, !llvm.ptr) -> ()\n    llvm.unreachable\n")
    state.terminated = true
}

priv mlir_cast := proc(e: Expr, mut state: MlirState, mut lp: LoadedProgram) returns Str {
    ref source_type : Type = e.children[1].til_type()
    target_type := type_from_name_init_name(ident_of(e.children[2]).ident_name(lp.ctx.symbols.names), lp.ctx.scope, lp.ctx.symbols)
    source := mlir_type(source_type, lp)
    target := mlir_type(target_type, lp)
    if source.len().eq(0).or(target.len().eq(0)) { return mlir_error(e, "unsupported cast type", lp) }
    value := mlir_expr(e.children[1], state, lp)
    mut converted := value.clone()
    mut signed_source := mlir_signed(source_type)
    mut signed_target := mlir_signed(target_type)
    if source == "vector<4xi32>" { signed_source = mlir_unsigned_vector(source_type, lp).not() }
    if target == "vector<4xi32>" { signed_target = mlir_unsigned_vector(target_type, lp).not() }
    if source != target {
        float_source := mlir_float(source).or(source.eq("vector<4xf32>"))
        float_target := mlir_float(target).or(target.eq("vector<4xf32>"))
        if float_source && float_target { converted=mlir_convert(value,source,target,signed_source,e,state,lp) }
        else if float_source {
            if mlir_integer_bits(target)==0 && target != "vector<4xi32>" { return mlir_error(e, "unsupported floating cast", lp) }
            mut bits := mlir_integer_bits(target)
            if target == "vector<4xi32>" { bits=32 }
            mut exponent := bits
            if signed_target { exponent = bits-1 }
            mut bound_bits := (exponent+127).cast(U64).shl(23)
            mut nibbles : USize = 8
            mut sign : U64 = 0x80000000
            if source=="f64" {bound_bits=(exponent+1023).cast(U64).shl(52);nibbles=16;sign=0x8000000000000000}
            mut upper_literal := mlir_hex_literal(bound_bits,nibbles)
            mut lower_literal := "0.0"
            if signed_target { lower_literal = mlir_hex_literal(bound_bits.bor(sign),nibbles) }
            if source == "vector<4xf32>" {
                upper_literal = format("dense<", upper_literal, ">")
                lower_literal = format("dense<", lower_literal, ">")
            }
            truncated := mlir_value(state, format("llvm.intr.trunc(", value, ") : (", source, ") -> ", source))
            lower := mlir_value(state, format("arith.constant ", lower_literal, " : ", source))
            upper := mlir_value(state, format("arith.constant ", upper_literal, " : ", source))
            above := mlir_value(state, format("arith.cmpf oge, ", truncated, ", ", lower, " : ", source))
            below := mlir_value(state, format("arith.cmpf olt, ", truncated, ", ", upper, " : ", source))
            mut predicate_type := "i1"
            if source == "vector<4xf32>" { predicate_type = "vector<4xi1>" }
            mut valid := mlir_value(state, format("arith.andi ", above, ", ", below, " : ", predicate_type))
            if predicate_type != "i1" { valid = mlir_value(state, format("vector.reduction <and>, ", valid, " : vector<4xi1> into i1")) }
            success := mlir_label(state)
            failure := mlir_label(state)
            state.text = format(state.text, "    llvm.cond_br ", valid, ", ^", success, ", ^", failure, "\n")
            mlir_block(failure, state)
            mlir_cast_failure(e, state, lp)
            mlir_block(success, state)
            mut operation := "fptoui"
            if signed_target { operation = "fptosi" }
            converted = mlir_value(state, format("arith.", operation, " ", value, " : ", source, " to ", target))
        } else if float_target {
            mut operation := "uitofp"
            if signed_source { operation = "sitofp" }
            converted = mlir_value(state, format("arith.", operation, " ", value, " : ", source, " to ", target))
        } else { converted = mlir_convert(value, source, target, signed_source, e, state, lp) }
    }
    return mlir_convert(converted, target, mlir_type(e.til_type(), lp), signed_target, e, state, lp)
}

priv mlir_legacy_numeric_conversion := proc(e: Expr, mut state: MlirState, mut lp: LoadedProgram) returns Str {
    ref fd : FunctionDef = funcdef_of(mlir_resolve_call(e,state,lp).unwrap())
    ref source_type:Type=e.children[1].til_type()
    target_type:=type_from_name_init_name(fd.sig.return_type,lp.ctx.scope,lp.ctx.symbols)
    source:=mlir_type(source_type,lp)
    target:=mlir_type(target_type,lp)
    value:=mlir_expr(e.children[1],state,lp)
    mut converted:=value.clone()
    if source!=target {
        if mlir_float(source).and(mlir_integer_type(target_type)) {
            // Compatibility to_x conversions keep their existing unchecked
            // C numeric conversion contract. Only cast adds the range panic.
            mut operation:="fptoui";if mlir_signed(target_type){operation="fptosi"}
            converted=mlir_value(state,format("arith.",operation," ",value," : ",source," to ",target))
        } else if mlir_integer_type(source_type).and(mlir_float(target)) {
            mut operation:="uitofp";if mlir_signed(source_type){operation="sitofp"}
            converted=mlir_value(state,format("arith.",operation," ",value," : ",source," to ",target))
        } else {converted=mlir_convert(value,source,target,mlir_signed(source_type),e,state,lp)}
    }
    return mlir_convert(converted,target,mlir_type(e.til_type(),lp),mlir_signed(target_type),e,state,lp)
}

priv mlir_pod_field_address := proc(parent: Expr, field: Str, mut state: MlirState, mut lp: LoadedProgram) returns Str {
    t := mlir_type(parent.til_type(), lp)
    if mlir_pod(t).or(mlir_record(t)).not() { return mlir_error(parent, "field access requires a supported POD struct or runtime descriptor", lp) }
    ref sd : StructDef = structdef_of(lp.ctx.scope.get_struct(type_name_ref(parent.til_type(),lp.ctx.symbols), lp.ctx.symbols).unwrap())
    ref index : USize = sd.fields_index[field]
    address := mlir_expr(parent, state, lp, true)
    return mlir_value(state, format("llvm.getelementptr ", address, "[0, ", index.to_str(), "] : (!llvm.ptr) -> !llvm.ptr, ", t))
}

priv mlir_memory_primitive := func(name: Str) returns Bool {
    switch name {
    case "to_ptr", "ptr_add", "deref", "write_ptr", "ptr_eq", "is_null", "word_bits",
         "malloc", "calloc", "realloc", "free", "memcpy", "memmove", "memset", "memcmp", "exit",
         "write_i64", "write_u8", "write_i8", "write_i16", "write_u16", "write_i32", "write_u32", "write_u64", "write_f32", "write_bool": return true
    case: return false
    }
}

priv mlir_check_pointer := func(pointer: Str, mut state: MlirState, lp: LoadedProgram) {
    zero := mlir_value(state,"llvm.mlir.zero : !llvm.ptr")
    missing := mlir_value(state,format("llvm.icmp \"eq\" ",pointer,", ",zero," : !llvm.ptr"))
    failure := mlir_label(state)
    success := mlir_label(state)
    state.text=format(state.text,"    llvm.cond_br ",missing,", ^",failure,", ^",success,"\n")
    mlir_block(failure,state)
    message := mlir_string_literal("panic: null deref\n",state,lp)
    bytes := mlir_value(state,format("llvm.extractvalue ",message,"[0] : ",mlir_type(type_from_name_init_name("Str",lp.ctx.scope,lp.ctx.symbols),lp)))
    fd := mlir_value(state,"arith.constant 2 : i32")
    count := mlir_value(state,"arith.constant 18 : i64")
    status := mlir_value(state,"arith.constant 1 : i32")
    state.externals.set("write",own "  llvm.func @write(i32, !llvm.ptr, i64) -> i64\n")
    state.externals.set("exit",own "  llvm.func @exit(i32)\n")
    mlir_value(state,format("llvm.call @write(",fd,", ",bytes,", ",count,") : (i32, !llvm.ptr, i64) -> i64"))
    state.text=format(state.text,"    llvm.call @exit(",status,") : (i32) -> ()\n    llvm.unreachable\n")
    mlir_block(success,state)
}

priv mlir_pointer_result := proc(pointer: Str, e: Expr, borrow: Bool, mut state: MlirState, mut lp: LoadedProgram,pointee:Str="",signed_value:Bool=false) returns Str {
    mut t := pointee.clone()
    if t.len()==0 {t=mlir_type(e.til_type(),lp)}
    if borrow || t=="!llvm.ptr" { return pointer.clone() }
    if t.len()==0 || t=="void" { return mlir_error(e,"unsupported pointer pointee type",lp) }
    mlir_check_pointer(pointer,state,lp)
    value:=mlir_load(pointer,t,state,"1")
    return mlir_convert(value,t,mlir_type(e.til_type(),lp),signed_value,e,state,lp)
}

priv mlir_print_call := proc(e : Expr, name : Str, mut state : MlirState, mut lp : LoadedProgram) returns Str {
    if name == "print_flush" {
        state.externals.set("putchar", own "  llvm.func @putchar(i32) -> i32\n")
        newline := mlir_value(state, "arith.constant 10 : i32")
        mlir_value(state, format("llvm.call @putchar(", newline, ") : (i32) -> i32"))
        return ""
    }
    descriptor := mlir_expr(e.children[1], state, lp, true)
    str_type := mlir_type(type_from_name_init_name("Str", lp.ctx.scope, lp.ctx.symbols), lp)
    data_slot := mlir_value(state, format("llvm.getelementptr ", descriptor, "[0, 0] : (!llvm.ptr) -> !llvm.ptr, ", str_type))
    data := mlir_load(data_slot, "!llvm.ptr", state, "1")
    count_slot := mlir_value(state, format("llvm.getelementptr ", descriptor, "[0, 1] : (!llvm.ptr) -> !llvm.ptr, ", str_type))
    count_type := mlir_count_type(lp)
    count := mlir_load(count_slot, count_type, state, "1")
    size := mlir_convert(count, count_type, "i64", false, e, state, lp)
    state.externals.set("stdout", own "  llvm.mlir.global external @stdout() : !llvm.ptr\n")
    state.externals.set("fwrite", own "  llvm.func @fwrite(!llvm.ptr, i64, i64, !llvm.ptr) -> i64\n")
    stream_slot := mlir_value(state, "llvm.mlir.addressof @stdout : !llvm.ptr")
    stream := mlir_load(stream_slot, "!llvm.ptr", state)
    one := mlir_value(state, "arith.constant 1 : i64")
    mlir_value(state, format("llvm.call @fwrite(", data, ", ", one, ", ", size, ", ", stream, ") : (!llvm.ptr, i64, i64, !llvm.ptr) -> i64"))
    return ""
}

priv mlir_memory_call := proc(e: Expr, name: Str, borrow: Bool, mut state: MlirState, mut lp: LoadedProgram) returns Str {
    if name=="exit" {
        // Core spells the status I64; libc's boundary is int, as in C output.
        raw:=mlir_expr(e.children[1],state,lp)
        code:=mlir_coerce(raw,e.children[1],"i32",state,lp)
        state.externals.set("exit",own "  llvm.func @exit(i32)\n")
        state.text=format(state.text,"    llvm.call @exit(",code,") : (i32) -> ()\n    llvm.unreachable\n")
        state.terminated=true
        return ""
    }
    if name=="malloc" || name=="calloc" || name=="realloc" {
        mut args:=""
        mut types:=""
        for i in 1..e.children.len() {
            mut t:="i64"
            if name=="realloc" && i==1 {t="!llvm.ptr"}
            value:=mlir_expr(e.children[i],state,lp,t=="!llvm.ptr")
            if i>1 {args=format(args,", ");types=format(types,", ")}
            args=format(args,value);types=format(types,t)
        }
        state.externals.set(name,own format("  llvm.func @",name,"(",types,") -> !llvm.ptr\n"))
        pointer:=mlir_value(state,format("llvm.call @",name,"(",args,") : (",types,") -> !llvm.ptr"))
        return mlir_pointer_result(pointer,e,borrow,state,lp)
    }
    pointer:=mlir_expr(e.children[1],state,lp,true)
    if name=="to_ptr" {return mlir_pointer_result(pointer,e,borrow,state,lp)}
    if name=="ptr_add" {
        offset:=mlir_expr(e.children[2],state,lp)
        result:=mlir_value(state,format("llvm.getelementptr ",pointer,"[",offset,"] : (!llvm.ptr, i64) -> !llvm.ptr, i8"))
        return mlir_pointer_result(result,e,borrow,state,lp)
    }
    if name=="deref" {
        result:=mlir_value(state,format("llvm.load ",pointer," {alignment = 1 : i64} : !llvm.ptr -> !llvm.ptr"))
        return mlir_pointer_result(result,e,borrow,state,lp)
    }
    if name=="word_bits" {return mlir_value(state,format("llvm.ptrtoint ",pointer," : !llvm.ptr to i64"))}
    if name=="ptr_eq" || name=="is_null" {
        mut other:=""
        if name=="is_null" {other=mlir_value(state,"llvm.mlir.zero : !llvm.ptr")}
        else {other=mlir_expr(e.children[2],state,lp,true)}
        return mlir_value(state,format("llvm.icmp \"eq\" ",pointer,", ",other," : !llvm.ptr"))
    }
    if name=="write_ptr" {
        value:=mlir_expr(e.children[2],state,lp,true)
        state.text=format(state.text,"    llvm.store ",value,", ",pointer," {alignment = 1 : i64} : !llvm.ptr, !llvm.ptr\n")
        return ""
    }
    if name.starts_with("write_") {
        ref fd:FunctionDef=funcdef_of(mlir_resolve_call(e,state,lp).unwrap())
        t:=mlir_type(declaration_resolved_type(fd.sig.params[1],lp.ctx.scope,lp.ctx.symbols),lp)
        raw:=mlir_expr(e.children[2],state,lp)
        mut value:=mlir_coerce(raw,e.children[2],t,state,lp)
        mut storage:=t.clone()
        if t=="i1" {storage="i8";value=mlir_value(state,format("arith.extui ",value," : i1 to i8"))}
        state.text=format(state.text,"    llvm.store ",value,", ",pointer," {alignment = 1 : i64} : ",storage,", !llvm.ptr\n")
        return ""
    }
    if name=="free" {
        switch e.children[1].node_type {
        case .Ident(id):
            ref binding:MlirBinding=state.values[id.ident_name(lp.ctx.symbols.names)]
            if binding.is_stack && e.children[1].til_type().is(Type.Dynamic).not() {return ""}
        case:
        }
        mut done:=""
        if type_name_ref(e.children[1].til_type(),lp.ctx.symbols)=="Str" {done=mlir_writable_record(pointer,state,lp)}
        state.externals.set("free",own "  llvm.func @free(!llvm.ptr)\n")
        state.text=format(state.text,"    llvm.call @free(",pointer,") : (!llvm.ptr) -> ()\n")
        if done.len()>0 {mlir_branch(done,state);mlir_block(done,state)}
        return ""
    }
    mut second:=""
    mut second_type:="!llvm.ptr"
    if name=="memset" {second_type="i32";raw:=mlir_expr(e.children[2],state,lp);second=mlir_coerce(raw,e.children[2],second_type,state,lp)}
    else {second=mlir_expr(e.children[2],state,lp,true)}
    count:=mlir_expr(e.children[3],state,lp)
    mut ret:="!llvm.ptr"
    if name=="memcmp" {ret="i32"}
    types:=format("!llvm.ptr, ",second_type,", i64")
    state.externals.set(name,own format("  llvm.func @",name,"(",types,") -> ",ret,"\n"))
    mut done:=""
    if name=="memset" && type_name_ref(e.children[1].til_type(),lp.ctx.symbols)=="Str" {done=mlir_writable_record(pointer,state,lp)}
    result:=mlir_value(state,format("llvm.call @",name,"(",pointer,", ",second,", ",count,") : (",types,") -> ",ret))
    if done.len()>0 {mlir_branch(done,state);mlir_block(done,state)}
    if name=="memcmp" {return mlir_convert(result,"i32",mlir_type(e.til_type(),lp),true,e,state,lp)}
    return ""
}

priv mlir_writable_record := func(pointer:Str,mut state:MlirState,lp:LoadedProgram) returns Str {
    t:=mlir_type(type_from_name_init_name("Str",lp.ctx.scope,lp.ctx.symbols),lp)
    cap_address:=mlir_value(state,format("llvm.getelementptr ",pointer,"[0, 2] : (!llvm.ptr) -> !llvm.ptr, ",t))
    count:=mlir_count_type(lp)
    cap:=mlir_load(cap_address,count,state,"1")
    literal:=mlir_value(state,format("arith.constant -1 : ",count))
    writable:=mlir_value(state,format("arith.cmpi ne, ",cap,", ",literal," : ",count))
    yes:=mlir_label(state);done:=mlir_label(state)
    state.text=format(state.text,"    llvm.cond_br ",writable,", ^",yes,", ^",done,"\n")
    mlir_block(yes,state)
    return done
}

priv mlir_construct_pod := proc(e: Expr, t: Str, borrow: Bool, mut state: MlirState, mut lp: LoadedProgram) returns Str {
    ref sd : StructDef = structdef_of(lp.ctx.scope.get_struct(type_name_ref(e.til_type(),lp.ctx.symbols), lp.ctx.symbols).unwrap())
    if e.children.len() != sd.fields.len()+1 { return mlir_error(e, "POD constructor fields were not lowered positionally", lp) }
    mut value := mlir_value(state, format("llvm.mlir.undef : ", t))
    for i in 0..sd.fields.len() {
        if sd.fields[i].own_type.is(OwnType.Ref).or(sd.fields[i].own_type.is(OwnType.Own)) {
            pointer:=mlir_expr(e.children[i+1],state,lp,true)
            value=mlir_value(state,format("llvm.insertvalue ",pointer,", ",value,"[",i.to_str(),"] : ",t))
            continue
        }
        ft := mlir_type(declaration_resolved_type(sd.fields[i], lp.ctx.scope, lp.ctx.symbols), lp)
        raw := mlir_expr(e.children[i+1], state, lp)
        mut field := mlir_coerce(raw, e.children[i+1], ft, state, lp)
        if ft == "i1" { field = mlir_value(state, format("arith.extui ", field, " : i1 to i8")) }
        if mlir_vector(ft) {
            // The register vector and its scalar-layout field occupy the same
            // bytes, but have different LLVM aggregate types and alignments.
            slot:=mlir_slot(ft,state)
            mlir_store(slot,field,ft,state)
            field=mlir_value(state,format("llvm.load ",slot," {alignment = 1 : i64} : !llvm.ptr -> ",mlir_field_storage(ft)))
        }
        value = mlir_value(state, format("llvm.insertvalue ", field, ", ", value, "[", i.to_str(), "] : ", t))
    }
    if borrow {
        slot := mlir_slot(t, state)
        mlir_store(slot, value, t, state)
        return slot
    }
    return value
}

priv mlir_expr := proc(e: Expr, mut state: MlirState, mut lp: LoadedProgram, borrow: Bool = false) returns Str {
    if borrow && e.node_type.is(NodeType.Literal) && e.node_type.is_literal_null().not() {
        value := mlir_expr(e, state, lp)
        t := mlir_type(e.til_type(), lp)
        slot := mlir_slot(t, state)
        mlir_store(slot, value, t, state)
        return slot
    }
    switch e.node_type {
    case .Ident(id):
        ref name : Str = id.ident_name(lp.ctx.symbols.names)
        if state.values.has(name) {
            ref mut binding : MlirBinding = state.values[name]
            if binding.native_definition_id!=0 {return mlir_error(e,"native declarations cannot be retained as runtime values",lp)}
            if binding.reference_slot.len()>0 {
                pointer:=mlir_load(binding.reference_slot,"!llvm.ptr",state)
                return mlir_pointer_result(pointer,e,borrow,state,lp,binding.type_name,binding.is_signed)
            }
            if borrow && binding.type_name != "!llvm.ptr" {
                if binding.is_ref.or(binding.is_mut).not() {
                    slot := mlir_slot(binding.type_name, state)
                    mlir_store(slot, binding.value, binding.type_name, state)
                    binding.value = slot.clone()
                    binding.is_ref = true
                    binding.is_stack = true
                    return slot
                }
                return binding.value.clone()
            }
            mut value := binding.value.clone()
            if binding.is_mut || binding.is_ref {
                if binding.is_ref && binding.is_stack.not() {mlir_check_pointer(binding.value,state,lp)}
                mut alignment:=mlir_alignment(binding.type_name)
                if binding.is_ref && binding.is_stack.not() {alignment="1"}
                value = mlir_load(binding.value,binding.type_name,state,alignment)
            }
            // Alias elimination can leave a wider type on this identifier.
            // Convert the actual binding value, not an imagined wider load.
            return mlir_convert(value, binding.type_name, mlir_type(e.til_type(), lp), binding.is_signed, e, state, lp)
        }
        // Core's immutable scalar sentinels remain declarations in the
        // prepared AST. Emit their literal/numeric-conversion initializer at
        // the target width; do not read host interpreter storage or add globals.
        for unit:ProgramUnit in lp.core_units {
            for stmt:Expr in lp.ctx.imported[unit.path].ast.children {
                if stmt.node_type.is(NodeType.Decl).not() {continue}
                ref dd:Declaration=decl_of(stmt)
                if dd.name!=name || dd.is_mut || stmt.children.len()!=1 {continue}
                if mlir_scalar(mlir_type(declaration_resolved_type(dd,lp.ctx.scope,lp.ctx.symbols),lp)).not() {continue}
                ref value:Expr=stmt.children[0]
                mut constant:=value.node_type.is(NodeType.Literal)
                if value.node_type.is(NodeType.FCall) && value.children.len()==2 {
                    ref callee:Expr=value.children[0]
                    if callee.node_type.is(NodeType.FieldAccess) {
                        constant=fieldaccess_of(callee).field_access_name(lp.ctx.symbols.names).starts_with("to_").and(value.children[1].node_type.is(NodeType.Literal))
                    }
                }
                if constant.not() {return mlir_error(e,format("unsupported non-literal core constant '",name,"'"),lp)}
                raw:=mlir_expr(value,state,lp)
                return mlir_coerce(raw,value,mlir_type(e.til_type(),lp),state,lp)
            }
        }
        return mlir_error(e, format("unsupported global or value '", name, "'"), lp)
    case .FieldAccess(field):
        switch e.children[0].node_type {
        case .Ident(owner):
            ref name:Str=owner.ident_name(lp.ctx.symbols.names)
            if state.values.has(name).not() {
                owner_type:=type_from_name_init_name(name,lp.ctx.scope,lp.ctx.symbols)
                if mlir_scalar(mlir_type(owner_type,lp)) {
                    ref definition:Expr=lp.ctx.scope.get_struct(name,lp.ctx.symbols).unwrap()
                    ref member:Declaration=def_ns_get(definition,field.field_access_name(lp.ctx.symbols.names)).unwrap()
                    if member.is_mut || member.default_value.is_none() {return mlir_error(e,"unsupported numeric namespace value",lp)}
                    ref value:Expr=member.default_expr()
                    if value.node_type.is(NodeType.Literal).not() {return mlir_error(e,"numeric namespace value is not a literal constant",lp)}
                    raw:=mlir_expr(value,state,lp)
                    return mlir_coerce(raw,value,mlir_type(e.til_type(),lp),state,lp)
                }
            }
        case:
        }
        parent_type := mlir_type(e.children[0].til_type(), lp)
        if mlir_pod(parent_type).or(mlir_record(parent_type)).not() { return mlir_error(e, "field access requires a supported POD struct or runtime descriptor", lp) }
        ref sd : StructDef = structdef_of(lp.ctx.scope.get_struct(type_name_ref(e.children[0].til_type(),lp.ctx.symbols), lp.ctx.symbols).unwrap())
        ref declaration:Declaration=sd.fields[sd.fields_index[field.field_access_name(lp.ctx.symbols.names)]]
        field_type := declaration_resolved_type(declaration, lp.ctx.scope, lp.ctx.symbols)
        address := mlir_pod_field_address(e.children[0], field.field_access_name(lp.ctx.symbols.names), state, lp)
        if declaration.own_type.is(OwnType.Ref).or(declaration.own_type.is(OwnType.Own)) {
            // Str.c_str owns its bytes, but borrowing it loads the buffer's
            // address, not the address of the descriptor's pointer slot.
            pointer:=mlir_load(address,"!llvm.ptr",state,"1")
            return mlir_pointer_result(pointer,e,borrow,state,lp,mlir_type(field_type,lp),mlir_signed(field_type))
        }
        if borrow { return address }
        // As with identifier loads, memory retains its declared width even if
        // a consuming expression has stamped a wider value type on this read.
        t := mlir_type(field_type, lp)
        mut value := ""
        if t == "i1" {
            byte := mlir_value(state, format("llvm.load ", address, " {alignment = 1 : i64} : !llvm.ptr -> i8"))
            value = mlir_value(state, format("arith.trunci ", byte, " : i8 to i1"))
        } else { value = mlir_load(address,t,state,"1") }
        return mlir_convert(value,t,mlir_type(e.til_type(),lp),mlir_signed(field_type),e,state,lp)
    case .Literal(Literal.Str(text)): return mlir_string_literal(text, state, lp)
    case .Literal(Literal.Null): return mlir_value(state,"llvm.mlir.zero : !llvm.ptr")
    case .Literal(Literal.Bool(value)):
        mut literal := "0"
        if value { literal = "1" }
        return mlir_value(state, format("arith.constant ", literal, " : i1"))
    case .Literal(Literal.Num(num)):
        if mlir_integer_type(e.til_type()) {
            value := mlir_integer(e, state, lp).unwrap()
            return mlir_value(state, format("arith.constant ", value.to_str(), " : ", mlir_type(e.til_type(), lp)))
        }
        t := mlir_type(e.til_type(),lp)
        mut bits : U64 = 0
        mut nibbles : USize = 8
        if t=="f32" {
            value:=num.to_f32();mut word:U32=0;memcpy(to_ptr(word),to_ptr(value),4);bits=word.to_u64()
        } else if t=="f64" {
            value:=num.literal_num_text().to_f64();memcpy(to_ptr(bits),to_ptr(value),8);nibbles=16
        } else {return mlir_error(e,"unsupported numeric literal type",lp)}
        return mlir_value(state,format("arith.constant ",mlir_hex_literal(bits,nibbles)," : ",t))
    case .FCall:
        ref callee : Expr = e.children[0]
        if fcall_of(e).swap_replace && type_name_ref(e.children[1].til_type(),lp.ctx.symbols)=="Str" {
            // Mirror C's marked delete-copy-free operation, not swap_bytes:
            // the RHS is already evaluated into its prepared transfer temp.
            t:=mlir_type(e.children[1].til_type(),lp)
            destination:=mlir_expr(e.children[1],state,lp,true)
            source:=mlir_expr(e.children[2],state,lp,true)
            value:=mlir_owned_record(mlir_load(source,t,state,"1"),t,state)
            no_free:=mlir_value(state,"arith.constant 0 : i8")
            state.text=format(state.text,"    llvm.call @\"til.mlir.core.Str.delete\"(",destination,", ",no_free,") : (!llvm.ptr, i8) -> ()\n")
            mlir_store(destination,value,t,state,"1")
            switch e.children[2].node_type {
            case .Ident(id):
                if state.values[id.ident_name(lp.ctx.symbols.names)].owns_wrapper {
                    state.externals.set("free",own "  llvm.func @free(!llvm.ptr)\n")
                    state.text=format(state.text,"    llvm.call @free(",source,") : (!llvm.ptr) -> ()\n")
                }
            case:
            }
            return ""
        }
        if type_is_callable_storage(callee.til_type()) { return mlir_error(e,"indirect calls are not supported",lp) }
        target := mlir_resolve_call(e,state,lp)
        if target.is_some() && state.functions.has(mlir_callable_id(target.unwrap())) {
            ref fd : FunctionDef = funcdef_of(target.unwrap())
            ref callable : MlirCallable = state.functions[mlir_callable_id(target.unwrap())]
            ref call_name : Str = callable.symbol
            mut args := ""
            mut types := ""
            stack_arguments := mlir_stack_arguments(fd, lp)
            for i in 0..fd.sig.params.len() {
                parameter_type:=mlir_parameter_type(fd,i,lp)
                t := mlir_type(parameter_type, lp)
                if (fd.sig.params[i].own_type.is(OwnType.Ref) && t != "!llvm.ptr") || mlir_record(t) || parameter_type.is(Type.Dynamic) {
                    mut address := ""
                    if mlir_record(t) { address = mlir_record_arg(e, i+1, t, state, lp) }
                    else { address = mlir_expr(e.children[i + 1], state, lp, true) }
                    if i > 0 { args = format(args, ", "); types = format(types, ", ") }
                    args = format(args, address)
                    types = format(types, "!llvm.ptr")
                    continue
                }
                mut value := mlir_expr(e.children[i + 1], state, lp)
                value = mlir_coerce(value, e.children[i + 1], t, state, lp)
                if i > 0 { args = format(args, ", "); types = format(types, ", ") }
                if stack_arguments[i] {
                    // Snapshot each stack argument before later operands run.
                    // The LLVM 18 export adapter restores call-site byval.
                    slot := mlir_slot(t, state, "8")
                    mlir_store(slot, value, t, state)
                    args = format(args, slot)
                    types = format(types, "!llvm.ptr")
                } else if mlir_pod(t) {
                    packed := mlir_pod_pack(value, t, state, lp)
                    parts := mlir_pod_parts(t, lp)
                    for j in 0..parts.len() {
                        mut chunk := packed.clone()
                        if parts.len() > 1 { chunk = mlir_value(state, format("llvm.extractvalue ", packed, "[", j.to_str(), "] : ", mlir_pod_abi(t, lp))) }
                        if j > 0 { args=format(args, ", "); types=format(types, ", ") }
                        args=format(args, chunk); types=format(types, parts[j])
                    }
                } else if t == "vector<4xf32>" {
                    lo := mlir_half(value, false, state)
                    hi := mlir_half(value, true, state)
                    args = format(args, lo, ", ", hi)
                    types = format(types, "vector<2xf32>, vector<2xf32>")
                } else if t == "vector<4xi32>" {
                    lo := mlir_i4_half(value, false, state)
                    hi := mlir_i4_half(value, true, state)
                    args = format(args, lo, ", ", hi)
                    types = format(types, "i64, i64")
                } else if t == "vector<4xi1>" {
                    value = mlir_pack_mask(value, state)
                    args = format(args, value)
                    types = format(types, "i32")
                } else if t == "i1" {
                    value = mlir_value(state, format("arith.extui ", value, " : i1 to i8"))
                    args = format(args, value)
                    types = format(types, "i8")
                } else { args = format(args, value); types = format(types, t) }
            }
            mut ret := "void"
            if fd.sig.return_type.len() > 0 {
                ret = mlir_type(type_from_name_init_name(fd.sig.return_type, lp.ctx.scope, lp.ctx.symbols), lp)
            }
            mut abi_ret := ret.clone()
            borrowed_result := fd.sig.return_own_type.is(OwnType.Ref)
            if ret == "vector<4xf32>" { abi_ret = mlir_f4_type() }
            if ret == "vector<4xi32>" { abi_ret = mlir_i4_type() }
            if ret == "i1" { abi_ret = "i8" }
            if ret == "vector<4xi1>" { abi_ret = "i32" }
            mut record_result := ""
            if mlir_record(ret) { abi_ret = mlir_record_abi(ret) }
            if mlir_pod(ret).and(mlir_return_sret(ret, lp).not()) { abi_ret = mlir_pod_abi(ret, lp) }
            if borrowed_result { abi_ret = "!llvm.ptr" }
            else if mlir_return_sret(ret, lp) {
                record_result = mlir_slot(ret, state)
                if args.len() > 0 { args = format(record_result, ", ", args); types = format("!llvm.ptr, ", types) }
                else { args = record_result.clone(); types = "!llvm.ptr" }
                abi_ret = "void"
            }
            mut result := ""
            if fd.sig.throw_types.len() > 0 {
                // Variadic packing has independent checked-set error slots.
                // Invalidate the enclosing throw proof only for its own slot.
                for i in 0..fd.sig.params.len() {
                    if fd.sig.params[i].name!="_err_kind" {continue}
                    switch e.children[i+1].node_type {
                    case .Ident(id): if id.ident_name(lp.ctx.symbols.names)==state.error_parameter {mlir_error_write(state)}
                    case:
                    }
                }
            }
            if abi_ret == "void" {
                state.text = format(state.text, "    llvm.call @\"", call_name, "\"(", args, ") : (", types, ") -> ()\n")
                if mlir_return_sret(ret, lp) { result = mlir_value(state, format("llvm.load ", record_result, " {alignment = ", mlir_alignment(ret), " : i64} : !llvm.ptr -> ", ret)) }
            } else {
                result = mlir_value(state, format("llvm.call @\"", call_name, "\"(", args, ") : (", types, ") -> ", abi_ret))
                if borrowed_result {
                    return mlir_pointer_result(result,e,borrow,state,lp,ret,mlir_signed(type_from_name_init_name(fd.sig.return_type,lp.ctx.scope,lp.ctx.symbols)))
                } else if ret == "vector<4xf32>" {
                    lo := mlir_value(state, format("llvm.extractvalue ", result, "[0] : ", abi_ret))
                    hi := mlir_value(state, format("llvm.extractvalue ", result, "[1] : ", abi_ret))
                    result = mlir_join(lo, hi, state)
                } else if ret == "vector<4xi32>" {
                    lo := mlir_value(state, format("llvm.extractvalue ", result, "[0] : ", abi_ret))
                    hi := mlir_value(state, format("llvm.extractvalue ", result, "[1] : ", abi_ret))
                    result = mlir_i4_join(lo, hi, state)
                } else if ret == "vector<4xi1>" { result = mlir_unpack_mask(result, state) }
                else if ret == "i1" { result = mlir_value(state, format("arith.trunci ", result, " : i8 to i1")) }
                else if mlir_record(ret) { result = mlir_record_cast(result, abi_ret, ret, state) }
                else if mlir_pod(ret) { result = mlir_pod_unpack(result, ret, state, lp) }
            }
            if fd.noreturn { state.text=format(state.text,"    llvm.unreachable\n");state.terminated=true }
            return result
        }
        switch callee.node_type {
        case .FieldAccess(field):
            if callee.children.len() != 1 { return mlir_error(e, "unsupported method receiver", lp) }
            ref owner : Expr = callee.children[0]
            switch owner.node_type {
            case .Ident(id):
                owner_type := type_from_name_init_name(id.ident_name(lp.ctx.symbols.names), lp.ctx.scope, lp.ctx.symbols)
                t := mlir_type(owner_type, lp)
                ref op : Str = field.field_access_name(lp.ctx.symbols.names)
                if id.ident_name(lp.ctx.symbols.names)=="Dynamic" {
                    if op=="size" {return mlir_value(state,"arith.constant 8 : i64")}
                    if op=="delete" || op=="clone" {
                        return mlir_runtime_call(e,format("Dynamic_",op),funcdef_of(mlir_resolve_call(e,state,lp).unwrap()),state,lp,borrow)
                    }
                }
                if mlir_scalar(t) && op=="size" && e.children.len()==1 {
                    mut size:USize=1
                    if t=="f32" {size=4}else if t=="f64" {size=8}else if t!="i1" {size=mlir_integer_bits(t)/8}
                    return mlir_value(state,format("arith.constant ",size.to_str()," : ",mlir_count_type(lp)))
                }
                if mlir_vector(t) && op=="size" && e.children.len()==1 {
                    mut size:USize=16
                    if t=="vector<4xi1>" {size=4}
                    return mlir_value(state,format("arith.constant ",size.to_str()," : ",mlir_count_type(lp)))
                }
                if mlir_pod(t) && op == "size" && e.children.len() == 1 {
                    size := target_emitted_size(mlir_pod_name(t), lp.ctx.scope, lp.ctx)
                    return mlir_value(state, format("arith.constant ", size.to_str(), " : ", mlir_count_type(lp)))
                }
                if mlir_record(t) || op == "to_str" || op == "to_repr" {
                    found := mlir_resolve_call(e,state,lp)
                    if found.is_none() { return mlir_error(e, "unresolved runtime method", lp) }
                    return mlir_runtime_call(e, format(id.ident_name(lp.ctx.symbols.names), "_", op), funcdef_of(found.unwrap()), state, lp, borrow)
                }
                if t.len() == 0 { return mlir_error(e, "unsupported operation type", lp) }
                if op.starts_with("to_").or(op=="from_i64") && e.children.len()==2
                    && mlir_integer_type(owner_type).or(mlir_float(t)) {
                    return mlir_legacy_numeric_conversion(e,state,lp)
                }
                element:=mlir_array_element(owner_type,lp)
                if element.is(Type.None).not() {
                    scalar:=mlir_type(element,lp)
                    if op == "len" && e.children.len() == 2 {
                        buffer := mlir_expr(e.children[1], state, lp)
                        return mlir_buffer_length(buffer, state, lp)
                    }
                    if op == "get" && e.children.len() == 4 {
                        address := mlir_checked_memory(e, false, false, scalar, state, lp)
                        if borrow { return address }
                        value:=mlir_load(address,scalar,state,"1")
                        return mlir_convert(value,scalar,mlir_type(e.til_type(),lp),mlir_signed(element),e,state,lp)
                    }
                    if op == "set" && e.children.len() == 5 { return mlir_checked_memory(e, false, true, scalar, state, lp) }
                    return mlir_error(e, format("unsupported borrowed-buffer operation '", op, "'"), lp)
                }
                if op.eq("inc").or(op.eq("dec")) && e.children.len() == 2 && mlir_integer_type(owner_type) {
                    mut known_slot:=false
                    switch e.children[1].node_type {
                    case .Ident(id):
                        ref name : Str = id.ident_name(lp.ctx.symbols.names)
                        if state.values.has(name).not() { return mlir_error(e, "increment requires a local", lp) }
                        ref binding : MlirBinding = state.values[name]
                        // Mutability was checked before hoisting. A generated
                        // binding for a ref-returning getter can be immutable
                        // even though its borrowed pointee is writable.
                        known_slot=binding.is_stack
                    case .FieldAccess, .FCall:
                    case: return mlir_error(e, "increment requires mutable storage", lp)
                    }
                    address:=mlir_expr(e.children[1],state,lp,true)
                    if known_slot.not() {mlir_check_pointer(address,state,lp)}
                    value:=mlir_load(address,t,state,"1")
                    one := mlir_value(state, format("arith.constant 1 : ", t))
                    mut operation := "addi"
                    if op == "dec" { operation = "subi" }
                    result := mlir_value(state, format("arith.", operation, " ", value, ", ", one, " : ", t))
                    mlir_store(address,result,t,state,"1")
                    return ""
                }
                if op=="cmp" && e.children.len()==3 && mlir_integer_type(owner_type).or(mlir_float(t)) {
                    a:=mlir_expr(e.children[1],state,lp)
                    b:=mlir_expr(e.children[2],state,lp)
                    mut operation:="cmpi";mut prefix:="s"
                    if mlir_float(t) {operation="cmpf";prefix="o"}else if mlir_signed(owner_type).not() {prefix="u"}
                    less:=mlir_value(state,format("arith.",operation," ",prefix,"lt, ",a,", ",b," : ",t))
                    greater:=mlir_value(state,format("arith.",operation," ",prefix,"gt, ",a,", ",b," : ",t))
                    zero:=mlir_value(state,"arith.constant 0 : i64")
                    one:=mlir_value(state,"arith.constant 1 : i64")
                    minus_one:=mlir_value(state,"arith.constant -1 : i64")
                    positive:=mlir_value(state,format("arith.select ",greater,", ",one,", ",zero," : i64"))
                    return mlir_value(state,format("arith.select ",less,", ",minus_one,", ",positive," : i64"))
                }
                if op == "fma" && e.children.len() == 4 && mlir_float(t).or(t.eq("vector<4xf32>")) {
                    a := mlir_expr(e.children[1], state, lp)
                    b := mlir_expr(e.children[2], state, lp)
                    c := mlir_expr(e.children[3], state, lp)
                    return mlir_value(state, format("llvm.intr.fma(", a, ", ", b, ", ", c, ") : (", t, ", ", t, ", ", t, ") -> ", t))
                }
                if mlir_integer_type(owner_type) && e.children.len()==3 && op.eq("div").or(op.eq("mod")).or(op.eq("shl")).or(op.eq("shr")) {
                    raw_a:=mlir_expr(e.children[1],state,lp)
                    a:=mlir_coerce(raw_a,e.children[1],t,state,lp)
                    raw_b:=mlir_expr(e.children[2],state,lp)
                    b:=mlir_coerce(raw_b,e.children[2],t,state,lp)
                    mut result:=""
                    if op.eq("div").or(op.eq("mod")) {result=mlir_scalar_divmod(a,b,t,mlir_signed(owner_type),op=="mod",state)}
                    else {result=mlir_scalar_shift(a,b,t,mlir_signed(owner_type),op=="shr",state)}
                    return mlir_convert(result,t,mlir_type(e.til_type(),lp),mlir_signed(owner_type),e,state,lp)
                }
                floating_div := op.eq("div").and(mlir_float(t).or(t.eq("vector<4xf32>")))
                if op.eq("add").or(op.eq("mul")).or(op.eq("sub")).or(floating_div) && e.children.len() == 3 {
                    a_value := mlir_expr(e.children[1], state, lp)
                    a := mlir_coerce(a_value, e.children[1], t, state, lp)
                    b_value := mlir_expr(e.children[2], state, lp)
                    b := mlir_coerce(b_value, e.children[2], t, state, lp)
                    mut suffix := "f"
                    if mlir_integer_type(owner_type) || t == "vector<4xi32>" { suffix = "i" }
                    if t == "i1" { return mlir_error(e, "Boolean arithmetic is not supported", lp) }
                    return mlir_value(state, format("arith.", op, suffix, " ", a, ", ", b, " : ", t))
                }
                if t == "i1" && op == "not" && e.children.len() == 2 {
                    a := mlir_expr(e.children[1], state, lp)
                    one := mlir_value(state, "arith.constant 1 : i1")
                    return mlir_value(state, format("arith.xori ", a, ", ", one, " : i1"))
                }
                if e.children.len() == 3 {
                    mut predicate := ""
                    switch op {
                    case "eq": predicate = "eq"
                    case "neq": predicate = "ne"
                    case "lt": predicate = "lt"
                    case "lte": predicate = "le"
                    case "gt": predicate = "gt"
                    case "gte": predicate = "ge"
                    case:
                    }
                    if predicate.len() > 0 {
                        a_value := mlir_expr(e.children[1], state, lp)
                        a := mlir_coerce(a_value, e.children[1], t, state, lp)
                        b_value := mlir_expr(e.children[2], state, lp)
                        b := mlir_coerce(b_value, e.children[2], t, state, lp)
                        if mlir_float(t) || t == "vector<4xf32>" {
                            if predicate == "ne" { predicate = "une" }
                            else { predicate = format("o", predicate) }
                            return mlir_value(state, format("arith.cmpf ", predicate, ", ", a, ", ", b, " : ", t))
                        }
                        if predicate != "eq" && predicate != "ne" {
                            mut sign := "s"
                            if mlir_integer_type(owner_type).and(mlir_signed(owner_type).not()) || t == "i1" { sign = "u" }
                            if t == "vector<4xi32>" { if mlir_unsigned_vector(owner_type, lp) { sign = "u" } }
                            predicate = format(sign, predicate)
                        }
                        return mlir_value(state, format("arith.cmpi ", predicate, ", ", a, ", ", b, " : ", t))
                    }
                }
                if mlir_vector(t) {
                    if op == "get" && e.children.len() == 4 { return mlir_checked_lane(e, t, false, state, lp) }
                    if op == "set" && e.children.len() == 5 { return mlir_checked_lane(e, t, true, state, lp) }
                    if op == "select" && e.children.len() == 4 {
                        mask := mlir_expr(e.children[1], state, lp)
                        a := mlir_expr(e.children[2], state, lp)
                        b := mlir_expr(e.children[3], state, lp)
                        return mlir_value(state, format("arith.select ", mask, ", ", a, ", ", b, " : vector<4xi1>, ", t))
                    }
                }
                if t == "vector<4xi1>" || t == "vector<4xi32>" || mlir_integer_type(owner_type) {
                    if op == "new" && e.children.len() == 5 { return mlir_construct(e, state, lp) }
                    if op == "zero" && e.children.len() == 1 { return mlir_value(state, format("arith.constant dense<0> : ", t)) }
                    if op == "splat" && e.children.len() == 2 {
                        value := mlir_expr(e.children[1], state, lp)
                        return mlir_value(state, format("vector.broadcast ", value, " : ", mlir_vector_scalar(t), " to ", t))
                    }
                    if op.eq("band").or(op.eq("bor")).or(op.eq("bxor")) && e.children.len() == 3 {
                        a := mlir_expr(e.children[1], state, lp)
                        b := mlir_expr(e.children[2], state, lp)
                        mut operation := "andi"
                        if op == "bor" { operation = "ori" }
                        if op == "bxor" { operation = "xori" }
                        return mlir_value(state, format("arith.", operation, " ", a, ", ", b, " : ", t))
                    }
                    if op == "bnot" && e.children.len() == 2 {
                        value := mlir_expr(e.children[1], state, lp)
                        mut literal:="-1";if mlir_vector(t) {literal="dense<-1>"}
                        ones := mlir_value(state, format("arith.constant ",literal," : ", t))
                        return mlir_value(state, format("arith.xori ", value, ", ", ones, " : ", t))
                    }
                    if op.eq("all").or(op.eq("any")) && e.children.len() == 2 && t == "vector<4xi1>" {
                        value := mlir_expr(e.children[1], state, lp)
                        mut operation := "and"
                        if op == "any" { operation = "or" }
                        return mlir_value(state, format("vector.reduction <", operation, ">, ", value, " : vector<4xi1> into i1"))
                    }
                }
                if t == "vector<4xi32>" && op == "div" && e.children.len() == 3 {
                    a := mlir_expr(e.children[1], state, lp)
                    b := mlir_expr(e.children[2], state, lp)
                    return mlir_i4_div(a, b, mlir_unsigned_vector(owner_type, lp), state)
                }
                if t == "vector<4xi32>" && op == "reduce_add" && e.children.len() == 2 {
                    value := mlir_expr(e.children[1], state, lp)
                    return mlir_value(state, format("vector.reduction <add>, ", value, " : vector<4xi32> into i32"))
                }
                if t == "vector<4xf32>" || t == "vector<4xi32>" {
                    if op.eq("reduce_min").or(op.eq("reduce_max")) && e.children.len() == 2 {
                        mut unsigned_lanes := false
                        if t == "vector<4xi32>" { unsigned_lanes = mlir_unsigned_vector(owner_type, lp) }
                        return mlir_reduce_minmax(e, t, unsigned_lanes, op == "reduce_max", state, lp)
                    }
                    if op == "load" && e.children.len() == 4 { return mlir_checked_memory(e, true, false, mlir_vector_scalar(t), state, lp) }
                    if op == "store" && e.children.len() == 5 { return mlir_checked_memory(e, true, true, mlir_vector_scalar(t), state, lp) }
                }
                if t == "vector<4xf32>" {
                    if op == "new" && e.children.len() == 5 { return mlir_construct(e, state, lp) }
                    if op == "splat" && e.children.len() == 2 {
                        value := mlir_expr(e.children[1], state, lp)
                        return mlir_value(state, format("vector.broadcast ", value, " : f32 to vector<4xf32>"))
                    }
                    if op == "zero" && e.children.len() == 1 { return mlir_value(state, "arith.constant dense<0.0> : vector<4xf32>") }
                    if op == "reduce_add" && e.children.len() == 2 {
                        value := mlir_expr(e.children[1], state, lp)
                        a := mlir_lane(value, 0, state)
                        b := mlir_lane(value, 1, state)
                        c := mlir_lane(value, 2, state)
                        d := mlir_lane(value, 3, state)
                        // No vector.reduction or initial +0: til's exact tree,
                        // including the sign of an all-negative-zero sum.
                        even := mlir_value(state, format("arith.addf ", a, ", ", c, " : f32"))
                        odd := mlir_value(state, format("arith.addf ", b, ", ", d, " : f32"))
                        return mlir_value(state, format("arith.addf ", even, ", ", odd, " : f32"))
                    }
                }
                if op == "clone" && e.children.len() == 2 {
                    if mlir_pod(t) {
                        ref method : Expr = mlir_resolve_call(e,state,lp).unwrap()
                        if funcdef_of(method).auto_generated.not() { return mlir_error(e, "custom POD clone methods are not supported", lp) }
                    }
                    // The typer also uses clone for a widened declaration,
                    // e.g. I64.clone(an_i32); it is not always an identity.
                    value := mlir_expr(e.children[1], state, lp)
                    return mlir_coerce(value, e.children[1], t, state, lp)
                }
                if op == "delete" && e.children.len() == 3 {
                    address:=mlir_expr(e.children[1],state,lp,true)
                    release:=mlir_expr(e.children[2],state,lp)
                    yes:=mlir_label(state);done:=mlir_label(state)
                    state.text=format(state.text,"    llvm.cond_br ",release,", ^",yes,", ^",done,"\n")
                    mlir_block(yes,state)
                    state.externals.set("free",own "  llvm.func @free(!llvm.ptr)\n")
                    state.text=format(state.text,"    llvm.call @free(",address,") : (!llvm.ptr) -> ()\n")
                    mlir_branch(done,state);mlir_block(done,state)
                    return ""
                }
                return mlir_error(e, format("unsupported operation '", op, "'"), lp)
            case: return mlir_error(e, "unsupported method receiver", lp)
            }
        case .Ident(id):
            ref name : Str = id.ident_name(lp.ctx.symbols.names)
            if name == "cast" && e.children.len() == 3 { return mlir_cast(e, state, lp) }
            if target.is_some() && funcdef_of(target.unwrap()).sig.func_type.is_bodyless() {
                if name == "print_single" || name == "print_flush" { return mlir_print_call(e, name, state, lp) }
                if mlir_memory_primitive(name) { return mlir_memory_call(e,name,borrow,state,lp) }
            }
            primitive := mlir_resolve_call(e,state,lp)
            if primitive.is_some() {
                if funcdef_of(primitive.unwrap()).sig.func_type.is_core() {
                    if name == "not" && e.children.len() == 2 {
                        value := mlir_expr(e.children[1], state, lp)
                        one := mlir_value(state, "arith.constant 1 : i1")
                        return mlir_value(state, format("arith.xori ", value, ", ", one, " : i1"))
                    }
                    if name.eq("and").or(name.eq("or")) && e.children.len() == 3 {
                        // Residual post-typing lazy primitives must keep the
                        // RHS conditional, just like the frontend's match form.
                        first := mlir_expr(e.children[1], state, lp)
                        result := mlir_slot("i1", state)
                        mlir_store(result, first, "i1", state)
                        rhs := mlir_label(state)
                        done := mlir_label(state)
                        if name == "and" { state.text = format(state.text, "    llvm.cond_br ", first, ", ^", rhs, ", ^", done, "\n") }
                        else { state.text = format(state.text, "    llvm.cond_br ", first, ", ^", done, ", ^", rhs, "\n") }
                        mlir_block(rhs, state)
                        second := mlir_expr(e.children[2], state, lp)
                        mlir_store(result, second, "i1", state)
                        mlir_branch(done, state)
                        mlir_block(done, state)
                        return mlir_value(state, format("llvm.load ", result, " {alignment = 1 : i64} : !llvm.ptr -> i1"))
                    }
                }
            }
            constructor_type := type_from_name_init_name(name, lp.ctx.scope, lp.ctx.symbols)
            constructor_mlir_type := mlir_type(constructor_type, lp)
            if mlir_pod(constructor_mlir_type).or(mlir_record(constructor_mlir_type)) { return mlir_construct_pod(e, constructor_mlir_type, borrow, state, lp) }
            if mlir_vector(constructor_mlir_type) && e.children.len() == 5 {
                // The constant folder materializes SIMD values as positional
                // struct constructors, rather than calls to .new/.splat.
                return mlir_construct(e, state, lp)
            }
            found := mlir_resolve_call(e,state,lp)
            if found.is_none() { return mlir_error(e, format("unsupported call '", name, "'"), lp) }
            return mlir_runtime_call(e, name, funcdef_of(found.unwrap()), state, lp, borrow)
        case: return mlir_error(e, "indirect calls are not supported", lp)
        }
    case: return mlir_error(e, "unsupported expression", lp)
    }
}

priv mlir_has_local_error := func(e: Expr) returns Bool {
    switch e.node_type {
    case .Decl(dd): if dd.name == "_err_kind" { return true }
    case .FuncDef, .StructDef, .EnumDef: return false
    case:
    }
    for child : Expr in e.children { if mlir_has_local_error(child) { return true } }
    return false
}

priv mlir_body := proc(body: Expr, ret: Str, mut state: MlirState, mut lp: LoadedProgram) {
    // Restore lexical bindings, not their runtime contents. An assignment to
    // an outer local stores through the same entry-block slot in either arm.
    saved_values := state.values.clone()
    saved_integers := state.integers.clone()
    saved_booleans := state.booleans.clone()
    saved_conditions := state.clear_conditions.clone()
    saved_set_conditions := state.set_conditions.clone()
    saved_error_version := state.error_version
    for stmt : Expr in body.children {
        if state.terminated { break }
        switch stmt.node_type {
        case .Decl(local):
            if stmt.children.len() != 1 {
                mlir_error(stmt, "only initialized value locals are supported", lp)
                break
            }
            if stmt.children[0].node_type.is(NodeType.FuncDef) && funcdef_of(stmt.children[0]).sig.func_type.is_bodyless() {
                // A lexical ext declaration supplies ABI metadata, not a
                // runtime callable value (e.g. U64.to_str's native formatter).
                state.values.set(local.name,own MlirBinding(native_definition_id=word_bits(to_ptr(stmt.children[0]))))
                continue
            }
            local_type := declaration_resolved_type(local, lp.ctx.scope, lp.ctx.symbols)
            t := mlir_type(local_type, lp)
            if t.len() == 0 || t == "void" { mlir_error(stmt, "unsupported local type", lp); break }
            if rhs_is_allocator_call(stmt.children[0],lp.ctx.symbols) {
                pointer:=mlir_expr(stmt.children[0],state,lp,true)
                state.values.set(local.name,own MlirBinding(value=pointer,type_name=t.clone(),is_ref=t!="!llvm.ptr",is_mut=local.is_mut,is_signed=mlir_signed(local_type),owns_wrapper=t!="!llvm.ptr"))
                continue
            }
            if local.own_type.is(OwnType.Ref) {
                if mlir_scalar(t).or(mlir_vector(t)).not() && t != "!llvm.ptr" && mlir_record(t).or(mlir_pod(t)).not() { mlir_error(stmt, "unsupported borrowed local", lp); break }
                address := mlir_expr(stmt.children[0], state, lp, true)
                mut reference_slot:=""
                if local.is_mut && local_type.is(Type.Dynamic).not() {reference_slot=mlir_slot("!llvm.ptr",state);mlir_store(reference_slot,address,"!llvm.ptr",state)}
                state.values.set(local.name, own MlirBinding(value = address, type_name = t.clone(),
                    is_mut = local.is_mut && local_type.is(Type.Dynamic).not(), is_ref = t != "!llvm.ptr", is_local_ref=true,is_dynamic=local_type.is(Type.Dynamic),reference_slot=reference_slot,is_signed = mlir_signed(local_type)))
                continue
            }
            if t == "!llvm.ptr" && local_type.is(Type.Dynamic).not() { mlir_error(stmt, "numeric Array locals must borrow existing storage", lp); break }
            integer := mlir_integer(stmt.children[0], state, lp)
            boolean := mlir_boolean(stmt.children[0], state, lp)
            raw_value := mlir_expr(stmt.children[0], state, lp)
            value := mlir_coerce(raw_value, stmt.children[0], t, state, lp)
            clear_test := mlir_tests_error_value(stmt.children[0], 0, state, lp)
            set_test := mlir_tests_error_value(stmt.children[0], 1, state, lp)
            state.clear_conditions.remove(local.name)
            state.set_conditions.remove(local.name)
            if clear_test && local.is_mut.not() { state.clear_conditions.add(own local.name.clone()) }
            if set_test && local.is_mut.not() { state.set_conditions.add(own local.name.clone()) }
            if local.name == state.error_parameter {
                if integer.is_none() { mlir_error(stmt, "error slot must start at zero", lp); break }
                if integer.unwrap() != 0 { mlir_error(stmt, "error slot must start at zero", lp); break }
                state.error_known_clear = true
            }
            state.integers.remove(local.name)
            state.booleans.remove(local.name)
            if local.is_mut.not() {
                if integer.is_some() { state.integers.set(local.name, own integer.unwrap().clone()) }
                if boolean.is_some() { state.booleans.set(local.name, own boolean.unwrap().clone()) }
            }
            if t != "!llvm.ptr" || local.is_mut {
                slot := mlir_slot(t, state)
                mlir_store(slot, value, t, state)
                state.values.set(local.name, own MlirBinding(value = slot, type_name = t.clone(), is_mut = local.is_mut, is_ref = t!="!llvm.ptr", is_stack=true, is_signed = mlir_signed(local_type)))
            } else { state.values.set(local.name, own MlirBinding(value = value, type_name = t.clone(), is_signed = mlir_signed(local_type))) }
        case .FieldAssign(assignment):
            parent_type := mlir_type(stmt.children[0].til_type(), lp)
            if mlir_pod(parent_type).or(type_name_ref(stmt.children[0].til_type(),lp.ctx.symbols)=="Str").not() { mlir_error(stmt, "field assignment requires a supported POD struct or Str descriptor", lp); break }
            ref sd : StructDef = structdef_of(lp.ctx.scope.get_struct(type_name_ref(stmt.children[0].til_type(),lp.ctx.symbols), lp.ctx.symbols).unwrap())
            ref declaration:Declaration=sd.fields[sd.fields_index[assignment.name]]
            if declaration.own_type.is(OwnType.Own) {mlir_error(stmt,"owning Str field replacement is unsupported",lp);break}
            address := mlir_pod_field_address(stmt.children[0], assignment.name, state, lp)
            if declaration.own_type.is(OwnType.Ref) {
                pointer:=mlir_expr(stmt.children[1],state,lp,true)
                mlir_store(address,pointer,"!llvm.ptr",state,"1")
                continue
            }
            ft := mlir_type(declaration_resolved_type(declaration, lp.ctx.scope, lp.ctx.symbols), lp)
            raw := mlir_expr(stmt.children[1], state, lp)
            value := mlir_coerce(raw, stmt.children[1], ft, state, lp)
            if ft == "i1" {
                byte := mlir_value(state, format("arith.extui ", value, " : i1 to i8"))
                mlir_store(address, byte, "i8", state)
            } else { mlir_store(address, value, ft, state,"1") }
        case .Assign(assignment):
            if state.values.has(assignment.name).not() { mlir_error(stmt, "assignment requires a local", lp); break }
            ref binding : MlirBinding = state.values[assignment.name]
            if binding.is_mut.not() { mlir_error(stmt, "assignment requires mutable storage", lp); break }
            if binding.is_local_ref && binding.is_dynamic.not() && mlir_reference_rhs(stmt.children[0],state,lp) {
                pointer:=mlir_expr(stmt.children[0],state,lp,true)
                mlir_store(binding.reference_slot,pointer,"!llvm.ptr",state)
                continue
            }
            if binding.is_local_ref && binding.type_name=="!llvm.ptr" && binding.is_dynamic.not() {
                mlir_error(stmt,"array descriptor replacement is unsupported",lp)
                break
            }
            address:=mlir_binding_address(binding,state)
            mut old := ""
            if assignment.save_old_delete && mlir_record(binding.type_name) {
                old = mlir_slot(binding.type_name, state)
                saved := mlir_value(state, format("llvm.load ", address, " {alignment = 1 : i64} : !llvm.ptr -> ", binding.type_name))
                mlir_store(old, saved, binding.type_name, state)
            }
            raw_value := mlir_expr(stmt.children[0], state, lp)
            value := mlir_coerce(raw_value, stmt.children[0], binding.type_name, state, lp)
            if binding.is_ref && binding.type_name == "i1" {
                byte := mlir_value(state, format("arith.extui ", value, " : i1 to i8"))
                mlir_store(address, byte, "i8", state)
            } else { mlir_store(address, value, binding.type_name, state,"1") }
            if old.len() > 0 {
                mut symbol := "til.mlir.core.Array__Str.delete"
                if binding.type_name == "!llvm.struct<(!llvm.ptr, i32, i32)>" || mlir_sret(binding.type_name) { symbol = "til.mlir.core.Str.delete" }
                no_free := mlir_value(state, "arith.constant 0 : i8")
                state.text = format(state.text, "    llvm.call @\"", symbol, "\"(", old, ", ", no_free, ") : (!llvm.ptr, i8) -> ()\n")
            }
            if assignment.name == state.error_parameter {
                zero := mlir_integer(stmt.children[0], state, lp)
                if zero.is_none() { mlir_error(stmt, "only OutOfBounds error tags are supported", lp); break }
                if zero.unwrap() > 1 { mlir_error(stmt, "only OutOfBounds error tags are supported", lp); break }
                mlir_error_write(state)
                state.error_known_clear = zero.is_some().and(zero.unwrap() == 0)
            }
        case .Return:
            if stmt.children.len() == 0 { state.text = format(state.text, "    llvm.return\n") }
            else if state.return_borrow {
                value := mlir_expr(stmt.children[0],state,lp,true)
                state.text = format(state.text,"    llvm.return ",value," : !llvm.ptr\n")
            }
            else if ret=="!llvm.ptr" {
                value:=mlir_expr(stmt.children[0],state,lp,true)
                state.text=format(state.text,"    llvm.return ",value," : !llvm.ptr\n")
            }
            else {
                mut value := mlir_expr(stmt.children[0], state, lp)
                value = mlir_coerce(value, stmt.children[0], ret, state, lp)
                // Returning a value consumes an owned raw/parameter wrapper,
                // but keeps the loaded payload. Borrowed returns above never
                // release the storage they alias.
                switch stmt.children[0].node_type {
                case .Ident(id):
                    ref name:Str=id.ident_name(lp.ctx.symbols.names)
                    if state.values[name].owns_wrapper {
                        state.externals.set("free",own "  llvm.func @free(!llvm.ptr)\n")
                        state.text=format(state.text,"    llvm.call @free(",state.values[name].value,") : (!llvm.ptr) -> ()\n")
                    }
                case:
                }
                mut abi_ret := ret.clone()
                if ret == "vector<4xf32>" { value = mlir_pack_return(value, state); abi_ret = mlir_f4_type() }
                else if ret == "vector<4xi32>" { value = mlir_pack_i4(value, state); abi_ret = mlir_i4_type() }
                else if ret == "vector<4xi1>" { value = mlir_pack_mask(value, state); abi_ret = "i32" }
                else if ret == "i1" { value = mlir_value(state, format("arith.extui ", value, " : i1 to i8")); abi_ret = "i8" }
                else if mlir_pod(ret) {
                    if mlir_return_sret(ret, lp) {
                        mlir_store("%result", value, ret, state)
                        state.text = format(state.text, "    llvm.return\n")
                        state.terminated = true
                        continue
                    }
                    value = mlir_pod_pack(value, ret, state, lp)
                    abi_ret = mlir_pod_abi(ret, lp)
                }
                else if mlir_record(ret) {
                    value = mlir_owned_record(value, ret, state)
                    if mlir_sret(ret) {
                        mlir_store("%result", value, ret, state)
                        state.text = format(state.text, "    llvm.return\n")
                        state.terminated = true
                        continue
                    }
                    abi_ret = mlir_record_abi(ret)
                    value = mlir_record_cast(value, ret, abi_ret, state)
                }
                state.text = format(state.text, "    llvm.return ", value, " : ", abi_ret, "\n")
            }
            state.terminated = true
        case .FCall: mlir_expr(stmt, state, lp, true)
        case .Body: mlir_body(stmt, ret, state, lp)
        case .If:
            known := mlir_boolean(stmt.children[0], state, lp)
            clear_test := mlir_tests_error_value(stmt.children[0], 0, state, lp)
            set_test := mlir_tests_error_value(stmt.children[0], 1, state, lp)
            if known.is_some() {
                if known.unwrap() {
                    if clear_test { state.error_known_clear = true }
                    mlir_body(stmt.children[1], ret, state, lp)
                }
                else if stmt.children.len() == 3 { mlir_body(stmt.children[2], ret, state, lp) }
            } else {
                condition := mlir_expr(stmt.children[0], state, lp)
                before_clear := state.error_known_clear
                before_conditions := state.clear_conditions.clone()
                before_set_conditions := state.set_conditions.clone()
                yes := mlir_label(state)
                no := mlir_label(state)
                merge := mlir_label(state)
                state.text = format(state.text, "    llvm.cond_br ", condition, ", ^", yes, ", ^", no, "\n")
                mlir_block(yes, state)
                if clear_test { state.error_known_clear = true }
                mlir_body(stmt.children[1], ret, state, lp)
                yes_ends := state.terminated
                yes_clear := state.error_known_clear
                if yes_ends.not() { mlir_branch(merge, state) }
                mlir_block(no, state)
                state.error_known_clear = before_clear
                if set_test { state.error_known_clear = true }
                state.clear_conditions = before_conditions
                state.set_conditions = before_set_conditions
                if stmt.children.len() == 3 { mlir_body(stmt.children[2], ret, state, lp) }
                no_ends := state.terminated
                no_clear := state.error_known_clear
                if no_ends.not() { mlir_branch(merge, state) }
                mlir_block(merge, state)
                state.error_known_clear = yes_ends.or(yes_clear).and(no_ends.or(no_clear))
                state.clear_conditions.clear()
                state.set_conditions.clear()
                if yes_ends && no_ends { state.text = format(state.text, "    llvm.unreachable\n"); state.terminated = true }
            }
        case .While:
            known := mlir_boolean(stmt.children[0], state, lp)
            if known.is_some() { if known.unwrap().not() { continue } }
            check := mlir_label(state)
            loop := mlir_label(state)
            done := mlir_label(state)
            saved_break := state.break_label.clone()
            saved_continue := state.continue_label.clone()
            saved_has_break := state.has_break
            before_clear := state.error_known_clear
            before_version := state.error_version
            state.break_label = done.clone()
            state.continue_label = check.clone()
            state.has_break = false
            mlir_branch(check, state)
            mlir_block(check, state)
            condition := mlir_expr(stmt.children[0], state, lp)
            state.text = format(state.text, "    llvm.cond_br ", condition, ", ^", loop, ", ^", done, "\n")
            mlir_block(loop, state)
            mlir_body(stmt.children[1], ret, state, lp)
            if state.terminated.not() { mlir_branch(check, state) }
            loop_breaks := state.has_break
            state.break_label = saved_break
            state.continue_label = saved_continue
            state.has_break = saved_has_break
            mlir_block(done, state)
            // A failing iteration can leave through a break before the
            // fall-through body's final proof. Never export that proof.
            if state.error_version != before_version { mlir_error_write(state) }
            else { state.error_known_clear = before_clear }
            if known.is_some() && loop_breaks.not() {
                state.text = format(state.text, "    llvm.unreachable\n")
                state.terminated = true
            }
        case .Break, .Continue:
            if state.break_label.len() == 0 { mlir_error(stmt, "loop transfer outside a loop", lp); break }
            if stmt.node_type.is(NodeType.Break) { state.has_break = true; mlir_branch(state.break_label, state) }
            else { mlir_branch(state.continue_label, state) }
        case: mlir_error(stmt, "unsupported statement", lp)
        }
    }
    state.values = saved_values
    state.integers = saved_integers
    state.booleans = saved_booleans
    if state.error_version == saved_error_version {
        state.clear_conditions = saved_conditions
        state.set_conditions = saved_set_conditions
    } else { state.clear_conditions.clear(); state.set_conditions.clear() }
}

priv mlir_function := proc(callable: MlirCallable, functions: Map(UPtr,MlirCallable), mut externals: Map(Str, Str), mut lp: LoadedProgram) returns Str {
    ref decl : Expr = mlir_callable_expr(callable,lp)
    ref fexpr : Expr = decl
    ref fd : FunctionDef = funcdef_of(fexpr)
    if fd.sig.func_type.is_bodyless() || fd.sig.func_type.is(FuncType.Macro)
        || fd.captures.len() > 0
        || fd.sig.kwargs_index >= 0 {
        return mlir_error(decl, "only ordinary non-capturing functions are supported", lp)
    }
    if fd.sig.variadic_index>=0 && decl_type_name_ref(fd.sig.params[fd.sig.variadic_index.to_usize()],lp.ctx.symbols)!="Str" {
        return mlir_error(decl,"only Str variadic parameters are supported",lp)
    }
    for error_type : Str in fd.sig.throw_types {
        if error_type != "OutOfBounds" { return mlir_error(decl, "only OutOfBounds propagation is supported", lp) }
    }
    mut state := MlirState()
    state.return_borrow = fd.sig.return_own_type.is(OwnType.Ref)
    state.functions = functions.clone()
    state.symbol_prefix = callable.symbol.clone()
    if fd.sig.throw_types.len() > 0 {
        state.error_parameter = "_err_kind"
        // The existing caller ABI starts each error-out transaction at zero.
        state.error_known_clear = true
    }
    mut signature := ""
    stack_arguments := mlir_stack_arguments(fd, lp)
    for i in 0..fd.sig.params.len() {
        ref p : Declaration = fd.sig.params[i]
        t := mlir_type(mlir_parameter_type(fd,i,lp), lp)
        if t != "!llvm.ptr" && p.own_type.is(OwnType.Ref) && t.len()>0 && t!="void" {
            if i > 0 { signature = format(signature, ", ") }
            arg := format("%p", i.to_str())
            signature = format(signature, arg, ": !llvm.ptr")
            state.values.set(p.name, own MlirBinding(value=arg, type_name=t.clone(), is_ref=true, is_mut=p.is_mut, is_signed=mlir_signed(declaration_resolved_type(p,lp.ctx.scope,lp.ctx.symbols))))
            continue
        }
        if mlir_record(t) {
            if p.own_type.is(OwnType.Shallow) { return mlir_error(decl, "shallow record parameters are unsupported", lp) }
            if i > 0 { signature = format(signature, ", ") }
            arg := format("%p", i.to_str())
            signature = format(signature, arg, ": !llvm.ptr")
            state.values.set(p.name, own MlirBinding(value = arg, type_name = t.clone(), is_ref = true, is_mut = p.is_mut, owns_wrapper = p.own_type.is(OwnType.Own)))
            continue
        }
        if t == "!llvm.ptr" && (p.own_type.is(OwnType.Ref) || declaration_resolved_type(p,lp.ctx.scope,lp.ctx.symbols).is(Type.Dynamic)) {
            if i > 0 { signature = format(signature, ", ") }
            arg := format("%p", i.to_str())
            signature = format(signature, arg, ": !llvm.ptr")
            state.values.set(p.name, own MlirBinding(value = arg, type_name = t.clone()))
            continue
        }
        if t == "!llvm.ptr" { return mlir_error(decl, "numeric Array parameters must be borrowed, not own or shallow", lp) }
        if t.len() == 0 || t == "void" || p.is_mut || p.own_type.is(OwnType.Ref).or(p.own_type.is(OwnType.Own)) {
            return mlir_error(decl, format("parameters of '", callable.name, "' must be supported immutable values"), lp)
        }
        if i > 0 { signature = format(signature, ", ") }
        arg := format("%p", i.to_str())
        if stack_arguments[i] {
            signature = format(signature, arg, ": !llvm.ptr {llvm.byval = ", mlir_byval_type(t), ", llvm.align = 8 : i64}")
            value := mlir_value(state, format("llvm.load ", arg, " {alignment = 4 : i64} : !llvm.ptr -> ", t))
            state.values.set(p.name, own MlirBinding(value = value, type_name = t.clone()))
        } else if mlir_pod(t) {
            parts := mlir_pod_parts(t, lp)
            abi := mlir_pod_abi(t, lp)
            mut value := ""
            if parts.len() > 1 { value = mlir_value(state, format("llvm.mlir.undef : ", abi)) }
            for j in 0..parts.len() {
                chunk := format(arg, "c", j.to_str())
                if j > 0 { signature = format(signature, ", ") }
                signature = format(signature, chunk, ": ", parts[j])
                if parts.len() == 1 { value = chunk.clone() }
                else { value = mlir_value(state, format("llvm.insertvalue ", chunk, ", ", value, "[", j.to_str(), "] : ", abi)) }
            }
            state.values.set(p.name, own MlirBinding(value=mlir_pod_unpack(value,t,state,lp), type_name=t.clone()))
        } else if t == "vector<4xf32>" {
            signature = format(signature, arg, "lo: vector<2xf32>, ", arg, "hi: vector<2xf32>")
            state.values.set(p.name, own MlirBinding(value = mlir_join(format(arg, "lo"), format(arg, "hi"), state), type_name = t.clone()))
        } else if t == "vector<4xi32>" {
            signature = format(signature, arg, "lo: i64, ", arg, "hi: i64")
            state.values.set(p.name, own MlirBinding(value = mlir_i4_join(format(arg, "lo"), format(arg, "hi"), state), type_name = t.clone()))
        } else {
            mut value := arg.clone()
            mut abi_t := t.clone()
            if t == "i1" {
                abi_t = "i8"
                value = mlir_value(state, format("arith.trunci ", arg, " : i8 to i1"))
            }
            if t == "vector<4xi1>" {
                abi_t = "i32"
                value = mlir_unpack_mask(arg, state)
            }
            signature = format(signature, arg, ": ", abi_t)
            extension := mlir_integer_extension(declaration_resolved_type(p,lp.ctx.scope,lp.ctx.symbols))
            if extension.len()>0 {signature=format(signature," {llvm.",extension,"}")}
            state.values.set(p.name, own MlirBinding(value = value, type_name = t.clone(), is_signed = mlir_signed(declaration_resolved_type(p, lp.ctx.scope, lp.ctx.symbols))))
        }
    }
    // Address-taking is observable (including across branches). Give each
    // value parameter one stable native-layout slot, not a fresh spill at
    // each to_ptr/borrow use. LLVM can promote slots that do not escape.
    for name:Str in state.values.keys {
        ref mut binding:MlirBinding=state.values[name]
        if binding.type_name!="!llvm.ptr" && binding.is_ref.not() {
            slot:=mlir_slot(binding.type_name,state)
            mlir_store(slot,binding.value,binding.type_name,state)
            binding.value=slot.clone();binding.is_ref=true;binding.is_stack=true
        }
    }
    mut ret := "void"
    if fd.sig.return_type.len() > 0 {
        ret = mlir_type(type_from_name_init_name(fd.sig.return_type, lp.ctx.scope, lp.ctx.symbols), lp)
    }
    if ret.len() == 0 || (ret == "!llvm.ptr" && state.return_borrow.not() && type_from_name_init_name(fd.sig.return_type,lp.ctx.scope,lp.ctx.symbols).is(Type.Dynamic).not()) { return mlir_error(decl, "unsupported return type", lp) }
    if callable.symbol == "til.mlir.main" && (ret != "void" || fd.sig.params.len() > 0) {
        return mlir_error(decl, "main must take no arguments and return no value", lp)
    }
    if state.error_parameter.len() == 0 && mlir_has_local_error(fexpr.children[0]) { state.error_parameter = "_err_kind" }
    mlir_body(fexpr.children[0], ret, state, lp)
    if state.terminated.not() {
        if ret != "void" { return mlir_error(decl, "missing value return", lp) }
        state.text = format(state.text, "    llvm.return\n")
    }
    ref name : Str = callable.symbol
    mut linkage := ""
    if callable.exported.not() || name == "til.mlir.main" { linkage = "internal " }
    mut result := format("  llvm.func ", linkage, "@\"", name, "\"(", signature, ")")
    if state.return_borrow.not() && mlir_return_sret(ret, lp) {
        if signature.len() > 0 { signature = format(", ", signature) }
        result = format("  llvm.func ", linkage, "@\"", name, "\"(%result: !llvm.ptr {llvm.sret = ", ret, "}", signature, ")")
    }
    mut extension := ""
    if fd.sig.return_type.len()>0 {extension=mlir_integer_extension(type_from_name_init_name(fd.sig.return_type,lp.ctx.scope,lp.ctx.symbols))}
    if state.return_borrow { result=format(result," -> !llvm.ptr") }
    else if extension.len()>0 {
        mut abi:=ret.clone();if ret=="i1" {abi="i8"}
        result=format(result," -> (",abi," {llvm.",extension,"})")
    }
    else if ret == "vector<4xf32>" { result = format(result, " -> ", mlir_f4_type()) }
    else if ret == "vector<4xi32>" { result = format(result, " -> ", mlir_i4_type()) }
    else if ret == "i1" { result = format(result, " -> i8") }
    else if ret == "vector<4xi1>" { result = format(result, " -> i32") }
    else if mlir_record(ret).and(mlir_sret(ret).not()) { result = format(result, " -> ", mlir_record_abi(ret)) }
    else if mlir_pod(ret).and(mlir_return_sret(ret, lp).not()) { result = format(result, " -> ", mlir_pod_abi(ret, lp)) }
    else if ret != "void" && mlir_return_sret(ret, lp).not() { result = format(result, " -> ", ret) }
    mut entry := ""
    if state.allocations.len() > 0 { entry = format("    %alloc_count = llvm.mlir.constant(1 : i64) : i64\n", state.allocations) }
    for symbol : Str in state.externals.keys { externals.set(symbol, own state.externals[symbol].clone()) }
    return format(state.globals, result, " {\n", entry, state.text, "  }\n")
}

mlir_codegen_translate := proc(mut lp: LoadedProgram, path: Str, source_functions: Set(Str)) returns I32 {
    lp.mlir_needs_core = false
    mut text := "module attributes {llvm.target_triple = \"x86_64-pc-linux-gnu\"} {\n"
    root_path := lp.units[lp.units.len()-1].path.clone()
    context_enter_file(lp.ctx, root_path)
    mut has_main := false
    mut externals := Map(Str, Str).new()
    inventory := mlir_callable_inventory(lp,source_functions)
    mut functions := Map(UPtr,MlirCallable).new()
    mut symbols := Map(Str,UPtr).new()
    mut selected := Set(UPtr).new()
    mut pending := Vec(UPtr).new()
    for callable : MlirCallable in inventory {
        ref function : Expr = mlir_callable_expr(callable,lp)
        id := mlir_callable_id(function)
        if symbols.has(callable.symbol) && symbols[callable.symbol] != id {
            context_enter_file(lp.ctx,callable.source_path)
            mlir_error(function,format("callable symbol collision: ",callable.symbol),lp)
        }
        symbols.set(callable.symbol,own id.clone())
        functions.set(id,own callable.clone())
        is_main := callable.path.eq(root_path).and(callable.member < 0).and(callable.name == "main")
        if is_main { has_main=true }
        if lp.cur_mode.is_library.and(callable.exported).or(is_main) {
            selected.add(own id.clone())
            pending.push(own id.clone())
        }
    }
    mut next : USize = 0
    while next < pending.len() {
        ref callable : MlirCallable = functions[pending[next]]
        ref function : Expr = mlir_callable_expr(callable,lp)
        context_enter_file(lp.ctx,callable.source_path)
        mlir_collect_calls(function.children[0],functions,selected,pending,lp)
        next++
    }
    // Validate source data surfaces independently of callable reachability.
    // A fieldless namespace is metadata; its functions do not need an owner
    // instance, a receiver parameter or any special calling convention.
    for unit : ProgramUnit in lp.units {
        context_enter_file(lp.ctx,unit.path)
        for stmt : Expr in lp.ctx.imported[unit.path].ast.children {
            switch stmt.node_type {
            case .Decl(dd):
                if mlir_source_name(unit.path,dd,source_functions).not() { continue }
                if stmt.children.len() != 1 { mlir_error(stmt,"unsupported top-level declaration",lp); continue }
                if stmt.children[0].node_type.is(NodeType.FuncDef) { continue }
                mut namespace_functions := false
                if is_struct_or_enum(stmt) {
                    ref definition : Expr = stmt.children[0]
                    ref members : Vec(Declaration) = def_ns_decls(definition)
                    for i in 0..members.len() {
                        ref member : Declaration = members[i]
                        ref name : Str = def_ns_name_at(definition,i)
                        if mlir_source_member(unit.path,dd,name,source_functions).not().or(member.default_value.is_none()) { continue }
                        if member.default_expr().node_type.is(NodeType.FuncDef) { namespace_functions=true }
                        else { mlir_error(member.default_expr(),format("namespace values are not supported: ",dd.name,".",name),lp) }
                    }
                }
                alias_type := mlir_type(type_from_name_init_name(dd.name,lp.ctx.scope,lp.ctx.symbols),lp)
                if alias_type.len().eq(0).or(alias_type=="void").and(namespace_functions.not())
                    .and(unit.path.eq(root_path).or(lp.cur_mode.is_library)) {
                    mlir_error(stmt,format("unsupported module declaration '",dd.name,"'"),lp)
                }
            case: mlir_error(stmt,"unsupported top-level statement",lp)
            }
        }
    }
    // Preserve source-unit/declaration order. Pointer identity is used only
    // for lookups, never to order emitted functions or construct symbol names.
    for callable : MlirCallable in inventory {
        if selected.has(mlir_callable_id(mlir_callable_expr(callable,lp))) {
            context_enter_file(lp.ctx,callable.source_path)
            text=format(text,mlir_function(callable,functions,externals,lp))
        }
    }
    context_enter_file(lp.ctx,root_path)
    if lp.cur_mode.is_library.not() {
        if has_main.not() { println("error: MLIR backend requires a no-argument main"); return 1 }
        text = format(text, "  llvm.func @main() -> i32 {\n    llvm.call @\"til.mlir.main\"() : () -> ()\n    %zero = llvm.mlir.constant(0 : i32) : i32\n    llvm.return %zero : i32\n  }\n")
    }
    for symbol : Str in externals.keys {
        text = format(text, externals[symbol])
        if symbol.starts_with(lp.ctx.builder_core_c_prefix) { lp.mlir_needs_core = true }
    }
    if lp.ctx.errors > 0 { return 1 }
    File.writefile(path, format(text, "}\n"))
    return 0
}

// LLVM 18 exports parameter ABI attributes on functions, but not llvm.call.
// Lowering alone can appear to work because the instruction selector consults
// the callee; optimizers require the attributes on the call itself. Restore
// them from the actual exported declarations before Clang runs any passes.
priv MlirLlvmSignature := struct {
    name := ""
    open : USize = 0
    close : USize = 0
}

priv MlirLlvmAbi := struct {
    parameters := Vec(Str).new()
    result := ""
}

priv mlir_llvm_extension := func(text: Str) returns Str {
    for word : Str in text.split(" ") {
        if word=="signext" || word=="zeroext" {return word.clone()}
    }
    return ""
}

priv mlir_llvm_close := func(text: Str, open: USize) returns USize {
    mut depth : I64 = 0
    mut quoted := false
    for i in open..text.len() {
        ref byte : I8 = text.unsafe_get(i)
        if byte == '"' { quoted = quoted.not() }
        if quoted { continue }
        if byte == '(' { depth++ }
        if byte == ')' { depth--; if depth == 0 { return i } }
    }
    panic("unclosed LLVM function/ABI attribute signature")
}

priv mlir_llvm_signature := func(line: Str) returns Option(MlirLlvmSignature) {
    at := line.find("@")
    if at < 0 { return Option(MlirLlvmSignature).None }
    mut quoted := false
    for i in at.to_usize()+1..line.len() {
        ref byte : I8 = line.unsafe_get(i)
        if byte == '"' { quoted = quoted.not() }
        if byte == '(' && quoted.not() {
            return Option(MlirLlvmSignature).Some(MlirLlvmSignature(
                name=line.substr(at.to_usize()+1,i-at.to_usize()-1).trim(),
                open=i,close=mlir_llvm_close(line,i)))
        }
    }
    panic("LLVM direct function has no parameter list")
}

priv mlir_llvm_parameters := func(text: Str) returns Vec(Str) {
    mut parameters := Vec(Str).new()
    if text.trim().len() == 0 { return parameters }
    mut depth : I64 = 0
    mut quoted := false
    mut start : USize = 0
    for i in 0..text.len() {
        ref byte : I8 = text.unsafe_get(i)
        if byte == '"' { quoted = quoted.not() }
        if quoted { continue }
        if byte == '(' || byte == '{' || byte == '[' || byte == '<' { depth++ }
        if byte == ')' || byte == '}' || byte == ']' || byte == '>' { depth-- }
        if byte == ',' && depth == 0 {
            parameters.push(own text.substr(start,i-start).trim())
            start=i+1
        }
    }
    if quoted || depth != 0 { panic("unbalanced LLVM parameter types") }
    parameters.push(own text.substr(start,text.len()-start).trim())
    return parameters
}

priv mlir_llvm_parameter_abi := func(parameter: Str) returns Str {
    for kind in array(Str,"byval","sret") {
        position := parameter.find(format(" ",kind,"("))
        if position < 0 { continue }
        start := position.to_usize()+1
        close := mlir_llvm_close(parameter,start+kind.len())
        mut result := parameter.substr(start,close-start+1)
        tail := parameter.substr(close+1,parameter.len()-close-1)
        alignment := tail.find(" align ")
        if alignment >= 0 {
            digits := tail.substr(alignment.to_usize()+7,tail.len()-alignment.to_usize()-7)
            mut end : USize = 0
            while end < digits.len() {
                ref byte : I8 = digits.unsafe_get(end)
                if byte < '0' || byte > '9' { break }
                end++
            }
            if end == 0 { panic("LLVM ABI alignment has no value") }
            result=format(result," align ",digits.substr(0,end))
        }
        return result
    }
    return mlir_llvm_extension(parameter)
}

mlir_llvm_call_attributes := func(text: Str) returns Str {
    lines := text.split("\n")
    mut functions := Map(Str,MlirLlvmAbi).new()
    for line : Str in lines {
        trimmed := line.trim()
        if trimmed.starts_with("define ").or(trimmed.starts_with("declare ")).not() { continue }
        signature := mlir_llvm_signature(line).unwrap()
        parameters := mlir_llvm_parameters(line.substr(signature.open+1,signature.close-signature.open-1))
        mut attributes := Vec(Str).new()
        mut any := false
        for parameter : Str in parameters {
            abi := mlir_llvm_parameter_abi(parameter)
            any=any.or(abi.len()>0)
            attributes.push(own abi)
        }
        extension:=mlir_llvm_extension(line.substr(0,line.find("@").to_usize()))
        if any || extension.len()>0 { functions.set(signature.name,own MlirLlvmAbi(parameters=attributes,result=extension)) }
    }
    mut rendered_lines := Vec(Str).new()
    mut total : USize = 0
    for i in 0..lines.len() {
        ref line : Str = lines[i]
        trimmed := line.trim()
        is_call := trimmed.starts_with("call ").or(trimmed.starts_with("tail call ")).or(trimmed.starts_with("musttail call "))
            .or(trimmed.starts_with("%").and(trimmed.contains(" = call ").or(trimmed.contains(" = tail call ")).or(trimmed.contains(" = musttail call "))))
        mut rendered := line.clone()
        if is_call {
            signature := mlir_llvm_signature(line)
            if signature.is_some() {
                call := signature.unwrap()
                if functions.has(call.name) {
                    ref abi_info : MlirLlvmAbi = functions[call.name]
                    ref attributes : Vec(Str) = abi_info.parameters
                    parameters := mlir_llvm_parameters(line.substr(call.open+1,call.close-call.open-1))
                    if parameters.len() != attributes.len() { panic("LLVM call ABI argument count mismatch: ",call.name) }
                    mut arguments := ""
                    for j in 0..parameters.len() {
                        ref parameter : Str = parameters[j]
                        ref abi : Str = attributes[j]
                        if j > 0 { arguments=format(arguments,", ") }
                        if abi.len() == 0 { arguments=format(arguments,parameter); continue }
                        if abi=="signext" || abi=="zeroext" {
                            present:=mlir_llvm_extension(parameter)
                            if present.len()>0 {
                                if present!=abi {panic("LLVM integer call extension disagrees: ",call.name)}
                                arguments=format(arguments,parameter)
                            } else {
                                separator:=parameter.find(" ")
                                if separator<0 {panic("LLVM integer ABI argument has no value: ",call.name)}
                                arguments=format(arguments,parameter.substr(0,separator.to_usize())," ",abi,parameter.substr(separator.to_usize(),parameter.len()-separator.to_usize()))
                            }
                        } else if parameter.contains(" byval(").or(parameter.contains(" sret(")) {
                            if parameter.contains(abi).not() { panic("LLVM call ABI attributes disagree: ",call.name) }
                            arguments=format(arguments,parameter)
                        } else {
                            if parameter.starts_with("ptr ").not() { panic("LLVM ABI argument is not an opaque pointer: ",call.name) }
                            arguments=format(arguments,"ptr ",abi," ",parameter.strip_prefix("ptr "))
                        }
                    }
                    mut prefix:=line.substr(0,call.open+1)
                    if abi_info.result.len()>0 {
                        present:=mlir_llvm_extension(line.substr(0,line.find("@").to_usize()))
                        if present.len()>0 {
                            if present!=abi_info.result {panic("LLVM call result extension disagrees: ",call.name)}
                        } else {
                            position:=prefix.find("call ")
                            if position<0 {panic("LLVM call result has no call opcode: ",call.name)}
                            end:=position.to_usize()+5
                            prefix=format(prefix.substr(0,end),abi_info.result," ",prefix.substr(end,prefix.len()-end))
                        }
                    }
                    rendered=format(prefix,arguments,line.substr(call.close,line.len()-call.close))
                }
            }
        }
        if i > 0 { total++ }
        total=total+rendered.len()
        rendered_lines.push(own rendered)
    }
    mut output := Str.with_capacity(total)
    for i in 0..rendered_lines.len() {
        if i > 0 { output.push_str("\n") }
        output.push_str(rendered_lines[i])
    }
    return output
}
