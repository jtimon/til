mode lib
import("../loader")
import("common")
import("../../std/file")

// Locals and temporaries have frame slots, so nested calls cannot clobber
// earlier operands; globals have process-lifetime writable slots. Frames
// preserve SysV alignment; aggregates keep their target-sized outer storage.
priv FasmDefinition := struct {
    path := ""
    declaration : USize = 0
    member : I64 = -1
    nested := Vec(USize).new()
    capture_signatures := Map(Str, Str).new()
}

priv FasmGlobal := struct {
    label := ""
    til_type := Type.None
    address := false
    pointer := false
    boxed := false
    reference := false
    signature := ""
}

priv FasmProgram := struct {
    definitions := Map(Str, FasmDefinition).new()
    labels := Map(Str, Str).new()
    pending := Vec(Str).new()
    source_names := Set(Str).new()
    globals := Map(Str, FasmGlobal).new()
    global_data := ""
    callable_data := ""
}

// Globals use the same value/pointer distinction as frame bindings. Their
// slots live in the executable's writable segment, never an init frame.
priv fasm_bind_globals := func(mut state: FasmState) {
    for i in 0..state.program.globals.len() {
        ref name : Str = state.program.globals.keys[i]
        ref global : FasmGlobal = state.program.globals.values[i]
        fasm_bind(name, global.til_type, own format("qword [", global.label, "]"),
            global.address, global.pointer, global.boxed, global.reference, state)
        if global.signature.len() > 0 { state.signatures.set(name, own global.signature.clone()) }
    }
}

priv fasm_temporary_global := func(name: Str) returns Bool {
    return name.starts_with("hoisted__").or(name.starts_with("_va_")).or(name.starts_with("_err_"))
}

priv fasm_collect_global := proc(stmt: Expr, mut program: FasmProgram, mut lp: LoadedProgram) {
    ref dd : Declaration = decl_of(stmt)
    if fasm_temporary_global(dd.name) { return }
    t := declaration_resolved_type(dd, lp.ctx.scope, lp.ctx.symbols)
    if stmt.children.len() != 1 || fasm_scalar(t).or(fasm_aggregate(t, lp)).not() {
        fasm_error(stmt, "unsupported global type or initializer", lp)
        return
    }
    if dd.external_symbol.len() > 0 { fasm_error(stmt, "external globals are not supported", lp); return }
    boxed := type_is_callable_storage(t).not().and(dd.gc_storage.is(GcStorage.HeapBox).or(rhs_is_allocator_call(stmt.children[0], lp.ctx.symbols)))
    reference := dd.own_type.is(OwnType.Ref)
    address := fasm_aggregate(t, lp).and(reference.or(boxed).not())
    pointer := fasm_scalar(t).and(t.is(Type.Dynamic).not()).and(reference.or(boxed))
    label := format("global", program.globals.len().to_str())
    mut bytes : USize = 8
    if address { bytes = fasm_type_size(t, lp); if bytes == 0 { bytes = 1 } }
    program.global_data = format(program.global_data, "align 8\n", label, ": rb ", bytes.to_str(), "\n")
    program.globals.set(dd.name, own FasmGlobal(label=label, til_type=t.clone(),
        address=address, pointer=pointer, boxed=boxed, reference=reference,
        signature=fasm_signature_name(stmt.children[0], t, Map(Str, Str).new(), program, lp)))
}

// Keep the canonical unit order and lowered initializer statements. Namespace
// data has a flattened symbol, like namespace methods, but is stored once.
priv fasm_global_body := proc(root: Expr, phase: USize, mut program: FasmProgram, mut lp: LoadedProgram) returns Expr {
    mut body := Expr.new(own NodeType.Body, root.line, root.col)
    for stmt : Expr in root.children {
        if stmt.node_type.is(NodeType.Decl) {
            if stmt.children.len() == 1 {
                ref value : Expr = stmt.children[0]
                if value.node_type.is(NodeType.StructDef).or(value.node_type.is(NodeType.EnumDef)) {
                    ref members : Vec(Declaration) = def_ns_decls(value)
                    for position : I64 in ns_const_eval_order(decl_of(stmt).name, value, lp.ctx.symbols) {
                        i := position.to_usize()
                        ref member : Declaration = members[i]
                        if value.node_type.is(NodeType.EnumDef) && enum_variant_index(value, def_ns_name_at(value, i)) >= 0 { continue }
                        if member.default_value.is_none() { continue }
                        ref initial : Expr = member.default_expr()
                        if initial.node_type.is(NodeType.FuncDef).or(initial.node_type.is(NodeType.StructDef)).or(initial.node_type.is(NodeType.EnumDef)) { continue }
                        if phase == 2 { continue }
                        if initial.node_type.is(NodeType.Literal) != (phase == 0) { continue }
                        mut declaration := member.clone()
                        declaration.name = format(decl_of(stmt).name, "_", def_ns_name_at(value, i))
                        declaration.default_value = Option(Expr).None
                        mut global := Expr.new(own NodeType.Decl(own declaration), stmt.line, stmt.col)
                        global.add_child(own initial.clone())
                        fasm_collect_global(global, program, lp)
                        body.add_child(own global)
                    }
                    continue
                }
                if value.node_type.is(NodeType.FuncDef) && funcdef_of(value).captures.len() == 0 { continue }
                if stmt.til_type().is(Type.None) && value.node_type.is(NodeType.Ident) { continue }
            }
            if stmt.til_type().is(Type.StructDef).or(stmt.til_type().is(Type.EnumDef)) { continue }
            if phase == 1 { continue }
            if fasm_temporary_global(decl_of(stmt).name).not() && stmt.children.len() == 1 && stmt.children[0].node_type.is(NodeType.Literal) {
                if phase != 0 { continue }
            } else if phase != 2 { continue }
            fasm_collect_global(stmt, program, lp)
        } else if phase != 2 { continue }
        body.add_child(own stmt.clone())
    }
    return body
}

priv fasm_namespace_name := func(e: Expr, lp: LoadedProgram, state: FasmState) returns Str {
    if fa_is_ns(e, lp.ctx.scope, lp.ctx.symbols).not() { return "" }
    ref owner : Expr = e.children[0]
    mut instance:=true
    switch owner.node_type {
    case .Ident(id): instance=state.values.has(id.ident_name(lp.ctx.symbols.names))
    case:
    }
    if instance.and(is_struct_type(owner.til_type())) {
        ref definition:Expr=lp.ctx.scope.get_struct(type_name_ref(owner.til_type(),lp.ctx.symbols),lp.ctx.symbols).unwrap()
        ref sd:StructDef=structdef_of(definition)
        // A value's actual field wins over a same-named namespace method
        // (for example source.size versus NamespaceSized.size()).
        switch e.node_type {
        case .FieldAccess(field): if sd.fields_index.has(field.field_access_name(lp.ctx.symbols.names)) { return "" }
        case .FieldAssign(field): if sd.fields_index.has(field.name) { return "" }
        case: UNREACHABLE("namespace access without a field")
        }
    }
    mut owner_name := ""
    if is_named_type(owner.til_type()) { owner_name = type_name_ref(owner.til_type(), lp.ctx.symbols).clone() }
    else { owner_name = ident_of(owner).ident_name(lp.ctx.symbols.names).clone() }
    ref name : Str = resolve_type_alias_for_name(lp.ctx.scope, owner_name, lp.ctx.symbols)
    switch e.node_type {
    case .FieldAccess(field): return format(name, "_", field.field_access_name(lp.ctx.symbols.names))
    case .FieldAssign(field): return format(name, "_", field.name)
    case: UNREACHABLE("namespace global without a field"); return ""
    }
}

priv FasmState := struct {
    ref program : FasmProgram
    text := ""
    slots : USize = 0
    labels : USize = 0
    values := Map(Str, Str).new()
    value_types := Map(Str, Type).new()
    addresses := Set(Str).new()
    pointers := Set(Str).new()
    boxes := Set(Str).new()
    no_free := Set(Str).new()
    references := Set(Str).new()
    parameters := Set(Str).new()
    signatures := Map(Str, Str).new()
    return_type := Type.None
    return_ref := false
    return_buffer := ""
    outer_parameter := ""
    outer_heap := ""
    interface_name := ""
    data := ""
    prefix := ""
    literals : USize = 0
    break_label := ""
    continue_label := ""
}

priv fasm_bind := func(name: Str, shallow t: Type, own slot: Str, address: Bool,
    pointer: Bool, box: Bool, reference: Bool, mut state: FasmState) {
    state.values.set(name, own slot)
    state.value_types.set(name, own t.clone())
    state.addresses.remove(name)
    state.pointers.remove(name)
    state.boxes.remove(name)
    state.references.remove(name)
    state.parameters.remove(name)
    state.no_free.remove(name)
    state.signatures.remove(name)
    if address { state.addresses.add(own name.clone()) }
    if pointer { state.pointers.add(own name.clone()) }
    if box { state.boxes.add(own name.clone()) }
    if reference { state.references.add(own name.clone()) }
}

priv fasm_simd_supported := func(sd: StructDef, lp: LoadedProgram) returns Bool {
    if sd.simd_width == 0 { return false }
    lane := declaration_resolved_type(sd.fields[0], lp.ctx.scope, lp.ctx.symbols)
    if lane.eq(Type.Primitive(Primitive.I8)).or(lane.eq(Type.Primitive(Primitive.U8))) { return sd.simd_width >= 16 }
    if lane.eq(Type.Primitive(Primitive.I16)).or(lane.eq(Type.Primitive(Primitive.U16))) { return sd.simd_width >= 8 }
    if lane.eq(Type.Primitive(Primitive.F32)).or(lane.eq(Type.Primitive(Primitive.I32))).or(lane.eq(Type.Primitive(Primitive.U32))) { return sd.simd_width>=4 }
    if lane==Type.Primitive(Primitive.F64) { return sd.simd_width>=2 }
    return lane.eq(Type.Primitive(Primitive.Bool)).and(sd.simd_width>=2)
}

priv fasm_simd := func(shallow t: Type, lp: LoadedProgram) returns Bool {
    if is_struct_type(t).not() { return false }
    definition:=lp.ctx.scope.get_struct(type_name_ref(t,lp.ctx.symbols),lp.ctx.symbols)
    if definition.is_none() { return false }
    if definition.unwrap().node_type.is(NodeType.StructDef).not() { return false }
    return fasm_simd_supported(structdef_of(definition.unwrap()),lp)
}

priv fasm_aggregate := func(shallow t: Type, lp: LoadedProgram) returns Bool {
    if is_struct_type(t).or(is_enum_type(t)).not() { return false }
    definition := lp.ctx.scope.get_struct(type_name_ref(t, lp.ctx.symbols), lp.ctx.symbols)
    if definition.is_none() { return false }
    if definition.unwrap().node_type.is(NodeType.EnumDef) { return true }
    ref sd : StructDef = structdef_of(definition.unwrap())
    return sd.simd_width.eq(0).or(fasm_simd_supported(sd,lp))
}

priv fasm_interface_owner := func(name: Str, program: FasmProgram, lp: LoadedProgram) returns Str {
    ref location : FasmDefinition = program.definitions.get(name)!
    if location.member < 0 || location.nested.len() > 0 { return "" }
    ref unit : ImportUnit = lp.ctx.imported.get(location.path)!
    ref declaration : Expr = unit.ast.children.unsafe_get(location.declaration)
    ref definition : Expr = declaration.children[0]
    if definition.node_type.is(NodeType.StructDef).not() { return "" }
    if structdef_of(definition).is_interface.not() { return "" }
    return decl_of(declaration).name.clone()
}

priv fasm_interface_dispatchable := func(name: Str, program: FasmProgram, lp: LoadedProgram) returns Bool {
    owner := fasm_interface_owner(name, program, lp)
    if owner.len() == 0 { return false }
    ref fd : FunctionDef = funcdef_of(fasm_definition(name, program, lp))
    if fd.auto_generated && name.eq(format(owner,"_clone")).not() { return false }
    if fd.sig.params.len() == 0 { return false }
    if decl_type_name_ref(fd.sig.params[0], lp.ctx.symbols) != owner { return false }
    if fd.sig.return_type.eq(owner).and(fd.sig.return_own_type.is(OwnType.Ref)) { return false }
    return interface_method_requires_concrete_types(fd, owner, lp.ctx).not()
}

priv fasm_type_size := func(shallow t: Type, lp: LoadedProgram) returns USize {
    if t.is(Type.Dynamic).or(type_is_callable_storage(t)) { return 8 }
    switch t {
    case .Primitive(p):
        switch p {
        case .I8, .U8, .Bool: return 1
        case .I16, .U16: return 2
        case .I32, .U32, .F32: return 4
        case .I64, .U64, .F64: return 8
        }
    case: return target_value_size(type_name_ref(t, lp.ctx.symbols), lp.ctx.scope, lp.ctx)
    }
}

priv fasm_enum_def := func(shallow t: Type, lp: LoadedProgram) returns ref Expr {
    return codegen_enum_definition(t, lp.ctx).unwrap()
}

priv fasm_enum_literal_index := func(e: Expr, lp: LoadedProgram) returns I32 {
    if is_enum_type(e.til_type()).not().or(fa_is_ns(e, lp.ctx.scope, lp.ctx.symbols).not()) { return -1 }
    return codegen_enum_variant_index(e, type_name_ref(e.til_type(), lp.ctx.symbols), fasm_enum_def(e.til_type(), lp), lp.ctx.symbols)
}

// Tagged unions include the pointer-alignment member in the shared layout.
// Niche enums instead contain one native pointer and have no separate tag.
priv fasm_enum_payload_offset := func(definition: Expr, lp: LoadedProgram) returns USize {
    mut alignment : USize = 8
    ref ed : EnumDef = enumdef_of(definition)
    for i in 0..ed.variants.len() {
        payload := enum_variant_type(definition, i.to_i32())
        if payload.len() == 0 || enum_variant_payload_ref(definition, i.to_i32()) { continue }
        mut bytes : USize = 0
        mut field_alignment : USize = 1
        target_value_size_align(payload, lp.ctx.scope, lp.ctx, bytes, field_alignment)
        if field_alignment > alignment { alignment = field_alignment }
    }
    return align_up(enum_tag_size(definition), alignment)
}

priv fasm_enum_tag := proc(e: Expr, shallow t: Type, mut state: FasmState, mut lp: LoadedProgram) {
    ref definition : Expr = fasm_enum_def(t, lp)
    variant := fasm_enum_literal_index(e, lp)
    if variant >= 0 {
        fasm_emit(state, format("mov rax, ", enum_variant_tag_at(definition, variant).to_str()))
        return
    }
    fasm_pointer(e, state, lp)
    if enum_is_niche(definition) {
        // Expose the declared tag, not a 0/1 surrogate: explicit values and
        // a payload variant declared before the empty variant are legal.
        some := enum_niche_some_index(definition)
        mut none : I32 = 0
        if some == 0 { none = 1 }
        fasm_emit(state, format("cmp qword [rax], 0\n    mov rax, ", enum_variant_tag_at(definition, none).to_str(),
            "\n    mov rcx, ", enum_variant_tag_at(definition, some).to_str(), "\n    cmovne rax, rcx"))
    } else {
        fasm_load_scalar(type_from_name_init_name(enum_tag_type(definition), lp.ctx.scope, lp.ctx.symbols), state)
    }
}

priv fasm_enum_is := proc(e: Expr, shallow t: Type, mut state: FasmState, mut lp: LoadedProgram) {
    fasm_enum_tag(e.children[1], t, state, lp)
    left := fasm_slot(state)
    fasm_emit(state, format("mov ", left, ", rax"))
    fasm_enum_tag(e.children[2], t, state, lp)
    fasm_emit(state, format("cmp rax, ", left, "\n    sete al\n    movzx eax, al"))
}

priv fasm_enum_constructor := proc(e: Expr, shallow t: Type, variant: I32, mut state: FasmState, mut lp: LoadedProgram) {
    ref definition : Expr = fasm_enum_def(t, lp)
    size := fasm_type_size(t, lp)
    storage := fasm_value_slot(t, state, lp)
    destination := fasm_slot(state)
    fasm_emit(state, format("lea rax, ", storage.strip_prefix("qword "), "\n    mov ", destination,
        ", rax\n    mov rdi, rax\n    xor esi, esi\n    mov rdx, ", size.to_str(), "\n    call rt_memset\n    mov rax, ", destination))
    payload := enum_variant_type(definition, variant)
    niche := enum_is_niche(definition)
    if niche.not() {
        fasm_emit(state, format("mov rcx, rax\n    mov rax, ", enum_variant_tag_at(definition, variant).to_str()))
        fasm_store_scalar(type_from_name_init_name(enum_tag_type(definition), lp.ctx.scope, lp.ctx.symbols), state)
    }
    if payload.len() > 0 {
        pt := type_from_name_init_name(payload, lp.ctx.scope, lp.ctx.symbols)
        if fasm_scalar(pt).or(fasm_aggregate(pt, lp)).not() { fasm_error(e, "unsupported enum payload type", lp); return }
        ref value : Expr = e.children[1]
        if niche {
            if enum_variant_payload_ref(definition, variant) { fasm_pointer(value, state, lp) }
            else { fasm_owned(value, state, lp) }
            fasm_emit(state, format("mov rcx, ", destination, "\n    mov [rcx], rax"))
        } else if enum_variant_payload_ref(definition, variant) {
            fasm_pointer(value, state, lp)
            fasm_emit(state, format("mov rcx, ", destination, "\n    mov [rcx+", fasm_enum_payload_offset(definition, lp).to_str(), "], rax"))
        } else if type_is_callable_storage(pt) {
            fasm_callable_copy(value, true, state, lp)
            fasm_emit(state, format("mov rcx, ", destination, "\n    mov [rcx+", fasm_enum_payload_offset(definition, lp).to_str(), "], rax"))
        } else if fasm_aggregate(pt, lp) {
            snapshot := fasm_snapshot(value, pt, state, lp)
            fasm_emit(state, format("mov rdi, ", destination, "\n    add rdi, ", fasm_enum_payload_offset(definition, lp).to_str(),
                "\n    lea rsi, ", snapshot.strip_prefix("qword "), "\n    mov rdx, ", fasm_type_size(pt, lp).to_str(), "\n    call rt_memcpy"))
        } else {
            fasm_expr(value, state, lp)
            fasm_emit(state, format("mov rcx, ", destination, "\n    add rcx, ", fasm_enum_payload_offset(definition, lp).to_str()))
            if pt.is(Type.Dynamic) { fasm_emit(state, "mov [rcx], rax") }
            else { fasm_store_scalar(pt, state) }
        }
    }
    fasm_emit(state, format("mov rax, ", destination))
}

// ctx.struct_layouts belongs to the HOST interpreter. Native layout must use
// the shared target-size/alignment query, including USize aliases in fields.
priv fasm_field_layout := func(shallow owner: Type, name: Str, lp: LoadedProgram) returns FieldLayout {
    ref sd : StructDef = structdef_of(lp.ctx.scope.get_struct(type_name_ref(owner, lp.ctx.symbols), lp.ctx.symbols).unwrap())
    mut offset : USize = 0
    for i in 0..sd.fields.len() {
        ref field : Declaration = sd.field_at(i)
        mut bytes : USize = 8
        mut alignment : USize = 8
        if field.own_type.is(OwnType.Shallow) {
            target_value_size_align(decl_type_name_ref(field, lp.ctx.symbols), lp.ctx.scope, lp.ctx, bytes, alignment)
        }
        offset = align_up(offset, alignment)
        if sd.field_name_at(i) == name { return FieldLayout(offset=offset, size=bytes, own_type=field.own_type) }
        offset = offset + bytes
    }
    panic("missing FASM field layout: ", name)
}

priv fasm_value_slot := func(shallow t: Type, mut state: FasmState, lp: LoadedProgram) returns Str {
    bytes := fasm_type_size(t, lp)
    // Even a zero-sized struct needs an addressable frame slot.
    if bytes > 0 { state.slots = state.slots + (bytes + 7) / 8 - 1 }
    return fasm_slot(state)
}

priv fasm_collect_closures := func(mut e: Expr, path: Str, declaration: USize, member: I64,
    mut nested: Vec(USize), mut program: FasmProgram) {
    mut name := ""
    switch e.node_type {
    case .FuncDef(fd):
        if e.children.len() == 0 { return }
        if fd.closure_name.len() == 0 { fd.closure_name = format("@callable:", program.definitions.len().to_str()) }
        name = fd.closure_name.clone()
    case .BodyValue(bd): name = bd.closure_name.clone()
    case:
    }
    if name.len() > 0 {
        program.definitions.set(name, own FasmDefinition(path=path.clone(), declaration=declaration,
            member=member, nested=nested.clone()))
    }
    for i in 0..e.children.len() {
        nested.push(own i.clone())
        fasm_collect_closures(e.children[i], path, declaration, member, nested, program)
        nested.remove_at(nested.len() - 1)!
    }
}

priv fasm_collect := func(mut e: Expr, path: Str, mut program: FasmProgram) {
    for position in 0..e.children.len() {
        ref mut stmt : Expr = e.children[position]
        if stmt.node_type.is(NodeType.Decl) && stmt.children.len() == 1 {
            ref dd : Declaration = decl_of(stmt)
            ref mut value : Expr = stmt.children[0]
            if value.node_type.is(NodeType.FuncDef) {
                program.definitions.set(dd.name, own FasmDefinition(path=path.clone(), declaration=position))
            } else if value.node_type.is(NodeType.StructDef).or(value.node_type.is(NodeType.EnumDef)) {
                ref members : Vec(Declaration) = def_ns_decls(value)
                for i in 0..members.len() {
                    ref member : Declaration = members[i]
                    if member.default_value.is_some() && member.default_expr().node_type.is(NodeType.FuncDef) {
                        name := format(dd.name, "_", def_ns_name_at(value, i))
                        program.definitions.set(name, own FasmDefinition(path=path.clone(), declaration=position, member=i.to_i64()))
                    }
                }
            }
            fasm_collect_closures(value, path, position, -1, Vec(USize).new(), program)
            if value.node_type.is(NodeType.StructDef).or(value.node_type.is(NodeType.EnumDef)) {
                ref mut members : Vec(Declaration) = def_ns_decls(value)
                for i in 0..members.len() {
                    if members[i].default_value.is_some() {
                        fasm_collect_closures(members[i].default_expr(), path, position, i.to_i64(), Vec(USize).new(), program)
                    }
                }
            }
        }
    }
}

priv fasm_definition := func(name: Str, program: FasmProgram, lp: LoadedProgram) returns ref Expr {
    ref location : FasmDefinition = program.definitions[name]
    ref unit : ImportUnit = lp.ctx.imported[location.path]
    ref declaration : Expr = unit.ast.children.unsafe_get(location.declaration)
    ref mut value : Expr = declaration.children.unsafe_get(0)
    if location.member >= 0 { value = def_ns_decls(value)[location.member.to_usize()].default_expr() }
    for index : USize in location.nested { value = value.children[index] }
    return value
}

priv fasm_request := func(name: Str, mut program: FasmProgram) returns Str {
    if program.labels.has(name).not() {
        program.labels.set(name, own format("f", program.labels.len().to_str()))
        program.pending.push(own name.clone())
    }
    return program.labels[name].clone()
}

priv fasm_captures := func(e: Expr) returns ref Vec(Declaration) {
    switch e.node_type {
    case .FuncDef(fd): return fd.captures
    case .BodyValue(bd): return bd.captures
    case: panic("FASM callable definition is not a function or Body")
    }
}

priv fasm_closure_name := func(e: Expr) returns Str {
    switch e.node_type {
    case .FuncDef(fd): return fd.closure_name.clone()
    case .BodyValue(bd): return bd.closure_name.clone()
    case: panic("FASM callable definition is not a function or Body")
    }
}

priv fasm_callable_fd := func(e: Expr) returns FunctionDef {
    switch e.node_type {
    case .FuncDef(fd): return fd.clone()
    case .BodyValue(bd):
        mut fd := FunctionDef(captures=bd.captures.clone(), closure_name=bd.closure_name.clone())
        fd.sig.func_type = FuncType.Proc
        return fd
    case: panic("FASM callable definition is not a function or Body")
    }
}

priv fasm_signature_name := func(e: Expr, shallow t: Type, signatures: Map(Str, Str), program: FasmProgram, lp: LoadedProgram) returns Str {
    if is_funcptr_sig(t) { return type_name_ref(t, lp.ctx.symbols).clone() }
    switch e.node_type {
    case .FuncDef: return fasm_closure_name(e)
    case .Ident(id):
        ref name : Str = id.ident_name(lp.ctx.symbols.names)
        if signatures.has(name) { return signatures[name].clone() }
        if program.globals.has(name) { return program.globals[name].signature.clone() }
        if program.definitions.has(name) { return name.clone() }
    case:
    }
    return ""
}

priv fasm_callable_slot := proc(e: Expr, mut state: FasmState, mut lp: LoadedProgram) {
    fasm_pointer(e, state, lp)
}

priv fasm_callable_copy := proc(e: Expr, clone_borrowed: Bool, mut state: FasmState, mut lp: LoadedProgram) {
    fasm_expr(e, state, lp)
    if clone_borrowed.and(e.node_type.is(NodeType.Ident).or(e.node_type.is(NodeType.FieldAccess))) {
        fasm_emit(state, "mov rdi, rax\n    call rt_closure_clone")
    }
}

priv fasm_callable_replace := proc(e: Expr, destination: Str, drop_old: Bool, clone_borrowed: Bool,
    mut state: FasmState, mut lp: LoadedProgram) {
    fasm_callable_copy(e, clone_borrowed, state, lp)
    value := fasm_slot(state)
    fasm_emit(state, format("mov ", value, ", rax"))
    if drop_old {
        fasm_emit(state, format("mov rax, ", destination, "\n    mov rdi, [rax]\n    call rt_til_closure_delete"))
    }
    fasm_emit(state, format("mov rcx, ", destination, "\n    mov rax, ", value, "\n    mov [rcx], rax"))
}

priv fasm_static_callable := func(name: Str, slot: Bool, mut program: FasmProgram) returns Str {
    key := format("@value:", name)
    if program.labels.has(key).not() {
        target := fasm_request(name, program)
        label := format("callableValue", program.labels.len().to_str())
        program.labels.set(key, own label.clone())
        program.callable_data = format(program.callable_data, "align 8\n", label, ": dq ", target, ",0,0,0\n")
    }
    if slot.not() { return program.labels[key].clone() }
    slot_key := format("@slot:", name)
    if program.labels.has(slot_key).not() {
        label := format("callableSlot", program.labels.len().to_str())
        program.labels.set(slot_key, own label.clone())
        program.callable_data = format(program.callable_data, "align 8\n", label, ": dq ", program.labels[key], "\n")
    }
    return program.labels[slot_key].clone()
}

priv fasm_capture_inline := func(cap: Declaration) returns Bool {
    // An owned opaque pointer retains its independent allocation. Ref captures
    // retain their borrowed address; all other captures have private value space.
    return cap.own_type.is(OwnType.Ref).or(cap.own_type.is(OwnType.Own).and(cap.til_type.is(Type.Dynamic))).not()
}

// Offsets relative to the environment, followed by its total size. The pointer
// table preserves borrowed/heap-owned identity; private value space follows it.
priv fasm_capture_layout := func(captures: Vec(Declaration), lp: LoadedProgram) returns Vec(USize) {
    mut offsets := Vec(USize).new()
    mut bytes := captures.len() * 8
    for cap : Declaration in captures {
        offsets.push(own bytes.clone())
        if fasm_capture_inline(cap) {
            mut size := fasm_type_size(cap.til_type, lp)
            if size < 8 { size = 8 }
            bytes = bytes + ((size + 7) / 8) * 8
        }
    }
    offsets.push(own bytes)
    return offsets
}

// RAX points to the source value. Copy into this closure's private storage,
// without allocating a capture box. Existing owned heap outers can stay external.
priv fasm_capture_copy := func(cap: Declaration, offset: USize, environment: Str, mut state: FasmState, lp: LoadedProgram) {
    destination := fasm_slot(state)
    fasm_emit(state, format("mov rsi, rax\n    mov rdi, ", environment, "\n    add rdi, ", offset.to_str(),
        "\n    mov ", destination, ", rdi\n    mov rdx, ", fasm_type_size(cap.til_type, lp).to_str(), "\n    call rt_memcpy\n    mov rax, ", destination))
    if fasm_is_str(cap.til_type, lp) {
        label := state.labels.to_str()
        state.labels++
        fasm_emit(state, format("mov rdx, rax\n    load_size rcx, [rdx+STR_CAP]\n    mov r9, CAP_LIT\n    cmp rcx, r9\n    jne .capture_str", label,
            "\n    store_size [rdx+STR_CAP], CAP_VIEW\n.capture_str", label, ":\n    mov rax, rdx"))
    }
}

priv fasm_closure_value := proc(e: Expr, name: Str, mut state: FasmState, mut lp: LoadedProgram) {
    target := fasm_request(name, state.program)
    ref captures : Vec(Declaration) = fasm_captures(e)
    if captures.len() == 0 {
        label := fasm_static_callable(name, false, state.program)
        fasm_emit(state, format("mov rax, ", label))
        return
    }
    layout := fasm_capture_layout(captures, lp)
    descriptor := fasm_slot(state)
    environment := fasm_slot(state)
    fasm_emit(state, format("mov rdi, ", (layout[captures.len()] + 32).to_str(), "\n    call rt_malloc\n    mov ", descriptor,
        ", rax\n    add rax, 32\n    mov ", environment, ", rax"))
    for i in 0..captures.len() {
        ref cap : Declaration = captures[i]
        mut source := Expr.new(own ident_node(lp.ctx.symbols.intern(cap.name)), e.line, e.col)
        source.set_til_type(cap.til_type.clone())
        if type_is_callable_storage(cap.til_type) {
            signature := fasm_signature_name(source, cap.til_type, state.signatures, state.program, lp)
            state.program.definitions[name].capture_signatures.set(cap.name, own signature)
        }
        if cap.own_type.is(OwnType.Ref) { fasm_pointer(source, state, lp) }
        else if fasm_capture_inline(cap) {
            fasm_pointer(source, state, lp)
            if cap.own_type.is(OwnType.Own).and(type_is_callable_storage(cap.til_type).not()).and(fasm_boxed(source, state, lp)) {
                // Moving an existing heap owner preserves its pointee address.
            } else {
                mut done := ""
                if cap.own_type.is(OwnType.Own) && state.outer_heap.len() > 0 && cap.name == state.outer_parameter {
                    done = format(".capture_outer", state.labels.to_str())
                    state.labels++
                    fasm_emit(state, format("cmp ", state.outer_heap, ", 0\n    jne ", done))
                }
                fasm_capture_copy(cap, layout[i], environment, state, lp)
                if done.len() > 0 { fasm_emit(state, format(done, ":")) }
            }
        } else { fasm_owned(source, state, lp) }
        fasm_emit(state, format("mov rdx, ", environment, "\n    mov [rdx+", (i * 8).to_str(), "], rax"))
    }
    drop := fasm_request(format("@drop:", name), state.program)
    clone := fasm_request(format("@clone:", name), state.program)
    fasm_emit(state, format("mov rax, ", descriptor, "\n    mov qword [rax], ", target,
        "\n    mov rdx, ", environment, "\n    mov [rax+8], rdx\n    mov qword [rax+16], ", drop, "\n    mov qword [rax+24], ", clone))
}

priv fasm_environment_function := func(name: Str, clone: Bool, mut program: FasmProgram, mut lp: LoadedProgram) returns Str {
    owner := name.strip_prefix("@clone:").strip_prefix("@drop:")
    ref expr : Expr = fasm_definition(owner, program, lp)
    context_enter_file(lp.ctx, program.definitions[owner].path)
    ref captures : Vec(Declaration) = fasm_captures(expr)
    layout := fasm_capture_layout(captures, lp)
    mut state := FasmState(program=program)
    state.prefix = program.labels[name].clone()
    source := fasm_slot(state)
    fasm_emit(state, format("mov ", source, ", rdi"))
    mut destination := ""
    mut environment := ""
    if clone {
        destination = fasm_slot(state)
        environment = fasm_slot(state)
        fasm_emit(state, format("mov rdi, ", (layout[captures.len()] + 32).to_str(), "\n    call rt_malloc\n    mov ", destination,
            ", rax\n    mov rdi, rax\n    mov rsi, ", source, "\n    sub rsi, 32\n    mov edx, 32\n    call rt_memcpy\n    mov rax, ", destination,
            "\n    lea rdx, [rax+32]\n    mov [rax+8], rdx\n    mov ", environment, ", rdx"))
    }
    for i in 0..captures.len() {
        ref cap : Declaration = captures[i]
        if clone.not().and(cap.own_type.is(OwnType.Ref)) { continue }
        fasm_emit(state, format("mov rax, ", source, "\n    mov rax, [rax+", (i * 8).to_str(), "]"))
        if clone {
            if cap.own_type.is(OwnType.Ref) {
                // Ref captures in both environments point at the same storage.
            } else if type_is_callable_storage(cap.til_type) {
                fasm_emit(state, format("mov rdi, [rax]\n    call rt_closure_clone\n    mov rdx, ", environment,
                    "\n    add rdx, ", layout[i].to_str(), "\n    mov [rdx], rax\n    mov rax, rdx"))
            } else if fasm_aggregate(cap.til_type, lp) {
                input := fasm_slot(state)
                fasm_emit(state, format("mov ", input, ", rax\n    mov rdi, ", input, "\n    mov rax, ", environment,
                    "\n    add rax, ", layout[i].to_str()))
                if fasm_is_str(cap.til_type, lp) { fasm_emit(state, "call rt_str_clone") }
                else {
                    target := fasm_request(format(type_name_ref(cap.til_type, lp.ctx.symbols), "_clone"), program)
                    fasm_emit(state, format("call ", target))
                }
            } else if fasm_capture_inline(cap) { fasm_capture_copy(cap, layout[i], environment, state, lp) }
            else { fasm_box_copy(cap.til_type, state, lp) }
            fasm_emit(state, format("mov rdx, ", environment, "\n    mov [rdx+", (i * 8).to_str(), "], rax"))
        } else {
            value := fasm_slot(state)
            fasm_emit(state, format("mov ", value, ", rax"))
            fasm_emit(state, "mov rdi, rax")
            if fasm_capture_inline(cap) {
                if cap.own_type.is(OwnType.Own).and(type_is_callable_storage(cap.til_type).not()) {
                    external := format(".capture_external", state.labels.to_str())
                    done := format(".capture_drop", state.labels.to_str())
                    state.labels++
                    fasm_emit(state, format("mov rdx, ", source, "\n    add rdx, ", layout[i].to_str(),
                        "\n    cmp rdi, rdx\n    jne ", external))
                    fasm_destroy(cap.til_type, false, state, lp, call_free=true)
                    fasm_emit(state, format("jmp ", done, "\n", external, ":\n    mov rdi, ", value))
                    fasm_destroy(cap.til_type, true, state, lp)
                    fasm_emit(state, format(done, ":"))
                } else { fasm_destroy(cap.til_type, false, state, lp, call_free=true) }
            } else { fasm_destroy(cap.til_type, true, state, lp) }
        }
    }
    if clone { fasm_emit(state, format("mov rax, ", destination)) }
    fasm_emit(state, "leave\n    ret")
    bytes := ((state.slots * 8 + 15) / 16) * 16
    return format(state.prefix, ":\n    push rbp\n    mov rbp, rsp\n    sub rsp, ", bytes.to_str(), "\n", state.text, state.data)
}

priv fasm_indirect_signature := func(e: Expr, state: FasmState, lp: LoadedProgram) returns Option(ref Expr) {
    ref callee : Expr = e.children[0]
    signature := fasm_signature_name(callee, callee.til_type(), state.signatures, state.program, lp)
    if state.program.definitions.has(signature) { return safe_ref(fasm_definition(signature, state.program, lp)) }
    if signature.len() > 0 {
        definition := lp.ctx.scope.lookup_func_name(signature, lp.ctx.symbols)
        if definition.is_some() { return definition }
    }
    return resolve_fn_sig(e, lp.ctx.scope, lp.ctx.symbols)
}

priv fasm_call_returns_ref := func(e: Expr, state: FasmState, lp: LoadedProgram) returns Bool {
    if fcall_is_direct(e) { return fcall_returns_ref(e, lp.ctx.scope, lp.ctx.symbols) != 0 }
    if e.children[0].til_type().is(Type.Body) { return false }
    signature := fasm_indirect_signature(e, state, lp)
    return signature.is_some().and(funcdef_of(signature.unwrap()).sig.return_own_type.is(OwnType.Ref))
}

priv fasm_indirect_call := proc(e: Expr, mut state: FasmState, mut lp: LoadedProgram, as_pointer: Bool) {
    ref callee : Expr = e.children[0]
    mut fd := FunctionDef()
    if callee.til_type().is(Type.Body).not() {
        definition := fasm_indirect_signature(e, state, lp)
        if definition.is_none() { fasm_error(e, "unsupported indirect-call signature", lp); return }
        fd = funcdef_of(definition.unwrap()).clone()
    }
    if e.children.len() > 7 { fasm_error(e, "at most six arguments are supported", lp); return }
    mut borrowed_cast := false
    if callee.node_type.is(NodeType.FCall).and(callee.children.len() == 3) {
        switch callee.children[0].node_type {
        case .Ident(id): borrowed_cast = id.ident_name(lp.ctx.symbols.names).eq("cast").and(callee.children[1].til_type().is(Type.Dynamic))
        case:
        }
    }
    if borrowed_cast { fasm_pointer(callee.children[1], state, lp); fasm_emit(state, "mov rax, [rax]") }
    else { fasm_expr(callee, state, lp) }
    callable := fasm_slot(state)
    fasm_emit(state, format("mov ", callable, ", rax"))
    mut arguments := Vec(Str).new()
    for i in 1..e.children.len() {
        fasm_call_argument(e, i, fd, state, lp)
        slot := fasm_slot(state)
        fasm_emit(state, format("mov ", slot, ", rax"))
        arguments.push(own slot)
    }
    for i in 0..arguments.len() { fasm_emit(state, format("mov ", fasm_register(i), ", ", arguments[i])) }
    // R10 carries the private environment without reducing the existing six
    // integer argument slots. The callee saves it before making any calls.
    code := fasm_slot(state)
    fasm_emit(state, format("mov r11, ", callable, "\n    mov r10, [r11+8]\n    mov r11, [r11]\n    mov ", code, ", r11"))
    fasm_call_outer(e, fd, state, lp)
    result := fasm_call_result(fd, state, lp)
    if result.len() > 0 { fasm_emit(state, format("lea rax, ", result.strip_prefix("qword "))) }
    fasm_emit(state, format("call ", code))
    fasm_release_arguments(e, fd, arguments, state, lp)
    fasm_finish_call(e, fd, state, lp, as_pointer)
}

priv fasm_callee_name := func(e: Expr, lp: LoadedProgram) returns Str {
    switch e.children[0].node_type {
    case .Ident(id): return id.ident_name(lp.ctx.symbols.names).clone()
    case .FieldAccess(field):
        ref owner : Expr = e.children[0].children[0]
        ref id : IdentData = ident_of(owner)
        ref name : Str = resolve_type_alias_for_name(lp.ctx.scope, id.ident_name(lp.ctx.symbols.names), lp.ctx.symbols)
        if name == "USize" { return format(lp.ctx.target_usize_pname,"_",field.field_access_name(lp.ctx.symbols.names)) }
        if name == "UPtr" { return format(lp.ctx.target_uptr_pname,"_",field.field_access_name(lp.ctx.symbols.names)) }
        return format(name, "_", field.field_access_name(lp.ctx.symbols.names))
    case: return ""
    }
}

// True only for an owned outer wrapper. References and inline field storage
// must not be released merely because their address carries an aggregate.
priv fasm_boxed := func(e: Expr, state: FasmState, lp: LoadedProgram) returns Bool {
    if type_is_callable_storage(e.til_type()) { return false }
    if fasm_enum_literal_index(e, lp) >= 0 { return false }
    global_name := fasm_namespace_name(e, lp, state)
    if global_name.len() > 0 { return state.boxes.has(global_name) }
    switch e.node_type {
    case .Ident(id):
        ref name : Str = id.ident_name(lp.ctx.symbols.names)
        if state.outer_heap.len() > 0 && name == state.outer_parameter { return false }
        return state.boxes.has(name)
    case .PrecomputedSequence: return false
    case .FieldAccess(field):
        return fasm_field_decl(e.children[0], field.field_access_name(lp.ctx.symbols.names), lp).own_type.is(OwnType.Own)
    case .FCall:
        if fcall_is_direct(e).not() {
            if fasm_call_returns_ref(e, state, lp) { return false }
        } else {
            name := fasm_callee_name(e, lp)
            if state.program.definitions.has(name) {
                ref fd : FunctionDef = funcdef_of(fasm_definition(name, state.program, lp))
                if fd.sig.return_own_type.is(OwnType.Ref) { return false }
                if fd.sig.return_type == "Dynamic" && fd.sig.return_own_type.is(OwnType.Own) { return true }
            }
        }
        return rhs_is_allocator_call(e, lp.ctx.symbols)
    case: return false
    }
}

priv fasm_static_number := func(value: U64, bytes: USize) returns Str {
    mut text := "db "
    for i in 0..bytes {
        if i > 0 { text = format(text, ",") }
        text = format(text, value.shr((i * 8).to_u64()).band(255).to_str())
    }
    return format(text, "\n")
}

priv fasm_numeric_bits := func(value: LiteralNumData, shallow t: Type) returns U64 {
    mut bits:U64=0
    if t==Type.Primitive(Primitive.F32) {
        number:=numeric_literal_parse_text(value.text).to_f32()
        memcpy(to_ptr(bits),to_ptr(number),4)
    } else if t==Type.Primitive(Primitive.F64) {
        number:=numeric_literal_parse_text(value.text).to_f64()
        memcpy(to_ptr(bits),to_ptr(number),8)
    } else { return value.to_u64() }
    return bits
}

priv fasm_static_label := func(mut state: FasmState) returns Str {
    label := format(state.prefix, "p", state.literals.to_str())
    state.literals++
    return label
}

priv fasm_static_box := proc(e: Expr, shallow t: Type, mut state: FasmState, mut lp: LoadedProgram) returns Str {
    label := fasm_static_label(state)
    contents := fasm_static_value(e, t, state, lp)
    state.data = format(state.data, "align 8\n", label, ":\n", contents)
    return label
}

// PrecomputedSequence is the frontend's canonical serialized value. Emit a
// read-only template and invoke its real til clone method, as the C backend
// does, so owned elements are never shared accidentally with the template.
priv fasm_static_value := proc(e: Expr, shallow t: Type, mut state: FasmState, mut lp: LoadedProgram) returns Str {
    if type_is_callable_storage(t) {
        mut name := ""
        switch e.node_type {
        case .Ident(id): name = id.ident_name(lp.ctx.symbols.names).clone()
        case .FuncDef, .BodyValue: name = fasm_closure_name(e)
        case .FieldAccess: name = fasm_namespace_name(e, lp, state)
        case:
        }
        if state.program.definitions.has(name).not() { fasm_error(e, "unsupported precomputed callable", lp); return "" }
        if fasm_captures(fasm_definition(name, state.program, lp)).len() > 0 { fasm_error(e, "precomputed callable environment is not supported", lp); return "" }
        return format("dq ", fasm_static_callable(name, false, state.program), "\n")
    }
    if is_enum_type(t) {
        if rhs_is_clone_fcall(e, lp.ctx.symbols) { return fasm_static_value(e.children[1], t, state, lp) }
        ref definition : Expr = fasm_enum_def(t, lp)
        mut variant := codegen_enum_variant_index(e, type_name_ref(t, lp.ctx.symbols), definition, lp.ctx.symbols)
        switch e.node_type {
        case .Literal(Literal.Num(n)): variant = enum_variant_index_for_tag(definition, n.to_u64().to_i64())
        case:
        }
        if variant < 0 { fasm_error(e, "unsupported precomputed enum value", lp); return "" }
        payload := enum_variant_type(definition, variant)
        mut text := ""
        mut used : USize = 0
        if enum_is_niche(definition) {
            if payload.len() == 0 { return "dq 0\n" }
            pt := type_from_name_init_name(payload, lp.ctx.scope, lp.ctx.symbols)
            return format("dq ", fasm_static_box(e.children[1], pt, state, lp), "\n")
        }
        text = fasm_static_number(enum_variant_tag_at(definition, variant).cast(U64), enum_tag_size(definition))
        used = enum_tag_size(definition)
        if payload.len() > 0 {
            offset := fasm_enum_payload_offset(definition, lp)
            if offset > used { text = format(text, "db ", (offset - used).to_str(), " dup(0)\n") }
            pt := type_from_name_init_name(payload, lp.ctx.scope, lp.ctx.symbols)
            if enum_variant_payload_ref(definition, variant) {
                text = format(text, "dq ", fasm_static_box(e.children[1], pt, state, lp), "\n")
                used = offset + 8
            } else {
                text = format(text, fasm_static_value(e.children[1], pt, state, lp))
                used = offset + fasm_type_size(pt, lp)
            }
        }
        size := fasm_type_size(t, lp)
        if size > used { text = format(text, "db ", (size - used).to_str(), " dup(0)\n") }
        return text
    }
    switch e.node_type {
    case .Literal(Literal.Num(n)):
        if fasm_scalar(t).not() { fasm_error(e, "unsupported precomputed scalar", lp); return "" }
        return fasm_static_number(fasm_numeric_bits(n,t), fasm_type_size(t, lp))
    case .Literal(Literal.Bool(v)):
        if v { return "db 1\n" }
        return "db 0\n"
    case .Literal(Literal.Null): return "dq 0\n"
    case .Literal(Literal.Str(value)):
        ref bytes : Str = value
        label := fasm_static_label(state)
        mut data := "db "
        for b : I8 in bytes { data = format(data, b.cast(U8).to_str(), ",") }
        state.data = format(state.data, label, ": ", data, "0\n")
        return format("dq ", label, "\n", fasm_static_number(bytes.len().to_u64(), lp.ctx.target_usize_bytes),
            fasm_static_number(0xffffffffffffffff, lp.ctx.target_usize_bytes))
    case .FCall, .PrecomputedSequence:
        if fasm_aggregate(t, lp).not() { fasm_error(e, "unsupported precomputed aggregate", lp); return "" }
        ref sd : StructDef = structdef_of(lp.ctx.scope.get_struct(type_name_ref(t, lp.ctx.symbols), lp.ctx.symbols).unwrap())
        mut data_label := ""
        mut count : U64 = 0
        mut capacity : U64 = 0
        switch e.node_type {
        case .PrecomputedSequence(sequence):
            data_label = fasm_static_label(state)
            mut elements := ""
            for element : Expr in e.children { elements = format(elements, fasm_static_value(element, sequence.element_type, state, lp)) }
            if e.children.len() == 0 { elements = "db 0\n" }
            state.data = format(state.data, "align 8\n", data_label, ":\n", elements)
            count = e.children.len().to_u64()
            capacity = sequence.capacity.to_u64()
        case:
        }
        mut text := ""
        mut offset : USize = 0
        for i in 0..sd.fields.len() {
            ref field : Declaration = sd.field_at(i)
            ref name : Str = sd.field_name_at(i)
            layout := fasm_field_layout(t, name, lp)
            if layout.offset > offset { text = format(text, "db ", (layout.offset - offset).to_str(), " dup(0)\n") }
            ft := declaration_resolved_type(field, lp.ctx.scope, lp.ctx.symbols)
            if fasm_scalar(ft).or(fasm_aggregate(ft, lp)).not() { fasm_error(e, "unsupported precomputed field type", lp); return "" }
            if e.node_type.is(NodeType.PrecomputedSequence) {
                switch name {
                case "data": text = format(text, "dq ", data_label, "\n")
                case "count": text = format(text, fasm_static_number(count, layout.size))
                case "cap": text = format(text, fasm_static_number(capacity, layout.size))
                case: fasm_error(e, "unsupported precomputed sequence field", lp); return ""
                }
            } else if field.own_type.is(OwnType.Shallow) {
                text = format(text, fasm_static_value(e.children[i + 1], ft, state, lp))
            } else {
                ref value : Expr = e.children[i + 1]
                if value.node_type.is_literal_null() { text = format(text, "dq 0\n") }
                else { text = format(text, "dq ", fasm_static_box(value, ft, state, lp), "\n") }
            }
            offset = layout.offset + layout.size
        }
        size := fasm_type_size(t, lp)
        if size > offset { text = format(text, "db ", (size - offset).to_str(), " dup(0)\n") }
        return text
    case: fasm_error(e, "unsupported precomputed value", lp); return ""
    }
}

priv fasm_release_outer := func(slot: Str, mut state: FasmState) {
    // Release actual owned outer storage after moving its contents. Ordinary
    // aggregate results live in caller frames and never take this path.
    fasm_emit(state, format("mov rdi, ", slot, "\n    call rt_free"))
}

priv fasm_release_value_outer := func(e: Expr, slot: Str, mut state: FasmState, lp: LoadedProgram) {
    switch e.node_type {
    case .Ident(id):
        if state.outer_heap.len() > 0 && id.ident_name(lp.ctx.symbols.names) == state.outer_parameter {
            done := format(".moved_outer", state.labels.to_str())
            state.labels++
            fasm_emit(state, format("cmp ", state.outer_heap, ", 0\n    je ", done, "\n    mov ", state.outer_heap, ", 0"))
            fasm_release_outer(slot, state)
            fasm_emit(state, format(done, ":"))
            return
        }
    case:
    }
    if fasm_boxed(e, state, lp) { fasm_release_outer(slot, state) }
}

// RAX is a value's address. Allocate storage for an escaping/explicit owner,
// such as an own field or a private closure capture, not a call's result.
priv fasm_box_copy := func(shallow t: Type, mut state: FasmState, lp: LoadedProgram) {
    source := fasm_slot(state)
    dest := fasm_slot(state)
    bytes := fasm_type_size(t, lp).to_str()
    fasm_emit(state, format("mov ", source, ", rax\n    mov rdi, ", bytes, "\n    call rt_malloc\n    mov ", dest,
        ", rax\n    mov rdi, rax\n    mov rsi, ", source, "\n    mov rdx, ", bytes, "\n    call rt_memcpy\n    mov rax, ", dest))
    if fasm_is_str(t, lp) {
        label := state.labels.to_str()
        state.labels++
        fasm_emit(state, format("mov rdx, rax\n    load_size rcx, [rdx+STR_CAP]\n    mov r9, CAP_LIT\n    cmp rcx, r9\n    jne .boxed_str", label,
            "\n    store_size [rdx+STR_CAP], CAP_VIEW\n.boxed_str", label, ":\n    mov rax, rdx"))
    }
}

priv fasm_owned := proc(e: Expr, mut state: FasmState, mut lp: LoadedProgram) {
    if type_is_callable_storage(e.til_type()) {
        fasm_expr(e, state, lp)
        slot := fasm_slot(state)
        fasm_emit(state, format("mov ", slot, ", rax\n    lea rax, ", slot.strip_prefix("qword ")))
        fasm_box_copy(e.til_type(), state, lp)
        return
    }
    switch e.node_type {
    case .Ident(id):
        if state.outer_heap.len() > 0 && id.ident_name(lp.ctx.symbols.names) == state.outer_parameter {
            fasm_pointer(e, state, lp)
            done := format(".owned_outer", state.labels.to_str())
            state.labels++
            fasm_emit(state, format("cmp ", state.outer_heap, ", 0\n    jne ", done))
            fasm_box_copy(state.value_types[state.outer_parameter], state, lp)
            fasm_emit(state, format(done, ":"))
            return
        }
    case:
    }
    if fasm_boxed(e, state, lp) { fasm_pointer(e, state, lp); return }
    mut t := e.til_type().clone()
    if fasm_enum_literal_index(e, lp) >= 0 {
        fasm_pointer(e, state, lp)
        fasm_box_copy(t, state, lp)
        return
    }
    global_name := fasm_namespace_name(e, lp, state)
    if global_name.len() > 0 {
        fasm_pointer(e, state, lp)
        ref global : FasmGlobal = state.program.globals[global_name]
        if global.pointer.or(global.reference).or(t.is(Type.Dynamic)).not() { fasm_box_copy(t, state, lp) }
        return
    }
    switch e.node_type {
    case .Ident(id):
        ref name : Str = id.ident_name(lp.ctx.symbols.names)
        if state.pointers.has(name) { fasm_pointer(e, state, lp); return }
        t = state.value_types[name].clone()
    case .FieldAccess(field):
        ref fd : Declaration = fasm_field_decl(e.children[0], field.field_access_name(lp.ctx.symbols.names), lp)
        if fd.own_type.is(OwnType.Shallow).not() { fasm_pointer(e, state, lp); return }
        t = declaration_resolved_type(fd, lp.ctx.scope, lp.ctx.symbols)
    case:
    }
    fasm_pointer(e, state, lp)
    if t.is(Type.Dynamic).not() { fasm_box_copy(t, state, lp) }
}

priv fasm_snapshot := proc(e: Expr, shallow t: Type, mut state: FasmState, mut lp: LoadedProgram) returns Str {
    fasm_pointer(e, state, lp)
    source := fasm_slot(state)
    destination := fasm_value_slot(t, state, lp)
    fasm_emit(state, format("mov ", source, ", rax\n    mov rsi, rax\n    lea rdi, ", destination.strip_prefix("qword "),
        "\n    mov rdx, ", fasm_type_size(t, lp).to_str(), "\n    call rt_memcpy"))
    fasm_release_value_outer(e, source, state, lp)
    return destination
}

priv fasm_parameter_type := func(fd: FunctionDef, i: USize, lp: LoadedProgram) returns Type {
    ref p : Declaration = fd.sig.params[i]
    if i.to_i32() == fd.sig.variadic_index {
        ref name : Str = resolve_type_alias_for_name(lp.ctx.scope, decl_type_name_ref(p, lp.ctx.symbols), lp.ctx.symbols)
        return type_from_name_init_name(format("Array__", name), lp.ctx.scope, lp.ctx.symbols)
    }
    return declaration_resolved_type(p, lp.ctx.scope, lp.ctx.symbols)
}

priv fasm_call_argument := proc(e: Expr, i: USize, fd: FunctionDef, mut state: FasmState, mut lp: LoadedProgram) {
    ref p : Declaration = fd.sig.params[i - 1]
    t := fasm_parameter_type(fd, i - 1, lp)
    ref argument : Expr = e.children[i]
    if type_is_callable_storage(t) {
        if p.is_mut { fasm_callable_slot(argument, state, lp) }
        else { fasm_expr(argument, state, lp) }
    } else if fasm_aggregate(t, lp) {
        if p.own_type.is(OwnType.Own) && get_keep_outer_arg(e, i).not() {
            opaque_result := fd.sig.return_type.eq("Dynamic").and(fd.sig.return_own_type.is(OwnType.Own))
            if fasm_param_stack_outer(fd, i - 1, lp).or(fasm_outer_selector(fd, lp).and(opaque_result.not())) { fasm_pointer(argument, state, lp) }
            else { fasm_owned(argument, state, lp) }
        } else { fasm_pointer(argument, state, lp) }
    } else if t.is(Type.Dynamic) {
        if p.own_type.is(OwnType.Own) && get_keep_outer_arg(e, i).not() {
            if type_is_callable_storage(argument.til_type()) { fasm_callable_copy(argument, false, state, lp) }
            else { fasm_owned(argument, state, lp) }
        }
        else { fasm_pointer(argument, state, lp) }
    } else if func_param_passes_c_value(fd, i - 1, lp.ctx.param_value_abi_ok, lp.ctx.scope, lp.ctx.symbols) {
        if p.own_type.is(OwnType.Own) && fasm_boxed(argument, state, lp) && get_keep_outer_arg(e, i).not() {
            snapshot := fasm_snapshot(argument, t, state, lp)
            fasm_emit(state, format("lea rax, ", snapshot.strip_prefix("qword ")))
            fasm_load_scalar(t, state)
        } else { fasm_expr(argument, state, lp) }
    } else if p.own_type.is(OwnType.Own) && fasm_boxed(argument, state, lp) && get_keep_outer_arg(e, i).not() {
        snapshot := fasm_snapshot(argument, t, state, lp)
        fasm_emit(state, format("lea rax, ", snapshot.strip_prefix("qword ")))
    } else { fasm_pointer(argument, state, lp) }
}

// All ordinary aggregate arguments lend their outer storage. A lifecycle
// method's call_free parameter still selects actual owned heap storage.
priv fasm_param_stack_outer := func(fd: FunctionDef, index: USize, lp: LoadedProgram) returns Bool {
    ref param : Declaration = fd.sig.params[index]
    if param.own_type.is(OwnType.Own).not() { return false }
    if fasm_aggregate(fasm_parameter_type(fd, index, lp), lp).not() { return false }
    if index == 0 && fd.sig.params.len() > 1 && fd.sig.params[1].name == "call_free" { return false }
    // Owned opaque results may transfer this storage beyond the call.
    if fd.sig.return_type == "Dynamic" && fd.sig.return_own_type.is(OwnType.Own) { return false }
    return true
}

priv fasm_outer_selector := func(fd: FunctionDef, lp: LoadedProgram) returns Bool {
    if fd.sig.params.len() < 2 { return false }
    return fd.sig.params[1].name.eq("call_free").and(fd.sig.params[0].own_type.is(OwnType.Own))
        .and(fasm_aggregate(fasm_parameter_type(fd, 0, lp), lp))
}

priv fasm_call_outer := func(e: Expr, fd: FunctionDef, mut state: FasmState, lp: LoadedProgram) {
    // An indirect signature can use different parameter names from its
    // implementation, so initialize the bit for every owning first aggregate.
    if fd.sig.params.len() == 0 { return }
    if fd.sig.params[0].own_type.is(OwnType.Own).not().or(fasm_aggregate(fasm_parameter_type(fd, 0, lp), lp).not()) { return }
    if fasm_param_stack_outer(fd, 0, lp) { fasm_emit(state, "xor r11d, r11d"); return }
    if fd.sig.return_type == "Dynamic" && fd.sig.return_own_type.is(OwnType.Own) && get_keep_outer_arg(e, 1).not() {
        fasm_emit(state, "mov r11d, 1")
        return
    }
    ref arg : Expr = e.children[1]
    switch arg.node_type {
    case .Ident(id):
        if state.outer_heap.len() > 0 && id.ident_name(lp.ctx.symbols.names) == state.outer_parameter {
            fasm_emit(state, format("mov r11, ", state.outer_heap))
            return
        }
    case:
    }
    if fasm_boxed(arg, state, lp) { fasm_emit(state, "mov r11d, 1") }
    else { fasm_emit(state, "xor r11d, r11d") }
}

priv fasm_release_arguments := func(e: Expr, fd: FunctionDef, arguments: Vec(Str), mut state: FasmState, lp: LoadedProgram) {
    mut result := ""
    for i in 1..e.children.len() {
        if fasm_param_stack_outer(fd, i - 1, lp).not().or(get_keep_outer_arg(e, i)) { continue }
        ref arg : Expr = e.children[i]
        mut dynamic_outer := false
        switch arg.node_type {
        case .Ident(id): dynamic_outer = state.outer_heap.len().gt(0).and(id.ident_name(lp.ctx.symbols.names).eq(state.outer_parameter))
        case:
        }
        if fasm_boxed(arg, state, lp).or(dynamic_outer).not() { continue }
        if result.len() == 0 {
            result = fasm_slot(state)
            fasm_emit(state, format("mov ", result, ", rax"))
        }
        mut done := ""
        if dynamic_outer {
            done = format(".argument_outer", state.labels.to_str())
            state.labels++
            fasm_emit(state, format("cmp ", state.outer_heap, ", 0\n    je ", done, "\n    mov ", state.outer_heap, ", 0"))
        }
        fasm_emit(state, format("mov rdi, ", arguments[i - 1], "\n    call rt_free"))
        if done.len() > 0 { fasm_emit(state, format(done, ":")) }
    }
    if result.len() > 0 { fasm_emit(state, format("mov rax, ", result)) }
}

priv fasm_call_result := func(fd: FunctionDef, mut state: FasmState, lp: LoadedProgram) returns Str {
    ret := type_from_name_init_name(fd.sig.return_type, lp.ctx.scope, lp.ctx.symbols)
    if fd.sig.return_own_type.is(OwnType.Ref).or(fasm_aggregate(ret, lp).not()) { return "" }
    return fasm_value_slot(ret, state, lp)
}

priv fasm_interface_literal := proc(value: Str, mut state: FasmState, mut lp: LoadedProgram) {
    mut literal := Expr.new(own NodeType.Literal(Literal.Str(value.clone())), 0, 0)
    literal.set_til_type(type_from_name_init_name("Str", lp.ctx.scope, lp.ctx.symbols))
    fasm_expr(literal, state, lp)
}

priv fasm_interface_fail := proc(message: Str, mut state: FasmState, mut lp: LoadedProgram) {
    fasm_interface_literal(format(message,"\n"), state, lp)
    fasm_emit(state, "mov rdi, [rax]\n    jmp rt_fail")
}

priv fasm_interface_ident := func(name: Str, shallow t: Type, site: Expr, mut lp: LoadedProgram) returns Expr {
    mut value := Expr.new(own ident_node(lp.ctx.symbols.intern(name)), site.line, site.col)
    value.set_til_type(t.clone())
    return value
}

// Keep the shared synthetic {iface_type_name, iface_val} fields inline. Only
// the concrete owned payload needs persistent storage, never a return wrapper.
priv fasm_interface_result := proc(concrete: Str, payload: Str, mut state: FasmState, mut lp: LoadedProgram) {
    fasm_interface_literal(concrete, state, lp)
    fasm_emit(state, format("mov rsi, rax\n    mov rdi, ", state.return_buffer,
        "\n    mov rdx, ", fasm_type_size(type_from_name_init_name("Str", lp.ctx.scope, lp.ctx.symbols), lp).to_str(),
        "\n    call rt_memcpy\n    mov rax, ", state.return_buffer, "\n    mov rdx, ", payload,
        "\n    mov [rax+", fasm_field_layout(state.return_type,"iface_val",lp).offset.to_str(), "], rdx"))
}

priv fasm_interface_dispatch := proc(name: Str, expr: Expr, mut state: FasmState, mut lp: LoadedProgram) {
    ref fd : FunctionDef = funcdef_of(expr)
    ref location : FasmDefinition = state.program.definitions.get(name)!
    ref unit : ImportUnit = lp.ctx.imported.get(location.path)!
    ref declaration : Expr = unit.ast.children.unsafe_get(location.declaration)
    ref owner : Str = decl_of(declaration).name
    ref method : Str = def_ns_name_at(declaration.children[0], location.member.to_usize())
    returns_self := fd.sig.return_type == owner
    mut handles := Vec(Str).new()
    for i in 0..fd.sig.params.len() {
        ref param : Declaration = fd.sig.params[i]
        mut handle := ""
        if decl_type_name_ref(param, lp.ctx.symbols) == owner {
            value := fasm_interface_ident(param.name, state.value_types[param.name], expr, lp)
            fasm_pointer(value, state, lp)
            handle = fasm_slot(state)
            fasm_emit(state, format("mov ", handle, ", rax"))
        }
        handles.push(own handle)
    }
    for path : Str in lp.unit_paths() {
        for stmt : Expr in lp.ctx.imported[path].ast.children {
            if is_struct_or_enum(stmt).not() { continue }
            ref definition : Expr = stmt.children[0]
            if type_def_implements_iface(definition, owner, lp.ctx.scope, lp.ctx.symbols).not() { continue }
            ref concrete : Str = decl_of(stmt).name
            concrete_type := type_from_name_init_name(concrete, lp.ctx.scope, lp.ctx.symbols)
            target_name := format(concrete,"_",method)
            ref target : FunctionDef = funcdef_of(fasm_definition(target_name, state.program, lp))
            next := format(".interface_next",state.labels.to_str())
            state.labels++
            fasm_interface_literal(concrete, state, lp)
            tag := fasm_slot(state)
            fasm_emit(state, format("mov ",tag,", rax\n    mov rdi, ",handles[0],"\n    mov rsi, rax\n    call rt_str_eq\n    test rax, rax\n    jz ",next))
            mut call := Expr.new(own NodeType.FCall(FCallData()), expr.line, expr.col)
            call.add_child(own Expr.new(own ident_node(lp.ctx.symbols.intern(target_name)), expr.line, expr.col))
            call.set_til_type(type_from_name_init_name(target.sig.return_type, lp.ctx.scope, lp.ctx.symbols))
            for i in 0..fd.sig.params.len() {
                ref param : Declaration = fd.sig.params[i]
                if handles[i].len() > 0 {
                    if i > 0 {
                        matched := format(".interface_same",state.labels.to_str())
                        state.labels++
                        fasm_emit(state,format("mov rdi, ",handles[i],"\n    mov rsi, ",tag,"\n    call rt_str_eq\n    test rax, rax\n    jnz ",matched))
                        fasm_interface_fail("interface dispatch: Self arguments have different runtime types", state, lp)
                        fasm_emit(state,format(matched,":"))
                    }
                    value := fasm_slot(state)
                    offset := fasm_field_layout(state.value_types[param.name],"iface_val",lp).offset.to_str()
                    fasm_emit(state,format("mov rdx, ",handles[i],"\n    mov rax, [rdx+",offset,"]\n    mov ",value,", rax"))
                    if param.own_type.is(OwnType.Own) { fasm_emit(state,format("mov qword [rdx+",offset,"], 0")) }
                    binding := format("@interface",state.slots.to_str())
                    fasm_bind(binding, concrete_type, own value, false, false, param.own_type.is(OwnType.Own), false, state)
                    call.add_child(own fasm_interface_ident(binding, concrete_type, expr, lp))
                } else { call.add_child(own fasm_interface_ident(param.name, state.value_types[param.name], expr, lp)) }
                if param.own_type.is(OwnType.Own) { set_own_arg(call,i+1) }
            }
            mark_fcall_direct(call)
            mut result_pointer := ""
            if returns_self {
                result_pointer = fasm_slot(state)
                fasm_emit(state,format("mov rdi, ",fasm_type_size(concrete_type,lp).to_str(),"\n    call rt_malloc\n    mov ",result_pointer,", rax"))
            } else if state.return_buffer.len() > 0 { result_pointer = state.return_buffer.clone() }
            fasm_user_call(call,target_name,state,lp,as_pointer=state.return_ref,result_pointer=result_pointer)
            result := fasm_slot(state)
            fasm_emit(state,format("mov ",result,", rax"))
            for i in 0..fd.sig.params.len() {
                ref param : Declaration = fd.sig.params[i]
                if handles[i].len().gt(0).and(param.own_type.is(OwnType.Own)) {
                    fasm_emit(state,format("mov rdi, ",handles[i]))
                    fasm_destroy(state.value_types[param.name],false,state,lp)
                    value := fasm_interface_ident(param.name,state.value_types[param.name],expr,lp)
                    fasm_release_value_outer(value,handles[i],state,lp)
                }
            }
            if returns_self { fasm_interface_result(concrete,result_pointer,state,lp) }
            else { fasm_emit(state,format("mov rax, ",result)) }
            fasm_emit(state,"leave\n    ret")
            fasm_emit(state,format(next,":"))
        }
    }
    fasm_interface_fail(format("interface dispatch: no implementation of ",owner,".",method),state,lp)
}

// The shared frontend inserts these calls for concrete-to-interface coercions
// and for generated interface destruction. This is native lifecycle dispatch,
// using the same prepared concrete methods, not a second reflection registry.
priv fasm_interface_dynamic := proc(e: Expr, mut state: FasmState, mut lp: LoadedProgram) {
    mut concrete := ""
    switch e.children[1].node_type {
    case .Literal(Literal.Str(value)): concrete = value.clone()
    case:
    }
    mut method := ""
    switch e.children[2].node_type {
    case .Literal(Literal.Str(value)): method = value.clone()
    case:
    }
    if method.eq("clone").or(method.eq("delete")).not().or(concrete.len().eq(0).and(state.interface_name.len().eq(0))) {
        fasm_error(e,"dynamic runtime lookup is not supported",lp)
        return
    }
    fasm_pointer(e.children[1],state,lp)
    tag := fasm_slot(state)
    fasm_emit(state,format("mov ",tag,", rax"))
    fasm_pointer(e.children[4],state,lp)
    payload := fasm_slot(state)
    fasm_emit(state,format("mov ",payload,", rax"))
    mut types := Vec(Str).new()
    if concrete.len() > 0 { types.push(own concrete.clone()) }
    else {
        for path : Str in lp.unit_paths() {
            for stmt : Expr in lp.ctx.imported[path].ast.children {
                if is_struct_or_enum(stmt).not() { continue }
                if type_def_implements_iface(stmt.children[0],state.interface_name,lp.ctx.scope,lp.ctx.symbols) {
                    types.push(own decl_of(stmt).name.clone())
                }
            }
        }
    }
    done := format(".interface_dynamic_done",state.labels.to_str())
    state.labels++
    for type_name : Str in types {
        t := type_from_name_init_name(type_name,lp.ctx.scope,lp.ctx.symbols)
        next := format(".interface_dynamic_next",state.labels.to_str())
        state.labels++
        if concrete.len() == 0 {
            fasm_interface_literal(type_name,state,lp)
            fasm_emit(state,format("mov rdi, ",tag,"\n    mov rsi, rax\n    call rt_str_eq\n    test rax, rax\n    jz ",next))
        }
        binding := format("@interfacePayload",state.slots.to_str())
        fasm_bind(binding,t,own payload.clone(),false,false,true,false,state)
        target_name := format(type_name,"_",method)
        mut call := Expr.new(own NodeType.FCall(FCallData()),e.line,e.col)
        call.add_child(own Expr.new(own ident_node(lp.ctx.symbols.intern(target_name)),e.line,e.col))
        call.add_child(own fasm_interface_ident(binding,t,e,lp))
        mut result_pointer := ""
        if method == "clone" {
            call.set_til_type(t.clone())
            result_pointer = fasm_slot(state)
            fasm_emit(state,format("mov rdi, ",fasm_type_size(t,lp).to_str(),"\n    call rt_malloc\n    mov ",result_pointer,", rax"))
        } else {
            set_own_arg(call,1)
            call.add_child(own e.children[5].clone())
        }
        mark_fcall_direct(call)
        fasm_user_call(call,target_name,state,lp,as_pointer=true,result_pointer=result_pointer)
        fasm_emit(state,format("jmp ",done,"\n",next,":"))
    }
    fasm_interface_fail("interface dispatch: unknown concrete payload type",state,lp)
    fasm_emit(state,format(done,":"))
}

priv fasm_user_call := proc(e: Expr, name: Str, mut state: FasmState, mut lp: LoadedProgram, as_pointer: Bool = false, result_pointer: Str = "") {
    if state.program.definitions.has(name).not() { fasm_error(e, format("unsupported call '", name, "'"), lp); return }
    ref definition : Expr = fasm_definition(name, state.program, lp)
    ref fd : FunctionDef = funcdef_of(definition)
    if fd.sig.func_type.is_bodyless().and(fasm_interface_dispatchable(name,state.program,lp).not()) { fasm_error(e, format("unsupported external operation '", name, "'"), lp); return }
    if e.children.len() > 7 { fasm_error(e, "at most six arguments are supported", lp); return }
    target := fasm_request(name, state.program)
    mut arguments := Vec(Str).new()
    for i in 1..e.children.len() {
        fasm_call_argument(e, i, fd, state, lp)
        slot := fasm_slot(state)
        fasm_emit(state, format("mov ", slot, ", rax"))
        arguments.push(own slot)
    }
    for i in 0..arguments.len() { fasm_emit(state, format("mov ", fasm_register(i), ", ", arguments[i])) }
    fasm_call_outer(e, fd, state, lp)
    if result_pointer.len() > 0 { fasm_emit(state,format("mov rax, ",result_pointer)) }
    else {
        result := fasm_call_result(fd, state, lp)
        if result.len() > 0 { fasm_emit(state, format("lea rax, ", result.strip_prefix("qword "))) }
    }
    fasm_emit(state, format("call ", target))
    fasm_release_arguments(e, fd, arguments, state, lp)
    fasm_finish_call(e, fd, state, lp, as_pointer)
}

priv fasm_finish_call := func(e: Expr, fd: FunctionDef, mut state: FasmState, lp: LoadedProgram, as_pointer: Bool) {
    ret := type_from_name_init_name(fd.sig.return_type, lp.ctx.scope, lp.ctx.symbols)
    if ret.is(Type.Dynamic) && as_pointer.not() && e.til_type().is(Type.Primitive).or(type_is_callable_storage(e.til_type())) {
        source := fasm_slot(state)
        value := fasm_slot(state)
        fasm_emit(state, format("mov ", source, ", rax"))
        fasm_load_scalar(e.til_type(), state)
        fasm_emit(state, format("mov ", value, ", rax"))
        if fd.sig.return_own_type.is(OwnType.Own) { fasm_release_outer(source, state) }
        fasm_emit(state, format("mov rax, ", value))
    } else if fd.sig.return_own_type.is(OwnType.Ref) && as_pointer.not() && fasm_scalar(ret) && ret.is(Type.Dynamic).not() {
        fasm_load_scalar(ret, state)
    }
}

// Destroy contents according to the shared lifecycle definition. The caller
// supplies an address in RDI and whether this destructor also owns its box.
priv fasm_destroy := func(shallow t: Type, outer: Bool, mut state: FasmState, lp: LoadedProgram, call_free: Bool = false) {
    if type_is_callable_storage(t) {
        slot := fasm_slot(state)
        fasm_emit(state, format("mov ", slot, ", rdi\n    call rt_til_closure_slot_delete"))
        if outer { fasm_emit(state, format("mov rdi, ", slot, "\n    call rt_free")) }
        return
    }
    if fasm_scalar(t) {
        if outer { fasm_emit(state, "call rt_free") }
        return
    }
    if fasm_is_str(t, lp) {
        if outer {
            wrapper := fasm_slot(state)
            fasm_emit(state, format("mov ", wrapper, ", rdi\n    xor esi, esi\n    call rt_str_delete"))
            fasm_release_outer(wrapper, state)
        } else { fasm_emit(state, "xor esi, esi\n    call rt_str_delete") }
        return
    }
    if init_delete_is_noop(type_name_ref(t, lp.ctx.symbols), lp.ctx.scope, lp.ctx.symbols) {
        if outer { fasm_emit(state, "call rt_free") }
        return
    }
    name := format(type_name_ref(t, lp.ctx.symbols), "_delete")
    target := fasm_request(name, state.program)
    // Inline captures retain the lifecycle flag of their former private boxes,
    // while R11 independently prevents a user destructor from freeing interiors.
    if outer.or(call_free) { fasm_emit(state, "mov esi, 1") }
    else { fasm_emit(state, "xor esi, esi") }
    if outer { fasm_emit(state, "mov r11d, 1") }
    else { fasm_emit(state, "xor r11d, r11d") }
    fasm_emit(state, format("call ", target))
}

priv fasm_replace := proc(rhs: Expr, shallow t: Type, destination: Str, drop_old: Bool, mut state: FasmState, mut lp: LoadedProgram) {
    snapshot := fasm_snapshot(rhs, t, state, lp)
    if drop_old {
        fasm_emit(state, format("mov rdi, ", destination))
        fasm_destroy(t, false, state, lp)
    }
    fasm_emit(state, format("mov rdi, ", destination, "\n    lea rsi, ", snapshot.strip_prefix("qword "),
        "\n    mov rdx, ", fasm_type_size(t, lp).to_str(), "\n    call rt_memcpy"))
}

priv fasm_field_decl := func(owner: Expr, name: Str, lp: LoadedProgram) returns ref Declaration {
    ref sd : StructDef = structdef_of(lp.ctx.scope.get_struct(type_name_ref(owner.til_type(), lp.ctx.symbols), lp.ctx.symbols).unwrap())
    return sd.field_at(sd.fields_index[name])
}

priv fasm_field_address := proc(owner: Expr, name: Str, mut state: FasmState, mut lp: LoadedProgram) {
    fasm_pointer(owner, state, lp)
    layout := fasm_field_layout(owner.til_type(), name, lp)
    fasm_emit(state, format("add rax, ", layout.offset.to_str()))
}

priv fasm_constructor := proc(e: Expr, mut state: FasmState, mut lp: LoadedProgram) {
    ref sd : StructDef = structdef_of(lp.ctx.scope.get_struct(type_name_ref(e.til_type(), lp.ctx.symbols), lp.ctx.symbols).unwrap())
    size := fasm_type_size(e.til_type(), lp)
    storage := fasm_value_slot(e.til_type(), state, lp)
    destination := fasm_slot(state)
    fasm_emit(state, format("lea rax, ", storage.strip_prefix("qword "), "\n    mov ", destination,
        ", rax\n    mov rdi, rax\n    xor esi, esi\n    mov rdx, ", size.to_str(), "\n    call rt_memset"))
    // Typed constructor arguments are in field order. A throw-default
    // constructor may deliberately leave all fields zero-initialized.
    for i in 0..e.children.len() - 1 {
        ref field : Declaration = sd.field_at(i)
        t := declaration_resolved_type(field, lp.ctx.scope, lp.ctx.symbols)
        if fasm_scalar(t).or(fasm_aggregate(t, lp)).not() { fasm_error(e, "unsupported constructor field type", lp); return }
        ref value : Expr = e.children[i + 1]
        layout := fasm_field_layout(e.til_type(), sd.field_name_at(i), lp)
        if type_is_callable_storage(t).and(field.own_type.is(OwnType.Ref).not()) {
            fasm_callable_copy(value, get_own_arg(e, i + 1).not(), state, lp)
            if field.own_type.is(OwnType.Own) {
                slot := fasm_slot(state)
                fasm_emit(state, format("mov ", slot, ", rax\n    lea rax, ", slot.strip_prefix("qword ")))
                fasm_box_copy(t, state, lp)
            }
        } else if field.own_type.is(OwnType.Ref) { fasm_pointer(value, state, lp) }
        else if field.own_type.is(OwnType.Own) { fasm_owned(value, state, lp) }
        else { fasm_expr(value, state, lp) }
        saved := fasm_slot(state)
        fasm_emit(state, format("mov ", saved, ", rax\n    mov rcx, ", destination, "\n    add rcx, ", layout.offset.to_str()))
        if field.own_type.is(OwnType.Shallow) && fasm_aggregate(t, lp) {
            fasm_emit(state, format("mov rdi, rcx\n    mov rsi, rax\n    mov rdx, ", layout.size.to_str(), "\n    call rt_memcpy"))
            if fasm_boxed(value, state, lp) { fasm_release_outer(saved, state) }
        } else if field.own_type.is(OwnType.Shallow) && t.is(Type.Dynamic).not() {
            if fasm_scalar(t).not() { fasm_error(e, "unsupported constructor field type", lp); return }
            fasm_store_scalar(t, state)
        } else { fasm_emit(state, "mov [rcx], rax") }
    }
    fasm_emit(state, format("mov rax, ", destination))
}

priv fasm_scalar := func(shallow t: Type) returns Bool {
    if t.is(Type.Dynamic).or(type_is_callable_storage(t)) { return true }
    switch t {
    case .Primitive(p):
        switch p {
        case .I8, .U8, .I16, .U16, .I32, .U32, .I64, .U64, .Bool, .F32, .F64: return true
        }
    case: return false
    }
}

priv fasm_float := func(shallow t: Type) returns Bool {
    return t.eq(Type.Primitive(Primitive.F32)).or(t.eq(Type.Primitive(Primitive.F64)))
}

priv fasm_float_suffix := func(shallow t: Type) returns Str {
    if t==Type.Primitive(Primitive.F32) { return "ss" }
    return "sd"
}

priv fasm_float_factory := func(name: Str, program: FasmProgram, lp: LoadedProgram) returns Bool {
    ref location:FasmDefinition=program.definitions[name]
    if location.member<0 || location.nested.len()>0 { return false }
    ref unit:ImportUnit=lp.ctx.imported[location.path]
    ref declaration:Expr=unit.ast.children.unsafe_get(location.declaration)
    ref owner:Str=decl_of(declaration).name
    return owner.eq("F32").or(owner.eq("F64"))
        .and(def_ns_name_at(declaration.children[0],location.member.to_usize()).eq("from_i64"))
}

// Values retain the private RAX/argument-register bit convention. XMM registers
// are scratch for IEEE operations, so closures, refs and aggregates share slots.
priv fasm_float_cast := proc(e: Expr, shallow source: Type, shallow target: Type, checked: Bool,
    mut state: FasmState, mut lp: LoadedProgram) {
    single:=source==Type.Primitive(Primitive.F32)
    if fasm_float(source).and(fasm_float(target)) {
        if source==target { return }
        if single { fasm_emit(state,"movd xmm0, eax\n    cvtss2sd xmm0, xmm0\n    movq rax, xmm0") }
        else { fasm_emit(state,"movq xmm0, rax\n    cvtsd2ss xmm0, xmm0\n    movd eax, xmm0") }
        return
    }
    if fasm_float(target) {
        label:=state.labels.to_str()
        state.labels++
        suffix:=fasm_float_suffix(target)
        if source==Type.Primitive(Primitive.U64) {
            fasm_emit(state,format("test rax, rax\n    jns .float_signed",label,
                "\n    mov rcx, rax\n    and ecx, 1\n    shr rax, 1\n    or rax, rcx\n    cvtsi2",suffix,
                " xmm0, rax\n    add",suffix," xmm0, xmm0\n    jmp .float_converted",label,
                "\n.float_signed",label,":\n    cvtsi2",suffix," xmm0, rax\n.float_converted",label,":"))
        } else { fasm_emit(state,format("cvtsi2",suffix," xmm0, rax")) }
        if target==Type.Primitive(Primitive.F32) { fasm_emit(state,"movd eax, xmm0") }
        else { fasm_emit(state,"movq rax, xmm0") }
        return
    }
    if checked.not() {
        if single { fasm_emit(state,"movd xmm0, eax\n    cvttss2si rax, xmm0") }
        else { fasm_emit(state,"movq xmm0, rax\n    cvttsd2si rax, xmm0") }
        fasm_narrow(target,state)
        return
    }
    // Decode the truncated mathematical integer before conversion. This avoids
    // rounded MAX bounds and handles unsigned 64-bit values without overflow.
    label:=state.labels.to_str()
    state.labels++
    mut mantissa:USize=52
    mut bias:I64=1023
    mut exponent_mask:U64=2047
    mut exponent_bits:USize=11
    one:U64=1
    if single { mantissa=23; bias=127; exponent_mask=255; exponent_bits=8 }
    fasm_emit(state,format("mov r8, rax\n    shr r8, ",(mantissa+exponent_bits).to_str()))
    fasm_emit(state,format("mov rcx, rax\n    shr rcx, ",mantissa.to_str(),"\n    and ecx, ",exponent_mask.to_str(),
        "\n    cmp ecx, ",exponent_mask.to_str(),"\n    je .float_invalid",label,"\n    sub rcx, ",bias.to_str(),
        "\n    js .float_zero",label,"\n    cmp rcx, 64\n    jae .float_invalid",label,
        "\n    mov rdx, ",one.shl(mantissa.to_u64()).to_str(),"\n    dec rdx\n    and rax, rdx\n    inc rdx\n    or rax, rdx",
        "\n    sub rcx, ",mantissa.to_str(),"\n    jns .float_left",label,"\n    neg rcx\n    shr rax, cl\n    jmp .float_bounds",label,
        "\n.float_left",label,":\n    shl rax, cl\n.float_bounds",label,":"))
    bits:=fasm_type_size(target,lp)*8
    if fasm_unsigned(target) {
        fasm_emit(state,format("test r8, r8\n    jnz .float_invalid",label))
        if bits<64 { fasm_emit(state,format("mov rdx, ",one.shl(bits.to_u64()).to_str(),"\n    cmp rax, rdx\n    jae .float_invalid",label)) }
    } else {
        fasm_emit(state,format("mov rdx, ",one.shl((bits-1).to_u64()).to_str(),"\n    test r8, r8\n    jz .float_positive",label,
            "\n    cmp rax, rdx\n    ja .float_invalid",label,"\n    neg rax\n    jmp .float_done",label,
            "\n.float_positive",label,":\n    cmp rax, rdx\n    jae .float_invalid",label))
    }
    fasm_emit(state,format("jmp .float_done",label,"\n.float_zero",label,":\n    xor eax, eax\n    jmp .float_done",label,"\n.float_invalid",label,":"))
    fasm_interface_literal(format(numeric_cast_location(e,lp.ctx),": panic: invalid numeric cast\n"),state,lp)
    fasm_emit(state,format("mov rdi, rax\n    call rt_print_single\n    mov edi, 1\n    jmp rt_exit\n.float_done",label,":"))
    fasm_narrow(target,state)
}

priv fasm_is_str := func(shallow t: Type, lp: LoadedProgram) returns Bool { return type_name_ref(t, lp.ctx.symbols) == "Str" }

priv fasm_unsigned := func(shallow t: Type) returns Bool {
    switch t {
    case .Primitive(p): return p.is(Primitive.U8).or(p.is(Primitive.U16)).or(p.is(Primitive.U32)).or(p.is(Primitive.U64))
    case: return false
    }
}

priv fasm_narrow := func(shallow t: Type, mut state: FasmState) {
    switch t {
    case .Primitive(p):
        switch p {
        case .I8: fasm_emit(state, "movsx rax, al")
        case .U8, .Bool: fasm_emit(state, "movzx eax, al")
        case .I16: fasm_emit(state, "movsx rax, ax")
        case .U16: fasm_emit(state, "movzx eax, ax")
        case .I32: fasm_emit(state, "movsxd rax, eax")
        case .U32, .F32: fasm_emit(state, "mov eax, eax")
        case:
        }
    case:
    }
}

priv fasm_load_scalar := func(shallow t: Type, mut state: FasmState) {
    switch t {
    case .Primitive(p):
        switch p {
        case .I8: fasm_emit(state, "movsx rax, byte [rax]")
        case .U8, .Bool: fasm_emit(state, "movzx eax, byte [rax]")
        case .I16: fasm_emit(state, "movsx rax, word [rax]")
        case .U16: fasm_emit(state, "movzx eax, word [rax]")
        case .I32: fasm_emit(state, "movsxd rax, dword [rax]")
        case .U32, .F32: fasm_emit(state, "mov eax, dword [rax]")
        case: fasm_emit(state, "mov rax, [rax]")
        }
    case: fasm_emit(state, "mov rax, [rax]")
    }
}

priv fasm_pointer := proc(e: Expr, mut state: FasmState, mut lp: LoadedProgram) {
    if type_is_callable_storage(e.til_type()) {
        switch e.node_type {
        case .Ident(id):
            ref name : Str = id.ident_name(lp.ctx.symbols.names)
            if state.values.has(name) { fasm_binding_pointer(name, state); return }
            if state.program.definitions.has(name) {
                fasm_emit(state, format("mov rax, ", fasm_static_callable(name, true, state.program)))
                return
            }
        case .FieldAccess:
            // Field lowering below already distinguishes inline/own/ref slots.
        case .FCall:
            if fasm_call_returns_ref(e, state, lp) { fasm_expr(e, state, lp, true); return }
        case:
        }
        if e.node_type.is(NodeType.FieldAccess).not() {
            fasm_expr(e, state, lp)
            slot := fasm_slot(state)
            fasm_emit(state, format("mov ", slot, ", rax\n    lea rax, ", slot.strip_prefix("qword ")))
            return
        }
    }
    if fasm_enum_literal_index(e, lp) >= 0 { fasm_expr(e, state, lp, true); return }
    global_name := fasm_namespace_name(e, lp, state)
    if global_name.len() > 0 {
        if state.values.has(global_name).not() {
            if type_is_callable_storage(e.til_type()).and(state.program.definitions.has(global_name)) {
                fasm_emit(state, format("mov rax, ", fasm_static_callable(global_name, true, state.program)))
            } else { fasm_error(e, "unsupported namespace global", lp) }
            return
        }
        fasm_binding_pointer(global_name, state)
        return
    }
    switch e.node_type {
    case .Ident(id):
        ref name : Str = id.ident_name(lp.ctx.symbols.names)
        if state.values.has(name) && fasm_scalar(state.value_types[name]) && state.value_types[name].is(Type.Dynamic).not() {
            if state.pointers.has(name) { fasm_emit(state, format("mov rax, ", state.values[name])) }
            else { fasm_emit(state, format("lea rax, ", state.values[name].strip_prefix("qword "))) }
            return
        }
    case .FieldAccess(field):
        ref owner : Expr = e.children[0]
        if fasm_aggregate(owner.til_type(), lp).not() { fasm_error(e, "unsupported field address", lp); return }
        ref fd : Declaration = fasm_field_decl(owner, field.field_access_name(lp.ctx.symbols.names), lp)
        fasm_field_address(owner, field.field_access_name(lp.ctx.symbols.names), state, lp)
        if fd.own_type.is(OwnType.Shallow).not() || declaration_resolved_type(fd, lp.ctx.scope, lp.ctx.symbols).is(Type.Dynamic) {
            fasm_emit(state, "mov rax, [rax]")
        }
        return
    case .Literal:
        if fasm_scalar(e.til_type()) && e.til_type().is(Type.Dynamic).not() {
            fasm_expr(e, state, lp)
            slot := fasm_slot(state)
            fasm_emit(state, format("mov ", slot, ", rax\n    lea rax, ", slot.strip_prefix("qword ")))
            return
        }
    case:
    }
    fasm_expr(e, state, lp, true)
}

priv fasm_store_scalar := func(shallow t: Type, mut state: FasmState) {
    switch t {
    case .Primitive(p):
        switch p {
        case .I8, .U8, .Bool: fasm_emit(state, "mov [rcx], al")
        case .I16, .U16: fasm_emit(state, "mov [rcx], ax")
        case .I32, .U32, .F32: fasm_emit(state, "mov [rcx], eax")
        case .I64, .U64, .F64: fasm_emit(state, "mov [rcx], rax")
        }
    case:
        if type_is_callable_storage(t) { fasm_emit(state, "mov [rcx], rax") }
        else { panic("invalid FASM scalar store") }
    }
}

priv fasm_conversion := func(op: Str, lp: LoadedProgram) returns Type {
    switch op {
    case "to_i8": return Type.Primitive(Primitive.I8)
    case "to_u8": return Type.Primitive(Primitive.U8)
    case "to_i16": return Type.Primitive(Primitive.I16)
    case "to_u16": return Type.Primitive(Primitive.U16)
    case "to_i32": return Type.Primitive(Primitive.I32)
    case "to_u32": return Type.Primitive(Primitive.U32)
    case "to_i64": return Type.Primitive(Primitive.I64)
    case "to_u64": return Type.Primitive(Primitive.U64)
    case "to_usize": return type_from_name_init_name("USize", lp.ctx.scope, lp.ctx.symbols)
    case "to_uptr": return type_from_name_init_name("UPtr", lp.ctx.scope, lp.ctx.symbols)
    case "to_f32": return Type.Primitive(Primitive.F32)
    case "to_f64": return Type.Primitive(Primitive.F64)
    case: return Type.Unknown
    }
}

// Copy each value before evaluating the next operand: saving an address would
// let a later argument's mutation change the earlier SIMD value. Storage keeps
// scalar alignment, so packed moves are deliberately unaligned.
priv fasm_simd_snapshot := proc(e: Expr, shallow t: Type, mut state: FasmState, mut lp: LoadedProgram) returns Str {
    fasm_pointer(e,state,lp)
    result:=fasm_value_slot(t,state,lp).strip_prefix("qword ").clone()
    bytes:=fasm_type_size(t,lp)
    if bytes>16 { fasm_emit(state,format("mov rsi, rax\n    lea rdi, ",result,"\n    mov rdx, ",bytes.to_str(),"\n    call rt_memcpy")) }
    else if bytes==16 { fasm_emit(state,format("movups xmm0, [rax]\n    movups ",result,", xmm0")) }
    else if bytes==8 { fasm_emit(state,format("mov rax, [rax]\n    mov qword ",result,", rax")) }
    else if bytes==4 { fasm_emit(state,format("mov eax, [rax]\n    mov dword ",result,", eax")) }
    else if bytes==2 { fasm_emit(state,format("movzx eax, word [rax]\n    mov word ",result,", ax")) }
    else { UNREACHABLE("unsupported FASM SIMD snapshot size") }
    return result
}

priv fasm_simd_extrema := func(input: Str, sd: StructDef, shallow lane: Type, op: Str, mut state: FasmState, lp: LoadedProgram) {
    bytes:=fasm_type_size(lane,lp)
    suffix:=fasm_float_suffix(lane)
    mut half:=sd.simd_width/2
    while half>0 {
        for i in 0..half {
            label:=state.labels.to_str()
            state.labels++
            fasm_emit(state,format("lea rax, ",input,"\n    mov r10, rax\n    add rax, ",(i*bytes).to_str()))
            fasm_load_scalar(lane,state)
            fasm_emit(state,"mov r8, rax")
            fasm_emit(state,format("lea rax, [r10+",((i+half)*bytes).to_str(),"]"))
            fasm_load_scalar(lane,state)
            fasm_emit(state,"mov rcx, rax\n    mov rax, r8")
            if bytes==4 { fasm_emit(state,"movd xmm0, eax\n    movd xmm1, ecx") }
            else { fasm_emit(state,"movq xmm0, rax\n    movq xmm1, rcx") }
            // Propagate a NaN; if both are NaN the right lane wins, as in
            // the shared reduction tree. Equal zeros choose -0/+0 for min/max.
            fasm_emit(state,format("ucomi",suffix," xmm1, xmm1\n    jp .simd_reduce_rhs",label,
                "\n    ucomi",suffix," xmm0, xmm0\n    jp .simd_reduce_done",label))
            mut reg:="rdx"
            if bytes==4 { reg="edx" }
            fasm_emit(state,format("mov rdx, rax\n    or rdx, rcx\n    shl ",reg,", 1\n    jnz .simd_reduce_ordered",label))
            mut zero_op:="or"
            if op=="reduce_max" { zero_op="and" }
            fasm_emit(state,format(zero_op," rax, rcx\n    jmp .simd_reduce_done",label,
                "\n.simd_reduce_ordered",label,":\n    ucomi",suffix," xmm0, xmm1"))
            mut condition:="a"
            if op=="reduce_max" { condition="b" }
            fasm_emit(state,format("cmov",condition," rax, rcx\n    jmp .simd_reduce_done",label,
                "\n.simd_reduce_rhs",label,":\n    mov rax, rcx\n.simd_reduce_done",label,":\n    lea rcx, [r10+",(i*bytes).to_str(),"]"))
            fasm_store_scalar(lane,state)
        }
        half=half/2
    }
    fasm_emit(state,format("lea rax, ",input))
    fasm_load_scalar(lane,state)
}

priv fasm_simd_integer_extrema := func(input : Str, sd : StructDef, shallow lane : Type, op : Str, bytes : USize, mut state : FasmState) {
    mut condition := "g"
    if op=="reduce_max" { condition="l" }
    if fasm_unsigned(lane) {
        condition="a"
        if op=="reduce_max" { condition="b" }
    }
    mut half := sd.simd_width / 2
    while half>0 {
        for i in 0..half {
            fasm_emit(state,format("lea r10, ",input,"\n    lea rax, [r10+",(i * bytes).to_str(),"]"))
            fasm_load_scalar(lane,state)
            fasm_emit(state,"mov r8, rax")
            fasm_emit(state,format("lea rax, [r10+",((i + half) * bytes).to_str(),"]"))
            fasm_load_scalar(lane,state)
            fasm_emit(state,format("mov rcx, rax\n    mov rax, r8\n    cmp rax, rcx\n    cmov",condition,
                " rax, rcx\n    lea rcx, [r10+",(i * bytes).to_str(),"]"))
            fasm_store_scalar(lane,state)
        }
        half=half/2
    }
    fasm_emit(state,format("lea rax, ",input))
    fasm_load_scalar(lane,state)
}

priv fasm_simd_integer_binary := func(arguments : Vec(Str), result : Str, shallow lane : Type, op : Str, bytes : USize, mut state : FasmState) {
    mut suffix := "d"
    switch bytes {
    case 1: suffix = "b"
    case 2: suffix = "w"
    case 4:
    case: UNREACHABLE("unsupported FASM integer SIMD lane size")
    }
    fasm_emit(state,format("movups xmm0, ",arguments[0],"\n    movups xmm1, ",arguments[1]))
    switch op {
    case "add": fasm_emit(state, format("padd", suffix, " xmm0, xmm1"))
    case "sub": fasm_emit(state, format("psub", suffix, " xmm0, xmm1"))
    case "band": fasm_emit(state,"pand xmm0, xmm1")
    case "bor": fasm_emit(state,"por xmm0, xmm1")
    case "bxor": fasm_emit(state,"pxor xmm0, xmm1")
    case "mul":
        if bytes == 1 {
            // Widen both byte halves, multiply as words, mask to low bytes,
            // then pack. Masking first prevents packuswb from saturating.
            fasm_emit(state, "movdqa xmm2, xmm0\n    movdqa xmm3, xmm1\n    pxor xmm4, xmm4\n    punpcklbw xmm0, xmm4\n    punpcklbw xmm1, xmm4\n    punpckhbw xmm2, xmm4\n    punpckhbw xmm3, xmm4\n    pmullw xmm0, xmm1\n    pmullw xmm2, xmm3\n    pcmpeqw xmm4, xmm4\n    psrlw xmm4, 8\n    pand xmm0, xmm4\n    pand xmm2, xmm4\n    packuswb xmm0, xmm2")
        } else if bytes == 2 {
            fasm_emit(state, "pmullw xmm0, xmm1")
        } else {
            // Low dwords have the same signed/unsigned wrapped product.
            // Repeat the even-lane multiply for odd lanes and interleave.
            fasm_emit(state,"movdqa xmm2, xmm0\n    pmuludq xmm0, xmm1\n    psrldq xmm2, 4\n    psrldq xmm1, 4\n    pmuludq xmm2, xmm1\n    pshufd xmm0, xmm0, 136\n    pshufd xmm2, xmm2, 136\n    punpckldq xmm0, xmm2")
        }
    case:
        if fasm_unsigned(lane).and(op.eq("eq").or(op.eq("neq")).not()) {
            // XOR each lane's sign bit before the signed packed comparison.
            fasm_emit(state, "pcmpeqd xmm2, xmm2")
            if bytes == 1 {
                fasm_emit(state, "psllw xmm2, 15\n    movdqa xmm3, xmm2\n    psrlw xmm3, 8\n    por xmm2, xmm3")
            } else if bytes == 2 { fasm_emit(state, "psllw xmm2, 15") }
            else { fasm_emit(state, "pslld xmm2, 31") }
            fasm_emit(state, "pxor xmm0, xmm2\n    pxor xmm1, xmm2")
        }
        switch op {
        case "eq","neq": fasm_emit(state, format("pcmpeq", suffix, " xmm0, xmm1"))
        case "lt","gte": fasm_emit(state, format("pcmpgt", suffix, " xmm1, xmm0\n    movdqa xmm0, xmm1"))
        case "gt","lte": fasm_emit(state, format("pcmpgt", suffix, " xmm0, xmm1"))
        case: UNREACHABLE("unsupported FASM integer SIMD operation: ",op)
        }
        if op.eq("neq").or(op.eq("lte")).or(op.eq("gte")) { fasm_emit(state,"pcmpeqd xmm2, xmm2\n    pxor xmm0, xmm2") }
        mut mask_step : USize = 1
        if bytes == 4 { fasm_emit(state, "movmskps eax, xmm0") }
        else { fasm_emit(state, "pmovmskb eax, xmm0"); mask_step = bytes }
        fasm_emit(state, format("lea rdx, ", result))
        lanes : USize = 16 / bytes
        for i in 0..lanes {
            fasm_emit(state,format("mov ecx, eax\n    shr ecx, ",(i * mask_step).to_str(),"\n    and ecx, 1\n    mov [rdx+",i.to_str(),"], cl"))
        }
        return
    }
    fasm_emit(state,format("movups ",result,", xmm0"))
}

priv fasm_simd_address := func(address: Str, offset: USize) returns Str {
    if offset==0 { return address.clone() }
    return format(address.strip_suffix("]"),"+",offset.to_str(),"]")
}

priv fasm_simd_float_binary := func(arguments: Vec(Str), result: Str, shallow lane: Type, op: Str, lanes: USize, mut state: FasmState) {
    mut suffix:="pd"
    mut mask:="movmskpd"
    if lane==Type.Primitive(Primitive.F32) { suffix="ps"; mask="movmskps" }
    fasm_emit(state,format("movups xmm0, ",arguments[0],"\n    movups xmm1, ",arguments[1]))
    switch op {
    case "add","sub","mul","div":
        fasm_emit(state,format(op,suffix," xmm0, xmm1\n    movups ",result,", xmm0"))
    case:
        mut predicate:USize=0
        switch op {
        case "neq": predicate=4
        case "lt","gt": predicate=1
        case "lte","gte": predicate=2
        case:
        }
        if op=="gt" || op=="gte" { fasm_emit(state,"movaps xmm2, xmm0\n    movaps xmm0, xmm1\n    movaps xmm1, xmm2") }
        fasm_emit(state,format("cmp",suffix," xmm0, xmm1, ",predicate.to_str(),"\n    ",mask," eax, xmm0\n    lea rdx, ",result))
        for i in 0..lanes {
            fasm_emit(state,format("mov ecx, eax\n    shr ecx, ",i.to_str(),"\n    and ecx, 1\n    mov [rdx+",i.to_str(),"], cl"))
        }
    }
}

priv fasm_simd_core := proc(e: Expr, shallow owner: Type, op: Str, mut state: FasmState, mut lp: LoadedProgram) returns Bool {
    switch op {
    case "new","len","add","sub","mul","div","band","bor","bxor","eq","neq","lt","lte","gt","gte","fma","select","reduce_min","reduce_max":
    case: return false
    }
    ref sd:StructDef=structdef_of(lp.ctx.scope.get_struct(type_name_ref(owner,lp.ctx.symbols),lp.ctx.symbols).unwrap())
    lane:=declaration_resolved_type(sd.fields[0],lp.ctx.scope,lp.ctx.symbols)
    if op=="new" {
        // A direct SIMD constructor writes scalar arguments into its result,
        // so its lane count does not consume the private call register budget.
        result:=fasm_value_slot(owner,state,lp).strip_prefix("qword ").clone()
        bytes:=fasm_type_size(lane,lp)
        for i in 0..sd.simd_width {
            fasm_expr(e.children[i+1],state,lp)
            fasm_emit(state,format("lea rcx, ",fasm_simd_address(result,i*bytes)))
            fasm_store_scalar(lane,state)
        }
        fasm_emit(state,format("lea rax, ",result))
        return true
    }
    integer := lane.eq(Type.Primitive(Primitive.I8)).or(lane.eq(Type.Primitive(Primitive.U8)))
        .or(lane.eq(Type.Primitive(Primitive.I16))).or(lane.eq(Type.Primitive(Primitive.U16)))
        .or(lane.eq(Type.Primitive(Primitive.I32))).or(lane.eq(Type.Primitive(Primitive.U32)))
    // Bool mask logic has ordinary generated bodies, rather than core ops.
    if integer.not().and(op.eq("band").or(op.eq("bor")).or(op.eq("bxor"))) { return false }
    // The generated integer div body already preserves zero-divisor and
    // MIN/-1 behavior. There is no baseline packed integer divide instruction.
    if integer.and(op.eq("div")) { return false }
    if op=="len" {
        fasm_expr(e.children[1],state,lp)
        fasm_emit(state,format("mov rax, ",sd.simd_width.to_str()))
        return true
    }
    mut arguments:=Vec(Str).new()
    for i in 1..e.children.len() { arguments.push(own fasm_simd_snapshot(e.children[i],e.children[i].til_type(),state,lp)) }
    if op=="reduce_min" || op=="reduce_max" {
        if integer { fasm_simd_integer_extrema(arguments[0],sd,lane,op,fasm_type_size(lane,lp),state) }
        else { fasm_simd_extrema(arguments[0],sd,lane,op,state,lp) }
        if fasm_float(e.til_type()).and(lane.neq(e.til_type())) { fasm_float_cast(e,lane,e.til_type(),false,state,lp) }
        return true
    }
    result:=fasm_value_slot(e.til_type(),state,lp).strip_prefix("qword ").clone()
    bytes:=fasm_type_size(lane,lp)
    if op=="fma" {
        mut runtime:="rt_f64_fma"
        if bytes==4 { runtime="rt_f32_fma" }
        for i in 0..sd.simd_width {
            for j:USize in 0..3 {
                fasm_emit(state,format("lea rax, ",arguments[j],"\n    add rax, ",(i*bytes).to_str()))
                fasm_load_scalar(lane,state)
                fasm_emit(state,format("mov ",fasm_register(j),", rax"))
            }
            fasm_emit(state,format("call ",runtime,"\n    lea rcx, ",result,"\n    add rcx, ",(i*bytes).to_str()))
            fasm_store_scalar(lane,state)
        }
    } else if op=="select" {
        if lane==Type.Primitive(Primitive.Bool) {
            for i in 0..sd.simd_width {
                fasm_emit(state,format("lea rdx, ",arguments[0],"\n    lea rax, ",arguments[1],"\n    lea rcx, ",arguments[2],
                    "\n    cmp byte [rdx+",i.to_str(),"], 0\n    cmove rax, rcx\n    movzx eax, byte [rax+",i.to_str(),"]\n    lea rdx, ",result,"\n    mov [rdx+",i.to_str(),"], al"))
            }
        } else {
            expanded:=fasm_value_slot(owner,state,lp).strip_prefix("qword ").clone()
            for i in 0..sd.simd_width {
                fasm_emit(state,format("lea rdx, ",arguments[0],"\n    movzx eax, byte [rdx+",i.to_str(),"]\n    neg rax\n    lea rcx, ",expanded,"\n    add rcx, ",(i*bytes).to_str()))
                fasm_store_scalar(lane,state)
            }
            for chunk in 0..(sd.simd_width*bytes/16) {
                offset:=chunk*16
                fasm_emit(state,format("movups xmm0, ",fasm_simd_address(arguments[1],offset),
                    "\n    movups xmm1, ",fasm_simd_address(arguments[2],offset),"\n    movups xmm2, ",fasm_simd_address(expanded,offset),
                    "\n    pand xmm0, xmm2\n    pandn xmm2, xmm1\n    por xmm0, xmm2\n    movups ",fasm_simd_address(result,offset),", xmm0"))
            }
        }
    } else if lane==Type.Primitive(Primitive.Bool) {
        for i in 0..sd.simd_width {
            fasm_emit(state,format("lea rdx, ",arguments[0],"\n    mov al, [rdx+",i.to_str(),"]\n    lea rdx, ",arguments[1],"\n    cmp al, [rdx+",i.to_str(),"]"))
            mut condition:="e"
            if op=="neq" { condition="ne" }
            fasm_emit(state,format("set",condition," al\n    lea rdx, ",result,"\n    mov [rdx+",i.to_str(),"], al"))
        }
    } else {
        lanes:USize=16/bytes
        result_stride:=fasm_type_size(e.til_type(),lp)/sd.simd_width
        for chunk in 0..(sd.simd_width/lanes) {
            mut inputs:=Vec(Str).new()
            for input in arguments { inputs.push(own fasm_simd_address(input,chunk*16)) }
            output:=fasm_simd_address(result,chunk*lanes*result_stride)
            if integer { fasm_simd_integer_binary(inputs,output,lane,op,bytes,state) }
            else { fasm_simd_float_binary(inputs,output,lane,op,lanes,state) }
        }
    }
    fasm_emit(state,format("lea rax, ",result))
    return true
}

priv fasm_float_binary := proc(e: Expr, shallow owner: Type, op: Str, mut state: FasmState, mut lp: LoadedProgram) returns Bool {
    switch op {
    case "add","sub","mul","div","eq","neq","lt","gt","lte","gte","cmp":
    case: return false
    }
    fasm_expr(e.children[1],state,lp)
    left:=fasm_slot(state)
    fasm_emit(state,format("mov ",left,", rax"))
    fasm_expr(e.children[2],state,lp)
    fasm_emit(state,format("mov rcx, rax\n    mov rax, ",left))
    if owner==Type.Primitive(Primitive.F32) { fasm_emit(state,"movd xmm0, eax\n    movd xmm1, ecx") }
    else { fasm_emit(state,"movq xmm0, rax\n    movq xmm1, rcx") }
    switch op {
    case "add","sub","mul","div":
        fasm_emit(state,format(op,fasm_float_suffix(owner)," xmm0, xmm1"))
        if owner==Type.Primitive(Primitive.F32) { fasm_emit(state,"movd eax, xmm0") }
        else { fasm_emit(state,"movq rax, xmm0") }
        if fasm_float(e.til_type()).and(owner.neq(e.til_type())) { fasm_float_cast(e,owner,e.til_type(),false,state,lp) }
    case:
        fasm_emit(state,format("ucomi",fasm_float_suffix(owner)," xmm0, xmm1"))
        switch op {
        case "eq": fasm_emit(state,"sete al\n    setnp dl\n    and al, dl")
        case "neq": fasm_emit(state,"setne al\n    setp dl\n    or al, dl")
        case "lt": fasm_emit(state,"setb al\n    setnp dl\n    and al, dl")
        case "lte": fasm_emit(state,"setbe al\n    setnp dl\n    and al, dl")
        case "gt": fasm_emit(state,"seta al")
        case "gte": fasm_emit(state,"setae al")
        case "cmp":
            fasm_emit(state,"seta cl\n    setb al\n    setnp dl\n    and al, dl\n    movzx ecx, cl\n    movzx eax, al\n    sub rcx, rax\n    mov rax, rcx")
            return true
        case:
        }
        fasm_emit(state,"movzx eax, al")
    }
    return true
}

priv fasm_binary := proc(e: Expr, shallow owner: Type, op: Str, mut state: FasmState, mut lp: LoadedProgram) returns Bool {
    if fasm_float(owner) { return fasm_float_binary(e,owner,op,state,lp) }
    switch op {
    case "add", "sub", "mul", "div", "mod", "band", "bor", "bxor", "shl", "shr", "eq", "neq", "lt", "gt", "lte", "gte", "cmp":
    case: return false
    }
    if e.children.len() != 3 { fasm_error(e, "binary operation requires two arguments", lp); return true }
    fasm_expr(e.children[1], state, lp)
    saved := fasm_slot(state)
    fasm_emit(state, format("mov ", saved, ", rax"))
    fasm_expr(e.children[2], state, lp)
    fasm_emit(state, "mov rcx, rax")
    fasm_emit(state, format("mov rax, ", saved))
    is_unsigned := fasm_unsigned(owner)
    wide := owner == Type.Primitive(Primitive.I64) || owner == Type.Primitive(Primitive.U64)
    switch op {
    case "add": fasm_emit(state, "add rax, rcx")
    case "sub": fasm_emit(state, "sub rax, rcx")
    case "mul": fasm_emit(state, "imul rax, rcx")
    case "band": fasm_emit(state, "and rax, rcx")
    case "bor": fasm_emit(state, "or rax, rcx")
    case "bxor": fasm_emit(state, "xor rax, rcx")
    case "shl", "shr":
        label:=state.labels.to_str()
        state.labels++
        bits:=fasm_type_size(owner,lp)*8
        fasm_emit(state,format("cmp rcx, ",bits.to_str(),"\n    jae .shiftoutside",label))
        mut instruction := "shl"
        if op == "shr" {
            instruction = "sar"
            if is_unsigned { instruction = "shr" }
        }
        fasm_emit(state,format(instruction," rax, cl\n    jmp .shiftend",label,"\n.shiftoutside",label,":"))
        if op=="shr" && is_unsigned.not() {fasm_emit(state,"sar rax, 63")}
        else {fasm_emit(state,"xor eax, eax")}
        fasm_emit(state,format(".shiftend",label,":"))
    case "div", "mod":
        label := state.labels.to_str()
        state.labels++
        fasm_emit(state, format("test rcx, rcx\n    jz .divzero", label))
        if is_unsigned {
            fasm_emit(state, "xor edx, edx\n    div rcx")
        } else {
            if wide {
                fasm_emit(state,format("cmp rcx, -1\n    jne .divnormal",label,"\n    mov rdx, 0x8000000000000000\n    cmp rax, rdx\n    jne .divnormal",label))
                if op=="mod" {fasm_emit(state,"xor eax, eax")}
                fasm_emit(state,format("jmp .divend",label,"\n.divnormal",label,":"))
            }
            // Narrow operands are sign-extended: a 64-bit divide followed by
            // narrowing also handles the smaller types' MIN/-1 without traps.
            fasm_emit(state, "cqo\n    idiv rcx")
        }
        if op == "mod" { fasm_emit(state, "mov rax, rdx") }
        fasm_emit(state, format("jmp .divend", label, "\n.divzero", label, ":\n    xor eax, eax\n.divend", label, ":"))
    case:
        fasm_emit(state, "cmp rax, rcx")
        mut less := "l"
        mut greater := "g"
        if is_unsigned { less = "b"; greater = "a" }
        if op == "cmp" {
            fasm_emit(state, format("set", less, " dl\n    set", greater, " al\n    movzx eax, al\n    movzx edx, dl\n    sub rax, rdx"))
            return true
        }
        mut condition := "e"
        switch op {
        case "neq": condition = "ne"
        case "lt": condition = less.clone()
        case "gt": condition = greater.clone()
        case "lte": condition = format(less, "e")
        case "gte": condition = format(greater, "e")
        case:
        }
        fasm_emit(state, format("set", condition, " al\n    movzx eax, al"))
        return true
    }
    // The method owns the arithmetic width. An argument-position coercion
    // may have restamped e.til_type with a wider caller parameter type.
    fasm_narrow(owner, state)
    return true
}

priv fasm_runtime_call := proc(e: Expr, name: Str, mut state: FasmState, mut lp: LoadedProgram) {
    if e.children.len() > 7 { fasm_error(e, "at most six arguments are supported", lp); return }
    if name == "rt_free" {
        switch e.children[1].node_type {
        case .Ident(id):
            if state.no_free.has(id.ident_name(lp.ctx.symbols.names)) { return }
        case:
        }
    }
    mut free_label := ""
    if name == "rt_free" && state.outer_heap.len() > 0 {
        switch e.children[1].node_type {
        case .Ident(id):
            if id.ident_name(lp.ctx.symbols.names) == state.outer_parameter {
                free_label = format(".outer_free", state.labels.to_str())
                state.labels++
                fasm_emit(state, format("cmp ", state.outer_heap, ", 0\n    je ", free_label))
            }
        case:
        }
    }
    source_name := fasm_callee_name(e, lp)
    if state.program.definitions.has(source_name).not() { fasm_error(e, format("missing runtime declaration '", source_name, "'"), lp); return }
    ref fd : FunctionDef = funcdef_of(fasm_definition(source_name, state.program, lp))
    mut args := Vec(Str).new()
    for i in 1..e.children.len() {
        mut outer_free := false
        if name == "rt_free" && state.outer_heap.len() > 0 {
            switch e.children[i].node_type {
            case .Ident(id): outer_free = id.ident_name(lp.ctx.symbols.names) == state.outer_parameter
            case:
            }
        }
        if outer_free { fasm_pointer(e.children[i], state, lp) }
        else if name == "rt_til_closure_delete" || (name == "rt_til_closure_slot_take" && i == 2 && type_is_callable_storage(e.children[i].til_type())) {
            fasm_expr(e.children[i], state, lp)
        } else { fasm_call_argument(e, i, fd, state, lp) }
        slot := fasm_slot(state)
        fasm_emit(state, format("mov ", slot, ", rax"))
        args.push(own slot)
    }
    for i in 0..args.len() { fasm_emit(state, format("mov ", fasm_register(i), ", ", args[i])) }
    fasm_call_outer(e, fd, state, lp)
    result := fasm_call_result(fd, state, lp)
    if result.len() > 0 { fasm_emit(state, format("lea rax, ", result.strip_prefix("qword "))) }
    fasm_emit(state, format("call ", name))
    fasm_release_arguments(e, fd, args, state, lp)
    if free_label.len() > 0 { fasm_emit(state, format(free_label, ":")) }
    if name == "rt_til_closure_slot_clone" && type_is_callable_storage(e.til_type()) {
        value := fasm_slot(state)
        fasm_emit(state, format("mov rdi, rax\n    mov rax, [rax]\n    mov ", value, ", rax\n    call rt_free\n    mov rax, ", value))
    }
    // A raw allocator's contextual til_type is its POINTEE type; its ABI
    // result is still a pointer and must never be narrowed to that type.
}

priv fasm_runtime_name := func(name: Str) returns Str {
    switch name {
    case "exit", "print_single", "eprint_single", "print_flush", "print", "println", "panic", "format", "assert", "expect",
        "malloc", "calloc", "realloc", "free", "memcpy", "memmove", "memset", "memcmp", "c_str_len", "ptr_eq", "str_parse_f32", "str_parse_f64",
        "cfile_open", "cfile_open_update", "cfile_open_append", "cfile_close", "cfile_write_str", "cfile_read_n", "cfile_read_all",
        "cfile_exists", "cfile_remove", "cfile_tell", "cfile_seek", "cfile_seek_cur", "cfile_seek_end": return format("rt_", name)
    case "til_closure_delete", "til_closure_slot_delete", "til_closure_slot_clone", "til_closure_slot_take", "til_closure_slot_pop": return format("rt_", name)
    case: return ""
    }
}

priv fasm_error := proc(e: Expr, message: Str, mut lp: LoadedProgram) {
    e.type_error(format("FASM backend: ", message), lp.ctx)
}

priv fasm_emit := func(mut state: FasmState, text: Str) {
    state.text = format(state.text, "    ", text, "\n")
}

priv fasm_slot := func(mut state: FasmState) returns Str {
    state.slots++
    return format("qword [rbp-", (state.slots * 8).to_str(), "]")
}

priv fasm_root := func(lp: LoadedProgram) returns ref Expr {
    return lp.ctx.imported[lp.units[lp.units.len() - 1].path].ast
}

fasm_source_declarations := func(lp: LoadedProgram) returns Set(Str) {
    mut names := Set(Str).new()
    for stmt : Expr in fasm_root(lp).children {
        if stmt.node_type.is(NodeType.Decl) { names.add(own decl_of(stmt).name.clone()) }
    }
    return names
}

priv fasm_register := func(index: USize) returns Str {
    switch index {
    case 0: return "rdi"
    case 1: return "rsi"
    case 2: return "rdx"
    case 3: return "rcx"
    case 4: return "r8"
    case 5: return "r9"
    case: panic("invalid FASM argument register")
    }
}

priv fasm_expr := proc(e: Expr, mut state: FasmState, mut lp: LoadedProgram, as_pointer: Bool = false) {
    if e.node_type.is(NodeType.FCall).and(fcall_is_direct(e).not()) {
        fasm_indirect_call(e, state, lp, as_pointer)
        return
    }
    variant_literal := fasm_enum_literal_index(e, lp)
    if variant_literal >= 0 {
        if enum_variant_type(fasm_enum_def(e.til_type(), lp), variant_literal).len() > 0 { fasm_error(e, "enum variant requires a payload", lp); return }
        fasm_emit(state, format("mov rax, ", fasm_static_box(e, e.til_type(), state, lp)))
        return
    }
    if e.node_type.is(NodeType.FCall).and(is_enum_type(e.til_type())) {
        variant := codegen_enum_variant_index(e.children[0], type_name_ref(e.til_type(), lp.ctx.symbols), fasm_enum_def(e.til_type(), lp), lp.ctx.symbols)
        if variant >= 0 { fasm_enum_constructor(e, e.til_type(), variant, state, lp); return }
    }
    global_name := fasm_namespace_name(e, lp, state)
    if global_name.len() > 0 {
        if state.values.has(global_name).not() {
            if type_is_callable_storage(e.til_type()).and(state.program.definitions.has(global_name)) {
                fasm_closure_value(fasm_definition(global_name, state.program, lp), global_name, state, lp)
            } else { fasm_error(e, "unsupported namespace global", lp) }
            return
        }
        fasm_binding_value(global_name, e.til_type(), as_pointer, state)
        return
    }
    switch e.node_type {
    case .Ident(id):
        ref name : Str = id.ident_name(lp.ctx.symbols.names)
        if state.values.has(name).not().and(type_is_callable_storage(e.til_type())).and(state.program.definitions.has(name)) {
            fasm_closure_value(fasm_definition(name, state.program, lp), name, state, lp)
            return
        }
        if state.values.has(name).not() { fasm_error(e, format("unsupported value '", name, "'"), lp); return }
        fasm_binding_value(name, e.til_type(), as_pointer, state)
    case .Literal(Literal.Num(n)):
        if fasm_scalar(e.til_type()).not() { fasm_error(e, "unsupported numeric value", lp); return }
        fasm_emit(state, format("mov rax, ", fasm_numeric_bits(n,e.til_type()).to_str()))
        fasm_narrow(e.til_type(), state)
    case .Literal(Literal.Null): fasm_emit(state, "xor eax, eax")
    case .PrecomputedSequence:
        label := fasm_static_box(e, e.til_type(), state, lp)
        method := format(type_name_ref(e.til_type(), lp.ctx.symbols), "_clone")
        if state.program.definitions.has(method).not() { fasm_error(e, "missing precomputed sequence clone", lp); return }
        target := fasm_request(method, state.program)
        result := fasm_value_slot(e.til_type(), state, lp)
        fasm_emit(state, format("mov rdi, ", label, "\n    lea rax, ", result.strip_prefix("qword "), "\n    call ", target))
    case .Literal(Literal.Str(value)):
        ref bytes : Str = value
        label := format(state.prefix, "s", state.literals.to_str())
        state.literals++
        state.data = format(state.data, "align 8\n", label, ": dq ", label, "bytes\n")
        mut directive := "dq"
        if lp.ctx.target_usize_bytes == 4 { directive = "dd" }
        state.data = format(state.data, directive, " ", bytes.len().to_str(), ", -1\n", label, "bytes: db ")
        for b : I8 in bytes { state.data = format(state.data, b.cast(U8).to_str(), ",") }
        state.data = format(state.data, "0\n")
        fasm_emit(state, format("mov rax, ", label))
    case .FieldAccess(field):
        ref owner : Expr = e.children[0]
        if fasm_aggregate(owner.til_type(), lp).not() { fasm_error(e, "unsupported field access", lp); return }
        ref field_name : Str = field.field_access_name(lp.ctx.symbols.names)
        ref fd : Declaration = fasm_field_decl(owner, field_name, lp)
        t := declaration_resolved_type(fd, lp.ctx.scope, lp.ctx.symbols)
        fasm_field_address(owner, field_name, state, lp)
        if fd.own_type.is(OwnType.Shallow).not() { fasm_emit(state, "mov rax, [rax]") }
        if t.is(Type.Dynamic) || (fd.own_type.is(OwnType.Shallow) && fasm_scalar(t)) { fasm_load_scalar(t, state) }
        else if fasm_scalar(t) && as_pointer.not() && e.til_type().is(Type.Dynamic).not() { fasm_load_scalar(t, state) }
        else if fasm_scalar(t).or(fasm_aggregate(t, lp)).not() { fasm_error(e, "unsupported field type", lp) }
    case .Literal(Literal.Bool(value)):
        if value { fasm_emit(state, "mov eax, 1") }
        else { fasm_emit(state, "xor eax, eax") }
    case .FCall:
        ref callee : Expr = e.children[0]
        switch callee.node_type {
        case .FieldAccess(field):
            if callee.children.len() != 1 { fasm_error(e, "unsupported method receiver", lp); return }
            switch callee.children[0].node_type {
            case .Ident(id):
                owner := type_from_name_init_name(id.ident_name(lp.ctx.symbols.names), lp.ctx.scope, lp.ctx.symbols)
                ref op : Str = field.field_access_name(lp.ctx.symbols.names)
                if op == "size" && e.children.len() == 1 {
                    method := fasm_callee_name(e, lp)
                    if fasm_scalar(owner) || (state.program.definitions.has(method) && funcdef_of(fasm_definition(method, state.program, lp)).auto_generated) {
                        if fasm_scalar(owner).or(fasm_aggregate(owner, lp)).not() { fasm_error(e, "unsupported size query", lp); return }
                        fasm_emit(state, format("mov rax, ", fasm_type_size(owner, lp).to_str()))
                        return
                    }
                }
                if is_enum_type(owner) && op == "is" {
                    method := fasm_callee_name(e, lp)
                    if state.program.definitions.has(method) && funcdef_of(fasm_definition(method, state.program, lp)).sig.func_type.is(FuncType.CoreFunc) {
                        fasm_enum_is(e, owner, state, lp)
                        return
                    }
                }
                if fasm_is_str(owner, lp) {
                    mut runtime := ""
                    switch op {
                    case "clone", "to_str": runtime = "rt_str_clone"
                    case "delete": runtime = "rt_str_delete"
                    case "with_capacity": runtime = "rt_str_capacity"
                    case "push_str": runtime = "rt_str_push"
                    case "borrowed_view": runtime = "rt_str_view"
                    case "substr": runtime = "rt_str_substr"
                    case "from_c_str": runtime = "rt_str_from_c"
                    case "eq": runtime = "rt_str_eq"
                    case "len":
                        fasm_expr(e.children[1], state, lp)
                        fasm_emit(state, "load_size rdx, [rax+8]\n    mov rax, rdx")
                        return
                    case:
                    }
                    if runtime.len() > 0 { fasm_runtime_call(e, runtime, state, lp); return }
                }
                if owner.is(Type.Dynamic) {
                    if op == "clone" { fasm_runtime_call(e, "rt_dynamic_clone", state, lp); return }
                    if op == "delete" { fasm_runtime_call(e, "rt_dynamic_delete", state, lp); return }
                }
                if fasm_simd(owner,lp).and(fasm_simd_core(e,owner,op,state,lp)) { return }
                if fasm_scalar(owner).not() {
                    fasm_user_call(e, fasm_callee_name(e, lp), state, lp, as_pointer)
                    return
                }
                if fasm_float(owner) && (op=="to_str" || op=="to_repr") {
                    mut runtime:="rt_f64_"
                    if owner==Type.Primitive(Primitive.F32) { runtime="rt_f32_" }
                    fasm_runtime_call(e,format(runtime,op),state,lp)
                    return
                }
                if fasm_float(owner) && op=="fma" {
                    mut runtime:="rt_f64_fma"
                    if owner==Type.Primitive(Primitive.F32) { runtime="rt_f32_fma" }
                    fasm_runtime_call(e,runtime,state,lp)
                    if fasm_float(e.til_type()).and(owner.neq(e.til_type())) { fasm_float_cast(e,owner,e.til_type(),false,state,lp) }
                    return
                }
                if op == "to_str" && owner.is(Type.Dynamic).not() && owner != Type.Primitive(Primitive.Bool) {
                    mut runtime := "rt_i64_to_str"
                    if fasm_unsigned(owner) { runtime = "rt_u64_to_str" }
                    fasm_runtime_call(e, runtime, state, lp)
                    return
                }
                conversion := fasm_conversion(op, lp)
                if conversion.is(Type.Unknown).not() {
                    fasm_expr(e.children[1], state, lp)
                    if fasm_float(owner).or(fasm_float(conversion)) { fasm_float_cast(e,owner,conversion,false,state,lp) }
                    else { fasm_narrow(conversion, state) }
                    return
                }
                if op=="from_i64" && fasm_float(owner) {
                    fasm_expr(e.children[1],state,lp)
                    fasm_float_cast(e,Type.Primitive(Primitive.I64),owner,false,state,lp)
                    return
                }
                if (op == "inc" || op == "dec") && e.children.len() == 2 {
                    fasm_pointer(e.children[1], state, lp)
                    address := fasm_slot(state)
                    fasm_emit(state, format("mov ", address, ", rax"))
                    fasm_load_scalar(owner, state)
                    fasm_emit(state, format(op, " rax"))
                    fasm_narrow(owner, state)
                    fasm_emit(state, format("mov rcx, ", address))
                    fasm_store_scalar(owner, state)
                    return
                }
                if op == "bnot" && e.children.len() == 2 {
                    fasm_expr(e.children[1], state, lp)
                    fasm_emit(state, "not rax")
                    fasm_narrow(owner, state)
                    return
                }
                if op == "clone" && e.children.len() == 2 { fasm_expr(e.children[1], state, lp); return }
                if op == "not" && owner == Type.Primitive(Primitive.Bool) && e.children.len() == 2 {
                    fasm_expr(e.children[1], state, lp)
                    fasm_emit(state, "xor eax, 1")
                    return
                }
                if fasm_binary(e, owner, op, state, lp) { return }
                fasm_user_call(e, fasm_callee_name(e, lp), state, lp, as_pointer)
            case: fasm_error(e, "unsupported method receiver", lp)
            }
        case .Ident(id):
            ref name : Str = id.ident_name(lp.ctx.symbols.names)
            if name == "not" && state.program.source_names.has(name).not() && e.children.len() == 2 && e.children[1].til_type() == Type.Primitive(Primitive.Bool) {
                fasm_expr(e.children[1], state, lp)
                fasm_emit(state, "xor eax, 1")
                return
            }
            if state.program.source_names.has(name).not() {
                if name == "is_n" { fasm_enum_is(e, e.children[1].til_type(), state, lp); return }
                if name == "get_payload" {
                    ref definition : Expr = fasm_enum_def(e.children[1].til_type(), lp)
                    fasm_pointer(e.children[1], state, lp)
                    if enum_is_niche(definition) { fasm_emit(state, "mov rax, [rax]") }
                    else { fasm_emit(state, format("add rax, ", fasm_enum_payload_offset(definition, lp).to_str())) }
                    if as_pointer.not().and(fasm_scalar(e.til_type())).and(e.til_type().is(Type.Dynamic).not()) { fasm_load_scalar(e.til_type(), state) }
                    return
                }
                if name == "deref" {
                    fasm_pointer(e.children[1], state, lp)
                    fasm_emit(state, "mov rax, [rax]")
                    if as_pointer.not().and(fasm_scalar(e.til_type())).and(e.til_type().is(Type.Dynamic).not()) { fasm_load_scalar(e.til_type(), state) }
                    return
                }
                if (name == "and" || name == "or") && e.children.len() == 3 {
                    label := state.labels.to_str()
                    state.labels++
                    fasm_expr(e.children[1], state, lp)
                    mut jump := "jz"
                    if name == "or" { jump = "jnz" }
                    fasm_emit(state, format("test rax, rax\n    ", jump, " .lazy", label))
                    fasm_expr(e.children[2], state, lp)
                    fasm_emit(state, format(".lazy", label, ":"))
                    return
                }
                if name == "cast" && e.children.len() == 3 {
                    switch e.children[2].node_type {
                    case .Ident(target_id):
                        target := type_from_name_init_name(target_id.ident_name(lp.ctx.symbols.names), lp.ctx.scope, lp.ctx.symbols)
                        if type_is_callable_storage(target) {
                            if e.children[1].til_type().is(Type.Dynamic) {
                                fasm_pointer(e.children[1], state, lp)
                                saved := fasm_slot(state)
                                fasm_emit(state, format("mov rdi, rax\n    call rt_til_closure_slot_clone\n    mov rdi, rax\n    mov rax, [rax]\n    mov ", saved,
                                    ", rax\n    call rt_free\n    mov rax, ", saved))
                            } else { fasm_expr(e.children[1], state, lp) }
                            return
                        }
                        if fasm_scalar(target).not() { fasm_error(e, "unsupported cast target", lp); return }
                        fasm_expr(e.children[1], state, lp)
                        ref source:Type=e.children[1].til_type()
                        if fasm_float(source).or(fasm_float(target)) { fasm_float_cast(e,source,target,true,state,lp) }
                        else { fasm_narrow(target, state) }
                        return
                    case: fasm_error(e, "cast target must be a concrete type", lp); return
                    }
                }
                if name == "noop_proc" { return }
                if name == "dyn_call" || name == "dyn_call_ret" {
                    fasm_interface_dynamic(e,state,lp)
                    return
                }
                if name == "dyn_fn" && type_is_callable_storage(e.til_type()) {
                    mut owner := ""
                    mut member := ""
                    switch e.children[1].node_type {
                    case .Literal(Literal.Str(value)): owner = value.clone()
                    case:
                    }
                    switch e.children[2].node_type {
                    case .Literal(Literal.Str(value)): member = value.clone()
                    case:
                    }
                    target := format(owner,"_",member)
                    if owner.len().eq(0).or(member.len().eq(0)).or(state.program.definitions.has(target).not()) {
                        fasm_error(e,"native method lookup requires a known type and method",lp)
                        return
                    }
                    label := fasm_static_callable(target,false,state.program)
                    fasm_emit(state,format("mov rax, ",label))
                    return
                }
                runtime := fasm_runtime_name(name)
                if runtime.len() > 0 { fasm_runtime_call(e, runtime, state, lp); return }
                if name == "ptr_add" || name == "is_null" || name == "to_ptr" {
                    fasm_pointer(e.children[1], state, lp)
                    if name == "is_null" { fasm_emit(state, "test rax, rax\n    sete al\n    movzx eax, al") }
                    if name == "ptr_add" {
                        slot := fasm_slot(state)
                        fasm_emit(state, format("mov ", slot, ", rax"))
                        fasm_expr(e.children[2], state, lp)
                        fasm_emit(state, format("add rax, ", slot))
                    }
                    return
                }
            }
            if fasm_aggregate(e.til_type(), lp) && name == type_name_ref(e.til_type(), lp.ctx.symbols) {
                fasm_constructor(e, state, lp)
                return
            }
            fasm_user_call(e, name, state, lp, as_pointer)
        case: fasm_error(e, "indirect calls are not supported", lp)
        }
    case .FuncDef, .BodyValue: fasm_closure_value(e, fasm_closure_name(e), state, lp)
    case: fasm_error(e, "unsupported expression", lp)
    }
}

priv fasm_binding_pointer := func(name: Str, mut state: FasmState) {
    if state.addresses.has(name).or(fasm_scalar(state.value_types[name]).and(state.value_types[name].is(Type.Dynamic).not()).and(state.pointers.has(name).not())) {
        fasm_emit(state, format("lea rax, ", state.values[name].strip_prefix("qword ")))
    } else { fasm_emit(state, format("mov rax, ", state.values[name])) }
}

priv fasm_binding_value := func(name: Str, shallow t: Type, as_pointer: Bool, mut state: FasmState) {
    if state.addresses.has(name) { fasm_emit(state, format("lea rax, ", state.values[name].strip_prefix("qword "))) }
    else { fasm_emit(state, format("mov rax, ", state.values[name])) }
    if state.pointers.has(name) {
        if t.is(Type.Dynamic).not().and(as_pointer.not()) { fasm_load_scalar(state.value_types[name], state) }
    } else if state.addresses.has(name).not() {
        // Mut/ref writes touch only the declared width, including globals.
        fasm_narrow(state.value_types[name], state)
    }
}

priv fasm_switch := proc(e: Expr, mut state: FasmState, mut lp: LoadedProgram) {
    ref subject : Expr = e.children[0]
    t := subject.til_type().clone()
    is_enum := is_enum_type(t)
    if is_enum { fasm_enum_tag(subject, t, state, lp) }
    else if fasm_scalar(t) { fasm_expr(subject, state, lp) }
    else { fasm_error(e, "unsupported switch subject", lp); return }
    value := fasm_slot(state)
    fasm_emit(state, format("mov ", value, ", rax"))
    label := format(".switch", state.labels.to_str())
    state.labels++
    mut fallback := format(label, "done")
    for ci in 1..e.children.len() {
        ref arm : Expr = e.children[ci]
        count := case_pattern_count(arm)
        target := format(label, "case", ci.to_str())
        if count == 0 { fallback = target.clone() }
        for pi in 0..count {
            ref pattern : Expr = arm.children[pi]
            if is_enum {
                ref definition : Expr = fasm_enum_def(t, lp)
                variant := codegen_enum_variant_index(pattern, type_name_ref(t, lp.ctx.symbols), definition, lp.ctx.symbols)
                if variant < 0 { fasm_error(pattern, "unsupported enum case", lp); continue }
                fasm_emit(state, format("mov rax, ", enum_variant_tag_at(definition, variant).to_str()))
            } else if is_range_new_call(pattern, lp.ctx.symbols) {
                next := format(label, "next", ci.to_str(), "p", pi.to_str())
                mut below := "jl"
                mut above := "jg"
                if fasm_unsigned(t) { below = "jb"; above = "ja" }
                fasm_expr(pattern.children[1], state, lp)
                fasm_emit(state, format("cmp ", value, ", rax\n    ", below, " ", next))
                fasm_expr(pattern.children[2], state, lp)
                fasm_emit(state, format("cmp ", value, ", rax\n    ", above, " ", next, "\n    jmp ", target, "\n", next, ":"))
                continue
            } else { fasm_expr(pattern, state, lp) }
            fasm_emit(state, format("cmp rax, ", value, "\n    je ", target))
        }
    }
    fasm_emit(state, format("jmp ", fallback))
    for ci in 1..e.children.len() {
        ref arm : Expr = e.children[ci]
        fasm_emit(state, format(label, "case", ci.to_str(), ":"))
        fasm_body(arm.children[arm.children.len() - 1], state, lp)
        fasm_emit(state, format("jmp ", label, "done"))
    }
    fasm_emit(state, format(label, "done:"))
}

priv fasm_body := proc(body: Expr, mut state: FasmState, mut lp: LoadedProgram, global_scope: Bool = false) {
    saved_values := state.values.clone()
    saved_types := state.value_types.clone()
    saved_addresses := state.addresses.clone()
    saved_pointers := state.pointers.clone()
    saved_boxes := state.boxes.clone()
    saved_no_free := state.no_free.clone()
    saved_references := state.references.clone()
    saved_parameters := state.parameters.clone()
    saved_signatures := state.signatures.clone()
    for stmt : Expr in body.children {
        switch stmt.node_type {
        case .Decl(dd):
            t := declaration_resolved_type(dd, lp.ctx.scope, lp.ctx.symbols)
            if t.is(Type.None) && stmt.children.len() == 1 && stmt.children[0].node_type.is(NodeType.Ident) { continue }
            aggregate := fasm_aggregate(t, lp)
            if stmt.children.len() != 1 || fasm_scalar(t).or(aggregate).not() {
                fasm_error(stmt, "unsupported local type or initializer", lp)
                continue
            }
            if type_is_callable_storage(t) {
                signature := fasm_signature_name(stmt.children[0], t, state.signatures, state.program, lp)
                if dd.own_type.is(OwnType.Ref) { fasm_callable_slot(stmt.children[0], state, lp) }
                else { fasm_expr(stmt.children[0], state, lp) }
                mut slot := fasm_slot(state)
                if global_scope.and(state.program.globals.has(dd.name)) { slot = format("qword [", state.program.globals[dd.name].label, "]") }
                fasm_emit(state, format("mov ", slot, ", rax"))
                fasm_bind(dd.name, t, own slot, false, dd.own_type.is(OwnType.Ref), false, false, state)
                if signature.len() > 0 { state.signatures.set(dd.name, own signature) }
                continue
            }
            raw := rhs_is_allocator_call(stmt.children[0], lp.ctx.symbols)
            boxed := dd.gc_storage.is(GcStorage.HeapBox).or(raw)
            pointer := aggregate.not().and(t.is(Type.Dynamic).not()).and(dd.own_type.is(OwnType.Ref).or(boxed))
            persistent := global_scope.and(state.program.globals.has(dd.name))
            if aggregate && dd.own_type.is(OwnType.Ref).or(boxed).not() {
                mut slot := fasm_snapshot(stmt.children[0], t, state, lp)
                if persistent {
                    destination := format("qword [", state.program.globals[dd.name].label, "]")
                    fasm_emit(state, format("lea rsi, ", slot.strip_prefix("qword "), "\n    lea rdi, ", destination.strip_prefix("qword "),
                        "\n    mov rdx, ", fasm_type_size(t, lp).to_str(), "\n    call rt_memcpy"))
                    slot = destination.clone()
                }
                fasm_bind(dd.name, t, own slot, true, false, false, false, state)
                continue
            }
            if boxed { fasm_owned(stmt.children[0], state, lp) }
            // A Dynamic receiving typed scalar pointer storage keeps the
            // address (for example Str.c_str), rather than loading its byte.
            else if t.is(Type.Dynamic).and(stmt.children[0].til_type().is(Type.Primitive)) { fasm_pointer(stmt.children[0], state, lp) }
            else if pointer.or(dd.own_type.is(OwnType.Ref)) { fasm_pointer(stmt.children[0], state, lp) }
            else { fasm_expr(stmt.children[0], state, lp) }
            mut slot := fasm_slot(state)
            if persistent { slot = format("qword [", state.program.globals[dd.name].label, "]") }
            fasm_emit(state, format("mov ", slot, ", rax"))
            fasm_bind(dd.name, t, own slot, false, pointer, boxed, dd.own_type.is(OwnType.Ref), state)
        case .Assign(dd):
            if state.values.has(dd.name).not() { fasm_error(stmt, "unknown assignment storage", lp); continue }
            ref mut rhs : Expr = stmt.children[0]
            if dd.is_move && rhs_is_clone_fcall(rhs, lp.ctx.symbols) { rhs = rhs.children[1] }
            t := state.value_types[dd.name].clone()
            if type_is_callable_storage(t) {
                mut target := Expr.new(own ident_node(lp.ctx.symbols.intern(dd.name)), stmt.line, stmt.col)
                target.set_til_type(t.clone())
                fasm_callable_slot(target, state, lp)
                destination := fasm_slot(state)
                fasm_emit(state, format("mov ", destination, ", rax"))
                fasm_callable_replace(rhs, destination, dd.save_old_delete, dd.is_move.not(), state, lp)
                continue
            }
            if state.references.has(dd.name).and(dd.is_payload_alias.not()) {
                mut rebind := rhs.node_type.is(NodeType.FieldAccess).and(fa_is_ns(rhs, lp.ctx.scope, lp.ctx.symbols).not())
                switch rhs.node_type {
                case .FCall:
                    rebind = fcall_returns_ref(rhs, lp.ctx.scope, lp.ctx.symbols) != 0
                case .Ident(id):
                    ref name : Str = id.ident_name(lp.ctx.symbols.names)
                    if state.values.has(name).not() { fasm_error(stmt, "unsupported reference reassignment source", lp); continue }
                    stack_value := state.addresses.has(name).or(fasm_scalar(state.value_types[name]).and(state.pointers.has(name).or(state.boxes.has(name)).not()))
                    rebind = stack_value.or(state.parameters.has(name)).not()
                case:
                }
                if rebind {
                    fasm_pointer(rhs, state, lp)
                    fasm_emit(state, format("mov ", state.values[dd.name], ", rax"))
                    continue
                }
            }
            if fasm_aggregate(t, lp) {
                if state.boxes.has(dd.name) && dd.is_payload_alias.not() {
                    fasm_owned(rhs, state, lp)
                    new_value := fasm_slot(state)
                    fasm_emit(state, format("mov ", new_value, ", rax\n    mov rdi, ", state.values[dd.name], "\n    mov ", state.values[dd.name], ", rax"))
                    if dd.save_old_delete { fasm_destroy(t, true, state, lp) }
                } else {
                    destination := fasm_slot(state)
                    if state.addresses.has(dd.name) { fasm_emit(state, format("lea rax, ", state.values[dd.name].strip_prefix("qword "))) }
                    else { fasm_emit(state, format("mov rax, ", state.values[dd.name])) }
                    fasm_emit(state, format("mov ", destination, ", rax"))
                    fasm_replace(rhs, t, destination, dd.save_old_delete, state, lp)
                    if state.references.has(dd.name) && fasm_is_str(t, lp) && rhs.node_type.is_literal_str() {
                        fasm_emit(state, format("mov rdx, ", destination, "\n    store_size [rdx+STR_CAP], CAP_VIEW"))
                    }
                }
                continue
            }
            fasm_expr(rhs, state, lp)
            if state.pointers.has(dd.name) {
                fasm_emit(state, format("mov rcx, ", state.values[dd.name]))
                fasm_store_scalar(stmt.til_type(), state)
            } else { fasm_emit(state, format("mov ", state.values[dd.name], ", rax")) }
        case .FieldAssign(fd):
            global_name := fasm_namespace_name(stmt, lp, state)
            if global_name.len() > 0 {
                mut assignment := stmt.clone()
                assignment.node_type = NodeType.Assign(AssignData(name=global_name.clone(),
                    save_old_delete=fd.save_old_delete, is_move=fd.is_move))
                assignment.children.clear()
                assignment.add_child(own stmt.children[1].clone())
                mut block := Expr.new(own NodeType.Body, stmt.line, stmt.col)
                block.add_child(own assignment)
                fasm_body(block, state, lp)
                continue
            }
            ref owner : Expr = stmt.children[0]
            ref mut rhs : Expr = stmt.children[1]
            if fd.is_move && rhs_is_clone_fcall(rhs, lp.ctx.symbols) { rhs = rhs.children[1] }
            if fasm_aggregate(owner.til_type(), lp).not() { fasm_error(stmt, "unsupported field assignment", lp); continue }
            ref field : Declaration = fasm_field_decl(owner, fd.name, lp)
            t := declaration_resolved_type(field, lp.ctx.scope, lp.ctx.symbols)
            if fasm_scalar(t).or(fasm_aggregate(t, lp)).not() { fasm_error(stmt, "unsupported assigned field type", lp); continue }
            fasm_field_address(owner, fd.name, state, lp)
            destination := fasm_slot(state)
            fasm_emit(state, format("mov ", destination, ", rax"))
            if type_is_callable_storage(t) && field.own_type.is(OwnType.Shallow) {
                fasm_callable_replace(rhs, destination, fd.save_old_delete, fd.is_move.not(), state, lp)
            } else if field.own_type.is(OwnType.Shallow) && fasm_aggregate(t, lp) {
                fasm_replace(rhs, t, destination, fd.save_old_delete, state, lp)
            } else if field.own_type.is(OwnType.Shallow) && t.is(Type.Dynamic).not() {
                fasm_expr(rhs, state, lp)
                fasm_emit(state, format("mov rcx, ", destination))
                fasm_store_scalar(t, state)
            } else {
                if field.own_type.is(OwnType.Own) { fasm_owned(rhs, state, lp) }
                else { fasm_pointer(rhs, state, lp) }
                value := fasm_slot(state)
                fasm_emit(state, format("mov ", value, ", rax"))
                if field.own_type.is(OwnType.Own) && fd.save_old_delete {
                    fasm_emit(state, format("mov rax, ", destination, "\n    mov rdi, [rax]"))
                    fasm_destroy(t, true, state, lp)
                }
                fasm_emit(state, format("mov rcx, ", destination, "\n    mov rax, ", value, "\n    mov [rcx], rax"))
            }
        case .Return:
            if stmt.children.len() > 0 {
                if state.return_ref { fasm_pointer(stmt.children[0], state, lp) }
                else if fasm_aggregate(state.return_type, lp) {
                    fasm_pointer(stmt.children[0], state, lp)
                    source := fasm_slot(state)
                    fasm_emit(state, format("mov ", source, ", rax\n    mov rsi, rax\n    mov rdi, ", state.return_buffer,
                        "\n    mov rdx, ", fasm_type_size(state.return_type, lp).to_str(), "\n    call rt_memcpy"))
                    fasm_release_value_outer(stmt.children[0], source, state, lp)
                    fasm_emit(state, format("mov rax, ", state.return_buffer))
                }
                else { fasm_expr(stmt.children[0], state, lp) }
            }
            fasm_emit(state, "leave\n    ret")
        case .FCall:
            if fcall_of(stmt).swap_replace {
                // The shared ownership pass marks mut-aggregate replacement
                // as delete/copy/consume, not a literal byte swap that leaves
                // the old payload stranded in a consumed temporary.
                switch stmt.children[1].node_type {
                case .Ident(id):
                    t := state.value_types[id.ident_name(lp.ctx.symbols.names)].clone()
                    fasm_pointer(stmt.children[1], state, lp)
                    destination := fasm_slot(state)
                    fasm_emit(state, format("mov ", destination, ", rax"))
                    fasm_replace(stmt.children[2], t, destination, true, state, lp)
                case: fasm_error(stmt, "unsupported aggregate replacement target", lp)
                }
                continue
            }
            if fcall_is_direct(stmt) && fasm_aggregate(stmt.til_type(), lp) && fasm_callee_name(stmt, lp) == type_name_ref(stmt.til_type(), lp.ctx.symbols) { continue }
            fasm_expr(stmt, state, lp, true)
            if type_is_callable_storage(stmt.til_type()) && fasm_call_returns_ref(stmt, state, lp).not() {
                fasm_emit(state, "mov rdi, rax\n    call rt_til_closure_delete")
            } else if fasm_boxed(stmt, state, lp) {
                fasm_emit(state, "mov rdi, rax")
                fasm_destroy(stmt.til_type(), true, state, lp)
            } else if fasm_aggregate(stmt.til_type(), lp).and(fasm_call_returns_ref(stmt, state, lp).not()) {
                fasm_emit(state, "mov rdi, rax")
                fasm_destroy(stmt.til_type(), false, state, lp)
            }
        case .Body: fasm_body(stmt, state, lp)
        case .CaptureBlock: fasm_body(stmt.children[0], state, lp)
        case .Switch: fasm_switch(stmt, state, lp)
        case .While:
            label := state.labels.to_str()
            state.labels++
            saved_break := state.break_label.clone()
            saved_continue := state.continue_label.clone()
            state.break_label = format(".done", label)
            state.continue_label = format(".loop", label)
            fasm_emit(state, format(state.continue_label, ":"))
            fasm_expr(stmt.children[0], state, lp)
            fasm_emit(state, format("test rax, rax\n    jz ", state.break_label))
            fasm_body(stmt.children[1], state, lp)
            fasm_emit(state, format("jmp ", state.continue_label, "\n", state.break_label, ":"))
            state.break_label = saved_break.clone()
            state.continue_label = saved_continue.clone()
        case .Break, .Continue:
            if state.break_label.len() == 0 { fasm_error(stmt, "loop transfer outside a loop", lp); continue }
            if stmt.node_type.is(NodeType.Break) { fasm_emit(state, format("jmp ", state.break_label)) }
            else { fasm_emit(state, format("jmp ", state.continue_label)) }
        case .If:
            label := state.labels.to_str()
            state.labels++
            fasm_expr(stmt.children[0], state, lp)
            fasm_emit(state, format("test rax, rax\n    jz .else", label))
            fasm_body(stmt.children[1], state, lp)
            fasm_emit(state, format("jmp .end", label, "\n.else", label, ":"))
            if stmt.children.len() > 2 { fasm_body(stmt.children[2], state, lp) }
            fasm_emit(state, format(".end", label, ":"))
        case: fasm_error(stmt, "unsupported statement", lp)
        }
    }
    state.values = saved_values.clone()
    state.value_types = saved_types.clone()
    state.addresses = saved_addresses.clone()
    state.pointers = saved_pointers.clone()
    state.boxes = saved_boxes.clone()
    state.no_free = saved_no_free.clone()
    state.references = saved_references.clone()
    state.parameters = saved_parameters.clone()
    state.signatures = saved_signatures.clone()
}

priv fasm_function := proc(name: Str, mut program: FasmProgram, mut lp: LoadedProgram) returns Str {
    if name.starts_with("@drop:").or(name.starts_with("@clone:")) {
        return fasm_environment_function(name, name.starts_with("@clone:"), program, lp)
    }
    ref expr : Expr = fasm_definition(name, program, lp)
    fd := fasm_callable_fd(expr)
    context_enter_file(lp.ctx, program.definitions[name].path)
    if fd.auto_generated && name.ends_with("_size") && fd.sig.params.len() == 0 {
        owner := type_from_name_init_name(name.strip_suffix("_size"), lp.ctx.scope, lp.ctx.symbols)
        if fasm_scalar(owner).or(fasm_aggregate(owner, lp)).not() { fasm_error(expr, "unsupported size query", lp); return "" }
        return format(program.labels[name], ":\n    mov rax, ", fasm_type_size(owner, lp).to_str(), "\n    ret\n")
    }
    if fd.sig.func_type.is(FuncType.Macro) || fd.sig.kwargs_index >= 0 {
        fasm_error(expr, "unsupported callable definition", lp)
        return ""
    }
    ret := type_from_name_init_name(fd.sig.return_type, lp.ctx.scope, lp.ctx.symbols)
    if fd.sig.return_type.len() > 0 && fasm_scalar(ret).or(fasm_aggregate(ret, lp)).not() {
        fasm_error(expr, "unsupported return type", lp)
        return ""
    }
    if name == "main" && (fd.sig.params.len() > 0 || fd.sig.return_type.len() > 0) {
        fasm_error(expr, "main must take no arguments and return no value", lp)
        return ""
    }
    if fd.sig.params.len() > 6 { fasm_error(expr, "at most six parameters are supported", lp); return "" }
    mut state := FasmState(program = program)
    fasm_bind_globals(state)
    state.prefix = program.labels[name].clone()
    state.interface_name = fasm_interface_owner(name,program,lp)
    state.return_type = ret.clone()
    state.return_ref = fd.sig.return_own_type.is(OwnType.Ref)
    if fasm_aggregate(ret, lp).and(state.return_ref.not()) {
        state.return_buffer = fasm_slot(state)
        fasm_emit(state, format("mov ", state.return_buffer, ", rax"))
    }
    if fasm_outer_selector(fd, lp) {
        state.outer_parameter = fd.sig.params[0].name.clone()
        state.outer_heap = fasm_slot(state)
        fasm_emit(state, format("mov ", state.outer_heap, ", r11"))
    }
    mut environment := ""
    if fd.captures.len() > 0 {
        environment = fasm_slot(state)
        fasm_emit(state, format("mov ", environment, ", r10"))
    }
    mut incoming := Vec(Str).new()
    for i in 0..fd.sig.params.len() {
        slot := fasm_slot(state)
        fasm_emit(state, format("mov ", slot, ", ", fasm_register(i)))
        incoming.push(own slot)
    }
    for i in 0..fd.sig.params.len() {
        ref p : Declaration = fd.sig.params[i]
        t := fasm_parameter_type(fd, i, lp)
        aggregate := fasm_aggregate(t, lp)
        if aggregate.or(fasm_scalar(t)).not() {
            fasm_error(expr, "unsupported parameter type", lp)
            return ""
        }
        mut slot := incoming[i].clone()
        by_value := func_param_passes_c_value(fd, i, lp.ctx.param_value_abi_ok, lp.ctx.scope, lp.ctx.symbols)
        stack_outer := fasm_param_stack_outer(fd, i, lp)
        if aggregate && by_value {
            slot = fasm_value_slot(t, state, lp)
            fasm_emit(state, format("mov rsi, ", incoming[i], "\n    lea rdi, ", slot.strip_prefix("qword "),
                "\n    mov rdx, ", fasm_type_size(t, lp).to_str(), "\n    call rt_memcpy"))
        }
        no_free := by_value.or(stack_outer).or(p.own_type.is(OwnType.Own).and(t.is(Type.Primitive)))
        mut pointer := by_value.or(aggregate).or(t.is(Type.Dynamic)).not()
        if type_is_callable_storage(t) { pointer = p.is_mut }
        fasm_bind(p.name, t, own slot, aggregate.and(by_value),
            pointer, p.own_type.is(OwnType.Own).and(no_free.not()).and(type_is_callable_storage(t).not()), false, state)
        state.parameters.add(own p.name.clone())
        if is_funcptr_sig(t) { state.signatures.set(p.name, own type_name_ref(t, lp.ctx.symbols).clone()) }
        if no_free {
            state.no_free.add(own p.name.clone())
        }
    }
    for i in 0..fd.captures.len() {
        ref cap : Declaration = fd.captures[i]
        slot := fasm_slot(state)
        fasm_emit(state, format("mov rax, ", environment, "\n    mov rax, [rax+", (i * 8).to_str(), "]\n    mov ", slot, ", rax"))
        fasm_bind(cap.name, cap.til_type, own slot, false, fasm_scalar(cap.til_type).and(cap.til_type.is(Type.Dynamic).not()), false, false, state)
        state.parameters.add(own cap.name.clone())
        if program.definitions[name].capture_signatures.has(cap.name) {
            state.signatures.set(cap.name, own program.definitions[name].capture_signatures[cap.name].clone())
        } else if is_funcptr_sig(cap.til_type) { state.signatures.set(cap.name, own type_name_ref(cap.til_type, lp.ctx.symbols).clone()) }
    }
    if fasm_interface_dispatchable(name,program,lp) {
        fasm_interface_dispatch(name,expr,state,lp)
    } else if fd.sig.func_type.is_bodyless().or(fasm_float_factory(name,program,lp)) {
        ref location : FasmDefinition = program.definitions[name]
        mut callee := Expr.new(own ident_node(lp.ctx.symbols.intern(name)), expr.line, expr.col)
        if location.member >= 0 {
            ref unit : ImportUnit = lp.ctx.imported.get(location.path)!
            ref declaration : Expr = unit.ast.children.unsafe_get(location.declaration)
            ref definition : Expr = declaration.children[0]
            callee.node_type = field_access_node(lp.ctx.symbols.intern(def_ns_name_at(definition, location.member.to_usize())))
            callee.add_child(own Expr.new(own ident_node(lp.ctx.symbols.intern(decl_of(declaration).name)), expr.line, expr.col))
        }
        mut call := Expr.new(own NodeType.FCall(FCallData()), expr.line, expr.col)
        call.add_child(own callee)
        call.set_til_type(ret.clone())
        for i in 0..fd.sig.params.len() {
            ref param : Declaration = fd.sig.params[i]
            mut arg := Expr.new(own ident_node(lp.ctx.symbols.intern(param.name)), expr.line, expr.col)
            arg.set_til_type(fasm_parameter_type(fd, i, lp))
            call.add_child(own arg)
            if param.own_type.is(OwnType.Own) { set_own_arg(call, i + 1) }
        }
        mark_fcall_direct(call)
        fasm_expr(call, state, lp, state.return_ref)
        if state.return_buffer.len() > 0 {
            fasm_emit(state, format("mov rsi, rax\n    mov rdi, ", state.return_buffer,
                "\n    mov rdx, ", fasm_type_size(ret, lp).to_str(), "\n    call rt_memcpy\n    mov rax, ", state.return_buffer))
        }
        fasm_emit(state, "leave\n    ret")
    } else if expr.children.len() == 0 {
        fasm_error(expr, "a function signature is not a callable implementation", lp)
        return ""
    } else { fasm_body(expr.children[0], state, lp) }
    // A non-void fallthrough is a compiler invariant violation, not a value.
    if fd.sig.return_type.len() > 0 { fasm_emit(state, "ud2") }
    else { fasm_emit(state, "leave\n    ret") }
    size := ((state.slots * 8 + 15) / 16) * 16
    return format(program.labels[name], ":\n    push rbp\n    mov rbp, rsp\n    sub rsp, ", size.to_str(), "\n", state.text, state.data)
}

priv fasm_test_report := proc(message: Str, mut state: FasmState, mut lp: LoadedProgram) {
    mut value := Expr.new(own NodeType.Literal(Literal.Str(message.clone())), 0, 0)
    value.set_til_type(type_from_name_init_name("Str", lp.ctx.scope, lp.ctx.symbols))
    fasm_expr(value, state, lp)
    fasm_emit(state, "mov rdi, rax\n    call rt_eprint_single")
}

priv fasm_test_entry := proc(mut program: FasmProgram, mut lp: LoadedProgram) returns Str {
    mut state := FasmState(program=program)
    state.prefix = "test_main"
    mut count:USize=0
    // Match C and interpretation: user units in dependency order, top-level
    // tests and struct/enum namespace tests in their declaration order.
    for unit:ProgramUnit in lp.units {
        context_enter_file(lp.ctx, unit.path)
        for stmt:Expr in lp.ctx.imported[unit.path].ast.children {
            if stmt.node_type.is(NodeType.Decl).not().or(stmt.children.len().eq(0)) { continue }
            ref declaration:Declaration=decl_of(stmt)
            ref value:Expr=stmt.children[0]
            if value.node_type.is(NodeType.FuncDef) {
                if funcdef_of(value).sig.func_type.is(FuncType.Test).not() { continue }
                fasm_emit(state,format("call ",fasm_request(declaration.name,program)))
                fasm_test_report(format("  pass: ",declaration.name,"\n"),state,lp)
                count++
            } else if value.node_type.is(NodeType.StructDef).or(value.node_type.is(NodeType.EnumDef)) {
                ref members:Vec(Declaration)=def_ns_decls(value)
                for i in 0..members.len() {
                    ref member:Declaration=members[i]
                    if member.default_value.is_none() { continue }
                    ref body:Expr=member.default_expr()
                    if body.node_type.is(NodeType.FuncDef).not() { continue }
                    if funcdef_of(body).sig.func_type.is(FuncType.Test).not() { continue }
                    ref name:Str=def_ns_name_at(value,i)
                    fasm_emit(state,format("call ",fasm_request(format(declaration.name,"_",name),program)))
                    fasm_test_report(format("  pass: ",declaration.name,".",name,"\n"),state,lp)
                    count++
                }
            }
        }
    }
    if count == 0 { fasm_test_report("no tests found\n",state,lp) }
    else { fasm_test_report(format(count.to_str(),"/",count.to_str()," tests passed\n"),state,lp) }
    bytes:=((state.slots*8+15)/16)*16
    return format(state.prefix,":\n    push rbp\n    mov rbp, rsp\n    sub rsp, ",bytes.to_str(),"\n",
        state.text,"    leave\n    ret\n",state.data)
}

fasm_codegen_translate := proc(mut lp: LoadedProgram, path: Str, source_names: Set(Str)) returns I32 {
    context_enter_file(lp.ctx, lp.units[lp.units.len() - 1].path)
    mut program := FasmProgram()
    program.source_names = source_names.clone()
    for unit : ProgramUnit in lp.core_units {
        fasm_collect(lp.ctx.imported[unit.path].ast, unit.path, program)
    }
    for unit : ProgramUnit in lp.units {
        fasm_collect(lp.ctx.imported[unit.path].ast, unit.path, program)
    }
    script := lp.mode_str.eq("script").and(lp.run_tests.not())
    if script.or(lp.run_tests).not() && program.definitions.has("main").not() { println("error: FASM backend requires a no-argument main"); return 1 }
    mut width := "8"
    mut str_size := "24"
    mut cap_offset := "16"
    mut cap_view := "-2"
    mut cap_lit := "-1"
    if lp.ctx.target_usize_bytes == 4 { width = "4"; str_size = "16"; cap_offset = "12"; cap_view = "0xfffffffe"; cap_lit = "0xffffffff" }
    runtime := format(lp.ctx.import_support_dir, "/src/self/codegen/ext.fasm")
    mut entry := "script_main"
    mut test_entry := ""
    if lp.run_tests { entry = "test_main"; test_entry = fasm_test_entry(program,lp) }
    else if script.not() { entry = fasm_request("main", program) }
    mut initialization := ""
    mut initializers := ""
    paths := lp.unit_paths()
    mut bodies := Vec(Expr).new()
    // Static literals are available to every initializer. Namespace runtime
    // values precede ordinary module initializers, matching the shared order.
    for phase in 0..3 {
        for unit_path : Str in paths {
            context_enter_file(lp.ctx, unit_path)
            bodies.push(own fasm_global_body(lp.ctx.imported[unit_path].ast, phase.to_usize(), program, lp))
        }
    }
    if lp.ctx.errors > 0 { return 1 }
    for i in 0..bodies.len() {
        ref body : Expr = bodies[i]
        if body.children.len() == 0 && script.and(i == bodies.len() - 1).not() { continue }
        context_enter_file(lp.ctx, paths[i.mod(paths.len())])
        mut state := FasmState(program=program)
        fasm_bind_globals(state)
        state.prefix = format("init", i.to_str())
        fasm_body(body, state, lp, true)
        bytes := ((state.slots * 8 + 15) / 16) * 16
        if script && i == bodies.len() - 1 { entry = state.prefix.clone() }
        else { initialization = format(initialization, "    call ", state.prefix, "\n") }
        initializers = format(initializers, state.prefix, ":\n    push rbp\n    mov rbp, rsp\n    sub rsp, ", bytes.to_str(),
            "\n", state.text, "    leave\n    ret\n", state.data)
    }
    context_enter_file(lp.ctx, lp.units[lp.units.len() - 1].path)
    mut text := format("format ELF64 executable 3\nentry start\nUSIZE_BYTES = ", width, "\nSTR_SIZE = ", str_size, "\nSTR_CAP = ", cap_offset,
        "\nCAP_VIEW = ", cap_view, "\nCAP_LIT = ", cap_lit,
        "\nsegment readable executable\ninclude '", runtime.replace("'", "''"), "'\nsegment readable executable\nstart:\n", initialization,
        "    call ", entry, "\n    xor edi, edi\n    jmp rt_exit\n", initializers,test_entry)
    mut next : USize = 0
    while next < program.pending.len() {
        name := program.pending[next].clone()
        text = format(text, fasm_function(name, program, lp))
        next++
    }
    if lp.ctx.errors > 0 { return 1 }
    text = format(text, "segment readable\n", program.callable_data, "segment readable writeable\n", program.global_data)
    File.writefile(path, text)
    return 0
}
