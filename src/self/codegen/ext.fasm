; Linux x86-64 native runtime. Behavioral reference: src/self/codegen/ext.c and the
; core Str/Array(Str) definitions. SysV registers; rax is the result.
; The emitter defines USIZE_BYTES (4/8), STR_SIZE (16/24), STR_CAP (12/16).
; Str is {pointer, USize count, USize cap}; Array(Str) is {pointer,USize cap}.
; Aggregate-producing entries receive caller-owned result storage in RAX and
; return that address. R11 selects owned outer storage for lifecycle calls.

macro load_size destination, address {
    if USIZE_BYTES = 4
        mov eax, dword address
        mov destination, rax
    else
        mov destination, qword address
    end if
}
macro store_size address, value {
    mov rax, value
    if USIZE_BYTES = 4
        mov dword address, eax
    else
        mov qword address, rax
    end if
}
macro frame bytes {
    push rbp
    mov rbp, rsp
    sub rsp, bytes
}

rt_exit:
    mov eax, 60
    syscall
    ud2

; Fatal runtime diagnostics go to stderr. Language panic goes to stdout.
rt_fail:
    mov rsi, rdi
    xor edx, edx
.length:
    cmp byte [rsi+rdx], 0
    je .write
    inc rdx
    jmp .length
.write:
    test rdx, rdx
    jz .exit
    mov edi, 2
    mov eax, 1
    syscall
    cmp rax, -4
    je .write
    test rax, rax
    jle .exit
    add rsi, rax
    sub rdx, rax
    jmp .write
.exit:
    mov edi, 1
    jmp rt_exit

; Complete writes, retrying EINTR. Zero-length writes do not dereference buf.
rt_write_all:
    test rdx, rdx
    jz .done
.next:
    mov eax, 1
    syscall
    cmp rax, -4
    je .next
    test rax, rax
    jle .error
    add rsi, rax
    sub rdx, rax
    jnz .next
.done:
    ret
.error:
    mov rdi, rt_io_error
    jmp rt_fail

rt_print_single:
    load_size rdx, [rdi+8]
    mov rsi, [rdi]
    mov edi, 1
    jmp rt_write_all
rt_eprint_single:
    load_size rdx, [rdi+8]
    mov rsi, [rdi]
    mov edi, 2
    jmp rt_write_all
rt_print_flush:
    mov edi, 1
    mov rsi, rt_newline
    mov edx, 1
    jmp rt_write_all

; One anonymous mapping per allocation. A 16-byte private header records
; the requested extent for realloc and munmap. Returned storage is aligned.
rt_malloc:
    push rdi
    mov rsi, rdi
    add rsi, 16
    jc .error
    xor edi, edi
    mov edx, 3
    mov r10d, 22h
    mov r8, -1
    xor r9d, r9d
    mov eax, 9
    syscall
    cmp rax, -4095
    jae .error
    pop rdi
    mov [rax], rdi
    add rax, 16
    ret
.error:
    ; malloc's nullable failure result, including size overflow.
    pop rdi
    xor eax, eax
    ret
rt_free:
    test rdi, rdi
    jz .done
    sub rdi, 16
    mov rsi, [rdi]
    add rsi, 16
    mov eax, 11
    syscall
    test rax, rax
    jnz .error
.done:
    ret
.error:
    mov rdi, rt_alloc_error
    jmp rt_fail
rt_calloc:
    mov rax, rdi
    mul rsi
    test rdx, rdx
    jnz .error
    mov rdi, rax
    jmp rt_malloc
.error:
    xor eax, eax
    ret
rt_realloc:
    frame 32
    mov [rbp-8], rdi
    mov [rbp-16], rsi
    test rsi, rsi
    jnz .allocate
    call rt_free
    xor eax, eax
    leave
    ret
.allocate:
    mov rdi, rsi
    call rt_malloc
    mov [rbp-24], rax
    test rax, rax
    jz .done
    mov rsi, [rbp-8]
    test rsi, rsi
    jz .done
    mov rdx, [rsi-16]
    cmp rdx, [rbp-16]
    cmova rdx, [rbp-16]
    mov rdi, rax
    call rt_memcpy
    mov rdi, [rbp-8]
    call rt_free
.done:
    mov rax, [rbp-24]
    leave
    ret
rt_memcpy:
    mov rcx, rdx
    cld
    rep movsb
    ret

; Callable values use {code, env, drop, clone} native-pointer descriptors.
; A null descriptor is an empty moved slot; drop=0 denotes static storage.
; Capturing descriptors, environments and private value space share one block.
; Drop destroys captures; clone receives env and returns a complete descriptor.
rt_til_closure_delete:
    test rdi, rdi
    jz .done
    cmp qword [rdi+16], 0
    je .done
    frame 16
    mov [rbp-8], rdi
    mov rax, [rdi+16]
    mov rdi, [rdi+8]
    call rax
    mov rdi, [rbp-8]
    call rt_free
    leave
.done:
    ret
rt_til_closure_slot_delete:
    mov rax, [rdi]
    mov qword [rdi], 0
    mov rdi, rax
    jmp rt_til_closure_delete
rt_til_closure_slot_take:
    mov [rdi], rsi
    ret
rt_til_closure_slot_pop:
    mov rax, [rdi]
    mov qword [rdi], 0
    ret
rt_closure_clone:
    test rdi, rdi
    jz .shared
    cmp qword [rdi+16], 0
    je .shared
    frame 0
    mov rax, rdi
    mov rdi, [rax+8]
    call qword [rax+24]
    leave
    ret
.shared:
    mov rax, rdi
    ret
rt_til_closure_slot_clone:
    frame 16
    mov rdi, [rdi]
    call rt_closure_clone
    mov [rbp-8], rax
    mov edi, 8
    call rt_malloc
    mov rdx, [rbp-8]
    mov [rax], rdx
    leave
    ret

rt_memmove:
    cmp rdi, rsi
    jbe rt_memcpy
    test rdx, rdx
    jz .done
    lea rdi, [rdi+rdx-1]
    lea rsi, [rsi+rdx-1]
    mov rcx, rdx
    std
    rep movsb
    cld
.done:
    ret
rt_memset:
    mov rax, rsi
    mov rcx, rdx
    cld
    rep stosb
    ret
rt_memcmp:
    xor eax, eax
    test rdx, rdx
    jz .done
.next:
    movzx eax, byte [rdi]
    movzx ecx, byte [rsi]
    sub eax, ecx
    jnz .done
    inc rdi
    inc rsi
    dec rdx
    jnz .next
.done:
    movsxd rax, eax
    ret
rt_c_str_len:
    xor eax, eax
.next:
    cmp byte [rdi+rax], 0
    je .done
    inc rax
    jmp .next
.done:
    ret
rt_ptr_eq:
    cmp rdi, rsi
    sete al
    movzx eax, al
    ret
rt_dynamic_clone:
    frame 16
    mov [rbp-8], rdi
    mov edi, 8
    call rt_malloc
    mov rdx, [rbp-8]
    mov rdx, [rdx]
    mov [rax], rdx
    leave
    ret
rt_dynamic_delete:
    test rsi, rsi
    jnz rt_free
    ret

; Fill the caller's descriptor; only character storage is allocated.
rt_str_capacity:
    test rdi, rdi
    jnz rt_str_allocate_owned
    mov rdx, rax
    mov qword [rdx], rt_empty
    store_size [rdx+8], 0
    store_size [rdx+STR_CAP], CAP_LIT
    mov rax, rdx
    ret
rt_str_allocate_owned:
    frame 32
    mov [rbp-24], rax
    mov [rbp-8], rdi
    inc rdi
    jz .error
    call rt_malloc
    test rax, rax
    jz .error
    mov [rbp-16], rax
    mov byte [rax], 0
    mov rdx, [rbp-24]
    mov rcx, [rbp-16]
    mov [rdx], rcx
    store_size [rdx+8], 0
    store_size [rdx+STR_CAP], [rbp-8]
    mov rax, rdx
    leave
    ret
.error:
    mov rdi, rt_alloc_error
    jmp rt_fail
rt_str_clone:
    frame 32
    mov [rbp-24], rax
    mov [rbp-8], rdi
    load_size rdi, [rdi+8]
    mov rax, [rbp-24]
    call rt_str_capacity
    mov [rbp-16], rax
    mov rdi, rax
    mov rsi, [rbp-8]
    call rt_str_push
    mov rax, [rbp-16]
    leave
    ret
rt_str_push:
    frame 48
    mov [rbp-8], rdi
    mov [rbp-16], rsi
    load_size rdx, [rsi+8]
    test rdx, rdx
    jz .done
    mov [rbp-24], rdx
    load_size rcx, [rdi+STR_CAP]
    mov r9, CAP_VIEW
    cmp rcx, r9
    jae .view_error
    load_size r8, [rdi+8]
    add r8, rdx
    jc .capacity_error
    cmp r8, rcx
    ja .capacity_error
    mov [rbp-32], r8
    mov rdi, [rdi]
    add rdi, r8
    sub rdi, rdx
    mov rsi, [rsi]
    call rt_memcpy
    mov rdi, [rbp-8]
    mov rdx, [rbp-32]
    store_size [rdi+8], rdx
    mov rax, [rdi]
    mov byte [rax+rdx], 0
.done:
    leave
    ret
.view_error:
    mov rdi, rt_view_error
    jmp rt_str_panic
.capacity_error:
    mov rdi, rt_capacity_error
    jmp rt_str_panic
rt_str_delete:
    frame 32
    mov [rbp-8], rdi
    mov [rbp-16], rsi
    mov [rbp-24], r11
    load_size rdx, [rdi+STR_CAP]
    mov r9, CAP_LIT
    cmp rdx, r9
    je .done
    mov r9, CAP_VIEW
    cmp rdx, r9
    je .wrapper
    mov rdi, [rdi]
    call rt_free
.wrapper:
    cmp qword [rbp-16], 0
    je .done
    cmp qword [rbp-24], 0
    je .done
    mov rdi, [rbp-8]
    call rt_free
.done:
    leave
    ret
rt_str_view:
    frame 16
    mov [rbp-8], rdi
    mov [rbp-16], rax
    mov rdi, rax
    mov rsi, [rbp-8]
    mov edx, STR_SIZE
    call rt_memcpy
    mov rdx, [rbp-16]
    store_size [rdx+STR_CAP], CAP_VIEW
    mov rax, rdx
    leave
    ret
rt_str_from_c:
    frame 32
    mov [rbp-8], rdi
    mov [rbp-24], rax
    call rt_c_str_len
    mov [rbp-16], rax
    mov rdx, [rbp-24]
    mov rcx, [rbp-8]
    mov [rdx], rcx
    store_size [rdx+8], [rbp-16]
    store_size [rdx+STR_CAP], CAP_VIEW
    mov rax, rdx
    leave
    ret
rt_str_substr:
    frame 32
    mov [rbp-32], rax
    mov [rbp-8], rdi
    load_size r8, [rdi+8]
    cmp rsi, r8
    cmova rsi, r8
    mov rcx, rsi
    add rcx, rdx
    if USIZE_BYTES = 4
        mov ecx, ecx
    end if
    cmp rcx, r8
    jbe .count
    mov rdx, r8
    sub rdx, rsi
.count:
    mov [rbp-16], rsi
    mov [rbp-24], rdx
    mov rax, [rbp-32]
    call rt_str_view
    mov rdx, rax
    mov rcx, [rbp-16]
    add [rdx], rcx
    store_size [rdx+8], [rbp-24]
    mov rax, rdx
    leave
    ret
rt_str_eq:
    load_size rdx, [rdi+8]
    load_size rcx, [rsi+8]
    cmp rdx, rcx
    jne .different
    mov rdi, [rdi]
    mov rsi, [rsi]
    sub rsp, 8
    call rt_memcmp
    add rsp, 8
    test rax, rax
    sete al
    movzx eax, al
    ret
.different:
    xor eax, eax
    ret

; Variadic Array(Str) values have inline Str elements, as in the C backend.
rt_parts_new:
    frame 32
    mov [rbp-8], rdi
    mov [rbp-24], rax
    mov rsi, STR_SIZE
    call rt_calloc
    mov [rbp-16], rax
    mov rdx, [rbp-24]
    mov rcx, [rbp-16]
    mov [rdx], rcx
    store_size [rdx+8], [rbp-8]
    mov rax, rdx
    leave
    ret
rt_parts_set:
    load_size rcx, [rdi+8]
    cmp rsi, rcx
    jae .error
    imul rsi, STR_SIZE
    add rsi, [rdi]
    mov rdi, rsi
    mov rsi, rdx
    mov edx, STR_SIZE
    jmp rt_memcpy
.error:
    mov rdi, rt_parts_error
    jmp rt_fail
rt_parts_delete:
    frame 32
    mov [rbp-8], rdi
    mov [rbp-16], rsi
    mov qword [rbp-24], 0
.next:
    mov rdi, [rbp-8]
    load_size rcx, [rdi+8]
    mov rax, [rbp-24]
    cmp rax, rcx
    jae .buffer
    imul rax, STR_SIZE
    add rax, [rdi]
    mov rdi, rax
    xor esi, esi
    call rt_str_delete
    inc qword [rbp-24]
    jmp .next
.buffer:
    mov rdi, [rbp-8]
    mov rdi, [rdi]
    call rt_free
    cmp qword [rbp-16], 0
    je .done
    mov rdi, [rbp-8]
    call rt_free
.done:
    leave
    ret
rt_print:
    frame 32
    mov [rbp-8], rdi
    mov qword [rbp-16], 0
.next:
    mov rdi, [rbp-8]
    load_size rcx, [rdi+8]
    mov rax, [rbp-16]
    cmp rax, rcx
    jae .done
    imul rax, STR_SIZE
    add rax, [rdi]
    mov rdi, rax
    call rt_print_single
    inc qword [rbp-16]
    jmp .next
.done:
    mov rdi, [rbp-8]
    xor esi, esi
    call rt_parts_delete
    leave
    ret
rt_println:
    sub rsp, 8
    call rt_print
    call rt_print_flush
    add rsp, 8
    ret
rt_format:
    frame 48
    mov [rbp-40], rax
    mov [rbp-8], rdi
    mov qword [rbp-16], 0
    mov qword [rbp-24], 0
.count:
    mov rdi, [rbp-8]
    load_size rcx, [rdi+8]
    mov rax, [rbp-16]
    cmp rax, rcx
    jae .allocate
    imul rax, STR_SIZE
    add rax, [rdi]
    load_size rdx, [rax+8]
    add [rbp-24], rdx
    jc .overflow
    inc qword [rbp-16]
    jmp .count
.allocate:
    mov rdi, [rbp-24]
    mov rax, [rbp-40]
    call rt_str_capacity
    mov [rbp-32], rax
    mov qword [rbp-16], 0
.append:
    mov rdi, [rbp-8]
    load_size rcx, [rdi+8]
    mov rax, [rbp-16]
    cmp rax, rcx
    jae .done
    imul rax, STR_SIZE
    add rax, [rdi]
    mov rsi, rax
    mov rdi, [rbp-32]
    call rt_str_push
    inc qword [rbp-16]
    jmp .append
.done:
    mov rdi, [rbp-8]
    xor esi, esi
    call rt_parts_delete
    mov rax, [rbp-32]
    leave
    ret
.overflow:
    mov rdi, rt_alloc_error
    jmp rt_fail
rt_panic:
    frame 16
    mov [rbp-8], rdi
    mov rdi, rsi
    call rt_print_single
    mov edi, 1
    mov rsi, rt_panic_separator
    mov edx, 9
    call rt_write_all
    mov rdi, [rbp-8]
    call rt_println
    mov edi, 1
    jmp rt_exit
rt_str_panic:
    frame 16
    mov [rbp-8], rdi
    call rt_c_str_len
    mov [rbp-16], rax
    mov edi, 1
    mov rsi, rt_native_panic
    mov edx, rt_native_panic_end-rt_native_panic
    call rt_write_all
    mov edi, 1
    mov rsi, [rbp-8]
    mov rdx, [rbp-16]
    call rt_write_all
    mov edi, 1
    jmp rt_exit
rt_assert:
    test rdi, rdi
    jz .failed
    ret
.failed:
    sub rsp, 8
    mov rdi, rsi
    call rt_print_single
    mov edi, 1
    mov rsi, rt_assert_message
    mov edx, rt_assert_message_end-rt_assert_message
    call rt_write_all
    mov edi, 1
    jmp rt_exit
rt_expect:
    test rdi, rdi
    jz .failed
    mov rdi, rsi
    xor esi, esi
    jmp rt_parts_delete
.failed:
    frame 16
    mov [rbp-8], rsi
    mov rdi, rdx
    call rt_print_single
    mov edi, 1
    mov rsi, rt_expect_message
    mov edx, rt_expect_message_end-rt_expect_message
    call rt_write_all
    mov rdi, [rbp-8]
    call rt_println
    mov edi, 1
    jmp rt_exit
rt_i64_to_str:
    mov r11, rax
    mov r8, rdi
    sar r8, 63
    mov rax, rdi
    xor rax, r8
    sub rax, r8
    jmp rt_integer_to_str
rt_u64_to_str:
    mov r11, rax
    xor r8d, r8d
    mov rax, rdi
rt_integer_to_str:
    frame 64
    mov [rbp-64], r11
    lea rsi, [rbp-32]
    xor ecx, ecx
    mov r9d, 10
.digit:
    xor edx, edx
    div r9
    add dl, '0'
    dec rsi
    mov [rsi], dl
    inc rcx
    test rax, rax
    jnz .digit
    test r8, r8
    jz .allocate
    dec rsi
    mov byte [rsi], '-'
    inc rcx
.allocate:
    mov [rbp-8], rsi
    mov [rbp-16], rcx
    mov rdi, rcx
    mov rax, [rbp-64]
    call rt_str_capacity
    mov [rbp-24], rax
    mov rdi, [rax]
    mov rsi, [rbp-8]
    mov rdx, [rbp-16]
    call rt_memcpy
    mov rdx, [rbp-24]
    mov rcx, [rbp-16]
    store_size [rdx+8], rcx
    mov rax, [rdx]
    mov byte [rax+rcx], 0
    mov rax, rdx
    leave
    ret

; Match C's %g / %.9g / %.17g in the default nearest-even environment.
; Expand the finite IEEE value exactly as decimal digits, then round once.
; 800 bytes cover a 53-bit significand scaled by 2^-1074.
rt_f32_to_str:
    mov esi, 6
    mov edx, 4
    jmp rt_float_to_str
rt_f32_to_repr:
    mov esi, 9
    mov edx, 4
    jmp rt_float_to_str
rt_f64_to_str:
    mov esi, 6
    mov edx, 8
    jmp rt_float_to_str
rt_f64_to_repr:
    mov esi, 17
    mov edx, 8
rt_float_to_str:
    frame 1152
    mov [rbp-8], rax
    mov [rbp-16], rsi
    cmp edx, 4
    jne .double
    mov eax, edi
    mov ecx, edi
    mov edx, edi
    shr edx, 31
    mov [rbp-24], rdx
    and eax, 7fffffh
    shr ecx, 23
    and ecx, 255
    mov edx, 800000h
    mov r8d, 150
    mov r9d, 255
    jmp .decoded
.double:
    mov rax, rdi
    mov rcx, rdi
    shr rdi, 63
    mov [rbp-24], rdi
    mov rdx, 0fffffffffffffh
    and rax, rdx
    inc rdx
    shr rcx, 52
    and ecx, 2047
    mov r8d, 1075
    mov r9d, 2047
.decoded:
    lea rdi, [rbp-192]
    cmp qword [rbp-24], 0
    je .prefix
    mov byte [rdi], '-'
    inc rdi
.prefix:
    mov [rbp-88], rdi
    cmp rcx, r9
    je .special
    test rcx, rcx
    jnz .normal
    test rax, rax
    jz .zero
    mov ecx, 1
    jmp .exponent
.normal:
    or rax, rdx
.exponent:
    sub rcx, r8
    mov qword [rbp-32], 0
    mov r11, rcx
    mov r8d, 2
    test rcx, rcx
    jns .initial_digits
    mov [rbp-32], rcx
    neg r11
    mov r8d, 5
.initial_digits:
    xor r10d, r10d
    mov ecx, 10
.initial_digit:
    xor edx, edx
    div rcx
    mov [rbp-1024+r10], dl
    inc r10
    test rax, rax
    jnz .initial_digit
.multiply:
    test r11, r11
    jz .round
    xor esi, esi
    xor r9d, r9d
.multiply_digit:
    movzx eax, byte [rbp-1024+rsi]
    imul eax, r8d
    add eax, r9d
    xor edx, edx
    div ecx
    mov r9d, eax
    mov [rbp-1024+rsi], dl
    inc rsi
    cmp rsi, r10
    jb .multiply_digit
    test r9d, r9d
    jz .multiplied
    mov [rbp-1024+r10], r9b
    inc r10
.multiplied:
    dec r11
    jmp .multiply
.round:
    mov r8, r10
    sub r8, [rbp-16]
    jle .rounded
    movzx eax, byte [rbp-1025+r8]
    cmp eax, 5
    jb .rounded
    ja .round_up
    xor esi, esi
.sticky:
    lea rdx, [r8-1]
    cmp rsi, rdx
    jae .tie
    cmp byte [rbp-1024+rsi], 0
    jne .round_up
    inc rsi
    jmp .sticky
.tie:
    test byte [rbp-1024+r8], 1
    jz .rounded
.round_up:
    mov rsi, r8
.carry:
    cmp byte [rbp-1024+rsi], 9
    jne .increment
    mov byte [rbp-1024+rsi], 0
    inc rsi
    cmp rsi, r10
    jb .carry
    mov byte [rbp-1024+r10], 0
    inc r10
.increment:
    inc byte [rbp-1024+rsi]
.rounded:
    mov rax, r10
    dec rax
    add rax, [rbp-32]
    mov [rbp-40], rax
    mov r8, r10
    sub r8, [rbp-16]
    jns .trim
    xor r8d, r8d
.trim:
    lea rsi, [r10-1]
    cmp r8, rsi
    jae .emit
    cmp byte [rbp-1024+r8], 0
    jne .emit
    inc r8
    jmp .trim
.emit:
    mov rdi, [rbp-88]
    cmp rax, -4
    jl .scientific
    cmp rax, [rbp-16]
    jge .scientific
    test rax, rax
    js .fraction
    lea r11, [rax+1]
    mov r9, r10
    dec r9
.integer:
    mov al, '0'
    cmp r9, r8
    jl .integer_digit
    mov al, [rbp-1024+r9]
    add al, '0'
.integer_digit:
