    jmp .sign
.infinity:
    mov rax, [rbp-72]
    shl rax, 1
    inc rax
    mov rcx, [rbp-40]
    shl rax, cl
    jmp .sign
.zero:
    xor eax, eax
.sign:
    mov ecx, 63
    cmp qword [rbp-32], 24
    jne .sign_bit
    mov ecx, 31
.sign_bit:
    mov rdx, [rbp-24]
    shl rdx, cl
    or rax, rdx
    leave
    ret
.invalid:
    xor eax, eax
    leave
    ret
.nan_token:
    add rsi, 3
    xor r8d, r8d
    cmp rsi, [rbp-16]
    jae .nan_pack
    cmp byte [rsi], '('
    jne .nan_pack
    inc rsi
    mov r10, rsi
.nan_scan:
    cmp rsi, [rbp-16]
    jae .nan_pack
    mov al, [rsi]
    cmp al, ')'
    je .nan_payload
    cmp al, '_'
    je .nan_next
    sub al, '0'
    cmp al, 9
    jbe .nan_next
    mov al, [rsi]
    or al, 20h
    sub al, 'a'
    cmp al, 25
    ja .nan_pack
.nan_next:
    inc rsi
    jmp .nan_scan
.nan_payload:
    mov r11, rsi
    mov rsi, r10
    mov r9d, 10
    cmp rsi, r11
    jae .nan_pack
    cmp byte [rsi], '0'
    jne .nan_integer
    mov r9d, 8
    lea rax, [rsi+1]
    cmp rax, r11
    jae .nan_integer
    mov al, [rsi+1]
    or al, 20h
    cmp al, 'x'
    jne .nan_integer
    mov r9d, 16
    add rsi, 2
    cmp rsi, r11
    jae .nan_pack
.nan_integer:
    xor r10d, r10d
.nan_digit:
    movzx ecx, byte [rsi]
    sub ecx, '0'
    cmp ecx, 9
    jbe .nan_digit_value
    movzx ecx, byte [rsi]
    or ecx, 20h
    sub ecx, 'a'
    cmp ecx, 5
    ja .nan_not_integer
    add ecx, 10
.nan_digit_value:
    cmp rcx, r9
    jae .nan_not_integer
    mov rax, r8
    mul r9
    add rax, rcx
    adc rdx, 0
    test rdx, rdx
    jz .nan_accumulated
    mov r10d, 1
.nan_accumulated:
    mov r8, rax
    inc rsi
    cmp rsi, r11
    jb .nan_digit
    test r10d, r10d
    jz .nan_pack
    mov r8, -1
    jmp .nan_pack
.nan_not_integer:
    xor r8d, r8d
.nan_pack:
    mov rcx, [rbp-40]
    mov rdx, 1
    shl rdx, cl
    dec rdx
    and r8, rdx
    mov rax, [rbp-72]
    shl rax, 1
    inc rax
    shl rax, cl
    or rax, r8
    dec ecx
    mov rdx, 1
    shl rdx, cl
    or rax, rdx
    jmp .sign

; Fixed 48-word unsigned integer operations for float parsing. Callers retain
; their pointers/counters in the parser frame; these helpers use volatile regs.
rt_float_big_multiply:
    mov r8, rdx
    xor r9d, r9d
    mov ecx, 48
.word:
    mov rax, [rdi+r9]
    mul rsi
    add rax, r8
    adc rdx, 0
    mov [rdi+r9], rax
    mov r8, rdx
    add r9, 8
    loop .word
    ret
rt_float_big_bits:
    mov r8d, 47
.word:
    mov rax, [rdi+r8*8]
    test rax, rax
    jnz .found
    dec r8
    jns .word
    xor eax, eax
    ret
.found:
    bsr rax, rax
    shl r8, 6
    lea rax, [rax+r8+1]
    ret
rt_float_big_compare:
    mov r8d, 47
.word:
    mov rax, [rdi+r8*8]
    cmp rax, [rsi+r8*8]
    ja .greater
    jb .less
    dec r8
    jns .word
    xor eax, eax
    ret
.greater:
    mov eax, 1
    ret
.less:
    mov rax, -1
    ret
rt_float_big_subtract:
    xor r8d, r8d
    mov ecx, 48
.word:
    mov rax, [rdi+r8]
    sbb rax, [rsi+r8]
    mov [rdi+r8], rax
    lea r8, [r8+8]
    loop .word
    ret
rt_float_big_shift_left:
    mov r8, rcx
    shr r8, 6
    mov r9, rcx
    and r9d, 63
    mov r10d, 47
.word:
    mov r11, r10
    sub r11, r8
    js .zero
    mov rax, [rdi+r11*8]
    xor edx, edx
    test r11, r11
    jz .bits
    mov rdx, [rdi+r11*8-8]
.bits:
    mov ecx, r9d
    shld rax, rdx, cl
    jmp .store
.zero:
    xor eax, eax
.store:
    mov [rdi+r10*8], rax
    dec r10
    jns .word
    ret
rt_float_big_shift_right:
    mov r8d, 47*8
    mov ecx, 48
    clc
.word:
    rcr qword [rdi+r8], 1
    lea r8, [r8-8]
    loop .word
    ret

; Paths are counted Strs: copy and terminate instead of assuming views end
; at a NUL. File handles encode fd+1, keeping zero as the closed sentinel.
rt_path:
    frame 16
    mov [rbp-8], rdi
    load_size rdi, [rdi+8]
    inc rdi
    call rt_malloc
    mov [rbp-16], rax
    mov rdi, rax
    mov rsi, [rbp-8]
    load_size rdx, [rsi+8]
    mov rsi, [rsi]
    mov byte [rdi+rdx], 0
    call rt_memcpy
    mov rax, [rbp-16]
    leave
    ret
rt_cfile_open:
    test rsi, rsi
    jz .read
    mov esi, 241h
    jmp rt_open
.read:
    xor esi, esi
    jmp rt_open
rt_cfile_open_update:
    mov esi, 2
    jmp rt_open
rt_cfile_open_append:
    mov esi, 441h
rt_open:
    frame 32
    mov [rbp-8], rsi
    call rt_path
    mov [rbp-16], rax
    mov rdi, rax
    mov rsi, [rbp-8]
    mov edx, 1b6h
    mov eax, 2
    syscall
    mov [rbp-24], rax
    mov rdi, [rbp-16]
    call rt_free
    mov rax, [rbp-24]
    test rax, rax
    js rt_file_fail
    inc rax
    leave
    ret
rt_cfile_close:
    test rdi, rdi
    jz rt_file_fail
    dec rdi
    mov eax, 3
    syscall
    test rax, rax
    js rt_file_fail
    ret
rt_cfile_write_str:
    test rdi, rdi
    jz rt_file_fail
    dec rdi
    load_size rdx, [rsi+8]
    mov rsi, [rsi]
    jmp rt_write_all
rt_cfile_tell:
    xor esi, esi
    mov edx, 1
    jmp rt_seek
rt_cfile_seek:
    xor edx, edx
    jmp rt_seek
rt_cfile_seek_cur:
    mov edx, 1
    jmp rt_seek
rt_cfile_seek_end:
    mov edx, 2
rt_seek:
    test rdi, rdi
    jz rt_file_fail
    dec rdi
    mov eax, 8
    syscall
    test rax, rax
    js rt_file_fail
    ret
rt_cfile_exists:
    frame 160
    call rt_path
    mov [rbp-8], rax
    mov rdi, rax
    lea rsi, [rbp-160]
    mov eax, 4
    syscall
    mov [rbp-16], rax
    mov rdi, [rbp-8]
    call rt_free
    cmp qword [rbp-16], 0
    sete al
    movzx eax, al
    leave
    ret
rt_cfile_remove:
    frame 16
    call rt_path
    mov [rbp-8], rax
    mov rdi, rax
    mov eax, 87
    syscall
    mov [rbp-16], rax
    mov rdi, [rbp-8]
    call rt_free
    ; Match ext.c's unlink contract: only ENOENT is an expected miss.
    mov rax, [rbp-16]
    cmp rax, -2
    je .done
    test rax, rax
    js rt_file_fail
.done:
    leave
    ret
rt_cfile_read_n:
    frame 48
    mov [rbp-40], rax
    test rdi, rdi
    jz rt_file_fail
    dec rdi
    mov [rbp-8], rdi
    xor eax, eax
    test rsi, rsi
    cmovs rsi, rax
    mov [rbp-16], rsi
    mov rdi, rsi
    mov rax, [rbp-40]
    call rt_str_allocate_owned
    mov [rbp-24], rax
    mov qword [rbp-32], 0
.next:
    mov rdx, [rbp-16]
    sub rdx, [rbp-32]
    jz .done
    mov rax, [rbp-24]
    mov rsi, [rax]
    add rsi, [rbp-32]
    mov rdi, [rbp-8]
    xor eax, eax
    syscall
    cmp rax, -4
    je .next
    test rax, rax
    js rt_file_fail
    jz .done
    add [rbp-32], rax
    jmp .next
.done:
    mov rdx, [rbp-24]
    mov rcx, [rbp-32]
    store_size [rdx+8], rcx
    mov rax, [rdx]
    mov byte [rax+rcx], 0
    mov rax, rdx
    leave
    ret
rt_cfile_read_all:
    frame 48
    mov [rbp-40], rax
    test rdi, rdi
    jz rt_file_fail
    dec rdi
    mov [rbp-8], rdi
    xor esi, esi
    xor edx, edx
    mov eax, 8
    syscall
    ; As ext.c: failed rewind on a non-seekable stream leaves it in place.
    mov edi, 65535
    mov rax, [rbp-40]
    call rt_str_capacity
    mov [rbp-16], rax
    mov qword [rbp-24], 0
    mov qword [rbp-32], 65535
.next:
    mov rdx, [rbp-32]
    sub rdx, [rbp-24]
    jnz .read
    shl qword [rbp-32], 1
    jc rt_file_fail
    mov rax, [rbp-16]
    mov rdi, [rax]
    mov rsi, [rbp-32]
    inc rsi
    call rt_realloc
    mov rdx, [rbp-16]
    mov [rdx], rax
    jmp .next
.read:
    mov rax, [rbp-16]
    mov rsi, [rax]
    add rsi, [rbp-24]
    mov rdi, [rbp-8]
    xor eax, eax
    syscall
    cmp rax, -4
    je .next
    test rax, rax
    js rt_file_fail
    jz .done
    add [rbp-24], rax
    jmp .next
.done:
    mov rax, [rbp-16]
    mov rdi, [rax]
    mov rsi, [rbp-24]
    inc rsi
    call rt_realloc
    mov rdx, [rbp-16]
    mov [rdx], rax
    mov rcx, [rbp-24]
    mov byte [rax+rcx], 0
    store_size [rdx+8], rcx
    store_size [rdx+STR_CAP], rcx
    mov rax, rdx
    leave
    ret
rt_file_fail:
    mov rdi, rt_file_error
    jmp rt_fail

segment readable
rt_newline db 10
rt_empty db 0
rt_panic_separator db ': panic: '
rt_native_panic db 'FASM runtime: panic: '
rt_native_panic_end:
rt_assert_message db ': panic: assert failed',10
rt_assert_message_end:
rt_expect_message db ': panic: assert failed: '
rt_expect_message_end:
rt_io_error db 'FASM runtime: write failed',10,0
rt_alloc_error db 'FASM runtime: allocation failure',10,0
rt_file_error db 'cfile: file operation failed',10,0
rt_view_error db 'Str.push_str: cannot mutate a string view or literal',10,0
rt_capacity_error db 'Str.push_str: capacity exceeded',10,0
rt_parts_error db 'FASM runtime: invalid variadic array index',10,0
