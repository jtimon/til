    jz .aligned
    mov r8, rdx
    shld r8, rax, cl
    shl rax, cl
    neg ecx
    add ecx, 64
    shr rdx, cl
    mov [rdi+16], rdx
    mov [rdi+8], r8
    mov [rdi], rax
    ret
.aligned:
    mov [rdi], rax
    mov [rdi+8], rdx
    ret

