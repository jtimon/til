    jz .done
    or rax, r10
    mov rdx, r8
    sub rdx, [rbp-32]
    sub rdx, [rbp-16]
.done:
    ret
.special:
    mov r9d, 1
    test rax, rax
    jz .done
    inc r9
    ret

; Store an at-most-128-bit integer into a zeroed magnitude at bit offset RCX.
; Even the largest F64 product occupies at most words 63, 64 and 65.
rt_float_fma_place:
    mov r8, rcx
    shr r8, 6
    and ecx, 63
    lea rdi, [rdi+r8*8]
