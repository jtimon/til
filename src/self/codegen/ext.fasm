    mov qword [rbp-80], 0
    mov qword [rbp-88], 0
    mov qword [rbp-96], 0
    mov qword [rbp-104], 0
    mov qword [rbp-112], 0
    mov qword [rbp-120], 0
    mov qword [rbp-128], 0
    mov qword [rbp-144], 0
