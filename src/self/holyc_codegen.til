mode lib
import("context")

import("loader")
import("../std/file")


// HolyC shares the typed/lowered AST with C, but owns its textual syntax,
// runtime requirements, and entrypoint policy.
priv HolyCEmitState := struct {
    user_functions := Set(Str).new()
    user_return_types := Map(Str, Str).new()
    ref_return_functions := Set(Str).new()
    user_ref_params := Map(Str, Set(USize)).new()
    str_return_functions := Set(Str).new()
    struct_names := Set(Str).new()
    enum_types := Map(Str, Str).new()
    payload_enum_names := Set(Str).new()
    niche_ref_types := Map(Str, Str).new()
    switch_id : USize = 0
    temp_id : USize = 0
    needs_i64_div := false
    needs_i64_mod := false
}

priv HolyCLocalState := struct {
    ref_return_type := ""
    param_pointer_names := Set(Str).new()
    payload_names := Map(Str, Str).new()
    pointer_types := Map(Str, Str).new()
    str_names := Set(Str).new()
    str_pointer_names := Set(Str).new()
    str_array_names := Set(Str).new()
    struct_types := Map(Str, Str).new()
    struct_pointer_types := Map(Str, Str).new()
}

priv holyc_direct_call_name := func(e: Expr, ctx: Context) returns Str {
    if e.node_type.is(NodeType.FCall).not() { return "" }
    if e.children.len() == 0 { return "" }
    switch e.children[0].node_type {
    case .Ident(id): return Str.clone(id.ident_name(ctx.symbols.names))
    case: return ""
    }
}

priv holyc_indent := func(depth: USize) returns Str {
    mut out := ""
    for _ in 0..depth { out = format(out, "    ") }
    return out
}

priv holyc_temp := func(prefix: Str, mut state: HolyCEmitState) returns Str {
    name := format(prefix, "_", state.temp_id.to_str())
    state.temp_id++
    return name
}

priv holyc_local_name := func(name: Str, locals: HolyCLocalState) returns Str {
    if locals.payload_names.has(name) { return locals.payload_names[name].clone() }
    return name
}

priv holyc_bind_name := func(name: Str, emitted_name: Str, mut locals: HolyCLocalState) {
    locals.param_pointer_names.remove(name)
    locals.payload_names.remove(name)
    locals.str_names.remove(name)
    locals.str_pointer_names.remove(name)
    locals.str_array_names.remove(name)
    locals.struct_types.remove(name)
    locals.struct_pointer_types.remove(name)
    locals.pointer_types.remove(name)
    if name != emitted_name { locals.payload_names.set(name, own emitted_name.clone()) }
}

priv holyc_field_call_name := func(e: Expr, ctx: Context) returns Str {
    if e.node_type.is(NodeType.FCall).not().or(e.children.len().eq(0)) { return "" }
    switch e.children[0].node_type {
    case .FieldAccess(fa): return Str.clone(fa.field_access_name(ctx.symbols.names))
    case: return ""
    }
}

priv holyc_scalar_type_name := func(name: Str) returns Bool {
    switch name {
    case "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "Bool":
        return true
    case:
        return false
    }
}

priv holyc_storage_type_name := func(name: Str) returns Str {
    if name == "USize" { return "U32" }
    if name == "UPtr" { return "U64" }
    return name
}

priv holyc_aggregate_type := func(name: Str, state: HolyCEmitState) returns Bool {
    return state.struct_names.has(name).or(state.payload_enum_names.has(name))
}

priv holyc_value_ctype := func(name: Str, state: HolyCEmitState) returns Str {
    if name == "Str" { return "TilStr" }
    if state.niche_ref_types.has(name) {
        return format(holyc_value_ctype(state.niche_ref_types[name], state), " *")
    }
    if state.enum_types.has(name).and(state.payload_enum_names.has(name).not()) {
        return state.enum_types[name].clone()
    }
    return holyc_storage_type_name(name)
}

priv holyc_param_is_pointer := func(param: Declaration, state: HolyCEmitState) returns Bool {
    if param.is_mut { return true }
    type_name := param.type_name()
    return param.own_type.is(OwnType.Ref)
        .and(state.enum_types.has(type_name).and(state.payload_enum_names.has(type_name).not())
            .or(state.niche_ref_types.has(type_name)).not())
}

priv holyc_payload_ref := func(e: Expr, ctx: Context, locals: HolyCLocalState,
    mut error: Str) returns Str {
    if e.children.len() != 2 { error = "invalid payload access"; return "" }
    enum_name := til_type_name(e.children[1].til_type())
    ref def : Expr = ctx.scope.get_struct(enum_name, ctx.symbols).unwrap()
    ref ed : EnumDef = enumdef_of(def)
    value := holyc_struct_ref(e.children[1], ctx, locals, error)
    for variant : VariantDef in ed.variants {
        // Every union member has the same address. The binding supplies the
        // selected payload type; no runtime tag-to-pointer lookup is needed.
        if variant.payload_type.len() > 0 {
            return format("(&(", value, ")->payload_", variant.name, ")")
        }
    }
    error = format("enum '", enum_name, "' has no payload")
    return ""
}

priv holyc_enum_tag_expr := func(e: Expr, ctx: Context, mut state: HolyCEmitState,
    locals: HolyCLocalState, mut error: Str) returns Str {
    switch e.node_type {
    case .FCall:
        // A binding pattern's callee is its variant; the remaining children
        // name bindings, not evaluated constructor arguments.
        return holyc_enum_tag_expr(e.children[0], ctx, state, locals, error)
    case .FieldAccess(fa):
        owner := holyc_field_owner_name(e, ctx.symbols)
        if state.enum_types.has(owner) {
            ref def : Expr = ctx.scope.get_struct(owner, ctx.symbols).unwrap()
            ref member : Str = fa.field_access_name(ctx.symbols.names)
            if enum_variant_index(def, member) >= 0 { return enum_variant_tag(def, member).to_str() }
        }
    case:
    }
    type_name := til_type_name(e.til_type())
    if state.payload_enum_names.has(type_name) {
        value := holyc_struct_ref(e, ctx, locals, error)
        return format("(", value, ")->tag")
    }
    return holyc_expr(e, ctx, state, locals, error)
}

priv holyc_clone_locals := func(locals: HolyCLocalState) returns HolyCLocalState {
    return HolyCLocalState(ref_return_type = locals.ref_return_type.clone(),
        param_pointer_names = locals.param_pointer_names.clone(),
        payload_names = locals.payload_names.clone(),
        pointer_types = locals.pointer_types.clone(),
        str_names = locals.str_names.clone(),
        str_pointer_names = locals.str_pointer_names.clone(),
        str_array_names = locals.str_array_names.clone(),
        struct_types = locals.struct_types.clone(),
        struct_pointer_types = locals.struct_pointer_types.clone())
}

// Post-escape byte count for source-form string literals. HolyC receives the
// same escaped spelling as C, but TilStr.count names the resulting bytes.
priv holyc_lit_byte_count := func(s: Str) returns USize {
    n := s.len()
    mut count : USize = 0
    mut i : USize = 0
    while i < n {
        ref b : I8 = s.unsafe_get(i)
        if b.eq('\\').and(i.add(1).lt(n)) {
            ref next : I8 = s.unsafe_get(i + 1)
            if next == 'x' {
                mut hex_i := i + 2
                while hex_i < n {
                    if digit_value(s.unsafe_get(hex_i)).lt(0) { break }
                    hex_i++
                }
                if hex_i > i + 2 {
                    i = hex_i
                    count++
                    continue
                }
            }
            i = i + 2
            count++
            continue
        }
        if b.eq('"').and(i.add(1).lt(n)).and(s.unsafe_get(i + 1).eq('"')) {
            i = i + 2
            continue
        }
        i++
        count++
    }
    return count
}

priv holyc_decl_pointer_type := func(decl: Declaration, rhs: Expr,
    symbols: SymbolPool) returns Str {
    type_name := holyc_storage_type_name(til_type_name_c(decl.til_type))
    if type_name == "Dynamic" { return "Dynamic" }
    if decl.own_type.is(OwnType.Ref) { return type_name }
    if rhs_is_allocator_call(rhs, symbols) { return type_name }
    return ""
}

priv holyc_expr_is_pointer := func(e: Expr, ctx: Context,
    locals: HolyCLocalState) returns Bool {
    switch e.node_type {
    case .Literal(Literal.Null): return true
    case .Ident(id): return locals.pointer_types.has(id.ident_name(ctx.symbols.names))
    case .FCall:
        name := holyc_direct_call_name(e, ctx)
        return name.eq("malloc").or(name.eq("calloc")).or(name.eq("realloc"))
            .or(name.eq("ptr_add")).or(name.eq("deref")).or(name.eq("to_ptr"))
    case: return false
    }
}

priv holyc_pointer_expr := func(e: Expr, ctx: Context, mut state: HolyCEmitState,
    locals: HolyCLocalState, mut error: Str) returns Str {
    switch e.node_type {
    case .Literal(Literal.Null): return "NULL"
    case .Ident(id):
        ref name : Str = id.ident_name(ctx.symbols.names)
        emitted_name := holyc_local_name(name, locals)
        if locals.pointer_types.has(name).or(locals.struct_pointer_types.has(name))
            .or(locals.str_pointer_names.has(name)) { return emitted_name }
        return format("&", emitted_name)
    case .FieldAccess(fa):
        switch e.children[0].node_type {
        case .FCall:
            base_call := holyc_direct_call_name(e.children[0], ctx)
            if state.ref_return_functions.has(base_call) {
                base := holyc_expr(e.children[0], ctx, state, locals, error)
                if error.len() > 0 { return "" }
                field := format("(", base, ")->", fa.field_access_name(ctx.symbols.names))
                if holyc_pointer_field(e, ctx) { return field }
                return format("&", field)
            }
            error = format("unsupported field base call '", base_call, "'")
            return ""
        case:
        }
        path := holyc_field_path(e, ctx, locals, error)
        if holyc_pointer_field(e, ctx) { return path }
        return format("&", path)
    case .FCall:
        if holyc_direct_call_name(e, ctx) == "get_payload" {
            return holyc_payload_ref(e, ctx, locals, error)
        }
        switch e.children[0].node_type {
        case .FieldAccess:
            owner := holyc_field_owner_name(e.children[0], ctx.symbols)
            if state.niche_ref_types.has(owner) { return holyc_expr(e, ctx, state, locals, error) }
        case:
        }
        if holyc_expr_is_pointer(e, ctx, locals) {
            return holyc_expr(e, ctx, state, locals, error)
        }
        if state.ref_return_functions.has(holyc_direct_call_name(e, ctx)) {
            return holyc_expr(e, ctx, state, locals, error)
        }
    case:
    }
    error = format("unsupported pointer expression '", node_name(e.node_type), "'")
    return ""
}

priv holyc_checked_load := func(name: Str, type_name: Str) returns Str {
    return format("(*((TilCheckPtr(", name, "))(", type_name, " *)))")
}

priv holyc_str_ref := func(e: Expr, ctx: Context, locals: HolyCLocalState,
    mut error: Str) returns Str {
    switch e.node_type {
    case .Ident(id):
        ref name : Str = id.ident_name(ctx.symbols.names)
        emitted_name := holyc_local_name(name, locals)
        if locals.str_pointer_names.has(name) { return emitted_name }
        if locals.str_names.has(name) { return format("&", emitted_name) }
    case .FieldAccess:
        path := holyc_field_path(e, ctx, locals, error)
        if holyc_pointer_field(e, ctx) { return path }
        return format("&", path)
    case:
    }
    error = format("unsupported Str value '", node_name(e.node_type), "'")
    return ""
}

priv holyc_struct_ref := func(e: Expr, ctx: Context, locals: HolyCLocalState,
    mut error: Str) returns Str {
    switch e.node_type {
    case .Ident(id):
        ref name : Str = id.ident_name(ctx.symbols.names)
        emitted_name := holyc_local_name(name, locals)
        if locals.struct_pointer_types.has(name) { return emitted_name }
        if locals.struct_types.has(name) { return format("&", emitted_name) }
    case .FieldAccess:
        owner := holyc_field_owner_name(e, ctx.symbols)
        def_o := ctx.scope.get_struct(owner, ctx.symbols)
        if def_o.is_some() {
            ref def : Expr = def_o.unwrap()
            switch def.node_type {
            case .EnumDef(ed):
                switch e.node_type {
                case .FieldAccess(fa):
                    ref member : Str = fa.field_access_name(ctx.symbols.names)
                    index := enum_variant_index(def, member)
                    if index >= 0 {
                        if ed.variants[index.to_usize()].payload_type.len() > 0 {
                            error = "payload variant requires a constructor value"
                            return ""
                        }
                        return format("&", owner, "_Literal_", member)
                    }
                case:
                }
            case:
            }
        }
        path := holyc_field_path(e, ctx, locals, error)
        if holyc_pointer_field(e, ctx) { return path }
        return format("&", path)
    case:
    }
    error = format("unsupported struct value '", node_name(e.node_type), "'")
    return ""
}

priv holyc_struct_method_is_generated := func(type_name: Str, method: Str,
    ctx: Context) returns Bool {
    def_o := ctx.scope.get_struct(type_name, ctx.symbols)
    if def_o.is_none() { return false }
    ref def : Expr = def_o.unwrap()
    switch def.node_type {
    case .StructDef(sdef):
        if sdef.ns_index.has(method).not() { return false }
        ref method_decl : Declaration = sdef.member_at(sdef.ns_index[method])
        if method_decl.default_value.is_none() { return false }
        switch method_decl.default_expr().node_type {
        case .FuncDef(fdef): return fdef.auto_generated
        case: return false
        }
    case .EnumDef(ed):
        if ed.ns_index.has(method).not() { return false }
        ref method_decl : Declaration = ed.member_at(ed.ns_index[method])
        if method_decl.default_value.is_none() { return false }
        switch method_decl.default_expr().node_type {
        case .FuncDef(fdef): return fdef.auto_generated
        case: return false
        }
    case:
        return false
    }
}

priv holyc_struct_eq_supported := func(type_name: Str, ctx: Context,
    state: HolyCEmitState) returns Bool {
    def_o := ctx.scope.get_struct(type_name, ctx.symbols)
    if def_o.is_none() { return false }
    ref def : Expr = def_o.unwrap()
    switch def.node_type {
    case .StructDef(sdef):
        mut has_generated_comparison := false
        if sdef.ns_index.has("eq") {
            if holyc_struct_method_is_generated(type_name, "eq", ctx).not() { return false }
            has_generated_comparison = true
        }
        if sdef.ns_index.has("cmp") {
            if holyc_struct_method_is_generated(type_name, "cmp", ctx).not() { return false }
            has_generated_comparison = true
        }
        if has_generated_comparison.not() { return false }
        for field : Declaration in sdef.fields {
            field_type := holyc_storage_type_name(field.type_name())
            if state.niche_ref_types.has(field_type) {
                ref target : Str = state.niche_ref_types[field_type]
                if target == type_name { continue }
                if holyc_scalar_type_name(target).or(target.eq("Str")) { continue }
                if holyc_aggregate_type(target, state).and(holyc_struct_eq_supported(target, ctx, state)) { continue }
                return false
            }
            if holyc_scalar_type_name(field_type).or(field_type.eq("Str")) { continue }
            if holyc_aggregate_type(field_type, state)
                .and(holyc_struct_eq_supported(field_type, ctx, state)) { continue }
            return false
        }
        return true
    case .EnumDef(ed):
        for method : Str in "eq cmp".split(" ") {
            if ed.ns_index.has(method) {
                ref member : Declaration = ed.member_at(ed.ns_index[method])
                switch member.default_expr().node_type {
                case .FuncDef(fd):
                    if fd.auto_generated.not() { return false }
                case: return false
                }
            }
        }
        for variant : VariantDef in ed.variants {
            type_name := holyc_storage_type_name(variant.payload_type)
            if type_name.len().eq(0).or(holyc_scalar_type_name(type_name)).or(type_name.eq("Str")) { continue }
            if holyc_aggregate_type(type_name, state).and(holyc_struct_eq_supported(type_name, ctx, state)) { continue }
            return false
        }
        return true
    case:
        return false
    }
}

priv holyc_field_eq_expr := func(type_name: Str, left: Str, right: Str,
    pointer: Bool, state: HolyCEmitState, mut error: Str) returns Str {
    if holyc_scalar_type_name(type_name) {
        if pointer {
            return format("(", holyc_checked_load(left, type_name), " == ",
                holyc_checked_load(right, type_name), ")")
        }
        return format("(", left, " == ", right, ")")
    }
    mut a := left
    mut b := right
    if pointer.not() { a = format("&", left); b = format("&", right) }
    if type_name == "Str" { return format("TilStrEq(", a, ", ", b, ")") }
    if holyc_aggregate_type(type_name, state) {
        return format(type_name, "_Eq(", a, ", ", b, ")")
    }
    error = format("unsupported equality field type '", type_name, "'")
    return ""
}

priv holyc_call_args := func(e: Expr, start: USize, ctx: Context,
    mut state: HolyCEmitState, locals: HolyCLocalState, mut error: Str) returns Str {
    mut args := ""
    direct_name := holyc_direct_call_name(e, ctx)
    for i in start..e.children.len() {
        if i > start { args = format(args, ", ") }
        ref arg : Expr = e.children[i]
        type_name_o := expr_type_name_ref(arg)
        mut value := ""
        mut is_str := false
        mut is_struct := false
        if type_name_o.is_some() {
            type_name := holyc_storage_type_name(type_name_o.unwrap())
            is_str = type_name == "Str"
            is_struct = holyc_aggregate_type(type_name, state)
        }
        if is_str {
            value = holyc_str_ref(arg, ctx, locals, error)
        } else if is_struct {
            value = holyc_struct_ref(arg, ctx, locals, error)
        } else if state.user_ref_params.has(direct_name)
            .and(state.user_ref_params[direct_name].has(i - start)) {
            value = holyc_pointer_expr(arg, ctx, state, locals, error)
        } else {
            value = holyc_expr(arg, ctx, state, locals, error)
        }
        if error.len() > 0 { return "" }
        args = format(args, value)
    }
    return args
}

priv holyc_str_init := func(dest: Str, e: Expr, ctx: Context,
    mut state: HolyCEmitState, locals: HolyCLocalState, mut error: Str) returns Str {
    switch e.node_type {
    case .Literal(Literal.Str(s)):
        return format("TilStrInitLit(&", dest, ", \"", s, "\", ",
            holyc_lit_byte_count(s).to_str(), ")")
    case .Ident:
        src := holyc_str_ref(e, ctx, locals, error)
        return format("TilStrCopyValue(&", dest, ", ", src, ")")
    case .FCall:
        if e.children.len() == 0 {
            error = "Str initializer call has no callee"
            return ""
        }
        direct_name := holyc_direct_call_name(e, ctx)
        if state.str_return_functions.has(direct_name) {
            mut args := holyc_call_args(e, 1, ctx, state, locals, error)
            if error.len() > 0 { return "" }
            if args.len() > 0 { args = format(", ", args) }
            return format(direct_name, "(&", dest, args, ")")
        }
        method := holyc_field_call_name(e, ctx)
        owner := holyc_storage_type_name(holyc_field_owner_name(e.children[0], ctx.symbols))
        if owner == "Str" {
            if method.eq("clone").or(method.eq("to_str")) {
                if e.children.len() != 2 { error = format("invalid Str.", method, " call"); return "" }
                src := holyc_str_ref(e.children[1], ctx, locals, error)
                return format("TilStrClone(&", dest, ", ", src, ")")
            }
            if method == "with_capacity" {
                if e.children.len() != 2 { error = "invalid Str.with_capacity call"; return "" }
                cap := holyc_expr(e.children[1], ctx, state, locals, error)
                return format("TilStrWithCapacity(&", dest, ", ", cap, ")")
            }
            if method == "substr" {
                if e.children.len() != 4 { error = "invalid Str.substr call"; return "" }
                src := holyc_str_ref(e.children[1], ctx, locals, error)
                start := holyc_expr(e.children[2], ctx, state, locals, error)
                count := holyc_expr(e.children[3], ctx, state, locals, error)
                return format("TilStrSubstr(&", dest, ", ", src, ", ", start, ", ", count, ")")
            }
            if method.eq("borrowed_view").or(method.eq("trim_start")).or(method.eq("trim")) {
                if e.children.len() != 2 { error = format("invalid Str.", method, " call"); return "" }
                src := holyc_str_ref(e.children[1], ctx, locals, error)
                mut runtime_name := "TilStrBorrowedView"
                if method == "trim_start" { runtime_name = "TilStrTrimStart" }
                if method == "trim" { runtime_name = "TilStrTrim" }
                return format(runtime_name, "(&", dest, ", ", src, ")")
            }
        }
        if owner.eq("I64").and(method.eq("to_str")) {
            if e.children.len() != 2 { error = "invalid I64.to_str call"; return "" }
            value := holyc_expr(e.children[1], ctx, state, locals, error)
            return format("TilStrFromI64(&", dest, ", ", value, ")")
        }
        error = format("unsupported Str initializer call '", owner, ".", method, "'")
        return ""
    case:
        error = format("unsupported Str initializer '", node_name(e.node_type), "'")
        return ""
    }
}

priv holyc_str_array_ref := func(e: Expr, ctx: Context, locals: HolyCLocalState,
    mut error: Str) returns Str {
    switch e.node_type {
    case .Ident(id):
        ref name : Str = id.ident_name(ctx.symbols.names)
        if locals.str_array_names.has(name) { return format("&", holyc_local_name(name, locals)) }
    case:
    }
    error = format("unsupported Array(Str) value '", node_name(e.node_type), "'")
    return ""
}

priv holyc_str_array_init := func(dest: Str, e: Expr, ctx: Context,
    mut state: HolyCEmitState, locals: HolyCLocalState, mut error: Str) returns Str {
    if e.node_type.is(NodeType.FCall).not().or(e.children.len().neq(2)) {
        error = "unsupported Array(Str) initializer"
        return ""
    }
    method := holyc_field_call_name(e, ctx)
    owner := holyc_storage_type_name(holyc_field_owner_name(e.children[0], ctx.symbols))
    if owner.neq("Array__Str").or(method.neq("new")) {
        error = format("unsupported Array(Str) initializer call '", owner, ".", method, "'")
        return ""
    }
    cap := holyc_expr(e.children[1], ctx, state, locals, error)
    return format("TilStrArrayNew(&", dest, ", ", cap, ")")
}

priv holyc_field_path := func(e: Expr, ctx: Context, locals: HolyCLocalState,
    mut error: Str) returns Str {
    switch e.node_type {
    case .Ident(id):
        ref name : Str = id.ident_name(ctx.symbols.names)
        emitted_name := holyc_local_name(name, locals)
        if locals.struct_pointer_types.has(name) { return format("(*", emitted_name, ")") }
        return emitted_name
    case .FieldAccess(fa):
        if e.children.len() != 1 {
            error = "invalid field access"
            return ""
        }
        switch e.children[0].node_type {
        case .Ident(id):
            ref name : Str = id.ident_name(ctx.symbols.names)
            if locals.struct_pointer_types.has(name) {
                return format(holyc_local_name(name, locals), "->", fa.field_access_name(ctx.symbols.names))
            }
        case:
        }
        base := holyc_field_path(e.children[0], ctx, locals, error)
        if holyc_pointer_field(e.children[0], ctx) {
            return format(base, "->", fa.field_access_name(ctx.symbols.names))
        }
        return format(base, ".", fa.field_access_name(ctx.symbols.names))
    case:
        error = format("unsupported field base '", node_name(e.node_type), "'")
        return ""
    }
}

priv holyc_pointer_field := func(e: Expr, ctx: Context) returns Bool {
    switch e.node_type {
    case .FieldAccess(fa):
        if e.children.len() != 1 { return false }
        owner_o := expr_type_name_ref(e.children[0])
        if owner_o.is_none() { return false }
        def_o := ctx.scope.get_struct(owner_o.unwrap(), ctx.symbols)
        if def_o.is_none() { return false }
        ref def : Expr = def_o.unwrap()
        switch def.node_type {
        case .StructDef(sd):
            ref name : Str = fa.field_access_name(ctx.symbols.names)
            if sd.fields_index.has(name) {
                ref field : Declaration = sd.field_at(sd.fields_index[name])
                return field.own_type.is(OwnType.Ref).or(field.own_type.is(OwnType.Own))
            }
        case:
        }
    case:
    }
    return false
}

priv holyc_delete_free_flag := func(receiver: Expr, flag: Expr, ctx: Context,
    mut state: HolyCEmitState, locals: HolyCLocalState, mut error: Str) returns Str {
    switch receiver.node_type {
    case .Ident(id):
        if locals.param_pointer_names.has(id.ident_name(ctx.symbols.names)) { return "FALSE" }
    case:
    }
    return holyc_expr(flag, ctx, state, locals, error)
}

priv holyc_struct_copy := func(type_name: Str, dest: Str, dest_sep: Str,
    src: Str, src_sep: Str, depth: USize, ctx: Context, state: HolyCEmitState,
    mut error: Str) returns Str {
    if state.payload_enum_names.has(type_name) {
        mut dest_ref := format("&", dest)
        mut src_ref := format("&", src)
        if dest_sep == "->" { dest_ref = dest }
        if src_sep == "->" { src_ref = src }
        return format(holyc_indent(depth), type_name, "_CopyValue(", dest_ref, ", ", src_ref, ");\n")
    }
    def_o := ctx.scope.get_struct(type_name, ctx.symbols)
    if def_o.is_none() {
        error = format("missing struct definition '", type_name, "'")
        return ""
    }
    ref def : Expr = def_o.unwrap()
    switch def.node_type {
    case .StructDef(sdef):
        mut out := ""
        prefix := holyc_indent(depth)
        for i in 0..sdef.fields.len() {
            ref field : Declaration = sdef.field_at(i)
            ref field_name : Str = sdef.field_name_at(i)
            field_type := holyc_storage_type_name(field.type_name())
            field_dest := format(dest, dest_sep, field_name)
            field_src := format(src, src_sep, field_name)
            if field.own_type.is(OwnType.Ref).or(field.own_type.is(OwnType.Own)) {
                out = format(out, prefix, field_dest, " = ", field_src, ";\n")
            } else if state.niche_ref_types.has(field_type).or(holyc_scalar_type_name(field_type)) {
                out = format(out, prefix, field_dest, " = ", field_src, ";\n")
            } else if field_type == "Str" {
                out = format(out, prefix, "TilStrCopyValue(&", field_dest,
                    ", &", field_src, ");\n")
            } else if holyc_aggregate_type(field_type, state) {
                out = format(out, holyc_struct_copy(field_type, field_dest, ".",
                    field_src, ".", depth, ctx, state, error))
            } else {
                error = format("unsupported field '", type_name, ".", field_name,
                    "' of type '", field.type_name(), "'")
                return ""
            }
        }
        return out
    case:
        error = format("'", type_name, "' is not a struct")
        return ""
    }
}

priv holyc_owned_field_init := func(field_type: Str, dest: Str, value: Expr,
    depth: USize, ctx: Context, mut state: HolyCEmitState, locals: HolyCLocalState,
    mut error: Str) returns Str {
    prefix := holyc_indent(depth)
    ctype := holyc_value_ctype(field_type, state)
    temp := holyc_temp("owned_value", state)
    mut init := ""
    if field_type == "Str" {
        init = format(prefix, holyc_str_init(temp, value, ctx, state, locals, error), ";\n")
    } else if holyc_aggregate_type(field_type, state) {
        init = holyc_struct_init(field_type, temp, value, depth, ctx, state, locals, error)
    } else {
        error = format("unsupported owned field of type '", field_type, "'")
        return ""
    }
    if error.len() > 0 { return "" }
    mut out := format(prefix, ctype, " ", temp, ";\n", init,
        prefix, dest, " = (TilMAlloc(sizeof(", ctype, ")))(", ctype, " *);\n")
    if field_type == "Str" {
        return format(out, prefix, "TilStrCopyValue(", dest, ", &", temp, ");\n",
            prefix, "TilStrPrepareReturn(", dest, ");\n")
    }
    out = format(out, holyc_struct_copy(field_type, dest, "->", temp, ".",
        depth, ctx, state, error))
    return out
}

priv holyc_struct_init := func(type_name: Str, dest: Str, e: Expr, depth: USize,
    ctx: Context, mut state: HolyCEmitState, locals: HolyCLocalState,
    mut error: Str) returns Str {
    if state.payload_enum_names.has(type_name) {
        return holyc_enum_init(type_name, dest, e, depth, ctx, state, locals, error)
    }
    if e.node_type.is(NodeType.Ident).or(e.node_type.is(NodeType.FieldAccess)) {
        src := holyc_field_path(e, ctx, locals, error)
        mut src_base := src
        mut src_sep := "."
        switch e.node_type {
        case .Ident(id):
            ref name : Str = id.ident_name(ctx.symbols.names)
            if locals.struct_pointer_types.has(name) {
                src_base = holyc_local_name(name, locals)
                src_sep = "->"
            }
        case:
        }
        return holyc_struct_copy(type_name, dest, ".", src_base, src_sep,
            depth, ctx, state, error)
    }
    if e.node_type.is(NodeType.FCall) {
        method := holyc_field_call_name(e, ctx)
        owner := holyc_storage_type_name(holyc_field_owner_name(e.children[0], ctx.symbols))
        if owner.eq(type_name).and(method.eq("clone")) {
            if e.children.len() != 2 { error = format("invalid ", type_name, ".clone call"); return "" }
            src := holyc_struct_ref(e.children[1], ctx, locals, error)
            return format(holyc_indent(depth), type_name, "_Clone(&", dest, ", ", src, ");\n")
        }
        direct_name := holyc_direct_call_name(e, ctx)
        if state.user_return_types.has(direct_name) {
            ref return_type : Str = state.user_return_types[direct_name]
            if holyc_storage_type_name(return_type) == type_name {
                args := holyc_call_args(e, 1, ctx, state, locals, error)
                mut suffix := ""
                if args.len() > 0 { suffix = format(", ", args) }
                return format(holyc_indent(depth), direct_name, "(&", dest, suffix, ");\n")
            }
        }
    }
    if e.node_type.is(NodeType.FCall).not().or(holyc_direct_call_name(e, ctx) != type_name) {
        error = format("unsupported initializer for struct '", type_name, "'")
        return ""
    }
    def_o := ctx.scope.get_struct(type_name, ctx.symbols)
    if def_o.is_none() {
        error = format("missing struct definition '", type_name, "'")
        return ""
    }
    ref def : Expr = def_o.unwrap()
    switch def.node_type {
    case .StructDef(sdef):
        if e.children.len() != sdef.fields.len() + 1 {
            error = format("invalid constructor call '", type_name, "'")
            return ""
        }
        mut out := ""
        prefix := holyc_indent(depth)
        for i in 0..sdef.fields.len() {
            ref field : Declaration = sdef.field_at(i)
            ref field_name : Str = sdef.field_name_at(i)
            field_type := holyc_storage_type_name(field.type_name())
            field_dest := format(dest, ".", field_name)
            ref value : Expr = e.children[i + 1]
            if field.own_type.is(OwnType.Ref) {
                value_code := holyc_pointer_expr(value, ctx, state, locals, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, field_dest, " = ", value_code, ";\n")
            } else if field.own_type.is(OwnType.Own) {
                out = format(out, holyc_owned_field_init(field_type, field_dest, value,
                    depth, ctx, state, locals, error))
                if error.len() > 0 { return "" }
            } else if state.niche_ref_types.has(field_type).or(holyc_scalar_type_name(field_type)) {
                value_code := holyc_expr(value, ctx, state, locals, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, field_dest, " = ", value_code, ";\n")
            } else if field_type == "Str" {
                value_code := holyc_str_init(field_dest, value, ctx, state, locals, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, value_code, ";\n")
            } else if holyc_aggregate_type(field_type, state) {
                out = format(out, holyc_struct_init(field_type, field_dest, value,
                    depth, ctx, state, locals, error))
                if error.len() > 0 { return "" }
            } else {
                error = format("unsupported field '", type_name, ".", field_name,
                    "' of type '", field.type_name(), "'")
                return ""
            }
        }
        return out
    case:
        error = format("'", type_name, "' is not a struct")
        return ""
    }
}

priv holyc_enum_init := func(type_name: Str, dest: Str, e: Expr, depth: USize,
    ctx: Context, mut state: HolyCEmitState, locals: HolyCLocalState,
    mut error: Str) returns Str {
    prefix := holyc_indent(depth)
    ref def : Expr = ctx.scope.get_struct(type_name, ctx.symbols).unwrap()
    ref ed : EnumDef = enumdef_of(def)
    mut variant_name := ""
    switch e.node_type {
    case .FieldAccess(fa):
        if holyc_field_owner_name(e, ctx.symbols) == type_name {
            variant_name = fa.field_access_name(ctx.symbols.names).clone()
        }
    case .FCall:
        if holyc_field_owner_name(e.children[0], ctx.symbols) == type_name {
            variant_name = holyc_field_call_name(e, ctx)
        }
    case:
    }
    index := enum_variant_index(def, variant_name)
    if index >= 0 {
        ref variant : VariantDef = ed.variants[index.to_usize()]
        out := format(prefix, dest, ".tag = ", variant.tag_value.to_str(), ";\n")
        if variant.payload_type.len() == 0 { return out }
        if e.children.len() != 2 { error = "invalid payload constructor"; return "" }
        payload_type := holyc_storage_type_name(variant.payload_type)
        field := format(dest, ".payload_", variant.name)
        ref value : Expr = e.children[1]
        if variant.payload_ref {
            src := holyc_pointer_expr(value, ctx, state, locals, error)
            if error.len() > 0 { return "" }
            return format(out, prefix, field, " = ", src, ";\n")
        }
        if payload_type == "Str" {
            init := holyc_str_init(field, value, ctx, state, locals, error)
            return format(out, prefix, init, ";\n")
        }
        if holyc_aggregate_type(payload_type, state) {
            return format(out, holyc_struct_init(payload_type, field, value, depth, ctx, state, locals, error))
        }
        init := holyc_expr(value, ctx, state, locals, error)
        return format(out, prefix, field, " = ", init, ";\n")
    }
    if e.node_type.is(NodeType.Ident).or(e.node_type.is(NodeType.FieldAccess)) {
        src := holyc_struct_ref(e, ctx, locals, error)
        return format(prefix, type_name, "_CopyValue(&", dest, ", ", src, ");\n")
    }
    if e.node_type.is(NodeType.FCall) {
        if variant_name == "clone" {
            if holyc_struct_method_is_generated(type_name, "clone", ctx).not() {
                error = format("custom enum clone for '", type_name, "' is not supported yet")
                return ""
            }
            switch e.children[1].node_type {
            case .FieldAccess(fa):
                variant_index := enum_variant_index(def, fa.field_access_name(ctx.symbols.names))
                if variant_index.gte(0).and(holyc_field_owner_name(e.children[1], ctx.symbols).eq(type_name)) {
                    return holyc_enum_init(type_name, dest, e.children[1], depth, ctx, state, locals, error)
                }
            case:
            }
            src := holyc_struct_ref(e.children[1], ctx, locals, error)
            return format(prefix, type_name, "_Clone(&", dest, ", ", src, ");\n")
        }
        name := holyc_direct_call_name(e, ctx)
        if state.user_return_types.has(name).and(state.user_return_types[name].eq(type_name)) {
            args := holyc_call_args(e, 1, ctx, state, locals, error)
            mut suffix := ""
            if args.len() > 0 { suffix = format(", ", args) }
            return format(prefix, name, "(&", dest, suffix, ");\n")
        }
    }
    error = format("unsupported initializer for enum '", type_name, "'")
    return ""
}

priv holyc_narrow_wrap := func(value: Str, owner: Str) returns Str {
    switch owner {
    case "U8":  return format("((", value, ") & 255)")
    case "U16": return format("((", value, ") & 65535)")
    case "U32": return format("((", value, ") & 4294967295)")
    case "I8":  return format("((((", value, ") & 255) ^ 128) - 128)")
    case "I16": return format("((((", value, ") & 65535) ^ 32768) - 32768)")
    case "I32": return format("((((", value, ") & 4294967295) ^ 2147483648) - 2147483648)")
    case: return value
    }
}

priv holyc_core_binop := func(op: Str) returns Str {
    switch op {
    case "add":  return "+"
    case "sub":  return "-"
    case "mul":  return "*"
    case "eq":   return "=="
    case "neq":  return "!="
    case "lt":   return "<"
    case "gt":   return ">"
    case "lte":  return "<="
    case "gte":  return ">="
    case "band": return "&"
    case "bor":  return "|"
    case "bxor": return "^"
    case "shl":  return "<<"
    case "shr":  return ">>"
    }
    return ""
}

priv holyc_field_owner_name := func(e: Expr, symbols: SymbolPool) returns Str {
    if e.children.len() == 0 {
        name_o := expr_type_name_ref(e)
        if name_o.is_some() { return name_o.unwrap().clone() }
        return ""
    }
    ref obj : Expr = e.children[0]
    name_o := expr_type_name_ref(obj)
    if name_o.is_some() { return name_o.unwrap().clone() }
    switch obj.node_type {
    case .Ident(ident): return Str.clone(ident.ident_name(symbols.names))
    case: return ""
    }
}

priv holyc_prepare_state := func(program: Expr, mut state: HolyCEmitState, mut error: Str) {
    for stmt : Expr in program.children {
        switch stmt.node_type {
        case .Decl(decl):
            if stmt.children.len() == 1 {
                switch stmt.children[0].node_type {
                case .FuncDef(fdef):
                    state.user_functions.add(own decl.name.clone())
                    state.user_return_types.set(decl.name, own fdef.sig.return_type.clone())
                    if fdef.sig.return_own_type.is(OwnType.Ref) {
                        state.ref_return_functions.add(own decl.name.clone())
                    } else if holyc_storage_type_name(fdef.sig.return_type) == "Str" {
                        state.str_return_functions.add(own decl.name.clone())
                    }
                    mut ref_params := Set(USize).new()
                    for i in 0..fdef.sig.params.len() {
                        ref param : Declaration = fdef.sig.params[i]
                        if holyc_param_is_pointer(param, state) {
                            ref_params.add(own i.clone())
                        }
                    }
                    state.user_ref_params.set(decl.name, own ref_params)
                case .StructDef:
                    state.struct_names.add(own decl.name.clone())
                case .EnumDef:
                    ref def : Expr = stmt.children[0]
                    if enum_has_payloads(def) {
                        ref ed : EnumDef = enumdef_of(def)
                        if enum_is_niche(def) {
                            ref payload : VariantDef = ed.variants[enum_niche_some_index(def).to_usize()]
                            if payload.payload_ref.and(payload.payload_funcsig.not()) {
                                state.niche_ref_types.set(decl.name, own payload.payload_type.clone())
                                continue
                            }
                        }
                        for variant : VariantDef in ed.variants {
                            if variant.payload_funcsig {
                                error = format("unsupported pointer payload '", decl.name, ".", variant.name, "'")
                                return
                            }
                        }
                        state.payload_enum_names.add(own decl.name.clone())
                    }
                    state.enum_types.set(decl.name, own enum_tag_type(def))
                case:
                }
            }
        case:
        }
    }
}

priv holyc_function_signature := func(name: Str, func_expr: Expr,
    state: HolyCEmitState, mut error: Str) returns Str {
    switch func_expr.node_type {
    case .FuncDef(fdef):
        if fdef.sig.func_type.is_plain().not() {
            error = format("unsupported function kind '", func_type_name(fdef.sig.func_type), "'")
            return ""
        }
        if fdef.sig.variadic_index.gte(0).or(fdef.sig.kwargs_index.gte(0)) {
            error = "variadic and keyword parameters are not supported yet"
            return ""
        }
        if fdef.captures.len().gt(0) {
            error = "capturing functions are not supported yet"
            return ""
        }
        if fdef.sig.throw_types.len().gt(0) {
            error = "throwing functions are not supported yet"
            return ""
        }
        mut return_type := "U0"
        mut aggregate_return_type := ""
        if fdef.sig.return_type.len() > 0 {
            mut return_type_name := holyc_storage_type_name(fdef.sig.return_type)
            if state.enum_types.has(return_type_name).and(state.payload_enum_names.has(return_type_name).not()) {
                return_type_name = state.enum_types[return_type_name].clone()
            }
            if state.niche_ref_types.has(return_type_name).and(fdef.sig.return_own_type.is(OwnType.Ref).not()) {
                return_type = holyc_value_ctype(return_type_name, state)
            } else if fdef.sig.return_own_type.is(OwnType.Ref) {
                if holyc_scalar_type_name(return_type_name).or(return_type_name.eq("Str"))
                    .or(holyc_aggregate_type(return_type_name, state)).not() {
                    error = format("unsupported ref function return type '", fdef.sig.return_type, "'")
                    return ""
                }
                return_type = format(holyc_value_ctype(return_type_name, state), " *")
            } else if return_type_name == "Str" {
                aggregate_return_type = "TilStr"
            } else if holyc_aggregate_type(return_type_name, state) {
                aggregate_return_type = return_type_name
            } else if holyc_scalar_type_name(return_type_name)
                .and(fdef.sig.return_own_type.is(OwnType.Shallow).or(state.enum_types.has(fdef.sig.return_type))).not() {
                error = format("unsupported function return type '", fdef.sig.return_type, "'")
                return ""
            } else {
                return_type = return_type_name
            }
        }
        mut params := ""
        if aggregate_return_type.len() > 0 {
            params = format(aggregate_return_type, " *return_out")
        }
        for i in 0..fdef.sig.params.len() {
            ref param : Declaration = fdef.sig.params[i]
            mut param_type := holyc_storage_type_name(param.type_name())
            if state.enum_types.has(param_type).and(state.payload_enum_names.has(param_type).not()) { param_type = state.enum_types[param_type].clone() }
            if state.niche_ref_types.has(param_type).and(param.is_mut.not()) {
                if params.len() > 0 { params = format(params, ", ") }
                params = format(params, holyc_value_ctype(param_type, state), " ", param.name)
                continue
            }
            if param_type == "Str" {
                if params.len() > 0 { params = format(params, ", ") }
                params = format(params, "TilStr *", param.name)
                continue
            }
            if holyc_aggregate_type(param_type, state) {
                if params.len() > 0 { params = format(params, ", ") }
                params = format(params, param_type, " *", param.name)
                continue
            }
            if holyc_scalar_type_name(param_type).not() {
                error = format("unsupported parameter '", param.name, "' of type '", param_type, "'")
                return ""
            }
            if params.len() > 0 { params = format(params, ", ") }
            if holyc_param_is_pointer(param, state) {
                params = format(params, param_type, " *", param.name)
            } else if param.own_type.is(OwnType.Shallow).or(state.enum_types.has(param.type_name())) {
                params = format(params, param_type, " ", param.name)
            } else {
                error = format("unsupported parameter '", param.name, "' of type '", param_type, "'")
                return ""
            }
        }
        return format(return_type, " ", name, "(", params, ")")
    case:
        error = "expected function definition"
        return ""
    }
}

priv holyc_expr := func(e: Expr, ctx: Context, mut state: HolyCEmitState,
    locals: HolyCLocalState, mut error: Str) returns Str {
    switch e.node_type {
    case .Literal(Literal.Num(num)):
        return Str.clone(num.literal_num_text())
    case .Literal(Literal.Bool(b)):
        if b { return "TRUE" }
        return "FALSE"
    case .Literal(Literal.Null): return "NULL"
    case .Ident(id):
        ref name : Str = id.ident_name(ctx.symbols.names)
        emitted_name := holyc_local_name(name, locals)
        if locals.pointer_types.has(name) {
            ref type_name : Str = locals.pointer_types[name]
            if type_name == "Dynamic" { return emitted_name }
            return holyc_checked_load(emitted_name, type_name)
        }
        return emitted_name
    case .FieldAccess(fa):
        owner := holyc_field_owner_name(e, ctx.symbols)
        if state.niche_ref_types.has(owner) {
            ref def : Expr = ctx.scope.get_struct(owner, ctx.symbols).unwrap()
            ref member : Str = fa.field_access_name(ctx.symbols.names)
            index := enum_variant_index(def, member)
            if index >= 0 {
                ref ed : EnumDef = enumdef_of(def)
                if ed.variants[index.to_usize()].payload_type.len() == 0 { return "NULL" }
                error = "borrowed niche payload requires a constructor"
                return ""
            }
        }
        if state.enum_types.has(owner) {
            ref def : Expr = ctx.scope.get_struct(owner, ctx.symbols).unwrap()
            ref member : Str = fa.field_access_name(ctx.symbols.names)
            index := enum_variant_index(def, member)
            if index >= 0 {
                return enum_variant_tag(def, member).to_str()
            }
            if member == "tag" { return holyc_enum_tag_expr(e.children[0], ctx, state, locals, error) }
            error = format("unsupported enum member '", owner, ".", member, "'")
            return ""
        }
        switch e.children[0].node_type {
        case .FCall:
            base_call := holyc_direct_call_name(e.children[0], ctx)
            if state.ref_return_functions.has(base_call) {
                base := holyc_expr(e.children[0], ctx, state, locals, error)
                if error.len() > 0 { return "" }
                return format("(", base, ")->", fa.field_access_name(ctx.symbols.names))
            }
            error = format("unsupported field base call '", base_call, "'")
            return ""
        case:
        }
        path := holyc_field_path(e, ctx, locals, error)
        if holyc_pointer_field(e, ctx) {
            type_name := holyc_storage_type_name(til_type_name_c(e.til_type()))
            if holyc_scalar_type_name(type_name) { return holyc_checked_load(path, type_name) }
        }
        return path
    case .FCall:
        if e.children.len() == 0 {
            error = "call has no callee"
            return ""
        }
        ref callee : Expr = e.children[0]
        switch callee.node_type {
        case .FieldAccess(fa):
            ref method : Str = fa.field_access_name(ctx.symbols.names)
            owner := holyc_storage_type_name(holyc_field_owner_name(callee, ctx.symbols))
            if state.niche_ref_types.has(owner) {
                if method == "Some" {
                    if e.children.len() != 2 { error = "invalid borrowed niche constructor"; return "" }
                    return holyc_pointer_expr(e.children[1], ctx, state, locals, error)
                }
                if e.children.len() != 2 { error = format("invalid borrowed niche call '", method, "'"); return "" }
                value := holyc_expr(e.children[1], ctx, state, locals, error)
                if method == "is_some" { return format("(", value, " != NULL)") }
                if method == "is_none" { return format("(", value, " == NULL)") }
                if method == "unwrap" {
                    return format("(TilCheckPtr(", value, "))(", holyc_value_ctype(owner, state), ")")
                }
                if method == "clone" { return value }
                error = format("unsupported borrowed niche call '", owner, ".", method, "'")
                return ""
            }
            if state.enum_types.has(owner) {
                if method == "size" {
                    if e.children.len() != 1 { error = "invalid enum size call"; return "" }
                    if holyc_struct_method_is_generated(owner, method, ctx).not() {
                        error = format("custom enum size for '", owner, "' is not supported yet")
                        return ""
                    }
                    return format("sizeof(", holyc_value_ctype(owner, state), ")")
                }
                if method.eq("is").or(method.eq("eq")).or(method.eq("neq"))
                    .or(method.eq("clone")).or(method.eq("delete")) {
                    ref def : Expr = ctx.scope.get_struct(owner, ctx.symbols).unwrap()
                    ref ed : EnumDef = enumdef_of(def)
                    ref method_decl : Declaration = ed.member_at(ed.ns_index[method])
                    switch method_decl.default_expr().node_type {
                    case .FuncDef(fd):
                        if fd.auto_generated.not() {
                            error = format("custom enum method '", owner, ".", method, "' is not supported yet")
                            return ""
                        }
                    case:
                        error = format("unsupported enum method '", owner, ".", method, "'")
                        return ""
                    }
                    if method == "neq" {
                        ref eq_decl : Declaration = ed.member_at(ed.ns_index["eq"])
                        switch eq_decl.default_expr().node_type {
                        case .FuncDef(fd):
                            if fd.auto_generated.not() {
                                error = format("custom enum method '", owner, ".eq' is not supported yet")
                                return ""
                            }
                        case:
                            error = format("unsupported enum equality for '", owner, "'")
                            return ""
                        }
                    }
                    if method == "clone" {
                        if e.children.len() != 2 { error = "invalid enum clone call"; return "" }
                        return holyc_expr(e.children[1], ctx, state, locals, error)
                    }
                    if method == "delete" {
                        if e.children.len() != 3 { error = "invalid enum delete call"; return "" }
                        if state.payload_enum_names.has(owner) {
                            value := holyc_struct_ref(e.children[1], ctx, locals, error)
                            call_free := holyc_delete_free_flag(e.children[1], e.children[2], ctx, state, locals, error)
                            return format(owner, "_Delete(", value, ", ", call_free, ")")
                        }
                        // REM: payload-free enums are unboxed tag values with
                        // nothing to free; still evaluate the consumed value.
                        return holyc_expr(e.children[1], ctx, state, locals, error)
                    }
                    if e.children.len() != 3 { error = format("invalid ", owner, ".", method, " call"); return "" }
                    if state.payload_enum_names.has(owner).and(method.neq("is")) {
                        if holyc_struct_eq_supported(owner, ctx, state).not() {
                            error = format("unsupported payload equality for '", owner, "'")
                            return ""
                        }
                        left := holyc_struct_ref(e.children[1], ctx, locals, error)
                        right := holyc_struct_ref(e.children[2], ctx, locals, error)
                        mut value := format(owner, "_Eq(", left, ", ", right, ")")
                        if method == "neq" { value = format("(!", value, ")") }
                        return value
                    }
                    left := holyc_enum_tag_expr(e.children[1], ctx, state, locals, error)
                    right := holyc_enum_tag_expr(e.children[2], ctx, state, locals, error)
                    mut op := " == "
                    if method == "neq" { op = " != " }
                    return format("(", left, op, right, ")")
                }
                error = format("unsupported enum call '", owner, ".", method, "'")
                return ""
            }
            if owner == "Array__Str" {
                if method == "len" {
                    if e.children.len() != 2 { error = "invalid Array(Str).len call"; return "" }
                    array := holyc_str_array_ref(e.children[1], ctx, locals, error)
                    return format("(", array, ")->cap")
                }
                if method.eq("set").or(method.eq("unsafe_set")) {
                    mut expected_len : USize = 4
                    if method == "set" { expected_len = 5 }
                    if e.children.len() != expected_len {
                        error = format("invalid Array(Str).", method, " call")
                        return ""
                    }
                    array := holyc_str_array_ref(e.children[1], ctx, locals, error)
                    index := holyc_expr(e.children[2], ctx, state, locals, error)
                    value := holyc_str_ref(e.children[3], ctx, locals, error)
                    return format("TilStrArraySet(", array, ", ", index, ", ", value, ")")
                }
                if method == "delete" {
                    if e.children.len() != 3 { error = "invalid Array(Str).delete call"; return "" }
                    array := holyc_str_array_ref(e.children[1], ctx, locals, error)
                    return format("TilStrArrayDelete(", array, ")")
                }
                error = format("unsupported call 'Array(Str).", method, "'")
                return ""
            }
            if owner == "Str" {
                if method == "len" {
                    if e.children.len() != 2 { error = "invalid Str.len call"; return "" }
                    src := holyc_str_ref(e.children[1], ctx, locals, error)
                    return format("(", src, ")->count")
                }
                if method == "to_i64" {
                    if e.children.len() != 2 { error = "invalid Str.to_i64 call"; return "" }
                    src := holyc_str_ref(e.children[1], ctx, locals, error)
                    return format("TilStrToI64(", src, ")")
                }
                if method == "is_empty" {
                    if e.children.len() != 2 { error = "invalid Str.is_empty call"; return "" }
                    src := holyc_str_ref(e.children[1], ctx, locals, error)
                    return format("((", src, ")->count == 0)")
                }
                if method.eq("eq").or(method.eq("neq")).or(method.eq("cmp")) {
                    if e.children.len() != 3 { error = format("invalid Str.", method, " call"); return "" }
                    left := holyc_str_ref(e.children[1], ctx, locals, error)
                    right := holyc_str_ref(e.children[2], ctx, locals, error)
                    mut value := format("TilStrEq(", left, ", ", right, ")")
                    if method == "neq" { value = format("(!", value, ")") }
                    if method == "cmp" { value = format("TilStrCmp(", left, ", ", right, ")") }
                    return value
                }
                if method == "push_str" {
                    if e.children.len() != 3 { error = "invalid Str.push_str call"; return "" }
                    dest := holyc_str_ref(e.children[1], ctx, locals, error)
                    src := holyc_str_ref(e.children[2], ctx, locals, error)
                    return format("TilStrPush(", dest, ", ", src, ")")
                }
                if method == "delete" {
                    if e.children.len() != 3 { error = "invalid Str.delete call"; return "" }
                    src := holyc_str_ref(e.children[1], ctx, locals, error)
                    call_free := holyc_delete_free_flag(e.children[1], e.children[2], ctx, state, locals, error)
                    return format("TilStrDelete(", src, ", ", call_free, ")")
                }
                error = format("unsupported call 'Str.", method, "'")
                return ""
            }
            if state.struct_names.has(owner) {
                if method == "size" {
                    if e.children.len() != 1 { error = format("invalid ", owner, ".size call"); return "" }
                    if holyc_struct_method_is_generated(owner, method, ctx).not() {
                        error = format("custom size for struct '", owner, "' is not supported yet")
                        return ""
                    }
                    return format("sizeof(", owner, ")")
                }
                if method.eq("eq").or(method.eq("neq")) {
                    if e.children.len() != 3 { error = format("invalid ", owner, ".", method, " call"); return "" }
                    if holyc_struct_eq_supported(owner, ctx, state).not() {
                        error = format("custom or unsupported equality for struct '", owner, "'")
                        return ""
                    }
                    if method.eq("neq")
                        .and(holyc_struct_method_is_generated(owner, method, ctx).not()) {
                        error = format("custom or unsupported equality for struct '", owner, "'")
                        return ""
                    }
                    left := holyc_struct_ref(e.children[1], ctx, locals, error)
                    right := holyc_struct_ref(e.children[2], ctx, locals, error)
                    mut value := format(owner, "_Eq(", left, ", ", right, ")")
                    if method == "neq" { value = format("(!", value, ")") }
                    return value
                }
                if method == "delete" {
                    if e.children.len() != 3 { error = format("invalid ", owner, ".delete call"); return "" }
                    value := holyc_struct_ref(e.children[1], ctx, locals, error)
                    call_free := holyc_delete_free_flag(e.children[1], e.children[2], ctx, state, locals, error)
                    return format(owner, "_Delete(", value, ", ", call_free, ")")
                }
                error = format("unsupported call '", owner, ".", method, "'")
                return ""
            }
            if method == "size" {
                if e.children.len() != 1 {
                    error = "invalid core call 'size'"
                    return ""
                }
                switch owner {
                case "I8", "U8", "Bool": return "1"
                case "I16", "U16": return "2"
                case "I32", "U32": return "4"
                case "I64", "U64": return "8"
                case:
                    error = format("unsupported size call for '", owner, "'")
                    return ""
                }
            }
            if method == "is_null" {
                if e.children.len() != 2 {
                    error = "invalid core call 'is_null'"
                    return ""
                }
                ptr := holyc_pointer_expr(e.children[1], ctx, state, locals, error)
                return format("(", ptr, " == NULL)")
            }
            if method == "ptr_eq" {
                if e.children.len() != 3 {
                    error = "invalid core call 'ptr_eq'"
                    return ""
                }
                left := holyc_pointer_expr(e.children[1], ctx, state, locals, error)
                right := holyc_pointer_expr(e.children[2], ctx, state, locals, error)
                return format("(", left, " == ", right, ")")
            }
            if method.eq("to_i64").and(holyc_scalar_type_name(owner)) {
                if e.children.len() != 2 {
                    error = "invalid core call 'to_i64'"
                    return ""
                }
                value := holyc_expr(e.children[1], ctx, state, locals, error)
                // HolyC casts an lvalue's storage type. Force a numeric value
                // before widening so a narrow payload is not read as I64.
                return format("((", value, ") + 0)(I64)")
            }
            if holyc_scalar_type_name(owner).not() {
                error = format("unsupported call '", owner, ".", method, "'")
                return ""
            }
            if method == "clone" {
                if e.children.len() != 2 { error = "invalid scalar clone call"; return "" }
                return holyc_expr(e.children[1], ctx, state, locals, error)
            }
            if method.eq("inc").or(method.eq("dec")) {
                if e.children.len() != 2 {
                    error = format("invalid core call '", method, "'")
                    return ""
                }
                value := holyc_expr(e.children[1], ctx, state, locals, error)
                if owner.eq("I64").or(owner.eq("U64")) {
                    mut op := "++"
                    if method == "dec" { op = "--" }
                    return format("(", op, value, ")")
                }
                mut op := " + 1"
                if method == "dec" { op = " - 1" }
                wrapped := holyc_narrow_wrap(format(value, op), owner)
                return format("(", value, " = ", wrapped, ")")
            }
            if method == "bnot" {
                if e.children.len() != 2 {
                    error = "invalid core call 'bnot'"
                    return ""
                }
                value := holyc_expr(e.children[1], ctx, state, locals, error)
                return holyc_narrow_wrap(format("~", value), owner)
            }
            if e.children.len() != 3 {
                error = format("invalid binary core call '", method, "'")
                return ""
            }
            left := holyc_expr(e.children[1], ctx, state, locals, error)
            right := holyc_expr(e.children[2], ctx, state, locals, error)
            if method.eq("div").or(method.eq("mod")) {
                if owner != "I64" {
                    error = format("unsupported core call '", owner, ".", method, "'")
                    return ""
                }
                if method == "div" {
                    state.needs_i64_div = true
                    return format("TilI64Div(", left, ", ", right, ")")
                }
                state.needs_i64_mod = true
                return format("TilI64Mod(", left, ", ", right, ")")
            }
            op := holyc_core_binop(method)
            if op.len() == 0 {
                error = format("unsupported core call '", owner, ".", method, "'")
                return ""
            }
            value := format("(", left, " ", op, " ", right, ")")
            if method.eq("add").or(method.eq("sub")).or(method.eq("mul")).or(method.eq("shl")) {
                return holyc_narrow_wrap(value, owner)
            }
            return value
        case .Ident(id):
            ref name : Str = id.ident_name(ctx.symbols.names)
            if name == "not" {
                if e.children.len() != 2 { error = "invalid Bool.not call"; return "" }
                value := holyc_expr(e.children[1], ctx, state, locals, error)
                return format("(!", value, ")")
            }
            if name == "is_n" {
                if e.children.len() != 4 { error = "invalid enum tag comparison"; return "" }
                enum_name := til_type_name(e.children[1].til_type())
                if state.enum_types.has(enum_name).not() {
                    error = "tag comparison requires a payload-free enum"
                    return ""
                }
                left := holyc_enum_tag_expr(e.children[1], ctx, state, locals, error)
                right := holyc_enum_tag_expr(e.children[2], ctx, state, locals, error)
                return format("(", left, " == ", right, ")")
            }
            if name.eq("print").or(name.eq("println")) {
                if e.children.len() != 2 { error = format("invalid call '", name, "'"); return "" }
                parts := holyc_str_array_ref(e.children[1], ctx, locals, error)
                mut runtime_name := "TilPrint"
                if name == "println" { runtime_name = "TilPrintln" }
                return format(runtime_name, "(", parts, ")")
            }
            if name == "print_single" {
                if e.children.len() != 2 { error = "invalid call 'print_single'"; return "" }
                value := holyc_str_ref(e.children[1], ctx, locals, error)
                return format("TilStrWrite(", value, ")")
            }
            if name == "malloc" {
                if e.children.len() != 2 { error = "invalid call 'malloc'"; return "" }
                count := holyc_expr(e.children[1], ctx, state, locals, error)
                return format("TilMAlloc(", count, ")")
            }
            if name == "calloc" {
                if e.children.len() != 3 { error = "invalid call 'calloc'"; return "" }
                nmemb := holyc_expr(e.children[1], ctx, state, locals, error)
                size := holyc_expr(e.children[2], ctx, state, locals, error)
                return format("TilCAlloc(", nmemb, ", ", size, ")")
            }
            if name == "realloc" {
                if e.children.len() != 3 { error = "invalid call 'realloc'"; return "" }
                ptr := holyc_pointer_expr(e.children[1], ctx, state, locals, error)
                count := holyc_expr(e.children[2], ctx, state, locals, error)
                return format("TilReAlloc(", ptr, ", ", count, ")")
            }
            if name == "free" {
                if e.children.len() != 2 { error = "invalid call 'free'"; return "" }
                ptr := holyc_pointer_expr(e.children[1], ctx, state, locals, error)
                return format("TilFree(", ptr, ")")
            }
            if name.eq("memcpy").or(name.eq("memmove")) {
                if e.children.len() != 4 { error = format("invalid call '", name, "'"); return "" }
                dest := holyc_pointer_expr(e.children[1], ctx, state, locals, error)
                src := holyc_pointer_expr(e.children[2], ctx, state, locals, error)
                count := holyc_expr(e.children[3], ctx, state, locals, error)
                mut runtime_name := "TilMemCpy"
                if name == "memmove" { runtime_name = "TilMemMove" }
                return format(runtime_name, "(", dest, ", ", src, ", ", count, ")")
            }
            if name == "memset" {
                if e.children.len() != 4 { error = "invalid call 'memset'"; return "" }
                dest := holyc_pointer_expr(e.children[1], ctx, state, locals, error)
                value := holyc_expr(e.children[2], ctx, state, locals, error)
                count := holyc_expr(e.children[3], ctx, state, locals, error)
                return format("TilMemSet(", dest, ", ", value, ", ", count, ")")
            }
            if name == "memcmp" {
                if e.children.len() != 4 { error = "invalid call 'memcmp'"; return "" }
                left := holyc_pointer_expr(e.children[1], ctx, state, locals, error)
                right := holyc_pointer_expr(e.children[2], ctx, state, locals, error)
                count := holyc_expr(e.children[3], ctx, state, locals, error)
                return format("TilMemCmp(", left, ", ", right, ", ", count, ")")
            }
            if name == "ptr_eq" {
                if e.children.len() != 3 { error = "invalid call 'ptr_eq'"; return "" }
                left := holyc_pointer_expr(e.children[1], ctx, state, locals, error)
                right := holyc_pointer_expr(e.children[2], ctx, state, locals, error)
                return format("(", left, " == ", right, ")")
            }
            if name == "is_null" {
                if e.children.len() != 2 { error = "invalid call 'is_null'"; return "" }
                ptr := holyc_pointer_expr(e.children[1], ctx, state, locals, error)
                return format("(", ptr, " == NULL)")
            }
            if name == "ptr_add" {
                if e.children.len() != 3 { error = "invalid call 'ptr_add'"; return "" }
                offset := holyc_expr(e.children[2], ctx, state, locals, error)
                mut base_is_null := false
                switch e.children[1].node_type {
                case .Literal(Literal.Null): base_is_null = true
                case:
                }
                if base_is_null {
                    return format("(", offset, ")(U8 *)")
                }
                ptr := holyc_pointer_expr(e.children[1], ctx, state, locals, error)
                return format("(", ptr, " + ", offset, ")")
            }
            if name == "deref" {
                if e.children.len() != 2 { error = "invalid call 'deref'"; return "" }
                slot := holyc_pointer_expr(e.children[1], ctx, state, locals, error)
                return format("TilDeref((", slot, ")(U8 **))")
            }
            if name == "write_ptr" {
                if e.children.len() != 3 { error = "invalid call 'write_ptr'"; return "" }
                slot := holyc_pointer_expr(e.children[1], ctx, state, locals, error)
                value := holyc_pointer_expr(e.children[2], ctx, state, locals, error)
                return format("TilWritePtr(", slot, ", ", value, ")")
            }
            if name == "to_ptr" {
                if e.children.len() != 2 { error = "invalid call 'to_ptr'"; return "" }
                return holyc_pointer_expr(e.children[1], ctx, state, locals, error)
            }
            if state.user_functions.has(name).not() {
                error = format("unsupported direct call '", name, "'")
                return ""
            }
            if state.str_return_functions.has(name) {
                error = format("Str-returning call '", name, "' requires a Str destination")
                return ""
            }
            args := holyc_call_args(e, 1, ctx, state, locals, error)
            return format(name, "(", args, ")")
        case:
            error = "unsupported indirect call"
            return ""
        }
    case:
        error = format("unsupported expression '", node_name(e.node_type), "'")
        return ""
    }
}

priv holyc_body := func(body: Expr, depth: USize, top_level: Bool,
    aggregate_return_type: Str, ctx: Context,
    mut state: HolyCEmitState, mut locals: HolyCLocalState, mut error: Str) returns Str {
    mut out := ""
    mut i : USize = 0
    while i < body.children.len() {
        ref stmt : Expr = body.children[i]
        if is_compile_directive(stmt, ctx.symbols) {
            i++
            continue
        }
        prefix := holyc_indent(depth)
        switch stmt.node_type {
        case .Body:
            mut nested_locals := holyc_clone_locals(locals)
            nested := holyc_body(stmt, depth + 1, false, aggregate_return_type,
                ctx, state, nested_locals, error)
            if error.len() > 0 { return "" }
            out = format(out, prefix, "{\n", nested, prefix, "}\n")
        case .Decl(decl):
            if stmt.children.len() != 1 {
                error = "HolyC scalar declaration requires an initializer"
                return ""
            }
            if stmt.children[0].node_type.is(NodeType.FuncDef) {
                if top_level {
                    i++
                    continue
                }
                error = "nested functions are not supported yet"
                return ""
            }
            if stmt.children[0].node_type.is(NodeType.StructDef).or(stmt.children[0].node_type.is(NodeType.EnumDef)) {
                if top_level {
                    i++
                    continue
                }
                error = "nested aggregate definitions are not supported yet"
                return ""
            }
            mut decl_type := holyc_storage_type_name(decl.type_name())
            mut decl_name := decl.name.clone()
            if locals.payload_names.has(decl.name).or(decl.own_type.is(OwnType.Ref)) {
                decl_name = holyc_temp("ref_value", state)
            }
            if holyc_direct_call_name(stmt.children[0], ctx) == "get_payload" {
                value := holyc_payload_ref(stmt.children[0], ctx, locals, error)
                if error.len() > 0 { return "" }
                ctype := holyc_value_ctype(decl_type, state)
                emitted_name := holyc_temp("payload", state)
                out = format(out, prefix, ctype, " *", emitted_name, " = (", value, ")(", ctype, " *);\n")
                // A pattern binding can shadow a differently typed outer local.
                holyc_bind_name(decl.name, emitted_name, locals)
                if decl_type == "Str" {
                    locals.str_pointer_names.add(own decl.name.clone())
                } else if holyc_aggregate_type(decl_type, state) {
                    locals.struct_pointer_types.set(decl.name, own decl_type.clone())
                } else {
                    locals.pointer_types.set(decl.name, own ctype.clone())
                }
                i++
                continue
            }
            if state.enum_types.has(decl_type).and(state.payload_enum_names.has(decl_type).not()) { decl_type = state.enum_types[decl_type].clone() }
            if holyc_aggregate_type(decl_type, state).and(rhs_is_allocator_call(stmt.children[0], ctx.symbols)) {
                value := holyc_pointer_expr(stmt.children[0], ctx, state, locals, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, decl_type, " *", decl_name, " = (", value, ")(", decl_type, " *);\n")
                holyc_bind_name(decl.name, decl_name, locals)
                locals.struct_pointer_types.set(decl.name, own decl_type)
            } else if decl.own_type.is(OwnType.Ref).and(decl_type.eq("Str").or(holyc_aggregate_type(decl_type, state))) {
                value := holyc_pointer_expr(stmt.children[0], ctx, state, locals, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, holyc_value_ctype(decl_type, state), " *", decl_name, " = ", value, ";\n")
                holyc_bind_name(decl.name, decl_name, locals)
                if decl_type == "Str" {
                    locals.str_pointer_names.add(own decl.name.clone())
                } else {
                    locals.struct_pointer_types.set(decl.name, own decl_type)
                }
            } else if state.niche_ref_types.has(decl_type) {
                value := holyc_expr(stmt.children[0], ctx, state, locals, error)
                if error.len() > 0 { return "" }
                ctype := holyc_value_ctype(decl_type, state)
                out = format(out, prefix, ctype, " ", decl_name, " = ", value, ";\n")
                holyc_bind_name(decl.name, decl_name, locals)
            } else if decl_type == "Str" {
                value := holyc_str_init(decl_name, stmt.children[0], ctx, state, locals, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, "TilStr ", decl_name, ";\n",
                    prefix, value, ";\n")
                holyc_bind_name(decl.name, decl_name, locals)
                locals.str_names.add(own decl.name.clone())
            } else if decl_type == "Array__Str" {
                value := holyc_str_array_init(decl_name, stmt.children[0], ctx, state, locals, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, "TilStrArray ", decl_name, ";\n",
                    prefix, value, ";\n")
                holyc_bind_name(decl.name, decl_name, locals)
                locals.str_array_names.add(own decl.name.clone())
            } else if holyc_aggregate_type(decl_type, state) {
                value := holyc_struct_init(decl_type, decl_name, stmt.children[0],
                    depth, ctx, state, locals, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, decl_type, " ", decl_name, ";\n", value)
                holyc_bind_name(decl.name, decl_name, locals)
                locals.struct_types.set(decl.name, own decl_type)
            } else {
                pointer_type := holyc_decl_pointer_type(decl, stmt.children[0], ctx.symbols)
                if pointer_type.len() > 0 {
                    if pointer_type.neq("Dynamic").and(holyc_scalar_type_name(pointer_type).not()) {
                        error = format("unsupported pointer declaration type '", pointer_type, "'")
                        return ""
                    }
                    value := holyc_pointer_expr(stmt.children[0], ctx, state, locals, error)
                    if error.len() > 0 { return "" }
                    mut storage_type := pointer_type
                    if storage_type == "Dynamic" { storage_type = "U8" }
                    out = format(out, prefix, storage_type, " *", decl_name, " = ", value, ";\n")
                    holyc_bind_name(decl.name, decl_name, locals)
                    locals.pointer_types.set(decl.name, own pointer_type)
                } else {
                    scalar_type := decl_type
                    if holyc_scalar_type_name(scalar_type).not() {
                        error = format("unsupported declaration type '", decl.type_name(), "'")
                        return ""
                    }
                    value := holyc_expr(stmt.children[0], ctx, state, locals, error)
                    if error.len() > 0 { return "" }
                    out = format(out, prefix, scalar_type, " ", decl_name, " = ", value, ";\n")
                    holyc_bind_name(decl.name, decl_name, locals)
                }
            }
        case .Assign(assign):
            if stmt.children.len() != 1 {
                error = "invalid scalar assignment"
                return ""
            }
            assign_name := holyc_local_name(assign.name, locals)
            if locals.str_names.has(assign.name).and(locals.str_pointer_names.has(assign.name).not()) {
                replacement := holyc_temp("replacement", state)
                value := holyc_str_init(replacement, stmt.children[0], ctx, state, locals, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, "{\n",
                    prefix, "    TilStr ", replacement, ";\n",
                    prefix, "    ", value, ";\n",
                    prefix, "    TilStrDelete(&", assign_name, ", FALSE);\n",
                    prefix, "    TilStrCopyValue(&", assign_name, ", &", replacement, ");\n",
                    prefix, "}\n")
            } else if locals.str_pointer_names.has(assign.name) {
                replacement := holyc_temp("replacement", state)
                value := holyc_str_init(replacement, stmt.children[0], ctx, state, locals, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, "{\n", prefix, "    TilStr ", replacement, ";\n",
                    prefix, "    ", value, ";\n")
                if assign.save_old_delete {
                    out = format(out, prefix, "    TilStrDelete(", assign_name, ", FALSE);\n")
                }
                out = format(out, prefix, "    TilStrCopyValue(", assign_name, ", &", replacement, ");\n", prefix, "}\n")
            } else if locals.struct_types.has(assign.name).or(locals.struct_pointer_types.has(assign.name)) {
                mut type_name := ""
                mut dest_ref := format("&", assign_name)
                mut dest_sep := "."
                if locals.struct_pointer_types.has(assign.name) {
                    type_name = locals.struct_pointer_types[assign.name].clone()
                    dest_ref = assign_name
                    dest_sep = "->"
                } else {
                    type_name = locals.struct_types[assign.name].clone()
                }
                replacement := holyc_temp("replacement", state)
                value := holyc_struct_init(type_name, replacement, stmt.children[0], depth + 1, ctx, state, locals, error)
                if error.len() > 0 { return "" }
                install := holyc_struct_copy(type_name, assign_name, dest_sep, replacement, ".", depth + 1, ctx, state, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, "{\n", prefix, "    ", type_name, " ", replacement, ";\n", value)
                // REM: the shared garbager may already have emitted a delete.
                // Only save_old_delete requests teardown after evaluating RHS.
                if assign.save_old_delete {
                    out = format(out, prefix, "    ", type_name, "_Delete(", dest_ref, ", FALSE);\n")
                }
                out = format(out, install, prefix, "}\n")
            } else if locals.str_array_names.has(assign.name) {
                error = "Array(Str) assignment is not supported yet"
                return ""
            } else if locals.pointer_types.has(assign.name) {
                ref pointer_type : Str = locals.pointer_types[assign.name]
                if pointer_type.eq("Dynamic").or(holyc_expr_is_pointer(stmt.children[0], ctx, locals)) {
                    value := holyc_pointer_expr(stmt.children[0], ctx, state, locals, error)
                    if error.len() > 0 { return "" }
                    out = format(out, prefix, assign_name, " = ", value, ";\n")
                } else {
                    value := holyc_expr(stmt.children[0], ctx, state, locals, error)
                    if error.len() > 0 { return "" }
                    out = format(out, prefix, holyc_checked_load(assign_name, pointer_type), " = ", value, ";\n")
                }
            } else {
                value := holyc_expr(stmt.children[0], ctx, state, locals, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, assign_name, " = ", value, ";\n")
            }
        case .FieldAssign(field_assign):
            if stmt.children.len() != 2 {
                error = "invalid field assignment"
                return ""
            }
            mut field_type := holyc_storage_type_name(til_type_name_c(stmt.children[1].til_type()))
            mut owner_type := ""
            mut field_own_type := OwnType.Shallow
            switch stmt.children[0].node_type {
            case .Ident(id):
                ref owner_name : Str = id.ident_name(ctx.symbols.names)
                if locals.struct_types.has(owner_name) { owner_type = locals.struct_types[owner_name].clone() }
                if locals.struct_pointer_types.has(owner_name) { owner_type = locals.struct_pointer_types[owner_name].clone() }
            case:
                owner_type_o := expr_type_name_ref(stmt.children[0])
                if owner_type_o.is_some() { owner_type = owner_type_o.unwrap().clone() }
            }
            if owner_type.len() > 0 {
                owner_def_o := ctx.scope.get_struct(owner_type, ctx.symbols)
                if owner_def_o.is_some() {
                    ref owner_def : Expr = owner_def_o.unwrap()
                    switch owner_def.node_type {
                    case .StructDef(sdef):
                        if sdef.fields_index.has(field_assign.name) {
                            ref field : Declaration = sdef.field_at(sdef.fields_index[field_assign.name])
                            field_type = holyc_storage_type_name(field.type_name())
                            field_own_type = field.own_type.clone()
                        }
                    case:
                    }
                }
            }
            mut field_path := ""
            switch stmt.children[0].node_type {
            case .Ident(id):
                ref name : Str = id.ident_name(ctx.symbols.names)
                if locals.struct_pointer_types.has(name) {
                    field_path = format(holyc_local_name(name, locals), "->", field_assign.name)
                }
            case:
            }
            if field_path.len() == 0 {
                base := holyc_field_path(stmt.children[0], ctx, locals, error)
                mut sep := "."
                if holyc_pointer_field(stmt.children[0], ctx) { sep = "->" }
                field_path = format(base, sep, field_assign.name)
            }
            if field_own_type.is(OwnType.Ref) {
                value := holyc_pointer_expr(stmt.children[1], ctx, state, locals, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, field_path, " = ", value, ";\n")
            } else if field_own_type.is(OwnType.Own) {
                ctype := holyc_value_ctype(field_type, state)
                replacement := holyc_temp("replacement", state)
                init := holyc_owned_field_init(field_type, replacement, stmt.children[1],
                    depth + 1, ctx, state, locals, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, "{\n", prefix, "    ", ctype, " *", replacement, ";\n", init)
                if field_assign.save_old_delete {
                    old := holyc_temp("old_field", state)
                    out = format(out, prefix, "    ", ctype, " *", old, " = ", field_path, ";\n",
                        prefix, "    ", field_path, " = ", replacement, ";\n")
                    if field_type == "Str" {
                        out = format(out, prefix, "    TilStrDelete(", old, ", TRUE);\n")
                    } else {
                        out = format(out, prefix, "    ", field_type, "_Delete(", old, ", TRUE);\n")
                    }
                } else {
                    out = format(out, prefix, "    ", field_path, " = ", replacement, ";\n")
                }
                out = format(out, prefix, "}\n")
            } else if holyc_scalar_type_name(field_type) {
                value := holyc_expr(stmt.children[1], ctx, state, locals, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, field_path, " = ", value, ";\n")
            } else if field_type == "Str" {
                replacement := holyc_temp("replacement", state)
                value := holyc_str_init(replacement, stmt.children[1], ctx, state, locals, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, "{\n",
                    prefix, "    TilStr ", replacement, ";\n",
                    prefix, "    ", value, ";\n",
                    prefix, "    TilStrDelete(&", field_path, ", FALSE);\n",
                    prefix, "    TilStrCopyValue(&", field_path, ", &", replacement, ");\n",
                    prefix, "}\n")
            } else {
                error = format("unsupported assignment to field '", field_assign.name,
                    "' of type '", field_type, "' on '", owner_type, "'")
                return ""
            }
        case .FCall:
            if holyc_direct_call_name(stmt, ctx) == "swap_bytes" {
                if stmt.children.len() != 4 { error = "invalid aggregate swap"; return "" }
                type_name := til_type_name(stmt.children[1].til_type())
                if state.payload_enum_names.has(type_name).not()
                    .or(til_type_name(stmt.children[2].til_type()).neq(type_name)) {
                    error = "only same-type payload enum swaps are supported yet"
                    return ""
                }
                left := holyc_struct_ref(stmt.children[1], ctx, locals, error)
                right := holyc_struct_ref(stmt.children[2], ctx, locals, error)
                count := holyc_expr(stmt.children[3], ctx, state, locals, error)
                if error.len() > 0 { return "" }
                swap_value := holyc_temp("swap_value", state)
                out = format(out, prefix, "{\n",
                    prefix, "    if (", count, " != sizeof(", type_name,
                    ")) TilPanicZ(\"partial enum swap is not supported\");\n",
                    prefix, "    ", type_name, " ", swap_value, ";\n",
                    prefix, "    ", type_name, "_CopyValue(&", swap_value, ", ", left, ");\n",
                    prefix, "    ", type_name, "_CopyValue(", left, ", ", right, ");\n",
                    prefix, "    ", type_name, "_CopyValue(", right, ", &", swap_value, ");\n", prefix, "}\n")
                i++
                continue
            }
            value := holyc_expr(stmt, ctx, state, locals, error)
            if error.len() > 0 { return "" }
            out = format(out, prefix, value, ";\n")
        case .While:
            if stmt.children.len() != 2 {
                error = "invalid while statement"
                return ""
            }
            condition := holyc_expr(stmt.children[0], ctx, state, locals, error)
            if error.len() > 0 { return "" }
            mut nested_locals := holyc_clone_locals(locals)
            nested := holyc_body(stmt.children[1], depth + 1, false, aggregate_return_type, ctx, state, nested_locals, error)
            if error.len() > 0 { return "" }
            out = format(out, prefix, "while (", condition, ") {\n", nested, prefix, "}\n")
        case .If:
            if stmt.children.len().lt(2).or(stmt.children.len().gt(3)) {
                error = "invalid if statement"
                return ""
            }
            condition := holyc_expr(stmt.children[0], ctx, state, locals, error)
            if error.len() > 0 { return "" }
            mut then_locals := holyc_clone_locals(locals)
            then_body := holyc_body(stmt.children[1], depth + 1, false, aggregate_return_type, ctx, state, then_locals, error)
            if error.len() > 0 { return "" }
            out = format(out, prefix, "if (", condition, ") {\n", then_body, prefix, "}")
            if stmt.children.len() == 3 {
                mut else_locals := holyc_clone_locals(locals)
                else_body := holyc_body(stmt.children[2], depth + 1, false, aggregate_return_type, ctx, state, else_locals, error)
                if error.len() > 0 { return "" }
                out = format(out, " else {\n", else_body, prefix, "}")
            }
            out = format(out, "\n")
        case .Switch:
            ref subject : Expr = stmt.children[0]
            enum_name := til_type_name(subject.til_type())
            if state.enum_types.has(enum_name).not() {
                error = "only payload-free enum switches are supported yet"
                return ""
            }
            value := holyc_enum_tag_expr(subject, ctx, state, locals, error)
            if error.len() > 0 { return "" }
            // REM: HolyC switches use bounded dense tag ranges. Compare full
            // tags instead; the do block retains the switch's break target.
            switch_value := format("enum_switch_", state.switch_id.to_str())
            state.switch_id++
            out = format(out, prefix, "do {\n", prefix, "    ", state.enum_types[enum_name],
                " ", switch_value, " = ", value, ";\n")
            mut default_body := ""
            for ci in 1..stmt.children.len() {
                ref arm : Expr = stmt.children[ci]
                pattern_count := case_pattern_count(arm)
                mut arm_locals := holyc_clone_locals(locals)
                if pattern_count == 0 {
                    default_body = holyc_body(arm.children[0], depth + 1,
                        false, aggregate_return_type, ctx, state, arm_locals, error)
                    if error.len() > 0 { return "" }
                    continue
                }
                mut condition := ""
                for pi in 0..pattern_count {
                    pattern := holyc_enum_tag_expr(arm.children[pi], ctx, state, locals, error)
                    if error.len() > 0 { return "" }
                    if pi > 0 { condition = format(condition, " || ") }
                    condition = format(condition, "(", switch_value, " == ", pattern, ")")
                }
                arm_body := holyc_body(arm.children[arm.children.len() - 1], depth + 2,
                    false, aggregate_return_type, ctx, state, arm_locals, error)
                if error.len() > 0 { return "" }
                out = format(out, prefix, "    if (", condition, ") {\n", arm_body,
                    prefix, "        break;\n", prefix, "    }\n")
            }
            out = format(out, default_body, prefix, "} while (FALSE);\n")
        case .Break:
            out = format(out, prefix, "break;\n")
        case .Continue:
            error = "continue is not supported by TempleOS HolyC"
            return ""
        case .Return:
            if stmt.children.len() == 0 {
                if aggregate_return_type.len() > 0 {
                    error = "aggregate-returning function requires a return value"
                    return ""
                }
                out = format(out, prefix, "return;\n")
            } else if stmt.children.len() == 1 {
                if locals.ref_return_type.len() > 0 {
                    value := holyc_pointer_expr(stmt.children[0], ctx, state, locals, error)
                    if error.len() > 0 { return "" }
                    out = format(out, prefix, "return ", value, ";\n")
                } else if aggregate_return_type == "Str" {
                    return_value := holyc_temp("return_value", state)
                    value := holyc_str_init(return_value, stmt.children[0], ctx, state, locals, error)
                    if error.len() > 0 { return "" }
                    out = format(out, prefix, "{\n",
                        prefix, "    TilStr ", return_value, ";\n",
                        prefix, "    ", value, ";\n",
                        prefix, "    TilStrCopyValue(return_out, &", return_value, ");\n",
                        prefix, "    TilStrPrepareReturn(return_out);\n",
                        prefix, "    return;\n",
                        prefix, "}\n")
                } else if holyc_aggregate_type(aggregate_return_type, state) {
                    return_value := holyc_temp("return_value", state)
                    value := holyc_struct_init(aggregate_return_type, return_value,
                        stmt.children[0], depth + 1, ctx, state, locals, error)
                    if error.len() > 0 { return "" }
                    install := holyc_struct_copy(aggregate_return_type, "return_out", "->",
                        return_value, ".", depth + 1, ctx, state, error)
                    if error.len() > 0 { return "" }
                    out = format(out, prefix, "{\n",
                        prefix, "    ", aggregate_return_type, " ", return_value, ";\n",
                        value, install,
                        prefix, "    return;\n",
                        prefix, "}\n")
                } else {
                    value := holyc_expr(stmt.children[0], ctx, state, locals, error)
                    if error.len() > 0 { return "" }
                    out = format(out, prefix, "return ", value, ";\n")
                }
            } else {
                error = "invalid return statement"
                return ""
            }
        case:
            error = format("unsupported statement '", node_name(stmt.node_type), "'")
            return ""
        }
        i++
    }
    return out
}

priv holyc_struct_field_ctype := func(owner: Str, field_name: Str,
    field: Declaration, state: HolyCEmitState, mut error: Str) returns Str {
    field_type := holyc_storage_type_name(field.type_name())
    if state.niche_ref_types.has(field_type) { return holyc_value_ctype(field_type, state) }
    if field.own_type.is(OwnType.Ref).or(field.own_type.is(OwnType.Own)) {
        ctype := holyc_value_ctype(field_type, state)
        if holyc_scalar_type_name(ctype).or(ctype.eq("TilStr"))
            .or(holyc_aggregate_type(field_type, state)) {
            return format(ctype, " *")
        }
        error = format("unsupported pointer field '", owner, ".", field_name, "' of type '", field.type_name(), "'")
        return ""
    }
    if holyc_scalar_type_name(field_type).or(holyc_aggregate_type(field_type, state)) {
        return field_type
    }
    if field_type == "Str" { return "TilStr" }
    error = format("unsupported field '", owner, ".", field_name,
        "' of type '", field.type_name(), "'")
    return ""
}

priv holyc_payload_lifecycle := func(name: Str, ctx: Context,
    state: HolyCEmitState, mut error: Str) {
    if holyc_aggregate_type(name, state).not() { return }
    ref def : Expr = ctx.scope.get_struct(name, ctx.symbols).unwrap()
    for method : Str in "clone delete".split(" ") {
        if def_ns_has(def, method).and(holyc_struct_method_is_generated(name, method, ctx).not()) {
            error = format("custom payload method '", name, ".", method, "' is not supported yet")
            return
        }
    }
    switch def.node_type {
    case .StructDef(sd):
        for field : Declaration in sd.fields {
            holyc_payload_lifecycle(field.type_name(), ctx, state, error)
            if error.len() > 0 { return }
        }
    case .EnumDef(ed):
        for variant : VariantDef in ed.variants {
            if variant.payload_ref { continue }
            holyc_payload_lifecycle(variant.payload_type, ctx, state, error)
            if error.len() > 0 { return }
        }
    case:
    }
}

priv holyc_enum_definition := func(name: Str, def: Expr, ctx: Context,
    state: HolyCEmitState, mut error: Str) returns Str {
    ref ed : EnumDef = enumdef_of(def)
    holyc_payload_lifecycle(name, ctx, state, error)
    if error.len() > 0 { return "" }
    mut out := format("class ", name, " {\n  ", state.enum_types[name], " tag;\n  union {\n")
    for variant : VariantDef in ed.variants {
        if variant.payload_type.len() == 0 { continue }
        ctype := holyc_value_ctype(variant.payload_type, state)
        if holyc_scalar_type_name(ctype).or(ctype.eq("TilStr"))
            .or(holyc_aggregate_type(variant.payload_type, state)).not() {
            error = format("unsupported payload '", name, ".", variant.name, "' of type '", variant.payload_type, "'")
            return ""
        }
        mut ptr := ""
        if variant.payload_ref { ptr = " *" }
        out = format(out, "    ", ctype, ptr, " payload_", variant.name, ";\n")
    }
    out = format(out, "  };\n};\n\n")
    for variant : VariantDef in ed.variants {
        if variant.payload_type.len() == 0 {
            out = format(out, name, " ", name, "_Literal_", variant.name, ";\n",
                name, "_Literal_", variant.name, ".tag = ", variant.tag_value.to_str(), ";\n\n")
        }
    }
    for method : Str in "CopyValue Clone Delete Eq".split(" ") {
        if method.eq("Eq").and(holyc_struct_eq_supported(name, ctx, state).not()) { continue }
        if method == "Eq" {
            out = format(out, "Bool ", name, "_Eq(", name, " *a, ", name, " *b)\n{\n",
                "  if (a->tag != b->tag) return FALSE;\n")
        } else if method == "Delete" {
            out = format(out, "U0 ", name, "_Delete(", name, " *src, Bool call_free)\n{\n")
        } else {
            out = format(out, "U0 ", name, "_", method, "(", name, " *out, ", name, " *src)\n{\n",
                "  out->tag = src->tag;\n")
        }
        for variant : VariantDef in ed.variants {
            mut subject := "src"
            if method == "Eq" { subject = "a" }
            out = format(out, "  if (", subject, "->tag == ", variant.tag_value.to_str(), ") {\n")
            payload_type := holyc_storage_type_name(variant.payload_type)
            field := format("payload_", variant.name)
            if payload_type.len() > 0 {
                if variant.payload_ref {
                    if method == "Eq" {
                        comparison := holyc_field_eq_expr(payload_type, format("a->", field),
                            format("b->", field), true, state, error)
                        if error.len() > 0 { return "" }
                        out = format(out, "    return ", comparison, ";\n")
                    } else if method != "Delete" {
                        out = format(out, "    out->", field, " = src->", field, ";\n")
                    }
                } else if method == "Eq" {
                    mut comparison := format("a->", field, " == b->", field)
                    if payload_type == "Str" {
                        comparison = format("TilStrEq(&a->", field, ", &b->", field, ")")
                    } else if holyc_aggregate_type(payload_type, state) {
                        comparison = format(payload_type, "_Eq(&a->", field, ", &b->", field, ")")
                    }
                    out = format(out, "    return ", comparison, ";\n")
                } else if method == "Delete" {
                    if payload_type == "Str" {
                        out = format(out, "    TilStrDelete(&src->", field, ", FALSE);\n")
                    } else if holyc_aggregate_type(payload_type, state) {
                        out = format(out, "    ", payload_type, "_Delete(&src->", field, ", FALSE);\n")
                    }
                } else if payload_type == "Str" {
                    mut operation := "TilStrCopyValue"
                    if method == "Clone" { operation = "TilStrClone" }
                    out = format(out, "    ", operation, "(&out->", field, ", &src->", field, ");\n")
                } else if holyc_aggregate_type(payload_type, state) {
                    if method == "Clone" {
                        out = format(out, "    ", payload_type, "_Clone(&out->", field, ", &src->", field, ");\n")
                    } else {
                        out = format(out, holyc_struct_copy(payload_type, format("out->", field), ".",
                            format("src->", field), ".", 1, ctx, state, error))
                    }
                } else {
                    out = format(out, "    out->", field, " = src->", field, ";\n")
                }
            }
            if method == "Delete" { out = format(out, "    if (call_free) TilFree(src);\n") }
            if method != "Eq" { out = format(out, "    return;\n") }
            else if payload_type.len() == 0 { out = format(out, "    return TRUE;\n") }
            out = format(out, "  }\n")
        }
        out = format(out, "  TilPanicZ(\"invalid ", name, " tag\");\n")
        if method == "Eq" { out = format(out, "  return FALSE;\n") }
        out = format(out, "}\n\n")
    }
    return out
}

priv holyc_append_struct_outputs := func(lp: LoadedProgram, state: HolyCEmitState,
    mut output: Str, mut error: Str) {
    mut emitted := Set(Str).new()
    mut remaining := state.struct_names.len() + state.payload_enum_names.len()
    while remaining > 0 {
        mut progress := false
        for unit : ProgramUnit in lp.units {
            ref program : Expr = lp.ctx.imported[unit.path].ast
            for stmt : Expr in program.children {
                if stmt.node_type.is(NodeType.Decl).not().or(stmt.children.len().neq(1)) { continue }
                ref decl : Declaration = decl_of(stmt)
                if holyc_aggregate_type(decl.name, state).not().or(emitted.has(decl.name)) { continue }
                ref def : Expr = stmt.children[0]
                switch def.node_type {
                case .EnumDef(ed):
                    mut deps_ready := true
                    for variant : VariantDef in ed.variants {
                        if holyc_aggregate_type(variant.payload_type, state).and(emitted.has(variant.payload_type).not()) {
                            deps_ready = false
                        }
                    }
                    if deps_ready.not() { continue }
                    out_enum := holyc_enum_definition(decl.name, def, lp.ctx, state, error)
                    if error.len() > 0 { return }
                    output = format(output, out_enum)
                    emitted.add(own decl.name.clone())
                    remaining--
                    progress = true
                case .StructDef(sdef):
                    if sdef.is_interface {
                        error = format("interface '", decl.name, "' is not supported yet")
                        return
                    }
                    mut deps_ready := true
                    for i in 0..sdef.fields.len() {
                        ref field : Declaration = sdef.field_at(i)
                        field_type := holyc_storage_type_name(field.type_name())
                        mut dep := field_type
                        if state.niche_ref_types.has(field_type) { dep = state.niche_ref_types[field_type].clone() }
                        if holyc_aggregate_type(dep, state).and(dep.neq(decl.name))
                            .and(emitted.has(dep).not()) {
                            deps_ready = false
                        }
                    }
                    if deps_ready.not() { continue }
                    output = format(output, "class ", decl.name, " {\n")
                    for i in 0..sdef.fields.len() {
                        ref field : Declaration = sdef.field_at(i)
                        ref field_name : Str = sdef.field_name_at(i)
                        ctype := holyc_struct_field_ctype(decl.name, field_name, field, state, error)
                        if error.len() > 0 { return }
                        output = format(output, "  ", ctype, " ", field_name, ";\n")
                    }
                    output = format(output, "};\n\n")
                    output = format(output, "U0 ", decl.name, "_Clone(", decl.name,
                        " *out, ", decl.name, " *src)\n{\n")
                    for i in 0..sdef.fields.len() {
                        ref field : Declaration = sdef.field_at(i)
                        ref field_name : Str = sdef.field_name_at(i)
                        field_type := holyc_storage_type_name(field.type_name())
                        if field.own_type.is(OwnType.Ref) {
                            output = format(output, "  out->", field_name, " = src->", field_name, ";\n")
                        } else if field.own_type.is(OwnType.Own) {
                            ctype := holyc_value_ctype(field_type, state)
                            output = format(output, "  out->", field_name,
                                " = (TilMAlloc(sizeof(", ctype, ")))(", ctype, " *);\n")
                            if field_type == "Str" {
                                output = format(output, "  TilStrClone(out->", field_name, ", src->", field_name, ");\n")
                            } else if holyc_aggregate_type(field_type, state) {
                                output = format(output, "  ", field_type, "_Clone(out->", field_name,
                                    ", src->", field_name, ");\n")
                            }
                        } else if state.niche_ref_types.has(field_type).or(holyc_scalar_type_name(field_type)) {
                            output = format(output, "  out->", field_name, " = src->", field_name, ";\n")
                        } else if field_type == "Str" {
                            output = format(output, "  TilStrClone(&out->", field_name,
                                ", &src->", field_name, ");\n")
                        } else if holyc_aggregate_type(field_type, state) {
                            output = format(output, "  ", field_type, "_Clone(&out->", field_name,
                                ", &src->", field_name, ");\n")
                        }
                    }
                    output = format(output, "}\n\n")
                    output = format(output, "U0 ", decl.name, "_Delete(", decl.name,
                        " *self, Bool call_free)\n{\n")
                    for i in 0..sdef.fields.len() {
                        ref field : Declaration = sdef.field_at(i)
                        ref field_name : Str = sdef.field_name_at(i)
                        field_type := holyc_storage_type_name(field.type_name())
                        if field.own_type.is(OwnType.Ref) { continue }
                        if field.own_type.is(OwnType.Own) {
                            if field_type == "Str" {
                                output = format(output, "  TilStrDelete(self->", field_name, ", TRUE);\n")
                            } else if holyc_aggregate_type(field_type, state) {
                                output = format(output, "  ", field_type, "_Delete(self->", field_name, ", TRUE);\n")
                            }
                        } else if field_type == "Str" {
                            output = format(output, "  TilStrDelete(&self->", field_name, ", FALSE);\n")
                        } else if holyc_aggregate_type(field_type, state) {
                            output = format(output, "  ", field_type, "_Delete(&self->", field_name, ", FALSE);\n")
                        }
                    }
                    output = format(output, "  if (call_free) TilFree(self);\n}\n\n")
                    if holyc_struct_eq_supported(decl.name, lp.ctx, state) {
                        output = format(output, "Bool ", decl.name, "_Eq(", decl.name,
                            " *a, ", decl.name, " *b)\n{\n")
                        for i in 0..sdef.fields.len() {
                            ref field : Declaration = sdef.field_at(i)
                            ref field_name : Str = sdef.field_name_at(i)
                            field_type := holyc_storage_type_name(field.type_name())
                            left := format("a->", field_name)
                            right := format("b->", field_name)
                            if state.niche_ref_types.has(field_type) {
                                ref target : Str = state.niche_ref_types[field_type]
                                check := holyc_field_eq_expr(target, left, right, true, state, error)
                                if error.len() > 0 { return }
                                output = format(output, "  if ((", left, " == NULL) != (", right,
                                    " == NULL)) return FALSE;\n",
                                    "  if (", left, " != NULL && !", check, ") return FALSE;\n")
                            } else {
                                comparison := holyc_field_eq_expr(field_type, left, right,
                                    field.own_type.is(OwnType.Ref).or(field.own_type.is(OwnType.Own)), state, error)
                                if error.len() > 0 { return }
                                output = format(output, "  if (!", comparison, ") return FALSE;\n")
                            }
                        }
                        output = format(output, "  return TRUE;\n}\n\n")
                    }
                    emitted.add(own decl.name.clone())
                    remaining--
                    progress = true
                case:
                }
            }
        }
        if progress.not() {
            error = "cyclic inline struct dependency"
            return
        }
    }
}

priv holyc_append_function_outputs := func(program: Expr, ctx: Context,
    mut state: HolyCEmitState, mut prototypes: Str, mut definitions: Str,
    mut error: Str) {
    for stmt : Expr in program.children {
        switch stmt.node_type {
        case .Decl(decl):
            if stmt.children.len().neq(1).or(stmt.children[0].node_type.is(NodeType.FuncDef).not()) { continue }
            ref func_expr : Expr = stmt.children[0]
            signature := holyc_function_signature(decl.name, func_expr, state, error)
            if error.len() > 0 { return }
            if func_expr.children.len() != 1 {
                error = format("function '", decl.name, "' has no body")
                return
            }
            mut locals := HolyCLocalState()
            mut aggregate_return_type := ""
            switch func_expr.node_type {
            case .FuncDef(fdef):
                return_type := holyc_storage_type_name(fdef.sig.return_type)
                if fdef.sig.return_own_type.is(OwnType.Ref) {
                    locals.ref_return_type = return_type.clone()
                } else if return_type.eq("Str").or(holyc_aggregate_type(return_type, state)) {
                    aggregate_return_type = return_type
                }
                for param : Declaration in fdef.sig.params {
                    param_type := holyc_storage_type_name(param.type_name())
                    if param_type == "Str" {
                        locals.str_pointer_names.add(own param.name.clone())
                        locals.param_pointer_names.add(own param.name.clone())
                    } else if holyc_aggregate_type(param_type, state) {
                        locals.struct_pointer_types.set(param.name, own param_type)
                        locals.param_pointer_names.add(own param.name.clone())
                    } else if holyc_param_is_pointer(param, state) {
                        locals.pointer_types.set(param.name, own holyc_value_ctype(param_type, state))
                    }
                }
            case:
            }
            body := holyc_body(func_expr.children[0], 1, false, aggregate_return_type, ctx, state, locals, error)
            if error.len() > 0 { return }
            prototypes = format(prototypes, "extern ", signature, ";\n")
            definitions = format(definitions, signature, "\n{\n", body, "}\n\n")
        case:
        }
    }
}

priv holyc_runtime_prelude := func() returns Str {
    return format(
        "extern U8 *TilMAlloc(U64 count);\n",
        "extern U8 *TilCAlloc(U64 nmemb,U64 size);\n",
        "extern U8 *TilReAlloc(U8 *ptr,U64 count);\n",
        "extern U0 TilFree(U8 *ptr);\n",
        "extern U8 *TilMemCpy(U8 *dst,U8 *src,U64 count);\n",
        "extern U8 *TilMemMove(U8 *dst,U8 *src,U64 count);\n",
        "extern U8 *TilMemSet(U8 *dst,I64 value,U64 count);\n",
        "extern I32 TilMemCmp(U8 *a,U8 *b,U64 count);\n",
        "extern U0 TilRawWrite(U8 *data,U64 count);\n",
        "extern U0 TilPanic(U8 *data,U64 count);\n",
        "extern U0 TilNullDeref();\n",
        "extern U8 *TilCheckPtr(U8 *ptr);\n",
        "extern U8 *TilDeref(U8 **slot);\n",
        "extern U0 TilWritePtr(U8 *slot,U8 *value);\n\n",
        "#include \"/Home/Ext.HC\"\n\n")
}

holyc_codegen_translate := proc(lp: LoadedProgram, output_path: Str) returns I32 {
    if lp.mode_str != "script" {
        println("error: HolyC codegen currently supports only mode script")
        return 1
    }
    if lp.link_c_paths.len() > 0 {
        println("error: HolyC codegen does not support link_c yet")
        return 1
    }
    if lp.link_flags.len().gt(0).or(lp.include_flags.len().gt(0)) {
        println("error: HolyC codegen does not support link or include flags yet")
        return 1
    }
    if lp.run_tests {
        println("error: HolyC codegen does not support test mode yet")
        return 1
    }

    compiler_root := lp.ext_c_path.strip_suffix("/src/c/ext.c")
    runtime_path := format(compiler_root, "/src/holyc/ext.HC")
    if File.is_file(runtime_path).not() {
        println(format("error: HolyC runtime source is missing: ", runtime_path))
        return 1
    }

    mut state := HolyCEmitState()
    mut validation_error := ""
    for unit : ProgramUnit in lp.units {
        ref program : Expr = lp.ctx.imported[unit.path].ast
        holyc_prepare_state(program, state, validation_error)
        if validation_error.len() > 0 {
            println("error: HolyC codegen: ", validation_error)
            return 1
        }
    }
    mut structs := ""
    holyc_append_struct_outputs(lp, state, structs, validation_error)
    mut prototypes := ""
    mut definitions := ""
    if validation_error.len() == 0 {
        for unit : ProgramUnit in lp.units {
            ref program : Expr = lp.ctx.imported[unit.path].ast
            holyc_append_function_outputs(program, lp.ctx, state, prototypes, definitions, validation_error)
            if validation_error.len() > 0 { break }
        }
    }
    if prototypes.len() > 0 { prototypes = format(prototypes, "\n") }
    mut body := ""
    mut main_locals := HolyCLocalState()
    if validation_error.len() == 0 {
        for unit : ProgramUnit in lp.units {
            ref program : Expr = lp.ctx.imported[unit.path].ast
            body = format(body, holyc_body(program, 1, true, "", lp.ctx, state, main_locals, validation_error))
            if validation_error.len() > 0 { break }
        }
    }
    if validation_error.len() > 0 {
        println("error: HolyC codegen: ", validation_error)
        return 1
    }

    f := File.new(output_path, true)
    f.write(holyc_runtime_prelude())
    f.write(structs)
    if state.needs_i64_div {
        f.write("I64 TilI64Div(I64 a, I64 b)\n{\n    if (!b)\n        return 0;\n    return a / b;\n}\n\n")
    }
    if state.needs_i64_mod {
        f.write("I64 TilI64Mod(I64 a, I64 b)\n{\n    if (!b)\n        return 0;\n    return a % b;\n}\n\n")
    }
    f.write(prototypes)
    f.write(definitions)
    f.write("I64 TilMain()\n{\n")
    f.write(body)
    f.write("    return 0;\n}\n\nTilMain;\n")
    return 0
}
