mode lib

import("parser")
import("eval_heap")
import("../std/hashmap")
import("../std/file")

// Filesystem canonicalization is shared by loader discovery and the later
// per-file phase walks that resolve import calls directly from each AST.
realpath_str := ext_proc(path: Str) returns Str {}

display_path := func(p: Str, cwd: Str) returns Str {
    prefix := format(cwd, "/")
    rel := p.strip_prefix(prefix)
    if File.is_absolute(rel) { return rel }
    if rel.starts_with("./") { return rel }
    return format("./", rel)
}

resolve_import_abs := proc(import_path: Str, base_dir: Str, lib_dir: Str) returns Str {
    if File.is_absolute(import_path) { return realpath_str(import_path) }
    mut abs := realpath_str(base_dir.format("/", import_path))
    if abs.len().eq(0).and(lib_dir.len().gt(0)) {
        abs = realpath_str(lib_dir.format("/", import_path))
    }
    return abs
}

// #344: one storage that a borrow reaches. A ref binding -- or a binding
// whose value carries a borrowed payload -- records the bindings its value
// aliases, so a write through the alias can be credited to them. Identity
// is the name PLUS the declaration site: a nested block that shadows the
// name is a different binding and must not absorb the write, so a bare
// name would redirect the credit to the wrong storage.
BorrowRoot := struct {
    name := ""
    path := ""
    line : U32 = 0
    col : U32 = 0
    // #351: true when the root was reached through a CARRIED borrow -- a
    // ref field or a borrow-carrying value -- rather than by aliasing the
    // storage directly. Both kinds are credited as written; only direct
    // roots are enforced for now (the staged-migration seam in
    // check_write_roots_mut, removed by #351's use commit once this
    // tracking is the boot). Appended at the END so the committed boot's
    // layout stays stable.
    carried := false
    // #393: true when the root was DEPOSITED into this binding's storage
    // by a call or assignment (Vec.push parking a holder), rather than
    // recorded at the binding's own declaration. On a REF binding the
    // declared roots are its alias set -- a direct write through the ref
    // writes them -- while deposited roots are only reachable by crossing
    // the carried borrow, so the direct-write walk must skip them.
    // Packed against `carried` rather than appended: the two Bools share
    // one word of padding, so this flag costs nothing.
    deposited := false
    // #355/#356: for a carried root, the dotted PATH of fields the
    // pointer sits behind, from the carrying value (`h.r`: cross the
    // owned `h`, then the ref `r`). Set where the constructor makes it
    // known; "" means unknown depth, and an unknown path passes every
    // filter, so the conservative routes keep their answers. Appended at
    // the END so the committed boot's layout stays stable.
    field := ""
namespace:
    eq := func(a: BorrowRoot, b: BorrowRoot) returns Bool {
        return a.line.eq(b.line).and(a.col == b.col).and(a.name == b.name).and(a.path == b.path).and(a.field == b.field)
    }
    to_str := func(self: BorrowRoot) returns Str { return self.name.clone() }
}

TypeBinding := struct {
    name := ""
    type := Type.Unknown
    is_mut := false
    is_priv := false
    path := ""
    line : U32 = 0
    col : U32 = 0
    is_param := false
    own_type := OwnType.Shallow
    is_alias := false
    is_type_alias := false
    // True when the binding denotes a function or function-signature
    // *declaration*, as opposed to a function-pointer *value* (a local,
    // param, or struct field of FuncPtr type). The actual func kind lives
    // on func_def; this only records "is this a declaration", which a
    // func-ptr value's copied func_def cannot tell us on its own.
    is_func_decl := false
    alias_target := ""
    // Issue #147: the dangerous `ref struct_def : Expr` and
    // `ref func_def : Expr` borrows into the parse tree are both gone.
    // A binding's StructDef/EnumDef/FuncDef Expr now lives in the owning
    // scope's struct_defs / func_defs maps (set by set_struct_def /
    // set_func_def_name, read via the pool-aware exact-binding helpers and
    // get_struct); func_type caches the FuncType so
    // binding_func_type doesn't need the Expr at all.
    func_type := FuncType.Func
    is_builtin := false
    used := false
    // #164: set when the binding is written through -- direct `name = ...`,
    // `name.f = ...`, etc. Combined with mut_explicit, lets
    // check_unused_mut_locals flag `mut` locals that are never written and
    // suggest dropping the keyword.
    written := false
    // #164: true when the source declaration used the lexical `mut`
    // keyword. The typer auto-promotes some bindings (array/vec literal
    // rewrites) to is_mut=true even when the user wrote `:=`; flagging
    // those would produce a confusing "redundant 'mut' on local 'X'"
    // diagnostic where there is no source-level 'mut' to drop.
    // mut_explicit is set exactly at the typer's Decl handler from
    // sdecl.is_mut.
    mut_explicit := false
    // #302/#357: this binding's VALUE is a raw allocation ADDRESS (`b : U8
    // = malloc(n)`), not a scalar of that type. Both wear the same Primitive
    // type, so without this nothing can tell "U8 that IS an address" from
    // "U8 that holds a byte".
    is_raw_alloc := false
    // #372: this binding holds a Str VIEW of str_view_base's buffer, not
    // storage of its own -- set when the initializer is one of core's
    // view-returning Str methods over a named binding. View-ness is a
    // runtime property of `cap` that no signature carries (#367), so
    // nothing else records it, and without it a view of a PARAMETER is
    // indistinguishable from an owned local at a return statement.
    is_str_view := false
    str_view_base := ""
    // Issue #93: mirror of Declaration.orig_name -- non-empty means
    // init_declarations_unit hoisted this decl from a function body and
    // the unused-priv check should report it in source terms (original
    // name + enclosing parent) rather than as a synthetic mangled name.
    orig_name := ""
    // #262 follow-up: for a local `v := DynVec.new(T)`, the element type
    // name T. Lets the typer narrow `v[i]` / v.get(i) / v.pop() results
    // from `Dynamic` to the concrete element type -- which is what makes a
    // direct subscript CALL on a stored funcptr (`ops[0](args)`) typable.
    // Empty when unknown (non-literal elem type, reassigned vec, etc.).
    dynvec_elem := ""
    // Issue #328: the type name AS DECLARED at the binding site, before
    // alias normalization rewrote it. Generic inference forms a
    // monomorphization name from it, so a `n: USize` operand contributes
    // the target-independent `USize` and not the target's `U32`, and a
    // user alias contributes the alias (which canonicalizes later through
    // resolve_type_alias_for_name). Empty when there is no declared
    // spelling to keep (a literal, an unannotated local with no
    // provenance). Appended at the END so the committed boot's layout
    // stays stable.
    declared_type_name := ""
    // #344: the storages this binding's value BORROWS -- the whole chain,
    // since a write through an alias writes every alias along the way, and
    // each alias's own `mut` is what permits it. Empty for ordinary owned
    // locals and for parameters (they ARE the storage);
    // non-empty for a `ref` local, a switch payload alias, and any binding
    // bound to a ref-returning call -- the accessor forms that used to
    // launder a write away from the binding it really lands on. The write
    // marker (mark_written_through) credits every root here, so a `mut`
    // whose only write goes through an accessor is no longer "redundant".
    // Appended at the END so the committed boot's layout stays stable.
    borrow_roots := Vec(BorrowRoot).new()
    // The binding names stable storage owned by an external C object.
    // Reads and writes are ordinary lvalue operations; borrows may take its
    // address, but scope teardown never owns it.
    is_external_global := false
namespace:
    eq := func(a: TypeBinding, b: TypeBinding) returns Bool {
        return a.name == b.name
    }
    to_str := func(self: TypeBinding) returns Str {
        return self.name.clone()
    }
}

ScopeFind := enum { NotFound, Found: TypeBinding }

// One bit of a 64-bit set fingerprint, picked from a name's length and
// first byte. TypeScope's registry filters below are the OR of their
// keys' bits, so a CLEAR bit proves the name is absent and the lookup
// can skip that level's binary search; a set bit means "maybe" and the
// search decides. Also used for the garbager's per-body fact index
// (typer.til), which filters the same way.
// Written for the emitted C, not for looks: this runs once per scope
// lookup (600K+ per maps.til compile), and at -O0 every intermediate is
// a store plus a load. band(63) instead of mod(64) drops the emitted
// divide-by-zero guard, and the byte goes through cast(U8) so the
// widening is a C cast rather than the sign-extending I8_to_u64 call.
name_fingerprint := func(name: Str) returns U64 {
    one : U64 = 1
    return one.shl(name.len().mul(31).add(name.unsafe_get(0).cast(U8).to_usize()).band(63).to_u64())
}

priv sym_fingerprint := func(sym: Sym) returns U64 {
    one : U64 = 1
    return one.shl(sym.to_u64().band(63))
}

// #397: the two questions every name-payload consumer actually asks,
// answered for BOTH the Str payloads and their Sym twins. Step 2 routes
// consumers through these; step 3 flips producers to build the Sym forms,
// and only these two functions have to notice.
//
// type_sym is the one that pays off: a caller holding a Type gets the
// symbol the scope registries are keyed by. For a Sym payload that is a
// field read. For a Str payload it interns -- ONCE per call, where the
// old path hashed the spelling once per scope level of the lookup walk.
type_sym := func(t: Type, mut symbols: SymbolPool) returns Sym {
    switch t {
    case .StructSym(sym):     return sym.clone()
    case .EnumSym(sym):       return sym.clone()
    case .CustomSym(sym):     return sym.clone()
    case .FuncPtrSigSym(sym): return sym.clone()
    case .Struct(s):     return symbols.intern(s)
    case .Enum(s):       return symbols.intern(s)
    case .Custom(s):     return symbols.intern(s)
    case .FuncPtrSig(s): return symbols.intern(s)
    case: return 0
    }
}

// The spelling, for the edges that genuinely need text: diagnostics, name
// mangling, C emission. Borrowed either way -- a Str payload is borrowed
// from the Type, a Sym payload from the pool's names vector -- so callers
// keep whatever lifetime discipline they already had with
// expr_type_name_ref / til_type_name.
type_name_of := func(t: Type, symbols: SymbolPool) returns Option(ref Str) {
    switch t {
    case .Struct(s):     return safe_ref(s)
    case .Enum(s):       return safe_ref(s)
    case .Custom(s):     return safe_ref(s)
    case .FuncPtrSig(s): return safe_ref(s)
    case .StructSym(sym):     return safe_ref(symbols.resolve(sym))
    case .EnumSym(sym):       return safe_ref(symbols.resolve(sym))
    case .CustomSym(sym):     return safe_ref(symbols.resolve(sym))
    case .FuncPtrSigSym(sym): return safe_ref(symbols.resolve(sym))
    case: return Option(ref Str).None
    }
}

// #292: definition registries are keyed by the same interned symbol as the
// binding registry. A parent walk therefore compares U32s rather than names.
// Keep the cell deref in this leaf: inlining the ?/catch into a multi-branch
// scope walker makes emitted C trip -Werror=return-type.
priv defs_lookup_one := func(filt: U64, fp: U64, m: Map(Sym, Dynamic), sym: Sym) returns Option(ref Expr) {
    if filt.band(fp) == 0 { return Option(ref Expr).None }
    ref slot : Dynamic = m.get(sym)?
    catch (e: KeyNotFound) { return Option(ref Expr).None }
    ref fd : Expr = deref(slot)
    return safe_ref(fd)
}

// #307 follow-up: leaf single-probe lookup for TypeScope.bindings, the
// binding-side twin of func_defs_lookup_one. The scope walkers used to
// pay a has() probe plus a [] probe per level (two binary searches per
// scope per lookup, ~850K has() calls per self-host translate); one
// get()?+catch does it in one probe, mirroring the interpreter's
// scope-chain collapse.
priv bindings_lookup_one := func(m: Map(Sym, TypeBinding), sym: Sym) returns Option(ref TypeBinding) {
    ref b : TypeBinding = m.get(sym)?
    catch (e: KeyNotFound) { return Option(ref TypeBinding).None }
    return safe_ref(b)
}

TyperFuncState := struct {
    // Empty for namespace methods; those use TypeScope.current_type_name.
    current_top_func_name := ""
    // Declared return type of the function currently being checked.
    typer_return_type_name := ""
    proc_calls_count : I32 = 0
    proc_def_depth : I32 = 0
    auto_gen_depth : I32 = 0
    // Function-wide throw-lowering state. Lowering runs before lexical block
    // scopes exist, so every child scope shares the function root's tables.
    throw_used_local_names := Set(Str).new()
    lowering_param_types := Map(Str, Str).new()
}

TypeScope := struct {
    bindings := Map(Sym, TypeBinding).new()
    target_usize_pname := "U64"
    target_uptr_pname := "U64"
    // Issue #147/#292: Sym -> FuncDef Expr ptr (stored as Dynamic since
    // Maps don't carry ref Expr). Replaces TypeBinding.func_def. Set
    // by scope.set_func_def_name at every binding write site that used to
    // assign b.func_def; readers use the pool-aware lookup helpers. The
    // builder also stores binding-less C-symbol aliases here through
    // set_func_symbol; lookup_func ignores those because it gates on
    // bindings, while lookup_func_symbol reads them for codegen.
    func_defs := Map(Sym, Dynamic).new()
    struct_defs := Map(Sym, Dynamic).new()
    // #321: None at the root scope; every lookup below walks the chain
    // until it runs out of parents. Real control flow, not a guard.
    parent := Option(ref TypeScope).None
    // #327: true for the scope a function's PARAMETERS are bound in. Block
    // scopes inside the body chain up to it, so a walk that stops here has
    // seen exactly this function's params and locals -- what a redeclaration
    // check must consider, without reaching enclosing/global bindings (a
    // local legitimately shadows a global, and codegen handles that).
    is_func_root := false
    // Lexical type owner. A type scope sets this; namespace function roots
    // retain it through their parent chain while owning fresh function state.
    current_type_name := ""
    // The global root and every function root own one active typer state.
    // Lexical child scopes carry an unused default and resolve through parent.
    typer_func := TyperFuncState()
    // Membership fingerprints of the three registries' key sets. A clear bit
    // PROVES the key is
    // not in that map, so the chain walk skips the binary search and the
    // KeyNotFound catch at this level -- and skipping is the common case,
    // because a lookup resolves at some outer scope while every level
    // below it pays a full search first.
    //
    // Erasing a name temporarily leaves its bit set: a stale bit only costs
    // the search it could have skipped, never a wrong answer. Batch retirement
    // callers rebuild all three filters once after their removals.
    bindings_filt : U64 = 0
    func_defs_filt : U64 = 0
    struct_defs_filt : U64 = 0
namespace:
    typer_func_state := func(mut self: TypeScope) returns ref TyperFuncState {
        if self.is_func_root { return self.typer_func }
        switch self.parent {
        case .Some(p): return p.typer_func_state()
        case .None: return self.typer_func
        }
    }
    active_type_name := func(self: TypeScope) returns ref Str {
        if self.current_type_name.len() > 0 { return self.current_type_name }
        switch self.parent {
        case .Some(p): return p.active_type_name()
        case .None: return self.current_type_name
        }
    }
    // Iterative single-probe walk (the interpreter's scope_get shape):
    // one call frame per lookup, one binary search per level -- the
    // recursive has()+[] version paid a call and up to two searches per
    // level (417K lookups per self-host translate).
    // The name's fingerprint is computed ONCE here and threaded down the
    // walk (same for every _fp worker below): recomputing it per level
    // would spend on arithmetic what the filter saves on searching.
    local_binding_sym := func(self: TypeScope, sym: Sym) returns Option(ref TypeBinding) {
        return bindings_lookup_one(self.bindings, sym)
    }
    local_binding_name := func(self: TypeScope, name: Str, symbols: SymbolPool) returns Option(ref TypeBinding) {
        sym_o := symbols.lookup(name)
        if sym_o.is_none() { return Option(ref TypeBinding).None }
        return self.local_binding_sym(sym_o.unwrap())
    }
    has_local_binding_sym := func(self: TypeScope, sym: Sym) returns Bool {
        return self.bindings.has(sym)
    }
    has_local_binding_name := func(self: TypeScope, name: Str, symbols: SymbolPool) returns Bool {
        sym_o := symbols.lookup(name)
        if sym_o.is_none() { return false }
        return self.has_local_binding_sym(sym_o.unwrap())
    }
    get_binding_sym := func(self: TypeScope, sym: Sym) returns Option(ref TypeBinding) {
        ref b : TypeBinding = self.bindings.get(sym)?
        catch (e: KeyNotFound) {
            switch self.parent {
            case .Some(p):
                return p.get_binding_sym(sym)
            case .None:
                return Option(ref TypeBinding).None
            }
        }
        return safe_ref(b)
    }
    get_binding_name := func(self: TypeScope, name: Str, symbols: SymbolPool) returns Option(ref TypeBinding) {
        sym_o := symbols.lookup(name)
        if sym_o.is_none() { return Option(ref TypeBinding).None }
        return self.get_binding_sym(sym_o.unwrap())
    }
    find_name := func(self: TypeScope, name: Str, symbols: SymbolPool) returns ScopeFind {
        bo := self.get_binding_name(name, symbols)
        if bo.is_some() { return ScopeFind.Found(bo.unwrap().clone()) }
        return ScopeFind.NotFound
    }
    find_sym := func(self: TypeScope, sym: Sym) returns ScopeFind {
        bo := self.get_binding_sym(sym)
        if bo.is_some() { return ScopeFind.Found(bo.unwrap().clone()) }
        return ScopeFind.NotFound
    }
    get_type_name := func(self: TypeScope, name: Str, symbols: SymbolPool) returns Type {
        bo := self.get_binding_name(name, symbols)
        if bo.is_some() { return bo.unwrap().type.clone() }
        return Type.Unknown
    }
    get_type_sym := func(self: TypeScope, sym: Sym) returns Type {
        bo := self.get_binding_sym(sym)
        if bo.is_some() { return bo.unwrap().type.clone() }
        return Type.Unknown
    }
    // #327: is `name` already bound by THIS function -- its parameters or a
    // local in an enclosing block of the same body? Walks like get_binding
    // but stops at the function root, so a global of the same name is not
    // reported (shadowing a global is legal and codegen handles it).
    // #327: are we inside a function body at all? (A func root somewhere up
    // the chain.) At global scope there is none, and a top-level redeclaration
    // is a separate matter handled elsewhere.
    in_function := func(self: TypeScope) returns Bool {
        if self.is_func_root { return true }
        switch self.parent {
        case .Some(p): return p.in_function()
        case .None: return false
        }
        return false
    }
    bound_in_this_func_sym := func(self: TypeScope, sym: Sym) returns Bool {
        if self.bindings.has(sym) { return true }
        if self.is_func_root { return false }
        switch self.parent {
        case .Some(p): return p.bound_in_this_func_sym(sym)
        case .None: return false
        }
        return false
    }
    bound_in_this_func_name := func(self: TypeScope, name: Str, symbols: SymbolPool) returns Bool {
        sym_o := symbols.lookup(name)
        if sym_o.is_none() { return false }
        return self.bound_in_this_func_sym(sym_o.unwrap())
    }
    get_func_type_name := func(self: TypeScope, name: Str, symbols: SymbolPool) returns shallow FuncType {
        bo := self.get_binding_name(name, symbols)
        if bo.is_none() { return FuncType.Func }
        return binding_func_type(bo.unwrap())
    }
    // Issue #147: TYPE-NAME resolution. Fall-through walk: a scope that
    // binds `name` as a non-type (no struct_defs entry) does NOT block
    // the lookup from finding a same-named type in a parent scope (e.g.
    // typing the `Type` enum body binds a payload variable `Primitive`
    // in the inner scope, and `Type.Primitive(Primitive)` must still
    // resolve the top-level `Primitive` enum from the parent). This is
    // the semantic master's get_struct had via `b.struct_def`-then-
    // fall-through; now it reads the struct_defs map.
    // Iterative single-probe walk (see get_binding): the hottest scope
    // lookup in the compiler -- 2.6M calls per self-host translate, and
    // the recursive has()+lookup version paid a call frame and up to two
    // binary searches per scope level.
    get_struct := func(self: TypeScope, name: Str, symbols: SymbolPool) returns Option(ref Expr) {
        sym_o := symbols.lookup(name)
        if sym_o.is_none() { return Option(ref Expr).None }
        return self.get_struct_by_sym(sym_o.unwrap())
    }
    get_struct_by_sym := func(self: TypeScope, sym: Sym) returns Option(ref Expr) {
        return self.get_struct_fp(sym, sym_fingerprint(sym))
    }
    get_struct_fp := func(self: TypeScope, sym: Sym, fp: U64) returns Option(ref Expr) {
        // Type defs live in the outer scopes, so a lookup from inside a
        // function body walks the whole chain and probes a map that is
        // EMPTY at nearly every level -- 14.3M probes per self-translate,
        // the bulk of them on empty maps. The filter answers both of
        // those (empty, and non-empty-but-absent) with one AND; the probe
        // below is a call plus a search plus the KeyNotFound catch.
        if self.struct_defs_filt.band(fp) == 0 {
            switch self.parent {
            case .Some(pe): return pe.get_struct_fp(sym, fp)
            case .None: return Option(ref Expr).None
            }
        }
        ref slot : Dynamic = self.struct_defs.get(sym)?
        catch (e: KeyNotFound) {
            switch self.parent {
            case .Some(p): return p.get_struct_fp(sym, fp)
            case .None: return Option(ref Expr).None
            }
        }
        ref sd : Expr = deref(slot)
        return safe_ref(sd)
    }
    // Issue #147: EXACT-BINDING struct def. Replaces direct
    // `binding.struct_def` field reads where the caller already holds a
    // specific binding (from get_binding / find / a bindings iteration)
    // and asks "is THIS binding a type def?". Gates on the first scope
    // that binds `name` (mirroring get_binding) and returns that scope's
    // struct def or None -- it must NOT fall through to a parent type of
    // the same name, or a shadowing local var would be misread as a type.
    struct_def_of_sym := func(self: TypeScope, sym: Sym, fp: U64) returns Option(ref Expr) {
        if bindings_lookup_one(self.bindings, sym).is_some() {
            return defs_lookup_one(self.struct_defs_filt, fp, self.struct_defs, sym)
        }
        switch self.parent {
        case .Some(p): return p.struct_def_of_sym(sym, fp)
        case .None: return Option(ref Expr).None
        }
    }
    struct_def_of_name := func(self: TypeScope, name: Str, symbols: SymbolPool) returns Option(ref Expr) {
        sym_o := symbols.lookup(name)
        if sym_o.is_none() { return Option(ref Expr).None }
        sym := sym_o.unwrap()
        return self.struct_def_of_sym(sym, sym_fingerprint(sym))
    }
    struct_def_of_by_sym := func(self: TypeScope, sym: Sym, _symbols: SymbolPool) returns Option(ref Expr) {
        return self.struct_def_of_sym(sym, sym_fingerprint(sym))
    }
    // Issue #147: name -> FuncDef Expr. Mirrors get_struct's parent-
    // walking lookup. Replaces direct reads of TypeBinding.func_def.
    // The actual cell deref is delegated to func_defs_lookup_one (a
    // leaf with the exact Map.get(sym)? + deref shape proven in
    // interpreter.til:lookup_interp_type_def) so the `?`/catch desugar
    // doesn't sit in a multi-branch function (which trips
    // -Werror=return-type in the emitted C).
    lookup_func_sym := func(self: TypeScope, sym: Sym, fp: U64) returns Option(ref Expr) {
        if bindings_lookup_one(self.bindings, sym).is_some() {
            return defs_lookup_one(self.func_defs_filt, fp, self.func_defs, sym)
        }
        switch self.parent {
        case .Some(p): return p.lookup_func_sym(sym, fp)
        case .None: return Option(ref Expr).None
        }
    }
    lookup_func_by_sym := func(self: TypeScope, sym: Sym, _symbols: SymbolPool) returns Option(ref Expr) {
        return self.lookup_func_sym(sym, sym_fingerprint(sym))
    }
    lookup_func_name := func(self: TypeScope, name: Str, symbols: SymbolPool) returns Option(ref Expr) {
        sym_o := symbols.lookup(name)
        if sym_o.is_none() { return Option(ref Expr).None }
        sym := sym_o.unwrap()
        return self.lookup_func_sym(sym, sym_fingerprint(sym))
    }
    // Is ANY function named `name` reachable, IGNORING value bindings
    // that shadow it? The mirror image of lookup_func, which stops at
    // the first scope that binds the name. Needed by the not-callable
    // diagnostic: infer_type_def_expr binds a struct's FIELDS in the
    // very scope its namespace methods are typed in, so a field named
    // `format` (vendor/bindings/raylib.til's Image/Texture) shadows the
    // global `format` function that the generated `to_str` body calls
    // and actually reaches at run time.
    any_func_def := func(self: TypeScope, name: Str, symbols: SymbolPool) returns Bool {
        sym_o := symbols.lookup(name)
        if sym_o.is_none() { return false }
        sym := sym_o.unwrap()
        return self.any_func_def_sym(sym, sym_fingerprint(sym))
    }
    any_func_def_sym := func(self: TypeScope, sym: Sym, fp: U64) returns Bool {
        if defs_lookup_one(self.func_defs_filt, fp, self.func_defs, sym).is_some() { return true }
        switch self.parent {
        case .Some(p): return p.any_func_def_sym(sym, fp)
        case .None: return false
        }
        return false
    }
    // The struct-def / func-def of a name the caller KNOWS this scope
    // binds -- it is iterating self.bindings. struct_def_of and
    // lookup_func both start by probing bindings to find the owning
    // scope; when the answer is "this one" by construction, that probe
    // (a search of the biggest map in the scope) is dead weight, and so
    // is recomputing the fingerprint for the second question.
    local_struct_def_fp := func(self: TypeScope, sym: Sym, fp: U64) returns Option(ref Expr) {
        return defs_lookup_one(self.struct_defs_filt, fp, self.struct_defs, sym)
    }
    // The Sym-taking twin of local_struct_def_fp above, for the same
    // callers: they are walking self.bindings, so they HOLD the symbol
    // and its fingerprint already. Going through the name spelling
    // instead made SymbolPool.lookup hash a name back into the symbol
    // the caller was iterating -- 62,711 hashes per self-translate to
    // learn what was already in hand (#292/#337).
    local_func_def_fp_sym := func(self: TypeScope, sym: Sym, fp: U64) returns Option(ref Expr) {
        return defs_lookup_one(self.func_defs_filt, fp, self.func_defs, sym)
    }
    local_func_def_fp := func(self: TypeScope, name: Str, symbols: SymbolPool) returns Option(ref Expr) {
        sym_o := symbols.lookup(name)
        if sym_o.is_none() { return Option(ref Expr).None }
        sym := sym_o.unwrap()
        return defs_lookup_one(self.func_defs_filt, sym_fingerprint(sym), self.func_defs, sym)
    }
    lookup_func_symbol_sym := func(self: TypeScope, sym: Sym, fp: U64) returns Option(ref Expr) {
        bo := bindings_lookup_one(self.bindings, sym)
        if bo.is_some() {
            if bo.unwrap().is_func_decl {
                return defs_lookup_one(self.func_defs_filt, fp, self.func_defs, sym)
            }
            return Option(ref Expr).None
        }
        local := defs_lookup_one(self.func_defs_filt, fp, self.func_defs, sym)
        if local.is_some() { return local }
        switch self.parent {
        case .Some(p): return p.lookup_func_symbol_sym(sym, fp)
        case .None: return Option(ref Expr).None
        }
    }
    lookup_func_symbol_name := func(self: TypeScope, name: Str, symbols: SymbolPool) returns Option(ref Expr) {
        sym_o := symbols.lookup(name)
        if sym_o.is_none() { return Option(ref Expr).None }
        sym := sym_o.unwrap()
        return self.lookup_func_symbol_sym(sym, sym_fingerprint(sym))
    }
    // Issue #147: register a binding's FuncDef Expr in the scope-side
    // func_defs map (the replacement for the removed ref func_def
    // field) and cache its FuncType so binding_func_type stays a pure
    // field read.
    //
    // The Sym-keyed func_defs Map stores a Dynamic-pointing-to-Expr-ptr
    // (malloc'd cell, write_ptr-populated). Mirrors the
    // ctx.interp_type_defs pattern -- the cell is owned by the Map so
    // its cleanup frees the allocation; the Expr it points at lives
    // in the AST and is not owned by the Map.
    //
    // The cell is typed UPtr, not I64: it holds a POINTER, so its width
    // must follow the pointer width (which is also what the Map's
    // Dynamic value slot is sized at). I64 happened to work only because
    // both are 8 bytes on 64-bit hosts; on a 32-bit target it allocated 8
    // bytes for a 4-byte slot and called a pointer a signed integer.
    set_func_def_name := func(mut self: TypeScope, name: Str, fdef: Expr, symbols: SymbolPool) {
        sym_o := symbols.lookup(name)
        if sym_o.is_none() { panic("set_func_def_name: binding name is not interned: ", name) }
        mut b_o := bindings_lookup_one(self.bindings, sym_o.unwrap())
        if b_o.is_some() {
            ref mut b : TypeBinding = b_o.unwrap()
            b.func_type = func_def_type(fdef)
        }
        mut cell : UPtr = malloc(UPtr.size().to_uptr())
        write_ptr(cell, fdef)
        sym := sym_o.unwrap()
        self.func_defs.set(sym, own cell)
        self.func_defs_filt = self.func_defs_filt.bor(sym_fingerprint(sym))
    }
    set_func_symbol_name := func(mut self: TypeScope, name: Str, fdef: Expr, mut symbols: SymbolPool) {
        sym := symbols.intern(name)
        if self.bindings.has(sym) { return }
        mut cell : UPtr = malloc(UPtr.size().to_uptr())
        write_ptr(cell, fdef)
        self.func_defs.set(sym, own cell)
        self.func_defs_filt = self.func_defs_filt.bor(sym_fingerprint(sym))
    }
    // Issue #147: register a binding's StructDef/EnumDef Expr in the
    // scope-side struct_defs map (the replacement for the removed
    // ref struct_def field). Same malloc'd-cell pattern as set_func_def
    // -- the cell is owned by the Map, the Expr lives in the AST.
    set_struct_def := func(mut self: TypeScope, name: Str, sdef: Expr, symbols: SymbolPool) {
        if sdef.node_type.is(NodeType.StructDef).not().and(sdef.node_type.is(NodeType.EnumDef).not()) {
            panic("set_struct_def: expected struct or enum for ", name, ", got ", sdef.node_type.head_str(symbols.names))
        }
        mut cell : UPtr = malloc(UPtr.size().to_uptr())
        write_ptr(cell, sdef)
        sym_o := symbols.lookup(name)
        if sym_o.is_none() { panic("set_struct_def: binding name is not interned: ", name) }
        sym := sym_o.unwrap()
        self.struct_defs.set(sym, own cell)
        self.struct_defs_filt = self.struct_defs_filt.bor(sym_fingerprint(sym))
    }
    is_mut_sym := func(self: TypeScope, sym: Sym) returns Bool {
        bo := self.get_binding_sym(sym)
        if bo.is_some() { return bo.unwrap().is_mut }
        return false
    }
    is_mut_name := func(self: TypeScope, name: Str, symbols: SymbolPool) returns Bool {
        bo := self.get_binding_name(name, symbols)
        if bo.is_some() { return bo.unwrap().is_mut }
        return false
    }
    // Issue #328: retiring a generic source template has to ERASE its
    // entries, not re-point them -- init_refresh_seeded_scope_defs only
    // refreshes names that are still declared, so an obsolete one would
    // keep a dangling FuncDef pointer for the backends to find.
    priv erase_func_def := func(mut self: TypeScope, name: Str, symbols: SymbolPool) {
        sym_o := symbols.lookup(name)
        if sym_o.is_some() { self.func_defs.remove(sym_o.unwrap()) }
    }
    priv erase_binding := func(mut self: TypeScope, name: Str) {
        for i in 0..self.bindings.values.len() {
            if self.bindings.values.unsafe_get(i).name == name {
                self.bindings.remove(self.bindings.keys.unsafe_get(i))
                return
            }
        }
    }
    // #326: the struct_defs twin of erase_func_def, for the scavenger --
    // a swept type declaration's AST is freed, so its registry entry must
    // go with it or a later by-name lookup reads a freed Expr.
    priv erase_struct_def := func(mut self: TypeScope, name: Str, symbols: SymbolPool) {
        sym_o := symbols.lookup(name)
        if sym_o.is_some() { self.struct_defs.remove(sym_o.unwrap()) }
    }
    // Retire every AST-backed registry entry for one declaration before its
    // Expr is freed. Some consumers still need the binding's type metadata
    // after removing the AST (the scavenger); callers that remove the name
    // semantically too request binding erasure.
    erase_ast_decl := func(mut self: TypeScope, name: Str, erase_decl_binding: Bool, symbols: SymbolPool) {
        self.erase_func_def(name, symbols)
        self.erase_struct_def(name, symbols)
        if erase_decl_binding { self.erase_binding(name) }
    }
    refresh_lookup_filters := func(mut self: TypeScope) {
        self.bindings_filt = 0
        self.func_defs_filt = 0
        self.struct_defs_filt = 0
        for binding : TypeBinding in self.bindings.values {
            self.bindings_filt = self.bindings_filt.bor(name_fingerprint(binding.name))
        }
        for func_sym : Sym in self.func_defs.keys {
            self.func_defs_filt = self.func_defs_filt.bor(sym_fingerprint(func_sym))
        }
        for struct_sym : Sym in self.struct_defs.keys {
            self.struct_defs_filt = self.struct_defs_filt.bor(sym_fingerprint(struct_sym))
        }
    }
    set := func(mut self: TypeScope, name: Str, type: Type,
        is_mut: Bool,
        path: Str,
        line: U32, col: U32,
        is_param: Bool, shallow own_type: OwnType, mut symbols: SymbolPool) {
            sym := symbols.intern(name)
            if self.bindings.has(sym) {
                ref mut b : TypeBinding = self.bindings[sym]
                b.type = type
                b.is_mut = is_mut
                // path/line/col are declaration-site identity. Preserve them
                // when a declaration is re-registered so private cross-file
                // checks retain the original location (#179 step 1).
                b.is_param = is_param
                b.own_type = own_type
                return
            }
            nb := TypeBinding(name = name.clone(), type = type.clone(),
                is_mut = is_mut,
                path = path.clone(),
                line = line, col = col,
                is_param = is_param, own_type = own_type)
            self.bindings.set(sym, own nb)
            self.bindings_filt = self.bindings_filt.bor(name_fingerprint(name))
        }
}

// A binding's func kind is cached in b.func_type (set by
// scope.set_func_def from the FuncDef node at registration). Non-function
// bindings keep the default FuncType.Func (the only callers test
// Proc/ExtProc/Test/Macro, none of which a non-function answers yes to,
// and FuncPtr-typed callees skip those checks entirely).
binding_func_type := func(b: TypeBinding) returns shallow FuncType {
    return b.func_type
}

// Issue #328: does this binding denote a TYPE (a real type token), as
// opposed to a value? Shared by the typer (rewrite_til_type_arg) and the
// initer (telling `gid(I64, v)` apart from `gid(v, 42)`), so both phases
// classify a `Type`-slot argument by exactly one rule. A bodyless FuncDef
// binding is a FuncSig type name (`BinaryOp := func(a: I64) returns I64`).
type_binding_is_type_token := func(scope: TypeScope, b: TypeBinding, symbols: SymbolPool) returns Bool {
    if b.is_type_alias { return true }
    if scope.struct_def_of_name(b.name, symbols).is_some() { return true }
    bfd_o := scope.lookup_func_name(b.name, symbols)
    if bfd_o.is_some() {
        // A BODYLESS FuncDef binding is a FuncSig type name; anything with
        // a body is a function VALUE. This is tested before is_builtin
        // because ext_func/core_func declarations (`vec`, `array`, `cast`,
        // ...) are builtins too, and reading one as a type token turned a
        // local named `vec` in a generic's value slot into a bogus type
        // application (#328).
        //
        // is_func_decl separates the two things that BOTH resolve to that
        // bodyless def: the signature's own declaration `ABin := func(a:
        // I64, b: I64) returns I64` (a type name), and any VALUE of that
        // type -- a param `f: ABin`, a local, a struct field -- which
        // carries the same def so calls through it resolve. Without it,
        // `gapply(f, 2, 5)` read the funcptr VALUE as a type argument and
        // died on "undefined type 'f'" instead of inferring T = ABin.
        return bfd_o.unwrap().children.len().eq(0).and(b.is_func_decl)
    }
    if b.is_builtin { return true }
    return false
}

// Issue #58 "Phase now": a top-level `name := func(T: Type, ...)` is a
// GENERIC function -- a func/proc whose param list has at least one
// `Type`-typed param. Unlike a macro it is CALLED DIRECTLY with the
// type-arg inline (`identity(I64, 42)`, `swap(I64, x, y)`); it is
// monomorphized per distinct type-arg tuple into a concrete copy, and
// each call is rewritten to that copy with the type-args dropped.
// Issue #328 moved it here from initer.til: initer, desugarer and typer
// all need ONE source-classification rule.
init_func_is_generic := func(rhs: Expr) returns Bool {
    switch rhs.node_type {
    case .FuncDef(fd):
        gok := fd.sig.func_type.is_plain()
        if gok.not() { return false }
        // A `P: Type` param is a generic TYPE-PARAMETER only if its name
        // is actually USED as a type elsewhere in the signature -- as
        // another param's declared type, or as the return type. A plain
        // `func(t: Type) returns Str` (where `t` is a runtime Type VALUE
        // never used to type anything, e.g. til_type_name_c) is NOT a
        // generic and must be left untouched.
        for p : Declaration in fd.sig.params {
            if p.type_name().eq("Type").not() { continue }
            tname := p.name
            // Directly (`v: T`, `returns T`), or as a SEGMENT of a
            // generated instance name: the parser mangles an annotation
            // `v: Vec(T)` to `Vec__T` before any expansion runs, and
            // init_subst_ident_name already rewrites that segment to the
            // concrete argument. Recognising it here is what makes such a
            // function a template at all -- without it `Vec__T` was just
            // an undefined type and `T` an unused parameter.
            if type_name_mentions_param(fd.sig.return_type, tname) { return true }
            for q : Declaration in fd.sig.params {
                if type_name_mentions_param(q.type_name(), tname) { return true }
            }
        }
        return false
    case:
        return false
    }
}

// Issue #328: is this top-level statement a direct-generic SOURCE
// template -- a `name := func(T: Type, ...)` decl whose body still names
// its unbound type parameters? Retained through typing, never typed or
// emitted itself.
init_stmt_is_generic_source := func(stmt: Expr) returns Bool {
    if stmt.node_type.is(NodeType.Decl).not() { return false }
    if stmt.children.len() == 0 { return false }
    return init_func_is_generic(stmt.children[0])
}

// Issue #328: does `name` mention the type parameter `pname` as a whole
// name SEGMENT? A generated instance name is `Base__Arg1_Arg2`, so the
// parameter shows up between underscores. A plain substring test would
// find `T` inside `BadThing328` and misread an ordinary error type as a
// type-dependent one.
type_name_mentions_param := func(name: Str, pname: Str) returns Bool {
    if pname.len() == 0 { return false }
    if name.eq(pname) { return true }
    segs := name.split("_")
    for sg : Str in segs {
        if sg.eq(pname) { return true }
    }
    return false
}

// Issue #328: does this generic source's `throws` clause name a type
// PARAMETER -- directly (`throws T`) or inside a generated instance name
// (`throws Err__T`)? Such a source cannot publish throw metadata under
// its source name: a caller's error outputs and result slots are built
// before inference resolves T, so they would name a type that does not
// exist yet. It stays an explicit-application-only generic. A STATIC
// throw type has no such problem and takes the ordinary path.
generic_source_throws_depend_on_type := func(rhs: Expr) returns Bool {
    switch rhs.node_type {
    case .FuncDef(fd):
        for p : Declaration in fd.sig.params {
            if p.type_name().eq("Type").not() { continue }
            for t : Str in fd.sig.throw_types {
                if type_name_mentions_param(t, p.name) { return true }
            }
        }
        return false
    case:
        return false
    }
}

// Issue #328: one RESOLVED generic-function source. The shared
// instantiation constructor takes this record plus the live FuncDef Expr
// and never reads Context.generic_funcs itself, so init-time explicit
// expansion and typer-time inferred expansion cannot drift apart.
// `path` is half the dedup key: two units' private generics that happen to
// share a name must not collapse onto one monomorphization.
GenericFuncSource := struct {
    // Source name as currently spelled in the owning scope: the raw name
    // during init (private mangling has not run yet), the already-mangled
    // one for a late typer resolution.
    name := ""
    path := ""
    is_priv := false
    // Stable source name for dedup. A late private source's `name` is
    // already mangled, while this keeps the original binding name seen by
    // init. Appended at the END so the committed boot's layout stays stable.
    identity_name := ""
namespace:
    eq := func(a: GenericFuncSource, b: GenericFuncSource) returns Bool {
        return a.name.eq(b.name).and(a.path.eq(b.path)).and(a.identity_name.eq(b.identity_name))
    }
    to_str := func(self: GenericFuncSource) returns Str {
        return format(self.path, ":", self.name)
    }
}

// Issue #147 helper: pick the FuncType for a func_def Expr. Empty
// (FuncType.Func) for non-FuncDef nodes such as FuncSig signatures
// stored at func-pointer locations -- callers don't distinguish those
// from regular funcs at the binding level.
func_def_type := func(fdef: Expr) returns shallow FuncType {
    switch fdef.node_type {
    case .FuncDef(fd):
        return fd.sig.func_type
    case:
    }
    return FuncType.Func
}

ImportUnit := struct {
    mode_str := ""
    mode := Mode()
    own ast := Expr.new(NodeType.Body, 0, 0)
    import_dir := ""
    import_lib_dir := ""
    // Mode auto-imports are the one dependency edge with no source AST call.
    mode_import := ""
}

priv import_path_for_call := func(imp: Expr, source_path: Str, symbols: SymbolPool) returns Str {
    if imp.node_type.is(NodeType.FCall).not().or(imp.children.len().lt(2)) { return "" }
    switch imp.children[0].node_type {
    case .Ident(id):
        if id.ident_name(symbols.names).eq("import").not() { return "" }
    case:
        return ""
    }
    switch imp.children[1].node_type {
    case .Literal(Literal.Str(p)):
        if p.ends_with(".til") {
            bare := p.strip_suffix(".til")
            loc := source_path.format(":", imp.line.to_str(), ":", imp.col.to_str())
            panic("import path must not end in '.til' (got \"", p,
                "\"); use import(\"", bare, "\") instead", loc = loc)
        }
        return format(p, ".til")
    case:
    }
    return ""
}

// Return the normalized path from a bare or declaration-RHS import call, or
// "" for a non-import statement. Explicit source paths omit the .til suffix.
import_path_for_stmt := func(stmt: Expr, source_path: Str, symbols: SymbolPool) returns Str {
    if stmt.node_type.is(NodeType.Decl) {
        if stmt.children.len() == 0 { return "" }
        return import_path_for_call(stmt.children[0], source_path, symbols)
    }
    return import_path_for_call(stmt, source_path, symbols)
}

// Resolve one AST import edge exactly as loader discovery did. A miss after
// loading is an internal graph invariant violation, not recoverable control
// flow: discovery already reported user-facing missing-file errors.
resolve_import_for_stmt := proc(stmt: Expr, source_path: Str, iu: ImportUnit,
        cwd: Str, imported: Map(Str, ImportUnit), symbols: SymbolPool) returns Str {
    import_path := import_path_for_stmt(stmt, source_path, symbols)
    if import_path.len() == 0 { return "" }
    abs := resolve_import_abs(import_path, iu.import_dir, iu.import_lib_dir)
    if abs.len() == 0 {
        panic(source_path, ": loaded import no longer resolves: ", import_path)
    }
    disp := display_path(abs, cwd)
    if imported.has(disp).not() {
        panic(source_path, ": resolved import is absent from Context.imported: ", disp)
    }
    return disp
}

BuilderFuncScratch := struct {
    // #178 first table: per-function-emission cache of FuncPtr local
    // signatures, populated by the builder when it emits a FuncPtr-typed
    // decl, read back when fcall_fn_sig needs to resolve a FuncPtr local
    // call. Currently swapped at emit_func_def boundaries to scope it
    // per emission. The eventual rstil-style direction is to populate
    // this from the typer (keyed by function name) so the builder reads
    // without a per-emit reset; this commit only moves the storage.
    local_fn_sigs := Map(Str, Dynamic).new()
    // #326: which names the CURRENT function body reads, and which it
    // declares more than once. emit_stmt_decl consults them so a
    // `_`-prefixed local gets its `(void)` cast only when the binding is
    // genuinely unread -- the escape hatch says a cast is ALLOWED there,
    // not that one is always needed, and 17k of them in boot/til.c sat
    // next to a read on the very next line. A name declared twice in one
    // body (sibling scopes) always gets the cast: this set is name-keyed,
    // so it cannot tell those two bindings apart.
    body_refs := Set(Sym).new()
    body_multi_decls := Set(Sym).new()
    stack_locals := Set(Sym).new()
    heap_locals := Set(Sym).new()
    stack_local_types := Map(Sym, Str).new()
    stack_lit_str_locals := Set(Sym).new()
    force_heap_stack_lit_str_own : Bool = false
    // #371: does the own argument being emitted travel as a caller-frame
    // slot? Decided by the CALLEE PARAMETER, never the argument: an I64
    // passed into an `own Dynamic` parameter (Array(Dynamic)) must still be
    // boxed, because adopt__Dynamic still frees it.
    own_arg_travels_by_slot : Bool = false
    unsafe_to_hoist := Set(Sym).new()
    ref_locals := Set(Sym).new()
    // #185: ref-locals declared as `ref X : Dynamic = ...`. Tracked
    // separately so emit_deref can typed-cast a Dynamic-declared
    // local when the typer's narrow_dynamic has retyped a use of it
    // to a concrete primitive (`not(x)`, `y.add(x)`, etc.). Without
    // the cast the codegen would emit `DEREF(x)` on a `void *`,
    // which is invalid C.
    ref_dyn_locals := Set(Sym).new()
    // #220: names of decls made inside the current function body. Inside a
    // function every `:=` decl is a local (is_global/is_rg are gated on
    // in_func_def.not()), but stack_locals/ref_locals only capture a subset
    // of emit paths -- own-heap pointer locals (`Type *m = malloc(...)`) and
    // Dynamic locals (`void *tmp = ...`) were untracked. A local that shadows
    // a script global of the same name then inherited the global's value
    // classification and codegen emitted `.`/`&`/value-return against a
    // pointer. Recorded for every in-function decl; consulted only by
    // is_value_global/is_ref_global so the effect is limited to the
    // global-vs-local decision.
    ptr_locals := Set(Sym).new()
    // #327: parameter names that a NESTED block currently re-binds. The
    // builder's ident queries match by name, so inside such a block
    // `is_value_param` would otherwise report the parameter's shape for
    // what is really the block's local -- a pointer local shadowing a
    // value parameter got `&w` (address of a pointer) instead of `w`.
    // emit_body adds a block's shadowing decls on entry and drops them on
    // exit, so the parameter's shape is restored once the block closes.
    // Same-scope re-binding cannot reach here: the typer rejects it.
    shadowed_params := Set(Sym).new()
    // Constructor-temp ordinal and active-body identity/shape. These are
    // reset or saved/restored with the rest of the current function's builder
    // scratch, including nested capturing-closure emission.
    ctor_seq : I32 = 0
    in_func_def := false
    in_main_func := false
    current_fdef := Option(ref Expr).None
}

// #246 step 4: interpreter dispatch and libffi state share one runtime
// lifetime. FFIEntry / ExprPtrBox / FFITypePtrBox are defined in
// interpreter.til and resolve here through whole-program type resolution.
// ffi_cleanup drains the owned C allocations before Context teardown, so the
// generated delete only sees empty containers after normal interpreter use.
FfiState := struct {
    dispatch_map := Map(Str, Dynamic).new()
    dispatch_inited := false
    entries := Map(Str, FFIEntry).new()
    entries_inited := false
    loaded := false
    struct_defs := Map(Str, ExprPtrBox).new()
    type_cache := Vec(FFITypePtrBox).new()
    type_cache_inited := false
}

// #286 follow-up: canonical heap Type blocks that HeapBinding.til_type
// borrows. A binding's type must outlive the binding, but neither
// TypeScope.bindings values (sorted-Vec Map: realloc/memmove on insert)
// nor Expr payload stamps (inline in children Vecs; constfold rewrites
// replace and delete subtrees) are address-stable for that long. Entries
// here are each their own allocation, never move, and are only freed at
// Context teardown -- which outlives every scope (eval scopes die during
// eval; eval.ns_fields and the session global drop before the Context does).
// Cells hold a Type* in a Dynamic word, the interp_type_defs pattern.

// Free the Type blocks a word-vec's non-null elements point at. The
// element WORD is read through a slot ref (loop element vars bind refs
// into the vec data, so freeing them directly would free interior
// pointers).
priv interned_vec_free_pointees := func(v: Vec(Dynamic)) {
    for i in 0..v.len() {
        ref slot : Dynamic = v.unsafe_get(i)
        ref pv : Dynamic = deref(slot)
        pointee : Dynamic = pv
        if pointee.is_null().not() { Type.delete(own to_ptr(pointee), true) }
    }
}

InternedTypes := struct {
    // Payload-less Type variants, indexed by intern_simple_index
    // (interpreter.til). Slots are NULL until first interned.
    simples := Vec(Dynamic).new()
    // Type.Primitive singletons, indexed by intern_prim_index.
    prims := Vec(Dynamic).new()
    structs := Map(Str, Dynamic).new()
    enums := Map(Str, Dynamic).new()
    customs := Map(Str, Dynamic).new()
    funcsigs := Map(Str, Dynamic).new()
namespace:
    // A cloned Context starts with a FRESH interner: entries are canonical
    // per Context and freed by its teardown, so bitwise-cloning the words
    // (the generated clone) would double free the shared blocks. Bindings
    // made before the clone keep borrowing the source Context's blocks;
    // the REPL retains the source program alongside its clones.
    clone := func(_self: InternedTypes) returns InternedTypes {
        return InternedTypes()
    }
    delete := func(own self: InternedTypes, call_free: Bool = true) {
        interned_vec_free_pointees(self.simples)
        interned_vec_free_pointees(self.prims)
        interned_vec_free_pointees(self.structs.values)
        interned_vec_free_pointees(self.enums.values)
        interned_vec_free_pointees(self.customs.values)
        interned_vec_free_pointees(self.funcsigs.values)
        free(own self.simples.data)
        free(own self.prims.data)
        own self.structs.delete(false)
        own self.enums.delete(false)
        own self.customs.delete(false)
        own self.funcsigs.delete(false)
        if call_free { free(own self) }
    }
}

EvalState := struct {
    has_return := false
    has_break := false
    has_continue := false
    // Non-owning pointer to the interpreter's current raw return allocation.
    // eval_user_func_call takes and clears it before Context teardown.
    // #321/#324: NOT an Option yet. context_return_take MOVES the pointer
    // out to a caller that owns it, and ownership cannot be transferred
    // out of a BORROWED payload -- `return result` off an unwrap is
    // rejected with "cannot return ref variable from non-ref function".
    // Same ownership question as the Scope-typed fields; #324 first.
    ref return_value : Dynamic = 0
    // True while the interpreter runs the body of a `returns ref`
    // function (saved/restored per call in eval_user_func_call).
    // return propagation and the call boundary consult it:
    // a ref return aliases storage that outlives the call (the typer
    // rejects ref returns of locals), so deep-cloning it would detach
    // the caller's ref from the real payload and lose writes.
    interp_ret_is_ref := false
    // Non-owning destination supplied by the current function's caller.
    ref interp_ret_dest : Dynamic = 0
    // #321: the current function's declared return type, borrowed from
    // its FuncDef. None outside a call (saved/restored around each one).
    interp_ret_type := Option(ref Str).None
    interp_ret_own_type := OwnType.Shallow
    // #343: one-shot "the field read about to happen feeds a C string
    // parameter". ext_dispatch_ffi sets it for exactly the arguments the
    // builder wraps in TIL_CSTR, and eval_expr_field_raw consumes it at
    // entry so nested evaluation (a call in the receiver) never inherits it.
    // A flag rather than a check inside `.c_str` itself: core/str.til reads
    // c_str on views constantly and legitimately (memcmp, substr, hash).
    interp_cstr_arg := false
    constfold_active := false
    // "Abandon this evaluation and unwind like an early return", checked by
    // eval_body / eval_while. Two producers, one meaning: a const-fold eval
    // that reached exit() (the fold is abandoned, the call is left for
    // runtime), and a REPL turn whose code panicked (the turn is abandoned,
    // the session survives). Set by h_exit, cleared by
    // interp_reset_control_flow and the constfolder's own consumers.
    eval_aborted := false
    // True while a REPL session interprets. Makes a failing exit() unwind
    // instead of terminating the process, so one panic does not end the
    // session. See h_exit.
    repl_session := false
    // #321/#324: the namespace-fields table, OWNED. It was `ref ... = NULL`
    // -- an owned pointer wearing a borrow label, freed through the #324
    // hole -- with a separate ns_inited Bool as a second source of truth
    // for "has it been built". The owned niche makes the honest spelling
    // free: one word, None IS the un-built state (subsuming ns_inited), and
    // teardown moves the scope out before scope_free instead of freeing
    // through a ref field.
    ns_fields := Option(Scope).None
    // #177 interpreter cache for the canonical Str type name, populated by
    // populate_cached_aggregate_defs / interpreter_init_ns and read by raw
    // allocation, field-layout, and argv construction paths. #321: now an
    // OWNED clone ("" = not yet registered), so raw-value teardown
    // (str_owns_c_str -> str_count_at -> ctx_field_layout) no longer reads
    // a borrow into the imported ASTs -- the #299 ordering hazard for this
    // field is gone. The five sibling caches (cached_str/array/vec_def,
    // cached_array/vec_name) were write-only and are removed.
    cached_str_name := ""
}

Context := struct {
    mode := Mode()
    path := ""
    path_modes := Map(Str, Mode).new()
    mode_registry := Map(Str, Mode).new()
    // The raw-bytes runtime heap (rstil's EvalHeap), threaded through Context
    // since Context already flows everywhere eval runs.
    eval_heap := EvalHeap.new()
    target_usize_pname := "U64"
    target_uptr_pname := "U64"
    // Target USize width in bytes, kept in lockstep with target_usize_pname
    // (context_register_target_int_alias_types). A SCALAR mirror of the pname
    // so the Str-ownership hot path (str_usize_read_width -> str_has_owned_
    // storage) can read the target width WITHOUT dereferencing an owned heap
    // Str: that path also runs during Context teardown, where the owned
    // target_usize_pname field is freed before the interned runtime tables whose
    // delete calls it -- reading it there is a heap-use-after-free (#309).
    target_usize_bytes : USize = 8
    anon_type_counter : I64 = 0
    // Issue #54: true when the program is headed for the C backend
    // (build/run/translate/install/test) rather than the interpreter.
    // Capturing closures currently run only under the interpreter, so the
    // typer rejects them in compile mode. Set by main() before the typer
    // runs (default false = interpret).
    compile_mode := false

    // Raw-owning runtime tables must delete before imported ASTs: aggregate
    // payloads carry type/layout refs into those ASTs.
    constfolder_foldables := Map(Str, FuncType).new()
    // #321/#324: the comptime-known scope, OWNED (see EvalState.ns_fields for
    // the pattern). None IS the between-resets state; the fold-nesting
    // save/restore moves the real scope out and parks an owned VIEW scope
    // (parented at the moved-out real one) in the field meanwhile.
    constfolder_known := Option(Scope).None
    constfolder_assigned := Set(Str).new()
    // Issue #70: deterministic file-scope template identity for recursively
    // reconstructed Array/Vec values. Reset with the rest of constfolder.
    precomputed_sequence_counter : USize = 0
    // Interpreter call/control/namespace state, grouped so Context no longer
    // exposes each evaluation-local flag, slot, and cache separately.
    eval := EvalState()

    // Import tracking (rstil-style). Explicit edges remain in each AST;
    // ImportUnit carries only the roots needed to resolve them again.
    imported := Map(Str, ImportUnit).new()
    import_cwd := ""
    // #154: unused-import check. The CLI enables it by default
    // (--check-unused-imports=false disables per invocation); the
    // Context default stays false so the REPL -- where an import is
    // legitimately typed before anything uses it -- never flags.
    // While it is on, the typer records one edge per cross-file symbol
    // read ("user_path|decl_path" in import_use_edges); the loader
    // consumes the edges after typing to flag imports that contributed
    // no used symbol.
    check_unused_imports := false
    import_use_edges := Set(Str).new()
    // Issue #271: init has two states now. Seeded means file-level
    // declarations are visible to break import cycles; done means the
    // full init pass completed. Active prevents recursive cycles from
    // re-entering a file while its imports are still being walked.
    imports_init_seed_done := Set(Str).new()
    imports_init_active := Set(Str).new()
    imports_init_done := Set(Str).new()
    // Multi-sweep typer (issue #174 / #338). The typer recursion is split
    // into pre-field method preparation, field inference, declaration work
    // (field-dependent methodgen/layout), and body type-checking. The field
    // sweep stamps every struct field before layout recursively inspects
    // sibling types. The declaration sweep produces all method-name
    // bindings before any body type-checks, so the Vec/Str/I64 method
    // cycle that #174 catalogues is broken: bodies in either
    // direction always see the other's methods. Each sweep has its own
    // per-file memo Set.
    imports_typer_methods_done := Set(Str).new()
    imports_typer_fields_done := Set(Str).new()
    imports_typer_decls_done := Set(Str).new()
    imports_typer_bodies_done := Set(Str).new()
    // Issues #380/#381: type_struct_fields infers on a clone, then the body
    // sweep validates the original default after generated methods exist.
    // Generated method names expose their fixed return type only during that
    // provisional inference; normal method lookup remains strict.
    infer_struct_fields_only := false
    // Issue #267: deterministic type-gen macro instantiations such as
    // `TemplVec__Bool` are shared across all initialized units. The first
    // unit that sees an inline `TemplVec(Bool)` owns the synthesized decl;
    // later units rewrite to the same name without emitting another type.
    type_gen_synths := Set(Str).new()

    // Issue #58 cross-unit direct generics: a `func(T: Type, ...)` generic
    // (e.g. core `assert_eq`) defined in one unit and CALLED from another is
    // monomorphized at the calling unit. generic_funcs records every public
    // generic funcdef at seed time (name -> generic FuncDef RHS), BEFORE each
    // unit's own expansion drops its local generic decls, so a calling unit
    // can find generics defined in imported units. generic_func_synths
    // dedupes the synthesized monomorphizations across units in one binary
    // (mirrors type_gen_synths): the first unit to need `assert_eq__I64`
    // emits the concrete decl; later units only rewrite their calls to it.
    generic_funcs := Map(Str, Expr).new()
    generic_func_synths := Set(Str).new()
    // Emitted monomorphization names parallel generic_func_synths' path-keyed
    // dedup registry. Binding generation needs to distinguish these internal
    // declarations from source API functions without parsing the dedup key.
    generic_func_synth_names := Set(Str).new()
    // #382: abstract type-generator declarations referenced by retained
    // direct generics. Init moves each discarded placeholder here under
    // `<declaring path>#<generated name>`; late inference substitutes the
    // concrete type arguments and queues the resulting type declaration
    // before the concrete function that uses it.
    generic_type_deps := Map(Str, Expr).new()
    // Issue #328: per-unit holder for the concrete declarations that late
    // (typer-time) generic inference synthesizes. A Decl OWNS its FuncDef
    // child, so the child address is only stable while it sits in this
    // holder -- the queue exists so a declaration can be registered and
    // typed WITHOUT being appended to the unit while nested inference
    // still holds refs into the statement being typed. The flush moves
    // every child at once (take_children) once infer_body_stmt has
    // returned to the top-level loop. Reset at type_check_unit entry and
    // asserted empty at unit exit.
    own generic_pending : Expr = Expr.new(NodeType.Body, 0, 0)
    // (#328's lambda_counter lived here; #101 replaced it with the
    // per-owner synth_symbol_seq below -- a late concrete body lifts under
    // its own unique mono name, so it cannot collide with the initial
    // sweep's symbols.)
    // #328 follow-up: per-unit holder for the DIRECT-generic twins the
    // typer synthesizes from all-Type-param function generators (the
    // macros #58's `func<T>` sugar desugars to), so their omitted type
    // arguments infer through the same path direct generics use. A twin
    // is registered into the scope by pointer, so it has to outlive the
    // call that built it -- this holder owns it for the unit. Reset
    // alongside generic_pending at type_check_unit entry.
    own func_gen_twins : Expr = Expr.new(NodeType.Body, 0, 0)
    // #328 follow-up: expected-type evidence for generic inference.
    // `v : Point = gdefault()` names T's answer in the ANNOTATION, which
    // argument evidence cannot see (gdefault has no value parameters).
    // infer_decl_stmt stores the resolved declared type name while the
    // RHS is inferred; generic_expected_for pins the exact RHS node so
    // only the OUTERMOST call reads it -- a generic nested deeper
    // (`wrap(gdefault())`) feeds wrap's parameter, not the annotation.
    // "" / null when no typed Decl is being inferred.
    generic_expected_type := ""
    ref generic_expected_for : Dynamic = 0

    scope := TypeScope()
    is_repl := false

    // Issue #147 step 3: struct/enum layouts keyed by type name. Populated
    // by record_struct_layout / record_enum_layout after compute_*_layout
    // fills the AST fields. Readers still use the AST fields for now; they
    // migrate to this map in step 4.
    struct_layouts := Map(Str, StructLayout).new()

    closure_emit_env := ""
    closure_emit_captures := Set(Sym).new()

    funcsig_names := Set(Sym).new()
    closure_value_names := Set(Sym).new()
    script_globals := Set(Sym).new()
    ref_globals := Set(Sym).new()

    // Issue #198: typer-owned error-type registries, moved off
    // module-level globals so they live on the same Context that
    // crosses unit boundaries. throw_type_registry is the integer-tag
    // table used by tag_for_type; throws_global is the Decl-name ->
    // throws-types map used by inject_throw_args_in_body. (Method
    // throws are keyed "Type.method", free functions stay bare.)
    throw_type_registry := Vec(Str).new()
    throws_global := Map(Str, Vec(Str)).new()

    // Issue #202: monotonically-increasing counter for `_bang_ret_<N>`
    // temps emitted when hoisting nested `f()!` calls. Lives on
    // ctx so the same Context that already threads the throws
    // registries also owns the matching temp counter.
    bang_counter : I64 = 0

    // Typer unique-name generators. Each counter mints a fresh
    // suffix for a different family of synthesised temps that the
    // typer emits during desugar/hoist passes: hoist_counter for
    // generic hoists (`hoisted__<T>_<N>`, `_wcond_Bool_<N>`,
    // `_sw_<T>_<N>`, ...), va_counter for variadic-Array packs
    // (`_va_Array_<N>`), kw_counter for keyword-arg DynMaps
    // (`_kw<N>`), coll_counter for vec/array literal hoists
    // (`_vec_<N>`, `_array_<N>`).
    //
    // Issue #101: every name these mint is a C LOCAL of the function
    // whose body is being typed, so the suffix only has to be unique
    // WITHIN that function. infer_func_def_expr saves them, zeroes
    // them, and restores them around each body -- so `hoisted__I64_3`
    // means "the fourth hoist in this function", not "the 3rd of
    // 108,000 in the program". Without the reset a one-line edit
    // renumbered every temp emitted after it, which is what made a
    // small source change produce a six-figure generated-C diff.
    // Statements OUTSIDE any function body (module-level initializers,
    // whose temps ARE file-scope C globals) keep using the outer
    // sequence, and the save/restore keeps that sequence independent
    // of whatever the function bodies did.
    hoist_counter : I32 = 0
    va_counter : I32 = 0
    kw_counter : I32 = 0
    coll_counter : I32 = 0

    // Issue #101: the top-level definition whose body the counters above
    // are currently numbering, or "" at module level. Every synthesised
    // name inside a definition carries it, so restarting the counters per
    // definition does NOT make two definitions share a name.
    //
    // The qualifier is not cosmetic. The compiler keeps side tables keyed
    // by bare identifier that outlive one body -- constfolder_known is the
    // one that bites -- so two functions that both hold a `hoisted__Str_0`
    // are the same entry there, and the constfolder starts folding one
    // function's call with another's value. That is what a first cut of
    // this change did: it made an unrelated call look foldable, walked
    // into `type_name_storage_kind`, read `ELEM_FN : USize = 2` out of the
    // interpreter scope as if the slot held an Expr pointer, and
    // segfaulted compiling the compiler.
    //
    // The value is the definition's already-unique program-level name: a
    // priv is mangled to `priv__<path>__<name>` by the initer before the
    // typer runs, a public free function must be unique to link, and a
    // namespace member uses `<Type>_<member>`, its own C symbol.
    synth_owner := ""

    // Issue #101: per-owner ordinals for FILE-SCOPE synthesized symbols
    // (`_lambda_<owner>_<n>`, `closure_<owner>_<n>`, `body_<owner>_<n>`).
    // Unlike the body temps above these become C symbols and `_env`
    // struct types, so they need program-unique names -- the owner
    // provides that -- while the per-owner ordinal keeps them stable
    // (editing one definition cannot renumber another's lambdas). A Map
    // rather than a save/reset window because the same owner can open
    // more than one window per Context: a REPL session redefining `f`
    // must not mint a second `_lambda_f_0` while the first is still
    // registered. Keys are owner tags ("g" for module level); mint order
    // follows the AST walk, so a fresh Context reproduces the same names.
    synth_symbol_seq := Map(Str, I64).new()

    // Issue #101: loader counter for the `_lzr_<N>` result temp that
    // lazy_build_prelude mints when statement-inlining a lazy body
    // (#262). It used to be a module global in loader.til, so a second
    // LoadedProgram built in the same process kept counting from the
    // first program's last name -- the last generated-name state leak
    // outside Context. Minted by the loader's lazy pass, which runs
    // before the typer's windows, so lazy_stmt_inline_walk opens its own
    // synth_owner window per top-level definition: inside one the counter
    // restarts and the temp is the bare per-definition `_lzr_<n>` (a C
    // local); module-level mints keep this outer sequence with the same
    // `g` marker as the other module-level temps.
    lazy_stmt_temp_counter : I64 = 0

    // Per-unit type-error counter, reset and returned by type_check_unit.
    // Function/type scratch lives on TypeScope; typer_path was always ctx.path.
    errors : I32 = 0
    // #187: "the function <key> references these priv names". A reference
    // made from inside a function proves nothing on its own -- the
    // referrer may itself be dead -- so those references are recorded
    // here instead of setting `used`, and check_unused_priv_top_level
    // propagates usedness from the real roots along these edges. Without
    // it a dead cycle (ping calls pong, pong calls ping, nobody calls
    // either) marked both used and survived forever. Typer-transient,
    // like the fields above.
    priv_ref_edges := Map(Str, Vec(Str)).new()

    // #178 builder per-function transients. The builder resets this on
    // entering each function body and reads it throughout that body's
    // emission. emit_func_def is not actually recursive (the typer lifts
    // nested funcs to top level), so a per-emit reset is sufficient.
    builder_func := BuilderFuncScratch()
    builder_str_lit_symbols := HashMap(Str, Str).new()
    builder_str_lit_values := Vec(Str).new()
    builder_str_lit_ident_symbols := HashMap(Str, Str).new()
    // #101: pool registration state, two-phase. The walk RECORDS how many
    // times each literal occurs (and the hoisted-ident -> content pairs);
    // builder_finalize_str_lit_pool then pools ONLY the literals used
    // MORE THAN ONCE, laid out in content-sorted order, and fills the
    // symbol maps the emitters read. A single-use literal gets no symbol
    // at all: every emitter already falls back to a per-site inline
    // form for an unpooled literal, which has no index and so cannot be
    // renumbered by any other edit -- rstil's model, which is what made
    // its generated C diffs local. See the finalize comment for why the
    // dense-index alternatives all failed.
    builder_str_lit_counts := HashMap(Str, USize).new()
    builder_str_lit_ident_contents := HashMap(Str, Str).new()
    // #101: the pooled literals' struct-field names (parallel to
    // builder_str_lit_values) and the collision counter behind them. The
    // pool is a struct with content-hash-named FIELDS, not an array: an
    // array index is dense, so promoting one new literal into the pool
    // renumbered every content-later reference in the program; a field
    // name derives from the literal's own bytes and moves for nothing
    // else.
    builder_str_lit_members := Vec(Str).new()
    builder_str_lit_member_seq := HashMap(Str, USize).new()
    // #326: which dyn/reflection builtins the SURVIVING AST actually names.
    // Filled once per emission (builder_collect_reflect_inventory) and read
    // by the gates on the generated dyn dispatch table, its per-method
    // wrappers/closure values, and the struct/enum/FuncSig reflection
    // families -- all of which used to be emitted unconditionally.
    builder_reflect_inventory := Set(Str).new()
    // #326: the `Type.method` pairs dyn_fn can actually ask for -- an exact
    // pair for `dyn_fn("T", "m")`, or `*.m` when the type name is a runtime
    // expression (interface dispatch, DynVec/DynMap element handling). The
    // per-method `_dyn` wrapper and closure value exist only to fill
    // dyn_fn's dispatch table, so this is what decides which ones are
    // emitted; without it every surviving namespace method got one.
    builder_dyn_fn_targets := Set(Str).new()
    // #326: every `Type.member` pair some surviving expression NAMES in a
    // field access, keyed exactly the way the namespace-call emitter names
    // the C function -- til_type_name of the RECEIVER, which is what turns
    // `Option(ref OptSrc).Some(x)` into `Option__ref_OptSrc_Some(x)`.
    // Two gates read it, because both families are emitted from a list that
    // is NOT the call graph: variant constructors come from `edd.variants`
    // (which must keep every variant, it defines the tag ABI), and the
    // auto-generated `size` method comes from the ns index whether or not
    // any call to it survived the constfolder.
    builder_ns_member_sites := Set(Str).new()
    // #326: element types of array()/vec() builtin literals. The raw-C
    // `array_of_<E>` / `vec_of_<E>` helpers clone and delete their elements
    // by direct call, outside any AST walk, so a POD lifecycle gate must
    // stand down for these types.
    builder_collection_elem_types := Set(Str).new()
    // #326: every struct/enum type name the emitted C will MENTION -- in a
    // kept signature, a kept body's expression types, an emitted struct's
    // field layout (transitively), or a reflection stub's sizeof arms. The
    // typedef emitters gate on it: a definition the scavenger correctly
    // kept in the AST (the type is named by til code) can still be a
    // typedef no emitted C spells out, because its every value position
    // lowered away (Dynamic -> void*) or every function referencing it was
    // omitted (an unused vendor binding struct).
    builder_used_ctypes := Set(Str).new()
    // #326: core top-level functions the emit gates drop -- every call
    // site they had sits inside a definition that is itself omitted. Read
    // by the definition pass, the forward-declaration pass and the
    // string-literal registrar, so all three agree on what exists.
    builder_omitted_core_funcs := Set(Str).new()
    // #326: what emit_func_forward_decl has already written in THIS
    // emission (the .c, or either header -- each resets it). An enum's
    // auto-generated `eq` and its variant constructors are ordinary
    // namespace members with FuncDef bodies, so the member walk declares
    // them, and the enum-auto-helper block that follows declared them a
    // second time: 105 duplicate prototypes across the corpus, 38 in
    // test/enums.til alone. Recording what was written beats re-deriving
    // which members the walk skipped -- its four loops do not all skip the
    // same things, and a mirror of them would drift.
    builder_forward_declared := Set(Str).new()
    // #326: memo for builder_delete_type_free_only, keyed by type name.
    // The answer is a property of the type's `delete` body, asked once per
    // delete SITE otherwise -- and the site inventory asks it again on
    // every fixpoint round. Each miss costs a Str allocation for the
    // `<T>_delete` key plus a scope-chain lookup; the corpus has ~20k
    // delete sites and a few dozen distinct types.
    builder_free_only_delete := Map(Str, Bool).new()
    // #326: true while emitting the monolithic .c of a CLOSED WORLD -- a
    // program (not a library), with no link_c handing the C to a stranger.
    // Its til functions are emitted `static`, which is what lets the C
    // compiler's -Wunused-function enforce this issue's invariant on every
    // build instead of a periodic survey. Headers set it false: a static
    // declaration in another translation unit's header declares nothing.
    builder_static_ok := false
    // Closed-world ordinary callables may pass owned values directly in C.
    // Libraries, declaration-only output, link_c consumers, bodyless C
    // declarations, and generated lifecycle helpers retain pointer parameters.
    param_value_abi_ok := false
    // #326: library output keeps its exported ABI whether or not anything
    // internal uses it, so the two site-driven gates above stand down there
    // -- a consumer can call any exported constructor or `size`, and no
    // walk of THIS program can see that call.
    builder_keep_all_exports := false
    // #90: a library's generated C identifiers are rewritten through one
    // deterministic per-library namespace. The forward header owns the map;
    // the .c emitter and public-header emitter consume this same ordered list.
    builder_lib_c_prefix := ""
    builder_lib_c_names := Vec(Str).new()
    // ext.c is shared by every library built by one exact compiler ABI. Its
    // names use this versioned prefix; generated and link_c names stay local.
    builder_runtime_c_prefix := ""
    builder_runtime_c_names := Set(Str).new()
    // #326: does any emitted statement write a Str THROUGH a pointer? Only
    // those three shapes call TIL_LIT_GUARD, and the pool -- with its
    // `#define` -- is emitted long before any body, so the answer has to
    // come from the AST rather than from what the bodies turned out to
    // write. Over-answering costs one dead `#define` (what this replaces);
    // under-answering is an undefined-macro build error, so the collector
    // takes the conservative side on every shape it is unsure of.
    builder_lit_guard_used := false
    // #326: does any surviving call pass a Str where an ext C function
    // wants a `char *`? Only then does the emitter write TIL_CSTR, and
    // only then is its #define anything but a dead line -- it was
    // unconditional, dead in 139 of the corpus's 140 generated files.
    builder_cstr_used := false
    // #326: does anything in the emitted C spell `TilClosure`? It is the C
    // type of every FuncPtr / FuncPtrSig / Body value, plus the closure
    // values themselves -- and its 8-line definition went into every
    // program, unused in 124 of the corpus's 152 generated files.
    builder_closure_rt_used := false
    // #326: is this program a closed world (a program, not a library,
    // with no link_c)? builder_static_ok says "we are emitting the .c of
    // one"; this stays true while the HEADERS are written, which is how
    // they know a symbol they would declare is going to be static -- and
    // therefore not something any other translation unit can call.
    builder_prog_closed_world := false
    // Interpreter type-def registry: maps every struct/enum name to its
    // AST def Expr. Populated by interpreter_init_ns, read via
    // lookup_interp_type_def. This is the rstil-style "external type
    // map" that lets struct/enum values carry only a heap pointer +
    // type name and recover their layout by name lookup. Stored as
    // Map(Str, Dynamic) of malloc'd cells holding the Expr pointer
    // (same encoding as TypeScope.struct_defs / TypeScope.func_defs) so the field type
    // stays in scope at the Context definition in this file.
    interp_type_defs := Map(Str, Dynamic).new()

    // #286 follow-up: canonical Type storage backing HeapBinding.til_type
    // borrows (see InternedTypes above; interp_intern_type in
    // interpreter.til is the only writer).
    interned_types := InternedTypes()

    // Interpreter-only dispatch/libffi runtime state, grouped so Context no
    // longer exposes each phase-local table and lifecycle flag separately.
    ffi := FfiState()

    // Source applications for synthesized type-generator declarations.
    // The generated-library binding uses these canonicalized calls to expose
    // Array(T), Vec(T), Map(K, V), Set(T), and Option(T) instead of leaking
    // their library-private physical struct names.
    type_gen_binding_sources := Map(Str, Expr).new()

    // Source-level external-global name -> exact C symbol. Built immediately
    // before C emission from Declaration.external_symbol; not persistent.
    builder_external_globals := Map(Str, Str).new()

    // Kept last so every Context-owned AST/registry using symbols is deleted
    // before the canonical name table that gives those symbols meaning.
    symbols := SymbolPool()
}

generic_type_dep_key := func(path: Str, name: Str) returns Str {
    return format(path, "#", name)
}

generic_type_dep := func(ctx: Context, path: Str, name: Str) returns Option(ref Expr) {
    key := generic_type_dep_key(path, name)
    ref dep : Expr = ctx.generic_type_deps.get(key)?
    catch (e: KeyNotFound) { return Option(ref Expr).None }
    return safe_ref(dep)
}

// Issue #101: the trailing part of a synthesised temp name. Inside a
// top-level definition it is `<owner>_<n>` with the counters restarted per
// definition, so `n` says "the n-th temp of THIS function" and editing one
// function cannot renumber another's. At module level (owner "") the temp
// is a file-scope C global drawn from the outer, never-restarted sequence,
// which stays a whole-program ordinal. Takes the already-stringified
// counter so one helper serves the I32 and I64 counters alike.
// A body temp is a C LOCAL: it only has to be unique inside its own
// function, and the per-definition ordinal already is, so the emitted
// suffix is the bare 1-2 digit ordinal -- SHORTER than the 4-5 digit
// whole-program ordinals it replaced. A module-level temp is a file-scope
// C GLOBAL drawn from the outer, never-restarted sequence; its `g` marks
// it so the two name spaces can never overlap (a body's `hoisted__U32_3`
// versus the globals' `hoisted__U32_g3`).
//
// Bare per-body ordinals are only sound because nothing PROGRAM-wide is
// keyed by a bare temp name. Two tables used to be, and both had to be
// dealt with before this function could drop the owner qualifier:
// ctx.builder_str_lit_ident_symbols still is context-wide, so the one
// family it keys on (`hoisted__Str_<N>`) takes synth_suffix_unique below;
// and the constfolder's known table leaked namespace-member body locals
// program-wide until fold_body_scoped closed that hole (one body's temp
// matched another's tracked literal and I64_to_str's
// `format("-", U64_to_str(mag))` folded to a constant).
synth_suffix := func(ctx: Context, n: Str) returns Str {
    if ctx.synth_owner.len() == 0 { return format("g", n) }
    return n.clone()
}

// The owner-qualified variant, for the ONE family whose name is a key in a
// context-wide table: `hoisted__Str_<N>` names become keys in
// ctx.builder_str_lit_ident_symbols, the whole-program map from a pooled
// literal's temp to its `_til_str_lits[i]` element
// (builder_register_str_lits_for_expr: "the ident map is context-wide, and
// an ordinary name can mean something else in a sibling body"). Two
// functions sharing a `hoisted__Str_0` there make one body's temp resolve
// to the other's literal -- `return _til_str_lits[22];` out of a
// Str*-returning function. ~5% of synthesized temps are Str hoists, so
// carrying the owner on just these costs ~0.2MB where carrying it on all
// of them cost 6MB. If a new context-wide table is ever keyed by a
// synthesized name, its family moves to this function too.
synth_suffix_unique := func(ctx: Context, n: Str) returns Str {
    if ctx.synth_owner.len() == 0 { return format("g", n) }
    return format(ctx.synth_owner, "_", n)
}

// Issue #101: the owner tag for a definition in the unit at `path`. The
// definition's own name is already unique program-wide -- a priv arrives
// here mangled to `priv__<path>__<name>` -- but that mangling is ~30
// characters of path boilerplate, and the owner is repeated in EVERY temp
// the definition mints: spelling it out cost 8.7MB of generated C. So
// privs are named `<unit>_<orig_name>` instead, where <unit> is the path
// with the `src/` prefix, the `.til` suffix and the separators removed
// (`src/self/loader.til` -> `self_loader`). That is an injective encoding
// of the path, so it discriminates units exactly as the mangling did, at
// a third of the length. Non-privs keep their own name, which has to be
// unique already or the C would not link.
synth_owner_name := func(path: Str, name: Str, orig_name: Str) returns Str {
    if orig_name.len() == 0 { return name.clone() }
    mut tag := path.clone()
    if tag.starts_with("./") { tag = tag.strip_prefix("./").clone() }
    if tag.starts_with("src/") { tag = tag.strip_prefix("src/").clone() }
    if tag.ends_with(".til") { tag = tag.strip_suffix(".til").clone() }
    return format(tag.replace("/", "_"), "_", orig_name)
}

// Issue #101: the full suffix for a FILE-SCOPE synthesized symbol
// (`_lambda_`, `closure_`, `body_`): `<owner>_<n>` where n is that owner's
// own ordinal from ctx.synth_symbol_seq. The owner makes the symbol
// program-unique (it becomes a C function and an `_env` struct type); the
// per-owner ordinal makes it stable, so editing one definition cannot
// renumber another's lambdas. See the field comment for why this is a Map
// and not a save/reset window.
synth_symbol_suffix := func(mut ctx: Context) returns Str {
    mut tag := ctx.synth_owner.clone()
    if tag.len() == 0 { tag = "g" }
    mut n : I64 = 0
    if ctx.synth_symbol_seq.has(tag) { n = ctx.synth_symbol_seq[tag] }
    ctx.synth_symbol_seq.set(tag, own n.add(1))
    return format(tag, "_", n.to_str())
}

// --- Helpers moved from initer.til ---

context_register_target_int_alias_types := func(mut ctx: Context, usize_name: Str, uptr_name: Str) {
    ctx.target_usize_pname = usize_name.clone()
    ctx.target_uptr_pname = uptr_name.clone()
    ctx.target_usize_bytes = unsigned_prim_width_for_name(usize_name)
    ctx.scope.target_usize_pname = usize_name.clone()
    ctx.scope.target_uptr_pname = uptr_name.clone()
}

context_reset_type_scope := func(mut ctx: Context) {
    ctx.scope = TypeScope()
    ctx.scope.target_usize_pname = ctx.target_usize_pname.clone()
    ctx.scope.target_uptr_pname = ctx.target_uptr_pname.clone()
}

// #154: record that the file currently being typed (ctx.path) read a
// symbol declared in decl_path. Gated on the --check-unused-imports
// flag so default builds pay one branch; check_unused_imports_collected
// in loader.til consumes the edges once the typer sweeps finish.
note_cross_file_use := func(mut ctx: Context, decl_path: Str) {
    if ctx.check_unused_imports.not() { return }
    if decl_path.len() == 0 { return }
    if decl_path == ctx.path { return }
    ctx.import_use_edges.add(own format(ctx.path, "|", decl_path))
}

// #154: same, keyed by a type name (constructor calls, method-call and
// field-access receivers): the use edge points at the file declaring
// the type.
note_cross_file_type_use := func(scope: TypeScope, mut ctx: Context, type_name: Str) {
    if ctx.check_unused_imports.not() { return }
    if type_name.len() == 0 { return }
    b_o := scope.get_binding_name(type_name, ctx.symbols)
    if b_o.is_none() { return }
    ref b : TypeBinding = b_o.unwrap()
    note_cross_file_use(ctx, b.path)
}

scope_target_usize_pname := func(scope: TypeScope) returns ref Str {
    switch scope.parent {
    case .Some(p): return scope_target_usize_pname(p)
    case .None:
    }
    return scope.target_usize_pname
}

scope_target_uptr_pname := func(scope: TypeScope) returns ref Str {
    switch scope.parent {
    case .Some(p): return scope_target_uptr_pname(p)
    case .None:
    }
    return scope.target_uptr_pname
}

priv_c_name := func(path: Str, name: Str) returns Str {
    mut buf := Str.with_capacity(path.len().add(name.len()) + 16)
    buf.push_str("priv__")
    mut last_was_underscore := false
    mut i : USize = 0
    while i < path.len() {
        ref c : I8 = path.unsafe_get(i)
        is_alnum := c.gte('a').and(c.lte('z'))
            .or(c.gte('A').and(c.lte('Z')))
            .or(c.gte('0').and(c.lte('9')))
        if is_alnum {
            buf.push_str(path.substr(i, 1))
            last_was_underscore = false
        } else {
            if last_was_underscore.not() {
                buf.push_str("_")
                last_was_underscore = true
            }
        }
        i++
    }
    buf.push_str("__")
    buf.push_str(name)
    return buf
}

align_up := func(offset: USize, align: USize) returns USize {
    return offset.add(align).sub(1).band(align.sub(1).bnot())
}

// Iterable compiler-only names for emitters that must generate one arm per
// scalar. Keep these outside core: global arrays in core add initialization to
// ordinary user programs. Membership tests use is_scalar_type_name instead.
// The fixed-width names are ext.h typedefs; USize/UPtr are per-build aliases.
PRIM_NAMES := array(Str, "I8", "U8", "I16", "U16", "I32", "U32",
                    "I64", "U64", "F32", "F64", "Bool")
WIDTH_ALIAS_NAMES := array(Str, "USize", "UPtr")

// The name a RESOLVED type is spelled with, primitives included --
// til_type_name only carries the struct/enum/custom payload and returns ""
// for a Type.Primitive. #326's third consumer wants the concrete answer
// rather than a source spelling: a generic body monomorphized on `T` emits
// `<this name>_<method>`, and the source ident at the call site may be an
// alias the typer already resolved (or one the file shadows).
resolved_type_name := func(t: Type) returns Str {
    name := til_type_name(t)
    if name.len() > 0 { return name }
    switch t {
    case .Primitive(Primitive.I8): return "I8"
    case .Primitive(Primitive.U8): return "U8"
    case .Primitive(Primitive.I16): return "I16"
    case .Primitive(Primitive.U16): return "U16"
    case .Primitive(Primitive.I32): return "I32"
    case .Primitive(Primitive.U32): return "U32"
    case .Primitive(Primitive.I64): return "I64"
    case .Primitive(Primitive.U64): return "U64"
    case .Primitive(Primitive.F32): return "F32"
    case .Primitive(Primitive.F64): return "F64"
    case .Primitive(Primitive.Bool): return "Bool"
    case: return ""
    }
}

// Single authorities for unsigned primitive width <-> name. USize and UPtr
// are INTERFACES whose concrete width is per-build (target pointer width,
// the --usize flag, and whatever future architectures bring -- U16? U128?).
// Nothing outside these two functions may enumerate their possible widths;
// callers derive the width from USize.size()/UPtr.size() or the resolved
// alias name and map through here. Extend HERE when a new width exists;
// unknown widths panic -- never a silent default.
// Literal case labels, not U8.size()/U16.size()/...: only literal labels
// keep the switch a real C switch (#254 -- a folded call as a label falls
// back to an if-else chain). Spelling the byte counts out is not the kind of
// hardcoding USize/UPtr forbid: U8/U16/U32/U64 are FIXED-width by name on
// every target, so 1/2/4/8 are definitional. What must never be assumed is
// which of them USize or UPtr resolves to.
unsigned_prim_name_for_width := func(w: USize) returns Str {
    switch w {
    case 1: return "U8"
    case 2: return "U16"
    case 4: return "U32"
    case 8: return "U64"
    }
    panic("unsigned_prim_name_for_width: no unsigned primitive is ", w.to_str(), " bytes wide")
    return ""
}

// The reverse direction reads as a table too. A Str switch is not a C
// switch (#278 -- it lowers to the same Str_eq chain the ifs did), so this
// is for symmetry with the width->name switch above, not for speed; #278
// is what would make it faster. Case labels here are the type NAMES, so
// the widths stay derived from .size() rather than spelled out.
unsigned_prim_width_for_name := func(name: Str) returns USize {
    switch name {
    case "U8":  return U8.size()
    case "U16": return U16.size()
    case "U32": return U32.size()
    case "U64": return U64.size()
    }
    panic("unsigned_prim_width_for_name: '", name, "' is not an unsigned integer primitive")
    return 0
}

// The RUNNING compiler's own USize/UPtr primitive names: USize.size() /
// UPtr.size() resolve when the compiler itself is built, so these are the
// host widths -- what the interpreter's layouts of host memory must use.
host_usize_pname := func() returns Str { return unsigned_prim_name_for_width(USize.size()) }
host_uptr_pname := func() returns Str { return unsigned_prim_name_for_width(UPtr.size()) }

// The interpreter's flat enum format: tag at offset 0 (its real 1/2/4/8-byte
// width), payload at this fixed offset. Single source of truth for the
// interpreter/constfolder payload accesses AND compute_enum_layout's enum
// sizing, so the two can't drift apart. Invariants that make the fixed
// offset valid:
// - It must be >= the widest allowed tag (enum(U64) -> 8, see #264), so the
//   payload never overlaps the tag.
// - Host C enum structs place `data` at this same offset because
//   emit_enum_struct_body pins the payload union to pointer alignment (the
//   void* sentinel): align_up(tag <= 8, 8) == 8 on the 64-bit host. That
//   agreement is what lets raw enum buffers cross between the interpreter
//   and compiled host code (dyn dispatch). Emitted TARGET code never uses
//   this constant -- it reads/writes payloads via offsetof(E, data) (#311),
//   which is what makes narrower layouts (e.g. 32-bit targets) correct.
ENUM_PAYLOAD_OFFSET : USize = 8

// Issue #309: type-size intrinsics (`X.size()`, `dyn_size_of`) normally fold
// to a compile-time literal taken from the HOST struct layout
// (ctx.struct_layouts, which the compile-time interpreter needs at host
// width). That literal is baked into the emitted C, so when the TARGET
// container width differs from the host's -- `--usize=32` on a 64-bit host,
// or any narrower cross-compile target (wasm32, linux-x86, ...) -- the baked
// size disagrees with the actual emitted struct (whose USize/UPtr fields
// follow ext.h's typedef). This returns true exactly in that mismatch case;
// callers then leave the size intrinsic unfolded so the emitted `X_size()` /
// `dyn_size_of()` return C `sizeof(...)` (target width). Native builds
// (host == target) return false and keep folding, so codegen is unchanged.
size_intrinsics_use_sizeof := func(ctx: Context) returns Bool {
    host_usize := host_usize_pname()
    host_uptr := host_uptr_pname()
    return ctx.target_usize_pname.eq(host_usize).not().or(ctx.target_uptr_pname.eq(host_uptr).not())
}

constfolder_classify_stmt := func(stmt: Expr, mut ctx: Context) {
    if stmt.node_type.is(NodeType.Decl).and(stmt.children.len().gt(0)).not() { return }
    switch stmt.children[0].node_type {
    case .FuncDef(fd):
        switch stmt.node_type {
        case .Decl(dd):
            if dd.name.eq("dyn_size_of").and(size_intrinsics_use_sizeof(ctx)) {
                // Issue #309: leave dyn_size_of unfolded on a width-mismatched
                // target so a constant-arg call reaches the runtime
                // dyn_size_of() (sizeof, target width) instead of folding to a
                // host-width literal.
            } else if fd.sig.func_type.is(FuncType.Macro) {
                ctx.constfolder_foldables.set(dd.name, own FuncType.Macro)
            } else if fd.sig.func_type.is(FuncType.Func)
                .or(fd.sig.func_type.is(FuncType.ExtFunc)).or(fd.sig.func_type.is(FuncType.CoreFunc)) {
                ctx.constfolder_foldables.set(dd.name, own fd.sig.func_type.clone())
            }
        case:
        }
    case .StructDef(sdd_data):
        switch stmt.node_type {
        case .Decl(sdd):
            mut mi : USize = 0
            for fdd : Declaration in sdd_data.ns_decls {
                ref mname : Str = sdd_data.member_name_at(mi)
                mi = mi + 1
                if fdd.default_value.is_none() { continue }
                switch fdd.default_expr().node_type {
                case .FuncDef(ffd):
                    if mname.eq("size").and(ffd.auto_generated).and(size_intrinsics_use_sizeof(ctx)) {
                        // Issue #309: skip the auto-generated size method on a
                        // width-mismatched target so the emitted X_size()
                        // returns sizeof(ctype) (target width).
                    } else {
                        qname := sdd.name.concat3("_", mname)
                        if ffd.sig.func_type.is(FuncType.Macro) {
                            ctx.constfolder_foldables.set(qname, own FuncType.Macro)
                        } else if ffd.sig.func_type.is(FuncType.Func)
                            .or(ffd.sig.func_type.is(FuncType.ExtFunc)).or(ffd.sig.func_type.is(FuncType.CoreFunc)) {
                            ctx.constfolder_foldables.set(qname, own ffd.sig.func_type.clone())
                        }
                    }
                case:
                }
            }
        case:
        }
    case .EnumDef(pc_edd):
        switch stmt.node_type {
        case .Decl(sdd):
            mut mi : USize = 0
            for nsd : Declaration in pc_edd.ns_decls {
                ref mname : Str = pc_edd.member_name_at(mi)
                mi = mi + 1
                if nsd.default_value.is_none() { continue }
                switch nsd.default_expr().node_type {
                case .FuncDef(ffd):
                    if mname.eq("size").and(ffd.auto_generated).and(size_intrinsics_use_sizeof(ctx)) {
                        // Issue #309: skip the auto-generated enum size method on
                        // a width-mismatched target (emitted X_size() -> sizeof).
                    } else {
                        qname := sdd.name.concat3("_", mname)
                        if ffd.sig.func_type.is(FuncType.Macro) {
                            ctx.constfolder_foldables.set(qname, own FuncType.Macro)
                        } else if ffd.sig.func_type.is(FuncType.Func)
                            .or(ffd.sig.func_type.is(FuncType.ExtFunc)).or(ffd.sig.func_type.is(FuncType.CoreFunc)) {
                            ctx.constfolder_foldables.set(qname, own ffd.sig.func_type.clone())
                        }
                    }
                case:
                }
            }
        case:
        }
    case:
    }
}

make_method_call_fcall := func(own recv: Expr, method: Str, line: U32, col: U32, mut symbols: SymbolPool) returns Expr {
    mut acc := Expr.new(field_access_node(symbols.intern(method)), line, col)
    acc.add_child(own recv)
    mut call := Expr.new(NodeType.FCall(FCallData()), line, col)
    call.add_child(own acc)
    return call
}

make_get_payload_fcall := func(own arg: Expr, shallow payload_type: Type, line: U32, col: U32, mut symbols: SymbolPool) returns Expr {
    mut gp := Expr.new(ident_node(symbols.intern("get_payload")), line, col)
    mut gc := Expr.new(NodeType.FCall(FCallData()), line, col)
    gc.add_child(own gp)
    mark_fcall_direct(gc)
    gc.add_child(own arg)
    gc.set_til_type(payload_type)
    return gc
}

// #264: the tag comparison primitive -- `is_n(a, b, size)`, where size is the
// tag width from enum_tag_size(enum_def). The interpreter FFIs is_n and reads
// exactly `size` bytes; the C backend inlines it to a width-correct
// ((E*)a)->tag == ((E*)b)->tag compare (see builder.til). The old 4-byte-only
// `is` builtin was folded into this -- is_n's typed tag read handles any width.
make_is_tag_check_fcall := func(arg_name: Str, ename: Str, vname: Str, tag_size: USize, line: U32, col: U32, mut symbols: SymbolPool) returns Expr {
    mut iv := Expr.new(ident_node(symbols.intern("is_n")), line, col)
    mut arg_id := Expr.new(ident_node(symbols.intern(arg_name)), line, col)
    mut et := Expr.new(ident_node(symbols.intern(ename)), line, col)
    mut vr := Expr.new(field_access_node(symbols.intern(vname)), line, col)
    vr.add_child(own et)
    mut is_call := Expr.new(NodeType.FCall(FCallData()), line, col)
    is_call.add_child(own iv)
    mark_fcall_direct(is_call)
    is_call.add_child(own arg_id)
    is_call.add_child(own vr)
    mut sz_lit := Expr.new(literal_num_node(tag_size.to_str()), line, col)
    is_call.add_child(own sz_lit)
    return is_call
}

make_payload_ref_decl := func(own arg: Expr, bind_name: Str, vtype: Str, line: U32, col: U32, is_mut: Bool, mut symbols: SymbolPool, is_ref_payload: Bool = false, used: Bool = false) returns Expr {
    mut gc := make_get_payload_fcall(own arg, declaration_type_from_name(vtype), line, col, symbols)
    mut decl := Expr.new(NodeType.Decl(decl_typed(name = bind_name, type_name = vtype, own_type = OwnType.Ref, is_mut = is_mut, used = used)), line, col)
    // REM: gc must be consumed in BOTH branches of a symmetric if/else --
    // an if-with-return plus fall-through consumption is a two-site
    // conditional transfer the garbager miscompiles (double free, found
    // the hard way building this very function).
    if is_ref_payload {
        // #320: a ref payload's slot holds a bare pointer to the borrowed
        // source, so the binding must LOAD the slot, not alias it: wrap in
        // deref(...) (a ref-returning ext_func both backends already
        // handle). Pre-typed to the payload type like get_payload itself.
        mut dv := Expr.new(ident_node(symbols.intern("deref")), line, col)
        mut dc := Expr.new(NodeType.FCall(FCallData()), line, col)
        dc.add_child(own dv)
        dc.add_child(own gc)
        dc.set_til_type(declaration_type_from_name(vtype))
        decl.add_child(own dc)
    } else {
        decl.add_child(own gc)
    }
    return decl
}

// True when `name` occurs as an Ident anywhere in `e`.
priv expr_contains_ident_named := func(e: Expr, name: Str, symbols: SymbolPool) returns Bool {
    switch e.node_type {
    case .Ident(idn):
        if idn.ident_name(symbols.names) == name { return true }
    case:
    }
    for c : Expr in e.children {
        if expr_contains_ident_named(c, name, symbols) { return true }
    }
    return false
}

// Build the case-body payload binding decl(s) to prepend, given the subject
// expr `arg` and the pattern's binding name. Normally one decl
// `ref T bind_name = get_payload(arg)`. But when `bind_name` also occurs in
// `arg` (e.g. `match a { case V(a): }`, or a thunk-forced `a()` under #262),
// that single decl self-references in C: the block's `bind_name` shadows the
// subject before its own initializer is evaluated. Split it so the subject is
// read into a FRESH-named ref first (where `bind_name` still resolves to the
// outer binding/param), then alias the user name to that ref -- a ref-to-ref,
// so the arm body's uses of `bind_name` need no rewriting. `fresh_name` must be
// unique (callers derive it from the binding's source location).
make_payload_ref_decls := func(own arg: Expr, bind_name: Str, fresh_name: Str, vtype: Str, line: U32, col: U32, is_mut: Bool, mut symbols: SymbolPool, is_ref_payload: Bool = false, used: Bool = false) returns Vec(Expr) {
    mut out := Vec(Expr).new()
    if expr_contains_ident_named(arg, bind_name, symbols) {
        out.push(own make_payload_ref_decl(own arg, fresh_name, vtype, line, col, is_mut, symbols, is_ref_payload, used))
        mut alias_rhs := Expr.new(ident_node(symbols.intern(fresh_name)), line, col)
        mut alias_decl := Expr.new(NodeType.Decl(decl_typed(name = bind_name, type_name = vtype, own_type = OwnType.Ref, is_mut = is_mut, used = used)), line, col)
        alias_decl.add_child(own alias_rhs)
        out.push(own alias_decl)
    } else {
        out.push(own make_payload_ref_decl(own arg, bind_name, vtype, line, col, is_mut, symbols, is_ref_payload, used))
    }
    return out
}

// True when ~t~ is exactly ~Type.Primitive(p)~. The runtime ~.is()~ is
// tag-only on the outer Type tag, so it can't tell two primitives apart;
// destructure and compare the inner Primitive (payload-free, so its own
// tag-only ~.is()~ is precise). Cheaper than discriminating by name via
// ~til_type_name_c(t).eq("X")~ (no Str build/compare).
type_is_primitive := func(t: Type, p: Primitive) returns Bool {
    switch t {
    case .Primitive(tp): return tp.is(p)
    case: return false
    }
}

// True when `t` is the `Type` metatype value itself (Issue #57): a type
// value whose payload name is "Type", regardless of whether inference
// produced it as Type.Enum("Type"), Type.Struct("Type") or
// Type.Custom("Type"). til_type_name returns "" for non-named variants,
// so those correctly compare false. Replaces the cross-variant
// `t.eq(Type.Enum("Type"))` comparisons that needed the bespoke Type.eq.
is_type_metatype := func(t: Type) returns Bool {
    // Compared in place, not via til_type_name: that clones the payload
    // to hand back an owned Str, and this predicate ran 28K times per
    // first_class translate just to test four bytes.
    switch t {
    case .Struct(mts):     return mts == "Type"
    case .Enum(mte):       return mte == "Type"
    case .Custom(mtc):     return mtc == "Type"
    case .FuncPtrSig(mtf): return mtf == "Type"
    case: return false
    }
}

// Issue #58 / #147 step 5: two FuncPtr-family types are call-compatible
// iff both name the same FuncSig OR at least one side is the wildcard
// (`Type.FuncPtr` with no payload, or `Type.FuncPtrSig` with empty
// name). Master's structural Type-eq (Issue #165) would otherwise treat
// `Type.FuncPtr` and `Type.FuncPtrSig("X")` as distinct because the
// tags AND payloads differ; this helper restores the wildcard semantic
// the migration needs while preserving the FuncSig name on the type itself.
funcptr_eq := func(a: Type, b: Type) returns Bool {
    if a.is_funcptr().not() { return false }
    if b.is_funcptr().not() { return false }
    an := til_type_name(a)
    bn := til_type_name(b)
    if an.is_empty().or(bn.is_empty()) { return true }
    return an == bn
}

type_is_callable_storage := func(t: Type) returns Bool {
    return t.is_funcptr().or(t.is(Type.Body))
}

// #346: C return representation is independent from semantic ownership.
// Ordinary til callables return every non-ref result by value. Bodyless
// ext/core declarations keep their established C ABI: shallow results are
// values and owned/ref results are pointers.
func_returns_c_value := func(fd: FunctionDef) returns Bool {
    if fd.sig.return_type.len() == 0 { return false }
    if fd.sig.return_own_type.is(OwnType.Ref) { return false }
    if fd.is_enum_variant_ctor { return true }
    if fd.sig.func_type.is_bodyless() {
        return fd.sig.return_own_type.is(OwnType.Shallow)
    }
    // Dynamic is already a pointer-shaped erased value. A call narrowed to a
    // concrete type must copy from that storage rather than treat the pointer
    // word as the concrete C value.
    if fd.sig.return_type == "Dynamic" { return false }
    return true
}

// C parameter representation is separate from semantic ownership. Shallow
// parameters are always values. In a closed world, an ordinary owned primitive
// can also transfer its value directly. Owned aggregates prefer pointer ABI
// over caller stack storage. External boundaries and generated lifecycle
// helpers retain their established ABI.
func_param_passes_c_value := func(fd: FunctionDef, i: USize, value_abi_ok: Bool, scope: TypeScope, symbols: SymbolPool) returns Bool {
    if i >= fd.sig.params.len() { return false }
    if i.to_i32() == fd.sig.variadic_index { return false }
    if i.to_i32() == fd.sig.kwargs_index { return false }
    ref p : Declaration = fd.sig.params[i]
    if p.own_type.is(OwnType.Shallow) { return true }
    if value_abi_ok.not() { return false }
    if p.own_type.is(OwnType.Own).not().or(p.is_mut) { return false }
    if fd.sig.func_type.is_bodyless() { return false }
    // delete(self, call_free) owns a pointer specifically so call_free can
    // release that outer storage; generated cleanup sites pass its address.
    if fd.sig.params.len() > 1 {
        if fd.sig.params[1].name == "call_free" { return false }
    }
    pt := declaration_resolved_type(p, scope, symbols)
    return pt.is(Type.Primitive)
}

// Some closed-world pointer parameters consume a value's contents while only
// borrowing its outer stack slot. Ordinary variadics destroy the Array
// contents with call_free=false; generated enum constructors copy their
// payload inline without freeing the argument pointer. Public and other
// bodyless boundaries retain the established heap-outer convention.
func_param_has_stack_outer := func(fd: FunctionDef, i: USize, stack_abi_ok: Bool, scope: TypeScope, symbols: SymbolPool) returns Bool {
    if stack_abi_ok.not().or(i >= fd.sig.params.len()) { return false }
    ref p : Declaration = fd.sig.params[i]
    if p.own_type.is(OwnType.Own).not().or(p.is_mut) { return false }
    if fd.is_enum_variant_ctor {
        // The initer marks niche constructors shallow-returning because the
        // returned enum is the payload pointer itself; that pointer escapes.
        // Small tagged enums can also become shallow through auto-shallow, so
        // confirm the representation from the enum definition in that case.
        if fd.sig.return_own_type.is(OwnType.Shallow).not() { return true }
        enum_def_o := scope.get_struct(fd.sig.return_type, symbols)
        if enum_def_o.is_none() { panic(__LOC__, "missing enum definition for constructor ", fd.sig.return_type) }
        return enum_is_niche(enum_def_o.unwrap()).not()
    }
    if fd.sig.func_type.is_bodyless() { return false }
    if i.to_i32() == fd.sig.variadic_index {
        // #392: a ..Dynamic parameter's carrier is Tuple, not Array__Dynamic
        // (which may ALSO exist); the outer-storage answer must name the
        // struct the collector is actually built as.
        if resolve_type_alias_for_name(scope, p.type_name(), symbols) == "Dynamic" {
            return scope.get_struct("Tuple", symbols).is_some()
        }
        arr_name := "Array__".format(resolve_type_alias_for_name(scope, p.type_name(), symbols))
        return scope.get_struct(arr_name, symbols).is_some()
    }
    if i.to_i32() == fd.sig.kwargs_index { return scope.get_struct("KwargsMap", symbols).is_some() }
    // delete(self, call_free) can receive either stack or heap outer storage;
    // call_free selects which one the individual call owns.
    if fd.sig.params.len() > 1 {
        if fd.sig.params[1].name == "call_free" { return false }
    }
    pt := declaration_resolved_type(p, scope, symbols)
    return pt.is(Type.Struct).or(pt.is(Type.Enum))
}

type_from_name_init_name := func(name: Str, scope: TypeScope, symbols: SymbolPool) returns Type {
    mut bt := Type.Unknown
    if builtin_type_from_name(name, bt) { return bt }
    if name == "USize" { return type_from_name_init_name(scope_target_usize_pname(scope), scope, symbols) }
    if name == "UPtr" { return type_from_name_init_name(scope_target_uptr_pname(scope), scope, symbols) }
    b_o := scope.get_binding_name(name, symbols)
    if b_o.is_some() {
        ref b : TypeBinding = b_o.unwrap()
        if b.is_type_alias.and(b.alias_target.is_empty().not()) {
            return type_from_name_init_name(b.alias_target, scope, symbols)
        }
        if b.is_builtin {
            // Builtin type (had a struct_def) vs builtin ext_func
            // (has a func_def): test "builtin and not a func", and
            // clone the owned Type. See the matching note in
            // typer.til:type_from_name.
            if scope.lookup_func_name(b.name, symbols).is_none() { return b.type.clone() }
        }
        // A FuncSig alias (`Op := func(x: I64) returns I64`, registered
        // bodyless with a bare Type.FuncPtr binding by
        // register_funcsig_alias_for_stmt). Declaration now has one type
        // field, so this resolution must carry the alias name itself.
        if b.is_func_decl.and(b.type.is(Type.FuncPtr)) {
            return Type.FuncPtrSig(name.clone())
        }
        if b.is_func_decl.and(b.type.is(Type.FuncPtrSig)) { return b.type.clone() }
    }
    sdef_o := scope.get_struct(name, symbols)
    if sdef_o.is_some() {
        if sdef_o.unwrap().node_type.is(NodeType.EnumDef) { return Type.Enum(name.clone()) }
        return Type.Struct(name.clone())
    }
    return Type.Unknown
}

type_from_declaration_name := func(name: Str, scope: TypeScope, symbols: SymbolPool) returns Type {
    resolved := type_from_name_init_name(name, scope, symbols)
    if resolved.is(Type.Unknown).not() { return resolved }
    return declaration_type_from_name(name)
}

// Resolve a declaration type for semantic use. Only Custom is unresolved;
// all refined and tag-only variants already carry the semantic answer.
declaration_resolved_type := func(decl: Declaration, scope: TypeScope, symbols: SymbolPool) returns Type {
    switch decl.til_type {
    case .Custom(name):
        resolved := type_from_name_init_name(name, scope, symbols)
        if resolved.is(Type.Unknown).not() { return resolved }
    case:
    }
    return decl.til_type.clone()
}

// Issue #289: the element type name of an `array(T, ...)` / `vec(T, ...)`
// pseudo-literal -- the bare type token in child(1) (e.g. `I64` in
// `array(I64, 1, 2, 3)`, or the synthesized `Array__Str` in
// `array(Array__Str, ...)`). array/vec take a type token, like assert_eq's
// `T: Type`, not a Str. The token is deliberately left un-rewritten by the
// typer so the initer/desugarer/builder can read the type NAME at compile
// time and monomorphize into Array__T / Vec__T. Returns "" when child(1) is
// missing or is not a plain type Ident.
array_vec_elem_type_name := func(fcall: Expr, symbols: SymbolPool) returns Str {
    if fcall.children.len() < 2 { return "" }
    switch fcall.children[1].node_type {
    case .Ident(tn): return Str.clone(tn.ident_name(symbols.names))
    case:
        return ""
    }
}

// #326: is this `delete` body nothing but the `if call_free { free(own
// self) }` tail? That is what the initer generates for a type holding
// nothing that needs cleanup, and what core writes by hand for every
// primitive -- reached with call_free false it does nothing at all. Both
// the initer (deciding whether to GENERATE a cleanup call) and the
// builder (deciding whether to EMIT one) ask it, of the same body.
delete_body_is_free_only := func(fdef: Expr, symbols: SymbolPool) returns Bool {
    if fdef.children.len() == 0 { return false }
    ref dbf_body : Expr = fdef.children[0]
    if dbf_body.children.len() != 1 { return false }
    ref dbf_only : Expr = dbf_body.children[0]
    if dbf_only.node_type.is(NodeType.If).not() { return false }
    if dbf_only.children.len() == 0 { return false }
    switch dbf_only.children[0].node_type {
    case .Ident(dbf_cond):
        return dbf_cond.ident_name(symbols.names).eq("call_free")
    case:
        return false
    }
}

// #326: does deleting a value of this type do ANYTHING? A HAND-WRITTEN
// delete may (test/structs.til's DeleteCustom counts its calls), so the
// answer is read off the body wherever there is one -- the generated ones
// this pass has already written included. Before one is written the shape
// decides, and that is the recursion is_pod_type_for_clone does: a
// primitive needs nothing, a struct needs whatever its fields need, an
// enum whatever its payloads need. Order-independent either way, because
// a hand-written member is in the def from parse time.
//
// This is the delete question; is_pod_type_for_clone is the copy
// question. They agree on shape and part ways on the hand-written member,
// which is exactly what a POD-ness proxy cannot see.
init_delete_is_noop := func(type_name: Str, scope: TypeScope, symbols: SymbolPool) returns Bool {
    if type_name.len() == 0 { return false }
    idn_t := type_from_name_init_name(type_name, scope, symbols)
    if is_primitive(idn_t) { return true }
    if type_is_callable_storage(idn_t) { return false }
    def_o := scope.get_struct(type_name, symbols)
    if def_o.is_none() { return false }
    ref idn_def : Expr = def_o.unwrap()
    del_o := def_ns_get(idn_def, "delete")
    if del_o.is_some() {
        ref idn_del : Declaration = del_o.unwrap()
        if idn_del.default_value.is_none() { return false }
        return delete_body_is_free_only(idn_del.default_expr(), symbols)
    }
    switch idn_def.node_type {
    case .StructDef(idn_sd):
        if idn_sd.fields.len() == 0 { return false }
        for idn_fd : Declaration in idn_sd.fields {
            if idn_fd.own_type.is(OwnType.Ref) { continue }
            if idn_fd.own_type.is(OwnType.Own) { return false }
            if init_delete_is_noop(idn_fd.type_name(), scope, symbols).not() { return false }
        }
        return true
    case .EnumDef(idn_ed):
        for idn_vd : VariantDef in idn_ed.variants {
            if idn_vd.payload_type.len() == 0 { continue }
            if idn_vd.payload_ref { continue }
            if init_delete_is_noop(idn_vd.payload_type, scope, symbols).not() { return false }
        }
        return true
    case:
        return false
    }
}

is_pod_type_for_clone := func(type_name: Str, scope: TypeScope, symbols: SymbolPool) returns Bool {
    if type_name.len() == 0 { return false }
    t := type_from_name_init_name(type_name, scope, symbols)
    if is_primitive(t) { return true }
    if type_is_callable_storage(t) { return false }
    sdef_o := scope.get_struct(type_name, symbols)
    if sdef_o.is_none() { return false }
    ref sdef : Expr = sdef_o.unwrap()
    switch sdef.node_type {
    case .StructDef(sdd):
        if sdd.fields.len() == 0 { return false }
        for fd : Declaration in sdd.fields {
            if fd.own_type.is(OwnType.Own) { return false }
            if fd.own_type.is(OwnType.Ref) { continue }
            ftn := fd.type_name()
            if is_pod_type_for_clone(ftn, scope, symbols).not() { return false }
        }
        return true
    case .EnumDef(edd):
        for vd : VariantDef in edd.variants {
            ref pt : Str = vd.payload_type
            if vd.payload_ref { continue }
            if pt.len().gt(0).and(is_pod_type_for_clone(pt, scope, symbols).not()) { return false }
        }
        return true
    case:
    }
    return false
}

// --- Helpers moved from ast.til ---

// Self-compiler AST inspection helpers.

priv is_decl_with_child := func(stmt: Expr) returns Bool {
    return stmt.node_type.is(NodeType.Decl).and(stmt.children.len().gt(0))
}

is_struct_or_enum := func(stmt: Expr) returns Bool {
    if is_decl_with_child(stmt).not() { return false }
    ref def : Expr = stmt.children[0]
    return def.node_type.is(NodeType.StructDef).or(def.node_type.is(NodeType.EnumDef))
}

is_func_decl := func(stmt: Expr) returns Bool {
    if is_decl_with_child(stmt).not() { return false }
    return stmt.children[0].node_type.is(NodeType.FuncDef)
}

is_def := func(stmt: Expr) returns Bool {
    if is_decl_with_child(stmt).not() { return false }
    ref def : Expr = stmt.children[0]
    return def.node_type.is(NodeType.FuncDef)
    .or(def.node_type.is(NodeType.StructDef))
    .or(def.node_type.is(NodeType.EnumDef))
}

// #307: single-probe member lookup -- one binary search, None on miss.
// The get()?/catch shape avoids both the has()+[] double probe and the
// checked subscript's __LOC__ Str allocation (KeyNotFound is fieldless,
// so the throw itself is free per #316). Same leaf shape as
// func_defs_lookup_one above.
member_get := func(idx: Map(Str, USize), v: Vec(Declaration), name: Str) returns Option(ref Declaration) {
    ref p : USize = idx.get(name)?
    catch (e: KeyNotFound) { return Option(ref Declaration).None }
    ref d : Declaration = v.unsafe_get(p)
    return safe_ref(d)
}

// #307: members are declaration-ordered Vecs with a name -> position
// index Map beside them (see ast.til StructDef doc). This is the
// Expr-level access API over both def kinds: the decl Vec itself (walk
// it with a plain for-in), positional name lookup, and name-keyed
// member lookup.
def_ns_decls := func(sdef: Expr) returns ref Vec(Declaration) {
    switch sdef.node_type {
    case .StructDef(sd):
        return sd.ns_decls
    case .EnumDef(ed):
        return ed.ns_decls
    case:
        panic(__LOC__, "def_ns_decls: node is neither a StructDef nor an EnumDef")
    }
}

// Member name at declaration-order position i (the map key).
def_ns_name_at := func(sdef: Expr, i: USize) returns ref Str {
    switch sdef.node_type {
    case .StructDef(sd):
        return sd.member_name_at(i)
    case .EnumDef(ed):
        return ed.member_name_at(i)
    case:
        panic(__LOC__, "def_ns_name_at: node is neither a StructDef nor an EnumDef")
    }
}

def_ns_has := func(sdef: Expr, name: Str) returns Bool {
    switch sdef.node_type {
    case .StructDef(sd):
        return sd.ns_index.has(name)
    case .EnumDef(ed):
        return ed.ns_index.has(name)
    case:
        UNREACHABLE("expected StructDef or EnumDef")
        return false
    }
}

// Member Declaration by name; None when the def has no such member.
// Single probe via member_get.
def_ns_get := func(sdef: Expr, name: Str) returns Option(ref Declaration) {
    switch sdef.node_type {
    case .StructDef(sd):
        return member_get(sd.ns_index, sd.ns_decls, name)
    case .EnumDef(ed):
        return member_get(ed.ns_index, ed.ns_decls, name)
    case:
        UNREACHABLE("expected StructDef or EnumDef")
        return Option(ref Declaration).None
    }
}

// #307 follow-up: declaration-order position of a named member, -1 when
// absent. The position twin of member_get.
priv member_pos := func(idx: Map(Str, USize), name: Str) returns I64 {
    ref p : USize = idx.get(name)?
    catch (e: KeyNotFound) { return -1 }
    return p.to_i64()
}

def_ns_pos := func(sdef: Expr, name: Str) returns I64 {
    switch sdef.node_type {
    case .StructDef(sd):
        return member_pos(sd.ns_index, name)
    case .EnumDef(ed):
        return member_pos(ed.ns_index, name)
    case:
        UNREACHABLE("expected StructDef or EnumDef")
        return -1
    }
}

// A namespace member that is a CONSTANT (has an initializer that is not
// a FuncDef) -- the population ns_const_eval_order sequences.
priv ns_decl_is_const := func(d: Declaration) returns Bool {
    if d.default_value.is_none() { return false }
    return d.default_expr().node_type.is(NodeType.FuncDef).not()
}

// #307 follow-up (the known-latent sibling-order class): evaluation
// order for a def's namespace CONSTANT members. A constant's
// initializer may reference a sibling constant as `<TypeName>.<member>`;
// the typer's member sweep and interpreter_init_ns used to process
// constants in declaration order, so a forward reference read an
// untyped / not-yet-evaluated sibling. Returns the constant members'
// declaration positions ordered so every referenced sibling precedes
// its referers (declaration order otherwise). A reference cycle is a
// user error and panics with the member's qualified name.
ns_const_eval_order := func(tname: Str, sdef: Expr, symbols: SymbolPool) returns Vec(I64) {
    ref decls : Vec(Declaration) = def_ns_decls(sdef)
    // I64 positions, not USize: a Vec(USize) local vs a Vec(USize) param
    // monomorphize under different width-alias spellings (Vec__U32 vs
    // Vec__USize -- see StructDef.field_name_at for the same trap).
    mut order := Vec(I64).new()
    // 0 = unvisited, 1 = in progress (cycle detection), 2 = done.
    mut state := Vec(I64).new()
    for _ in 0..decls.len() { state.push(own 0) }
    for i in 0..decls.len() {
        ns_const_order_visit(tname, sdef, i, state, order, symbols)
    }
    return order
}

priv ns_const_order_visit := func(tname: Str, sdef: Expr, pos: USize, mut state: Vec(I64), mut order: Vec(I64), symbols: SymbolPool) {
    ref decls : Vec(Declaration) = def_ns_decls(sdef)
    ref d : Declaration = decls.unsafe_get(pos)
    if ns_decl_is_const(d).not() { return }
    ref st : I64 = state.unsafe_get(pos)
    if st == 2 { return }
    if st == 1 {
        panic("namespace constant initializers form a reference cycle involving '",
            tname, ".", def_ns_name_at(sdef, pos), "'")
    }
    state.unsafe_set(pos, own 1)
    ns_const_order_deps(tname, sdef, d.default_expr(), state, order, symbols)
    state.unsafe_set(pos, own 2)
    order.push(own pos.to_i64())
}

// Walk a constant initializer for `<tname>.<member>` sibling-constant
// references and visit each first.
priv ns_const_order_deps := func(tname: Str, sdef: Expr, e: Expr, mut state: Vec(I64), mut order: Vec(I64), symbols: SymbolPool) {
    switch e.node_type {
    case .FieldAccess(fa):
        if e.children.len() > 0 {
            switch e.children[0].node_type {
            case .Ident(rid):
                if rid.ident_name(symbols.names) == tname {
                    p := def_ns_pos(sdef, fa.field_access_name(symbols.names))
                    if p >= 0 { ns_const_order_visit(tname, sdef, p.to_usize(), state, order, symbols) }
                }
            case:
            }
        }
    case:
    }
    for c : Expr in e.children { ns_const_order_deps(tname, sdef, c, state, order, symbols) }
}

enum_has_payloads := func(enum_def: Expr) returns Bool {
    ref edd : EnumDef = enumdef_of(enum_def)
    for vd : VariantDef in edd.variants {
        if vd.payload_type.len() > 0 { return true }
    }
    return false
}

// #264: the enum's discriminant (tag) type. Empty tag_type means the
// declaration omitted `(Type)`, defaulting to U8 (a 1-byte tag) for
// compactness; `enum(Type)` overrides the width.
enum_tag_type := func(enum_def: Expr) returns Str {
    ref edd : EnumDef = enumdef_of(enum_def)
    if edd.tag_type.len() > 0 { return edd.tag_type.clone() }
    return "U8"
}

// #264: size in bytes of the enum's discriminant.
enum_tag_size := func(enum_def: Expr) returns USize {
    return unsigned_prim_width_for_name(enum_tag_type(enum_def))
}

// The discriminant VALUE of a variant. With explicit `= N` tags this is the
// assigned value; otherwise the declaration index (enum_def_of fills
// tag_value with the index for FFI-built defs).
enum_variant_tag := func(enum_def: Expr, variant_name: Str) returns I64 {
    ref edd : EnumDef = enumdef_of(enum_def)
    for vd : VariantDef in edd.variants {
        if vd.name == variant_name { return vd.tag_value.clone() }
    }
    return -1
}

// The tag VALUE of a variant by its declaration INDEX (the index-keyed
// twin of enum_variant_tag, for callers that already hold a position --
// e.g. the niche layout's derived discriminant).
enum_variant_tag_at := func(enum_def: Expr, idx: I32) returns I64 {
    ref edd : EnumDef = enumdef_of(enum_def)
    idx_u := idx.to_usize()
    if idx_u < edd.variants.len() {
        ref vd : VariantDef = edd.variants[idx_u]
        return vd.tag_value.clone()
    }
    return -1
}

// The declaration INDEX whose discriminant equals `tag`. Explicit tags make
// this distinct from using the tag itself as an index.
enum_variant_index_for_tag := func(enum_def: Expr, tag: I64) returns I32 {
    ref edd : EnumDef = enumdef_of(enum_def)
    for i in 0..edd.variants.len() {
        ref vd : VariantDef = edd.variants[i]
        if vd.tag_value == tag { return i.to_i32() }
    }
    return -1
}

// The declaration INDEX of a variant (0-based). Distinct from the tag VALUE
// once explicit tags are used. Payload lookups by position must use this,
// NOT enum_variant_tag.
enum_variant_index := func(enum_def: Expr, variant_name: Str) returns I32 {
    ref edd : EnumDef = enumdef_of(enum_def)
    for i in 0..edd.variants.len() {
        ref vd : VariantDef = edd.variants[i]
        if vd.name == variant_name { return i.to_i32() }
    }
    return -1
}

// Payload type of a variant by its declaration INDEX. Callers holding a tag
// VALUE must convert via enum_variant_index -- do NOT pass a tag here.
enum_variant_type := func(enum_def: Expr, idx: I32) returns Str {
    ref edd : EnumDef = enumdef_of(enum_def)
    idx_u := idx.to_usize()
    if idx_u < edd.variants.len() {
        ref vd : VariantDef = edd.variants[idx_u]
        return vd.payload_type.clone()
    }
    return ""
}

// Payload-const flag of a variant by its declaration INDEX. Like
// enum_variant_type, callers with a tag VALUE convert via
// enum_variant_index first.
enum_variant_payload_const := func(enum_def: Expr, idx: I32) returns Bool {
    ref edd : EnumDef = enumdef_of(enum_def)
    idx_u := idx.to_usize()
    if idx_u < edd.variants.len() {
        ref vd : VariantDef = edd.variants[idx_u]
        return vd.payload_const
    }
    return false
}

// #320 niche layout: an enum laid out as a BARE POINTER, with the
// payload-less variant represented by the null bit pattern -- no tag, no
// union. This is Rust's null-pointer optimization, and it is a GENERAL
// rule rather than a blessing of Option by name: it applies to any enum
// with exactly two variants, one carrying no payload and one carrying a
// payload that can never itself be null (today: a `ref` payload; funcptr
// payloads are the obvious next candidate).
//
// The soundness argument is #321's: a `ref` points at something, so the
// null bit pattern is free to mean "the other variant". That is what
// makes Option(ref T) one word and ABI-identical to a nullable C pointer.
// #321: is this payload type a heap BOX -- a value til represents as a
// pointer, so it can never be null and can carry the niche, and someone has
// to free the box itself? Each exclusion is a way that stops being true:
// primitives live inline and 0 is a legal value; Dynamic is the quarantined
// raw layer where null IS legal; a Str literal is a static Str rather than
// a box. (Funcptr payloads are excluded by the stamped payload_funcsig
// flag, not by name -- a named FuncSig alias hides the pointer.)
niche_payload_is_owned_box := func(vtype: Str) returns Bool {
    if vtype.len() == 0 { return false }
    if vtype == "Dynamic" { return false }
    if vtype == "Str" { return false }
    if vtype.starts_with("_Fn_") { return false }
    return is_scalar_type_name(vtype).not()
}

// #321: payload_funcsig of a variant by declaration INDEX, for callers that
// hold the def and an index rather than the VariantDef itself.
enum_variant_payload_funcsig := func(enum_def: Expr, idx: I32) returns Bool {
    ref edd : EnumDef = enumdef_of(enum_def)
    idx_u := idx.to_usize()
    if idx_u < edd.variants.len() {
        ref vd : VariantDef = edd.variants[idx_u]
        return vd.payload_funcsig
    }
    return false
}

enum_is_niche := func(enum_def: Expr) returns Bool {
    ref edd : EnumDef = enumdef_of(enum_def)
    if edd.variants.len() != 2 { return false }
    mut payload_less := 0
    mut ref_payloads := 0
    for vd : VariantDef in edd.variants {
        if vd.payload_type.len() == 0 { payload_less++; continue }
        if vd.payload_ref { ref_payloads++; continue }
        // #321: a funcptr payload never joins the niche -- a distinct C
        // shape (TilClosure *) with its own delete/clone special cases.
        // Stamped by the initer, because the parser cannot see through a
        // named FuncSig alias.
        if vd.payload_funcsig { continue }
        if niche_payload_is_owned_box(vd.payload_type) { ref_payloads++ }
    }
    return payload_less.eq(1).and(ref_payloads.eq(1))
}

// The index of the payload-carrying variant of a niche enum (the other
// one IS null). Callers must have checked enum_is_niche first.
enum_niche_some_index := func(enum_def: Expr) returns I32 {
    ref edd : EnumDef = enumdef_of(enum_def)
    for vi in 0..edd.variants.len() {
        ref vd : VariantDef = edd.variants[vi]
        if vd.payload_type.len() > 0 { return vi.to_i32() }
    }
    panic(__LOC__, "niche enum without a payload variant")
    return -1
}

// #320: payload-ref flag of a variant by its declaration INDEX. True when
// the variant's payload was declared `ref Type` -- a borrowed payload
// stored as a bare pointer the enum does not own.
enum_variant_payload_ref := func(enum_def: Expr, idx: I32) returns Bool {
    ref edd : EnumDef = enumdef_of(enum_def)
    idx_u := idx.to_usize()
    if idx_u < edd.variants.len() {
        ref vd : VariantDef = edd.variants[idx_u]
        return vd.payload_ref
    }
    return false
}

// The payload expression of a syntactic enum constructor whose selected
// variant borrows its payload. Works before generated variant methods exist
// and after their calls have been flattened.
enum_ref_payload_ctor_arg := func(e: Expr, scope: TypeScope, symbols: SymbolPool) returns Option(ref Expr) {
    if e.node_type.is(NodeType.FCall).not() { return Option(ref Expr).None }
    if e.children.len() != 2 { return Option(ref Expr).None }
    ref callee : Expr = e.children[0]
    mut ename := ""
    mut vname := ""
    switch callee.node_type {
    case .FieldAccess(fa):
        if callee.children.len() == 0 { return Option(ref Expr).None }
        switch callee.children[0].node_type {
        case .Ident(eid): ename = Str.clone(eid.ident_name(symbols.names))
        case: return Option(ref Expr).None
        }
        vname = Str.clone(fa.field_access_name(symbols.names))
    case .Ident(cid):
        ename_o := expr_type_name_ref(e)
        if ename_o.is_none() { return Option(ref Expr).None }
        ename = ename_o.unwrap().clone()
        prefix := format(ename, "_")
        ref cname : Str = cid.ident_name(symbols.names)
        if cname.starts_with(prefix).not() { return Option(ref Expr).None }
        vname = cname.substr(prefix.len(), cname.len() - prefix.len())
    case: return Option(ref Expr).None
    }
    edef_o := scope.get_struct(ename, symbols)
    if edef_o.is_none() { return Option(ref Expr).None }
    ref edef : Expr = edef_o.unwrap()
    if edef.node_type.is(NodeType.EnumDef).not() { return Option(ref Expr).None }
    idx := enum_variant_index(edef, vname)
    if idx < 0 { return Option(ref Expr).None }
    if enum_variant_payload_ref(edef, idx).not() { return Option(ref Expr).None }
    return safe_ref(e.children[1])
}

// #321, stage 1 of the owned-payload niche: is this variant's payload stored
// in the enum as a POINTER rather than inline? Two different things make it
// so, and only one of them is about ownership:
//   - a `ref` payload is a borrowed pointer the enum does not own (#320);
//   - a NICHE enum's payload IS the whole value, so its slot is a pointer no
//     matter who owns the pointee.
// A payload BINDING has to LOAD that pointer either way -- the `deref` wrapper
// make_payload_ref_decl adds -- so the binding must ask this question, not the
// ownership one. Today the two coincide exactly: a niche is only ever a `ref`
// payload, so this returns what enum_variant_payload_ref returns and nothing
// changes. It exists so the deref gate is already correct when an OWNED
// aggregate payload becomes niche-eligible, which is the next stage.
//
// Sites that really do mean "is this payload borrowed" -- the generated
// delete and clone skipping a pointee the enum does not own, the ctor param's
// own_type, the garbager's borrow source -- keep calling
// enum_variant_payload_ref. Mixing the two up is exactly the bug that made
// the first attempt at the owned niche read `&self->data` as if it were the
// payload.
enum_payload_is_pointer_slot := func(enum_def: Expr, idx: I32) returns Bool {
    // A payload-less variant has no slot at all. Every caller already skips
    // those, but the niche arm below would otherwise answer for the wrong
    // variant of a niche enum.
    if enum_variant_type(enum_def, idx).len() == 0 { return false }
    // #321: a NICHE loads its own slot inside get_payload (it has exactly one
    // payload variant, so the lowering is unambiguous there). Only a TAGGED
    // enum's borrowed payload still needs the caller to wrap the call in
    // `deref(...)`, because which variants are pointers differs per variant
    // and get_payload alone cannot tell.
    if enum_is_niche(enum_def) { return false }
    return enum_variant_payload_ref(enum_def, idx)
}

// #321: does any variant of this enum carry a BORROWED payload? Such an
// enum hands a borrow out with the value, so a function returning one is
// as much a borrow source as a `returns ref` function is.
enum_has_ref_payload := func(enum_def: Expr) returns Bool {
    switch enum_def.node_type {
    case .EnumDef(edd):
        for vd : VariantDef in edd.variants {
            if vd.payload_ref { return true }
        }
    case:
    }
    return false
}

// --- Control-flow divergence analysis (shared by typer + builder) ---
//
// stmt_always_diverges(e) is true iff executing `e` can never fall through to
// the statement that would follow it -- it always returns or otherwise
// diverges. The typer uses it for its all-paths-return check (a non-void
// function whose body does NOT diverge is a missing-return error); the builder
// uses it to close such a body with __builtin_unreachable() so GCC's
// -Wreturn-type stays quiet under ASAN/-finstrument-functions. Both call the
// one predicate here so they can never drift apart.
//
// It is conservative: it reports "never falls through" only when control
// provably diverges on EVERY path, so it never mislabels a body that can fall
// through. The typer sees the pre-desugar AST and the builder the post-desugar
// one, but the node shapes this walks (Return/Body/If/Switch/While plus a
// noreturn call) are stable across both stages.

// True when `e` is a direct call to a raw allocator whose result is an
// owned heap block: malloc / calloc / realloc. Shared by the garbager
// (LocalInfo.raw_alloc provenance, #302) and the builder (raw-alloc
// value-local emit, #303).
rhs_is_allocator_call := func(e: Expr, symbols: SymbolPool) returns Bool {
    if e.node_type.is(NodeType.FCall).not() { return false }
    if e.children.len() < 1 { return false }
    switch e.children[0].node_type {
    case .Ident(fid):
        return fid.ident_name(symbols.names).eq("malloc").or(fid.ident_name(symbols.names).eq("calloc")).or(fid.ident_name(symbols.names).eq("realloc"))
    case:
        return false
    }
}

// #303: a `return` anywhere at this function's nesting level. Nested
// function bodies own their returns (like has_unnested_break), so
// recursion stops at FuncDef/BodyValue boundaries.
priv contains_return := func(e: Expr) returns Bool {
    switch e.node_type {
    case .Return:
        return true
    case .FuncDef, .BodyValue:
        return false
    case:
        for c : Expr in e.children {
            if contains_return(c) { return true }
        }
        return false
    }
}

// #303: true iff calling a function with this body never gives control
// back: no return statement at the function's own level, and every path
// diverges (through a noreturn call or an unbreakable `while true`).
// The typer runs this bottom-up after typing each Func/Proc body and
// records the result on FunctionDef.noreturn; callees typed earlier
// (imports, earlier in the file) are already marked, so chains like
// exit -> panic -> UNREACHABLE resolve without any name matching.
fn_never_returns := func(body: Expr, scope: TypeScope, symbols: SymbolPool) returns Bool {
    return contains_return(body).not().and(stmt_always_diverges(body, scope, symbols))
}

priv is_literal_true := func(e: Expr) returns Bool {
    switch e.node_type {
    case .Literal(Literal.Bool(b)):
        return b
    case:
        return false
    }
}

// True if `e` contains a `break` targeting the loop whose body `e` is part of:
// a break not swallowed by a nested loop or a nested function. A til case-level
// `break` targets the enclosing loop, so switch/if bodies are walked; nested
// while/for-in own their breaks, and a break cannot cross a function boundary,
// so recursion stops at those.
priv has_unnested_break := func(e: Expr) returns Bool {
    switch e.node_type {
    case .Break:
        return true
    case .While, .ForIn, .FuncDef, .BodyValue:
        return false
    case:
        for c : Expr in e.children {
            if has_unnested_break(c) { return true }
        }
        return false
    }
}

// `match` never appears here: it is value-position only, so it always rides
// inside a Return or a Decl, not as a bare statement.
stmt_always_diverges := func(e: Expr, scope: TypeScope, symbols: SymbolPool) returns Bool {
    switch e.node_type {
    case .Return:
        return true
    case .FCall:
        fd_o := resolve_direct_fcall(e, scope, symbols)
        if fd_o.is_none() { return false }
        switch fd_o.unwrap().node_type {
        case .FuncDef(fd): return fd.noreturn
        case: return false
        }
    case .Body:
        // Never falls through iff one statement doesn't: control cannot reach
        // anything past a diverging statement.
        for c : Expr in e.children {
            if stmt_always_diverges(c, scope, symbols) { return true }
        }
        return false
    case .If:
        // Needs an else branch (children[2]) AND both branches diverging.
        if e.children.len() <= 2 { return false }
        return stmt_always_diverges(e.children[1], scope, symbols).and(stmt_always_diverges(e.children[2], scope, symbols))
    case .Switch:
        // Exhaustive (a `case:` wildcard -> C default) and every arm diverges.
        // A pattern arm is [pattern x N, body]; the wildcard arm is [body].
        // The body is always the last child.
        mut has_default := false
        for ci in 1..e.children.len() {
            ref cn : Expr = e.children[ci]
            if cn.children.len() == 1 { has_default = true }
            if stmt_always_diverges(cn.children[cn.children.len() - 1], scope, symbols).not() { return false }
        }
        return has_default
    case .While:
        // `while true { ... }` with no break targeting it never falls through:
        // it exits only via a return inside the body (or loops forever). Any
        // other condition may go false and let control past the loop.
        return is_literal_true(e.children[0]).and(has_unnested_break(e.children[1]).not())
    case:
        return false
    }
}

// --- Issue #262: lazy body shape predicates ---
// Shared by the loader (which builds the inlined/unrolled expressions) and
// the typer (which accepts or rejects lazy def bodies with the same
// predicates). Cross-phase helpers, so they live here rather than in
// ast.til, which stays focused on the AST structs themselves.

// Issue #262: a lazy_func/lazy_proc body the inliner can splice into a single
// expression. Inlinable shapes:
//   { return <expr> }                          -> <expr>
//   { if cond { return X } else { return Y } }  -> match cond { ... }
//   { if c1 { return X1 } ... if ck { return Xk } return Y }   (guard chain)
//        -> nested match (each guard is an `if cond { return X }` with no
//           else; the chain ends in a bare `return Y`)
// The loader's lazy_body_as_expr constructs the inlined expression for exactly
// these shapes; the typer uses this predicate to reject any other shape
// (locals, loops, ...) loudly instead of silently degrading to an eager call.
// Keep the two in sync.
priv lazy_single_return_body := func(body: Expr) returns Bool {
    if body.node_type.is(NodeType.Body).not() { return false }
    if body.children.len().eq(1).not() { return false }
    ref ret : Expr = body.children[0]
    return ret.node_type.is(NodeType.Return).and(ret.children.len().gte(1))
}

// An `if cond { return X }` guard: an If with exactly [cond, then-Body] (no
// else) whose then-Body is a single `return X`.
priv lazy_is_guard := func(stmt: Expr) returns Bool {
    if stmt.node_type.is(NodeType.If).not() { return false }
    if stmt.children.len().eq(2).not() { return false }
    return lazy_single_return_body(stmt.children[1])
}

// True when body.children[start..] forms an inlinable tail: a single
// `return <expr>`, a single `if/else` with single returns, or a guard chain
// `if c1 { return X1 } ... return Y`.
priv lazy_stmts_inlinable := func(body: Expr, start: USize) returns Bool {
    n := body.children.len()
    if start >= n { return false }
    ref last : Expr = body.children[n - 1]
    if start == n - 1 {
        switch last.node_type {
        case .Return:
            return last.children.len() >= 1
        case .If:
            if last.children.len() < 3 { return false }
            return lazy_single_return_body(last.children[1])
                .and(lazy_single_return_body(last.children[2]))
        case:
            return false
        }
    }
    // start < n-1: a guard chain ends in `return Y`, preceded by guards.
    if last.node_type.is(NodeType.Return).not().or(last.children.len() < 1) { return false }
    for i in start..n - 1 {
        if lazy_is_guard(body.children[i]).not() { return false }
    }
    return true
}

lazy_body_inlinable := func(body: Expr) returns Bool {
    if body.node_type.is(NodeType.Body).not() { return false }
    if body.children.len() == 0 { return false }
    return lazy_stmts_inlinable(body, 0)
}

// A statement safe to splice as an unconditional prelude when statement-
// inlining a lazy body: a local decl, an assignment, or a call. Control flow
// and returns are excluded (an early return or a loop can't be flattened).
priv lazy_is_safe_prelude := func(stmt: Expr) returns Bool {
    switch stmt.node_type {
    case .Decl, .Assign, .FieldAssign, .FCall: return true
    case:                      return false
    }
}

// Issue #262: the split index for a statement-inlinable lazy body --
// `{ <safe prelude statements> <inlinable tail> }`. The prefix [0, k) is a
// non-empty run of safe-prelude statements (local bindings, assignments,
// calls) and the suffix [k, n) is an inlinable tail. Returns -1 when the body
// is not statement-inlinable (already inlinable with no prefix, all-prelude
// with no tail, or a prefix containing control flow / early returns).
lazy_body_split_point := func(body: Expr) returns I32 {
    if body.node_type.is(NodeType.Body).not() { return -1 }
    n := body.children.len()
    mut k : USize = 0
    while k < n {
        if lazy_is_safe_prelude(body.children[k]).not() { break }
        k++
    }
    if k == 0 { return -1 }
    if k >= n { return -1 }
    if lazy_stmts_inlinable(body, k).not() { return -1 }
    return k.to_i32()
}

lazy_body_stmt_inlinable := func(body: Expr) returns Bool {
    return lazy_body_split_point(body) >= 0
}

// True when `e` mentions identifier `name` anywhere (an Ident read or an
// Assign target). Used by lazy_variadic_body_unrollable to ensure the
// variadic param is consumed ONLY by the for-in loops that get unrolled.
priv lazy_mentions_ident := func(e: Expr, name: Str, symbols: SymbolPool) returns Bool {
    switch e.node_type {
    case .Ident(idd):  if idd.ident_name(symbols.names) == name { return true }
    case .Assign(ad):  if ad.name == name { return true }
    case:
    }
    for c : Expr in e.children {
        if lazy_mentions_ident(c, name, symbols) { return true }
    }
    return false
}

// Issue #262: shape check for a GENUINELY-variadic lazy body (vand/vor). The
// variadic param `vname` may be consumed only as the iterated collection of
// top-level `for <v> in <vname> { <guards> }` statements whose bodies are all
// guards (`if c { return X }`, see lazy_is_guard); every other statement must
// be a guard or the final single `return <expr>`, and must not mention
// `vname`. Such a body unrolls at any call site with N compile-time-known
// operands into a plain guard chain -- each for-in becomes its guards
// repeated once per operand with <v> substituted by the operand expression
// (call-by-name) -- which the lazy expression inliner then splices as nested
// short-circuit matches. Zero runtime cost: no thunk, no collection is ever
// built. The typer accepts a variadic lazy def iff this holds; the loader's
// inline_variadic_lazy_call performs the matching unroll.
lazy_variadic_body_unrollable := func(body: Expr, vname: Str, symbols: SymbolPool) returns Bool {
    if body.node_type.is(NodeType.Body).not() { return false }
    n := body.children.len()
    if n == 0 { return false }
    ref last : Expr = body.children[n - 1]
    if last.node_type.is(NodeType.Return).not().or(last.children.len() < 1) { return false }
    if lazy_mentions_ident(last, vname, symbols) { return false }
    for i in 0..n - 1 {
        ref stmt : Expr = body.children[i]
        mut is_unroll_loop := false
        switch stmt.node_type {
        case .ForIn(fid):
            if stmt.children.len() < 2 { return false }
            mut iter_is_vname := false
            switch stmt.children[0].node_type {
            case .Ident(itn): iter_is_vname = itn.ident_name(symbols.names) == vname
            case:
            }
            if iter_is_vname.not() { return false }        // a foreign loop: not unrollable
            if fid.name == vname { return false }          // loop var shadows the param
            if fid.name2.len() > 0 { return false }        // key/value form: not a plain list
            ref lbody : Expr = stmt.children[1]
            if lbody.node_type.is(NodeType.Body).not() { return false }
            if lbody.children.len() == 0 { return false }
            for lstmt : Expr in lbody.children {
                if lazy_is_guard(lstmt).not() { return false }
                if lazy_mentions_ident(lstmt, vname, symbols) { return false }
            }
            is_unroll_loop = true
        case:
        }
        if is_unroll_loop.not() {
            if lazy_is_guard(stmt).not() { return false }
            if lazy_mentions_ident(stmt, vname, symbols) { return false }
        }
    }
    return true
}

// --- Type / AST helpers moved from src/core/ast.til ---
// Cross-phase helper funcs over the core AST types. They live here (the
// cross-phase home) rather than in src/core/ast.til so the core file stays
// focused on the AST structs and enums themselves.

// True when ~t~ is one of the scalar primitive types. Every scalar now
// lives under ~Type.Primitive(Primitive)~, so this is a single tag check.
is_primitive := func(t: Type) returns Bool {
    return t.is(Type.Primitive)
}

// Issue #58 / #147: a FuncSig-typed value can carry the alias
// name in ~Type.FuncPtrSig: Str~ or remain anonymous as ~Type.FuncPtr~.
// Callers asking "is this a function pointer at all?" use this helper
// so callsites work transparently across both shapes.
is_funcptr := func(t: Type) returns Bool {
    return t.is(Type.FuncPtr).or(t.is(Type.FuncPtrSig))
}

// Compound aggregate type: user-defined struct or enum that the codegen
// represents as a multi-field record (and typically heap-allocates /
// dispatches a generated delete on). Primitives are Type.Primitive, so
// they fall out naturally -- no primitive guard needed.
is_aggregate := func(t: Type) returns Bool {
    return t.is(Type.Struct).or(t.is(Type.Enum))
}

fcall_is_direct := func(e: Expr) returns Bool {
    switch e.node_type {
    case .FCall: return e.children[0].til_type().is(Type.FuncDef)
    case: UNREACHABLE("expected FCall")
    }
    return false
}

mark_fcall_direct := func(mut e: Expr) {
    switch e.node_type {
    case .FCall: e.children[0].set_til_type(Type.FuncDef)
    case: UNREACHABLE("expected FCall")
    }
}

// Resolve the FunctionDef selected by a typed direct call. Directness lives
// on the callee expression's Type.FuncDef stamp; runtime callable values keep
// FuncPtr, FuncPtrSig, or Body and therefore never resolve through a same-name
// global. FieldAccess covers both namespace calls and pre-rewrite UFCS calls.
resolve_direct_fcall := func(fcall: Expr, scope: TypeScope, symbols: SymbolPool) returns Option(ref Expr) {
    if fcall.node_type.is(NodeType.FCall).not() { return Option(ref Expr).None }
    if fcall.children.len() == 0 { return Option(ref Expr).None }
    ref callee : Expr = fcall.children[0]
    if callee.til_type().is(Type.FuncDef).not() { return Option(ref Expr).None }
    switch callee.node_type {
    case .Ident(cn):
        cb_o := scope.get_binding_sym(cn.ident_sym())
        if cb_o.is_none() { return Option(ref Expr).None }
        return scope.lookup_func_name(cb_o.unwrap().name, symbols)
    case .FieldAccess(cfa):
        if callee.children.len() == 0 { return Option(ref Expr).None }
        ref recv : Expr = callee.children[0]
        mut sdef_o := Option(ref Expr).None
        recv_name_o := expr_type_name_ref(recv)
        if recv_name_o.is_some() {
            sdef_o = scope.get_struct(recv_name_o.unwrap(), symbols)
        } else {
            switch recv.node_type {
            case .Ident(rid): sdef_o = scope.get_struct_by_sym(rid.ident_sym())
            case:
            }
        }
        if sdef_o.is_none() { return Option(ref Expr).None }
        nd_o := def_ns_get(sdef_o.unwrap(), cfa.field_access_name(symbols.names))
        if nd_o.is_none() { return Option(ref Expr).None }
        ref nd : Declaration = nd_o.unwrap()
        if nd.default_value.is_none() { return Option(ref Expr).None }
        ref dv : Expr = nd.default_expr()
        if dv.node_type.is(NodeType.FuncDef) { return safe_ref(dv) }
        switch dv.node_type {
        case .Ident(did): return scope.lookup_func_name(did.ident_name(symbols.names), symbols)
        case: return Option(ref Expr).None
        }
    case: return Option(ref Expr).None
    }
}

// #254 range cases: true when `e` is a `Range.new(lo, hi)` FCall -- the AST
// shape a `lo..hi` range pattern parses to. Used by the C-like switch path to
// recognise a `case lo..hi:` arm (emitted as a C case range `lo ... hi`).
is_range_new_call := func(e: Expr, symbols: SymbolPool) returns Bool {
    if e.node_type.is(NodeType.FCall).not() { return false }
    if e.children.len() != 3 { return false }
    ref callee : Expr = e.children[0]
    // Pre-inference the callee is `Range.new` (FieldAccess); the constructor
    // rewrite later collapses it to a bare `Range` (Ident). Accept both.
    switch callee.node_type {
    case .Ident(id): return id.ident_name(symbols.names) == "Range"
    case .FieldAccess(fa):
        if fa.field_access_name(symbols.names).eq("new").not() { return false }
        if callee.children.len() == 0 { return false }
        switch callee.children[0].node_type {
        case .Ident(bid): return bid.ident_name(symbols.names) == "Range"
        case: return false
        }
    case: return false
    }
}

// Debug pretty-printer for an AST subtree (s-expression-ish, one node per
// line). Not called by the compiler passes; kept for interactive debugging.
ast_print := proc(e: Expr, indent: U32, symbols: SymbolPool) {
    for _ in 0..indent {
        print("  ")
    }
    print("(", node_name(e.node_type))
    ref et : Type = e.til_type()
    if et.is(Type.Unknown).not() {
        print(":", til_type_name_c(et))
    }
    switch e.node_type {
    case .Ident(s):      print(" \"", s.ident_name(symbols.names), "\"")
    case .Literal(Literal.Str(s)): print(" \"", s, "\"")
    case .Literal(Literal.Num(s)): print(" \"", s.literal_num_text(), "\"")
    case .Literal(Literal.Bool(b)): if b { print(" true") } else { print(" false") }
    case .ForIn(fi):
        if fi.is_mut { print(" mut") }
        print(" \"", fi.name, "\"")
    case .Decl(decl):
        if decl.is_mut { print(" mut") }
        print(" ", decl.name)
    case .Assign(a):     print(" ", a.name)
    case .NamedArg(s):   print(" ", s)
    case .FuncDef(fdef): print(" ", func_type_name(fdef.sig.func_type))
    case: // nothing
    }
    if e.children.len() > 0 {
        println("")
        for e_i : Expr in e.children {
            ast_print(e_i, indent + 1, symbols)
        }
        for _ in 0..indent {
            print("  ")
        }
    }
    println(")")
}

// Per-call count of kwargs args. After desugar puts the FCall in
// param-aligned form, kwargs args are the trailing children block --
// kwargs is always the last parameter (the parser forbids any
// parameter after it) and NamedArg nodes only survive to that block
// (the NamedArg-to-fixed-slot matching at desugar time unwraps any
// NamedArg whose name matches a non-kwargs param). The count is
// therefore the consecutive trailing NamedArg child count: pre-rewrite
// = the kwargs args, post-rewrite = 0 (the rewrite replaces the
// NamedArg children with a single KwargsMap-setter ident).
fcall_kwargs_count := func(fcall: Expr) returns USize {
    switch fcall.node_type {
    case .FCall:
        mut count : USize = 0
        ref ch : Vec(Expr) = fcall.children
        mut i : USize = ch.len()
        while i > 0 {
            i--
            ref c : Expr = ch[i]
            if c.node_type.is(NodeType.NamedArg).not() { break }
            count++
        }
        return count
    case:
        UNREACHABLE("expected FCall")
        return 0
    }
}

// Per-call count of variadic args. Unlike kwargs, the variadic block
// is not always trailing: default-valued params may follow a variadic
// (parser.til allows it via the `has_default` guard), so the count
// cannot be derived from children length alone. It needs the callee's
// param count, plus whether the callee has a kwargs param (since
// kwargs trails the variadic when both are present and shifts the
// trailing-children accounting).
//
// Derivation (post-desugar param-aligned children, pre-variadic-rewrite):
//   children = 1 (callee) + (nparam - 1 - callee_has_kwargs)
//              + variadic_count + kwargs_count
// Solving for variadic_count:
//   - callee_has_kwargs : variadic_count
//       = children.len() - nparam + 1 - kwargs_count
//   - no kwargs         : variadic_count = children.len() - nparam
// kwargs_count comes from the structural trailing-NamedArg count
// (see fcall_kwargs_count) so neither path needs a stored kwargs index.
// Caller must guarantee the callee has a variadic param; the function
// is only meaningful in that case (no field check survives now that
// FCallData.variadic_index has been derived away).
fcall_variadic_count := func(fcall: Expr, nparam: USize, callee_has_kwargs: Bool) returns USize {
    switch fcall.node_type {
    case .FCall:
        if callee_has_kwargs {
            kc := fcall_kwargs_count(fcall)
            return fcall.children.len().add(1).sub(nparam) - kc
        }
        return fcall.children.len() - nparam
    case:
        UNREACHABLE("expected FCall")
        return 0
    }
}

// #326: shared lowering queries. These answer "what shape does the C
// backend give this expression" -- the builder needs them to emit, and the
// scavenger's C-emit reachability pass needs the identical answer to decide
// what the backend will call. One definition, both consumers, exactly the
// precedent rhs_is_allocator_call set in #303.



// --- Two-part key probes (perf) -------------------------------------
//
// The compiler's hot predicates ask "is `Type.method` registered?" of a
// Str-keyed table, and used to BUILD that key to ask: 82K joined Strs
// per test/first_class.til translate, each one a malloc for the box and
// one for the bytes, thrown away on the next line. Every such table is
// a sorted array searched by Str.cmp, so the join can be compared
// against a stored key part by part instead -- the same binary search,
// no allocation at all.

// Str.cmp(key, a + sep + b) without materialising the right-hand side.
priv qname_part_cmp := func(key: Str, off: USize, part: Str) returns I64 {
    avail := key.len().sub(off)
    mut m := avail
    if part.len() < m { m = part.len() }
    c := memcmp(ptr_add(key.c_str, off.to_uptr()), part.c_str, m.to_uptr())
    if c < 0 { return -1 }
    if c > 0 { return 1 }
    // Common prefix equal: the key running out first orders before the
    // join, which continues with this part's remaining bytes.
    if avail < part.len() { return -1 }
    return 0
}

qname_cmp := func(key: Str, a: Str, sep: Str, b: Str) returns I64 {
    ca := qname_part_cmp(key, 0, a)
    if ca != 0 { return ca }
    cs := qname_part_cmp(key, a.len(), sep)
    if cs != 0 { return cs }
    off := a.len().add(sep.len())
    cb := qname_part_cmp(key, off, b)
    if cb != 0 { return cb }
    // Every part matched; a longer key orders after the join.
    if key.len() > off.add(b.len()) { return 1 }
    return 0
}

// Index of `a + sep + b` in a sorted Vec(Str) of keys, -1 when absent.
// Map(Str, V) hands over its `keys` vec, so one search serves every
// value type.
qname_keys_index := func(keys: Vec(Str), a: Str, sep: Str, b: Str) returns I64 {
    mut lo : USize = 0
    mut hi : USize = keys.count
    while lo < hi {
        mid : USize = lo.add(hi.sub(lo) / 2)
        c := qname_cmp(keys.unsafe_get(mid), a, sep, b)
        if c < 0 { lo = mid + 1 }
        else {
            if c > 0 { hi = mid }
            else { return mid.to_i64() }
        }
    }
    return -1
}

// The Set(Str) twin: its elements are the sorted array itself.
qname_in_set := func(s: Set(Str), a: Str, sep: Str, b: Str) returns Bool {
    mut lo : USize = 0
    mut hi : USize = s.count
    while lo < hi {
        mid : USize = lo.add(hi.sub(lo) / 2)
        ref cur : Str = ptr_add(s.data, mid.to_uptr().mul(Str.size().to_uptr()))
        c := qname_cmp(cur, a, sep, b)
        if c < 0 { lo = mid + 1 }
        else {
            if c > 0 { hi = mid }
            else { return true }
        }
    }
    return false
}
