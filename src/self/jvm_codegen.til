mode lib
import("loader")
import("../std/file")


priv JvmEmitState := struct {
    path := ""
    errors : I32 = 0
    cells := Set(Str).new()
    cell_types := Map(Str, Str).new()
    raw_refs := Set(Str).new()
    callable_defs := Map(Str, Str).new()
    return_cell := false
    // #375: namespace data members ("Type.member") the program reads or
    // writes; Main.main initializes exactly these (jvm_emit_ns_inits).
    ns_used := Set(Str).new()
    // The current function returns a plain VALUE (not a raw Ptr, not a
    // cell): a raw ref returned there is loaded first (Vec.pop's
    // malloc'd `out`, C's `return *out`).
    return_loads_raw := false
}

// #326: one method of an emitted class, keyed by the name a caller spells.
priv JvmMember := struct {
    name := ""
    text := ""
    live := false
}

// #326: one emitted .java file. `head` and `tail` are the class's fixed
// text; its methods are members so jvm_mark_live can keep only the ones
// the finished program calls.
priv JvmClassOut := struct {
    path := ""
    name := ""
    head := ""
    members := Vec(JvmMember).new()
    tail := ""
    live := false
}

priv jvm_add_member := func(mut cls: JvmClassOut, name: Str, text: Str) {
    cls.members.push(own JvmMember(name = name.clone(), text = text.clone()))
}

priv jvm_file_head := func(package_name: Str) returns Str {
    return format("package ", package_name, ";\n\nimport til.runtime.TilRuntime;\n\n")
}

// Adds every identifier `src` spells to `words`, except the first spelling
// of `own_name`: a member's own declaration is not a call to it.
priv jvm_add_words := func(src: Str, own_name: Str, mut words: Set(Str)) {
    n := src.len()
    mut skipped_own := false
    mut i : USize = 0
    while i < n {
        if is_alnum(src.unsafe_get(i)).not() { i = i + 1 continue }
        start := i
        while i < n {
            if is_alnum(src.unsafe_get(i)).not() { break }
            i = i + 1
        }
        word := src.substr(start, i - start)
        if skipped_own.not().and(word.eq(own_name)) {
            skipped_own = true
            continue
        }
        if words.has(word).not() { words.add(own word.clone()) }
    }
}

// #326: the classes and members the finished program reaches. Everything
// is in memory before a byte is written, so the text itself is the
// authority, as in the HolyC prelude: Main and the runtime are the roots;
// a class is live once live text spells its name, and a member of a live
// class once live text spells its name outside its own declaration. Java
// cannot use a class or call a method without spelling its name, and the
// runtime reaches generated code only through the interfaces it declares,
// whose method names its own text spells. Same-named members of different
// classes (every `delete`) keep each other alive: text cannot tell their
// receivers apart, and keeping is the safe side.
priv jvm_mark_live := func(runtime_src: Str, mut classes: Vec(JvmClassOut)) {
    mut words := Set(Str).new()
    jvm_add_words(runtime_src, "", words)
    words.add(own "Main")
    mut changed := true
    while changed {
        changed = false
        for i in 0..classes.len() {
            ref mut cls : JvmClassOut = classes[i]
            if cls.live.not().and(words.has(cls.name)) {
                cls.live = true
                changed = true
                jvm_add_words(cls.head, cls.name, words)
                jvm_add_words(cls.tail, "", words)
            }
            if cls.live {
                for j in 0..cls.members.len() {
                    ref mut member : JvmMember = cls.members[j]
                    if member.live.not().and(words.has(member.name)) {
                        member.live = true
                        changed = true
                        jvm_add_words(member.text, member.name, words)
                    }
                }
            }
        }
    }
}

priv jvm_render_class := func(cls: JvmClassOut) returns Str {
    mut out := cls.head.clone()
    for member : JvmMember in cls.members {
        if member.live { out = format(out, member.text) }
    }
    return format(out, cls.tail)
}

priv jvm_hex_byte := func(byte: U8) returns Str {
    digits := "0123456789abcdef"
    hi := byte.shr(4).band(15).to_usize()
    lo := byte.band(15).to_usize()
    return format(digits.substr(hi, 1), digits.substr(lo, 1))
}

// Every non-ASCII byte and '_' uses an escape introduced by '_'. Since a
// source '_' is escaped too, the spelling is injective; the p_ prefix makes
// keywords, empty names and leading digits valid Java identifiers.
jvm_package_segment := func(name: Str) returns Str {
    mut out := Str.with_capacity(name.len().mul(4) + 2)
    out.push_str("p_")
    for i in 0..name.len() {
        ref c : I8 = name.get(i)
        alpha := c.gte('a').and(c.lte('z')).or(c.gte('A').and(c.lte('Z')))
        if alpha.or(c.gte('0').and(c.lte('9'))) {
            out.push_str(Str.from_byte(c.cast(U8)))
        } else {
            out.push_str("_x")
            out.push_str(jvm_hex_byte(c.cast(U8)))
        }
    }
    return out
}

priv jvm_var_name := func(name: Str) returns Str {
    return format("v_", jvm_package_segment(name))
}

priv jvm_func_name := func(name: Str) returns Str {
    return format("f_", jvm_package_segment(name))
}

priv jvm_unit_class := func(path: Str) returns Str {
    return format("Unit_", jvm_package_segment(path))
}

priv jvm_struct_class := func(name: Str) returns Str {
    return format("S_", jvm_package_segment(name))
}

priv jvm_enum_class := func(name: Str) returns Str {
    return format("E_", jvm_package_segment(name))
}

priv jvm_funcsig_class := func(fd: FunctionDef, symbols: SymbolPool) returns Str {
    mut key := "fn"
    for param : Declaration in fd.sig.params {
        mut ownership := "own"
        if param.own_type.is(OwnType.Ref) { ownership = "ref" }
        else if param.own_type.is(OwnType.Shallow) { ownership = "shallow" }
        if param.is_mut { ownership = format(ownership, "_mut") }
        key = format(key, "__", ownership, "_", decl_type_name_ref(param, symbols))
    }
    if fd.sig.return_type.len() == 0 { key = format(key, "__void") }
    else {
        mut return_ownership := "own"
        if fd.sig.return_own_type.is(OwnType.Ref) { return_ownership = "ref" }
        else if fd.sig.return_own_type.is(OwnType.Shallow) { return_ownership = "shallow" }
        key = format(key, "__returns_", return_ownership, "_", fd.sig.return_type)
    }
    return format("F_", jvm_package_segment(key))
}

priv jvm_indent := func(depth: I32) returns Str {
    mut out := Str.with_capacity(depth.to_usize().mul(4))
    for _ in 0..depth { out.push_str("    ") }
    return out
}

priv jvm_argfile_quote := func(path: Str) returns Str {
    mut out := Str.with_capacity(path.len().mul(2) + 2)
    out.push_str("\"")
    for i in 0..path.len() {
        ref c : I8 = path.get(i)
        if c.eq('\\').or(c.eq('"')) { out.push_str("\\") }
        out.push_str(Str.from_byte(c.cast(U8)))
    }
    out.push_str("\"")
    return out
}

priv jvm_byte_array := func(s: Str) returns Str {
    if s.len() == 0 { return "new byte[0]" }
    mut out := Str.with_capacity(s.len().mul(13) + 12)
    out.push_str("new byte[] {")
    for i in 0..s.len() {
        if i > 0 { out = format(out, ", ") }
        out = format(out, "(byte) 0x", jvm_hex_byte(s.get(i).cast(U8)))
    }
    return format(out, "}")
}

priv jvm_type := func(t: Type, symbols: SymbolPool) returns Str {
    switch t {
    case .None: return "void"
    case .Primitive(Primitive.I8): return "byte"
    case .Primitive(Primitive.U8): return "int"
    case .Primitive(Primitive.I16): return "short"
    case .Primitive(Primitive.U16): return "int"
    case .Primitive(Primitive.I32): return "int"
    case .Primitive(Primitive.U32): return "int"
    case .Primitive(Primitive.I64): return "long"
    case .Primitive(Primitive.U64): return "long"
    case .Primitive(Primitive.F32): return "float"
    case .Primitive(Primitive.F64): return "double"
    case .Primitive(Primitive.Bool): return "boolean"
    case .Struct(name):
        if name == "Str" { return "TilRuntime.Str" }
        return jvm_struct_class(name)
    case .StructSym(s_sym):
        ref sname_sym : Str = symbols.resolve(s_sym)
        if sname_sym == "Str" { return "TilRuntime.Str" }
        return jvm_struct_class(sname_sym)
    case .Enum(name): return jvm_enum_class(name)
    case .EnumSym(e_sym): return jvm_enum_class(symbols.resolve(e_sym))
    case .Dynamic: return "TilRuntime.Ptr"
    case:
    }
    return ""
}

// #375: USize and UPtr are per-build aliases whose width only the build's
// target knows (unsigned_prim_name_for_width is the one authority), and
// Java has no typedef to spell them with -- so every question this back
// end asks of a type (its Java carrier, its cell class, its scalar name,
// whether it is a scalar at all) asks it of the type the scope's target
// resolves the alias to. Spelling USize as `int` here once, while the
// typer gave its literals the target's U64, is how a USize local came out
// `int n = Long.parseUnsignedLong("4")`. Every other type comes back as it
// came.
priv jvm_concrete := func(t: Type, lp: LoadedProgram) returns Type {
    mut jc_alias := ""
    switch t {
    case .Custom(jc_name): jc_alias = jc_name.clone()
    case .CustomSym(jc_sym): jc_alias = lp.ctx.symbols.resolve(jc_sym).clone()
    case:
    }
    if jc_alias.eq("USize").or(jc_alias.eq("UPtr")) {
        return type_from_name_init_name(jc_alias, lp.ctx.scope, lp.ctx.symbols)
    }
    // Any other Custom name (a payload `ref StructPoint`, a type declared
    // after its first use) is the struct/enum/alias the scope resolves.
    if jc_alias.len() > 0 {
        return type_from_name_init_name(jc_alias, lp.ctx.scope, lp.ctx.symbols)
    }
    return t.clone()
}

// An integer constant in a scalar type's Java carrier.
priv jvm_int_const := func(t: Type, value: Str, lp: LoadedProgram) returns Str {
    if jvm_type_lp(t, lp).eq("long") { return format(value, "L") }
    return value.clone()
}

priv jvm_is_scalar := func(t: Type, lp: LoadedProgram) returns Bool {
    return is_primitive(jvm_concrete(t, lp))
}

// The scalar a namespace receiver names: `USize.add` is the target
// width's `add`.
priv jvm_concrete_scalar := func(name: Str, lp: LoadedProgram) returns Str {
    if name.eq("USize").or(name.eq("UPtr")) {
        return jvm_scalar_name(type_from_name_init_name(name, lp.ctx.scope, lp.ctx.symbols), lp)
    }
    return name.clone()
}

priv jvm_funcsig_def := func(t: Type, lp: LoadedProgram) returns Option(ref Expr) {
    switch t {
    case .FuncPtrSigSym(fsig_sym):
        fdef_sym_o := lp.ctx.scope.lookup_func_name(lp.ctx.symbols.resolve(fsig_sym), lp.ctx.symbols)
        if fdef_sym_o.is_some() {
            ref fexpr_sym : Expr = fdef_sym_o.unwrap()
            if fexpr_sym.node_type.is(NodeType.FuncDef).and(fexpr_sym.children.len() == 0) {
                return fdef_sym_o
            }
        }
    case .FuncPtrSig(name):
        fdef_o := lp.ctx.scope.lookup_func_name(name, lp.ctx.symbols)
        if fdef_o.is_some() {
            ref fexpr : Expr = fdef_o.unwrap()
            if fexpr.node_type.is(NodeType.FuncDef).and(fexpr.children.len() == 0) {
                return fdef_o
            }
        }
    case:
    }
    return Option(ref Expr).None
}

priv jvm_find_funcsig_class := func(class_name: Str,
    lp: LoadedProgram) returns Option(ref Expr) {
        for unit_path : Str in lp.unit_paths() {
            ref iu : ImportUnit = lp.ctx.imported[unit_path]
            for stmt : Expr in iu.ast.children {
                if stmt.children.len() == 0 { continue }
                if stmt.children[0].node_type.is(NodeType.FuncDef) {
                    ref fexpr : Expr = stmt.children[0]
                    if jvm_funcsig_class(funcdef_of(fexpr), lp.ctx.symbols) == class_name {
                        return safe_ref(fexpr)
                    }
                }
            }
        }
        return Option(ref Expr).None
}

priv jvm_type_lp := func(t: Type, lp: LoadedProgram) returns Str {
    out := jvm_type(jvm_concrete(t, lp), lp.ctx.symbols)
    if out.len() > 0 { return out }
    fdef_o := jvm_funcsig_def(t, lp)
    if fdef_o.is_some() { return jvm_funcsig_class(funcdef_of(fdef_o.unwrap()), lp.ctx.symbols) }
    return ""
}

priv jvm_storage_size := func(t: Type, lp: LoadedProgram) returns USize {
    switch t {
    case .Primitive(Primitive.I8): return 1
    case .Primitive(Primitive.U8): return 1
    case .Primitive(Primitive.Bool): return 1
    case .Primitive(Primitive.I16): return 2
    case .Primitive(Primitive.U16): return 2
    case .Primitive(Primitive.I32): return 4
    case .Primitive(Primitive.U32): return 4
    case .Primitive(Primitive.F32): return 4
    case .Primitive(Primitive.I64): return 8
    case .Primitive(Primitive.U64): return 8
    case .Primitive(Primitive.F64): return 8
    // A raw pointer, sized as the struct layouts size a Dynamic field
    // (initer's primitive_type_info: the host's UPtr) -- the 8 bytes
    // TilRuntime.storePtr writes on a 64-bit host.
    case .Dynamic: return UPtr.size()
    case .Struct(name): return ctx_total_size(name, lp.ctx)
    case .StructSym(size_ssym): return ctx_total_size(lp.ctx.symbols.resolve(size_ssym), lp.ctx)
    case .Enum(name): return ctx_total_size(name, lp.ctx)
    case .EnumSym(size_esym): return ctx_total_size(lp.ctx.symbols.resolve(size_esym), lp.ctx)
    case .Custom(name):
        resolved := type_from_name_init_name(name, lp.ctx.scope, lp.ctx.symbols)
        return jvm_storage_size(resolved, lp)
    case .CustomSym(size_csym):
        resolved_sym := type_from_sym_init(size_csym, lp.ctx.scope, lp.ctx.symbols)
        return jvm_storage_size(resolved_sym, lp)
    case:
        panic(__LOC__, "JVM storage size unavailable for ", type_name_ref(t, lp.ctx.symbols))
        return 0
    }
}

priv jvm_cell_type := func(t: Type, lp: LoadedProgram) returns Str {
    switch jvm_concrete(t, lp) {
    case .Primitive(Primitive.I8): return "TilRuntime.I8Slot"
    case .Primitive(Primitive.U8): return "TilRuntime.U8Slot"
    case .Primitive(Primitive.I16): return "TilRuntime.I16Slot"
    case .Primitive(Primitive.U16): return "TilRuntime.U16Slot"
    case .Primitive(Primitive.I32): return "TilRuntime.I32Slot"
    case .Primitive(Primitive.U32): return "TilRuntime.U32Slot"
    case .Primitive(Primitive.I64): return "TilRuntime.I64Slot"
    case .Primitive(Primitive.U64): return "TilRuntime.U64Slot"
    case .Primitive(Primitive.F32): return "TilRuntime.F32Slot"
    case .Primitive(Primitive.F64): return "TilRuntime.F64Slot"
    case .Primitive(Primitive.Bool): return "TilRuntime.BoolSlot"
    case: return ""
    }
}

priv jvm_cell_impl_type := func(t: Type, lp: LoadedProgram) returns Str {
    switch jvm_concrete(t, lp) {
    case .Primitive(Primitive.I8): return "TilRuntime.I8Cell"
    case .Primitive(Primitive.U8): return "TilRuntime.U8Cell"
    case .Primitive(Primitive.I16): return "TilRuntime.I16Cell"
    case .Primitive(Primitive.U16): return "TilRuntime.U16Cell"
    case .Primitive(Primitive.I32): return "TilRuntime.I32Cell"
    case .Primitive(Primitive.U32): return "TilRuntime.U32Cell"
    case .Primitive(Primitive.I64): return "TilRuntime.I64Cell"
    case .Primitive(Primitive.U64): return "TilRuntime.U64Cell"
    case .Primitive(Primitive.F32): return "TilRuntime.F32Cell"
    case .Primitive(Primitive.F64): return "TilRuntime.F64Cell"
    case .Primitive(Primitive.Bool): return "TilRuntime.BoolCell"
    case: return ""
    }
}

priv jvm_scalar_name := func(t: Type, lp: LoadedProgram) returns Str {
    switch jvm_concrete(t, lp) {
    case .Primitive(Primitive.I8): return "I8"
    case .Primitive(Primitive.U8): return "U8"
    case .Primitive(Primitive.I16): return "I16"
    case .Primitive(Primitive.U16): return "U16"
    case .Primitive(Primitive.I32): return "I32"
    case .Primitive(Primitive.U32): return "U32"
    case .Primitive(Primitive.I64): return "I64"
    case .Primitive(Primitive.U64): return "U64"
    case .Primitive(Primitive.F32): return "F32"
    case .Primitive(Primitive.F64): return "F64"
    case .Primitive(Primitive.Bool): return "Bool"
    case: return ""
    }
}

priv jvm_new_cell := func(t: Type, value: Str, lp: LoadedProgram) returns Str {
    return format("new ", jvm_cell_impl_type(t, lp), "(", value, ")")
}

priv jvm_cell_read := func(t: Type, cell: Str, lp: LoadedProgram) returns Str {
    return format(cell, ".get", jvm_scalar_name(t, lp), "()")
}

priv jvm_cell_write := func(t: Type, cell: Str, value: Str, lp: LoadedProgram) returns Str {
    return format(cell, ".set", jvm_scalar_name(t, lp), "(", value, ")")
}

priv jvm_cell_read_name := func(name: Str, cell: Str) returns Str {
    return format(cell, ".get", name, "()")
}

priv jvm_cell_write_name := func(name: Str, cell: Str, value: Str) returns Str {
    return format(cell, ".set", name, "(", value, ")")
}

priv jvm_is_scalar_name := func(name: Str) returns Bool {
    return name.eq("I8").or(name.eq("U8")).or(name.eq("I16"))
        .or(name.eq("U16")).or(name.eq("I32")).or(name.eq("U32"))
        .or(name.eq("I64")).or(name.eq("U64")).or(name.eq("F32"))
        .or(name.eq("F64")).or(name.eq("Bool"))
}

priv jvm_is_scalar_function_name := func(name: Str) returns Bool {
    return name.starts_with("I8_").or(name.starts_with("U8_"))
        .or(name.starts_with("I16_")).or(name.starts_with("U16_"))
        .or(name.starts_with("I32_")).or(name.starts_with("U32_"))
        .or(name.starts_with("I64_")).or(name.starts_with("U64_"))
        .or(name.starts_with("F32_")).or(name.starts_with("F64_"))
        .or(name.starts_with("Bool_"))
}

priv jvm_scalar_core_method := func(name: Str) returns Bool {
    return name.eq("add").or(name.eq("sub")).or(name.eq("mul"))
        .or(name.eq("div")).or(name.eq("mod")).or(name.eq("inc"))
        .or(name.eq("dec")).or(name.eq("eq")).or(name.eq("neq"))
        .or(name.eq("lt")).or(name.eq("gt")).or(name.eq("lte"))
        .or(name.eq("gte")).or(name.eq("band")).or(name.eq("bor"))
        .or(name.eq("bxor")).or(name.eq("bnot")).or(name.eq("shl"))
        .or(name.eq("shr"))
}

priv jvm_scalar_narrow := func(name: Str, expr: Str) returns Str {
    switch name {
    case "I8": return format("(byte) (", expr, ")")
    case "U8": return format("((", expr, ") & 0xff)")
    case "I16": return format("(short) (", expr, ")")
    case "U16": return format("((", expr, ") & 0xffff)")
    case: return format("(", expr, ")")
    }
}

priv jvm_fail_expr := proc(e: Expr, what: Str, mut state: JvmEmitState,
    names: Vec(Str)) returns Str {
        e.error(state.path, format("JVM backend does not support ", what,
            " (", e.node_type.head_str(names), ")"))
        state.errors++
        return ""
}

priv jvm_decl_type := proc(e: Expr, t: Type, mut state: JvmEmitState,
    lp: LoadedProgram) returns Str {
        out := jvm_type_lp(t, lp)
        if out.len() > 0 { return out }
        mut name := Str.clone(type_name_ref(t, lp.ctx.symbols))
        if name.len() == 0 { name = "unknown" }
        return jvm_fail_expr(e, format("type '", name, "'"), state, lp.ctx.symbols.names)
}

priv jvm_num_literal := proc(e: Expr, num: LiteralNumData,
    mut state: JvmEmitState, lp: LoadedProgram) returns Str {
        ref text : Str = num.literal_num_text()
        switch jvm_concrete(e.til_type(), lp) {
        case .Primitive(Primitive.I8): return format("(byte) (", text, ")")
        case .Primitive(Primitive.U8): return format("((", text, ") & 0xff)")
        case .Primitive(Primitive.I16): return format("(short) (", text, ")")
        case .Primitive(Primitive.U16): return format("((", text, ") & 0xffff)")
        case .Primitive(Primitive.I32): return text.clone()
        case .Primitive(Primitive.U32): return format("(int) (", text, "L)")
        case .Primitive(Primitive.I64): return format(text, "L")
        case .Primitive(Primitive.U64):
            if text.starts_with("0x").or(text.starts_with("0X"))
                .or(text.starts_with("0b")).or(text.starts_with("0B")) {
                return format(text, "L")
            }
            return format("Long.parseUnsignedLong(\"", text, "\")")
        case .Primitive(Primitive.F32):
            if text.eq("inf").or(text.eq("+inf")) { return "Float.POSITIVE_INFINITY" }
            if text == "-inf" { return "Float.NEGATIVE_INFINITY" }
            if text.eq("nan").or(text.eq("-nan")) { return "Float.NaN" }
            return format(text, "f")
        case .Primitive(Primitive.F64):
            if text.eq("inf").or(text.eq("+inf")) { return "Double.POSITIVE_INFINITY" }
            if text == "-inf" { return "Double.NEGATIVE_INFINITY" }
            if text.eq("nan").or(text.eq("-nan")) { return "Double.NaN" }
            return format(text, "d")
        case:
        }
        return jvm_fail_expr(e, "untyped numeric literal", state, lp.ctx.symbols.names)
}

priv jvm_narrow := func(t: Type, expr: Str) returns Str {
    switch t {
    case .Primitive(Primitive.I8): return format("(byte) (", expr, ")")
    case .Primitive(Primitive.U8): return format("((", expr, ") & 0xff)")
    case .Primitive(Primitive.I16): return format("(short) (", expr, ")")
    case .Primitive(Primitive.U16): return format("((", expr, ") & 0xffff)")
    case .Primitive(Primitive.F32): return format("(float) (", expr, ")")
    case: return format("(", expr, ")")
    }
}

// A scalar type's method this back end lowers natively (arithmetic and
// comparisons, the ext conversions, clone/cmp/to_str, delete) rather than
// calling its til body. Anything else (`I64.safe_div`) is an ordinary
// til function and is emitted like one.
priv jvm_scalar_method_is_native := func(name: Str) returns Bool {
    if jvm_is_scalar_function_name(name).not() { return false }
    sep := name.find("_").to_usize()
    method := name.substr(sep + 1, name.len() - sep - 1)
    return jvm_scalar_core_method(method).or(method.eq("clone")).or(method.eq("cmp"))
        .or(method.eq("to_str")).or(method.eq("to_repr")).or(method.starts_with("to_"))
        .or(method.eq("from_i64")).or(method.eq("delete"))
}

priv jvm_runtime_bound_function := func(name: Str) returns Bool {
    if jvm_scalar_method_is_native(name) { return true }
    if name.eq("println").or(name.eq("print")).or(name.eq("eprintln"))
        .or(name.eq("eprint")).or(name.eq("print_single"))
        .or(name.eq("eprint_single")).or(name.eq("print_flush"))
        .or(name.eq("exit")).or(name.eq("Str_clone")).or(name.eq("Str_eq"))
        .or(name.eq("Str_delete")).or(name.eq("adopt__Str"))
        .or(name.eq("usize_to_uptr")).or(name.eq("malloc"))
        .or(name.eq("calloc")).or(name.eq("realloc")).or(name.eq("free"))
        .or(name.eq("ptr_add")).or(name.eq("memcpy")).or(name.eq("memmove"))
        .or(name.eq("memset")).or(name.eq("memcmp")).or(name.eq("ptr_eq"))
        .or(name.eq("is_null")).or(name.eq("deref")).or(name.eq("write_ptr"))
        .or(name.starts_with("write_")).or(name.eq("panic")).or(name.eq("to_ptr")).or(name.eq("noop_proc")).or(name.eq("dyn_size_of"))
        .or(name.eq("assert")).or(name.starts_with("assert_eq__"))
        .or(name.eq("expect")) { return true }
    return false
}

priv jvm_function_class := func(name: Str, lp: LoadedProgram) returns Str {
    for unit_path : Str in lp.unit_paths() {
        ref iu : ImportUnit = lp.ctx.imported[unit_path]
        for stmt : Expr in iu.ast.children {
            switch stmt.node_type {
                case .Decl(dd):
                    if dd.name.eq(name) {
                    if stmt.children.len() > 0 {
                        if stmt.children[0].node_type.is(NodeType.FuncDef) {
                            return jvm_unit_class(unit_path)
                        }
                    }
                    if stmt.children.len() > 0 {
                        if stmt.children[0].node_type.is(NodeType.StructDef) {
                            ref sd : StructDef = structdef_of(stmt.children[0])
                            for i in 0..sd.ns_decls.len() {
                                if name == format(dd.name, "_", sd.member_name_at(i)) {
                                    return jvm_struct_class(dd.name)
                                }
                            }
                        } else if stmt.children[0].node_type.is(NodeType.EnumDef) {
                            ref ed : EnumDef = enumdef_of(stmt.children[0])
                            for i in 0..ed.ns_decls.len() {
                                if name == format(dd.name, "_", ed.member_name_at(i)) {
                                    return jvm_enum_class(dd.name)
                                }
                            }
                        }
                    }
                }
            case:
            }
        }
    }
    for i in 0..lp.ctx.struct_layouts.len() {
        ref type_name : Str = lp.ctx.struct_layouts.keys.unsafe_get(i)
        def_o := lp.ctx.scope.get_struct(type_name, lp.ctx.symbols)
        if def_o.is_some() {
            ref def_expr : Expr = def_o.unwrap()
            if def_expr.node_type.is(NodeType.StructDef) {
                ref sd : StructDef = structdef_of(def_expr)
                for mi in 0..sd.ns_decls.len() {
                    if name == format(type_name, "_", sd.member_name_at(mi)) {
                        return "Functions"
                    }
                }
            } else if def_expr.node_type.is(NodeType.EnumDef) {
                ref ed : EnumDef = enumdef_of(def_expr)
                for mi in 0..ed.ns_decls.len() {
                    if name == format(type_name, "_", ed.member_name_at(mi)) {
                        return "Functions"
                    }
                }
            }
        }
    }
    fdef_o := jvm_find_fdef(name, lp)
    if fdef_o.is_some() {
        ref fd : FunctionDef = funcdef_of(fdef_o.unwrap())
        if fd.namespace_decl.is_some() {
            ref owner : Declaration = fd.namespace_decl.unwrap()
            owner_def_o := lp.ctx.scope.get_struct(owner.name, lp.ctx.symbols)
            if owner_def_o.is_some() {
                ref owner_def : Expr = owner_def_o.unwrap()
                if owner_def.node_type.is(NodeType.EnumDef) { return "Functions" }
                if owner_def.node_type.is(NodeType.StructDef) { return "Functions" }
            }
        }
    }
    if fdef_o.is_some() { return "Functions" }
    return ""
}

priv jvm_find_fdef := func(name: Str, lp: LoadedProgram) returns Option(ref Expr) {
    for unit_path : Str in lp.unit_paths() {
        ref iu : ImportUnit = lp.ctx.imported[unit_path]
        for stmt : Expr in iu.ast.children {
            switch stmt.node_type {
            case .Decl(dd):
                if stmt.children.len() > 0 {
                    if dd.name.eq(name).and(stmt.children[0].node_type.is(NodeType.FuncDef)) {
                        return safe_ref(stmt.children[0])
                    }
                    if stmt.children[0].node_type.is(NodeType.StructDef) {
                        ref sd : StructDef = structdef_of(stmt.children[0])
                        for i in 0..sd.ns_decls.len() {
                            if name == format(dd.name, "_", sd.member_name_at(i)) {
                                ref member : Declaration = sd.member_at(i)
                                if member.default_value.is_some() {
                                    ref fexpr : Expr = member.default_expr()
                                    if fexpr.node_type.is(NodeType.FuncDef) {
                                        return safe_ref(fexpr)
                                    }
                                }
                            }
                        }
                    } else if stmt.children[0].node_type.is(NodeType.EnumDef) {
                        ref ed : EnumDef = enumdef_of(stmt.children[0])
                        for i in 0..ed.ns_decls.len() {
                            if name == format(dd.name, "_", ed.member_name_at(i)) {
                                ref member : Declaration = ed.member_at(i)
                                if member.default_value.is_some() {
                                    ref fexpr : Expr = member.default_expr()
                                    if fexpr.node_type.is(NodeType.FuncDef) {
                                        return safe_ref(fexpr)
                                    }
                                }
                            }
                        }
                    }
                }
            case:
            }
        }
    }
    for i in 0..lp.ctx.struct_layouts.len() {
        ref type_name : Str = lp.ctx.struct_layouts.keys.unsafe_get(i)
        def_o := lp.ctx.scope.get_struct(type_name, lp.ctx.symbols)
        if def_o.is_some() {
            ref def_expr : Expr = def_o.unwrap()
            if def_expr.node_type.is(NodeType.StructDef) {
                ref sd : StructDef = structdef_of(def_expr)
                for mi in 0..sd.ns_decls.len() {
                    if name == format(type_name, "_", sd.member_name_at(mi)) {
                        ref member : Declaration = sd.member_at(mi)
                        if member.default_value.is_some() {
                            ref fexpr : Expr = member.default_expr()
                            if fexpr.node_type.is(NodeType.FuncDef) { return safe_ref(fexpr) }
                        }
                    }
                }
            } else if def_expr.node_type.is(NodeType.EnumDef) {
                ref ed : EnumDef = enumdef_of(def_expr)
                for mi in 0..ed.ns_decls.len() {
                    if name == format(type_name, "_", ed.member_name_at(mi)) {
                        ref member : Declaration = ed.member_at(mi)
                        if member.default_value.is_some() {
                            ref fexpr : Expr = member.default_expr()
                            if fexpr.node_type.is(NodeType.FuncDef) { return safe_ref(fexpr) }
                        }
                    }
                }
            }
        }
    }
    return lp.ctx.scope.lookup_func_symbol_name(name, lp.ctx.symbols)
}

priv jvm_fcall_name := func(e: Expr, lp: LoadedProgram) returns Str {
    if e.node_type.is(NodeType.FCall).not().or(e.children.len() == 0) { return "" }
    ref callee : Expr = e.children[0]
    switch callee.node_type {
    case .Ident(id): return id.ident_name(lp.ctx.symbols.names).clone()
    case .FieldAccess(fa):
        if callee.children.len() != 1 { return "" }
        switch callee.children[0].node_type {
        case .Ident(owner):
            return format(owner.ident_name(lp.ctx.symbols.names), "_",
                fa.field_access_name(lp.ctx.symbols.names))
        case: return ""
        }
    case: return ""
    }
}

priv jvm_fcall_funcsig := func(e: Expr, lp: LoadedProgram) returns Option(ref Expr) {
    if e.node_type.is(NodeType.FCall).not().or(e.children.len() == 0) {
        return Option(ref Expr).None
    }
    ref callee : Expr = e.children[0]
    fdef_o := jvm_funcsig_def(callee.til_type(), lp)
    if fdef_o.is_some() { return fdef_o }
    return resolve_fn_sig(e, lp.ctx.scope, lp.ctx.symbols)
}

priv jvm_expr_funcsig := func(e: Expr, state: JvmEmitState,
    lp: LoadedProgram) returns Option(ref Expr) {
        fdef_o := jvm_funcsig_def(e.til_type(), lp)
        if fdef_o.is_some() { return fdef_o }
        switch e.node_type {
        case .Ident(id):
            ref name : Str = id.ident_name(lp.ctx.symbols.names)
            if state.callable_defs.has(name) {
                return jvm_find_funcsig_class(state.callable_defs[name], lp)
            }
            symbol_o := lp.ctx.scope.lookup_func_by_sym(id.ident_sym(), lp.ctx.symbols)
            if symbol_o.is_some() {
                ref symbol_fdef : Expr = symbol_o.unwrap()
                if symbol_fdef.children.len() > 0 { return symbol_o }
            }
            direct_o := jvm_find_fdef(name, lp)
            if direct_o.is_some() {
                ref direct : Expr = direct_o.unwrap()
                if direct.children.len() > 0 { return direct_o }
            }
        case .FuncDef: return safe_ref(e)
        case:
        }
        return Option(ref Expr).None
}

priv jvm_emit_fcall_funcsig := func(e: Expr, state: JvmEmitState,
    lp: LoadedProgram) returns Option(ref Expr) {
        switch e.children[0].node_type {
        case .Ident(id):
            ref direct_name : Str = id.ident_name(lp.ctx.symbols.names)
            if state.callable_defs.has(direct_name).not() {
                direct_o := jvm_find_fdef(direct_name, lp)
                if direct_o.is_some() {
                    if direct_o.unwrap().children.len() > 0 {
                        return Option(ref Expr).None
                    }
                }
            }
        case:
        }
        sig_o := jvm_fcall_funcsig(e, lp)
        if sig_o.is_some() { return sig_o }
        switch e.children[0].node_type {
        case .Ident(id):
            ref name : Str = id.ident_name(lp.ctx.symbols.names)
            if state.callable_defs.has(name) {
                return jvm_find_funcsig_class(state.callable_defs[name], lp)
            }
        case:
        }
        return Option(ref Expr).None
}

priv jvm_collect_reachable := proc(e: Expr, mut names: Vec(Str),
    mut seen: Set(Str), lp: LoadedProgram) {
        if e.node_type.is(NodeType.FCall) {
            name := jvm_fcall_name(e, lp)
            if (name.len() > 0).and(seen.has(name).not()) {
                seen.add(own name.clone())
                names.push(own name.clone())
                if jvm_runtime_bound_function(name).not() {
                    fdef_o := jvm_find_fdef(name, lp)
                    if fdef_o.is_some() {
                        ref fexpr : Expr = fdef_o.unwrap()
                        ref fd : FunctionDef = funcdef_of(fexpr)
                        if fd.sig.func_type.is_bodyless().not() {
                            for child : Expr in fexpr.children {
                                jvm_collect_reachable(child, names, seen, lp)
                            }
                        }
                    }
                }
            }
        }
        if e.node_type.is(NodeType.Ident).and(e.til_type().is(Type.FuncDef)) {
            switch e.node_type {
            case .Ident(id):
                ref name : Str = id.ident_name(lp.ctx.symbols.names)
                if seen.has(name).not() {
                    fdef_o := jvm_find_fdef(name, lp)
                    if fdef_o.is_some() {
                        ref fexpr : Expr = fdef_o.unwrap()
                        if fexpr.children.len() > 0 {
                            seen.add(own name.clone())
                            names.push(own name.clone())
                            for child : Expr in fexpr.children {
                                jvm_collect_reachable(child, names, seen, lp)
                            }
                        }
                    }
                }
            case:
            }
        }
        for child : Expr in e.children { jvm_collect_reachable(child, names, seen, lp) }
}

priv jvm_top_level_function_class := func(name: Str, lp: LoadedProgram) returns Str {
    for unit_path : Str in lp.unit_paths() {
        ref iu : ImportUnit = lp.ctx.imported[unit_path]
        for stmt : Expr in iu.ast.children {
            switch stmt.node_type {
            case .Decl(dd):
                if (dd.name == name).and(stmt.children.len() > 0) {
                    if stmt.children[0].node_type.is(NodeType.FuncDef) {
                        return jvm_unit_class(unit_path)
                    }
                }
            case:
            }
        }
    }
    return ""
}

priv jvm_static_function_value := func(name: Str, lp: LoadedProgram) returns Str {
    fdef_o := jvm_find_fdef(name, lp)
    if fdef_o.is_none() { return "" }
    if fdef_o.unwrap().children.len() == 0 { return "" }
    cls := jvm_function_class(name, lp)
    if cls.len() == 0 { return "" }
    // A static function's value has no lifetime (TilRuntime.staticClosure).
    // REM: the explicit type argument gives the method reference a target
    // even where the call itself has none (eg under a cast).
    sig_cls := jvm_funcsig_class(funcdef_of(fdef_o.unwrap()), lp.ctx.symbols)
    return format("TilRuntime.<", sig_cls, ">staticClosure(", cls, "::", jvm_func_name(name), ")")
}

priv jvm_call_graph_has := func(e: Expr, wanted: Str,
    lp: LoadedProgram, depth: I32 = 32) returns Bool {
        if depth == 0 { return false }
        if e.node_type.is(NodeType.FCall) {
            name := jvm_fcall_name(e, lp)
            if name == wanted { return true }
            fdef_o := jvm_find_fdef(name, lp)
            if fdef_o.is_some() {
                ref fexpr : Expr = fdef_o.unwrap()
                ref fd : FunctionDef = funcdef_of(fexpr)
                if fd.sig.func_type.is_bodyless().not() {
                    for child : Expr in fexpr.children {
                        if jvm_call_graph_has(child, wanted, lp, depth - 1) { return true }
                    }
                }
            }
        }
        for child : Expr in e.children {
            if jvm_call_graph_has(child, wanted, lp, depth - 1) { return true }
        }
        return false
}

priv jvm_param_bit := func(i: USize) returns U64 {
    if i >= 64 { return 0 }
    one : U64 = 1
    return one.shl(i.to_u64())
}

priv jvm_param_needs_cell := func(fd: FunctionDef, i: USize, lp: LoadedProgram) returns Bool {
    if i >= fd.sig.params.len() { return false }
    ref param : Declaration = fd.sig.params[i]
    if jvm_is_scalar(param.til_type, lp).not() { return false }
    if param.own_type.is(OwnType.Shallow).not().or(param.is_mut) { return true }
    bit := jvm_param_bit(i)
    return fd.ref_return_params.band(bit) != 0
}

// #375: the signature is what CALLERS read, so a by-value scalar parameter
// arrives as a value -- yet the body may still need it as a cell, because
// it hands the parameter to a callee's cell parameter (Array.unsafe_set
// passing its `i` to unsafe_get, whose ref return may borrow it). Two
// answers to one question was `long cannot be converted to U64Slot`. The
// body's answer wins inside the body: the parameter is boxed on entry, the
// way a local the body addresses is declared as a cell.
priv jvm_param_boxed_on_entry := func(param: Declaration, sig_cells: Set(Str),
    state: JvmEmitState, lp: LoadedProgram) returns Bool {
        if sig_cells.has(param.name) { return false }
        if state.cells.has(param.name).not() { return false }
        return jvm_is_scalar(param.til_type, lp)
}

// The incoming value's name. jvm_var_name escapes every '_' a til name
// spells, so this suffix cannot collide with one.
priv jvm_param_arg_name := func(name: Str) returns Str {
    return format(jvm_var_name(name), "_arg")
}

priv jvm_param_box := func(param: Declaration, arg: Str, depth: I32,
    lp: LoadedProgram) returns Str {
        return format(jvm_indent(depth), jvm_cell_type(param.til_type, lp), " ",
            jvm_var_name(param.name), " = ", jvm_new_cell(param.til_type, arg, lp), ";\n")
}

priv jvm_signature_param_type := func(fd: FunctionDef, i: USize,
    lp: LoadedProgram) returns Str {
        ref param : Declaration = fd.sig.params[i]
        mut param_type := param.til_type.clone()
        if fd.sig.variadic_index == i.to_i32() {
            param_type = Type.StructSym(sym_of(format("Array__", decl_type_name_ref(param, lp.ctx.symbols)), lp.ctx.symbols))
        }
        mut out := jvm_type_lp(param_type, lp)
        if out.len() == 0 {
            param_type = type_from_name_init_name(decl_type_name_ref(param, lp.ctx.symbols), lp.ctx.scope, lp.ctx.symbols)
            out = jvm_type_lp(param_type, lp)
        }
        if jvm_param_needs_cell(fd, i, lp) { return jvm_cell_type(param_type, lp) }
        return out
}

priv jvm_signature_return_type := func(fd: FunctionDef, lp: LoadedProgram) returns Str {
    if fd.sig.return_type.len() == 0 { return "void" }
    rt := type_from_name_init_name(fd.sig.return_type, lp.ctx.scope, lp.ctx.symbols)
    if fd.sig.return_own_type.is(OwnType.Shallow).not().and(jvm_is_scalar(rt, lp)) {
        return jvm_cell_type(rt, lp)
    }
    return jvm_type_lp(rt, lp)
}

priv jvm_collect_cells := proc(e: Expr, mut cells: Set(Str),
    mut raw_refs: Set(Str), lp: LoadedProgram) {
    switch e.node_type {
    case .FuncDef(fd):
        for capture : Declaration in fd.captures {
            if capture.is_mut.and(capture.own_type.is(OwnType.Ref))
                .and(jvm_is_scalar(capture.til_type, lp)).and(cells.has(capture.name).not()) {
                cells.add(own capture.name.clone())
            }
        }
    case .CaptureBlock(cbd):
        for capture : Declaration in cbd.captures {
            if capture.is_mut.and(capture.own_type.is(OwnType.Ref))
                .and(jvm_is_scalar(capture.til_type, lp)).and(cells.has(capture.name).not()) {
                cells.add(own capture.name.clone())
            }
        }
    case .BodyValue(cbd):
        for capture : Declaration in cbd.captures {
            if capture.is_mut.and(capture.own_type.is(OwnType.Ref))
                .and(jvm_is_scalar(capture.til_type, lp)).and(cells.has(capture.name).not()) {
                cells.add(own capture.name.clone())
            }
        }
    case .Decl(dd):
        mut raw_init := false
        if e.children.len() > 0 {
            raw_init = e.children[0].til_type().is(Type.Dynamic)
            if e.children[0].node_type.is(NodeType.FCall) {
                init_name := jvm_fcall_name(e.children[0], lp)
                raw_init = raw_init.or(init_name.eq("ptr_add")).or(init_name.eq("malloc"))
                    .or(init_name.eq("calloc")).or(init_name.eq("realloc"))
                init_fdef_o := jvm_find_fdef(init_name, lp)
                if init_fdef_o.is_some() {
                    ref init_fexpr : Expr = init_fdef_o.unwrap()
                    ref init_fd : FunctionDef = funcdef_of(init_fexpr)
                    raw_init = raw_init.or(init_fd.sig.return_own_type.is(OwnType.Ref)
                        .and(jvm_call_graph_has(init_fexpr, "ptr_add", lp)))
                }
            }
        }
        if raw_init {
            if raw_refs.has(dd.name).not() { raw_refs.add(own dd.name.clone()) }
        } else if jvm_is_scalar(dd.til_type, lp).and(dd.own_type.is(OwnType.Shallow).or(
            cells.has(dd.name)).not()) {
            cells.add(own dd.name.clone())
        }
        // #375: a scalar `ref` binding of a plain name shares that name's
        // storage (jvm_emit_cell_ref of its right-hand side), so the name
        // must be a cell too. `for i in 0..count` borrows `count` for the
        // loop's bound this way.
        if raw_init.not().and(dd.own_type.is(OwnType.Ref)).and(jvm_is_scalar(dd.til_type, lp)) {
            switch e.children[0].node_type {
            case .Ident(ref_src):
                ref ref_src_name : Str = ref_src.ident_name(lp.ctx.symbols.names)
                if raw_refs.has(ref_src_name).or(cells.has(ref_src_name)).not() {
                    cells.add(own ref_src_name.clone())
                }
            case:
            }
        }
    case .FCall:
        name := jvm_fcall_name(e, lp)
        ref callee : Expr = e.children[0]
        sig_o := jvm_fcall_funcsig(e, lp)
        if sig_o.is_some() {
            ref sig_fd : FunctionDef = funcdef_of(sig_o.unwrap())
            for i in 1..e.children.len() {
                if jvm_param_needs_cell(sig_fd, i - 1, lp) {
                    switch e.children[i].node_type {
                    case .Ident(id):
                        ref arg_name : Str = id.ident_name(lp.ctx.symbols.names)
                        if jvm_is_scalar(e.children[i].til_type(), lp).and(cells.has(arg_name).not()) {
                            cells.add(own arg_name.clone())
                        }
                    case:
                    }
                }
            }
        }
        switch callee.node_type {
        case .FieldAccess(fa):
            ref method : Str = fa.field_access_name(lp.ctx.symbols.names)
            if method.eq("inc").or(method.eq("dec")) {
                if e.children.len() == 2 {
                    switch e.children[1].node_type {
                    case .Ident(id):
                        ref arg_name : Str = id.ident_name(lp.ctx.symbols.names)
                        if jvm_is_scalar(e.children[1].til_type(), lp).and(cells.has(arg_name).not()) {
                            cells.add(own arg_name.clone())
                        }
                    case:
                    }
                }
            }
        case:
        }
        if (name.len() > 0).and(jvm_is_scalar_function_name(name).not()) {
            struct_o := lp.ctx.scope.get_struct(name, lp.ctx.symbols)
            if struct_o.is_some() {
                ref struct_expr : Expr = struct_o.unwrap()
                if struct_expr.node_type.is(NodeType.StructDef) {
                    ref sd : StructDef = structdef_of(struct_expr)
                    for i in 1..e.children.len() {
                        ref field : Declaration = sd.field_at(i - 1)
                        if jvm_is_scalar(field.til_type, lp).and(field.own_type.is(OwnType.Ref)) {
                            switch e.children[i].node_type {
                            case .Ident(id):
                                ref arg_name : Str = id.ident_name(lp.ctx.symbols.names)
                                if cells.has(arg_name).not() { cells.add(own arg_name.clone()) }
                            case:
                            }
                        }
                    }
                }
            }
        }
        // A scalar type's til-written method (`I64.safe_div`, whose
        // throws lowering adds an `_err_kind` out-param) is emitted as an
        // ordinary call with typed args (jvm_emit_typed_args), so its
        // cell params need cell args here too.
        if name.len() > 0 {
            fdef_o := jvm_find_fdef(name, lp)
            if fdef_o.is_some() {
                ref fd : FunctionDef = funcdef_of(fdef_o.unwrap())
                if fd.sig.func_type.is_bodyless().not() {
                    for i in 1..e.children.len() {
                        pi := i - 1
                        if jvm_param_needs_cell(fd, pi, lp) {
                            switch e.children[i].node_type {
                            case .Ident(id):
                                ref arg_name : Str = id.ident_name(lp.ctx.symbols.names)
                                if jvm_is_scalar(e.children[i].til_type(), lp).and(cells.has(arg_name).not()) {
                                    cells.add(own arg_name.clone())
                                }
                            case:
                            }
                        }
                    }
                }
            }
        }
    case:
    }
    for child : Expr in e.children { jvm_collect_cells(child, cells, raw_refs, lp) }
}

// Cells are tracked by name per function, but a name can be bound again
// with another type in a sibling scope (the switch arms of a generated enum
// eq bind `_sp` as an I64 ref in one arm and a struct ref in another); only
// a SCALAR binding of the name is the cell.
priv jvm_is_cell := func(state: JvmEmitState, name: Str, t: Type,
    lp: LoadedProgram) returns Bool {
        return state.cells.has(name).and(jvm_is_scalar(t, lp))
}

priv jvm_expr_is_raw_ref := func(e: Expr, state: JvmEmitState,
    names: Vec(Str)) returns Bool {
    switch e.node_type {
    case .Ident(id): return state.raw_refs.has(id.ident_name(names))
    case: return e.til_type().is(Type.Dynamic)
    }
}

priv jvm_collect_return_cells := proc(e: Expr, mut cells: Set(Str),
    lp: LoadedProgram) {
        if e.node_type.is(NodeType.Return).and(e.children.len() == 1) {
            switch e.children[0].node_type {
            case .Ident(id):
                ref name : Str = id.ident_name(lp.ctx.symbols.names)
                if cells.has(name).not() { cells.add(own name.clone()) }
            case:
            }
        }
        for child : Expr in e.children { jvm_collect_return_cells(child, cells, lp) }
}

priv jvm_collect_cell_types := proc(e: Expr, mut cell_types: Map(Str, Str), lp: LoadedProgram) {
    switch e.node_type {
    case .Decl(dd):
        resolved := declaration_resolved_type(dd, lp.ctx.scope, lp.ctx.symbols)
        if jvm_is_scalar(resolved, lp) {
            cell_types.set(dd.name, own jvm_scalar_name(resolved, lp))
        }
    case .FuncDef(fd):
        for capture : Declaration in fd.captures {
            resolved := declaration_resolved_type(capture, lp.ctx.scope, lp.ctx.symbols)
            if jvm_is_scalar(resolved, lp) { cell_types.set(capture.name, own jvm_scalar_name(resolved, lp)) }
        }
    case .CaptureBlock(cbd):
        for capture : Declaration in cbd.captures {
            resolved := declaration_resolved_type(capture, lp.ctx.scope, lp.ctx.symbols)
            if jvm_is_scalar(resolved, lp) { cell_types.set(capture.name, own jvm_scalar_name(resolved, lp)) }
        }
    case .BodyValue(cbd):
        for capture : Declaration in cbd.captures {
            resolved := declaration_resolved_type(capture, lp.ctx.scope, lp.ctx.symbols)
            if jvm_is_scalar(resolved, lp) { cell_types.set(capture.name, own jvm_scalar_name(resolved, lp)) }
        }
    case:
    }
    for child : Expr in e.children { jvm_collect_cell_types(child, cell_types, lp) }
}

priv jvm_fcall_returns_cell := func(e: Expr, lp: LoadedProgram) returns Bool {
    name := jvm_fcall_name(e, lp)
    if name.len() == 0 { return false }
    fdef_o := jvm_find_fdef(name, lp)
    if fdef_o.is_none() { return false }
    ref fd : FunctionDef = funcdef_of(fdef_o.unwrap())
    if jvm_call_graph_has(fdef_o.unwrap(), "ptr_add", lp) { return false }
    if fd.sig.return_own_type.is(OwnType.Shallow) { return false }
    if fd.sig.return_type.len() == 0 { return false }
    rt := type_from_name_init_name(fd.sig.return_type, lp.ctx.scope, lp.ctx.symbols)
    return jvm_is_scalar(rt, lp)
}

priv jvm_fcall_returns_raw_ref := func(e: Expr, lp: LoadedProgram) returns Bool {
    name := jvm_fcall_name(e, lp)
    if name.len() == 0 { return false }
    fdef_o := jvm_find_fdef(name, lp)
    if fdef_o.is_none() { return false }
    ref fd : FunctionDef = funcdef_of(fdef_o.unwrap())
    return fd.sig.return_own_type.is(OwnType.Ref)
        .and(jvm_call_graph_has(fdef_o.unwrap(), "ptr_add", lp))
}

priv jvm_emit_cell_ref := proc(e: Expr, mut state: JvmEmitState,
    lp: LoadedProgram) returns Str {
        switch e.node_type {
        case .Literal(Literal.Null): return "null"
        case .Ident(id):
            ref name : Str = id.ident_name(lp.ctx.symbols.names)
            if state.raw_refs.has(name) { return jvm_var_name(name) }
            if jvm_is_cell(state, name, e.til_type(), lp) { return jvm_var_name(name) }
        case .FCall:
            if jvm_fcall_name(e, lp) == "get_payload" {
                return format("TilRuntime.payloadSlot(", jvm_emit_expr(e.children[1], state, lp), ")")
            }
            if jvm_fcall_returns_cell(e, lp).or(jvm_fcall_returns_raw_ref(e, lp)) {
                ref callee : Expr = e.children[0]
                switch callee.node_type {
                case .Ident(id): return jvm_emit_named_call(e, id.ident_name(lp.ctx.symbols.names), state, lp)
                case .FieldAccess: return jvm_emit_namespace_call(e, callee, state, lp)
                case:
                }
            }
        case .FieldAccess(fa):
            if e.children.len().eq(1).and(jvm_is_scalar(e.til_type(), lp)) {
                ref cr_member : Str = fa.field_access_name(lp.ctx.symbols.names)
                cr_owner := jvm_ns_data_owner(e.children[0], cr_member, lp)
                if cr_owner.len() > 0 { return jvm_ns_static(e, cr_owner, cr_member, state, lp) }
                obj := jvm_emit_value(e.children[0], state, lp)
                return format(obj, ".", jvm_field_getter(cr_member))
            }
        case:
        }
        return jvm_fail_expr(e, "non-addressable scalar ref", state, lp.ctx.symbols.names)
}

// #375: the struct/enum whose NAMESPACE holds `member` as data, when a
// field access names one -- `Counter.instance_count`, or
// `c.instance_count` through an instance, which C reads from the same
// global. "" when it is not namespace data (an instance field).
priv jvm_ns_data_owner := func(receiver: Expr, member: Str, lp: LoadedProgram) returns Str {
    rt := jvm_concrete(receiver.til_type(), lp)
    mut tname := ""
    if is_struct_type(rt).or(is_enum_type(rt)) { tname = Str.clone(type_name_ref(rt, lp.ctx.symbols)) }
    // A scalar's namespace (`I64.MAX`) is core's I64 struct declaration.
    else if is_primitive(rt) { tname = jvm_scalar_name(rt, lp) }
    if tname.len() == 0 { return "" }
    def_o := lp.ctx.scope.get_struct(tname, lp.ctx.symbols)
    if def_o.is_none() { return "" }
    ref def : Expr = def_o.unwrap()
    ref ns : Vec(Declaration) = def_ns_decls(def)
    for idx in 0..ns.len() {
        if def_ns_name_at(def, idx) == member {
            if ns_member_is_data(def, idx) { return tname }
            return ""
        }
    }
    return ""
}

// Namespace data is a static field of the owner's class (the C global
// `Type_member`); a scalar one is a cell, so a `mut` ref to it
// (`Counter.count.inc()`) shares the one storage.
priv jvm_ns_static := proc(e: Expr, tname: Str, member: Str,
    mut state: JvmEmitState, lp: LoadedProgram) returns Str {
        if tname == "Str" {
            return jvm_fail_expr(e, "namespace data of Str", state, lp.ctx.symbols.names)
        }
        key := format(tname, ".", member)
        if state.ns_used.has(key).not() { state.ns_used.add(own key) }
        def_o := lp.ctx.scope.get_struct(tname, lp.ctx.symbols)
        mut cls := jvm_struct_class(tname)
        if def_o.unwrap().node_type.is(NodeType.EnumDef) { cls = jvm_enum_class(tname) }
        return format(cls, ".ns_", jvm_package_segment(member))
}

// An operand of ptr_eq is a STORAGE: a raw ref is its address, a scalar
// binding its cell (two refs to one scalar share the cell), an aggregate
// its object -- compared by identity (TilRuntime.ptrEq).
priv jvm_ptr_eq_operand := proc(e: Expr, mut state: JvmEmitState,
    lp: LoadedProgram) returns Str {
        if jvm_expr_is_raw_ref(e, state, lp.ctx.symbols.names) { return jvm_emit_expr(e, state, lp) }
        if jvm_is_scalar(e.til_type(), lp) { return jvm_emit_cell_ref(e, state, lp) }
        return jvm_emit_expr(e, state, lp)
}

priv jvm_emit_struct_ctor := proc(e: Expr, name: Str,
    mut state: JvmEmitState, lp: LoadedProgram) returns Str {
        def_o := lp.ctx.scope.get_struct(name, lp.ctx.symbols)
        if def_o.is_none() {
            return jvm_fail_expr(e, format("struct definition '", name, "'"), state, lp.ctx.symbols.names)
        }
        ref def_expr : Expr = def_o.unwrap()
        ref sd : StructDef = structdef_of(def_expr)
        mut args := ""
        for i in 1..e.children.len() {
            if i > 1 { args = format(args, ", ") }
            ref field : Declaration = sd.field_at(i - 1)
            mut arg := ""
            if jvm_is_scalar(field.til_type, lp).and(field.own_type.is(OwnType.Ref)) {
                arg = jvm_emit_cell_ref(e.children[i], state, lp)
            } else {
                arg = jvm_emit_expr(e.children[i], state, lp)
                // A width-alias field holds the target's carrier; a value
                // the typer settled at another width converts to it. The
                // runtime's Str takes its lengths as ints instead.
                ref field_tn : Str = decl_type_name_ref(field, lp.ctx.symbols)
                if name.eq("Str").and(jvm_is_scalar(field.til_type, lp)) {
                    arg = jvm_str_field_write(field.til_type, arg, lp)
                } else if field_tn.eq("USize").or(field_tn.eq("UPtr")) {
                    field_jt := jvm_type_lp(field.til_type, lp)
                    if jvm_type_lp(e.children[i].til_type(), lp) != field_jt {
                        arg = format("(", field_jt, ") (", arg, ")")
                    }
                }
            }
            args = format(args, arg)
        }
        if name == "Str" { return format("TilRuntime.makeStr(", args, ")") }
        return format("new ", jvm_struct_class(name), "(", args, ")")
}

priv jvm_emit_enum_payload := proc(value: Expr, variant: VariantDef,
    mut state: JvmEmitState, lp: LoadedProgram) returns Str {
        pt := type_from_name_init_name(variant.payload_type, lp.ctx.scope, lp.ctx.symbols)
        // A borrowed aggregate payload is its Java reference (deref of it is
        // the identity); a borrowed SCALAR would need a cell in the payload.
        if variant.payload_ref.and(jvm_is_scalar(pt, lp)) {
            return jvm_fail_expr(value, "ref scalar enum payload", state, lp.ctx.symbols.names)
        }
        out := jvm_emit_expr(value, state, lp)
        // REM: static function values are self-typed (jvm_static_function_value);
        // only lambdas need the payload type as their target.
        if pt.is_funcptr().and(value.node_type.is(NodeType.FuncDef)) {
            return format("(", jvm_type_lp(pt, lp), ") ", out)
        }
        return out
}

priv jvm_emit_enum_ctor := proc(e: Expr, call_name: Str,
    mut state: JvmEmitState, lp: LoadedProgram) returns Str {
        switch e.til_type() {
        case .EnumSym(ctor_esym):
            ref enum_name_sym : Str = lp.ctx.symbols.resolve(ctor_esym)
            def_sym_o := lp.ctx.scope.get_struct_by_sym(ctor_esym)
            if def_sym_o.is_some() {
                ref def_sym_expr : Expr = def_sym_o.unwrap()
                if def_sym_expr.node_type.is(NodeType.EnumDef) {
                    ref ed_sym : EnumDef = enumdef_of(def_sym_expr)
                    for variant_sym : VariantDef in ed_sym.variants {
                        if call_name == format(enum_name_sym, "_", variant_sym.name) {
                            mut payload_sym := "null"
                            if variant_sym.payload_type.len() > 0 {
                                if e.children.len() != 2 {
                                    return jvm_fail_expr(e, "enum payload constructor shape", state, lp.ctx.symbols.names)
                                }
                                payload_sym = jvm_emit_enum_payload(e.children[1],
                                    variant_sym, state, lp)
                            }
                            return format("new ", jvm_enum_class(enum_name_sym), "(",
                                variant_sym.tag_value.to_str(), "L, ", payload_sym, ")")
                        }
                    }
                }
            }
        case .Enum(enum_name):
            def_o := lp.ctx.scope.get_struct(enum_name, lp.ctx.symbols)
            if def_o.is_some() {
                ref def_expr : Expr = def_o.unwrap()
                if def_expr.node_type.is(NodeType.EnumDef) {
                    ref ed : EnumDef = enumdef_of(def_expr)
                    for variant : VariantDef in ed.variants {
                        if call_name == format(enum_name, "_", variant.name) {
                            mut payload := "null"
                            if variant.payload_type.len() > 0 {
                                if e.children.len() != 2 {
                                    return jvm_fail_expr(e, "enum payload constructor shape", state, lp.ctx.symbols.names)
                                }
                                payload = jvm_emit_enum_payload(e.children[1],
                                    variant, state, lp)
                            }
                            return format("new ", jvm_enum_class(enum_name), "(",
                                variant.tag_value.to_str(), "L, ", payload, ")")
                        }
                    }
                }
            }
        case:
        }
        for i in 0..lp.ctx.struct_layouts.len() {
            ref enum_name : Str = lp.ctx.struct_layouts.keys.unsafe_get(i)
            def_o := lp.ctx.scope.get_struct(enum_name, lp.ctx.symbols)
            if def_o.is_some() {
                ref def_expr : Expr = def_o.unwrap()
                if def_expr.node_type.is(NodeType.EnumDef) {
                    ref ed : EnumDef = enumdef_of(def_expr)
                    for variant : VariantDef in ed.variants {
                        if call_name == format(enum_name, "_", variant.name) {
                            mut payload := "null"
                            if variant.payload_type.len() > 0 {
                                if e.children.len() != 2 {
                                    return jvm_fail_expr(e, "enum payload constructor shape", state, lp.ctx.symbols.names)
                                }
                                payload = jvm_emit_enum_payload(e.children[1],
                                    variant, state, lp)
                            }
                            return format("new ", jvm_enum_class(enum_name), "(",
                                variant.tag_value.to_str(), "L, ", payload, ")")
                        }
                    }
                }
            }
        }
        for unit_path : Str in lp.unit_paths() {
            ref iu : ImportUnit = lp.ctx.imported[unit_path]
            for stmt : Expr in iu.ast.children {
                switch stmt.node_type {
                case .Decl(dd):
                    if stmt.children.len() > 0 {
                        if stmt.children[0].node_type.is(NodeType.EnumDef) {
                            ref ed : EnumDef = enumdef_of(stmt.children[0])
                            for i in 0..ed.variants.len() {
                                ref variant : VariantDef = ed.variants[i]
                                if call_name == format(dd.name, "_", variant.name) {
                                    mut payload := "null"
                                    if variant.payload_type.len() > 0 {
                                        if e.children.len() != 2 {
                                            return jvm_fail_expr(e, "enum payload constructor shape", state, lp.ctx.symbols.names)
                                        }
                                        payload = jvm_emit_enum_payload(e.children[1],
                                            variant, state, lp)
                                    }
                                    return format("new ", jvm_enum_class(dd.name), "(",
                                        variant.tag_value.to_str(), "L, ", payload, ")")
                                }
                            }
                        }
                    }
                case:
                }
            }
        }
        return ""
}

priv jvm_emit_enum_variant_ref := func(owner: Str, variant_name: Str,
    lp: LoadedProgram) returns Str {
        def_o := lp.ctx.scope.get_struct(owner, lp.ctx.symbols)
        if def_o.is_none() { return "" }
        ref def_expr : Expr = def_o.unwrap()
        if def_expr.node_type.is(NodeType.EnumDef).not() { return "" }
        ref ed : EnumDef = enumdef_of(def_expr)
        for variant : VariantDef in ed.variants {
            if variant.name == variant_name {
                return format("new ", jvm_enum_class(owner), "(",
                    variant.tag_value.to_str(), "L, null)")
            }
        }
        return ""
}

priv jvm_enum_pattern_tag := func(pattern: Expr, enum_name: Str,
    lp: LoadedProgram) returns Str {
        mut variant_name := ""
        switch pattern.node_type {
        case .FieldAccess(fa):
            variant_name = fa.field_access_name(lp.ctx.symbols.names).clone()
        case .FCall:
            if pattern.children.len() > 0 {
                switch pattern.children[0].node_type {
                case .FieldAccess(fa):
                    variant_name = fa.field_access_name(lp.ctx.symbols.names).clone()
                case:
                }
            }
        case:
        }
        if variant_name.len() == 0 { return "" }
        def_o := lp.ctx.scope.get_struct(enum_name, lp.ctx.symbols)
        if def_o.is_none() { return "" }
        ref def_expr : Expr = def_o.unwrap()
        if def_expr.node_type.is(NodeType.EnumDef).not() { return "" }
        ref ed : EnumDef = enumdef_of(def_expr)
        // The variant's ordinal (tilOrdinal): a Java switch takes an int,
        // and an enum(U64) tag need not fit one.
        for vi in 0..ed.variants.len() {
            if ed.variants[vi].name == variant_name { return vi.to_str() }
        }
        return ""
}

priv jvm_emit_typed_args := proc(e: Expr, fd: FunctionDef,
    mut state: JvmEmitState, lp: LoadedProgram) returns Str {
        mut out := ""
        for i in 1..e.children.len() {
            if i > 1 { out = format(out, ", ") }
            pi := i - 1
            mut arg := ""
            if jvm_param_needs_cell(fd, pi, lp) {
                arg = jvm_emit_cell_ref(e.children[i], state, lp)
            } else if pi.lt(fd.sig.params.len()).and(fd.sig.params[pi].til_type.is(Type.Dynamic)) {
                ref darg : Expr = e.children[i]
                ref dt : Type = darg.til_type()
                mut darg_is_raw := jvm_expr_is_raw_ref(darg, state, lp.ctx.symbols.names)
                if darg.node_type.is(NodeType.FCall).and(jvm_fcall_returns_raw_ref(darg, lp)) { darg_is_raw = true }
                switch darg.node_type {
                case .FieldAccess(dfa):
                    if darg.children.len() == 1 {
                        if jvm_field_is_raw(darg.children[0].til_type(), dfa.field_access_name(lp.ctx.symbols.names), lp) {
                            darg_is_raw = true
                        }
                    }
                case:
                }
                if darg_is_raw {
                    // A raw ref handed to a Dynamic parameter (`adopt`'s
                    // `dest`, Vec.unsafe_set's slot) is the address itself.
                    arg = jvm_emit_expr(darg, state, lp)
                } else if jvm_is_scalar(dt, lp) {
                    // A value where a Dynamic is expected: C passes the
                    // address of a slot holding it; box it into one.
                    arg = format("TilRuntime.box", jvm_scalar_name(dt, lp), "(", jvm_emit_value(darg, state, lp), ")")
                } else if jvm_is_runtime_str(dt, lp).or(is_struct_type(dt)).or(is_enum_type(dt)) {
                    arg = format("TilRuntime.boxObject(", jvm_emit_value(darg, state, lp), ", ",
                        jvm_storage_size(dt, lp).to_str(), "L)")
                } else {
                    arg = jvm_emit_value(darg, state, lp)
                }
            } else {
                // A value parameter takes the value: a raw ref (a for-in
                // binding into an Array) is loaded first.
                arg = jvm_emit_compared(e.children[i], state, lp)
            }
            out = format(out, arg)
        }
        return out
}

// What assert_eq compares: the value, never a pointer to it. A borrowed
// scalar (`for i, value in v`: Vec.unsafe_get's `ref I64`) is a raw
// pointer here, and comparing two pointers to equal elements failed.
priv jvm_emit_compared := proc(e: Expr, mut state: JvmEmitState,
    lp: LoadedProgram) returns Str {
        if jvm_is_scalar(e.til_type(), lp).and(jvm_expr_is_raw_ref(e, state, lp.ctx.symbols.names)) {
            return format("TilRuntime.load", jvm_scalar_name(e.til_type(), lp), "(",
                jvm_emit_expr(e, state, lp), ")")
        }
        return jvm_emit_value(e, state, lp)
}

priv jvm_emit_value := proc(e: Expr, mut state: JvmEmitState,
    lp: LoadedProgram) returns Str {
        out := jvm_emit_expr(e, state, lp)
        mut is_raw := jvm_expr_is_raw_ref(e, state, lp.ctx.symbols.names)
        // A call returning a raw `ref T` (Vec.unsafe_get) is typed T, not
        // Dynamic, but hands back the slot's address all the same.
        if e.node_type.is(NodeType.FCall).and(jvm_fcall_returns_raw_ref(e, lp)) { is_raw = true }
        if is_raw {
            if is_struct_type(e.til_type()).or(is_enum_type(e.til_type())) {
                return format("((", jvm_type_lp(e.til_type(), lp), ") TilRuntime.value(", out, ", ",
                    ctx_total_size(type_name_ref(e.til_type(), lp.ctx.symbols), lp.ctx).to_str(), "L))")
            }
        }
        return out
}

priv jvm_emit_scalar_core := proc(e: Expr, scalar: Str, op: Str,
    mut state: JvmEmitState, lp: LoadedProgram) returns Str {
        if op == "clone" {
            if e.children.len() != 2 { return jvm_fail_expr(e, "malformed scalar clone", state, lp.ctx.symbols.names) }
            mut value := jvm_emit_expr(e.children[1], state, lp)
            if jvm_expr_is_raw_ref(e.children[1], state, lp.ctx.symbols.names) {
                value = format("TilRuntime.load", scalar, "(", value, ")")
            }
            return value
        }
        if op.eq("inc").or(op.eq("dec")) {
            if e.children.len() != 2 { return jvm_fail_expr(e, "malformed scalar mutation", state, lp.ctx.symbols.names) }
            cell := jvm_emit_cell_ref(e.children[1], state, lp)
            mut java_op := "+"
            if op == "dec" { java_op = "-" }
            mut cell_scalar := Str.clone(type_name_ref(e.children[1].til_type(), lp.ctx.symbols))
            switch e.children[1].node_type {
            case .Ident(id):
                ref cell_name : Str = id.ident_name(lp.ctx.symbols.names)
                if state.cell_types.has(cell_name) { cell_scalar = state.cell_types[cell_name].clone() }
            case:
            }
            value := jvm_scalar_narrow(scalar,
                format(jvm_cell_read_name(cell_scalar, cell), " ", java_op, " 1"))
            return jvm_cell_write_name(cell_scalar, cell, value)
        }
        if op.eq("bnot") {
            if e.children.len() != 2 { return jvm_fail_expr(e, "malformed scalar bnot", state, lp.ctx.symbols.names) }
            arg := jvm_emit_expr(e.children[1], state, lp)
            return jvm_narrow(e.til_type(), format("~(", arg, ")"))
        }
        if e.children.len() != 3 {
            return jvm_fail_expr(e, format("malformed scalar operation '", op, "'"), state, lp.ctx.symbols.names)
        }
        mut left := jvm_emit_expr(e.children[1], state, lp)
        mut right := jvm_emit_expr(e.children[2], state, lp)
        if jvm_expr_is_raw_ref(e.children[1], state, lp.ctx.symbols.names) {
            left = format("TilRuntime.load", scalar, "(", left, ")")
        }
        if jvm_expr_is_raw_ref(e.children[2], state, lp.ctx.symbols.names) {
            right = format("TilRuntime.load", scalar, "(", right, ")")
        }
        if op.eq("div").or(op.eq("mod")) {
            return format("TilRuntime.", op, scalar, "(", left, ", ", right, ")")
        }
        if op.eq("lt").or(op.eq("gt")).or(op.eq("lte")).or(op.eq("gte")) {
            mut cmp := ""
            if scalar == "U32" { cmp = format("Integer.compareUnsigned(", left, ", ", right, ")") }
            if scalar == "U64" { cmp = format("Long.compareUnsigned(", left, ", ", right, ")") }
            if cmp.len() > 0 {
                mut cop := "<"
                if op == "gt" { cop = ">" }
                if op == "lte" { cop = "<=" }
                if op == "gte" { cop = ">=" }
                return format("(", cmp, " ", cop, " 0)")
            }
        }
        mut java_op := ""
        switch op {
        case "add": java_op = "+"
        case "sub": java_op = "-"
        case "mul": java_op = "*"
        case "eq": java_op = "=="
        case "neq": java_op = "!="
        case "lt": java_op = "<"
        case "gt": java_op = ">"
        case "lte": java_op = "<="
        case "gte": java_op = ">="
        case "band": java_op = "&"
        case "bor": java_op = "|"
        case "bxor": java_op = "^"
        case "shl": java_op = "<<"
        case "shr":
            java_op = ">>"
            if scalar.eq("U8").or(scalar.eq("U16")).or(scalar.eq("U32"))
                .or(scalar.eq("U64")) { java_op = ">>>" }
        case:
        }
        if java_op.len() == 0 {
            return jvm_fail_expr(e, format("scalar core operation '", scalar, ".", op, "'"), state, lp.ctx.symbols.names)
        }
        expr := format(left, " ", java_op, " ", right)
        if type_is_primitive(e.til_type(), Primitive.Bool) { return format("(", expr, ")") }
        return jvm_scalar_narrow(scalar, expr)
}

priv jvm_emit_conversion := func(target_in: Type, source_in: Str, value: Str, lp: LoadedProgram) returns Str {
    target := jvm_concrete(target_in, lp)
    source := jvm_concrete_scalar(source_in, lp)
    target_name := jvm_scalar_name(target, lp)
    if target_name == source { return format("(", value, ")") }
    // Same Java carrier (I64 <-> U64, U32 <-> I32, U8 -> I32): the bits
    // are already right and only a narrower til type's mask applies. A
    // cast here is an identity cast, which javac's -Xlint:cast reports and
    // the builder's -Werror makes fatal.
    // An empty source is a non-scalar operand, which has no carrier to match.
    jt := jvm_type(target, lp.ctx.symbols)
    if source.len() > 0 {
        source_t := type_from_name_init_name(source, lp.ctx.scope, lp.ctx.symbols)
        if jvm_type(source_t, lp.ctx.symbols) == jt { return jvm_narrow(target, value) }
    }
    if type_is_primitive(target, Primitive.I64) {
        if source == "U32" { return format("Integer.toUnsignedLong(", value, ")") }
        if source == "U64" { return format("(", value, ")") }
        return format("(long) (", value, ")")
    }
    if type_is_primitive(target, Primitive.U64) {
        if source == "U32" { return format("Integer.toUnsignedLong(", value, ")") }
        if source == "I64" { return format("(", value, ")") }
        return format("(long) (", value, ")")
    }
    if type_is_primitive(target, Primitive.F32) {
        if source == "U32" { return format("(float) Integer.toUnsignedLong(", value, ")") }
        if source == "U64" { return format("TilRuntime.u64ToF32(", value, ")") }
        return format("(float) (", value, ")")
    }
    if type_is_primitive(target, Primitive.F64) {
        if source == "U32" { return format("(double) Integer.toUnsignedLong(", value, ")") }
        if source == "U64" { return format("TilRuntime.u64ToF64(", value, ")") }
        return format("(double) (", value, ")")
    }
    // I8/I16: the narrowing IS the cast to byte/short; a second one is
    // redundant (javac -Xlint:cast).
    if type_is_primitive(target, Primitive.I8).or(type_is_primitive(target, Primitive.I16)) {
        return jvm_narrow(target, value)
    }
    return jvm_narrow(target, format("(", jt, ") (", value, ")"))
}

priv jvm_emit_scalar_ext := proc(e: Expr, scalar: Str, method: Str,
    mut state: JvmEmitState, lp: LoadedProgram) returns Str {
        mut first := ""
        if e.children.len() > 1 {
            first = jvm_emit_expr(e.children[1], state, lp)
            if jvm_expr_is_raw_ref(e.children[1], state, lp.ctx.symbols.names) {
                first = format("TilRuntime.load", scalar, "(", first, ")")
            }
        }
        if method == "clone" {
            return first
        }
        if method == "cmp" {
            left := first
            mut right := jvm_emit_expr(e.children[2], state, lp)
            if jvm_expr_is_raw_ref(e.children[2], state, lp.ctx.symbols.names) {
                right = format("TilRuntime.load", scalar, "(", right, ")")
            }
            return format("TilRuntime.cmp", scalar, "(", left, ", ", right, ")")
        }
        if method == "to_str" {
            return format("TilRuntime.str", scalar, "(", first, ")")
        }
        if method == "to_repr" {
            return format("TilRuntime.repr", scalar, "(", first, ")")
        }
        if method.starts_with("to_") {
            return jvm_emit_conversion(e.til_type(), scalar, first, lp)
        }
        return jvm_fail_expr(e, format("scalar runtime function '", scalar, ".", method, "'"), state, lp.ctx.symbols.names)
}

priv jvm_emit_closure := proc(e: Expr, fd: FunctionDef,
    mut state: JvmEmitState, lp: LoadedProgram) returns Str {
        if e.children.len() != 1 {
            return jvm_fail_expr(e, "closure body shape", state, lp.ctx.symbols.names)
        }
        saved_cells := state.cells.clone()
        saved_cell_types := state.cell_types.clone()
        saved_raw_refs := state.raw_refs.clone()
        saved_callable_defs := state.callable_defs.clone()
        saved_return_cell := state.return_cell
        state.return_cell = false
        mut sig_cells := Set(Str).new()
        for i in 0..fd.sig.params.len() {
            ref param : Declaration = fd.sig.params[i]
            resolved := declaration_resolved_type(param, lp.ctx.scope, lp.ctx.symbols)
            if jvm_is_scalar(resolved, lp) {
                state.cell_types.set(param.name, own jvm_scalar_name(resolved, lp))
            }
            if jvm_param_needs_cell(fd, i, lp) {
                sig_cells.add(own param.name.clone())
                state.cells.add(own param.name.clone())
            }
        }
        jvm_collect_cells(e.children[0], state.cells, state.raw_refs, lp)
        jvm_collect_cell_types(e.children[0], state.cell_types, lp)
        // The same entry boxing a named function gets (jvm_param_boxed_on_entry):
        // the functional interface types the lambda's parameters.
        mut params := ""
        mut prologue := ""
        for i in 0..fd.sig.params.len() {
            ref param : Declaration = fd.sig.params[i]
            if i > 0 { params = format(params, ", ") }
            if jvm_param_boxed_on_entry(param, sig_cells, state, lp) {
                arg := jvm_param_arg_name(param.name)
                params = format(params, arg)
                prologue = format(prologue, jvm_param_box(param, arg, 1, lp))
            } else {
                params = format(params, jvm_var_name(param.name))
            }
        }
        saved_closure_loads_raw := state.return_loads_raw
        state.return_loads_raw = false
        body := format(prologue, jvm_emit_body(e.children[0], 1, state, lp))
        state.return_loads_raw = saved_closure_loads_raw
        state.cells = saved_cells
        state.cell_types = saved_cell_types
        state.raw_refs = saved_raw_refs
        state.callable_defs = saved_callable_defs
        state.return_cell = saved_return_cell
        return format("(", params, ") -> {\n", body, "}")
}

priv jvm_emit_cast := proc(e: Expr, mut state: JvmEmitState,
    lp: LoadedProgram) returns Str {
        if e.children.len() < 3 { return jvm_fail_expr(e, "malformed cast", state, lp.ctx.symbols.names) }
        target := type_from_name_init_name(ident_of(e.children[2]).ident_name(lp.ctx.symbols.names), lp.ctx.scope, lp.ctx.symbols)
        if jvm_type_lp(target, lp).len() == 0 { return jvm_fail_expr(e, "cast target", state, lp.ctx.symbols.names) }
        mut value := jvm_emit_expr(e.children[1], state, lp)
        source := jvm_scalar_name(e.children[1].til_type(), lp)
        // A borrowed scalar (`for c in s`: Str.unsafe_get's `ref I8`) is a
        // raw pointer here; the cast converts what it points at.
        if source.len().gt(0).and(jvm_expr_is_raw_ref(e.children[1], state, lp.ctx.symbols.names)) {
            value = format("TilRuntime.load", source, "(", value, ")")
        }
        return jvm_emit_conversion(target, source, value, lp)
}

priv jvm_emit_named_call := proc(e: Expr, name: Str, mut state: JvmEmitState,
    lp: LoadedProgram) returns Str {
        if is_struct_type(e.til_type()) {
            ref ctor_sname : Str = type_name_ref(e.til_type(), lp.ctx.symbols)
            if name == ctor_sname { return jvm_emit_struct_ctor(e, ctor_sname, state, lp) }
        }
        if name.eq("println").or(name.eq("print")).or(name.eq("eprintln")).or(name.eq("eprint")) {
            if e.children.len() != 2 { return jvm_fail_expr(e, format("malformed runtime call '", name, "'"), state, lp.ctx.symbols.names) }
            arg := jvm_emit_expr(e.children[1], state, lp)
            return format("TilRuntime.", name, "(", arg, ")")
        }
        if name.eq("print_single").or(name.eq("eprint_single")) {
            arg := jvm_emit_expr(e.children[1], state, lp)
            return format("TilRuntime.", name, "(", arg, ")")
        }
        if name == "print_flush" { return "TilRuntime.printFlush()" }
        // #375: the desugarer lowers `param = rhs` for a `mut` aggregate
        // parameter to swap_bytes(param, temp, T.size()). Here an aggregate
        // is an object, not bytes in the virtual heap: the swap exchanges
        // the two objects' contents (swapContents, generated per class).
        if name.eq("swap_bytes").and(e.children.len() == 4) {
            ref sb_a : Expr = e.children[1]
            if is_struct_type(sb_a.til_type()).or(is_enum_type(sb_a.til_type())) {
                if jvm_is_runtime_str(sb_a.til_type(), lp) {
                    return format("TilRuntime.swapStr(", jvm_emit_expr(sb_a, state, lp), ", ",
                        jvm_emit_expr(e.children[2], state, lp), ")")
                }
                return format(jvm_emit_expr(sb_a, state, lp), ".swapContents(",
                    jvm_emit_expr(e.children[2], state, lp), ")")
            }
        }
        if name == "exit" {
            arg := jvm_emit_expr(e.children[1], state, lp)
            return format("TilRuntime.exit((int) (", arg, "))")
        }
        if name == "panic" {
            return format("TilRuntime.panic(", jvm_emit_expr(e.children[1], state, lp), ", ",
                jvm_emit_expr(e.children[2], state, lp), ")")
        }
        if name == "assert" {
            return format("TilRuntime.assertTrue(", jvm_emit_compared(e.children[1], state, lp), ", ",
                jvm_emit_expr(e.children[2], state, lp), ")")
        }
        if name == "expect" {
            return format("TilRuntime.expect(", jvm_emit_expr(e.children[1], state, lp), ", ",
                jvm_emit_expr(e.children[2], state, lp), ", ", jvm_emit_expr(e.children[3], state, lp), ")")
        }
        if name.starts_with("assert_eq__") {
            return format("TilRuntime.assertEq(", jvm_emit_compared(e.children[1], state, lp), ", ",
                jvm_emit_compared(e.children[2], state, lp), ", ", jvm_emit_expr(e.children[3], state, lp), ")")
        }
        if name == "not" {
            arg := jvm_emit_expr(e.children[1], state, lp)
            return format("(!(", arg, "))")
        }
        if name.eq("and").or(name.eq("or")) {
            left := jvm_emit_expr(e.children[1], state, lp)
            right := jvm_emit_expr(e.children[2], state, lp)
            mut op := "&&"
            if name == "or" { op = "||" }
            return format("((", left, ") ", op, " (", right, "))")
        }
        if name == "cast" { return jvm_emit_cast(e, state, lp) }
        if name.ends_with("_from_i64_ext") {
            value := jvm_emit_expr(e.children[1], state, lp)
            return jvm_emit_conversion(e.til_type(), "I64", value, lp)
        }
        if name == "U64_to_str_ext" {
            value := jvm_emit_expr(e.children[1], state, lp)
            return format("TilRuntime.strU64(", value, ")")
        }
        if name == "Str_delete" {
            value := jvm_emit_expr(e.children[1], state, lp)
            if jvm_expr_is_raw_ref(e.children[1], state, lp.ctx.symbols.names) {
                return format("TilRuntime.deleteStrAt(", value, ", ",
                    ctx_total_size("Str", lp.ctx).to_str(), "L)")
            }
            return format("TilRuntime.deleteStr(", value, ")")
        }
        if name == "Str_clone" {
            value := jvm_emit_expr(e.children[1], state, lp)
            if jvm_expr_is_raw_ref(e.children[1], state, lp.ctx.symbols.names) {
                return format("TilRuntime.cloneStrAt(", value, ", ",
                    ctx_total_size("Str", lp.ctx).to_str(), "L)")
            }
            return format("TilRuntime.cloneStr(", value, ")")
        }
        if name == "til_closure_delete" {
            return format("TilRuntime.releaseClosure(", jvm_emit_expr(e.children[1], state, lp), ")")
        }
        if name == "is_n" {
            return format("TilRuntime.enumIs(", jvm_emit_expr(e.children[1], state, lp), ", ",
                jvm_emit_expr(e.children[2], state, lp), ")")
        }
        if name == "get_payload" {
            jt := jvm_type_lp(e.til_type(), lp)
            if jt.len() == 0 {
                return jvm_fail_expr(e, "enum payload type", state, lp.ctx.symbols.names)
            }
            if is_enum_type(jvm_concrete(e.til_type(), lp)) {
                return format("TilRuntime.payloadView(", jvm_emit_expr(e.children[1], state, lp),
                    ", ", jt, ".class, ", jt, ".INACTIVE_VIEW)")
            }
            return format("((", jt, ") TilRuntime.enumPayload(",
                jvm_emit_expr(e.children[1], state, lp), "))")
        }
        if name == "dyn_type_to_str" {
            return format("TilRuntime.dynTypeToStr(",
                jvm_emit_expr(e.children[1], state, lp), ")")
        }
        if name == "adopt__Str" {
            dest := jvm_emit_expr(e.children[1], state, lp)
            value := jvm_emit_expr(e.children[2], state, lp)
            return format("TilRuntime.storeObject(", dest, ", ", value, ", ",
                ctx_total_size("Str", lp.ctx).to_str(), "L)")
        }
        if name == "malloc" {
            return format("TilRuntime.malloc(", jvm_emit_expr(e.children[1], state, lp), ")")
        }
        if name == "calloc" {
            return format("TilRuntime.calloc(", jvm_emit_expr(e.children[1], state, lp), ", ",
                jvm_emit_expr(e.children[2], state, lp), ")")
        }
        if name == "realloc" {
            return format("TilRuntime.realloc(", jvm_emit_expr(e.children[1], state, lp), ", ",
                jvm_emit_expr(e.children[2], state, lp), ")")
        }
        if name == "free" {
            mut value := jvm_emit_expr(e.children[1], state, lp)
            switch e.children[1].node_type {
            case .Ident(id):
                ref arg_name : Str = id.ident_name(lp.ctx.symbols.names)
                if jvm_is_cell(state, arg_name, e.children[1].til_type(), lp).and(state.raw_refs.has(arg_name).not()) {
                    value = jvm_emit_cell_ref(e.children[1], state, lp)
                }
            case:
            }
            return format("TilRuntime.releaseBox(", value, ")")
        }
        if name == "ptr_add" {
            return format("TilRuntime.ptrAdd(", jvm_emit_expr(e.children[1], state, lp), ", ",
                jvm_emit_expr(e.children[2], state, lp), ")")
        }
        if name.eq("memcpy").or(name.eq("memmove")) {
            method := name.clone()
            return format("TilRuntime.", method, "(", jvm_emit_expr(e.children[1], state, lp), ", ",
                jvm_emit_expr(e.children[2], state, lp), ", ", jvm_emit_expr(e.children[3], state, lp), ")")
        }
        if name == "memset" {
            return format("TilRuntime.memset(", jvm_emit_expr(e.children[1], state, lp), ", ",
                jvm_emit_expr(e.children[2], state, lp), ", ", jvm_emit_expr(e.children[3], state, lp), ")")
        }
        if name == "memcmp" {
            return format("TilRuntime.memcmp(", jvm_emit_expr(e.children[1], state, lp), ", ",
                jvm_emit_expr(e.children[2], state, lp), ", ", jvm_emit_expr(e.children[3], state, lp), ")")
        }
        if name == "ptr_eq" {
            return format("TilRuntime.ptrEq(", jvm_ptr_eq_operand(e.children[1], state, lp), ", ",
                jvm_ptr_eq_operand(e.children[2], state, lp), ")")
        }
        if name == "is_null" {
            return format("(", jvm_emit_expr(e.children[1], state, lp), " == null)")
        }
        if name == "to_ptr" {
            // An aggregate is a Java reference, and its address is that
            // reference.
            ref tp_arg : Expr = e.children[1]
            if jvm_is_scalar(tp_arg.til_type(), lp)
                .or(jvm_expr_is_raw_ref(tp_arg, state, lp.ctx.symbols.names)) {
                return jvm_fail_expr(e, "to_ptr of a scalar or raw address", state, lp.ctx.symbols.names)
            }
            return jvm_emit_expr(tp_arg, state, lp)
        }
        if name == "deref" {
            // A typed (non-raw) slot: a borrowed (`ref T`) enum payload's
            // binding is deref(get_payload(e)), whose slot C stores a T* in.
            // The JVM payload already holds the T reference, so loading it
            // is the identity; a scalar there would need a cell.
            ref slot : Expr = e.children[1]
            if slot.til_type().is(Type.Dynamic).not()
                .and(jvm_expr_is_raw_ref(slot, state, lp.ctx.symbols.names).not()) {
                if jvm_is_scalar(slot.til_type(), lp) {
                    return jvm_fail_expr(e, "deref of a typed scalar slot", state, lp.ctx.symbols.names)
                }
                return jvm_emit_expr(slot, state, lp)
            }
            return format("TilRuntime.loadPtr(", jvm_emit_expr(slot, state, lp), ")")
        }
        if name == "write_ptr" {
            return format("TilRuntime.storePtr(", jvm_emit_expr(e.children[1], state, lp), ", ",
                jvm_emit_expr(e.children[2], state, lp), ")")
        }
        if name.starts_with("write_") {
            mut scalar := ""
            if name == "write_bool" { scalar = "Bool" }
            else if name == "write_i64" { scalar = "I64" }
            else if name == "write_u64" { scalar = "U64" }
            else if name == "write_i32" { scalar = "I32" }
            else if name == "write_u32" { scalar = "U32" }
            else if name == "write_i16" { scalar = "I16" }
            else if name == "write_u16" { scalar = "U16" }
            else if name == "write_i8" { scalar = "I8" }
            else if name == "write_u8" { scalar = "U8" }
            else if name == "write_f32" { scalar = "F32" }
            return format("TilRuntime.store", scalar, "(", jvm_emit_expr(e.children[1], state, lp), ", ",
                jvm_emit_expr(e.children[2], state, lp), ")")
        }
        if name == "noop_proc" { return "TilRuntime.noopProc()" }
        if name == "dyn_size_of" {
            return format("Functions.dynSizeOf(", jvm_emit_expr(e.children[1], state, lp), ")")
        }
        if name == "usize_to_uptr" {
            return format("Integer.toUnsignedLong(", jvm_emit_expr(e.children[1], state, lp), ")")
        }

        if jvm_is_scalar_function_name(name).and(name.ends_with("_delete")) {
            return "TilRuntime.dropScalar()"
        }

        // A struct's GENERATED clone/delete is lowered to the Java-side
        // cloneValue/delete (the generated til versions free own fields
        // through C's boxed layout); a user-defined one runs as written.
        if name.ends_with("_clone").and(e.children.len() == 2) {
            if is_struct_type(e.children[1].til_type()).and(jvm_is_auto_generated(name, lp)) {
                return format(jvm_emit_expr(e.children[1], state, lp), ".cloneValue()")
            }
        }
        if name.ends_with("_delete").and(e.children.len() >= 2) {
            if is_struct_type(e.children[1].til_type()).and(jvm_is_auto_generated(name, lp)) {
                return format(jvm_emit_expr(e.children[1], state, lp), ".delete()")
            }
            if is_enum_type(e.children[1].til_type()) {
                return format(jvm_emit_expr(e.children[1], state, lp), ".delete()")
            }
        }
        if name.ends_with("_is").and(e.children.len() == 3) {
            if is_enum_type(e.children[1].til_type()) {
                return format(jvm_emit_expr(e.children[1], state, lp), ".sameTag(",
                    jvm_emit_expr(e.children[2], state, lp), ")")
            }
        }
        if name.ends_with("_size").and(e.children.len() == 1) {
            for unit_path : Str in lp.unit_paths() {
                ref size_iu : ImportUnit = lp.ctx.imported[unit_path]
                for stmt : Expr in size_iu.ast.children {
                    switch stmt.node_type {
                    case .Decl(dd):
                        if name == format(dd.name, "_size") {
                            if stmt.children.len() > 0 {
                                if stmt.children[0].node_type.is(NodeType.StructDef)
                                    .or(stmt.children[0].node_type.is(NodeType.EnumDef)) {
                                    // Core declares the primitives as structs too, so a
                                    // struct layout's size would read U64 as its empty
                                    // body (1 byte); the resolved type knows it is 8.
                                    size_t := type_from_name_init_name(dd.name, lp.ctx.scope, lp.ctx.symbols)
                                    return jvm_int_const(e.til_type(), jvm_storage_size(size_t, lp).to_str(), lp)
                                }
                            }
                        }
                    case:
                    }
                }
            }
        }

        enum_ctor := jvm_emit_enum_ctor(e, name, state, lp)
        if enum_ctor.len() > 0 { return enum_ctor }

        fdef_o := jvm_find_fdef(name, lp)
        if fdef_o.is_none() { return jvm_fail_expr(e, format("unresolved direct call '", name, "'"), state, lp.ctx.symbols.names) }
        ref fdef_expr : Expr = fdef_o.unwrap()
        ref fd : FunctionDef = funcdef_of(fdef_expr)
        if fd.is_enum_variant_ctor {
            def_o := lp.ctx.scope.get_struct(fd.sig.return_type, lp.ctx.symbols)
            if def_o.is_some() {
                ref def_expr : Expr = def_o.unwrap()
                ref ed : EnumDef = enumdef_of(def_expr)
                for variant : VariantDef in ed.variants {
                    if name == format(fd.sig.return_type, "_", variant.name) {
                        mut payload := "null"
                        if variant.payload_type.len() > 0 {
                            payload = jvm_emit_enum_payload(e.children[1],
                                variant, state, lp)
                        }
                        return format("new ", jvm_enum_class(fd.sig.return_type), "(",
                            variant.tag_value.to_str(), "L, ", payload, ")")
                    }
                }
            }
        }
        if fd.sig.func_type.is_core().or(fd.sig.func_type.is_ext()) {
            return jvm_fail_expr(e, format("runtime function '", name, "'"), state, lp.ctx.symbols.names)
        }
        cls := jvm_function_class(name, lp)
        if cls.len() == 0 { return jvm_fail_expr(e, format("function definition '", name, "'"), state, lp.ctx.symbols.names) }
        args := jvm_emit_typed_args(e, fd, state, lp)
        return format(cls, ".", jvm_func_name(name), "(", args, ")")
}

priv jvm_emit_namespace_call := proc(e: Expr, callee: Expr,
    mut state: JvmEmitState, lp: LoadedProgram) returns Str {
        if callee.children.len() != 1 {
            return jvm_fail_expr(e, "non-namespace method call", state, lp.ctx.symbols.names)
        }
        mut scalar := ""
        switch callee.children[0].node_type {
        case .Ident(id): scalar = jvm_concrete_scalar(id.ident_name(lp.ctx.symbols.names), lp)
        case: return jvm_fail_expr(e, "non-identifier namespace call", state, lp.ctx.symbols.names)
        }
        ref method : Str = fieldaccess_of(callee).field_access_name(lp.ctx.symbols.names)
        owner_def_o := lp.ctx.scope.get_struct(scalar, lp.ctx.symbols)
        if owner_def_o.is_some() {
            if owner_def_o.unwrap().node_type.is(NodeType.EnumDef) {
                return jvm_emit_named_call(e, format(scalar, "_", method), state, lp)
            }
        }
        if jvm_is_scalar_name(scalar) {
            if method == "from_i64" {
                value := jvm_emit_expr(e.children[1], state, lp)
                return jvm_emit_conversion(e.til_type(), "I64", value, lp)
            }
            if method.eq("clone").or(method.eq("cmp")).or(method.eq("to_str"))
                .or(method.eq("to_repr")).or(method.starts_with("to_")) {
                return jvm_emit_scalar_ext(e, scalar, method, state, lp)
            }
            if jvm_scalar_core_method(method) {
                return jvm_emit_scalar_core(e, scalar, method, state, lp)
            }
        }
        if scalar == "Str" {
            if method == "eq" {
                left := jvm_emit_value(e.children[1], state, lp)
                right := jvm_emit_value(e.children[2], state, lp)
                return format("TilRuntime.strEq(", left, ", ", right, ")")
            }
        }
        flat := format(scalar, "_", method)
        fdef_o := jvm_find_fdef(flat, lp)
        if fdef_o.is_some() {
            ref fdef_expr : Expr = fdef_o.unwrap()
            ref fd : FunctionDef = funcdef_of(fdef_expr)
            if fd.sig.func_type.is_core().and(jvm_is_scalar_name(scalar)) {
                return jvm_emit_scalar_core(e, scalar, method, state, lp)
            }
            if fd.sig.func_type.is_ext() {
                return jvm_fail_expr(e, format("runtime function '", flat, "'"), state, lp.ctx.symbols.names)
            }
        }
        return jvm_emit_named_call(e, flat, state, lp)
}

priv jvm_emit_expr := proc(e: Expr, mut state: JvmEmitState,
    lp: LoadedProgram) returns Str {
        switch e.node_type {
        case .PrecomputedSequence(data):
            ref type_name : Str = type_name_ref(data.til_type, lp.ctx.symbols)
            mut heap := format("TilRuntime.precomputedValues(", data.capacity.to_str(), ", ",
                jvm_storage_size(data.element_type, lp).to_str())
            for child : Expr in e.children {
                heap = format(heap, ", ", jvm_emit_value(child, state, lp))
            }
            heap = format(heap, ")")
            if type_name.eq("Vec").or(type_name.starts_with("Vec__")) {
                return format("new ", jvm_type_lp(data.til_type, lp), "(", heap, ", ",
                    e.children.len().to_str(), ", ", data.capacity.to_str(), ")")
            }
            if type_name.eq("Array").or(type_name.starts_with("Array__")) {
                return format("new ", jvm_type_lp(data.til_type, lp), "(", heap, ", ",
                    data.capacity.to_str(), ")")
            }
            return jvm_fail_expr(e, format("precomputed sequence type '", type_name, "'"),
                state, lp.ctx.symbols.names)
        case .Literal(Literal.Str(s)):
            // A literal is stored in source form (C-style escapes, which C
            // and HolyC hand to their own lexers); Java gets the bytes, so
            // decode them the way the interpreter does. Writing the source
            // spelling made "\xc3\xa9x" nine bytes instead of three.
            return format("TilRuntime.literalStr(", jvm_byte_array(from_source_form(s)), ")")
        case .Literal(Literal.Num(num)):
            return jvm_num_literal(e, num, state, lp)
        case .Literal(Literal.Bool(b)):
            if b { return "true" }
            return "false"
        case .Literal(Literal.Null): return "null"
        case .FuncDef(fd): return jvm_emit_closure(e, fd, state, lp)
        case .Ident(id):
            ref name : Str = id.ident_name(lp.ctx.symbols.names)
            // USize's all-ones and all-ones-minus-one, at whatever width
            // the build gave USize (two's complement spells both as -1/-2).
            if name == "CAP_LIT" { return jvm_int_const(e.til_type(), "-1", lp) }
            if name == "CAP_VIEW" { return jvm_int_const(e.til_type(), "-2", lp) }
            function_value := jvm_static_function_value(name, lp)
            if function_value.len() > 0 { return function_value }
            mut out := jvm_var_name(name)
            if state.raw_refs.has(name) { return out }
            if jvm_is_cell(state, name, e.til_type(), lp) {
                if state.cell_types.has(name).not() {
                    panic("JVM cell missing type: ", name, " at ", e.line.to_str(), ":", e.col.to_str())
                }
                out = jvm_cell_read_name(state.cell_types[name], out)
            }
            return out
        case .FieldAccess(fa):
            if e.children.len() != 1 { return jvm_fail_expr(e, "field access shape", state, lp.ctx.symbols.names) }
            switch e.children[0].node_type {
            case .Ident(id):
                enum_variant := jvm_emit_enum_variant_ref(id.ident_name(lp.ctx.symbols.names),
                    fa.field_access_name(lp.ctx.symbols.names), lp)
                if enum_variant.len() > 0 { return enum_variant }
            case:
            }
            ref fa_member : Str = fa.field_access_name(lp.ctx.symbols.names)
            fa_owner := jvm_ns_data_owner(e.children[0], fa_member, lp)
            if fa_owner.len() > 0 {
                ns_static := jvm_ns_static(e, fa_owner, fa_member, state, lp)
                if jvm_is_scalar(e.til_type(), lp) { return jvm_cell_read(e.til_type(), ns_static, lp) }
                return ns_static
            }
            obj := jvm_emit_value(e.children[0], state, lp)
            mut out := format(obj, ".", jvm_field_getter(fa.field_access_name(lp.ctx.symbols.names)))
            if jvm_is_scalar(e.til_type(), lp).and(jvm_is_runtime_str(e.children[0].til_type(), lp)) {
                return jvm_str_field_read(e.til_type(), out, lp)
            }
            if jvm_is_scalar(e.til_type(), lp).and(jvm_field_is_cell(e.children[0].til_type(),
                fa.field_access_name(lp.ctx.symbols.names), lp)) {
                out = jvm_cell_read(e.til_type(), out, lp)
            }
            return out
        case .FCall:
            if e.children.len() == 0 { return jvm_fail_expr(e, "empty function call", state, lp.ctx.symbols.names) }
            ref callee : Expr = e.children[0]
            mut call := ""
            sig_o := jvm_emit_fcall_funcsig(e, state, lp)
            if sig_o.is_some() {
                ref sig_fd : FunctionDef = funcdef_of(sig_o.unwrap())
                call = format("(", jvm_emit_expr(callee, state, lp), ").invoke(",
                    jvm_emit_typed_args(e, sig_fd, state, lp), ")")
            } else {
                switch callee.node_type {
                case .Ident(id): call = jvm_emit_named_call(e, id.ident_name(lp.ctx.symbols.names), state, lp)
                case .FieldAccess: call = jvm_emit_namespace_call(e, callee, state, lp)
                case: return jvm_fail_expr(e, "unresolved indirect function call", state, lp.ctx.symbols.names)
                }
            }
            if jvm_fcall_returns_cell(e, lp) {
                fdef_o := jvm_find_fdef(jvm_fcall_name(e, lp), lp)
                ref fd : FunctionDef = funcdef_of(fdef_o.unwrap())
                return jvm_cell_read_name(fd.sig.return_type, call)
            }
            return call
        case:
        }
        return jvm_fail_expr(e, "expression", state, lp.ctx.symbols.names)
}

priv jvm_source_comment := func(e: Expr, state: JvmEmitState, depth: I32) returns Str {
    path := state.path.replace("\n", " ")
    return format(jvm_indent(depth), "// ", path, ":", e.line.to_str(), "\n")
}

// Whether javac sees `e` as unable to complete normally: it ends in a
// return, break or continue, or is an if/else whose branches all do.
priv jvm_ends_abruptly := func(e: Expr) returns Bool {
    switch e.node_type {
    case .Return: return true
    case .Break: return true
    case .Continue: return true
    case .Body:
        if e.children.len() == 0 { return false }
        return jvm_ends_abruptly(e.children[e.children.len() - 1])
    case .If:
        if e.children.len() < 3 { return false }
        return jvm_ends_abruptly(e.children[1]).and(jvm_ends_abruptly(e.children[2]))
    case: return false
    }
}

priv jvm_emit_switch := proc(e: Expr, depth: I32, mut state: JvmEmitState,
    lp: LoadedProgram) returns Str {
        ref subject : Expr = e.children[0]
        mut enum_name := ""
        switch subject.til_type() {
        case .Primitive(Primitive.I8):
        case .Primitive(Primitive.U8):
        case .Primitive(Primitive.I16):
        case .Primitive(Primitive.U16):
        case .Primitive(Primitive.I32):
        case .Primitive(Primitive.U32):
        case .Enum(name): enum_name = name.clone()
        case .EnumSym(sw_esym): enum_name = Str.clone(lp.ctx.symbols.resolve(sw_esym))
        case:
            return jvm_fail_expr(e, "non-32-bit scalar switch", state, lp.ctx.symbols.names)
        }
        mut subject_java := jvm_emit_expr(subject, state, lp)
        if enum_name.len() > 0 { subject_java = format(subject_java, ".tilOrdinal()") }
        mut out := format(jvm_source_comment(e, state, depth), jvm_indent(depth),
            "switch (", subject_java, ") {\n")
        mut has_default := false
        for ci in 1..e.children.len() {
            ref cn : Expr = e.children[ci]
            pc := case_pattern_count(cn)
            if cn.children.len() > pc + 1 {
                jvm_fail_expr(cn, "guarded switch case", state, lp.ctx.symbols.names)
            }
            if pc == 0 {
                has_default = true
                out = format(out, jvm_indent(depth + 1), "default: {\n")
            } else {
                for pi in 0..pc {
                    mut pat := ""
                    if enum_name.len() > 0 {
                        pat = jvm_enum_pattern_tag(cn.children[pi], enum_name, lp)
                        if pat.len() == 0 {
                            jvm_fail_expr(cn.children[pi], "enum switch pattern", state, lp.ctx.symbols.names)
                        }
                    } else {
                        pat = jvm_emit_expr(cn.children[pi], state, lp)
                    }
                    out = format(out, jvm_indent(depth + 1), "case ", pat, ":\n")
                }
                out = format(out, jvm_indent(depth + 1), "{\n")
            }
            ref case_body : Expr = cn.children[cn.children.len() - 1]
            // javac rejects a `break` after an arm that cannot complete
            // normally (a generated enum clone returns from every arm).
            mut case_break := format(jvm_indent(depth + 2), "break;\n")
            if jvm_ends_abruptly(case_body) { case_break = "" }
            out = format(out, jvm_emit_body(case_body, depth + 2, state, lp),
                case_break, jvm_indent(depth + 1), "}\n")
        }
        if has_default.not() { out = format(out, jvm_indent(depth + 1), "default: break;\n") }
        return format(out, jvm_indent(depth), "}\n")
}

// An aggregate local handed away by an `own` argument (a call, a
// constructor, an enum payload) or by an elided-clone move into a field
// no longer owns that object -- the receiver may keep it (a Vec slot, a
// field, a payload). Nulling the variable after the statement says so,
// which is what lets a later reassignment write a NON-null variable's
// object in place without touching the new owner's (see .Assign).
priv jvm_collect_moved := func(e: Expr, lp: LoadedProgram, mut out: Vec(Str)) {
    if e.node_type.is(NodeType.FuncDef) { return }
    if e.node_type.is(NodeType.FCall) {
        for i in 1..e.children.len() {
            if get_own_arg(e, i) {
                ref arg : Expr = e.children[i]
                switch arg.node_type {
                case .Ident(mid):
                    ref at : Type = arg.til_type()
                    if jvm_is_scalar(at, lp).not().and(jvm_is_runtime_str(at, lp).or(is_struct_type(at)).or(is_enum_type(at))) {
                        out.push(own mid.ident_name(lp.ctx.symbols.names).clone())
                    }
                case:
                }
            }
        }
    }
    for c : Expr in e.children { jvm_collect_moved(c, lp, out) }
}

priv jvm_moved_clears := func(e: Expr, depth: I32, state: JvmEmitState,
    lp: LoadedProgram) returns Str {
        mut moved := Vec(Str).new()
        mut skip := ""
        switch e.node_type {
        case .Decl(dd):
            if e.children.len() > 0 { jvm_collect_moved(e.children[0], lp, moved) }
            skip = dd.name.clone()
        case .Assign(ad):
            // `x = f(own x)`: x holds the new value afterwards.
            jvm_collect_moved(e.children[0], lp, moved)
            skip = ad.name.clone()
        case .FieldAssign(fad):
            jvm_collect_moved(e.children[1], lp, moved)
            if fad.is_move {
                switch e.children[1].node_type {
                case .Ident(fid): moved.push(own fid.ident_name(lp.ctx.symbols.names).clone())
                case:
                }
            }
        case .FCall: jvm_collect_moved(e, lp, moved)
        case: return ""
        }
        mut out := ""
        mut done := Set(Str).new()
        for name : Str in moved {
            if name == skip { continue }
            if state.raw_refs.has(name) { continue }
            if done.has(name) { continue }
            done.add(own name.clone())
            out = format(out, jvm_indent(depth), jvm_var_name(name), " = null;\n")
        }
        return out
}

priv jvm_emit_stmt := proc(e: Expr, depth: I32, mut state: JvmEmitState,
    lp: LoadedProgram) returns Str {
        stmt_out := jvm_emit_stmt_core(e, depth, state, lp)
        if stmt_out.len() == 0 { return stmt_out }
        return format(stmt_out, jvm_moved_clears(e, depth, state, lp))
}

priv jvm_emit_stmt_core := proc(e: Expr, depth: I32, mut state: JvmEmitState,
    lp: LoadedProgram) returns Str {
        switch e.node_type {
        case .Decl(dd):
            if e.children.len() > 0 {
                ref rhs : Expr = e.children[0]
                if rhs.node_type.is(NodeType.FuncDef) {
                    ref closure_fd : FunctionDef = funcdef_of(rhs)
                    if rhs.children.len() == 0 { return "" }
                    closure_type := jvm_funcsig_class(closure_fd, lp.ctx.symbols)
                    state.callable_defs.set(dd.name, own closure_type.clone())
                    return format(jvm_source_comment(e, state, depth), jvm_indent(depth),
                        closure_type, " ", jvm_var_name(dd.name), " = ",
                        jvm_emit_closure(rhs, closure_fd, state, lp), ";\n")
                }
                switch rhs.node_type {
                case .Ident(id):
                    alias_fdef_o := jvm_find_fdef(id.ident_name(lp.ctx.symbols.names), lp)
                    if alias_fdef_o.is_some() {
                        if alias_fdef_o.unwrap().children.len() == 0 { return "" }
                    }
                    // A type alias (`Point2 := Point`) has no runtime value;
                    // the typer resolved its uses already (as in C).
                    if e.til_type().is(Type.None) { return "" }
                case:
                }
                rhs_sig_o := jvm_expr_funcsig(rhs, state, lp)
                mut decl_type := dd.til_type.clone()
                if decl_type.is(Type.Unknown) { decl_type = e.til_type().clone() }
                mut jt := ""
                if decl_type.is(Type.Unknown).or(decl_type.is(Type.FuncDef))
                    .or(decl_type.is_funcptr())
                    .and(rhs_sig_o.is_some()) {
                    jt = jvm_funcsig_class(funcdef_of(rhs_sig_o.unwrap()), lp.ctx.symbols)
                } else {
                    jt = jvm_decl_type(e, decl_type, state, lp)
                }
                switch rhs.node_type {
                case .Ident(id):
                    ref rhs_name : Str = id.ident_name(lp.ctx.symbols.names)
                    if state.callable_defs.has(rhs_name) {
                        state.callable_defs.set(dd.name, own state.callable_defs[rhs_name].clone())
                    } else if rhs_sig_o.is_some() {
                        state.callable_defs.set(dd.name, own
                            jvm_funcsig_class(funcdef_of(rhs_sig_o.unwrap()), lp.ctx.symbols))
                    }
                case:
                }
                mut value := ""
                if state.raw_refs.has(dd.name) {
                    jt = "TilRuntime.Ptr"
                    if e.children[0].node_type.is(NodeType.FCall)
                        .and(jvm_fcall_returns_raw_ref(e.children[0], lp)) {
                        value = jvm_emit_cell_ref(e.children[0], state, lp)
                    } else {
                        value = jvm_emit_expr(e.children[0], state, lp)
                    }
                } else if jvm_is_cell(state, dd.name, e.til_type(), lp) {
                    jt = jvm_cell_type(e.til_type(), lp)
                    if dd.own_type.is(OwnType.Ref) {
                        value = jvm_emit_cell_ref(e.children[0], state, lp)
                    } else {
                        value = jvm_new_cell(e.til_type(),
                            jvm_emit_expr(e.children[0], state, lp), lp)
                    }
                } else {
                    value = jvm_emit_expr(e.children[0], state, lp)
                }
                return format(jvm_source_comment(e, state, depth), jvm_indent(depth),
                    jt, " ", jvm_var_name(dd.name), " = ", value, ";\n")
            }
            return jvm_fail_expr(e, format("declaration without initializer '", dd.name, "'"), state, lp.ctx.symbols.names)
        case .Assign(ad):
            value := jvm_emit_expr(e.children[0], state, lp)
            target := jvm_var_name(ad.name)
            // An aggregate's Java object IS its storage: C overwrites a
            // binding's storage in place (`x = v`, or `*t = _new` through a
            // payload binding, #416), so whatever borrows it -- a `ref`
            // local or field, an enum's payload slot -- sees the new value.
            // The binding's object therefore takes the new contents in
            // place. It is exclusively this binding's: a value handed away
            // by `own` leaves the variable null (jvm_moved_clears), and a
            // null variable simply takes the new object. A plain
            // identifier RHS that is not a move rebinds a borrow (`r =
            // other`; an owned value cannot be assigned to a `ref`), so it
            // stays a reference assignment. The value is evaluated before
            // the old one is deleted, as in C.
            ref at : Type = e.children[0].til_type()
            mut rhs_is_borrow := false
            switch e.children[0].node_type {
            case .Ident: rhs_is_borrow = ad.is_move.not().and(ad.is_payload_alias.not())
            case:
            }
            mut in_place := ""
            if jvm_is_scalar(at, lp).not().and(rhs_is_borrow.not()).and(state.raw_refs.has(ad.name).not()) {
                if jvm_is_runtime_str(at, lp) { in_place = format("TilRuntime.assignStr(", target, ", assignNew)") }
                else if is_struct_type(at).or(is_enum_type(at)) { in_place = format(target, ".assignFrom(assignNew)") }
                else if ad.is_payload_alias {
                    return jvm_fail_expr(e, "write through a payload binding of this type", state, lp.ctx.symbols.names)
                }
            }
            if in_place.len() > 0 {
                mut old_delete := ""
                if ad.save_old_delete { old_delete = format(jvm_delete_value(at, target, lp), "; ") }
                mut moved_clear := ""
                if ad.is_move {
                    switch e.children[0].node_type {
                    case .Ident(mid): moved_clear = format(" ", jvm_var_name(mid.ident_name(lp.ctx.symbols.names)), " = null;")
                    case: return jvm_fail_expr(e, "non-identifier aggregate move source", state, lp.ctx.symbols.names)
                    }
                }
                return format(jvm_source_comment(e, state, depth), jvm_indent(depth),
                    "{ ", jvm_type_lp(at, lp), " assignNew = ", value, "; ", old_delete,
                    "if (", target, " == null) { ", target, " = assignNew; } else { ", in_place, "; }",
                    moved_clear, " }\n")
            }
            is_cell := jvm_is_cell(state, ad.name, e.children[0].til_type(), lp)
            mut prefix := ""
            if ad.save_old_delete { prefix = format(jvm_indent(depth), jvm_delete_value(e.children[0].til_type(), target, lp), ";\n") }
            mut clear := ""
            if ad.is_move {
                switch e.children[0].node_type {
                case .Ident(id):
                    clear = format(jvm_indent(depth),
                        jvm_var_name(id.ident_name(lp.ctx.symbols.names)), " = null;\n")
                case:
                    jvm_fail_expr(e, "non-identifier aggregate move source", state, lp.ctx.symbols.names)
                }
            }
            mut assignment := format(target, " = ", value)
            if is_cell { assignment = jvm_cell_write_name(state.cell_types[ad.name], target, value) }
            else if state.raw_refs.has(ad.name).and(state.cell_types.has(ad.name)) {
                assignment = jvm_cell_write_name(state.cell_types[ad.name], target, value)
            }
            return format(jvm_source_comment(e, state, depth), prefix, jvm_indent(depth),
                assignment, ";\n", clear)
        case .FieldAssign(fad):
            fas_owner := jvm_ns_data_owner(e.children[0], fad.name, lp)
            if fas_owner.len() > 0 {
                ns_target := jvm_ns_static(e, fas_owner, fad.name, state, lp)
                ns_value := jvm_emit_expr(e.children[1], state, lp)
                mut ns_prefix := ""
                if fad.save_old_delete { ns_prefix = format(jvm_indent(depth), jvm_delete_value(e.children[1].til_type(), ns_target, lp), ";\n") }
                mut ns_write := format(ns_target, " = ", ns_value)
                if jvm_is_scalar(e.children[1].til_type(), lp) {
                    ns_write = jvm_cell_write(e.children[1].til_type(), ns_target, ns_value, lp)
                }
                return format(jvm_source_comment(e, state, depth), ns_prefix, jvm_indent(depth), ns_write, ";\n")
            }
            obj := jvm_emit_value(e.children[0], state, lp)
            value := jvm_emit_expr(e.children[1], state, lp)
            target := format(obj, ".", jvm_field_getter(fad.name))
            is_scalar := jvm_field_is_cell(e.children[0].til_type(), fad.name, lp)
            mut prefix := ""
            if fad.save_old_delete { prefix = format(jvm_indent(depth), jvm_delete_value(e.children[1].til_type(), target, lp), ";\n") }
            // A live owned aggregate field (save_old_delete: the field owns
            // the old value, so nothing moved it away) is overwritten IN
            // PLACE, as C overwrites the field's storage: a `ref` that
            // borrows the field (`ref b := v.text`, a ref field built from
            // it) is that object and must see the new value. The new value
            // is evaluated before the old one is deleted, as in C.
            ref fv_t : Type = e.children[1].til_type()
            if fad.save_old_delete.and(is_scalar.not()).and(jvm_is_scalar(fv_t, lp).not()) {
                mut in_place := ""
                if jvm_is_runtime_str(fv_t, lp) { in_place = format("TilRuntime.assignStr(", target, ", assignNew)") }
                else if is_struct_type(fv_t).or(is_enum_type(fv_t)) { in_place = format(target, ".assignFrom(assignNew)") }
                if in_place.len() > 0 {
                    return format(jvm_source_comment(e, state, depth), jvm_indent(depth),
                        "{ ", jvm_type_lp(fv_t, lp), " assignNew = ", value, "; ",
                        jvm_delete_value(fv_t, target, lp), "; ", in_place, "; }\n")
                }
            }
            if is_scalar.not() {
                mut set_value := value.clone()
                if jvm_is_runtime_str(e.children[0].til_type(), lp).and(jvm_is_scalar(e.children[1].til_type(), lp)) {
                    set_value = jvm_str_field_write(e.children[1].til_type(), value, lp)
                }
                return format(jvm_source_comment(e, state, depth), prefix, jvm_indent(depth),
                    obj, ".", jvm_field_setter(fad.name), "(", set_value, ");\n")
            }
            return format(jvm_source_comment(e, state, depth), prefix, jvm_indent(depth),
                jvm_cell_write(e.children[1].til_type(), target, value, lp), ";\n")
        case .FCall:
            call := jvm_emit_expr(e, state, lp)
            return format(jvm_source_comment(e, state, depth), jvm_indent(depth), call, ";\n")
        case .Return:
            if e.children.len() == 0 {
                return format(jvm_source_comment(e, state, depth), jvm_indent(depth), "return;\n")
            }
            mut value := ""
            if state.return_cell { value = jvm_emit_cell_ref(e.children[0], state, lp) }
            else if state.return_loads_raw.and(jvm_expr_is_raw_ref(e.children[0], state, lp.ctx.symbols.names)) {
                if jvm_is_scalar(e.children[0].til_type(), lp) { value = jvm_emit_compared(e.children[0], state, lp) }
                else { value = jvm_emit_value(e.children[0], state, lp) }
            }
            else { value = jvm_emit_expr(e.children[0], state, lp) }
            return format(jvm_source_comment(e, state, depth), jvm_indent(depth), "return ", value, ";\n")
        case .Body:
            return format(jvm_source_comment(e, state, depth), jvm_indent(depth), "{\n",
                jvm_emit_body(e, depth + 1, state, lp), jvm_indent(depth), "}\n")
        case .CaptureBlock:
            return format(jvm_source_comment(e, state, depth), jvm_indent(depth), "{\n",
                jvm_emit_body(e.children[0], depth + 1, state, lp), jvm_indent(depth), "}\n")
        case .If:
            cond := jvm_emit_expr(e.children[0], state, lp)
            mut out := format(jvm_source_comment(e, state, depth), jvm_indent(depth),
                "if (", cond, ") {\n", jvm_emit_body(e.children[1], depth + 1, state, lp),
                jvm_indent(depth), "}")
            if e.children.len() > 2 {
                out = format(out, " else {\n", jvm_emit_body(e.children[2], depth + 1, state, lp),
                    jvm_indent(depth), "}")
            }
            return format(out, "\n")
        case .While:
            cond := jvm_emit_expr(e.children[0], state, lp)
            return format(jvm_source_comment(e, state, depth), jvm_indent(depth),
                "while (", cond, ") {\n", jvm_emit_body(e.children[1], depth + 1, state, lp),
                jvm_indent(depth), "}\n")
        case .Switch: return jvm_emit_switch(e, depth, state, lp)
        case .Break:
            return format(jvm_source_comment(e, state, depth), jvm_indent(depth), "break;\n")
        case .Continue:
            return format(jvm_source_comment(e, state, depth), jvm_indent(depth), "continue;\n")
        case:
        }
        jvm_fail_expr(e, "statement", state, lp.ctx.symbols.names)
        return ""
}

priv jvm_emit_body := proc(body: Expr, depth: I32, mut state: JvmEmitState,
    lp: LoadedProgram) returns Str {
        if body.node_type.is(NodeType.Body).not() {
            jvm_fail_expr(body, "non-body function/block body", state, lp.ctx.symbols.names)
            return ""
        }
        mut out := ""
        for stmt : Expr in body.children {
            out = format(out, jvm_emit_stmt(stmt, depth, state, lp))
        }
        return out
}

// A non-void function whose body ends in a call that never returns
// (`UNREACHABLE()`, a noreturn til function) still falls off the end as far
// as javac can tell ("missing return statement"). The C backend's
// emit_diverge_terminator answers the same question with the same predicate.
// Only a trailing CALL gets the throw: after a trailing return, or an
// if/else whose arms all return, javac already knows and a throw there
// would be an unreachable statement.
priv jvm_diverge_terminator := func(ret: Str, body: Expr, depth: I32,
    lp: LoadedProgram) returns Str {
        if ret.eq("void").or(body.children.len() == 0) { return "" }
        ref last : Expr = body.children[body.children.len() - 1]
        if last.node_type.is(NodeType.FCall).not() { return "" }
        if stmt_always_diverges(last, lp.ctx.scope, lp.ctx.symbols).not() { return "" }
        return format(jvm_indent(depth), "throw new IllegalStateException(\"unreachable\");\n")
}

priv jvm_emit_function := proc(decl: Expr, depth: I32,
    mut state: JvmEmitState, lp: LoadedProgram) returns Str {
        ref dd : Declaration = decl_of(decl)
        ref fexpr : Expr = decl.children[0]
        ref fd : FunctionDef = funcdef_of(fexpr)
        if fd.sig.func_type.is_bodyless().or(jvm_runtime_bound_function(dd.name)) { return "" }
        if fd.sig.func_type.is(FuncType.Macro) { return "" }
        if dd.name == "main" { return "" }
        if fexpr.children.len() == 0 { return "" }
        if fexpr.children.len() != 1 {
            return jvm_fail_expr(fexpr, format("function body shape for '", dd.name, "'"), state, lp.ctx.symbols.names)
        }
        saved_cells := state.cells.clone()
        saved_cell_types := state.cell_types.clone()
        saved_raw_refs := state.raw_refs.clone()
        saved_callable_defs := state.callable_defs.clone()
        saved_return_cell := state.return_cell
        state.cells = Set(Str).new()
        state.cell_types = Map(Str, Str).new()
        state.raw_refs = Set(Str).new()
        state.callable_defs = Map(Str, Str).new()
        state.return_cell = false
        mut ret := "void"
        if fd.sig.return_type.len() > 0 {
            rt := type_from_name_init_name(fd.sig.return_type, lp.ctx.scope, lp.ctx.symbols)
            is_raw_return := fd.sig.return_own_type.is(OwnType.Ref)
                .and(jvm_call_graph_has(fexpr, "ptr_add", lp))
            state.return_cell = fd.sig.return_own_type.is(OwnType.Shallow).not()
                .and(jvm_is_scalar(rt, lp))
                .and(is_raw_return.not())
            if is_raw_return { ret = "TilRuntime.Ptr" }
            else if state.return_cell { ret = jvm_cell_type(rt, lp) }
            else if fd.sig.return_own_type.is(OwnType.Ref)
                .and(is_struct_type(rt).or(is_enum_type(rt))) { ret = "TilRuntime.Ptr" }
            else { ret = jvm_decl_type(fexpr, rt, state, lp) }
        }
        saved_return_loads_raw := state.return_loads_raw
        state.return_loads_raw = ret.eq("void").or(ret.eq("TilRuntime.Ptr")).or(state.return_cell).not()
        mut pts := Vec(Str).new()
        mut sig_cells := Set(Str).new()
        for i in 0..fd.sig.params.len() {
            ref param : Declaration = fd.sig.params[i]
            pt := jvm_signature_param_type(fd, i, lp)
            resolved := declaration_resolved_type(param, lp.ctx.scope, lp.ctx.symbols)
            if jvm_is_scalar(resolved, lp) {
                state.cell_types.set(param.name, own jvm_scalar_name(resolved, lp))
            }
            if jvm_param_needs_cell(fd, i, lp) {
                sig_cells.add(own param.name.clone())
                if state.cells.has(param.name).not() {
                    state.cells.add(own param.name.clone())
                }
            }
            if pt.len() == 0 {
                jvm_fail_expr(fexpr, format("parameter type for '", param.name, "'"), state, lp.ctx.symbols.names)
            }
            pts.push(own pt)
        }
        jvm_collect_cell_types(fexpr.children[0], state.cell_types, lp)
        jvm_collect_cells(fexpr.children[0], state.cells, state.raw_refs, lp)
        if state.return_cell { jvm_collect_return_cells(fexpr.children[0], state.cells, lp) }
        mut params := ""
        mut prologue := ""
        for i in 0..fd.sig.params.len() {
            ref param : Declaration = fd.sig.params[i]
            if i > 0 { params = format(params, ", ") }
            if jvm_param_boxed_on_entry(param, sig_cells, state, lp) {
                arg := jvm_param_arg_name(param.name)
                params = format(params, pts[i], " ", arg)
                prologue = format(prologue, jvm_param_box(param, arg, depth + 1, lp))
            } else {
                params = format(params, pts[i], " ", jvm_var_name(param.name))
            }
        }
        out := format(jvm_source_comment(decl, state, depth), jvm_indent(depth),
            "static ", ret, " ", jvm_func_name(dd.name), "(", params, ") {\n",
            prologue, jvm_emit_body(fexpr.children[0], depth + 1, state, lp),
            jvm_diverge_terminator(ret, fexpr.children[0], depth + 1, lp),
            jvm_indent(depth), "}\n\n")
        state.cells = saved_cells
        state.cell_types = saved_cell_types
        state.raw_refs = saved_raw_refs
        state.callable_defs = saved_callable_defs
        state.return_cell = saved_return_cell
        state.return_loads_raw = saved_return_loads_raw
        return out
}

priv jvm_field_name := func(name: Str) returns Str {
    return format("f_", jvm_package_segment(name))
}

priv jvm_field_getter := func(name: Str) returns Str {
    return format("get_", jvm_package_segment(name), "()")
}

priv jvm_field_setter := func(name: Str) returns Str {
    return format("set_", jvm_package_segment(name))
}

// #375: the runtime's hand-written Str keeps count and cap as Java ints
// behind plain accessors -- the JVM indexes by int -- while USize is
// whatever width the build chose. Its fields are never cells, and a scalar
// one converts at the boundary when USize's carrier is not int: a read
// through TilRuntime.widenLength (sign-extending, so CAP_LIT/CAP_VIEW keep
// their meaning), a write through TilRuntime.narrowLength (checked).
priv jvm_is_runtime_str := func(t: Type, lp: LoadedProgram) returns Bool {
    switch t {
    case .Struct(rs_name): return rs_name.eq("Str")
    case .StructSym(rs_sym): return lp.ctx.symbols.resolve(rs_sym).eq("Str")
    case: return false
    }
}

priv jvm_str_field_read := func(field_t: Type, expr: Str, lp: LoadedProgram) returns Str {
    if jvm_type_lp(field_t, lp).eq("long") { return format("TilRuntime.widenLength(", expr, ")") }
    return expr.clone()
}

priv jvm_str_field_write := func(field_t: Type, expr: Str, lp: LoadedProgram) returns Str {
    if jvm_type_lp(field_t, lp).eq("long") { return format("TilRuntime.narrowLength(", expr, ")") }
    return expr.clone()
}

// Releasing an aggregate value. The runtime's Str is a hand-written class
// with no delete() of its own -- the runtime releases it, as the struct
// destructors' field cleanup already spells it.
priv jvm_delete_value := func(t: Type, value: Str, lp: LoadedProgram) returns Str {
    if jvm_is_runtime_str(t, lp) { return format("TilRuntime.deleteStr(", value, ")") }
    return format(value, ".delete()")
}

// An `own` scalar field is a raw heap block (C's `I8 *c_str`): reading
// it yields the block's ADDRESS, a TilRuntime.Ptr.
priv jvm_field_is_raw := func(owner_type_in: Type, field_name: Str,
    lp: LoadedProgram) returns Bool {
        owner_type := jvm_concrete(owner_type_in, lp)
        if is_struct_type(owner_type).not() { return false }
        def_o := lp.ctx.scope.get_struct(type_name_ref(owner_type, lp.ctx.symbols), lp.ctx.symbols)
        if def_o.is_none() { return false }
        ref def_expr : Expr = def_o.unwrap()
        if def_expr.node_type.is(NodeType.StructDef).not() { return false }
        ref sd : StructDef = structdef_of(def_expr)
        if sd.fields_index.has(field_name).not() { return false }
        ref field : Declaration = sd.field_at(sd.fields_index[field_name])
        return jvm_is_scalar(field.til_type, lp).and(field.own_type.is(OwnType.Own))
}

priv jvm_field_is_cell := func(owner_type_in: Type, field_name: Str,
    lp: LoadedProgram) returns Bool {
        // A Custom spelling (a payload type, a type declared after its
        // use) is the struct the scope resolves it to.
        owner_type := jvm_concrete(owner_type_in, lp)
        if jvm_is_runtime_str(owner_type, lp) { return false }
        switch owner_type {
        case .StructSym(owner_ssym):
            def_sym_o := lp.ctx.scope.get_struct_by_sym(owner_ssym)
            if def_sym_o.is_some() {
                ref def_sym_expr : Expr = def_sym_o.unwrap()
                if def_sym_expr.node_type.is(NodeType.StructDef) {
                    ref sd_sym : StructDef = structdef_of(def_sym_expr)
                    if sd_sym.fields_index.has(field_name) {
                        ref field_sym : Declaration = sd_sym.field_at(sd_sym.fields_index[field_name])
                        return jvm_is_scalar(field_sym.til_type, lp).and(field_sym.own_type.is(OwnType.Own).not())
                    }
                }
            }
        case .Struct(owner_name):
            def_o := lp.ctx.scope.get_struct(owner_name, lp.ctx.symbols)
            if def_o.is_some() {
                ref def_expr : Expr = def_o.unwrap()
                if def_expr.node_type.is(NodeType.StructDef) {
                    ref sd : StructDef = structdef_of(def_expr)
                    if sd.fields_index.has(field_name) {
                        ref field : Declaration = sd.field_at(sd.fields_index[field_name])
                        return jvm_is_scalar(field.til_type, lp).and(field.own_type.is(OwnType.Own).not())
                    }
                }
            }
        case:
        }
        return false
}

// Whether `name` is a method the initer generated (clone/delete/eq/...),
// as opposed to one the user wrote in the namespace.
priv jvm_is_auto_generated := func(name: Str, lp: LoadedProgram) returns Bool {
    fdef_o := jvm_find_fdef(name, lp)
    if fdef_o.is_none() { return false }
    return funcdef_of(fdef_o.unwrap()).auto_generated
}

priv jvm_emit_struct := proc(decl: Expr, package_name: Str, mut state: JvmEmitState,
    lp: LoadedProgram) returns JvmClassOut {
        ref dd : Declaration = decl_of(decl)
        ref def_expr : Expr = decl.children[0]
        ref sd : StructDef = structdef_of(def_expr)
        cls := jvm_struct_class(dd.name)
        mut out := JvmClassOut(name = cls.clone())
        if sd.is_interface {
            jvm_fail_expr(def_expr, format("interface '", dd.name, "' before Stage F"), state, lp.ctx.symbols.names)
            return out
        }
        mut fields := ""
        mut params := ""
        mut init := ""
        mut copies := ""
        mut clones := ""
        mut deletes := ""
        mut swaps := ""
        mut assigns := ""
        jvm_add_member(out, "checkLive", format("    private void checkLive() {\n",
            "        if (deleted) { throw new IllegalStateException(\"use after aggregate delete\"); }\n",
            "    }\n\n"))
        for i in 0..sd.fields.len() {
            ref field : Declaration = sd.field_at(i)
            ref fname : Str = sd.field_name_at(i)
            is_scalar := jvm_is_scalar(field.til_type, lp)
            is_raw := is_scalar.and(field.own_type.is(OwnType.Own))
            is_cell := is_scalar.and(is_raw.not())
            mut field_type := jvm_type_lp(field.til_type, lp)
            mut param_type := field_type.clone()
            if is_raw {
                field_type = "TilRuntime.Ptr"
                param_type = field_type.clone()
            } else if is_cell {
                field_type = jvm_cell_type(field.til_type, lp)
                if field.own_type.is(OwnType.Ref) { param_type = field_type.clone() }
            }
            if field_type.len() == 0 {
                jvm_fail_expr(def_expr, format("field type '", decl_type_name_ref(field, lp.ctx.symbols), "'"), state, lp.ctx.symbols.names)
            }
            jname := jvm_field_name(fname)
            fields = format(fields, "    ", field_type, " ", jname, ";\n")
            jvm_add_member(out, format("get_", jvm_package_segment(fname)),
                format("    ", field_type, " ", jvm_field_getter(fname),
                    " { checkLive(); return ", jname, "; }\n"))
            if is_cell.not() {
                jvm_add_member(out, jvm_field_setter(fname),
                    format("    void ", jvm_field_setter(fname), "(",
                        field_type, " value) { checkLive(); ", jname, " = value; }\n"))
            }
            if i > 0 {
                params = format(params, ", ")
                copies = format(copies, ", ")
                clones = format(clones, ", ")
            }
            pname := format("p", i.to_str())
            params = format(params, param_type, " ", pname)
            // swapContents: a cell this object owns keeps its identity and
            // trades its VALUE -- a ref into this.x still points into this
            // object afterwards, as with C's byte swap; anything else is a
            // reference, and the references trade.
            if is_cell.and(field.own_type.is(OwnType.Ref).not()) {
                swaps = format(swaps, "        { ", jvm_type_lp(field.til_type, lp), " t = ",
                    jvm_cell_read(field.til_type, format("this.", jname), lp), "; ",
                    jvm_cell_write(field.til_type, format("this.", jname),
                        jvm_cell_read(field.til_type, format("other.", jname), lp), lp), "; ",
                    jvm_cell_write(field.til_type, format("other.", jname), "t", lp), "; }\n")
                assigns = format(assigns, "        ", jvm_cell_write(field.til_type, format("this.", jname),
                    jvm_cell_read(field.til_type, format("other.", jname), lp), lp), ";\n")
            } else {
                swaps = format(swaps, "        { ", field_type, " t = this.", jname, "; this.", jname,
                    " = other.", jname, "; other.", jname, " = t; }\n")
                assigns = format(assigns, "        this.", jname, " = other.", jname, ";\n")
            }
            if is_cell.and(field.own_type.is(OwnType.Ref).not()) {
                init = format(init, "        this.", jname, " = ",
                    jvm_new_cell(field.til_type, pname, lp), ";\n")
                copies = format(copies, jvm_cell_read(field.til_type, format("this.", jname), lp))
            } else {
                init = format(init, "        this.", jname, " = ", pname, ";\n")
                copies = format(copies, "this.", jname)
            }
            if field.own_type.is(OwnType.Ref) {
                clones = format(clones, "this.", jname)
            } else if is_cell {
                clones = format(clones, jvm_cell_read(field.til_type, format("this.", jname), lp))
            } else if is_raw {
                clones = format(clones, "TilRuntime.cloneBlock(this.", jname, ")")
                deletes = format(deletes, "        TilRuntime.releaseBox(this.", jname, ");\n")
            } else {
                switch field.til_type {
                case .FuncPtr, .FuncPtrSig, .FuncPtrSigSym, .Body:
                    clones = format(clones, "TilRuntime.retainClosure(this.", jname, ")")
                    deletes = format(deletes, "        TilRuntime.releaseClosure(this.", jname, ");\n")
                case .Struct(field_name):
                    if field_name == "Str" {
                        clones = format(clones, "TilRuntime.cloneStr(this.", jname, ")")
                        deletes = format(deletes, "        TilRuntime.deleteStr(this.", jname, ");\n")
                    } else {
                        clones = format(clones, "this.", jname, ".cloneValue()")
                        deletes = format(deletes, "        this.", jname, ".delete();\n")
                    }
                case .StructSym(field_ssym):
                    if lp.ctx.symbols.resolve(field_ssym) == "Str" {
                        clones = format(clones, "TilRuntime.cloneStr(this.", jname, ")")
                        deletes = format(deletes, "        TilRuntime.deleteStr(this.", jname, ");\n")
                    } else {
                        clones = format(clones, "this.", jname, ".cloneValue()")
                        deletes = format(deletes, "        this.", jname, ".delete();\n")
                    }
                case .Enum, .EnumSym:
                    clones = format(clones, "this.", jname, ".cloneValue()")
                    deletes = format(deletes, "        this.", jname, ".delete();\n")
                case:
                    clones = format(clones, "this.", jname)
                }
            }
        }
        mut interface_clause := ""
        if dd.name == "Array__Str" { interface_clause = " implements TilRuntime.StrParts" }
        out.head = format(jvm_file_head(package_name),
            "final class ", cls, interface_clause, " {\n", fields,
            "    private boolean deleted;\n",
            "\n    ", cls, "(", params, ") {\n", init, "    }\n\n")
        jvm_add_member(out, "copy", format("    ", cls, " copy() { checkLive(); return new ",
            cls, "(", copies, "); }\n"))
        jvm_add_member(out, "cloneValue", format("    ", cls,
            " cloneValue() { checkLive(); return new ", cls, "(", clones, "); }\n"))
        jvm_add_member(out, "swapContents", format("    void swapContents(", cls, " other) {\n",
            "        checkLive();\n        other.checkLive();\n", swaps, "    }\n"))
        // assignFrom: a write through a ref binding (`case .V(p): p = q`,
        // C's `*p = q`) -- this object takes the new value's contents in place,
        // so the enum or borrowed referent it is sees them. The old contents
        // were already settled by the assignment's save_old_delete, so this
        // may be a deleted object coming back to life.
        jvm_add_member(out, "assignFrom", format("    void assignFrom(", cls, " other) {\n",
            "        other.checkLive();\n", assigns, "        deleted = false;\n    }\n"))
        jvm_add_member(out, "delete", format("    void delete() {\n",
            "        checkLive();\n", deletes,
            "        deleted = true;\n",
            "    }\n"))
        if dd.name == "Array__Str" {
            str_size := ctx_total_size("Str", lp.ctx).to_str()
            // StrParts.length() is a Java int; cap is a USize cell, so it
            // crosses the same boundary the runtime Str's lengths do.
            ref cap_field : Declaration = sd.field_at(sd.fields_index["cap"])
            cap_read := jvm_str_field_write(cap_field.til_type,
                jvm_cell_read(cap_field.til_type, "f_p_cap", lp), lp)
            jvm_add_member(out, "length", format(
                "    public int length() { checkLive(); return ", cap_read, "; }\n"))
            jvm_add_member(out, "part", format(
                "    public TilRuntime.Str part(int index) {\n",
                "        checkLive();\n",
                "        return (TilRuntime.Str) TilRuntime.loadObject(",
                "TilRuntime.ptrAdd(f_p_data, (long) index * ", str_size, "L), ", str_size, "L);\n",
                "    }\n"))
        }
        out.tail = "}\n\n"
        return out
}

priv jvm_emit_enum := func(decl: Expr, package_name: Str, lp: LoadedProgram) returns JvmClassOut {
    ref dd : Declaration = decl_of(decl)
    ref ed : EnumDef = enumdef_of(decl.children[0])
    cls := jvm_enum_class(dd.name)
    // Tags are compared as longs: an enum(U64) tag need not fit the int a
    // Java switch takes (switch statements use tilOrdinal instead).
    mut variant_names := ""
    mut ordinals := ""
    mut payload_clones := ""
    for vi in 0..ed.variants.len() {
        ref variant : VariantDef = ed.variants[vi]
        tag_test := format("        if (tag == ", variant.tag_value.to_str(), "L) ")
        variant_names = format(variant_names, tag_test, "return \"", variant.name, "\";\n")
        ordinals = format(ordinals, tag_test, "return ", vi.to_str(), ";\n")
        // An OWNED aggregate payload is cloned with its own value semantics,
        // as the til-generated clone does; a borrowed (`ref`) one is shared,
        // and a boxed scalar is immutable.
        if variant.payload_type.len() > 0 {
            if variant.payload_ref.not() {
                pt := jvm_concrete(type_from_name_init_name(variant.payload_type, lp.ctx.scope, lp.ctx.symbols), lp)
                mut cloned := ""
                if pt.is_funcptr() {
                    cloned = "TilRuntime.retainClosure((TilRuntime.Closure) payload)"
                } else if jvm_is_scalar(pt, lp).not() {
                    pjt := jvm_type_lp(pt, lp)
                    if pjt == "TilRuntime.Str" {
                        cloned = "TilRuntime.cloneStr((TilRuntime.Str) payload)"
                    } else if is_struct_type(pt).or(is_enum_type(pt)) {
                        cloned = format("((", pjt, ") payload).cloneValue()")
                    }
                }
                if cloned.len() > 0 {
                    payload_clones = format(payload_clones, tag_test,
                        "return new ", cls, "(tag, ", cloned, ");\n")
                }
            }
        }
    }
    invalid_tag := "        throw new IllegalStateException(\"invalid enum tag\");\n"
    variant_names = format(variant_names, invalid_tag)
    ordinals = format(ordinals, invalid_tag)
    mut out := JvmClassOut(name = cls.clone())
    out.head = format(jvm_file_head(package_name),
        "final class ", cls, " implements TilRuntime.EnumValue {\n",
        "    long tag;\n",
        "    Object payload;\n",
        "    boolean deleted;\n\n",
        "    ", cls, "(long tag, Object payload) {\n",
        "        this.tag = tag;\n",
        "        this.payload = payload;\n",
        "    }\n\n")
    jvm_add_member(out, "INACTIVE_VIEW", format("    static final ", cls, " INACTIVE_VIEW = new ", cls, "(-1L, null);\n"))
    jvm_add_member(out, "tilTag", "    public long tilTag() { checkLive(); return tag; }\n")
    jvm_add_member(out, "tilOrdinal", format("    int tilOrdinal() {\n",
        "        checkLive();\n", ordinals, "    }\n"))
    jvm_add_member(out, "tilPayload", "    public Object tilPayload() { checkLive(); return payload; }\n")
    jvm_add_member(out, "tilSetPayload",
        "    public void tilSetPayload(Object value) { checkLive(); payload = value; }\n")
    jvm_add_member(out, "tilVariantName", format("    public String tilVariantName() {\n",
        variant_names, "    }\n"))
    jvm_add_member(out, "copy", format("    ", cls, " copy() {\n",
        "        if (deleted) { throw new IllegalStateException(\"copy of deleted enum\"); }\n",
        "        return new ", cls, "(tag, payload);\n",
        "    }\n"))
    jvm_add_member(out, "cloneValue", format("    ", cls, " cloneValue() {\n",
        "        checkLive();\n", payload_clones, "        return copy();\n    }\n"))
    jvm_add_member(out, "swapContents", format("    void swapContents(", cls, " other) {\n",
        "        checkLive();\n",
        "        other.checkLive();\n",
        "        long t = tag; tag = other.tag; other.tag = t;\n",
        "        Object p = payload; payload = other.payload; other.payload = p;\n",
        "    }\n"))
    // assignFrom: a write through a ref binding (`case .V(p): p = q`,
    // C's `*p = q`) -- this object takes the new value's contents in place,
    // so the enum or borrowed referent it is sees them. The old contents
    // were already settled by the assignment's save_old_delete, so this
    // may be a deleted object coming back to life.
    jvm_add_member(out, "assignFrom", format("    void assignFrom(", cls, " other) {\n",
        "        other.checkLive();\n",
        "        tag = other.tag;\n",
        "        payload = other.payload;\n",
        "        deleted = false;\n",
        "    }\n"))
    jvm_add_member(out, "sameTag", format("    boolean sameTag(", cls, " other) {\n",
        "        checkLive();\n",
        "        other.checkLive();\n",
        "        return tag == other.tag;\n",
        "    }\n"))
    jvm_add_member(out, "checkLive", format("    private void checkLive() {\n",
        "        if (deleted) { throw new IllegalStateException(\"use after enum delete\"); }\n",
        "    }\n"))
    jvm_add_member(out, "delete", format("    void delete() {\n",
        "        checkLive();\n",
        "        deleted = true;\n",
        "        payload = null;\n",
        "    }\n"))
    out.tail = "}\n\n"
    return out
}

priv jvm_emit_funcsig := func(fexpr: Expr, package_name: Str,
    lp: LoadedProgram) returns JvmClassOut {
        ref fd : FunctionDef = funcdef_of(fexpr)
        cls := jvm_funcsig_class(fd, lp.ctx.symbols)
        ret := jvm_signature_return_type(fd, lp)
        mut params := ""
        mut args := ""
        for i in 0..fd.sig.params.len() {
            if i > 0 {
                params = format(params, ", ")
                args = format(args, ", ")
            }
            pname := format("p", i.to_str())
            params = format(params, jvm_signature_param_type(fd, i, lp), " ", pname)
            args = format(args, pname)
        }
        mut invoke := format("        TilRuntime.checkClosure(this);\n        ")
        if ret != "void" { invoke = format(invoke, "return ") }
        invoke = format(invoke, "call(", args, ");\n")
        // `call` is the interface's one abstract method, which every
        // implementing lambda supplies, so it stays in the fixed text.
        mut out := JvmClassOut(name = cls.clone())
        out.head = format(jvm_file_head(package_name),
            "@FunctionalInterface\n",
            "interface ", cls, " extends TilRuntime.Closure {\n",
            "    ", ret, " call(", params, ");\n")
        jvm_add_member(out, "invoke", format("    default ", ret, " invoke(", params, ") {\n",
            invoke,
            "    }\n"))
        out.tail = "}\n"
        return out
}

priv jvm_emit_unit := proc(unit_path: Str, root_path: Str, package_name: Str,
    reachable: Set(Str), mut state: JvmEmitState, lp: LoadedProgram) returns JvmClassOut {
        ref iu : ImportUnit = lp.ctx.imported[unit_path]
        state.path = unit_path.clone()
        cls := jvm_unit_class(unit_path)
        mut out := JvmClassOut(name = cls.clone())
        out.head = format(jvm_file_head(package_name),
            "final class ", cls, " {\n",
            "    private ", cls, "() {}\n\n")
        for stmt : Expr in iu.ast.children {
            switch stmt.node_type {
            case .Decl:
                if stmt.children.len() > 0 {
                    if stmt.children[0].node_type.is(NodeType.FuncDef) {
                        ref dd : Declaration = decl_of(stmt)
                        if unit_path.eq(root_path).or(reachable.has(dd.name)) {
                            jvm_add_member(out, jvm_func_name(dd.name),
                                jvm_emit_function(stmt, 1, state, lp))
                        }
                    }
                }
            case:
            }
        }
        out.tail = "}\n"
        return out
}

// #375: mode test (and `til test`) runs the program's tests the way the
// interpreter and the C back end do: every top-level test() in unit order,
// a `  pass: <name>` line on stderr after each returns, then the count. A
// test that panics never reaches its line, and the panic is the exit
// status. Ignoring run_tests -- what this back end did -- ran no test at
// all and exited 0, a silent pass. A test() inside a struct or enum
// namespace is refused at translation until its Java home is settled.
priv jvm_emit_test_calls := proc(mut state: JvmEmitState, lp: LoadedProgram) returns Str {
    mut out := ""
    mut count : I64 = 0
    for u : ProgramUnit in lp.units {
        ref tiu : ImportUnit = lp.ctx.imported[u.path]
        for stmt : Expr in tiu.ast.children {
            if jvm_is_test_decl(stmt) {
                ref tdd : Declaration = decl_of(stmt)
                count = count + 1
                out = format(out, "        ", jvm_unit_class(u.path), ".", jvm_func_name(tdd.name), "();\n",
                    "        System.err.println(\"  pass: ", tdd.name, "\");\n")
            }
            if stmt.node_type.is(NodeType.Decl).and(stmt.children.len().gt(0)) {
                ref trhs : Expr = stmt.children[0]
                if trhs.node_type.is(NodeType.StructDef).or(trhs.node_type.is(NodeType.EnumDef)) {
                    ref tns : Vec(Declaration) = def_ns_decls(trhs)
                    for nsd : Declaration in tns {
                        if nsd.default_value.is_some() {
                            switch nsd.default_expr().node_type {
                            case .FuncDef(nsfd):
                                if nsfd.sig.func_type.is(FuncType.Test) {
                                    jvm_fail_expr(nsd.default_expr(), "test() inside a namespace", state, lp.ctx.symbols.names)
                                }
                            case:
                            }
                        }
                    }
                }
            }
        }
    }
    if count == 0 { return format(out, "        System.err.println(\"no tests found\");\n") }
    return format(out, "        System.err.println(\"", count.to_str(), "/", count.to_str(), " tests passed\");\n")
}

priv jvm_is_test_decl := func(stmt: Expr) returns Bool {
    if stmt.node_type.is(NodeType.Decl).not().or(stmt.children.len() == 0) { return false }
    switch stmt.children[0].node_type {
    case .FuncDef(jtd_fd): return jtd_fd.sig.func_type.is(FuncType.Test)
    case: return false
    }
}

// The declared type of a namespace data member (inferred from its value
// when unannotated, as C's ns_data_ctype does).
priv jvm_ns_data_type := func(dd: Declaration) returns Type {
    if dd.til_type.is(Type.Unknown) { return dd.default_expr().til_type().clone() }
    return dd.til_type.clone()
}

// The struct/enum types that may hold namespace data, in C's order:
// unit declarations first (emit_ns_inits), then generic instances.
priv jvm_ns_type_order := func(lp: LoadedProgram) returns Vec(Str) {
    mut names := Vec(Str).new()
    mut seen := Set(Str).new()
    for unit_path : Str in lp.unit_paths() {
        ref iu : ImportUnit = lp.ctx.imported[unit_path]
        for stmt : Expr in iu.ast.children {
            if is_struct_or_enum(stmt) {
                ref owner : Declaration = decl_of(stmt)
                if seen.has(owner.name).not() {
                    seen.add(own owner.name.clone())
                    names.push(own owner.name.clone())
                }
            }
        }
    }
    for i in 0..lp.ctx.struct_layouts.len() {
        ref type_name : Str = lp.ctx.struct_layouts.keys.unsafe_get(i)
        if seen.has(type_name).not() {
            seen.add(own type_name.clone())
            names.push(own type_name.clone())
        }
    }
    return names
}

// #375: the namespace data the program uses, initialized at the top of
// Main.main as C's emit_ns_inits does at program start: per type in
// ns_const_eval_order, so a member's initializer sees the members it
// reads. An initializer can itself read more namespace data, so this
// re-emits until the used set stops growing.
priv jvm_emit_ns_inits := proc(mut state: JvmEmitState, lp: LoadedProgram) returns Str {
    type_order := jvm_ns_type_order(lp)
    mut out := ""
    mut prev : I64 = -1
    while state.ns_used.len().to_i64() != prev {
        prev = state.ns_used.len().to_i64()
        out = ""
        for tname : Str in type_order {
            def_o := lp.ctx.scope.get_struct(tname, lp.ctx.symbols)
            if def_o.is_none() { continue }
            ref def : Expr = def_o.unwrap()
            ref ns : Vec(Declaration) = def_ns_decls(def)
            order := ns_const_eval_order(tname, def, lp.ctx.symbols)
            for pos : I64 in order {
                idx := pos.to_usize()
                if ns_member_is_data(def, idx).not() { continue }
                ref member : Str = def_ns_name_at(def, idx)
                if state.ns_used.has(format(tname, ".", member)).not() { continue }
                ref dd : Declaration = ns.unsafe_get(idx)
                ref init_expr : Expr = dd.default_expr()
                if dd.external_symbol.len() > 0 {
                    jvm_fail_expr(init_expr, "external namespace data", state, lp.ctx.symbols.names)
                    continue
                }
                target := jvm_ns_static(init_expr, tname, member, state, lp)
                value := jvm_emit_expr(init_expr, state, lp)
                t := jvm_ns_data_type(dd)
                mut init := format(target, " = ", value)
                if jvm_is_scalar(t, lp) { init = format(target, " = ", jvm_new_cell(t, value, lp)) }
                out = format(out, jvm_source_comment(init_expr, state, 2), jvm_indent(2), init, ";\n")
            }
        }
    }
    return out
}

// The static field declarations for the used namespace data, added to
// each owner's class.
priv jvm_add_ns_fields := func(state: JvmEmitState, mut classes: Vec(JvmClassOut),
    lp: LoadedProgram) {
        for tname : Str in jvm_ns_type_order(lp) {
            def_o := lp.ctx.scope.get_struct(tname, lp.ctx.symbols)
            if def_o.is_none() { continue }
            ref def : Expr = def_o.unwrap()
            ref ns : Vec(Declaration) = def_ns_decls(def)
            mut cls := jvm_struct_class(tname)
            if def.node_type.is(NodeType.EnumDef) { cls = jvm_enum_class(tname) }
            for idx in 0..ns.len() {
                if ns_member_is_data(def, idx).not() { continue }
                ref member : Str = def_ns_name_at(def, idx)
                if state.ns_used.has(format(tname, ".", member)).not() { continue }
                t := jvm_ns_data_type(ns.unsafe_get(idx))
                mut jt := jvm_type_lp(t, lp)
                if jvm_is_scalar(t, lp) { jt = jvm_cell_type(t, lp) }
                field := format("ns_", jvm_package_segment(member))
                mut found := false
                for ci in 0..classes.len() {
                    if classes[ci].name == cls {
                        jvm_add_member(classes[ci], field, format("    static ", jt, " ", field, ";\n"))
                        found = true
                    }
                }
                if found.not() { panic(__LOC__, "JVM class missing for namespace data: ", cls) }
            }
        }
}

// dyn_size_of: a type's storage size by NAME, for the runtime-typed
// containers (Tuple, the std dyn_* family). The same name set as C's
// emit_dyn_size_of_body -- primitives, the width aliases, Dynamic, the
// closure stand-ins, every struct and enum -- each sized as this back end
// stores it (jvm_storage_size). An unknown name fails loudly, as in C.
priv jvm_emit_dyn_size_of := func(lp: LoadedProgram) returns Str {
    usize_t := type_from_name_init_name("USize", lp.ctx.scope, lp.ctx.symbols)
    rt := jvm_type_lp(usize_t, lp)
    mut arms := ""
    mut seen := Set(Str).new()
    mut names := Vec(Str).new()
    for prim : Str in PRIM_NAMES { names.push(own prim.clone()) }
    for alias_name : Str in WIDTH_ALIAS_NAMES { names.push(own alias_name.clone()) }
    names.push(own "Dynamic")
    for upath : Str in lp.unit_paths() {
        ref iu : ImportUnit = lp.ctx.imported[upath]
        for stmt : Expr in iu.ast.children {
            if is_struct_or_enum(stmt).not() { continue }
            names.push(own decl_of(stmt).name.clone())
        }
    }
    for tname : Str in names {
        if seen.has(tname) { continue }
        seen.add(own tname.clone())
        t := type_from_name_init_name(tname, lp.ctx.scope, lp.ctx.symbols)
        mut size : USize = 0
        if tname == "Dynamic" { size = jvm_storage_size(Type.Dynamic, lp) }
        else if is_primitive(jvm_concrete(t, lp)).or(is_struct_type(t)).or(is_enum_type(t)) {
            size = jvm_storage_size(t, lp)
        } else { continue }
        arms = format(arms, "        case \"", tname, "\": return ", jvm_int_const(usize_t, size.to_str(), lp), ";\n")
    }
    // The closure stand-ins: a pointer-sized slot, as C's sizeof(TilClosure *).
    ptr_size := jvm_int_const(usize_t, jvm_storage_size(Type.Dynamic, lp).to_str(), lp)
    arms = format(arms, "        case \"Fn\": return ", ptr_size, ";\n",
        "        case \"Body\": return ", ptr_size, ";\n")
    return format("    static ", rt, " dynSizeOf(TilRuntime.Str typeName) {\n",
        "        String name = TilRuntime.javaString(typeName);\n",
        "        switch (name) {\n", arms,
        "        default: throw new IllegalStateException(\"dyn_size_of: unknown type \" + name);\n",
        "        }\n",
        "    }\n")
}

priv jvm_emit_main := proc(root: ProgramUnit, package_name: Str,
    mut state: JvmEmitState, lp: LoadedProgram) returns Str {
        ref iu : ImportUnit = lp.ctx.imported[root.path]
        state.path = root.path.clone()
        saved_cells := state.cells.clone()
        saved_cell_types := state.cell_types.clone()
        saved_raw_refs := state.raw_refs.clone()
        saved_callable_defs := state.callable_defs.clone()
        saved_return_cell := state.return_cell
        state.cells = Set(Str).new()
        state.cell_types = Map(Str, Str).new()
        state.raw_refs = Set(Str).new()
        state.callable_defs = Map(Str, Str).new()
        state.return_cell = false
        mut main_body := ""
        mut main_fexpr := Option(ref Expr).None
        for stmt : Expr in iu.ast.children {
            switch stmt.node_type {
            case .Decl(dd):
                if stmt.children.len() > 0 {
                    if stmt.children[0].node_type.is(NodeType.FuncDef) {
                        if dd.name == "main" {
                            main_fexpr = safe_ref(stmt.children[0])
                        }
                    }
                }
            case:
            }
        }
        // Under run_tests the tests are the entry points, as in the
        // interpreter: a mode cli file with test() decls runs only those.
        if main_fexpr.is_some().and(lp.run_tests.not()) {
            ref fexpr : Expr = main_fexpr.unwrap()
            ref fd : FunctionDef = funcdef_of(fexpr)
            if fd.sig.params.len().gt(0).or(fd.sig.return_type.len().gt(0)) {
                jvm_fail_expr(fexpr, "main parameters/return value in Stage D", state, lp.ctx.symbols.names)
            }
            jvm_collect_cells(fexpr.children[0], state.cells, state.raw_refs, lp)
            jvm_collect_cell_types(fexpr.children[0], state.cell_types, lp)
            main_body = jvm_emit_body(fexpr.children[0], 2, state, lp)
        } else {
            jvm_collect_cells(iu.ast, state.cells, state.raw_refs, lp)
            jvm_collect_cell_types(iu.ast, state.cell_types, lp)
            for stmt : Expr in iu.ast.children {
                mut is_definition := false
                switch stmt.node_type {
                case .Decl:
                    if stmt.children.len() > 0 {
                        is_definition = stmt.children[0].node_type.is(NodeType.FuncDef)
                            .or(stmt.children[0].node_type.is(NodeType.StructDef))
                            .or(stmt.children[0].node_type.is(NodeType.EnumDef))
                    }
                case:
                }
                if is_definition.not() {
                    main_body = format(main_body, jvm_emit_stmt(stmt, 2, state, lp))
                }
            }
            if lp.run_tests { main_body = format(main_body, jvm_emit_test_calls(state, lp)) }
        }
        ns_inits := jvm_emit_ns_inits(state, lp)
        out := format("package ", package_name, ";\n\n",
            "import til.runtime.TilRuntime;\n\n",
            "public final class Main {\n",
            "    private Main() {}\n\n",
            "    public static void main(String[] args) {\n",
            ns_inits, main_body,
            "    }\n",
            "}\n")
        state.cells = saved_cells
        state.cell_types = saved_cell_types
        state.raw_refs = saved_raw_refs
        state.callable_defs = saved_callable_defs
        state.return_cell = saved_return_cell
        return out
}

jvm_codegen_translate := proc(lp: LoadedProgram, source_dir: Str,
    package_dir: Str, source_path: Str, args_path: Str,
    package_name: Str) returns I32 {
        if lp.cur_mode.is_library {
            println("error: JVM mode lib support is not implemented")
            return 1
        }
        if lp.link_c_paths.len().gt(0).or(lp.link_flags.len().gt(0))
            .or(lp.include_flags.len().gt(0)) {
            println("error: JVM target does not support C link inputs")
            return 1
        }

        File.remove_tree(source_dir)
        File.remove(args_path)
        if mkdir_p(package_dir) != 0 { panic("failed to create JVM package output dir") }

        compiler_root := lp.ext_c_path.strip_suffix("/src/c/ext.c")
        runtime_path := format(compiler_root, "/src/jvm/TilRuntime.java")
        if File.is_file(runtime_path).not() {
            println(format("error: JVM runtime source is missing: ", runtime_path))
            return 1
        }

        mut state := JvmEmitState()
        mut classes := Vec(JvmClassOut).new()
        mut emitted_types := Set(Str).new()
        mut emitted_funcsigs := Set(Str).new()
        ref root : ProgramUnit = lp.units[lp.units.len() - 1]
        ref root_iu : ImportUnit = lp.ctx.imported[root.path]
        mut reachable_names := Vec(Str).new()
        mut reachable_seen := Set(Str).new()
        jvm_collect_reachable(root_iu.ast, reachable_names, reachable_seen, lp)
        if lp.run_tests {
            // Tests are entry points: emit each one wherever it lives, and
            // what it calls.
            for tu : ProgramUnit in lp.units {
                ref tu_iu : ImportUnit = lp.ctx.imported[tu.path]
                for tstmt : Expr in tu_iu.ast.children {
                    if jvm_is_test_decl(tstmt) {
                        ref tsd : Declaration = decl_of(tstmt)
                        if reachable_seen.has(tsd.name).not() {
                            reachable_seen.add(own tsd.name.clone())
                            reachable_names.push(own tsd.name.clone())
                        }
                        jvm_collect_reachable(tstmt, reachable_names, reachable_seen, lp)
                    }
                }
            }
        }
        for loaded_path : Str in lp.unit_paths() {
            mut unit_out := jvm_emit_unit(loaded_path, root.path, package_name,
                reachable_seen, state, lp)
            unit_out.path = format(package_dir, "/", unit_out.name, ".java")
            classes.push(own unit_out)
            ref iu : ImportUnit = lp.ctx.imported[loaded_path]
            state.path = loaded_path.clone()
            for stmt : Expr in iu.ast.children {
                switch stmt.node_type {
                case .Decl(dd):
                    if stmt.children.len() > 0 {
                        if stmt.children[0].node_type.is(NodeType.StructDef) {
                            emitted_types.add(own dd.name.clone())
                            mut struct_out := jvm_emit_struct(stmt, package_name, state, lp)
                            struct_out.path = format(package_dir, "/", struct_out.name, ".java")
                            classes.push(own struct_out)
                        } else if stmt.children[0].node_type.is(NodeType.EnumDef) {
                            emitted_types.add(own dd.name.clone())
                            mut enum_out := jvm_emit_enum(stmt, package_name, lp)
                            enum_out.path = format(package_dir, "/", enum_out.name, ".java")
                            classes.push(own enum_out)
                        } else if stmt.children[0].node_type.is(NodeType.FuncDef) {
                            ref fexpr : Expr = stmt.children[0]
                            ref fd : FunctionDef = funcdef_of(fexpr)
                            if (fexpr.children.len() == 0).and(fd.sig.func_type.is_plain()) {
                                funcsigs_class := jvm_funcsig_class(fd, lp.ctx.symbols)
                                if emitted_funcsigs.has(funcsigs_class).not() {
                                    emitted_funcsigs.add(own funcsigs_class.clone())
                                    mut funcsig_out := jvm_emit_funcsig(fexpr, package_name, lp)
                                    funcsig_out.path = format(package_dir, "/", funcsigs_class, ".java")
                                    classes.push(own funcsig_out)
                                }
                            }
                        }
                    }
                case:
                }
            }
        }
        for i in 0..lp.ctx.struct_layouts.len() {
            ref type_name : Str = lp.ctx.struct_layouts.keys.unsafe_get(i)
            if emitted_types.has(type_name).not() {
                def_o := lp.ctx.scope.get_struct(type_name, lp.ctx.symbols)
                if def_o.is_some() {
                    ref def_expr : Expr = def_o.unwrap()
                    mut synthetic := Expr.new(own NodeType.Decl(Declaration(name = type_name.clone())),
                        def_expr.line, def_expr.col)
                    synthetic.add_child(own def_expr.clone())
                    if def_expr.node_type.is(NodeType.StructDef) {
                        mut struct_out := jvm_emit_struct(synthetic, package_name, state, lp)
                        struct_out.path = format(package_dir, "/", struct_out.name, ".java")
                        classes.push(own struct_out)
                    } else if def_expr.node_type.is(NodeType.EnumDef) {
                        mut enum_out := jvm_emit_enum(synthetic, package_name, lp)
                        enum_out.path = format(package_dir, "/", enum_out.name, ".java")
                        classes.push(own enum_out)
                    }
                }
            }
        }
        mut functions_out := JvmClassOut(name = "Functions")
        functions_out.path = format(package_dir, "/Functions.java")
        functions_out.head = format(jvm_file_head(package_name),
            "final class Functions {\n",
            "    private Functions() {}\n\n")
        for name : Str in reachable_names {
            if jvm_top_level_function_class(name, lp).len() == 0 {
                fdef_o := jvm_find_fdef(name, lp)
                if fdef_o.is_some() {
                    ref fexpr : Expr = fdef_o.unwrap()
                    ref fd : FunctionDef = funcdef_of(fexpr)
                    if fd.sig.func_type.is_bodyless()
                        .or(jvm_runtime_bound_function(name)).not() {
                        mut synthetic := Expr.new(own NodeType.Decl(Declaration(name = name.clone())),
                            fexpr.line, fexpr.col)
                        synthetic.add_child(own fexpr.clone())
                        jvm_add_member(functions_out, jvm_func_name(name),
                            jvm_emit_function(synthetic, 1, state, lp))
                    }
                }
            }
        }
        jvm_add_member(functions_out, "dynSizeOf", jvm_emit_dyn_size_of(lp))
        functions_out.tail = "}\n"
        classes.push(own functions_out)
        mut main_out := JvmClassOut(name = "Main")
        main_out.path = source_path.clone()
        main_out.head = jvm_emit_main(root, package_name, state, lp)
        classes.push(own main_out)
        jvm_add_ns_fields(state, classes, lp)
        if state.errors > 0 { return 1 }

        jvm_mark_live(File.readfile(runtime_path), classes)
        mut args := format(jvm_argfile_quote(runtime_path), "\n")
        for cls : JvmClassOut in classes {
            if cls.live {
                File.writefile(cls.path, jvm_render_class(cls))
                args = format(args, jvm_argfile_quote(cls.path), "\n")
            }
        }
        File.writefile(args_path, args)
        return 0
}
