mode lib
import("context")

// Check if a FieldAccess is a namespace access (type-level, not instance).
// The typer marks type-name idents with StructDef/EnumDef til_type.
priv scav_fa_is_ns := func(e: Expr) returns Bool {
    if e.children.len() == 0 { return false }
    ref obj : Expr = e.children[0]
    switch obj.node_type {
    case .Ident(id):
        obj_type_name_o := expr_type_name_ref(obj)
        if obj_type_name_o.is_some() {
            ref obj_type_name : Str = obj_type_name_o.unwrap()
            if obj_type_name.eq("StructDef").or(obj_type_name.eq("EnumDef")) {
                return true
            }
            // Also check: if ident name matches struct_name, it's a type reference
            if obj_type_name.eq(id.ident_name()) { return true }
        }
        // #326: a SCALAR type name as receiver -- `U32.size()` /
        // `I64.delete(...)`, which is what a monomorphized generic body
        // leaves behind once `T.size()` has T substituted to a primitive.
        // til_type_name returns "" for Type.Primitive, so the comparison
        // above cannot see them, and they were reachable only through the
        // blanket "every reached type roots its five lifecycle methods"
        // rule this issue removes. Keyed on the NAME, not the receiver's
        // type: an over-match (a binding actually called `U32`) costs one
        // unresolvable qualified name, never a missing symbol.
        if is_scalar_type_name(id.ident_name()) { return true }
    case:
    }
    return false
}

priv qualified_name := func(type_name: Str, method_name: Str) returns Str {
    return type_name.format(".", method_name)
}

vec_push_str := func(mut v: Vec(Str), s: Str) {
    v.push(own s.clone())
}

// Push qualified "Type.method" refs into v
push_qn := func(mut v: Vec(Str), type_name: Str, method: Str) {
    v.push(own qualified_name(type_name, method))
}

priv push_builtin_methods := func(mut v: Vec(Str), builtin_name: Str, m1: Str, m2: Str, m3: Str) {
    v.push(own qualified_name(builtin_name, m1))
    v.push(own qualified_name(builtin_name, m2))
    v.push(own qualified_name(builtin_name, m3))
}

collect_refs := func(e: Expr, mut refs: Vec(Str)) {

    // #210/#326: a swap_replace call on a Str target never emits its
    // callee -- the builder writes the explicit delete-copy-free sequence
    // instead (the `arg_tname == "Str"` branch in emit_stmt) -- so the
    // callee must not root `swap_bytes`. Sweeping it is safe now that
    // scavenge_imported erases swept names from the scope registries;
    // the first attempt left check_fcall_mut_args resolving the name
    // into a freed Expr. Non-Str targets keep the real call and fall
    // through to the normal walk.
    switch e.node_type {
    case .FCall(cr_fcd):
        if cr_fcd.swap_replace.and(e.children.len().gte(2)) {
            swap_tname_o := expr_type_name_ref(e.children[1])
            if swap_tname_o.is_some() {
                ref swap_tname : Str = swap_tname_o.unwrap()
                if swap_tname.eq("Str") {
                    for cr_swi in 1..e.children.len() {
                        collect_refs(e.children[cr_swi], refs)
                    }
                    return
                }
            }
        }
    case:
    }

    // #302 stage 4: an overwrite of an owned aggregate slot DRAINS the old
    // value, and the builder conjures `T_delete(_old, ...)` straight into
    // the C -- no FCall exists in the AST for this walk to see. Root the
    // method off the same flag the desugarer/garbager stamp, or a type
    // whose ONLY delete caller is a drain gets swept (the builder's
    // lifecycle gate then has nothing to emit and the C calls an
    // undeclared symbol). Regression: test/drain_only_delete.til.
    switch e.node_type {
    case .Assign(dr_ad):
        if dr_ad.save_old_delete.and(e.children.len().gt(0)) {
            dr_tn_o := expr_type_name_ref(e.children[0])
            if dr_tn_o.is_some() {
                ref dr_tn : Str = dr_tn_o.unwrap()
                vec_push_str(refs, dr_tn)
                push_qn(refs, dr_tn, "delete")
            }
        }
    case .FieldAssign(dr_fad):
        if dr_fad.save_old_delete.and(e.children.len().gt(1)) {
            dr_tn2_o := expr_type_name_ref(e.children[1])
            if dr_tn2_o.is_some() {
                ref dr_tn2 : Str = dr_tn2_o.unwrap()
                vec_push_str(refs, dr_tn2)
                push_qn(refs, dr_tn2, "delete")
            }
        }
    case:
    }

    switch e.node_type {
    case .Ident(ident):
        vec_push_str(refs, ident.ident_name())
        // A runtime callable value carries its FuncSig in the type payload.
        // The signature declaration must survive even when only the value's
        // name appears in executable code.
        if e.til_type().is(Type.FuncPtrSig) {
            sig_name := til_type_name(e.til_type())
            if sig_name.len() > 0 { vec_push_str(refs, sig_name) }
        }
    case .Assign(adata):
        // An assignment TARGET names a binding the same way a read does --
        // the name lives in the node data, not in an Ident child, so
        // without this case a global written by a reached function (e.g.
        // std/doc's __doc_init__ storing the registry blobs) is invisible
        // to the walk and gets swept out from under it (#326).
        vec_push_str(refs, adata.name)
    case .FCall:
        // Check for namespace method call: Type.method(args...)
        if fcall_is_direct(e).and(e.children.len() > 0) {
            if e.children[0].node_type.is(NodeType.FieldAccess) {
                if scav_fa_is_ns(e.children[0]) {
                    ref fa : Expr = e.children[0]
                    ref type_name : IdentData = ident_of(fa.children[0])
                    ref method : FieldAccessData = fieldaccess_of(fa)
                    vec_push_str(refs, type_name.ident_name())
                    push_qn(refs, type_name.ident_name(), method.field_access_name())
                    // Issue #56/#57: when the typer rewrites a Type-typed
                    // arg (e.g. count_variants(Color3) where T: Type) into
                    // Type.Enum("Color3") / Type.Struct(...) / Type.Custom(...),
                    // the underlying type name only survives as the string
                    // literal arg. Without recording it here the scavenger
                    // would prune the enum/struct decl as unused.
                    if type_name.ident_name() == "Type" {
                        ref mn : Str = method.field_access_name()
                        is_named_type_ctor := mn.eq("Enum").or(mn.eq("Struct")).or(mn.eq("Custom"))
                        if is_named_type_ctor.and(e.children.len().gte(2)) {
                            switch e.children[1].node_type {
                            case .Literal(Literal.Str(tname)):
                                vec_push_str(refs, tname)
                            case:
                            }
                        }
                    }
                    // Recurse into args (skip callee -- already handled)
                    for i in 1..e.children.len() {
                        collect_refs(e.children[i], refs)
                    }
                    return
                }
            }
        }
        // array()/vec() builtins need Array/Vec constructor methods
        if fcall_is_direct(e).and(e.children.len() >= 2) {
            if e.children[0].node_type.is(NodeType.Ident) {
                ref cn : IdentData = ident_of(e.children[0])
                if cn.ident_name() == "array" {
                    push_builtin_methods(refs, "Array", "new", "set", "delete")
                } else if cn.ident_name() == "vec" {
                    push_builtin_methods(refs, "Vec", "new", "push", "delete")
                } else if cn.ident_name().eq("assert_eq").or(cn.ident_name().starts_with("assert_eq__")) {
                    // assert_eq's generic body emits T.to_str after this
                    // reachability walk. The concrete type argument is at
                    // the call site for a direct generic call, or the
                    // monomorphized callee suffix by this phase. Retain
                    // just that method rather than every generated to_str.
                    mut assert_type_name := ""
                    if cn.ident_name() == "assert_eq" {
                        // #326: take the name from the RESOLVED type of
                        // the compared value, not from the type
                        // argument's source spelling. The generic body
                        // emits `<resolved>_to_str`, and the two differ
                        // whenever the spelling is an alias: the old
                        // hardcoded USize->U32 / UPtr->U64 pair papered
                        // over the common case but is only right at the
                        // default build width, and it still missed
                        // test/aliases.til, where the file's own
                        // `USize := U64` shadows the core alias the
                        // typer actually resolved `v.len()` through.
                        if e.children.len() >= 3 {
                            assert_type_name = resolved_type_name(e.children[2].til_type())
                        }
                        if assert_type_name.len() == 0 {
                            switch e.children[1].node_type {
                            case .Ident(assert_type):
                                assert_type_name = Str.clone(assert_type.ident_name())
                            case:
                            }
                        }
                    } else {
                        assert_type_name = cn.ident_name().substr(11, cn.ident_name().len() - 11)
                    }
                    if assert_type_name.len() > 0 {
                        vec_push_str(refs, assert_type_name)
                        push_qn(refs, assert_type_name, "to_str")
                    }
                } else if cn.ident_name().eq("struct_def_of").or(cn.ident_name().eq("enum_def_of")) {
                    // Issue #56/#57: struct_def_of("X") / enum_def_of("X")
                    // builds a runtime StructDef/EnumDef value by querying
                    // the introspection primitives for type X. Pull X out
                    // of the string-literal arg so the underlying decl
                    // isn't scavenged as unused.
                    switch e.children[1].node_type {
                    case .Literal(Literal.Str(tname2)):
                        vec_push_str(refs, tname2)
                    case:
                    }
                } else if cn.ident_name().eq("dyn_call").or(cn.ident_name().eq("dyn_call_ret")).or(cn.ident_name().eq("dyn_fn")).or(cn.ident_name().eq("dyn_has_method")) {
                    // #269: a method reached only through the dyn machinery
                    // has no static Type.method callsite, so the walk above
                    // never records it and the scavenger would prune it --
                    // leaving the runtime dispatch pointing at a freed
                    // FuncDef. The method name is a string literal at
                    // child(2). When the type name (child(1)) is a literal
                    // too, keep exactly Type.method; when it is a runtime
                    // expression (interface dispatch reads the box's
                    // iface_type_name field), keep `method` on every type
                    // via the "*.method" wildcard the reachability walk
                    // expands (see scavenge_visited_imported).
                    if e.children.len() >= 3 {
                        switch e.children[2].node_type {
                        case .Literal(Literal.Str(dyn_mname)):
                            switch e.children[1].node_type {
                            case .Literal(Literal.Str(dyn_tname)):
                                vec_push_str(refs, dyn_tname)
                                push_qn(refs, dyn_tname, dyn_mname)
                            case:
                                vec_push_str(refs, format("*.", dyn_mname))
                            }
                        case:
                        }
                    }
                }
            }
        }
    case .FuncDef(fdef):
        // #326: a macro's SIGNATURE is comptime. It is fully expanded before
        // codegen, so neither its parameters nor its result ever exist at
        // runtime -- see the return-type note below for what rooting them
        // cost. `macro(T: Type)` is the generic-type-constructor shape, so
        // this is also what stops every generic container from rooting the
        // Type enum and its Primitive payload.
        cr_is_macro := fdef.func_type.is(FuncType.Macro)
        for p : Declaration in fdef.params {
            if p.til_type.is(Type.Unknown).not().and(cr_is_macro.not()) {
                vec_push_str(refs, p.type_name())
            }
        }
        if fdef.variadic_index >= 0 {
            vec_push_str(refs, "Array")
            push_qn(refs, "Array", "new")
            push_qn(refs, "Array", "set")
            push_qn(refs, "Array", "delete")
        }
        // #326: a macro's return type is a COMPTIME type. Macros are fully
        // expanded before codegen, so nothing in the emitted C ever
        // materializes one -- and a generic type constructor
        // (`Array := struct<T: Type>` lowers to `macro(T: Type) returns
        // StructDef`, `Option` to one returning EnumDef) is exactly that
        // shape. Rooting the return type made EVERY program that touches a
        // generic container -- `println("hi")` does, through the variadic
        // Array -- retain the compiler's own StructDef, and through its
        // `fields : Vec(Declaration)` the whole Declaration -> Expr ->
        // NodeType data model, since Declaration's field default is
        // `Expr.new(NodeType.NoDefaultArg, 0, 0)` and NodeType's payloads
        // close the cycle over every ast.til type. Reflection that really
        // does build a StructDef at runtime roots it honestly, through
        // struct_def_of's return type.
        if fdef.return_type.len().gt(0).and(cr_is_macro.not()) {
            vec_push_str(refs, fdef.return_type)
        }
    case .FieldAccess(field_name):
        if scav_fa_is_ns(e) {
            if e.children[0].node_type.is(NodeType.Ident) {
                ref type_name : IdentData = ident_of(e.children[0])
                vec_push_str(refs, type_name.ident_name())
                push_qn(refs, type_name.ident_name(), field_name.field_access_name())
            }
        }
    case .FieldAssign(fad):
        if scav_fa_is_ns(e) {
            if e.children[0].node_type.is(NodeType.Ident) {
                ref type_name : IdentData = ident_of(e.children[0])
                vec_push_str(refs, type_name.ident_name())
                push_qn(refs, type_name.ident_name(), fad.name)
            }
        }
    case .Decl(decl):
        if decl.til_type.is(Type.Unknown).not() {
            vec_push_str(refs, decl.type_name())
        }
    case:
    }

    // Also traverse sdd.fields for structs
    switch e.node_type {
    case .StructDef(cr_sdd):
        for cr_fd : Declaration in cr_sdd.fields {
            // #326: a field DEFAULT is not a reachability edge. The typer
            // substitutes it into every construction site that OMITS the
            // field, and that copy is an ordinary AST child which the walk
            // reaches on its own -- the same fact that let the builder stop
            // emitting closure machinery for field defaults. Walking the
            // ORIGINAL kept whatever it named alive even when no
            // constructor ever omits the field: examples/lib/alphabeta.til
            // declares `h : Heuristic = default_heuristic` and chess always
            // supplies h, yet default_heuristic was emitted with no caller.
            // The field's declared type stays -- that one is the struct's
            // layout, not a default.
            if cr_fd.til_type.is(Type.Unknown).not() {
                vec_push_str(refs, cr_fd.type_name())
            }
        }
    case:
    }
    // Also traverse ns_decls entries (not in Expr children tree)
    if e.node_type.is(NodeType.StructDef).or(e.node_type.is(NodeType.EnumDef)) {
        ref cr_ns : Vec(Declaration) = def_ns_decls(e)
        for cr_d : Declaration in cr_ns {
            if cr_d.default_value.is_some() {
                collect_refs(cr_d.default_expr(), refs)
            }
        }
    }

    // #302 stage 4 / #326: a marked move CONSUMES the clone's argument.
    // The garbager records the decision on the FieldAssign (is_move)
    // instead of editing the shared AST, so a `T.clone(x)` FCall stays in
    // the tree that NO back end runs: the builder (emit_stmt's FieldAssign
    // arm) and the interpreter (eval_field_assign) both substitute
    // `rhs = rhs.children[1]` at consumption and store the argument
    // itself. Walking the ARGUMENT in the callee's place keeps the move's
    // own edges and drops the call nobody makes -- otherwise the clone is
    // reachable, survives the sweep, and gets a definition with no caller
    // (Node_clone in test/bug256.til, Vec__Str_clone in
    // examples/tilminal.til). Backend-agnostic on purpose: this is a fact
    // about what the move MEANS, not about how C spells it.
    //
    // The Assign twin is deliberately NOT here. The builder substitutes
    // there too, but the interpreter does not -- it still evaluates the
    // clone -- so on that node the call is real for one back end and
    // spliced for the other, and only the back end that splices may drop
    // it. Dropping it here sweeps ErrorWithMessage.clone out from under
    // test/errors.til's `throw my_error`.
    mut cr_has_subst := false
    switch e.node_type {
    case .FieldAssign(cr_mfad):
        if cr_mfad.is_move.and(e.children.len().gt(1)) {
            if rhs_is_clone_fcall(e.children[1]).and(e.children[1].children.len().gte(2)) {
                cr_has_subst = true
            }
        }
    case:
    }

    // Recurse into children
    mut cr_ci : USize = 0
    for c : Expr in e.children {
        cur_cr_ci := cr_ci
        cr_ci = cr_ci + 1
        if cr_has_subst.and(cur_cr_ci == 1) {
            collect_refs(c.children[1], refs)
            continue
        }
        collect_refs(c, refs)
    }
}

// Filter top-level declarations and namespace methods in-place using a
// precomputed visited set.
// #307: member names live in the ns_index (name -> position), so the
// mark pass walks the index pairs, the decl Vec compacts via
// delete_marked (the same mark/sweep master used on named decls), and
// the dropped members' entries leave the index with the surviving
// positions renumbered in place. Zero clones: the survivors (and their
// method-body ASTs) never move through a copy.
priv scavenge_members_in_place := func(mut decls: Vec(Declaration), mut idx: Map(Str, USize), type_name: Str, visited: Set(Str)) {
    n := decls.len()
    if n == 0 { return }
    marks : U8 = malloc(n)
    memset(marks, 0, n)
    mut dropped_any := false
    for q in 0..idx.keys.count {
        // Probed without joining: the visited set is sorted, so the
        // "Type.method" key is compared part by part instead of being
        // built and dropped once per member of every type.
        if qname_in_set(visited, type_name, ".", idx.keys.unsafe_get(q)).not() {
            p := idx.values.unsafe_get(q).clone()
            memset(ptr_add(marks, p), 1, 1)
            dropped_any = true
        }
    }
    if dropped_any.not() { return }
    decls.delete_marked(marks)
    // Index maintenance: delete dead entries, renumber survivors (a
    // surviving position falls by the dropped positions below it).
    // Compacting the sorted parallel key/value vecs preserves their
    // order; O(n^2) with tiny n, avoiding scratch allocations.
    kn := idx.keys.count
    mut nv := Vec(USize).new()
    mut kw : USize = 0
    mut kr : USize = 0
    while kr < kn {
        p2 := idx.values.unsafe_get(kr).clone()
        ref km : Bool = ptr_add(marks, p2)
        if km {
            Str.delete(own ptr_add(idx.keys.data, kr.mul(Str.size())), false)
            memset(ptr_add(idx.keys.data, kr.mul(Str.size())), 0, Str.size())
        } else {
            mut shift : USize = 0
            for q2 in 0..p2 {
                ref qm : Bool = ptr_add(marks, q2)
                if qm { shift = shift + 1 }
            }
            np := p2 - shift
            nv.push(own np)
            if kw != kr {
                memcpy(ptr_add(idx.keys.data, kw.mul(Str.size())), ptr_add(idx.keys.data, kr.mul(Str.size())), Str.size())
            }
            kw++
        }
        kr++
    }
    idx.keys.count = kw
    idx.values.move_from(own nv)
}

// #326: a top-level VALUE declaration -- not a func/struct/enum def, and
// not a type alias (`USize := U32`, which emits nothing but stays a name
// the builder resolves through the scope). A generated-function alias has
// the same AST shape, but its target is recorded in type_gen_synths and the
// alias is an ordinary sweepable reachability edge.
priv scav_is_value_decl := func(stmt: Expr, ctx: Context) returns Bool {
    if stmt.node_type.is(NodeType.Decl).not() { return false }
    if stmt.children.len() == 0 { return false }
    ref rhs : Expr = stmt.children[0]
    if rhs.node_type.is(NodeType.FuncDef) { return false }
    if rhs.node_type.is(NodeType.StructDef) { return false }
    if rhs.node_type.is(NodeType.EnumDef) { return false }
    if stmt.til_type().is(Type.None).and(rhs.node_type.is(NodeType.Ident)) {
        switch rhs.node_type {
        case .Ident(alias_id): return ctx.type_gen_synths.has(alias_id.ident_name())
        case: UNREACHABLE("expected Ident alias")
        }
    }
    return true
}

// #326: a user-unit top-level value can be swept only when dropping its
// initializer cannot drop an observable effect: a literal, or a bare ident
// (reading another global). Anything containing a call takes the
// conservative side and stays a blanket root -- in script mode a top-level
// `x := foo()` IS the program, whether or not x is ever read.
scav_value_decl_sweepable := func(stmt: Expr, ctx: Context) returns Bool {
    if scav_is_value_decl(stmt, ctx).not() { return false }
    ref rhs : Expr = stmt.children[0]
    return rhs.node_type.is(NodeType.Literal).or(rhs.node_type.is(NodeType.Ident))
}

// The name a top-level cleanup statement reclaims: `T.delete(<Ident>, ...)`
// or `free(<Ident>)`, the two shapes the garbager inserts for an owned
// global. Returns "" for anything else. Sweeping a global's declaration
// without its cleanup would leave the C referencing an undeclared symbol.
priv scav_cleanup_target := func(stmt: Expr) returns Str {
    if stmt.node_type.is(NodeType.FCall).not() { return "" }
    if stmt.children.len() < 2 { return "" }
    ref callee : Expr = stmt.children[0]
    mut is_cleanup := false
    switch callee.node_type {
    case .FieldAccess(fam):
        is_cleanup = fam.field_access_name().eq("delete")
    case .Ident(fin):
        is_cleanup = fin.ident_name().eq("free")
    case:
    }
    if is_cleanup.not() { return "" }
    switch stmt.children[1].node_type {
    case .Ident(n): return Str.clone(n.ident_name())
    case:
    }
    return ""
}

// `sweep_values` puts top-level value declarations in the same mark/sweep
// graph as the defs (#326). It is on for core units, whose top-level decls
// are compiler-provided constants: a user unit's top-level statements are
// the program itself in script mode (and its global initializers in
// cli/test mode), so dropping one there could drop an observable effect,
// not just an unread binding. User units still sweep the value decls
// scav_value_decl_sweepable proves effect-free (literal/ident
// initializers); the seeding in scavenge_visited_imported skips rooting
// exactly those, so the two sides agree on which decls are graph nodes.
// `swept_names` reports every top-level declaration this sweep FREED, so
// the caller can erase them from the scope registries. The registries hold
// pointers INTO the AST (func_defs/struct_defs/bindings), and a post-sweep
// pass that resolves a swept name by string -- the builder's
// check_fcall_mut_args on a spliced swap_replace callee was the proven case
// -- would otherwise read a freed Expr. Same hazard #328 fixed for retired
// generic templates; the sweep is just the other producer of it.
scavenge_filter := func(mut program: Expr, visited: Set(Str), sweep_values: Bool, mut swept_names: Vec(Str), ctx: Context) {
    pn := program.children.len()
    pm : U8 = malloc(pn)
    memset(pm, 0, pn)
    mut swept := Set(Str).new()
    for i in 0..pn {
        ref stmt : Expr = program.children[i]
        if is_def(stmt).not().and(sweep_values.and(scav_is_value_decl(stmt, ctx)).or(scav_value_decl_sweepable(stmt, ctx))) {
            ref vd : Declaration = decl_of(stmt)
            if visited.has(vd.name).not() {
                memset(ptr_add(pm, i), 1, 1)
                swept.add(own vd.name.clone())
                vec_push_str(swept_names, vd.name)
            }
        }
        if is_def(stmt) {
            ref d : Declaration = decl_of(stmt)
            // Issue #56/#57: synthetic anon-lifted decls (AnonStructN /
            // AnonEnumN) are emitted by the parser only when there's a
            // matching user site, so they're always reachable in spirit.
            // The scavenger's reachability walk can lose track of them
            // when the typer rewrites a Type-ident into a constructor
            // call and the hoister moves the type-name string into a
            // hoisted Str temp; keep them unconditionally rather than
            // duplicating that indirection here.
            is_anon_lifted := d.name.starts_with("AnonStruct").or(d.name.starts_with("AnonEnum"))
            if visited.has(d.name).not().and(is_anon_lifted.not()) {
                memset(ptr_add(pm, i), 1, 1)
                vec_push_str(swept_names, d.name)
            }
        }
    }
    for i in 0..pn {
        target := scav_cleanup_target(program.children[i])
        if target.len() == 0 { continue }
        if swept.has(target).not() { continue }
        memset(ptr_add(pm, i), 1, 1)
    }
    program.children.delete_marked(pm)

    for mut stmt : Expr in program.children {
        if is_struct_or_enum(stmt).not() { continue }
        ref sdecl : Declaration = decl_of(stmt)
        ref mut sdef : Expr = stmt.children[0]
        switch sdef.node_type {
        case .StructDef(scv_sdd):
            scavenge_members_in_place(scv_sdd.ns_decls, scv_sdd.ns_index, sdecl.name, visited)
        case .EnumDef(scv_edd):
            scavenge_members_in_place(scv_edd.ns_decls, scv_edd.ns_index, sdecl.name, visited)
        case:
            UNREACHABLE("unexpected ", sdef.node_type.head_str())
        }
    }
}

// --- Body-level DCE (post-constfolder dead temp elimination) -----------------

// Constant folding in constfolder replaces FCall nodes with literals, but the
// arg-temps that the typer hoisted (`hoisted__<Type>_<n>`) remain as sibling
// Decls with no remaining references. They're side-effect-free (literal
// RHS, by-value primitive type), so we can drop them outright instead of
// papering over the unused-variable warning with a `(void)<name>;`.

// dyn_call/dyn_call_ret FCalls carry args beyond `nargs` that the
// builder discards (see `is_dyn_call_name` handling in builder.til). So
// `dyn_call_ret(self, "method", nargs, arg1, ..., argN, extra...)` only
// "really uses" args up to index 4+nargs-1; later children are weak
// refs that should not pin a hoisted temp.
priv dyn_call_real_arg_count := func(e: Expr) returns USize {
    if e.node_type.is(NodeType.FCall).not() { return e.children.len() }
    if e.children.len() < 4 { return e.children.len() }
    mut is_dc := false
    switch e.children[0].node_type {
    case .Ident(cn): is_dc = cn.ident_name().eq("dyn_call").or(cn.ident_name().eq("dyn_call_ret"))
    case:
    }
    if is_dc.not() { return e.children.len() }
    mut nargs : USize = 0
    switch e.children[3].node_type {
    case .Literal(Literal.Num(s)):
        nargs = s.literal_num_text().to_usize()
    case:
        return e.children.len()
    }
    real := nargs + 4
    if real > e.children.len() { return e.children.len() }
    return real
}

// Collect Ident/Assign refs anywhere in the subtree. Inside any Body,
// skip trivial `<Type>.delete(<candidate>, false)` cleanup calls (at
// any nesting depth) so a candidate's auto-generated cleanup doesn't
// pin it. Phase 3 prunes those cleanup stmts alongside the candidate.
priv collect_body_refs := proc(e: Expr, mut refs: Set(Str), candidates: Set(Str)) {
    switch e.node_type {
    case .Ident(name):
        refs.add(own Str.clone(name.ident_name()))
    case .Assign(adata):
        refs.add(own adata.name.clone())
    // A capture list NAMES the enclosing local: the emitted env init reads
    // it (`til_env->x = &x`), so it is a real reference even when nothing
    // in the closure BODY mentions it anymore. Captures are Declaration
    // metadata, not child Exprs, so the walk below cannot see them -- and
    // the constfolder routinely erases the body's own mention (a closure
    // returning `norm(msg)` over a known-constant `msg` folds to the
    // literal). Without this the candidate looked dead, its Decl was
    // dropped, and the env init referenced a local that no longer existed:
    // "'msg' undeclared" from the C compiler, "closure capture binding not
    // found" from the interpreter.
    case .FuncDef(fd):
        for cap : Declaration in fd.captures {
            refs.add(own cap.name.clone())
        }
    // A capture BLOCK only reads through an env when it was lowered to a
    // closure (closure_name set). An inlined block reads the local
    // directly from the body, so its list adds nothing -- and pinning a
    // local whose only mention the constfolder erased would trip
    // -Werror=unused-variable on the emitted C.
    case .CaptureBlock(cbd):
        if cbd.closure_name.len() > 0 {
            for bcap : Declaration in cbd.captures {
                refs.add(own bcap.name.clone())
            }
        }
    case:
    }
    is_body := e.node_type.is(NodeType.Body)
    real_n := dyn_call_real_arg_count(e)
    mut idx : USize = 0
    for c : Expr in e.children {
        if idx >= real_n { break }
        if is_body {
            target := match_trivial_delete(c)
            if target.len().gt(0).and(candidates.has(target)) {
                idx++
                continue
            }
        }
        collect_body_refs(c, refs, candidates)
        idx++
    }
}

// Recognize the typer-emitted "trivial delete" pattern:
//
//     <TypeName>.delete(<Ident>, LiteralBool false)
//
// These are auto-generated cleanup calls for hoisted primitive temps
// and for LiteralStr arg-temps (which the typer marks Shallow so
// call_free=false). They emit as a bare `;` (the builder's by-value-
// delete shortcut) or as a no-op cleanup of a stack compound literal
// (TIL_CAP_LIT view), so dropping them with the temp is safe and lets
// DCE actually remove the temp without false-positive ref hits from
// the cleanup itself.
//
// Returns the target Ident name on match, "" otherwise.
priv match_trivial_delete := func(stmt: Expr) returns Str {
    if stmt.node_type.is(NodeType.FCall).not() { return "" }
    if stmt.children.len() != 3 { return "" }
    // An `own` arg is CONSUMING: the delete destroys the pointee (the
    // old element in Array.unsafe_set's `T.delete(own self.unsafe_get(i),
    // false)`), which is real program semantics, not a temp cleanup. The
    // generated cleanups this matcher exists for never mark the arg own
    // -- make_delete_call passes arg_is_own=is_heap, and a hoisted
    // primitive / LiteralStr temp is never heap. This went unseen while
    // the desugarer hoisted every call_free literal into an Ident (the
    // Ident failed the literal-bool check below), and matching the
    // consuming delete would prune it and orphan its receiver temp.
    if get_own_arg(stmt, 1) { return "" }
    ref callee : Expr = stmt.children[0]
    if callee.node_type.is(NodeType.FieldAccess).not() { return "" }
    mut method := ""
    switch callee.node_type {
    case .FieldAccess(m): method = Str.clone(m.field_access_name())
    case:
    }
    if method.eq("delete").not() { return "" }
    if callee.children.len() != 1 { return "" }
    if callee.children[0].node_type.is(NodeType.Ident).not() { return "" }
    ref arg0 : Expr = stmt.children[1]
    if arg0.node_type.is(NodeType.Ident).not() { return "" }
    ref arg1 : Expr = stmt.children[2]
    if arg1.node_type.is_literal_bool().not() { return "" }
    mut bv := false
    switch arg1.node_type {
    case .Literal(Literal.Bool(b)): bv = b
    case:
    }
    if bv { return "" }
    switch arg0.node_type {
    case .Ident(n): return Str.clone(n.ident_name())
    case:
    }
    return ""
}

// Side-effect-free, by-value RHS: dropping the binding cannot leak or
// observe anything. LiteralStr is included because the typer marks
// LiteralStr decls Shallow, the builder emits them as stack compound
// literals (no malloc), and the paired Str.delete uses call_free=false
// (no-op view cleanup) -- so dropping the Decl + its trivial delete
// has no observable effect.
priv rhs_is_pure_byvalue := func(e: Expr) returns Bool {
    switch e.node_type {
    case .Literal(Literal.Num):  return true
    case .Literal(Literal.Bool): return true
    case .Literal(Literal.Null): return true
    case .Literal(Literal.Str):  return true
    case:
    }
    return false
}

// One DCE pass over a single Body. Returns true if anything was removed.
// Mark codes for body rewrite: 0=keep (default), 1=delete, 2=replace-with-rhs.
priv MARK_DELETE : U8 = 1
priv MARK_REPLACE_RHS : U8 = 2

// Recursively prune trivial-delete stmts from any Body in the subtree
// when they target a name in `dropped`. Used after candidates have
// been dropped/replaced in the outer body, since their cleanup calls
// also live in nested early-return bodies (if-then deletes before a
// return) that the outer body's phase 3 didn't reach.
priv prune_trivial_deletes := proc(mut e: Expr, dropped: Set(Str)) {
    if e.node_type.is(NodeType.Body) {
        n := e.children.len()
        if n > 0 {
            marks : U8 = malloc(n)
            memset(marks, 0, n)
            mut any := false
            for i in 0..n {
                target := match_trivial_delete(e.children[i])
                if target.len() == 0 { continue }
                if dropped.has(target).not() { continue }
                memset(ptr_add(marks, i), 1, 1)
                any = true
            }
            if any { e.children.delete_marked(marks) }
        }
    }
    for mut c : Expr in e.children {
        prune_trivial_deletes(c, dropped)
    }
}

// `at_top_level` is true for the program-root body (which becomes
// main() for non-library modes). At top level we restrict candidates
// to compiler-internal `hoisted__*` names so we never drop a
// user-named global -- those may be exported and referenced from
// outside this body's view.
priv dce_one_body := proc(mut body: Expr, at_top_level: Bool) returns Bool {
    n := body.children.len()
    if n == 0 { return false }

    // Phase 1: identify candidate temp Decls. Two flavors:
    //   - literal-RHS by-value temps (LiteralNum/Bool/Null/Str): the
    //     whole Decl can be deleted outright. LiteralStr qualifies
    //     because the typer marks these decls Shallow and the builder
    //     emits them as stack compound literals -- no allocation, and
    //     the paired delete is a no-op view cleanup.
    //   - `_t_*` with a trivial stack-scalar FCall RHS: the binding is
    //     unused, but the FCall may have side effects, so replace the Decl
    //     with the bare FCall. Results that own storage stay as Decl + delete:
    //     the garbager's AST, not either backend, says how they are reclaimed.
    mut candidates := Set(Str).new()
    mut candidates_replace := Set(Str).new()
    for stmt : Expr in body.children {
        if stmt.node_type.is(NodeType.Decl).not() { continue }
        if stmt.children.len() == 0 { continue }
        switch stmt.node_type {
        case .Decl(dd):
            if dd.is_mut { continue }
            // At top level only ever drop compiler-internal temps;
            // user-named globals may be exported. Both hoisted__* and
            // codegen _t_* temps are compiler-internal (users cannot name
            // a leading-underscore binding), so both are safe to drop --
            // _t_* matters since constfolder's ext_func folding (issue #136
            // item 1) orphans arg temps like `_t_I64_858 = -2` in main()'s
            // top-level init.
            if at_top_level {
                is_internal := dd.name.starts_with("hoisted__").or(dd.name.starts_with("_t_"))
                if is_internal.not() { continue }
            }
            ref rhs : Expr = stmt.children[0]
            if dd.own_type.is(OwnType.Ref) {
                // Ref-typed hoisted temps come from stmt-level FCalls
                // whose declared return is `ref T` (e.g. advance(p)):
                // the borrow binding is never read, but the FCall has
                // the real side effect we need to keep.
                if rhs.node_type.is(NodeType.FCall).and(dd.name.starts_with("hoisted__")) {
                    candidates.add(own dd.name.clone())
                    candidates_replace.add(own dd.name.clone())
                }
            } else if rhs_is_pure_byvalue(rhs) {
                candidates.add(own dd.name.clone())
            } else if rhs.node_type.is(NodeType.FCall).and(dd.name.starts_with("hoisted__")) {
                if dd.gc_storage.is(GcStorage.Stack).and(rhs.til_type().is(Type.Primitive).or(rhs.til_type().is(Type.None))) {
                    candidates.add(own dd.name.clone())
                    candidates_replace.add(own dd.name.clone())
                }
            }
        case:
        }
    }

    // Phase 2: collect "real" refs -- everything except trivial deletes
    // that target a candidate temp. Those are weak refs we'll drop along
    // with the candidate.
    mut refs := Set(Str).new()
    for stmt : Expr in body.children {
        target := match_trivial_delete(stmt)
        if target.len().gt(0).and(candidates.has(target)) { continue }
        collect_body_refs(stmt, refs, candidates)
    }

    // Phase 3: mark Decls (delete or replace-with-rhs) and the
    // matching trivial-delete stmts.
    marks : U8 = malloc(n)
    memset(marks, 0, n)
    mut dropped := Set(Str).new()
    mut any := false
    for i in 0..n {
        ref stmt : Expr = body.children[i]
        if stmt.node_type.is(NodeType.Decl).not() { continue }
        switch stmt.node_type {
        case .Decl(dd):
            if candidates.has(dd.name).not() { continue }
            if refs.has(dd.name) { continue }
            mut code : U8 = MARK_DELETE
            if candidates_replace.has(dd.name) { code = MARK_REPLACE_RHS }
            memset(ptr_add(marks, i), code.to_i32(), 1)
            dropped.add(own dd.name.clone())
            any = true
        case:
        }
    }
    if any {
        for j in 0..n {
            target := match_trivial_delete(body.children[j])
            if target.len() == 0 { continue }
            if dropped.has(target).not() { continue }
            memset(ptr_add(marks, j), MARK_DELETE.to_i32(), 1)
        }
        // Rebuild body.children honoring the marks. DELETE skips the
        // stmt; REPLACE_RHS swaps the Decl for its RHS (the FCall is
        // moved in via push_take from a temporary Vec).
        mut old := body.children.take()
        mut new_ch := Vec(Expr).new()
        for k in 0..n {
            ref mark : U8 = ptr_add(marks, k)
            if mark == MARK_DELETE { continue }
            if mark == MARK_REPLACE_RHS {
                mut decl_children := old[k].children.take()
                new_ch.push_take(decl_children, 0)
                continue
            }
            new_ch.push_take(old, k)
        }
        body.children.move_from(own new_ch)
        // Prune trivial-delete stmts targeting dropped names from any
        // nested body (e.g. early-return cleanup inside an if-then).
        for mut bstmt : Expr in body.children {
            prune_trivial_deletes(bstmt, dropped)
        }
    }
    return any
}

// Constfolder folds an FCall RHS to a LiteralStr in place but doesn't
// touch the surrounding Decl's `own_type` -- the typer already
// committed to Own when the RHS was still an FCall returning an owned
// Str. The stale Own hides these decls from body DCE, so restore the
// typer's LiteralStr-decl invariant (Shallow). The paired delete needs
// no fixup here: the constfolder's normalize_folded_decl_deletes
// already rewrote it to the Stack shape (own bit off, call_free=false)
// at the fold site.
priv fix_stale_litstr_in_body := func(mut body: Expr) {
    for mut stmt : Expr in body.children {
        if stmt.node_type.is(NodeType.Decl).not() { continue }
        if stmt.children.len() == 0 { continue }
        switch stmt.node_type {
        case .Decl(dd):
            if dd.own_type.is(OwnType.Own).not() { continue }
            if stmt.children[0].node_type.is_literal_str().not() { continue }
            dd.own_type = OwnType.Shallow
        case:
        }
    }
}

// Recurse into nested bodies bottom-up; iterate to a fixed point so that
// removing a Decl in an inner body can free up references that let an
// outer Decl drop too. `at_top_level` is true only for the program-root
// body; recursion turns it off when descending into any nested Body
// (which is by definition inside a function/test/proc).
priv body_dce_walk := proc(mut e: Expr, at_top_level: Bool) {
    is_body := e.node_type.is(NodeType.Body)
    child_top := at_top_level.and(is_body.not())
    for mut c : Expr in e.children {
        body_dce_walk(c, child_top)
    }
    if is_body {
        // #302 stage 4/6: honest records/destructors first -- the drops
        // below key on gc_storage and on recognizable decl+delete pairs.
        constfolder_normalize_stack_decls_in_body(e)
        fix_stale_litstr_in_body(e)
        while dce_one_body(e, at_top_level) {}
    }
}

priv body_dce_ns := proc(mut rhs: Expr) {
    ref mut dce_ns : Vec(Declaration) = def_ns_decls(rhs)
    for mut nsd : Declaration in dce_ns {
        if nsd.default_value.is_none() { continue }
        if nsd.default_expr().node_type.is(NodeType.FuncDef).not() { continue }
        if nsd.default_expr().children.len() == 0 { continue }
        body_dce_walk(nsd.default_expr().children[0], false)
    }
}

dce_program_bodies := proc(mut program: Expr) {
    // Walk the program-root body (becomes main() for non-library
    // modes) and every function/test/proc body inside it.
    // body_dce_walk descends through Expr.children, so namespace
    // methods (which live in StructDef.ns_decls outside the children
    // tree) need a separate walk.
    body_dce_walk(program, true)
    for mut stmt : Expr in program.children {
        if is_def(stmt).not() { continue }
        ref mut rhs : Expr = stmt.children[0]
        if rhs.node_type.is(NodeType.StructDef).or(rhs.node_type.is(NodeType.EnumDef)) {
            body_dce_ns(rhs)
        }
    }
}

// --- Roots, reachability, and the phase entry (#326) ------------------------
//
// Everything below decides WHAT is reachable; everything above decides how
// to sweep what is not. It lived in loader.til -- the loader drives the
// pipeline, so the phase entry was called from there and the policy grew
// beside the call -- but the root policy, the BFS and the sweep are one
// phase, and they read nothing of the loader beyond the LoadedProgram
// handle every phase gets. The loader keeps exactly two things: the CALL
// to scavenge_imported (it still owns phase order) and validate_cli_main
// (a CLI-shape diagnostic that runs beside the call, not a scavenging
// decision).

// Scavenge across per-file units (rstil-style): compute a single visited set
// from merged views, then filter each file's canonical AST in ctx.imported.
priv DeclRef := struct {
    path := ""
    idx : USize = 0
}

// #326: the target of a type ALIAS declaration (`UPtr := U64`), or "" when
// `base` is not one. An alias emits no C of its own, so a qualified name on
// it -- `UPtr.size()`, which the builder lowers to `U64_size()` -- must be
// forwarded to the target's namespace or the target's method is never
// rooted. Same shape the builder and scavenger use to recognize an alias:
// a value Decl whose RHS is a bare Ident and whose type is None.
priv alias_target_imported := func(ctx: Context, tbl: Map(Str, DeclRef), base: Str) returns Str {
    if tbl.has(base).not() { return "" }
    ref dr : DeclRef = tbl[base]
    ref iu : ImportUnit = ctx.imported[dr.path]
    ref decl : Expr = iu.ast.children[dr.idx]
    if decl.node_type.is(NodeType.Decl).not() { return "" }
    if decl.children.len() == 0 { return "" }
    if decl.til_type().is(Type.None).not() { return "" }
    switch decl.children[0].node_type {
    case .Ident(alias_id): return Str.clone(alias_id.ident_name())
    case:
    }
    return ""
}

priv find_ns_decl_fdef_imported := func(ctx: Context, top: Map(Str, DeclRef), name: Str) returns Option(ref Expr) {
    dot := name.find(".")
    if dot < 0 { return Option(ref Expr).None }
    type_part := name.substr(0, dot.to_usize())
    if top.has(type_part).not() { return Option(ref Expr).None }
    ref dr : DeclRef = top[type_part]
    ref iu : ImportUnit = ctx.imported[dr.path]
    ref tdecl : Expr = iu.ast.children[dr.idx]
    if tdecl.node_type.is(NodeType.Decl).not() { return Option(ref Expr).None }
    if is_struct_or_enum(tdecl).not() { return Option(ref Expr).None }
    dot_u := dot.to_usize()
    method_part := name.substr(dot_u + 1, name.len().sub(dot_u) - 1)
    nsd_o := def_ns_get(tdecl.children[0], method_part)
    if nsd_o.is_some() {
        ref nsd : Declaration = nsd_o.unwrap()
        if nsd.default_value.is_some() {
            return Option(ref Expr).Some(nsd.default_expr())
        }
    }
    return Option(ref Expr).None
}

// #326: the argv-parsing helper a CLI parameter of type `tname` needs.
// This mirrors cli_box_expr in builder.til, which picks exactly ONE
// conversion per parameter type; keep the two in sync when adding a type
// (validate_cli_main already rejects any type neither of them handles).
priv seed_cli_arg_helpers := func(tname: Str, mut worklist: Vec(Str)) {
    // Str parses inline to a Str_clone of a CAP_LIT view; clone is already
    // an unconditional root because ext.c calls it. Every OTHER type goes
    // through the from_c_str pipeline -- `({ Str _cvv = Str_from_c_str(a);
    // T _v = <conv>; Str_delete(&_cvv, false); _v; })` (cli_view_value /
    // cli_view_box) -- so those two come with any scalar parameter.
    if tname == "Str" { return }
    push_qn(worklist, "Str", "from_c_str")
    push_qn(worklist, "Str", "delete")
    if tname == "I64" { push_qn(worklist, "Str", "to_i64") return }
    if tname == "U8" { push_qn(worklist, "Str", "to_u8") return }
    if tname == "I32" { push_qn(worklist, "Str", "to_i32") return }
    if tname == "U32" { push_qn(worklist, "Str", "to_u32") return }
    if tname == "F32" { push_qn(worklist, "Str", "to_f32") return }
    if tname == "F64" { push_qn(worklist, "Str", "to_f64") return }
    // The narrow signed/unsigned widths go through I64 first.
    if tname == "I8" { push_qn(worklist, "Str", "to_i64") push_qn(worklist, "I64", "to_i8") return }
    if tname == "I16" { push_qn(worklist, "Str", "to_i64") push_qn(worklist, "I64", "to_i16") return }
    if tname == "U16" { push_qn(worklist, "Str", "to_i64") push_qn(worklist, "I64", "to_u16") return }
    if or(tname.eq("U64"), tname.eq("USize"), tname.eq("UPtr")) { push_qn(worklist, "Str", "to_u64") return }
    // Bool compares the argument against the "true"/"false" literals.
    if tname == "Bool" { push_qn(worklist, "Str", "cmp") return }
}

// #326: root EXACTLY the helpers main's own signature needs. The whole
// Str.to_* / I64.to_* family used to be seeded for every CLI or GUI
// program, so a no-argument `mode gui` main carried seven dead converters
// -- plus Str.from_c_str, which nothing has emitted since the Str case
// became an inline Str_clone. A variadic main also deletes each parsed
// element, so the element type's delete is a root too (the BFS forwards
// USize.delete to U32.delete through the alias).
priv seed_cli_main_arg_roots := func(lp: LoadedProgram, mut worklist: Vec(Str)) {
    for u : ProgramUnit in lp.units {
        for stmt : Expr in lp.ctx.imported[u.path].ast.children {
            if stmt.node_type.is(NodeType.Decl).not() { continue }
            if stmt.children.len() == 0 { continue }
            mut is_main_decl := false
            switch stmt.node_type {
            case .Decl(d):
                if d.name == "main" { is_main_decl = true }
            case:
            }
            if is_main_decl.not() { continue }
            switch stmt.children[0].node_type {
            case .FuncDef(fdef):
                mut pi : I32 = 0
                for p : Declaration in fdef.params {
                    seed_cli_arg_helpers(p.type_name(), worklist)
                    if pi == fdef.variadic_index { push_qn(worklist, p.type_name(), "delete") }
                    pi++
                }
            case:
            }
        }
    }
}

// #326: a library exports its non-priv top-level declarations, and a
// consumer can call any of them -- including any non-priv member of an
// exported type -- so those are the roots. There is no main to reach them
// from, which is why library mode used to skip scavenging altogether.
// Executable top-level statements are roots too, exactly as in script mode.
priv seed_library_roots := func(lp: LoadedProgram, mut worklist: Vec(Str)) {
    for u : ProgramUnit in lp.units {
        for stmt : Expr in lp.ctx.imported[u.path].ast.children {
            if stmt.node_type.is(NodeType.Decl).not() {
                collect_refs(stmt, worklist)
                continue
            }
            switch stmt.node_type {
            case .Decl(d):
                if d.is_priv { continue }
                vec_push_str(worklist, d.name)
                if is_struct_or_enum(stmt).not() { continue }
                ref sdef : Expr = stmt.children[0]
                ref lib_ns : Vec(Declaration) = def_ns_decls(sdef)
                mut lib_i : USize = 0
                for nsd : Declaration in lib_ns {
                    cur_lib_i := lib_i
                    lib_i = lib_i + 1
                    if nsd.is_priv { continue }
                    push_qn(worklist, d.name, def_ns_name_at(sdef, cur_lib_i))
                }
            case:
            }
        }
    }
}

// #326: the executable top-level statements of the user units are roots in
// every non-library mode -- they ARE the program in script mode, and its
// global initializers in cli/test mode. Defs are ordinary graph nodes, and
// so are the value decls scav_value_decl_sweepable proves effect-free (the
// BFS walks an initializer only once its name is reached; scavenge_filter
// sweeps the rest).
priv seed_executable_stmt_roots := func(lp: LoadedProgram, mut worklist: Vec(Str)) {
    for u : ProgramUnit in lp.units {
        for stmt : Expr in lp.ctx.imported[u.path].ast.children {
            if stmt.node_type.is(NodeType.Decl) {
                if is_def(stmt) { continue }
                if scav_value_decl_sweepable(stmt, lp.ctx) { continue }
            }
            collect_refs(stmt, worklist)
        }
    }
}

// Test mode roots every selected test: top-level `test` funcs by name, and
// namespace test() members as "Type.test_name" so emit_test_main's
// Type_test_name() calls don't get scavenged out.
priv seed_test_roots := func(lp: LoadedProgram, mut worklist: Vec(Str)) {
    for u : ProgramUnit in lp.units {
        for stmt : Expr in lp.ctx.imported[u.path].ast.children {
            if stmt.node_type.is(NodeType.Decl).not() { continue }
            if stmt.children.len() == 0 { continue }
            switch stmt.children[0].node_type {
            case .FuncDef(fdef):
                if fdef.func_type.is(FuncType.Test) {
                    switch stmt.node_type {
                    case .Decl(d):
                        vec_push_str(worklist, d.name)
                    case:
                    }
                }
            case:
            }
            ref decl_value : Expr = stmt.children[0]
            is_type_decl := decl_value.node_type.is(NodeType.StructDef)
                .or(decl_value.node_type.is(NodeType.EnumDef))
            if is_type_decl.not() { continue }
            ref sdecl : Declaration = decl_of(stmt)
            ref tvi_ns : Vec(Declaration) = def_ns_decls(stmt.children[0])
            mut tvi : USize = 0
            for nsd : Declaration in tvi_ns {
                cur_tvi := tvi
                tvi = tvi + 1
                if nsd.default_value.is_none() { continue }
                ref nsfdef : Expr = nsd.default_expr()
                if nsfdef.node_type.is(NodeType.FuncDef).not() { continue }
                ref nsfd : FunctionDef = funcdef_of(nsfdef)
                if nsfd.func_type.is(FuncType.Test) {
                    push_qn(worklist, sdecl.name, def_ns_name_at(stmt.children[0], cur_tvi))
                }
            }
        }
    }
}

// #326 root policy, defined centrally per mode. Every mode roots `Str`,
// the ext.c FFI boundary, and (when the program can be interpreted) the
// `*.size` wildcard. On top of that:
// - library: every exported (non-priv) top-level decl and exported member
//   of an exported type, plus executable top-level statements
//   (seed_library_roots) -- a consumer can call any of them and there is
//   no main to reach them from.
// - cli/gui:  main, the exact argv converters main's own signature needs
//   (seed_cli_main_arg_roots), and the executable top-level statements.
// - test:     every selected test func (seed_test_roots) and the
//   executable top-level statements.
// - script:   the executable top-level statements alone.
// Core units root only their executable non-Decl statements; every core
// decl, defs and values alike, is an ordinary graph node.

// #326: a generic type's template (`Vec := struct<T: Type>`, parsed as a
// type-gen MACRO returning a StructDef) is not a reachability blob. Reaching
// the NAME keeps the decl -- instantiation substitutes from it -- but the
// body is walked per METHOD, exactly like a concrete type's: a call site
// roots "Vec.push", and the BFS tail resolves that qualified name into the
// template's member FuncDef (find_ns_decl_fdef_imported) and walks just that
// body. Walking the whole template body on top of that re-rooted every
// method's callees for every program that touched the type at all --
// Array.to_vec's `Vec` reference kept Vec, and Vec's body kept adopt_from,
// in programs that never build a Vec (a 5-line uncalled definition in 147
// generated files).
priv scav_is_type_gen_template := func(fdef: Expr) returns Bool {
    switch fdef.node_type {
    case .FuncDef(tg_fd):
        if tg_fd.func_type.is(FuncType.Macro).not() { return false }
        return tg_fd.return_type.eq("StructDef")
            .or(tg_fd.return_type.eq("EnumDef"))
            .or(tg_fd.return_type.eq("FuncDef"))
            .or(tg_fd.return_type.eq("FunctionDef"))
    case:
    }
    return false
}

priv scavenge_visited_imported := func(lp: LoadedProgram) returns Set(Str) {
    mut is_cli := false
    if lp.cur_mode.needs_main {
        if lp.run_tests.not() {
            is_cli = true
        }
    }
    is_library := lp.cur_mode.is_library

    // 1) Build top-level decl maps: name -> (path, idx)
    mut core_top := Map(Str, DeclRef).new()
    if lp.skip_core.not() {
        for u : ProgramUnit in lp.core_units {
            ref iu : ImportUnit = lp.ctx.imported[u.path]
            for i in 0..iu.ast.children.len() {
                ref stmt : Expr = iu.ast.children[i]
                switch stmt.node_type {
                case .Decl(decl):
                    core_top.set(decl.name, own DeclRef(path = u.path.clone(), idx = i.clone()))
                case:
                }
            }
        }
    }
    mut top := Map(Str, DeclRef).new()
    for u : ProgramUnit in lp.units {
        ref iu : ImportUnit = lp.ctx.imported[u.path]
        for i in 0..iu.ast.children.len() {
            ref stmt : Expr = iu.ast.children[i]
            switch stmt.node_type {
            case .Decl(decl):
                top.set(decl.name, own DeclRef(path = u.path.clone(), idx = i.clone()))
            case:
            }
        }
    }

    // 2) Seed worklist from the concatenated user-unit stream
    mut worklist := Vec(Str).new()
    vec_push_str(worklist, "Str")
    // #326: `T.size()` is resolved by RUNTIME NAME -- get_elem_size builds
    // the call from a type name it only learns at runtime, for element
    // widths of Array/Vec/Tuple/Map/Set and for dyn_size_of -- so no static
    // walk can see those uses. That makes it a real reachability edge, and
    // an unconditional root: the scavenger answers "is this declaration
    // used", once, for every backend, and does not ask which backend is
    // coming. (It used to skip the root when ctx.compile_mode said "C
    // only", on the grounds that emitted C reads widths from sizeof. That
    // is a fact about the C emitter, and it belongs to the C emitter --
    // builder_size_method_omitted drops the function there, where a future
    // backend can make its own call.)
    vec_push_str(worklist, "*.size")
    // #326: the hand-written C runtime (src/c/ext.c) is linked into every
    // program, so whatever IT needs from til is an unconditional root. That
    // set is exactly three symbols -- `nm -u` on ext.o resolves everything
    // else to libc or libffi: Str_clone (the cwd, env and blob helpers each
    // return an owned empty Str that way) and the capacity sentinels the
    // Str writers stamp. The blanket lifecycle rooting and the blanket core
    // value rooting used to supply them by accident.
    push_qn(worklist, "Str", "clone")
    vec_push_str(worklist, "CAP_LIT")
    vec_push_str(worklist, "CAP_VIEW")
    vec_push_str(worklist, "CAP_INLINE")
    if is_library {
        seed_library_roots(lp, worklist)
    } else if is_cli {
        vec_push_str(worklist, "main")
        // The generated CLI entry wrapper parses typed argv into main()'s
        // params inline, by raw-C name. Those calls are emitted after this
        // reachability prune, so the names never appear in the user stream
        // -- seed them here or the wrapper fails to link.
        seed_cli_main_arg_roots(lp, worklist)
        seed_executable_stmt_roots(lp, worklist)
    } else if lp.run_tests {
        seed_test_roots(lp, worklist)
        seed_executable_stmt_roots(lp, worklist)
    } else {
        seed_executable_stmt_roots(lp, worklist)
    }

    // #326: core top-level VALUE decls used to be blanket roots -- every one
    // of their initializers was walked whether or not anything read the
    // value. That is why a dead `TYPE_STRUCTDEF = Type.Struct("StructDef")`
    // kept the compiler's StructDef/EnumDef/Expr data model (and its
    // Map/Vec dependency graph) alive in ordinary user output. They are
    // ordinary graph nodes now: scavenge_filter sweeps the unreached ones,
    // and the BFS below walks a core value's initializer only once the
    // value itself is reached. Non-Decl core top-level statements are still
    // executable program text, so they stay roots.
    if lp.skip_core.not() {
        for u : ProgramUnit in lp.core_units {
            for stmt : Expr in lp.ctx.imported[u.path].ast.children {
                if stmt.node_type.is(NodeType.Decl) { continue }
                collect_refs(stmt, worklist)
            }
        }
    }

    // 3) BFS
    mut visited := Set(Str).new()
    mut cursor : USize = 0
    while cursor < worklist.len() {
        name := Str.clone(worklist[cursor])
        cursor++
        if visited.has(name) { continue }
        visited.add(own name.clone())

        // #269: "*.m" wildcard from collect_refs -- a dyn_call whose type
        // name is a runtime expression (interface dispatch). The target
        // type is only known at runtime, so keep method m alive on every
        // top-level type by expanding to concrete Type.m names; the BFS
        // then walks each kept method's body normally.
        if name.starts_with("*.") {
            wc_method := name.substr(2, name.len() - 2)
            for wk, _ in top {
                push_qn(worklist, wk, wc_method)
            }
            for wk2, _ in core_top {
                push_qn(worklist, wk2, wc_method)
            }
            continue
        }

        // #326: `cast` is declared `ext_func(e: Dynamic, T: Type)` but there
        // is no such symbol -- the builder reads the target type NAME off
        // children[2] and emits a bare C cast, so nothing ever calls it and
        // no runtime value of its parameter types exists. Its `T: Type` slot
        // is a comptime type argument, the same shape the macro rule below
        // already excludes; walking the signature rooted the `Type` enum and,
        // through its payload, `Primitive`. `I64.to_str` casts, so EVERY
        // program that prints a number carried both struct definitions and
        // both tag enums with nothing referencing them.
        if name == "cast" { continue }

        if top.has(name) {
            ref dr : DeclRef = top[name]
            ref iu : ImportUnit = lp.ctx.imported[dr.path]
            ref decl : Expr = iu.ast.children[dr.idx]
            if is_struct_or_enum(decl) {
                switch decl.children[0].node_type {
                case .StructDef(bfs_sdd):
                    for bfs_fd : Declaration in bfs_sdd.fields {
                        // #326: a field DEFAULT is not a reachability edge --
                        // see collect_refs. Only the field's type is, because
                        // that is the struct's layout.
                        if bfs_fd.til_type.is(Type.Unknown).not() {
                            vec_push_str(worklist, bfs_fd.type_name())
                        }
                    }
                case .EnumDef(bfs_edd):
                    for bfs_vd : VariantDef in bfs_edd.variants {
                        if bfs_vd.payload_type.len() > 0 {
                            vec_push_str(worklist, bfs_vd.payload_type)
                        }
                    }
                case:
                    UNREACHABLE("unexpected ", decl.children[0].node_type.head_str())
                }
            } else {
                if scav_is_type_gen_template(decl.children[0]).not() {
                    collect_refs(decl.children[0], worklist)
                }
            }
        }
        if core_top.has(name) {
            ref dr : DeclRef = core_top[name]
            ref iu : ImportUnit = lp.ctx.imported[dr.path]
            ref decl : Expr = iu.ast.children[dr.idx]
            if is_struct_or_enum(decl) {
                switch decl.children[0].node_type {
                case .StructDef(bfs_sdd2):
                    for bfs_fd2 : Declaration in bfs_sdd2.fields {
                        // #326: a field DEFAULT is not a reachability edge --
                        // see collect_refs. Only the field's type is, because
                        // that is the struct's layout.
                        if bfs_fd2.til_type.is(Type.Unknown).not() {
                            vec_push_str(worklist, bfs_fd2.type_name())
                        }
                    }
                case .EnumDef(bfs_edd2):
                    for bfs_vd2 : VariantDef in bfs_edd2.variants {
                        if bfs_vd2.payload_type.len() > 0 {
                            vec_push_str(worklist, bfs_vd2.payload_type)
                        }
                    }
                case:
                    UNREACHABLE("unexpected ", decl.children[0].node_type.head_str())
                }
            } else {
                if scav_is_type_gen_template(decl.children[0]).not() {
                    collect_refs(decl.children[0], worklist)
                }
            }
        }

        // A "Type.member" qualified name on the worklist can resolve to
        // a FuncDef (namespace method) or to a plain Ident / FCall /
        // other Expr (namespace data decl like `HashMap.hasher : HashFn
        // = fnv1a`). Walk whatever the default_value is so the free
        // identifiers it references stay reachable -- otherwise
        // `fnv1a` gets pruned and the init `HashMap_hasher = (void
        // *)fnv1a` in main() references an undeclared symbol.
        // #326: follow a type alias before the namespace lookups below --
        // `UPtr.size` has to reach `U64.size`, and the width aliases stay
        // correct at any built USize width rather than through a hardcoded
        // pair. BOTH maps are consulted, not the user's first: one name can
        // denote two aliases at once, and the qualified name on the
        // worklist does not say which scope it came from. test/aliases.til
        // is the case -- it declares its own `USize := U64` while core's
        // `USize := U32` is what the typer resolved `v.len()` through, so
        // the monomorphized `assert_eq__USize` body emits `U32_to_str`.
        // Rooting both targets costs at most one extra method; rooting the
        // wrong one alone is a link error.
        alias_dot := name.find(".")
        if alias_dot >= 0 {
            alias_dot_u := alias_dot.to_usize()
            alias_base := name.substr(0, alias_dot_u)
            alias_member := name.substr(alias_dot_u + 1, name.len().sub(alias_dot_u) - 1)
            user_alias_to := alias_target_imported(lp.ctx, top, alias_base)
            if user_alias_to.len() > 0 { push_qn(worklist, user_alias_to, alias_member) }
            core_alias_to := alias_target_imported(lp.ctx, core_top, alias_base)
            if core_alias_to.len() > 0 { push_qn(worklist, core_alias_to, alias_member) }
        }

        ns_fdef_o := find_ns_decl_fdef_imported(lp.ctx, top, name)
        if ns_fdef_o.is_some() {
            collect_refs(ns_fdef_o.unwrap(), worklist)
        }
        core_ns_fdef_o := find_ns_decl_fdef_imported(lp.ctx, core_top, name)
        if core_ns_fdef_o.is_some() {
            collect_refs(core_ns_fdef_o.unwrap(), worklist)
        }
    }
    return visited
}

scavenge_imported := proc(mut lp: LoadedProgram) {
    visited := scavenge_visited_imported(lp)

    mut swept_names := Vec(Str).new()
    if lp.skip_core.not() {
        for u : ProgramUnit in lp.core_units {
            scavenge_filter(lp.ctx.imported[u.path].ast, visited, true, swept_names, lp.ctx)
        }
    }
    for u : ProgramUnit in lp.units {
        scavenge_filter(lp.ctx.imported[u.path].ast, visited, false, swept_names, lp.ctx)
    }
    // #326: the sweep freed those declarations' AST nodes, and the
    // func_defs / struct_defs registries hold pointers INTO them. Erase
    // the swept names so a later by-name lookup misses instead of reading
    // a freed Expr -- the builder's check_fcall_mut_args resolving a
    // spliced swap_replace callee was the ASAN-proven case, and #328 fixed
    // the identical hazard for retired generic templates. BINDINGS stay:
    // a TypeBinding is type data, not an AST pointer (#147 moved the
    // func_def pointer out into func_defs), and the interpreter still
    // resolves types through them at runtime -- erasing them broke
    // test/hashes.til's funcptr-typed global.
    for swept_n : Str in swept_names {
        lp.ctx.scope.erase_ast_decl(swept_n, false)
    }
    if swept_names.len() > 0 { lp.ctx.scope.refresh_lookup_filters() }

    // Body-level DCE: drop unreferenced hoisted temps left behind by
    // constfolder's constant folding. Runs over every imported unit (cores
    // included) so the codegen no longer needs `(void)<name>;` guards.
    for upath : Str in lp.unit_paths() {
        dce_program_bodies(lp.ctx.imported[upath].ast)
    }

}
