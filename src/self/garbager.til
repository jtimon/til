mode lib
import("context")
import("../std/sys")

// Asap destruction phase. See doc/pipeline.org step 5 and issue #204.
//
// Runs once per body after the typer's per-body work has settled
// (currently invoked from infer_body / infer_body_unit in typer.til).
// Computes per-binding live ranges and inserts Type.delete() / free()
// calls at the last use of every local, before reassignments, and on
// every early-exit edge (return / break / continue).
//
// The data model is LocalInfo (one per binding the body owns). The
// orchestrator is insert_free_calls. Everything else here is a helper
// it composes.
//
// Cross-file calls: this module reads several typer helpers that the
// asap walk needs (type_to_name, make_delete_call, make_free_call,
// fa_own_type, transfer_is_shallow_field_value_copy, is_compile_directive,
// expr_uses_var, expr_transfers_own, expr_used_in_nested_func,
// expr_contains_decl, fcall_returns_shallow, rhs_is_clone_fcall)
// The loader imports garbager.til right after
// typer.til so those names are in scope.

priv LocalInfo := struct {
    ref name : Str
    type := Type.Unknown
    decl_index : I32 = 0
    last_use : I32 = 0
    own_transfer : I32 = -1
    // #302 stage 3: "some statement of this body transfers this name",
    // recorded once at collection time and NEVER cleared -- unlike
    // own_transfer, which check_use_after_own_transfer resets to -1 for
    // a transfer every path diverges before. The flow solver uses it to
    // tell the bindings whose ownership state can actually move down
    // the lattice from the ones whose state follows from their Decl
    // position alone, which is most of them.
    has_transfer := false
    skip_scope_delete := false
    is_heap := false
    // True when the stmt at own_transfer consumes this binding via a
    // DESTRUCTOR call (free(own x) / T.delete(own x, ...) /
    // til_closure_delete(x)) rather than an ordinary own-arg / own-field
    // transfer. The delete-method shape `if call_free { free(own self) }`
    // is the one case where a param's conditional transfer must keep the
    // full asap stand-down: the body's field deletes already ran, so
    // grafting a delete onto the other path double-frees. Every OTHER
    // conditionally-transferred own param was leaking under the old
    // blanket "params stand down" rule (#302).
    dtor_transfer := false
    // #302 stage 4: the transfer at own_transfer is a struct-ctor arg
    // into a SHALLOW field (a value-copy: the field's destructor frees
    // the inner data, nothing frees the local's wrapper). Recorded here
    // at transfer-classification time, beside dtor_transfer, instead of
    // re-parsing the ctor shape at delete-insertion time (D4).
    shallow_copy_transfer := false
    // True for a TYPED local whose RHS is an allocator call (malloc /
    // calloc / realloc): an owned raw heap block. The garbager owns its
    // free -- inserted like any owned local's cleanup, but always as a
    // bare free(own x), never T.delete (the block is raw bytes; a deep
    // delete would walk uninitialized memory). This is what makes
    // `buf : U8 = malloc(n)` correct WITHOUT a hand-written
    // free(own buf): previously the declaration's meaning FLIPPED on
    // that manual free's presence (the free's own-transfer promoted the
    // local to Own -> pointer form; without it the builder emitted the
    // value-local malloc-deref-free roundtrip, reading one
    // uninitialized byte and discarding the buffer). Dynamic-typed
    // allocator locals are excluded: type erasure hides pointer escapes
    // (write_ptr smuggling in the interpreter), so they keep the manual
    // contract until the #302 Dynamic-never-owns migration retires
    // them.
    raw_alloc := false
}

// True when the local's value IS a callable (a funcptr or a Body
// closure): its storage is the callable box pointer itself, not a
// wrapper around separately-owned data.
priv heap_local_is_callable := func(local: LocalInfo) returns Bool {
    return local.type.is_funcptr().or(local.type.is(Type.Body))
}

// #302 stage 6: a delete the backends would execute as a NO-OP is not
// inserted at all. The generated destructor of a scalar is exactly
// `if (call_free) free(self);`, so a stack-stored primitive's
// `T.delete(x, false)` does nothing -- it exists only because the
// insertion loop below is type-blind. The C backend already elided it
// (is_noop_delete_stmt), which is the stage-6 compensation this
// retires for the scalar class: the pass now makes the decision and
// both backends just execute it.
//
// Scalars ONLY, deliberately. Str / Vec / struct / payload-carrying
// enum destructors free their inner data regardless of call_free, and
// a Custom / Dynamic type's destructor is not knowable here.
priv gc_delete_is_noop := func(local: LocalInfo) returns Bool {
    if local.is_heap { return false }
    if local.raw_alloc { return false }
    return local.type.is(Type.Primitive)
}

// The one delete factory this pass inserts through: no-op deletes come
// back None, which every call site already handles (make_delete_call
// itself returns None for an unnameable type).
priv gc_make_delete := func(local: LocalInfo, src: Expr) returns Option(Expr) {
    if gc_delete_is_noop(local) { return Option(Expr).None }
    return make_delete_call(local.name, local.type, local.is_heap, local.is_heap, src)
}

// rhs_is_allocator_call moved to context.til (#303): the builder's
// raw-alloc value-local emit needs the same predicate this pass uses.

// True when `stmt` (or any sub-expression) destroys `name` directly:
// free(own name), T.delete(own name, ...), or til_closure_delete(name).
// Matched structurally, no name sniffing -- the shapes make_delete_call /
// make_free_call / make_closure_delete_call emit and hand-written
// destructor bodies use.
priv transfer_is_destructor_call := func(stmt: Expr, name: Str) returns Bool {
    if stmt.node_type.is(NodeType.FCall).and(stmt.children.len().gt(1)) {
        mut is_dtor := false
        switch stmt.children[0].node_type {
        case .FieldAccess(dfa):
            if dfa.field_access_name() == "delete" { is_dtor = true }
        case .Ident(dfi):
            if dfi.ident_name().eq("free").or(dfi.ident_name().eq("til_closure_delete")) { is_dtor = true }
        case:
        }
        if is_dtor {
            switch stmt.children[1].node_type {
            case .Ident(dai):
                if dai.ident_name() == name { return true }
            case:
            }
        }
    }
    for dc : Expr in stmt.children {
        if transfer_is_destructor_call(dc, name) { return true }
    }
    return false
}

// Issue #302 stage 0: decision-audit dump. TIL_GC_AUDIT=<path-substring>
// makes insert_free_calls print, for every body in a matching unit, the
// pass's final per-binding decisions (the LocalInfo table after the
// analysis phases) and the destructor sites present in the body after
// insertion. The golden test test/gc_audit.til + test/gc_audit.expected
// pins the dump so later #302 stages show their decision diffs in review
// instead of only as ASAN outcomes. See doc/garbager.org. The env read is
// std/sys's get_env, which answers "" when the variable is unset.

priv gc_audit_flag := func(b: Bool) returns Str {
    if b { return "1" }
    return "0"
}

// `name` with its LAST digit run removed: "hoisted__U64_7725" ->
// "hoisted__U64_", "_va_Array_217_ek" -> "_va_Array__ek". Only the last
// run goes because it is the synthesized counter; interior digits are type
// widths (the U64 in hoisted__U64_...) and must survive. The counters are
// GLOBAL (ctx.hoist_counter and friends run across every previously typed
// unit), so printing them raw would shift the whole golden whenever an
// unrelated core/std change adds or removes a hoist. Returns `name`
// unchanged when it has no digits.
priv gc_audit_strip_counter := func(name: Str) returns Str {
    mut run_start : I64 = -1
    mut run_end : I64 = -1
    mut i : USize = 0
    while i < name.len() {
        if name.get(i).gte('0').and(name.get(i).lte('9')) {
            run_start = i.to_i64()
            mut j := i
            while j.lt(name.len()).and(name.get(j).gte('0')).and(name.get(j).lte('9')) {
                j++
            }
            run_end = j.to_i64()
            i = j
        } else {
            i++
        }
    }
    if run_start < 0 { return name.clone() }
    start_u := run_start.to_usize()
    end_u := run_end.to_usize()
    return format(name.substr(0, start_u), name.substr(end_u, name.len().sub(end_u)))
}

// Stable display name: user names pass through; synthesized names (the
// hoisted__ / leading-underscore population) get their trailing counter
// replaced by a per-body ordinal in order of first appearance, so
// identical bodies dump identically regardless of the global counter
// state. Digit-less synthetic names pass through unchanged.
priv gc_audit_name := func(name: Str, mut names: Map(Str, Str), mut counts: Map(Str, I64)) returns Str {
    if name.starts_with("hoisted__").or(name.starts_with("_")).not() { return name.clone() }
    if names.has(name) { return names[name].clone() }
    key := gc_audit_strip_counter(name)
    if key == name { return name.clone() }
    mut k : I64 = 0
    if counts.has(key) { k = counts[key].clone() }
    counts.set(key, own k.add(1))
    disp := format(key, "#", k.to_str())
    names.set(name, own disp.clone())
    return disp
}

// Renders `e` when it is a destructor-shaped call -- the exact shapes
// make_delete_call / make_free_call / make_closure_delete_call emit
// (which user-written cleanup shares) -- or "" for anything else.
priv gc_audit_destructor_line := func(e: Expr, mut names: Map(Str, Str), mut counts: Map(Str, I64)) returns Str {
    if e.node_type.is(NodeType.FCall).not() { return "" }
    if e.children.len() < 2 { return "" }
    mut kind := ""
    mut tname := ""
    switch e.children[0].node_type {
    case .FieldAccess(del_fa):
        if del_fa.field_access_name() != "delete" { return "" }
        if e.children[0].children.len() < 1 { return "" }
        switch e.children[0].children[0].node_type {
        case .Ident(tid): tname = Str.clone(tid.ident_name())
        case: return ""
        }
        kind = "delete"
    case .Ident(fid):
        if fid.ident_name() == "free" {
            kind = "free"
        } else if fid.ident_name() == "til_closure_delete" {
            kind = "closure-delete"
        } else {
            return ""
        }
    case:
        return ""
    }
    mut arg_name := "<expr>"
    switch e.children[1].node_type {
    case .Ident(aid): arg_name = gc_audit_name(aid.ident_name(), names, counts)
    case:
    }
    mut own_s := ""
    if get_own_arg(e, 1) { own_s = " own=1" }
    if kind == "delete" {
        mut cf := ""
        if e.children.len() > 2 {
            switch e.children[2].node_type {
            case .Literal(Literal.Bool(cfb)): cf = format(" call_free=", gc_audit_flag(cfb))
            case:
            }
        }
        return format("delete ", tname, ".delete(", arg_name, ")", cf, own_s)
    }
    return format(kind, "(", arg_name, ")", own_s)
}

// Destructor sites present in `body` after insertion, recursively; `prefix`
// is the dotted statement path ("2.if0.1 " style) so nested sites are
// addressable. Nested if/while/block bodies are also dumped by their OWN
// insert_free_calls run (they get separate garbager_destroy_body calls
// during typing), so their sites appear twice: once standalone, once inside
// the enclosing body's walk after insert_nested_exit_deletes may have
// appended to them. Both views are wanted -- the second is where the
// enclosing body's exit deletes land.
priv gc_audit_sites := proc(body: Expr, prefix: Str, mut names: Map(Str, Str), mut counts: Map(Str, I64)) {
    for i in 0..body.children.len() {
        ref s : Expr = body.children[i]
        line := gc_audit_destructor_line(s, names, counts)
        if line.len() > 0 {
            println("GC-AUDIT site ", prefix, i.to_str(), " ", line)
        }
        switch s.node_type {
        case .Assign(ad):
            if ad.save_old_delete {
                println("GC-AUDIT site ", prefix, i.to_str(), " assign-old-delete ", gc_audit_name(ad.name, names, counts))
            }
        case .FieldAssign(fad):
            if fad.save_old_delete {
                println("GC-AUDIT site ", prefix, i.to_str(), " fieldassign-old-delete ", gc_audit_name(fad.name, names, counts))
            }
        case .If:
            for ci in 1..s.children.len() {
                gc_audit_sites(s.children[ci], format(prefix, i.to_str(), ".if", ci.sub(1).to_str(), "."), names, counts)
            }
        case .While:
            if s.children.len() > 1 {
                gc_audit_sites(s.children[1], format(prefix, i.to_str(), ".while."), names, counts)
            }
        case .Body:
            gc_audit_sites(s, format(prefix, i.to_str(), ".body."), names, counts)
        case .Switch:
            for ci in 1..s.children.len() {
                if s.children[ci].node_type.is(NodeType.Case) {
                    cbi := s.children[ci].children.len() - 1
                    gc_audit_sites(s.children[ci].children[cbi], format(prefix, i.to_str(), ".case", ci.sub(1).to_str(), "."), names, counts)
                }
            }
        case:
        }
    }
}

// A binding with no decision at all -- not declared in this body, never
// used, never transferred, not heap, not skipped. Program-scope dumps see
// the whole global namespace this way (every imported core/std name plus
// re-registered per-body temps); printing those would tie the golden to
// the global name population, so the table filters them.
// A binding this body neither declares nor mentions: there is no decision to
// record, whichever way skip_scope_delete came out. The filter used to also
// require skip=0, which held only because a cross-body program-scope global
// (another file's top level, or an earlier REPL turn) wrongly fell through to
// skip=0; now that those are correctly skipped, keying on it would dump every
// core global into every file's table.
priv gc_audit_local_is_noise := func(local: LocalInfo) returns Bool {
    return local.decl_index.eq(-1).and(local.last_use.eq(-1))
        .and(local.own_transfer.eq(-1))
        .and(local.is_heap.not())
}

// One body's full audit record: the settled LocalInfo table (the pass's
// decisions; decl/last_use/own_transfer are PRE-insertion statement
// indexes), then the destructor sites found in the post-insertion body.
// Called after the insertion loop so both sections share one name-ordinal
// state. The table's order is the scope-binding order, which is
// deterministic for a fixed compiler + source. locals= counts the SHOWN
// lines (no-decision bindings are filtered, see gc_audit_local_is_noise).
priv gc_audit_dump := proc(ctx: Context, body: Expr, locals: Vec(LocalInfo)) {
    mut names := Map(Str, Str).new()
    mut counts := Map(Str, I64).new()
    mut shown : I64 = 0
    for counted : LocalInfo in locals {
        if gc_audit_local_is_noise(counted).not() { shown = shown + 1 }
    }
    println("GC-AUDIT body ", ctx.path, ":", body.line.to_str(), ":", body.col.to_str(),
        " locals=", shown.to_str())
    for local : LocalInfo in locals {
        if gc_audit_local_is_noise(local) { continue }
        mut tname := type_to_name(local.type)
        if tname.len() == 0 { tname = til_type_name(local.type) }
        println("GC-AUDIT local ", gc_audit_name(local.name, names, counts),
            " type=", tname,
            " decl=", local.decl_index.to_str(),
            " last_use=", local.last_use.to_str(),
            " own_transfer=", local.own_transfer.to_str(),
            " heap=", gc_audit_flag(local.is_heap),
            " skip=", gc_audit_flag(local.skip_scope_delete))
    }
    gc_audit_sites(body, "", names, counts)
}

// --- #302 stage 3, slice 1: per-body control-flow graph ---------------------
//
// Build an explicit graph of the statement-level control flow the index
// model (LocalInfo's decl/last_use/own_transfer) only approximates, and
// dump it under TIL_GC_AUDIT so the golden pins the shape per body.
// Nothing consumes the graph yet: the ownership dataflow lands on top of
// it in follow-up commits, asserted against the index model's decisions
// before replacing them.
//
// Model: a block is a run of consecutive statements inside ONE Body node
// (span [start, end) into body.children, pre-insertion indexes -- the
// same indexing the audit table's decl/last_use/own_transfer use).
// Compound statements end a block: If/Switch/Body branch from the tail
// of the current block (the span includes the compound statement, whose
// condition/subject evaluates there) and their branch bodies' flows join
// at a fresh block after the statement; While gets a dedicated
// single-statement head block so its back edge re-enters at the
// condition, never at preceding straight-line statements. Return /
// Break / Continue terminate a block with an edge to the exit block /
// the innermost loop's join / the innermost loop's head. Block 0 is the
// synthetic exit (body=NULL); block 1 is the entry. The exit block
// means "control leaves this body view" -- the pass runs per body,
// nested-first, so for a standalone loop-body view a break/continue
// whose While lives in the parent view is also an exit edge (this
// body's locals die there either way). Statements after a
// terminator open a fresh, edgeless (unreachable) block, matching how
// the insertion loop still walks them today. Compile directives ride
// inside spans like any statement; the insertion loop's skip is not
// flow.

priv GcCfgBlock := struct {
    // Backing Body node; None only for the synthetic exit block (#321).
    body := Option(ref Expr).None
    start : I32 = 0
    end : I32 = 0
    // True when `body` IS the view's root Body: this block's span
    // indexes are the same top-level statement indexes LocalInfo's
    // decl/last_use/own_transfer use, so index-model positions can be
    // located in the graph through root blocks only.
    is_root := false
    succs := Vec(I32).new()
}

priv cfg_new_block := func(mut blocks: Vec(GcCfgBlock), body: Expr, start: I32, is_root: Bool) returns I32 {
    id := blocks.len().to_i32()
    mut b := GcCfgBlock(start = start, end = start, is_root = is_root)
    b.body = Option(ref Expr).Some(body)
    blocks.push(own b)
    return id
}

priv cfg_set_end := func(mut blocks: Vec(GcCfgBlock), id: I32, end: I32) {
    ref mut b : GcCfgBlock = blocks[id.to_usize()]
    b.end = end
}

priv cfg_add_succ := func(mut blocks: Vec(GcCfgBlock), from: I32, to: I32) {
    ref mut b : GcCfgBlock = blocks[from.to_usize()]
    b.succs.push(own to)
}

// Scan body.children appending flow to the open block `cur_in`. brk /
// cont are the innermost loop's join / head (-1 outside loops); exit_id
// is the synthetic exit block. Returns the open fall-through block at
// the end of the body, or -1 if every path diverged.
priv cfg_scan := func(mut blocks: Vec(GcCfgBlock), body: Expr, cur_in: I32, brk: I32, cont: I32, exit_id: I32, is_root: Bool) returns I32 {
    mut cur := cur_in
    n := body.children.len()
    mut i : USize = 0
    while i < n {
        if cur < 0 { cur = cfg_new_block(blocks, body, i.to_i32(), is_root) }
        ref s : Expr = body.children[i]
        switch s.node_type {
        case .Return:
            cfg_set_end(blocks, cur, i.to_i32().add(1))
            cfg_add_succ(blocks, cur, exit_id)
            cur = -1
        case .Break:
            // brk < 0 is an EXPECTED state, not a violated invariant: the
            // garbager processes bodies nested-first, so a loop's body is
            // scanned standalone while its While statement lives in the
            // parent body's view. A break leaving this view has the same
            // local-liveness meaning as any exit edge (this body's scope
            // ends); the parent view's scan sees the same break again with
            // its real loop targets.
            cfg_set_end(blocks, cur, i.to_i32().add(1))
            if brk < 0 {
                cfg_add_succ(blocks, cur, exit_id)
            } else {
                cfg_add_succ(blocks, cur, brk)
            }
            cur = -1
        case .Continue:
            // Same standalone-body-view rule as Break above.
            cfg_set_end(blocks, cur, i.to_i32().add(1))
            if cont < 0 {
                cfg_add_succ(blocks, cur, exit_id)
            } else {
                cfg_add_succ(blocks, cur, cont)
            }
            cur = -1
        case .If:
            cfg_set_end(blocks, cur, i.to_i32().add(1))
            join := cfg_new_block(blocks, body, i.to_i32().add(1), is_root)
            mut bi : USize = 1
            while bi < s.children.len() {
                bfirst := cfg_new_block(blocks, s.children[bi], 0, false)
                cfg_add_succ(blocks, cur, bfirst)
                bfall := cfg_scan(blocks, s.children[bi], bfirst, brk, cont, exit_id, false)
                if bfall >= 0 { cfg_add_succ(blocks, bfall, join) }
                bi++
            }
            // No else branch: the condition can fall straight through.
            if s.children.len() == 2 { cfg_add_succ(blocks, cur, join) }
            cur = join
        case .While:
            cfg_set_end(blocks, cur, i.to_i32())
            head := cfg_new_block(blocks, body, i.to_i32(), is_root)
            cfg_set_end(blocks, head, i.to_i32().add(1))
            cfg_add_succ(blocks, cur, head)
            join := cfg_new_block(blocks, body, i.to_i32().add(1), is_root)
            wfirst := cfg_new_block(blocks, s.children[1], 0, false)
            cfg_add_succ(blocks, head, wfirst)
            cfg_add_succ(blocks, head, join)
            wfall := cfg_scan(blocks, s.children[1], wfirst, join, head, exit_id, false)
            if wfall >= 0 { cfg_add_succ(blocks, wfall, head) }
            cur = join
        case .Switch:
            cfg_set_end(blocks, cur, i.to_i32().add(1))
            join := cfg_new_block(blocks, body, i.to_i32().add(1), is_root)
            mut has_default := false
            mut ci : USize = 1
            while ci < s.children.len() {
                ref c : Expr = s.children[ci]
                if c.node_type.is(NodeType.Case) {
                    if c.children.len() == 1 { has_default = true }
                    cbi := c.children.len().sub(1)
                    cfirst := cfg_new_block(blocks, c.children[cbi], 0, false)
                    cfg_add_succ(blocks, cur, cfirst)
                    cfall := cfg_scan(blocks, c.children[cbi], cfirst, brk, cont, exit_id, false)
                    if cfall >= 0 { cfg_add_succ(blocks, cfall, join) }
                }
                ci++
            }
            // No default: an unmatched scrutinee falls straight through.
            if has_default.not() { cfg_add_succ(blocks, cur, join) }
            cur = join
        case .Body:
            cfg_set_end(blocks, cur, i.to_i32().add(1))
            join := cfg_new_block(blocks, body, i.to_i32().add(1), is_root)
            bfirst := cfg_new_block(blocks, s, 0, false)
            cfg_add_succ(blocks, cur, bfirst)
            bfall := cfg_scan(blocks, s, bfirst, brk, cont, exit_id, false)
            if bfall >= 0 { cfg_add_succ(blocks, bfall, join) }
            cur = join
        case:
            cfg_set_end(blocks, cur, i.to_i32().add(1))
        }
        i++
    }
    return cur
}

priv cfg_build := func(mut blocks: Vec(GcCfgBlock), body: Expr) {
    // Block 0: synthetic exit (body stays NULL).
    mut exit_b := GcCfgBlock(start = -1, end = -1)
    blocks.push(own exit_b)
    entry := cfg_new_block(blocks, body, 0, true)
    fall := cfg_scan(blocks, body, entry, -1, -1, 0, true)
    if fall >= 0 { cfg_add_succ(blocks, fall, 0) }
}

priv gc_cfg_dump := proc(ctx: Context, body: Expr, blocks: Vec(GcCfgBlock)) {
    println("GC-CFG body ", ctx.path, ":", body.line.to_str(), ":", body.col.to_str(),
        " blocks=", blocks.len().to_str())
    for i in 0..blocks.len() {
        ref b : GcCfgBlock = blocks[i]
        mut ss := ""
        for j in 0..b.succs.len() {
            if j > 0 { ss = format(ss, ",") }
            ss = format(ss, b.succs[j].to_str())
        }
        switch b.body {
        case .Some(bb):
            println("GC-CFG block ", i.to_str(), " body=", bb.line.to_str(), ":", bb.col.to_str(),
                " span=", b.start.to_str(), "..", b.end.to_str(), " succs=", ss)
        case .None:
            println("GC-CFG block ", i.to_str(), " exit")
        }
    }
}

// --- #302 stage 3, slice 2: ownership dataflow over the CFG -----------------
//
// Forward dataflow, one binding at a time: at every block the binding is
// Uninit (declared later), Owned, Moved (an own transfer consumed it),
// or Mixed (paths disagree -- the state the index model cannot
// represent). Meet is equality-or-Mixed; effects inside a block are
// decl/reassign -> Owned, own transfer -> Moved, in statement order. A
// compound statement at a block's tail contributes only its
// condition/subject (its branch bodies are separate blocks). The exit
// block's settled state is the per-body verdict: Moved everywhere is a
// completed transfer, Owned everywhere is an ordinary scope-end
// cleanup, Mixed at exit is a conditional-transfer path problem --
// exactly the class the sink repairs per path (its Body gate covers
// the desugared switch-with-break, fixture shape 12, whose
// non-transfer arms leaked under the pure index gate). Consumed at
// every migrated decision site: the three exit-delete sites test
// Owned exactly (gc_flow_stmt_table), the sink gates on Mixed at exit
// (gc_flow_exit_is_mixed), and the use-after-transfer check clears
// diverged transfers with owned-at-statement (gc_flow_owned_at_stmt).

priv FLOW_UNREACHED : U8 = 0
priv FLOW_UNINIT : U8 = 1
priv FLOW_OWNED : U8 = 2
priv FLOW_MOVED : U8 = 3
priv FLOW_MIXED : U8 = 4

priv gc_flow_meet := func(a: U8, b: U8) returns U8 {
    if a == FLOW_UNREACHED { return b }
    if b == FLOW_UNREACHED { return a }
    if a == b { return a }
    return FLOW_MIXED
}

priv gc_flow_letter := func(s: U8) returns Str {
    if s == FLOW_UNINIT { return "I" }
    if s == FLOW_OWNED { return "O" }
    if s == FLOW_MOVED { return "M" }
    if s == FLOW_MIXED { return "X" }
    return "U"
}

// A statement's transfer function is either the identity or a CONSTANT
// (it sets the state outright), so it is fully described by one value:
// FLOW_ID for identity, otherwise the state it installs. That property
// is what makes the per-block precomputation below exact -- composing
// identity-or-constant functions yields identity-or-constant, namely
// the last constant in the block, or identity when there is none.
priv FLOW_ID : U8 = 0

priv gc_flow_stmt_const := func(stmt: Expr, name: Str, scope: TypeScope, ctx: Context) returns U8 {
    // Decl-or-reassign checked first: `s = consume(own s)` transfers in
    // the RHS and re-owns in the same statement, net Owned.
    if expr_contains_decl(stmt, name) { return FLOW_OWNED }
    if expr_reassigns_var(stmt, name) { return FLOW_OWNED }
    if expr_transfers_own(stmt, name, scope, ctx) { return FLOW_MOVED }
    return FLOW_ID
}

priv gc_flow_stmt_effect := func(stmt: Expr, name: Str, state: U8, scope: TypeScope, ctx: Context) returns U8 {
    c := gc_flow_stmt_const(stmt, name, scope, ctx)
    if c == FLOW_ID { return state }
    return c
}

// The block's composed transfer function for `name` (see FLOW_ID). The
// solver evaluates this ONCE per block instead of re-walking the
// block's statements on every sweep -- the walk asks
// expr_contains_decl / expr_reassigns_var / expr_transfers_own, three
// subtree scans per statement, which dominated the fixpoint.
priv gc_flow_block_kill := func(blocks: Vec(GcCfgBlock), bid: USize, name: Str, scope: TypeScope, ctx: Context) returns U8 {
    ref b : GcCfgBlock = blocks[bid]
    switch b.body {
    case .None:
        // Synthetic exit block: no statements, state passes through.
        return FLOW_ID
    case .Some(bbody):
        mut k := FLOW_ID
        mut j := b.start
        while j < b.end {
            ref stmt : Expr = bbody.children[j.to_usize()]
            if is_compile_directive(stmt) { j = j.add(1); continue }
            mut tail_compound := false
            if j.add(1).eq(b.end) {
                tail_compound = stmt.node_type.is(NodeType.If)
                    .or(stmt.node_type.is(NodeType.While))
                    .or(stmt.node_type.is(NodeType.Switch))
                    .or(stmt.node_type.is(NodeType.Body))
            }
            if tail_compound {
                // Only the condition/subject evaluates here; a bare Body
                // contributes nothing at the tail.
                if stmt.node_type.is(NodeType.Body).not().and(stmt.children.len().gt(0)) {
                    c := gc_flow_stmt_const(stmt.children[0], name, scope, ctx)
                    if c.neq(FLOW_ID) { k = c }
                }
            } else {
                c := gc_flow_stmt_const(stmt, name, scope, ctx)
                if c.neq(FLOW_ID) { k = c }
            }
            j = j.add(1)
        }
        return k
    }
}

// Naive fixpoint: sweep until stable. States only descend the lattice
// (Unreached -> concrete -> Mixed) and effects are deterministic, so
// this converges; the guard is a loud backstop, not control flow.
//
// Both per-sweep costs are hoisted out of the loop. The predecessor
// sets used to be rediscovered by rescanning every block's successor
// list for every block, on every sweep (O(V^2) per sweep, and the
// single hottest thing in a self-translate profile: 122M Vec(I32)
// reads); they are now built once into a flat pred_off/preds pair. The
// per-block transfer function is likewise computed once (see
// gc_flow_block_kill), which turns the sweep body into pure state
// arithmetic.
// Counting sort by successor: one pass to size each block's bucket,
// one to fill it. The version this replaced asked, for every block,
// which of the OTHER blocks name it -- rescanning every successor list
// once per block, O(V^2) for a graph with O(V) edges. A big function's
// CFG has hundreds of blocks, and this is called once per body per
// solve. Bucket contents keep the same order (both fills visit
// predecessors in increasing block id), so the fixpoint meets in the
// same sequence.
priv gc_flow_preds := func(blocks: Vec(GcCfgBlock), mut pred_off: Array(USize), mut preds: Vec(USize)) {
    n := blocks.len()
    mut counts := Array(USize).new(n)
    for i in 0..n { counts[i] = 0 }
    for p in 0..n {
        ref pb : GcCfgBlock = blocks[p]
        for sc : I32 in pb.succs {
            sidx := sc.to_usize()
            ref c : USize = counts[sidx]
            counts[sidx] = c.add(1)
        }
    }
    mut acc : USize = 0
    for bi in 0..n {
        pred_off[bi] = acc.add(0)
        ref cb : USize = counts[bi]
        acc = acc.add(cb)
    }
    pred_off[n] = acc.add(0)
    if acc == 0 { return }
    // Sized once and written by index: the fill below is not in bucket
    // order, so pushing is out, and Vec.move_from would not help -- it
    // MEMCPIES the source into self and zeroes its count (it takes
    // `mut`, not `own`), so filling a second Vec and moving it in would
    // buy one malloc, one copy of the whole edge list, and one free.
    if preds.cap < acc {
        preds.data = realloc(own preds.data, acc.mul(USize.size()))
        preds.cap = acc
    }
    preds.count = acc
    mut cursor := Array(USize).new(n)
    for bi in 0..n {
        ref pb2 : USize = pred_off[bi]
        cursor[bi] = pb2.add(0)
    }
    // Every slot is written exactly once: acc is the edge count.
    for p in 0..n {
        ref pb : GcCfgBlock = blocks[p]
        for sc : I32 in pb.succs {
            sidx := sc.to_usize()
            ref at : USize = cursor[sidx]
            ref mut slot : USize = preds.unsafe_get(at)
            slot = p.add(0)
            cursor[sidx] = at.add(1)
        }
    }
}

// The sweep itself, over precomputed predecessors and per-block
// transfer functions. Split out so a caller solving MANY locals over
// one body pays for the graph once (gc_flow_stmt_table).
priv gc_flow_fixpoint := func(n: USize, pred_off: Array(USize), preds: Vec(USize), kill: Array(U8), entry_state: U8, mut ins: Array(U8), mut outs: Array(U8)) {
    for i in 0..n {
        ins[i] = FLOW_UNREACHED
        outs[i] = FLOW_UNREACHED
    }
    mut changed := true
    mut guard := 0
    while changed {
        changed = false
        for bi in 0..n {
            mut inm := FLOW_UNREACHED
            if bi == 1 { inm = entry_state }
            for pi in pred_off[bi]..pred_off[bi.add(1)] {
                inm = gc_flow_meet(inm, outs[preds[pi]])
            }
            mut newout := FLOW_UNREACHED
            if inm.neq(FLOW_UNREACHED) {
                newout = inm
                if kill[bi].neq(FLOW_ID) { newout = kill[bi] }
            }
            if inm.neq(ins[bi]) {
                ins[bi] = inm
                changed = true
            }
            if newout.neq(outs[bi]) {
                outs[bi] = newout
                changed = true
            }
        }
        guard++
        if guard > 1000 { panic(__LOC__, ": garbager flow: no fixpoint after 1000 sweeps") }
    }
}

priv gc_flow_solve := func(blocks: Vec(GcCfgBlock), entry_state: U8, name: Str, scope: TypeScope, ctx: Context, mut ins: Array(U8), mut outs: Array(U8)) {
    n := blocks.len()
    mut kill := Array(U8).new(n)
    for i in 0..n { kill[i] = gc_flow_block_kill(blocks, i, name, scope, ctx) }
    mut pred_off := Array(USize).new(n.add(1))
    mut preds := Vec(USize).new()
    gc_flow_preds(blocks, pred_off, preds)
    gc_flow_fixpoint(n, pred_off, preds, kill, entry_state, ins, outs)
}

// #302 stage 3: the per-statement ownership state of every live local
// in one table, so the insertion loop can ASK the dataflow instead of
// approximating it by statement order.
//
// table[l * body.children.len() + i] is local l's state on ENTRY to
// top-level statement i: the containing root block's IN, advanced
// through that block's earlier statements. Statements the CFG never
// reaches (code after a terminator) stay FLOW_UNREACHED.
//
// Built BEFORE the caller's move_from empties body.children -- the
// blocks index into it -- and shared across locals: the graph, its
// predecessor lists and the fixpoint scaffolding are per-body, only
// the per-block transfer functions are per-name.
priv gc_flow_stmt_table := func(body: Expr, locals: Vec(LocalInfo), entry_state: U8, has_exit: Bool, scope: TypeScope, ctx: Context) returns Array(U8) {
    // Nothing in this view can query the table: its exits, if any, live
    // inside nested views, and each of those builds its own. Bodies
    // with nested compounds but no exit of their own are the common
    // case, so building unconditionally would pay for a CFG, a
    // predecessor map and a name sweep per recursion level.
    if has_exit.not() { return Array(U8).new(0) }
    stmts := body.children.len()
    mut table := Array(U8).new(locals.len().mul(stmts))
    for t in 0..locals.len().mul(stmts) { table[t] = FLOW_UNREACHED }
    // No binding here can ever leave Owned, so no graph is needed: each
    // row is Uninit up to its Decl and Owned after, in closed form.
    // This is the majority of bodies, and building a CFG plus a
    // reachability solve for them cost 14% of a self-translate.
    mut any_transfer := false
    for probe : LocalInfo in locals {
        if probe.has_transfer { any_transfer = true; break }
    }
    if any_transfer.not() {
        for li in 0..locals.len() {
            ref local : LocalInfo = locals[li]
            for s in 0..stmts {
                if entry_state.eq(FLOW_UNINIT).and(local.decl_index.gte(0))
                    .and(s.to_i32().lte(local.decl_index)) {
                    table[li.mul(stmts).add(s)] = FLOW_UNINIT
                } else {
                    table[li.mul(stmts).add(s)] = FLOW_OWNED
                }
            }
        }
        return table
    }
    // Straight-line body: with no compound statement there is nothing to
    // branch or join, so the graph would be one block running to the
    // first terminator with everything after it unreachable. Compose the
    // statement effects directly instead of building it -- most bodies
    // end in a `return` and so reach the table, and paying a CFG plus a
    // reachability fixpoint for each cost 2% of a self-translate.
    mut first_exit : I32 = -1
    mut any_compound := false
    for s in 0..stmts {
        ref sstmt : Expr = body.children[s]
        if stmt_is_conditional_container(sstmt) { any_compound = true; break }
        if first_exit.lt(0).and(sstmt.node_type.is(NodeType.Return)
            .or(sstmt.node_type.is(NodeType.Break)).or(sstmt.node_type.is(NodeType.Continue))) {
            first_exit = s.to_i32()
        }
    }
    if any_compound.not() {
        for li in 0..locals.len() {
            ref local : LocalInfo = locals[li]
            mut cur := entry_state
            if local.decl_index < 0 { cur = FLOW_OWNED }
            for s in 0..stmts {
                if first_exit.gte(0).and(s.to_i32().gt(first_exit)) { break }
                table[li.mul(stmts).add(s)] = cur
                if local.has_transfer.not() {
                    // Cannot leave Owned: the only question is whether
                    // its Decl has run.
                    if cur.eq(FLOW_UNINIT).and(s.to_i32().gte(local.decl_index)) { cur = FLOW_OWNED }
                    continue
                }
                ref sstmt : Expr = body.children[s]
                if is_compile_directive(sstmt).not() {
                    c := gc_flow_stmt_const(sstmt, local.name, scope, ctx)
                    if c.neq(FLOW_ID) { cur = c }
                }
            }
        }
        return table
    }
    mut blocks := Vec(GcCfgBlock).new()
    cfg_build(blocks, body)
    n := blocks.len()
    mut pred_off := Array(USize).new(n.add(1))
    mut preds := Vec(USize).new()
    gc_flow_preds(blocks, pred_off, preds)
    mut kill := Array(U8).new(n)
    mut ins := Array(U8).new(n)
    mut outs := Array(U8).new(n)
    // Reachability is name-independent, so solve it once with the
    // identity transfer everywhere; the untransferred bindings ride it
    // instead of each running their own fixpoint.
    mut reachable := Array(Bool).new(stmts)
    for s in 0..stmts { reachable[s] = false }
    for bi in 0..n { kill[bi] = FLOW_ID }
    gc_flow_fixpoint(n, pred_off, preds, kill, FLOW_OWNED, ins, outs)
    for bi in 0..n {
        ref b : GcCfgBlock = blocks[bi]
        if b.is_root.not() { continue }
        if ins[bi].eq(FLOW_UNREACHED) { continue }
        mut j := b.start
        while j < b.end {
            reachable[j.to_usize()] = true
            j = j.add(1)
        }
    }
    for li in 0..locals.len() {
        ref local : LocalInfo = locals[li]
        // A binding with no Decl in this view (a param, or a local of
        // an enclosing body) is already owned when control arrives.
        mut entry := entry_state
        if local.decl_index < 0 { entry = FLOW_OWNED }
        if local.has_transfer.not() {
            // Never transferred here, so never Moved and never Mixed:
            // Uninit until its Decl statement has run, Owned after. The
            // Decl must be a top-level statement of THIS view for that
            // to hold -- one nested inside a branch or loop would leave
            // the join Mixed, so those take the solve.
            mut decl_is_top := false
            if entry.eq(FLOW_UNINIT).and(local.decl_index.gte(0)) {
                ref dstmt : Expr = body.children[local.decl_index.to_usize()]
                switch dstmt.node_type {
                case .Decl(dd): decl_is_top = dd.name == local.name
                case:
                }
            }
            if entry.eq(FLOW_UNINIT).and(decl_is_top.not()) {
                // fall through to the full solve
            } else {
                for s in 0..stmts {
                    if reachable[s].not() { continue }
                    if entry.eq(FLOW_UNINIT).and(s.to_i32().lte(local.decl_index)) {
                        table[li.mul(stmts).add(s)] = FLOW_UNINIT
                    } else {
                        table[li.mul(stmts).add(s)] = FLOW_OWNED
                    }
                }
                continue
            }
        }
        for bi in 0..n { kill[bi] = gc_flow_block_kill(blocks, bi, local.name, scope, ctx) }
        gc_flow_fixpoint(n, pred_off, preds, kill, entry, ins, outs)
        for bi in 0..n {
            ref b : GcCfgBlock = blocks[bi]
            if b.is_root.not() { continue }
            if ins[bi].eq(FLOW_UNREACHED) { continue }
            switch b.body {
            case .Some(bbody):
                mut st : U8 = FLOW_UNREACHED
                st = ins[bi]
                mut j := b.start
                while j < b.end {
                    table[li.mul(stmts).add(j.to_usize())] = st
                    ref stmt : Expr = bbody.children[j.to_usize()]
                    if is_compile_directive(stmt).not() {
                        st = gc_flow_stmt_effect(stmt, local.name, st, scope, ctx)
                    }
                    j = j.add(1)
                }
            case .None:
                // Root blocks always carry a body (cfg_new_block).
                UNREACHABLE("cfg block has no body")
            }
        }
    }
    return table
}

// True when the binding leaves this body view still OWNED on at least
// one path AND MOVED on at least one other -- the partial-transfer
// state whose cleanup must be path-sensitive. Computed from the exit
// block's predecessors, not the exit meet: a path that exits before
// the binding's decl carries Uninit (nothing to free there -- e.g. the
// loop-condition break of a loop-body view), and folding that into the
// meet would read as Mixed forever. Uniform Moved (a for-in / bare
// -block wrapper that transfers on every pass) and uniform Owned
// (ordinary scope-end cleanup) both return false.
priv gc_flow_exit_is_mixed := func(body: Expr, local: LocalInfo, scope: TypeScope, ctx: Context) returns Bool {
    mut blocks := Vec(GcCfgBlock).new()
    cfg_build(blocks, body)
    mut entry := FLOW_UNINIT
    if local.decl_index < 0 { entry = FLOW_OWNED }
    mut ins := Array(U8).new(blocks.len())
    mut outs := Array(U8).new(blocks.len())
    gc_flow_solve(blocks, entry, local.name, scope, ctx, ins, outs)
    mut may_owned := false
    mut may_moved := false
    for p in 0..blocks.len() {
        ref pb : GcCfgBlock = blocks[p]
        mut feeds_exit := false
        for sc : I32 in pb.succs {
            if sc == 0 { feeds_exit = true }
        }
        if feeds_exit {
            if outs[p].eq(FLOW_OWNED).or(outs[p].eq(FLOW_MIXED)) { may_owned = true }
            if outs[p].eq(FLOW_MOVED).or(outs[p].eq(FLOW_MIXED)) { may_moved = true }
        }
    }
    return may_owned.and(may_moved)
}

// True when EVERY path reaching top-level statement `stmt_idx` of this
// body view carries the binding still Owned -- i.e. no path that moved
// it rejoins before that statement (the transfer paths all diverged,
// e.g. `switch n { case 1: return f(own s) case: ... }; use s`). The
// state is taken at the statement's ENTRY: the containing root block's
// IN, advanced through the block's earlier statements. Statement
// indexes are the index model's top-level indexes, which root blocks
// share by construction.
priv gc_flow_owned_at_stmt := func(body: Expr, local: LocalInfo, scope: TypeScope, ctx: Context, stmt_idx: I32) returns Bool {
    mut blocks := Vec(GcCfgBlock).new()
    cfg_build(blocks, body)
    mut entry := FLOW_UNINIT
    if local.decl_index < 0 { entry = FLOW_OWNED }
    mut ins := Array(U8).new(blocks.len())
    mut outs := Array(U8).new(blocks.len())
    gc_flow_solve(blocks, entry, local.name, scope, ctx, ins, outs)
    for bi in 0..blocks.len() {
        ref b : GcCfgBlock = blocks[bi]
        if b.is_root.not() { continue }
        if b.start.lte(stmt_idx).and(stmt_idx.lt(b.end)) {
            mut st : U8 = FLOW_UNREACHED
            if ins[bi].eq(FLOW_UNREACHED).not() {
                switch b.body {
                case .Some(bbody):
                    mut j := b.start
                    st = gc_flow_meet(st, ins[bi])
                    while j < stmt_idx {
                        ref stmt : Expr = bbody.children[j.to_usize()]
                        if is_compile_directive(stmt).not() {
                            st = gc_flow_stmt_effect(stmt, local.name, st, scope, ctx)
                        }
                        j = j.add(1)
                    }
                case .None:
                    // Root blocks always carry a body (cfg_new_block).
                    UNREACHABLE("cfg block has no body")
                }
            }
            return st == FLOW_OWNED
        }
    }
    return false
}

priv gc_flow_dump := proc(ctx: Context, blocks: Vec(GcCfgBlock), locals: Vec(LocalInfo), scope: TypeScope) {
    mut names := Map(Str, Str).new()
    mut counts := Map(Str, I64).new()
    for local : LocalInfo in locals {
        if gc_audit_local_is_noise(local) { continue }
        mut entry := FLOW_UNINIT
        if local.decl_index < 0 { entry = FLOW_OWNED }
        mut ins := Array(U8).new(blocks.len())
        mut outs := Array(U8).new(blocks.len())
        gc_flow_solve(blocks, entry, local.name, scope, ctx, ins, outs)
        mut ss := ""
        for j in 0..blocks.len() {
            if j > 0 { ss = format(ss, ",") }
            ss = format(ss, gc_flow_letter(outs[j]))
        }
        println("GC-FLOW local ", gc_audit_name(local.name, names, counts),
            " entry=", gc_flow_letter(entry),
            " exit=", gc_flow_letter(outs[0]),
            " out=", ss)
    }
}

// --- #272 step 4, slice 1: backward liveness over the same CFG --------------
//
// The forward flow above answers "does some path still OWN the binding
// here"; the index model's last_use answers a different question --
// "is the binding read again after this statement" -- and answers it
// positionally, as one max over every path at once. Backward liveness
// is that question per path: a binding is live out of a block iff some
// successor reads it before killing it. Dump-only under TIL_GC_AUDIT
// (GC-LIVE rows), exactly like the forward flow when it landed:
// consumers migrate one at a time against the pass-diff referee before
// any last_use reader is retired.
//
// Uses are TEXTUAL here (expr_uses_var), deliberately. The borrow and
// view-taint extensions (collect_borrow_edges, collect_hoist_taint)
// today widen last_use before any consumer reads it; when a consumer
// migrates, those edges join this solve as extra per-statement uses.
// Until then the dump shows the raw textual answer, so the golden
// makes every place the extensions diverge from it reviewable.

priv LIVE_ID : U8 = 0
priv LIVE_DEAD : U8 = 1
priv LIVE_USE : U8 = 2

// A statement's backward transfer function, identity-or-constant like
// gc_flow_stmt_const. Use is checked FIRST: `s = f(own s)` reads the
// old value in its RHS before rebinding, so the binding is live above
// the statement. A Decl, or a reassign whose RHS never reads the name,
// kills liveness instead: above it the binding's current value either
// does not exist yet (Decl) or is replaced unread (Assign -- its
// save_old_delete cleanup is the assign's own business, not a use).
priv gc_live_stmt_const := func(stmt: Expr, name: Str) returns U8 {
    if expr_uses_var(stmt, name) { return LIVE_USE }
    if expr_contains_decl(stmt, name) { return LIVE_DEAD }
    if expr_reassigns_var(stmt, name) { return LIVE_DEAD }
    return LIVE_ID
}

// The block's composed backward transfer function. Composing
// identity-or-constant functions backward makes the EARLIEST
// non-identity statement in the span win -- it is applied last on the
// way up, the mirror image of gc_flow_block_kill's last-constant-wins.
// The tail-compound rule is shared: a compound statement closing a
// block contributes only its condition/subject; its branch bodies are
// separate blocks.
priv gc_live_block_gen := func(blocks: Vec(GcCfgBlock), bid: USize, name: Str) returns U8 {
    ref b : GcCfgBlock = blocks[bid]
    switch b.body {
    case .None:
        // Synthetic exit block: no statements, liveness passes through.
        return LIVE_ID
    case .Some(bbody):
        mut j := b.start
        while j < b.end {
            ref stmt : Expr = bbody.children[j.to_usize()]
            if is_compile_directive(stmt) { j = j.add(1); continue }
            mut tail_compound := false
            if j.add(1).eq(b.end) {
                tail_compound = stmt.node_type.is(NodeType.If)
                    .or(stmt.node_type.is(NodeType.While))
                    .or(stmt.node_type.is(NodeType.Switch))
                    .or(stmt.node_type.is(NodeType.Body))
            }
            if tail_compound {
                // Only the condition/subject evaluates here; a bare Body
                // contributes nothing at the tail.
                if stmt.node_type.is(NodeType.Body).not().and(stmt.children.len().gt(0)) {
                    c := gc_live_stmt_const(stmt.children[0], name)
                    if c.neq(LIVE_ID) { return c }
                }
            } else {
                c := gc_live_stmt_const(stmt, name)
                if c.neq(LIVE_ID) { return c }
            }
            j = j.add(1)
        }
        return LIVE_ID
    }
}

// Naive fixpoint like gc_flow_fixpoint, but BACKWARD: a block's out is
// the OR of its successors' ins, and its in applies the block's own
// composed function. Bits only flip 0 -> 1, so this converges; the
// guard is a loud backstop, not control flow. No predecessor lists
// needed -- the successor edges the blocks already carry are exactly
// what a backward sweep reads.
priv gc_live_solve := func(blocks: Vec(GcCfgBlock), name: Str, mut ins: Array(U8), mut outs: Array(U8)) {
    n := blocks.len()
    mut gen := Array(U8).new(n)
    for i in 0..n { gen[i] = gc_live_block_gen(blocks, i, name) }
    for i in 0..n {
        ins[i] = 0
        outs[i] = 0
    }
    mut changed := true
    mut guard := 0
    while changed {
        changed = false
        for bi in 0..n {
            ref b : GcCfgBlock = blocks[bi]
            mut o : U8 = 0
            for sc : I32 in b.succs {
                if ins[sc.to_usize()] == 1 { o = 1 }
            }
            mut lv := o
            if gen[bi] == LIVE_USE { lv = 1 }
            if gen[bi] == LIVE_DEAD { lv = 0 }
            if o.neq(outs[bi]) {
                outs[bi] = o
                changed = true
            }
            if lv.neq(ins[bi]) {
                ins[bi] = lv
                changed = true
            }
        }
        guard++
        if guard > 1000 { panic(__LOC__, ": garbager liveness: no fixpoint after 1000 sweeps") }
    }
}

priv gc_live_dump := proc(blocks: Vec(GcCfgBlock), locals: Vec(LocalInfo)) {
    mut names := Map(Str, Str).new()
    mut counts := Map(Str, I64).new()
    for local : LocalInfo in locals {
        if gc_audit_local_is_noise(local) { continue }
        mut ins := Array(U8).new(blocks.len())
        mut outs := Array(U8).new(blocks.len())
        gc_live_solve(blocks, local.name, ins, outs)
        mut ss := ""
        for j in 0..blocks.len() {
            if j > 0 { ss = format(ss, ",") }
            ss = format(ss, ins[j].to_str())
        }
        println("GC-LIVE local ", gc_audit_name(local.name, names, counts),
            " entry=", ins[1].to_str(),
            " in=", ss)
    }
}

// A `ref x := <binding>` alias of `name` that `expr` (typically a return
// value) uses -- the binding is reached through x, so it must outlive the
// exit. arg_addressed_ident sees through to_ptr(): `ref s : Scope =
// to_ptr(raw)` aliases raw exactly as `ref s := raw` would, and matching
// only a bare Ident missed it -- so a `return s` did not protect raw and
// the pass scheduled its free before the caller ever saw the block.
// Does any Return in this subtree hand back `name`?
priv body_returns_var := func(e: Expr, name: Str) returns Bool {
    if e.node_type.is(NodeType.Return).and(e.children.len().gt(0)) {
        if expr_uses_var(e.children[0], name) { return true }
    }
    for c : Expr in e.children {
        if body_returns_var(c, name) { return true }
    }
    return false
}

// `name` is aliased by a `ref` binding that the body RETURNS: the caller
// gets a pointer into name's block, so the block outlives this body and
// its cleanup must stand down. The per-return guard in
// insert_exit_deletes_into_stmt only skips the delete it is inserting at
// that return; the scope-end path has no such guard, which is how
// `ref s : Scope = to_ptr(raw) ... return s` still emitted `free(raw);
// return s;` -- a dangling pointer handed to the caller.
priv aliased_by_returned_ref := func(body: Expr, name: Str) returns Bool {
    for d : Expr in body.children {
        switch d.node_type {
        case .Decl(dd):
            if dd.own_type.is(OwnType.Ref).and(d.children.len().gt(0)) {
                src_o := arg_addressed_ident(d.children[0])
                if src_o.is_some().and(src_o.unwrap() == name) {
                    if body_returns_var(body, dd.name) { return true }
                }
            }
        case:
        }
    }
    return false
}

// Issue #238: the typer's hoist pass can lift a view-returning subexpression
// of an assignment's RHS (e.g. `vname.substr(...)`) into a `hoisted__` temp
// that ALIASES vname's heap buffer, emitted as a statement BEFORE the assign.
// The textual RHS then only names the temp, so expr_uses_var(rhs, vname) no
// longer sees the dependency. If we miss it, insert_assign_delete emits the
// old-value delete too early and the RHS clone copies from vname's freed
// buffer (a use-after-free; manifests as garbage bytes).
//
// Walk the already-emitted preceding statements, taint every binding whose
// initializer (transitively) reads vname, then report a dependency if the
// RHS reads vname directly or any tainted binding.
// Names of bindings among `preceding` whose initializer (transitively)
// reads `target`. Such a binding may hold a non-owning *view* into
// target's heap buffer (e.g. `target.substr(...)`), so any later use is
// really a use of target's storage. This deliberately covers USER-NAMED
// locals, not just `hoisted__` temps (#258 follow-up): `mut v :=
// src.substr(0, n)` aliases src exactly like a hoisted temp does, and
// the hoisted-only filter this walk used to have let src's delete land
// between the view Decl and the later `v.clone()` -- a use-after-free.
// The taint also follows clone results that no longer alias the buffer;
// that over-eagerness only defers a delete or keeps a clone, both safe.
// Only the first `limit` statements count: the insertion-loop callers
// ask about the statements ALREADY emitted, and taint is monotone in
// that prefix, so widening it to the whole body would defer deletes the
// pass has no reason to defer yet.
//
// A statement's uses row differs from its initializer's only by the
// Decl/Assign target name itself, which both skips below already
// exclude (def_bit == target_bit; already-tainted), so probing
// stmt-level uses is exact -- and it is why this needs no Expr at all,
// which is what lets the insertion loop call it after move_from.
//
// target_bit is the target's universe bit (fact_bit_req). tainted_mask
// is a caller-provided zeroed single row (zeroed_words(facts.words));
// on return it holds the tainted names as bits, so extend_hoist_view_
// lifetimes' per-statement probe is one row intersection instead of a
// per-tainted-name search. The returned names still matter to
// rhs_depends_on_var, whose expr_uses_var walk needs bytes.
priv collect_hoist_taint := func(target_bit: I64, facts: BodyFacts, limit: USize, mut tainted_mask: Vec(U64)) returns Vec(Str) {
    mut tainted := Vec(Str).new()
    mut changed := true
    while changed {
        changed = false
        for pi in 0..limit {
            ref def_bit : I64 = facts.def_bits.unsafe_get(pi)
            if def_bit < 0 { continue }
            if def_bit == target_bit { continue }
            if fact_bit_test(tainted_mask, 0, def_bit.to_usize()) { continue }
            base := pi.mul(facts.words)
            mut dep := fact_bit_test(facts.uses, base, target_bit.to_usize())
            if dep.not() { dep = fact_row_intersects(facts.uses, base, tainted_mask, facts.words) }
            if dep {
                fact_bit_record(tainted_mask, 0, def_bit.to_usize())
                tainted.push(own facts.def_names.unsafe_get(pi).clone())
                changed = true
            }
        }
    }
    return tainted
}

priv rhs_depends_on_var := func(rhs: Expr, vname: Str, target_bit: I64, facts: BodyFacts, limit: USize) returns Bool {
    if expr_uses_var(rhs, vname) { return true }
    mut tmask := zeroed_words(facts.words)
    tainted := collect_hoist_taint(target_bit, facts, limit, tmask)
    for t : Str in tainted {
        if expr_uses_var(rhs, t) { return true }
    }
    return false
}

// Issue #258: the clone-to-move elisions in insert_post_stmt_deletes are
// only sound when the clone-arg OWNS its buffer. A Str value can be a
// non-owning view at runtime (cap == CAP_VIEW: substr / strip_prefix /
// trim results), and views flow freely through locals, reassignments and
// returns -- only .clone() materializes an owned copy. View-ness is a
// runtime property of the VALUE (the cap sentinel), not of the type
// (Str is an ordinary owning collection like Vec or Map), so the type
// alone cannot tell a borrow from an owner. Moving a view into the
// assign/field target would install a borrow that dangles once the
// viewed buffer dies (the other half of the #250 substr-view
// miscompile: `cli.cc = flag.strip_prefix("--cc=").clone()` compiled to
// a move of the view into flag's argv storage). So a Str clone-arg only
// moves when ownership is provable (str_clone_to_move_provably_safe
// below); otherwise the clone stays -- exact and leak-free (Str_clone
// copies the bytes, Str_delete honors the view/literal cap sentinels),
// costing one byte copy. Every other aggregate keeps the move
// unconditionally -- non-Str values have no view representation, their
// contents always own, and for them the elision is a real leak fix
// (Context_clone via load_program; the #256 own-field move).
priv clone_arg_may_be_view := func(local: LocalInfo) returns Bool {
    return type_to_name(local.type) == "Str"
}

// A def RHS that provably yields an owning-or-static Str value:
//   - Str literal: CAP_LIT static bytes -- moving installs a view of
//     static storage, which never dangles;
//   - T.clone(...): ownership materialized by definition.
// Anything else -- any other call (substr / strip_prefix / user funcs
// can return CAP_VIEW borrows), ident copies, field reads -- is
// unprovable: the value may be a borrowed view (issue #258). Owning
// CONSTRUCTOR calls (format, Str.with_capacity) are deliberately NOT
// whitelisted: the garbager runs before the constfolder, and a
// constant-arg constructor can later fold into a stack literal Decl,
// turning the move rewrite's wrapper `free(local)` into a free of a
// stack value (fix_stale_litstr_in_body only repairs `<T>.delete`
// cleanups, not the move path's raw free). A clone call never folds:
// .clone() on a literal receiver is a typer error, and a runtime
// receiver is unknowable to the folder.
priv str_rhs_provably_owning := func(rhs: Expr) returns Bool {
    if rhs.node_type.is_literal_str() { return true }
    return rhs_is_clone_fcall(rhs)
}

// True when the subtree holds `name`'s Decl and its initializer is
// provably owning. Nested FuncDef subtrees are skipped: a nested
// function's `name` is a different binding.
priv expr_has_owning_str_decl := func(e: Expr, name: Str) returns Bool {
    switch e.node_type {
    case .FuncDef: return false
    case .Decl(dd):
        if dd.name == name {
            if e.children.len() == 0 { return false }
            return str_rhs_provably_owning(e.children[0])
        }
    case:
    }
    for c : Expr in e.children {
        if expr_has_owning_str_decl(c, name) { return true }
    }
    return false
}

// True when the subtree writes `name` (Decl initializer or Assign, at
// any nesting depth) with an RHS that is NOT provably owning. FuncDef
// subtrees are skipped as above.
priv expr_has_unproven_str_def := func(e: Expr, name: Str) returns Bool {
    switch e.node_type {
    case .FuncDef: return false
    case .Decl(dd):
        if dd.name == name {
            if e.children.len() == 0 { return true }
            return str_rhs_provably_owning(e.children[0]).not()
        }
    case .Assign(ad):
        if ad.name == name {
            if e.children.len() == 0 { return true }
            // Issue #325: a literal ASSIGN is NOT move-safe, even though a
            // literal DECL is. `t = "zz"` repoints the local's WRAPPER at
            // static literal storage (`t = &_til_str_lits[N]`), so the move
            // path's `free(local)` would free a non-heap object -- the C
            // compiler rejects it outright ("'free' called on unallocated
            // object '_til_str_lits'"). A literal DECL is fine: the local is
            // a static/stack value from the start (is_heap false), so it
            // never reaches the heap move path. Same hazard the comment on
            // str_rhs_provably_owning records for constructor RHSs that fold
            // into a stack literal.
            if e.children[0].node_type.is_literal_str() { return true }
            return str_rhs_provably_owning(e.children[0]).not()
        }
    case:
    }
    for c : Expr in e.children {
        if expr_has_unproven_str_def(c, name) { return true }
    }
    return false
}

// Issue #258 refinement: a Str clone-arg may still be MOVED when every
// def of the local among the preceding statements -- its Decl
// initializer and every reassignment, at any nesting depth -- provably
// yields an owning or static value (str_rhs_provably_owning). A local
// with no visible Decl (params, outer-scope bindings) stays
// conservative: its provenance is unknowable here, keep the clone.
priv str_clone_to_move_provably_safe := func(name: Str, preceding: Vec(Expr)) returns Bool {
    mut has_owning_decl := false
    for pst : Expr in preceding {
        if expr_has_unproven_str_def(pst, name) { return false }
        if expr_has_owning_str_decl(pst, name) { has_owning_decl = true }
    }
    return has_owning_decl
}

// Per-statement name facts for one body (perf): five U64 bitmask rows
// per statement, filled in a single walk (the expr_collect_* mirrors in
// typer.til) and probed by the per-local loops below, which previously
// rescanned every statement subtree once per (statement, local-name)
// query -- the top cost of a self-translate profile. The rows replaced
// per-statement Set(Str)s: a probe was a string binary search per
// (binding, statement) pair; now each consumer resolves its name to a
// universe bit once and every per-statement question is a word AND.
// scope may be NULL when with_transfers=false (the transfers walk is
// the only scope consumer).
priv BodyFacts := struct {
    // U64 words per statement row: ceil(universe size / 64). Rows are
    // stored row-major in each fact vec (statement i's row starts at
    // word i * words).
    words : USize = 0
    n_stmts : USize = 0
    uses := Vec(U64).new()
    decls := Vec(U64).new()
    nested := Vec(U64).new()
    transfers := Vec(U64).new()
    // Names whose pointer a statement stores into raw memory
    // (write_ptr): reachable afterwards through storage the pass cannot
    // see, so their cleanup stands down.
    escapes := Vec(U64).new()
    // Per statement, the binding it DEFINES from an initializer -- a
    // Decl's or an Assign's target, "" / -1 for anything else (and for
    // a Decl with no initializer, which defines nothing to taint).
    // Recorded so the taint walk needs no Expr access at all: the
    // insertion loop queries it after move_from has emptied
    // body.children and push_take has zeroed the statements it
    // consumed. Names AND bits: the fixpoint compares bits, while
    // rhs_depends_on_var hands names to expr_uses_var.
    def_names := Vec(Str).new()
    def_bits := Vec(I64).new()
    // is_compile_directive per statement. That is a property of the
    // STATEMENT, not of the binding being asked about, but the scans
    // below run per (binding, statement) and re-derived it every time:
    // a callee-name string compare per binding for the same answer.
    directives := Vec(Bool).new()
}

// The probe universe for one body: every name a fact consumer below can
// ever query -- this scope's own bindings (collect_scope_locals probes,
// borrow-edge Decl targets, hoist-taint targets from locals) plus the
// body's top-level Assign targets (taint def_names and
// rhs_depends_on_var targets may be outer-scope locals). The collectors
// drop any recorded name outside this map, which is exactly the filter
// that keeps rows narrow. Bit values are insertion positions.
priv fact_universe := func(body: Expr, scope: TypeScope) returns FactIndex {
    mut fi := FactIndex()
    for b in scope.bindings.values {
        if fi.idx.has(b.name).not() {
            fi.idx.set(b.name, own fi.idx.len())
            fi.filt = fi.filt.bor(name_fingerprint(b.name))
        }
    }
    for stmt : Expr in body.children {
        switch stmt.node_type {
        case .Assign(ad):
            if fi.idx.has(ad.name).not() {
                fi.idx.set(ad.name, own fi.idx.len())
                fi.filt = fi.filt.bor(name_fingerprint(ad.name))
            }
        case:
        }
    }
    return fi
}

// fact_bit_of for a name the universe MUST contain: every consumer
// probe below is for a binding or a top-level Assign target, both
// seeded by fact_universe, so a miss is a broken invariant -- fail at
// the source instead of probing false and silently mis-scheduling a
// delete.
priv fact_bit_req := func(fi: FactIndex, name: Str) returns USize {
    // Straight to the search: a required name is in the universe, so
    // the fingerprint prefilter could only waste an AND here.
    bit := fact_bit_search(fi.idx, name)
    if bit < 0 { panic(__LOC__, ": fact universe is missing probed name '", name, "'") }
    return bit.to_usize()
}

priv fact_bit_test := func(mask: Vec(U64), base: USize, bit: USize) returns Bool {
    one : U64 = 1
    return mask.unsafe_get(base.add(bit / 64)).band(one.shl(bit.mod(64).to_u64())) > 0
}

// True when the row at `base` in `mask` shares any bit with the
// single row `other` (both `words` wide).
priv fact_row_intersects := func(mask: Vec(U64), base: USize, other: Vec(U64), words: USize) returns Bool {
    for w in 0..words {
        if mask.unsafe_get(base.add(w)).band(other.unsafe_get(w)) > 0 { return true }
    }
    return false
}

// One malloc and one memset. Vec.push takes its value OWNED, so the
// element-at-a-time fill this replaced ran a malloc/free pair per WORD
// of every row -- five rows per body, to write zeros.
priv zeroed_words := func(total: USize) returns Vec(U64) {
    if total == 0 { return Vec(U64).new() }
    mut v := Vec(U64).with_capacity(total)
    memset(v.data, 0, total.mul(U64.size()))
    v.count = total
    return v
}

priv body_stmt_facts := func(body: Expr, scope: TypeScope, with_transfers: Bool, fi: FactIndex) returns BodyFacts {
    mut bf := BodyFacts()
    bf.words = fi.idx.len().add(63) / 64
    bf.n_stmts = body.children.len()
    total := bf.n_stmts.mul(bf.words)
    bf.uses = zeroed_words(total)
    bf.decls = zeroed_words(total)
    bf.nested = zeroed_words(total)
    bf.transfers = zeroed_words(total)
    bf.escapes = zeroed_words(total)
    mut i : USize = 0
    for stmt : Expr in body.children {
        base := i.mul(bf.words)
        i = i + 1
        // One traversal fills all five rows. It replaced five separate
        // walks over the same subtree -- 1.8M collector calls per
        // maps.til compile where one walk needs 411K.
        expr_collect_stmt_facts(stmt, scope, with_transfers, true, fi, base, bf.uses, bf.decls, bf.nested, bf.escapes, bf.transfers)
        mut dname := ""
        if stmt.children.len() >= 1 {
            switch stmt.node_type {
            case .Decl(dd): dname = dd.name.clone()
            case .Assign(ad): dname = ad.name.clone()
            case:
            }
        }
        bf.directives.push(own is_compile_directive(stmt))
        if dname.len() > 0 {
            bf.def_bits.push(own fact_bit_req(fi, dname).to_i64())
            bf.def_names.push(own dname)
        } else {
            bf.def_bits.push(own -1)
            // Not `own dname`: that empty is the "" LITERAL, and the
            // own-arg box wrapping a CAP_LIT value is exempt from
            // adopt's box free (the exemption exists for true static
            // literal objects), so pushing it leaks the box -- ASAN
            // caught 8K of them. A default-constructed Str is an owned
            // buffer-less empty: same bytes, freeable box.
            bf.def_names.push(own Str())
        }
    }
    return bf
}

priv collect_scope_locals := func(body: Expr, scope: TypeScope, is_program_scope: Bool, facts: BodyFacts, fi: FactIndex, stack_own_params: Set(Str), mut locals_vec: Vec(LocalInfo)) {
    for b in scope.bindings.values {
        // Non-Own parameters borrow their storage; their caller or generated
        // entry wrapper owns any setup storage.
        if b.is_param.and(b.own_type.is(OwnType.Own).not()) { continue }
        // These two ask whether THIS scope registers the name as a type
        // or a function; the binding came out of this scope's own map,
        // so the local probes answer exactly what struct_def_of /
        // lookup_func would, without their binding probe.
        bfp := name_fingerprint(b.name)
        if scope.local_struct_def_fp(b.name, bfp).is_some() { continue }
        if scope.local_func_def_fp(b.name, bfp).is_some().and(b.type.is_funcptr().not()).and(b.type.is(Type.Body).not()) { continue }

        // One name->bit resolution per binding; every per-statement
        // question below is then a bit test.
        bbit := fact_bit_req(fi, b.name)

        mut decl_idx : I32 = -1
        for j in 0..body.children.len() {
            ref s : Expr = body.children[j]
            switch s.node_type {
            case .Decl(dd):
                if dd.name == b.name {
                    decl_idx = j.to_i32()
                    break
                }
            case:
            }
        }
        if decl_idx == -1 {
            for j in 0..body.children.len() {
                if fact_bit_test(facts.decls, j.mul(facts.words), bbit) {
                    decl_idx = j.to_i32()
                    break
                }
            }
        }

        mut last_use : I32 = -1
        mut own_transfer : I32 = -1
        mut scan_from : USize = 0
        if decl_idx >= 0 {
            scan_from = decl_idx.add(1).to_usize()
        }
        for j in scan_from..body.children.len() {
            if facts.directives.unsafe_get(j) { continue }
            fbase := j.mul(facts.words)
            if fact_bit_test(facts.uses, fbase, bbit) {
                last_use = j.to_i32()
            }
            if own_transfer == -1 {
                if fact_bit_test(facts.transfers, fbase, bbit) {
                    own_transfer = j.to_i32()
                }
            }
        }

        // Program-scope locals "live forever" so the asap pass skips
        // their cleanup. Synthesized hoist temps (`hoisted__` prefix) are
        // a separate population: the hoist pass lifts FCall args / Type
        // ctors / etc. into a Decl that is consumed by the very next stmt,
        // so they need the normal post-stmt-deletes treatment even at
        // program scope. Without this carveout, top-level `mut X := Foo()`
        // initializers leak every hoisted temp the typer emits to build
        // the constructor args (Type_Struct, Type_Enum, ...).
        //
        // A program-scope binding whose Decl is NOT in this body was declared
        // by some other body sharing the same global scope -- another imported
        // file, or (in the REPL) an earlier turn's delta -- and belongs to
        // whoever declared it. Scheduling a scope-end delete here destroys a
        // live global at its last use in a body that never owned it: the REPL
        // ran `Vec(I64).delete(v, false)` at the end of every turn after the
        // one declaring `v`, so the next `v.push` memcpy'd into a freed buffer
        // and the session died on "corrupted size vs. prev_size in fastbins".
        // Only hoist temps are program-scope locals this pass owns, and the
        // hoist pass always declares them in the body it serves.
        mut skip_scope_delete := is_program_scope.and(decl_idx.lt(0).or(b.name.starts_with("hoisted__").not()))
        if skip_scope_delete.not() {
            for j in scan_from..body.children.len() {
                if facts.directives.unsafe_get(j) { continue }
                fbase := j.mul(facts.words)
                // A closure body use, or a write_ptr that stored this
                // binding's pointer into raw memory: in both cases it stays
                // reachable past its last textual mention, so the pass must
                // not schedule a delete for it.
                if fact_bit_test(facts.nested, fbase, bbit).or(fact_bit_test(facts.escapes, fbase, bbit)) {
                    skip_scope_delete = true
                    break
                }
            }
        }
        // Ref bindings do not own data and skip cleanup. Shallow parameters
        // are C values and were filtered with the other non-Own parameters.
        if b.own_type.is(OwnType.Ref) { skip_scope_delete = true }
        if skip_scope_delete.not() {
            if aliased_by_returned_ref(body, b.name) { skip_scope_delete = true }
        }

        mut li := LocalInfo(name = b.name)
        li.type = b.type
        li.decl_index = decl_idx
        li.last_use = last_use
        li.own_transfer = own_transfer
        li.has_transfer = own_transfer >= 0
        li.skip_scope_delete = skip_scope_delete
        if own_transfer >= 0 {
            li.dtor_transfer = transfer_is_destructor_call(body.children[own_transfer.to_usize()], b.name)
            li.shallow_copy_transfer = transfer_is_shallow_field_value_copy(body.children[own_transfer.to_usize()], b.name, scope)
        }
        // #346: semantic Own does not imply a heap wrapper. Ordinary
        // aggregate locals are values. Closed-world ordinary Own primitive
        // and aggregate parameters are values too; pointer-boundary Own
        // parameters, raw allocations, Dynamic, and allocated callable objects
        // are exceptions.
        stack_own_param := b.is_param.and(decl_idx.lt(0)).and(stack_own_params.has(b.name))
        li.is_heap = b.own_type.is(OwnType.Own)
            .and(b.type.is(Type.Dynamic).or(b.is_param.and(decl_idx.lt(0)).and(stack_own_param.not())))
        if type_is_callable_storage(b.type).and(b.own_type.is(OwnType.Ref).not()) { li.is_heap = false }
        if decl_idx >= 0 {
            ref li_stmt : Expr = body.children[decl_idx.to_usize()]
            if li_stmt.node_type.is(NodeType.Decl).and(li_stmt.children.len().gt(0)) {
                ref li_rhs : Expr = li_stmt.children[0]
                switch li_rhs.node_type {
                case .FuncDef(rhs_fd):
                    if b.type.is_funcptr().and(rhs_fd.captures.len().gt(0)).and(b.own_type.is(OwnType.Ref).not()) {
                        li.is_heap = true
                    }
                case .BodyValue:
                    if b.type.is(Type.Body).and(b.own_type.is(OwnType.Ref).not()) { li.is_heap = true }
                case .FCall:
                    if fcall_returns_dynamic_storage(li_rhs, scope) { li.is_heap = true }
                    if type_is_callable_storage(b.type).and(b.own_type.is(OwnType.Ref).not()) { li.is_heap = true }
                case:
                }
                if rhs_is_allocator_call(li_rhs).and(b.type.is(Type.Dynamic).not()) {
                    // Typed local from a raw allocator: an owned heap
                    // block the pass frees itself (see LocalInfo.raw_alloc).
                    li.raw_alloc = true
                    li.is_heap = true
                }
            }
        }
        locals_vec.push(own li)
    }
}

// #320: true when `e` is an enum-variant ctor FCall whose variant carries a
// ref payload; returns the payload arg's root Ident name ("" otherwise).
// Matches both the ns FieldAccess callee (`Opt.Some(x)`) and the flattened
// Ident callee (`Opt_Some(x)`).
priv enum_ref_payload_borrow_src := func(e: Expr, scope: TypeScope) returns Str {
    if e.node_type.is(NodeType.FCall).not() { return "" }
    if e.children.len() != 2 { return "" }
    // Cheap tag-only gates first: this predicate runs on every FCall of
    // every body, and til_type_name below builds a Str. A variant ctor's
    // result type is always Type.Enum, and only an Ident or field-chain
    // arg can name a local to extend (the typer rejects temporaries).
    if e.til_type().is(Type.Enum).not() { return "" }
    switch e.children[1].node_type {
    case .Ident, .FieldAccess:
    case: return ""
    }
    ename_o := expr_type_name_ref(e)
    if ename_o.is_none() { return "" }
    ref ename : Str = ename_o.unwrap()
    mut vname := ""
    switch e.children[0].node_type {
    case .Ident(ci):
        prefix := format(ename, "_")
        if ci.ident_name().starts_with(prefix) {
            vname = ci.ident_name().substr(prefix.len(), ci.ident_name().len() - prefix.len())
        }
    case .FieldAccess(cf):
        vname = Str.clone(cf.field_access_name())
    case:
    }
    if vname.len() == 0 { return "" }
    def_o := scope.get_struct(ename)
    if def_o.is_none() { return "" }
    ref def : Expr = def_o.unwrap()
    if def.node_type.is(NodeType.EnumDef).not() { return "" }
    idx := enum_variant_index(def, vname)
    if idx < 0 { return "" }
    if enum_variant_payload_ref(def, idx).not() { return "" }
    // The borrowed source is the payload arg's ROOT binding: a bare Ident,
    // or the root of a field chain (`Opt.SomeRef(s.field)` borrows into s).
    return expr_root_ident_name(e.children[1])
}

// Root Ident name of an Ident / field-chain expr; "" for anything else.
priv expr_root_ident_name := func(e: Expr) returns Str {
    switch e.node_type {
    case .Ident(an): return Str.clone(an.ident_name())
    case .FieldAccess:
        if e.children.len() > 0 { return expr_root_ident_name(e.children[0]) }
    case:
    }
    return ""
}

// #302 stage 3: borrow edges, consolidated. extend_ref_local_lifetimes
// used to interleave its lifetime rules inside one hand-rolled
// fixpoint; they are now COLLECTED once as explicit borrower->owner
// edges and solved by one max-propagation. The rules (unchanged
// semantics -- max-lattice fixpoints are order-independent, so the
// final last_use values are identical by construction):
//   1. FieldAssign to a Ref field (`holder.f = src`): src must outlive
//      any later access of holder; without aliasing analysis the bound
//      is END OF BODY (borrows propagate through shallow clones of the
//      holder).
//   2. Ref-capturing closures (FuncDef/BodyValue capture lists): each
//      ref-captured local lives as long as the closure binding.
//   3. `ref x := src` / `ref x := src.field` / `ref x := f(args)`:
//      the borrow source (the FieldAccess root / each non-transferred
//      FCall arg's ident root) lives as long as x's reach -- x's last
//      textual use after its decl, max'd with x's own (possibly
//      extended) last_use.
//   4. #320: an enum-variant ctor with a ref payload borrows its arg
//      into the enum value (`o := Opt.Some(src)`): src stays alive
//      through scope exit, the same conservative bound as rule 1.
priv GcBorrowEdge := struct {
    owner := ""
    // "" for a body-end edge (rule 1); otherwise the borrower binding
    // whose current last_use joins the reach.
    borrower := ""
    fixed_reach : I32 = -1
}

priv gc_add_borrow_edge := func(mut edges: Vec(GcBorrowEdge), owner: Str, borrower: Str, fixed_reach: I32) {
    mut e := GcBorrowEdge(fixed_reach = fixed_reach)
    e.owner = owner.clone()
    e.borrower = borrower.clone()
    edges.push(own e)
}

// Rule 4's collector: walk a statement subtree adding a body-end edge
// for every local borrowed into an enum ref payload.
priv collect_enum_ref_payload_edges := func(e: Expr, body_last: I32, mut edges: Vec(GcBorrowEdge), scope: TypeScope) {
    // Tag-only pre-gate: borrow_src constructs and returns a Str, so
    // calling it per NODE paid a build+delete on every miss. Only a
    // two-child FCall can be a variant ctor (borrow_src re-checks).
    if e.node_type.is(NodeType.FCall).and(e.children.len() == 2) {
        src_name := enum_ref_payload_borrow_src(e, scope)
        if src_name.len() > 0 {
            gc_add_borrow_edge(edges, src_name, "", body_last)
        }
    }
    for c : Expr in e.children {
        collect_enum_ref_payload_edges(c, body_last, edges, scope)
    }
}

priv collect_borrow_edges := func(body: Expr, scope: TypeScope, facts: BodyFacts, fi: FactIndex) returns Vec(GcBorrowEdge) {
    mut edges := Vec(GcBorrowEdge).new()
    body_last := body.children.len().sub(1).to_i32()
    // Rule 1: FieldAssign into a Ref field. Rule 4: enum ref payloads
    // anywhere in the statement subtree.
    for stmt : Expr in body.children {
        collect_enum_ref_payload_edges(stmt, body_last, edges, scope)
        if stmt.node_type.is(NodeType.FieldAssign).not() { continue }
        if stmt.fa_own_type(scope).is(OwnType.Ref).not() { continue }
        if stmt.children.len() < 2 { continue }
        ref mut target : Expr = stmt.children[0]
        while target.node_type.is(NodeType.FieldAccess).and(target.children.len().gt(0)) {
            target = target.children[0]
        }
        mut holder_name := ""
        switch target.node_type {
        case .Ident(hn): holder_name = Str.clone(hn.ident_name())
        case:
        }
        if holder_name.len() == 0 { continue }
        ref value : Expr = stmt.children[1]
        switch value.node_type {
        case .Ident(sn):
            gc_add_borrow_edge(edges, sn.ident_name(), "", body_last)
        case:
        }
    }
    for i in 0..body.children.len() {
        ref stmt : Expr = body.children[i]
        if stmt.node_type.is(NodeType.Decl).not() { continue }
        mut dd_name := ""
        mut dd_is_ref := false
        switch stmt.node_type {
        case .Decl(dd):
            dd_name = dd.name.clone()
            dd_is_ref = dd.own_type.is(OwnType.Ref)
        case:
        }
        if stmt.children.len() > 0 {
            // Rule 2: ref captures live as long as the closure binding.
            switch stmt.children[0].node_type {
            case .FuncDef(fd):
                for cap : Declaration in fd.captures {
                    if cap.own_type.is(OwnType.Ref).not() { continue }
                    gc_add_borrow_edge(edges, cap.name, dd_name, i.to_i32())
                }
            case .BodyValue(bd):
                for cap : Declaration in bd.captures {
                    if cap.own_type.is(OwnType.Ref).not() { continue }
                    gc_add_borrow_edge(edges, cap.name, dd_name, i.to_i32())
                }
            case:
            }
        }
        if dd_is_ref.not() { continue }
        // Rule 3: the ref's reach = its last textual use after the decl
        // (at least the decl itself); the borrower term joins the ref's
        // own extended last_use during propagation.
        mut ref_last : I32 = -1
        ddbit := fact_bit_req(fi, dd_name)
        for j in i.add(1)..body.children.len() {
            if fact_bit_test(facts.uses, j.mul(facts.words), ddbit) {
                ref_last = j.to_i32()
            }
        }
        if ref_last == -1 { ref_last = i.to_i32() }
        ref mut rhs : Expr = stmt.children[0]
        switch rhs.node_type {
        case .Ident(src_name):
            gc_add_borrow_edge(edges, src_name.ident_name(), dd_name, ref_last)
            continue
        case:
        }
        if rhs.node_type.is(NodeType.FieldAccess) {
            ref mut root : Expr = rhs
            while root.node_type.is(NodeType.FieldAccess).and(root.children.len().gt(0)) {
                root = root.children[0]
            }
            switch root.node_type {
            case .Ident(src_name):
                gc_add_borrow_edge(edges, src_name.ident_name(), dd_name, ref_last)
            case:
            }
            continue
        }
        if rhs.node_type.is(NodeType.FCall).not() { continue }
        for a in 1..rhs.children.len() {
            // An own arg moved into the callee cannot back the returned ref
            // through its caller-side local. keep_outer marks destructor
            // calls that retain the outer shell, so those remain borrowers.
            if get_own_arg(rhs, a).and(get_keep_outer_arg(rhs, a).not()) { continue }
            ref mut arg : Expr = rhs.children[a]
            while arg.node_type.is(NodeType.FieldAccess).and(arg.children.len().gt(0)) {
                arg = arg.children[0]
            }
            switch arg.node_type {
            case .Ident(aname):
                gc_add_borrow_edge(edges, aname.ident_name(), dd_name, ref_last)
            case:
            }
        }
    }
    return edges
}

priv propagate_borrow_edges := func(edges: Vec(GcBorrowEdge), mut locals: Vec(LocalInfo)) {
    mut changed := true
    while changed {
        changed = false
        for e : GcBorrowEdge in edges {
            mut reach := e.fixed_reach
            if e.borrower.len() > 0 {
                for bl : LocalInfo in locals {
                    if bl.name.eq(e.borrower).and(bl.last_use.gt(reach)) {
                        reach = bl.last_use
                    }
                }
            }
            for mut local : LocalInfo in locals {
                if local.name.eq(e.owner).and(local.last_use.lt(reach)) {
                    local.last_use = reach
                    changed = true
                }
            }
        }
    }
}

priv extend_ref_local_lifetimes := func(body: Expr, mut locals: Vec(LocalInfo), scope: TypeScope, facts: BodyFacts, fi: FactIndex) {
    edges := collect_borrow_edges(body, scope, facts, fi)
    propagate_borrow_edges(edges, locals)
}

// Issue #250: a view binding (a Decl whose initializer reads a local's heap
// buffer, e.g. `arg.substr(...)` -- a `hoisted__` temp or, since the #258
// follow-up, a user-named local like `mut v := src.substr(0, n)`) keeps
// that local's buffer live until the binding is consumed -- typically by a
// later `.clone()`. The local's last *named* mention is the view-producing
// statement, so without this the asap pass schedules the local's
// auto-delete right there, BEFORE the clone copies from the view: a
// use-after-free that corrupts the clone (garbage bytes). This is the
// cross-variable generalization of #238, whose collect_hoist_taint /
// var_aliases_target machinery only handled the case where the view
// aliases the *assign target*.
//
// Fix idea #2 from the issue: treat a use of a hoisted view as a use of its
// backing local. Taint the hoisted temps that (transitively) read the local,
// then extend the local's last_use to the last statement that consumes any
// such temp. Deferring an owned local's delete is always memory-safe, so the
// (slightly over-eager) transitive taint -- which also follows clone results
// that no longer alias the buffer -- only pushes the delete a touch later.
priv extend_hoist_view_lifetimes := func(body: Expr, mut locals: Vec(LocalInfo), facts: BodyFacts, fi: FactIndex) {
    // #302 stage 3: the taint rule expressed as borrow edges on the
    // same machinery as rules 1-3 (collect_borrow_edges). Discovery is
    // unchanged (collect_hoist_taint's transitive initializer-read
    // walk); the extension is one edge per owner whose reach is the
    // last statement consuming any tainted binding. Kept as a separate
    // application AFTER the use-after-transfer check on purpose: an
    // over-eager taint must not spuriously flag a transfer (see the
    // call site).
    mut edges := Vec(GcBorrowEdge).new()
    for local : LocalInfo in locals {
        if local.name.starts_with("hoisted__") { continue }
        mut tmask := zeroed_words(facts.words)
        tainted := collect_hoist_taint(fact_bit_req(fi, local.name).to_i64(), facts, facts.n_stmts, tmask)
        if tainted.len() == 0 { continue }
        // #350: a borrow can move INTO a binding a def-less statement
        // mutates. The varargs desugaring is the canonical shape: the
        // hoisted view lands in its _va_Array via Array.set, which
        // defines nothing, so collect_hoist_taint's def-only walk
        // stopped at the set and view_last below missed that the ARRAY
        // now carries the borrow until format() consumes it -- the
        // owner's delete landed between the two, and the emitted C
        // read the view out of freed storage. Close the mask over
        // use-sites instead: any statement touching a tainted binding
        // taints everything it touches. Over-taint stays in this
        // design's safe direction (it can only defer the owner's
        // delete), same argument as the clone-following note on
        // collect_hoist_taint.
        mut spreading := true
        while spreading {
            spreading = false
            for j in 0..body.children.len() {
                if facts.directives.unsafe_get(j) { continue }
                base := j.mul(facts.words)
                if fact_row_intersects(facts.uses, base, tmask, facts.words).not() { continue }
                for w in 0..facts.words {
                    merged : U64 = facts.uses.unsafe_get(base + w).bor(tmask.unsafe_get(w))
                    if merged != tmask.unsafe_get(w) {
                        tmask.unsafe_set(w, own merged)
                        spreading = true
                    }
                }
            }
        }
        mut view_last : I32 = -1
        for j in 0..body.children.len() {
            if facts.directives.unsafe_get(j) { continue }
            // Any tainted binding used here? One row intersection
            // replaces the per-tainted-name probes.
            if fact_row_intersects(facts.uses, j.mul(facts.words), tmask, facts.words) { view_last = j.to_i32() }
        }
        if view_last >= 0 { gc_add_borrow_edge(edges, local.name, "", view_last) }
    }
    propagate_borrow_edges(edges, locals)
}

// A while body that can transfer `name` on an iteration -- i.e. the
// transfer may re-run. Two exemptions keep this an errors-only check
// under the index model:
//   - a spine containing a direct Break or Return executes at most once
//     in full, so its transfer cannot re-run (Continue does NOT exempt:
//     `{ consume(own s); continue }` still re-runs);
//   - a nested While's condition and spine re-run, so they are checked
//     recursively.
//
// #364: an If/Switch-guarded transfer used to be exempt, on the theory
// that the guard might hold for exactly one iteration -- which the
// desugarer's splat push (`for j { if ji == vi { push(own splat) } }`)
// really did. Nothing static can tell that apart from a guard that holds
// on every iteration, and BOTH ways of being wrong were live: the
// non-transferring iterations got no cleanup at all (a leak only ASAN
// saw), and a guard true twice freed the same buffer twice. The splat
// push was the only site in the compiler relying on the exemption and is
// now written straight-line, so the guard no longer buys anything.
priv while_spine_transfers := func(wbody: Expr, name: Str, scope: TypeScope, ctx: Context) returns Bool {
    for sp : Expr in wbody.children {
        if sp.node_type.is(NodeType.Break).or(sp.node_type.is(NodeType.Return)) { return false }
    }
    for sp : Expr in wbody.children {
        switch sp.node_type {
        case .If, .Switch:
            if expr_transfers_own(sp, name, scope, ctx) { return true }
            continue
        case .While:
            if expr_transfers_own(sp.children[0], name, scope, ctx) { return true }
            if while_spine_transfers(sp.children[1], name, scope, ctx) { return true }
            continue
        case .Body:
            if while_spine_transfers(sp, name, scope, ctx) { return true }
            continue
        case:
        }
        if expr_transfers_own(sp, name, scope, ctx) { return true }
    }
    return false
}

// `stmt` contains a loop whose re-running part transfers ownership of
// `name`. The single own_transfer index cannot represent "the transfer
// statement can execute twice", so without this check a transfer inside
// a while of a binding declared outside it compiles into C whose second
// iteration consumes an already-freed value (verified: silent
// heap-use-after-free).
priv transfer_inside_loop := func(stmt: Expr, name: Str, scope: TypeScope, ctx: Context) returns Bool {
    if stmt.node_type.is(NodeType.While) {
        if expr_transfers_own(stmt.children[0], name, scope, ctx) { return true }
        return while_spine_transfers(stmt.children[1], name, scope, ctx)
    }
    for tc : Expr in stmt.children {
        if transfer_inside_loop(tc, name, scope, ctx) { return true }
    }
    return false
}

// True when a transfer of `name` sits lexically under ANY While inside
// `e` -- cond or body, conditional or not. Grafting per-path deletes
// there double-frees: the transfer belongs to a DIFFERENT iteration than
// the grafted path, so the delete would free a value a later iteration
// still needs. Per-iteration locals never hit this: their graft view is
// the loop body itself, where no While wraps the transfer.
//
// #364 rejects most of what used to reach here. What still does is the
// rebind-then-transfer pattern the diagnostic exempts by
// expr_reassigns_var -- a loop that reassigns the binding before
// transferring it owns a fresh value each iteration, so there is no
// use-after-move to report and no static path for a graft either.
priv transfer_lex_inside_while := func(e: Expr, name: Str, scope: TypeScope, ctx: Context) returns Bool {
    if e.node_type.is(NodeType.While) {
        return expr_transfers_own(e, name, scope, ctx)
    }
    for c : Expr in e.children {
        if transfer_lex_inside_while(c, name, scope, ctx) { return true }
    }
    return false
}

priv expr_reassigns_var := func(e: Expr, name: Str) returns Bool {
    switch e.node_type {
    case .Assign(ad):
        if ad.name == name { return true }
    case:
    }
    for rc : Expr in e.children {
        if expr_reassigns_var(rc, name) { return true }
    }
    return false
}

priv check_use_after_own_transfer := proc(mut body: Expr, mut locals: Vec(LocalInfo), scope: TypeScope, mut ctx: Context) {
    for mut local : LocalInfo in locals {
        if local.own_transfer.gte(0).and(local.last_use.gt(local.own_transfer)) {
            // #302 stage 3: path-sensitive. When every path reaching the
            // use still owns the binding -- the transfer paths diverged
            // (returned) before rejoining, e.g. `switch n { case 1:
            // return f(own s) case: ... }; use s` -- the use is valid.
            // Clear the transfer so the local gets ordinary owned-local
            // cleanup on the surviving paths: suppressing the error
            // alone LEAKED (the index model's transfer stand-down left
            // the fall-through with no delete, verified 2026-07-11).
            if gc_flow_owned_at_stmt(body, local, scope, ctx, local.last_use) {
                // #364: clearing the transfer hands the local ordinary
                // cleanup on the paths that still own it -- but a
                // SHALLOW-field ctor arg leaves an orphaned wrapper on the
                // path that DID transfer, and that knowledge dies with the
                // record. insert_post_stmt_deletes is gated on
                // own_transfer >= 0, so nothing frees it: 16 bytes per call,
                // which is what the ownership-shape matrix's own-param row
                // caught. Graft the wrapper free onto the transferring path
                // before the record goes.
                if local.shallow_copy_transfer {
                    ref mut xfer_stmt : Expr = body.children[local.own_transfer.to_usize()]
                    sink_transfer_path_wrapper_free(xfer_stmt, local, scope, ctx)
                }
                // #368: the surviving path may transfer TOO. The record
                // holds ONE transfer index, so clearing it to -1 here used
                // to say "never transferred" and hand the local an ordinary
                // exit delete -- emitted at last_use, which in that case IS
                // the second transfer statement. The result was a delete of
                // a value handed away on the line above: not a leak but a
                // use-after-transfer, and since #364 removed the loud
                // double-free it corrupted silently instead.
                //
                // So look for the next transfer on the surviving path
                // rather than dropping to -1, and re-derive the flags that
                // belong to whichever transfer now holds the record.
                mut next_xfer : I32 = -1
                for nj in local.own_transfer.add(1).to_usize()..body.children.len() {
                    if expr_transfers_own(body.children[nj], local.name, scope, ctx) {
                        next_xfer = nj.to_i32()
                        break
                    }
                }
                local.own_transfer = next_xfer
                local.dtor_transfer = false
                if next_xfer >= 0 {
                    local.dtor_transfer = transfer_is_destructor_call(body.children[next_xfer.to_usize()], local.name)
                    local.shallow_copy_transfer = transfer_is_shallow_field_value_copy(body.children[next_xfer.to_usize()], local.name, scope)
                }
            } else {
                ref stmt : Expr = body.children[local.last_use.to_usize()]
                stmt.type_error(format("use of '", local.name, "' after ownership transfer"), ctx)
                ref xfer : Expr = body.children[local.own_transfer.to_usize()]
                println(ctx.path, ":", xfer.line.to_str(), ":", xfer.col.to_str(), ": note: ownership transferred here")
                println("  help: pass a clone instead: own ", local.name, ".clone()")
            }
        }
        // #302: a transfer inside a loop, of a binding declared outside the
        // loop, may run on every iteration -- the second one moves an
        // already-moved value.
        //
        // #365: a loop that also REASSIGNS the binding used to be exempt,
        // read as the legitimate rebind-then-transfer pattern. It is not
        // legitimate as compiled: the assign's save_old_delete frees the
        // old value unconditionally, so it frees what the previous
        // iteration's transfer already freed -- a double free in all four
        // orderings of rebind and transfer, which the interpreter did not
        // reproduce because it tracks moved-ness at runtime. Nothing
        // static can stand in for that flag here: with a loop back edge
        // the binding is owned on the first iteration and moved on the
        // rest, so the assign would need a runtime test to know whether
        // to free. Rejecting says so, and `declare it inside the loop`
        // is the rewrite every correct version of this wanted anyway.
        //
        // Aggregates only: a primitive `own` transfer copies, so there is
        // nothing to double-free, and the Array index-assign in this very
        // file (`table[i] = cur`) reads as a transfer of a U8.
        if local.own_transfer.gte(0).and(is_aggregate(local.type)) {
            ref xstmt : Expr = body.children[local.own_transfer.to_usize()]
            if transfer_inside_loop(xstmt, local.name, scope, ctx) {
                xstmt.type_error(format("ownership of '", local.name,
                    "' transferred inside a loop; a second iteration would use a moved value"), ctx)
                println("  help: declare '", local.name, "' inside the loop, or pass a clone: own ", local.name, ".clone()")
            }
        }
    }
}

priv insert_exit_deletes := proc(mut body: Expr, mut live: Vec(LocalInfo), return_only: Bool, scope: TypeScope, ctx: Context) {
    // Quick check: any returns/breaks/continues or nested if/while/body?
    // has_exit tracks the narrower question the flow table needs: does
    // an exit occur at THIS view's top level (deeper ones are handled
    // by the recursive calls, each with its own table).
    mut needs_scan := false
    mut has_exit := false
    for s : Expr in body.children {
        if s.node_type.is(NodeType.Return).or(return_only.not().and(s.node_type.is(NodeType.Break).or(s.node_type.is(NodeType.Continue)))) {
            needs_scan = true
            has_exit = true
            break
        }
        if s.node_type.is(NodeType.If).or(s.node_type.is(NodeType.While)).or(s.node_type.is(NodeType.Body)).or(s.node_type.is(NodeType.Switch)) {
            needs_scan = true
        }
    }
    if needs_scan.not() { return }

    // Built here, while body.children is still populated: the CFG
    // indexes into it and the move_from below empties it. Every caller
    // of this proc passes a NESTED view whose live locals are all
    // declared in an enclosing body (insert_nested_exit_deletes filters
    // on decl_index < stmt_idx), so they enter the view Owned -- the
    // same assumption the positional scan this replaces made implicitly
    // by only looking at preceding siblings within the view.
    flow_table := gc_flow_stmt_table(body, live, FLOW_OWNED, has_exit, scope, ctx)

    mut old := body.children.take()

    mut new_ch := Vec(Expr).new()
    for i in 0..old.len() {
        ref mut stmt : Expr = old[i]
        if is_compile_directive(stmt) { continue }
        if stmt.node_type.is(NodeType.If) {
            for c in 1..stmt.children.len() {
                insert_exit_deletes(stmt.children[c], live, return_only, scope, ctx)
            }
        }
        if stmt.node_type.is(NodeType.While) {
            insert_exit_deletes(stmt.children[1], live, true, scope, ctx)
        }
        if stmt.node_type.is(NodeType.Body) {
            insert_exit_deletes(stmt, live, return_only, scope, ctx)
        }
        if stmt.node_type.is(NodeType.Switch) {
            for ci in 1..stmt.children.len() {
                if stmt.children[ci].node_type.is(NodeType.Case) {
                    cbi := stmt.children[ci].children.len() - 1
                    insert_exit_deletes(stmt.children[ci].children[cbi], live, return_only, scope, ctx)
                }
            }
        }
        if stmt.node_type.is(NodeType.Return).or(return_only.not().and(stmt.node_type.is(NodeType.Break).or(stmt.node_type.is(NodeType.Continue)))) {
            for li in 0..live.len() {
                ref local : LocalInfo = live[li]
                if stmt.children.len() > 0 {
                    ref retval : Expr = stmt.children[0]
                    if expr_uses_var(retval, local.name) {
                        continue
                    }
                }
                // #302 stage 3: the DATAFLOW says whether this exit still
                // owns the local. Moved on every path reaching it means
                // the value is already consumed -- the shape the
                // return-operand exclusion above misses once the typer
                // has hoisted the transferring call into its own decl
                // (`hoisted := f(own s); return hoisted`), and
                // load-bearing for diverged transfers (own_transfer
                // cleared by the path-sensitive use check): without it
                // the nested return right after the hoisted transfer
                // re-deleted the consumed local (ASAN heap-use-after-
                // free, probed). Unreached means no path gets here at
                // all (statements after a terminator), so there is
                // nothing to free either.
                //
                // This replaces a positional scan of the preceding
                // siblings for an unconditional transfer, which
                // approximated the same question by statement order and
                // had to skip compound siblings wholesale to stay sound
                // (a transfer inside one branch of an earlier if is
                // CONDITIONAL, and suppressing the delete on the
                // fall-through leaked). The lattice draws that
                // distinction itself: such a branch meets to Mixed, not
                // Moved.
                mut st : U8 = FLOW_UNREACHED
                st = flow_table[li.mul(old.len()).add(i)]
                if st.eq(FLOW_OWNED).not() { continue }
                // #302 stage 2: exit deletes are always PRECEDING statements,
                // never Return children. The garbager already excludes any
                // local used (or aliased) by the return operand above, so
                // running the deletes just before the Return is
                // order-equivalent to the old capture-then-delete-then-return
                // shape -- and it makes Return a CFG leaf (a stage-3
                // precondition) that the builder emits without the per-shape
                // `{ T _ret = <expr>; <deletes>; return _ret; }` wrapper.
                if local.raw_alloc.not().and(type_to_name(local.type).len().gt(0)) {
                    del_o := gc_make_delete(local, stmt)
                    if del_o.is_some() { new_ch.push(own Option(Expr).take(own del_o)) }
                } else if local.is_heap {
                    del := make_free_call(local.name, local.type, stmt)
                    new_ch.push(own del)
                }
            }
        }
        new_ch.push_take(old, i)
    }
    body.children.move_from(own new_ch)
}

priv insert_nested_exit_deletes := proc(mut stmt: Expr, locals: Vec(LocalInfo), stmt_idx: USize, root_flow: Array(U8), root_stmts: USize, scope: TypeScope, ctx: Context) {
    if stmt.node_type.is(NodeType.If).not() {
        if stmt.node_type.is(NodeType.While).not() {
            if stmt.node_type.is(NodeType.Body).not() {
                if stmt.node_type.is(NodeType.Switch).not() { return }
            }
        }
    }
    mut live_vec := Vec(LocalInfo).new()
    for li in 0..locals.len() {
        ref local : LocalInfo = locals[li]
        if local.skip_scope_delete { continue }
        // An own param whose transfer is its own destructor call (a
        // delete method's `if call_free { free(own self) }`) stands
        // down wholesale: an extra delete double-frees -- the same
        // exclusion sink_conditional_transfer_deletes uses. That is a
        // fact about WHAT the transfer is, not about where it sits, so
        // it stays outside the flow.
        if local.own_transfer.gte(0).and(local.decl_index.lt(0)).and(local.dtor_transfer) { continue }
        // #302 stage 3: the state on entry to THIS statement decides
        // whether the binding is the nested view's business, replacing
        // two positional gates that approximated it by statement order.
        // `own_transfer <= stmt_idx` stood the local down once the
        // transfer was at or before this statement -- a transfer only
        // consumes the local on paths that REACH it, which is Moved;
        // an exit inside a statement strictly before it still owns the
        // value (the parser's last_field: consumed by a ctor in the
        // final statement, leaked by earlier `return mcall` paths).
        // `decl_index < stmt_idx` is Uninit. Unreached means no path
        // arrives here at all.
        //
        // MIXED stands down too, and that is not conservatism -- it is
        // the only sound answer. An exit delete is UNCONDITIONAL code on
        // whatever path reaches it, so emitting one where some paths
        // still own the binding and others already moved it double-frees
        // the moved ones. Only "owned on EVERY path" licenses the free;
        // the partial-transfer case is the sink's job, which grafts
        // per-path deletes instead. (Landed without this in d2f1ae0: the
        // constfolder's `arg_raw`, conditionally consumed by
        // `EvalHeap.heap_free(own arg_raw)` and then read past an early
        // `return NULL`, got a `free(arg_raw)` on that exit -- a double
        // free on the prim path. Latent, since nothing in the suite
        // reaches that return, and invisible because the pass-diff
        // referee used to compare the wrong files.)
        mut st : U8 = FLOW_UNREACHED
        st = root_flow[li.mul(root_stmts).add(stmt_idx)]
        if st.eq(FLOW_OWNED).not() { continue }
        if local.last_use.gte(stmt_idx.to_i32()).or(local.last_use.eq(-1)) {
            live_vec.push(own local.clone())
        }
    }
    if live_vec.len() > 0 {
        switch stmt.node_type {
        case .If:
            for c in 1..stmt.children.len() {
                insert_exit_deletes(stmt.children[c], live_vec, false, scope, ctx)
            }
        case .While:
            insert_exit_deletes(stmt.children[1], live_vec, true, scope, ctx)
        case .Switch:
            // #254: an un-desugared C-like switch. break/continue inside a
            // case exit the enclosing loop, so live outer locals need cleanup
            // on those edges -- pass return_only=false like the Body arm.
            for ci in 1..stmt.children.len() {
                if stmt.children[ci].node_type.is(NodeType.Case) {
                    cbi := stmt.children[ci].children.len() - 1
                    insert_exit_deletes(stmt.children[ci].children[cbi], live_vec, false, scope, ctx)
                }
            }
        case:
            // NodeType.Body -- a plain block: a desugared for-in wrapper
            // (its decls + while), the lowered form of a switch/match
            // (infer_switch_stmt emits an if/elif chain inside a Body), or a
            // bare `{ }` scope. break/continue inside such a Body are NOT
            // captured here (only a nested While captures them, and that
            // While is recursed into with return_only=true on its own), so
            // those edges exit the enclosing loop and must free this scope's
            // live locals. Pass return_only=false so they get cleanup; a
            // for-in wrapper has no Body-level break/continue, so this is a
            // no-op for that shape.
            insert_exit_deletes(stmt, live_vec, false, scope, ctx)
        }
    }
}

priv insert_exit_deletes_into_stmt := func(stmt: Expr, locals: Vec(LocalInfo), stmt_idx: USize, root_flow: Array(U8), root_stmts: USize, mut new_ch: Vec(Expr)) {
    if stmt.node_type.is(NodeType.Return).not() {
        if stmt.node_type.is(NodeType.Break).not() {
            if stmt.node_type.is(NodeType.Continue).not() { return }
        }
    }
    for li in 0..locals.len() {
        ref local : LocalInfo = locals[li]
        if stmt.children.len() > 0 {
            ref retval : Expr = stmt.children[0]
            if expr_uses_var(retval, local.name) {
                continue
            }
        }
        if local.skip_scope_delete { continue }
        // Destructor-transferred own params keep the full stand-down
        // (see the dtor_transfer comment on LocalInfo): the body's field
        // deletes already ran, so a second one double-frees. That is a
        // fact about WHAT the transfer is, not where it sits, so it
        // stays outside the flow.
        if local.own_transfer.gte(0).and(local.decl_index.lt(0)).and(local.dtor_transfer) { continue }
        // #302 stage 3: the same two index gates insert_nested_exit_
        // deletes retired, on the same root-body table -- Moved for
        // `own_transfer <= stmt_idx` (an exit at a statement strictly
        // before the transfer still OWNS the local, which is why the
        // positional form had to compare rather than just test), Uninit
        // for `decl_index < stmt_idx`, and Unreached for a statement no
        // path arrives at. Mixed stands down for the same reason as
        // there: an unconditional free where only some paths still own
        // the binding double-frees the others.
        mut st : U8 = FLOW_UNREACHED
        st = root_flow[li.mul(root_stmts).add(stmt_idx)]
        if st.eq(FLOW_OWNED).not() { continue }
        if local.last_use.gte(stmt_idx.to_i32()).or(local.last_use.eq(-1)) {
            if local.raw_alloc.not().and(type_to_name(local.type).len().gt(0)) {
                del_o := gc_make_delete(local, stmt)
                if del_o.is_some() { new_ch.push(own Option(Expr).take(own del_o)) }
            } else if local.is_heap {
                del := make_free_call(local.name, local.type, stmt)
                new_ch.push(own del)
            }
        }
    }
}

priv insert_post_stmt_deletes := func(ctx: Context, mut stmt: Expr, locals: Vec(LocalInfo), stmt_idx: USize, mut new_ch: Vec(Expr), scope: TypeScope, preceding: Vec(Expr)) {
    if stmt.node_type.is(NodeType.Return).or(stmt.node_type.is(NodeType.Break)).or(stmt.node_type.is(NodeType.Continue)) {
        return
    }
    for local : LocalInfo in locals {
        if local.skip_scope_delete { continue }
        if local.own_transfer >= 0 {
            // Ownership transferred via value-copy to a Shallow struct field
            // (e.g. `Decl(name = local, ...)` where Declaration.name has the
            // default Shallow ownership) leaves the local's heap wrapper
            // orphaned: the field gets a bit-copy of *local, the field's own
            // destructor frees the inner data, but nothing frees the wrapper.
            // Skipping the delete entirely (the previous behavior) leaks the
            // wrapper. Emit a raw `free(local)` after the transfer stmt to
            // release the wrapper without touching the inner data.
            //
            // This only fires when the transfer is a struct constructor with
            // the receiving field declared Shallow. Other transfer shapes
            // (`free(own X)`, `Type.delete(own X, ...)`, `field = X` where the
            // field is Own/Ref, passing X as `own` arg to a function that
            // takes ownership of the wrapper) already consume the wrapper, so
            // adding a `free` here would double-free.
            //
            // REM (#258 audit): this branch is view-safe as-is -- freeing the
            // WRAPPER of a view local touches neither the viewed buffer nor
            // the field's copy. But the audited scenario (`h := Holder(s =
            // v)` where `v := src.substr(...)`) shows the TRANSFER itself
            // stores the borrow in the field, which dangles once src dies.
            // That is constructor/field transfer semantics (no clone exists
            // to preserve), not a garbager decision; a fix needs a language
            // -level call (runtime clone-if-view on Str field transfers, or
            // a diagnostic) and is out of scope here.
            // #302 stage 6: a CALLABLE local (funcptr / Body closure box)
            // transferred at this statement is consumed by the receiver --
            // the ctor moves the box POINTER into the field. is_aggregate
            // is false for callables, so without this the flow fell
            // through to the last-use delete below and emitted a
            // til_closure_delete on the box the field now owns (a
            // use-after-free the builder was masking with its swap_freed
            // defusing set). No wrapper free: a callable local IS the
            // pointer, there is no separate box to release.
            if local.own_transfer.eq(stmt_idx.to_i32()).and(heap_local_is_callable(local)) { continue }
            if local.is_heap.and(is_aggregate(local.type)) {
                if local.own_transfer == stmt_idx.to_i32() {
                    if local.raw_alloc.not().and(type_to_name(local.type).len().gt(0)) {
                        // Decl(field = local) where the receiving Shallow
                        // field value-copies the inner struct: the field's
                        // own destructor frees the inner data, but nothing
                        // would free the local's wrapper. Emit a raw
                        // `free(local)` after the transfer stmt to release
                        // the wrapper without touching the inner data.
                        if local.shallow_copy_transfer {
                            // #364: after the STATEMENT is only right when
                            // the transfer is unconditional. A ctor inside a
                            // branch makes this statement an if/switch whose
                            // other paths never transferred -- and already
                            // carry the sink's full delete -- so the wrapper
                            // free is grafted onto the transferring path
                            // instead. Falls back to the flat emission when
                            // no branch claims it (an unconditional ctor).
                            if sink_transfer_path_wrapper_free(stmt, local, scope, ctx).not() {
                                free_call := make_free_call(local.name, local.type, stmt)
                                new_ch.push(own free_call)
                            }
                        }
                    }
                }
            }
            continue
        }
        if local.last_use == stmt_idx.to_i32() {
            // #258: Str clone-args move only under provable ownership; any
            // other aggregate moves unconditionally (no view representation).
            // The Str move is additionally COMPILE-ONLY: it pairs a bare
            // field/assign store with a wrapper free, shaped for the C
            // backend's move semantics. The interpreter executes value
            // semantics with its own heap accounting, and running the
            // rewritten pair there leaks the moved buffer (caught by the
            // suite's ASAN interp run on test/bug258.til shape 5). The
            // interpreter gains nothing from the rewrite -- it is a pure
            // C-perf optimization -- so interp mode keeps the exact
            // clone+delete roundtrip instead.
            mut clone_to_move_ok := clone_arg_may_be_view(local).not()
            if clone_to_move_ok.not().and(ctx.compile_mode) {
                clone_to_move_ok = str_clone_to_move_provably_safe(local.name, preceding)
            }
            // FieldAssign with auto-cloned Ident RHS at the local's last use:
            // the clone allocates a deep copy, the field stores the copy, and
            // the local's contents would then be deleted by the normal
            // last_use destructor below -- a clone+delete roundtrip whose
            // intermediate allocation leaks its sub-pointers (Context_clone
            // via load_program, etc.). Replace clone(local) with bare local
            // so codegen emits a value-copy (`field = *local`), then free
            // only the heap wrapper. Only apply when stmt is the FieldAssign
            // itself (not a wrapping for/if -- last_use would point to the
            // outer stmt in that case, so this match implicitly excludes
            // loop/conditional bodies). Str moves only when its defs are
            // provably owning (clone_to_move_ok above, issue #258).
            if local.is_heap.and(is_aggregate(local.type)).and(clone_to_move_ok) {
                if stmt.node_type.is(NodeType.FieldAssign).and(stmt.children.len().gte(2)) {
                    ref fa_rhs : Expr = stmt.children[1]
                    if rhs_is_clone_fcall(fa_rhs).and(fa_rhs.children.len().gte(2)) {
                        ref clone_arg : Expr = fa_rhs.children[1]
                        switch clone_arg.node_type {
                        case .Ident(clone_arg_name):
                            if clone_arg_name.ident_name() == local.name {
                                // The marker IS the move now: the builder
                                // substitutes the clone's arg at consumption
                                // (emit_stmt's FieldAssign arm); the
                                // interpreter's value semantics make the
                                // kept clone equivalent. No AST edit.
                                switch stmt.node_type {
                                case .FieldAssign(fad_mv): fad_mv.is_move = true
                                case:
                                }
                                // A Shallow (value) field deref-copies the move
                                // source (`field = *local`), so the inner data
                                // transfers but the heap wrapper must still be
                                // freed. An Own (pointer) field instead moves the
                                // pointer itself into the field, which then owns
                                // the wrapper -- freeing it here would dangle the
                                // field (issue #256). Only emit the wrapper free
                                // for the value-field case.
                                if stmt.fa_own_type(scope).is(OwnType.Own).not() {
                                    free_call := make_free_call(local.name, local.type, stmt)
                                    new_ch.push(own free_call)
                                }
                                continue
                            }
                        case:
                        }
                    }
                }
            }
            // Plain Assign with auto-cloned Ident RHS at the local's last
            // use: `lhs = local.clone()` where `local` is a dying owned
            // aggregate. The typer (infer_assign_stmt) wraps the Ident RHS
            // in .clone() for value semantics, but at the local's last use
            // the clone is a wasteful copy whose deep allocations leak --
            // the original `local` is dropped by the scope-end delete right
            // after. Replace `local.clone()` with bare `local` so codegen
            // emits a pointer move into lhs, and skip local's scope-end
            // delete: ownership transfers wholesale to the assign target
            // (whose own save_old_delete already freed lhs's prior value).
            // Str moves only when its defs are provably owning
            // (clone_to_move_ok above, issue #258).
            if local.is_heap.and(is_aggregate(local.type)).and(clone_to_move_ok) {
                mut assign_saves_old := false
                switch stmt.node_type {
                case .Assign(adata): assign_saves_old = adata.save_old_delete
                case:
                }
                if stmt.node_type.is(NodeType.Assign).and(assign_saves_old).and(stmt.children.len().gte(1)) {
                    mut assign_target := ""
                    switch stmt.node_type {
                    case .Assign(adata2): assign_target = adata2.name
                    case:
                    }
                    ref assign_rhs : Expr = stmt.children[0]
                    // Guard against self-assign `e = e.clone()`: moving there
                    // would alias the just-deleted old value.
                    if assign_target.eq(local.name).not().and(rhs_is_clone_fcall(assign_rhs)).and(assign_rhs.children.len().gte(2)) {
                        ref clone_arg : Expr = assign_rhs.children[1]
                        switch clone_arg.node_type {
                        case .Ident(clone_arg_name):
                            // Issue #238: never move a clone-arg that is a
                            // hoisted view aliasing the assign target. The
                            // clone is what decouples `target = target.substr(
                            // ...).clone()` from target's own freed buffer;
                            // moving the view instead would alias the deleted
                            // old value.
                            if clone_arg_name.ident_name().eq(local.name) {
                                // Marker only -- see the FieldAssign site.
                                switch stmt.node_type {
                                case .Assign(adata_mv): adata_mv.is_move = true
                                case:
                                }
                                continue
                            }
                        case:
                        }
                    }
                }
            }
            if local.raw_alloc.not().and(type_to_name(local.type).len().gt(0)) {
                del_o := gc_make_delete(local, stmt)
                if del_o.is_some() { new_ch.push(own Option(Expr).take(own del_o)) }
            } else if local.is_heap {
                del := make_free_call(local.name, local.type, stmt)
                new_ch.push(own del)
            }
        }
        if local.last_use.eq(-1).and(local.decl_index.eq(stmt_idx.to_i32())) {
            if local.raw_alloc.not().and(type_to_name(local.type).len().gt(0)) {
                del_o := gc_make_delete(local, stmt)
                if del_o.is_some() { new_ch.push(own Option(Expr).take(own del_o)) }
            } else if local.is_heap {
                del := make_free_call(local.name, local.type, stmt)
                new_ch.push(own del)
            }
        }
    }
}

// #302 stage 4: the OUTER-scope save_old_delete decision, consolidated
// from the typer's infer_assign_stmt (the flag now has one writer pass:
// this file). An assign from a nested scope to an enclosing
// function-local that rebinds an owned aggregate must free the old
// value inline: the RHS shapes are a clone-wrapped ident / any
// own-returning call (both fcall_returns_own) or a Str literal rebind.
// Ref targets rebind a borrow, not a value, and globals outlive the
// body -- both excluded, matching the old typer rule. Runs for EVERY
// body -- including bodies with no locals of their own, which is where
// most outer-target assigns live (if branches, loop wrappers), and
// which insert_free_calls otherwise early-returns on.
priv flag_outer_assign_rebinds := func(mut body: Expr, locals: Vec(LocalInfo), mut scope: TypeScope) {
    for mut stmt : Expr in body.children {
        switch stmt.node_type {
        case .Assign(ad):
            vname := ad.name
            mut is_body_local := false
            for local : LocalInfo in locals {
                if local.name.eq(vname) { is_body_local = true }
            }
            if is_body_local.or(stmt.children.len().eq(0)) { continue }
            sf_out := scope.find(vname)
            switch sf_out {
            case .Found(ob):
                if is_aggregate(ob.type).and(ob.own_type.is(OwnType.Ref).not())
                    .and(assign_target_is_func_local(scope, vname)) {
                    ref orhs : Expr = stmt.children[0]
                    mut rebind := orhs.node_type.is_literal_str()
                    if rebind.not().and(orhs.node_type.is(NodeType.FCall)) {
                        rebind = fcall_returns_own(orhs, scope)
                    }
                    if rebind { ad.save_old_delete = true }
                }
            case:
            }
        case:
        }
    }
}

priv insert_assign_delete := func(mut stmt: Expr, locals: Vec(LocalInfo), mut new_ch: Vec(Expr), facts: BodyFacts, fi: FactIndex, stmt_idx: USize) {
    switch stmt.node_type {
    case .Assign(ad):
        vname := ad.name
        mut is_body_local := false
        for local : LocalInfo in locals {
            if local.name.eq(vname).not() { continue }
            is_body_local = true
            if is_aggregate(local.type) {
                if ad.save_old_delete {
                    return
                } else if rhs_depends_on_var(stmt.children[0], vname, fact_bit_req(fi, vname).to_i64(), facts, stmt_idx) {
                    ad.save_old_delete = true
                    stmt.set_til_type(local.type.clone())
                } else {
                    if local.raw_alloc.not().and(type_to_name(local.type).len().gt(0)) {
                        del_o := gc_make_delete(local, stmt)
                        if del_o.is_some() { new_ch.push(own Option(Expr).take(own del_o)) }
                    } else if local.is_heap {
                        del := make_free_call(local.name, local.type, stmt)
                        new_ch.push(own del)
                    }
                }
            }
            break
        }
        if is_body_local { return }
    case:
    }
}

// Asap entry point. The typer's scope-management sites call this
// once per body after the per-body in-place pass settles, just
// before they tear down the per-body scope. Issue #204 step 3b
// tracks lifting the per-site calls into a single garbager_destroy(ctx)
// walk in prepare_program once #158's per-body scope cache is in
// the Context.
priv stmt_is_conditional_container := func(stmt: Expr) returns Bool {
    return stmt.node_type.is(NodeType.If)
        .or(stmt.node_type.is(NodeType.While))
        .or(stmt.node_type.is(NodeType.Switch))
        .or(stmt.node_type.is(NodeType.Body))
}

priv add_delete_to_branch := proc(mut branch: Expr, local: LocalInfo, src: Expr, scope: TypeScope, ctx: Context) returns Bool {
    // Same emission split as the exit-delete inserters: a raw-allocator
    // local is a bare heap block (free, never a deep delete); everything
    // else typed goes through gc_make_delete.
    mut del_o := Option(Expr).None
    if local.raw_alloc.not().and(type_to_name(local.type).len().gt(0)) {
        del_o = gc_make_delete(local, src)
    } else if local.is_heap {
        del_o = Option(Expr).Some(make_free_call(local.name, local.type, src))
    }
    if del_o.is_none() { return false }
    del := Option(Expr).take(own del_o)
    // #302 stage 3: the graft lands at the END of the branch body, so any
    // exit INSIDE that body escapes it -- an early `return` nested in a
    // sibling branch of the transferring one left the local owned and
    // unfreed (ASAN: 26 bytes for `if k == 1 { return sink(own s) } else
    // { if k == 2 { return 7 } }`). The exit edges of this branch need
    // the same delete, which is exactly what insert_exit_deletes does
    // for a live local (and it already skips exits whose operand uses
    // the local, so a `return <local>` inside the branch is untouched).
    mut branch_live := Vec(LocalInfo).new()
    branch_live.push(own local.clone())
    insert_exit_deletes(branch, branch_live, false, scope, ctx)
    branch.add_child(own del)
    return true
}

// #364: the mirror of sink_nontransfer_paths, for the ONE cleanup that
// belongs on the transferring path instead of the others.
//
// A ctor arg into a SHALLOW field is a value-copy: the field's destructor
// frees the inner data, and the local's heap WRAPPER is left orphaned, so
// insert_post_stmt_deletes emits a bare `free(local)` to release it. That
// free is unconditional code placed after the transfer STATEMENT -- correct
// only when the transfer itself is unconditional. When the ctor sits in one
// branch, the statement is an `if`, and the same free then runs on paths
// that never transferred, where sink_nontransfer_paths has already grafted a
// full delete: the wrapper is freed twice (#364's double free, which glibc
// stopped reporting on 133ef49 while ASAN still called it a
// heap-use-after-free). Omitting it instead just moves the bug: the
// transferring path then leaks the wrapper -- 16 bytes per call, which is
// what the ownership-shape matrix caught on the own-param row.
//
// So it is grafted, not emitted after the statement: appended at the end of
// the branch that actually transfers, the same placement rule
// add_delete_to_branch uses for the paths that do not.
priv sink_transfer_path_wrapper_free := func(mut node: Expr, local: LocalInfo, scope: TypeScope, ctx: Context) returns Bool {
    if node.node_type.is(NodeType.If).or(node.node_type.is(NodeType.Switch)) {
        mut any := false
        mut ci : USize = 1
        while ci < node.children.len() {
            ref mut child : Expr = node.children[ci]
            ci++
            mut bi : USize = 0
            if child.node_type.is(NodeType.Case) {
                if child.children.len() == 0 { continue }
                bi = child.children.len() - 1
            }
            ref mut arm : Expr = child
            if child.node_type.is(NodeType.Case) { arm = child.children[bi] }
            if expr_transfers_own(arm, local.name, scope, ctx).not() { continue }
            if sink_transfer_path_wrapper_free(arm, local, scope, ctx) { any = true }
        }
        return any
    }
    if node.node_type.is(NodeType.Body).not() { return false }
    // Find the statement that actually transfers and put the free right
    // AFTER it. Not at the end of the branch: an arm that `return`s after
    // the ctor -- `if flag { h := Holder(s = s); return h.s.len() }`, the
    // own-param row of the matrix -- would leave the free unreachable
    // behind the return. Immediately after the transfer is also the
    // narrowest correct window: the local is consumed from there on.
    mut idx : USize = 0
    mut found := false
    while idx < node.children.len() {
        ref mut child : Expr = node.children[idx]
        if is_compile_directive(child).not() {
            if child.node_type.is(NodeType.If).or(child.node_type.is(NodeType.Switch)).or(child.node_type.is(NodeType.Body)) {
                if expr_transfers_own(child, local.name, scope, ctx) {
                    if sink_transfer_path_wrapper_free(child, local, scope, ctx) { return true }
                }
            } else if expr_transfers_own(child, local.name, scope, ctx) {
                found = true
                break
            }
        }
        idx++
    }
    if found.not() { return false }
    mut old := node.children.take()
    mut new_ch := Vec(Expr).new()
    for i in 0..old.len() {
        new_ch.push_take(old, i)
        if i == idx {
            free_call := make_free_call(local.name, local.type, node)
            new_ch.push(own free_call)
        }
    }
    node.children.move_from(own new_ch)
    return true
}

priv sink_nontransfer_paths := proc(mut node: Expr, local: LocalInfo, scope: TypeScope, ctx: Context) returns Bool {
    if node.node_type.is(NodeType.If) {
        if node.children.len() < 2 { return false }

        ref mut then_body : Expr = node.children[1]
        mut then_done := sink_nontransfer_paths(then_body, local, scope, ctx)
        if then_done.not() { then_done = add_delete_to_branch(then_body, local, node, scope, ctx) }

        mut else_done := false
        if node.children.len() > 2 {
            ref mut else_body : Expr = node.children[2]
            else_done = sink_nontransfer_paths(else_body, local, scope, ctx)
            if else_done.not() { else_done = add_delete_to_branch(else_body, local, node, scope, ctx) }
        } else {
            mut else_body_new := Expr.new(NodeType.Body, node.line, node.col)
            else_done = add_delete_to_branch(else_body_new, local, node, scope, ctx)
            if else_done { node.add_child(own else_body_new) }
        }

        return then_done.and(else_done)
    }

    if node.node_type.is(NodeType.Switch) {
        // Same path-split as If, per case. A case that transfers the local
        // is already covered (its own transfer consumes it); every other
        // case leaf gets the delete. A C-like switch with no default leaks
        // the local on an unmatched scrutinee, so synthesize a `case:`
        // default carrying just the delete when none exists. (Enum switches
        // are exhaustive and desugar to if/elif before this pass, so this
        // path handles the integer/char C-like switches only.)
        mut all_done := true
        mut has_default := false
        for ci in 1..node.children.len() {
            ref mut case_node : Expr = node.children[ci]
            if case_node.node_type.is(NodeType.Case).not() { continue }
            if case_node.children.len() == 1 { has_default = true }
            cbi := case_node.children.len() - 1
            ref mut case_body : Expr = case_node.children[cbi]
            mut case_done := sink_nontransfer_paths(case_body, local, scope, ctx)
            if case_done.not() { case_done = add_delete_to_branch(case_body, local, node, scope, ctx) }
            all_done = all_done.and(case_done)
        }
        if has_default.not() {
            mut default_body := Expr.new(NodeType.Body, node.line, node.col)
            if add_delete_to_branch(default_body, local, node, scope, ctx) {
                mut default_case := Expr.new(NodeType.Case(CaseData(pattern_count = 0)), node.line, node.col)
                default_case.add_child(own default_body)
                node.add_child(own default_case)
            }
        }
        return all_done
    }

    if node.node_type.is(NodeType.Body).not() { return false }
    for mut child : Expr in node.children {
        if is_compile_directive(child) { continue }
        if child.node_type.is(NodeType.If).or(child.node_type.is(NodeType.Switch)).and(expr_transfers_own(child, local.name, scope, ctx)) {
            if sink_nontransfer_paths(child, local, scope, ctx) { return true }
            continue
        }
        if stmt_is_conditional_container(child).not() {
            if expr_transfers_own(child, local.name, scope, ctx) { return true }
        }
    }
    return false
}

// asap stands down on any `own` transfer (own_transfer >= 0). When the
// transfer sits inside one branch of an `if`, the other path never frees the
// local -- a leak (the conditional-transfer footgun). Fix: add the local's
// delete to every branch leaf that does NOT transfer it. This only ever ADDS a
// delete on a path where the local is still owned, so it cannot double-free;
// nested `else if` trees are handled recursively so a transfer in an inner
// branch is not followed by an outer-branch delete.
//
// Own params are covered too, EXCEPT when the conditional transfer is the
// param's own destructor call (dtor_transfer): a delete method's `self` does
// `if call_free { free(own self) }` after its field deletes already ran, so
// sinking a delete into the else branch there re-frees the fields (recursive
// delete -> bad-free). The old rule excluded ALL params, which leaked every
// ordinary conditionally-transferred own param (#302: 30 bytes per call on
// the non-transfer path of `if flag { return consume(own s) }`).
//
// Str is handled like any other owned local here: Str.delete knows whether its
// buffer is owned, literal, or a view. The sink must be path-sensitive instead
// of type-sensitive.
// Returns true iff a graft happened, i.e. iff the body was
// restructured. Facts taken before this pass are positional, so the
// caller must recompute them when (and only when) that is the case --
// and it almost never is: 22 grafts per 8,154 fact computations on a
// test/first_class.til translate.
priv sink_conditional_transfer_deletes := proc(mut body: Expr, locals: Vec(LocalInfo), scope: TypeScope, ctx: Context) returns Bool {
    mut grafted := false
    for local : LocalInfo in locals {
        if local.skip_scope_delete { continue }
        if local.decl_index.lt(0).and(local.dtor_transfer) { continue }
        // Index guard, not a semantic one: own_transfer is the statement
        // index read below, and -1 would index out of bounds.
        if local.own_transfer < 0 { continue }
        // Stack values need the same non-transfer cleanup as heap boxes:
        // their deep contents are still owned even though call_free=false
        // preserves the frame storage. Pointer-transfer adapters consume a
        // boxed copy only on the path that actually transfers ownership.
        // Callables and other unnamed types still stand down.
        if is_aggregate(local.type).not().and(local.type.is(Type.Primitive).not()) { continue }
        if type_to_name(local.type).len() == 0 { continue }
        if local.own_transfer >= body.children.len().to_i32() { continue }
        // #302 stage 3: the DATAFLOW decides whether a graft is needed,
        // for every container kind. Mixed at exit means some path leaves
        // the local still owned while another moved it -- exactly the
        // conditional-transfer leak the sink repairs. Uniform Moved (the
        // transfer covers every path) and uniform Owned (no path moved
        // it; the ordinary scope-end delete applies) both stand down.
        // This replaces the index precondition `last_use > own_transfer`,
        // which approximated the same question positionally: a use after
        // the transfer statement means the fall-through path still owns
        // the local, which IS the Mixed verdict -- computed per path
        // instead of by statement order.
        if gc_flow_exit_is_mixed(body, local, scope, ctx).not() { continue }
        ref mut tstmt : Expr = body.children[local.own_transfer.to_usize()]
        if tstmt.node_type.is(NodeType.If).or(tstmt.node_type.is(NodeType.Switch)) {
            sink_nontransfer_paths(tstmt, local, scope, ctx)
            grafted = true
            continue
        }
        // #302 stage 3: a Body at own_transfer is EITHER the
        // desugared-switch-with-break wrapper (transfer in one arm of
        // the inner if/elif chain; the other arms leak) OR a loop
        // wrapper (for-in / desugared for) -- and grafting into a loop
        // wrapper double-frees, the failure that reverted the bare Body
        // gate. Two gates make the graft precise:
        //   1. transfer_lex_inside_while: the transfer must NOT sit
        //      under a While inside the wrapper, because the transfer
        //      belongs to a different ITERATION than any grafted path
        //      -- per-path deletes there free a value a later iteration
        //      still needs. (Per-iteration locals are unaffected: their
        //      graft view IS the loop body, no While wraps the
        //      transfer there.) #364 turned the shapes that used to
        //      reach this gate into errors; the rebind-then-transfer
        //      pattern is what is left.
        //   2. gc_flow_exit_is_mixed: some path must leave the view
        //      still owning the local (a bare-block wrapper whose
        //      transfer covers every path shows uniform Moved and
        //      stands down).
        if tstmt.node_type.is(NodeType.Body) {
            // The Mixed verdict is already established by the shared
            // gate above; only the loop-iteration hazard remains.
            if transfer_lex_inside_while(tstmt, local.name, scope, ctx).not() {
                sink_nontransfer_paths(tstmt, local, scope, ctx)
                grafted = true
            }
        }
    }
    return grafted
}

// #302 stage 1: stamp the settled storage decision on each Decl's
// Declaration (GcStorage). The record IS the decision the delete insertion
// below executes. Ref bindings stay
// Unset: they are borrows, neither stack-owned values nor heap boxes
// of their own. The builder's transition asserts (emit_stmt_decl)
// compare their re-derived twin shape checks against this record and
// panic loudly on disagreement.
priv record_storage_decisions := func(mut body: Expr, locals: Vec(LocalInfo)) {
    for local : LocalInfo in locals {
        if local.decl_index < 0 { continue }
        ref mut stmt : Expr = body.children[local.decl_index.to_usize()]
        if stmt.node_type.is(NodeType.Decl).not() { continue }
        switch stmt.node_type {
        case .Decl(dd):
            if dd.own_type.is(OwnType.Ref) { continue }
            if local.is_heap {
                dd.gc_storage = GcStorage.HeapBox
            } else {
                dd.gc_storage = GcStorage.Stack
            }
        case:
        }
    }
}

// Stamp whether each field assignment consumes its RHS. The interpreter
// cannot recover this from an Ident after the typer hoists an owning call.
priv record_field_transfer_decisions := func(mut body: Expr, scope: TypeScope) {
    for mut stmt : Expr in body.children {
        switch stmt.node_type {
        case .FieldAssign(fad):
            fad.transfers_own = field_assign_transfers_own(stmt, scope)
        case:
        }
    }
}

// A delete(..., false) consumes nested ownership but intentionally leaves the
// outer allocation for the caller's following memset/free protocol.
priv record_keep_outer_args_expr := proc(mut e: Expr, false_names: Set(Str)) {
    if e.node_type.is(NodeType.FCall).and(e.children.len().gt(2)).and(get_own_arg(e, 1)) {
        mut is_delete := false
        switch e.children[0].node_type {
        case .FieldAccess(fa): is_delete = fa.field_access_name() == "delete"
        case .Ident(id): is_delete = id.ident_name().ends_with("_delete")
        case:
        }
        if is_delete {
            mut call_free_is_false := false
            switch e.children[2].node_type {
            case .Literal(Literal.Bool(call_free)):
                call_free_is_false = call_free.not()
            case .Ident(id):
                call_free_is_false = false_names.has(id.ident_name())
            case:
            }
            if call_free_is_false { set_keep_outer_arg(e, 1) }
        }
    }
    for mut child : Expr in e.children { record_keep_outer_args_expr(child, false_names) }
}

priv record_keep_outer_args := proc(mut body: Expr) {
    mut false_names := Set(Str).new()
    for stmt : Expr in body.children {
        switch stmt.node_type {
        case .Decl(dd):
            if stmt.children.len() > 0 {
                switch stmt.children[0].node_type {
                case .Literal(Literal.Bool(value)):
                    if value.not() { false_names.add(own dd.name.clone()) }
                case:
                }
            }
        case:
        }
    }
    record_keep_outer_args_expr(body, false_names)
}

// --- #302 stage 5: the temp contract, checked ------------------------------
//
// The hoisting division of labor says every owned-aggregate-producing
// expression the asap pass must track has been lifted into a named
// `hoisted__` Decl by the typer. The contract was implicit: any shape
// the hoister missed was INVISIBLE to the pass and leaked silently
// (the f().field class, #272). This walk makes it checked: an
// own-returning aggregate call in a position that neither a Decl nor a
// consuming parent covers is reported. Positions that COVER a temp:
//   - RHS (child 0) of a Decl (the hoisted form itself);
//   - a Return operand (the return machinery owns it);
//   - an Assign RHS (save_old_delete / assign machinery owns it);
//   - an own-arg slot of a call (the callee consumes it);
//   - a bare expression statement (the discard machinery deletes it);
//   - a FieldAssign RHS (the field takes it).
// The walk stops at nested Body / FuncDef boundaries: those are
// separate garbager views with their own check.
priv temp_check_expr := proc(e: Expr, consumed: Bool, ctx: Context, scope: TypeScope) {
    if e.node_type.is(NodeType.FuncDef) {
        switch e.node_type {
        case .FuncDef(fd):
            if fd.captures.len().gt(0).and(consumed.not()) {
                panic(__LOC__, ": unhoisted capturing closure temp at ", ctx.path, ":", e.line.to_str(), ":", e.col.to_str())
            }
        case:
        }
        return
    }
    if e.node_type.is(NodeType.Body) { return }
    // Struct/enum defs: field defaults and namespace members are owned
    // by the initer/constructor machinery, and method bodies are
    // separate garbager views -- not this body's temps.
    if e.node_type.is(NodeType.StructDef).or(e.node_type.is(NodeType.EnumDef)) { return }
    // NamedArg wraps a value without changing who consumes it.
    if e.node_type.is(NodeType.NamedArg) {
        for na : Expr in e.children {
            temp_check_expr(na, consumed, ctx, scope)
        }
        return
    }
    if e.node_type.is(NodeType.FCall) {
        // A struct-constructor call's fields take every arg (own fields
        // consume, Shallow fields value-copy with the wrapper-free
        // machinery compensating) -- the same ctor special case
        // fcall_has_own_arg carries, since ctor calls have no own-arg
        // bits. A MACRO call is folded away whole by the constfolder
        // (with its typer-synthesized Type-value args), so neither the
        // call nor its args survive to codegen. Ordinary calls consume
        // exactly their own-arg slots.
        mut is_ctor := false
        ctor_name_o := expr_type_name_ref(e)
        if ctor_name_o.is_some().and(e.children.len().gt(0)) {
            ref ctor_name : Str = ctor_name_o.unwrap()
            switch e.children[0].node_type {
            case .Ident(tc_cn):
                if tc_cn.ident_name() == ctor_name { is_ctor = true }
            case:
            }
        }
        mut is_mac := false
        if e.children.len() > 0 {
            switch e.children[0].node_type {
            case .Ident(tc_mn):
                ref mn : Str = tc_mn.ident_name()
                if ctx.constfolder_foldables.has(mn) {
                    if ctx.constfolder_foldables[mn].is(FuncType.Macro) { is_mac = true }
                }
            case:
            }
        }
        if consumed.not().and(is_mac.not()).and(is_aggregate(e.til_type())).and(fcall_returns_own(e, scope)) {
            tn := type_to_name(e.til_type())
            if tn.len() > 0 {
                // ICE, not a diagnostic: an owned temp the hoister missed
                // is invisible to the asap pass and leaks silently -- the
                // D5 class. Loud beats a plausible-looking leak. The whole
                // corpus (compiler + tests + examples) is hit-free as of
                // 2026-07-16; anything firing here is a NEW hoister gap.
                panic(__LOC__, ": unhoisted owned temp at ", ctx.path, ":", e.line.to_str(), ":", e.col.to_str(),
                    " type=", tn, " -- the typer's hoist pass missed an owned aggregate temp; the asap pass cannot track it")
            }
        }
        for ai in 0..e.children.len() {
            if ai == 0 {
                temp_check_expr(e.children[ai], false, ctx, scope)
            } else if is_ctor.or(is_mac) {
                temp_check_expr(e.children[ai], true, ctx, scope)
            } else {
                temp_check_expr(e.children[ai], get_own_arg(e, ai), ctx, scope)
            }
        }
        return
    }
    for c : Expr in e.children {
        temp_check_expr(c, false, ctx, scope)
    }
}

priv temp_check_body := proc(ctx: Context, body: Expr, scope: TypeScope) {
    for stmt : Expr in body.children {
        if is_compile_directive(stmt) { continue }
        switch stmt.node_type {
        case .Decl(tc_dd):
            // The Decl RHS IS the hoisted/bound form; its nested args
            // still need the walk.
            if stmt.children.len() > 0 { temp_check_expr(stmt.children[0], true, ctx, scope) }
            if tc_dd.default_value.is_some() { temp_check_expr(tc_dd.default_expr(), true, ctx, scope) }
        case .Assign(tc_ad):
            if tc_ad.name.len().gt(0).and(stmt.children.len().gt(0)) {
                temp_check_expr(stmt.children[0], true, ctx, scope)
            }
        case .FieldAssign(tc_fad):
            if tc_fad.name.len().gt(0).and(stmt.children.len().gt(1)) {
                temp_check_expr(stmt.children[0], false, ctx, scope)
                temp_check_expr(stmt.children[1], true, ctx, scope)
            }
        case .Return:
            if stmt.children.len() > 0 { temp_check_expr(stmt.children[0], true, ctx, scope) }
        case .FCall:
            // Bare call statement: the discard machinery owns the result.
            temp_check_expr(stmt, true, ctx, scope)
        case:
            temp_check_expr(stmt, false, ctx, scope)
        }
    }
}

priv insert_free_calls := proc(mut ctx: Context, mut body: Expr, mut scope: TypeScope, scope_exit: I32, stack_own_params: Set(Str)) returns Bool {
    if scope_exit == 0 { return false }
    is_program_scope := scope.parent.is_none()

    mut locals_vec := Vec(LocalInfo).new()
    // One fact computation for every pass that reads this body BEFORE it
    // is restructured. Each pass used to build its own -- collect_scope_
    // locals, collect_borrow_edges, extend_hoist_view_lifetimes and the
    // taint walk below -- so a body's statements were walked four times
    // over. `with_transfers` is the superset (only collect_scope_locals
    // reads that row, and it is the only part that consults scope), so
    // computing it once here serves all of them.
    //
    // The name->bit index is shared by every consumer: sink below moves
    // deletes (FCall statements) around but adds no bindings and no
    // top-level Assign targets, so the universe built from the
    // pre-restructure body stays exact.
    //
    // ONE computation for the whole pass. Fact rows are positional, so
    // they must be rebuilt if sink_conditional_transfer_deletes grows a
    // branch body -- and only then, which is why sink reports it: the
    // graft fires 22 times per 8,154 fact computations, so the
    // unconditional rebuild this replaced was pure waste in essentially
    // every body (~9% of a translate went into building facts).
    fidx := fact_universe(body, scope)
    mut facts := body_stmt_facts(body, scope, true, fidx)
    collect_scope_locals(body, scope, is_program_scope, facts, fidx, stack_own_params, locals_vec)
    // Before the zero-locals early return: outer-target assigns need
    // their save_old_delete decision even in bodies that own no locals,
    // and the stage-5 temp contract applies to every body.
    flag_outer_assign_rebinds(body, locals_vec, scope)
    record_field_transfer_decisions(body, scope)
    record_keep_outer_args(body)
    temp_check_body(ctx, body, scope)
    if locals_vec.len() == 0 { return false }

    extend_ref_local_lifetimes(body, locals_vec, scope, facts, fidx)
    check_use_after_own_transfer(body, locals_vec, scope, ctx)
    record_storage_decisions(body, locals_vec)
    if sink_conditional_transfer_deletes(body, locals_vec, scope, ctx) {
        // Only when sink actually grafted: the rows are positional and
        // the grafted deletes shift the statements they landed among.
        facts = body_stmt_facts(body, scope, false, fidx)
    }
    // After the own-transfer check (so an over-eager taint can't spuriously
    // flag use-after-transfer): defer a local's auto-delete past any later
    // statement that reads a hoisted view aliasing its buffer. See #250.
    extend_hoist_view_lifetimes(body, locals_vec, facts, fidx)

    // #302 stage 0: decision audit. The analysis above has settled every
    // per-binding decision; the dump itself runs after the insertion loop
    // so the site walk sees the final body. Cost when disabled: one env
    // read per body.
    audit_filter := get_env("TIL_GC_AUDIT")
    audit := audit_filter.len().gt(0).and(ctx.path.contains(audit_filter))
    if audit {
        // #302 stage 3 slice 1: dump the body's CFG. Built here, after
        // the analysis passes settle (sink may have grown branch bodies)
        // and before the insertion loop, so spans use the same
        // pre-insertion statement indexes as the audit table.
        mut cfg_blocks := Vec(GcCfgBlock).new()
        cfg_build(cfg_blocks, body)
        gc_cfg_dump(ctx, body, cfg_blocks)
        gc_flow_dump(ctx, cfg_blocks, locals_vec, scope)
        gc_live_dump(cfg_blocks, locals_vec)
    }

    // #302 stage 3: the root body's per-statement ownership states,
    // built while body.children still exists (the move_from below
    // empties it) and consumed by insert_nested_exit_deletes, which
    // runs inside the loop and would otherwise have only statement
    // indexes to reason with. Entry is Uninit: a root local is not
    // live before its Decl (params, decl_index < 0, enter Owned).
    // ... and only when some statement can actually consume it: its two
    // readers return immediately unless the statement is a compound
    // (insert_nested_exit_deletes) or an exit
    // (insert_exit_deletes_into_stmt).
    mut wants_flow := false
    for s : Expr in body.children {
        if stmt_is_conditional_container(s).or(s.node_type.is(NodeType.Return))
            .or(s.node_type.is(NodeType.Break)).or(s.node_type.is(NodeType.Continue)) {
            wants_flow = true
            break
        }
    }
    root_flow := gc_flow_stmt_table(body, locals_vec, FLOW_UNINIT, wants_flow, scope, ctx)
    root_stmts := body.children.len()
    // #302 stage 3: the view-taint relation, built once here rather
    // than rescanned per query. The two consumers below used to walk
    // the already-emitted statement list on every (statement, name)
    // question -- and needed the Exprs to do it, which is why a second
    // Expr-free copy of the same walk existed for the extend pass.
    // BodyFacts' def_names/def_bits close that gap: one walk, one
    // implementation, and it keeps answering after the move_from below
    // empties body.children.
    ref taint_facts : BodyFacts = facts

    mut old := body.children.take()

    mut new_ch := Vec(Expr).new()
    for i in 0..old.len() {
        ref mut stmt : Expr = old[i]
        if is_compile_directive(stmt) { continue }
        insert_exit_deletes_into_stmt(stmt, locals_vec, i, root_flow, root_stmts, new_ch)
        insert_nested_exit_deletes(stmt, locals_vec, i, root_flow, root_stmts, scope, ctx)
        insert_assign_delete(stmt, locals_vec, new_ch, taint_facts, fidx, i)
        mut post_deletes := Vec(Expr).new()
        insert_post_stmt_deletes(ctx, stmt, locals_vec, i, post_deletes, scope, new_ch)
        new_ch.push_take(old, i)
        new_ch.append(own post_deletes)
    }

    body.children.move_from(own new_ch)
    if audit { gc_audit_dump(ctx, body, locals_vec) }
    return true
}

// Per-body asap entry. Called from the typer's scope-management sites
// (infer_func_def_expr, infer_if_stmt, infer_while_stmt, the Body/Catch
// arms of infer_body_stmt) after infer_body has settled. The per-body
// TypeScope local itself is an ordinary owned local of the calling
// typer function, reclaimed by this same pass when the CALLER's body
// is processed (#302 removed the 11 hand-written TypeScope.delete
// calls that used to follow these call sites; they predated the pass
// covering such locals and the full ASAN suite proves the inserted
// deletes cover them). Returns true iff body.children changed, so the
// caller can decide whether to re-run reregister_scope_defs.
// See issue #204.
garbager_destroy_body := proc(mut ctx: Context, mut body: Expr, mut scope: TypeScope) returns Bool {
    return insert_free_calls(ctx, body, scope, 1, Set(Str).new())
}

garbager_destroy_func_body := proc(mut ctx: Context, mut body: Expr, mut scope: TypeScope, fd: FunctionDef) returns Bool {
    mut stack_own_params := Set(Str).new()
    for i in 0..fd.params.len() {
        ref p : Declaration = fd.params[i]
        if p.own_type.is(OwnType.Own)
        .and(func_param_passes_c_value(fd, i, ctx.param_value_abi_ok, scope)
            .or(func_param_has_stack_outer(fd, i, ctx.param_value_abi_ok, scope))) {
            stack_own_params.add(own p.name.clone())
        }
    }
    return insert_free_calls(ctx, body, scope, 1, stack_own_params)
}

// Phase entry point. Runs the asap-destruction pass on every
// imported file's program body using the global TypeScope
// (ctx.scope). Called from the tail of init_and_type_program
// (loader.til) so both prepare_program (interpret/translate/
// build/run/test/install paths) and cmd_doc see the post-asap
// program AST.
//
// Sub-body asap (function bodies, if/while/block/catch scopes)
// still runs inline from the typer's scope-management sites
// because per-body scopes are locals of the typer functions,
// gone (via this pass's own inserted deletes, #302) once
// infer_body returns. Issue #204 step 3b covers lifting the
// inline calls into this proc; the blocker is per-body scope
// ownership, which needs either a scope cache on Context (#158)
// or an on-the-fly scope rebuild in garbager.
garbager_destroy := proc(mut ctx: Context) {
    saved_path := ctx.path.clone()
    for path, mut iu in ctx.imported {
        ctx.path = path.clone()
        insert_free_calls(ctx, iu.ast, ctx.scope, 1, Set(Str).new())
    }
    ctx.path = saved_path
}
