mode lib
import("context")

// Check if a FieldAccess/FieldAssign Expr accesses a namespace field.
fa_is_ns := func(e: Expr, scope: TypeScope) returns Bool {
    if e.children.len() == 0 { return false }
    if e.node_type.is(NodeType.FieldAccess).not().and(e.node_type.is(NodeType.FieldAssign).not()) { return false }
    ref obj : Expr = e.children[0]
    // Borrowed names only: this runs on every field access the typer
    // sees, and the owning til_type_name/Str.clone forms paid three
    // clone+delete pairs per call.
    sn_o := expr_type_name_ref(obj)
    if sn_o.is_some() { return fa_is_ns_named(e, scope, sn_o.unwrap()) }
    switch obj.node_type {
    case .Ident(id):
        return fa_is_ns_named(e, scope, id.ident_name())
    case:
        return false
    }
}

// The tail of fa_is_ns once the receiver's type name is known: does the
// named def carry this member in its namespace?
priv fa_is_ns_named := func(e: Expr, scope: TypeScope, sn: Str) returns Bool {
    sdef_o := scope.get_struct(sn)
    if sdef_o.is_none() { return false }
    ref sdef : Expr = sdef_o.unwrap()
    switch e.node_type {
    case .FieldAccess(fn):
        return def_ns_has(sdef, fn.field_access_name())
    case .FieldAssign(fad):
        return def_ns_has(sdef, fad.name)
    case:
        UNREACHABLE("unexpected ", e.node_type.head_str())
        return false
    }
}

make_til_type_expr := func(src: Expr, t: Type) returns Expr {
    mut variant_name := ""
    mut payload_name := ""
    mut has_payload := false
    // Variants stored under Type.Primitive(Primitive.X) need a nested
    // construction `Type.Primitive(Primitive.X)`, not a bare
    // `Type.X` (Type has no such field). Built below after the switch.
    mut primitive_variant := ""
    switch t {
    case .Unknown:   variant_name = "Unknown"
    case .None:      variant_name = "None"
    case .Primitive(Primitive.I64):       primitive_variant = "I64"
    case .Primitive(Primitive.U8):        primitive_variant = "U8"
    case .Primitive(Primitive.I8):        primitive_variant = "I8"
    case .Primitive(Primitive.I16):       primitive_variant = "I16"
    case .Primitive(Primitive.U16):       primitive_variant = "U16"
    case .Primitive(Primitive.I32):       primitive_variant = "I32"
    case .Primitive(Primitive.U32):       primitive_variant = "U32"
    case .Primitive(Primitive.U64):       primitive_variant = "U64"
    case .Primitive(Primitive.F32):       primitive_variant = "F32"
    case .Primitive(Primitive.F64):       primitive_variant = "F64"
    case .Primitive(Primitive.Bool):      primitive_variant = "Bool"
    case .Struct(s): variant_name = "Struct"; payload_name = s.clone(); has_payload = true
    case .StructDef: variant_name = "StructDef"
    case .Enum(s):   variant_name = "Enum"; payload_name = s.clone(); has_payload = true
    case .EnumDef:   variant_name = "EnumDef"
    case .FuncDef:   variant_name = "FuncDef"
    case .FuncPtr:   variant_name = "FuncPtr"
    // Issue #58: FuncPtrSig carries a FuncSig alias name. For
    // make_til_type_expr we emit it as the bare FuncPtr type token --
    // the name isn't part of til's type-token surface (no user-visible
    // `Type.FuncPtrSig("X")` constructor exists yet), and downstream
    // consumers that care about the name read it from the binding's
    // type via til_type_name. As migration progresses this can grow
    // its own variant_name path.
    case .FuncPtrSig: variant_name = "FuncPtr"
    case .Body:      variant_name = "Body"
    case .Dynamic:   variant_name = "Dynamic"
    case .Custom(s): variant_name = "Custom"; payload_name = s.clone(); has_payload = true
    }
    if primitive_variant.len() > 0 {
        // Build Type.Primitive(Primitive.<primitive_variant>).
        mut type_ident_p := Expr.new(ident_node("Type"), src.line, src.col)
        type_ident_p.set_til_type(Type.Enum("Type"))
        mut prim_ident := Expr.new(ident_node("Primitive"), src.line, src.col)
        prim_ident.set_til_type(Type.Enum("Primitive"))
        mut prim_fa := Expr.new(field_access_node(primitive_variant), src.line, src.col)
        prim_fa.add_child(own prim_ident)
        prim_fa.set_til_type(Type.Enum("Primitive"))
        mut type_prim_fa := Expr.new(field_access_node("Primitive"), src.line, src.col)
        type_prim_fa.add_child(own type_ident_p)
        type_prim_fa.set_til_type(Type.Unknown)
        mut call := Expr.new(NodeType.FCall(FCallData()), src.line, src.col)
        call.add_child(own type_prim_fa)
        call.add_child(own prim_fa)
        // No own marking: Primitive is a payload-less enum, so the
        // ctor COPIES the value out of the caller's storage and frees
        // nothing. Marking it own made this emit a heap box the ctor
        // read once and dropped -- and now that the ctor keeps its
        // hands off, an own arg here would leak the box.
        call.set_til_type(Type.Enum("Type"))
        return call
    }
    mut type_ident := Expr.new(ident_node("Type"), src.line, src.col)
    type_ident.set_til_type(Type.Enum("Type"))
    mut fa := Expr.new(field_access_node(variant_name), src.line, src.col)
    fa.add_child(own type_ident)
    if has_payload.not() {
        fa.set_til_type(Type.Enum("Type"))
        return fa
    }
    fa.set_til_type(Type.Unknown)
    mut call := Expr.new(NodeType.FCall(FCallData()), src.line, src.col)
    call.add_child(own fa)
    mut payload := Expr.new(NodeType.Literal(Literal.Str(payload_name)), src.line, src.col)
    call.add_child(own payload)
    call.set_til_type(Type.Enum("Type"))
    return call
}

priv rewrite_til_type_arg := proc(mut scope: TypeScope, mut parent: Expr, arg_idx: USize, ptype: Type, in_func: I32, mut ctx: Context) {
    if is_type_metatype(ptype).not() { return }
    ref arg : Expr = parent.children[arg_idx]
    switch arg.node_type {
    case .Ident(arg_name):
        b_o := scope.get_binding(arg_name.ident_name())
        if b_o.is_none() { return }
        ref b : TypeBinding = b_o.unwrap()
        if type_binding_is_type_token(scope, b).not() { return }
        replacement := arg.make_til_type_expr(b.type)
        parent.children[arg_idx] = replacement
        infer_expr(scope, parent.children[arg_idx], in_func, ctx)
    case:
    }
}

// Look up the OwnType for the instance field of a FieldAccess/FieldAssign.
fa_own_type := func(e: Expr, scope: TypeScope) returns shallow OwnType {
    if e.children.len() == 0 { return OwnType.Shallow }
    if e.node_type.is(NodeType.FieldAccess).not().and(e.node_type.is(NodeType.FieldAssign).not()) { return OwnType.Shallow }
    ref obj : Expr = e.children[0]
    mut sn_o := expr_type_name_ref(obj)
    if sn_o.is_none() {
        switch obj.node_type {
        case .Ident(id):
            sn_o = Option(ref Str).Some(id.ident_name())
        case:
            return OwnType.Shallow
        }
    }
    ref sn : Str = sn_o.unwrap()
    sdef_o := scope.get_struct(sn)
    if sdef_o.is_none() { return OwnType.Shallow }
    ref sdef : Expr = sdef_o.unwrap()
    mut fname := ""
    switch e.node_type {
    case .FieldAccess(fn):
        fname = Str.clone(fn.field_access_name())
    case .FieldAssign(fad):
        fname = fad.name
    case:
        UNREACHABLE("unexpected ", e.node_type.head_str())
        return OwnType.Shallow
    }
    switch sdef.node_type {
    case .StructDef(ot_sdd):
        ot_fld_o := member_get(ot_sdd.fields_index, ot_sdd.fields, fname)
        if ot_fld_o.is_some() { return ot_fld_o.unwrap().own_type }
    case:
    }
    return OwnType.Shallow
}

// hoist_counter / va_counter / kw_counter / coll_counter previously
// lived here as module-level mut; they moved to Context (see
// initer.til). The hoist/desugar pre-pass chain (body_pre_passes ->
// apply_call_hoist_delete -> process_call_desugars +
// apply_hoist_to_stmt -> hoist_to_temp / hoist_expr / ...) threads
// `mut ctx: Context` so the same Context that already owns the rest
// of the typer scratch state also owns these unique-name counters.
// proc_calls_count / proc_def_depth previously lived here as
// module-level mut; they moved to Context (see initer.til). The
// typer reads/writes via ctx.proc_calls_count / ctx.proc_def_depth.
// errors / current_type_name / current_top_func_name / auto_gen_depth /
// throw_used_local_names likewise moved onto Context (see initer.til);
// helpers with ctx in scope use ctx.<field>, and the leaf diagnostics
// (type_error / type_error_at) reach it via ctx.
// Issue #93 follow-up: name of the top-level Decl whose body we are
// currently typing (function rhs or struct/enum that contains the
// active ns method body via current_type_name). Lifted nested defs
// carry their original parent in TypeBinding.orig_name; the function-
// scope priv check uses these two tracking globals to decide whether
// a reference at the current location is allowed to see the mangled
// name (only the original parent function and any of its other lifted
// descendants can). current_top_func_name now lives on Context.
// Issue #198: the throw_type_registry / throws_global tables
// previously declared here moved onto the
// `Context` struct (see initer.til) so cross-unit typer state lives
// on the same ctx everything else threads through. The accessors
// below take `ctx` and the body-walk helpers thread it down.
// #187 step 2: nesting depth of auto-generated FuncDef bodies
// (clone/delete/size/etc emitted by initer). The unused-priv-member
// check ignores reads inside these so genuinely-unused priv fields
// and ns methods are not masked by boilerplate references.
// auto_gen_depth / throw_used_local_names now live on Context.
// typer_in_shallow_return (and the late typer_in_main_func) lived as
// module-level mut here. They moved to Context (see initer.til) since
// garbager.til reads them and the garbager entry points already thread
// ctx. infer_func_def_expr writes ctx.typer_in_* while typing each
// body; collect_scope_locals / promote_own_transferred_locals read
// them through ctx.
I64Name := "I64"
U8Name := "U8"
I8Name := "I8"
I16Name := "I16"
U16Name := "U16"
I32Name := "I32"
U32Name := "U32"
U64Name := "U64"
F32Name := "F32"
F64Name := "F64"
BoolName := "Bool"

priv CtorArg := enum {
    Unfilled,
    Filled: Expr,
}

// Active file path and error counter for diagnostics live on Context
// (ctx.path / ctx.errors), threaded explicitly through type_error /
// type_error_at and every caller.
// Non-priv so the garbager module can report use-after-ownership-transfer
// against the same diagnostic counter.
type_error := proc(e: Expr, msg: Str, mut ctx: Context) {
    e.error(ctx.path, msg)
    ctx.errors++
}

type_error_at := proc(path: Str, line: U32, col: U32, msg: Str, mut ctx: Context) {
    println(path, ":", line.to_str(), ":", col.to_str(), ": error: ", msg)
    ctx.errors++
}

// #321 step 2: "this type has no such namespace function" is a real
// state every caller branches on -- Option, not a null ref. (The sdef
// ARGUMENT stays nullable: a null def simply has no members.)
find_namespace_func := func(sdef: Expr, method: Str, scope: TypeScope) returns Option(ref Expr) {
    fd_o := def_ns_get(sdef, method)
    if fd_o.is_none() { return Option(ref Expr).None }
    ref fd : Declaration = fd_o.unwrap()
    if fd.default_value.is_none() { return Option(ref Expr).None }
    ref e : Expr = fd.default_expr()
    if e.node_type.is(NodeType.Ident) {
        switch e.node_type {
        case .Ident(id):
            sf := scope.find(id.ident_name())
            switch sf {
            case .Found(b):
                bfd_o := scope.lookup_func(b.name)
                if bfd_o.is_some() { return bfd_o }
                bsd_o := scope.struct_def_of(b.name)
                if bsd_o.is_some() { return bsd_o }
            case:
            }
        case:
        }
    }
    return Option(ref Expr).Some(e)
}

// Issue #191: check if an Expr is comptime-known. Used by typer to
// validate macro arguments and by constfolder to decide func folding.
// Conservative: only accepts shapes that are definitely known at
// compile time.
priv expr_is_comptime := func(e: Expr, scope: TypeScope) returns Bool {
    switch e.node_type {
    case .Literal(Literal.Num):    return true
    case .Literal(Literal.Str):    return true
    case .Literal(Literal.Bool):   return true
    case .Literal(Literal.Null):   return true
    case .Ident(id):
        b_o := scope.get_binding(id.ident_name())
        if b_o.is_none() { return false }
        ref b : TypeBinding = b_o.unwrap()
        if b.is_mut { return false }
        if b.is_param { return false }
        return true
    case .FCall:
        if e.children.len() == 0 { return false }
        // Issue #57: a `Type.<Variant>(...)` constructor call returns a Type
        // metatype value -- pure and comptime when its arg(s) are. The typer
        // rewrites a Type-typed ident (e.g. `mymacro(NamedEnum)` or anon-lifted
        // `enum { ... }`) into this form via make_til_type_expr, so recognise
        // it before the binding lookup below (there is no `Type_Enum` binding
        // for the receiver-qualified method name).
        if is_type_metatype(e.til_type()) {
            for ai in 1..e.children.len() {
                if e.children[ai].expr_is_comptime(scope).not() { return false }
            }
            return true
        }
        ref callee : Expr = e.children[0]
        mut cb_ft := FuncType.Proc
        switch callee.node_type {
        case .Ident(cn):
            cb_o := scope.get_binding(cn.ident_name())
            if cb_o.is_none() { return false }
            ref cb : TypeBinding = cb_o.unwrap()
            if cb.is_func_decl.not() { return false }
            cb_ft = binding_func_type(cb)
        case .FieldAccess(mn):
            // A namespace/UFCS method call (`recv.method(...)`) is lowered
            // by infer_field_access_fcall to `Type.method(recv, ...)`, with
            // the receiver's type as a leading arg. Those methods live in the
            // type's namespace -- they are NOT registered as flat `Type_method`
            // bindings, so a `scope.get_binding(...)` lookup always misses
            // (issue #285: that miss wrongly rejected `2.to_f32()`). Resolve
            // the FuncDef through the namespace and read its FuncType directly.
            if callee.children.len() == 0 { return false }
            ref recv : Expr = callee.children[0]
            mut sname_o := expr_type_name_ref(recv)
            if sname_o.is_none() {
                switch recv.node_type {
                case .Ident(rn):
                    sname_o = Option(ref Str).Some(rn.ident_name())
                case:
                }
            }
            if sname_o.is_none() { return false }
            ref sname : Str = sname_o.unwrap()
            sdef_o := scope.get_struct(sname)
            if sdef_o.is_none() { return false }
            nfo := find_namespace_func(sdef_o.unwrap(), mn.field_access_name(), scope)
            if nfo.is_none() { return false }
            ref ns_func : Expr = nfo.unwrap()
            switch ns_func.node_type {
            case .FuncDef(nfd):
                cb_ft = nfd.func_type
            case:
                return false
            }
        case:
            return false
        }
        if cb_ft.is_proc() {
            return false
        }
        if cb_ft.is(FuncType.Macro).or(cb_ft.is(FuncType.Func)).or(cb_ft.is(FuncType.ExtFunc)).or(cb_ft.is(FuncType.CoreFunc)).or(cb_ft.is(FuncType.CoreLazyFunc)) {
            for ai in 1..e.children.len() {
                if e.children[ai].expr_is_comptime(scope).not() { return false }
            }
            return true
        }
        return false
    case .FieldAccess:
        // Issue #57: `Type.<Variant>` (no payload, e.g. `Type.None` produced
        // by make_til_type_expr for primitive type-token args) is a Type
        // metatype value -- pure and comptime.
        if is_type_metatype(e.til_type()) {
            return true
        }
        return false
    case:
        return false
    }
}

// Issue #179 step 5: locate a namespace member's Declaration so the
// caller can read its is_priv flag (find_namespace_func only returns
// the default_value FuncDef Expr).
// #321 step 2: "this type has no such namespace member" is a real state
// -- an Option, not a null ref. (The sdef ARGUMENT is still a nullable
// ref param, a separate step-2 item; a null def simply has no members.)
find_ns_decl := func(sdef: Expr, method: Str) returns Option(ref Declaration) {
    d_o := def_ns_get(sdef, method)
    if d_o.is_none() { return Option(ref Declaration).None }
    ref d : Declaration = d_o.unwrap()
    return Option(ref Declaration).Some(d)
}

priv try_ufcs_rewrite := func(mut scope: TypeScope, mut e: Expr, fa: Expr, mut obj: Expr, method: Str, type_name: Str, mut ctx: Context) returns Bool {
    // Top-level `priv` free functions are file-mangled to
    // `priv__<path>__<name>`, and init_rewrite_refs only rewrites Ident
    // references -- not the method name on a UFCS FieldAccess. So
    // `x.priv_helper(...)` arrives here with the bare name while the
    // binding lives under the mangled name. Retry the lookup mangled so
    // priv free functions are UFCS-callable in their own file (the U in
    // UFCS is universal). cross-file priv access is still rejected later
    // by check_priv_access.
    mut lookup_name := method.clone()
    mut top_o := scope.get_binding(method)
    if top_o.is_none() {
        mangled := priv_c_name(ctx.path, method)
        top_o = scope.get_binding(mangled)
        if top_o.is_some() { lookup_name = mangled.clone() }
    }
    mut ufcs_match : I32 = 0
    if top_o.is_some() {
        ref top : TypeBinding = top_o.unwrap()
        top_fd_o := scope.lookup_func(top.name)
        if top_fd_o.is_some() {
            ref top_fd : Expr = top_fd_o.unwrap()
            switch top_fd.node_type {
            case .FuncDef(top_fdef):
                if top_fdef.params.len() > 0 {
                    ref first_param : Str = top_fdef.params[0].explicit_type
                    if first_param.len() > 0 {
                        // Only a genuine free-function *declaration* is
                        // UFCS-callable; a func-pointer value bound to the
                        // same sig (is_func_decl false) must not match, even
                        // though the sig's own FuncDef is a Func.
                        top_ft := binding_func_type(top)
                        is_free_func := top.is_func_decl.and(
                            or(top_ft.is(FuncType.Func),
                               top_ft.is(FuncType.ExtFunc),
                               top_ft.is(FuncType.Proc),
                               top_ft.is(FuncType.ExtProc),
                               top_ft.is(FuncType.CoreFunc),
                               top_ft.is(FuncType.CoreProc),
                               top_ft.is(FuncType.CoreLazyFunc)))
                        if type_name.len() > 0 {
                            if first_param == type_name {
                                ufcs_match = 1
                            } else if first_param.eq("Dynamic").and(is_free_func) {
                                ufcs_match = 1
                            }
                        } else if obj.til_type().is(Type.Dynamic) {
                            pt := type_from_name(first_param, scope, ctx)
                            narrow_dynamic(obj, pt)
                            ufcs_match = 1
                        }
                    }
                }
            case:
            }
        }
    }
    if ufcs_match == 0 { return false }
    mut fn_ident := Expr.new(ident_node(lookup_name), fa.line, fa.col)
    mut new_children := Vec(Expr).new()
    new_children.push(own fn_ident)
    // Move the receiver out of the old callee `fa` (slot 0) instead of
    // cloning it: push_take zeroes fa's slot so the trailing
    // `e.children = new_children` FieldAssign frees the old callee --
    // including its FieldAccess method-name Str -- without leaking and
    // without an extra clone of the receiver subtree. #109.
    new_children.push_take(e.children[0].children, 0)
    for i in 1..e.children.len() {
        new_children.push_take(e.children, i)
    }
    e.children = new_children
    return true
}

// Resolve the FunctionDef Expr that describes the callee signature for an
// FCall, by walking the AST + scope rather than reading a cached field.
// Mirrors the four FuncPtr-indirect cases the typer used to handle:
//   1/2. callee is FieldAccess on a struct whose field has a FuncSig type
//   3.   callee is an Ident bound to a FuncPtr local/param
//   4.   callee is an Ident for a regular func that returns a FuncSig
// Returns NULL when the binding is not in `scope` (e.g. param/local at
// builder time after func_scope was destroyed). Callers that need to
// resolve those cases must layer their own fallback on top.
// #321 step 2: every miss path in this resolver was a null ref; they
// are all "no funcsig for this callee", a real state -> Option.
resolve_fn_sig := func(fcall: Expr, scope: TypeScope) returns Option(ref Expr) {
    if fcall.node_type.is(NodeType.FCall).not() { return Option(ref Expr).None }
    if fcall.children.len() == 0 { return Option(ref Expr).None }
    ref callee : Expr = fcall.children[0]
    switch callee.node_type {
    case .FCall:
        // Calling a call's result: the inner call's own type names the
        // signature. Without this the builder's indirect-call emit had no
        // signature to work from and fell through to its Ident-only path.
        sig_nm_o := expr_type_name_ref(callee)
        if sig_nm_o.is_none() { return Option(ref Expr).None }
        ref sig_nm : Str = sig_nm_o.unwrap()
        snb_o := scope.get_binding(sig_nm)
        if snb_o.is_none() { return Option(ref Expr).None }
        snb_fd_o := scope.lookup_func(snb_o.unwrap().name)
        if snb_fd_o.is_none() { return Option(ref Expr).None }
        if snb_fd_o.unwrap().children.len() != 0 { return Option(ref Expr).None }
        return snb_fd_o
    case .Ident(name):
        cb_o := scope.get_binding(name.ident_name())
        if cb_o.is_none() { return Option(ref Expr).None }
        ref cb : TypeBinding = cb_o.unwrap()
        if cb.type.is_funcptr().not() { return Option(ref Expr).None }
        cb_fd_o := scope.lookup_func(cb.name)
        if cb_fd_o.is_none() { return Option(ref Expr).None }
        ref cb_fd : Expr = cb_fd_o.unwrap()
        // A func-pointer value (not a function declaration) carries a
        // signature func_def: hand it back directly.
        if cb.is_func_decl.not() {
            return Option(ref Expr).Some(cb_fd)
        }
        switch cb_fd.node_type {
        case .FuncDef(cb_fdef):
            if cb_fdef.return_type.len() == 0 { return Option(ref Expr).None }
            rsb_o := scope.get_binding(cb_fdef.return_type)
            if rsb_o.is_none() { return Option(ref Expr).None }
            ref rsb : TypeBinding = rsb_o.unwrap()
            rsb_fd_o := scope.lookup_func(rsb.name)
            if rsb_fd_o.is_none() { return Option(ref Expr).None }
            if rsb_fd_o.unwrap().children.len() != 0 { return Option(ref Expr).None }
            return rsb_fd_o
        case:
        }
        return Option(ref Expr).None
    case .FieldAccess(method):
        if callee.children.len() == 0 { return Option(ref Expr).None }
        sname_o := expr_type_name_ref(callee.children[0])
        if sname_o.is_none() { return Option(ref Expr).None }
        ref sname : Str = sname_o.unwrap()
        sdef_o := scope.get_struct(sname)
        if sdef_o.is_none() { return Option(ref Expr).None }
        ref sdef : Expr = sdef_o.unwrap()
        switch sdef.node_type {
        case .StructDef(sdd):
            fd_o := member_get(sdd.fields_index, sdd.fields, method.field_access_name())
            if fd_o.is_some() {
                ref fd : Declaration = fd_o.unwrap()
                // Issue #58 / #147 step 5: read the FuncSig alias name
                // from fd.til_type's FuncPtrSig payload (set by
                // type_from_name at field-typing time) instead of
                // fd.explicit_type + get_binding indirection.
                fsig_name := til_type_name(fd.til_type)
                if fsig_name.len() > 0 {
                    ftb_fd_o := scope.lookup_func(fsig_name)
                    if ftb_fd_o.is_some() {
                        if ftb_fd_o.unwrap().children.len() == 0 { return ftb_fd_o }
                    }
                }
            }
        case:
        }
        return Option(ref Expr).None
    case:
        return Option(ref Expr).None
    }
}

// #168 step 2: true when an FCall yields a by-value result that a `ref`
// cannot borrow -- i.e. the callee returns Own (heap value the caller owns)
// OR Shallow (a stack value: a primitive, or an issue #223 auto-shallow
// struct). Only a `returns ref T` callee yields a borrowable pointer, so the
// predicate is "return_own_type is not Ref". A struct/enum constructor always
// produces a fresh owned value. Recognised callee shapes:
//   - Ident("foo")     -> scope binding's func_def.return_own_type
//   - Type.method(...) -> namespace lookup on the type's def
//   - obj.method(...)  -> namespace lookup on the receiver's type def
// A callee whose return is a fresh by-value result a `ref` cannot borrow:
// either an Own return, or (issue #223) a Shallow-returning callee whose
// return type is a STRUCT/ENUM. A Shallow primitive return (I64, ...) is
// left out: `ref x : I64 = f()` predates auto-shallow and other code relies
// on the existing classification; only the struct case is newly value-typed.
priv fdef_returns_unborrowable := func(fd: FunctionDef, scope: TypeScope) returns Bool {
    if fd.return_own_type.is(OwnType.Own) { return true }
    if fd.return_own_type.is(OwnType.Shallow) {
        rt := type_from_name_init(fd.return_type, scope)
        if rt.is(Type.Struct).or(rt.is(Type.Enum)) { return is_primitive(rt).not() }
    }
    return false
}

fcall_returns_own := func(fcall: Expr, scope: TypeScope) returns Bool {
    if fcall.node_type.is(NodeType.FCall).not() { return false }
    if fcall.children.len() == 0 { return false }
    ref callee : Expr = fcall.children[0]
    switch callee.node_type {
    case .Ident(cn):
        // Struct/enum constructor: `Foo(...)` where Foo is a registered
        // struct/enum type. The result is a freshly-constructed owned value.
        if scope.get_struct(cn.ident_name()).is_some() { return true }
        cb_o := scope.get_binding(cn.ident_name())
        if cb_o.is_none() { return false }
        ref cb : TypeBinding = cb_o.unwrap()
        cb_fd_o := scope.lookup_func(cb.name)
        if cb_fd_o.is_none() { return false }
        switch cb_fd_o.unwrap().node_type {
        case .FuncDef(cfd):
            return fdef_returns_unborrowable(cfd, scope)
        case:
        }
        return false
    case .FieldAccess(cfa):
        // Type-name dispatch: Type.method(args). Receiver Ident is the type.
        if fa_is_ns(callee, scope) {
            switch callee.children[0].node_type {
            case .Ident(cti):
                sdef_o := scope.get_struct(cti.ident_name())
                if sdef_o.is_none() { return false }
                mo := find_namespace_func(sdef_o.unwrap(), cfa.field_access_name(), scope)
                if mo.is_none() { return false }
                ref method : Expr = mo.unwrap()
                switch method.node_type {
                case .FuncDef(ffd):
                    return fdef_returns_unborrowable(ffd, scope)
                case:
                }
                return false
            case:
            }
        }
        // UFCS / instance method: obj.method(args). Resolve via receiver's type.
        if callee.children.len() > 0 {
            sname_o := expr_type_name_ref(callee.children[0])
            if sname_o.is_none() { return false }
            ref sname : Str = sname_o.unwrap()
            sdef_o := scope.get_struct(sname)
            if sdef_o.is_none() { return false }
            mo2 := find_namespace_func(sdef_o.unwrap(), cfa.field_access_name(), scope)
            if mo2.is_none() { return false }
            ref method : Expr = mo2.unwrap()
            switch method.node_type {
            case .FuncDef(ffd):
                return fdef_returns_unborrowable(ffd, scope)
            case:
            }
        }
        return false
    case:
    }
    return false
}

// #168 step 1+2: ref bindings cannot be initialized from an owned value --
// the value would be heap-allocated with no owner. Step 1 caught literal
// `.clone()`; step 2 generalises to any FCall whose callee returns
// `OwnType.Own` (constructors, take_* helpers, factory funcs, etc.).
// Future steps broaden the surface (struct field defaults, assignments,
// ref-typed returns).
priv check_ref_decl_owned_init := proc(stmt: Expr, scope: TypeScope, mut ctx: Context) {
    if stmt.children.len() == 0 { return }
    switch stmt.node_type {
    case .Decl(sdecl):
        if sdecl.own_type.is(OwnType.Ref).not() { return }
        ref rhs : Expr = stmt.children[0]
        if rhs.node_type.is(NodeType.FCall).not() { return }
        if fcall_is_raw_alloc(rhs) { return }
        if fcall_returns_own(rhs, scope).not() { return }
        stmt.type_error(format("ref binding '", sdecl.name, "' cannot be initialized from an owned value (.clone() / constructor / function returning own) -- use 'own' to keep the value, or borrow the source directly"), ctx)
    case:
    }
}

// #168 step 3: struct field defaults follow the same predicate -- a
// `ref` field cannot have an owned-RHS default. #321 step 2 retires
// the old forced exception for `= NULL`: a nullable borrow is an
// Option(ref T) field now that the niche makes it pointer-sized, so a
// NULL default is rejected too -- the field either becomes mandatory
// (no default; an instance to borrow from exists at ctor time) or an
// Option with a real None state. The one exemption is the Dynamic
// quarantine, resolved through aliases: a `ref Dynamic` field is a raw
// pointer whose null IS a legal value by design (doc/ownership.org's
// manual-memory island).
priv check_ref_field_owned_default := proc(fname: Str, fd: Declaration, mut scope: TypeScope, mut ctx: Context) {
    if fd.own_type.is(OwnType.Ref).not() { return }
    if fd.default_value.is_none() { return }
    if fd.default_expr().node_type.is_literal_null() {
        if fd.explicit_type.len().gt(0)
            .and(type_from_name(fd.explicit_type, scope, ctx).is(Type.Dynamic)) { return }
        fd.default_expr().type_error(format("ref field '", fname, "' cannot default to a null pointer (`0` at a Dynamic slot) -- use Option(ref T) for a real absent state, drop the default to make the field mandatory, or 'ref Dynamic' at a raw C boundary"), ctx)
        return
    }
    if fd.default_expr().node_type.is(NodeType.FCall).not() { return }
    if fcall_returns_own(fd.default_expr(), scope).not() { return }
    fd.default_expr().type_error(format("ref field '", fname, "' default cannot be an owned value (.clone() / constructor / function returning own) -- use Option(ref T), drop the default, or change the field to 'own'"), ctx)
}

// #168 step 4: assignments to ref-typed lvalues follow the same
// predicate. Catches the original FCallData.fn_sig motivating case
// (`fcd.fn_sig = src.clone()` where fn_sig was `ref mut Expr = NULL`).
// Caller passes the resolved target name (just for the diagnostic) and
// the rhs Expr; the predicate is the same as steps 1-3.
priv check_ref_assign_owned_rhs := proc(stmt: Expr, target_name: Str, rhs: Expr, scope: TypeScope, mut ctx: Context) {
    if rhs.node_type.is(NodeType.FCall).not() { return }
    if fcall_returns_own(rhs, scope).not() { return }
    stmt.type_error(format("ref target '", target_name, "' cannot be assigned an owned value (.clone() / constructor / function returning own) -- borrow the source directly, or change the target to 'own'/'mut'")
    , ctx)
}

// #168 step 1b / #177: ref bindings cannot be initialized to null. A
// `ref` slot initialized to null is structurally an uninitialized
// borrow; every legitimate use is rewritable as the borrow at the
// point you actually have it, as a sentinel value, or as a Context
// field on a longer-lived owner.
//
// Struct field defaults used to be the allowed exception (no
// instance to point at yet); #321 step 2 closed it --
// check_ref_field_owned_default rejects a null default there too,
// Dynamic quarantine fields excepted.
//
// Module-scope globals were the original conservative carve-out; the
// 8 remaining sites flagged in #177 (interpreter cached_*_def/_name,
// builder current_fdef, typer current_struct_def) all migrated to
// Context fields. Module scope now enforces the same rule as locals.
//
// #321: the NULL keyword is gone, so the only source spelling that
// reaches here is `ref x : Dynamic = 0` -- the message names that, not
// a keyword the user cannot type.
priv check_ref_local_null_init := proc(stmt: Expr, mut ctx: Context) {
    if stmt.children.len() == 0 { return }
    switch stmt.node_type {
    case .Decl(sdecl):
        if sdecl.own_type.is(OwnType.Ref).not() { return }
        ref rhs : Expr = stmt.children[0]
        if rhs.node_type.is_literal_null().not() { return }
        stmt.type_error(format("ref binding '", sdecl.name, "' cannot be initialized to a null pointer (`0` at a Dynamic slot) -- borrow the source directly, or use a non-ref shape (own/mut + sentinel)"), ctx)
    case:
    }
}

priv infer_func_ptr_field_call := proc(mut scope: TypeScope, mut e: Expr, mut fa: Expr, obj: Expr, sdef: Expr, method: Str, in_func: I32, mut ctx: Context) returns Bool {
    if obj.til_type().is(Type.Struct).not().and(obj.til_type().is(Type.Enum).not()) { return false }
    switch sdef.node_type {
    case .StructDef(fpf_sdd):
        fd_o := member_get(fpf_sdd.fields_index, fpf_sdd.fields, method)
        if fd_o.is_some() {
            ref fd : Declaration = fd_o.unwrap()
            if fd.til_type.is(Type.Body) {
                fa.set_til_type(Type.Body)
                nargs := e.children.len() - 1
                if nargs != 0 {
                    e.type_error(format("Body field '", method, "' expects 0 args, got ", nargs.to_str()), ctx)
                }
                if in_func != 0 {
                    e.type_error(format("func cannot call Body field '", method, "'"), ctx)
                } else if ctx.proc_def_depth > 0 {
                    ctx.proc_calls_count = ctx.proc_calls_count + 1
                }
                e.set_til_type(Type.None)
                return true
            }
            // Issue #58 / #147 step 5: read the FuncSig alias name from
            // fd.til_type's FuncPtrSig payload instead of fd.explicit_type
            // + scope.find indirection.
            fpf_sig_name := til_type_name(fd.til_type)
            if fpf_sig_name.len() == 0 { return false }
            ftb_fd_o := scope.lookup_func(fpf_sig_name)
            if ftb_fd_o.is_none() { return false }
            ref ftb_fd : Expr = ftb_fd_o.unwrap()
            if ftb_fd.children.len().neq(0) { return false }
            fa.set_til_type(Type.FuncPtr)
            ref sig : Expr = ftb_fd
            mut nargs : USize = e.children.len()
            nargs--
            ref sig_fdef : FunctionDef = funcdef_of(sig)
            if nargs != sig_fdef.params.len() {
                e.type_error(format("function pointer field '", method, "' expects ", sig_fdef.params.len().to_str(), " args, got ", nargs.to_str()), ctx)
            }
            mut ai : USize = 0
            while ai < nargs {
                if ai >= sig_fdef.params.len() { break }
                infer_expr(scope, e.children[ai + 1], in_func, ctx)
                ai++
            }
            if sig_fdef.return_type.len() > 0 {
                e.set_til_type(type_from_name(sig_fdef.return_type, scope, ctx))
            } else {
                e.set_til_type(Type.None)
            }
            return true
        }
    case:
    }
    return false
}

// True when `e` is a `.clone()` method call (either UFCS form
// `x.clone()` or the desugared namespace form `Type.clone(x)`): an FCall
// whose callee is a FieldAccess named "clone".
is_clone_fcall := func(e: Expr) returns Bool {
    if e.node_type.is(NodeType.FCall).not() { return false }
    if e.children.len() == 0 { return false }
    switch e.children[0].node_type {
    case .FieldAccess(cfa):
        return cfa.field_access_name() == "clone"
    case:
        return false
    }
}

priv validate_fcall_own_args_for_fdef := proc(mut scope: TypeScope, e: Expr, fdef_data: FunctionDef, mut ctx: Context) {
        fvi := fdef_data.variadic_index
        fkwi := fdef_data.kwargs_index
        mut fvc : USize = 0
        if fvi >= 0 {
            fvc = fcall_variadic_count(e, fdef_data.params.len(), fkwi >= 0)
        }
        mut fkc : USize = 0
        if fkwi >= 0 {
            fkc = fcall_kwargs_count(e)
        }
        mut ci : USize = 1
        mut pi : USize = 0
        while pi < fdef_data.params.len() {
            if ci >= e.children.len() { break }
            if fvi >= 0 {
                if pi.to_i32() == fvi {
                    ci = ci + fvc
                    pi++
                    continue
                }
            }
            if fkwi >= 0 {
                if pi.to_i32() == fkwi {
                    ci = ci + fkc
                    pi++
                    continue
                }
            }
            ref pp2 : Declaration = fdef_data.params[pi]
            pown := pp2.own_type.is(OwnType.Own)
            ref arg : Expr = e.children[ci]
            // A `.clone()` passed to an immutable ref (borrow) parameter
            // is pure waste: the callee only borrows, so the fresh copy
            // is allocated and dropped without ever being retained or
            // mutated. Pass the value directly. (Own params legitimately
            // consume the clone; ref-mut params may mutate the copy.)
            if pp2.own_type.is(OwnType.Ref).and(pp2.is_mut.not()) {
                if arg.is_clone_fcall() {
                    arg.type_error(format("redundant '.clone()': parameter '", pp2.name, "' is a ref (borrow); pass the value directly"), ctx)
                }
            }
            if pown {
                if get_own_arg(e, ci).not() {
                    arg.type_error(format("argument for 'own' parameter '", pp2.name, "' must be marked 'own'"), ctx)
                }
                cap_name := closure_borrowed_capture_name(arg, scope)
                if cap_name.len() > 0 {
                    arg.type_error(format("own argument closure borrows captured local '", cap_name,
                        "'; capture it as 'own ", cap_name, "' or 'shallow ", cap_name,
                        "' if the closure escapes"), ctx)
                }
            } else if get_own_arg(e, ci) {
                arg.type_error(format("'own' on argument but parameter '", pp2.name, "' is not 'own'"), ctx)
            }
            if pown {
                switch arg.node_type {
                case .Ident(an):
                    sf_ab := scope.find(an.ident_name())
                    switch sf_ab {
                    case .Found(ab):
                        if ab.own_type.is(OwnType.Ref) {
                            arg.type_error("cannot pass ref variable to 'own' parameter; use .clone() to make an owned copy", ctx)
                        }
                    case:
                    }
                    // #164: passing an Ident as `own` consumes the binding
                    // (ownership transfer). The source's `mut` is what
                    // keeps the binding from auto-aliasing into a ref, so
                    // count this as a write-through.
                    mut own_arg_b_o := scope.get_binding(an.ident_name())
                    if own_arg_b_o.is_some() {
                        ref mut own_arg_b : TypeBinding = own_arg_b_o.unwrap()
                        own_arg_b.written = true
                    }
                case .FieldAccess:
                    // #324: the same rule for a ref FIELD. A `ref` field is
                    // precisely the one its holder must NOT free
                    // (doc/ownership.org) -- passing it to an `own`
                    // parameter transfers an ownership the field never had.
                    // The Ident arm above has rejected this for ref
                    // VARIABLES all along; fields just slipped past. Broad
                    // on purpose: every field this flagged in-tree was an
                    // owned pointer wearing a ref label, and each has been
                    // relabeled (the Scope trio, InterpCallableBox.env,
                    // FFIEntry's buffers, FFITypePtrBox.ptr).
                    if fa_own_type(arg, scope).is(OwnType.Ref) {
                        arg.type_error("cannot pass ref field to 'own' parameter; the holder does not own it -- use .clone(), or relabel the field if it is really owned", ctx)
                    }
                case:
                }
            }
            if pown {
                if arg.node_type.is_literal_null() {
                    arg.type_error("cannot pass null to 'own' parameter", ctx)
                }
            }
            if pp2.own_type.is(OwnType.Shallow) {
                if arg.node_type.is_literal_null() {
                    arg.type_error("cannot pass null to 'shallow' parameter", ctx)
                }
            }
            // #321 step 4: null is the quarantine's literal. A borrowed
            // param of any other type cannot receive it -- the maybe-absent
            // argument is an Option(ref T). (own/shallow params error above
            // on ownership grounds; this closes the remaining ref/plain
            // params.)
            if pp2.own_type.is(OwnType.Own).not().and(pp2.own_type.is(OwnType.Shallow).not()) {
                if arg.node_type.is_literal_null() {
                    if type_is_null_quarantine(type_from_name(pp2.explicit_type, scope, ctx)).not() {
                        arg.type_error(format("cannot pass a null pointer to typed parameter '", pp2.name, "'; null is quarantine-only (Dynamic / the U8-I8 raw labels, where it is spelled `0`) -- pass an Option(ref T) instead (#321)"), ctx)
                    }
                }
            }
            ci++
            pi++
        }
}

priv validate_fcall_own_args := proc(mut scope: TypeScope, e: Expr, fdef_o: Option(ref Expr), mut ctx: Context) {
    if fdef_o.is_none() { return }
    ref fdef_data : FunctionDef = funcdef_of(fdef_o.unwrap())
    validate_fcall_own_args_for_fdef(scope, e, fdef_data, ctx)
}

priv set_fcall_own_args_for_own_params := func(mut e: Expr, fdef_data: FunctionDef) {
    fvi := fdef_data.variadic_index
    fkwi := fdef_data.kwargs_index
    mut fvc : USize = 0
    if fvi >= 0 {
        fvc = fcall_variadic_count(e, fdef_data.params.len(), fkwi >= 0)
    }
    mut fkc : USize = 0
    if fkwi >= 0 {
        fkc = fcall_kwargs_count(e)
    }
    mut ci : USize = 1
    mut pi : USize = 0
    while pi < fdef_data.params.len() {
        if ci >= e.children.len() { break }
        if fvi >= 0 {
            if pi.to_i32() == fvi {
                ci = ci + fvc
                pi++
                continue
            }
        }
        if fkwi >= 0 {
            if pi.to_i32() == fkwi {
                ci = ci + fkc
                pi++
                continue
            }
        }
        if fdef_data.params[pi].own_type.is(OwnType.Own) { set_own_arg(e, ci) }
        ci++
        pi++
    }
}

priv infer_struct_constructor_fcall := proc(mut scope: TypeScope, mut e: Expr, name: Str, in_func: I32, mut ctx: Context) returns Bool {
    mut sdef_o := scope.get_struct(name)
    if sdef_o.is_none() { return false }
    ref mut sdef : Expr = sdef_o.unwrap()
    return infer_struct_constructor_fcall_impl(scope, sdef, e, name, in_func, ctx)
}

// Field init shorthand: in a struct literal, a bare identifier that
// names a field stands for `field = field`, so `User(name, pass)` means
// `User(name = name, pass = pass)`. Same rule as Rust's (RFC 1682): it
// is purely name coincidence -- shorthand and explicit `field = value`
// args mix freely and order never mattered, because a struct literal is
// name-keyed, not positional.
//
// Rewriting into NamedArg here, rather than in the parser, is what makes
// the rule safe: the parser cannot tell `User(name)` (a struct literal)
// from `f(name)` (an ordinary call), and only this path knows the callee
// is a struct with a field of that name. Everything downstream -- priv
// checks, the null quarantine, interface boxing, duplicate detection --
// then sees an ordinary named argument.
//
// A bare identifier that matches NO field is left alone and still gets
// "struct instantiation requires named arguments": positional struct
// args have never been accepted, so there is no spelling this rewrite
// can silently change the meaning of.
priv rewrite_ctor_field_shorthand := func(ctor_sdd: StructDef, mut e: Expr) {
    for i in 1..e.children.len() {
        mut fname := ""
        switch e.children[i].node_type {
        case .Ident(id):
            if ctor_sdd.fields_index.has(id.ident_name()) { fname = Str.clone(id.ident_name()) }
        case:
        }
        if fname.len() == 0 { continue }
        line := e.children[i].line
        col := e.children[i].col
        mut named := Expr.new(NodeType.NamedArg(fname.clone()), line, col)
        named.add_child(own e.children[i].clone())
        e.children[i] = named
    }
}

priv infer_struct_constructor_fcall_impl := proc(mut scope: TypeScope, mut sdef: Expr, mut e: Expr, name: Str, in_func: I32, mut ctx: Context) returns Bool {
    // #187 step 1: mark the struct binding as used so a priv struct
    // that is only ever instantiated (no namespace method calls) is
    // not misreported as dead. Skip when current_type_name matches
    // the struct itself: that's an internal constructor inside the
    // struct's own auto-generated or user-written ns methods, which
    // does not count as "used externally".
    if ctx.current_type_name.eq(name).not() {
        mut sb_used_o := scope.get_binding(name)
        if sb_used_o.is_some() {
            ref mut sb_used : TypeBinding = sb_used_o.unwrap()
            sb_used.used = true
        }
    }
    // #154: constructing a cross-file type counts as a use of its import.
    note_cross_file_type_use(scope, ctx, name)
    sf_sb := scope.find(name)
    switch sf_sb {
    case .Found(sb):
        if sb.is_builtin {
            e.type_error(format("cannot instantiate builtin type '", name, "'"), ctx)
            e.set_til_type(Type.Unknown)
            return true
        }
        check_priv_access(e, name, sb, ctx)
    case:
    }

    // #99: if struct has new(), disallow literal outside its namespace
    if ctx.current_type_name.eq(name).not() {
        if def_ns_has(sdef, "new") {
            e.type_error(format("struct '", name, "' has a new() constructor; use ", name, ".new(...) instead"), ctx)
            e.set_til_type(Type.Struct(name.clone()))
            return true
        }
    }

    ref mut ctor_sdd : StructDef = structdef_of(sdef)
    nfields := ctor_sdd.fields.len()
    rewrite_ctor_field_shorthand(ctor_sdd, e)
    mut field_vals := Vec(CtorArg).new()
    for _ in 0..nfields {
        field_vals.push(own CtorArg.Unfilled())
    }
    for i in 1..e.children.len() {
        ref mut arg : Expr = e.children[i]
        switch arg.node_type {
        case .NamedArg(aname):
            // #307: the fields_index maps the arg name straight to its
            // declaration position -- one probe, no name scan.
            mut slot : I32 = -1
            if ctor_sdd.fields_index.has(aname) {
                slot = ctor_sdd.fields_index[aname].to_i32()
            }
            if slot < 0 {
                msg := format("struct '", name, "' has no field '", aname, "'")
                arg.type_error(msg, ctx)
            }
            if slot >= 0 {
                ref mut ctor_fld : Declaration = ctor_sdd.field_at(slot.to_usize())
                check_member_priv(arg, name, aname, ctor_fld.is_priv, ctx)
                if ctx.auto_gen_depth == 0 { ctor_fld.used = true }
                // #321: a 0 arg for a Dynamic field is the null spelling.
                if arg.children.len() > 0 {
                    rewrite_zero_to_null(arg.children[0], type_from_name(ctor_fld.explicit_type, scope, ctx), ctor_fld.own_type.is(OwnType.Own))
                    // #341: `Holder(kind = .Nothing)` -- the field's declared
                    // type is the expected enum.
                    qualify_dotted_expr(arg.children[0], type_from_name(ctor_fld.explicit_type, scope, ctx))
                }
                // #321 step 4: null only fills quarantine-labeled fields.
                if arg.children.len().gt(0).and(arg.children[0].node_type.is_literal_null()) {
                    if type_is_null_quarantine(type_from_name(ctor_fld.explicit_type, scope, ctx)).not() {
                        arg.type_error(format("cannot initialize field '", aname, "' with a null pointer; null is quarantine-only (Dynamic / the U8-I8 raw labels, where it is spelled `0`) -- use an Option field for a real absent state (#321)"), ctx)
                    }
                }
                ref slot_arg : CtorArg = field_vals[slot.to_usize()]
                if slot_arg.is(CtorArg.Filled) {
                    msg := format("duplicate argument for field '", aname, "'")
                    arg.type_error(msg, ctx)
                }
                if slot_arg.is(CtorArg.Filled).not() {
                    // #251 follow-up: a conforming concrete given for an
                    // interface-typed field coerces to an OWNED box -- the
                    // field outlives the ctor call, so a borrow would
                    // dangle. Snapshot before inference desugars a struct
                    // ctor's named args (the box re-infers the snapshot);
                    // box if conforming, else store the value as usual.
                    ref fld_tn : Str = ctor_fld.explicit_type
                    if name_is_interface(fld_tn, scope) {
                        mut fld_snap := arg.children[0].clone()
                        infer_expr(scope, arg.children[0], in_func, ctx)
                        fld_cname_o := expr_type_name_ref(arg.children[0])
                        if fld_cname_o.is_some() {
                            ref fld_cname : Str = fld_cname_o.unwrap()
                            if fld_cname.eq(fld_tn).not().and(type_implements_iface(fld_cname, fld_tn, scope)) {
                                mut fld_box := make_owned_iface_box(fld_tn, fld_cname, own fld_snap, arg.children[0].line, arg.children[0].col)
                                infer_expr(scope, fld_box, in_func, ctx)
                                field_vals[slot.to_usize()] = CtorArg.Filled(fld_box)
                            } else {
                                field_vals[slot.to_usize()] = CtorArg.Filled(own take_expr(arg.children[0]))
                            }
                        } else {
                            field_vals[slot.to_usize()] = CtorArg.Filled(own take_expr(arg.children[0]))
                        }
                    } else {
                        // Moved, not copied: the NamedArg holding this value is
                        // deleted a few lines below when e.children is replaced
                        // by new_ch, so a clone here would be a copy of a node
                        // that is about to be freed.
                        field_vals[slot.to_usize()] = CtorArg.Filled(own take_expr(arg.children[0]))
                    }
                }
            }
        case:
            arg.type_error("struct instantiation requires named arguments", ctx)
            continue
        }
    }
    mut missing_required := false
    for i in 0..nfields {
        if field_vals[i].is(CtorArg.Filled).not() {
            ref fld_d : Declaration = ctor_sdd.field_at(i)
            if fld_d.default_value.is_none() {
                // #242: a field with no default is required at
                // instantiation; it must be supplied by name.
                e.type_error(format("missing required field '", ctor_sdd.field_name_at(i), "' in '", name, "(...)'"), ctx)
                missing_required = true
            } else {
                field_vals[i] = CtorArg.Filled(resolve_default_value(fld_d.default_expr(), e, ctx))
            }
        }
    }
    if missing_required {
        // Diagnostic(s) already emitted. Bail before the desugar so the
        // build loop below doesn't trip over the unfilled slot(s); set a
        // sensible type so the typer keeps reporting later errors.
        e.set_til_type(Type.Struct(resolve_type_alias(scope, name).clone()))
        return true
    }
    mut new_ch := Vec(Expr).new()
    new_ch.push_take(e.children, 0)
    for mut fv : CtorArg in field_vals {
        switch fv {
        case .Filled(filled_arg):
            // Moved out of the payload: field_vals is a local that dies at the
            // end of this call, so cloning here copied every argument subtree
            // only to free the original a statement later.
            new_ch.push(own take_expr(filled_arg))
        case:
            UNREACHABLE("expected CtorArg.Filled, got ", fv.to_str())
        }
    }
    e.children = new_ch
    for i in 1..e.children.len() {
        // Issue #295: a FuncDef's til_type is FuncPtr (not Unknown),
        // so a capturing-closure arg would skip inference and its body
        // would never be typed against this (enclosing) scope -- losing the
        // captured variables' types in codegen. Infer capturing closures
        // here too so `n.add(1)` etc. resolve against the live scope.
        ref mut ci : Expr = e.children[i]
        mut needs_infer := ci.til_type().is(Type.Unknown)
        switch ci.node_type {
        case .FuncDef(ci_fd): if ci_fd.captures.len() > 0 { needs_infer = true }
        case .BodyValue: needs_infer = true
        case:
        }
        if needs_infer {
            infer_expr(scope, ci, in_func, ctx)
        }
    }
    for fi in 0..nfields {
        if fi >= e.children.len() - 1 { break }
        ref fld_decl : Declaration = ctor_sdd.field_at(fi)
        ai := fi + 1
        if fld_decl.own_type.is(OwnType.Ref) { continue }
        if fld_decl.own_type.is(OwnType.Own).not() {
            if type_ctor_consumes(fld_decl.til_type).not() { continue }
        }
        set_own_arg(e, ai)
    }
    e.set_til_type(Type.Struct(resolve_type_alias(scope, name).clone()))
    return true
}

// Issue #281: materialize one parameter/field default value for a call/ctor
// fill site. If the default is the __LOC__ sentinel, resolve it to a Str
// literal holding the CALL SITE's location (the call/ctor Expr's coords + the
// file currently being typed, ctx.path -- the caller's file); otherwise clone
// the default as before. This is what makes a defaulted `loc: Str = __LOC__`
// report the caller. Keyed on the default VALUE, never on the callee's name,
// so any user func/proc/struct field gets the behavior.
resolve_default_value := func(default_value: Expr, call_expr: Expr, ctx: Context) returns Expr {
    if default_value.node_type.is(NodeType.Loc) {
        loc_str := format(ctx.path, ":", call_expr.line.to_str(), ":", call_expr.col.to_str())
        return Expr.new(NodeType.Literal(Literal.Str(loc_str)), call_expr.line, call_expr.col)
    }
    return default_value.clone()
}

// #269: is `name` an interface type (a StructDef flagged is_interface)?
priv name_is_interface := func(name: Str, scope: TypeScope) returns Bool {
    d_o := scope.get_struct(name)
    if d_o.is_none() { return false }
    ref d : Expr = d_o.unwrap()
    switch d.node_type {
    case .StructDef(sdd):
        return sdd.is_interface
    case:
        return false
    }
}

// #269: does concrete type `cname` declare `implements iface`?
priv type_implements_iface := func(cname: Str, iface: Str, scope: TypeScope) returns Bool {
    d_o := scope.get_struct(cname)
    if d_o.is_none() { return false }
    ref d : Expr = d_o.unwrap()
    switch d.node_type {
    case .StructDef(sdd):
        return sdd.implements_name == iface
    case .EnumDef(edd):
        return edd.implements_name == iface
    case:
        return false
    }
}

// Validate a single argument against its parameter's type. Narrows
// numeric literals to fit the param type, applies implicit widen /
// usize-coerce, and emits a type_error on mismatch. Skips Dynamic-typed
// args (the caller has already decided this arg is not constrained).
priv validate_fcall_arg := proc(mut arg: Expr, ptype: Type, ptype_name: Str, param_name: Str, mut ctx: Context) {
    // #269: accept a conforming concrete type where an interface is expected.
    // The #251 conformance check guarantees the methods exist; the runtime
    // dispatches the method call to the concrete type. (Interpreter path
    // first; compiled dispatch via a box is the follow-up.)
    if name_is_interface(ptype_name, ctx.scope) {
        arg_cname_o := expr_type_name_ref(arg)
        if arg_cname_o.is_some() {
            ref arg_cname : Str = arg_cname_o.unwrap()
            if type_implements_iface(arg_cname, ptype_name, ctx.scope) { return }
        }
    }
    if arg.til_type().is(Type.Dynamic) { return }
    if arg.til_type().is(Type.Unknown) { return }
    switch arg.node_type {
    case .Literal(Literal.Num(lit_str)):
        if is_numeric_type(ptype) {
            if literal_in_range(lit_str.literal_num_text(), ptype).not() {
                arg.type_error(format("integer literal ", Str.clone(lit_str.literal_num_text()), " out of range for ", type_to_name(ptype)), ctx)
            }
            arg.set_til_type(ptype)
            return
        }
    case:
    }
    // Issue #224: implicit integer widening of non-literal arguments at
    // call sites is no longer allowed. A numeric literal still adopts the
    // param type via the Literal branch above; any runtime value that needs
    // a wider type must say so with an explicit `.cast(T)`. The USize/UPtr
    // coercion is intentionally kept (see can_implicit_usize_coerce).
    if can_implicit_usize_coerce(arg.til_type(), ptype, ptype_name) {
        // ACCEPT, but do NOT re-stamp the argument. The stamp is the
        // expression's own type and downstream readers use it as such:
        // overwriting it with the PARAM's width made `i.cast(U32)` in a
        // UPtr argument position emit/evaluate as a 64-bit cast (I32 -1
        // sign-extended to 0xFFFFFFFFFFFFFFFF instead of reinterpreted to
        // 0xFFFFFFFF), and dressed 32-bit arithmetic as ((U64)(a + b)).
        // The widening to the param's width is done where it belongs: C's
        // implicit conversion at the call in the compiled path, and
        // raw_widen_numeric against the param's declared type in the
        // interpreter.
        return
    }
    // Primitives all share the Type.Primitive tag, so the tag-only is()
    // can't tell them apart (e.g. Primitive(I64) vs Primitive(Bool)).
    // Compare precisely when both sides are primitives.
    mut type_matches := arg.til_type().is(ptype)
    if arg.til_type().is(Type.Primitive).and(ptype.is(Type.Primitive)) {
        type_matches = arg.til_type() == ptype
    }
    // Issue #58 / #147 step 5: FuncPtr / FuncPtrSig live on different
    // tags but are the same family. funcptr_eq applies the wildcard
    // semantic (bare FuncPtr matches any FuncPtrSig; named FuncPtrSig
    // must match exactly).
    if funcptr_eq(arg.til_type(), ptype) {
        type_matches = true
    }
    if type_matches.not().and(is_aggregate(ptype)) {
        arg_sname_for_match_o := expr_type_name_ref(arg)
        if arg_sname_for_match_o.is_some() {
            ref arg_sname_for_match : Str = arg_sname_for_match_o.unwrap()
            if ptype_name.eq(arg_sname_for_match) { type_matches = true }
        }
    }
    if type_matches.not() {
        arg.type_error(format("argument type mismatch for '", param_name, "': expected ", ptype_name, ", got ", type_to_name(arg.til_type())), ctx)
    } else if is_aggregate(ptype) {
        arg_sname_o := expr_type_name_ref(arg)
        if arg_sname_o.is_some() {
            ref arg_sname : Str = arg_sname_o.unwrap()
            if ptype_name.eq(arg_sname).not() {
                arg.type_error(format("argument type mismatch for '", param_name, "': expected ", ptype_name, ", got ", arg_sname), ctx)
            }
        }
}

}

// #342: the splat counterpart of validate_fcall_arg. A `..` argument stands
// for the whole variadic run, so what has to match the parameter is the
// container's ELEMENT type, not the container. Unknown and Dynamic are left
// alone the way the element path leaves them: an earlier diagnostic already
// fired, and piling a second one on it helps nobody.
//
// The element coercion the plain path applies (`format("x", 7)` wrapping the
// I64 in to_str) deliberately does NOT extend here: coercing a splat would
// mean mapping to_str over a runtime-length array, which is a lowering this
// does not have. Saying so is better than the segfault that silence produced.
priv validate_splat_elem_type := proc(scope: TypeScope, arg: Expr, want_name: Str, target: Str, mut ctx: Context) {
    ref at : Type = arg.til_type()
    if at.is(Type.Unknown).or(at.is(Type.Dynamic)) { return }
    src_name := type_to_name(at)
    if src_name.len() == 0 { return }
    ref want : Str = resolve_type_alias_for_name(scope, want_name)
    elem := array_instance_elem_type_name(src_name)
    if elem.eq(want) { return }
    vec_elem := vec_instance_elem_type_name(src_name)
    if vec_elem.len() > 0 {
        arg.type_error(format("'..' splat of '", src_name,
            "': a splat source must be an Array, not a Vec (the block is folded with Array.concat)"), ctx)
        return
    }
    mut got := format("'", src_name, "'")
    if elem.len() > 0 { got = format("'", src_name, "', whose elements are '", elem, "'") }
    arg.type_error(format("'..' splat of ", got, " does not match ", target,
        "; splat an Array of '", want,
        "' (a splat is not coerced element by element the way a plain argument is)"), ctx)
}

priv infer_and_validate_fcall_args_for_fdef := proc(mut scope: TypeScope, mut e: Expr, fdef_data: FunctionDef, in_func: I32, mut ctx: Context) {
        fvi := fdef_data.variadic_index
        fkwi := fdef_data.kwargs_index
        mut fvc : USize = 0
        if fvi >= 0 {
            fvc = fcall_variadic_count(e, fdef_data.params.len(), fkwi >= 0)
        }
        mut fkc : USize = 0
        if fkwi >= 0 {
            fkc = fcall_kwargs_count(e)
        }
        mut ci : USize = 1
        mut pi : USize = 0
        while pi < fdef_data.params.len() {
            if ci >= e.children.len() { break }
            if fvi >= 0 {
                if pi.to_i32() == fvi {
                    ref vparam : Declaration = fdef_data.params[pi]
                    vptype := type_from_name(vparam.explicit_type, scope, ctx)
                    for vk in 0..fvc {
                        rewrite_til_type_arg(scope, e, ci + vk, vptype, in_func, ctx)
                        narrow_dynamic(e.children[ci + vk], vptype)
                    }
                    ci = ci + fvc
                    pi++
                    continue
                }
            }
            if fkwi >= 0 {
                if pi.to_i32() == fkwi {
                    ci = ci + fkc
                    pi++
                    continue
                }
            }
            ref param1 : Declaration = fdef_data.params[pi]
            ref ptype : Str = param1.explicit_type
            ptype_t := type_from_name(ptype, scope, ctx)
            rewrite_til_type_arg(scope, e, ci, ptype_t, in_func, ctx)
            narrow_dynamic(e.children[ci], ptype_t)
            // #164: an arg passed to a `mut` param may be written through,
            // and the callee's signature is what proves it -- so this also
            // covers a `mut self` receiver, whose UFCS call reaches here as
            // `Type.method(recv, ...)` with the receiver at parameter 0.
            // #344: a real mutable borrow travels along borrow provenance.
            // A `Dynamic` param is an untyped raw pointer the callee can
            // write through (move/memcpy/memset/write_ptr/adopt all take
            // Dynamic dests), so treat those conservatively as writes too.
            // That arm is a LINT, not proof of a typed mutable borrow.
            if param1.is_mut.or(ptype_t.is(Type.Dynamic)) {
                mark_written_through(scope, e.children[ci])
            }
            if param1.is_mut {
                check_write_roots_mut(scope, e.children[ci], e.children[ci],
                    format("pass this to the 'mut' parameter '", param1.name, "'"), ctx)
            }
            ci++
            pi++
        }
        ci = 1
        pi = 0
        while pi < fdef_data.params.len() {
            if ci >= e.children.len() { break }
            if fvi >= 0 {
                if pi.to_i32() == fvi {
                    ref vparam : Declaration = fdef_data.params[pi]
                    ref vptype_name : Str = vparam.explicit_type
                    // #342: a splat sharing the variadic block with other
                    // args used to be refused here -- which argument carried
                    // the `..` was recorded nowhere, so the desugar wrapped
                    // the splatted Array as a single element and the callee
                    // read its header bytes as the element type. The parser
                    // now records the position (FCallData.splat_args) and
                    // desugar_mixed_splat_variadic_call folds the block into
                    // one Array, so the mixed form lowers correctly.
                    //
                    // is_splat used to gate the whole block out of validation:
                    // a splatted argument is the run, not an element, so
                    // checking it AS an element would reject every splat. That
                    // left a mismatched one -- `format(..ints)` against
                    // `parts: ..Str` -- unchecked all the way to the callee,
                    // which read each I64 as a Str pointer and segfaulted. The
                    // bitmap now says which argument is which, so each is
                    // checked as what it is.
                    if vptype_name.len() > 0 {
                        vptype := type_from_name(vptype_name, scope, ctx)
                        if vptype.is(Type.Dynamic).not() {
                            is_str_va := vptype_name == "Str"
                            for vk in 0..fvc {
                                if get_splat_arg(e, ci + vk) {
                                    validate_splat_elem_type(scope, e.children[ci + vk], vptype_name,
                                        format("the variadic parameter '", vparam.name, ": ..", vptype_name, "'"), ctx)
                                    continue
                                }
                                if is_str_va {
                                    ref vk_arg : Expr = e.children[ci + vk]
                                    if vk_arg.til_type().is(vptype).not() {
                                        if vk_arg.til_type().is(Type.Dynamic).not().and(vk_arg.til_type().is(Type.Unknown).not()) {
                                            arg_tname := type_to_name(vk_arg.til_type())
                                                if arg_tname.len().gt(0).and(arg_tname.eq("Str").not()) {
                                                    if type_has_to_str(scope, arg_tname) {
                                                        e.children[ci + vk] = make_to_str_call(arg_tname, vk_arg)
                                                        continue
                                                    }
                                            }
                                        }
                                    }
                                }
                                rewrite_til_type_arg(scope, e, ci + vk, vptype, in_func, ctx)
                                validate_fcall_arg(e.children[ci + vk], vptype, vptype_name, vparam.name, ctx)
                            }
                        }
                    }
                    ci = ci + fvc
                    pi++
                    continue
                }
            }
            if fkwi >= 0 {
                if pi.to_i32() == fkwi {
                    ci = ci + fkc
                    pi++
                    continue
                }
            }
            ref param2 : Declaration = fdef_data.params[pi]
            ref ptype_name : Str = param2.explicit_type
            if ptype_name.len() == 0 {
                ci++
                pi++
                continue
            }
            ptype := type_from_name(ptype_name, scope, ctx)
            if ptype.is(Type.Dynamic) {
                ci++
                pi++
                continue
            }
            // #269: a conforming concrete value where an interface is
            // expected coerces by BOXING: the arg is rewritten to
            // `Iface(iface_type_name = "<Concrete>", iface_val = <arg>)`.
            // The concrete type is statically known here, so the box carries
            // the runtime tag that interface method dispatch (dyn_call on
            // the box fields) needs. iface_val is a ref field: the box
            // borrows the value, it does not consume it.
            if name_is_interface(ptype_name, scope) {
                box_cname_o := expr_type_name_ref(e.children[ci])
                if box_cname_o.is_some() {
                    ref box_cname : Str = box_cname_o.unwrap()
                    if box_cname.eq(ptype_name).not().and(type_implements_iface(box_cname, ptype_name, scope)) {
                    box_line := e.children[ci].line
                    box_col := e.children[ci].col
                    mut iface_box := Expr.new(NodeType.FCall(FCallData()), box_line, box_col)
                    iface_box.add_child(own Expr.new(ident_node(ptype_name), box_line, box_col))
                    mut na_tag := Expr.new(NodeType.NamedArg("iface_type_name"), box_line, box_col)
                    na_tag.add_child(own Expr.new(NodeType.Literal(Literal.Str(box_cname.clone())), box_line, box_col))
                    iface_box.add_child(own na_tag)
                    mut na_val := Expr.new(NodeType.NamedArg("iface_val"), box_line, box_col)
                    // Wrap the value in to_ptr so the C backend passes its
                    // ADDRESS into the box's ref-Dynamic field (a struct
                    // local would otherwise be assigned by value).
                    mut val_ptr := Expr.new(NodeType.FCall(FCallData()), box_line, box_col)
                    val_ptr.add_child(own Expr.new(ident_node("to_ptr"), box_line, box_col))
                    val_ptr.add_child(own e.children[ci].clone())
                    na_val.add_child(own val_ptr)
                    iface_box.add_child(own na_val)
                    e.children[ci] = iface_box
                    infer_expr(scope, e.children[ci], in_func, ctx)
                    }
                }
            }
            rewrite_til_type_arg(scope, e, ci, ptype, in_func, ctx)
            validate_fcall_arg(e.children[ci], ptype, ptype_name, param2.name, ctx)
            ci++
            pi++
        }
}

priv infer_and_validate_fcall_args := proc(mut scope: TypeScope, mut e: Expr, callee_bind_o: Option(ref TypeBinding), mut fdef_o: Option(ref Expr), in_func: I32, mut ctx: Context) {
    // Argument inference can instantiate a generic and refresh scope
    // registrations. Snapshot the lookup name before that mutation, then
    // resolve the settled FuncDef once afterward for this function and caller.
    mut cb_name := ""
    if callee_bind_o.is_some() { cb_name = callee_bind_o.unwrap().name.clone() }
    // #341: `f(.Nothing)` -- an argument at an enum-typed parameter. The
    // param type names are snapshotted BEFORE the loop for the same reason
    // cb_name is (see above). Only a call whose arguments line up one for
    // one with the params is qualified: with a variadic or kwargs block the
    // positional mapping is not reliable, and qualifying against the wrong
    // param could silently name a DIFFERENT enum that happens to have the
    // variant. Those keep needing the name written out.
    mut qparam_types := Vec(Str).new()
    if fdef_o.is_some() {
        ref qfd : FunctionDef = funcdef_of(fdef_o.unwrap())
        if qfd.variadic_index.lt(0).and(qfd.kwargs_index.lt(0))
            .and(qfd.params.len().eq(e.children.len() - 1)) {
            for qp : Declaration in qfd.params {
                qparam_types.push(own qp.explicit_type.clone())
            }
        }
    }
    for i in 1..e.children.len() {
        if i - 1 < qparam_types.len() {
            ref qtn : Str = qparam_types[i - 1]
            if qtn.len() > 0 { qualify_dotted_expr(e.children[i], type_from_name(qtn, scope, ctx)) }
        }
        infer_expr(scope, e.children[i], in_func, ctx)
    }
    if cb_name.len() == 0 {
        fdef_o = Option(ref Expr).None
        return
    }
    fdef_o = scope.lookup_func(cb_name)
    if fdef_o.is_none() { return }
    ref fdef_data : FunctionDef = funcdef_of(fdef_o.unwrap())
    infer_and_validate_fcall_args_for_fdef(scope, e, fdef_data, in_func, ctx)
}

priv resolve_fcall_return_type := proc(mut scope: TypeScope, mut e: Expr, name: Str, callee_bind_o: Option(ref TypeBinding), fdef_o: Option(ref Expr), in_func: I32, mut ctx: Context) {
    // #303: stamp noreturn calls at resolution time. lookup_func tracks
    // get_binding's scope walk, so a shadowing local wins over a core
    // function of the same name -- the stamp reflects the callee that
    // actually runs. Read by stmt_always_diverges (context.til) in both
    // the all-paths-return check and the builder's terminator emit.
    if fdef_o.is_some() {
        switch fdef_o.unwrap().node_type {
        case .FuncDef(nr_fd):
            if nr_fd.noreturn {
                switch e.node_type {
                case .FCall(nr_fcd): nr_fcd.noreturn_call = true
                case:
                }
            }
        case:
        }
    }
    if name.eq("dyn_call").or(name.eq("dyn_call_ret")).or(name.eq("dyn_has_method")).or(name.eq("dyn_fn")) {
        if e.children.len() >= 3 {
            ref method_arg : Expr = e.children[2]
            if method_arg.node_type.is_literal_str().not() {
                method_arg.type_error("dyn_call method argument must be a string literal", ctx)
            }
        }
    }
    mut fn_type := Type.Unknown
    mut callee_ft := FuncType.Func
    if callee_bind_o.is_some() {
        ref callee_bind : TypeBinding = callee_bind_o.unwrap()
        fn_type = callee_bind.type.clone()
        callee_ft = binding_func_type(callee_bind)
    }
    if fn_type.is(Type.Unknown) {
        e.type_error(format("undefined function '", name, "'"), ctx)
    }
    if fn_type.is(Type.Body) {
        e.children[0].set_til_type(Type.Body)
        nargs := e.children.len() - 1
        if nargs != 0 {
            e.type_error(format("Body '", name, "' expects 0 args, got ", nargs.to_str()), ctx)
        }
        if in_func != 0 {
            e.type_error(format("func cannot call Body '", name, "'"), ctx)
        } else if ctx.proc_def_depth > 0 {
            ctx.proc_calls_count = ctx.proc_calls_count + 1
        }
        e.set_til_type(Type.None)
        return
    }
    if fn_type.is_funcptr() {
        if callee_bind_o.is_some() {
            ref callee_bind : TypeBinding = callee_bind_o.unwrap()
            // A FuncPtr-typed binding that is a function-pointer value (not a
            // function/sig declaration) is called through its signature.
            if callee_bind.is_func_decl.not() {
                e.children[0].set_til_type(Type.FuncPtr)
                if fdef_o.is_some() {
                    ref cb_fdef : FunctionDef = funcdef_of(fdef_o.unwrap())
                    if cb_fdef.return_type.len() > 0 {
                        ref resolved_return_type : Str = resolve_type_alias(scope, cb_fdef.return_type)
                        rt := type_from_name(resolved_return_type, scope, ctx)
                        e.set_til_type(rt)
                    } else {
                        e.set_til_type(Type.None)
                    }
                } else {
                    e.set_til_type(Type.Dynamic)
                }
                if fdef_o.is_some() {
                    ref sig : Expr = fdef_o.unwrap()
                    ref sig_fdef : FunctionDef = funcdef_of(sig)
                    mut nargs : USize = e.children.len()
                    nargs--
                    if nargs != sig_fdef.params.len() {
                        e.type_error(format("function pointer '", name, "' expects ", sig_fdef.params.len().to_str(), " args, got ", nargs.to_str()), ctx)
                    }
                    mut ai : USize = 0
                    while ai < nargs {
                        if ai >= sig_fdef.params.len() { break }
                        ref arg : Expr = e.children[ai + 1]
                        ref expected_name : Str = sig_fdef.params[ai].explicit_type
                        if expected_name.len() == 0 {
                            ai++
                            continue
                        }
                        expected := type_from_name(expected_name, scope, ctx)
                        if expected.is(Type.Unknown).or(expected.is(Type.Dynamic)) {
                            ai++
                            continue
                        }
                        if arg.til_type().is(Type.Dynamic) {
                            ai++
                            continue
                        }
                        // #58 / #147: use the same wildcard-aware funcptr
                        // comparison validate_fcall_arg uses -- a bare
                        // FuncPtr (e.g. a thunk wrapping a first-class lazy
                        // arg, #262) matches any named FuncPtrSig param.
                        if arg.til_type().is(expected).not().and(funcptr_eq(arg.til_type(), expected).not()) {
                            e.type_error(format("function pointer '", name, "' param ", ai.add(1).to_str(), ": expected ", expected_name, ", got ", type_to_name(arg.til_type())), ctx)
                        }
                        ai++
                    }
                }
                return
            }
        }
    }
    switch fn_type {
    case .Custom(ret_name):
        ref resolved_ret_name : Str = resolve_type_alias(scope, ret_name)
        resolved_ret := type_from_name(resolved_ret_name, scope, ctx)
        if resolved_ret.is(Type.Unknown).not() {
            fn_type = resolved_ret
        }
    case:
    }
    e.set_til_type(fn_type)
    // fn_type (from binding.type) already carries the name payload via
    // Type.Struct(name) or Type.Enum(name) when registered, so
    // no additional struct_name assignment is needed.
    mut debug_exempt := false
    if ctx.mode.debug_prints {
        if name.eq("print").or(name.eq("println")) {
            debug_exempt = true
        }
    }
    if fn_type.is_funcptr().not() {
        if in_func != 0 {
            if callee_ft.is_proc() {
                ctx.proc_calls_count = ctx.proc_calls_count + 1
                if debug_exempt.not() {
                    e.type_error(format("func cannot call proc '", name, "'"), ctx)
                }
            }
        } else if ctx.proc_def_depth > 0 {
            if callee_ft.is_proc() {
                ctx.proc_calls_count = ctx.proc_calls_count + 1
            }
        }
    }
    if callee_ft.is(FuncType.Test) {
        e.type_error(format("test functions cannot be called ('", name, "')"), ctx)
    }
}

// True when `method` is a `to_<X>` conversion whose suffix matches the
// receiver's `type_name` ASCII case-insensitively (e.g. `to_u32` on a
// U32, `to_aaa` on an Aaa). Converting a value to its own type is
// always redundant, so the typer emits a clearer diagnostic than the
// generic "no method 'to_u32' for type 'U32'". The check is purely on
// the call shape: core defines no identity converters (no `to_u32` on
// U32, no `to_str` on Str), so this only ever fires on a mistake.
priv is_self_conversion_method := func(method: Str, type_name: Str) returns Bool {
    if method.starts_with("to_").not() { return false }
    if type_name.len() == 0 { return false }
    suffix_len := method.len() - 3
    if suffix_len.eq(type_name.len()).not() { return false }
    for i in 0..suffix_len {
        ref mc : I8 = method.get(i + 3)
        ref tc : I8 = type_name.get(i)
        if mc == tc { continue }
        if tc.gte('A').and(tc.lte('Z')) {
            if tc + 32 == mc { continue }
        }
        return false
    }
    return true
}

// For methods like `obj.foo(...)`: returns the type-name lookup key
// (a primitive's c_name, a struct/enum payload name, or "" when no
// match). Used by infer_field_access_fcall to find the namespace.
// Avoids the `mut type_name := ""; type_name = ...` reassign pattern
// that leaked the empty Str default.
priv obj_method_type_name := func(obj: Expr) returns Str {
    if is_primitive(obj.til_type()) {
        return til_type_name_c(obj.til_type())
    }
    if is_aggregate(obj.til_type()) {
        type_name_o := expr_type_name_ref(obj)
        if type_name_o.is_some() {
            ref type_name : Str = type_name_o.unwrap()
            return type_name.clone()
        }
    }
    return ""
}

// Canonical type name that a numeric `to_<X>` conversion method
// converts TO, or "" when `method` is not such a conversion. `to_u32`
// -> "U32", `to_usize` -> "USize" (which type_from_name then resolves
// to the target's U32/U64). Drives the redundant-literal-conversion
// check: `5.to_u32()` is redundant because a bare `5` already narrows
// to U32 in any U32 context. Mirrors builtin_primitive_from_name's
// shape; Bool and to_str/to_ptr (non-numeric) deliberately fall through.
priv numeric_conv_target_name := func(method: Str) returns Str {
    switch method {
    case "to_i64":   return "I64"
    case "to_u8":    return "U8"
    case "to_i8":    return "I8"
    case "to_i16":   return "I16"
    case "to_u16":   return "U16"
    case "to_i32":   return "I32"
    case "to_u32":   return "U32"
    case "to_u64":   return "U64"
    case "to_f32":   return "F32"
    case "to_f64":   return "F64"
    case "to_usize": return "USize"
    case "to_uptr":  return "UPtr"
    case:
    }
    return ""
}

// FCall bitmaps use absolute child positions. UFCS inserts the receiver at
// child 1, so preserve the callee's bit 0 and move every argument bit right.
priv shift_fcall_bitmap_for_ufcs := func(bits: U64) returns U64 {
    callee_bit : U64 = 1
    return bits.band(callee_bit).bor(bits.band(callee_bit.bnot()).shl(1))
}

priv infer_field_access_fcall := proc(mut scope: TypeScope, mut e: Expr, in_func: I32, mut ctx: Context) returns Bool {
    ref mut fa : Expr = e.children[0]
    ref mut obj : Expr = fa.children[0]
    mut method := ""
    ref m : FieldAccessData = fieldaccess_of(fa)
    method = Str.clone(m.field_access_name())
    // `.clone()` on a literal receiver is always redundant: the literal
    // itself is a fresh value, so the clone allocates a copy that the
    // surrounding code would have produced anyway. Reject at the typer
    // level so callers fix the source instead of paying for the copy.
    if method == "clone" {
        if obj.node_type.is_nonnull_literal() {
            e.type_error("redundant '' on a literal", ctx)
            e.set_til_type( Type.Unknown)
            return true
        }
    }
    // #294: a numeric conversion on a numeric literal is redundant. A
    // bare literal already narrows to the target type through its
    // declaration type, an argument/field type, or any numeric context
    // (`x : U32 = 5`, `f(5)`, `b > 0`, `a / 2`), so `5.to_u32()` /
    // `5.cast(U32)` does no work the surrounding code would not do
    // anyway. Reject it: the fix is to drop the conversion, or -- where
    // the value was otherwise inferred -- give the binding an explicit
    // type (`x : U32 = 5`, not `x := 5.to_u32()`). Checked here, before
    // UFCS desugaring and constant folding, so it fires uniformly at
    // every literal receiver (arguments, operator operands, decls).
    // Out-of-range conversions stay legal -- they do real work
    // (300.to_u8() truncation, -1.to_usize() wraparound) -- gated by
    // literal_in_range against the resolved target type.
    if obj.node_type.is_literal_num() {
        mut conv_target := Type.Unknown
        if method.eq("cast") {
            if e.children.len().eq(2) {
                switch e.children[1].node_type {
                case .Ident(cast_tn):
                    conv_target = type_from_name(cast_tn.ident_name(), scope, ctx)
                case:
                }
            }
        } else {
            conv_tgt_name := numeric_conv_target_name(method)
            if conv_tgt_name.len() > 0 {
                conv_target = type_from_name(conv_tgt_name, scope, ctx)
            }
        }
        if is_numeric_type(conv_target) {
            switch obj.node_type {
            case .Literal(Literal.Num(conv_lit)):
                if literal_in_range(conv_lit.literal_num_text(), conv_target) {
                    e.type_error(format(
                        "redundant conversion '", method,
                        "' on a numeric literal: a bare literal already narrows to ",
                        type_to_name(conv_target),
                        " through its declaration or argument type; drop the conversion",
                        " (give the binding an explicit type if it was inferred)"), ctx)
                    // Keep the well-defined conversion result type (not
                    // Unknown) so the diagnostic does not cascade into
                    // spurious "got unknown" mismatches at the use site.
                    e.set_til_type(conv_target)
                    return true
                }
            case:
            }
        }
    }
    infer_expr(scope, obj, in_func, ctx)

    // A function pointer is a pointer-sized value, but a funcsig is not a
    // struct, so it has no `size` metatype method of its own. Route a funcptr
    // type-token's `.size()` through Dynamic (the universal 8-byte pointer,
    // src/core/dyn.til), which reports pointer size. (`clone`/`delete` need
    // funcptr-typed results / true no-op delete -- not Dynamic's, which frees
    // -- so they are handled separately as the Array-of-funcptr work lands.)
    if obj.til_type().is_funcptr().and(method.eq("size")) {
        switch obj.node_type {
        case .Ident:
            mut dyn_recv := Expr.new(ident_node("Dynamic"), obj.line, obj.col)
            dyn_recv.set_til_type(Type.Struct("Dynamic"))
            fa.children[0] = dyn_recv
        case:
        }
    }

    mut obj_is_type := false
    switch obj.node_type {
    case .Ident(oit_id):
        if scope.get_struct(oit_id.ident_name()).is_some() {
            obj_is_type = true
        }
    case:
    }

    mut ufcs_desugared := false
    if obj_is_type.not() {
        type_name := obj_method_type_name(obj)
        has_type_name := type_name.len() > 0

        // Calling `to_<self>` on a value that is already of that type is
        // a redundant self-conversion. Caught here -- before the
        // namespace lookup -- so the diagnostic names the mistake
        // directly instead of surfacing as a generic "no method". Skip
        // namespace calls like `Str.to_str(x)` (handled by the
        // obj_is_type branch), which dispatch on the explicit type.
        // #192: to_u64/to_u32 are the target-dependent widths -- a USize/UPtr
        // value needs `.to_u64()` on 64-bit and `.to_u32()` on 32-bit for the
        // same source to typecheck on both, so a self-conversion to either is
        // portable, not a mistake. Exempt them (mirrors the /.cast(U32)
        // exemption below). The lint still catches every other self-conversion.
        conv_w := method.eq("to_u64").or(method.eq("to_u32"))
        if has_type_name.and(is_self_conversion_method(method, type_name)).and(conv_w.not()) {
            e.type_error(format(
                "redundant self-conversion: '", method,
                "' would convert ", type_name, " to itself; ",
                "value is already of type '", type_name, "'",
            ), ctx)
            e.set_til_type(Type.Unknown)
            return true
        }
        // Same diagnostic for `x.cast(X)` where X matches the receiver's
        // type -- identity casts are accepted by infer_cast_fcall's
        // same-size rule, but they are always pointless and almost
        // always a copy-paste / migration mistake.
        if has_type_name.and(method.eq("cast")).and(e.children.len().eq(2)) {
            switch e.children[1].node_type {
            case .Ident(cast_id_data):
                // #192: USize/UPtr are target-dependent (U32 on 32-bit,
                // U64 on 64-bit). A ``/`.cast(U32)` on such a
                // value is redundant on one target but a needed widening on
                // the other, so it must stay for portability. Don't flag
                // self-casts to these widths; the lint still catches
                // pointless self-casts of every other type.
                cast_w := cast_id_data.ident_name().eq("U64").or(cast_id_data.ident_name().eq("U32"))
                if cast_id_data.ident_name().eq(type_name).and(cast_w.not()) {
                    e.type_error(format(
                        "redundant self-cast: 'cast(", type_name,
                        ")' would reinterpret ", type_name,
                        " as itself; drop the .cast(", type_name, ")",
                    ), ctx)
                    e.set_til_type(Type.Unknown)
                    return true
                }
            case:
            }
        }

        sdef1_o := scope.get_struct(type_name)
        mut nf1o := Option(ref Expr).None
        if sdef1_o.is_some() { nf1o = find_namespace_func(sdef1_o.unwrap(), method, scope) }
        if nf1o.is_none() {
            if try_ufcs_rewrite(scope, e, fa, obj, method, type_name, ctx) {
                return false
            }
            if sdef1_o.is_some() {
                if infer_func_ptr_field_call(scope, e, fa, obj, sdef1_o.unwrap(), method, in_func, ctx) {
                    return true
                }
            }
            if has_type_name.not() {
                if obj.til_type().is(Type.Dynamic) {
                    e.type_error(format(
                        "cannot call method '", method, "' on Dynamic value; ",
                        "use 'ref x : Type = ...' to declare with an explicit type first",
                    ), ctx)
                } else {
                    e.type_error(format("no method '", method, "' for type 'unknown'"), ctx)
                }
            } else {
                e.type_error(format("no method '", method, "' for type '", type_name, "'"), ctx)
            }
            e.set_til_type(Type.Unknown)
            return true
        }
        ufcs_desugared = true
        mut type_ident := Expr.new(ident_node(type_name), obj.line, obj.col)
        type_ident.set_til_type(Type.Struct(type_name.clone()))
        // Move the receiver `obj` out of fa.children[0] (no clone) into a
        // holder, then put the type ident in the vacated slot. push_take
        // zeroes the source slot, so the .set below is a plain bit-overwrite
        // of a dead slot. The moved receiver becomes the UFCS self-arg at
        // position 1 (pushed into new_children further down), so we reuse the
        // original subtree instead of cloning it and orphaning the original
        // -- the clone+orphan was a per-UFCS-call leak of the whole receiver.
        mut recv_holder := Vec(Expr).new()
        recv_holder.push_take(fa.children, 0)
        fa.children[0] = type_ident
        // Keep every child-indexed call flag aligned with the argument it
        // describes when UFCS inserts self at position 1.
        ref mut ufcs_fcd : FCallData = fcall_of(e)
        ufcs_fcd.own_args = shift_fcall_bitmap_for_ufcs(ufcs_fcd.own_args)
        ufcs_fcd.keep_outer_args = shift_fcall_bitmap_for_ufcs(ufcs_fcd.keep_outer_args)
        ufcs_fcd.ref_args = shift_fcall_bitmap_for_ufcs(ufcs_fcd.ref_args)
        ufcs_fcd.splat_args = shift_fcall_bitmap_for_ufcs(ufcs_fcd.splat_args)
        mut new_children := Vec(Expr).new()
        new_children.push_take(e.children, 0)
        new_children.push_take(recv_holder, 0)
        for i in 1..e.children.len() {
            new_children.push_take(e.children, i)
        }
        e.children = new_children
        ref fa2 : Expr = e.children[0]
        ref m2 : FieldAccessData = fieldaccess_of(fa2)
        method = Str.clone(m2.field_access_name())
    }

    ref mut fa3 : Expr = e.children[0]
    ref mut obj3 : Expr = fa3.children[0]
    if obj3.til_type().is(Type.Unknown) {
        infer_expr(scope, obj3, in_func, ctx)
    }
    mut obj3_sname_o := expr_type_name_ref(obj3)
    if obj3_sname_o.is_none() {
        switch obj3.node_type {
        case .Ident(obj3_id):
            obj3_sname_o = Option(ref Str).Some(obj3_id.ident_name())
        case:
        }
    }
    if obj3_sname_o.is_none() {
        e.type_error(format("no namespace function '", method, "'"), ctx)
        e.set_til_type(Type.Unknown)
        return true
    }
    ref obj3_sname : Str = obj3_sname_o.unwrap()
    sdef2_o := scope.get_struct(obj3_sname)
    mut nf2o := Option(ref Expr).None
    if sdef2_o.is_some() { nf2o = find_namespace_func(sdef2_o.unwrap(), method, scope) }
    if nf2o.is_none() {
        e.type_error(format("no namespace function '", method, "'"), ctx)
        e.set_til_type(Type.Unknown)
        return true
    }
    // A Some nf2o means the def lookup above hit, so this cannot be None.
    ref sdef2 : Expr = sdef2_o.unwrap()
    ref mut ns_func2 : Expr = nf2o.unwrap()
    mut ns_member_priv := false
    switch find_ns_decl(sdef2, method) {
    case .Some(fd):
        ns_member_priv = fd.is_priv
        if ctx.auto_gen_depth == 0 { fd.used = true }
    case .None:
    }
    check_member_priv(e, obj3_sname, method, ns_member_priv, ctx)
    // #154: calling a method of a cross-file type uses that type's import.
    note_cross_file_type_use(scope, ctx, obj3_sname)
    // #269: a call to an ABSTRACT method through an interface-typed receiver
    // cannot be resolved statically -- the receiver is a box carrying the
    // concrete implementer's type name (see gen_interface_box_fields_for_stmt
    // and the boxing rewrite in infer_and_validate_fcall_args). Lower the
    // call onto the existing dyn_call machinery, which dispatches on the
    // box's tag at runtime in BOTH backends:
    //   Iface.method(recv, extra...) ->
    //   dyn_call_ret(recv.iface_type_name, "method", arity, recv.iface_val, extra...)
    // Concrete default methods stay statically dispatched to the interface's
    // own implementation.
    if name_is_interface(obj3_sname, scope).and(e.children.len().gte(2)) {
        mut abs_method := false
        mut abs_returns := false
        mut abs_ret_type := ""
        switch ns_func2.node_type {
        case .FuncDef(abs_fd):
            if abs_fd.func_type.is_ext() {
                abs_method = true
                abs_returns = abs_fd.return_type.len() > 0
                abs_ret_type = abs_fd.return_type.clone()
            }
        case:
        }
        mut recv_is_iface := false
        recv_sname_o := expr_type_name_ref(e.children[1])
        if recv_sname_o.is_some() {
            ref recv_sname : Str = recv_sname_o.unwrap()
            recv_is_iface = recv_sname == obj3_sname
        }
        if abs_method.and(recv_is_iface) {
            payload_args := e.children.len() - 1
            if payload_args > 2 {
                e.type_error(format("interface dispatch of '", obj3_sname, ".", method,
                    "': dyn_call supports at most one argument besides self"), ctx)
                e.set_til_type(Type.Unknown)
                return true
            }
            dl := e.line
            dc := e.col
            mut dyn_callee_name := "dyn_call"
            if abs_returns { dyn_callee_name = "dyn_call_ret" }
            mut dyn_children := Vec(Expr).new()
            dyn_children.push(own Expr.new(ident_node(dyn_callee_name), dl, dc))
            mut fa_tag := Expr.new(field_access_node("iface_type_name"), dl, dc)
            fa_tag.add_child(own e.children[1].clone())
            dyn_children.push(own fa_tag)
            dyn_children.push(own Expr.new(NodeType.Literal(Literal.Str(method.clone())), dl, dc))
            dyn_children.push(own Expr.new(NodeType.Literal(Literal.Num(LiteralNumData(text = payload_args.to_str()))), dl, dc))
            mut fa_val := Expr.new(field_access_node("iface_val"), dl, dc)
            fa_val.add_child(own e.children[1].clone())
            dyn_children.push(own fa_val)
            for xi in 2..e.children.len() {
                dyn_children.push_take(e.children, xi)
            }
            e.children = dyn_children
            switch e.node_type {
            case .FCall(dyn_fcd):
                dyn_fcd.own_args = 0
                // #342: the call is now dyn_call with a wholly different
                // argument list, so the parsed splat positions describe
                // nothing here -- clear them with the own bits rather than
                // leave a bitmap pointing at the new arguments.
                dyn_fcd.splat_args = 0
            case:
            }
            infer_expr(scope, e, in_func, ctx)
            if abs_ret_type.len() > 0 {
                e.set_til_type(type_from_name(abs_ret_type, scope, ctx))
            }
            return true
        }
    }
    if ctx.proc_def_depth.gt(0).or(in_func.neq(0)) {
        switch ns_func2.node_type {
        case .FuncDef(ns_fdef0):
            if ns_fdef0.func_type.is_proc() {
                ctx.proc_calls_count = ctx.proc_calls_count + 1
            }
        case:
        }
    }
    // Ensure obj3 carries the resolved struct type so the interpreter can
    // extract the parent type name via til_type_name for dispatch.
    if obj3_sname.len().gt(0).and(obj3.til_type().is(Type.Struct).not()) {
        obj3.set_til_type(Type.Struct(obj3_sname.clone()))
    }
    // is() compares only the outer enum tag (see ast.til), so a payload-carrying
    // variant like NodeType.Literal(Literal.SetLit) silently matches *any*
    // Literal -- the payload is dead. Reject it: use a bare variant
    // (NodeType.Literal) or a switch to discriminate the inner variant.
    if method == "is" {
        // is(self, other): the `other` argument is the last child (UFCS may
        // have inserted `self` ahead of it).
        if e.children.len() > 1 {
            ref is_other : Expr = e.children[e.children.len() - 1]
            if is_enum_variant_ctor_with_payload(is_other, scope) {
                is_other.type_error(format(
                    "is() compares only the enum tag, so the payload here is ignored; ",
                    "use a bare variant (e.g. 'NodeType.Literal') or a switch to ",
                    "discriminate the inner variant"), ctx)
            }
        }
    }
    switch ns_func2.node_type {
    case .FuncDef(ns_fdef):
        mut implicit_arg_count : USize = 0
        if ufcs_desugared { implicit_arg_count = 1 }
        if desugar_fcall_args_for_fdef(e, "", ns_fdef, implicit_arg_count, ctx).not() {
            // Missing-argument diagnostic was already emitted above.
            return true
        }
        // After UFCS rewriting, e.children[1] is the original receiver
        // Expr that was already inferred at the top of this proc. Skip
        // it (and any already-typed positional arg) to avoid firing
        // priv / member checks twice on the same node. Genuinely
        // unresolved args (Unknown til_type) still get inferred here.
        for i in 1..e.children.len() {
            if e.children[i].til_type().is(Type.Unknown) {
                infer_expr(scope, e.children[i], in_func, ctx)
            }
        }
        infer_and_validate_fcall_args_for_fdef(scope, e, ns_fdef, in_func, ctx)
        if ufcs_desugared {
            // If bit 0 (callee) was set by the parser's 'own expr' handler,
            // propagate it to bit 1 (the UFCS self arg) and clear bit 0.
            if get_own_arg(e, 0) {
                ref mut ufcs_fcd2 : FCallData = fcall_of(e)
                ufcs_fcd2.own_args = ufcs_fcd2.own_args - 1
                set_own_arg(e, 1)
            }
        }
        if ns_fdef.is_enum_variant_ctor {
            set_fcall_own_args_for_own_params(e, ns_fdef)
            // #320: a ref-payload ctor arg is a borrow that ESCAPES into
            // the enum value, so it must name a place the garbager can
            // keep alive (a variable or a field chain); an owned
            // temporary (FCall result, literal, ...) would dangle in
            // compiled code the moment its statement ends. sdef2 IS the
            // enum def -- the variant ctor was found in its namespace --
            // so no re-lookup and no null/EnumDef guard: if that
            // invariant ever breaks, enum_variant_index's UNREACHABLE
            // fails loudly here.
            if e.children.len() > 1 {
                rp_idx := enum_variant_index(sdef2, method)
                if rp_idx.gte(0).and(enum_variant_payload_ref(sdef2, rp_idx)) {
                    ref rp_arg : Expr = e.children[e.children.len() - 1]
                    // Same predicate a `ref` DECL requires of its source:
                    // a ref-returning call is a legitimate borrow (its
                    // referent outlives the call), so the rule is "must be
                    // a borrow source", not "must be an Ident or field".
                    if expr_is_ref_decl_source(rp_arg, scope).not() {
                        rp_arg.type_error(format("variant '", obj3_sname, ".", method,
                            "' has a 'ref' payload: the argument is borrowed, so it must be a variable, a field, or a ref-returning call, not a temporary"), ctx)
                    }
                }
            }
        }
        validate_fcall_own_args_for_fdef(scope, e, ns_fdef, ctx)
        mut rt := Type.None
        if ns_fdef.return_type.len() > 0 {
            rt = type_from_name(ns_fdef.return_type, scope, ctx)
        }
        // #262 follow-up: narrow a DynVec element read from Dynamic to the
        // vec's recorded element type (`v := DynVec.new(T)` set dynvec_elem
        // on v's binding). Makes `x := v[i]` typed and a stored funcptr
        // directly callable (`ops[i](args)`).
        if rt.is(Type.Dynamic).and(obj3_sname.eq("DynVec")) {
            if method.eq("get").or(method.eq("unsafe_get")).or(method.eq("pop")) {
                if e.children.len() >= 2 {
                    switch e.children[1].node_type {
                    case .Ident(recv_id):
                        recv_b_o := scope.get_binding(recv_id.ident_name())
                        if recv_b_o.is_some() {
                            ref recv_b : TypeBinding = recv_b_o.unwrap()
                            if recv_b.dynvec_elem.len() > 0 {
                                elem_t := type_from_name(recv_b.dynvec_elem, scope, ctx)
                                if elem_t.is(Type.Unknown).not() { rt = elem_t }
                            }
                        }
                    case:
                    }
                }
            }
        }
        e.set_til_type(rt)
        // Issue #191: namespace macro calls require all arguments to be comptime-known.
        if ns_fdef.func_type.is(FuncType.Macro) {
            for ai in 1..e.children.len() {
                if e.children[ai].expr_is_comptime(scope).not() {
                    e.children[ai].type_error("macro argument must be known at compile time", ctx)
                }
            }
        }
    case .StructDef(_ns_sdef):
        mut type_ident := Expr.new(ident_node(method), e.children[0].line, e.children[0].col)
        e.children[0] = type_ident
        return infer_struct_constructor_fcall_impl(scope, ns_func2, e, method, in_func, ctx)
    case:
        UNREACHABLE("unexpected ", ns_func2.node_type.head_str())
        return false
    }
    return true
}

// Issue #179 step 1: cross-file priv check for standalone funcs.
// The duplicate-fire problem this used to dedup against (FieldAccess
// receiver re-walk in infer_field_access_fcall) is now prevented at
// source: the post-UFCS re-walk skips already-typed children, so the
// receiver Expr is inferred exactly once.
priv check_priv_access := proc(e: Expr, name: Str, b: TypeBinding, mut ctx: Context) {
    if b.is_priv.not() { return }
    if b.path.eq(ctx.path).not() {
        // init_declarations_unit rewrote top-level priv decls to
        // `priv__<path>__<orig>`. Prefer the original identifier in the
        // diagnostic so users see the source form, not the mangle.
        mut display_name := name
        if b.orig_name.len().gt(0).and(b.name.starts_with("priv__")) {
            display_name = b.orig_name
        }
        e.type_error(format("'", display_name, "' is private to '", b.path, "'; remove 'priv' to expose it"), ctx)
        return
    }
    if b.orig_name.len() == 0 { return }
    // Top-level priv decls (mangled `priv__<path>__<orig>`) live at file
    // scope, so the same-file path check above is sufficient -- skip the
    // nested-parent check that follows, which assumes the
    // `<parent>_<orig>` lifted-nested layout.
    if b.name.starts_with("priv__") { return }
    // Issue #93 follow-up: lifted nested defs are function-scoped within
    // the original parent function. init_declarations_unit sets
    // b.orig_name to the user-facing identifier and mangles b.name as
    // `<parent>_<orig>`. Allow references from:
    //   - the parent function itself (current_top_func_name == parent), or
    //   - any other lifted descendant whose own mangled name starts with
    //     `<parent>_` (sibling helpers and inner ns methods), or
    //   - a ns-method body of a lifted struct/enum (tracked through
    //     current_type_name).
    parent_len := b.name.len().sub(b.orig_name.len()) - 1
    parent_name := b.name.substr(0, parent_len)
    parent_underscore := format(parent_name, "_")
    if ctx.current_top_func_name == parent_name { return }
    if ctx.current_top_func_name.starts_with(parent_underscore) { return }
    if ctx.current_type_name == parent_name { return }
    if ctx.current_type_name.starts_with(parent_underscore) { return }
    e.type_error(format("'", b.orig_name, "' is a local def of '", parent_name, "' and cannot be referenced from outside it"), ctx)
}

// Issue #179 + follow-up: cross-file priv check for type names that
// appear in declaration positions (parameter types, return types,
// ref/let decl explicit_type). The Ident-path check_priv_access only
// fires when a name is referenced as a value -- a user can otherwise
// write ~func(x: PrivStruct) returns PrivStruct~ in another file
// silently. Skip when inside the type's own namespace (auto-gen and
// hand-written ns methods both reference the parent type by name).
// Thin wrapper: looks up the binding, gates on current_type_name,
// then defers to check_priv_access for the actual emit.
priv check_priv_type_name := proc(e: Expr, name: Str, scope: TypeScope, mut ctx: Context) {
    if name.len() == 0 { return }
    if ctx.current_type_name == name { return }
    b_o := scope.get_binding(name)
    if b_o.is_some() { check_priv_access(e, name, b_o.unwrap(), ctx) }
}

// Issue #179 steps 4-5: priv check for struct fields and namespace
// methods. Stricter than top-level priv: priv members are only
// visible inside the struct's own namespace methods, not just the
// declaring file. current_type_name == owner_name iff we are
// type-checking a member body of that struct.
priv check_member_priv := proc(e: Expr, owner_name: Str, member_name: Str, member_is_priv: Bool, mut ctx: Context) {
    if member_is_priv.not() { return }
    if ctx.current_type_name == owner_name { return }
    e.type_error(format("'", owner_name, ".", member_name, "' is private to its struct; remove 'priv' to expose it"), ctx)
}

// Forbid `free(own X)` when X is an aggregate local whose type has a
// `delete` method. Such a shallow free releases only the struct box, and
// because passing `own X` makes the asap pass treat X as transferred (see
// expr_transfers_own), asap then skips the proper X.delete -- so X's owned
// fields leak. Demonstrated: `free(own vec_local)` leaks the element buffer.
// Exceptions fall out naturally: `self` is a param (not a local) so a
// delete method's own `free(own self)` box-release is allowed, and raw
// pointer types (U8/Dynamic) have no `delete` method so raw frees are fine.
priv check_free_managed_local := proc(scope: TypeScope, e: Expr, mut ctx: Context) {
    if e.children.len() < 2 { return }
    if get_own_arg(e, 1).not() { return }
    switch e.children[1].node_type {
    case .Ident(an):
        sf := scope.find(an.ident_name())
        switch sf {
        case .Found(b):
            if b.is_param { return }
            if b.own_type.is(OwnType.Ref) { return }
            tn := til_type_name(b.type)
            if tn.len() == 0 { return }
            sdef_o := scope.get_struct(tn)
            if sdef_o.is_none() { return }
            ref sdef : Expr = sdef_o.unwrap()
            if find_namespace_func(sdef, "delete", scope).is_none() { return }
            e.type_error(format(
                "free(own ", Str.clone(an.ident_name()), ") shallow-frees managed type '", tn,
                "': passing 'own' makes the asap pass skip ", tn,
                ".delete, leaking its owned fields -- call ", tn, ".delete(own ",
                Str.clone(an.ident_name()), ", true) or let the asap pass free it",
            ), ctx)
        case:
        }
    case:
    }
}

// Issue #212: byte size of an integer primitive Type, or 0 for any
// non-integer-reinterpret-able type. F32 (4 bytes) and Bool are
// deliberately excluded -- `cast` is a bit reinterpret, not a value
// conversion. All four integer widths (1/2/4/8) carry a full same-size
// signed/unsigned pair in both codegen and the interpreter's raw-byte model.
priv cast_int_size := func(t: Type) returns USize {
    tn := til_type_name_c(t)
    if tn.eq("I8").or(tn.eq("U8"))   { return 1 }
    if tn.eq("I16").or(tn.eq("U16")) { return 2 }
    if tn.eq("I32").or(tn.eq("U32")) { return 4 }
    if tn.eq("I64").or(tn.eq("U64")) { return 8 }
    return 0
}

// True for the signed integer primitives the cast typer recognises.
// Used by cast_pair_ok to gate same-signedness widening; cross-
// signedness widening (e.g. I8 -> U16) is deferred for now because it
// changes the value's signed interpretation -- the operand and result
// no longer agree on what the bits mean.
priv cast_is_signed := func(t: Type) returns Bool {
    tn := til_type_name_c(t)
    if tn.eq("I8").or(tn.eq("I16")).or(tn.eq("I32")).or(tn.eq("I64")) {
        return true
    }
    return false
}

// True iff cast(src -> target) is legal for issue #212's current
// scope: same-size integer reinterpret (any signedness combination)
// OR same-signedness widening (src.size < target.size, both signed
// or both unsigned). Narrowing and cross-signedness widening are
// intentionally rejected.
priv cast_pair_ok := func(src: Type, target: Type) returns Bool {
    src_size := cast_int_size(src)
    target_size := cast_int_size(target)
    if src_size.gt(0).and(target_size.gt(0)) {
        if src_size == target_size { return true }
        if src_size < target_size {
            return cast_is_signed(src) == cast_is_signed(target)
        }
        return false
    }
    // Issue #58: Dynamic -> FuncPtr (named FuncSig) is the user's
    // assertion that the slot holds a function pointer of the target
    // signature -- used to pull a fn ptr out of a Dynamic-element Vec
    // (`Vec(BinaryOp).new()`) and call it. FuncPtr -> FuncPtr (same shape)
    // is accepted as an identity / nominal cast for completeness.
    if target.is_funcptr() {
        if src.is(Type.Dynamic).or(src.is_funcptr()) { return true }
    }
    if target.is(Type.Body) {
        if src.is(Type.Dynamic).or(src.is(Type.Body)) { return true }
    }
    return false
}

// Issue #212: type-check a `cast(e, T)` call. Validates that e and T are
// integer primitives of the same byte size, rewrites the T argument into
// a Type value (so downstream passes see a well-formed Type, as with
// Vec(I32).new()), and sets the call's result type to T -- the typer's
// stand-in for the not-yet-expressible `returns T`.
priv infer_cast_fcall := proc(mut scope: TypeScope, mut e: Expr, in_func: I32, mut ctx: Context) {
    if e.children.len() != 3 {
        e.type_error("cast expects (value, Type), e.g. x.cast(I32)", ctx)
        e.set_til_type(Type.Unknown)
        return
    }
    // Idempotency: if the typer has already processed this cast (e.g. a
    // for-range desugar re-infers an already-typed FCall), re-infer the
    // value arg for safety but skip re-deriving the target type. child(2)
    // stays the bare type-token Ident either way.
    if e.til_type().is(Type.Unknown).not() {
        infer_expr(scope, e.children[1], in_func, ctx)
        return
    }
    infer_expr(scope, e.children[1], in_func, ctx)
    ref src_type : Type = e.children[1].til_type()
    mut tname := ""
    switch e.children[2].node_type {
    case .Ident(tn0): tname = Str.clone(tn0.ident_name())
    case:
        e.children[2].type_error("cast target must be a type name, e.g. cast(x, I32)", ctx)
        e.set_til_type(Type.Unknown)
        return
    }
    // Issue #58: a bare user FuncSig name (`cast(raw, BinaryOp)`)
    // resolves to Type.Custom through til_type_from_explicit_type;
    // walk scope to map it to Type.FuncPtr so cast_pair_ok's
    // Dynamic -> FuncPtr branch fires.
    mut target_type := til_type_from_explicit_type(tname)
    if target_type.is(Type.Custom) {
        target_type = type_from_name(tname, scope, ctx)
    }
    if cast_pair_ok(src_type, target_type).not() {
        e.type_error(format(
            "cast only supports same-size integer reinterpret ",
            "(any signedness) and same-signedness widening; ",
            "cannot cast ", til_type_name_c(src_type), " to ", tname,
        ), ctx)
        e.set_til_type(Type.Unknown)
        return
    }
    // Codegen never reads child(2), the type-token arg, so leave it as the
    // bare Ident it was parsed as and just tag it Type.Enum("Type"):
    //   * integer reinterpret / widening takes the target C type from the
    //     cast FCall's own til_type (til_type_name_c(e.til_type())) in
    //     the builder, never from child(2);
    //   * Issue #58's cast(value, FuncSig)(args) resolves the signature by
    //     NAME from this Ident (fcall_fn_sig / infer_funcptr_call_via_cast),
    //     which needs the bare Ident, not a rewritten Type value.
    // Materialising a runtime Type here (make_til_type_expr would build
    // Type.Primitive(Primitive.X) with an owned heap payload) only produced a
    // temp the hoister boxes with malloc and then deletes unused -- that dead
    // Type_Primitive box was the largest single allocation source in the
    // self-host --prof run.
    e.children[2].set_til_type(Type.Enum("Type"))
    e.set_til_type(target_type)
}

// The declared RETURN TYPE NAME of an Ident-callee call (`pick()` ->
// "Op"), or "" when the callee is not a plain named function. Reads the
// name straight off the callee's FuncDef, which is authoritative from
// the moment init registers it -- unlike the callee binding's `type`,
// which spells a FuncSig return as a nameless Type.FuncPtr until the
// typer reaches that function's own Decl.
priv fcall_callee_declared_return_type := func(scope: TypeScope, callee: Expr) returns Str {
    if callee.children.len() == 0 { return "" }
    switch callee.children[0].node_type {
    case .Ident(cn):
        cf_o := scope.lookup_func(cn.ident_name())
        if cf_o.is_none() { return "" }
        ref cfd : FunctionDef = funcdef_of(cf_o.unwrap())
        if cfd.return_type.len() == 0 { return "" }
        return resolve_type_alias(scope, cfd.return_type).clone()
    case:
    }
    return ""
}

// Issue #58: type-check a postfix call where the callee is
// `cast(value, FuncSig)`. The cast has already been infer'd; this
// function reads the FuncSig name out of cast's child(2), looks up the
// FuncDef in scope, validates arg count + arg types against the sig,
// and sets the outer FCall's til_type to the sig's return type. Returns
// false when the callee isn't a cast-to-FuncSig shape so callers can
// fall back to other paths.
priv infer_funcptr_call_via_cast := proc(mut scope: TypeScope, mut e: Expr, in_func: I32, mut ctx: Context) returns Bool {
    ref mut callee : Expr = e.children[0]
    if callee.node_type.is(NodeType.FCall).not() { return false }
    if callee.til_type().is_funcptr().not() { return false }
    // `cast(raw, Sig)(args)` names its signature in child(2). Any OTHER
    // funcptr-typed call result -- `pick()(5)` where `pick returns Sig` --
    // carries the same name in its own Type.FuncPtrSig payload, so both
    // shapes resolve to a signature here and share the validation below.
    mut sig_name := ""
    mut is_cast := false
    if callee.children.len() == 3 {
        switch callee.children[0].node_type {
        case .Ident(cn): is_cast = cn.ident_name().eq("cast")
        case:
        }
    }
    if is_cast {
        switch callee.children[2].node_type {
        case .Ident(tn): sig_name = Str.clone(tn.ident_name())
        case:
            return false
        }
    } else {
        sig_name_o := expr_type_name_ref(callee)
        if sig_name_o.is_some() {
            ref sig_name_ref : Str = sig_name_o.unwrap()
            sig_name = sig_name_ref.clone()
        } else {
            // A NAMELESS Type.FuncPtr: init's type_from_name_init gives a
            // FuncSig return type that provisional spelling, and the typer
            // only upgrades the binding to Type.FuncPtrSig once it reaches
            // the callee's own Decl. A call site typed BEFORE that Decl
            // still reads the provisional type -- always the case for a
            // monomorphized generic instance, which is appended after its
            // caller. The signature is named on the callee's FuncDef the
            // whole time, and consulting it costs nothing outside this
            // rare `f(...)(args)` shape.
            sig_name = fcall_callee_declared_return_type(scope, callee)
            if sig_name.len() == 0 { return false }
            // Settle the callee's type HERE, once per call site, so every
            // later consumer reads the signature straight off it -- in
            // particular resolve_fn_sig's FCall case, which the builder's
            // indirect-call emit depends on and which otherwise drops to
            // its Ident-only path and panics "expected Ident, got FCall".
            // This is the single Str clone the shape costs; paying it in
            // type_from_name_init instead taxed every FuncSig-returning
            // declaration in the program to serve this one call shape.
            callee.set_til_type(Type.FuncPtrSig(sig_name.clone()))
        }
    }
    sig_bind_o := scope.get_binding(sig_name)
    if sig_bind_o.is_none() { return false }
    ref sig_bind : TypeBinding = sig_bind_o.unwrap()
    if sig_bind.type.is_funcptr().not() { return false }
    sig_def_o := scope.lookup_func(sig_bind.name)
    if sig_def_o.is_none() { return false }
    switch sig_def_o.unwrap().node_type {
    case .FuncDef(sfd):
        nargs := e.children.len() - 1
        nparam := sfd.params.len()
        if nargs != nparam {
            type_error(e, format(
                "function pointer of type '", sig_name, "' expects ",
                nparam.to_str(), " arg(s), got ", nargs.to_str()
            ), ctx)
            e.set_til_type(Type.Unknown)
            return true
        }
        for ai in 1..e.children.len() {
            infer_expr(scope, e.children[ai], in_func, ctx)
        }
        if sfd.return_type.len() > 0 {
            e.set_til_type(type_from_name(sfd.return_type, scope, ctx))
        } else {
            e.set_til_type(Type.None)
        }
        return true
    case:
        return false
    }
}

// Issue #289: type an array(T, ...) / vec(T, ...) call. The element args are
// inferred normally; child(1) is the element TYPE token and is intentionally
// left un-inferred (its name -- a primitive like I64, a struct like Vector3,
// or a synthesized container name like Array__Str -- is all the later
// monomorphization passes need, and inferring a synthesized name as a value
// could spuriously fail symbol resolution). The token is NOT rewritten into a
// runtime Type expression, so the bare Ident survives for those passes.
priv infer_array_vec_fcall := proc(mut scope: TypeScope, mut e: Expr, name: Str, in_func: I32, mut ctx: Context) {
    for i in 2..e.children.len() {
        infer_expr(scope, e.children[i], in_func, ctx)
    }
    elem_type := array_vec_elem_type_name(e)
    if elem_type.len() == 0 {
        e.type_error("array/vec element type must be a type name, e.g. array(I64, 1, 2, 3)", ctx)
        e.set_til_type(Type.Unknown)
        return
    }
    // `vec(MyInt, ...)` names a type, so resolve it for its side effects
    // (#154 import credit, #187 used-marking) exactly like any other type
    // annotation. The instance name below resolves the alias away, so this
    // is the only point that sees the spelling the user wrote.
    _ : Type = type_from_name(elem_type, scope, ctx)
    // #342: `array` / `vec` are declared `..Dynamic`, so the variadic check in
    // infer_and_validate_fcall_args_for_fdef skips their block entirely and
    // the element type the literal NAMES is the only thing a splat can be
    // measured against. Without this `array(I64, 1, ..strs, 9)` folded an
    // Array(Str) into an Array(I64) and printed the Str pointers as numbers.
    // (Plain elements are still unchecked here -- `array(I64, 1, "a")` is the
    // same garbage and predates splats; that gap is not this issue's.)
    for si in 2..e.children.len() {
        if get_splat_arg(e, si) {
            validate_splat_elem_type(scope, e.children[si], elem_type,
                format("the '", elem_type, "' element type of this ", name, "() literal"), ctx)
        }
    }
    if name == "array" {
        e.set_til_type(Type.Struct(variadic_array_type_name(scope, elem_type)))
    } else {
        e.set_til_type(Type.Struct(variadic_vec_type_name(scope, elem_type)))
    }
}

// --- Issue #328: omitted generic type arguments ------------------------
//
// A direct generic `gid := func(T: Type, v: T) returns T` can be called
// as `gid(7)` as well as `gid(I64, 7)`. Init leaves the omitted form
// untouched (it cannot type the value arguments), so the call arrives
// here still bound to the retained generic SOURCE. This is where the type
// arguments are deduced from the value arguments, a concrete declaration
// is queued through the shared init constructor, and the call continues
// down the ordinary concrete path.

// The best DECLARED type name for an expression -- the spelling a
// monomorphization name should be formed from. Ident bindings carry their
// declared spelling, struct fields their field annotation, and named
// aggregate / enum / FuncSig types come off the Expr's own Type payload;
// everything else falls back to type_to_name. The result goes through
// resolve_type_alias_for_name, so user aliases canonicalize while
// USize/UPtr stay target-independent -- exactly the rule init's explicit
// path uses, so both spellings select one implementation.
priv generic_field_declared_type := func(scope: TypeScope, e: Expr) returns Str {
    if e.children.len() == 0 { return "" }
    owner_o := expr_type_name_ref(e.children[0])
    if owner_o.is_none() { return "" }
    ref owner : Str = owner_o.unwrap()
    sd_o := scope.get_struct(owner)
    if sd_o.is_none() { return "" }
    mut fname := ""
    switch e.node_type {
    case .FieldAccess(fan): fname = Str.clone(fan.field_access_name())
    case:
        return ""
    }
    switch sd_o.unwrap().node_type {
    case .StructDef(sdd):
        for fd : Declaration in sdd.fields {
            if fd.name == fname { return fd.explicit_type.clone() }
        }
    case:
    }
    return ""
}

// The declared return spelling of a call, read off the RESOLVED callee.
// infer_func_def_expr normalizes a return type through resolve_type_alias
// but deliberately leaves USize/UPtr alone when the two widths differ, so
// this keeps a target-independent return name while a user alias has
// already canonicalized to the same primitive resolve_type_alias_for_name
// would pick anyway.
priv generic_call_declared_return := func(scope: TypeScope, e: Expr) returns Str {
    if e.children.len() == 0 { return "" }
    switch e.children[0].node_type {
    case .Ident(cn):
        fd_o := scope.lookup_func(cn.ident_name())
        if fd_o.is_none() { return "" }
        switch fd_o.unwrap().node_type {
        case .FuncDef(cfd): return cfd.return_type.clone()
        case:
        }
    case:
    }
    return ""
}

expr_declared_type_name := func(scope: TypeScope, e: Expr) returns Str {
    mut spelled := ""
    switch e.node_type {
    case .Ident(idn):
        b_o := scope.get_binding(idn.ident_name())
        if b_o.is_some() { spelled = b_o.unwrap().declared_type_name.clone() }
    case .FieldAccess:
        spelled = generic_field_declared_type(scope, e)
    case .FCall:
        spelled = generic_call_declared_return(scope, e)
    case:
    }
    if spelled.len() == 0 { spelled = type_to_name(e.til_type()) }
    if spelled.len() == 0 { return "" }
    return resolve_type_alias_for_name(scope, spelled).clone()
}

// Does this generic source -- or any generic source reachable from its
// calls -- declare a struct or enum in its body? A late instantiation
// skips the full init declaration pipeline (layout, generated methods,
// registration), so such a source keeps requiring explicit application.
priv generic_body_declares_type := func(e: Expr) returns Bool {
    if e.node_type.is(NodeType.Decl).and(e.children.len().gt(0)) {
        ref drhs : Expr = e.children[0]
        if drhs.node_type.is(NodeType.StructDef).or(drhs.node_type.is(NodeType.EnumDef)) { return true }
    }
    for c : Expr in e.children {
        if generic_body_declares_type(c) { return true }
    }
    return false
}

priv generic_closure_declares_type := func(scope: TypeScope, name: Str, mut seen: Set(Str)) returns Bool {
    if seen.has(name) { return false }
    seen.add(own name.clone())
    fd_o := scope.lookup_func(name)
    if fd_o.is_none() { return false }
    ref fd : Expr = fd_o.unwrap()
    if init_func_is_generic(fd).not() { return false }
    if generic_body_declares_type(fd) { return true }
    return generic_closure_walk_calls(scope, fd, seen)
}

priv generic_closure_walk_calls := func(scope: TypeScope, e: Expr, mut seen: Set(Str)) returns Bool {
    if e.node_type.is(NodeType.FCall).and(e.children.len().gt(0)) {
        switch e.children[0].node_type {
        case .Ident(cn):
            if generic_closure_declares_type(scope, cn.ident_name(), seen) { return true }
        case:
        }
    }
    for c : Expr in e.children {
        if generic_closure_walk_calls(scope, c, seen) { return true }
    }
    return false
}

// Is `pname` one of this source's type-parameter names?
priv generic_is_type_param := func(gfd: FunctionDef, pname: Str) returns Bool {
    for p : Declaration in gfd.params {
        if p.explicit_type.eq("Type").and(p.name.eq(pname)) { return true }
    }
    return false
}

// Issue #328: bind a type parameter that appears INSIDE a generated
// instance name. The parser mangles an annotation `v: Vec(T)` to
// `Vec__T` and a `Map(K, V)` to `Map__K_V`, so a formal and its operand
// are two spellings of the same shape: line the segments up and the
// argument falls out (`Vec__T` against `Vec__I64` gives T = I64).
//
// Deliberately conservative -- it declines rather than guesses. The bases
// must match, the argument counts must match, every non-parameter segment
// must match exactly (so a `ref_` mangle segment cannot be crossed with an
// owned one), and every position claiming the parameter must agree.
// Returns "" when the shape does not line up, which keeps the existing
// cannot-infer diagnostic.
priv generic_decompose_nested := func(gfd: FunctionDef, formal: Str, actual: Str, pname: Str) returns Str {
    fm := formal.find("__")
    am := actual.find("__")
    if fm.lt(0).or(am.lt(0)) { return "" }
    fm_u : USize = fm.to_usize()
    am_u : USize = am.to_usize()
    if formal.substr(0, fm_u).eq(actual.substr(0, am_u)).not() { return "" }
    if fm_u + 2 >= formal.len() { return "" }
    if am_u + 2 >= actual.len() { return "" }
    fargs := formal.substr(fm_u + 2, formal.len().sub(fm_u) - 2).split("_")
    aargs := actual.substr(am_u + 2, actual.len().sub(am_u) - 2).split("_")
    if fargs.len() != aargs.len() { return "" }
    mut bound := ""
    for i in 0..fargs.len() {
        ref fseg : Str = fargs[i]
        ref aseg : Str = aargs[i]
        if fseg.eq(pname) {
            if aseg.len() == 0 { return "" }
            if bound.len().gt(0).and(bound.eq(aseg).not()) { return "" }
            bound = aseg.clone()
        } else if generic_is_type_param(gfd, fseg) {
            // Another type parameter of the SAME generic: its own pass
            // binds it, so it is a wildcard here rather than a mismatch --
            // `Map__K_V` against `Map__Str_I64` binds K on this pass and V
            // on the next.
        } else if fseg.eq(aseg).not() {
            return ""
        }
    }
    return bound
}

// A value-only clone of the generic's signature: the `Type` params are
// gone and the variadic / kwargs block markers move with them. Used to
// desugar the omitted call through the ONE existing argument matcher
// (positional / named / defaults / variadic / call-site __LOC__) instead
// of writing a second one.
priv generic_value_only_fdef := func(gfd: FunctionDef) returns FunctionDef {
    mut out := FunctionDef(func_type = gfd.func_type, return_type = gfd.return_type.clone())
    mut vidx : I32 = gfd.variadic_index
    mut kidx : I32 = gfd.kwargs_index
    for i in 0..gfd.params.len() {
        ref p : Declaration = gfd.params[i]
        if p.explicit_type == "Type" {
            cpos : I32 = i.to_i64().to_i32()
            if vidx > cpos { vidx = vidx - 1 }
            if kidx > cpos { kidx = kidx - 1 }
            continue
        }
        out.params.push(own p.clone())
    }
    out.variadic_index = vidx
    out.kwargs_index = kidx
    return out
}

// Does the call spell its type arguments? The first PRESENT `Type` slot
// decides, exactly as in init: a real type token there means explicit
// application, anything else means the caller omitted them.
priv generic_call_is_explicit := func(scope: TypeScope, e: Expr, gfd: FunctionDef) returns Bool {
    for i in 0..gfd.params.len() {
        ref p : Declaration = gfd.params[i]
        if p.explicit_type.eq("Type").not() { continue }
        argidx := i + 1
        if argidx >= e.children.len() { return false }
        switch e.children[argidx].node_type {
        case .Ident(an):
            tb_o := scope.get_binding(an.ident_name())
            if tb_o.is_some() {
                return type_binding_is_type_token(scope, tb_o.unwrap())
            }
            return false
        case:
            return false
        }
    }
    return false
}

// Explicit late application: read the type tokens straight off the call.
priv generic_explicit_subs := proc(scope: TypeScope, e: Expr, gfd: FunctionDef, mut subs: Map(Str, Expr), mut ref_params: Set(Str), display_name: Str, mut ctx: Context) returns Bool {
    for i in 0..gfd.params.len() {
        ref p : Declaration = gfd.params[i]
        if p.explicit_type.eq("Type").not() { continue }
        argidx := i + 1
        if argidx >= e.children.len() {
            e.type_error(format("missing type argument for parameter '", p.name, "' of generic '", display_name, "'"), ctx)
            return false
        }
        ref arg : Expr = e.children[argidx]
        switch arg.node_type {
        case .Ident(an):
            tn := resolve_type_alias_for_name(scope, an.ident_name()).clone()
            mut tid := Expr.new(ident_node(tn), arg.line, arg.col)
            subs.set(p.name, own tid)
            if get_ref_arg(e, argidx) { ref_params.add(own p.name.clone()) }
        case:
            e.type_error(format("type argument for parameter '", p.name, "' of generic '", display_name, "' must be a type"), ctx)
            return false
        }
    }
    return true
}

// Omitted application: desugar the call against the value-only signature,
// infer every value argument, then read the type arguments back off the
// formals that ARE a type parameter (`v: T`, `own v: T`, `xs: ..T`).
//
// A typed non-literal operand is HARD evidence: several of them must
// denote the same concrete type, by exact primitive equality, aggregate
// name equality or named-FuncSig identity -- never by the permissive
// call-site compatibility rules (no interface conformance, no USize
// coercion, no wildcard funcptr match, no integer widening, #224).
// Numeric literals are SOFT: they narrow against hard evidence when there
// is any, and otherwise pick the documented I64 / F32 default. Dynamic,
// Unknown and null establish nothing at all.
priv generic_infer_subs := proc(mut scope: TypeScope, mut e: Expr, gfd: FunctionDef, mut subs: Map(Str, Expr), display_name: Str, in_func: I32, mut ctx: Context) returns Bool {
    vo := generic_value_only_fdef(gfd)
    if desugar_fcall_args_for_fdef(e, display_name, vo, 0, ctx).not() { return false }
    for ai in 1..e.children.len() {
        infer_expr(scope, e.children[ai], in_func, ctx)
    }
    // param name -> canonical type key (equality), declared spelling
    // (naming) and the site the evidence came from (diagnostics).
    mut ev_key := Map(Str, Str).new()
    mut ev_spell := Map(Str, Str).new()
    mut ev_site := Map(Str, Str).new()
    mut soft_num := Set(Str).new()
    mut soft_float := Set(Str).new()
    mut soft_empty := Set(Str).new()
    mut nested_only := Set(Str).new()
    // A parameter reached only through a generated instance name
    // (`Vec__T`) is deduced by lining the two spellings up below; the flag
    // records that this is where its evidence has to come from, so a
    // shape that does not line up says exactly that.
    for np : Declaration in vo.params {
        for tp : Declaration in gfd.params {
            if tp.explicit_type.eq("Type").not() { continue }
            if np.explicit_type.eq(tp.name) { continue }
            if type_name_mentions_param(np.explicit_type, tp.name) { nested_only.add(own tp.name.clone()) }
        }
    }
    fvi := vo.variadic_index
    fkwi := vo.kwargs_index
    mut fvc : USize = 0
    if fvi >= 0 { fvc = fcall_variadic_count(e, vo.params.len(), fkwi >= 0) }
    mut fkc : USize = 0
    if fkwi >= 0 { fkc = fcall_kwargs_count(e) }
    mut ci : USize = 1
    mut pi : USize = 0
    while pi < vo.params.len() {
        mut run : USize = 1
        if pi.to_i32() == fvi { run = fvc }
        if pi.to_i32() == fkwi { run = fkc }
        ref p : Declaration = vo.params[pi]
        // Nested: the formal is a generated instance name mentioning one
        // or more type parameters. Every operand in the run must agree.
        if generic_is_type_param(gfd, p.explicit_type).not() {
            for ntp : Declaration in gfd.params {
                if ntp.explicit_type.eq("Type").not() { continue }
                if type_name_mentions_param(p.explicit_type, ntp.name).not() { continue }
                for nk in 0..run {
                    if ci + nk >= e.children.len() { break }
                    ref narg : Expr = e.children[ci + nk]
                    nspell := expr_declared_type_name(scope, narg)
                    if nspell.len() == 0 { continue }
                    nbound := generic_decompose_nested(gfd, p.explicit_type, nspell, ntp.name)
                    if nbound.len() == 0 { continue }
                    nsite := format(ctx.path, ":", narg.line.to_str(), ":", narg.col.to_str())
                    if ev_key.has(ntp.name) {
                        if ev_key[ntp.name].eq(nbound).not() {
                            narg.type_error(format("conflicting evidence for type argument '", ntp.name,
                                "' of '", display_name, "': ", ev_key[ntp.name], " at ", ev_site[ntp.name],
                                " and ", nbound, " at ", nsite), ctx)
                            return false
                        }
                        continue
                    }
                    ev_key.set(ntp.name, own nbound.clone())
                    ev_spell.set(ntp.name, own nbound.clone())
                    ev_site.set(ntp.name, own nsite.clone())
                }
            }
        }
        if generic_is_type_param(gfd, p.explicit_type) {
            for k in 0..run {
                if ci + k >= e.children.len() { break }
                ref arg : Expr = e.children[ci + k]
                mut is_num := false
                mut is_float_num := false
                mut is_empty := false
                switch arg.node_type {
                case .Literal(Literal.Num(lnum)):
                    is_num = true
                    is_float_num = lnum.is_float()
                case .Literal(Literal.Null): is_empty = true
                case:
                }
                if is_num {
                    soft_num.add(own p.explicit_type.clone())
                    if is_float_num { soft_float.add(own p.explicit_type.clone()) }
                    continue
                }
                ref at : Type = arg.til_type()
                if is_empty.or(at.is(Type.Unknown)).or(at.is(Type.Dynamic)) {
                    soft_empty.add(own p.explicit_type.clone())
                    continue
                }
                mut spell := expr_declared_type_name(scope, arg)
                if spell.len() == 0 {
                    soft_empty.add(own p.explicit_type.clone())
                    continue
                }
                // The equality key comes from the operand's TYPE; a plain
                // Type.FuncPtr has no name of its own, so a value whose
                // declared type is a named FuncSig falls back to that
                // spelling -- two different signatures then still conflict.
                mut key := type_to_name(at)
                if key.len() == 0 { key = spell.clone() }
                // #342: a `..` splat stands for the array's ELEMENTS, so what
                // it says about `..T` is the element type. Reading the Array
                // itself made `gcount(..xs)` deduce T = Array__Str and then
                // demand an Array__Array__Str instance, and mixed it with a
                // plain element `gcount("x", ..xs)` became "conflicting
                // evidence: Str and Array__Str". A splat can only appear in
                // the variadic run, so nothing outside it is touched.
                if pi.to_i32() == fvi {
                    if get_splat_arg(e, ci + k) {
                        elem_spell := array_instance_elem_type_name(spell)
                        elem_key := array_instance_elem_type_name(key)
                        if elem_spell.len().gt(0).and(elem_key.len().gt(0)) {
                            spell = elem_spell.clone()
                            key = elem_key.clone()
                        }
                    }
                }
                site := format(ctx.path, ":", arg.line.to_str(), ":", arg.col.to_str())
                if ev_key.has(p.explicit_type) {
                    if ev_key[p.explicit_type].eq(key).not() {
                        arg.type_error(format("conflicting evidence for type argument '", p.explicit_type,
                            "' of '", display_name, "': ", ev_key[p.explicit_type], " at ", ev_site[p.explicit_type],
                            " and ", key, " at ", site), ctx)
                        return false
                    }
                    continue
                }
                ev_key.set(p.explicit_type, own key.clone())
                ev_spell.set(p.explicit_type, own spell.clone())
                ev_site.set(p.explicit_type, own site.clone())
            }
        }
        ci = ci + run
        pi++
    }
    for tp : Declaration in gfd.params {
        if tp.explicit_type.eq("Type").not() { continue }
        mut chosen := ""
        if ev_spell.has(tp.name) {
            chosen = ev_spell[tp.name].clone()
        } else if soft_num.has(tp.name) {
            // Literal-only: the documented defaults. A fractional or
            // exponent literal anywhere in the group picks F32.
            if soft_float.has(tp.name) { chosen = "F32" } else { chosen = "I64" }
        }
        if chosen.len() == 0 {
            if nested_only.has(tp.name) {
                e.type_error(format("cannot infer type argument '", tp.name, "' for '", display_name,
                    "': it appears only inside another type (nested type arguments are not deduced); pass it explicitly"), ctx)
            } else if soft_empty.has(tp.name) {
                e.type_error(format("cannot infer type argument '", tp.name, "' for '", display_name,
                    "': Dynamic and null arguments establish no type; pass it explicitly"), ctx)
            } else {
                e.type_error(format("cannot infer type argument '", tp.name, "' for '", display_name,
                    "'; pass it explicitly"), ctx)
            }
            return false
        }
        // A `..T` formal needs the concrete Array instance to EXIST: the
        // type-gen pass that synthesizes `Array__I64` is init-only, and it
        // has long finished by the time a call is typed. Init does
        // synthesize it for an explicit application, so that is the
        // instruction -- not a silent fallback to an untyped variadic.
        if vo.variadic_index >= 0 {
            ref vp : Declaration = vo.params[vo.variadic_index.to_usize()]
            if vp.explicit_type.eq(tp.name) {
                va_name := variadic_array_type_name(scope, chosen)
                if scope.get_struct(va_name).is_none() {
                    e.type_error(format("cannot infer type argument '", tp.name, "' for '", display_name,
                        "': its variadic '", vp.name, ": ..", tp.name, "' needs the '", va_name,
                        "' instance, which only explicit type application creates; pass it explicitly"), ctx)
                    return false
                }
            }
        }
        mut tid := Expr.new(ident_node(chosen), e.line, e.col)
        subs.set(tp.name, own tid)
    }
    return true
}

// Rewrite an expanded generic call IN PLACE: the callee becomes the
// concrete name and the `Type` arguments are dropped, own bits following
// their formals. The parent-slot variant lives in initer.til; here the
// caller holds the call itself, not its parent.
priv generic_rewrite_call_in_place := func(mut e: Expr, mono: Str, arg_pos: Vec(I64)) {
    mut new_ch := Vec(Expr).with_capacity(e.children.len())
    mut owned := Vec(Bool).new()
    // #342: splat_args is indexed like own_args, so a dropped `Type` argument
    // renumbers it too -- `gjoin(Str, "x", ..a)` otherwise left the bit on the
    // position the Type argument used to hold.
    mut splatted := Vec(Bool).new()
    new_ch.push(own Expr.new(ident_node(mono), e.children[0].line, e.children[0].col))
    for k in 1..e.children.len() {
        pidx := k - 1
        mut drop_arg := false
        if pidx < arg_pos.len() {
            if arg_pos[pidx] < 0 { drop_arg = true }
        }
        if drop_arg { continue }
        kept : Bool = get_own_arg(e, k)
        owned.push(own kept)
        kept_splat : Bool = get_splat_arg(e, k)
        splatted.push(own kept_splat)
        // Moved: the old children vector is dropped by move_from below, so a
        // clone here would copy each argument and free the original at once.
        new_ch.push(own take_expr(e.children[k]))
    }
    e.children.move_from(own new_ch)
    switch e.node_type {
    case .FCall(fcd):
        fcd.own_args = 0
        fcd.ref_args = 0
        fcd.splat_args = 0
    case:
    }
    for bi in 0..owned.len() {
        if owned[bi] { set_own_arg(e, bi + 1) }
    }
    for si in 0..splatted.len() {
        if splatted[si] { set_splat_arg(e, si + 1) }
    }
}

// Issue #328: a late concrete declaration is typed by the body loop only
// AFTER the caller that queued it, but the caller needs its ABI-relevant
// signature NOW -- whether the return and each parameter are shallow
// decides how the caller stores the result (#223 auto-shallow, and with
// it the #302 storage record the builder checks). Apply exactly the
// ownership normalization infer_func_def_expr applies, so the two agree;
// the full inference re-runs it idempotently when the body is typed.
priv generic_normalize_concrete_sig := func(mut scope: TypeScope, mut fdef_expr: Expr, mut ctx: Context) {
    switch fdef_expr.node_type {
    case .FuncDef(fdef):
        auto_ok := fdef.func_type.is_plain().or(fdef.func_type.is_lazy())
        if auto_ok.not() { return }
        widths_differ := resolve_type_alias(scope, "USize").eq(resolve_type_alias(scope, "UPtr")).not()
        if fdef.return_type.len() > 0 {
            rname := fdef.return_type.clone()
            ref resolved_r : Str = resolve_type_alias(scope, rname)
            if is_usize_name(rname).or(is_uptr_name(rname)).and(widths_differ).not() { fdef.return_type = resolved_r }
            if fdef.return_own_type.is(OwnType.Own) {
                rt := type_from_name(fdef.return_type, scope, ctx)
                if is_auto_shallow_type(rt, fdef.return_type, scope, ctx) { fdef.return_own_type = OwnType.Shallow }
            }
        }
        // Params are NOT pre-normalized: infer_func_def_expr rejects a
        // 'shallow' primitive param as redundant BEFORE it applies the
        // same Ref->Shallow normalization, so doing it early would turn
        // every inferred call into a spurious diagnostic. Only the return
        // ownership is needed this early, and only it is idempotent.
    case:
    }
}

// Instantiate through the shared init constructor, queue the concrete
// declaration, rewrite the call, and continue down the ordinary concrete
// path with the resolved concrete FunctionDef.
priv generic_finish_fcall := proc(mut scope: TypeScope, mut e: Expr, src_name: Str, subs: Map(Str, Expr), ref_params: Set(Str), explicit: Bool, in_func: I32, mut ctx: Context) {
    mut src := GenericFuncSource(name = src_name.clone(), path = ctx.path.clone())
    sb_o := scope.get_binding(src_name)
    if sb_o.is_some() {
        ref sb : TypeBinding = sb_o.unwrap()
        src.path = sb.path.clone()
        src.is_priv = sb.is_priv
    }
    gs := GenericSources(late = true)
    lt := Map(Str, Str).new()
    mut seen := Map(Str, Str).new()
    mut arg_pos := Vec(I64).new()
    pend_start := ctx.generic_pending.children.len()
    mono := generic_instantiate(src, scope.lookup_func(src_name).unwrap(), subs, ref_params, gs, lt, seen, ctx.generic_pending, arg_pos, e.line, e.col, scope, ctx)
    // Register while the Decl's FuncDef child is still in stable pending
    // storage; the flush re-registers everything after the single move.
    for k in pend_start..ctx.generic_pending.children.len() {
        if ctx.generic_pending.children[k].children.len() > 0 {
            generic_normalize_concrete_sig(scope, ctx.generic_pending.children[k].children[0], ctx)
        }
        // Against ctx.scope, NEVER the caller's nested body scope: the
        // concrete declaration is a UNIT-level function, and a binding
        // left in a body scope dies with it (the garbager then reads no
        // signature and records the wrong storage for the call result).
        register_function_def_for_stmt(ctx, ctx.generic_pending.children[k], ctx.scope)
    }
    if explicit {
        generic_rewrite_call_in_place(e, mono, arg_pos)
    } else {
        // The omitted call is already value-only after desugaring: only
        // the callee changes, every aligned value/ownership position stays.
        e.children[0] = Expr.new(ident_node(mono), e.line, e.col)
    }
    // #320/#328: the generic path is the ONLY legitimate consumer of a
    // `ref` argument bit. Anything left after type application is a ref on
    // a value argument, and gets the same hard error every other call does.
    if fcall_has_ref_args(e) {
        e.type_error("'ref' argument qualifier is only valid on type arguments of type templates (e.g. Opt(ref T))", ctx)
    }
    cfd_o := scope.lookup_func(mono)
    if cfd_o.is_none() {
        panic(ctx.path, ": concrete generic '", mono, "' is not registered")
    }
    mut cb_used := scope.get_binding(mono)
    if cb_used.is_some() {
        ref mut cbu : TypeBinding = cb_used.unwrap()
        cbu.used = true
    }
    ref cfd : FunctionDef = funcdef_of(cfd_o.unwrap())
    if explicit {
        if desugar_fcall_args_for_fdef(e, mono, cfd, 0, ctx).not() {
            e.set_til_type(Type.Unknown)
            return
        }
        for ai in 1..e.children.len() {
            infer_expr(scope, e.children[ai], in_func, ctx)
        }
    }
    infer_and_validate_fcall_args_for_fdef(scope, e, cfd, in_func, ctx)
    validate_fcall_own_args_for_fdef(scope, e, cfd, ctx)
    cb_used = scope.get_binding(mono)
    resolve_fcall_return_type(scope, e, mono, cb_used, cfd_o, in_func, ctx)
}

// #328 follow-up: is this binding a FUNCTION GENERATOR whose parameters
// are all types -- the macro `gid := func<T>(v: T) returns T { ... }`
// desugars to (a FuncDef-returning macro whose body is `return func(v: T)
// returns T { ... }`, #58's angle-bracket sugar, exactly as `struct<T>`
// desugars to a StructDef-returning macro)? Every EXPLICIT use is already
// rewritten by init (`gid(I64)(7)` reads as `gid__I64(7)`), so a macro
// call still standing here is the omitted-type-argument form and nothing
// else. A generator with VALUE params (#57's `macro(N: I64) returns
// FuncDef`) has no omittable arguments and is not this shape.
priv func_gen_macro_template := func(fd: Expr) returns Option(ref Expr) {
    switch fd.node_type {
    case .FuncDef(mfd):
        if mfd.func_type.is(FuncType.Macro).not() { return Option(ref Expr).None }
        if mfd.return_type.eq("FuncDef").or(mfd.return_type.eq("FunctionDef")).not() {
            return Option(ref Expr).None
        }
        if mfd.params.len() == 0 { return Option(ref Expr).None }
        for p : Declaration in mfd.params {
            if p.explicit_type.eq("Type").not() { return Option(ref Expr).None }
        }
    case:
        return Option(ref Expr).None
    }
    // body -> return -> the template FuncDef. A hand-written macro can
    // return anything, so every step is checked rather than assumed.
    if fd.children.len() == 0 { return Option(ref Expr).None }
    ref body : Expr = fd.children[0]
    if body.node_type.is(NodeType.Body).not() { return Option(ref Expr).None }
    if body.children.len() != 1 { return Option(ref Expr).None }
    ref ret : Expr = body.children[0]
    if ret.node_type.is(NodeType.Return).not() { return Option(ref Expr).None }
    if ret.children.len() != 1 { return Option(ref Expr).None }
    ref tmpl : Expr = ret.children[0]
    if tmpl.node_type.is(NodeType.FuncDef).not() { return Option(ref Expr).None }
    return Option(ref Expr).Some(tmpl)
}

// Build the DIRECT-generic equivalent of a function generator: the macro's
// type parameters prepended to the template's own parameters. That is the
// same function `gid := func(T: Type, v: T) returns T` spells by hand, so
// the whole #328 inference-and-instantiate path applies unchanged, and the
// instance it names (`gid__I64`) is the one init's macro expansion would
// have produced for the explicit form.
priv make_direct_generic_twin := func(macro_fd: Expr, tmpl: Expr) returns Expr {
    mut twin := FunctionDef()
    switch tmpl.node_type {
    case .FuncDef(tfd):
        twin.func_type = tfd.func_type
        twin.return_type = tfd.return_type.clone()
        twin.return_own_type = tfd.return_own_type
        twin.noreturn = tfd.noreturn
        for t : Str in tfd.throw_types { twin.throw_types.push(own t.clone()) }
        switch macro_fd.node_type {
        case .FuncDef(mfd):
            for gp : Declaration in mfd.params { twin.params.push(own gp.clone()) }
        case:
        }
        ntype := twin.params.len().to_i32()
        for vp : Declaration in tfd.params { twin.params.push(own vp.clone()) }
        // The variadic/kwargs markers index the PARAMETER LIST, so they
        // shift by however many type params were prepended. -1 means
        // "none" and must stay -1.
        twin.variadic_index = tfd.variadic_index
        if twin.variadic_index >= 0 { twin.variadic_index = twin.variadic_index + ntype }
        twin.kwargs_index = tfd.kwargs_index
        if twin.kwargs_index >= 0 { twin.kwargs_index = twin.kwargs_index + ntype }
    case:
    }
    mut def := Expr.new(NodeType.FuncDef(twin), tmpl.line, tmpl.col)
    for c : Expr in tmpl.children { def.add_child(own c.clone()) }
    return def
}

// Type a call whose callee is still bound to a retained generic SOURCE.
priv infer_generic_fcall := proc(mut scope: TypeScope, mut e: Expr, src_name: Str, display_name: Str, in_func: I32, mut ctx: Context) {
    // A source whose call closure declares a struct or enum needs init's
    // complete declaration pipeline (layout, generated methods,
    // registration); late instantiation cannot provide it, so those keep
    // requiring explicit type application.
    mut closure_seen := Set(Str).new()
    if generic_closure_declares_type(scope, src_name, closure_seen) {
        e.type_error(format("cannot infer type arguments for '", display_name, "': it declares a type in its body; pass them explicitly"), ctx)
        e.set_til_type(Type.Unknown)
        return
    }
    gfd_o := scope.lookup_func(src_name)
    mut subs := Map(Str, Expr).new()
    mut ref_params := Set(Str).new()
    mut ok := false
    mut explicit := false
    ref gfd : FunctionDef = funcdef_of(gfd_o.unwrap())
    explicit = generic_call_is_explicit(scope, e, gfd)
    if explicit.not() {
        // #328 task 11: a `throws T` (or `throws Err__T`) source is
        // deliberately not lowered before this point, so there is
        // nothing to infer against -- the caller must spell it.
        if generic_source_throws_depend_on_type(gfd_o.unwrap()) {
            e.type_error(format("cannot infer type arguments for '", display_name,
                "': its 'throws' clause names a type parameter; pass them explicitly"), ctx)
            e.set_til_type(Type.Unknown)
            return
        }
    }
    if explicit {
        ok = generic_explicit_subs(scope, e, gfd, subs, ref_params, display_name, ctx)
    } else {
        ok = generic_infer_subs(scope, e, gfd, subs, display_name, in_func, ctx)
    }
    if ok.not() {
        e.set_til_type(Type.Unknown)
        return
    }
    generic_finish_fcall(scope, e, src_name, subs, ref_params, explicit, in_func, ctx)
}

priv infer_fcall_expr := proc(mut scope: TypeScope, mut e: Expr, in_func: I32, mut ctx: Context) {
    // #320: ref-qualified args (`f(ref x)`) only mean something on type
    // arguments of type-gen macro instantiations, and those are fully
    // expanded during init -- any call still carrying a ref bit here is
    // user error, rejected instead of silently ignoring the qualifier.
    // #328: for an IDENT callee the rejection waits until the binding is
    // resolved, because an explicit `ref Type` argument to a retained
    // generic source is legitimate and is consumed by the generic path
    // below. Every other callee shape is rejected right here, as before.
    mut callee_is_ident := false
    if e.children.len() > 0 { callee_is_ident = e.children[0].node_type.is(NodeType.Ident) }
    if callee_is_ident.not() {
        if fcall_has_ref_args(e) {
            e.type_error("'ref' argument qualifier is only valid on type arguments of type templates (e.g. Opt(ref T))", ctx)
        }
    }
    // #344: no blanket "a UFCS receiver is written" mark here any more.
    // It fired before dispatch, on every `obj.method(...)` regardless of
    // what `method` does with its receiver, so `mut` survived on bindings
    // whose only use was a read-only method. The UFCS rewrite in
    // infer_field_access_fcall lands the receiver at parameter 0 of
    // `Type.method(recv, ...)` and runs it through
    // infer_and_validate_fcall_args_for_fdef, which marks it exactly when
    // the resolved `self` is `mut` -- the fact, instead of the guess.
    if e.children[0].node_type.is(NodeType.FieldAccess) {
        if infer_field_access_fcall(scope, e, in_func, ctx) { return }
    }
    ref mut callee : Expr = e.children[0]
    // Issue #58: postfix call on a cast result: `cast(raw, BinaryOp)(3, 4)`.
    // Recognise the cast-to-FuncSig shape, type the cast (which sets the
    // cast expr's til_type to Type.FuncPtr and keeps child(2) as the
    // FuncSig Ident), and validate the outer call against the FuncSig.
    if callee.node_type.is(NodeType.FCall) {
        infer_expr(scope, callee, in_func, ctx)
        if callee.til_type().is(Type.Body) {
            nargs := e.children.len() - 1
            if nargs != 0 {
                e.type_error(format("Body value expects 0 args, got ", nargs.to_str()), ctx)
            }
            if in_func != 0 {
                e.type_error("func cannot call Body value", ctx)
            } else if ctx.proc_def_depth > 0 {
                ctx.proc_calls_count = ctx.proc_calls_count + 1
            }
            e.set_til_type(Type.None)
            return
        }
        if infer_funcptr_call_via_cast(scope, e, in_func, ctx) { return }
        // Other FCall callees (e.g. `pick()(5)` on a funcptr-returning
        // call) are not supported yet; the switch below reports it.
    }
    mut name := ""
    switch callee.node_type {
    case .Ident(name0):
        // Reject user-code calls to the internal ~get_payload~ builtin.
        // The typer's switch case desugar in make_switch_case_condition
        // and the initer's generated method bodies pre-set til_type on
        // their emitted FCalls; user-written FCalls arrive here with
        // til_type still Unknown.
        if name0.ident_name() == "get_payload" {
            if e.til_type().is(Type.Unknown) {
                e.type_error("bare get_payload(...) is not allowed; use a switch case binding instead", ctx)
                return
            }
            // typer-emitted: infer the receiver argument so downstream
            // checks see its type, but skip the normal callee-binding
            // resolution -- otherwise resolve_fcall_return_type would
            // overwrite our preset Struct/Enum til_type with the
            // declared `Dynamic` return of dyn.til's get_payload, and a
            // condition-side field access on this FCall (e.g.
            // ~case Shape.Dot(Point(x = 0)):~) would then fail with
            // "field access on non-struct value".
            if e.children.len() > 1 {
                infer_expr(scope, e.children[1], in_func, ctx)
            }
            return
        }
        name = Str.clone(name0.ident_name())
    case:
        // A callee that is neither a name, a field access, a Body value,
        // nor a cast-to-FuncSig -- e.g. calling a call's result directly,
        // `pick()(5)`. Not supported yet; this used to be UNREACHABLE()
        // and crashed the COMPILER on ordinary-looking user code.
        e.type_error("cannot call this expression directly; bind it to a local first (f := ..., then f(args))", ctx)
        e.set_til_type(Type.Unknown)
        return
    }
    ref resolved_name : Str = resolve_type_alias(scope, name)
    if resolved_name.eq(name).not() {
        callee.node_type = ident_node(resolved_name)
        name = resolved_name.clone()
    }
    if name == "cast" {
        infer_cast_fcall(scope, e, in_func, ctx)
        return
    }
    if infer_struct_constructor_fcall(scope, e, name, in_func, ctx) { return }
    mut callee_bind_o := scope.get_binding(name)
    mut callee_fdef_o := Option(ref Expr).None
    // #328: set when the callee resolves to a retained generic SOURCE.
    // Recorded as a NAME so the binding borrow above is released before
    // the generic path mutates e.children and registers new bindings.
    mut generic_src_name := ""
    // #328 follow-up: set when the callee is an all-Type-param function
    // generator (the `func<T>` sugar's macro) and this is its omitted-type
    // -argument call. The twin is registered after the binding borrow is
    // released, for the same reason the name above is recorded rather than
    // the binding.
    mut func_gen_src_name := ""
    if callee_bind_o.is_some() {
        ref mut callee_bind : TypeBinding = callee_bind_o.unwrap()
        // #187: a call from inside a function is only evidence once that
        // function is itself reachable -- see mark_binding_referenced.
        // The source binding is credited here, before the call is
        // rewritten to a concrete name it does not own.
        mark_binding_referenced(ctx, callee_bind)
        note_cross_file_use(ctx, callee_bind.path)
        check_priv_access(e, name, callee_bind, ctx)
        callee_fdef_o = scope.lookup_func(callee_bind.name)
        if callee_fdef_o.is_some() {
            if init_func_is_generic(callee_fdef_o.unwrap()) {
                generic_src_name = callee_bind.name.clone()
            } else if func_gen_macro_template(callee_fdef_o.unwrap()).is_some() {
                func_gen_src_name = callee_bind.name.clone()
            } else {
                desugar_user_func_fcall_args(scope, e, name, callee_bind, ctx)
            }
        }
    }
    if func_gen_src_name.len() > 0 {
        // Swap the macro's func_def for its direct-generic twin, then hand
        // the call to the ordinary generic path. Every explicit use was
        // rewritten to a concrete name by init, so nothing left in this
        // unit still needs to read the macro through this binding.
        macro_fd_o := scope.lookup_func(func_gen_src_name)
        tmpl_o := func_gen_macro_template(macro_fd_o.unwrap())
        ctx.func_gen_twins.add_child(own make_direct_generic_twin(macro_fd_o.unwrap(), tmpl_o.unwrap()))
        ref twin : Expr = ctx.func_gen_twins.children[ctx.func_gen_twins.children.len() - 1]
        // Against ctx.scope, never the caller's nested body scope: the
        // macro's BINDING is a unit-level one, and lookup_func answers
        // from the scope that owns the binding -- a func_def parked in a
        // body scope with no binding beside it is simply never seen.
        ctx.scope.set_func_def(func_gen_src_name, twin)
        infer_generic_fcall(scope, e, func_gen_src_name, name, in_func, ctx)
        return
    }
    if generic_src_name.len() > 0 {
        infer_generic_fcall(scope, e, generic_src_name, name, in_func, ctx)
        return
    }
    if callee_is_ident {
        if fcall_has_ref_args(e) {
            e.type_error("'ref' argument qualifier is only valid on type arguments of type templates (e.g. Opt(ref T))", ctx)
        }
    }
    // Issue #289: array(T, ...) / vec(T, ...) carry the element type as a bare
    // type token in child(1) (like assert_eq's `T: Type`), not a Str. Handle
    // them before the generic arg machinery so the token is NOT rewritten into
    // a runtime Type expression by rewrite_til_type_arg -- array/vec are
    // monomorphized into Array__T / Vec__T at compile time, so the initer and
    // desugarer read the type NAME straight off this Ident.
    if name.eq("array").or(name.eq("vec")) {
        infer_array_vec_fcall(scope, e, name, in_func, ctx)
        return
    }
    // #288: a core_func / core_proc is an inline-only primitive intrinsic --
    // every backend lowers it natively, it emits NO symbol, and it must never
    // be indirected. dyn_fn is the one path that turns a (type, method) pair
    // into a callable funcptr (the FuncPtr fields CloneFn/CmpFn/HashFn/... are
    // all populated through it), so rejecting dyn_fn on a core_func also blocks
    // the FuncPtr-field and function-pointer vectors. dyn_fn takes the type
    // NAME as a Str (`dyn_fn("Type", "method")`); only that fully-literal shape
    // is statically checkable -- a Str-valued type argument
    // (`dyn_fn(elem_type, ...)`) is dynamic and skipped, and clone/cmp/hash
    // stay ext_func anyway.
    if name.eq("dyn_fn").and(e.children.len() >= 3) {
        switch e.children[1].node_type {
        case .Literal(Literal.Str(dyn_type_nm)):
            dyn_tdef_o := scope.get_struct(dyn_type_nm)
            if dyn_tdef_o.is_some() {
                ref dyn_tdef : Expr = dyn_tdef_o.unwrap()
                switch e.children[2].node_type {
                case .Literal(Literal.Str(dyn_meth)):
                    switch find_ns_decl(dyn_tdef, dyn_meth) {
                    case .None:
                    case .Some(dyn_md):
                        if dyn_md.default_value.is_some() {
                            switch dyn_md.default_expr().node_type {
                            case .FuncDef(dyn_mfd):
                                if dyn_mfd.func_type.is_core() {
                                    e.type_error(format("'", dyn_type_nm, ".", dyn_meth, "' is a ", func_type_name(dyn_mfd.func_type), " (an inline-only primitive intrinsic with no symbol) and cannot be indirected via dyn_fn"), ctx)
                                }
                            case:
                            }
                        }
                    }
                case:
                }
            }
        case:
        }
    }
    infer_and_validate_fcall_args(scope, e, callee_bind_o, callee_fdef_o, in_func, ctx)
    // Re-resolve: inferring the args above can instantiate a generic,
    // and registering the monomorphization grows the scope's binding
    // map, invalidating any ref taken before the call (same hazard the
    // callee documents).
    callee_bind_o = scope.get_binding(name)
    if name == "free" { check_free_managed_local(scope, e, ctx) }
    if name == "is_null" { check_is_null_arg_dynamic(scope, e, ctx) }
    // (check_move_managed_dest retired with the raw byte-move: `move` is
    // now the typed ownership primitive that destroys dest's old value
    // itself -- the guard's premise is gone, #302.)
    // Issue #191: macro calls require all arguments to be comptime-known.
    if callee_bind_o.is_some() {
        if binding_func_type(callee_bind_o.unwrap()).is(FuncType.Macro) {
            for ai in 1..e.children.len() {
                if e.children[ai].expr_is_comptime(scope).not() {
                    e.children[ai].type_error("macro argument must be known at compile time", ctx)
                }
            }
        }
    }
    // A call to something that is NOT callable. Every callable shape has
    // returned or been recognised by now: functions and signatures have a
    // func_def, funcptr values carry a funcptr type, a Body value its own,
    // struct constructors and cast/array/vec returned earlier. What is
    // left is a plain value with a call's syntax -- `x := 0` then `x(5)`
    // -- which the typer used to accept silently and the interpreter then
    // walked into with a NULL callee def and segfaulted on.
    if callee_bind_o.is_some() {
        ref nc_bind : TypeBinding = callee_bind_o.unwrap()
        if callee_fdef_o.is_none() {
            ref nc_type : Type = nc_bind.type
            mut nc_callable := nc_type.is_funcptr().or(nc_type.is(Type.Body))
            // An unresolved binding already produced its own diagnostic;
            // adding a second one here would just be noise.
            if nc_type.is(Type.Unknown) { nc_callable = true }
            // A value binding that merely SHADOWS a function of the same
            // name is not this bug: both backends resolve the call to the
            // function and it runs (`foo := 0` next to a global `foo` has
            // always called the global). Only a name with no function
            // behind it at all reaches the NULL callee def.
            if scope.any_func_def(name) { nc_callable = true }
            if nc_callable.not() {
                e.type_error(format("'", name, "' is not callable: it is a ",
                    type_to_name(nc_type), " value, not a function"), ctx)
                e.set_til_type(Type.Unknown)
                return
            }
        }
    }
    validate_fcall_own_args(scope, e, callee_fdef_o, ctx)
    resolve_fcall_return_type(scope, e, name, callee_bind_o, callee_fdef_o, in_func, ctx)
    return
}

infer_expr := proc(mut scope: TypeScope, mut expr: Expr, in_func: I32, mut ctx: Context) {
    switch expr.node_type {
    case .Literal(Literal.Num):  infer_literal_expr(expr)
    case .Literal(Literal.Null): infer_literal_expr(expr)
    // Issue #281: a DIRECT __LOC__ use resolves to this token's own location
    // (the same string the old parse-time expansion produced). A __LOC__ that
    // is a parameter/field DEFAULT never reaches here -- it is left untouched
    // on the Declaration and resolved by the default-fill (resolve_default_value)
    // to the caller's location instead (infer_type_def_expr skips it for fields).
    case .Loc:
        expr.node_type = NodeType.Literal(Literal.Str(format(ctx.path, ":", expr.line.to_str(), ":", expr.col.to_str())))
    case .Ident:       infer_ident_expr(scope, expr, ctx)
    case .FuncDef:     infer_func_def_expr(scope, expr, ctx)
    case .BodyValue:   infer_body_value_expr(scope, expr, ctx)
    case .StructDef, .EnumDef: infer_type_def_expr(scope, expr, ctx)
    case .FCall:       infer_fcall_expr(scope, expr, in_func, ctx)
    case .FieldAccess: infer_field_access_expr(scope, expr, in_func, ctx)
    case .Literal(Literal.MapLit):      infer_map_lit_expr(scope, expr, in_func, ctx)
    case .Literal(Literal.SetLit):      infer_set_lit_expr(scope, expr, in_func, ctx)
    case .NamedArg:    infer_named_arg_expr(scope, expr, in_func, ctx)
    case .Match:       infer_match_expr(scope, expr, in_func, ctx)
    case .Switch:
        // Issue #244: a switch reached expression position (e.g. `x := switch
        // ...`). switch is statement-only; point the user at match.
        expr.type_error("switch is a statement and yields no value; use 'match' to select a value", ctx)
        expr.set_til_type(Type.Unknown)
    case:
        expr.set_til_type(Type.Unknown)
    }
}

priv infer_ident_expr := proc(mut scope: TypeScope, mut expr: Expr, mut ctx: Context) {
    ref id_name : IdentData = ident_of(expr)
    type := scope.get_type(id_name.ident_name())
    if type.is(Type.Unknown) {
        // #341: the empty receiver a leading-dot variant parses to. One
        // that survives to here sat in a position with no expected enum
        // type to fill it from, so say that instead of reporting a
        // symbol named "" -- which reads like a compiler bug.
        if id_name.ident_name().len() == 0 {
            expr.type_error("a leading-dot enum variant needs a known enum type in this position; write the enum name out (issue #341)", ctx)
        } else {
            expr.type_error(format("undefined symbol '", Str.clone(id_name.ident_name()), "'"), ctx)
        }
    }
    expr.set_til_type(type)
    mut ib_o := scope.get_binding(id_name.ident_name())
    if ib_o.is_some() {
        ref mut ib : TypeBinding = ib_o.unwrap()
        // #154: cross-file edge is recorded unconditionally -- the
        // current_type_name gate below only guards the priv-decl
        // `used` flag, and a type's own ns methods live in the
        // type's file so a self-reference is a no-op edge anyway.
        note_cross_file_use(ctx, ib.path)
        // #187 step 1: skip "used" marking when we're inside the
        // ident's own type namespace. Auto-generated clone/delete/
        // variant-constructor bodies reference the parent type by
        // name; counting those would mask a genuinely unused priv
        // type. External Ident references still mark it used.
        // Same reachability rule for a name used as a value (a
        // function passed as a func-pointer, a global read).
        if ctx.current_type_name.eq(id_name.ident_name()).not() {
            mark_binding_referenced(ctx, ib)
        }
        check_priv_access(expr, id_name.ident_name(), ib, ctx)
        if scope.lookup_func(ib.name).is_some() {
            expr.set_til_type(Type.FuncPtr)
        }
        if scope.struct_def_of(ib.name).is_some() {
            if expr_type_name_ref(expr).is_none() {
                ref resolved_name : Str = resolve_type_alias(scope, id_name.ident_name())
                expr.set_til_type(Type.Custom(resolved_name.clone()))
            }
        }
    }
}

priv infer_named_arg_expr := proc(mut scope: TypeScope, mut expr: Expr, in_func: I32, mut ctx: Context) {
    if expr.children.len() > 0 {
        infer_expr(scope, expr.children[0], in_func, ctx)
    }
}

priv infer_map_lit_expr := proc(mut scope: TypeScope, mut expr: Expr, in_func: I32, mut ctx: Context) {
    for mut e_i : Expr in expr.children {
        infer_expr(scope, e_i, in_func, ctx)
    }
}

priv infer_set_lit_expr := proc(mut scope: TypeScope, mut expr: Expr, in_func: I32, mut ctx: Context) {
    for mut e_i : Expr in expr.children {
        infer_expr(scope, e_i, in_func, ctx)
    }
}

// Recursively scan `e` for any read or write of `self.<field_name>`
// (FieldAccess or FieldAssign whose receiver chain bottoms out in
// Ident("self")). Used to verify that user-written delete bodies
// reference each declared `own` field at least once -- if a field is
// never touched, the delete cannot possibly free it and any heap
// allocation the field's `own` qualifier announced is leaked at every
// destruction site (Map.delete, Vec.delete, scope_free, the
// auto-generated delete chain, etc.).
priv expr_uses_self_field := proc(e: Expr, field_name: Str) returns Bool {
    switch e.node_type {
    case .FieldAccess(fa_name):
        if fa_name.field_access_name() == field_name {
            if e.children.len() > 0 {
                switch e.children[0].node_type {
                case .Ident(id):
                    if id.ident_name() == "self" { return true }
                case:
                }
            }
        }
    case .FieldAssign(fad):
        if fad.name == field_name {
            if e.children.len() > 0 {
                switch e.children[0].node_type {
                case .Ident(id2):
                    if id2.ident_name() == "self" { return true }
                case:
                }
            }
        }
    case:
    }
    for ec : Expr in e.children {
        if expr_uses_self_field(ec, field_name) { return true }
    }
    return false
}

// Walk a struct's namespace decls; for the user-written `delete`
// (skip auto-generated ones), verify the body references each `own`
// field that the struct declares. A miss means the field's heap
// allocation has no path out -- the destructor silently leaks every
// time it runs. Issued at struct typing time so the error points at
// the struct declaration.
priv check_user_delete_frees_own_fields := proc(struct_name: Str, sdef: Expr, mut ctx: Context) {
    switch sdef.node_type {
    case .StructDef(cdsdd):
        cdnd_o := def_ns_get(sdef, "delete")
        if cdnd_o.is_none() { return }
        ref cdnd : Declaration = cdnd_o.unwrap()
        if cdnd.default_value.is_none() { return }
        switch cdnd.default_expr().node_type {
        case .FuncDef(cdfd):
            if cdfd.auto_generated { return }
            if cdnd.default_expr().children.len() == 0 { return }
            ref cdbody : Expr = cdnd.default_expr().children[0]
            mut cdfi : USize = 0
            for fd : Declaration in cdsdd.fields {
                cur_cdfi := cdfi
                cdfi = cdfi + 1
                if fd.own_type.is(OwnType.Own).not() { continue }
                ref cd_fname : Str = cdsdd.field_name_at(cur_cdfi)
                if expr_uses_self_field(cdbody, cd_fname).not() {
                    cdnd.default_expr().type_error(
                        format("delete on '", struct_name, "' never references 'own' field 'self.", cd_fname, "' -- declaring the field 'own' announces a heap allocation; the destructor must free it (e.g. `free(own self.", cd_fname, ")`) or transfer its ownership."), ctx)
                }
            }
        case:
        }
    case:
    }
}

// Resolve enum payload type names against scope so e.g. a macro param `T`
// used as `Variant: T` payload is marked used, matching how StructDef
// field types do.
priv typer_resolve_enum_payload_types := func(edef: EnumDef, mut scope: TypeScope, mut ctx: Context) {
    for vd_e : VariantDef in edef.variants {
        ref pt_e : Str = vd_e.payload_type
        if pt_e.len() > 0 {
            _ : Type = type_from_name(pt_e, scope, ctx)
        }
    }
}

// Issue #251: does the implementing method `impl_fd` match the interface's
// abstract-method signature `iface_fd`? Same param count, same param types
// and return type -- but the interface's OWN name is "Self" and substitutes
// to the implementing type's name (so `self: Drawable` in the interface
// matches `self: Circle` in Circle). The func KIND differs by design
// (interface: ext_func/ext_proc; impl: func/proc), so it is not compared.
priv interface_method_conforms := func(iface_name: Str, impl_name: Str, iface_fd: Expr, impl_fd: Expr) returns Bool {
    switch iface_fd.node_type {
    case .FuncDef(ifd):
        switch impl_fd.node_type {
        case .FuncDef(mfd):
            if ifd.params.len() != mfd.params.len() { return false }
            for i in 0..ifd.params.len() {
                mut it := ifd.params[i].explicit_type.clone()
                if it == iface_name { it = impl_name.clone() }
                if it.eq(mfd.params[i].explicit_type).not() { return false }
            }
            mut ir := ifd.return_type.clone()
            if ir == iface_name { ir = impl_name.clone() }
            return ir == mfd.return_type
        case:
            return false
        }
    case:
        return false
    }
}

priv infer_type_def_expr := proc(scope: TypeScope, mut expr: Expr, mut ctx: Context) {
    expr.set_til_type(Type.None)
    mut inner := TypeScope(parent = Option(ref TypeScope).Some(scope))
    switch expr.node_type {
    case .StructDef(tc_sdd):
        mut tcfi : USize = 0
        for mut fd : Declaration in tc_sdd.fields {
            ref tc_fname : Str = tc_sdd.field_name_at(tcfi)
            tcfi = tcfi + 1
            if fd.redundant_mut {
                // A mandatory mut field has no default expr to anchor the
                // error; report it on the type definition node instead.
                mut rm_at : Option(ref Expr) = Option(ref Expr).Some(expr)
                if fd.default_value.is_some() { rm_at = Option(ref Expr).Some(fd.default_expr()) }
                rm_at.unwrap().type_error(format("redundant 'mut' on struct field '", tc_fname, "': fields are mutable by default; drop the 'mut' (use 'const' to make the field immutable)"), ctx)
            }
            // Issue #281: a `loc: Str = __LOC__` field default must stay the
            // Loc sentinel here -- inferring it now would resolve it to this
            // definition site. It is resolved per-constructor-call by the
            // default-fill (resolve_default_value) to the CALLER's location.
            if fd.default_value.is_some()
                .and(fd.default_expr().node_type.is(NodeType.Loc).not()) {
                // #341: `kind : Shape = .Nothing` -- same rule as a typed
                // local, with the field's annotation as the expectation.
                if fd.explicit_type.len() > 0 {
                    qualify_dotted_expr(fd.default_expr(), type_from_name(fd.explicit_type, inner, ctx))
                }
                infer_expr(inner, fd.default_expr(), 0, ctx)
                check_ref_field_owned_default(tc_fname, fd, inner, ctx)
            }
            if fd.explicit_type.len() > 0 {
                fd.til_type =type_from_name(fd.explicit_type, inner, ctx)
                if fd.til_type.is(Type.Unknown).not() {
                    if fd.default_value.is_some() {
                        // #321: a 0 default on a Dynamic field is the null
                        // spelling (a hoisted-literal borrow otherwise).
                        rewrite_zero_to_null(fd.default_expr(), fd.til_type, fd.own_type.is(OwnType.Own))
                        if fd.default_expr().node_type.is_literal_num().and(is_numeric_type(fd.til_type)) {
                            fd.default_expr().set_til_type(fd.til_type)
                        }
                        if fd.default_expr().node_type.is_literal_null().not() {
                            narrow_dynamic(fd.default_expr(), fd.til_type)
                        }
                        // The `__LOC__` sentinel above is deliberately left
                        // uninferred, so it has no value type to compare.
                        if fd.default_expr().node_type.is(NodeType.Loc).not() {
                            check_declared_value_type(fd.default_expr(), tc_fname, fd.default_expr(), fd.til_type, fd.explicit_type, inner, ctx)
                        }
                    }
                }
            } else {
                if fd.default_value.is_none() {
                    // #242: no default means there is no expression to infer
                    // the field type from, so an explicit `: Type` is required.
                    // (No default expr to anchor the error; use the def node.)
                    expr.type_error(format("field '", tc_fname, "' has no default value, so it needs an explicit type: '", tc_fname, " : Type'"), ctx)
                } else if fd.default_value.is_some() {
                    fd.til_type =fd.default_expr().til_type().clone()
                }
            }
            inner.set(tc_fname, fd.til_type, fd.is_mut, ctx.path, expr.line, expr.col, false, fd.own_type)
            if fd.til_type.is_funcptr() {
                // Registered by the inner.set on the line above.
                ref fb : TypeBinding = inner.get_binding(tc_fname).unwrap()
                if fd.default_value.is_some() {
                    switch fd.default_expr().node_type {
                    case .Ident(dv_id):
                        src_o := inner.get_binding(dv_id.ident_name())
                        if src_o.is_some() {
                            ref src : TypeBinding = src_o.unwrap()
                            src_fd_o := inner.lookup_func(src.name)
                            if src_fd_o.is_some() { inner.set_func_def(tc_fname, src_fd_o.unwrap()) }
                        }
                    case:
                    }
                }
                if inner.lookup_func(fb.name).is_none() {
                    // Issue #58 / #147 step 5: read the FuncSig alias
                    // name from fd.til_type (Type.FuncPtrSig payload)
                    // instead of from fd.explicit_type + get_binding
                    // round-trip. The FuncPtrSig predicate already gates
                    // "this is a FuncSig"; the bodyless-FuncDef check
                    // below is the same belt-and-braces it always was.
                    if fd.til_type.is(Type.FuncPtrSig) {
                        fsig_name := til_type_name(fd.til_type)
                        if fsig_name.len() > 0 {
                            fsb_fd_o := inner.lookup_func(fsig_name)
                            if fsb_fd_o.is_some() {
                                ref fsb_fd : Expr = fsb_fd_o.unwrap()
                                if fsb_fd.children.len() == 0 {
                                    inner.set_func_def(tc_fname, fsb_fd)
                                }
                            }
                        }
                    }
                }
            }
        }
    case .EnumDef(tc_edd):
        // Issue #57: see typer_resolve_enum_payload_types.
        typer_resolve_enum_payload_types(tc_edd, inner, ctx)
    case:
    }
    // Issue #251: enforce the interface contract. `interface {...}`
    // desugars to a StructDef(is_interface) whose members the parser
    // accepts without checking. Each member must be ext_func/ext_proc
    // (an ABSTRACT method, implemented by conforming types) or func/proc
    // (a CONCRETE default with a body). A field, a test/macro/lazy member,
    // and a `namespace:` marker are all type errors. Reported here so they
    // aggregate in test/typer_errors.til.
    switch expr.node_type {
    case .StructDef(if_sdd):
        if if_sdd.is_interface {
            if if_sdd.interface_ns_marker {
                expr.type_error("interface has no 'namespace:' marker: it has no fields, so every declaration is already a method", ctx)
            }
            mut ifni : USize = 0
            for if_nd : Declaration in if_sdd.ns_decls {
                ref if_name : Str = if_sdd.member_name_at(ifni)
                ifni = ifni + 1
                if if_nd.default_value.is_none() { continue }
                switch if_nd.default_expr().node_type {
                case .FuncDef(if_fd):
                    // Skip clone/delete/size/hash etc. that the initer
                    // auto-generates for the (empty) interface struct --
                    // only user-written members carry the contract.
                    if if_fd.auto_generated { continue }
                    ift := if_fd.func_type
                    ok_kind := ift.is_plain().or(ift.is_ext())
                    if ok_kind.not() {
                        if_nd.default_expr().type_error(format("interface member '", if_name, "' must be a 'func'/'proc' (concrete default) or 'ext_func'/'ext_proc' (abstract method)"), ctx)
                    }
                case:
                    if_nd.default_expr().type_error(format("interface member '", if_name, "' must be a method: an interface cannot have fields"), ctx)
                }
            }
        }
    case:
    }
    // Issue #251: `struct implements Iface` / `enum implements Iface` --
    // verify the type provides every ABSTRACT (ext_func/ext_proc) method the
    // interface lists, with a matching signature. Concrete defaults are
    // inherited and not required. Structs and enums both carry methods in
    // their namespace, so the check is identical; only where the interface
    // name is recorded differs. Reported as aggregatable type errors.
    mut impl_iface_name := ""
    switch expr.node_type {
    case .StructDef(impl_sdd):
        impl_iface_name = impl_sdd.implements_name.clone()
    case .EnumDef(impl_edd):
        impl_iface_name = impl_edd.implements_name.clone()
    case:
    }
    if impl_iface_name.len() > 0 {
        impl_self_name := ctx.current_type_name
        iface_def_o := scope.get_struct(impl_iface_name)
        mut is_iface := false
        if iface_def_o.is_some() {
            switch iface_def_o.unwrap().node_type {
            case .StructDef(iface_idd):
                if iface_idd.is_interface { is_iface = true }
            case:
            }
        }
        if is_iface.not() {
            expr.type_error(format("'", impl_self_name, "' implements '", impl_iface_name, "', which is not an interface"), ctx)
        } else {
            // is_iface is only set inside the Some arm above.
            ref iface_def : Expr = iface_def_o.unwrap()
            ref ami_ns : Vec(Declaration) = def_ns_decls(iface_def)
            mut ami : USize = 0
            for am : Declaration in ami_ns {
                ref am_name : Str = def_ns_name_at(iface_def, ami)
                ami = ami + 1
                if am.default_value.is_none() { continue }
                switch am.default_expr().node_type {
                case .FuncDef(am_fd):
                    if am_fd.auto_generated { continue }
                    // Only abstract (ext_func/ext_proc) methods must be
                    // provided; func/proc defaults are inherited.
                    if am_fd.func_type.is_ext().not() { continue }
                    switch find_ns_decl(expr, am_name) {
                    case .None:
                        expr.type_error(format("'", impl_self_name, "' does not implement abstract method '", am_name, "' required by interface '", impl_iface_name, "'"), ctx)
                    case .Some(impl_m):
                        if interface_method_conforms(impl_iface_name, impl_self_name, am.default_expr(), impl_m.default_expr()).not() {
                            impl_m.default_expr().type_error(format("'", impl_self_name, ".", am_name, "' does not match the signature of '", impl_iface_name, ".", am_name, "' declared in the interface"), ctx)
                        }
                    }
                case:
                }
            }
        }
    }
    // Type-check ns_decls (stored directly by parser, not via body).
    // Flip ctx.typing_namespace_member so infer_func_def_expr accepts
    // test() decls at the namespace level (issue #51).
    //
    // #307 follow-up (the known-latent sibling-order class), three
    // passes so member typing does not depend on declaration order:
    //   1. register every function member's signature (a constant's
    //      initializer may call a sibling method declared later),
    //   2. infer constant initializers in sibling-dependency order
    //      (ns_const_eval_order -- a constant may read a sibling
    //      constant declared later),
    //   3. infer function bodies (they may read any sibling constant's
    //      settled type).
    saved_in_ns := ctx.typing_namespace_member
    ctx.typing_namespace_member = true
    ref mut tc_ns : Vec(Declaration) = def_ns_decls(expr)
    mut tcni : USize = 0
    for mut tc_nd : Declaration in tc_ns {
        ref tc_name : Str = def_ns_name_at(expr, tcni)
        tcni = tcni + 1
        if tc_nd.default_value.is_none() { continue }
        switch tc_nd.default_expr().node_type {
        case .FuncDef(tc_fd):
            mut tc_rt := Type.None
            if tc_fd.return_type.len() > 0 {
                tc_rt = type_from_name(tc_fd.return_type, inner, ctx)
            }
            tc_nd.til_type =tc_rt.clone()
            inner.set(tc_name, tc_rt, false, ctx.path, 0, 0, false, OwnType.Shallow)
            inner.set_func_def(tc_name, tc_nd.default_expr())
            ref mut tc_fb : TypeBinding = inner.get_binding(tc_name).unwrap()
            tc_fb.is_func_decl = true
            if tc_fd.func_type.is_bodyless() {
                tc_fb.is_builtin = true
            }
        case:
        }
    }
    tc_const_order := ns_const_eval_order(ctx.current_type_name, expr)
    for tc_ci_pos : I64 in tc_const_order {
        ref mut tc_cd : Declaration = tc_ns.unsafe_get(tc_ci_pos.to_usize())
        // A non-func namespace member is a constant (e.g. `MAX : F32 =
        // 3.4..e38`). Coerce its numeric literals to the declared type
        // before inference, exactly like top-level / local / field decls
        // (infer_decl_typed_value), so a typed float/int literal isn't
        // mis-parsed as I64 by the constfolder / interpreter.
        if tc_cd.explicit_type.len() > 0 {
            ns_declared := type_from_name(tc_cd.explicit_type, inner, ctx)
            if is_numeric_type(ns_declared) {
                pre_coerce_decl_numeric_literals(tc_cd.default_expr(), ns_declared)
            }
        }
        infer_expr(inner, tc_cd.default_expr(), 0, ctx)
        tc_cd.til_type =tc_cd.default_expr().til_type().clone()
    }
    // Issue #101: a member body is a top-level definition too, so it opens
    // its own synthesised-name window, named after the member's own C
    // symbol (`<Type>_<member>`) -- the same uniqueness the emitted
    // function names already depend on.
    mut tcbi : USize = 0
    for mut tc_bd : Declaration in tc_ns {
        ref tc_bname : Str = def_ns_name_at(expr, tcbi)
        tcbi = tcbi + 1
        if tc_bd.default_value.is_none() { continue }
        if tc_bd.default_expr().node_type.is(NodeType.FuncDef).not() { continue }
        saved_ns_synth_owner := ctx.synth_owner.clone()
        saved_ns_hoist := ctx.hoist_counter
        saved_ns_va := ctx.va_counter
        saved_ns_kw := ctx.kw_counter
        saved_ns_coll := ctx.coll_counter
        saved_ns_bang := ctx.bang_counter
        ctx.synth_owner = format(ctx.current_type_name, "_", tc_bname)
        ctx.hoist_counter = 0
        ctx.va_counter = 0
        ctx.kw_counter = 0
        ctx.coll_counter = 0
        ctx.bang_counter = 0
        infer_func_def_expr(inner, tc_bd.default_expr(), ctx)
        ctx.synth_owner = saved_ns_synth_owner
        ctx.hoist_counter = saved_ns_hoist
        ctx.va_counter = saved_ns_va
        ctx.kw_counter = saved_ns_kw
        ctx.coll_counter = saved_ns_coll
        ctx.bang_counter = saved_ns_bang
    }
    ctx.typing_namespace_member = saved_in_ns
    // Static check: a hand-written `delete` must free (or transfer) every
    // `own` field, otherwise the auto-generated destructor chain through
    // generated delete / Map.delete / Vec.delete / scope_free leaks the
    // allocation the field's `own` qualifier declared.
    if expr.node_type.is(NodeType.StructDef) {
        check_user_delete_frees_own_fields(ctx.current_type_name, expr, ctx)
    }
}

// Issue #223 step 3: a struct is auto-shallow (safe to pass/return by a
// byte copy, like a primitive) when ALL of:
//   - its size fits in a machine word (total_struct_size <= 8 = UPtr.size()),
//   - it has no `own` fields (an owned heap pointer would be aliased /
//     double-freed by a byte copy -> the struct is "deep"),
//   - it has no `ref` fields (disqualified for now; revisitable later), AND
//   - every field's TYPE is itself auto-shallow (a primitive or another
//     auto-shallow struct). The transitive check closes the hole where a
//     size-8 struct embeds a deep struct inline.
// Enums are not covered here (revisit separately). Mirrors builder's
// is_pod_struct field rules, plus the size gate.
PTR_SIZE_BYTES : USize = 8
priv is_shallow_struct := func(type_name: Str, scope: TypeScope, ctx: Context) returns Bool {
    if type_name.len() == 0 { return false }
    sdef_o := scope.get_struct(type_name)
    if sdef_o.is_none() { return false }
    ref sdef : Expr = sdef_o.unwrap()
    switch sdef.node_type {
    case .EnumDef:
        // #320: a NICHE enum is exactly one pointer with no owned payload
        // -- the same "small, trivially copyable, nothing to free" shape
        // step 3 accepts for structs, so it passes and returns by value.
        // Tagged enums stay pointer-passed (issue #223's open item).
        return enum_is_niche(sdef)
    case .StructDef(sdd):
        if ctx_total_size(type_name, ctx) > PTR_SIZE_BYTES { return false }
        if sdd.fields.len() == 0 { return false }
        for fd : Declaration in sdd.fields {
            if fd.own_type.is(OwnType.Own) { return false }
            if fd.own_type.is(OwnType.Ref) { return false }
            ref ftn : Str = fd.explicit_type
            if ftn.len() == 0 { return false }
            if is_primitive(til_type_from_explicit_type(ftn)) { continue }
            if is_shallow_struct(ftn, scope, ctx) { continue }
            return false
        }
        return true
    case:
    }
    return false
}

// A param/return type qualifies for auto-shallow if it is a primitive
// (step 1) or a small value-shaped struct (step 3).
priv is_auto_shallow_type := func(t: Type, type_name: Str, scope: TypeScope, ctx: Context) returns Bool {
    if is_primitive(t) { return true }
    if t.is(Type.Body) { return true }
    return is_shallow_struct(type_name, scope, ctx)
}

priv infer_func_sig_expr := func(scope: TypeScope, mut expr: Expr) {
    ref mut fdef : FunctionDef = funcdef_of(expr)
    // Issue #223 step 1: a function-pointer signature must match the
    // auto-shallow ABI of the ordinary func/proc it will hold, so
    // normalize primitive params/returns to Shallow here too. Otherwise
    // the call-through codegen would deref a value return as a pointer.
    sig_auto_shallow := fdef.func_type.is_plain()
    if fdef.return_type.len() > 0 {
        return_type_name := fdef.return_type.clone()
        ref resolved_return_type : Str = resolve_type_alias(scope, return_type_name)
        if is_usize_name(return_type_name).or(is_uptr_name(return_type_name)).and(resolve_type_alias(scope, "USize").eq(resolve_type_alias(scope, "UPtr")).not()).not() { fdef.return_type = resolved_return_type }
        // Issue #223 step 2: forbid redundant 'shallow' on a primitive
        // funcptr return. COMMENTED OUT during rollout (see infer_func_def_expr).
        // NOTE: infer_func_sig_expr is a func with no ctx, so enabling this
        // needs the diagnostic raised from a proc context.
        // if sig_auto_shallow.and(fdef.return_own_type.is(OwnType.Shallow)) {
        //     if is_primitive(til_type_from_explicit_type(resolved_return_type)) {
        //         <raise: redundant 'shallow' on primitive return type ... drop it>
        //     }
        // }
        if sig_auto_shallow.and(fdef.return_own_type.is(OwnType.Own)) {
            if is_primitive(til_type_from_explicit_type(resolved_return_type)) {
                fdef.return_own_type = OwnType.Shallow
            }
        }
    }
    for mut param : Declaration in fdef.params {
        ptype_name := param.explicit_type.clone()
        ref resolved_ptype : Str = resolve_type_alias(scope, ptype_name)
        // Keep USize/UPtr as their alias name ONLY when the two widths
        // actually differ (a --usize=32 / 32-bit build): there the coercion
        // must recognize size vs pointer params. When they are equal (the
        // default), resolve to the primitive as before -- byte-identical.
        if is_usize_name(ptype_name).or(is_uptr_name(ptype_name)).and(resolve_type_alias(scope, "USize").eq(resolve_type_alias(scope, "UPtr")).not()).not() { param.explicit_type = resolved_ptype }
        param.til_type =til_type_from_explicit_type(resolved_ptype)
        // Issue #58 / #147 step 5: if the param's type resolves to a
        // FuncSig alias (a bodyless FuncDef in scope), upgrade
        // til_type from Type.Custom(name) to Type.FuncPtrSig(name)
        // so downstream consumers (builder's fcall_fn_sig fallback,
        // typer's func_def propagation) can read the FuncSig name
        // off the type instead of off `param.explicit_type`. This
        // is what makes the FuncPtrSig migration reach param-level
        // til_type, not just expr-level inferred types.
        sig_fd_param_o := scope.lookup_func(resolved_ptype)
        if sig_fd_param_o.is_some() {
            if sig_fd_param_o.unwrap().children.len() == 0 {
                param.til_type = Type.FuncPtrSig(resolved_ptype.clone())
            }
        }
        // Issue #223 step 2: forbid redundant 'shallow' on a primitive
        // funcptr parameter. COMMENTED OUT during rollout (see infer_func_def_expr).
        // if sig_auto_shallow.and(fdef.return_own_type.is(OwnType.Ref).not()).and(param.own_type.is(OwnType.Shallow)).and(param.is_mut.not()).and(is_primitive(param.til_type)) {
        //     <raise: redundant 'shallow' on primitive parameter ... drop it>
        // }
        if sig_auto_shallow.and(fdef_return_carries_borrow(fdef, scope).not()).and(param.own_type.is(OwnType.Ref)).and(param.is_mut.not()).and(is_primitive(param.til_type)) {
            param.own_type = OwnType.Shallow
        }
        // A FuncPtr param is an 8-byte pointer; the C ABI passes it
        // by value just like a primitive, so the funcptr-sig has to
        // match auto-shallow too. Otherwise emit_fcall_funcptr_cast
        // generates `(void * *)` for the param and the arg emit
        // takes its address, both wrong for a callee that expects
        // the function pointer by value. param.til_type at this
        // point is Type.Custom(name) -- the FuncPtr-ness lives in
        // the scope binding for the alias name, not in the inline
        // Type, so look it up.
        if sig_auto_shallow.and(fdef_return_carries_borrow(fdef, scope).not()).and(param.own_type.is(OwnType.Ref)).and(param.is_mut.not()) {
            pbind_o := scope.get_binding(resolved_ptype)
            mut pbind_is_funcptr := false
            if pbind_o.is_some() { pbind_is_funcptr = pbind_o.unwrap().type.is_funcptr() }
            if param.til_type.is(Type.Body).or(pbind_is_funcptr) {
                param.own_type = OwnType.Shallow
            }
        }
    }
    expr.set_til_type(Type.FuncPtr)
}

// #321: true when calling this function hands a BORROW back to the
// caller -- either declared `returns ref`, or returning an enum with a
// borrowed payload (Option(ref T) and friends). The param-demotion gates
// below must treat the two the same: auto-shallow turns a borrowed
// aggregate param into a by-value copy, which is safe only if no borrow
// of it escapes. It does escape through a ref payload, and the emitted C
// then took the address of the callee's dead stack copy --
// `pick(c: Cell) returns Option(ref Cell)` silently lost every write
// through the returned borrow while the `returns ref Cell` twin worked.
priv fdef_return_carries_borrow := func(fdef: FunctionDef, scope: TypeScope) returns Bool {
    if fdef.return_own_type.is(OwnType.Ref) { return true }
    if fdef.return_type.len() == 0 { return false }
    ref resolved : Str = resolve_type_alias(scope, fdef.return_type)
    rdef_o := scope.get_struct(resolved)
    if rdef_o.is_none() { return false }
    return enum_has_ref_payload(rdef_o.unwrap())
}

priv check_ref_function_returns := proc(func_scope: TypeScope, expr: Expr, mut ctx: Context) {
    mut throws_count : USize = 0
    ref fdef : FunctionDef = funcdef_of(expr)
    if fdef.return_own_type.is(OwnType.Ref).not() { return }
    throws_count = fdef.throw_types.len()
    for stmt : Expr in expr.children[0].children {
        if stmt.node_type.is(NodeType.Return).not() { continue }
        if stmt.children.len() == 0 { continue }
        ref rv : Expr = stmt.children[0]
        // A throwing ref-returning fn gets a synthetic `return null`
        // fallback from process_throw_catch_in_func_body. It is
        // unreachable on the success path and unused on the error path
        // (the err code flows out through the out-param), so allow it.
        if throws_count.gt(0).and(rv.node_type.is_literal_null()) { continue }
        if expr_is_borrow_source(rv, func_scope).not() {
            stmt.type_error("ref function must return a parameter or ref variable", ctx)
        }
    }
}

priv first_borrowed_capture_name := func(e: Expr) returns Str {
    switch e.node_type {
    case .FuncDef(fd):
        for cap : Declaration in fd.captures {
            if cap.own_type.is(OwnType.Ref) { return cap.name.clone() }
        }
    case:
    }
    return ""
}

priv closure_borrowed_capture_name := func(e: Expr, scope: TypeScope) returns Str {
    switch e.node_type {
    case .FuncDef:
        return first_borrowed_capture_name(e)
    case .Ident(id):
        fdef_o := scope.lookup_func(id.ident_name())
        if fdef_o.is_none() { return "" }
        return first_borrowed_capture_name(fdef_o.unwrap())
    case:
    }
    return ""
}

// #54: true when `name` denotes a GLOBAL -- a binding that lives in the
// program root scope and is not shadowed by anything in this function. A
// closure stored there outlives the call that built it.
priv assign_target_is_global := func(name: Str, func_scope: TypeScope) returns Bool {
    if func_scope.bindings.has(name) { return false }
    ref root : TypeScope = scope_root_ref(func_scope)
    return root.bindings.has(name)
}

// #54: the root binding name of an lvalue chain (`g.a.b` -> `g`), or "" when
// the chain does not root in a plain name. Used to decide whether a
// FieldAssign target lives in a global.
priv closure_lvalue_root := func(e: Expr) returns Str {
    switch e.node_type {
    case .Ident(rid): return Str.clone(rid.ident_name())
    case .FieldAccess:
        if e.children.len() > 0 { return closure_lvalue_root(e.children[0]) }
    case:
    }
    return ""
}

// #54: does this function body STORE the parameter named `pname` somewhere
// that outlives the call -- a global, or a global's field? Whole-program
// compilation makes the callee visible, so the escape is decidable here with
// no annotation on the signature. `root` is the callee's own root scope; a
// name it does not know is not a global of ours.
priv body_stores_param_globally := func(e: Expr, pname: Str, root: TypeScope, depth: I32) returns Bool {
    if depth > 128 { return false }
    switch e.node_type {
    case .FuncDef: return false          // nested def: its own params
    case .Assign(sad):
        if root.bindings.has(sad.name).and(e.children.len().gt(0)) {
            switch e.children[0].node_type {
            case .Ident(sid):
                if sid.ident_name() == pname { return true }
            case:
            }
        }
    case .FieldAssign:
        if e.children.len() > 1 {
            froot := closure_lvalue_root(e.children[0])
            if froot.len().gt(0).and(root.bindings.has(froot)) {
                switch e.children[1].node_type {
                case .Ident(fid):
                    if fid.ident_name() == pname { return true }
                case:
                }
            }
        }
    case:
    }
    for c : Expr in e.children {
        if body_stores_param_globally(c, pname, root, depth + 1) { return true }
    }
    return false
}

// #54: a function that STORES a parameter somewhere outliving the call must
// own it. Storing a BORROWED parameter globally keeps a reference the caller
// still owns and destroys: for a closure argument the caller emits
// `drop(env); free(til_closure)` right after the call, so the global is left
// pointing at freed memory (ASAN: heap-use-after-free). Declaring the
// parameter `own` transfers it instead, and the caller stops freeing --
// verified: the same program runs correctly with `own f`. Checked on the
// DEFINITION, so it holds no matter who calls it.
priv check_param_stored_globally := proc(fdef: Expr, func_scope: TypeScope, mut ctx: Context) {
    if fdef.children.len() == 0 { return }
    ref pfd : FunctionDef = funcdef_of(fdef)
    if pfd.variadic_index >= 0 { return }
    ref pbody : Expr = fdef.children[0]
    ref proot : TypeScope = scope_root_ref(func_scope)
    for pp : Declaration in pfd.params {
        if pp.own_type.is(OwnType.Ref).not() { continue }
        if pp.name.len() == 0 { continue }
        if body_stores_param_globally(pbody, pp.name, proot, 0).not() { continue }
        fdef.type_error(format("parameter '", pp.name,
            "' is stored where it outlives this call, but it is only borrowed; ",
            "declare it 'own ", pp.name, "' so the caller transfers ownership ",
            "instead of destroying it after the call"), ctx)
    }
}

priv check_returned_borrowed_closure_captures_in := proc(e: Expr, func_scope: TypeScope, mut ctx: Context) {
    switch e.node_type {
    case .Return:
        if e.children.len() == 0 { return }
        cap_name := closure_borrowed_capture_name(e.children[0], func_scope)
        if cap_name.len() > 0 {
            e.type_error(format("returned closure borrows captured local '", cap_name,
                "'; capture it as 'own ", cap_name, "' or 'shallow ", cap_name,
                "' if the closure escapes"), ctx)
        }
        return
    case .Assign(gad):
        // #54: storing a borrowed-capture closure in a GLOBAL is the same
        // escape as returning one -- the global outlives the call, so the
        // captured stack local dangles the moment the function returns
        // (ASAN: stack-use-after-return). Same diagnostic and same fix.
        if e.children.len() > 0 {
            if assign_target_is_global(gad.name, func_scope) {
                gcap := closure_borrowed_capture_name(e.children[0], func_scope)
                if gcap.len() > 0 {
                    e.type_error(format("closure stored in global '", gad.name,
                        "' borrows captured local '", gcap, "'; capture it as 'own ", gcap,
                        "' or 'shallow ", gcap, "' if the closure escapes"), ctx)
                }
            }
        }
    case .FieldAssign(gfad):
        // #54: same escape one level deeper -- `g.fn = <closure>` where `g` is
        // a global. The field outlives the call exactly as the global does, so
        // a borrowed capture dangles on return (ASAN: stack-use-after-return,
        // and the read returns garbage). Children are [receiver, rhs].
        if e.children.len() > 1 {
            froot := closure_lvalue_root(e.children[0])
            if froot.len() > 0 {
                if assign_target_is_global(froot, func_scope) {
                    fcap := closure_borrowed_capture_name(e.children[1], func_scope)
                    if fcap.len() > 0 {
                        e.type_error(format("closure stored in global '", froot, ".", gfad.name,
                            "' borrows captured local '", fcap, "'; capture it as 'own ", fcap,
                            "' or 'shallow ", fcap, "' if the closure escapes"), ctx)
                    }
                }
            }
        }
    case .FuncDef:
        return
    case:
    }
    for c : Expr in e.children {
        check_returned_borrowed_closure_captures_in(c, func_scope, ctx)
    }
}

priv check_returned_borrowed_closure_captures := proc(func_scope: TypeScope, expr: Expr, mut ctx: Context) {
    switch expr.node_type {
    case .FuncDef:
        if expr.children.len() == 0 { return }
        check_returned_borrowed_closure_captures_in(expr.children[0], func_scope, ctx)
    case:
        UNREACHABLE("expected FuncDef, got ", expr.node_type.head_str())
    }
}

priv infer_func_def_expr := proc(mut scope: TypeScope, mut expr: Expr, mut ctx: Context) {
    if expr.children.len() == 0 {
        infer_func_sig_expr(scope, expr)
        return
    }
    expr.set_til_type(Type.None)
    // Snapshot + clear the namespace flag so nested funcs typed by
    // recursive infer_expr calls aren't treated as namespace members.
    ifd_in_ns := ctx.typing_namespace_member
    ctx.typing_namespace_member = false
    switch expr.node_type {
    case .FuncDef(fdef):
        // Issue #262: a lazy_func types like a func (cannot call proc,
        // tracks its return type); a lazy_proc types like neither func nor
        // proc here so its body may call procs without the "proc has no
        // proc calls" diagnostic. All lazy calls are inlined before this
        // pass runs, so these defs are dead -- they only need to type and
        // emit as ordinary functions.
        is_func := fdef.func_type.is(FuncType.Func).or(fdef.func_type.is(FuncType.LazyFunc)).or(fdef.func_type.is(FuncType.CoreLazyFunc))
        is_macro := fdef.func_type.is(FuncType.Macro)
        // #303 seed: core exit is the one noreturn primitive that cannot
        // be inferred -- an ext_func with no til body, bound to libc exit,
        // which never returns. It is the only ext_func in core/exit.til;
        // everything else (panic, TODO, UNREACHABLE, user wrappers) is
        // inferred bottom-up from bodies at the end of this function.
        if fdef.func_type.is(FuncType.ExtFunc).and(ctx.path.ends_with("core/exit.til")) {
            fdef.noreturn = true
        }
        // Issue #262: a lazy callable's body must be handled by the loader's
        // lazy passes -- either expression-inlinable (lazy_body_inlinable:
        // single `return <expr>`, `if/else`, or guard chain) or statement-
        // inlinable (lazy_body_stmt_inlinable: a safe prelude + an inlinable
        // tail, e.g. `x := f(a); return x.and(b)`). Reject anything else
        // loudly (loops, early returns, first-class) -- those need the thunk
        // fallback and would otherwise silently degrade to an eager call.
        if fdef.func_type.is_lazy() {
            if expr.children.len() > 0 {
                // Issue #262: the RECURSIVE variadic form (vand/vor) is fully
                // consumed by the loader's recursion-unroll -- every call is
                // already expanded -- and its ListPattern arms cannot type as
                // ordinary code, so skip typing the def entirely (the same
                // way template macro bodies are skipped). The builder skips
                // its emission via the same predicate.
                if lazy_recursive_variadic_def(expr) {
                    expr.set_til_type(Type.None)
                    ctx.typing_namespace_member = ifd_in_ns
                    return
                }
                ref lbody : Expr = expr.children[0]
                if lazy_body_inlinable(lbody).or(lazy_body_stmt_inlinable(lbody)).not() {
                    // Issue #262: a variadic lazy def is accepted when its
                    // body is unrollable -- the loader unrolls every call
                    // over its known operands (inline_variadic_lazy_call),
                    // so the def itself is dead like any inlinable lazy def.
                    mut lazy_var_unrollable := false
                    if fdef.variadic_index >= 0 {
                        ref vparam : Declaration = fdef.params[fdef.variadic_index.to_usize()]
                        lazy_var_unrollable = lazy_variadic_body_unrollable(lbody, vparam.name)
                    }
                    if lazy_var_unrollable.not() {
                        expr.type_error("lazy_func/lazy_proc body must be inlinable for now (issue #262): a single 'return <expr>', an 'if/else' or guard chain, a prelude of local bindings followed by such a tail, or a variadic body consuming its variadic param only via 'for x in xs { if ... { return ... } }' loops or the recursive 'match xs { case []: ... case [x, ..tl]: ... }' form; other loops, early returns, and first-class use are not yet supported", ctx)
                    }
                }
            }
        }
        // Issue #57: macros that are pure templates (returning
        // StructDef / EnumDef / FuncDef, or with a `Type` parameter) are
        // expanded at each call site by initer's pre-pass. Detect the
        // condition up front so every subsequent body-walk and param-
        // resolution skip cleanly -- references to the type-params can't
        // be resolved until expansion. Mirrors rstil typer.rs:1090-1097.
        mut macro_is_template := false
        if is_macro {
            mtg_ret := fdef.return_type.eq("StructDef")
                .or(fdef.return_type.eq("EnumDef"))
                .or(fdef.return_type.eq("FuncDef"))
                .or(fdef.return_type.eq("FunctionDef"))
            if mtg_ret { macro_is_template = true }
            if macro_is_template.not() {
                for tmp_param : Declaration in fdef.params {
                    if tmp_param.explicit_type == "Type" {
                        macro_is_template = true
                    }
                }
            }
        }
        // Issue #223 step 1: auto-shallow applies to ordinary til
        // func/proc definitions only. ext_func/ext_proc qualifiers map
        // directly to a hand-written C signature (e.g. U64_clone takes a
        // 'const U64 *'), so their shallow-ness must be preserved exactly.
        auto_shallow_ok := fdef.func_type.is_plain().or(fdef.func_type.is_lazy())
        if fdef.func_type.is(FuncType.Test) {
            // Allowed at root scope, or at the immediate namespace
            // level of a struct/enum (issue #51).  Tests in arbitrary
            // nested function bodies are still rejected.
            if scope.parent.is_some().and(ifd_in_ns.not()) {
                expr.type_error("test functions can only be declared at root scope or in a struct/enum namespace", ctx)
            }
            if fdef.return_type.len() > 0 {
                expr.type_error("test functions cannot have a return type", ctx)
            }
            if fdef.params.len() > 0 {
                expr.type_error("test functions cannot have parameters", ctx)
            }
        }
        if ctx.mode.is_pure {
            if fdef.func_type.is(FuncType.Proc) {
                expr.type_error("proc not allowed in pure mode", ctx)
            }
        }
        mut func_scope := TypeScope(parent = Option(ref TypeScope).Some(scope), is_func_root = true)
        if fdef.return_type.len() > 0 {
            return_type_name := fdef.return_type.clone()
            ref resolved_return_type : Str = resolve_type_alias(scope, return_type_name)
            if is_usize_name(return_type_name).or(is_uptr_name(return_type_name)).and(resolve_type_alias(scope, "USize").eq(resolve_type_alias(scope, "UPtr")).not()).not() { fdef.return_type = resolved_return_type }
            check_priv_type_name(expr, resolved_return_type, scope, ctx)
            // Issue #223 step 2: an explicit 'shallow' on a primitive return is
            // redundant (auto-shallow handles it). Reject it. Test the parser's
            // return_shallow_explicit flag, NOT return_own_type: the step-1
            // normalization below overwrites Own->Shallow for primitives, so
            // checking return_own_type would misfire on any RE-inference of the
            // def (e.g. a capturing closure re-typed as a UFCS-receiver-call
            // arg, which the auto-shallow pass had already normalized).
            if auto_shallow_ok.and(fdef.return_shallow_explicit) {
                if is_primitive(type_from_name_at(resolved_return_type, scope, expr, ctx)) {
                    expr.type_error("redundant 'shallow' on primitive return type: primitives are returned by value automatically (issue #223); drop it", ctx)
                }
            }
            // Issue #223 step 1/3: a primitive (step 1) or a small value-shaped
            // struct (step 3) is returned by value (shallow) even without the
            // qualifier. Normalize the default (Own) to Shallow for those types
            // so every downstream stage treats them as value types. Explicit
            // 'ref' returns are left alone (a borrowed pointer is intentional).
            if auto_shallow_ok.and(fdef.return_own_type.is(OwnType.Own)) {
                rt := type_from_name_at(resolved_return_type, scope, expr, ctx)
                if is_auto_shallow_type(rt, resolved_return_type, scope, ctx) { fdef.return_own_type = OwnType.Shallow }
            }
        }
        // #302: main is never called from til code -- the builder's argv
        // prologue IS its params' constructor and no caller frees them --
        // so a main param still borrowed AFTER auto-shallow (an aggregate:
        // Str, Array) is OWNED by main. Recorded on the Declaration, just
        // before the binding below inherits own_type, instead of the old
        // ctx.typer_in_main_func flag the garbager special-cased at a
        // distance. Shallow params (scalars, auto or explicit) stay: they
        // parse straight into C stack values, no heap box.
        in_main_def := ctx.current_top_func_name.eq("main").and(scope.parent.is_none())
        for i in 0..fdef.params.len() {
            ref mut param : Declaration = fdef.params[i]
            // #321: a `p: Dynamic = 0` param default is the null spelling;
            // the fill clones the rewritten node into call sites.
            if param.default_value.is_some().and(param.til_type.is(Type.Dynamic).or(til_type_from_explicit_type(param.explicit_type).is(Type.Dynamic))) {
                rewrite_zero_to_null(param.default_expr(), Type.Dynamic, param.own_type.is(OwnType.Own))
            }
            ptype_name := param.explicit_type.clone()
            ref resolved_ptype : Str = resolve_type_alias(scope, ptype_name)
            // Keep USize/UPtr as their alias name ONLY when the two widths
            // actually differ (a --usize=32 / 32-bit build): there the coercion
            // must recognize size vs pointer params. When they are equal (the
            // default), resolve to the primitive as before -- byte-identical.
            if is_usize_name(ptype_name).or(is_uptr_name(ptype_name)).and(resolve_type_alias(scope, "USize").eq(resolve_type_alias(scope, "UPtr")).not()).not() { param.explicit_type = resolved_ptype }
            param.til_type =til_type_from_explicit_type(resolved_ptype)
            ref ptn : Str = param.explicit_type
            pt := type_from_name_at(ptn, scope, expr, ctx)
            // Issue #58 / #147 step 5: same FuncPtrSig upgrade as in
            // infer_func_sig_expr -- if the param's type resolves to a
            // FuncSig (Type.FuncPtrSig(name)), store that on til_type so
            // downstream readers don't need to go through param.explicit_type.
            if pt.is(Type.FuncPtrSig) {
                param.til_type = pt.clone()
            }
            // Issue #57: skip the undefined-type diagnostic for template
            // macros -- a param like `T` is a stand-in resolved at
            // expansion time, not a real type.
            if pt.is(Type.Unknown).and(macro_is_template.not()) {
                expr.type_error(format("undefined type '", ptn, "'"), ctx)
            }
            pmut := param.is_mut
            pown := param.own_type.is(OwnType.Own)
            pshallow := param.own_type.is(OwnType.Shallow)
            if pshallow {
                is_scalar := is_primitive(pt)
                if is_scalar.not().and(pt.is(Type.Struct).not()).and(pt.is(Type.Enum).not()) {
                    expr.type_error(format("shallow parameter '", param.name, "' must be a scalar or struct type"), ctx)
                }
                if pown {
                    expr.type_error("parameter cannot be both 'shallow' and 'own'", ctx)
                }
                // Issue #223 step 2: an explicit 'shallow' on a primitive
                // parameter is redundant where auto-shallow applies (ordinary
                // func/proc not returning ref). Reject it.
                if is_scalar.and(auto_shallow_ok).and(fdef_return_carries_borrow(fdef, scope).not()) {
                    expr.type_error(format("redundant 'shallow' on primitive parameter '", param.name, "': primitives are passed by value automatically (issue #223); drop it"), ctx)
                }
            }
            if i.to_i32() == fdef.variadic_index {
                // Regular til funcs get a callee-side auto-cleanup
                // (Array.delete at scope exit) so the caller can transfer
                // ownership cleanly. ext_func/ext_proc bodies are
                // user-written C with no auto-cleanup -- transferring
                // ownership leaks the synthesized Array. Keep the parser's
                // Ref setting for ext bindings; force Own elsewhere.
                // (Issue #109: ffi_run was 228B/9 from exactly this.)
                is_ext_va := fdef.func_type.is_bodyless()
                if is_ext_va.not() { param.own_type = OwnType.Own }
                va_type := variadic_array_type_name(scope, param.explicit_type)
                func_scope.set(param.name, Type.Struct(va_type), false, ctx.path, expr.line, expr.col, true, param.own_type)
            } else if i.to_i32() == fdef.kwargs_index {
                // Same rationale as variadic above.
                is_ext_kw := fdef.func_type.is_bodyless()
                if is_ext_kw.not() { param.own_type = OwnType.Own }
                func_scope.set(param.name, Type.Struct("KwargsMap"), false, ctx.path, expr.line, expr.col, true, param.own_type)
            } else {
                // Issue #223 step 1/3: a primitive (step 1) or small value-shaped
                // struct (step 3) param is passed by value (shallow) even without
                // the qualifier. Normalize the plain borrowed default (Ref,
                // non-mut) to Shallow for those types so every downstream stage
                // treats them as value types. 'mut', 'own', and 'shallow' params
                // are left as the user wrote them. A ref-returning function may
                // hand a param back by reference (e.g. min(a, b) returns ref I64),
                // so its params must stay borrowed pointers -- skip auto-shallow
                // there.
                if auto_shallow_ok.and(fdef_return_carries_borrow(fdef, scope).not()).and(param.own_type.is(OwnType.Ref)).and(pmut.not()).and(is_auto_shallow_type(pt, ptn, scope, ctx)) {
                    param.own_type = OwnType.Shallow
                }
                if in_main_def.and(param.own_type.is(OwnType.Ref)) { param.own_type = OwnType.Own }
                func_scope.set(param.name, pt, pmut, ctx.path, expr.line, expr.col, true, param.own_type)
                if pt.is_funcptr() {
                    sf_fsb := scope.find(ptn)
                    switch sf_fsb {
                    case .Found(fsb):
                        fsb_fd_o := scope.lookup_func(fsb.name)
                        if fsb_fd_o.is_some() {
                            ref fsb_fd : Expr = fsb_fd_o.unwrap()
                            if fsb_fd.children.len() == 0 {
                                func_scope.set_func_def(param.name, fsb_fd)
                            }
                        }
                    case:
                    }
                }
            }
            // #328: keep the spelling the user DECLARED. The alias
            // normalization above already overwrote param.explicit_type,
            // so this is the only place that still knows a `n: USize`
            // param was written USize rather than the target's U32.
            mut pb_o := func_scope.get_binding(param.name)
            if pb_o.is_some() {
                ref mut pb : TypeBinding = pb_o.unwrap()
                pb.declared_type_name = ptype_name.clone()
            }
        }
        mut in_func_val : I32 = 0
        if is_func { in_func_val = 1 }
        mut returns_ref_val : I32 = 0
        if fdef.return_own_type.is(OwnType.Ref) { returns_ref_val = 1 }
        is_proc := fdef.func_type.is(FuncType.Proc)
        saved_proc_calls := ctx.proc_calls_count
        if is_proc {
            ctx.proc_calls_count = 0
            ctx.proc_def_depth = ctx.proc_def_depth + 1
        }
        if fdef.auto_generated {
            ctx.auto_gen_depth = ctx.auto_gen_depth + 1
        }
        saved_in_shallow_ret := ctx.typer_in_shallow_return
        ctx.typer_in_shallow_return = fdef.return_own_type.is(OwnType.Shallow)
        saved_return_type_name := ctx.typer_return_type_name.clone()
        // #321: a PROC can declare `returns Dynamic` too (the interpreter's
        // evaluators do), and its `return 0` needs the zero-to-null rewrite
        // exactly like a func's. Track the name in that case as well -- the
        // field's other readers are inert for Dynamic (numeric narrowing
        // skips a non-numeric type, interface boxing skips a non-interface
        // name), so the widening reaches only what the rewrite needs.
        if is_func { ctx.typer_return_type_name = fdef.return_type.clone() }
        else if fdef.return_type == "Dynamic" { ctx.typer_return_type_name = fdef.return_type.clone() }
        else { ctx.typer_return_type_name = "" }
        // Issue #198: lower throw/catch BEFORE infer_body so the
        // synthesised _err_kind / payload locals + if-guards
        // get type-checked normally and reach all downstream stages
        // (interpreter and builder) as plain til. Then inject the
        // extra err args at every does_throw call site so the
        // typer's arity check passes. UFCS calls keep their
        // FieldAccess(method) callee at this stage; the inject
        // matches by method name so the appended args end up at
        // the end of the eventual rewritten FCall.
        if fdef.auto_generated.not().and(macro_is_template.not()) {
            // Issue #158-aligned: single per-body walk for all
            // throw/catch processing (replaces the previous chain
            // of desugar_bang + validate + lower + inject + fallback
            // return). One walk does the work the five old passes
            // did, integrated per stmt.
            // Seed the receiver-type map so the walk's type-qualified
            // throws lookup can resolve `param.method(...)` receivers.
            ctx.lowering_param_types = Map(Str, Str).new()
            for lpi in 0..fdef.params.len() {
                ref lpp : Declaration = fdef.params[lpi]
                mut lptn := lpp.explicit_type.clone()
                if lpi.to_i32() == fdef.variadic_index { lptn = variadic_array_type_name(scope, lpp.explicit_type) }
                if lpi.to_i32() == fdef.kwargs_index { lptn = "KwargsMap" }
                if lptn.len() == 0 { continue }
                ctx.lowering_param_types.set(lpp.name, own lptn)
            }
            // Also seed switch-case payload bindings: `case E.V(x):` binds
            // `x` to the variant's payload type. The case-body Decls don't
            // exist yet at this stage (they are emitted inside infer_body
            // by make_switch_case_condition), so the throw/catch walk
            // can't see their explicit_type via the body-Decl scan.
            collect_switch_case_bindings(ctx, expr.children[0], expr.children[0])
            process_throw_catch_in_func_body(ctx, expr.children[0], fdef.throw_types, fdef.return_type, fdef.return_own_type)
        }
        if macro_is_template.not() {
            mut capture_source_muts := Vec(Bool).new()
            mut capture_source_written := Vec(Bool).new()
            if fdef.captures.len() > 0 {
                validate_captures(scope, fdef.captures, expr, ctx)
                capture_private_mut_begin(scope, fdef.captures, capture_source_muts, capture_source_written)
            }
            infer_body(func_scope, expr.children[0], in_func_val, 1, 0, returns_ref_val, 0, ctx)
            if fdef.captures.len() > 0 {
                capture_private_mut_end(scope, fdef.captures, capture_source_muts, capture_source_written)
            }
            garbager_destroy_body(ctx, expr.children[0], func_scope)
            // Issue #54: for a capturing function/lambda, validate the
            // captures against the enclosing scope and enforce that the
            // body only touches captured outer locals (plus params,
            // body-locals, globals, funcs/types) -- the same explicit-
            // capture restriction as a bare capture block.
            if fdef.captures.len() > 0 {
                ref cap_root : TypeScope = scope_root_ref(scope)
                capture_block_check_refs(expr.children[0], scope, func_scope, cap_root, fdef.captures, ctx)
            }
        }
        ctx.typer_in_shallow_return = saved_in_shallow_ret
        ctx.typer_return_type_name = saved_return_type_name
        if fdef.auto_generated {
            ctx.auto_gen_depth = ctx.auto_gen_depth - 1
        }
        if is_proc {
            if ctx.proc_calls_count == 0 {
                expr.type_error("proc has no proc/ext_proc calls; should be a func", ctx)
            }
            ctx.proc_calls_count = saved_proc_calls
            ctx.proc_def_depth = ctx.proc_def_depth - 1
        }
        if is_macro.and(fdef.return_type.len().eq(0)) {
            expr.type_error("macro must declare a return type", ctx)
        }
        if macro_is_template.not() {
            // #344: refresh the return-borrow summary now that the body is
            // TYPED. The per-unit pre-pass is syntactic, so it cannot see
            // through a UFCS receiver whose type it does not know yet, and
            // an instantiated generic is created long after that pass ran.
            // Re-deriving here is monotone (the recorded bits are only
            // ORed into), so a late answer can add roots but never retract
            // one, and callees typed before their callers -- imports, and
            // ordinary source order -- get the better answer in time.
            update_ref_return_summary(expr, ctx.scope, ctx.current_type_name)
            check_ref_function_returns(func_scope, expr, ctx)
            check_returned_borrowed_closure_captures(func_scope, expr, ctx)
            check_param_stored_globally(expr, func_scope, ctx)
            check_all_paths_return(expr, ctx)
            check_unused_params(func_scope, expr, ctx)
            check_unused_mut_params(func_scope, expr, ctx.path, ctx)
            check_unused_locals(func_scope, ctx.path, ctx)
            check_unused_mut_locals(func_scope, ctx.path, ctx)
        }
        // #303: bottom-up noreturn inference -- record whether calling this
        // function can ever hand control back. Runs after the body is
        // typed, so FCalls inside it already carry noreturn_call stamps
        // from callees typed earlier (imports and earlier decls in the
        // file: exit -> panic -> TODO/UNREACHABLE chain in core/exit.til).
        if fdef.func_type.is_plain() {
            if fn_never_returns(expr.children[0]) { fdef.noreturn = true }
        }
    case:
        UNREACHABLE("expected FuncDef, got ", expr.node_type.head_str())
    }
    ctx.typing_namespace_member = ifd_in_ns
}

// til's own all-paths-return check (option B). A non-void user function whose
// body can fall off the end without returning is reported here, with a til
// source location, instead of surfacing later as GCC's -Werror=return-type on
// the generated C (which the emitter's __builtin_unreachable terminator would
// otherwise quietly satisfy). The divergence predicate stmt_always_diverges
// lives in context.til, shared with the builder's emit-side terminator so the
// two can never drift. The C -Werror=return-type backstop stays on to catch
// anything the analysis still misses in the other direction.
priv check_all_paths_return := proc(expr: Expr, mut ctx: Context) {
    switch expr.node_type {
    case .FuncDef(fdef):
        // Only user Func/Proc bodies with a declared return type must return on
        // every path. A void function (no return type) may fall off the end;
        // ext/core have no til body; macros return AST; Test and auto-generated
        // functions are the compiler's own concern, not user-facing.
        if fdef.return_type.len() == 0 { return }
        if fdef.auto_generated { return }
        if or(fdef.func_type.is(FuncType.ExtFunc),
              fdef.func_type.is(FuncType.ExtProc),
              fdef.func_type.is(FuncType.CoreFunc),
              fdef.func_type.is(FuncType.CoreProc),
              fdef.func_type.is(FuncType.CoreLazyFunc),
              fdef.func_type.is(FuncType.Macro),
              fdef.func_type.is(FuncType.Test)) { return }
        if stmt_always_diverges(expr.children[0]).not() {
            expr.type_error(format("non-void function can reach its end without returning; every path must return a value (declared 'returns ", fdef.return_type, "')"), ctx)
        }
    case:
    }
}

priv check_unused_params := proc(func_scope: TypeScope, expr: Expr, mut ctx: Context) {
    ref fdef : FunctionDef = funcdef_of(expr)
    if fdef.func_type.is(FuncType.ExtFunc) { return }
    if fdef.func_type.is(FuncType.ExtProc) { return }
    if fdef.func_type.is(FuncType.CoreFunc) { return }
    if fdef.func_type.is(FuncType.CoreProc) { return }
    if fdef.func_type.is(FuncType.CoreLazyFunc) { return }
    for param : Declaration in fdef.params {
        if param.name.len() == 0 { continue }
        if param.name.starts_with("_") { continue }
        pb_o := func_scope.get_binding(param.name)
        if pb_o.is_none() { continue }
        ref pb : TypeBinding = pb_o.unwrap()
        if pb.used.not() {
            expr.type_error(format("unused parameter '", param.name, "'"), ctx)
        }
    }
}

// #164 step 2: a `mut` parameter that the body never writes through
// (no `param = ...`, no `param.f = ...`, never passed as the mut/own
// argument of another callee) is a redundant qualifier. Same `written`
// tracking as check_unused_mut_locals, but iterates the FuncDef's own
// params (locals are skipped via is_param in the step-1 check, so the
// two passes don't overlap). Called once per function -- params live on
// the func_scope only, not on the if/while/block inner scopes.
priv check_unused_mut_params := proc(func_scope: TypeScope, expr: Expr, path: Str, mut ctx: Context) {
    ref fdef : FunctionDef = funcdef_of(expr)
    if fdef.func_type.is(FuncType.ExtFunc) { return }
    if fdef.func_type.is(FuncType.ExtProc) { return }
    if fdef.func_type.is(FuncType.CoreFunc) { return }
    if fdef.func_type.is(FuncType.CoreProc) { return }
    if fdef.func_type.is(FuncType.CoreLazyFunc) { return }
    // Auto-generated bodies (clone/delete/size/enum eq/to_str/...) are
    // typer-emitted; the user cannot edit their signatures, so a
    // redundant `mut` there is not actionable.
    if fdef.auto_generated { return }
    for param : Declaration in fdef.params {
        if param.is_mut.not() { continue }
        if param.name.len() == 0 { continue }
        if param.name.starts_with("_") { continue }
        pb_o := func_scope.get_binding(param.name)
        if pb_o.is_none() { continue }
        ref pb : TypeBinding = pb_o.unwrap()
        if pb.written { continue }
        type_error_at(path, pb.line, pb.col,
            format("redundant 'mut' on parameter '", param.name, "': never written through; drop the 'mut'"), ctx)
    }
}

check_unused_locals := proc(scope: TypeScope, path: Str, mut ctx: Context) {
    for b in scope.bindings.values {
        if b.is_param { continue }
        if b.is_builtin { continue }
        if b.is_type_alias { continue }
        fp := name_fingerprint(b.name)
        if scope.local_struct_def_fp(b.name, fp).is_some() { continue }
        if scope.local_func_def_fp(b.name, fp).is_some() { continue }
        if b.name.len() == 0 { continue }
        if b.name.starts_with("_") { continue }
        // Hoist temps are compiler-internal and always have their use
        // substituted into the AST after typing, so `b.used` is never
        // flipped by the regular Ident-lookup path. Body DCE catches
        // any of these that go dead after constfolder; the typer's job
        // here is just to report user bugs.
        if b.name.starts_with("hoisted__") { continue }
        if ctx.throw_used_local_names.has(b.name) { continue }
        if b.used { continue }
        type_error_at(path, b.line, b.col, format("unused variable '", b.name, "'"), ctx)
    }
}

// #164: a `mut` local that is never written through (no `name = ...`,
// no `name.f = ...`) is a redundant qualifier -- the `mut` is a small
// lie about the local's effective shape. Flag it. Scoped to locals only
// for now (params are excluded: chain-walker cursors that take a `mut`
// param and only rebind it via `param = param.next` are still legal
// under the current language because `ref mut x : T = src` rejects
// immutable sources -- dropping the `mut` would require the language
// to distinguish "rebindable local pointer" from "write-through ref
// mut"; tracked separately on #164).
check_unused_mut_locals := proc(scope: TypeScope, path: Str, mut ctx: Context) {
    for b in scope.bindings.values {
        if b.is_param { continue }
        if b.is_builtin { continue }
        if b.is_type_alias { continue }
        fp := name_fingerprint(b.name)
        if scope.local_struct_def_fp(b.name, fp).is_some() { continue }
        if scope.local_func_def_fp(b.name, fp).is_some() { continue }
        if b.name.len() == 0 { continue }
        if b.name.starts_with("_") { continue }
        if b.name.starts_with("hoisted__") { continue }
        // Payload-alias bindings (`case V(p):`) are typer-synthesized; the
        // user did not lexically write `mut` on `p`. Skip them so writes to
        // the source via `p = ...` (handled elsewhere) are the only signal.
        if b.is_alias { continue }
        if b.mut_explicit.not() { continue }
        if b.written { continue }
        type_error_at(path, b.line, b.col,
            format("redundant 'mut' on local '", b.name, "': never written through; drop the 'mut'"), ctx)
    }
}

// Issue #187 step 1: top-level priv items (funcs, structs, enums,
// globals) are file-local by construction. If nothing in the
// declaring file references one, it is dead code -- no importer can
// possibly reach it. Flag and suggest removing 'priv' to expose it.
// Returns the number of errors emitted so the loader can fold the
// count into its overall type_errors total.
// #187: mark a referenced binding used, or -- when the reference comes
// from inside a function -- record the edge so usedness can be decided
// by reachability later. A reference from a function body only counts
// once that function is itself known to be reachable; the old flag said
// "someone mentioned it", which a dead recursive cycle satisfies by
// mentioning itself. Non-priv referees skip the bookkeeping entirely:
// only priv items are ever flagged, so their edges would never be read.
mark_binding_referenced := func(mut ctx: Context, mut b: TypeBinding) {
    if b.is_priv.not() {
        b.used = true
        return
    }
    if ctx.current_top_func_name.len() == 0 {
        // Referenced outside any function body -- a top-level statement,
        // a field default, a namespace method: a root reference.
        b.used = true
        return
    }
    if ctx.current_top_func_name.eq(b.name) { return }
    if ctx.priv_ref_edges.has(ctx.current_top_func_name).not() {
        ctx.priv_ref_edges.set(ctx.current_top_func_name, own Vec(Str).new())
    }
    ref mut referees : Vec(Str) = ctx.priv_ref_edges[ctx.current_top_func_name]
    // Distinct referees per function is a handful, so the linear dedup
    // keeps the vec tiny and costs less than re-walking duplicates later.
    for existing : Str in referees {
        if existing == b.name { return }
    }
    referees.push(own b.name.clone())
}

// Propagate usedness from the roots along the recorded reference edges.
// Roots: every non-priv binding (an importer can reach it) and every
// priv binding already marked used from a root context. A priv binding
// reached from a root is used, and so are the things IT references.
priv propagate_priv_refs := func(mut scope: TypeScope, ctx: Context) {
    mut worklist := Vec(Str).new()
    for rb in scope.bindings.values {
        if rb.is_priv.not().or(rb.used) { worklist.push(own rb.name.clone()) }
    }
    mut wi : USize = 0
    while wi < worklist.len() {
        ref referrer : Str = worklist[wi]
        wi = wi + 1
        if ctx.priv_ref_edges.has(referrer).not() { continue }
        ref referees : Vec(Str) = ctx.priv_ref_edges[referrer]
        for referee : Str in referees {
            mut rbo := scope.get_binding(referee)
            if rbo.is_none() { continue }
            ref mut rb2 : TypeBinding = rbo.unwrap()
            if rb2.used { continue }
            rb2.used = true
            worklist.push(own referee.clone())
        }
    }
}

check_unused_priv_top_level := proc(mut scope: TypeScope, mut ctx: Context) returns I32 {
    mut found : I32 = 0
    propagate_priv_refs(scope, ctx)
    for b in scope.bindings.values {
        if b.is_priv.not() { continue }
        if b.is_builtin { continue }
        if b.used { continue }
        if b.name.len() == 0 { continue }
        if b.name.starts_with("_") { continue }
        // Issue #328: a retained generic SOURCE template is deliberately
        // exempt. Nothing calls it -- init and the typer rewrite every
        // call to a concrete monomorphization -- so usedness is credited
        // to the concrete declaration, and before #328 kept the source
        // alive it was dropped long before this check ran.
        mut b_is_generic_source := false
        fp := name_fingerprint(b.name)
        b_fd_o := scope.local_func_def_fp(b.name, fp)
        if b_fd_o.is_some() { b_is_generic_source = init_func_is_generic(b_fd_o.unwrap()) }
        if b_is_generic_source { continue }
        mut kind := "value"
        if b_fd_o.is_some() { kind = "func" }
        b_sd_o := scope.local_struct_def_fp(b.name, fp)
        if b_sd_o.is_some() {
            if b_sd_o.unwrap().node_type.is(NodeType.EnumDef) { kind = "enum" }
            else { kind = "struct" }
        }
        // Two flavors of mangled priv names land here:
        //   * top-level `priv X` rewritten by init_declarations_unit to
        //     `priv__<path>__<orig>` (b.name has the "priv__" prefix).
        //     Report it as a top-level priv with the original identifier.
        //   * Issue #93 nested defs hoisted out of a function body, named
        //     `<parent>_<orig>` (no "priv__" prefix). Report parent +
        //     local in source terms.
        if b.name.starts_with("priv__").and(b.orig_name.len().gt(0)) {
            type_error_at(b.path, b.line, b.col,
                format("unused priv ", kind, " '", b.orig_name, "'; remove 'priv' to expose it"), ctx)
            found++
            continue
        }
        if b.orig_name.len() > 0 {
            mangled_len := b.name.len()
            orig_len := b.orig_name.len()
            parent_len := mangled_len.sub(orig_len) - 1
            parent_name := b.name.substr(0, parent_len)
            type_error_at(b.path, b.line, b.col,
                format("unused local ", kind, " '", b.orig_name, "' in '", parent_name, "'; remove it or move it to file scope"), ctx)
            found++
            continue
        }
        type_error_at(b.path, b.line, b.col,
            format("unused priv ", kind, " '", b.name, "'; remove 'priv' to expose it"), ctx)
        found++
    }
    return found
}

// #187 steps 2-3: priv struct fields and namespace methods that no
// code in the struct's own namespace ever reads. The typer marks
// fields/ns_decls used on every successful access (gated on
// auto_gen_depth == 0 so boilerplate clone/delete don't mask
// unused decls). After type_check, walk every struct/enum decl in
// each ImportUnit and flag the leftovers.
check_unused_priv_members_in_program := proc(program: Expr, path: Str, mut ctx: Context) returns I32 {
    mut found : I32 = 0
    for stmt : Expr in program.children {
        if stmt.node_type.is(NodeType.Decl).not() { continue }
        if stmt.children.len() == 0 { continue }
        ref tdef : Expr = stmt.children[0]
        if tdef.node_type.is(NodeType.StructDef).not()
            .and(tdef.node_type.is(NodeType.EnumDef).not()) { continue }
        mut owner_name := ""
        ref td_decl : Declaration = decl_of(stmt)
        owner_name = td_decl.name.clone()
        // Field walk (StructDef only). Report at the field's
        // default_value location (every field has one -- the parser
        // requires `name := value` or `name : Type = value`) so the
        // diagnostic points at the dead member, not the enclosing
        // struct. Fall back to tdef location for compiler-generated
        // decls that may carry the NoDefaultArg sentinel.
        switch tdef.node_type {
        case .StructDef(walk_sdd):
            mut wfi : USize = 0
            for fld : Declaration in walk_sdd.fields {
                cur_wfi := wfi
                wfi = wfi + 1
                if fld.is_priv.not() { continue }
                if fld.used { continue }
                ref wf_name : Str = walk_sdd.field_name_at(cur_wfi)
                if wf_name.len() == 0 { continue }
                if wf_name.starts_with("_") { continue }
                mut fl_line : U32 = tdef.line
                mut fl_col : U32 = tdef.col
                if fld.default_value.is_some() {
                    fl_line = fld.default_expr().line
                    fl_col = fld.default_expr().col
                }
                type_error_at(path, fl_line, fl_col,
                    format("unused priv field '", owner_name, ".", wf_name, "'; remove 'priv' to expose it"), ctx)
                found++
            }
        case:
        }
        // Namespace walk (both StructDef and EnumDef). Same
        // default_value-location strategy as fields.
        ref wni_ns : Vec(Declaration) = def_ns_decls(tdef)
        mut wni : USize = 0
        for nsd : Declaration in wni_ns {
            cur_wni := wni
            wni = wni + 1
            if nsd.is_priv.not() { continue }
            if nsd.used { continue }
            ref wn_name : Str = def_ns_name_at(tdef, cur_wni)
            if wn_name.len() == 0 { continue }
            if wn_name.starts_with("_") { continue }
            mut ns_line : U32 = tdef.line
            mut ns_col : U32 = tdef.col
            if nsd.default_value.is_some() {
                ns_line = nsd.default_expr().line
                ns_col = nsd.default_expr().col
            }
            type_error_at(path, ns_line, ns_col,
                format("unused priv ns member '", owner_name, ".", wn_name, "'; remove 'priv' to expose it"), ctx)
            found++
        }
    }
    return found
}



// Narrow a bare numeric literal return value to the function's declared
// numeric return type, mirroring validate_fcall_arg for call arguments.
// Fires for a direct Literal.Num return expression (including negative
// literals like -1, which the parser now produces as a single literal);
// any other expression is left as-is.
priv narrow_return_literal := proc(mut scope: TypeScope, mut rv: Expr, mut ctx: Context) {
    if ctx.typer_return_type_name.len() == 0 { return }
    rt := type_from_name(ctx.typer_return_type_name, scope, ctx)
    if is_numeric_type(rt).not() { return }
    switch rv.node_type {
    case .Literal(Literal.Num(lit_str)):
        if literal_in_range(lit_str.literal_num_text(), rt).not() {
            rv.type_error(format("integer literal ", Str.clone(lit_str.literal_num_text()), " out of range for ", type_to_name(rt)), ctx)
        }
        rv.set_til_type(rt)
    case:
    }
}

// #251 follow-up: box a conforming concrete RETURNED where an interface is
// declared, with OWNED semantics. The box escapes the function, so a borrow
// (to_ptr, as args/locals use) would dangle once the concrete's frame is gone;
// instead iface_val holds a heap deep-copy via dyn_call_ret(.., "clone", ..)
// and iface_owned = true, so the box's delete frees that copy (see
// gen_interface_clone_delete_for_stmt). The raw return value is snapshotted
// BEFORE infer_expr desugars a struct ctor's named args to positional, since
// the box re-infers that snapshot and a desugared ctor would fail the
// named-arg requirement. The snapshot is moved into the box, or reclaimed by
// the garbager when the value is already the interface / not conforming.
// #251 follow-up: build an OWNED interface box wrapping `value` (a conforming
// concrete of type `concrete_name`) as interface `iface_name`:
//   <Iface>(iface_type_name = "<Concrete>",
//           iface_val = dyn_call_ret("<Concrete>", "clone", 1, value),
//           iface_owned = true)
// iface_val is a heap deep-copy (dyn_call_<method> mallocs shallow returns),
// so the box owns it and its delete frees it (gen_interface_clone_delete_for_stmt).
// Used at every ESCAPING coercion site (returns, fields, ...). `value` is
// passed to clone directly, NOT to_ptr(value): the C backend addresses it via
// emit_as_ptr and the interpreter binds a value to clone's ref self
// correctly, whereas a raw pointer yields a garbage self for enum receivers.
// The caller must pass a `value` snapshotted BEFORE inference desugared a
// struct ctor's named args, since the returned box gets re-inferred.
priv make_owned_iface_box := func(iface_name: Str, concrete_name: Str, own value: Expr, line: U32, col: U32) returns Expr {
    mut box := Expr.new(NodeType.FCall(FCallData()), line, col)
    box.add_child(own Expr.new(ident_node(iface_name), line, col))
    mut na_tag := Expr.new(NodeType.NamedArg("iface_type_name"), line, col)
    na_tag.add_child(own Expr.new(NodeType.Literal(Literal.Str(concrete_name.clone())), line, col))
    box.add_child(own na_tag)
    mut na_val := Expr.new(NodeType.NamedArg("iface_val"), line, col)
    mut clone_call := Expr.new(NodeType.FCall(FCallData()), line, col)
    clone_call.add_child(own Expr.new(ident_node("dyn_call_ret"), line, col))
    clone_call.add_child(own Expr.new(NodeType.Literal(Literal.Str(concrete_name.clone())), line, col))
    clone_call.add_child(own Expr.new(NodeType.Literal(Literal.Str("clone")), line, col))
    clone_call.add_child(own Expr.new(NodeType.Literal(Literal.Num(LiteralNumData(text = "1"))), line, col))
    clone_call.add_child(own value)
    na_val.add_child(own clone_call)
    box.add_child(own na_val)
    mut na_owned := Expr.new(NodeType.NamedArg("iface_owned"), line, col)
    na_owned.add_child(own Expr.new(NodeType.Literal(Literal.Bool(true)), line, col))
    box.add_child(own na_owned)
    return box
}

priv box_return_value := proc(mut scope: TypeScope, mut stmt: Expr, in_func: I32, mut ctx: Context) {
    iface_name := ctx.typer_return_type_name.clone()
    mut raw_val := stmt.children[0].clone()
    infer_expr(scope, stmt.children[0], in_func, ctx)
    narrow_return_literal(scope, stmt.children[0], ctx)
    rbox_cname_o := expr_type_name_ref(stmt.children[0])
    if rbox_cname_o.is_some() {
        ref rbox_cname : Str = rbox_cname_o.unwrap()
        if rbox_cname.eq(iface_name).not().and(type_implements_iface(rbox_cname, iface_name, scope)) {
            mut box := make_owned_iface_box(iface_name, rbox_cname, own raw_val, stmt.children[0].line, stmt.children[0].col)
            stmt.children[0] = box
            infer_expr(scope, stmt.children[0], in_func, ctx)
        }
    }
}

// #282 follow-up: true when `e` is an FCall carrying an injected `_err_kind`
// out-arg -- i.e. the pre-infer throw pass lowered it as a throwing (`?`/`!`)
// call. Used to limit the ref-returning-return check to throwing calls (whose
// result is null on the throw path), so a plain non-throwing ref-returning
// call returned by value is left alone.
priv fcall_has_injected_err_arg := func(e: Expr) returns Bool {
    if e.node_type.is(NodeType.FCall).not() { return false }
    for c : Expr in e.children {
        switch c.node_type {
        case .Ident(idn):
            if idn.ident_name() == "_err_kind" { return true }
        case:
        }
    }
    return false
}

priv infer_return_stmt := proc(mut scope: TypeScope, mut stmt: Expr, in_func: I32, returns_ref: I32, mut ctx: Context) {    if stmt.children.len() > 0 {
        // #251 follow-up: a conforming concrete RETURNED where an interface is
        // declared coerces to an OWNED box (box_return_value). Done in a
        // helper because it must snapshot the raw value BEFORE inference
        // desugars a struct ctor's named args. Non-interface returns infer
        // normally and pay nothing.
        // #341: `return .Nothing` -- the declared return type is the
        // expected enum.
        if ctx.typer_return_type_name.len() > 0 {
            qualify_dotted_expr(stmt.children[0], type_from_name(ctx.typer_return_type_name, scope, ctx))
        }
        if ctx.typer_return_type_name.len().gt(0).and(name_is_interface(ctx.typer_return_type_name, scope)) {
            box_return_value(scope, stmt, in_func, ctx)
        } else {
            infer_expr(scope, stmt.children[0], in_func, ctx)
            narrow_return_literal(scope, stmt.children[0], ctx)
        }
        stmt.set_til_type(stmt.children[0].til_type())
        // #321: `return 0` from a returns-Dynamic function is the null
        // spelling.
        if ctx.typer_return_type_name.len() > 0 {
            rewrite_zero_to_null(stmt.children[0], type_from_name(ctx.typer_return_type_name, scope, ctx), false)
        }
        // #321 step 4: a typed function cannot return null; the
        // maybe-absent return is an Option. Quarantine returns
        // (returns Dynamic) keep it. Exempt: generated members
        // (auto_gen_depth -- niche variant ctors legitimately return the
        // null pointer) and ref returns (the throw-lowering appends an
        // unreachable `return null` fallback there; the dedicated
        // check_ref_function_returns rules own that shape).
        if stmt.children[0].node_type.is_literal_null().and(ctx.typer_return_type_name.len().gt(0))
            .and(ctx.auto_gen_depth == 0).and(returns_ref == 0) {
            if type_is_null_quarantine(type_from_name(ctx.typer_return_type_name, scope, ctx)).not() {
                stmt.type_error("cannot return a null pointer from a typed function; null is quarantine-only (Dynamic / the U8-I8 raw labels, where it is spelled `0`) -- return an Option for a real absent state (#321)", ctx)
            }
        }
        if returns_ref == 0 {
            // #282 follow-up: a by-value `return v.get(i)?` (ref-returning,
            // THROWING call) compiled, then DEREF'd a null ref on the throw
            // path ("panic: null deref"). The Decl form (`x := v.get(i)?`) and
            // the bang form (`return v.get(i)!`, via its hoisted temp Decl)
            // already reject this with "cannot own result of ref-returning
            // function"; the `?` return slipped past. Reject it the same way.
            // #286 follow-up: an AGGREGATE-typed ref result returned by value
            // hands the caller a BORROWED block it will free as owned (a
            // double free), so reject those even for non-throwing calls. A
            // non-throwing ref-returning call of pointer/scalar shape
            // (`return deref(p)`) copies the value and stays fine to return
            // by value. Use `returns ref T` or `.clone()` instead.
            ref ret_val : Expr = stmt.children[0]
            if ret_val.node_type.is(NodeType.FCall)
                .and(fcall_returns_ref(ret_val, scope).neq(0))
                .and(fcall_has_injected_err_arg(ret_val).or(is_aggregate(stmt.til_type()))) {
                stmt.type_error("cannot own result of ref-returning function; use 'ref' or Type.clone()", ctx)
            }
            check_enum_borrow_of_local_return(scope, stmt, ctx)
            switch stmt.children[0].node_type {
            case .Ident(rn):
                sf := scope.find(rn.ident_name())
                switch sf {
                case .Found(b):
                    if b.own_type.is(OwnType.Ref).and(b.is_alias.not()).and(b.is_param.not()) {
                        stmt.type_error("cannot return ref variable from non-ref function; use .clone() or 'returns ref'", ctx)
                    }
                        if b.own_type.is(OwnType.Ref).and(b.is_alias).or(b.is_param.and(b.own_type.is(OwnType.Own).not())) {
                            tname := type_to_name(stmt.til_type())
                            // Issue #58 / #147 step 5: FuncPtr/FuncPtrSig has no T_clone.
                            if tname.len().gt(0).and(stmt.til_type().is_funcptr().not()).and(stmt.til_type().is(Type.Body).not()) {
                                mc := make_clone_call(tname, stmt.til_type(), stmt.children[0], stmt)
                                stmt.children[0] = mc
                            }
                        }
                case:
                }
            case:
            }
        } else {
            // #168 step 5: a ref-typed function cannot return an owned value
            // -- the heap allocation has nowhere to live in the caller.
            ref ret_expr : Expr = stmt.children[0]
            if ret_expr.node_type.is(NodeType.FCall).and(fcall_returns_own(ret_expr, scope)) {
                stmt.type_error("ref-typed function cannot return an owned value (.clone() / constructor / function returning own) -- return a borrow source directly, or change the signature to return owned", ctx)
            }
        }
    } else {
        stmt.set_til_type(Type.None)
    }
}

priv infer_if_stmt := proc(mut scope: TypeScope, mut stmt: Expr, in_func: I32, in_loop: I32, returns_ref: I32, mut ctx: Context) {
    infer_expr(scope, stmt.children[0], in_func, ctx)
    ref if_cond_t : Type = stmt.children[0].til_type()
    if type_is_primitive(if_cond_t, Primitive.Bool).not().and(if_cond_t.is(Type.Unknown).not()) {
        stmt.type_error("if condition must be Bool", ctx)
    }
    mut then_scope := TypeScope(parent = Option(ref TypeScope).Some(scope))
    infer_body(then_scope, stmt.children[1], in_func, 1, in_loop, returns_ref, 0, ctx)
    garbager_destroy_body(ctx, stmt.children[1], then_scope)
    check_unused_locals(then_scope, ctx.path, ctx)
    check_unused_mut_locals(then_scope, ctx.path, ctx)
    if stmt.children.len() > 2 {
        mut else_scope := TypeScope(parent = Option(ref TypeScope).Some(scope))
        infer_body(else_scope, stmt.children[2], in_func, 1, in_loop, returns_ref, 0, ctx)
        garbager_destroy_body(ctx, stmt.children[2], else_scope)
        check_unused_locals(else_scope, ctx.path, ctx)
        check_unused_mut_locals(else_scope, ctx.path, ctx)
    }
    stmt.set_til_type(Type.None)
}

// Issue #297: a FieldAccess receiver that is a bare type alias (USize,
// UPtr, or a user `Foo := U8`) names a namespace through the alias. The
// alias has no struct def of its own, so resolve it to the target type and
// rewrite the receiver Ident to the target name (mirroring the method-call
// callee path, which is why `USize.size()` already resolves). Rewriting the
// name -- not just the til_type -- is what every downstream consumer needs:
// the scavenger's usage marking and the interpreter's ns lookup both key on
// the Ident name, while the builder reads the til_type; setting both keeps
// them in agreement so the `<Type>_<NAME>` global is emitted and not pruned.
priv resolve_fa_receiver_alias := func(scope: TypeScope, mut obj: Expr) {
    switch obj.node_type {
    case .Ident(rid):
        ref resolved : Str = resolve_type_alias(scope, rid.ident_name())
        if resolved.eq(rid.ident_name()).not() {
            if scope.get_struct(resolved).is_some() {
                obj.node_type = ident_node(resolved)
                obj.set_til_type(Type.Struct(resolved.clone()))
            }
        }
    case:
    }
}

priv infer_field_access_expr := proc(mut scope: TypeScope, mut expr: Expr, in_func: I32, mut ctx: Context) {
    infer_expr(scope, expr.children[0], in_func, ctx)
    resolve_fa_receiver_alias(scope, expr.children[0])
    mut obj_sname_o := expr_type_name_ref(expr.children[0])
    // #307: an Ident receiver whose binding is a non-type (e.g. a sibling
    // namespace member such as a variant ctor named like a global enum)
    // types nameless, but a field access needs a type. Apply get_struct's
    // fall-through rule (#147): a non-type binding does not block
    // resolving the same-named TYPE in receiver position.
    if obj_sname_o.is_none() {
        switch expr.children[0].node_type {
        case .Ident(fa_rid):
            fa_tdef_o := scope.get_struct(fa_rid.ident_name())
            if fa_tdef_o.is_some() {
                ref fa_tdef : Expr = fa_tdef_o.unwrap()
                obj_sname_o = Option(ref Str).Some(fa_rid.ident_name())
                if fa_tdef.node_type.is(NodeType.EnumDef) {
                    expr.children[0].set_til_type(Type.Enum(fa_rid.ident_name().clone()))
                } else {
                    expr.children[0].set_til_type(Type.Struct(fa_rid.ident_name().clone()))
                }
            }
        case:
        }
    }
    if obj_sname_o.is_some() {
        ref obj_sname : Str = obj_sname_o.unwrap()
        sdef_o := scope.get_struct(obj_sname)
        if sdef_o.is_some() {
            ref sdef : Expr = sdef_o.unwrap()
            // #154: reading a member of a cross-file type uses its import.
            note_cross_file_type_use(scope, ctx, obj_sname)
            mut fname := ""
            ref fn : FieldAccessData = fieldaccess_of(expr)
            fname = Str.clone(fn.field_access_name())
            mut found := false
            // Search struct fields from payload
            switch sdef.node_type {
            case .StructDef(fa_sdd):
                mut fld_o := member_get(fa_sdd.fields_index, fa_sdd.fields, fname)
                if fld_o.is_some() {
                    ref mut fld : Declaration = fld_o.unwrap()
                    mut field_type := fld.til_type.clone()
                    if fld.explicit_type.len() > 0 {
                        resolved_field_type := type_from_name(fld.explicit_type, scope, ctx)
                        if resolved_field_type.is(Type.Unknown).not() {
                            field_type = resolved_field_type
                        }
                    }
                    expr.set_til_type(field_type)
                    check_member_priv(expr, obj_sname, fname, fld.is_priv, ctx)
                    if ctx.auto_gen_depth == 0 { fld.used = true }
                    found = true
                }
            case:
            }
            // Search namespace declarations from payload ns_decls
            if found.not() {
                mut nsd_o := def_ns_get(sdef, fname)
                if nsd_o.is_some() {
                    ref mut nsd : Declaration = nsd_o.unwrap()
                    expr.set_til_type(nsd.til_type.clone())
                    if sdef.node_type.is(NodeType.EnumDef).and(nsd.default_value.is_some()) {
                        switch nsd.default_expr().node_type {
                        case .FuncDef(fd):
                            if fd.func_type.is(FuncType.ExtFunc).and(fd.return_type.len().gt(0)).and(fd.return_type.eq(obj_sname)) {
                                expr.set_til_type(Type.Enum(obj_sname.clone()))
                            }
                        case:
                            expr.set_til_type(Type.Enum(obj_sname.clone()))
                        }
                    }
                    check_member_priv(expr, obj_sname, fname, nsd.is_priv, ctx)
                    if ctx.auto_gen_depth == 0 { nsd.used = true }
                    found = true
                }
            }
            if found.not() {
                mut kind := "struct"
                if sdef.node_type.is(NodeType.EnumDef) { kind = "enum" }
                expr.type_error(format(kind, " '", obj_sname, "' has no field '", fname, "'"), ctx)
                expr.set_til_type(Type.Unknown)
            }
        }
    } else {
        expr.type_error("field access on non-struct value", ctx)
        expr.set_til_type(Type.Unknown)
    }
}

priv infer_field_assign_stmt := proc(mut scope: TypeScope, mut stmt: Expr, in_func: I32, mut ctx: Context) {
    infer_expr(scope, stmt.children[0], in_func, ctx)
    infer_expr(scope, stmt.children[1], in_func, ctx)
    ref obj : Expr = stmt.children[0]
    ref mut rhs : Expr = stmt.children[1]
    mut fname := ""
    switch stmt.node_type {
    case .FieldAssign(fad):
        fname = fad.name.clone()
    case:
        UNREACHABLE("expected FieldAssign, got ", stmt.node_type.head_str())
        return
    }
    // #164 / #344: walk to the root identifier of the obj chain and mark
    // it written. `a.b.c = ...` writes the root `a` (transitively), and
    // when `a` is a borrow, the storage `a` aliases.
    mark_written_through(scope, obj)
    check_write_roots_mut(scope, stmt, obj, format("assign to '", fname, "' here"), ctx)
    obj_sname_o := expr_type_name_ref(obj)
    if obj_sname_o.is_some() {
        ref obj_sname : Str = obj_sname_o.unwrap()
        sdef_o := scope.get_struct(obj_sname)
        if sdef_o.is_some() {
            ref sdef : Expr = sdef_o.unwrap()
            // #154: writing a member of a cross-file type uses its import.
            note_cross_file_type_use(scope, ctx, obj_sname)
            mut found := false
            switch sdef.node_type {
            case .StructDef(fa_sdd):
                mut fld_o := member_get(fa_sdd.fields_index, fa_sdd.fields, fname)
                if fld_o.is_some() {
                    ref mut fld : Declaration = fld_o.unwrap()
                    found = true
                    check_member_priv(stmt, obj_sname, fname, fld.is_priv, ctx)
                    if ctx.auto_gen_depth == 0 { fld.used = true }
                    if fld.is_mut.not() {
                        stmt.type_error(format("cannot assign to const field '", fname, "'; remove the 'const' keyword from its declaration to make it mutable"), ctx)
                    }
                    if fld.own_type.is(OwnType.Ref) {
                        check_ref_assign_owned_rhs(stmt, fname, rhs, scope, ctx)
                    }
                    // Resolve the declared type from explicit_type when
                    // set, like the field-ACCESS path does: a
                    // template-synthesized struct's cloned decls carry
                    // til_type Unknown, and comparing against that
                    // misreported every assign as a type mismatch.
                    mut fld_type := fld.til_type.clone()
                    if fld.explicit_type.len() > 0 {
                        resolved_fld_type := type_from_name(fld.explicit_type, scope, ctx)
                        if resolved_fld_type.is(Type.Unknown).not() {
                            fld_type = resolved_fld_type
                        }
                    }
                    // #321: `x.f = 0` on a Dynamic field is the null spelling.
                    rewrite_zero_to_null(rhs, fld_type, false)
                    // #321 step 4: null only overwrites quarantine slots.
                    if rhs.node_type.is_literal_null().and(type_is_null_quarantine(fld_type).not()) {
                        rhs.type_error(format("cannot assign a null pointer to field '", fname, "'; null is quarantine-only (Dynamic / the U8-I8 raw labels, where it is spelled `0`) -- use an Option field for a real absent state (#321)"), ctx)
                    }
                    mut handled_lit := false
                    switch rhs.node_type {
                    case .Literal(Literal.Num(lit_str)):
                        if is_numeric_type(fld_type) {
                            if literal_in_range(lit_str.literal_num_text(), fld_type).not() {
                                rhs.type_error(format("integer literal out of range for field '", fname, "'"), ctx)
                            }
                            rhs.set_til_type(fld_type.clone())
                            handled_lit = true
                        }
                    case:
                    }
                    if handled_lit.not() {
                        ref rhs_type : Type = rhs.til_type()
                        // Issue #58 / #147 step 5: FuncPtr/FuncPtrSig
                        // wildcard-aware family-equality.
                        if rhs_type.is(fld_type).not().and(funcptr_eq(rhs_type, fld_type).not()) {
                            if rhs_type.is(Type.Unknown).not() {
                                if rhs_type.is(Type.Dynamic).not() {
                                    stmt.type_error(format("field '", fname, "' type mismatch"), ctx)
                                }
                            }
                        }
                    }
                }
            case:
            }
            // Search namespace declarations from payload ns_decls
            if found.not() {
                nsd_o := def_ns_get(sdef, fname)
                if nsd_o.is_some() {
                    ref nsd : Declaration = nsd_o.unwrap()
                    found = true
                    if nsd.is_mut.not() {
                        stmt.type_error(format("cannot assign to immutable field '", fname, "'"), ctx)
                    }
                        // Same explicit_type fallback as the struct-field
                        // branch above (template-synthesized clones carry
                        // til_type Unknown).
                        mut nsd_type := nsd.til_type.clone()
                        if nsd.explicit_type.len() > 0 {
                            resolved_nsd_type := type_from_name(nsd.explicit_type, scope, ctx)
                            if resolved_nsd_type.is(Type.Unknown).not() {
                                nsd_type = resolved_nsd_type
                            }
                        }
                        mut handled_lit2 := false
                        switch rhs.node_type {
                        case .Literal(Literal.Num(lit_str)):
                            if is_numeric_type(nsd_type) {
                                if literal_in_range(lit_str.literal_num_text(), nsd_type).not() {
                                    rhs.type_error(format("integer literal out of range for field '", fname, "'"), ctx)
                                }
                                rhs.set_til_type(nsd_type.clone())
                                handled_lit2 = true
                            }
                        case:
                        }
                        if handled_lit2.not() {
                            ref rhs_type : Type = rhs.til_type()
                            if rhs_type.is(nsd_type).not().and(funcptr_eq(rhs_type, nsd_type).not()) {
                                if rhs_type.is(Type.Unknown).not() {
                                    if rhs_type.is(Type.Dynamic).not() {
                                        stmt.type_error(format("field '", fname, "' type mismatch"), ctx)
                                    }
                                }
                            }
                        }
                }
            }
            if found.not() {
                stmt.type_error(format("struct '", obj_sname, "' has no field '", fname, "'"), ctx)
            }
        }
    } else {
        stmt.type_error("field assignment on non-struct value", ctx)
    }
    stmt.set_til_type(Type.None)
    if stmt.fa_own_type(scope).is(OwnType.Ref).not().and(
        rhs.node_type.is(NodeType.Ident).or(
            rhs.node_type.is(NodeType.FieldAccess).and(is_aggregate(rhs.til_type()))
        )
    ) {
        tname := type_to_name(rhs.til_type())
        // Issue #58 / #147 step 5: FuncPtr/FuncPtrSig has no T_clone.
        if tname.len().gt(0).and(rhs.til_type().is_funcptr().not()).and(rhs.til_type().is(Type.Body).not()) {
            mc := make_clone_call(tname, rhs.til_type(), rhs, rhs)
            stmt.children[1] = mc
        }
    }
}

priv infer_while_stmt := proc(mut scope: TypeScope, mut stmt: Expr, in_func: I32, returns_ref: I32, mut ctx: Context) {
    infer_expr(scope, stmt.children[0], in_func, ctx)
    ref while_cond_t : Type = stmt.children[0].til_type()
    if type_is_primitive(while_cond_t, Primitive.Bool).not().and(while_cond_t.is(Type.Unknown).not()) {
        stmt.type_error(format("while condition must be Bool, got ", type_to_name(stmt.children[0].til_type())), ctx)
    }
    ref while_cond : Expr = stmt.children[0]
    if expr_contains_fcall(while_cond).or(stmt_contains_match(while_cond)) {
        ref cond : Expr = stmt.children[0]
        line := cond.line
        col := cond.col
        ref mut body : Expr = stmt.children[1]
        wname := format("_wcond_Bool_", synth_suffix(ctx, ctx.hoist_counter.to_str()))
        ctx.hoist_counter++

        mut decl := Expr.new(NodeType.Decl(Declaration(name = wname.clone())), line, col)
        decl.set_til_type(Type.Primitive(Primitive.Bool))
        decl.add_child(own cond.clone())
        decl.children[0].set_til_type(Type.Primitive(Primitive.Bool))

        mut ident := Expr.new(ident_node(wname), line, col)
        ident.set_til_type(Type.Primitive(Primitive.Bool))

        mut if_node := Expr.new(NodeType.If, line, col)
        if_node.set_til_type(Type.None)
        if_node.add_child(own ident)

        mut then_body := Expr.new(NodeType.Body, line, col)
        then_body.set_til_type(Type.None)
        if_node.add_child(own then_body)

        mut else_body := Expr.new(NodeType.Body, line, col)
        else_body.set_til_type(Type.None)
        mut brk := Expr.new(NodeType.Break, line, col)
        brk.set_til_type(Type.None)
        else_body.add_child(own brk)
        if_node.add_child(own else_body)

        mut true_lit := Expr.new(NodeType.Literal(Literal.Bool(true)), line, col)
        stmt.children[0] = true_lit

        mut old := body.children.take()

        // Exact final size: decl + if_node + old stmts.
        mut new_ch := Vec(Expr).with_capacity(old.len() + 2)
        new_ch.push(own decl)
        new_ch.push(own if_node)
        for j in 0..old.len() {
            new_ch.push_take(old, j)
        }
        body.children.move_from(own new_ch)
    }
    mut while_scope := TypeScope(parent = Option(ref TypeScope).Some(scope))
    infer_body(while_scope, stmt.children[1], in_func, 1, 1, returns_ref, 0, ctx)
    garbager_destroy_body(ctx, stmt.children[1], while_scope)
    check_unused_locals(while_scope, ctx.path, ctx)
    check_unused_mut_locals(while_scope, ctx.path, ctx)
    stmt.set_til_type(Type.None)
}

priv infer_decl_type_def := proc(mut scope: TypeScope, mut stmt: Expr, mut ctx: Context) returns Bool {
    if is_struct_or_enum(stmt).not() { return false }
    is_enum := stmt.children[0].node_type.is(NodeType.EnumDef)
    ref sdecl : Declaration = decl_of(stmt)
    if sdecl.explicit_type.len() > 0 {
        declared := type_from_name(sdecl.explicit_type, scope, ctx)
        mut expected := Type.Struct("StructDef")
        if is_enum { expected = Type.Struct("EnumDef") }
        if declared.eq(expected).not() {
            mut value_type := "StructDef"
            if is_enum { value_type = "EnumDef" }
            stmt.type_error(format("'", sdecl.name, "' declared as ", sdecl.explicit_type, " but value is ", value_type), ctx)
        }
    }
    stmt.set_til_type(Type.None)
    ref sname : Str = sdecl.name
    existing_o := scope.get_binding(sname)
    if existing_o.is_some() {
        ref existing : TypeBinding = existing_o.unwrap()
        existing_sd_o := scope.struct_def_of(existing.name)
        if existing_sd_o.is_some() {
            ref existing_sd : Expr = existing_sd_o.unwrap()
            ref type_expr : Expr = stmt.children[0]
            if existing_sd.line.neq(type_expr.line).or(
                existing_sd.col.neq(type_expr.col).or(
                    existing.path.eq(ctx.path).not()
                )
            ) {
                mut kind := "struct"
                if is_enum { kind = "enum" }
                stmt.type_error(format(kind, " '", sname, "' already declared at ", existing.path, ":", existing.line.to_str(), ":", existing.col.to_str()), ctx)
                return true
            }
        }
    }
    mut builtin_type := Type.Struct(sname.clone())
    mut is_builtin := false
    if is_enum {
        builtin_type = Type.Enum(sname.clone())
    } else {
        mut prim : Primitive = Primitive.I64
        if builtin_primitive_from_name(sname, prim) {
            builtin_type = Type.Primitive(prim)
            is_builtin = true
        } else if sname == "Dynamic" {
            builtin_type = Type.Dynamic
            is_builtin = true
        }
    }
    scope.set(sname, builtin_type, false, ctx.path, stmt.line, stmt.col, false, OwnType.Shallow)
    scope.set_struct_def(sname, stmt.children[0])
    ref mut b : TypeBinding = scope.get_binding(sname).unwrap()
    b.is_builtin = is_builtin
    b.is_priv = sdecl.is_priv
    b.orig_name = sdecl.orig_name.clone()
    return true
}

priv infer_decl_func_def := proc(mut scope: TypeScope, mut stmt: Expr, mut ctx: Context) returns Bool {
    if is_func_decl(stmt).not() { return false }
    switch stmt.node_type {
    case .Decl(sdecl):
        switch stmt.children[0].node_type {
        case .FuncDef(rhs_fd0):
            if rhs_fd0.captures.len() > 0 { return false }
        case:
        }
        if sdecl.explicit_type.len() > 0 {
            declared_t := type_from_name(sdecl.explicit_type, scope, ctx)
            if declared_t.is_funcptr() {
                switch stmt.children[0].node_type {
                case .FuncDef(rhs_fd):
                    if rhs_fd.captures.len() > 0 { return false }
                case:
                }
            }
        }
        // Issue #58: the metatype name from rstil's first_class.org is
        // ~FuncDef~; til's internal name is ~FunctionDef~ (the data
        // struct in src/core/ast.til). Accept both as the annotation
        // for a FuncDef value.
        annot_is_funcdef := sdecl.explicit_type.eq("FunctionDef").or(sdecl.explicit_type.eq("FuncDef"))
        if sdecl.explicit_type.len().gt(0).and(annot_is_funcdef.not()) {
            stmt.type_error(format("'", sdecl.name, "' declared as ", sdecl.explicit_type, " but value is FunctionDef"), ctx)
        }
        ref fdef : FunctionDef = funcdef_of(stmt.children[0])
        mut rt := Type.None
        if fdef.return_type.len() > 0 {
            ref resolved_return_type : Str = resolve_type_alias(scope, fdef.return_type)
            rt = type_from_name(resolved_return_type, scope, ctx)
        }
        stmt.set_til_type(rt)
        // Bodyless FuncDef is a FuncSig type-alias declaration:
        // bind the name to Type.FuncPtr so dyn_type_to_str and Vec.new
        // round-trip the name through Type.FuncPtr ("Fn") instead of
        // the function's return type. Issue #58.
        is_bodyless := stmt.children[0].children.len() == 0
        mut binding_type := rt
        if is_bodyless { binding_type = Type.FuncPtr }
        scope.set(sdecl.name, binding_type, false, ctx.path, stmt.line, stmt.col, false, OwnType.Shallow)
        scope.set_func_def(sdecl.name, stmt.children[0])
        ref mut fb : TypeBinding = scope.get_binding(sdecl.name).unwrap()
        fb.is_func_decl = true
        fb.is_priv = sdecl.is_priv
        fb.orig_name = sdecl.orig_name.clone()
        if fdef.func_type.is_bodyless() {
            fb.is_builtin = true
        }
        return true
    case:
        UNREACHABLE("expected Decl, got ", stmt.node_type.head_str())
        return false
    }
}

priv infer_decl_type_alias_passthrough := func(scope: TypeScope, mut stmt: Expr) returns Bool {
    if stmt.children[0].node_type.is(NodeType.Ident).not() { return false }
    ref sdecl : Declaration = decl_of(stmt)
    alias_b_o := scope.get_binding(sdecl.name)
    if alias_b_o.is_some() {
        ref alias_b : TypeBinding = alias_b_o.unwrap()
        if alias_b.is_type_alias {
            stmt.set_til_type(Type.None)
            return true
        }
    }
    return false
}

priv declared_type_for_decl := func(mut scope: TypeScope, stmt: Expr, mut ctx: Context) returns Type {
    ref sdecl : Declaration = decl_of(stmt)
    mut declared := stmt.til_type().clone()
    switch declared {
    case .Unknown:
        declared = type_from_name(sdecl.explicit_type, scope, ctx)
    case .Custom(cname):
        declared = type_from_name(cname, scope, ctx)
    case:
    }
    return declared
}

// Typed declarations can steer numeric method resolution (for example,
// `x : F32 = 1 / 2` -> `F32.div`), but explicit `to_*` conversions still need
// their literal receiver to keep the default numeric type so lookup lands on
// the source type's namespace.
priv pre_coerce_decl_numeric_literals := proc(mut expr: Expr, target: Type) {
    switch expr.node_type {
    case .Literal(Literal.Num):
        expr.set_til_type(target)
    case .FieldAccess(fname):
        for i in 0..expr.children.len() {
            if i.eq(0).and(fname.starts_with("to_")) { continue }
            pre_coerce_decl_numeric_literals(expr.children[i], target)
        }
    case:
        for mut c : Expr in expr.children {
            pre_coerce_decl_numeric_literals(c, target)
        }
    }
}

priv fcall_is_raw_alloc := func(e: Expr) returns Bool {
    if e.node_type.is(NodeType.FCall).not() { return false }
    if e.children.len() == 0 { return false }
    switch e.children[0].node_type {
    case .Ident(callee):
        ref name : Str = callee.ident_name()
        return name.eq("malloc").or(name.eq("calloc")).or(name.eq("realloc"))
    case:
        return false
    }
}

// The declared-vs-value agreement check, shared by local declarations
// and struct field defaults. Both spell the same rule -- an explicit
// `: T` annotation must agree with the initialization value -- but only
// the local path enforced it, so a field default reached the C compiler
// unchecked: `Bar := struct { ref f : Foo = 0 }` typed clean and then
// died as "assignment to 'Foo *' from incompatible pointer type" in
// gen/til/*.c, and `s : Str = 0` / `n : I64 = "x"` typed clean too.
// `at` is the node the diagnostic hangs off (the Decl stmt for a local,
// the default expr for a field).
priv check_declared_value_type := proc(at: Expr, name: Str, val: Expr, declared: Type, explicit_type: Str, scope: TypeScope, mut ctx: Context) {
    if can_implicit_usize_coerce(val.til_type(), declared, explicit_type).not()
        .and(val.til_type().is(declared).not())
        // Issue #58 / #147 step 5: FuncPtr/FuncPtrSig wildcard family-eq.
        .and(funcptr_eq(val.til_type(), declared).not())
        .and(val.til_type().is(Type.Dynamic).not())
        .and(declared.is(Type.Dynamic).not()) {
        at.type_error(format("'", name, "' declared as ", type_to_name(declared), " but value is ", type_to_name(val.til_type())), ctx)
    } else if is_aggregate(declared) {
        val_sname_o := expr_type_name_ref(val)
        if val_sname_o.is_some() {
            ref val_sname : Str = val_sname_o.unwrap()
            if resolve_type_alias(scope, explicit_type).eq(val_sname).not() {
                at.type_error(format("'", name, "' declared as ", explicit_type, " but value is ", val_sname), ctx)
            }
        }
    }
}

priv infer_decl_typed_value := proc(mut scope: TypeScope, mut stmt: Expr, in_func: I32, mut ctx: Context) {
    switch stmt.node_type {
    case .Decl(sdecl):
        mut declared := declared_type_for_decl(scope, stmt, ctx)
        // #179 follow-up: explicit type annotation on a Decl
        // (e.g. ~ref x : Foo = ...~) is a use of Foo's name from
        // declaration position. Check priv across files.
        check_priv_type_name(stmt, sdecl.explicit_type, scope, ctx)
        // #251 follow-up: a conforming concrete bound to an interface-typed
        // LOCAL coerces by BOXING, exactly like an interface-typed argument
        // (infer_and_validate_fcall_args). Done here -- before `val` is bound
        // below -- so the box (whose type is the interface, == declared) flows
        // through the rest of the checks without a type-mismatch error. The
        // box borrows the value via to_ptr, like the argument case: sound
        // while the source outlives the binding (same scope, reverse-order
        // teardown). Escaping sites (returns, fields, Vec elements) need an
        // OWNED box and remain a follow-up.
        if name_is_interface(sdecl.explicit_type, scope) {
            box_cname_o := expr_type_name_ref(stmt.children[0])
            if box_cname_o.is_some() {
                ref box_cname : Str = box_cname_o.unwrap()
                if box_cname.eq(sdecl.explicit_type).not().and(type_implements_iface(box_cname, sdecl.explicit_type, scope)) {
                box_line := stmt.children[0].line
                box_col := stmt.children[0].col
                mut iface_box := Expr.new(NodeType.FCall(FCallData()), box_line, box_col)
                iface_box.add_child(own Expr.new(ident_node(sdecl.explicit_type), box_line, box_col))
                mut na_tag := Expr.new(NodeType.NamedArg("iface_type_name"), box_line, box_col)
                na_tag.add_child(own Expr.new(NodeType.Literal(Literal.Str(box_cname.clone())), box_line, box_col))
                iface_box.add_child(own na_tag)
                mut na_val := Expr.new(NodeType.NamedArg("iface_val"), box_line, box_col)
                mut val_ptr := Expr.new(NodeType.FCall(FCallData()), box_line, box_col)
                val_ptr.add_child(own Expr.new(ident_node("to_ptr"), box_line, box_col))
                val_ptr.add_child(own stmt.children[0].clone())
                na_val.add_child(own val_ptr)
                iface_box.add_child(own na_val)
                stmt.children[0] = iface_box
                infer_expr(scope, stmt.children[0], in_func, ctx)
                }
            }
        }
        ref mut val : Expr = stmt.children[0]
        switch val.til_type() {
        case .Custom(alias_name):
            ref resolved_alias_name : Str = resolve_type_alias(scope, alias_name)
            resolved_alias_type := type_from_name(resolved_alias_name, scope, ctx)
            if resolved_alias_type.is(Type.Unknown).not() {
                val.set_til_type(resolved_alias_type)
            }
        case:
        }
        if declared.is(Type.Unknown) {
            stmt.type_error(format("undefined type '", sdecl.explicit_type, "'"), ctx)
        } else if val.node_type.is_literal_num().and(declared.is(Type.Dynamic)) {
            // #321: `x : Dynamic = 0` -- 0 IS the null spelling now.
            rewrite_zero_to_null(val, declared, false)
            if val.node_type.is_literal_null().not() {
                val.set_til_type(declared)
            }
        } else if val.node_type.is_literal_num().and(is_numeric_type(declared).or(declared.is(Type.Dynamic))) {
            switch val.node_type {
            case .Literal(Literal.Num(lit_str)):
                if is_numeric_type(declared).and(literal_in_range(lit_str.literal_num_text(), declared).not()) {
                    val.type_error(format("integer literal ", Str.clone(lit_str.literal_num_text()), " out of range for ", type_to_name(declared)), ctx)
                }
            case:
            }
            val.set_til_type(declared)
        } else if val.node_type.is_literal_null().and(sdecl.own_type.is(OwnType.Ref).not()) {
            stmt.type_error("null can only be assigned to 'ref' declarations", ctx)
        } else if declared.is_funcptr().and(val.node_type.is(NodeType.FuncDef)) {
            switch val.node_type {
            case .FuncDef(vfd):
                if vfd.captures.len() > 0 {
                    val.set_til_type(declared.clone())
                } else {
                    stmt.type_error(format("'", sdecl.name, "' declared as ", type_to_name(declared), " but value is ", type_to_name(val.til_type())), ctx)
                }
            case:
            }
        } else {
            check_declared_value_type(stmt, sdecl.name, val, declared, sdecl.explicit_type, scope, ctx)
        }
    // Resolve type alias in declared til_type so that struct/enum names match
    // the canonical target (e.g. Point2 -> Point).
    if is_aggregate(declared) {
        ref resolved : Str = resolve_type_alias(scope, sdecl.explicit_type)
        if declared.is(Type.Struct) {
            declared = Type.Struct(resolved.clone())
        } else {
            declared = Type.Enum(resolved.clone())
        }
    }
    stmt.set_til_type(declared)
    if can_implicit_usize_coerce(val.til_type(), declared, sdecl.explicit_type) {
        val.set_til_type(declared)
    }
    narrow_dynamic(val, declared)
        if is_aggregate(declared) {
            if expr_type_name_ref(val).is_some() {
                ref resolved : Str = resolve_type_alias(scope, sdecl.explicit_type)
                if declared.is(Type.Struct) {
                    val.set_til_type(Type.Struct(resolved.clone()))
                } else {
                    val.set_til_type(Type.Enum(resolved.clone()))
                }
            }
        }
    case:
        UNREACHABLE("expected Decl, got ", stmt.node_type.head_str())
    }
}

priv infer_decl_untyped_value := proc(mut stmt: Expr, mut ctx: Context) {
    ref mut rhs : Expr = stmt.children[0]
    mut inferred := rhs.til_type().clone()
    switch rhs.node_type {
    case .FuncDef(rhs_fd):
        if rhs_fd.captures.len() > 0 {
            inferred = Type.FuncPtr
            rhs.set_til_type(inferred.clone())
        }
    case .Literal(Literal.SetLit):
        if rhs.children.len() > 0 {
            elem_type := type_to_name(rhs.children[0].til_type())
            if elem_type.len() > 0 { inferred = Type.Struct(format("Set__", elem_type)) }
        }
    case .Literal(Literal.MapLit):
        if rhs.children.len() >= 2 {
            key_type := type_to_name(rhs.children[0].til_type())
            val_type := type_to_name(rhs.children[1].til_type())
            if key_type.len().gt(0).and(val_type.len().gt(0)) {
                inferred = Type.Struct(format("Map__", key_type, "_", val_type))
            }
        }
    case:
    }
    stmt.set_til_type(inferred)
    if stmt.til_type().is(Type.Dynamic) {
        ref sdecl : Declaration = decl_of(stmt)
        stmt.type_error(format("cannot store Dynamic in '", sdecl.name, "'; add a type annotation like '", sdecl.name, " : Type = ...' to specify the concrete type"), ctx)
    }
}

// #262 follow-up: if `rhs` is a `DynVec.new(T)` call with a literal type token
// (or `DynVec.new_type_name("T")` with a literal string), return T's name,
// else "". The token is syntactic, so no inference is needed.
priv dynvec_elem_from_new := func(rhs: Expr) returns Str {
    if rhs.node_type.is(NodeType.FCall).not() { return "" }
    if rhs.children.len() != 2 { return "" }
    ref callee : Expr = rhs.children[0]
    if callee.node_type.is(NodeType.FieldAccess).not() { return "" }
    if callee.children.len() == 0 { return "" }
    mut mname := ""
    switch callee.node_type {
    case .FieldAccess(fa): mname = Str.clone(fa.field_access_name())
    case:
    }
    switch callee.children[0].node_type {
    case .Ident(rn):
        if rn.ident_name().eq("DynVec").not() { return "" }
    case:
        return ""
    }
    if mname == "new" {
        switch rhs.children[1].node_type {
        case .Ident(tn): return Str.clone(tn.ident_name())
        case:
        }
    } else if mname == "new_type_name" {
        switch rhs.children[1].node_type {
        case .Literal(Literal.Str(ts)): return ts.clone()
        case:
        }
    }
    return ""
}

priv finalize_decl_binding := proc(mut scope: TypeScope, mut stmt: Expr, in_type_body: I32, dv_elem: Str, mut ctx: Context) {
    switch stmt.node_type {
    case .Decl(sdecl):
        ref mut rhs : Expr = stmt.children[0]
        raw_alloc_rhs := fcall_is_raw_alloc(rhs)
        if in_type_body.eq(0).and(raw_alloc_rhs).and(sdecl.explicit_type.len().gt(0)) {
            if sdecl.own_type.is(OwnType.Ref) {
                stmt.type_error(format("raw allocation local '", sdecl.name, "' cannot be declared with 'ref'; locals are owned by default"), ctx)
            } else if ctx.path.contains("/src/self/").not().and(ctx.path.starts_with("src/self/").not())
                .and(stmt.til_type().is(Type.Dynamic))
                .and(ctx.current_type_name.contains("__").not())
                .and(ctx.current_top_func_name.contains("__").not()) {
                stmt.type_error(format("raw allocation local '", sdecl.name, "' must use a concrete type, not Dynamic"), ctx)
            }
        }
        if in_type_body.eq(0).and(sdecl.own_type.is(OwnType.Own)) {
            if sdecl.is_mut {
                stmt.type_error(format("no need for 'own' on mutable local '", sdecl.name, "'; write 'mut ", sdecl.name, " := ...'"), ctx)
            } else {
                stmt.type_error(format("no need for 'own' on local '", sdecl.name, "'; locals are owned by default"), ctx)
            }
        }
        // #327: reject re-binding a name already bound in THIS scope -- a
        // second `x := ...` in one block, or a body-level local reusing a
        // parameter's name (parameters live in the same scope as the body's
        // top-level locals). til accepted both and the interpreter took the
        // newest binding, but codegen emits them under one C identifier, so
        // the compiled backend died with "redefinition of 'x'": a silent
        // interpret/compile divergence, now a diagnostic at the source.
        //
        // Deliberately SAME-SCOPE only. A binding in a nested block is a
        // different C scope, where C's own shadowing rules apply and the
        // for-in desugar's loop variable (which reuses the user's name and
        // is renamed by codegen) is legitimate -- rejecting those would
        // break working programs. The one nested case that still misbehaves
        // is a pointer-shaped block local shadowing a shallow parameter,
        // where the builder's name-keyed shape query picks the parameter;
        // that fails LOUDLY at C compile ("'w' is a pointer"), never
        // silently, and is what keeps #327 open for the builder-side fix.
        if scope.in_function().and(scope.bindings.has(sdecl.name)) {
            stmt.type_error(format("'", sdecl.name,
                "' is already declared in this function; pick another name",
                " (or use 'mut ", sdecl.name, " := ...' and assign with '",
                sdecl.name, " = ...' to rebind)"), ctx)
        }
        scope.set(sdecl.name, stmt.til_type(), sdecl.is_mut, ctx.path, stmt.line, stmt.col, false, OwnType.Shallow)
        ref mut decl_b : TypeBinding = scope.get_binding(sdecl.name).unwrap()
        // #164: snapshot the source-level `mut` keyword here, before any
        // later typer machinery (array/vec literal rewrite, alias
        // promotion etc.) auto-promotes is_mut.
        decl_b.mut_explicit = sdecl.is_mut
        // #328: declared-spelling provenance. An annotated local keeps its
        // own annotation; an inferred one inherits the RHS's provenance
        // when the RHS is a plain Ident that has some, so
        // `n : USize = ...; m := n` still contributes USize.
        if sdecl.explicit_type.len() > 0 {
            decl_b.declared_type_name = sdecl.explicit_type.clone()
        } else {
            switch rhs.node_type {
            case .Ident(prov_id):
                prov_o := scope.get_binding(prov_id.ident_name())
                if prov_o.is_some() {
                    decl_b.declared_type_name = prov_o.unwrap().declared_type_name.clone()
                }
            case:
            }
        }
        decl_b.used = sdecl.used
        if ctx.throw_used_local_names.has(sdecl.name) { decl_b.used = true }
        decl_b.is_priv = sdecl.is_priv
        decl_b.orig_name = sdecl.orig_name.clone()
        // #262 follow-up: `v := DynVec.new(T)` records the element type name
        // on the binding so `v[i]` / v.get(i) / v.pop() narrow from Dynamic
        // to T. Read from the PRE-inference token by infer_decl_stmt ("" for
        // any other RHS shape).
        decl_b.dynvec_elem = dv_elem.clone()
        // #262 follow-up: stamp an INFERRED funcsig type onto the Declaration
        // itself. A typer-synthesized decl (the bang-hoisted `_bang_ret_N :=
        // ops.get(i)!` behind a direct `ops[i](args)` call) carries its
        // narrowed sig only on the STMT's til_type; without stamping, the
        // scavenger sees no reference to the sig type (it reads
        // Declaration.explicit_type) and prunes the funcsig decl the emit
        // later needs, and resolve_decl_fn_sig cannot recover the signature.
        if sdecl.explicit_type.len() == 0 {
            if stmt.til_type().is(Type.FuncPtrSig) {
                sdecl.til_type = stmt.til_type().clone()
                stmt_tname_o := expr_type_name_ref(stmt)
                if stmt_tname_o.is_some() {
                    ref stmt_tname : Str = stmt_tname_o.unwrap()
                    sdecl.explicit_type = stmt_tname.clone()
                }
            }
        }
        if stmt.til_type().is_funcptr() {
            switch rhs.node_type {
            case .Ident(rhs_id):
                src_o := scope.get_binding(rhs_id.ident_name())
                if src_o.is_some() {
                    ref src : TypeBinding = src_o.unwrap()
                    src_fd_o := scope.lookup_func(src.name)
                    if src_fd_o.is_some() { scope.set_func_def(sdecl.name, src_fd_o.unwrap()) }
                }
            case .FCall:
                switch resolve_fn_sig(rhs, scope) {
                case .Some(rfc_sig): scope.set_func_def(sdecl.name, rfc_sig)
                case .None:
                }
            case .FuncDef(rhs_fd):
                if rhs_fd.captures.len() > 0 { scope.set_func_def(sdecl.name, rhs) }
            case:
            }
            if scope.lookup_func(decl_b.name).is_none() {
                // Issue #58 / #147 step 5: read FuncSig alias name from
                // sdecl.til_type (Type.FuncPtrSig payload) instead of
                // sdecl.explicit_type + get_binding indirection.
                if sdecl.til_type.is(Type.FuncPtrSig) {
                    sdsig_name := til_type_name(sdecl.til_type)
                    if sdsig_name.len() > 0 {
                        fsb_fd_o := scope.lookup_func(sdsig_name)
                        if fsb_fd_o.is_some() {
                            ref fsb_fd : Expr = fsb_fd_o.unwrap()
                            if fsb_fd.children.len() == 0 {
                                scope.set_func_def(sdecl.name, fsb_fd)
                            }
                        }
                    }
                }
            }
        }
        // #351: an OWNED binding whose value carries a borrow -- a struct
        // with a ref field, or an enum with a ref payload, built by a
        // constructor or returned by a call -- records the storages that
        // value reaches, so a later write through the carried borrow can
        // be credited to them. Only call results are recorded: a plain
        // copy of another binding arrives clone-wrapped and contributes
        // no summary, which is the conservative no-roots answer.
        if sdecl.own_type.is(OwnType.Ref).not().and(rhs.node_type.is(NodeType.FCall)) {
            tname_351 := type_to_name(stmt.til_type())
            if tname_351.len().gt(0).and(type_carries_borrow(scope, tname_351)) {
                mut carried_roots := expr_borrow_roots(scope, rhs)
                for mut crr : BorrowRoot in carried_roots {
                    crr.carried = true
                }
                decl_b.borrow_roots = carried_roots
            }
        }
        if sdecl.own_type.is(OwnType.Ref) {
            decl_b.own_type = OwnType.Ref
            // #211: payload binding `ref T = get_payload(<ident>)` is the
            // typer-emitted shape produced by make_switch_case_condition.
            // Mark its TypeBinding as an alias so the subsequent Assign
            // check at line 6935 recognises writes to it as
            // write-through-the-payload and accepts a constructor /
            // literal RHS (the builder lowers it to `*p = *new` for
            // structs and `*p = (Str){...}` for Str literals).
            if rhs_is_payload_binding(rhs) { decl_b.is_alias = true }
            if expr_is_ref_decl_source(rhs, scope).not().and(raw_alloc_rhs.not()) {
                stmt.type_error("'ref' declaration requires a ref-returning function, a ref/param variable, or a raw allocation", ctx)
            }
            // #344: remember WHAT this borrow aliases. A write through the
            // binding is then credited to that storage instead of stopping
            // at the alias -- which is what makes an honest `mut` on the
            // parameter an accessor borrowed from survive #164's check.
            // #351: the WRITE walk, not the value walk: a `ref` into one
            // field aliases that field's storage, not every borrow the
            // whole value happens to carry through its other fields.
            decl_b.borrow_roots = lvalue_write_roots(scope, rhs)
            if sdecl.is_mut {
                switch rhs.node_type {
                case .Ident(rid):
                    rb_o := scope.get_binding(rid.ident_name())
                    if rb_o.is_some() {
                        ref rb : TypeBinding = rb_o.unwrap()
                        if rb.is_mut.not() {
                            stmt.type_error("'ref mut' cannot bind to an immutable source; declare the source as 'mut' or 'ref mut'", ctx)
                        }
                    }
                    // #344: taking the borrow is NOT a write. The eager mark
                    // that used to sit here credited the source the moment a
                    // `ref mut` alias was created, so a `mut` local aliased
                    // but never written still counted as written. An actual
                    // write through the alias now travels the roots above.
                case:
                }
            }
        }
        // #321: the typer's own move-out temp (`_steal_...`, built by
        // make_niche_steal_block) is the one place where owning a
        // ref-returning result is CORRECT: the deref loads a niche enum's
        // payload box, which the enum is giving up in the same block. Named
        // like the `hoisted__` temps other passes already recognise, so no
        // user-writable spelling gains the exemption.
        if sdecl.own_type.is(OwnType.Ref).not().and(rhs.node_type.is(NodeType.FCall)).and(fcall_returns_ref(rhs, scope).neq(0)).and(sdecl.name.starts_with("_steal_").not()) {
            stmt.type_error("cannot own result of ref-returning function; use 'ref' or Type.clone()", ctx)
        }
        if sdecl.own_type.is(OwnType.Ref).not().and(sdecl.is_mut.not()).and(stmt.til_type().is_funcptr().not()).and(stmt.til_type().is(Type.Body).not()) {
            switch rhs.node_type {
            case .Ident(rhs_id2):
                rb_o := scope.get_binding(rhs_id2.ident_name())
                if rb_o.is_some() {
                    ref rb : TypeBinding = rb_o.unwrap()
                    if rb.is_mut.not().and(rb.own_type.is(OwnType.Own).not()).and(rb.own_type.is(OwnType.Ref).not().or(rb.is_alias)).and(rb.is_param.not()) {
                        sdecl.own_type = OwnType.Ref
                        decl_b.own_type = OwnType.Ref
                        decl_b.is_alias = true
                    }
                }
            case:
            }
        }
        if rhs.node_type.is(NodeType.Ident).or(
            rhs.node_type.is(NodeType.FieldAccess).and(
                is_aggregate(rhs.til_type())
            )
        ) {
            if sdecl.own_type.is(OwnType.Ref).not() {
                tname := type_to_name(stmt.til_type())
                // Issue #58 / #147 step 5: a FuncPtr/FuncPtrSig has no
                // T_clone method; it's a plain 8-byte pointer.
                if tname.len().gt(0).and(stmt.til_type().is_funcptr().not()).and(stmt.til_type().is(Type.Body).not()) {
                    mc := make_clone_call(tname, stmt.til_type(), rhs, stmt)
                    stmt.children[0] = mc
                }
            }
        }
    case:
        UNREACHABLE("expected Decl, got ", stmt.node_type.head_str())
    }
}

priv infer_decl_stmt := proc(mut scope: TypeScope, mut stmt: Expr, in_func: I32, in_type_body: I32, mut ctx: Context) {
    if stmt.children.len() == 0 { return }
    // Issue #328: a retained direct-generic SOURCE is a template, not code.
    // Its signature and body still name the unbound type parameters, so
    // typing it would report `T` as an undefined type. It stays live only
    // so late inference can clone a fully prepared body from it;
    // init_retire_generic_sources drops it once every body is typed.
    if init_stmt_is_generic_source(stmt) { return }
    mut dv_elem := ""
    ref first_child : Expr = stmt.children[0]
    if first_child.node_type.is(NodeType.StructDef).or(first_child.node_type.is(NodeType.EnumDef)) {
        ref td_decl : Declaration = decl_of(stmt)
        saved_type_name := ctx.current_type_name.clone()
        ctx.current_type_name = td_decl.name.clone()
        infer_expr(scope, stmt.children[0], in_func, ctx)
        ctx.current_type_name = saved_type_name
    } else {
        // Issue #93 follow-up: when the decl's rhs is a FuncDef body
        // (top-level after init_declarations_unit's nested-def lift),
        // set current_top_func_name so the function-scope priv check in
        // check_priv_access knows which parent we're inside while typing
        // the body.
        mut tracked_func := false
        saved_top_func := ctx.current_top_func_name.clone()
        // Issue #101: this Decl-with-a-FuncDef-body window is also the
        // synthesised-name window. The counters restart inside it and every
        // name they mint carries ctx.synth_owner, so a temp's number is its
        // ordinal within THIS definition. Anonymous lambdas and nested
        // blocks are typed by infer_expr below without opening a window of
        // their own, so they keep sharing this definition's sequence --
        // which is what keeps their lifted top-level names unique.
        // bang_counter belongs here too: process_throw_catch_in_func_body
        // mints `_bang_ret_<N>` while this body is being typed.
        saved_synth_owner := ctx.synth_owner.clone()
        saved_hoist_counter := ctx.hoist_counter
        saved_va_counter := ctx.va_counter
        saved_kw_counter := ctx.kw_counter
        saved_coll_counter := ctx.coll_counter
        saved_bang_counter := ctx.bang_counter
        switch stmt.node_type {
        case .Decl(sdecl):
            if sdecl.explicit_type.len() > 0 {
                declared := declared_type_for_decl(scope, stmt, ctx)
                if is_numeric_type(declared) {
                    pre_coerce_decl_numeric_literals(stmt.children[0], declared)
                }
                switch stmt.children[0].node_type {
                case .FuncDef(rhs_fd):
                    mut needs_sig_fill := false
                    if rhs_fd.params.len() > 0 {
                        needs_sig_fill = rhs_fd.params[0].explicit_type.len() == 0
                    }
                    if needs_sig_fill {
                        sig_expr_o := scope.lookup_func(sdecl.explicit_type)
                        if sig_expr_o.is_some() {
                            switch sig_expr_o.unwrap().node_type {
                            case .FuncDef(sig_fd):
                                if sig_fd.params.len() == rhs_fd.params.len() {
                                    for sig_i in 0..rhs_fd.params.len() {
                                        ref mut dst_p : Declaration = rhs_fd.params[sig_i]
                                        ref src_p : Declaration = sig_fd.params[sig_i]
                                        dst_p.explicit_type = src_p.explicit_type.clone()
                                        dst_p.til_type = src_p.til_type.clone()
                                        if src_p.own_type.is(OwnType.Shallow).not() { dst_p.own_type = src_p.own_type }
                                    }
                                    rhs_fd.return_type = sig_fd.return_type.clone()
                                    if sig_fd.return_own_type.is(OwnType.Shallow).not() { rhs_fd.return_own_type = sig_fd.return_own_type }
                                }
                            case:
                            }
                        }
                    }
                case:
                }
            }
            if stmt.children[0].node_type.is(NodeType.FuncDef) {
                if stmt.children[0].children.len() > 0 {
                    ctx.current_top_func_name = sdecl.name.clone()
                    ctx.synth_owner = synth_owner_name(ctx.path, sdecl.name, sdecl.orig_name)
                    ctx.hoist_counter = 0
                    ctx.va_counter = 0
                    ctx.kw_counter = 0
                    ctx.coll_counter = 0
                    ctx.bang_counter = 0
                    tracked_func = true
                }
            }
        case:
        }
        // #262 follow-up: read the DynVec element type token BEFORE inference
        // -- rewrite_til_type_arg replaces the literal `Ident T` arg with a
        // runtime Type expression, so the syntactic shape is gone afterwards.
        dv_elem = dynvec_elem_from_new(stmt.children[0])
        // #341: `s : Shape = .Nothing` -- the annotation is the expected
        // enum, so fill the elided name in before the RHS is inferred.
        switch stmt.node_type {
        case .Decl(qdd):
            if qdd.explicit_type.len() > 0 {
                qualify_dotted_expr(stmt.children[0], type_from_name(qdd.explicit_type, scope, ctx))
            }
        case:
        }
        infer_expr(scope, stmt.children[0], in_func, ctx)
        if tracked_func {
            ctx.current_top_func_name = saved_top_func
            ctx.synth_owner = saved_synth_owner
            ctx.hoist_counter = saved_hoist_counter
            ctx.va_counter = saved_va_counter
            ctx.kw_counter = saved_kw_counter
            ctx.coll_counter = saved_coll_counter
            ctx.bang_counter = saved_bang_counter
        }
    }
    if infer_decl_type_def(scope, stmt, ctx) { return }
    if infer_decl_func_def(scope, stmt, ctx) { return }
    if infer_decl_type_alias_passthrough(scope, stmt) { return }
    ref sdecl : Declaration = decl_of(stmt)
    if sdecl.explicit_type.len() > 0 {
        infer_decl_typed_value(scope, stmt, in_func, ctx)
    } else {
        infer_decl_untyped_value(stmt, ctx)
    }
    check_ref_decl_owned_init(stmt, scope, ctx)
    check_ref_local_null_init(stmt, ctx)
    finalize_decl_binding(scope, stmt, in_type_body, dv_elem, ctx)
}

is_simple_lvalue_expr := func(e: Expr) returns Bool {
    if e.node_type.is(NodeType.Ident) { return true }
    if e.node_type.is(NodeType.FieldAccess) {
        if e.children.len() == 1 {
            return is_simple_lvalue_expr(e.children[0])
        }
    }
    return false
}

is_compile_directive := func(e: Expr) returns Bool {
    if e.node_type.is(NodeType.FCall).not() { return false }
    if e.children.len() < 1 { return false }
    switch e.children[0].node_type {
    case .Ident(name):
        ref name_str : Str = name.ident_name()
        return name_str.eq("link").or(name_str.eq("link_c")).or(name_str.eq("import"))
    case:
        return false
    }
}

// Issue #54 capture-block helpers. -------------------------------------

// Is `name` listed in the block's capture list?
priv capture_listed := func(captures: Vec(Declaration), name: Str) returns Bool {
    for cap : Declaration in captures {
        if cap.name == name { return true }
    }
    return false
}

// Was `name` captured with the `mut` modifier?
priv capture_is_mut := func(captures: Vec(Declaration), name: Str) returns Bool {
    for cap : Declaration in captures {
        if cap.name == name { return cap.is_mut }
    }
    return false
}

// Walk up to the file/global root scope.
priv scope_root_ref := func(s: TypeScope) returns ref TypeScope {
    switch s.parent {
    case .Some(p): return scope_root_ref(p)
    case .None: return s
    }
}

// Issue #54: a single name reference inside a capture block must resolve
// to a block-local, a captured name, a global/top-level func, or a type.
// A reference to an un-captured enclosing *local* is an error -- that is
// the whole point of the explicit capture list. `is_write` flags an
// assignment target, which additionally requires a `mut` capture.
priv capture_block_check_name := proc(e: Expr, name: Str, is_write: I32,
        enclosing: TypeScope, block_scope: TypeScope, root: TypeScope,
        captures: Vec(Declaration), mut ctx: Context) {
    if block_scope.bindings.has(name) { return }   // block-local (or shadow)
    if capture_listed(captures, name) {
        if is_write.eq(1).and(capture_is_mut(captures, name).not()) {
            e.type_error(format("capture '", name,
                "' is const here; capture it as 'mut' to assign to it"), ctx)
        }
        return
    }
    b_o := enclosing.get_binding(name)
    if b_o.is_none() { return }                    // unresolved: normal diagnostics handle it
    ref b : TypeBinding = b_o.unwrap()
    if root.bindings.has(name) { return }          // global / top-level func / type
    if b.is_func_decl.or(b.is_builtin) { return }
    e.type_error(format("'", name,
        "' is not captured; add it to the '[...]' capture list to use it here"), ctx)
}

// Recurse the block body checking every variable reference. Nested
// capture blocks and func literals carry their own capture rules, so
// stop at them.
priv capture_block_check_refs := proc(e: Expr,
        enclosing: TypeScope, block_scope: TypeScope, root: TypeScope,
        captures: Vec(Declaration), mut ctx: Context) {
    switch e.node_type {
    case .CaptureBlock, .BodyValue, .FuncDef: return
    case .Ident(idd):
        capture_block_check_name(e, idd.name, 0, enclosing, block_scope, root, captures, ctx)
    case .Assign(ad):
        capture_block_check_name(e, ad.name, 1, enclosing, block_scope, root, captures, ctx)
    case:
    }
    for c : Expr in e.children {
        capture_block_check_refs(c, enclosing, block_scope, root, captures, ctx)
    }
}

priv body_value_check_no_return := proc(e: Expr, mut ctx: Context) {
    switch e.node_type {
    case .FuncDef: return
    case .Return:
        e.type_error("Body value cannot contain return", ctx)
    case:
    }
    for c : Expr in e.children {
        body_value_check_no_return(c, ctx)
    }
}

priv infer_body_value_expr := proc(mut scope: TypeScope, mut expr: Expr, mut ctx: Context) {
    mut captures := Vec(Declaration).new()
    switch expr.node_type {
    case .BodyValue(bd):
        if bd.closure_name.len().eq(0) {
            // #101: synth_symbol_suffix, not hoist_counter -- this name
            // becomes a file-scope C function and a `_env` struct type,
            // so it needs the program-unique owner-qualified suffix,
            // while hoist_counter restarts at 0 in every function body.
            bd.closure_name = format("body_", synth_symbol_suffix(ctx))
        }
        captures = bd.captures.clone()
    case:
        UNREACHABLE("expected BodyValue, got ", expr.node_type.head_str())
    }
    validate_captures(scope, captures, expr, ctx)
    switch expr.node_type {
    case .BodyValue(bd): bd.captures = captures.clone()
    case:
        UNREACHABLE("expected BodyValue, got ", expr.node_type.head_str())
    }
    ref mut body : Expr = expr.children[0]
    body_value_check_no_return(body, ctx)
    mut body_scope := TypeScope(parent = Option(ref TypeScope).Some(scope))
    mut capture_source_muts := Vec(Bool).new()
    mut capture_source_written := Vec(Bool).new()
    capture_private_mut_begin(scope, captures, capture_source_muts, capture_source_written)
    infer_body(body_scope, body, 0, 1, 0, 0, 0, ctx)
    capture_private_mut_end(scope, captures, capture_source_muts, capture_source_written)
    ref root : TypeScope = scope_root_ref(scope)
    capture_block_check_refs(body, scope, body_scope, root, captures, ctx)
    garbager_destroy_body(ctx, body, body_scope)
    check_unused_locals(body_scope, ctx.path, ctx)
    check_unused_mut_locals(body_scope, ctx.path, ctx)
    expr.set_til_type(Type.Body)
}

// Issue #54: validate a capture list against the enclosing scope. Each
// captured name must exist; mark it used (so listing it counts as a use)
// and check the `mut` modifier against the source binding's mutability.
// Shared by capture blocks and capturing functions.
priv validate_captures := proc(mut scope: TypeScope, mut captures: Vec(Declaration), errnode: Expr, mut ctx: Context) {
    for mut cap : Declaration in captures {
        mut b_o := scope.get_binding(cap.name)
        if b_o.is_none() {
            errnode.type_error(format("capture '", cap.name,
                "': no such variable in the enclosing scope"), ctx)
        } else {
            ref mut b : TypeBinding = b_o.unwrap()
            cap.til_type = b.type.clone()
            if cap.explicit_type.len() == 0 { cap.explicit_type = til_type_name_c(b.type) }
            b.used = true
            if cap.is_mut {
                // `mut` on a BORROW (the default ref capture) writes through to
                // the source, so the source must itself be mut. On a `shallow`
                // (private value copy) or `own` (moved in) capture it describes
                // the capture's OWN storage -- the source is never written, so
                // its mutability is irrelevant. Issue #54.
                if cap.own_type.is(OwnType.Ref) {
                    if b.is_mut.not() {
                        errnode.type_error(format("cannot capture immutable '", cap.name,
                            "' as 'mut'"), ctx)
                    }
                    b.written = true
                }
            }
        }
    }
}

// A private mutable capture (`shallow mut` / `own mut`) is writable while
// typing the closure body, but the write targets environment storage, not the
// enclosing binding. Temporarily expose that mutability to normal assignment
// inference, then restore the source's mutation bookkeeping exactly.
priv capture_private_mut_begin := func(mut scope: TypeScope, captures: Vec(Declaration),
        mut source_muts: Vec(Bool), mut source_written: Vec(Bool)) {
    for cap : Declaration in captures {
        mut b_o := scope.get_binding(cap.name)
        if b_o.is_none() {
            missing_mut := false
            missing_written := false
            source_muts.push(own missing_mut.clone())
            source_written.push(own missing_written.clone())
            continue
        }
        ref mut b : TypeBinding = b_o.unwrap()
        source_muts.push(own b.is_mut.clone())
        source_written.push(own b.written.clone())
        if cap.is_mut.and(cap.own_type.is(OwnType.Ref).not()) { b.is_mut = true }
    }
}

priv capture_private_mut_end := func(mut scope: TypeScope, captures: Vec(Declaration),
        source_muts: Vec(Bool), source_written: Vec(Bool)) {
    for i in 0..captures.len() {
        ref cap : Declaration = captures[i]
        if cap.is_mut.not().or(cap.own_type.is(OwnType.Ref)) { continue }
        mut b_o := scope.get_binding(cap.name)
        if b_o.is_none() { continue }
        ref mut b : TypeBinding = b_o.unwrap()
        b.is_mut = source_muts[i]
        b.written = source_written[i]
    }
}

// Issue #54: rewrite every reference to `from` into `to` inside a capture
// block body. Used to give a `shallow` block capture a PRIVATE copy: the copy
// is declared under a fresh name and the body's uses are renamed to it, so the
// outer binding is never shadowed (a same-name shadowing decl would emit
// `T x = x` in C -- a self-reference). Stops at nested capture blocks / body
// values / func defs, which carry their own capture lists.
priv capture_block_rename := proc(mut e: Expr, from: Str, to: Str) {
    switch e.node_type {
    case .CaptureBlock, .BodyValue, .FuncDef: return
    case .Ident(idd):
        if idd.ident_name() == from { e.node_type = ident_node(to) }
    case .Assign(ad):
        if ad.name == from { ad.name = to.clone() }
    case .Decl(dd):
        // A block-local of the same name shadows the capture from here on;
        // leave it (and the rest of this body) alone.
        if dd.name == from { return }
    case:
    }
    for mut c : Expr in e.children {
        capture_block_rename(c, from, to)
    }
}

// Issue #54: type-check a bare capture block `[a, mut b] { ... }`. The
// body is typed in a normal inline child scope, then a read-only
// restriction pass enforces that only captured outer locals are touched.
// `shallow` captures are given a private renamed copy first (see
// capture_block_rename); `own` captures transfer the binding to the block
// (expr_transfers_own reports the CaptureBlock, so the enclosing scope stands
// down its delete and a later use is a use-after-move error).
priv infer_capture_block := proc(mut scope: TypeScope, mut stmt: Expr,
        in_func: I32, in_loop: I32, returns_ref: I32, mut ctx: Context) {
    mut captures := Vec(Declaration).new()
    switch stmt.node_type {
    case .CaptureBlock(cbd):
        captures = cbd.captures.clone()
    case:
        UNREACHABLE("expected CaptureBlock, got ", stmt.node_type.head_str())
    }
    // Each captured name must exist in the enclosing scope; mark it used
    // (so listing it counts as a use) and validate the `mut` modifier.
    validate_captures(scope, captures, stmt, ctx)
    if stmt.children.len() == 0 {
        stmt.set_til_type(Type.None)
        return
    }
    // `shallow`: prepend `_cap_<name>_<n> := <outer name>` and rename the
    // body's uses to it, so writes stay private to the block and the outer
    // binding is untouched.
    for cap : Declaration in captures {
        if cap.own_type.is(OwnType.Shallow).not() { continue }
        if scope.get_binding(cap.name).is_none() { continue }
        fresh := format("_cap_", cap.name, "_", synth_suffix(ctx, ctx.hoist_counter.to_str()))
        ctx.hoist_counter++
        ref mut cbody : Expr = stmt.children[0]
        capture_block_rename(cbody, cap.name, fresh)
        mut cdecl := Expr.new(NodeType.Decl(Declaration(name = fresh.clone(), is_mut = cap.is_mut)), stmt.line, stmt.col)
        cdecl.add_child(own Expr.new(ident_node(cap.name), stmt.line, stmt.col))
        mut new_ch := Vec(Expr).new()
        new_ch.push(own cdecl)
        for bi in 0..cbody.children.len() { new_ch.push_take(cbody.children, bi) }
        cbody.children.move_from(own new_ch)
    }
    ref mut body : Expr = stmt.children[0]
    mut block_scope := TypeScope(parent = Option(ref TypeScope).Some(scope))
    infer_body(block_scope, body, in_func, 1, in_loop, returns_ref, 0, ctx)
    ref root : TypeScope = scope_root_ref(scope)
    capture_block_check_refs(body, scope, block_scope, root, captures, ctx)
    // `own`: the block took ownership, so the ENCLOSING scope stands down its
    // delete (expr_transfers_own reports the CaptureBlock). Register the
    // binding in the block scope so the garbager gives it ordinary block-end
    // cleanup here -- without this the value would leak, since neither scope
    // would free it. Done after the body is typed so it does not disturb
    // inference, and before garbager_destroy_body so the pass sees it.
    for ocap : Declaration in captures {
        if ocap.own_type.is(OwnType.Own).not() { continue }
        osrc_o := scope.get_binding(ocap.name)
        if osrc_o.is_none() { continue }
        if block_scope.bindings.has(ocap.name) { continue }
        ref osrc : TypeBinding = osrc_o.unwrap()
        block_scope.set(ocap.name, osrc.type, osrc.is_mut, ctx.path,
            stmt.line, stmt.col, false, OwnType.Own)
        ref mut ob : TypeBinding = block_scope.get_binding(ocap.name).unwrap()
        ob.used = true
    }
    garbager_destroy_body(ctx, body, block_scope)
    check_unused_locals(block_scope, ctx.path, ctx)
    check_unused_mut_locals(block_scope, ctx.path, ctx)
    stmt.set_til_type(Type.None)
}

infer_body_stmt := proc(mut scope: TypeScope, mut body: Expr, mut i: USize, in_func: I32, in_loop: I32, returns_ref: I32, in_type_body: I32, mut ctx: Context) {
    // Issue #244: a Match at statement position is either the lowering's
    // result-temp-tagged form (desugar it like a switch) or a bare user
    // `match` whose value is discarded (an error pointing at switch).
    if body.children[i].node_type.is(NodeType.Match) {
        mut match_result_temp := ""
        switch body.children[i].node_type {
        case .Match(md): match_result_temp = md.result_temp.clone()
        case:
        }
        if match_result_temp.len() == 0 {
            ref mut bare_match : Expr = body.children[i]
            bare_match.type_error("match yields a value that is unused here; use 'switch' for arms that run statements", ctx)
            bare_match.set_til_type(Type.None)
            return
        }
        // `i--` re-visits this index so the lowered replacement gets typed --
        // but ONLY when the lowering actually ran. infer_switch_stmt bails
        // early on a rejected pattern (a #262 list pattern, a #334 binding
        // sharing a case), leaving the Match in place; decrementing then
        // retries the same node forever, re-reporting its error until the
        // disk fills. The Switch caller has always guarded on this; Match
        // did not.
        if infer_switch_stmt(scope, body, i, in_func, in_loop, returns_ref, ctx) {
            i--
        } else {
            body.children[i].set_til_type(Type.None)
        }
        return
    }
    // Issue #244: lower any match nested in this statement into a result temp
    // plus a switch, spliced before it. `i` is advanced past the inserted
    // statements so the now-match-free statement is type-checked next.
    ref stmt_for_match : Expr = body.children[i]
    if stmt_for_match.node_type.is(NodeType.While).not().and(stmt_contains_match(stmt_for_match)) {
        inserted := lower_matches_in_stmt(scope, body, i, in_func, in_loop, returns_ref, ctx)
        i = i + inserted
    }
    ref mut stmt : Expr = body.children[i]
    if is_compile_directive(stmt) { stmt.set_til_type(Type.None); return }
    switch stmt.node_type {
    case .Decl:
        infer_decl_stmt(scope, stmt, in_func, in_type_body, ctx)
    case .Assign:
        infer_assign_stmt(scope, stmt, in_func, ctx)
    case .FieldAssign:
        infer_field_assign_stmt(scope, stmt, in_func, ctx)
    case .FCall:
        infer_expr(scope, stmt, in_func, ctx)
    case .Return:
        infer_return_stmt(scope, stmt, in_func, returns_ref, ctx)
    case .Break:
        if in_loop == 0 {
            stmt.type_error("break outside loop", ctx)
        }
        stmt.set_til_type(Type.None)
    case .Continue:
        if in_loop == 0 {
            stmt.type_error("continue outside loop", ctx)
        }
        stmt.set_til_type(Type.None)
    case .If:
        infer_if_stmt(scope, stmt, in_func, in_loop, returns_ref, ctx)
    case .Body:
        mut block_scope := TypeScope(parent = Option(ref TypeScope).Some(scope))
        infer_body(block_scope, stmt, in_func, 1, in_loop, returns_ref, 0, ctx)
        garbager_destroy_body(ctx, stmt, block_scope)
        check_unused_locals(block_scope, ctx.path, ctx)
        check_unused_mut_locals(block_scope, ctx.path, ctx)
    case .While:
        infer_while_stmt(scope, stmt, in_func, returns_ref, ctx)
    case .CaptureBlock:
        infer_capture_block(scope, stmt, in_func, in_loop, returns_ref, ctx)
    case .Switch:
        switch_lowered := infer_switch_stmt(scope, body, i, in_func, in_loop, returns_ref, ctx)
        if switch_lowered { i = i - 1 }
    case .ForIn:
        if desugar_for_in_kv_stmt(scope, body, i, in_func, ctx) {
            i--
        } else if desugar_for_in_range_stmt(scope, body, i, in_func, ctx) {
            i--
        } else if desugar_for_in_collection_stmt(scope, body, i, in_func, ctx) {
            i--
        }
    case .Throw:
        // Issue #198 step 5a: minimal dispatch -- type-check the
        // thrown expression so it isn't silently skipped. Validation
        // (throws-set tracking) and lowering land in later steps.
        if stmt.children.len() == 1 {
            infer_expr(scope, stmt.children[0], in_func, ctx)
        } else {
            stmt.type_error("throw must have exactly one parameter", ctx)
        }
        stmt.set_til_type(Type.None)
    case .Catch:
        // Issue #198 step 5a: minimal dispatch -- type-check the
        // catch body in a child scope. The err variable binding and
        // throws-set matching land in the validation step. Body
        // statements need infer_body so var refs etc. resolve.
        if stmt.children.len() == 3 {
            ref mut body_expr : Expr = stmt.children[2]
            mut catch_scope := TypeScope(parent = Option(ref TypeScope).Some(scope))
            infer_body(catch_scope, body_expr, in_func, 1, in_loop, returns_ref, 0, ctx)
            garbager_destroy_body(ctx, body_expr, catch_scope)
            check_unused_locals(catch_scope, ctx.path, ctx)
            check_unused_mut_locals(catch_scope, ctx.path, ctx)
        } else {
            stmt.type_error("catch must have 3 children: var, type, body", ctx)
        }
        stmt.set_til_type(Type.None)
    case:
        stmt.set_til_type(Type.None)
    }
}

priv reregister_scope_defs := func(body: Expr, mut scope: TypeScope) {
    for rstmt : Expr in body.children {
        if rstmt.children.len() == 0 { continue }
        ref rfirst : Expr = rstmt.children[0]
        switch rstmt.node_type {
        case .Decl(rdecl):
            mut rb_o := scope.get_binding(rdecl.name)
            if rb_o.is_some() {
                ref mut rb : TypeBinding = rb_o.unwrap()
                if rfirst.node_type.is(NodeType.StructDef).or(rfirst.node_type.is(NodeType.EnumDef)) {
                    rb_old_sd_o := scope.struct_def_of(rb.name)
                    if rb_old_sd_o.is_some().and(rb_old_sd_o.unwrap().ptr_eq(rstmt.children[0]).not()) {
                        // Skipped when the registered def IS this statement's
                        // def -- every typer sweep after the first re-walks
                        // the same bodies, and the broadcast below then hands
                        // each aliased binding the pointer it already holds.
                        // It pivots on ptr_eq of the OLD def, so old == new
                        // makes every write a no-op; the scan is not. That
                        // scan costs one scope lookup PER BINDING IN SCOPE per
                        // def statement, which is why this function was 7.4%
                        // of a self-translate.
                        ref rb_old_sd : Expr = rb_old_sd_o.unwrap()
                        scope.set_struct_def(rb.name, rstmt.children[0])
                        for b in scope.bindings.values {
                            if b.ptr_eq(rb) { continue }
                            fp := name_fingerprint(b.name)
                            b_old_sd_o := scope.local_struct_def_fp(b.name, fp)
                            if b_old_sd_o.is_none() { continue }
                            if b_old_sd_o.unwrap().ptr_eq(rb_old_sd) {
                                scope.set_struct_def(b.name, rstmt.children[0])
                            }
                        }
                    }
                }
                if rfirst.node_type.is(NodeType.FuncDef) {
                    rb_old_fd_o := scope.lookup_func(rb.name)
                    if rb_old_fd_o.is_some().and(rb_old_fd_o.unwrap().ptr_eq(rstmt.children[0]).not()) {
                        // Same no-op guard as the struct/enum broadcast above.
                        ref rb_old_fd : Expr = rb_old_fd_o.unwrap()
                        scope.set_func_def(rb.name, rstmt.children[0])
                        for b in scope.bindings.values {
                            if b.ptr_eq(rb) { continue }
                            fp := name_fingerprint(b.name)
                            b_old_fd_o := scope.local_func_def_fp(b.name, fp)
                            if b_old_fd_o.is_none() { continue }
                            if b_old_fd_o.unwrap().ptr_eq(rb_old_fd) {
                                scope.set_func_def(b.name, rstmt.children[0])
                            }
                        }
                    }
                }
                if rb.alias_target.is_empty().not() {
                    switch rstmt.children[0].node_type {
                    case .Ident(target_name):
                        // Refresh just this alias's target. We deliberately
                        // do NOT broadcast to other bindings whose
                        // alias_target string happened to match the old
                        // value -- two unrelated aliases can share a target
                        // (e.g. `A := Dynamic` and `B := Dynamic`), and
                        // rewriting them in lockstep here created
                        // self-referential chains (`ffi_raw := Dynamic`
                        // followed by `ffi_java_raw := ffi_raw` used to
                        // leave ffi_raw.alias_target = "ffi_raw", and
                        // type_from_name would loop until stack overflow).
                        // The struct/func re-binding above is fine because
                        // it pivots on ptr_eq of the old Expr.
                        rb.alias_target = Str.clone(target_name.ident_name())
                    case:
                    }
                }
            }
        case:
        }
    }
}

reregister_repl_scope_defs := func(body: Expr, mut scope: TypeScope) {
    reregister_scope_defs(body, scope)
}

// Type-inference walk for a single body. Issue #204 step 3a: this
// proc no longer runs the asap-destruction pass; the scope-management
// sites that call infer_body invoke garbager_destroy_body(body, scope)
// themselves before tearing the scope down.
infer_body := proc(mut scope: TypeScope, mut body: Expr, in_func: I32, owns_scope: I32, in_loop: I32, returns_ref: I32, in_type_body: I32, mut ctx: Context) {
    body.set_til_type(Type.None)
    mut i : USize = 0
    while i < body.children.len() {
        if scope.parent.is_none().and(in_func.eq(0)).and(in_type_body.eq(0)) {
            context_set_mode_from_path(ctx, ctx.path)
        }
        infer_body_stmt(scope, body, i, in_func, in_loop, returns_ref, in_type_body, ctx)
        i++
    }
    if body_pre_passes(ctx, body, scope, owns_scope) {
        reregister_scope_defs(body, scope)
    }
}

// Issue #328: move every concrete declaration that late generic inference
// queued while the statement just typed was being walked onto the unit,
// then let infer_body_unit's dynamic-length loop type them.
//
// A Decl OWNS its FuncDef child, so a pending declaration's registration
// is valid only while it sits in ctx.generic_pending. The single
// take_children move invalidates all of them at once, which is why the
// re-registration below happens immediately after it and by destination
// index -- never against the pending storage, and never one-at-a-time
// interleaved with more moves.
priv flush_generic_pending := proc(mut scope: TypeScope, mut body: Expr, mut ctx: Context) {
    if ctx.generic_pending.children.len() == 0 { return }

    // Nested struct/enum/func definitions inside a substituted body are
    // lifted to the top level exactly as init_declarations_unit does for
    // an ordinary function. Task 6 refuses to infer a source whose
    // closure declares a struct or enum, so only FuncDefs reach here.
    mut nested := Vec(Expr).new()
    for mut pstmt : Expr in ctx.generic_pending.children {
        if pstmt.children.len() == 0 { continue }
        ref mut prhs : Expr = pstmt.children[0]
        if prhs.node_type.is(NodeType.FuncDef).not() { continue }
        if prhs.children.len() == 0 { continue }
        switch pstmt.node_type {
        case .Decl(pdd):
            init_lift_in_body(prhs.children[0], pdd.name, nested)
        case:
        }
    }
    for nl : Expr in nested {
        ctx.generic_pending.children.push(own nl.clone())
    }

    // Lambdas in those bodies, off the context-wide monotonic counter.
    typer_lift_lambdas(scope, ctx.generic_pending, ctx)

    for mut tstmt : Expr in ctx.generic_pending.children {
        extend_throwing_func_sigs(ctx, tstmt)
    }
    // Late declarations are created after type_decls_file classified this
    // unit's top level, so classify each one before it enters the body loop.
    for cstmt : Expr in ctx.generic_pending.children {
        constfolder_classify_stmt(cstmt, ctx)
    }

    start := body.children.len()
    body.take_children(ctx.generic_pending)

    for k in start..body.children.len() {
        register_function_def_for_stmt(ctx, body.children[k], scope)
    }
    init_refresh_seeded_scope_defs(body, scope)
    for k2 in start..body.children.len() {
        switch body.children[k2].node_type {
        case .Decl(kdd):
            if body.children[k2].children.len() == 0 { continue }
            kf_o := scope.lookup_func(kdd.name)
            if kf_o.is_none() {
                panic(ctx.path, ": late generic '", kdd.name, "' is not registered after append")
            }
            if kf_o.unwrap().ptr_eq(body.children[k2].children[0]).not() {
                panic(ctx.path, ": late generic '", kdd.name, "' is registered against stale storage")
            }
        case:
        }
    }
}

priv infer_body_unit := proc(mut scope: TypeScope, mut body: Expr, in_func: I32, owns_scope: I32, in_loop: I32, returns_ref: I32, in_type_body: I32, mut ctx: Context) {
    body.set_til_type(Type.None)
    // Issue #158: the foldable-name set (ctx.constfolder_foldables) is
    // populated by type_decls_file's existing per-decl walk, plus the
    // lifted-lambda tail in type_check_unit -- both of which complete
    // before this body walk starts. The dedicated pre-walk that used to
    // live here is gone; see type_decls_file for why the #315
    // forward-reference guarantee still holds (decls for the whole
    // import graph are classified before any body is typed).
    mut i : USize = 0
    while i < body.children.len() {
        infer_body_stmt(scope, body, i, in_func, in_loop, returns_ref, in_type_body, ctx)
        // #328: only here -- back in the top-level loop, with no ref into
        // the statement just typed still alive -- is it safe to append.
        // The loop re-reads children.len() each turn, so the appended
        // declarations are typed by this same sweep, and a concrete body
        // that queues another batch reaches a natural fixpoint.
        flush_generic_pending(scope, body, ctx)
        i++
    }
    if body_pre_passes(ctx, body, scope, owns_scope) {
        reregister_scope_defs(body, scope)
    }
}

// Type-check a single file unit. Caller must have registered a mode for path.
// #165 step 1: post-init normalization sweep.
//
// Initer's registration helpers store user-defined-type names as
// ~Type.Custom(name)~ via the scope-free ~til_type_from_explicit_type~,
// so they don't have to read scope. This sweep -- run after every file's
// init has completed but before type_check -- walks the global bindings
// and replaces ~Custom(name)~ with ~Struct(name)~ or ~Enum(name)~ when
// the name resolves to a real struct/enum. Bindings whose type does
// not resolve are left as ~Custom~ and surface as undefined-symbol
// errors during type_check (same as today).
normalize_scope_bindings := func(mut scope: TypeScope) {
    for mut b in scope.bindings.values {
        switch b.type {
        case .Custom(name):
            alias_b_o := scope.get_binding(name)
            if alias_b_o.is_some() {
                ref alias_b : TypeBinding = alias_b_o.unwrap()
                if alias_b.is_type_alias {
                    if alias_b.type.is(Type.Custom).not() {
                        b.type = alias_b.type.clone()
                        continue
                    }
                }
            }
            sdef_o := scope.get_struct(name)
            if sdef_o.is_none() { continue }
            if sdef_o.unwrap().node_type.is(NodeType.EnumDef) {
                b.type = Type.Enum(name.clone())
            } else {
                b.type = Type.Struct(name.clone())
            }
        case:
        }
    }
}

// --- Lambda lifting -----------------------------------------------------
//
// Anonymous `func(...) {...}` literals in expression positions (FCall
// args, NamedArg values, struct field defaults, etc.) are lifted out to
// the program top level as `_lambda_<N> := func(...) {...}` priv decls
// before the typer's main body walk. The original spot in the AST is
// replaced with an `Ident("_lambda_N")` reference; the typer then types
// the lifted decl as an ordinary named function.
//
// This used to live in a separate pre-typer transform file.
// Moved into the typer module so the parser stays dumb and the lift
// happens during the typer phase rather than as its own #158 pass.

priv type_check_unit := proc(path: Str, mut program: Expr, mut scope: TypeScope, mut ctx: Context) returns I32 {
    ctx.errors = 0
    context_enter_file(ctx, path)
    // #328: the late-generic queue is per unit. It should already be
    // empty (every flush drains it), but a stale entry would be appended
    // to the WRONG unit, so clear it here and check it drained at exit.
    ctx.generic_pending.children.clear()
    // #328 follow-up: same per-unit lifetime for the function-generator twins.
    // A twin is only reachable through this unit's scope registration, so
    // carrying one into the next unit would leave a dangling func_def.
    ctx.func_gen_twins.children.clear()
    // Lift anonymous func literals out of expression positions to
    // top-level _lambda_<N> priv decls. The typer then types them as
    // ordinary named functions through the normal walk below. Doing
    // this in the typer (rather than as a pre-typer pass in init_file)
    // keeps the parser dumb and avoids adding a #158-style extra walk.
    pre_lift_len := program.children.len()
    typer_lift_lambdas(scope, program, ctx)
    // Issue #158: the lifted `_lambda_<N>` decls are APPENDED after
    // type_decls_file already classified this unit's source-level top
    // level, so classify just that new tail -- not the whole body, which
    // would reinstate the full pre-walk this change removes.
    for li in pre_lift_len..program.children.len() {
        constfolder_classify_stmt(program.children[li], ctx)
    }
    // Issue #198: extend signatures of throwing functions BEFORE
    // any body type-checking so call-site rewrites in
    // inject_throw_args_in_body see the post-extension param list.
    extend_throwing_func_sigs(ctx, program)
    // The unit's top-level body is a function body too -- the builder
    // emits it as main -- so lower its throw/catch/bang calls exactly
    // like infer_func_def_expr does for a FuncDef, and before typing it
    // for the same reason. Only FuncDef bodies used to get this pass, so
    // a top-level `v[0]` (which parses to `v.get(0)!`) or `f()?` kept its
    // pre-lowering argument list while extend_throwing_func_sigs had
    // already appended the callee's err out-params: "missing argument for
    // parameter '_err_kind'".
    // The top level declares no throws (there is no signature to declare
    // them on), so an uncaught `?` reports the usual "declare it or catch
    // it" error instead of miscompiling.
    // Gate on the unit's OWN top level: the pass deep-clones the body it
    // is given, and its internal gate counts a bang anywhere in the file,
    // so running it unconditionally cloned and walked every file's entire
    // AST -- functions included -- to lower nothing.
    if toplevel_needs_throw_lowering(program) {
        unit_no_throws := Vec(Str).new()
        ctx.lowering_param_types = Map(Str, Str).new()
        collect_switch_case_bindings(ctx, program, program)
        process_throw_catch_in_func_body(ctx, program, unit_no_throws, "", OwnType.Shallow)
    }
    // #344: settle which parameters each borrow-returning function hands
    // back, before any body is typed. The bodies below read these summaries
    // to decide where a write through a returned `ref` actually lands, and
    // the redundant-`mut` verdict for a body is reached as that body is
    // typed -- a summary computed afterwards would come too late. Runs
    // after extend_throwing_func_sigs so the parameter indices it records
    // are the post-extension ones the call sites will use.
    compute_ref_return_summaries(program, scope)
    // For per-file units, we do not switch modes per statement.
    infer_body_unit(scope, program, 0, 1, 0, 0, 0, ctx)
    // #328: every batch the body loop queued has been flushed onto this
    // unit. A leftover would silently land on the next unit typed.
    if ctx.generic_pending.children.len() > 0 {
        panic(path, ": late generic declarations left unflushed at unit exit")
    }
    // Program-scope asap runs from prepare_program via
    // garbager_destroy(ctx) once all files are typed -- see issue #204
    // step 3b.
    return ctx.errors
}

// Two-sweep typer driver (#174 / #147 step 3-4 prep). type_file calls
// type_decls_file first (decls + methodgen + layout, future home of
// init_declarations_global's scope-using work) and then
// type_bodies_file (function body type-checking). Both walks are
// rstil-style: recurse on imports in source order, then handle this
// file. The split memo Sets (imports_typer_decls_done /
// imports_typer_bodies_done) ensure each file is visited at most once
// per sweep, and the per-file ordering "imports first, then this
// file" within each sweep matches today's single-sweep behaviour.
//
// type_decls_file currently owns layout computation
// (compute_struct_layout / compute_enum_layout), the layout-dependent
// size methodgen (gen_*_size_method_for_stmt), and the scope-free
// cmp/unity derived-method helpers. Subsequent commits relocate the
// scope-using methodgen (gen_struct_clone_delete,
// gen_missing_enum_clone) the same way and eventually retire
// init_declarations_global's heavy parts entirely.
type_file := proc(path: Str, mut ctx: Context) returns I32 {
    mut total : I32 = 0
    total = total + type_decls_file(path, ctx)
    total = total + type_bodies_file(path, ctx)
    return total
}

priv type_repl_delta_decls_from := proc(mut program: Expr, start_idx: USize, mut ctx: Context) returns I32 {
    total : I32 = 0
    mut i := start_idx
    while i < program.children.len() {
        ref mut stmt : Expr = program.children[i]
        i++
        if stmt.node_type.is(NodeType.Decl).not() { continue }
        if stmt.children.len() == 0 { continue }
        ref mut rhs : Expr = stmt.children[0]
        if rhs.node_type.is(NodeType.StructDef) {
            switch stmt.node_type {
            case .Decl(d):
                compute_struct_layout(d.name, rhs, ctx.scope, ctx)
            case:
            }
            gen_struct_size_method_for_stmt(stmt, ctx)
        } else if rhs.node_type.is(NodeType.EnumDef) {
            switch stmt.node_type {
            case .Decl(d):
                compute_enum_layout(d.name, rhs, ctx.scope, ctx)
            case:
            }
            gen_enum_size_method_for_stmt(stmt, ctx.scope, ctx)
        }
        gen_cmp_derived_for_stmt(stmt)
        gen_unity_derived_for_stmt(stmt)
        // Issue #158: same inline classify as type_decls_file. The REPL
        // delta path does not go through type_decls_file, so this is
        // where its top-level decls enter ctx.constfolder_foldables now
        // that infer_body_unit no longer pre-walks for them.
        constfolder_classify_stmt(stmt, ctx)
    }
    return total
}

type_repl_delta := proc(path: Str, mut program: Expr, mut ctx: Context) returns I32 {
    context_enter_file(ctx, path)
    mut total : I32 = 0
    total = total + type_repl_delta_decls_from(program, 0, ctx)
    post_decl_start := program.children.len()
    total = total + type_check_unit(path, program, ctx.scope, ctx)
    total = total + type_repl_delta_decls_from(program, post_decl_start, ctx)
    total = total + check_unused_priv_top_level(ctx.scope, ctx)
    total = total + check_unused_priv_members_in_program(program, path, ctx)
    return total
}

// First of two typer sweeps: per file, recurse on imports first
// (matching the existing rstil-style ordering), then walk top-level
// decls and do struct/enum layout computation, layout-dependent size
// methodgen, and the scope-free cmp/unity derived-method helpers.
// Layout's nested-type lookups follow scope.get_struct /
// get_binding; the topo-ordered import recursion above guarantees
// every import's layouts are already done before the parent file's
// layouts run, and within a file compute_*_layout recurses on
// nested defs for local forward references. The remaining
// scope-using methodgen (gen_struct_clone_delete,
// gen_missing_enum_clone) and the post-init re-registration loops
// stay in init_declarations_global for now -- they hit the #174
// method-body cycle and will migrate once the second sweep takes
// over function bodies.
priv type_decls_file := proc(path: Str, mut ctx: Context) returns I32 {
    if ctx.imports_typer_decls_done.has(path) {
        return 0
    }
    ctx.imports_typer_decls_done.add(own path.clone())

    ref mut iu : ImportUnit = ctx.imported[path]
    mut total : I32 = 0
    ast_count : USize = count_ast_imports(iu.ast)
    auto_count : USize = iu.imports.len() - ast_count
    for i in 0..auto_count {
        ref dep : Str = iu.imports[i]
        total = total + type_decls_file(dep, ctx)
    }
    mut import_idx : USize = auto_count
    for stmt : Expr in iu.ast.children {
        mut is_imp := false
        if stmt.node_type.is(NodeType.Decl).and(stmt.children.len().gt(0)) {
            ref imp_stmt : Expr = stmt.children[0]
            if imp_stmt.node_type.is(NodeType.FCall).and(imp_stmt.children.len().gte(2)) {
                if imp_stmt.children[1].node_type.is_literal_str() {
                    switch imp_stmt.children[0].node_type {
                    case .Ident(id):
                        if id.ident_name() == "import" { is_imp = true }
                    case:
                    }
                }
            }
        } else {
            if stmt.node_type.is(NodeType.FCall).and(stmt.children.len().gte(2)) {
                if stmt.children[1].node_type.is_literal_str() {
                    switch stmt.children[0].node_type {
                    case .Ident(id):
                        if id.ident_name() == "import" { is_imp = true }
                    case:
                    }
                }
            }
        }

        if is_imp {
            ref dep : Str = iu.imports[import_idx]
            total = total + type_decls_file(dep, ctx)
            import_idx++
        }
    }

    // Per-decl work in source order: compute struct/enum layouts,
    // synthesize the layout-dependent size method, and run the
    // scope-free cmp/unity derived-method helpers. Layout has to run
    // before gen_*_size_method_for_stmt (which reads
    // total_struct_size / total_enum_size) and before the cmp/unity
    // helpers (which inspect the same ns_decls that size methodgen
    // may have just populated). All three steps are safe in this
    // sweep because compute_*_layout's nested-type lookups follow
    // the same scope.get_struct / scope.get_binding path that
    // init_declarations_global used today; the rstil-style
    // topo-ordered recursion above guarantees every import's
    // layouts are already done by the time we get here. Within a
    // file, compute_struct_layout / compute_enum_layout internally
    // recurse on nested defs to handle local forward references.
    for mut stmt : Expr in iu.ast.children {
        if stmt.node_type.is(NodeType.Decl).not() { continue }
        if stmt.children.len() == 0 { continue }
        ref mut rhs : Expr = stmt.children[0]
        if rhs.node_type.is(NodeType.StructDef) {
            switch stmt.node_type {
            case .Decl(d):
                compute_struct_layout(d.name, rhs, ctx.scope, ctx)
            case:
            }
            gen_struct_size_method_for_stmt(stmt, ctx)
        } else if rhs.node_type.is(NodeType.EnumDef) {
            switch stmt.node_type {
            case .Decl(d):
                compute_enum_layout(d.name, rhs, ctx.scope, ctx)
            case:
            }
            gen_enum_size_method_for_stmt(stmt, ctx.scope, ctx)
        }
        // gen_cmp_derived_for_stmt / gen_unity_derived_for_stmt self-guard
        // on is_struct_or_enum, so calling them for FuncDef stmts is a
        // cheap no-op. Removing the earlier `else { continue }` lets #158's
        // classify below run for every top-level decl (FuncDef included)
        // without a second walk.
        gen_cmp_derived_for_stmt(stmt)
        gen_unity_derived_for_stmt(stmt)
        // Issue #158: populate the constfolder foldable-name set inline.
        // Runs after gen_*_size_method / gen_cmp / gen_unity so classify
        // sees the ns methods those helpers just added. type_decls_file
        // completes for every imported file before type_bodies_file
        // starts on any of them (topo-ordered recursion above), so by
        // the time any body is type-checked -- and body_pre_passes reads
        // is_macro_call for hoist decisions -- every top-level foldable
        // in the transitive import graph is already recorded. That is
        // what the old pre-walk in infer_body_unit had to guarantee
        // for the forward-reference case flagged by #315.
        constfolder_classify_stmt(stmt, ctx)
    }
    return total
}

// Per-file body type-check sweep (the second of two). The recursion
// here is the same shape as the current single-sweep type_file: walk
// imports in source order, then type_check_unit. Renamed from
// type_file to make the two-sweep split explicit.
priv type_bodies_file := proc(path: Str, mut ctx: Context) returns I32 {
    if ctx.imports_typer_bodies_done.has(path) {
        return 0
    }
    ctx.imports_typer_bodies_done.add(own path.clone())

    ref mut iu : ImportUnit = ctx.imported[path]

    // Walk the AST in source order; recurse on each ~import("...")~ FCall.
    // iu.imports stays as a source-ordered side table for path resolution.
    // Loader-prepended mode auto-imports (e.g. mode gui -> gui.til) come
    // first in iu.imports without a matching AST FCall, so process those
    // leading entries before the walk. #165 step 5.
    mut total : I32 = 0
    ast_count : USize = count_ast_imports(iu.ast)
    auto_count : USize = iu.imports.len() - ast_count
    for i in 0..auto_count {
        ref dep : Str = iu.imports[i]
        total = total + type_bodies_file(dep, ctx)
    }
    mut import_idx : USize = auto_count
    for stmt : Expr in iu.ast.children {
        if stmt.node_type.is(NodeType.FCall).not() { continue }
        // >= 2, matching count_ast_imports: a selective import
        // (`import("x", Sym)`) has 3 children. Requiring exactly 2 here
        // desynchronized this walk from the auto_count math above, so
        // the dep AFTER a selective import was never body-typed -- its
        // priv uses stayed unmarked and tripped the #187 unused-priv
        // check (visible as bogus "unused priv" errors in that file).
        if stmt.children.len() < 2 { continue }
        if stmt.children[1].node_type.is_literal_str().not() { continue }
        switch stmt.children[0].node_type {
        case .Ident(id):
            if id.ident_name().eq("import").not() { continue }
            ref dep : Str = iu.imports[import_idx]
            total = total + type_bodies_file(dep, ctx)
            import_idx++
        case:
            continue
        }
    }

    context_enter_file(ctx, path)
    if iu.mode_str == "mode" {
        for stmt : Expr in iu.ast.children {
            mut is_valid := false
            if stmt.node_type.is(NodeType.Decl) {
                switch stmt.node_type {
                case .Decl(_dd):
                    if stmt.children.len() > 0 {
                        ref val : Expr = stmt.children[0]
                        if val.node_type.is(NodeType.NoDefaultArg).not() {
                            if val.node_type.is(NodeType.FCall).and(val.children.len().gt(0)) {
                                ref callee : Expr = val.children[0]
                                switch callee.node_type {
                                case .Ident(id):
                                    if id.ident_name() == "Mode" {
                                        is_valid = true
                                    }
                                case:
                                }
                            }
                        }
                    }
                case:
                }
            } else if stmt.node_type.is(NodeType.FCall).and(stmt.children.len().eq(2)) {
                if stmt.children[1].node_type.is_literal_str() {
                    switch stmt.children[0].node_type {
                    case .Ident(id):
                        if id.ident_name() == "import" { is_valid = true }
                    case:
                    }
                }
            }
            if is_valid.not() {
                stmt.type_error("only Mode declarations (e.g. `cli := Mode(...)`) and imports are allowed in 'mode mode'", ctx)
            }
        }
    }
    return total + type_check_unit(path, iu.ast, ctx.scope, ctx)
}

priv infer_assign_stmt := proc(mut scope: TypeScope, mut stmt: Expr, in_func: I32, mut ctx: Context) {
    mut aname := ""
    switch stmt.node_type {
    case .Assign(adata):
        aname = adata.name.clone()
    case:
        UNREACHABLE("expected Assign, got ", stmt.node_type.head_str())
        return
    }
    // #341: `s = .Nothing` -- the target's own type is the expected enum,
    // so fill the elided name in before the RHS is inferred.
    qualify_dotted_expr(stmt.children[0], scope.get_type(aname))
    infer_expr(scope, stmt.children[0], in_func, ctx)
    ref mut rhs : Expr = stmt.children[0]
    stmt.set_til_type(rhs.til_type())
    // A write isn't a read. Don't flip `used = true` on the assign
    // target for plain mut locals -- that's the accidental exception
    // that masks write-only locals like `mut y := x; y = 99` as
    // not-unused.
    //
    // Two carve-outs where the write IS observable:
    // - Params: a `mut foo: T` param is an output channel watched by
    //   the caller.
    // - Ref bindings: `ref mut x : T = &slot` followed by `x = v` is
    //   the explicit write-through-ref pattern -- the assign is the
    //   whole point of the binding.
    mut ub_o := scope.get_binding(aname)
    if ub_o.is_some() {
        ref mut ub : TypeBinding = ub_o.unwrap()
        // #154: writing a cross-file global counts as using its import
        // even though it is not a read for the unused-variable check.
        note_cross_file_use(ctx, ub.path)
        if ub.is_param.or(ub.own_type.is(OwnType.Ref)) { ub.used = true }
    }
    existing := scope.get_type(aname)
    // #321: `x = 0` on a Dynamic target is the null spelling.
    rewrite_zero_to_null(rhs, existing, false)
    // #321 step 4: null only overwrites quarantine-labeled slots.
    if rhs.node_type.is_literal_null().and(existing.is(Type.Unknown).not()) {
        if type_is_null_quarantine(existing).not() {
            rhs.type_error(format("cannot assign a null pointer to '", aname, "'; null is quarantine-only (Dynamic / the U8-I8 raw labels, where it is spelled `0`) -- use an Option for a real absent state (#321)"), ctx)
        }
    }
    if existing.is(Type.Unknown) {
        stmt.type_error(format("undefined symbol '", aname, "'"), ctx)
    } else if scope.is_mut(aname).not() {
        stmt.type_error(format("cannot assign to immutable variable '", aname, "'"), ctx)
        sf := scope.find(aname)
        switch sf {
        case .Found(b):
            if b.is_param {
                println(ctx.path, ":", b.line.to_str(), ":", b.col.to_str(), ": note: '", aname, "' is a function parameter")
            } else {
                println(ctx.path, ":", b.line.to_str(), ":", b.col.to_str(), ": note: '", aname, "' declared here, consider adding 'mut'")
            }
        case:
        }
    } else if rhs.node_type.is_literal_num().and(is_numeric_type(existing)) {
        switch rhs.node_type {
        case .Literal(Literal.Num(lit_str)):
            if literal_in_range(lit_str.literal_num_text(), existing).not() {
                stmt.type_error(format("integer literal out of range for assignment to '", aname, "'"), ctx)
            }
        case:
        }
        rhs.set_til_type(existing)
        stmt.set_til_type(existing)
    } else if rhs.til_type().is(existing).not().and(rhs.til_type().is(Type.Unknown).not())
        // Issue #58 / #147 step 5: FuncPtr/FuncPtrSig wildcard family-eq.
        .and(funcptr_eq(rhs.til_type(), existing).not()) {
        // Issue #244: a `_m_*` target is a synthesized match result temp; an
        // arm-type mismatch was already reported cleanly by infer_match_expr,
        // so don't also surface the internal temp name here.
        if aname.starts_with("_m_").not() {
            stmt.type_error(format("'", aname, "' assignment type mismatch"), ctx)
        }
    }
    // #164: record that this binding was written through. Done before
    // the ScopeFind.Found read below because get_binding returns a ref
    // so the write actually persists (find returns by-value semantics).
    // #344: `ref mut r : T = <borrow>` followed by `r = v` writes the
    // storage `r` aliases, so the same walker credits its roots.
    mark_name_written(scope, aname)
    sf_assign := scope.find(aname)
    mut is_ref_target := false
    mut is_payload_alias := false
    switch sf_assign {
    case .Found(ab):
        if ab.own_type.is(OwnType.Ref).and(ab.is_param.not()) {
            is_ref_target = true
            if ab.is_alias { is_payload_alias = true }
        }
    case:
    }
    if is_payload_alias {
        switch stmt.node_type {
        case .Assign(adata_p):
            adata_p.is_payload_alias = true
        case:
        }
    }
    if is_ref_target {
        // #211: payload aliases accept an owned-value RHS (the builder
        // lowers it to `*p = *new` for structs and `*p = (Str){...}` for
        // Str literals); only plain ref bindings still reject.
        if is_payload_alias.not() {
            check_ref_assign_owned_rhs(stmt, aname, rhs, scope, ctx)
        }
    }
    if is_ref_target.not() {
        // A ref-returning call's AGGREGATE result is BORROWED storage:
        // reassigning it into an owned (non-ref) binding makes the
        // target's teardown free the callee's block (a double free).
        // The Decl form (`x := f()`) was already rejected in infer_decl;
        // plain reassignment slipped past the typer and compiled into a
        // double free. Pointer/scalar-shaped results (`p = deref(q)`,
        // `c = s.unsafe_get(i)`) copy the value and stay legal to
        // reassign.
        if rhs.node_type.is(NodeType.FCall).and(fcall_returns_ref(rhs, scope).neq(0)).and(is_aggregate(existing)) {
            stmt.type_error("cannot own result of ref-returning function; use 'ref' or Type.clone()", ctx)
        }
        if rhs.node_type.is(NodeType.Ident).or(
            rhs.node_type.is(NodeType.FieldAccess).and(
                is_aggregate(rhs.til_type())
            )
        ) {
            tname := type_to_name(rhs.til_type())
            // Issue #58 / #147 step 5: FuncPtr/FuncPtrSig has no T_clone.
            if tname.len().gt(0).and(rhs.til_type().is_funcptr().not()).and(rhs.til_type().is(Type.Body).not()) {
                mc := make_clone_call(tname, rhs.til_type(), rhs, stmt)
                stmt.children[0] = mc
            }
        }
        // The outer-scope save_old_delete decision (an assign from a
        // nested scope to an enclosing function-local rebinding an
        // owned aggregate) now lives in the garbager's
        // insert_assign_delete, beside the in-scope assign decision --
        // #302 stage 4: save_old_delete has exactly one writer pass.
    }
}

rhs_is_clone_fcall := func(rhs: Expr) returns Bool {
    if rhs.node_type.is(NodeType.FCall).not() { return false }
    if rhs.children.len() < 1 { return false }
    ref callee : Expr = rhs.children[0]
    if callee.node_type.is(NodeType.FieldAccess).not() { return false }
    switch callee.node_type {
    case .FieldAccess(method):
        return method.field_access_name() == "clone"
    case:
        return false
    }
}

assign_target_is_func_local := func(mut scope: TypeScope, name: Str) returns Bool {
    // Walks to the root; the root scope itself never qualifies (a
    // top-level binding is not a func local).
    switch scope.parent {
    case .None: return false
    case .Some(p):
        if scope.bindings.has(name) { return true }
        return assign_target_is_func_local(p, name)
    }
}

is_numeric_type := func(t: Type) returns Bool {
    switch t {
    case .Primitive(Primitive.I64): return true
    case .Primitive(Primitive.U8):  return true
    case .Primitive(Primitive.I8):  return true
    case .Primitive(Primitive.I16): return true
    case .Primitive(Primitive.U16): return true
    case .Primitive(Primitive.I32): return true
    case .Primitive(Primitive.U32): return true
    case .Primitive(Primitive.U64): return true
    case .Primitive(Primitive.F32): return true
    case .Primitive(Primitive.F64): return true
    case: return false
    }
}

is_integral_numeric_type := func(t: Type) returns Bool {
    switch t {
    case .Primitive(Primitive.I64): return true
    case .Primitive(Primitive.U8):  return true
    case .Primitive(Primitive.I8):  return true
    case .Primitive(Primitive.I16): return true
    case .Primitive(Primitive.U16): return true
    case .Primitive(Primitive.I32): return true
    case .Primitive(Primitive.U32): return true
    case .Primitive(Primitive.U64): return true
    case: return false
    }
}

priv type_ctor_consumes := func(t: Type) returns Bool {
    // Primitives (now all Type.Primitive) are value types -- a ctor field
    // default of `0` with explicit type I32
    // shouldn't trigger "own" semantics. Without this short-circuit, the
    // generic Type.Struct case below pulls them into set_own_arg in
    // infer_struct_constructor_fcall, which makes the typer's hoist pass
    // promote the LiteralNum temp to Own, which makes the builder emit
    // `I32 *t = malloc(sizeof(I32)); *t = 0;` -- a per-LocalInfo leak that
    // never gets freed. (Issue #109.)
    if is_primitive(t) { return false }
    // #302: every CALLABLE field consumes its ctor arg -- the field takes
    // the callable box pointer itself. Type.FuncPtr alone missed the
    // NAMED-signature form (`UnaryOp := func(I64) returns I64` is
    // Type.FuncPtrSig) and Type.Body entirely, so those ctor args were
    // never marked own: the transfer was invisible to the pass (it
    // emitted a closure drop on the box the field now owned -- a
    // use-after-free the builder masked with its swap_freed defusing
    // set) and to the interpreter's own-arg move path.
    if is_funcptr(t) { return true }
    switch t {
    case .Struct, .Enum, .Dynamic, .Body: return true
    case: return false
    }
}

priv is_usize_name := func(name: Str) returns Bool {
    return name == "USize"
}

priv is_uptr_name := func(name: Str) returns Bool {
    return name == "UPtr"
}

priv can_implicit_usize_coerce := func(from: Type, to: Type, to_name: Str) returns Bool {
    // USize and UPtr are the same test: both are container-width aliases
    // that resolve to U32 or U64 depending on the build, and an integral
    // source coerces into either. They were two identical switches.
    if is_usize_name(to_name).or(is_uptr_name(to_name)) {
        switch to {
        case .Primitive(Primitive.U32):
            return is_integral_numeric_type(from)
        case .Primitive(Primitive.U64):
            return is_integral_numeric_type(from)
        case: return false
        }
    }
    return false
}

literal_in_range := func(val_str: Str, target: Type) returns Bool {
    switch target {
    case .Primitive(Primitive.I64): return true
    case .Primitive(Primitive.F32): return true
    case .Primitive(Primitive.F64): return true
    case .Primitive(Primitive.U8):
        val := val_str.to_i64()
        return val.gte(0).and(val.lte(255))
    case .Primitive(Primitive.I8):
        val := val_str.to_i64()
        return val.gte(-128).and(val.lte(127))
    case .Primitive(Primitive.I16):
        val := val_str.to_i64()
        return val.gte(-32768).and(val.lte(32767))
    case .Primitive(Primitive.U16):
        val := val_str.to_i64()
        return val.gte(0).and(val.lte(65535))
    case .Primitive(Primitive.I32):
        val := val_str.to_i64()
        return val.gte(-2147483648).and(val.lte(2147483647))
    case .Primitive(Primitive.U32):
        val := val_str.to_i64()
        return val.gte(0).and(val.lte(4294967295))
    case .Primitive(Primitive.U64):
        val := val_str.to_i64()
        return val >= 0
    case: return true
    }
}

// Type-name resolution at a user-facing site (parameter type, return
// type, ref/let decl explicit_type). Shares the single
// scope.get_binding lookup with the priv check, so user-facing
// callers don't pay for two Map traversals per declaration position.
priv type_from_name_at := proc(name: Str, mut scope: TypeScope, e: Expr, mut ctx: Context) returns Type {
    pt := type_from_name(name, scope, ctx)
    if name.len() == 0 { return pt }
    if ctx.current_type_name == name { return pt }
    b_o := scope.get_binding(name)
    if b_o.is_some() { check_priv_access(e, name, b_o.unwrap(), ctx) }
    return pt
}

type_from_name := func(name: Str, mut scope: TypeScope, mut ctx: Context) returns Type {
    mut bt := Type.Unknown
    if builtin_type_from_name(name, bt) { return bt }
    // #192: USize/UPtr resolve to the loader-stamped per-target primitive
    // name, same authority as type_from_name_init and resolve_type_alias.
    if name == "USize" { return type_from_name(ctx.target_usize_pname, scope, ctx) }
    if name == "UPtr" { return type_from_name(ctx.target_uptr_pname, scope, ctx) }
    fp := name_fingerprint(name)
    mut b_o := scope.get_binding_fp(name, fp)
    if b_o.is_some() {
        ref mut b : TypeBinding = b_o.unwrap()
        // #154: a type annotation naming a cross-file type uses its
        // import (no auto_gen/current_type_name gate -- auto-generated
        // bodies only exist because this file declared the type, so
        // their annotations are source-level uses of the field types).
        note_cross_file_use(ctx, b.path)
        if b.is_type_alias {
            if b.alias_target.is_empty().not() {
                return type_from_name(b.alias_target, scope, ctx)
            }
        }
        // #187: explicit type annotations (e.g. ~ref x : Foo = ...~,
        // function param/return types) count as a use of the named
        // type. Same gate as the Ident path -- skip when we're inside
        // the type's own namespace to keep auto-gen body references
        // from masking a genuinely unused priv type.
        if ctx.auto_gen_depth.eq(0).and(ctx.current_type_name.eq(name).not()) {
            b.used = true
        }
        b_fd_o := scope.lookup_func_fp(b.name, fp)
        if b.is_builtin {
            // A builtin binding is either a builtin TYPE (had a
            // struct_def) or a builtin ext_func (has a func_def);
            // never both. The old read here was
            // `if b.struct_def.is_null().not()`, i.e. "builtin type".
            // With struct_def removed, test the equivalent "builtin
            // and NOT a func". lookup_func is shadowing-aware (gates
            // on the binding's own scope) so it matches the exact
            // per-binding semantics the struct_def field read had,
            // unlike a get_struct name-walk which can fall through to
            // a parent type of the same name. Clone the result: every
            // type_from_name return path yields an owned Type that the
            // caller Type_deletes.
            if b_fd_o.is_none() { return b.type.clone() }
        }
        if b_fd_o.is_some() {
            ref b_fd : Expr = b_fd_o.unwrap()
            if b_fd.children.len() == 0 {
                // Issue #58 / #147 step 5: a name that resolves to a
                // bodyless FuncDef (a FuncSig alias like `BinaryOp`)
                // now carries the alias name in the type itself.
                // Callsites that ask "is this a FuncPtr?" go through
                // `t.is_funcptr()` (helper accepting both `FuncPtr`
                // and `FuncPtrSig`). Consumers needing the FuncSig
                // name read it from `til_type_name(t)` instead of
                // from the carrier's `Declaration.explicit_type`,
                // which is the migration that eventually drops the
                // field.
                return Type.FuncPtrSig(name.clone())
            }
        }
    }
    sdef_o := scope.get_struct_fp(name, fp)
    if sdef_o.is_some() {
        ref sdef : Expr = sdef_o.unwrap()
        if sdef.node_type.is(NodeType.EnumDef) {
            return Type.Enum(name.clone())
        }
        return Type.Struct(name.clone())
    }
    return Type.Unknown
}

resolve_type_alias := func(scope: TypeScope, name: Str) returns ref Str {
    // #192: USize/UPtr resolve to the per-target width registered by the
    // loader, the same authority the builtin type table uses, so the
    // name-form (this function) and the type-form never disagree -- even
    // during init, before the alias binding is retargeted.
    if name == "USize" { return scope_target_usize_pname(scope) }
    if name == "UPtr" { return scope_target_uptr_pname(scope) }
    b_o := scope.get_binding(name)
    if b_o.is_some() {
        ref b : TypeBinding = b_o.unwrap()
        if b.is_type_alias {
            if b.alias_target.is_empty().not() { return b.alias_target }
        }
    }
    return name
}

// NAME-forming twin of resolve_type_alias. USize/UPtr are the INTERFACE:
// their width is a property of the target (--usize) resolved by ext.h's
// typedef and USize.size(), and it is not always U32 or U64 (a future
// target may make it U16 or U128) -- so a width alias is NEVER resolved
// into a type/instance NAME. The parser already mangles annotation
// spellings raw (Map(Str, USize) -> Map__Str_USize); this keeps every
// other name-forming site (monomorphization instance names, synthesized
// collection decls, variadic array keys) on the same spelling, instead
// of baking one width in and making two names for one type circulate
// (Map__Str_USize vs Map__Str_U32) depending on declaration order.
// User-written aliases still resolve, exactly like resolve_type_alias.
resolve_type_alias_for_name := func(scope: TypeScope, name: Str) returns ref Str {
    if name.eq("USize").or(name.eq("UPtr")) { return name }
    return resolve_type_alias(scope, name)
}

priv usize_name := func(scope: TypeScope) returns Str {
    if scope.get_binding("USize").is_some() { return "USize" }
    return "U64"
}

usize_type := func(mut scope: TypeScope, mut ctx: Context) returns Type {
    return type_from_name(usize_name(scope), scope, ctx)
}

type_has_cmp := func(scope: TypeScope, type_name: Str) returns Bool {
    sdef_o := scope.get_struct(type_name)
    if sdef_o.is_none() { return false }
    ref sdef : Expr = sdef_o.unwrap()
    return def_ns_has(sdef, "cmp")
}

priv type_has_to_str := func(scope: TypeScope, type_name: Str) returns Bool {
    sdef_o := scope.get_struct(type_name)
    if sdef_o.is_none() { return false }
    ref sdef : Expr = sdef_o.unwrap()
    return def_ns_has(sdef, "to_str")
}

priv expr_contains_fcall := func(e: Expr) returns Bool {
    if e.node_type.is(NodeType.FCall) { return true }
    for e_i : Expr in e.children {
        if expr_contains_fcall(e_i) { return true }
    }
    return false
}

expr_uses_var := func(e: Expr, name: Str) returns Bool {
    if e.node_type.is(NodeType.FuncDef) { return false }
    switch e.node_type {
    case .Ident(id):
        if id.ident_name() == name { return true }
    case .Assign(asgn):
        if asgn.name == name { return true }
    case:
    }
    for e_i : Expr in e.children {
        if expr_uses_var(e_i, name) { return true }
    }
    return false
}

expr_contains_decl := func(e: Expr, name: Str) returns Bool {
    if e.node_type.is(NodeType.FuncDef) { return false }
    switch e.node_type {
    case .Decl(dd):
        if dd.name == name { return true }
    case:
    }
    for e_i : Expr in e.children {
        if expr_contains_decl(e_i, name) { return true }
    }
    return false
}

expr_used_in_nested_func := func(e: Expr, name: Str) returns Bool {
    switch e.node_type {
    case .FuncDef(fdef):
        for p : Declaration in fdef.params {
            if p.name == name { return false }
        }
        if e.children.len() > 0 {
            return expr_uses_var(e.children[0], name)
        }
        return false
    case:
    }
    for e_i : Expr in e.children {
        if expr_used_in_nested_func(e_i, name) { return true }
    }
    return false
}

type_prefix := func(t: Type) returns Str {
    switch t {
    case .Primitive(Primitive.I64): return "I64"
    case .Primitive(Primitive.U8): return "U8"
    case .Primitive(Primitive.I8): return "I8"
    case .Primitive(Primitive.I16): return "I16"
    case .Primitive(Primitive.U16): return "U16"
    case .Primitive(Primitive.I32): return "I32"
    case .Primitive(Primitive.U32): return "U32"
    case .Primitive(Primitive.U64): return "U64"
    case .Primitive(Primitive.F32): return "F32"
    case .Primitive(Primitive.F64): return "F64"
    case .Primitive(Primitive.Bool): return "Bool"
    case .None: return "None"
    case .Struct(s):
        if s.len() > 0 { return s.clone() }
        return "compound"
    case .Enum(s):
        if s.len() > 0 { return s.clone() }
        return "compound"
    case .Custom(s):
        // #165 step 1: Custom(name) is the unresolved form of
        // Struct(name)/Enum(name). Treat them the same here so type
        // comparisons (e.g. argument-type checks) see a consistent
        // prefix string.
        if s.len() > 0 { return s.clone() }
        return "compound"
    case: return "v"
    }
}

type_to_name := func(t: Type) returns Str {
    name := til_type_name(t)
    if name.len() > 0 { return name }
    switch t {
    case .Primitive(Primitive.I64): return I64Name.clone()
    case .Primitive(Primitive.U8): return U8Name.clone()
    case .Primitive(Primitive.I8): return I8Name.clone()
    case .Primitive(Primitive.I16): return I16Name.clone()
    case .Primitive(Primitive.U16): return U16Name.clone()
    case .Primitive(Primitive.I32): return I32Name.clone()
    case .Primitive(Primitive.U32): return U32Name.clone()
    case .Primitive(Primitive.U64): return U64Name.clone()
    case .Primitive(Primitive.F32): return F32Name.clone()
    case .Primitive(Primitive.F64): return F64Name.clone()
    case .Primitive(Primitive.Bool): return BoolName.clone()
    case .Body: return "Body"
    case: return ""
    }
}

make_closure_delete_call := func(var_name: Str, src: Expr) returns Expr {
    mut call := Expr.new(NodeType.FCall(FCallData()), src.line, src.col)
    call.set_til_type(Type.None)

    mut callee := Expr.new(ident_node("til_closure_delete"), src.line, src.col)
    call.add_child(own callee)

    mut arg := Expr.new(ident_node(var_name), src.line, src.col)
    arg.set_til_type(Type.FuncPtr)
    call.add_child(own arg)

    return call
}

make_delete_call := func(var_name: Str, shallow type: Type, arg_is_own: Bool, call_free: Bool, src: Expr) returns Option(Expr) {
    if type.is_funcptr().or(type.is(Type.Body)) {
        if call_free.not() { return Option(Expr).None }
        return Option(Expr).Some(make_closure_delete_call(var_name, src))
    }
    tname := type_to_name(type)
    if tname.len() == 0 { return Option(Expr).None }

    mut call := Expr.new(NodeType.FCall(FCallData()), src.line, src.col)
    call.set_til_type(Type.None)

    mut type_id := Expr.new(ident_node(tname), src.line, src.col)
    type_id.set_til_type(Type.Custom(tname.clone()))

    mut fa := Expr.new(field_access_node("delete"), src.line, src.col)
    fa.add_child(own type_id)
    call.add_child(own fa)

    mut arg := Expr.new(ident_node(var_name), src.line, src.col)
    arg.set_til_type(type)
    if arg_is_own { set_own_arg(call, call.children.len()) }
    call.add_child(own arg)

    mut cf_lit := Expr.new(NodeType.Literal(Literal.Bool(call_free)), src.line, src.col)
    call.add_child(own cf_lit)

    return Option(Expr).Some(own call)
}

// True when `e` (or any sub-expression) is a struct constructor FCall of the
// shape `Type(..., var_name, ...)` where var_name is at the position of a
// field whose declared own_type is `Shallow`. In that case the constructor
// emits `dst->field = *var_name`, i.e. value-copies the inner Str/Vec/etc.
// from var_name's heap wrapper into the field; the field's own destructor
// will free the inner data when the parent struct is destroyed, but nothing
// frees var_name's wrapper, so it leaks.
//
// This is the exact shape we want `make_free_call` to follow up. Other
// transfer shapes -- own arg to a function, struct constructor with an Own
// or Ref field -- already consume the wrapper, so we must NOT emit a free.
// The value expr of a ctor arg: the wrapped child for a NamedArg
// (`Type(field = local)`), the arg itself otherwise.
priv named_arg_inner := func(arg: Expr) returns ref Expr {
    switch arg.node_type {
    case .NamedArg:
        if arg.children.len() > 0 { return arg.children[0] }
    case:
    }
    return arg
}

transfer_is_shallow_field_value_copy := func(e: Expr, var_name: Str, scope: TypeScope) returns Bool {
    if e.node_type.is(NodeType.FuncDef) { return false }
    if e.node_type.is(NodeType.FCall) {
        if e.children.len() >= 2 {
            fcall_sname_o := expr_type_name_ref(e)
            if fcall_sname_o.is_some() {
                ref fcall_sname : Str = fcall_sname_o.unwrap()
                switch e.children[0].node_type {
                case .Ident(c0s):
                    if c0s.ident_name() == fcall_sname {
                        sdef_o := scope.get_struct(fcall_sname)
                        if sdef_o.is_some() {
                            ref sdef : Expr = sdef_o.unwrap()
                            switch sdef.node_type {
                            case .StructDef(tsv_sdd):
                                // Walk every constructor arg. For each
                                // arg that resolves to `Ident(var_name)`
                                // (positional or NamedArg-wrapped), look
                                // up the matching field by position
                                // (positional) or by name (NamedArg) to
                                // check its own_type. The previous loop
                                // only checked positional Ident args and
                                // missed every Type(field = local) form,
                                // so the local's wrapper leaked there.
                                for ci in 1..e.children.len() {
                                    ref arg : Expr = e.children[ci]
                                    ref inner : Expr = named_arg_inner(arg)
                                    mut field_name : Str = ""
                                    switch arg.node_type {
                                    case .NamedArg(nan):
                                        field_name = nan
                                    case:
                                    }
                                    switch inner.node_type {
                                    case .Ident(an):
                                        if an.ident_name().eq(var_name).not() { continue }
                                        // Resolve the receiving field.
                                        mut fd_idx : I32 = -1
                                        if field_name.is_empty() {
                                            // Positional: arg position ci-1 maps to field index.
                                            fd_idx = ci.sub(1).to_i32()
                                        } else if tsv_sdd.fields_index.has(field_name) {
                                            fd_idx = tsv_sdd.fields_index[field_name].to_i32()
                                        }
                                        if fd_idx < 0 { continue }
                                        if fd_idx.to_usize() >= tsv_sdd.fields.len() { continue }
                                        ref fld_decl : Declaration = tsv_sdd.field_at(fd_idx.to_usize())
                                        if fld_decl.own_type.is(OwnType.Shallow).not() { continue }
                                        if type_ctor_consumes(fld_decl.til_type) {
                                            return true
                                        }
                                    case:
                                    }
                                }
                            case:
                            }
                        }
                    }
                case:
                }
            }
        }
    }
    for ec : Expr in e.children {
        if transfer_is_shallow_field_value_copy(ec, var_name, scope) { return true }
    }
    return false
}

// `free(own var_name)`: release just the heap wrapper without invoking the
// type's destructor. Used after value-copy ownership transfer to a Shallow
// struct field, where the field's own destructor will free the inner data.
make_free_call := func(var_name: Str, shallow type: Type, src: Expr) returns Expr {
    if type.is_funcptr().or(type.is(Type.Body)) { return make_closure_delete_call(var_name, src) }
    mut call := Expr.new(NodeType.FCall(FCallData()), src.line, src.col)
    call.set_til_type(Type.None)

    mut callee := Expr.new(ident_node("free"), src.line, src.col)
    call.add_child(own callee)

    mut arg := Expr.new(ident_node(var_name), src.line, src.col)
    arg.set_til_type(type)
    set_own_arg(call, call.children.len())
    call.add_child(own arg)

    return call
}

make_clone_call := func(type_name: Str, shallow type: Type, arg: Expr, src: Expr) returns Expr {
    mut call := Expr.new(NodeType.FCall(FCallData()), src.line, src.col)
    call.set_til_type(type)
    if type.is(Type.Struct).and(til_type_name(type).len().eq(0)) {
        call.set_til_type(Type.Struct(type_name.clone()))
    } else if type.is(Type.Enum).and(til_type_name(type).len().eq(0)) {
        call.set_til_type(Type.Enum(type_name.clone()))
    }

    mut type_id := Expr.new(ident_node(type_name), src.line, src.col)
    type_id.set_til_type(Type.Custom(type_name.clone()))

    mut fa := Expr.new(field_access_node("clone"), src.line, src.col)
    fa.add_child(own type_id)
    call.add_child(own fa)

    call.add_child(own arg.clone())
    return call
}

// Wrap `arg` with `T.to_str(arg)`, used to auto-coerce non-Str args
// passed to a `..Str` variadic param so `print(1+1)` etc. work.
priv make_to_str_call := func(type_name: Str, arg: Expr) returns Expr {
    mut call := make_ns_call(type_name, "to_str", Type.Struct("Str"), arg)
    call.add_child(own arg.clone())
    return call
}

make_ns_call := func(sname: Str, method: Str, shallow ret_type: Type, src: Expr) returns Expr {
    mut call := Expr.new(NodeType.FCall(FCallData()), src.line, src.col)
    call.set_til_type(ret_type)

    mut type_id := Expr.new(ident_node(sname), src.line, src.col)
    type_id.set_til_type(Type.Custom(sname.clone()))

    mut fa := Expr.new(field_access_node(method), src.line, src.col)
    fa.add_child(own type_id)
    call.add_child(own fa)
    return call
}

// The monomorphized container is keyed the way every other position names
// it (resolve_type_alias_for_name, same rule as the type-gen macro's
// init_type_arg_name): user aliases resolve to their target, width aliases
// (USize/UPtr) keep their spelling -- a `..USize` param types as
// Array__USize, and that IS the generated instance's name.
variadic_array_type_name := func(scope: TypeScope, elem_type: Str) returns Str {
    if scope.get_struct("Array").is_some() { return "Array" }
    return format("Array__", resolve_type_alias_for_name(scope, elem_type))
}

// #342: the inverse of variadic_array_type_name -- the element spelling of a
// monomorphized Array instance ("Array__Str" -> "Str"). What a `..` splat
// contributes to the variadic run is the array's ELEMENTS, so both readers
// want this: type-argument deduction takes its evidence from it, and the
// argument check compares it against the parameter's type. Returns "" when the
// name is not an Array instance to decompose (the generic `Array` in scope, a
// Vec, or any other type), which leaves each caller on what it had -- for
// deduction the evidence it already held, for the check a spelling that cannot
// match and so reports.
priv array_instance_elem_type_name := func(container_name: Str) returns Str {
    prefix := "Array__"
    if container_name.starts_with(prefix).not() { return "" }
    if container_name.len() <= prefix.len() { return "" }
    return container_name.substr(prefix.len(), container_name.len().sub(prefix.len()))
}

// #342: the same for a Vec instance, used only to tell a Vec splat apart in a
// diagnostic. A Vec cannot BE a splat source -- the lowering folds the block
// with Array.concat, whose parameters are Arrays -- but it used to reach the
// fold untyped, so the interpreter ran it on the layout coincidence that a
// Vec's data pointer and count sit where an Array's data and cap do, while the
// C backend rejected the same program outright. One diagnostic replaces that
// disagreement.
priv vec_instance_elem_type_name := func(container_name: Str) returns Str {
    prefix := "Vec__"
    if container_name.starts_with(prefix).not() { return "" }
    if container_name.len() <= prefix.len() { return "" }
    return container_name.substr(prefix.len(), container_name.len().sub(prefix.len()))
}

priv variadic_vec_type_name := func(scope: TypeScope, elem_type: Str) returns Str {
    if scope.get_struct("Vec").is_some() { return "Vec" }
    return format("Vec__", resolve_type_alias_for_name(scope, elem_type))
}

// True when `expr` is a syntactic enum-variant construction that supplies a
// payload, e.g. NodeType.Literal(Literal.SetLit). Bare variants (a plain
// FieldAccess like NodeType.Literal) and ordinary calls returning an enum are
// not matched. Used to reject such arguments to is(), which compares only the
// outer tag and so ignores the payload entirely.
priv is_enum_variant_ctor_with_payload := func(expr: Expr, scope: TypeScope) returns Bool {
    if expr.node_type.is(NodeType.FCall).not() { return false }
    // callee + at least one payload argument
    if expr.children.len() < 2 { return false }
    ref callee : Expr = expr.children[0]
    if callee.node_type.is(NodeType.FieldAccess).not() { return false }
    if callee.children.len() == 0 { return false }
    mut variant := ""
    switch callee.node_type {
    case .FieldAccess(fad): variant = Str.clone(fad.field_access_name())
    case: return false
    }
    ref base : Expr = callee.children[0]
    mut tn := ""
    switch base.node_type {
    case .Ident(idd): tn = Str.clone(idd.ident_name())
    case: return false
    }
    sdef_o := scope.get_struct(tn)
    if sdef_o.is_none() { return false }
    ref sdef : Expr = sdef_o.unwrap()
    if sdef.node_type.is(NodeType.EnumDef).not() { return false }
    fd_o := def_ns_get(sdef, variant)
    if fd_o.is_none() { return false }
    ref fd : Declaration = fd_o.unwrap()
    if fd.default_value.is_none() { return false }
    switch fd.default_expr().node_type {
    case .FuncDef(vfd):
        return vfd.is_enum_variant_ctor
    case: return false
    }
    return false
}

// #321 step 3: is_null is the Dynamic quarantine's raw-pointer probe. On
// a typed value it asks reference-nullability, which the type system now
// answers with Option(ref T) -- and after the field/param/return
// migrations nothing typed legitimately holds null, so the question is
// either dead or hiding a bug. Deliberately-raw checks launder through
// to_ptr: a custom delete probing its own possibly-drained storage (the
// #302 drain contract zeroes moved-out slots) spells it
// `to_ptr(self).is_null()`, which makes the quarantine explicit and
// greppable instead of an invisible exemption here.
// The types where null is a LEGAL value -- the quarantine's spellings:
// Dynamic (the type-erased raw pointer), U8 (the raw-buffer label, the
// Vec.data `own data : U8 = 0` form where integer zero is a legal
// lazily-absent state) and I8 (the C-string pointer, Str.c_str). Both
// the is_null read rule (step 3) and the null literal write rule
// (step 4) gate on this set.
priv type_is_null_quarantine := func(shallow t: Type) returns Bool {
    if t.is(Type.Dynamic) { return true }
    switch t {
    case .Primitive(Primitive.U8): return true
    case .Primitive(Primitive.I8): return true
    case: return false
    }
}

// #321 keyword removal: the source spelling of the Dynamic null is the
// integer literal 0 in VALUE positions -- decl inits, field defaults,
// assignments, ctor field args and returns, where a Dynamic slot IS a
// word and the 0 word is null. The typer rewrites those into the
// internal Literal.Null node, so both backends keep the null-pointer
// emission the NULL keyword used to select. CALL-ARGUMENT positions do
// NOT rewrite: at a Dynamic parameter the number zero (a boxed scalar,
// DynSet.has(0)) and the null pointer are different values, so null
// arguments spell to_ptr(0) -- the 0 boxes into to_ptr's param and
// derefs back out as the null word in both backends. U8/I8-typed 0
// stays an ordinary integer everywhere (raw slots use to_ptr(0) too).
// `owned` widens the rule from Dynamic to the whole null quarantine
// (Dynamic / U8 / I8). An OWN slot of a raw-buffer type holds a
// POINTER, so its `= 0` is the lazily-absent state this file's
// quarantine comment already names by example (`own data : U8 = 0`).
// Without it the zero was an ordinary byte: every empty container
// constructor hoisted it into a one-byte heap box that the first grow
// immediately threw away -- 663K of them per test/first_class.til
// translate. A NON-own `b : U8 = 0` field keeps meaning the number 0.
priv rewrite_zero_to_null := func(mut e: Expr, shallow target: Type, owned: Bool) {
    mut null_slot := target.is(Type.Dynamic)
    if null_slot.not().and(owned) { null_slot = type_is_null_quarantine(target) }
    if null_slot.not() { return }
    mut is_zero := false
    switch e.node_type {
    case .Literal(Literal.Num(zn)):
        if zn.literal_num_text().eq("0") { is_zero = true }
    case:
    }
    if is_zero {
        e.node_type = NodeType.Literal(Literal.Null)
        e.set_til_type(Type.Dynamic)
    }
}

priv check_is_null_arg_dynamic := proc(mut scope: TypeScope, e: Expr, mut ctx: Context) {
    if e.children.len() < 2 { return }
    ref arg : Expr = e.children[1]
    mut t := arg.til_type().clone()
    switch t {
    case .Custom(ind_cn): t = type_from_name(ind_cn, scope, ctx)
    case:
    }
    if type_is_null_quarantine(t) { return }
    arg.type_error("is_null on a typed value; only raw pointers (Dynamic / the U8-I8 buffer labels) can be null (#321) -- switch on the Option instead, or to_ptr(x) for a deliberate raw-address probe", ctx)
}

// #321/#147: `return E.Variant(x)` where the variant's payload is a BORROW
// (`ref` payload) stores x's ADDRESS inside the returned enum value. When x
// is a LOCAL this function owns, that storage dies with the frame -- and
// unlike `return x` from a `returns ref` function, which gcc catches with
// -Werror=return-local-addr, the escaping address hides inside a struct, so
// the caller silently reads garbage instead of crashing. Reject it here.
//
// What stays legal, and why:
//   - params: an Option(ref)-returning function's aggregate params are kept
//     by-pointer exactly so their borrows point at caller-owned data
//     (fdef_return_carries_borrow and its regression test);
//   - ref bindings and aliases: they borrow storage this frame does not
//     own -- the same trust `returns ref` extends today. til has no origin
//     checker; #147 tracks that general problem.
// Only an OWNED local is certain to dangle, and that is what this flags.
priv check_enum_borrow_of_local_return := proc(scope: TypeScope, stmt: Expr, mut ctx: Context) {
    ref ret_val : Expr = stmt.children[0]
    if is_enum_variant_ctor_with_payload(ret_val, scope).not() { return }
    ref ebl_callee : Expr = ret_val.children[0]
    mut variant := ""
    switch ebl_callee.node_type {
    case .FieldAccess(fad): variant = Str.clone(fad.field_access_name())
    case: return
    }
    ref ebl_base : Expr = ebl_callee.children[0]
    mut tn := ""
    switch ebl_base.node_type {
    case .Ident(idd): tn = Str.clone(idd.ident_name())
    case: return
    }
    // is_enum_variant_ctor_with_payload resolved this def a moment ago.
    ref sdef : Expr = scope.get_struct(tn).unwrap()
    vt_idx := enum_variant_index(sdef, variant)
    if vt_idx < 0 { return }
    if enum_variant_payload_ref(sdef, vt_idx).not() { return }
    switch ret_val.children[1].node_type {
    case .Ident(an):
        sf := scope.find(an.ident_name())
        switch sf {
        case .Found(b):
            if and(b.own_type.is(OwnType.Ref).not(), b.is_param.not(), b.is_alias.not(), b.is_builtin.not()) {
                stmt.type_error(format("cannot return a borrow of local '", an.ident_name(), "' inside '", tn, "': the local dies with this call; borrow a param instead, or make the payload owned"), ctx)
            }
        case:
        }
    case:
    }
}

// The binding an argument expression ADDRESSES, or NULL. Sees through
// to_ptr(x), which re-types an address without changing it: a ctor arg
// `Str(c_str = to_ptr(buf), ...)` transfers buf exactly as
// `Str(c_str = buf, ...)` does. Matching only a bare Ident missed that,
// so the pass kept ownership of buf and scheduled a free while the
// constructed value still pointed at the block.
arg_addressed_ident := func(arg: Expr) returns Option(ref Str) {
    switch arg.node_type {
    case .Ident(ai): return Option(ref Str).Some(ai.ident_name())
    case .FCall:
        if arg.children.len() == 2 {
            switch arg.children[0].node_type {
            case .Ident(cn):
                if cn.ident_name() == "to_ptr" {
                    switch arg.children[1].node_type {
                    case .Ident(inner): return Option(ref Str).Some(inner.ident_name())
                    case: return Option(ref Str).None
                    }
                }
                return Option(ref Str).None
            case: return Option(ref Str).None
            }
        }
        return Option(ref Str).None
    case: return Option(ref Str).None
    }
}

priv check_own_args := func(fdef: Expr, fcall: Expr, var_name: Str) returns Bool {
    switch fdef.node_type {
    case .FuncDef(fd):
        if fd.params.len() == 0 { return false }
        for i in 0..fd.params.len() {
            if i + 1 >= fcall.children.len() { return false }
            ref p : Declaration = fd.params[i]
            if p.own_type.is(OwnType.Own) {
                ref arg : Expr = fcall.children[i + 1]
                an_o := arg_addressed_ident(arg)
                if an_o.is_some().and(an_o.unwrap() == var_name) { return true }
            }
        }
        return false
    case:
        return false
    }
}

priv fcall_has_own_arg := func(fcall: Expr, var_name: Str, scope: TypeScope) returns Bool {
    if fcall.node_type.is(NodeType.FCall).not() { return false }
    if fcall.children.len() < 2 { return false }
    // Struct constructor
    fcall_sname_o := expr_type_name_ref(fcall)
    if fcall_sname_o.is_some() {
        ref fcall_sname : Str = fcall_sname_o.unwrap()
        switch fcall.children[0].node_type {
        case .Ident(c0s):
            if c0s.ident_name() == fcall_sname {
                sdef_o := scope.get_struct(fcall_sname)
                if sdef_o.is_some() {
                    ref sdef : Expr = sdef_o.unwrap()
                    switch sdef.node_type {
                    case .StructDef(fhoa_sdd):
                        // Ctor args are NamedArg-wrapped (`Type(field =
                        // val)`), so unwrap the value and resolve the
                        // receiving field BY NAME, with the positional
                        // index as the bare-arg fallback -- the same
                        // mapping transfer_is_shallow_field_value_copy
                        // uses. The old loop zipped fields against raw
                        // children positionally: arg_addressed_ident hit
                        // the NamedArg wrapper, never the value, so no
                        // kwargs ctor ever registered a transfer -- and
                        // an adopt like `Str(c_str = to_ptr(buf), ...)`
                        // kept buf's cleanup scheduled while the Str
                        // pointed at the block (ASAN double-free,
                        // fixture shape 15).
                        for ci in 1..fcall.children.len() {
                            ref arg : Expr = fcall.children[ci]
                            ref inner : Expr = named_arg_inner(arg)
                            an_o := arg_addressed_ident(inner)
                            if an_o.is_none() { continue }
                            if an_o.unwrap().eq(var_name).not() { continue }
                            mut fd_idx : I32 = ci.sub(1).to_i32()
                            switch arg.node_type {
                            case .NamedArg(fhoa_nan):
                                fd_idx = -1
                                if fhoa_sdd.fields_index.has(fhoa_nan) { fd_idx = fhoa_sdd.fields_index[fhoa_nan].to_i32() }
                            case:
                            }
                            if fd_idx < 0 { continue }
                            if fd_idx.to_usize() >= fhoa_sdd.fields.len() { continue }
                            ref fld_decl : Declaration = fhoa_sdd.field_at(fd_idx.to_usize())
                            if fld_decl.own_type.is(OwnType.Ref) { continue }
                            if fld_decl.own_type.is(OwnType.Own).or(type_ctor_consumes(fld_decl.til_type)) {
                                return true
                            }
                        }
                    case:
                    }
                }
            }
        case:
        }
    }
    // Direct call
    switch fcall.children[0].node_type {
    case .Ident(fn_name):
        fb_fd_o := scope.lookup_func(fn_name.ident_name())
        if fb_fd_o.is_none() { return false }
        return check_own_args(fb_fd_o.unwrap(), fcall, var_name)
    case .FieldAccess(method):
        // Namespace method call
        if fa_is_ns(fcall.children[0], scope) {
            ref type_node : Expr = fcall.children[0].children[0]
            switch type_node.node_type {
            case .Ident(tn):
                sdef_o := scope.get_struct(tn.ident_name())
                if sdef_o.is_none() { return false }
                ref sdef : Expr = sdef_o.unwrap()
                fd_o := def_ns_get(sdef, method.field_access_name())
                if fd_o.is_some() {
                    ref fd : Declaration = fd_o.unwrap()
                    if fd.default_value.is_some().and(fd.default_expr().node_type.is(NodeType.FuncDef)) {
                        return check_own_args(fd.default_expr(), fcall, var_name)
                    }
                }
            case:
            }
        }
    case:
    }
    return false
}

expr_transfers_own := func(e: Expr, var_name: Str, scope: TypeScope, ctx: Context) returns Bool {
    switch e.node_type {
    case .FuncDef(fd):
        for cap : Declaration in fd.captures {
            if cap.name.eq(var_name).and(cap.own_type.is(OwnType.Own)) { return true }
        }
        return false
    case .CaptureBlock(cbd):
        // Issue #54: an `[own x]` block capture consumes x -- the block owns
        // it from here, so the enclosing scope stands down its delete and a
        // later use is a use-after-move error. Unlike a FuncDef the block is
        // INLINE code, so keep recursing into its body below for any further
        // transfers it performs.
        for cap : Declaration in cbd.captures {
            if cap.name.eq(var_name).and(cap.own_type.is(OwnType.Own)) { return true }
        }
    case .BodyValue(bvd):
        for cap : Declaration in bvd.captures {
            if cap.name.eq(var_name).and(cap.own_type.is(OwnType.Own)) { return true }
        }
        return false
    case .FCall(fcd):
        if fcd.swap_replace.and(e.children.len().gte(3)) {
            switch e.children[2].node_type {
            case .Ident(src):
                if src.ident_name() == var_name { return true }
            case:
            }
        }
    case:
    }
    if fcall_has_own_arg(e, var_name, scope) { return true }
    // FieldAssign is a transfer only when the receiving field is Own --
    // Ref fields take a borrow (caller keeps ownership), Shallow fields
    // value-copy (caller keeps too). The old check `not Shallow`
    // misclassified Ref-field assignments as transfers, so a local
    // assigned into a ref-typed field never got its scope-end delete.
    // (Issue #109: test/ref.til's `a.next = b` where `next` is `ref mut
    // next : RefNode` leaked b's 16-byte wrapper.)
    if e.node_type.is(NodeType.FieldAssign).and(e.fa_own_type(scope).is(OwnType.Own)) {
        if e.children.len() > 1 {
            switch e.children[1].node_type {
            case .Ident(ei):
                if ei.ident_name() == var_name { return true }
            case:
            }
        }
    }
    for e_i : Expr in e.children {
        if expr_transfers_own(e_i, var_name, scope, ctx) { return true }
    }
    return false
}

// --- Bitmask-building mirrors of the per-name scanners above (perf) ---
// The garbager's per-local loops asked expr_uses_var / expr_contains_decl
// / expr_used_in_nested_func / expr_transfers_own once per (statement,
// name): O(locals x stmts x subtree), the single largest cost in a
// self-translate profile. The mirrors record, in one walk, every name the
// predicate would answer true for, so those loops became bit probes.
// expr_collect_stmt_facts below is the single walk that fills all five
// fact rows; the helpers here are the pieces it does not inline (the
// param/capture-shadowing walk for nested uses, the own-arg scan, and the
// escapes-only descent it hands nested function bodies to). Each must
// stay in lockstep with its predicate above; the recursion cuts (FuncDef
// opacity) are identical.

// A fact row is a U64 bitmask over a per-body name->bit index (the
// probe universe: garbager.til's fact_universe -- this scope's bindings
// plus the body's top-level Assign targets, the only names any fact
// consumer ever queries). Recording a name costs at most one binary
// search of that index instead of a per-statement Set(Str) insert,
// names outside the universe are dropped at record time, and every
// consumer probe is a word AND instead of a string search. The rows
// replaced Set(Str) fields that stored borrowed Str views; now nothing
// is stored at all.

// The name->bit index plus a 64-bit membership fingerprint of its
// names. Most record-time lookups are for names OUTSIDE the universe
// (callee idents, outer-scope names): an unset fingerprint bit proves
// such a miss with one AND instead of a binary search. A set bit still
// searches, so the resolved bits are identical either way.
FactIndex := struct {
    filt : U64 = 0
    idx := Map(Str, USize).new()
}

// One binary search over the index Map's storage. Map.get throws on
// a miss, so going through it would need a has() probe first --
// doubling the searches on the collectors' hottest path.
fact_bit_search := func(idx: Map(Str, USize), name: Str) returns I64 {
    mut lo : USize = 0
    mut hi : USize = idx.keys.count
    while lo < hi {
        mid : USize = lo.add(hi.sub(lo) / 2)
        c : I64 = Str.cmp(idx.keys.unsafe_get(mid), name)
        if c < 0 { lo = mid + 1 }
        else {
            if c > 0 { hi = mid }
            else { return idx.values.unsafe_get(mid).to_i64() }
        }
    }
    return -1
}

fact_bit_of := func(fi: FactIndex, name: Str) returns I64 {
    if fi.filt.band(name_fingerprint(name)) == 0 { return -1 }
    return fact_bit_search(fi.idx, name)
}

// OR bit `bit` into the mask row starting at word `base`. The caller
// guarantees bit < 64 * row words (every bit comes from the index the
// row was sized for).
fact_bit_record := func(mut mask: Vec(U64), base: USize, bit: USize) {
    w := base.add(bit / 64)
    one : U64 = 1
    // Stored through a ref, not Vec.unsafe_set: the setter takes its
    // value OWNED, so every recorded bit went through a malloc'd U64
    // box that adopt then freed -- a malloc/free pair per name per
    // statement, to OR one word.
    ref mut slot : U64 = mask.unsafe_get(w)
    slot = slot.bor(one.shl(bit.mod(64).to_u64()))
}

// Record `name` in the mask row at `base`. A name outside the probe
// universe is never queried by any fact consumer, so it is dropped --
// that filter is what keeps rows one or two words wide.
fact_record_name := func(fi: FactIndex, name: Str, base: USize, mut mask: Vec(U64)) {
    bit := fact_bit_of(fi, name)
    if bit < 0 { return }
    fact_bit_record(mask, base, bit.to_usize())
}

// expr_used_in_nested_func's shadow rule, applied at add time so the
// FuncDef body's uses never need materializing separately.
priv nested_uses_add := func(name: Str, params: Vec(Declaration), caps: Vec(Declaration), fi: FactIndex, base: USize, mut out: Vec(U64)) {
    for p : Declaration in params { if p.name == name { return } }
    // A REF capture is a TRACKED borrow, not an opaque nested use: the
    // garbager's borrow-edge rule 2 already ties the captured local's
    // lifetime to the closure binding, so the scope-end delete lands after
    // the closure dies. Counting it as a nested use instead made
    // collect_scope_locals set skip_scope_delete and drop that delete
    // entirely, leaking whatever the captured local held. Own captures are
    // left alone: those are ownership transfers, tracked by
    // expr_transfers_own, and the closure's drop frees them.
    for c : Declaration in caps {
        if c.name == name { if c.own_type.is(OwnType.Ref) { return } }
    }
    fact_record_name(fi, name, base, out)
}

priv expr_collect_uses_excluding := func(e: Expr, params: Vec(Declaration), caps: Vec(Declaration), fi: FactIndex, base: USize, mut out: Vec(U64)) {
    if e.node_type.is(NodeType.FuncDef) { return }
    switch e.node_type {
    case .Ident(id):
        nested_uses_add(id.ident_name(), params, caps, fi, base, out)
    case .Assign(asgn):
        nested_uses_add(asgn.name, params, caps, fi, base, out)
    case:
    }
    for e_i : Expr in e.children { expr_collect_uses_excluding(e_i, params, caps, fi, base, out) }
}

// Names whose POINTER is stored into raw memory by write_ptr, the one
// primitive that hands a til pointer to storage the ownership passes
// cannot see. Such a local stays reachable through that storage after
// its last textual use, so its cleanup must stand down: the asap pass
// would otherwise free it at the last mention and every later read
// through the raw slot is a use-after-free (ASAN confirms;
// test/raw_escape.til pins it). Deferring or skipping a delete is always
// memory-safe -- the same bias the hoist-view taint rule takes.
expr_collect_ptr_escapes := func(e: Expr, fi: FactIndex, base: USize, mut out: Vec(U64)) {
    if e.node_type.is(NodeType.FCall).and(e.children.len() >= 3) {
        mut is_write_ptr := false
        switch e.children[0].node_type {
        case .Ident(cn): is_write_ptr = cn.ident_name() == "write_ptr"
        case .FieldAccess(cf): is_write_ptr = cf.field_access_name() == "write_ptr"
        case:
        }
        if is_write_ptr {
            switch e.children[2].node_type {
            case .Ident(vn):
                fact_record_name(fi, vn.ident_name(), base, out)
            case:
            }
        }
    }
    for e_i : Expr in e.children { expr_collect_ptr_escapes(e_i, fi, base, out) }
}

// Mirrors check_own_args: every arg name in an own param position.
priv collect_own_arg_names := func(fdef: Expr, fcall: Expr, fi: FactIndex, base: USize, mut out: Vec(U64)) {
    switch fdef.node_type {
    case .FuncDef(fd):
        if fd.params.len() == 0 { return }
        for i in 0..fd.params.len() {
            if i + 1 >= fcall.children.len() { return }
            ref p : Declaration = fd.params[i]
            if p.own_type.is(OwnType.Own) {
                ref arg : Expr = fcall.children[i + 1]
                an_o := arg_addressed_ident(arg)
                if an_o.is_some() {
                    ref an : Str = an_o.unwrap()
                    fact_record_name(fi, an, base, out)
                }
            }
        }
    case:
    }
}

// Mirrors fcall_has_own_arg: one signature/ctor-field derivation per call
// SITE (with its scope lookups) instead of one per (site, name) query.
priv fcall_collect_own_arg_names := func(fcall: Expr, scope: TypeScope, fi: FactIndex, base: USize, mut out: Vec(U64)) {
    if fcall.node_type.is(NodeType.FCall).not() { return }
    if fcall.children.len() < 2 { return }
    // Struct constructor
    fcall_sname_o := expr_type_name_ref(fcall)
    if fcall_sname_o.is_some() {
        ref fcall_sname : Str = fcall_sname_o.unwrap()
        switch fcall.children[0].node_type {
        case .Ident(c0s):
            if c0s.ident_name() == fcall_sname {
                sdef_o := scope.get_struct(fcall_sname)
                if sdef_o.is_some() {
                    ref sdef : Expr = sdef_o.unwrap()
                    switch sdef.node_type {
                    case .StructDef(fcoa_sdd):
                        // NamedArg-aware, by-name field mapping -- see
                        // fcall_has_own_arg's ctor branch for why the
                        // positional zip recorded nothing for kwargs
                        // ctors.
                        for ci in 1..fcall.children.len() {
                            ref arg : Expr = fcall.children[ci]
                            ref inner : Expr = named_arg_inner(arg)
                            an_o := arg_addressed_ident(inner)
                            if an_o.is_none() { continue }
                            mut fd_idx : I32 = ci.sub(1).to_i32()
                            switch arg.node_type {
                            case .NamedArg(fcoa_nan):
                                fd_idx = -1
                                if fcoa_sdd.fields_index.has(fcoa_nan) { fd_idx = fcoa_sdd.fields_index[fcoa_nan].to_i32() }
                            case:
                            }
                            if fd_idx < 0 { continue }
                            if fd_idx.to_usize() >= fcoa_sdd.fields.len() { continue }
                            ref fld_decl : Declaration = fcoa_sdd.field_at(fd_idx.to_usize())
                            if fld_decl.own_type.is(OwnType.Ref) { continue }
                            if fld_decl.own_type.is(OwnType.Own).or(type_ctor_consumes(fld_decl.til_type)) {
                                ref an : Str = an_o.unwrap()
                                fact_record_name(fi, an, base, out)
                            }
                        }
                    case:
                    }
                }
            }
        case:
        }
    }
    // Direct call
    switch fcall.children[0].node_type {
    case .Ident(fn_name):
        fb_fd_o := scope.lookup_func(fn_name.ident_name())
        if fb_fd_o.is_none() { return }
        collect_own_arg_names(fb_fd_o.unwrap(), fcall, fi, base, out)
        return
    case .FieldAccess(method):
        // Namespace method call
        if fa_is_ns(fcall.children[0], scope) {
            ref type_node : Expr = fcall.children[0].children[0]
            switch type_node.node_type {
            case .Ident(tn):
                ns_sdef_o := scope.get_struct(tn.ident_name())
                if ns_sdef_o.is_none() { return }
                ref ns_sdef : Expr = ns_sdef_o.unwrap()
                fd_o := def_ns_get(ns_sdef, method.field_access_name())
                if fd_o.is_some() {
                    ref fd : Declaration = fd_o.unwrap()
                    if fd.default_value.is_some().and(fd.default_expr().node_type.is(NodeType.FuncDef)) {
                        collect_own_arg_names(fd.default_expr(), fcall, fi, base, out)
                    }
                }
            case:
            }
        }
    case:
    }
}

// All five per-statement fact rows in ONE traversal. The collectors above
// each walked the whole statement subtree separately -- five passes over
// the same nodes, ~1.6M collector invocations per maps.til compile where
// one walk needs ~430K. Each row's rules are copied verbatim from its
// own collector above; keep them in lockstep the same way those stay in
// lockstep with their predicates.
//
// The cuts line up better than they look: uses, decls, nested and
// transfers all stop at a FuncDef (transfers after recording its own
// captures, nested after collecting the body's uses through the
// param/capture-shadowing walk), so the fused walk stops there once and
// hands the body to expr_collect_ptr_escapes -- the one row that does
// descend into nested function bodies. A BodyValue stops transfers only,
// which is what transfers_on carries down.
//
// want_transfers=false skips the transfer work entirely: it is the only
// part that consults scope (fcall_collect_own_arg_names, fa_own_type),
// and most callers do not ask for it.
// Name-fact collection records unconditionally: ORing an already-set bit
// is free, so no site carries a has-style dup guard.
expr_collect_stmt_facts := func(e: Expr, scope: TypeScope, want_transfers: Bool, transfers_on: Bool,
        fi: FactIndex, base: USize,
        mut uses: Vec(U64), mut decls: Vec(U64), mut nested: Vec(U64),
        mut escapes: Vec(U64), mut transfers: Vec(U64)) {
    // --- ptr escapes: every node, nested function bodies included ---
    if e.node_type.is(NodeType.FCall).and(e.children.len() >= 3) {
        mut is_write_ptr := false
        switch e.children[0].node_type {
        case .Ident(cn): is_write_ptr = cn.ident_name() == "write_ptr"
        case .FieldAccess(cf): is_write_ptr = cf.field_access_name() == "write_ptr"
        case:
        }
        if is_write_ptr {
            switch e.children[2].node_type {
            case .Ident(vn):
                fact_record_name(fi, vn.ident_name(), base, escapes)
            case:
            }
        }
    }

    mut sub_transfers_on := transfers_on
    switch e.node_type {
    case .FuncDef(fdef):
        // The shared cut. Record what each row takes from the def itself,
        // then leave the body to the escapes-only walk.
        if want_transfers.and(transfers_on) {
            for cap : Declaration in fdef.captures {
                if cap.own_type.is(OwnType.Own) { fact_record_name(fi, cap.name, base, transfers) }
            }
        }
        if e.children.len() > 0 {
            expr_collect_uses_excluding(e.children[0], fdef.params, fdef.captures, fi, base, nested)
        }
        for fd_c : Expr in e.children { expr_collect_ptr_escapes(fd_c, fi, base, escapes) }
        return
    case .BodyValue(bvd):
        if want_transfers.and(transfers_on) {
            for cap : Declaration in bvd.captures {
                if cap.own_type.is(OwnType.Own) { fact_record_name(fi, cap.name, base, transfers) }
            }
        }
        // expr_collect_transfers returns here; the other rows keep going,
        // so only the transfer collection stands down below this node.
        sub_transfers_on = false
    case .CaptureBlock(cbd):
        if want_transfers.and(transfers_on) {
            for cap : Declaration in cbd.captures {
                if cap.own_type.is(OwnType.Own) { fact_record_name(fi, cap.name, base, transfers) }
            }
        }
    case .Ident(id):
        fact_record_name(fi, id.ident_name(), base, uses)
    case .Assign(asgn):
        fact_record_name(fi, asgn.name, base, uses)
    case .Decl(dd):
        fact_record_name(fi, dd.name, base, decls)
    case .FCall(fcd):
        if want_transfers.and(transfers_on) {
            if fcd.swap_replace.and(e.children.len().gte(3)) {
                switch e.children[2].node_type {
                case .Ident(src):
                    fact_record_name(fi, src.ident_name(), base, transfers)
                case:
                }
            }
        }
    case:
    }

    if want_transfers.and(sub_transfers_on) {
        fcall_collect_own_arg_names(e, scope, fi, base, transfers)
        if e.node_type.is(NodeType.FieldAssign).and(e.fa_own_type(scope).is(OwnType.Own)) {
            if e.children.len() > 1 {
                switch e.children[1].node_type {
                case .Ident(ei):
                    fact_record_name(fi, ei.ident_name(), base, transfers)
                case:
                }
            }
        }
    }

    for e_i : Expr in e.children {
        expr_collect_stmt_facts(e_i, scope, want_transfers, sub_transfers_on, fi, base, uses, decls, nested, escapes, transfers)
    }
}

priv expr_is_borrow_source := func(e: Expr, scope: TypeScope) returns Bool {
    if e.node_type.is_literal_null() { return true }
    if e.node_type.is(NodeType.FCall).and(fcall_returns_ref(e, scope).neq(0)) { return true }
    switch e.node_type {
    case .Ident(id):
        sf := scope.find(id.ident_name())
        switch sf {
        case .Found(b):
            if b.own_type.is(OwnType.Ref).or(b.is_param) { return true }
            // Owned compound locals are pointers in C -- valid borrow source
            if is_aggregate(b.type) { return true }
        case:
        }
    case:
    }
    if e.node_type.is(NodeType.FieldAccess) {
        if fa_is_ns(e, scope) { return false }
        return expr_is_borrow_source(e.children[0], scope)
    }
    return false
}

priv expr_is_stable_field_base := func(e: Expr, scope: TypeScope) returns Bool {
    if expr_is_borrow_source(e, scope) { return true }
    switch e.node_type {
    case .Ident(id):
        sf := scope.find(id.ident_name())
        switch sf {
        case .Found(b):
            if scope.lookup_func(b.name).is_some() { return false }
            if scope.struct_def_of(b.name).is_some() { return false }
            return true
        case:
            return false
        }
    case:
    }
    if e.node_type.is(NodeType.FieldAccess) {
        if fa_is_ns(e, scope) { return false }
        return expr_is_stable_field_base(e.children[0], scope)
    }
    return false
}

priv expr_is_ref_decl_source := func(e: Expr, scope: TypeScope) returns Bool {
    if expr_is_borrow_source(e, scope) { return true }
    if e.node_type.is(NodeType.FieldAccess) {
        if fa_is_ns(e, scope) { return false }
        return expr_is_stable_field_base(e.children[0], scope)
    }
    return false
}

// --- #344: borrow provenance -------------------------------------------
//
// #164's write tracking is one bit per binding, flipped only by a write
// SPELLED on that binding. A write that goes through a borrow returned by
// a call -- `inner_of(o).n = 1`, or the `ref` an #253 payload accessor
// hands back -- credited nobody, so the honest `mut o` looked redundant
// and the only shape that compiled was the one the two backends disagree
// about. Two facts close that gap:
//
//   FunctionDef.ref_return_params: which PARAMETERS a function's returned
//   borrow can reach. Computed once per unit, before any body is typed,
//   so a call site can read it no matter where the callee is declared.
//
//   TypeBinding.borrow_roots: which caller storages a BINDING's value
//   borrows. Resolved by mapping the callee summary's parameter positions
//   onto the call's actual arguments.
//
// The write marker then credits the roots, not just the name that was
// written. Both facts only ever ADD credit: an unresolved callee, or a
// root whose scope the walk cannot reach, means "no roots", which is
// exactly the pre-#344 answer. The walks below carry no depth or
// iteration bounds: they recurse over expression and statement TREES,
// which are finite and acyclic, and the roots they record are flattened
// to terminals at declaration time over a graph that is a DAG by
// construction (a declaration's RHS can only name earlier bindings). A
// bound there would not prevent anything -- it would only drop roots
// past the limit, which is a loud false "redundant mut" on one side and
// a silently accepted laundered write on the other (#352).

// Bit `i` of a ref_return_params summary. A function with more than 64
// parameters gets no bit -- 0 is the conservative answer, and the bitmap
// keeps the same indexing as FCallData's own_args / ref_args.
priv summary_param_bit := func(i: USize) returns U64 {
    if i >= 64 { return 0 }
    one : U64 = 1
    return one.shl(i.to_u64())
}

// The FuncDef Expr a call site resolves to. Mirrors fcall_returns_ref's
// resolution for all three callee shapes the typer sees -- a plain name, a
// namespace-qualified `Type.method`, and a not-yet-rewritten UFCS
// `recv.method` -- but hands back the def, so its summary and parameter
// list are readable too.
priv fcall_callee_fdef := func(fcall: Expr, scope: TypeScope) returns Option(ref Expr) {
    if fcall.node_type.is(NodeType.FCall).not() { return Option(ref Expr).None }
    if fcall.children.len() == 0 { return Option(ref Expr).None }
    ref callee : Expr = fcall.children[0]
    switch callee.node_type {
    case .Ident(cn):
        cb_o := scope.get_binding(cn.ident_name())
        if cb_o.is_none() { return Option(ref Expr).None }
        ref cb : TypeBinding = cb_o.unwrap()
        return scope.lookup_func(cb.name)
    case .FieldAccess(cfa):
        if callee.children.len() == 0 { return Option(ref Expr).None }
        if fa_is_ns(callee, scope) {
            switch callee.children[0].node_type {
            case .Ident(cti):
                sdef_o := scope.get_struct(cti.ident_name())
                if sdef_o.is_none() { return Option(ref Expr).None }
                nd_o := def_ns_get(sdef_o.unwrap(), cfa.field_access_name())
                if nd_o.is_none() { return Option(ref Expr).None }
                ref nd : Declaration = nd_o.unwrap()
                if nd.default_value.is_none() { return Option(ref Expr).None }
                ref dv : Expr = nd.default_expr()
                if dv.node_type.is(NodeType.FuncDef) { return Option(ref Expr).Some(dv) }
                return Option(ref Expr).None
            case:
                return Option(ref Expr).None
            }
        }
        // UFCS before the rewrite: needs the receiver's type, so this only
        // resolves once the receiver has been inferred.
        rsname_o := expr_type_name_ref(callee.children[0])
        if rsname_o.is_none() { return Option(ref Expr).None }
        rsdef_o := scope.get_struct(rsname_o.unwrap())
        if rsdef_o.is_none() { return Option(ref Expr).None }
        return find_namespace_func(rsdef_o.unwrap(), cfa.field_access_name(), scope)
    case:
    }
    return Option(ref Expr).None
}

// The argument expression bound to callee parameter `pi` at this call
// site. Two layouts: with a plain or namespace-qualified callee (which is
// also what the UFCS rewrite produces) parameter i sits at children[i+1];
// before the rewrite, `recv.method(a)` keeps its receiver inside the
// callee node and it fills parameter 0.
priv fcall_arg_for_param := func(fcall: Expr, pi: USize, scope: TypeScope) returns Option(ref Expr) {
    if fcall.children.len() == 0 { return Option(ref Expr).None }
    ref callee : Expr = fcall.children[0]
    if callee.node_type.is(NodeType.FieldAccess).and(fa_is_ns(callee, scope).not()) {
        if callee.children.len() == 0 { return Option(ref Expr).None }
        if pi == 0 { return Option(ref Expr).Some(callee.children[0]) }
        if pi < fcall.children.len() { return Option(ref Expr).Some(fcall.children[pi]) }
        return Option(ref Expr).None
    }
    if pi + 1 < fcall.children.len() { return Option(ref Expr).Some(fcall.children[pi + 1]) }
    return Option(ref Expr).None
}

// Does this binding denote STORAGE a write could land in? Type names,
// function declarations and type aliases bind a name without binding a
// value, so a borrow that reaches one of them borrows nothing writable.
// #351: does a VALUE of this type carry a borrow -- a struct with a ref
// field (directly or through an inline/own field of a carrying type), or
// an enum with a ref payload? Such a value smuggles a pointer to storage
// it does not own, so writes reached through it must be credited to that
// storage. The visited set is real control flow, not a guard: the type
// graph has cycles through own/ref fields (a list node's next), and a
// type already being tested carries nothing new.
priv type_carries_borrow_v := func(scope: TypeScope, tname: Str, mut visited: Set(Str)) returns Bool {
    if tname.len() == 0 { return false }
    ref resolved : Str = resolve_type_alias(scope, tname)
    if visited.has(resolved) { return false }
    visited.add(own resolved.clone())
    tdef_o := scope.get_struct(resolved)
    if tdef_o.is_none() { return false }
    ref tdef : Expr = tdef_o.unwrap()
    switch tdef.node_type {
    case .StructDef(sdd):
        for fd : Declaration in sdd.fields {
            if fd.own_type.is(OwnType.Ref) { return true }
            if type_carries_borrow_v(scope, fd.explicit_type, visited) { return true }
        }
    case .EnumDef:
        if enum_has_ref_payload(tdef) { return true }
    case:
    }
    return false
}

priv type_carries_borrow := func(scope: TypeScope, tname: Str) returns Bool {
    mut visited := Set(Str).new()
    return type_carries_borrow_v(scope, tname, visited)
}

// The field Declaration a FieldAccess crosses, resolved from the base
// expression's type. None when the base type or the field is unknown --
// the conservative answer, which keeps the walk on the base binding.
priv fieldaccess_field_decl := func(scope: TypeScope, fa: Expr) returns Option(ref Declaration) {
    if fa.node_type.is(NodeType.FieldAccess).not() { return Option(ref Declaration).None }
    if fa.children.len() == 0 { return Option(ref Declaration).None }
    base_tn_o := expr_type_name_ref(fa.children[0])
    if base_tn_o.is_none() { return Option(ref Declaration).None }
    sdef_o := scope.get_struct(base_tn_o.unwrap())
    if sdef_o.is_none() { return Option(ref Declaration).None }
    switch sdef_o.unwrap().node_type {
    case .StructDef(sdd):
        switch fa.node_type {
        case .FieldAccess(fad):
            return member_get(sdd.fields_index, sdd.fields, fad.field_access_name())
        case:
        }
    case:
    }
    return Option(ref Declaration).None
}

// Does crossing this FieldAccess step OUT of the base's own storage, into
// something it merely borrows? Only a `ref` field does that. An owned or
// inline field is the base's own state -- writing it writes the base --
// even when its type carries borrows of its own further down; reaching
// those means crossing THEIR ref field, which the recursive walk sees at
// that step. Conflating the two credits every borrow a value contains to
// a write that never touched it.
priv fieldaccess_crosses_borrow := func(scope: TypeScope, fa: Expr) returns Bool {
    fd_o := fieldaccess_field_decl(scope, fa)
    if fd_o.is_none() { return false }
    ref fd : Declaration = fd_o.unwrap()
    return fd.own_type.is(OwnType.Ref)
}

// The struct definition a constructor call instantiates, or None when the
// callee is not a plain struct name.
priv fcall_struct_ctor_def := func(fcall: Expr, scope: TypeScope) returns Option(ref Expr) {
    if fcall.children.len() == 0 { return Option(ref Expr).None }
    switch fcall.children[0].node_type {
    case .Ident(cn):
        sdef_o := scope.get_struct(cn.ident_name())
        if sdef_o.is_none() { return Option(ref Expr).None }
        if sdef_o.unwrap().node_type.is(NodeType.StructDef) { return sdef_o }
    case:
    }
    return Option(ref Expr).None
}

// The field a constructor argument populates: by name for a NamedArg, by
// declaration order for a positional one.
// The NAME of the field a constructor argument populates. Stored member
// Declarations carry name == "" (the single copy lives in the index), so
// the name comes from the NamedArg or the position, not the decl.
priv ctor_arg_field_name := func(sdd_e: Expr, arg: Expr, pos: USize) returns Str {
    switch sdd_e.node_type {
    case .StructDef(sdd):
        switch arg.node_type {
        case .NamedArg(nm):
            return nm.clone()
        case:
        }
        if pos < sdd.fields.len() { return sdd.field_name_at(pos).clone() }
    case:
    }
    return ""
}

priv ctor_arg_field_decl := func(sdd_e: Expr, arg: Expr, pos: USize) returns Option(ref Declaration) {
    switch sdd_e.node_type {
    case .StructDef(sdd):
        switch arg.node_type {
        case .NamedArg(nm):
            return member_get(sdd.fields_index, sdd.fields, nm)
        case:
        }
        if pos < sdd.fields.len() { return Option(ref Declaration).Some(sdd.fields[pos]) }
    case:
    }
    return Option(ref Declaration).None
}

priv binding_is_storage := func(scope: TypeScope, b: TypeBinding) returns Bool {
    if b.is_builtin { return false }
    if b.is_type_alias { return false }
    if b.is_func_decl { return false }
    return scope.struct_def_of(b.name).is_none()
}

// The storage a compiler-created pointer operation borrows FROM.
//
// These four are bodyless `returns ref Dynamic` primitives whose whole
// definition is "hand back a pointer INTO argument 0": ptr_add walks
// inside a buffer, to_ptr addresses a value, deref loads through a slot,
// get_payload opens an enum's payload (the `case .V(p):` binding
// make_switch_case_condition emits, sometimes wrapped in a deref). They
// are the "unless their compiler-created operation explicitly preserves
// one" half of the raw-boundary rule -- without them every container
// element access bottoms out in ptr_add and NO write to a Vec or Map
// element could ever be credited to the container. What stays unchecked
// is a raw pointer arriving from OUTSIDE the typed world (a malloc'd
// buffer, an FFI handle, an integer): those root in whatever local holds
// them, and nothing is invented for them.
priv raw_borrow_source := func(rhs: Expr) returns Option(ref Expr) {
    if rhs.node_type.is(NodeType.FCall).not() { return Option(ref Expr).None }
    if rhs.children.len() < 2 { return Option(ref Expr).None }
    switch rhs.children[0].node_type {
    case .Ident(hid):
        ref hn : Str = hid.ident_name()
        if hn.eq("ptr_add").or(hn == "to_ptr").or(hn == "deref").or(hn == "get_payload") {
            return Option(ref Expr).Some(rhs.children[1])
        }
    case:
    }
    return Option(ref Expr).None
}

priv borrow_root_of_binding := func(b: TypeBinding) returns BorrowRoot {
    return BorrowRoot(name = b.name.clone(), path = b.path.clone(), line = b.line, col = b.col)
}

priv push_root_unique := func(mut out: Vec(BorrowRoot), r: BorrowRoot) {
    for have : BorrowRoot in out {
        if BorrowRoot.eq(have, r) { return }
    }
    out.push(own r.clone())
}

// Which storages does this expression's value borrow? The whole chain,
// not just its far end: a write through an alias writes the alias too, and
// the alias's own `mut` is what permits it. An alias forwards the roots it
// resolved at its own declaration, so the set is always flat -- a write
// never has to chase a second hop at marking time.
priv expr_borrow_roots := func(scope: TypeScope, e: Expr) returns Vec(BorrowRoot) {
    mut out := Vec(BorrowRoot).new()
    switch e.node_type {
    case .Ident(id):
        bo := scope.get_binding(id.ident_name())
        if bo.is_none() { return out }
        ref b : TypeBinding = bo.unwrap()
        if binding_is_storage(scope, b) { push_root_unique(out, borrow_root_of_binding(b)) }
        // #351: an owned binding's stored roots are CARRIED -- what its
        // value's ref fields point at -- not storage the binding aliases.
        // A ref binding's stored roots are the alias itself.
        if b.own_type.is(OwnType.Ref) {
            for r : BorrowRoot in b.borrow_roots { push_root_unique(out, r) }
        } else {
            for r : BorrowRoot in b.borrow_roots {
                mut cr := r.clone()
                cr.carried = true
                push_root_unique(out, cr)
            }
        }
    case .FieldAccess:
        if e.children.len() == 0 { return out }
        if fa_is_ns(e, scope) { return out }
        return expr_borrow_roots(scope, e.children[0])
    case .FCall:
        rso := raw_borrow_source(e)
        if rso.is_some() { return expr_borrow_roots(scope, rso.unwrap()) }
        fd_o := fcall_callee_fdef(e, scope)
        if fd_o.is_none() {
            // #351: a struct constructor whose argument populates a ref
            // field (or a borrow-carrying one) hands the borrow to the
            // built value; the result CARRIES the argument's roots.
            ctor_o := fcall_struct_ctor_def(e, scope)
            if ctor_o.is_some() {
                for ai in 1..e.children.len() {
                    ref arg : Expr = e.children[ai]
                    fld_o := ctor_arg_field_decl(ctor_o.unwrap(), arg, ai - 1)
                    if fld_o.is_none() { continue }
                    ref fld : Declaration = fld_o.unwrap()
                    mut crosses := fld.own_type.is(OwnType.Ref)
                    if crosses.not() { crosses = type_carries_borrow(scope, fld.explicit_type) }
                    if crosses.not() { continue }
                    // #355/#356: record the PATH the pointer sits
                    // behind. A ref field IS the last segment: what it
                    // points at is reached by crossing it, and anything
                    // the pointee itself carries extends the path. An
                    // owned field that merely carries prefixes its own
                    // name onto the argument's paths -- and contributes
                    // nothing tagged when the argument's depth is
                    // unknown, since the pointer is not behind the owned
                    // field alone.
                    fname_356 := ctor_arg_field_name(ctor_o.unwrap(), arg, ai - 1)
                    fld_is_ref := fld.own_type.is(OwnType.Ref)
                    mut sub := Vec(BorrowRoot).new()
                    switch arg.node_type {
                    case .NamedArg:
                        if arg.children.len() > 0 { sub = expr_borrow_roots(scope, arg.children[0]) }
                    case:
                        sub = expr_borrow_roots(scope, e.children[ai])
                    }
                    for r : BorrowRoot in sub {
                        mut cr := r.clone()
                        cr.carried = true
                        if fname_356.len() == 0 {
                            cr.field = ""
                        } else if fld_is_ref {
                            if r.carried.and(r.field.len().gt(0)) {
                                cr.field = format(fname_356, ".", r.field)
                            } else {
                                cr.field = fname_356.clone()
                            }
                        } else if r.field.len() > 0 {
                            cr.field = format(fname_356, ".", r.field)
                        } else {
                            cr.field = ""
                        }
                        push_root_unique(out, cr)
                    }
                }
            }
            return out
        }
        switch fd_o.unwrap().node_type {
        case .FuncDef(cfd):
            for pi in 0..cfd.params.len() {
                pb := summary_param_bit(pi)
                mut relevant := cfd.ref_return_params.band(pb)
                relevant = relevant.bor(cfd.ref_return_into_params.band(pb))
                relevant = relevant.bor(cfd.ref_return_carried_params.band(pb))
                if relevant == 0 { continue }
                arg_o := fcall_arg_for_param(e, pi, scope)
                if arg_o.is_none() { continue }
                // #354: each relation maps to what it actually reaches.
                // alias: the return IS (part of) the argument's value --
                // its full roots. into: the return carries a pointer INTO
                // the argument's own storage -- the lvalue roots. carried:
                // the return reaches only what the argument carries.
                if cfd.ref_return_params.band(pb) != 0 {
                    sub := expr_borrow_roots(scope, arg_o.unwrap())
                    for r : BorrowRoot in sub { push_root_unique(out, r) }
                }
                if cfd.ref_return_into_params.band(pb) != 0 {
                    sub := lvalue_write_roots(scope, arg_o.unwrap())
                    for r : BorrowRoot in sub {
                        mut cr := r.clone()
                        cr.carried = true
                        push_root_unique(out, cr)
                    }
                }
                if cfd.ref_return_carried_params.band(pb) != 0 {
                    subc := carried_roots_of(scope, expr_borrow_roots(scope, arg_o.unwrap()), "")
                    for r : BorrowRoot in subc { push_root_unique(out, r) }
                }
            }
        case:
        }
    case:
    }
    return out
}

// #351: the storages WRITING this lvalue can touch, which is narrower
// than what its value can reach. Writing an owned field stays on the
// base binding; writing through a ref field (or a field whose type
// carries a borrow) lands in the storage the borrow points at -- the
// base's carried roots -- and does not write the base itself.
priv lvalue_write_roots := func(scope: TypeScope, obj: Expr) returns Vec(BorrowRoot) {
    mut out := Vec(BorrowRoot).new()
    switch obj.node_type {
    case .Ident(id):
        bo := scope.get_binding(id.ident_name())
        if bo.is_none() { return out }
        ref b : TypeBinding = bo.unwrap()
        if binding_is_storage(scope, b) { push_root_unique(out, borrow_root_of_binding(b)) }
        // A ref binding IS a window onto its roots: writing through it
        // writes them. An owned binding's carried roots are only reached
        // by crossing a ref field, handled at the FieldAccess arm.
        if b.own_type.is(OwnType.Ref) {
            for r : BorrowRoot in b.borrow_roots { push_root_unique(out, r) }
        }
    case .FieldAccess:
        if obj.children.len() == 0 { return out }
        if fa_is_ns(obj, scope) { return out }
        if fieldaccess_crosses_borrow(scope, obj) {
            // The write lands in whatever the borrow points at: the
            // roots THIS field carries (#355) -- plus every untagged one.
            return carried_roots_of(scope, expr_borrow_roots(scope, obj.children[0]),
                fieldaccess_path(obj))
        }
        return lvalue_write_roots(scope, obj.children[0])
    case .FCall:
        // A compiler-created pointer op returns a pointer INTO argument 0,
        // so writing through it writes whatever writing argument 0 writes
        // -- keep the field-aware walk across that hop instead of falling
        // back to the whole VALUE's roots, which would credit every borrow
        // the value carries no matter which field the pointer came from.
        rso := raw_borrow_source(obj)
        if rso.is_some() { return lvalue_write_roots(scope, rso.unwrap()) }
        return expr_borrow_roots(scope, obj)
    case:
    }
    return out
}

// The binding a root names, matched by DECLARATION SITE and not just by
// spelling: a nested block that rebinds the name is different storage, and
// crediting it would leave the real root looking unwritten. A root the
// walk cannot reach is left uncredited -- #164's diagnostics are
// deliberately conservative on the write side.
priv lookup_binding_at := func(scope: TypeScope, r: BorrowRoot) returns Option(ref TypeBinding) {
    if scope.bindings.has(r.name) {
        ref b : TypeBinding = scope.bindings[r.name]
        if b.line.eq(r.line).and(b.col == r.col).and(b.path == r.path) {
            return Option(ref TypeBinding).Some(b)
        }
    }
    switch scope.parent {
    case .Some(p): return lookup_binding_at(p, r)
    case .None: return Option(ref TypeBinding).None
    }
}

priv mark_roots_written := func(scope: TypeScope, roots: Vec(BorrowRoot)) {
    for r : BorrowRoot in roots {
        mut rb_o := lookup_binding_at(scope, r)
        if rb_o.is_none() { continue }
        ref mut rb : TypeBinding = rb_o.unwrap()
        rb.written = true
    }
}

// #344 step B: is this root storage the writer is allowed to change?
//
//   mut   -- the whole point of the keyword.
//   own   -- the callee took ownership; writing what you own is not
//            writing through someone else's borrow.
//   ref   -- a plain `ref` borrow is read-only and a `ref mut` one is not;
//            is_mut already carries that distinction.
//
// A global (module-scope or namespace decl) is exempt, on the same
// reasoning #164's redundant-`mut` check exempts them: a write may live in
// a downstream importer this build never loads, so a per-build verdict
// would depend on which files happened to be compiled.
priv root_is_writable := func(scope: TypeScope, b: TypeBinding, r: BorrowRoot) returns Bool {
    if b.is_mut { return true }
    if b.own_type.is(OwnType.Own) { return true }
    ref root : TypeScope = scope_root_ref(scope)
    if root.bindings.has(r.name).not() { return false }
    ref gb : TypeBinding = root.bindings[r.name]
    return gb.line.eq(r.line).and(gb.col == r.col).and(gb.path == r.path)
}

// A root the author cannot put `mut` on: a `case V(p):` payload binding,
// whose mutability the language INHERITS from the scrutinee (doc/enums.org
// "Payload mutability"), and the typer's own temps. Judging those on their
// own absent qualifier would demand a keyword there is no place to write.
// The scrutinee they alias is in the same root set and IS judged, so the
// real question still gets asked -- one hop further up.
priv root_carries_own_qualifier := func(b: TypeBinding, r: BorrowRoot) returns Bool {
    if b.is_alias { return false }
    if r.name.len() == 0 { return false }
    if r.name.starts_with("_") { return false }
    if r.name.starts_with("hoisted__") { return false }
    return true
}

// #344 step B: reject a write whose storage the writer may not change.
// `obj` is what is being written, `site` where to report, `what` the
// caller's description of the attempt. Every root the write reaches must
// be writable -- including the ones reached THROUGH a borrow, which is the
// hole this issue is about: `inner_of(o).n = 1` writes `o`, and a plain
// `o` parameter is a read-only borrow of the caller's storage.
//
// Deliberately NOT wired to the conservative `Dynamic` argument lint:
// handing a raw pointer to a callee is a guess about what the callee does
// with it, and a guess must not produce a rejection.
priv check_write_roots_mut := proc(scope: TypeScope, site: Expr, obj: Expr, what: Str, mut ctx: Context) {
    // Typer-emitted bodies (clone / delete / size / enum to_str / ...) have
    // signatures the user cannot edit, so a diagnostic on them is not
    // actionable -- the same carve-out check_unused_mut_params makes.
    if ctx.auto_gen_depth > 0 { return }
    roots := lvalue_write_roots(scope, obj)
    mut reported := Vec(BorrowRoot).new()
    for r : BorrowRoot in roots {
        // #355: eq now separates same-site roots tagged with different
        // fields; one storage still gets one diagnostic.
        mut seen := false
        for pr : BorrowRoot in reported {
            if pr.line.eq(r.line).and(pr.col == r.col).and(pr.name == r.name).and(pr.path == r.path) { seen = true }
        }
        if seen { continue }
        rb_o := lookup_binding_at(scope, r)
        if rb_o.is_none() { continue }
        ref rb : TypeBinding = rb_o.unwrap()
        if root_carries_own_qualifier(rb, r).not() { continue }
        if root_is_writable(scope, rb, r) { continue }
        site.type_error(format("cannot ", what, ": '", r.name,
            "' is an immutable binding; declare it 'mut'"), ctx)
        println(r.path, ":", r.line.to_str(), ":", r.col.to_str(),
            ": note: '", r.name, "' declared here")
        reported.push(own r.clone())
    }
}

priv mark_name_written := func(mut scope: TypeScope, name: Str) {
    mut bo := scope.get_binding(name)
    if bo.is_none() { return }
    ref mut b : TypeBinding = bo.unwrap()
    b.written = true
    if b.borrow_roots.len() > 0 { mark_roots_written(scope, b.borrow_roots) }
}

// #344: the one write-credit walker. `obj` is the storage an assignment or
// a `mut` argument writes to; walk it down to the binding the write lands
// in, mark that binding written, and credit every terminal storage that
// binding borrows -- so a write laundered through an accessor's returned
// `ref` reaches the parameter it came from.
//
// Crediting is all this does. The `Dynamic` argument lint routes through
// here too, and its guess about what a callee does with a raw pointer is
// deliberately generous on the write side; it is NOT proof of a typed
// mutable borrow, so a rejection must never be derived from it.
priv mark_written_through := func(mut scope: TypeScope, obj: Expr) {
    switch obj.node_type {
    case .Ident(root_id):
        mark_name_written(scope, root_id.ident_name())
    case .FieldAccess:
        if obj.children.len() > 0 { mark_written_through(scope, obj.children[0]) }
    case .FCall:
        // `inner_of(o).n = 1`, `adopt(T, self.unsafe_get(i), own v)`: no
        // binding is involved at all, so the callee summary is the only
        // record of where the write lands.
        mark_roots_written(scope, expr_borrow_roots(scope, obj))
    case:
    }
}

// --- #344: the per-unit return-borrow summary pass ---------------------

// `case .Variant(p):` binds p to the scrutinee's payload, which is the
// same storage the scrutinee names. Pattern shape mirrors
// collect_one_case_binding's: FCall(FieldAccess(variant), Ident(binding)).
// #354: the three relations a summarized value can have to a parameter,
// tracked separately so the call site can map each to what it actually
// reaches. alias: the value IS (part of) the parameter's storage. into:
// the value carries a pointer INTO the parameter's storage. carried: the
// value carries pointers to what the parameter itself carries.
RootBits := struct {
    alias : U64 = 0
    into : U64 = 0
    carried : U64 = 0
namespace:
    eq := func(a: RootBits, b: RootBits) returns Bool {
        return a.alias.eq(b.alias).and(a.into == b.into).and(a.carried == b.carried)
    }
    to_str := func(_self: RootBits) returns Str { return "RootBits" }
    bor := func(self: RootBits, other: RootBits) returns RootBits {
        return RootBits(alias = self.alias.bor(other.alias),
            into = self.into.bor(other.into),
            carried = self.carried.bor(other.carried))
    }
    all := func(self: RootBits) returns U64 {
        return self.alias.bor(self.into).bor(self.carried)
    }
    is_zero := func(self: RootBits) returns Bool { return self.all() == 0 }
}

// #354: reduce a value's roots to the storages IT CARRIES: keep roots
// already marked carried, and for a directly-rooted binding chase what
// that binding's own value carries. Shared by the lvalue walk's ref-field
// crossing and the carried-bit call mapping -- both ask the same
// question, "where do this value's smuggled pointers point?".
// #356: do a root's recorded field path and the path the write actually
// crossed describe the same pointer? Either side being unknown answers
// yes (conservative). Otherwise one must be a SUFFIX of the other on a
// segment boundary: a write reached through a binding that lost the
// outer segments crosses "r" where the root records "h.r", and both name
// the same field of the same holder.
priv field_path_matches := func(tag: Str, crossed: Str) returns Bool {
    if tag.len() == 0 { return true }
    if crossed.len() == 0 { return true }
    if tag == crossed { return true }
    if tag.ends_with(format(".", crossed)) { return true }
    return crossed.ends_with(format(".", tag))
}

// The dotted field path a FieldAccess chain crosses, from its base
// binding: `o.h.r` -> "h.r". Namespace accesses cross no storage.
priv fieldaccess_path := func(fa: Expr) returns Str {
    if fa.node_type.is(NodeType.FieldAccess).not() { return "" }
    if fa.children.len() == 0 { return "" }
    mut own_name := ""
    switch fa.node_type {
    case .FieldAccess(fad): own_name = Str.clone(fad.field_access_name())
    case:
    }
    base := fieldaccess_path(fa.children[0])
    if base.len() == 0 { return own_name }
    return format(base, ".", own_name)
}

// crossed filters to the roots that specific field path carries; "" keeps
// them all. An untagged root always passes -- unknown provenance stays
// conservative.
priv carried_roots_of := func(scope: TypeScope, roots: Vec(BorrowRoot), fname: Str) returns Vec(BorrowRoot) {
    mut out := Vec(BorrowRoot).new()
    for r : BorrowRoot in roots {
        if r.carried {
            if field_path_matches(r.field, fname).not() { continue }
            push_root_unique(out, r)
        } else {
            br_o := lookup_binding_at(scope, r)
            if br_o.is_none() { continue }
            ref brb : TypeBinding = br_o.unwrap()
            for cr : BorrowRoot in brb.borrow_roots {
                if field_path_matches(cr.field, fname).not() { continue }
                mut ccr := cr.clone()
                ccr.carried = true
                push_root_unique(out, ccr)
            }
        }
    }
    return out
}

priv summary_bind_case := func(cn: Expr, subj: RootBits, mut roots: Map(Str, RootBits)) {
    if cn.node_type.is(NodeType.Case).not() { return }
    npat := case_pattern_count(cn)
    for pi in 0..npat {
        if pi >= cn.children.len() { return }
        ref pat : Expr = cn.children[pi]
        if pat.node_type.is(NodeType.FCall).not() { continue }
        if pat.children.len() != 2 { continue }
        if pat.children[0].node_type.is(NodeType.FieldAccess).not() { continue }
        switch pat.children[1].node_type {
        case .Ident(bid):
            // Unwrapping reaches the pointer the subject CARRIES: an
            // into-bit becomes a direct alias of that parameter's
            // storage; a carried-bit stays carried; an alias-bit is the
            // conservative pass-through (the payload lives inside the
            // parameter's own storage and its target is unknown).
            roots.set(bid.ident_name(), own RootBits(
                alias = subj.alias.bor(subj.into), carried = subj.carried))
        case:
        }
    }
}

// A generic spelling reduced to the def it instantiates: `Vec(V)` ->
// `Vec`. Summaries are PARAMETER-INDEXED, so a template and every
// instantiation of it answer identically -- which is exactly what makes
// the answer independent of when monomorphization happens.
priv summary_base_type_name := func(tn: Str) returns Str {
    at := tn.find("(")
    if at < 0 { return tn.clone() }
    return tn.substr(0, at.to_usize())
}

// The type name of a `self`-rooted receiver, read off DECLARATIONS rather
// than off inference -- this pass runs before anything is typed. `self` is
// the def being walked; `self.<field>` takes the field's declared type
// from that def, which is what lets a container method that delegates to
// its storage field (Map.get -> self.values.unsafe_get) be summarised.
priv summary_receiver_type := func(recv: Expr, scope: TypeScope, self_type: Str) returns Str {
    switch recv.node_type {
    case .Ident(rid):
        if rid.ident_name() == "self" { return self_type.clone() }
    case .FieldAccess(fad):
        if recv.children.len() == 0 { return "" }
        base := summary_receiver_type(recv.children[0], scope, self_type)
        if base.len() == 0 { return "" }
        bdef_o := scope.get_struct(base)
        if bdef_o.is_none() { return "" }
        switch bdef_o.unwrap().node_type {
        case .StructDef(bsd):
            fo := member_get(bsd.fields_index, bsd.fields, fad.field_access_name())
            if fo.is_none() { return "" }
            ref bfd : Declaration = fo.unwrap()
            return summary_base_type_name(bfd.explicit_type)
        case:
        }
    case:
    }
    return ""
}

// `self.helper(...)` / `self.field.helper(...)` inside a namespace method.
// This pass runs before a single body is typed, so the receiver carries no
// til_type and the ordinary UFCS resolution (which reads one) cannot fire
// -- but the type being walked IS known, and `self` is by construction an
// instance of it. Without this every `returns ref T` method that delegates
// (Vec.get -> Vec.unsafe_get, Map.get -> self.values.unsafe_get) would
// summarise as borrowing nothing, and no write to a container element
// could ever be credited to the container.
priv summary_self_method := func(e: Expr, scope: TypeScope, self_type: Str) returns Option(ref Expr) {
    if self_type.len() == 0 { return Option(ref Expr).None }
    ref callee : Expr = e.children[0]
    if callee.node_type.is(NodeType.FieldAccess).not() { return Option(ref Expr).None }
    if callee.children.len() == 0 { return Option(ref Expr).None }
    rtn := summary_receiver_type(callee.children[0], scope, self_type)
    if rtn.len() == 0 { return Option(ref Expr).None }
    sdef_o := scope.get_struct(rtn)
    if sdef_o.is_none() { return Option(ref Expr).None }
    switch callee.node_type {
    case .FieldAccess(cfa):
        return find_namespace_func(sdef_o.unwrap(), cfa.field_access_name(), scope)
    case:
    }
    return Option(ref Expr).None
}

// Which parameters does this expression's value borrow, in terms of the
// enclosing function's parameter bits? `roots` maps every name already
// known to carry a borrow (the parameters themselves, ref locals, switch
// payload bindings) to its bits.
// A constructor stores its borrow-feeding arguments' pointers in the
// built value: an argument that IS parameter storage (alias) becomes a
// pointer INTO that parameter; one that already carries pointers keeps
// carrying them.
priv summary_ctor_wrap := func(arg_bits: RootBits) returns RootBits {
    return RootBits(into = arg_bits.alias.bor(arg_bits.into), carried = arg_bits.carried)
}

priv summary_expr_bits := func(e: Expr, roots: Map(Str, RootBits), scope: TypeScope, self_type: Str) returns RootBits {
    switch e.node_type {
    case .Ident(id):
        if roots.has(id.ident_name()) {
            ref bits : RootBits = roots[id.ident_name()]
            return bits.clone()
        }
        return RootBits()
    case .FieldAccess:
        if e.children.len() == 0 { return RootBits() }
        if fa_is_ns(e, scope) { return RootBits() }
        base := summary_expr_bits(e.children[0], roots, scope, self_type)
        // #354: crossing a REF field steps out of the base's storage into
        // what it carries -- resolvable pre-typing only for self-rooted
        // chains; anywhere else the alias pass-through is the
        // conservative answer (over-credit, as before).
        btn := summary_receiver_type(e.children[0], scope, self_type)
        if btn.len() > 0 {
            bdef_o := scope.get_struct(btn)
            if bdef_o.is_some() {
                switch bdef_o.unwrap().node_type {
                case .StructDef(bsd):
                    switch e.node_type {
                    case .FieldAccess(fad):
                        fo := member_get(bsd.fields_index, bsd.fields, fad.field_access_name())
                        if fo.is_some() {
                            ref bfd : Declaration = fo.unwrap()
                            if bfd.own_type.is(OwnType.Ref) {
                                return RootBits(alias = base.into,
                                    carried = base.alias.bor(base.carried))
                            }
                        }
                    case:
                    }
                case:
                }
            }
        }
        return base
    case .FCall:
        rso := raw_borrow_source(e)
        if rso.is_some() { return summary_expr_bits(rso.unwrap(), roots, scope, self_type) }
        mut fd_o := fcall_callee_fdef(e, scope)
        if fd_o.is_none() { fd_o = summary_self_method(e, scope, self_type) }
        if fd_o.is_none() {
            // #351: a struct constructor carries the borrows of the
            // arguments feeding its ref (or borrow-carrying) fields, so
            // the built value reaches those parameters.
            mut cbits := RootBits()
            ctor_o := fcall_struct_ctor_def(e, scope)
            if ctor_o.is_some() {
                for ai in 1..e.children.len() {
                    ref arg : Expr = e.children[ai]
                    fld_o := ctor_arg_field_decl(ctor_o.unwrap(), arg, ai - 1)
                    if fld_o.is_none() { continue }
                    ref fld : Declaration = fld_o.unwrap()
                    mut crosses := fld.own_type.is(OwnType.Ref)
                    if crosses.not() { crosses = type_carries_borrow(scope, fld.explicit_type) }
                    if crosses.not() { continue }
                    switch arg.node_type {
                    case .NamedArg:
                        if arg.children.len() > 0 { cbits = cbits.bor(summary_ctor_wrap(summary_expr_bits(arg.children[0], roots, scope, self_type))) }
                    case:
                        cbits = cbits.bor(summary_ctor_wrap(summary_expr_bits(e.children[ai], roots, scope, self_type)))
                    }
                }
            }
            return cbits
        }
        mut bits := RootBits()
        switch fd_o.unwrap().node_type {
        case .FuncDef(cfd):
            // An enum constructor with a borrowed payload
            // (`Option(ref T).Some(x)`) hands the borrow straight through;
            // its auto-generated body has nothing to summarise.
            if cfd.is_enum_variant_ctor {
                edef_o := scope.get_struct(cfd.return_type)
                if edef_o.is_none() { return RootBits() }
                if enum_has_ref_payload(edef_o.unwrap()).not() { return RootBits() }
                for ai in 1..e.children.len() {
                    bits = bits.bor(summary_ctor_wrap(summary_expr_bits(e.children[ai], roots, scope, self_type)))
                }
                return bits
            }
            for pi in 0..cfd.params.len() {
                pb := summary_param_bit(pi)
                mut relevant := cfd.ref_return_params.band(pb)
                relevant = relevant.bor(cfd.ref_return_into_params.band(pb))
                relevant = relevant.bor(cfd.ref_return_carried_params.band(pb))
                if relevant == 0 { continue }
                arg_o := fcall_arg_for_param(e, pi, scope)
                if arg_o.is_none() { continue }
                ab := summary_expr_bits(arg_o.unwrap(), roots, scope, self_type)
                if cfd.ref_return_params.band(pb) != 0 { bits = bits.bor(ab) }
                if cfd.ref_return_into_params.band(pb) != 0 {
                    // The callee's return carries a pointer into the
                    // argument's own storage.
                    bits.into = bits.into.bor(ab.alias).bor(ab.into)
                    bits.carried = bits.carried.bor(ab.carried)
                }
                if cfd.ref_return_carried_params.band(pb) != 0 {
                    // The callee's return reaches what the argument
                    // carries: its into-pointers' targets, its carried
                    // set, and conservatively what its aliased params
                    // carry (settled by the chase at the real call site).
                    bits.into = bits.into.bor(ab.into)
                    bits.carried = bits.carried.bor(ab.carried).bor(ab.alias)
                }
            }
        case:
        }
        return bits
    case:
    }
    return RootBits()
}

// Walk one body, collecting the parameter bits every `return` can hand
// back. Nested FuncDefs are skipped: their returns belong to them.
priv summary_walk := func(e: Expr, mut roots: Map(Str, RootBits), scope: TypeScope, self_type: Str) returns RootBits {
    switch e.node_type {
    case .FuncDef:
        return RootBits()
    case .Return:
        if e.children.len() == 0 { return RootBits() }
        return summary_expr_bits(e.children[0], roots, scope, self_type)
    case .Decl(d):
        // Only a BORROW forwards roots. An owned intermediate inside a
        // summarized body deliberately does NOT -- propagating it would
        // grow summaries the committed boot cannot reproduce, forcing a
        // bootstrap ladder for credit no in-tree write needs. The cost is
        // under-crediting through such intermediates, the documented
        // conservative direction.
        if d.own_type.is(OwnType.Ref).and(e.children.len().gt(0)) {
            db := summary_expr_bits(e.children[0], roots, scope, self_type)
            if db.is_zero().not() { roots.set(d.name, own db.clone()) }
        }
        return RootBits()
    case .Switch, .Match:
        if e.children.len() > 0 {
            subj := summary_expr_bits(e.children[0], roots, scope, self_type)
            if subj.is_zero().not() {
                for ci in 1..e.children.len() { summary_bind_case(e.children[ci], subj, roots) }
            }
        }
    case:
    }
    mut bits := RootBits()
    for c : Expr in e.children {
        bits = bits.bor(summary_walk(c, roots, scope, self_type))
    }
    return bits
}

// OR this function's freshly computed summary into the recorded one.
// Monotone by construction, so the fixed point below terminates; the
// return value is its progress signal.
priv update_ref_return_summary := func(mut fd_expr: Expr, scope: TypeScope, self_type: Str) returns Bool {
    if fd_expr.children.len() == 0 { return false }
    switch fd_expr.node_type {
    case .FuncDef(fd):
        // A bodyless raw / core / FFI ref has no typed root to hand back.
        if fd.func_type.is_bodyless() { return false }
        // #351: summaries also cover a function returning a VALUE that
        // carries a borrow (a struct with a ref field). Deliberately a
        // wider gate than fdef_return_carries_borrow, which also steers
        // auto-shallow and must keep the ABI it implies.
        mut carries := fdef_return_carries_borrow(fd, scope)
        if carries.not() { carries = type_carries_borrow(scope, fd.return_type) }
        if carries.not() { return false }
        mut roots := Map(Str, RootBits).new()
        for pi in 0..fd.params.len() {
            ref p : Declaration = fd.params[pi]
            if p.name.len() == 0 { continue }
            roots.set(p.name, own RootBits(alias = summary_param_bit(pi)))
        }
        rb := summary_walk(fd_expr.children[0], roots, scope, self_type)
        merged_a := fd.ref_return_params.bor(rb.alias)
        merged_i := fd.ref_return_into_params.bor(rb.into)
        merged_c := fd.ref_return_carried_params.bor(rb.carried)
        if merged_a.eq(fd.ref_return_params).and(merged_i == fd.ref_return_into_params).and(merged_c == fd.ref_return_carried_params) { return false }
        fd.ref_return_params = merged_a
        fd.ref_return_into_params = merged_i
        fd.ref_return_carried_params = merged_c
        return true
    case:
    }
    return false
}

// One round over every definition in the unit. Namespace methods live in
// the StructDef / EnumDef payload rather than in the node's children, so
// they need their own descent; a FuncDef is never descended into, because
// init_declarations_unit hoists nested definitions to file scope and
// typer_lift_lambdas has already lifted the anonymous ones.
priv summarize_unit_walk := func(mut e: Expr, scope: TypeScope, self_type: Str) returns Bool {
    mut changed := false
    switch e.node_type {
    case .FuncDef:
        return update_ref_return_summary(e, scope, self_type)
    case .Decl(dd):
        // A type definition names the `self` its namespace methods take;
        // the name lives on the Decl, not on the def node.
        if e.children.len() > 0 {
            ref mut drhs : Expr = e.children[0]
            if drhs.node_type.is(NodeType.StructDef).or(drhs.node_type.is(NodeType.EnumDef)) {
                return summarize_unit_walk(drhs, scope, dd.name)
            }
        }
    case .StructDef(sd):
        for mut nd : Declaration in sd.ns_decls {
            if nd.default_value.is_none() { continue }
            if summarize_unit_walk(nd.default_expr(), scope, self_type) { changed = true }
        }
    case .EnumDef(ed):
        for mut nd : Declaration in ed.ns_decls {
            if nd.default_value.is_none() { continue }
            if summarize_unit_walk(nd.default_expr(), scope, self_type) { changed = true }
        }
    case:
    }
    for mut c : Expr in e.children {
        if summarize_unit_walk(c, scope, self_type) { changed = true }
    }
    return changed
}

// Settle every borrow-returning function in the unit BEFORE a single body
// is typed -- the redundant-`mut` verdict for a body is reached while that
// body is being typed, so a summary that arrives later is useless to it.
// Callees in imported files were summarised when their own unit ran (the
// typer walks imports first), so only forward references inside this unit
// start at zero; the rounds grow them monotonically. The loop needs no
// iteration bound: the summaries are a monotone function on a finite
// lattice (bits are only ever ORed in, 64 per function, finitely many
// functions), so a round that reports a change has set at least one bit
// that can never be unset -- `changed` is the termination proof.
// Instantiated generics need no separate pass -- their FunctionDef is
// cloned from the template, summary included.
priv compute_ref_return_summaries := func(mut program: Expr, scope: TypeScope) {
    mut changed := true
    while changed {
        changed = summarize_unit_walk(program, scope, "")
    }
}

// Asap-destruction helpers (LocalInfo, alias_used_in_stmts,
// collect_scope_locals, extend_ref_local_lifetimes,
// check_use_after_own_transfer, promote_own_transferred_locals,
// insert_exit_deletes / insert_nested_exit_deletes /
// insert_exit_deletes_into_stmt / insert_post_stmt_deletes /
// insert_assign_delete, insert_free_calls) moved to
// src/self/garbager.til. See issue #204 / doc/pipeline.org step 5.
// til_type derives Type.Struct("Str") and Type.Primitive(Primitive.Bool) for LiteralStr
// and LiteralBool directly from node_type, so this function only needs
// to handle the two variants with non-trivial inference: LiteralNum's
// I64-default-unless-already-narrowed (parser writes Type.Primitive(Primitive.U8) for char
// literals) and LiteralNull's initial Type.Dynamic (narrow_dynamic may
// mutate it post-write, so the field is still authoritative for that
// variant).
priv infer_literal_expr := func(mut expr: Expr) {
    switch expr.node_type {
    case .Literal(Literal.Num(num_data)):
        if is_numeric_type(expr.til_type()).not() {
            // No context to narrow from (no declared type, no parameter type).
            // Integers default to I64, but a literal whose text is fractional
            // is a float and must not become one: `f := 1.5` used to be typed
            // I64 and then blew up converting its own text, with
            // "Str.to_i64: invalid char in '1.5'" pointing into src/core -- no
            // user file, no line. F32 is the only float til has.
            //
            // This cannot change any working program: the default only applies
            // where no type was inferred, and an I64 literal with fractional
            // text always panicked, in both backends. Literals that DO have a
            // context type keep it -- is_numeric_type is already true for them.
            if num_data.is_float() {
                expr.set_til_type(Type.Primitive(Primitive.F32))
            } else {
                expr.set_til_type(Type.Primitive(Primitive.I64))
            }
        }
    case .Literal(Literal.Null):
        expr.set_til_type(Type.Dynamic)
    case:
    }
}

priv narrow_dynamic := func(mut expr: Expr, target: Type) {
    if expr.til_type().is(Type.Dynamic).not() { return }
    if target.is(Type.Dynamic) { return }
    if target.is(Type.Unknown) { return }
    expr.set_til_type(target)
}

fcall_is_get_method := func(fcall: Expr) returns Bool {
    if fcall.node_type.is(NodeType.FCall).not() { return false }
    if fcall.children.len() == 0 { return false }
    ref callee : Expr = fcall.children[0]
    switch callee.node_type {
    case .FieldAccess(fad):
        return fad.field_access_name() == "get"
    case:
        return false
    }
}

fcall_returns_ref := func(fcall: Expr, scope: TypeScope) returns I32 {
    if fcall.node_type.is(NodeType.FCall).not() { return 0 }
    if fcall.children.len() == 0 { return 0 }
    ref callee : Expr = fcall.children[0]
    switch callee.node_type {
    case .Ident(cn):
        cb_fd_o := scope.lookup_func(cn.ident_name())
        if cb_fd_o.is_none() { return 0 }
        switch cb_fd_o.unwrap().node_type {
        case .FuncDef(cfd):
            return cfd.return_own_type.is(OwnType.Ref)
        case:
            return 0
        }
    case .FieldAccess(cfa):
        if fa_is_ns(callee, scope) {
            switch callee.children[0].node_type {
            case .Ident(cti):
                sdef_o := scope.get_struct(cti.ident_name())
                if sdef_o.is_none() { return 0 }
                ref sdef : Expr = sdef_o.unwrap()
                fd_o := def_ns_get(sdef, cfa.field_access_name())
                if fd_o.is_some() {
                    ref fd : Declaration = fd_o.unwrap()
                    if fd.default_value.is_some() {
                        switch fd.default_expr().node_type {
                        case .FuncDef(ffd):
                            return ffd.return_own_type.is(OwnType.Ref)
                        case:
                        }
                    }
                }
            case:
            }
        }
        if callee.children.len() > 0 {
            ref obj : Expr = callee.children[0]
            sname_o := expr_type_name_ref(obj)
            if sname_o.is_some() {
                ref sname : Str = sname_o.unwrap()
                sdef2_o := scope.get_struct(sname)
                if sdef2_o.is_none() { return 0 }
                mo3 := find_namespace_func(sdef2_o.unwrap(), cfa.field_access_name(), scope)
                if mo3.is_some() {
                    ref method : Expr = mo3.unwrap()
                    switch method.node_type {
                    case .FuncDef(ffd2):
                        return ffd2.return_own_type.is(OwnType.Ref)
                    case:
                    }
                }
            }
        }
    case:
    }
    return 0
}

// Parallel to fcall_returns_ref: returns 1 when the FCall's callee is
// declared `returns shallow T`. Used by collect_scope_locals to keep
// the typer-emitted cleanup's call_free bool consistent with the
// builder's shallow-return stack-alloc path (no malloc, so freeing
// would touch a stack pointer).
// The SETTLED shallow-return answer for a callee signature. The garbager
// queries callee sigs (via fcall_returns_shallow) while typing the unit
// that may have JUST instantiated the callee's template -- before the
// instantiated def's own signature inference applied the #223
// auto-shallow normalization (Own -> Shallow for primitive / small
// value-shaped returns, see infer_func_def_expr). Trusting the
// unsettled return_own_type recorded HeapBox for locals the builder
// stack-allocates (its fcall_is_shallow_return reads the flag AFTER all
// typing); the #302 stage-1 assert caught the mismatch on
// `popped : I64 = v.pop()` the first time a unit instantiated Vec(T)
// itself. Mirror the normalization here instead.
priv fdef_returns_shallow_settled := func(fd: FunctionDef, scope: TypeScope, ctx: Context) returns Bool {
    if fd.return_own_type.is(OwnType.Shallow) { return true }
    if fd.return_own_type.is(OwnType.Own).not() { return false }
    auto_ok := fd.func_type.is_plain().or(fd.func_type.is_lazy())
    if auto_ok.not() { return false }
    if fd.return_type.len() == 0 { return false }
    ref resolved : Str = resolve_type_alias(scope, fd.return_type)
    return is_auto_shallow_type(type_from_name_init(resolved, scope), resolved, scope, ctx)
}

fcall_returns_shallow := func(fcall: Expr, scope: TypeScope, ctx: Context) returns I32 {
    if fcall.node_type.is(NodeType.FCall).not() { return 0 }
    if fcall.children.len() == 0 { return 0 }
    ref callee : Expr = fcall.children[0]
    switch callee.node_type {
    case .Ident(cn):
        cb_fd_o := scope.lookup_func(cn.ident_name())
        if cb_fd_o.is_none() { return 0 }
        switch cb_fd_o.unwrap().node_type {
        case .FuncDef(cfd):
            return fdef_returns_shallow_settled(cfd, scope, ctx)
        case:
            return 0
        }
    case .FieldAccess(cfa):
        if fa_is_ns(callee, scope) {
            switch callee.children[0].node_type {
            case .Ident(cti):
                sdef_o := scope.get_struct(cti.ident_name())
                if sdef_o.is_none() { return 0 }
                ref sdef : Expr = sdef_o.unwrap()
                fd_o := def_ns_get(sdef, cfa.field_access_name())
                if fd_o.is_some() {
                    ref fd : Declaration = fd_o.unwrap()
                    if fd.default_value.is_some() {
                        switch fd.default_expr().node_type {
                        case .FuncDef(ffd):
                            return fdef_returns_shallow_settled(ffd, scope, ctx)
                        case:
                        }
                    }
                }
            case:
            }
        }
    case:
    }
    return 0
}

// ---- switch / match / for-in TYPE INFERENCE (moved back from desugarer) ----
// These drive type inference (infer_expr / infer_body) and emit the
// exhaustiveness / pattern type errors, so they live in the typer. The pure
// lowering primitives they invoke (make_switch_case_condition, the if/elif and
// while builders) stay in desugarer.til.
// Issue #200: per-arm coverage trie for nested switch exhaustiveness.
// Each node corresponds to one enum's variants. ~fully_covered~ means the
// pattern bound the entire value at this level (e.g. ~case X.A(v):~ or
// ~case X.A:~) so no inner walk is needed. Otherwise the parallel vecs
// ~sub_names~ / ~sub_nodes~ hold per-variant child coverage; an empty
// ~sub_nodes~ entry means "the variant's payload was never decomposed"
// and is only fully_covered iff its own ~fully_covered~ bit is set.
priv CoverageNode := struct {
    fully_covered := false
    sub_names := Vec(Str).new()
    sub_nodes := Vec(CoverageNode).new()
}

// Seed a node with empty per-variant sub-coverage for an enum_def.
priv init_coverage_for_enum := func(mut node: CoverageNode, enum_def: Expr) {
    switch enum_def.node_type {
    case .EnumDef(cn_edd):
        for vd : VariantDef in cn_edd.variants {
            node.sub_names.push(own vd.name.clone())
            node.sub_nodes.push(own CoverageNode())
        }
    case:
    }
}

priv coverage_sub_index := func(coverage: CoverageNode, variant_name: Str) returns I32 {
    for csi in 0..coverage.sub_names.len() {
        ref n : Str = coverage.sub_names[csi]
        if n == variant_name { return csi.to_i32() }
    }
    return -1
}

// Read-only mirror of mark_pattern_coverage: true iff every value the
// pattern could match has already been captured by an earlier (unguarded)
// arm in this switch -- i.e. the arm carrying this pattern is dead.
// Patterns the trie doesn't statically describe (value literals, struct
// patterns, non-enum subjects) return false so a more permissive checker
// or guard-protected arm doesn't get a false positive.
priv is_pattern_covered := func(scope: TypeScope, coverage: CoverageNode, expected_type_name: Str, enum_def: Expr, pattern: Expr) returns Bool {
    if pattern.node_type.is(NodeType.FieldAccess) {
        if pattern.children.len() > 0 {
            if pattern.children[0].node_type.is(NodeType.Ident) {
                mut type_name := ""
                mut variant_name := ""
                switch pattern.children[0].node_type {
                case .Ident(tn): type_name = Str.clone(tn.ident_name())
                case:
                }
                switch pattern.node_type {
                case .FieldAccess(vn): variant_name = Str.clone(vn.field_access_name())
                case:
                }
                // #322: the pattern may spell the enum through an ALIAS
                // (`Opt := make_opt(I64); case Opt.Some:`) while
                // expected_type_name is the resolved name from the
                // scrutinee's type -- resolve before comparing.
                if resolve_type_alias(scope, type_name) == expected_type_name {
                    idx := coverage_sub_index(coverage, variant_name)
                    if idx >= 0 {
                        ref sub : CoverageNode = coverage.sub_nodes[idx.to_usize()]
                        return sub.fully_covered
                    }
                }
            }
        }
        return false
    }

    if pattern.node_type.is(NodeType.FCall) {
        if pattern.children.len() == 2 {
            ref callee : Expr = pattern.children[0]
            if callee.node_type.is(NodeType.FieldAccess) {
                if callee.children.len() > 0 {
                    if callee.children[0].node_type.is(NodeType.Ident) {
                        mut type_name2 := ""
                        mut variant_name2 := ""
                        switch callee.children[0].node_type {
                        case .Ident(tn2): type_name2 = Str.clone(tn2.ident_name())
                        case:
                        }
                        switch callee.node_type {
                        case .FieldAccess(vn2): variant_name2 = Str.clone(vn2.field_access_name())
                        case:
                        }
                        // #322: same alias resolution as the bare-variant arm.
                        if resolve_type_alias(scope, type_name2) == expected_type_name {
                            idx2 := coverage_sub_index(coverage, variant_name2)
                            if idx2 >= 0 {
                                ref sub2 : CoverageNode = coverage.sub_nodes[idx2.to_usize()]
                                if sub2.fully_covered { return true }
                                ref inner_pat : Expr = pattern.children[1]
                                if inner_pat.node_type.is(NodeType.Ident) {
                                    return false
                                }
                                vt_idx := enum_variant_index(enum_def, variant_name2)
                                if vt_idx >= 0 {
                                    inner_type_name := enum_variant_type(enum_def, vt_idx)
                                    if inner_type_name.len() > 0 {
                                        inner_def_o := scope.get_struct(inner_type_name)
                                        if inner_def_o.is_some() {
                                            if inner_def_o.unwrap().node_type.is(NodeType.EnumDef) {
                                                if sub2.sub_names.len() > 0 {
                                                    return is_pattern_covered(scope, sub2, inner_type_name, inner_def_o.unwrap(), inner_pat)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        return false
    }
    return false
}

// Walk a case pattern against the (expected) enum type and update the
// coverage trie. Returns silently for patterns that don't statically
// describe a variant of `expected_type_name` (e.g. ~case 42:~, or a
// pattern targeting a different enum -- those will surface as other
// type errors).
priv mark_pattern_coverage := func(scope: TypeScope, mut coverage: CoverageNode, expected_type_name: Str, enum_def: Expr, pattern: Expr) {
    // `case Type.Variant` (bare).
    if pattern.node_type.is(NodeType.FieldAccess) {
        if pattern.children.len() > 0 {
            if pattern.children[0].node_type.is(NodeType.Ident) {
                mut type_name := ""
                mut variant_name := ""
                switch pattern.children[0].node_type {
                case .Ident(tn): type_name = Str.clone(tn.ident_name())
                case:
                }
                switch pattern.node_type {
                case .FieldAccess(vn): variant_name = Str.clone(vn.field_access_name())
                case:
                }
                // #322: the pattern may spell the enum through an ALIAS
                // (`Opt := make_opt(I64); case Opt.Some:`) while
                // expected_type_name is the resolved name from the
                // scrutinee's type -- resolve before comparing.
                if resolve_type_alias(scope, type_name) == expected_type_name {
                    idx := coverage_sub_index(coverage, variant_name)
                    if idx >= 0 {
                        ref mut sub : CoverageNode = coverage.sub_nodes[idx.to_usize()]
                        sub.fully_covered = true
                    }
                }
            }
        }
        return
    }

    // `case Type.Variant(inner)` -- inner is either a binding (Ident, marks
    // the variant fully covered) or another enum pattern (recurse).
    if pattern.node_type.is(NodeType.FCall) {
        if pattern.children.len() == 2 {
            ref callee : Expr = pattern.children[0]
            if callee.node_type.is(NodeType.FieldAccess) {
                if callee.children.len() > 0 {
                    if callee.children[0].node_type.is(NodeType.Ident) {
                        mut type_name2 := ""
                        mut variant_name2 := ""
                        switch callee.children[0].node_type {
                        case .Ident(tn2): type_name2 = Str.clone(tn2.ident_name())
                        case:
                        }
                        switch callee.node_type {
                        case .FieldAccess(vn2): variant_name2 = Str.clone(vn2.field_access_name())
                        case:
                        }
                        // #322: same alias resolution as the bare-variant arm.
                        if resolve_type_alias(scope, type_name2) == expected_type_name {
                            idx2 := coverage_sub_index(coverage, variant_name2)
                            if idx2 >= 0 {
                                ref mut sub2 : CoverageNode = coverage.sub_nodes[idx2.to_usize()]
                                ref inner_pat : Expr = pattern.children[1]
                                if inner_pat.node_type.is(NodeType.Ident) {
                                    // Whole-payload binding -> covers all sub-variants.
                                    sub2.fully_covered = true
                                } else {
                                    // Nested pattern: find inner enum and recurse.
                                    vt_idx := enum_variant_index(enum_def, variant_name2)
                                    if vt_idx >= 0 {
                                        inner_type_name := enum_variant_type(enum_def, vt_idx)
                                        if inner_type_name.len() > 0 {
                                            inner_def_o := scope.get_struct(inner_type_name)
                                            if inner_def_o.is_some() {
                                                ref inner_def : Expr = inner_def_o.unwrap()
                                                if inner_def.node_type.is(NodeType.EnumDef) {
                                                    if sub2.sub_names.len() == 0 {
                                                        init_coverage_for_enum(sub2, inner_def)
                                                    }
                                                    mark_pattern_coverage(scope, sub2, inner_type_name, inner_def, inner_pat)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        return
    }
}

// Collect "Outer.Inner.Leaf"-style paths for any uncovered variants of
// `enum_def` under `coverage`. A variant is OK iff fully_covered or
// (its payload is itself an enum AND its sub-coverage is exhaustive).
priv collect_missing_paths := func(scope: TypeScope, coverage: CoverageNode, enum_def: Expr, prefix: Str, mut out: Vec(Str), ctx: Context) {
    switch enum_def.node_type {
    case .EnumDef(cm_edd):
        for cmi in 0..cm_edd.variants.len() {
            ref cm_vd : VariantDef = cm_edd.variants[cmi]
            ref vn : Str = cm_vd.name
            ref sub : CoverageNode = coverage.sub_nodes[cmi]
            mut current := ""
            if prefix.len() == 0 {
                current = vn.clone()
            } else {
                current = format(prefix, ".", vn)
            }
            if sub.fully_covered { continue }
            mut recursed := false
            vt_idx := enum_variant_index(enum_def, vn)
            if vt_idx >= 0 {
                inner_type_name := enum_variant_type(enum_def, vt_idx)
                if inner_type_name.len() > 0 {
                    inner_def_o := scope.get_struct(inner_type_name)
                    if inner_def_o.is_some() {
                        ref inner_def : Expr = inner_def_o.unwrap()
                        if inner_def.node_type.is(NodeType.EnumDef) {
                            if sub.sub_names.len() > 0 {
                                collect_missing_paths(scope, sub, inner_def, current, out, ctx)
                                recursed = true
                            }
                        }
                    }
                }
            }
            if recursed.not() {
                out.push(own current.clone())
            }
        }
    case:
    }
}

// Issue #244: type a `match` expression by computing the common arm type.
// Each arm body is a single value-expression; the whole match yields that
// type. The actual lowering (result temp + synthetic switch) happens at the
// statement level in lower_matches_in_stmt; here we only set the node's type
// so enclosing decls/args/returns/nested-matches see it. The common type is
// taken from the first arm; the synthetic switch's per-arm assignment then
// enforces that every other arm agrees (a mismatch surfaces as an assign
// type error). Arm values are type-checked on a throwaway clone so the real
// arm nodes stay pristine for the desugar that re-infers them.
priv infer_match_expr := proc(mut scope: TypeScope, mut expr: Expr, in_func: I32, mut ctx: Context) {
    if expr.children.len() == 0 { expr.set_til_type(Type.Unknown); return }
    ref mut subj : Expr = expr.children[0]
    infer_expr(scope, subj, in_func, ctx)
    // #341: a match types its arms HERE, before the shared switch desugar
    // ever sees them, so `case .Some(v):` has to be qualified here too --
    // infer_switch_stmt's own call then finds nothing left to do.
    qualify_dotted_case_patterns(expr, expr.children[0].til_type(), ctx)
    // The match's type is the common arm type. Take it from the first arm and
    // check the rest agree, so a mismatch is reported clearly here (rather than
    // surfacing later as a temp-named assignment error from the lowering).
    mut result_t := Type.Unknown
    mut has_t := false
    mut reported := false
    for ci in 1..expr.children.len() {
        arm_t := match_arm_value_type(scope, expr.children[ci], subj, in_func, ctx)
        if has_t.not() {
            result_t = arm_t
            has_t = true
        } else if reported.not().and(arm_t.is(Type.Unknown).not()).and(result_t.is(Type.Unknown).not()).and(arm_t.eq(result_t).not()) {
            expr.children[ci].type_error(format("match arms have incompatible types: '", type_to_name(result_t), "' vs '", type_to_name(arm_t), "'; all arms must yield the same type"), ctx)
            reported = true
        }
    }
    // Arm-type agreement is the one check unique to match (switch arms have no
    // type). Exhaustiveness -- enum and non-enum alike -- is enforced by the
    // shared switch desugar (infer_switch_stmt) once the match is lowered.
    expr.set_til_type(result_t)
}

// Type of one match arm's value-expression. Clones the arm body (so the real
// node is untouched), prepends the pattern's payload bindings via the shared
// switch helper, infers the bindings, then infers the value expression.
priv match_arm_value_type := proc(scope: TypeScope, case_node: Expr, subj: Expr, in_func: I32, mut ctx: Context) returns Type {
    mut arm_scope := TypeScope(parent = Option(ref TypeScope).Some(scope))
    body_idx := case_node.children.len() - 1
    has_pattern := case_pattern_count(case_node) > 0
    mut trial := case_node.children[body_idx].clone()
    if has_pattern {
        // Bindings come only from a case's single pattern (a pattern that
        // binds cannot share a case, #334), so prepending children[0] is
        // enough to type the body under its bindings.
        sw_ref := subj.clone()
        make_switch_case_condition(arm_scope, trial, case_node.children[0], sw_ref, case_node.line, case_node.col)
    }
    mut t := Type.Unknown
    if trial.children.len() > 0 {
        last_idx := trial.children.len() - 1
        mut k : USize = 0
        while k < last_idx {
            infer_body_stmt(arm_scope, trial, k, in_func, 0, 0, 0, ctx)
            k++
        }
        infer_expr(arm_scope, trial.children[last_idx], in_func, ctx)
        t = trial.children[last_idx].til_type().clone()
    }
    return t
}

// Lower every top-level Match in body.children[stmt_idx] into a result temp plus
// the match itself (tagged with that temp so the shared switch desugar handles
// it), spliced as new statements before stmt_idx. Each Match node is replaced
// in place by an Ident referencing its result temp. Returns the number of
// statements inserted, so the caller can advance past them to type-check the
// now-match-free statement.
priv lower_matches_in_stmt := proc(mut scope: TypeScope, mut body: Expr, stmt_idx: USize, in_func: I32, in_loop: I32, returns_ref: I32, mut ctx: Context) returns USize {
    mut pre := Vec(Expr).new()
    ref mut stmt : Expr = body.children[stmt_idx]
    replace_matches_rec(scope, stmt, in_func, in_loop, returns_ref, ctx, pre)
    inserted := pre.len()
    splice_stmts_before(body, stmt_idx, pre)
    return inserted
}

priv literal_bool_is := func(e: Expr, want: Bool) returns Bool {
    switch e.node_type {
    case .Literal(Literal.Bool(b)): return b == want
    case: return false
    }
}

// `match X { case true: true case: false }` yields exactly X: one subject
// evaluation, one Bool out, no arm doing anything else. Recognising it lets
// the caller drop the whole node down to its subject instead of spending a
// result temp, a block and a branch on the identity. Purely structural, so it
// fires wherever the shape appears -- the tail level of an unrolled recursive
// variadic lazy body reaches it (the last operand wrapping the base literal),
// and so does a hand-written match.
priv match_is_bool_identity := func(m: Expr) returns Bool {
    if m.node_type.is(NodeType.Match).not() { return false }
    if m.children.len() != 3 { return false }
    // Only a genuinely Bool subject. A Dynamic one reaching `case true:` is a
    // type error the switch desugar reports (it builds `subject.eq(true)`);
    // folding it away would swallow that diagnostic.
    if type_is_primitive(m.children[0].til_type(), Primitive.Bool).not() { return false }
    ref case_true : Expr = m.children[1]
    ref case_def : Expr = m.children[2]
    if case_true.children.len() != 2 { return false }
    if case_def.children.len() != 1 { return false }
    if literal_bool_is(case_true.children[0], true).not() { return false }
    ref body_true : Expr = case_true.children[1]
    ref body_def : Expr = case_def.children[0]
    if body_true.children.len() != 1 { return false }
    if body_def.children.len() != 1 { return false }
    if literal_bool_is(body_true.children[0], true).not() { return false }
    return literal_bool_is(body_def.children[0], false)
}

// Walk `node`, replacing each top-level Match child with an Ident to its
// lowered result temp and collecting the temp's setup statements into `pre`.
// Does not descend into a Match (its arms are lowered by lower_one_match's own
// infer_body pass) nor into nested blocks/definitions (handled separately).
priv replace_matches_rec := proc(mut scope: TypeScope, mut node: Expr, in_func: I32, in_loop: I32, returns_ref: I32, mut ctx: Context, mut pre: Vec(Expr)) {
    switch node.node_type {
    case .Body, .FuncDef, .StructDef, .EnumDef: return
    // #282: do not hoist a match out of a case guard (or body) -- it is
    // conditionally evaluated and infer_switch_stmt lowers it into the
    // pattern-gated position. See stmt_contains_match for the rationale.
    case .Case:      return
    case:
    }
    mut ci : USize = 0
    while ci < node.children.len() {
        if node.children[ci].node_type.is(NodeType.Match) {
            infer_match_expr(scope, node.children[ci], in_func, ctx)
            // Typed first, so a bad subject still gets its diagnostic; only
            // then collapse the identity away instead of hoisting it.
            // Re-examine the subject in place rather than advancing: it can be
            // another identity, or a match that still needs its own hoist.
            if match_is_bool_identity(node.children[ci]) {
                node.children[ci] = node.children[ci].children[0].clone()
                continue
            }
            mname := lower_one_match(scope, node.children[ci], in_func, in_loop, returns_ref, ctx, pre)
            mut id := Expr.new(ident_node(mname), node.children[ci].line, node.children[ci].col)
            id.set_til_type(node.children[ci].til_type())
            node.children[ci] = id
        } else {
            replace_matches_rec(scope, node.children[ci], in_func, in_loop, returns_ref, ctx, pre)
        }
        ci++
    }
}

// Build the lowering for one (already-typed) Match: a `mut _m := default(T)`
// temp plus the match itself tagged with that temp. The block is inferred here
// (declaring the temp in `scope`, then reaching infer_switch_stmt which turns
// the arms into `_m = <value>` assignments and emits the dispatch, including
// any nested matches in arm values), then its statements are appended to
// `pre`. Returns the temp's name.
priv lower_one_match := proc(mut scope: TypeScope, match_node: Expr, in_func: I32, in_loop: I32, returns_ref: I32, mut ctx: Context, mut pre: Vec(Expr)) returns Str {
    line := match_node.line
    col := match_node.col
    ref result_t : Type = match_node.til_type()
    tname := type_to_name(result_t)
    mname := format("_m_", type_prefix(result_t), "_", synth_suffix(ctx, ctx.hoist_counter.to_str()))
    ctx.hoist_counter++

    mut decl := Expr.new(NodeType.Decl(Declaration(name = mname.clone(), is_mut = true, explicit_type = tname.clone(), til_type = result_t.clone())), line, col)
    decl.add_child(own make_default_value_expr(tname, line, col))

    // Clone the match and tag it with the result temp; the shared switch
    // desugar (infer_switch_stmt, reached via infer_body) turns its arms into
    // `mname = <value>` assignments and emits the dispatch.
    mut match_stmt := match_node.clone()
    switch match_stmt.node_type {
    case .Match(md): md.result_temp = mname.clone()
    case:
    }

    mut block := Expr.new(NodeType.Body, line, col)
    block.add_child(own decl)
    block.add_child(own match_stmt)
    infer_body(scope, block, in_func, 0, in_loop, returns_ref, 0, ctx)
    for bi in 0..block.children.len() {
        pre.push_take(block.children, bi)
    }
    return mname
}

// Issue #36: a struct pattern that omits fields needs an explicit `..`
// marker. Run on each non-default case BEFORE make_switch_case_condition
// (which is a func and can't call the proc-typed type_error). Skips
// silently for patterns that aren't struct-shaped.
priv validate_struct_pattern_rest := proc(scope: TypeScope, pattern: Expr, mut ctx: Context) {
    if pattern.node_type.is(NodeType.FCall).not() { return }
    if pattern.children.len() == 0 { return }
    if pattern.children[0].node_type.is(NodeType.Ident).not() { return }
    mut vsp_type_name := ""
    switch pattern.children[0].node_type {
    case .Ident(vspn): vsp_type_name = Str.clone(vspn.ident_name())
    case:
    }
    mut vsp_all_named := true
    mut vsp_has_rest := false
    for vci in 1..pattern.children.len() {
        ref vsc : Expr = pattern.children[vci]
        if vsc.node_type.is(NodeType.RestPattern) {
            vsp_has_rest = true
        } else if vsc.node_type.is(NodeType.NamedArg).not() {
            vsp_all_named = false
        }
    }
    if vsp_all_named.not() { return }
    vsp_def_o := scope.get_struct(vsp_type_name)
    if vsp_def_o.is_none() { return }
    ref vsp_def : Expr = vsp_def_o.unwrap()
    if vsp_def.node_type.is(NodeType.StructDef).not() { return }
    if vsp_has_rest { return }
    switch vsp_def.node_type {
    case .StructDef(vsp_sdd):
        for vf_name : Str in vsp_sdd.fields_index.keys {
            mut vsp_found := false
            for vnai in 1..pattern.children.len() {
                ref vnac : Expr = pattern.children[vnai]
                switch vnac.node_type {
                case .NamedArg(vnan):
                    if vnan == vf_name { vsp_found = true }
                case:
                }
            }
            if vsp_found.not() {
                pattern.type_error(format("struct pattern '", vsp_type_name, "' is missing field '", vf_name, "'; either bind it or add '..' to allow partial matching"), ctx)
            }
        }
    case:
    }
}

// #211/#321: is this Decl RHS a switch PAYLOAD BINDING? Two shapes reach
// here. An INLINE payload binds the bare `get_payload(<subject>)`, which
// addresses the payload where it sits. A payload in a POINTER SLOT binds
// `deref(get_payload(<subject>))`, because the slot holds the pointer and
// the binding has to LOAD it. Both alias the payload, so both must mark the
// binding as an alias -- that is what lets a write through it be recognised
// as a write through the payload, and what makes a by-value `return` of it
// CLONE rather than be rejected as "cannot return ref variable".
//
// Only the bare shape was recognised before, which was invisible while every
// slot payload was a `ref` one: those live in enums whose `unwrap` returns
// `ref T`, so the return path never asked. An OWNED slot payload returns by
// value and asked immediately.
priv rhs_is_payload_binding := func(rhs: Expr) returns Bool {
    if rhs.node_type.is(NodeType.FCall).not() { return false }
    if rhs.children.len() != 2 { return false }
    mut head := ""
    switch rhs.children[0].node_type {
    case .Ident(hid): head = Str.clone(hid.ident_name())
    case: return false
    }
    if head == "get_payload" { return true }
    if head == "deref" { return rhs_is_payload_binding(rhs.children[1]) }
    return false
}

// #321: `T.size()` as a call node, the same FieldAccess-on-a-type-Ident shape
// make_delete_call builds for `T.delete(...)`.
priv make_type_size_call := func(tname: Str, src: Expr) returns Expr {
    mut type_id := Expr.new(ident_node(tname), src.line, src.col)
    type_id.set_til_type(Type.Custom(tname.clone()))
    mut fa := Expr.new(field_access_node("size"), src.line, src.col)
    fa.add_child(own type_id)
    mut call := Expr.new(NodeType.FCall(FCallData()), src.line, src.col)
    call.add_child(own fa)
    return call
}

// #321: the block that MOVES a switch payload out of an enum the function
// owns, replacing a `return <payload binding>`:
//
//   { <tmp> : T = malloc(T.size())
//     memcpy(<tmp>, <binding>, T.size())
//     free(own <param>)
//     return <tmp> }
//
// All ordinary til, so neither backend learns a new node. Two things make it
// sound. `free` is the ext_func wrapping C's free, so it releases the enum
// SHELL without running the payload's destructor -- the payload's heap
// children transfer with the copied bytes instead of being freed under the
// caller. And `free(own <param>)` is an own-transfer the garbager already
// understands, so it stands the param's exit delete down on this path exactly
// as it does for a hand-written one.
// #321: the same move, for a payload that lives in a POINTER SLOT (a niche
// enum). There is nothing to copy -- the slot already holds the payload's
// box -- so the block is the steal above minus the malloc and the memcpy:
//
//   { <tmp> : T = deref(get_payload(<param>))
//     free(own <param>)
//     return <tmp> }
//
// `free(own <param>)` releases the enum SHELL without running the payload's
// destructor, which is what makes handing the box on sound; it is also the
// own-transfer that stands the param's exit delete down, exactly as in the
// inline case. This is the zero-copy take: no allocation at all.
priv make_niche_steal_block := func(param_name: Str, tname: Str, tmp: Str, src: Expr) returns Expr {
    mut blk := Expr.new(NodeType.Body, src.line, src.col)

    // <tmp> : T = get_payload(<param>)
    // No deref wrapper: get_payload LOADS a niche's slot itself, so the call
    // already yields the payload box. The wrapper this block was born with
    // predated that and double-dereffed -- reading the payload's first word
    // as if it were the pointer (ASAN: heap-buffer-overflow in the caller's
    // adopt, copying sizeof(T) from wherever that word pointed).
    mut self_id := Expr.new(ident_node(param_name), src.line, src.col)
    mut gp := make_get_payload_fcall(own self_id, til_type_from_explicit_type(tname), src.line, src.col)
    mut decl := Expr.new(NodeType.Decl(decl_typed(name = tmp, explicit_type = tname)), src.line, src.col)
    decl.add_child(own gp)
    blk.add_child(own decl)

    // free(own <param>)
    mut free_id := Expr.new(ident_node("free"), src.line, src.col)
    mut free_call := Expr.new(NodeType.FCall(FCallData()), src.line, src.col)
    free_call.add_child(own free_id)
    set_own_arg(free_call, free_call.children.len())
    mut param_id := Expr.new(ident_node(param_name), src.line, src.col)
    free_call.add_child(own param_id)
    blk.add_child(own free_call)

    // return <tmp>
    mut ret := Expr.new(NodeType.Return, src.line, src.col)
    mut ret_id := Expr.new(ident_node(tmp), src.line, src.col)
    ret.add_child(own ret_id)
    blk.add_child(own ret)

    return blk
}

priv make_payload_steal_block := func(bind_name: Str, param_name: Str, tname: Str, tmp: Str, src: Expr) returns Expr {
    mut blk := Expr.new(NodeType.Body, src.line, src.col)

    // <tmp> : T = malloc(T.size())
    mut malloc_id := Expr.new(ident_node("malloc"), src.line, src.col)
    mut malloc_call := Expr.new(NodeType.FCall(FCallData()), src.line, src.col)
    malloc_call.add_child(own malloc_id)
    mut msize := make_type_size_call(tname, src)
    malloc_call.add_child(own msize)
    mut decl := Expr.new(NodeType.Decl(decl_typed(name = tmp, explicit_type = tname)), src.line, src.col)
    decl.add_child(own malloc_call)
    blk.add_child(own decl)

    // memcpy(<tmp>, <binding>, T.size())
    mut memcpy_id := Expr.new(ident_node("memcpy"), src.line, src.col)
    mut copy_call := Expr.new(NodeType.FCall(FCallData()), src.line, src.col)
    copy_call.add_child(own memcpy_id)
    mut dest_id := Expr.new(ident_node(tmp), src.line, src.col)
    copy_call.add_child(own dest_id)
    mut src_id := Expr.new(ident_node(bind_name), src.line, src.col)
    copy_call.add_child(own src_id)
    mut csize := make_type_size_call(tname, src)
    copy_call.add_child(own csize)
    blk.add_child(own copy_call)

    // free(own <param>)
    mut free_id := Expr.new(ident_node("free"), src.line, src.col)
    mut free_call := Expr.new(NodeType.FCall(FCallData()), src.line, src.col)
    free_call.add_child(own free_id)
    set_own_arg(free_call, free_call.children.len())
    mut param_id := Expr.new(ident_node(param_name), src.line, src.col)
    free_call.add_child(own param_id)
    blk.add_child(own free_call)

    // return <tmp>
    mut ret := Expr.new(NodeType.Return, src.line, src.col)
    mut ret_id := Expr.new(ident_node(tmp), src.line, src.col)
    ret.add_child(own ret_id)
    blk.add_child(own ret)

    return blk
}

// Replace every `return <bind_name>` in this case body with the steal block.
// Nested FuncDefs are skipped: a closure's `return` belongs to the closure,
// not to the function that owns the enum.
// Does this subtree still name `n`? Used to tell whether the niche move-out
// left the payload binding with no readers at all.
priv subtree_names_ident := func(e: Expr, n: Str) returns Bool {
    switch e.node_type {
    case .Ident(idn):
        if idn.ident_name() == n { return true }
    case:
    }
    for c : Expr in e.children {
        if subtree_names_ident(c, n) { return true }
    }
    return false
}

priv steal_payload_returns := proc(mut body: Expr, bind_name: Str, param_name: Str, tname: Str, in_slot: Bool) {
    for i in 0..body.children.len() {
        ref mut st : Expr = body.children[i]
        if st.node_type.is(NodeType.FuncDef) { continue }
        if st.node_type.is(NodeType.Return).and(st.children.len() == 1) {
            mut is_bind := false
            switch st.children[0].node_type {
            case .Ident(rn): is_bind = rn.ident_name() == bind_name
            case:
            }
            if is_bind {
                tmp := format("_steal_", bind_name, "_", st.line.to_str(), "_", st.col.to_str())
                if in_slot {
                    body.children[i] = make_niche_steal_block(param_name, tname, tmp, st)
                } else {
                    body.children[i] = make_payload_steal_block(bind_name, param_name, tname, tmp, st)
                }
                continue
            }
        }
        steal_payload_returns(st, bind_name, param_name, tname, in_slot)
    }
}

// #321: `case V(v): return v` hands the caller a payload the enum is about to
// destroy, so infer_return_stmt's alias rule CLONES it -- a deep copy of a
// value nobody else can observe, followed by a deep delete of the original.
// That is what blocks moving an owned payload out of an Option: an `Expr`
// clone is a whole AST subtree, both a large cost and a semantic change (the
// passes compare and mutate nodes by identity).
//
// When the switch subject is an `own` PARAM the copy is never needed: the
// function owns the enum, nothing else can observe it, and the payload's bytes
// can simply be moved into a fresh box. Gated on exactly that -- an own param
// subject, an owned (non-ref) payload, and a return type that IS the payload
// type -- so a borrowed subject or a ref payload keeps the clone.
priv steal_own_param_payload_returns := proc(scope: TypeScope, enum_def: Expr, sw_expr: Expr, mut case_node: Expr, ctx: Context) returns Bool {
    if ctx.typer_return_type_name.len() == 0 { return false }
    mut param_name := ""
    switch sw_expr.node_type {
    case .Ident(sw_idn): param_name = Str.clone(sw_idn.ident_name())
    case: return false
    }
    sw_b_o := scope.get_binding(param_name)
    if sw_b_o.is_none() { return false }
    ref sw_b : TypeBinding = sw_b_o.unwrap()
    if sw_b.is_param.and(sw_b.own_type.is(OwnType.Own)).not() { return false }

    ref pat : Expr = case_node.children[0]
    if pat.node_type.is(NodeType.FCall).not() { return false }
    if pat.children.len() != 2 { return false }
    mut variant_name := ""
    switch pat.children[0].node_type {
    case .FieldAccess(vn): variant_name = Str.clone(vn.field_access_name())
    case: return false
    }
    mut bind_name := ""
    switch pat.children[1].node_type {
    case .Ident(bn): bind_name = Str.clone(bn.ident_name())
    case: return false
    }
    vt_idx := enum_variant_index(enum_def, variant_name)
    if vt_idx < 0 { return false }
    // A BORROWED payload is a pointer the enum never owned, so there is
    // nothing to move and the by-value return must keep copying.
    if enum_variant_payload_ref(enum_def, vt_idx) { return false }
    // An OWNED payload of a NICHE enum is the box itself: hand it straight
    // back, no copy (make_niche_steal_block). An inline one is copied out of
    // the enum's own storage (make_payload_steal_block, which then frees only
    // the enum shell). NOT enum_payload_is_pointer_slot: that predicate now
    // answers "does the caller still need a deref wrapper around get_payload"
    // -- false for a niche, whose get_payload loads its own slot -- and using
    // it here silently routed a niche take onto the inline block, which
    // memcpys the pointee into a fresh box and LEAKS the original. The
    // borrowed case already returned above, so niche-ness alone is the
    // storage answer.
    in_slot := enum_is_niche(enum_def)
    payload_type := enum_variant_type(enum_def, vt_idx)
    if payload_type.len() == 0 { return false }
    if payload_type != ctx.typer_return_type_name { return false }
    steal_payload_returns(case_node.children[1], bind_name, param_name, payload_type, in_slot)
    // The zero-copy form hands the payload BOX back without ever reading the
    // pointee, so if that was the binding's only reader it now has none. Say
    // so, and the binding is not emitted at all -- a dead one would reach gcc
    // as -Werror=unused-variable, which #326 deliberately keeps loud.
    if in_slot.not() { return false }
    return subtree_names_ident(case_node.children[1], bind_name).not()
}

// #254: type-check a C-like switch in place, leaving its Switch/Case nodes for
// the backends instead of desugaring to if/elif. Each case body is inferred in
// its own child scope, mirroring infer_if_stmt's branch handling. For an enum
// scrutinee, runs the same coverage/exhaustiveness checks as the desugar path;
// an exhaustive enum switch with no `case:` turns its last case into the
// default so the emitted C switch has a terminal arm (no -Wreturn-type).
priv infer_clike_switch := proc(mut scope: TypeScope, mut stmt: Expr, enum_def_o: Option(ref Expr), in_func: I32, in_loop: I32, returns_ref: I32, mut ctx: Context) {
    ref sw_expr : Expr = stmt.children[0]
    sw_sname_o := expr_type_name_ref(sw_expr)
    mut is_enum := false
    is_bool := type_is_primitive(sw_expr.til_type(), Primitive.Bool)
    mut bool_labels := 0
    mut coverage := CoverageNode()
    if enum_def_o.is_some() {
        ref edef : Expr = enum_def_o.unwrap()
        is_enum = true
        init_coverage_for_enum(coverage, edef)
    }
    mut has_default := false
    mut default_line : U32 = 0
    mut default_col : U32 = 0
    mut last_case_idx : USize = 0
    mut has_last_case := false
    for ci in 1..stmt.children.len() {
        ref mut cn : Expr = stmt.children[ci]
        body_idx := cn.children.len() - 1
        pc := case_pattern_count(cn)
        if pc == 0 {
            has_default = true
            default_line = cn.line
            default_col = cn.col
        } else {
            if is_enum {
                ref sw_sname : Str = sw_sname_o.unwrap()
                ref edef : Expr = enum_def_o.unwrap()
                // #334: every pattern of the case counts toward coverage.
                // Payload bindings only exist on single-pattern cases (a
                // binding pattern sharing a case is rejected before the
                // clike dispatch), so the binding prepend stays keyed to
                // children[0].
                for pi in 0..pc {
                    mark_pattern_coverage(scope, coverage, sw_sname, edef, cn.children[pi])
                }
                stole_box := steal_own_param_payload_returns(scope, edef, sw_expr, cn, ctx)
                prepend_clike_payload_binding(scope, edef, sw_expr, cn, stole_box)
            }
            // A multi-pattern bool case can cover both labels on its own.
            if is_bool { bool_labels = bool_labels + pc.to_i64() }
            last_case_idx = ci
            has_last_case = true
        }
        ref mut case_body : Expr = cn.children[body_idx]
        mut case_scope := TypeScope(parent = Option(ref TypeScope).Some(scope))
        infer_body(case_scope, case_body, in_func, 1, in_loop, returns_ref, 0, ctx)
        garbager_destroy_body(ctx, case_body, case_scope)
        check_unused_locals(case_scope, ctx.path, ctx)
        check_unused_mut_locals(case_scope, ctx.path, ctx)
    }
    if is_enum {
        ref sw_sname : Str = sw_sname_o.unwrap()
        ref edef2 : Expr = enum_def_o.unwrap()
        mut missing := Vec(Str).new()
        collect_missing_paths(scope, coverage, edef2, "", missing, ctx)
        if has_default {
            if missing.len() == 0 {
                type_error_at(ctx.path, default_line, default_col, format("unnecessary default `case:`; all variants of enum '", sw_sname, "' are already covered"), ctx)
            }
        } else if missing.len() > 0 {
            mut msg := format("non-exhaustive switch on enum '", sw_sname, "'; missing cases:")
            for mp : Str in missing {
                if msg.ends_with(":").not() { msg = format(msg, ",") }
                msg = format(msg, " ", mp)
            }
            stmt.type_error(msg, ctx)
        } else if has_last_case {
            ref mut last_cn : Expr = stmt.children[last_case_idx]
            mut bvec := Vec(Expr).new()
            bvec.push_take(last_cn.children, last_cn.children.len() - 1)
            last_cn.children.move_from(own bvec)
            // The case is [body] now; the payload must say so or every
            // shape reader downstream miscounts (#334).
            switch last_cn.node_type {
            case .Case(last_cd): last_cd.pattern_count = 0
            case:
            }
        }
    } else if is_bool {
        // A bool switch covering both true and false with no `case:` is
        // exhaustive; turn the last case into the default so the emitted C
        // switch has a terminal arm (C does not know bool is only 0/1).
        if has_default.not().and(bool_labels.eq(2)).and(has_last_case) {
            ref mut last_cn : Expr = stmt.children[last_case_idx]
            mut bvec := Vec(Expr).new()
            bvec.push_take(last_cn.children, last_cn.children.len() - 1)
            last_cn.children.move_from(own bvec)
            switch last_cn.node_type {
            case .Case(last_cd): last_cd.pattern_count = 0
            case:
            }
        }
    }
    stmt.set_til_type(Type.None)
}

// #341: the receiver of a leading-dot case pattern. The parser emits
// `.Body` as `FieldAccess("Body")(Ident(""))` -- the qualified shape with
// the enum name left blank, because only the switch subject knows it.
// Returns the empty-Ident child of `pat` to fill in, or None. Sees through
// the FCall wrapper a payload binding adds (`.Decl(dd)`).
priv dotted_pattern_receiver := func(pat: Expr) returns Option(ref Expr) {
    mut fa_o : Option(ref Expr) = Option(ref Expr).None
    if pat.node_type.is(NodeType.FieldAccess) {
        fa_o = Option(ref Expr).Some(pat)
    } else if pat.node_type.is(NodeType.FCall).and(pat.children.len().gt(0)) {
        if pat.children[0].node_type.is(NodeType.FieldAccess) {
            fa_o = Option(ref Expr).Some(pat.children[0])
        }
    }
    if fa_o.is_none() { return Option(ref Expr).None }
    ref fa : Expr = fa_o.unwrap()
    if fa.children.len() == 0 { return Option(ref Expr).None }
    ref mut recv : Expr = fa.children[0]
    switch recv.node_type {
    case .Ident(rid):
        if rid.ident_name().len() == 0 { return Option(ref Expr).Some(recv) }
    case:
    }
    return Option(ref Expr).None
}

// #341: fill in the enum name a leading-dot expression elided, taking it
// from the type the position expects (`s : Shape = .Nothing`, an argument
// at an enum-typed parameter, a return, an enum-typed field). A no-op when
// `e` is not a dotted expression or the expectation is not an enum -- the
// position's own type check reports the mismatch, and a dotted expression
// with no enum to resolve against is caught by infer_ident_expr's "needs a
// known enum type in this position".
priv qualify_dotted_expr := func(e: Expr, expected: Type) {
    mut recv_o := dotted_pattern_receiver(e)
    if recv_o.is_none() { return }
    if expected.is(Type.Enum).not() { return }
    ename := til_type_name(expected)
    if ename.len() == 0 { return }
    ref mut recv : Expr = recv_o.unwrap()
    recv.node_type = ident_node(ename)
}

// #341: rewrite every `case .Variant:` in this switch/match into the fully
// qualified `case Enum.Variant:`, so every later pass keeps seeing exactly
// what it sees today. A dotted pattern over a non-enum subject has no enum
// to resolve against and is rejected here rather than left to fail as a
// baffling "no variant" further down.
priv qualify_dotted_case_patterns := proc(stmt: Expr, sw_type: Type, mut ctx: Context) {
    sname := til_type_name(sw_type)
    for ci in 1..stmt.children.len() {
        ref cnode : Expr = stmt.children[ci]
        if cnode.node_type.is(NodeType.Case).not() { continue }
        for pi in 0..case_pattern_count(cnode) {
            mut recv_o := dotted_pattern_receiver(cnode.children[pi])
            if recv_o.is_none() { continue }
            if sw_type.is(Type.Enum).not().or(sname.len() == 0) {
                cnode.children[pi].type_error("a leading-dot pattern needs an enum subject: the elided name is the subject's enum, and this switch's subject is not one -- write the pattern out in full (issue #341)", ctx)
            }
            // Fill in the subject's name even when it is not an enum: the
            // error above already says what is wrong, and leaving the empty
            // marker in place makes the follow-on diagnostics talk about a
            // symbol named "" -- which reads like a compiler bug.
            mut recv_name := sname.clone()
            if recv_name.len() == 0 { recv_name = type_to_name(sw_type) }
            ref mut recv : Expr = recv_o.unwrap()
            recv.node_type = ident_node(recv_name)
        }
    }
}

priv infer_switch_stmt := proc(mut scope: TypeScope, mut body: Expr, stmt_idx: USize, in_func: I32, in_loop: I32, returns_ref: I32, mut ctx: Context) returns Bool {
    ref mut stmt : Expr = body.children[stmt_idx]
    ref mut sw_expr : Expr = stmt.children[0]
    sw_line := stmt.line
    sw_col := stmt.col
    // Issue #244: a Match node rides the same desugar -- it is a switch whose
    // arms yield a value. The only difference: each arm body is a single
    // value-expression, which we wrap into `result_temp = <value>` up front so
    // every downstream step (conditions, payload bindings, guards, coverage,
    // unreachable/exhaustiveness diagnostics, if/elif building) is shared
    // verbatim with switch. The result temp itself is declared by the lowering
    // (it must live in the enclosing scope, not this block's scope).
    is_match := stmt.node_type.is(NodeType.Match)
    // Issue #262: a ListPattern case head is only legal on the variadic param
    // of a recursive variadic lazy body, where the loader's recursion-unroll
    // consumes it before typing. One surviving here is a misuse -- reject it
    // loudly instead of letting the pattern desugar into nonsense.
    for lp_ci in 1..stmt.children.len() {
        ref lp_case : Expr = stmt.children[lp_ci]
        if lp_case.node_type.is(NodeType.Case).and(lp_case.children.len().gt(1)) {
            if lp_case.children[0].node_type.is(NodeType.ListPattern) {
                lp_case.type_error("list patterns ('[]', '[x, ..tl]') are only supported matching the variadic param of a recursive variadic lazy_func/lazy_proc body (issue #262)", ctx)
                return false
            }
            // #334: patterns sharing a case must be pure comparisons. An
            // FCall pattern other than a range is a payload binding, a
            // struct pattern, or a call -- shapes that can bind names or
            // prepend per-pattern statements, which have no meaning when
            // several patterns pick one body. Split those into their own
            // cases.
            mp_count := case_pattern_count(lp_case)
            if mp_count > 1 {
                for mp_pi in 0..mp_count {
                    ref mp_pat : Expr = lp_case.children[mp_pi]
                    if mp_pat.node_type.is(NodeType.FCall).and(is_range_new_call(mp_pat).not()) {
                        lp_case.type_error("a payload binding, struct pattern, or call pattern cannot share a case with other patterns; give it its own case (issue #334)", ctx)
                        return false
                    }
                }
            }
        }
    }
    mut kind_word := "switch"
    mut result_temp := ""
    if is_match {
        kind_word = "match"
        switch stmt.node_type {
        case .Match(md): result_temp = md.result_temp.clone()
        case:
        }
        for tci in 1..stmt.children.len() {
            ref mut tcase : Expr = stmt.children[tci]
            tbody_idx := tcase.children.len() - 1
            ref mut tvbody : Expr = tcase.children[tbody_idx]
            mut tvalue : Expr = tvbody.children.pop()
            while match_is_bool_identity(tvalue) { tvalue = tvalue.children[0].clone() }
            // An arm value that is itself a match sits in tail position: hand
            // it THIS match's result temp so its own arms assign straight to
            // it (infer_body_stmt desugars a temp-tagged Match like a switch).
            // Otherwise every level of a right-nested chain -- what unrolling a
            // recursive variadic lazy body produces -- would hoist a fresh
            // temp, a block and a copy back into the level above it.
            if tvalue.node_type.is(NodeType.Match) {
                switch tvalue.node_type {
                case .Match(imd): imd.result_temp = result_temp.clone()
                case:
                }
                tvbody.add_child(own tvalue)
            } else {
                mut tassign := Expr.new(NodeType.Assign(AssignData(name = result_temp.clone())), tvbody.line, tvbody.col)
                tassign.add_child(own tvalue)
                tvbody.add_child(own tassign)
            }
        }
    }
    infer_expr(scope, sw_expr, in_func, ctx)
    // #154: case patterns (`case Color.Red:`) textually reference the
    // subject's enum; credit its declaring file so a pattern-only use
    // doesn't flag the import as unused. Must sit BEFORE the clike
    // dispatch -- payload-free enums lower through infer_clike_switch
    // and return early.
    if sw_expr.til_type().is(Type.Enum) {
        sw_name_o := expr_type_name_ref(sw_expr)
        if sw_name_o.is_some() {
            ref sw_name : Str = sw_name_o.unwrap()
            note_cross_file_type_use(scope, ctx, sw_name)
        }
    }
    // #341: `case .Body:` -- fill in the enum the parser could not know.
    // Must sit here: after the subject is inferred (that is where the name
    // comes from) and before the clike dispatch below, which returns early
    // for payload-free enums.
    qualify_dotted_case_patterns(stmt, sw_expr.til_type(), ctx)
    sw_expr_sname_o := expr_type_name_ref(sw_expr)
    mut switch_enum_def_o := Option(ref Expr).None
    if sw_expr.til_type().is(Type.Enum).and(sw_expr_sname_o.is_some()) {
        ref sw_expr_sname : Str = sw_expr_sname_o.unwrap()
        switch_enum_def_o = scope.get_struct(sw_expr_sname)
    }
    if switch_is_clike(stmt, sw_expr, is_match, switch_enum_def_o) {
        infer_clike_switch(scope, stmt, switch_enum_def_o, in_func, in_loop, returns_ref, ctx)
        return false
    }
    mut coverage := CoverageNode()
    mut has_default_case := false
    mut has_switch_enum_def := false
    if switch_enum_def_o.is_some() {
        ref switch_enum_def : Expr = switch_enum_def_o.unwrap()
        if switch_enum_def.node_type.is(NodeType.EnumDef) {
            has_switch_enum_def = true
            init_coverage_for_enum(coverage, switch_enum_def)
        }
    }

    mut sw_ref := Expr.new(NodeType.Literal(Literal.Null), sw_line, sw_col)
    mut block := Expr.new(NodeType.Body, stmt.line, stmt.col)
    // #196.B: Never hoist enum-typed subjects. A hoisted local would be
    // either a shallow value copy (whose destructor frees aliased Vec/Str
    // pointers and corrupts the source AST in compile mode) or a deep
    // clone (whose destructor frees clone-owned strings that downstream
    // case-bindings expose via CAP_VIEW pointers in callers like
    // ffi_register). Re-evaluate sw_expr per case condition instead.
    // A match whose SUBJECT is another match of the same type is the mirror of
    // the tail-position case handled above -- and it is the shape every
    // left-associative chain has: `a && b && c`, `a.and(b).and(c)`, or nested
    // matches written by hand. Lowering it as a plain subject would hoist a
    // temp of its own and copy it here, one per operand. Instead give it THIS
    // result temp and switch on that: the subject writes the temp, `_sw` reads
    // it back before any arm assigns, and a whole chain costs one temp.
    mut subject_shares_temp := false
    if is_match.and(sw_expr.node_type.is(NodeType.Match)) {
        rt_bind_o := scope.get_binding(result_temp)
        if rt_bind_o.is_some() {
            ref rt_bind : TypeBinding = rt_bind_o.unwrap()
            subject_shares_temp = type_to_name(rt_bind.type) == type_to_name(sw_expr.til_type())
        }
    }
    if subject_shares_temp {
        mut subj_match := sw_expr.clone()
        switch subj_match.node_type {
        case .Match(smd): smd.result_temp = result_temp.clone()
        case: UNREACHABLE("expected Match, got ", subj_match.node_type.head_str())
        }
        block.add_child(own subj_match)
        sw_ref = Expr.new(ident_node(result_temp), sw_line, sw_col)
    } else if is_simple_lvalue_expr(sw_expr).or(sw_expr.til_type().is(Type.Enum)) {
        sw_ref = sw_expr.clone()
    } else {
        tp := type_prefix(sw_expr.til_type())
        sw_name := format("_sw_", tp, "_", synth_suffix(ctx, ctx.hoist_counter.to_str()))
        ctx.hoist_counter++
        mut decl := Expr.new(NodeType.Decl(Declaration(name = sw_name.clone())), stmt.line, stmt.col)
        decl.add_child(own sw_expr.clone())
        block.add_child(own decl)
        sw_ref = Expr.new(ident_node(sw_name), sw_line, sw_col)
    }

    // Issue #199: a Case with 3 children is `[pattern, guard, body]`; with
    // 2 children it's `[pattern, body]`. When ANY case in this switch has
    // a guard we can't use a plain if/elif chain -- a failed guard must
    // fall through to the next case, which an if/elif chain cannot model.
    // Instead we hoist a `_sw_matched_<n> := false` flag and emit each
    // case as an independent `if _sw_matched.not().and(cond) { body;
    // _sw_matched = true }`. Guards become an inner `if <guard> { ...
    // _sw_matched = true }` wrapped around the user body so a failed
    // guard leaves _sw_matched false and the next case runs. Plain
    // switches keep the cheaper if/elif chain.
    mut any_guard := false
    for ag_ci in 1..stmt.children.len() {
        ref ag_cn : Expr = stmt.children[ag_ci]
        if case_has_guard(ag_cn) { any_guard = true }
    }

    mut first_if := Expr.new(NodeType.Body, stmt.line, stmt.col)
    mut has_first_if := false
    mut default_body := Expr.new(NodeType.Body, stmt.line, stmt.col)
    mut has_default_body := false
    // For an exhaustive enum switch with no `case:`, the if/elif chain
    // would have no terminal else and C's -Wreturn-type would fire on
    // value-returning funcs. Stash the last non-guarded case body so we
    // can attach it as the synthetic terminal else after the loop.
    mut last_case_body := Expr.new(NodeType.Body, stmt.line, stmt.col)
    mut has_last_case_body := false

    mut matched_name := ""
    if any_guard {
        matched_name = format("_sw_matched_", synth_suffix(ctx, ctx.hoist_counter.to_str()))
        ctx.hoist_counter++
        mut matched_decl := Expr.new(NodeType.Decl(Declaration(name = matched_name.clone(), is_mut = true, explicit_type = "Bool", til_type = Type.Primitive(Primitive.Bool), own_type = OwnType.Shallow)), stmt.line, stmt.col)
        matched_decl.add_child(own Expr.new(NodeType.Literal(Literal.Bool(false)), stmt.line, stmt.col))
        block.add_child(own matched_decl)
    }

    // Dead-arm detection: any case after a default arm is unreachable
    // (the default absorbs everything earlier cases didn't match). Tracked
    // here as a flag rather than re-scanning the case vec per case.
    mut saw_default := false
    mut default_line : U32 = 0
    mut default_col : U32 = 0

    // #282: once an earlier case's guard/body can leave _err_kind set (a `?`
    // throw), the following independent case `if`s must be gated on
    // `_err_kind == 0` so they don't run after a throw. Tracks that state
    // across the case loop (only meaningful on the any_guard path).
    mut switch_can_throw := false

    for ci in 1..stmt.children.len() {
        ref mut case_node : Expr = stmt.children[ci]
        pat_count := case_pattern_count(case_node)
        if pat_count == 0 {
            if saw_default {
                case_node.type_error("unreachable default arm; an earlier `case:` already covers everything", ctx)
            }
            default_body = case_node.children[0].clone()
            has_default_body = true
            has_default_case = true
            saw_default = true
            default_line = case_node.line
            default_col = case_node.col
            continue
        }
        has_guard := case_has_guard(case_node)
        body_idx := case_node.children.len() - 1
        ref match_expr : Expr = case_node.children[0]
        ref mut case_body : Expr = case_node.children[body_idx]
        // #334: every pattern of the case is validated and coverage-marked;
        // an arm matches when ANY of them does, so unreachability holds only
        // if each pattern is already covered.
        mut all_covered := true
        for vp_i in 0..pat_count {
            ref vp_pat : Expr = case_node.children[vp_i]
            validate_struct_pattern_rest(scope, vp_pat, ctx)
            if has_switch_enum_def.and(has_guard.not()) {
                ref sw_expr_sname : Str = sw_expr_sname_o.unwrap()
                ref switch_enum_def : Expr = switch_enum_def_o.unwrap()
                if is_pattern_covered(scope, coverage, sw_expr_sname, switch_enum_def, vp_pat).not() { all_covered = false }
            }
        }
        if saw_default {
            case_node.type_error("unreachable case; an earlier `case:` default already covers everything", ctx)
        } else if has_switch_enum_def.and(has_guard.not()).and(all_covered) {
            case_node.type_error("unreachable case; the variant is already fully covered by an earlier arm", ctx)
        }
        // Guards may fail at runtime, so they don't mark the pattern as
        // covered for exhaustiveness.
        if has_switch_enum_def.and(has_guard.not()) {
            ref sw_expr_sname : Str = sw_expr_sname_o.unwrap()
            ref switch_enum_def : Expr = switch_enum_def_o.unwrap()
            for mc_i in 0..pat_count {
                mark_pattern_coverage(scope, coverage, sw_expr_sname, switch_enum_def, case_node.children[mc_i])
            }
        }
        user_stmt_count := case_body.children.len()
        // One condition per pattern, OR-chained left to right. Patterns past
        // the first cannot bind (rejected up front), so the extra calls
        // prepend nothing to case_body -- they only build comparisons.
        // take_expr moves the accumulator out before the reassignment, so
        // `condition = or_call` deletes an empty husk, not the subtree the
        // or-call now owns (the make_nested_subject use-after-free).
        mut condition := make_switch_case_condition(scope, case_body, match_expr, sw_ref, sw_line, sw_col)
        for oc_i in 1..pat_count {
            mut next_cond := make_switch_case_condition(scope, case_body, case_node.children[oc_i], sw_ref, sw_line, sw_col)
            mut or_call := make_method_call_fcall(own take_expr(condition), "or", sw_line, sw_col)
            or_call.add_child(own next_cond)
            condition = or_call
        }

        if any_guard {
            // Build the case_body for the flag-based desugar:
            //   [bindings..., if <guard> { user_stmts; _sw_matched = true }]
            //   or (no guard)
            //   [bindings..., user_stmts..., _sw_matched = true]
            total_count := case_body.children.len()
            n_bindings := total_count - user_stmt_count
            mut all_children := case_body.children.take()
            // Lower bound: the bindings plus the guard-if/user-stmts wrapper
            // pushed below.
            mut new_body := Vec(Expr).with_capacity(n_bindings + 2)
            for bi in 0..n_bindings {
                new_body.push_take(all_children, bi)
            }
            mut user_stmts := Expr.new(NodeType.Body, case_node.line, case_node.col)
            for ui in 0..user_stmt_count {
                user_stmts.children.push_take(all_children, n_bindings + ui)
            }
            mut matched_assign := Expr.new(NodeType.Assign(AssignData(name = matched_name.clone())), case_node.line, case_node.col)
            matched_assign.add_child(own Expr.new(NodeType.Literal(Literal.Bool(true)), case_node.line, case_node.col))
            user_stmts.add_child(own matched_assign)

            if has_guard {
                ref guard_expr : Expr = case_node.children[pat_count]
                mut guard_if := Expr.new(NodeType.If, case_node.line, case_node.col)
                guard_if.add_child(own guard_expr.clone())
                guard_if.add_child(own user_stmts)
                // #282: the pre-infer throw pass deliberately left a throwing
                // (bang) call in the guard un-hoisted. Lower it now into
                // new_body, before the guard `if`. new_body is the body of the
                // pattern gate (`if _sw_matched.not().and(pattern) { ... }`),
                // so the call -- and its panic-on-throw check -- run only when
                // the pattern matches; short-circuit preserved.
                if subtree_has_bang(guard_if.children[0]) {
                    lower_guard_bang_calls(scope, guard_if, new_body, body, ctx)
                }
                new_body.push(own guard_if)
            } else {
                for us_i in 0..user_stmts.children.len() {
                    new_body.push_take(user_stmts.children, us_i)
                }
            }
            case_body.children.move_from(own new_body)

            // Outer condition: _sw_matched.not().and(pattern_cond)
            mut not_id := Expr.new(ident_node(matched_name), case_node.line, case_node.col)
            mut not_call := make_method_call_fcall(own not_id, "not", case_node.line, case_node.col)
            mut gated_cond := make_method_call_fcall(own not_call, "and", case_node.line, case_node.col)
            gated_cond.add_child(own condition)

            mut if_node := Expr.new(NodeType.If, case_node.line, case_node.col)
            if_node.add_child(own gated_cond)
            if_node.add_child(own case_body.clone())
            // #282: this case can leave _err_kind set if its guard or body
            // contains a (lowered) throwing call -- detected by a reference to
            // _err_kind. Gate it on `_err_kind == 0` when a PRIOR case could
            // throw, then propagate the flag.
            case_can_throw := subtree_references_name(if_node, "_err_kind")
            if switch_can_throw {
                block.add_child(own make_if_kind_eq_zero_wrap(if_node, case_node.line, case_node.col))
            } else {
                block.add_child(own if_node)
            }
            if case_can_throw { switch_can_throw = true }
        } else {
            mut if_node := Expr.new(NodeType.If, case_node.line, case_node.col)
            if_node.add_child(own condition)
            if_node.add_child(own case_body.clone())
            if has_first_if.not() {
                first_if = if_node
                has_first_if = true
            } else {
                append_switch_else_if(first_if, if_node)
            }
            last_case_body = case_body.clone()
            has_last_case_body = true
        }
    }

    if any_guard {
        if has_default_body {
            mut nid2 := Expr.new(ident_node(matched_name), stmt.line, stmt.col)
            mut ncall2 := make_method_call_fcall(own nid2, "not", stmt.line, stmt.col)
            mut def_if := Expr.new(NodeType.If, stmt.line, stmt.col)
            def_if.add_child(own ncall2)
            def_if.add_child(own default_body.clone())
            // #282: skip the default too if an earlier case's guard threw.
            if switch_can_throw {
                block.add_child(own make_if_kind_eq_zero_wrap(def_if, stmt.line, stmt.col))
            } else {
                block.add_child(own def_if)
            }
        }
    } else {
        if has_default_body.and(has_first_if) {
            attach_switch_default_body(first_if, default_body)
        } else if has_default_body.and(has_first_if.not()) {
            first_if = default_body.clone()
            has_first_if = true
        }
    }

    if has_switch_enum_def {
        ref sw_expr_sname : Str = sw_expr_sname_o.unwrap()
        ref switch_enum_def : Expr = switch_enum_def_o.unwrap()
        mut missing_paths := Vec(Str).new()
        collect_missing_paths(scope, coverage, switch_enum_def, "", missing_paths, ctx)
        if has_default_case {
            if missing_paths.len() == 0 {
                type_error_at(ctx.path, default_line, default_col, format("unnecessary default `case:`; all variants of enum '", sw_expr_sname, "' are already covered"), ctx)
            }
        } else if missing_paths.len() > 0 {
            mut msg := format("non-exhaustive ", kind_word, " on enum '", sw_expr_sname, "'; missing cases:")
            for mp : Str in missing_paths {
                if msg.ends_with(":").not() { msg = format(msg, ",") }
                msg = format(msg, " ", mp)
            }
            stmt.type_error(msg, ctx)
        } else if any_guard.not().and(has_first_if).and(has_last_case_body) {
            // Exhaustive enum switch, no `case:`, no guards: attach a clone
            // of the last case body as the chain's terminal else so C sees
            // an unconditional return path. By exhaustiveness the duplicate
            // body never runs at the source level; it exists purely so the
            // generated C compiles under -Wreturn-type.
            attach_switch_default_body(first_if, last_case_body)
        }
    }
    // Issue #244: a match must yield a value on every path. The enum case is
    // covered above (same check switch uses); for any other subject, require an
    // explicit `case:` default. switch has no such requirement, so this is the
    // one place the two forms genuinely diverge.
    if is_match.and(has_switch_enum_def.not()).and(has_default_case.not()) {
        stmt.type_error("non-exhaustive match; add a 'case:' default arm to cover the remaining values", ctx)
    }

    if has_first_if { block.add_child(own first_if.clone()) }
    replace_switch_stmt_with_block(body, stmt_idx, own block)
    return true
}

// A range's direction is a RUNTIME question in general -- `a..b` counts up
// when a <= b and down otherwise -- so the desugar below emits both loops
// and picks between them with an `if`, which means the loop body is built,
// typed and emitted TWICE. For the overwhelmingly common shapes the answer
// is knowable here, and then only one loop needs to exist:
//
//   1 = ascending, -1 = descending, 0 = not known
//
// Two shapes qualify. Both bounds numeric literals: compare them. Or a
// literal 0 start with an UNSIGNED element type: nothing unsigned is less
// than 0, so `0 <= end` holds for every value end can take. That second
// one is `for i in 0..v.len()`, 418 of this repo's 535 range loops.
//
// Deliberately NOT extended to a literal 1 (or any other positive) start:
// `for i in 1..v.len()` over an EMPTY vec descends today and runs the body
// once with i = 1. That is almost certainly not what anyone means, but it
// is the language's current answer and this commit is not the place to
// change it.
priv range_static_direction := func(start_expr: Expr, end_expr: Expr, elem_t: Type) returns I32 {
    mut start_lit := ""
    switch start_expr.node_type {
    case .Literal(Literal.Num(sn)): start_lit = Str.clone(sn.literal_num_text())
    case:
    }
    if start_lit.len() == 0 { return 0 }
    mut end_lit := ""
    switch end_expr.node_type {
    case .Literal(Literal.Num(en)): end_lit = Str.clone(en.literal_num_text())
    case:
    }
    if end_lit.len() > 0 {
        if start_lit.to_i64() <= end_lit.to_i64() { return 1 }
        return -1
    }
    if start_lit.to_i64() != 0 { return 0 }
    switch elem_t {
    case .Primitive(Primitive.U8): return 1
    case .Primitive(Primitive.U16): return 1
    case .Primitive(Primitive.U32): return 1
    case .Primitive(Primitive.U64): return 1
    case: return 0
    }
}

priv desugar_for_in_range_stmt := proc(mut scope: TypeScope, mut body: Expr, stmt_idx: USize, in_func: I32, mut ctx: Context) returns Bool {
    ref mut stmt : Expr = body.children[stmt_idx]
    ref mut iter : Expr = stmt.children[0]
    if iter.node_type.is(NodeType.FCall).not() { return false }
    if iter.children.len() != 3 { return false }
    ref callee : Expr = iter.children[0]
    switch callee.node_type {
    case .FieldAccess(callee_field):
        if callee_field.field_access_name().eq("new").not() { return false }
    case:
        return false
    }
    if callee.children.len() == 0 { return false }
    ref callee_base : Expr = callee.children[0]
    switch callee_base.node_type {
    case .Ident(callee_name):
        if callee_name.ident_name().eq("Range").not() { return false }
    case:
        return false
    }

    ref mut start_expr : Expr = iter.children[1]
    ref mut end_expr : Expr = iter.children[2]
    infer_expr(scope, start_expr, in_func, ctx)
    infer_expr(scope, end_expr, in_func, ctx)

    mut elem_type := ""
    stmt_tname_o := expr_type_name_ref(stmt)
    if stmt_tname_o.is_some() {
        ref stmt_tname : Str = stmt_tname_o.unwrap()
        elem_type = stmt_tname.clone()
    }
    if elem_type.len() == 0 {
        mut type_src := start_expr
        if start_expr.node_type.is_literal_num().and(end_expr.node_type.is_literal_num().not()) {
            type_src = end_expr
        } else if end_expr.node_type.is_literal_num().and(start_expr.node_type.is_literal_num().not()) {
            type_src = start_expr
        }
        if is_aggregate(type_src.til_type()) {
            ts_sname_o := expr_type_name_ref(type_src)
            if ts_sname_o.is_some() {
                ref ts_sname : Str = ts_sname_o.unwrap()
                elem_type = ts_sname.clone()
            } else {
                elem_type = type_to_name(type_src.til_type())
            }
        } else {
            elem_type = type_to_name(type_src.til_type())
        }
    }

    mut var_name := ""
    mut forin_is_mut := false
    switch stmt.node_type {
    case .ForIn(forin_data_r):
        var_name = forin_data_r.name.clone()
        forin_is_mut = forin_data_r.is_mut
    case:
        UNREACHABLE("expected ForIn, got ", stmt.node_type.head_str())
        return false
    }
    ref for_body : Expr = stmt.children[1]
    line := stmt.line
    col := stmt.col
    counter := synth_suffix(ctx, ctx.hoist_counter.to_str())
    ctx.hoist_counter++

    end_name := format("_re_", elem_type, "_", counter)
    cur_name := format("_rc_", elem_type, "_", counter)

    mut block := Expr.new(NodeType.Body, line, col)

    mut end_decl := Expr.new(NodeType.Decl(decl_typed(name = end_name, explicit_type = elem_type)), line, col)
    end_decl.add_child(own end_expr.clone())
    block.add_child(own end_decl)

    mut cur_decl := Expr.new(NodeType.Decl(decl_typed(name = cur_name, explicit_type = elem_type, is_mut = true)), line, col)
    cur_decl.add_child(own start_expr.clone())
    block.add_child(own cur_decl)

    // One direction proven means one loop: the other while is never built,
    // so the body is not cloned, typed or emitted a second time. Every arm
    // assigns the SAME `loop_node` and falls through to the one add_child
    // below, so `block` keeps exactly one owner-transfer site.
    dir := range_static_direction(start_expr, end_expr, type_from_name(elem_type, scope, ctx))
    mut loop_node := Expr.new(NodeType.Body, line, col)

    if dir != 0 {
        mut only_cur := Expr.new(ident_node(cur_name), line, col)
        mut only_cmp := Expr.new(NodeType.Body, line, col)
        mut only_body := Expr.new(NodeType.Body, line, col)
        if dir > 0 {
            only_cmp = make_method_call_fcall(own only_cur, "lt", line, col)
            only_body = make_for_in_range_while_body(var_name, cur_name, "inc", for_body, line, col, elem_type, forin_is_mut)
        } else {
            only_cmp = make_method_call_fcall(own only_cur, "gt", line, col)
            only_body = make_for_in_range_while_body(var_name, cur_name, "dec", for_body, line, col, elem_type, forin_is_mut)
        }
        mut only_end := Expr.new(ident_node(end_name), line, col)
        only_cmp.add_child(own only_end)
        loop_node = Expr.new(NodeType.While, line, col)
        loop_node.add_child(own only_cmp)
        loop_node.add_child(own only_body)
    } else {
        mut cur_ident_lt := Expr.new(ident_node(cur_name), line, col)
        mut lt_call := make_method_call_fcall(own cur_ident_lt, "lt", line, col)
        mut end_ident_lt := Expr.new(ident_node(end_name), line, col)
        lt_call.add_child(own end_ident_lt)
        mut asc_while := Expr.new(NodeType.While, line, col)
        asc_while.add_child(own lt_call)
        asc_while.add_child(own make_for_in_range_while_body(var_name, cur_name, "inc", for_body, line, col, elem_type, forin_is_mut))

        mut cur_ident_gt := Expr.new(ident_node(cur_name), line, col)
        mut gt_call := make_method_call_fcall(own cur_ident_gt, "gt", line, col)
        mut end_ident_gt := Expr.new(ident_node(end_name), line, col)
        gt_call.add_child(own end_ident_gt)
        mut desc_while := Expr.new(NodeType.While, line, col)
        desc_while.add_child(own gt_call)
        desc_while.add_child(own make_for_in_range_while_body(var_name, cur_name, "dec", for_body, line, col, elem_type, forin_is_mut))

        mut cur_ident_lte := Expr.new(ident_node(cur_name), line, col)
        mut lte_call := make_method_call_fcall(own cur_ident_lte, "lte", line, col)
        mut end_ident_lte := Expr.new(ident_node(end_name), line, col)
        lte_call.add_child(own end_ident_lte)
        loop_node = Expr.new(NodeType.If, line, col)
        loop_node.add_child(own lte_call)

        mut then_body := Expr.new(NodeType.Body, line, col)
        then_body.add_child(own asc_while)
        loop_node.add_child(own then_body)

        mut else_body := Expr.new(NodeType.Body, line, col)
        else_body.add_child(own desc_while)
        loop_node.add_child(own else_body)
    }
    block.add_child(own loop_node)

    replace_body_stmt_with_block(body, stmt_idx, own block)
    return true
}

priv desugar_for_in_collection_stmt := proc(mut scope: TypeScope, mut body: Expr, stmt_idx: USize, in_func: I32, mut ctx: Context) returns Bool {
    ref mut stmt : Expr = body.children[stmt_idx]
    ref mut iter : Expr = stmt.children[0]

    infer_expr(scope, iter, in_func, ctx)

    mut type_name := ""
    if is_aggregate(iter.til_type()) {
        iter_sname_o := expr_type_name_ref(iter)
        if iter_sname_o.is_some() {
            ref iter_sname : Str = iter_sname_o.unwrap()
            type_name = iter_sname.clone()
        }
    }
    if type_name.len() == 0 {
        stmt.type_error("for-in requires a collection type with get() and len() methods", ctx)
        return false
    }

    sdef_o := scope.get_struct(type_name)
    if sdef_o.is_none() {
        stmt.type_error("for-in requires a collection type with get() and len() methods", ctx)
        return false
    }
    ref sdef : Expr = sdef_o.unwrap()

    len_funco := find_namespace_func(sdef, "len", scope)
    // Issue #284: prefer an unchecked accessor when the collection offers
    // one. The desugared index runs exactly 0..len(), so the loop's own
    // `_fi < len()` test already proves the access in bounds -- the
    // per-element bounds check inside the throwing `get` is pure redundancy.
    // Because unsafe_get is non-throwing, the whole get_throws branch below
    // (err out-params, malloc(OutOfBounds) slot, post-call _err_kind check)
    // is never emitted; the loop body collapses to one compare + ptr
    // arithmetic. Falls back to `get` for collections without unsafe_get.
    mut method_name := "unsafe_get"
    if find_namespace_func(sdef, "unsafe_get", scope).is_none() {
        method_name = "get"
    }
    mut get_funco := find_namespace_func(sdef, method_name, scope)

    if len_funco.is_none() {
        stmt.type_error(format("type '", type_name, "' has no 'len' method (required for for-in)"), ctx)
        return false
    }
    ref len_func : Expr = len_funco.unwrap()
    mut idx_type := ""
    ref len_def : FunctionDef = funcdef_of(len_func)
    if len_def.params.len().neq(1).or(len_def.return_type.len().eq(0)) {
        stmt.type_error(format("type '", type_name, "' len() must take 1 param and return a scalar for for-in"), ctx)
        return false
    }
    idx_type = len_def.return_type.clone()

    if get_funco.is_none() {
        stmt.type_error(format("type '", type_name, "' has no 'get' method (required for for-in)"), ctx)
        return false
    }
    ref mut get_func : Expr = get_funco.unwrap()
    mut elem_type := ""
    stmt_tname_o := expr_type_name_ref(stmt)
    if stmt_tname_o.is_some() {
        ref stmt_tname : Str = stmt_tname_o.unwrap()
        elem_type = stmt_tname.clone()
    }
    mut get_returns_ref := false
    mut get_throws := false
    mut get_throw_types := Vec(Str).new()
    // Issue #281: a get() may carry trailing defaulted params (e.g.
    // `loc: Str = __LOC__`). The for-in hand-builds the get call below, so it
    // must fill those itself; capture their default expressions here while
    // get_def is in scope. Empty (no-op) for the common get(self, i) shape.
    mut get_trailing_defaults := Vec(Expr).new()
    ref mut get_def : FunctionDef = funcdef_of(get_func)
    // A throwing get gets its signature extended in place with
    // synthetic _err_kind/payload params below. Allow either
    // the original (self, idx) shape or the already-extended one
    // -- the original 2-param form is what user code wrote, and
    // any subsequent for-in over the same type sees the extended
    // shape because we mutated its FuncDef.
    if get_def.params.len() < 2 {
        stmt.type_error(format("type '", type_name, "' get() second param must match len() return type for for-in"), ctx)
        return false
    }
    ref get_idx_param : Declaration = get_def.params[1]
    if get_idx_param.explicit_type.len().eq(0).or(get_idx_param.explicit_type.eq(idx_type).not()) {
        stmt.type_error(format("type '", type_name, "' get() second param must match len() return type for for-in"), ctx)
        return false
    }
    if elem_type.len() == 0 {
        if get_def.return_type.len().eq(0).or(get_def.return_type.eq("Dynamic")) {
            stmt.type_error(format("cannot infer element type for '", type_name, "', use explicit type: for x : Type in ..."), ctx)
            return false
        }
        elem_type = get_def.return_type.clone()
    }
    get_returns_ref = get_def.return_own_type.is(OwnType.Ref)
    get_throws = get_def.throw_types.len() > 0
    if get_throws {
        for gtn : Str in get_def.throw_types {
            get_throw_types.push(own gtn.clone())
        }
        // Extend the get FuncDef in place with the synthetic
        // _err_kind plus payload-bearing out-params so the call we emit
        // below matches the
        // callee's arity. Idempotent: only extends once.
        mut already_extended := false
        for p : Declaration in get_def.params {
            if p.name == "_err_kind" { already_extended = true }
        }
        if already_extended.not() {
            append_err_out_params(get_def.params, get_def.throw_types, ctx)
        }
    }
    // Issue #281: capture any params beyond self + idx (+ the err out-args
    // for a throwing get) -- the trailing defaulted params (e.g. a
    // `loc: Str = __LOC__`) the hand-built call below must fill itself.
    mut forin_filled : USize = 1
    if get_throws {
        // _err_kind is always present; fieldless throws carry no slot.
        forin_filled++
        for gtn : Str in get_throw_types {
            if throw_type_has_payload(ctx, gtn) { forin_filled++ }
        }
    }
    for tp_i in forin_filled.add(1)..get_def.params.len() {
        get_trailing_defaults.push(own get_def.params[tp_i].default_expr().clone())
    }

    mut var_name := ""
    mut forin_is_mut := false
    switch stmt.node_type {
    case .ForIn(forin_data_c):
        var_name = forin_data_c.name.clone()
        forin_is_mut = forin_data_c.is_mut
    case:
        UNREACHABLE("expected ForIn, got ", stmt.node_type.head_str())
        return false
    }
    // A `for mut x in coll` mutates coll's elements through the element
    // ref, so coll's `mut` qualifier is justified. Mark its root binding
    // written here -- otherwise check_unused_mut_locals later flags
    // `mut coll` as "never written through", forcing the user to drop a
    // `mut` that actually reflects the loop's intent.
    if forin_is_mut {
        mark_written_through(scope, iter)
        check_write_roots_mut(scope, stmt, iter, "mutate the elements of this collection", ctx)
    }
    ref for_body : Expr = stmt.children[1]
    line := stmt.line
    col := stmt.col

    counter := synth_suffix(ctx, ctx.hoist_counter.to_str())
    ctx.hoist_counter++
    col_name := format("_fc_", type_name, "_", counter)
    idx_name := format("_fi_USize_", counter)

    mut block := Expr.new(NodeType.Body, line, col)

    // When iter is an lvalue (ident or field access), bind _fc as a ref to
    // alias the source instead of letting infer_decl_value insert a deep
    // .clone() that would dangle any refs taken out of the loop body.
    // For rvalues (literals, calls), keep the default Shallow so the result
    // gets stored as a value.
    mut col_own_type := OwnType.Shallow
    if iter.node_type.is(NodeType.Ident).or(iter.node_type.is(NodeType.FieldAccess)) {
        col_own_type = OwnType.Ref
    }
    mut col_decl := Expr.new(NodeType.Decl(Declaration(name = col_name.clone(), own_type = col_own_type)), line, col)
    col_decl.add_child(own iter.clone())
    block.add_child(own col_decl)

    mut idx_decl := Expr.new(NodeType.Decl(decl_typed(name = idx_name, explicit_type = idx_type, is_mut = true)), line, col)
    mut zero := Expr.new(literal_num_node("0"), line, col)
    idx_decl.add_child(own zero)
    block.add_child(own idx_decl)

    // For a throwing get, declare block-local err slots: we lower
    // the iteration access as an explicit `get(idx, mut _kind, mut _slot)`
    // followed by `if _kind != 0 { panic(...) }`, instead of routing
    // through the bang/throw-catch pipeline. Self-contained: no extra
    // pre-pass, no fdef-level slot prepend.
    fk_name := format("_forin_err_kind_", counter)
    if get_throws {
        mut kind_decl := Expr.new(NodeType.Decl(Declaration(name = fk_name.clone(),
            explicit_type = "I64", til_type = Type.Primitive(Primitive.I64), is_mut = true)), line, col)
        kind_decl.add_child(own make_int_lit(0, line, col))
        block.add_child(own kind_decl)
        for gtn : Str in get_throw_types {
            if throw_type_has_payload(ctx, gtn).not() { continue }
            slot_name := format("_forin_", gtn, "_", counter)
            mut slot_decl := Expr.new(NodeType.Decl(decl_typed(name = slot_name,
                explicit_type = gtn,
                is_mut = true)), line, col)
            slot_decl.add_child(own make_default_value_expr(gtn, line, col))
            block.add_child(own slot_decl)
        }
    }

    mut while_node := Expr.new(NodeType.While, line, col)

    mut idx_ident_cond := Expr.new(ident_node(idx_name), line, col)
    mut cond_call := make_method_call_fcall(own idx_ident_cond, "lt", line, col)
    mut col_ident_len := Expr.new(ident_node(col_name), line, col)
    cond_call.add_child(own make_method_call_fcall(own col_ident_len, "len", line, col))
    while_node.add_child(own cond_call)

    mut wbody := Expr.new(NodeType.Body, line, col)

    mut forin_own := OwnType.Shallow
    if get_returns_ref { forin_own = OwnType.Ref }
    mut elem_decl := Expr.new(NodeType.Decl(decl_typed(name = var_name, explicit_type = elem_type, own_type = forin_own, is_mut = forin_is_mut)), line, col)
    mut col_ident_get := Expr.new(ident_node(col_name), line, col)
    mut get_call := make_method_call_fcall(own col_ident_get, method_name, line, col)
    mut idx_ident_get := Expr.new(ident_node(idx_name), line, col)
    get_call.add_child(own idx_ident_get)
    if get_throws {
        // Pass the block-local err slots as out-args so the throwing
        // get's extended signature is satisfied without any flag-and-
        // lower roundtrip through the throw/catch pass.
        mut kind_arg := Expr.new(ident_node(fk_name), line, col)
        kind_arg.set_til_type(Type.Primitive(Primitive.I64))
        get_call.add_child(own kind_arg)
        for gtn : Str in get_throw_types {
            if throw_type_has_payload(ctx, gtn).not() { continue }
            slot_name := format("_forin_", gtn, "_", counter)
            mut slot_arg := Expr.new(ident_node(slot_name), line, col)
            slot_arg.set_til_type(til_type_from_explicit_type(gtn))
            get_call.add_child(own slot_arg)
        }
    }
    // Issue #281: fill get's trailing defaulted params (e.g. `loc: Str =
    // __LOC__`). resolve_default_value stamps a __LOC__ default with the for-in
    // loop's location (get_call's coords) -- the loop is the caller. No-op when
    // get_trailing_defaults is empty (the common get(self, i) shape).
    for td : Expr in get_trailing_defaults {
        get_call.add_child(own resolve_default_value(td, get_call, ctx))
    }
    elem_decl.add_child(own get_call)
    wbody.add_child(own elem_decl)

    if get_throws {
        // if _forin_err_kind_<n>.eq(0).not() { panic("<T>") }
        // for-in is the only caller of this get; on-error semantics is
        // panic-with-type-name, matching the user-visible `arr[i]`.
        mut kind_id := Expr.new(ident_node(fk_name), line, col)
        kind_id.set_til_type(Type.Primitive(Primitive.I64))
        mut zero_lit := make_int_lit(0, line, col)
        mut eq_call := make_method_call_fcall(own kind_id, "eq", line, col)
        eq_call.add_child(own zero_lit)
        mut not_call := make_method_call_fcall(own eq_call, "not", line, col)

        ref first_throw : Str = get_throw_types[0]
        mut panic_call := make_uncaught_throw_panic(first_throw, line, col)

        mut panic_body := Expr.new(NodeType.Body, line, col)
        panic_body.add_child(own panic_call)
        mut if_panic := Expr.new(NodeType.If, line, col)
        if_panic.add_child(own not_call)
        if_panic.add_child(own panic_body)
        wbody.add_child(own if_panic)
    }

    mut idx_assign := Expr.new(NodeType.Assign(AssignData(name = idx_name.clone())), line, col)
    mut idx_ident_inc := Expr.new(ident_node(idx_name), line, col)
    mut add_call := make_method_call_fcall(own idx_ident_inc, "add", line, col)
    mut one := Expr.new(literal_num_node("1"), line, col)
    add_call.add_child(own one)
    idx_assign.add_child(own add_call)
    wbody.add_child(own idx_assign)

    for e_bi : Expr in for_body.children {
        wbody.add_child(own e_bi.clone())
    }

    while_node.add_child(own wbody)
    block.add_child(own while_node)
    replace_body_stmt_with_block(body, stmt_idx, own block)
    return true
}

// True when struct/enum def `sdef` declares a field named `field_name`.
priv struct_def_has_field := func(sdef: Expr, field_name: Str) returns Bool {
    switch sdef.node_type {
    case .StructDef(sd):
        return sd.fields_index.has(field_name)
    case:
    }
    return false
}

// Element type of a collection type named `col_type_name`, read off its
// unchecked accessor's (unsafe_get, else get) return type -- the same
// resolution desugar_for_in_collection_stmt uses for the single-variable
// element decl. Returns "" when the type or accessor is missing. The
// element decls need this concrete type explicitly: a typeless `ref`
// decl makes the interpreter copy the value instead of aliasing the
// slot, so a `for k, mut v` write would not persist.
priv collection_elem_type_of := func(scope: TypeScope, col_type_name: Str) returns Str {
    col_sdef_o := scope.get_struct(col_type_name)
    if col_sdef_o.is_none() { return "" }
    ref col_sdef : Expr = col_sdef_o.unwrap()
    mut method_name := "unsafe_get"
    if find_namespace_func(col_sdef, "unsafe_get", scope).is_none() {
        method_name = "get"
    }
    gfo := find_namespace_func(col_sdef, method_name, scope)
    if gfo.is_none() { return "" }
    ref get_func : Expr = gfo.unwrap()
    switch get_func.node_type {
    case .FuncDef(get_def):
        return get_def.return_type.clone()
    case:
        return ""
    }
}

// Issue #287: key-value for-in over maps -- `for k, v in map`.
//
// Maps (Map, HashMap, and the dyn variants) store their entries as two
// index-aligned Vecs, `keys` and `values`. A two-variable for-in lowers
// to a single lockstep index walk over those backing Vecs, going
// straight through the public fields -- no map-level key/value accessor
// is leaked into the desugared loop::
//
//   _fc := ref map
//   _fi := 0
//   while _fi < _fc.keys.len() {
//       ref k : K = _fc.keys.unsafe_get(_fi)     // unchecked: _fi < len
//       ref v : V = _fc.values.unsafe_get(_fi)
//       _fi++
//       <body>
//   }
//
// Like the single-variable collection for-in (#284) this rides
// Vec.unsafe_get, so the loop body is one `_fi < len` compare plus
// pointer arithmetic with no per-element bounds check. The element
// types K/V are resolved and set explicitly (see collection_elem_type_of)
// so the interpreter aliases each slot -- a `for k, mut v` write must
// persist into the map. Returns false for the single-variable form
// (name2 empty), leaving the other for-in desugars to handle it.
priv desugar_for_in_kv_stmt := proc(mut scope: TypeScope, mut body: Expr, stmt_idx: USize, in_func: I32, mut ctx: Context) returns Bool {
    ref mut stmt : Expr = body.children[stmt_idx]

    mut var_name := ""
    mut var_name2 := ""
    mut forin_is_mut := false
    mut forin_is_mut2 := false
    switch stmt.node_type {
    case .ForIn(fid):
        if fid.name2.len() == 0 { return false }
        var_name = fid.name.clone()
        var_name2 = fid.name2.clone()
        forin_is_mut = fid.is_mut
        forin_is_mut2 = fid.is_mut2
    case:
        UNREACHABLE("expected ForIn, got ", stmt.node_type.head_str())
        return false
    }

    // The key of a two-variable for-in cannot be `mut`: mutating a key in
    // place breaks the map's key ordering (Map/DynMap binary search) and
    // bucket placement (HashMap), so a later get/has/set would silently
    // miss. Values may be mutated (`for k, mut v`); keys may not. Flag it
    // and continue as a non-mut key so the rest of typing stays sane.
    if forin_is_mut {
        stmt.type_error("for k, v in map: the key binding cannot be 'mut' -- mutating a key in place breaks the map's key ordering; drop 'mut' on the key (use 'for k, mut v' to mutate values)", ctx)
        forin_is_mut = false
    }

    ref mut iter : Expr = stmt.children[0]
    infer_expr(scope, iter, in_func, ctx)

    // `for [mut] k, mut v in map` mutates the map's keys/values through
    // the element refs, so the map's `mut` is justified -- mark its root
    // binding written so check_unused_mut_locals doesn't later flag a
    // `mut map` whose only writer is this loop.
    if forin_is_mut.or(forin_is_mut2) {
        mark_written_through(scope, iter)
        check_write_roots_mut(scope, stmt, iter, "mutate the entries of this map", ctx)
    }

    mut type_name := ""
    if is_aggregate(iter.til_type()) {
        iter_sname_o := expr_type_name_ref(iter)
        if iter_sname_o.is_some() {
            ref iter_sname : Str = iter_sname_o.unwrap()
            type_name = iter_sname.clone()
        }
    }
    if type_name.len() == 0 {
        stmt.type_error("for k, v in ...: requires a map type with 'keys' and 'values' fields", ctx)
        return false
    }

    sdef_o := scope.get_struct(type_name)
    if sdef_o.is_none() {
        stmt.type_error("for k, v in ...: requires a map type with 'keys' and 'values' fields", ctx)
        return false
    }
    ref sdef : Expr = sdef_o.unwrap()
    if struct_def_has_field(sdef, "keys").not().or(struct_def_has_field(sdef, "values").not()) {
        stmt.type_error(format("type '", type_name, "' has no 'keys'/'values' fields (required for two-variable for-in)"), ctx)
        return false
    }

    ref for_body : Expr = stmt.children[1]
    line := stmt.line
    col := stmt.col
    counter := synth_suffix(ctx, ctx.hoist_counter.to_str())
    ctx.hoist_counter++
    col_name := format("_fc_", type_name, "_", counter)
    idx_name := format("_fi_USize_", counter)

    // Resolve the concrete key/value element types. Probe the inferred
    // map's `keys` / `values` field types (which carry the monomorphized
    // backing-Vec types), then read each element type off the Vec's
    // unsafe_get return -- mirroring the single-variable desugar. These
    // must be set explicitly on the element decls; a typeless `ref` decl
    // makes the interpreter copy rather than alias, so `for k, mut v`
    // writes would not persist.
    mut keys_probe := Expr.new(field_access_node("keys"), line, col)
    keys_probe.add_child(own iter.clone())
    infer_expr(scope, keys_probe, in_func, ctx)
    mut vals_probe := Expr.new(field_access_node("values"), line, col)
    vals_probe.add_child(own iter.clone())
    infer_expr(scope, vals_probe, in_func, ctx)
    mut key_elem := ""
    keys_tname_o := expr_type_name_ref(keys_probe)
    if keys_tname_o.is_some() {
        ref keys_tname : Str = keys_tname_o.unwrap()
        key_elem = collection_elem_type_of(scope, keys_tname)
    }
    mut val_elem := ""
    vals_tname_o := expr_type_name_ref(vals_probe)
    if vals_tname_o.is_some() {
        ref vals_tname : Str = vals_tname_o.unwrap()
        val_elem = collection_elem_type_of(scope, vals_tname)
    }
    if key_elem.len().eq(0).or(val_elem.len().eq(0)) {
        stmt.type_error(format("cannot resolve key/value element types for two-variable for-in over '", type_name, "'"), ctx)
        return false
    }

    mut block := Expr.new(NodeType.Body, line, col)

    // _fc := ref map  (ref when iter is an lvalue, mirroring the
    // single-variable collection desugar; else a shallow value bind).
    mut col_own_type := OwnType.Shallow
    if iter.node_type.is(NodeType.Ident).or(iter.node_type.is(NodeType.FieldAccess)) {
        col_own_type = OwnType.Ref
    }
    mut col_decl := Expr.new(NodeType.Decl(Declaration(name = col_name.clone(), own_type = col_own_type)), line, col)
    col_decl.add_child(own iter.clone())
    block.add_child(own col_decl)

    // _fi := 0
    mut idx_decl := Expr.new(NodeType.Decl(decl_typed(name = idx_name, explicit_type = "USize", is_mut = true)), line, col)
    idx_decl.add_child(own Expr.new(literal_num_node("0"), line, col))
    block.add_child(own idx_decl)

    // while _fi < _fc.keys.len()
    mut while_node := Expr.new(NodeType.While, line, col)
    mut idx_ident_cond := Expr.new(ident_node(idx_name), line, col)
    mut cond_call := make_method_call_fcall(own idx_ident_cond, "lt", line, col)
    mut keys_len_recv := Expr.new(field_access_node("keys"), line, col)
    keys_len_recv.add_child(own Expr.new(ident_node(col_name), line, col))
    cond_call.add_child(own make_method_call_fcall(own keys_len_recv, "len", line, col))
    while_node.add_child(own cond_call)

    mut wbody := Expr.new(NodeType.Body, line, col)

    // ref [mut] k : K = _fc.keys.unsafe_get(_fi)
    // A `_` binding is a discard: emit no decl for it. The body never
    // references `_`, and two `_` element decls in one scope would collide
    // as identical C identifiers (`for _, _ in map` -> "redefinition of _").
    if var_name.eq("_").not() {
        mut key_decl := Expr.new(NodeType.Decl(decl_typed(name = var_name, explicit_type = key_elem, own_type = OwnType.Ref, is_mut = forin_is_mut)), line, col)
        mut keys_recv := Expr.new(field_access_node("keys"), line, col)
        keys_recv.add_child(own Expr.new(ident_node(col_name), line, col))
        mut key_get := make_method_call_fcall(own keys_recv, "unsafe_get", line, col)
        key_get.add_child(own Expr.new(ident_node(idx_name), line, col))
        key_decl.add_child(own key_get)
        wbody.add_child(own key_decl)
    }

    // ref [mut] v : V = _fc.values.unsafe_get(_fi)
    if var_name2.eq("_").not() {
        mut val_decl := Expr.new(NodeType.Decl(decl_typed(name = var_name2, explicit_type = val_elem, own_type = OwnType.Ref, is_mut = forin_is_mut2)), line, col)
        mut vals_recv := Expr.new(field_access_node("values"), line, col)
        vals_recv.add_child(own Expr.new(ident_node(col_name), line, col))
        mut val_get := make_method_call_fcall(own vals_recv, "unsafe_get", line, col)
        val_get.add_child(own Expr.new(ident_node(idx_name), line, col))
        val_decl.add_child(own val_get)
        wbody.add_child(own val_decl)
    }

    // _fi = _fi.add(1)
    mut idx_assign_kv := Expr.new(NodeType.Assign(AssignData(name = idx_name.clone())), line, col)
    mut idx_ident_inc_kv := Expr.new(ident_node(idx_name), line, col)
    mut add_call_kv := make_method_call_fcall(own idx_ident_inc_kv, "add", line, col)
    add_call_kv.add_child(own Expr.new(literal_num_node("1"), line, col))
    idx_assign_kv.add_child(own add_call_kv)
    wbody.add_child(own idx_assign_kv)

    for e_bi_kv : Expr in for_body.children {
        wbody.add_child(own e_bi_kv.clone())
    }

    while_node.add_child(own wbody)
    block.add_child(own while_node)
    replace_body_stmt_with_block(body, stmt_idx, own block)
    return true
}
