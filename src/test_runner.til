mode cli

import("std/sys")
import("std/file")

// test_runner.til -- runs tests and reports structured results for tests.til.
//
// Usage:
//   test_runner both <file> [-no-interp] [-no-run] [-no-match] [--til-bin <path>]
//   test_runner single <label> <expected_exit> [<expected_out_file>] [--regen] -- <cmd...>
//   test_runner count <label> <needle> <expected_count> [<needle> <expected_count> ...] -- <cmd...>
//
// Expected-output files are reviewed goldens committed under test/, not a
// cache: `single` fails when one is missing instead of writing it. --regen
// (issue #172) overwrites the golden from the command's own output, so an
// intentional behaviour change is one explicit run plus a reviewed diff.

TIL := "bin/til"

// Extract basename from path: "test/types.til" -> "types"
test_basename := func(path: Str) returns Str {
    mut last_slash : USize = 0
    mut has_slash := 0
    for si in 0..path.len() {
        if path.get(si) == '/' {
            last_slash = si
            has_slash = 1
        }
    }
    mut name := path
    if has_slash == 1 {
        name = path.substr(last_slash + 1, path.len().sub(last_slash) - 1)
    }
    if name.ends_with(".til") {
        name = name.strip_suffix(".til")
    }
    return name
}

count_matches := func(haystack: Str, needle: Str) returns I64 {
    if needle.is_empty() { return 0 }
    mut count := 0
    mut start : USize = 0
    while start <= haystack.len() - needle.len() {
        pos := haystack.substr(start, haystack.len() - start).find(needle)
        if pos == -1 { return count }
        count++
        pos_u : USize = pos.to_usize()
        start = start.add(pos_u) + needle.len()
    }
    return count
}

// Echo a file into the suite log, tail-truncated so one pathological test
// cannot bury the rest of it. `what` names the kind of content so a reader
// scanning the log knows whether the block is a raw capture or a diff.
echo_file := proc(what: Str, path: Str) {
    content := File.readfile(path)
    // An EMPTY capture is a finding, not a reason to stay quiet: a failing
    // command that wrote nothing at all did not get far enough to report
    // anything (killed by the OS, exec failure, a child that died before
    // flushing), which is a different diagnosis from a capture the harness
    // never took. Staying silent here left a CI-only `FAIL: <label>
    // exit=1 expected=124` with no second line to reason from.
    if content.len() == 0 {
        println("--- ", what, " (", path, "): EMPTY (nothing was written)")
        return
    }
    max_len : USize = 8192
    if content.len() > max_len {
        println("--- ", what, " (last ", max_len.to_str(), " bytes of ", path, "):")
        println(content.substr(content.len() - max_len, max_len))
    } else {
        println("--- ", what, " (", path, "):")
        println(content)
    }
    println("--- end ", what)
}

// Echo a failing phase's captured output so the reason for the failure
// (til panic, ASAN report, cc error, ...) lands in the suite log instead
// of dying with the redirect.
print_captured_err := proc(path: Str) {
    echo_file("captured output", path)
}

// The capture file must never survive the run that did not write it.
//
// What fills it is a shell redirect, and in a chained command -- `a '&&' b`,
// which ~130 rows use as `translate ... '&&' cat gen/c/x.c` -- that redirect
// belongs to `b` alone. When `a` fails, `b` never runs, the file is never
// opened, and the LAST run's contents are still sitting there. `count` then
// reads it: it counts needles and deliberately does not look at the exit
// status, because the typer-error rows legitimately exit non-zero. So a
// chain that died at `translate` counted the previous run's generated C and
// reported ok=1 -- a green row for a command that failed. Reproduced
// directly:
//
//     test_runner count P HELLO 1 -- echo HELLO        -> ok=1  (writes P.out)
//     test_runner count P HELLO 1 -- false '&&' echo HELLO -> ok=1, exit 0
//
// Truncating here is the whole fix: an unwritten capture is now empty, which
// `count` fails on and echo_file reports as "EMPTY (nothing was written)".
// Wrapping the redirect around the chain instead would ALSO capture the
// first command's output, which is not what these rows mean -- their needles
// are counted against the cat'd file, not against translate's chatter.
truncate_capture := proc(path: Str) {
    File.writefile(path, "")
}

// An output mismatch reported as two blobs makes the reader eyeball them;
// `diff -u` says which lines moved. Both sides are real files on disk, so
// the reader can rerun the same diff by hand from the printed command.
print_output_diff := proc(label: Str, expected_path: Str, actual_path: Str) {
    diff_path := format("gen/out/single/", label, ".diff")
    system_cmd(format("diff -u '", expected_path, "' '", actual_path, "' > ", diff_path, " 2>&1"))
    echo_file("diff -u expected actual", diff_path)
}

PhaseResult := struct {
    status := -1
    ms := 0
    mem := 0
}

run_phase := proc(cmd: Str) returns PhaseResult {
    start := clock_ms()
    pid := spawn_cmd(cmd)
    mut mem := 0
    while true {
        rss := current_rss_bytes(pid).cast(I64)
        if rss > mem { mem = rss }
        status := check_cmd_status(pid)
        if status != -1 {
            return PhaseResult(status = status, ms = clock_ms() - start, mem = mem)
        }
        sleep_ms(10)
    }
}

main := proc(args: ..Str) {
    if args.len() < 1 {
        println("Usage: test_runner <both|single|count> ...")
        exit(1)
    }

    ref subcmd : Str = args[0]

    // both subcommand: compare interpret output with compiled-run output.
    if subcmd == "both" {
        if args.len() < 2 {
            println("Usage: test_runner both <file> [-no-interp] [-no-run] [-no-match] [--til-bin <path>] [--asan]")
            exit(1)
        }

        ref file : Str = args[1]
        mut en_interp := 1
        mut en_run := 1
        mut en_match := 1
        mut asan_flag := ""
        mut til_bin := TIL
        for i in 2..args.len() {
            ref arg : Str = args[i]
            if arg == "-no-interp" { en_interp = 0 }
            if arg == "-no-run" { en_run = 0 }
            if arg == "-no-match" { en_match = 0 }
            if arg == "--asan" { asan_flag = " --asan" }
            if arg.eq("--til-bin").and(i.add(1).lt(args.len())) {
                ref val : Str = args[i + 1]
                til_bin = val.clone()
            }
        }

        basename := test_basename(file)

        interp_outfile := format("gen/out/interp/", basename, ".out")
        run_outfile := format("gen/out/run/", basename, ".out")
        bin_path := format("bin/c/", basename)

        mut interp_ms := 0
        mut interp_ok := 0
        mut interp_mem := 0
        mut compile_ms := 0
        mut compile_ok := 0
        mut compile_mem := 0
        mut run_ms := 0
        mut run_ok := 0
        mut run_mem := 0
        mut fail := 0

        interp_errfile := format("gen/out/interp/", basename, ".err")
        run_errfile := format("gen/out/run/", basename, ".err")
        compile_errfile := format("gen/out/run/", basename, ".cc.err")

        if en_interp == 1 {
            cmd := til_bin.format(" interpret '", file, "' > ", interp_outfile, " 2> ", interp_errfile)
            phase := run_phase(cmd)
            interp_ms = phase.ms
            interp_mem = phase.mem
            if phase.status == 0 {
                interp_ok = 1
            } else {
                println("FAIL (interp): ", file)
                print_captured_err(interp_errfile)
                fail = 1
            }
        }

        if en_run == 1 {
            // Compile
            build_cmd := til_bin.format(" build", asan_flag, " -o ", bin_path, " '", file, "' 2> ", compile_errfile)
            phase := run_phase(build_cmd)
            compile_ms = phase.ms
            compile_mem = phase.mem
            if phase.status == 0 {
                compile_ok = 1
                // Run the compiled binary
                run_cmdline := bin_path.format(" > ", run_outfile, " 2> ", run_errfile)
                run_phase_result := run_phase(run_cmdline)
                run_ms = run_phase_result.ms
                run_mem = run_phase_result.mem
                if run_phase_result.status == 0 {
                    run_ok = 1
                } else {
                    println("FAIL (run): ", file)
                    print_captured_err(run_errfile)
                    fail = 1
                }
            } else {
                println("FAIL (compile): ", file)
                print_captured_err(compile_errfile)
                fail = 1
            }
        }

        // Compare all passing both outputs
        mut out_match := 1
        mut ref_out := ""
        mut has_ref := 0

        if en_interp.eq(1).and(interp_ok.eq(1)) {
            ref_out = File.readfile(interp_outfile)
            has_ref = 1
        }
        if en_run.eq(1).and(run_ok.eq(1)) {
            run_out := File.readfile(run_outfile)
            if has_ref == 0 {
                ref_out = run_out
                has_ref = 1
            } else {
                if en_match.eq(1).and(run_out.neq(ref_out)) {
                    out_match = 0
                    println("MISMATCH: ", file, " (run vs interp)")
                    fail = 1
                }
            }
        }

        mut both_ok := 1
        if fail != 0 { both_ok = 0 }
        if out_match == 0 { both_ok = 0 }
        total_ms := interp_ms.add(compile_ms) + run_ms

        println("RESULT ok=", both_ok.to_str(), " ms=", total_ms.to_str(),
                " interp_ms=", interp_ms.to_str(), " interp_ok=", interp_ok.to_str(),
                " interp_mem=", interp_mem.to_str(),
                " compile_ms=", compile_ms.to_str(), " compile_ok=", compile_ok.to_str(),
                " compile_mem=", compile_mem.to_str(),
                " run_ms=", run_ms.to_str(), " run_ok=", run_ok.to_str(),
                " run_mem=", run_mem.to_str(),
                " match=", out_match.to_str())

        exit(fail)
    }

    // single subcommand
    if subcmd == "single" {
        if args.len() < 4 {
            println("Usage: test_runner single <label> <expected_exit> [<expected_out_file>] [--regen] -- <cmd...>")
            exit(1)
        }

        ref label : Str = args[1]
        ref exit_str : Str = args[2]
        expected_exit := exit_str.to_i64()

        // Find "--" starting from index 3
        mut dd : USize = 3
        while dd < args.len() {
            ref a : Str = args[dd]
            if a == "--" { break }
            dd++
        }

        // Between expected_exit and "--" live the optional expected-output
        // file and the optional flags; the first word that is not a flag is
        // the expected file.
        mut expected_out_file := ""
        mut has_expected := 0
        mut regen := 0
        for oi in 3..dd {
            ref oa : Str = args[oi]
            if oa == "--regen" {
                regen = 1
            } else {
                if has_expected == 0 {
                    expected_out_file = oa.clone()
                    has_expected = 1
                }
            }
        }

        // Join args after "--" as command
        mut cmd := ""
        for ci in dd.add(1)..args.len() {
            if ci > dd + 1 { cmd = format(cmd, " ") }
            ref carg : Str = args[ci]
            cmd = format(cmd, carg)
        }

        if cmd.is_empty() {
            println("FAIL: ", label, " no command after --")
            println("RESULT ms=0 ok=0")
            exit(1)
        }

        outfile := format("gen/out/single/", label, ".out")
        truncate_capture(outfile)

        phase := run_phase(cmd.format(" > ", outfile, " 2>&1"))
        mut ok := 1
        if phase.status != expected_exit {
            println("FAIL: ", label, " exit=", phase.status.to_str(), " expected=", expected_exit.to_str())
            print_captured_err(outfile)
            ok = 0
        }

        if ok.eq(1).and(has_expected.eq(1)) {
            if regen == 1 {
                // Regen rewrites the golden from what the command just
                // printed. It runs only once the exit code matched: a
                // command that died the wrong way printed a failure
                // message, and freezing THAT as the expectation would
                // make the test pass forever on the broken behaviour.
                actual := File.readfile(outfile)
                File.writefile(expected_out_file, actual)
                println("REGEN: ", label, " -> ", expected_out_file)
            } else {
                // Goldens are reviewed artifacts under git, not a cache:
                // a missing one is a failure, never a silent first-run
                // "expectation" written from whatever the program did.
                if File.exists(expected_out_file).not() {
                    println("FAIL: ", label, " missing expected output file ",
                            expected_out_file, " (create it with `make test_regen`)")
                    print_captured_err(outfile)
                    ok = 0
                } else {
                    actual := File.readfile(outfile)
                    expected := File.readfile(expected_out_file)
                    if actual != expected {
                        println("FAIL: ", label, " output mismatch")
                        print_output_diff(label, expected_out_file, outfile)
                        ok = 0
                    }
                }
            }
        }

        println("RESULT ms=", phase.ms.to_str(), " mem=", phase.mem.to_str(), " ok=", ok.to_str())
        if ok == 1 { exit(0) } else { exit(1) }
    }

    // count subcommand
    if subcmd == "count" {
        if args.len() < 5 {
            println("Usage: test_runner count <label> <needle> <expected_count> [<needle> <expected_count> ...] -- <cmd...>")
            exit(1)
        }

        ref label : Str = args[1]

        // Find "--" after the needle/count pairs.
        mut dd : USize = 2
        while dd < args.len() {
            ref a : Str = args[dd]
            if a == "--" { break }
            dd++
        }
        if dd.eq(args.len()).or(dd.lt(4)).or(dd.sub(2).mod(2).neq(0)) {
            println("Usage: test_runner count <label> <needle> <expected_count> [<needle> <expected_count> ...] -- <cmd...>")
            exit(1)
        }

        // Join args after "--" as command
        mut cmd := ""
        for ci in dd.add(1)..args.len() {
            if ci > dd + 1 { cmd = format(cmd, " ") }
            ref carg : Str = args[ci]
            cmd = format(cmd, carg)
        }

        if cmd.is_empty() {
            println("FAIL: ", label, " no command after --")
            println("RESULT ms=0 ok=0 count=0")
            exit(1)
        }

        outfile := format("gen/out/single/", label, ".out")
        truncate_capture(outfile)

        phase := run_phase(cmd.format(" > ", outfile, " 2>&1"))
        actual_out := File.readfile(outfile)

        mut ok := 1
        mut actual_count := 0
        mut check : USize = 2
        while check < dd {
            ref needle : Str = args[check]
            ref count_str : Str = args[check.add(1)]
            expected_count := count_str.to_i64()
            actual_count = count_matches(actual_out, needle)
            if actual_count != expected_count {
                println("FAIL: ", label, " needle=", needle, " count=", actual_count.to_str(), " expected=", expected_count.to_str())
                ok = 0
            }
            check = check.add(2)
        }
        if ok == 0 { print_captured_err(outfile) }

        println("RESULT ms=", phase.ms.to_str(), " mem=", phase.mem.to_str(), " ok=", ok.to_str(), " count=", actual_count.to_str())
        if ok == 1 { exit(0) } else { exit(1) }
    }

    println("Unknown subcommand: ", subcmd)
    exit(1)
}
