mode cli

import("std/sys")
import("std/file")

NL := "\n"
TIL := "bin/til"
RUNNER := "bin/test_runner"
PLOT := "bin/plot"
GUI_TIMEOUT := "1"
DOC_DOCTEST_FILE := "tmp/doc_doctests.til"

count_matches := func(haystack: Str, needle: Str) returns I64 {
    if needle.is_empty() { return 0 }
    mut count := 0
    mut start : USize = 0
    while start <= haystack.len() - needle.len() {
        pos := haystack.substr(start, haystack.len() - start).find(needle)
        if pos == -1 { return count }
        count++
        pos_u : USize = pos.to_usize()
        start = start.add(pos_u) + needle.len()
    }
    return count
}

// Run a shell command, return exit code
run := proc(cmd: Str) returns I64 {
    pid := spawn_cmd(cmd)
    return wait_cmd(pid)
}

// --- Helpers ---

ms_to_str := func(ms: I64) returns Str {
    secs := ms / 1000
    frac := ms.mod(1000) / 10
    mut frac_str := frac.to_str()
    if frac < 10 { frac_str = format("0", frac_str) }
    return format(secs.to_str(), ".", frac_str, "s")
}

pad_right := func(s: Str, width: USize) returns Str {
    mut result := s.clone()
    while result.len() < width {
        result = format(result, " ")
    }
    return result
}

test_basename := func(path: Str) returns Str {
    mut last_slash : USize = 0
    mut has_slash := 0
    for si in 0..path.len() {
        if path.get(si) == '/' {
            last_slash = si
            has_slash = 1
        }
    }
    mut name := path
    if has_slash == 1 {
        name = path.substr(last_slash + 1, path.len().sub(last_slash) - 1)
    }
    if name.ends_with(".til") {
        name = name.strip_suffix(".til")
    }
    return name
}

parse_kv := func(line: Str, key: Str) returns I64 {
    needle := format(key, "=")
    pos := line.find(needle)
    if pos < 0 { return 0 }
    pos_u : USize = pos.to_usize()
    start := pos_u + needle.len()
    mut end := start
    while end.lt(line.len()).and(line.get(end).neq(' ')).and(line.get(end).neq(10)) {
        end++
    }
    return line.substr(start, end - start).to_i64()
}

mode_flags := func(en_interp: I64, en_run: I64, asan_flag: Str) returns Str {
    mut f := ""
    if en_interp == 0 { f = format(f, " -no-interp") }
    if en_run == 0 { f = format(f, " -no-run") }
    if asan_flag.len() > 0 { f = format(f, " ", asan_flag) }
    return f
}

doc_test_line_end := func(body: Str, pos: USize) returns USize {
    rest := body.substr(pos, body.len() - pos)
    line_rel := rest.find("\n")
    if line_rel < 0 { return body.len() }
    return pos + line_rel.to_usize()
}

doc_test_next_line_pos := func(body: Str, line_end: USize) returns USize {
    if line_end >= body.len() { return body.len() }
    return line_end + 1
}

doc_test_comment_text := func(line: Str, path: Str) returns Str {
    trimmed := line.trim()
    if trimmed.starts_with("///").not() { panic("unterminated doctest block in ", path) }
    mut text := trimmed.strip_prefix("///").clone()
    if text.starts_with(" ") { text = text.strip_prefix(" ").clone() }
    return text
}

doc_test_is_doctest_begin := func(line: Str) returns Bool {
    trimmed := line.trim()
    if trimmed.starts_with("///").not() { return false }
    text := doc_test_comment_text(line, "<doc-test>")
    return text.trim().starts_with("#+begin_src").and(text.contains(":doctest"))
}

append_source_doc_doctests := func(mut out: Str, path: Str, source: Str, count: USize) returns USize {
    mut next_count := count
    mut pos : USize = 0
    mut line_number : USize = 1
    while pos < source.len() {
        line_end := doc_test_line_end(source, pos)
        line := source.substr(pos, line_end - pos)
        if doc_test_is_doctest_begin(line) {
            block_line := line_number
            loc := format(path, ":", block_line.to_str())
            pos = doc_test_next_line_pos(source, line_end)
            line_number++
            out.push_str("// doctest source: ")
            out.push_str(loc)
            out.push_str("\n")
            out.push_str("doctest_")
            out.push_str(next_count.to_str())
            out.push_str(" := test() {\n")
            mut found_end := false
            mut has_body := false
            while pos < source.len() {
                src_line_end := doc_test_line_end(source, pos)
                src_line := source.substr(pos, src_line_end - pos)
                body_line := doc_test_comment_text(src_line, loc)
                if body_line.trim().starts_with("#+end_src") {
                    found_end = true
                    pos = doc_test_next_line_pos(source, src_line_end)
                    line_number++
                    break
                }
                if body_line.trim().is_empty().not() { has_body = true }
                out.push_str(body_line)
                out.push_str("\n")
                pos = doc_test_next_line_pos(source, src_line_end)
                line_number++
            }
            if found_end.not() { panic("unterminated doctest block in ", loc) }
            if has_body.not() { panic("empty doctest block in ", loc) }
            out.push_str("}\n\n")
            next_count++
            continue
        }
        pos = doc_test_next_line_pos(source, line_end)
        line_number++
    }
    return next_count
}

append_tracked_doc_doctests := proc(mut out: Str) returns USize {
    mut listing := ""
    result := run_cmd(listing, "git", "ls-files", "src/core/*.til", "src/std/*.til", "src/self/*.til", "src/modes/*.til", "src/til.til", "examples/lib/*.til", "vendor/bindings/*.til")
    if result != 0 { panic("failed to list documented til sources") }
    mut count : USize = 0
    mut pos : USize = 0
    while pos < listing.len() {
        line_end := doc_test_line_end(listing, pos)
        path := listing.substr(pos, line_end - pos).trim()
        if path.is_empty().not() {
            source := File.readfile(path)
            count = append_source_doc_doctests(out, path, source, count)
        }
        pos = doc_test_next_line_pos(listing, line_end)
    }
    return count
}

write_doc_doctests := proc(out_path: Str) {
    mut regression := Str.with_capacity(256)
    regression_count := append_source_doc_doctests(regression, "test/doc_fixture.til", "/// #+begin_src til :doctest\n/// assert(true)\n/// #+end_src\n", 0)
    if regression_count != 1 { panic("doctest extraction regression: wrong count") }
    if regression.contains("// doctest source: test/doc_fixture.til:1").not() { panic("doctest extraction regression: missing source location") }
    if regression.contains("assert(true)").not() { panic("doctest extraction regression: missing body") }

    mut out := Str.with_capacity(4096)
    out.push_str("mode test\n\n")
    count := append_tracked_doc_doctests(out)
    if count == 0 { panic("no doc doctests found") }
    File.writefile(out_path, out)
}

// --- Data structures ---

BothData := struct {
    interp_ms := 0
    interp_ok := 0
    interp_mem := 0
    compile_ms := 0
    compile_ok := 0
    compile_mem := 0
    run_ms := 0
    run_ok := 0
    run_mem := 0
    output_match := 1
namespace:
    eq := func(a: BothData, b: BothData) returns Bool {
        return and(a.interp_ms.eq(b.interp_ms), a.interp_ok.eq(b.interp_ok),
                   a.interp_mem.eq(b.interp_mem),
                   a.compile_ms.eq(b.compile_ms),
                   a.compile_ok.eq(b.compile_ok),
                   a.compile_mem.eq(b.compile_mem),
                   a.run_ms.eq(b.run_ms),
                   a.run_ok.eq(b.run_ok),
                   a.run_mem.eq(b.run_mem),
                   a.output_match.eq(b.output_match))
    }
    to_str := func(_self: BothData) returns Str { return "BothData" }
}

TestKind := enum { Both: BothData, Single, Count }

Test := struct {
    label := ""
    cmd := ""
    outfile := ""
    category := ""
    kind := TestKind.Single
    // scheduling
    pid := 0
    start_ms := 0
    // common results
    ok := 0
    ms := 0
    mem := 0
    // both config flags
    has_interp := 0
    has_run := 0
}

Slot := struct {
    test_idx : USize = 0
    pid := 0
    start_ms := 0
}

// --- Output helpers ---

print_test_result := proc(t: Test) {
    switch t.kind {
    case .Both(md):
        mut line := pad_right(t.label, 42)
        if t.has_interp == 1 { line = format(line, "interp: ", pad_right(ms_to_str(md.interp_ms), 9)) }
        if t.has_run == 1 { line = format(line, "compile: ", pad_right(ms_to_str(md.compile_ms), 9), "run: ", pad_right(ms_to_str(md.run_ms), 9)) }
        if md.output_match == 0 { line = format(line, " MISMATCH") }
        println(line)
    case:
        if t.ok == 1 {
            println(pad_right(t.label, 42), ms_to_str(t.ms))
        }
    }
}

// --- Registration helpers ---

add_both := func(mut tests: Vec(Test), file: Str, flags: Str) {
    bn := test_basename(file)
    tests.push(own Test(
        label = file.clone(),
        cmd = format(RUNNER, " both '", file, "'", flags),
        outfile = format("gen/out/results/", bn, ".txt"),
        category = "both",
        kind = TestKind.Both(BothData()),
        has_interp = 1, has_run = 1
    ))
}

add_single := func(mut tests: Vec(Test), label: Str, category: Str,
    expected_exit: I64, expected_out: Str, cmd_suffix: Str) {
        mut runner_cmd := format(RUNNER, " single ", label, " ", expected_exit.to_str())
        if expected_out.len() > 0 {
            runner_cmd = format(runner_cmd, " ", expected_out)
        }
        runner_cmd = format(runner_cmd, " -- ", cmd_suffix)
        tests.push(own Test(
            label = label.clone(),
            cmd = runner_cmd,
            outfile = format("gen/out/results/", label, ".txt"),
            category = category.clone(),
            kind = TestKind.Single
        ))
    }

add_count := func(mut tests: Vec(Test), label: Str, category: Str,
    needle: Str, expected_count: I64, cmd_suffix: Str) {
        runner_cmd := format(RUNNER, " count ", label, " '", needle, "' ", expected_count.to_str(), " -- ", cmd_suffix)
        tests.push(own Test(
            label = label.clone(),
            cmd = runner_cmd,
            outfile = format("gen/out/results/", label, ".txt"),
            category = category.clone(),
            kind = TestKind.Count
        ))
    }

add_cli_pair := func(mut tests: Vec(Test), name: Str, file: Str,
    cli_args: Str, expected_exit: I64, expected_out: Str,
    til: Str, asan_flag: Str) {
        mut cmd_i := format(til, " interpret ", file)
        if cli_args.len() > 0 { cmd_i = format(cmd_i, " ", cli_args) }
        add_single(tests, format(name, "_i"), "cli", expected_exit, expected_out, cmd_i)
        mut cmd_r := format(til, " run", asan_flag, " -o bin/c/", name,
            " -c gen/c/", name, ".c ",
            file)
        if cli_args.len() > 0 { cmd_r = format(cmd_r, " ", cli_args) }
        add_single(tests, format(name, "_r"), "cli", expected_exit, expected_out, cmd_r)
    }

// --- Blind parallel runner ---

run_all_parallel := proc(mut tests: Vec(Test), j: USize, mut fail: I64, mut suite_end_ms: I64) {
    mut next : USize = 0
    mut active : USize = 0

    mut slots := Array(Slot).new(j)
    mut si : USize = 0
    while si < j {
        slots[si] = Slot()
        si++
    }

    // Spawn initial batch
    si = 0
    while si.lt(j).and(next.lt(tests.len())) {
        ref t : Test = tests[next]
        cmd := format(t.cmd, " > ", t.outfile, " 2>&1")
        start := clock_ms()
        pid := spawn_cmd(cmd)
        slots[si] = Slot(test_idx = next, pid = pid, start_ms = start)
        active++
        next++
        si++
    }

    // Poll loop
    while active > 0 {
        mut i : USize = 0
        while i < j {
            ref mut slot : Slot = slots[i]
            if slot.pid > 0 {
                status := check_cmd_status(slot.pid)
                if status != -1 {
                    ref mut t : Test = tests[slot.test_idx]
                    runner_out := File.readfile(t.outfile)

                    // Find RESULT line
                    mut result_line := ""
                    result_pos := runner_out.rfind("RESULT ")
                    if result_pos >= 0 {
                        result_pos_u : USize = result_pos.to_usize()
                        result_line = runner_out.substr(result_pos_u,
                            runner_out.len() - result_pos_u)
                    }

                    // Parse common fields
                    t.ok = parse_kv(result_line, "ok")
                    t.ms = parse_kv(result_line, "ms")
                    t.mem = parse_kv(result_line, "mem")
                    // Parse both-specific fields into payload
                    switch t.kind {
                    case .Both(md):
                        md.interp_ms = parse_kv(result_line, "interp_ms")
                        md.interp_ok = parse_kv(result_line, "interp_ok")
                        md.interp_mem = parse_kv(result_line, "interp_mem")
                        md.compile_ms = parse_kv(result_line, "compile_ms")
                        md.compile_ok = parse_kv(result_line, "compile_ok")
                        md.compile_mem = parse_kv(result_line, "compile_mem")
                        md.run_ms = parse_kv(result_line, "run_ms")
                        md.run_ok = parse_kv(result_line, "run_ok")
                        md.run_mem = parse_kv(result_line, "run_mem")
                        md.output_match = parse_kv(result_line, "match")
                        t.kind = TestKind.Both(md.clone())
                    case:
                    }

                    print_test_result(t)

                    // Suite wall excludes the self-translate benchmark: record
                    // when each non-"self" test finishes; the last one marks the
                    // end of the real suite (self runs in parallel past it).
                    if t.category != "self" { suite_end_ms = clock_ms() }

                    if status != 0 {
                        // Everything the runner said, minus the
                        // machine-readable RESULT line already parsed
                        // above. Relaying ONLY the FAIL/MISMATCH lines
                        // dropped the one thing a reader needs: the
                        // block print_captured_err writes -- the til
                        // panic, the ASAN report, the cc error, the
                        // test's own assertion dump. A failure that
                        // reproduces locally survives that filter; a
                        // CI-only one does not, and `FAIL: repl_pty
                        // exit=1 expected=0` with no second line is all
                        // the mac jobs could say for twenty red runs.
                        runner_lines := runner_out.split(NL)
                        mut li : USize = 0
                        while li < runner_lines.len() {
                            ref ln : Str = runner_lines[li]
                            if ln.starts_with("RESULT ").not() {
                                println(ln)
                            }
                            li++
                        }
                        fail = 1
                    }

                    active--
                    slot.pid = 0

                    if next < tests.len() {
                        ref nt : Test = tests[next]
                        cmd := format(nt.cmd, " > ", nt.outfile, " 2>&1")
                        start := clock_ms()
                        pid := spawn_cmd(cmd)
                        slots[i] = Slot(test_idx = next, pid = pid, start_ms = start)
                        active++
                        next++
                    }
                }
            }
            i++
        }
        if active > 0 {
            sleep_ms(10)
        }
    }
}

// --- Main ---

main := proc(args: ..Str) {
    wall_start := clock_ms()

    // Parse args: -jN, -no-interp, -no-run, --no-gui, --til-bin <path>, --asan
    mut j : USize = get_thread_count().to_usize()
    mut en_interp := 1
    mut en_run := 1
    mut en_gui := 1
    mut til_bin := TIL
    mut asan := 0
    mut i : USize = 0
    while i < args.len() {
        ref arg : Str = args[i]
        if arg.starts_with("-j") {
            j = arg.substr(2, arg.len() - 2).to_usize()
            if j < 1 { j = 1 }
        }
        if arg == "-no-interp" { en_interp = 0 }
        if arg == "-no-run" { en_run = 0 }
        if arg == "--no-gui" { en_gui = 0 }
        if arg.eq("--til-bin").and(i.add(1).lt(args.len())) {
            i++
            ref val : Str = args[i]
            til_bin = val.clone()
        }
        if arg == "--asan" { asan = 1 }
        i++
    }

    // When --asan is set, asan_flag is spliced after "build"/"run"/"test"
    // so the underlying `til build` invocation produces an ASAN-instrumented
    // binary. Compiled binaries built this way run under ASAN and report
    // their own leaks when executed.
    mut asan_flag := ""
    if asan == 1 { asan_flag = " --asan" }

    mut fail := 0

    // Create output directories
    run("mkdir -p gen/out/interp gen/out/run gen/out/results gen/out/single gen/out/expected tmp")

    mut tests := Vec(Test).new()
    mut flags := mode_flags(en_interp, en_run, asan_flag)
    if til_bin != TIL { flags = format(" --til-bin ", til_bin, flags) }

    // Self-translate: bin/til translate src/til.til -- the compiler translating
    // its own source, the largest input it handles and the single slowest job.
    // Registered FIRST so run_all_parallel spawns it in the first batch; it then
    // holds one of the j parallel slots for the whole run (usually the long
    // pole). Its time is collected via the "self" category into self_ms and is
    // deliberately EXCLUDED from wall_ms (run_all_parallel marks the suite end
    // from the last non-"self" test), so the benchmark does not inflate wall.
    // Exit must be 0: the compiler has to be able to translate itself.
    //
    // Issue #101: it is also the determinism guard, and ONE translation buys
    // both halves of it, so self_ms stays a single self-translate. The
    // comparison is against the pass-1 boot/ artifacts the build just
    // produced, which were written by a DIFFERENT compiler binary in a
    // DIFFERENT process (til_boot under `make test`, the self-applied
    // bin/til under two_pass):
    //   - REPEATABILITY falls out of that. Byte-identical output from two
    //     processes is exactly the property a second run of this compiler
    //     would test, and it tests it across a process boundary rather than
    //     within one. Every synthesized name (`hoisted__<T>_<N>`,
    //     `_lzr_<N>`, `_sw_<T>_<N>`, ...) comes from a Context counter
    //     advanced by an ordered AST/Vec walk, so a fresh LoadedProgram has
    //     to reproduce the bytes. This used to be checked by hand with
    //     occasional self-build diffs (#77).
    //   - SELF-APPLICATION is the other half: the compiler BUILT from pass
    //     1's output must re-emit pass 1's bytes -- the bootstrap fixed
    //     point. Both artifacts come from the same HEAD, which matters
    //     because VERSION embeds the current git commit.
    // A second translation would only re-test one process against itself,
    // for the price of doubling the suite's single slowest job.
    // A unique tmp/ path so the parallel suite cannot race another
    // translation, and so gen/til/til.c (pass 1's artifact) is left alone.
    // The '&&' tokens are quoted for the OUTER shell: test_runner joins its
    // post-`--` argv with spaces and re-runs the result under sh, which is
    // where they take effect.
    add_single(tests, "self_translate", "self", 0, "",
        format(til_bin, " translate -c tmp/self_det.c src/til.til",
            " '&&' cmp tmp/self_det.c boot/til.c",
            " '&&' cmp tmp/self_det_forward.h boot/til_forward.h"))

    // The two REPL drivers, registered EARLY for the same reason
    // self_translate is: run_all_parallel dispatches strictly in
    // registration order, so a long job listed last runs with nothing left
    // to overlap it and its whole duration lands on wall_ms. Both of these
    // are long in ELAPSED time while costing almost no CPU -- they spend it
    // waiting on a piped or pseudo-terminal REPL -- so started early they
    // hide entirely behind the rest of the suite. (Their durations still
    // sum into cli_ms, which measures elapsed time, not work.)
    //
    // repl_help drives bin/til's REPL over a piped script and self-checks,
    // exiting 0 on PASS / 1 on FAIL. It used to be a separate hand-run
    // `make test_repl_help` target outside the suite, so the suite could
    // pass green while the REPL was broken (it did, twice, during the
    // doc.til core->std move). Registered here it runs wherever bin/tests
    // runs -- make test, linux CI, and the mac jobs that invoke bin/tests
    // directly. Exit-code-only check (no expected_out).
    add_single(tests, "repl_help", "cli", 0, "", format(TIL, " run test/repl_help.til"))

    // #332: the REPL line editor's real-terminal half. Drives bin/til
    // through a pseudo-terminal with actual escape/control bytes and an
    // isolated XDG_STATE_HOME, and self-checks like repl_help does. The
    // pure state machine is test/repl_editor.til, in the both-backend list;
    // neither is a hand-run target, so the feature cannot regress behind
    // one again.
    add_single(tests, "repl_pty", "cli", 0, "", format(TIL, " run test/repl_pty.til"))

    // #347: the console half of the same editor, which had never been
    // RUN on any machine. The real session happens on the windows runner
    // (the workflow's "REPL console session on windows" step, against the
    // cross-built .exe); here it reports SKIP -- and in doing so keeps
    // test/wincon.c compiling and linking on every host, so the driver
    // cannot rot between windows runs.
    add_single(tests, "repl_wincon", "cli", 0, "",
        format(TIL, " run test/repl_wincon.til ", TIL))

    // `til install` end to end: install the compiler under tmp/ and
    // build a program with the RESULT, from another directory, against
    // the installed std and C runtime. Nothing covered install before,
    // which is how it stayed broken for two weeks after lib/ moved to
    // examples/lib/ and the installer kept copying the old path.
    add_single(tests, "install", "build", 0, "", format(TIL, " run test/install.til"))

    // The non-zero half of the value-returning-main contract: `return 7`
    // is process exit status 7 on both backends. The compiled `int main`
    // always did this; the interpreter used to discard the value and
    // exit 0 (behind the panic that test/main_return.til, in the both
    // list, pins -- a both entry demands exit 0, so the non-zero case
    // lives here as expected-exit singles, the same shape as the gui
    // tests' expected 124).
    add_single(tests, "main_return7_interp", "cli", 7, "",
        format(til_bin, " test/main_return7.til one two"))
    add_single(tests, "main_return7_run", "cli", 7, "",
        format(til_bin, " build", asan_flag, " -o bin/main_return7 test/main_return7.til '&&' bin/main_return7 one two"))

    // Issue #343: a Str view reaching a C string parameter must die at the
    // boundary, on BOTH backends and with the same message -- the compiled
    // TIL_CSTR macro and the interpreter's FFI marshalling test the same
    // byte. `count` rather than expected-exit singles because what matters
    // is WHICH failure fired: an exit 1 could be any panic, while the
    // message appearing exactly once says the terminator check is what
    // stopped it. The safe half (literal / owned / clone) rides
    // test/ext_libc.til, a both entry that must stay green.
    cstr_view_msg := "Str is not NUL-terminated"
    add_count(tests, "cstr_view_interp", "cli", cstr_view_msg, 1,
        format(til_bin, " test/cstr_view.til"))
    add_count(tests, "cstr_view_run", "cli", cstr_view_msg, 1,
        format(til_bin, " build", asan_flag, " -o bin/cstr_view test/cstr_view.til '&&' bin/cstr_view"))

    // Cmd's argv round trip (issue #349): spawn test/echo_argv.til's
    // binary through Cmd with the argument shapes a quoted command
    // line gets wrong and compare what the child's C runtime parsed.
    // This linux leg pins the driver and the execvp path; the SAME two
    // programs cross-compile to .exes in the windows-x64 host CI job
    // and run on a real windows runner, where they are the only
    // execution of win_quote_arg / CreateProcessA / win_env_block.
    // TIL_QUOTE_CASE feeds the case-insensitive env displacement probe.
    add_single(tests, "win_quoting", "build", 0, "",
        format(til_bin, " build", asan_flag, " test/echo_argv.til '&&' ",
            til_bin, " build", asan_flag, " -o bin/win_quoting test/win_quoting.til '&&' ",
            "TIL_QUOTE_CASE=parent bin/win_quoting bin/echo_argv"))

    // Issue #302 stage 0: the garbager decision-audit golden. Translating
    // the frozen fixture with TIL_GC_AUDIT set dumps the asap pass's
    // per-binding decisions and destructor sites; the byte-exact compare
    // against test/gc_audit.expected turns any decision change into a
    // reviewable diff. Regeneration recipe in test/gc_audit.til's header.
    add_single(tests, "gc_audit", "self", 0, "test/gc_audit.expected",
        format("TIL_GC_AUDIT=test/gc_audit.til ", til_bin, " translate test/gc_audit.til"))

    // Issue #326: the generated C must be honest about liveness. The fixture
    // (test/dead_temps.til, run interpreted + compiled by the `both` entry
    // below) pins the BEHAVIOUR; these three pin the OUTPUT. A compiler temp
    // that goes dead has to be removed, not silenced with `(void)name;`; no
    // generated helper may exist only because __attribute__((unused)) lets it
    // compile; and the one cast that remains is on `_b`, the deliberately-
    // unused param spelling issue #86 defines. Each translates to its own
    // -c path so the three (and the `both` compile) never race on one file.
    //
    // Category "build", NOT "self": self_ms/self_mem are the self-translate
    // BENCHMARK, and they are plain SUMS over the category (self_mem adds
    // each test's whole peak RSS). Any extra test filed under "self" lands
    // in doc/totals.csv and img/totals.svg as a benchmark regression that
    // did not happen -- these three cost ~3 x 2s and ~3 x 1.1GB of peak RSS,
    // which is what made self_mem jump 11.8GB -> 15.1GB when they were first
    // registered here. Measured on identical input, the compiler's own
    // self-translate was 29.07s/262.8MB before #326 and 29.40s/261.7MB after.
    add_count(tests, "dead_temps_no_temp_casts", "build", "(void)hoisted__", 0,
        format(til_bin, " translate -c gen/c/dead_temps_casts.c test/dead_temps.til '&&' cat gen/c/dead_temps_casts.c"))
    add_count(tests, "dead_temps_no_unused_attrs", "build", "__attribute__((unused))", 0,
        format(til_bin, " translate -c gen/c/dead_temps_attrs.c test/dead_temps.til '&&' cat gen/c/dead_temps_attrs.c"))
    add_count(tests, "dead_temps_underscore_cast", "build", "(void)_b;", 1,
        format(til_bin, " translate -c gen/c/dead_temps_uscore.c test/dead_temps.til '&&' cat gen/c/dead_temps_uscore.c"))
    // ...and it is the ONLY cast in the file. The `_` prefix says a cast is
    // ALLOWED where a binding is deliberately unread, not that one is
    // always needed: every other `_`-prefixed temp this fixture generates
    // is read, most of them on the very next line.
    add_count(tests, "dead_temps_one_cast_total", "build", "(void)_", 1,
        format(til_bin, " translate -c gen/c/dead_temps_one.c test/dead_temps.til '&&' cat gen/c/dead_temps_one.c"))

    // #346: ownership and C representation are separate. The ordinary
    // aggregate function, its closure wrapper and its FuncSig cast all return
    // ReturnBox346 by value; only the bodyless dyn_type_to_str boundary uses
    // the one pointer-to-value adapter.
    add_count(tests, "aggregate_return_value_abi", "build",
        "static ReturnBox346 make_return_box346(Str * value)", 2,
        format(til_bin, " translate -c gen/c/aggregate_return_value.c test/fn_ptr.til '&&' cat gen/c/aggregate_return_value.c"))
    add_count(tests, "aggregate_return_no_pointer_abi", "build",
        "static ReturnBox346 *make_return_box346", 0,
        format(til_bin, " translate -c gen/c/aggregate_return_pointer.c test/fn_ptr.til '&&' cat gen/c/aggregate_return_pointer.c"))
    add_count(tests, "funcsig_aggregate_return_value_abi", "build",
        "((ReturnBox346 (*)(void *, Str *))", 1,
        format(til_bin, " translate -c gen/c/aggregate_return_funcsig.c test/fn_ptr.til '&&' cat gen/c/aggregate_return_funcsig.c"))
    add_count(tests, "closure_aggregate_return_value_abi", "build",
        "static ClosureBox346 closure_test_capturing_closure_owned_aggregate_return_0(void *til_env_raw)", 1,
        format(til_bin, " translate -c gen/c/aggregate_return_closure.c test/closures.til '&&' cat gen/c/aggregate_return_closure.c"))
    add_count(tests, "ext_owned_return_boundary_adapter", "build",
        "Str *_hp = (Str *)dyn_type_to_str", 1,
        format(til_bin, " translate -c gen/c/aggregate_return_ext.c test/fn_ptr.til '&&' cat gen/c/aggregate_return_ext.c"))
    add_count(tests, "aggregate_local_stack_storage", "build",
        "StackValue346 value = {0};", 1,
        format(til_bin, " translate -c gen/c/aggregate_local_stack.c test/structs.til '&&' cat gen/c/aggregate_local_stack.c"))
    add_count(tests, "aggregate_own_param_value_return", "build",
        "static StackValue346 priv__test_structs_til__move_stack_value346(StackValue346 value)", 2,
        format(til_bin, " translate -c gen/c/aggregate_own_return.c test/structs.til '&&' cat gen/c/aggregate_own_return.c"))
    add_count(tests, "aggregate_own_escape_boxes", "build",
        "StackValue346 *_oa = malloc(TIL_BOX(StackValue346))", 1,
        format(til_bin, " translate -c gen/c/aggregate_own_escape.c test/structs.til '&&' cat gen/c/aggregate_own_escape.c"))
    add_count(tests, "funcsig_own_param_value_abi", "build",
        "static USize consume_owned_box346(ReturnBox346 box)", 2,
        format(til_bin, " translate -c gen/c/aggregate_param_funcsig.c test/fn_ptr.til '&&' cat gen/c/aggregate_param_funcsig.c"))
    add_count(tests, "closure_own_param_value_abi", "build",
        "static USize closure_make_closure_owned_box_consumer346_0(void *til_env_raw, ClosureBox346 box)", 1,
        format(til_bin, " translate -c gen/c/aggregate_param_closure.c test/closures.til '&&' cat gen/c/aggregate_param_closure.c"))
    add_count(tests, "self_method_own_param_value_abi", "build",
        "static void Expr_add_child(Expr * self, Expr child)", 2,
        "cat boot/til.c")
    add_count(tests, "self_template_own_param_value_abi", "build",
        "static void Vec__Expr_push(Vec__Expr * self, Expr val)", 2,
        "cat boot/til.c")
    add_count(tests, "delete_own_param_pointer_abi", "build",
        "static void Str_delete(Str * self, Bool call_free)", 2,
        "cat boot/til.c")
    add_count(tests, "expr_new_value_return_abi", "build",
        "static Expr Expr_new(NodeType * data, U32 line, U32 col)", 2,
        "cat boot/til.c")
    add_count(tests, "expr_new_no_pointer_return_abi", "build",
        "static Expr *Expr_new(NodeType * data, U32 line, U32 col)", 0,
        "cat boot/til.c")

    // Issue #326: a program that names no compiler AST type and no
    // reflection must not carry the compiler's data model into its output.
    // NodeType is the hub -- StructDef's fields reach Declaration, whose
    // field default reaches Expr, whose node_type reaches NodeType -- so one
    // needle guards the whole cluster. See test/minimal_reach.til; the
    // `both` entry below proves what survives still links and runs.
    add_count(tests, "minimal_reach_no_ast_model", "build", "NodeType", 0,
        format(til_bin, " translate -c gen/c/minimal_reach.c test/minimal_reach.til '&&' cat gen/c/minimal_reach.c"))
    // A reached type no longer roots all five of delete/clone/size/cmp/hash:
    // only the ones a real call site asks for survive. `hash` is the clearest
    // witness -- nothing in this fixture hashes anything, so every `_hash`
    // the old blanket rule emitted (ten of them, one per scalar) is gone.
    add_count(tests, "minimal_reach_no_dead_lifecycle", "build", "_hash", 0,
        format(til_bin, " translate -c gen/c/minimal_reach_lc.c test/minimal_reach.til '&&' cat gen/c/minimal_reach_lc.c"))
    // A user-unit top-level value used to be a blanket root: unread or not,
    // its global, its initializer and everything the initializer referenced
    // were emitted. Effect-free initializers (literal/ident) are ordinary
    // graph nodes now -- the fixture's UNREAD_GLOBAL must vanish while the
    // read KEPT_GLOBAL survives (the `both` entry proves the latter by
    // printing it). std/raylib.til is where this bites for real programs:
    // snake carried every unused SHADER_/TEXTURE_/KEY_ flag constant.
    // `cast` is declared `ext_func(e: Dynamic, T: Type)` but no such symbol
    // exists: the builder reads the target type name off the call and emits
    // a bare C cast. Its `T: Type` slot is a comptime type argument, the
    // same shape the macro-signature rule excludes, so walking the
    // signature rooted the `Type` enum and, through its payload,
    // `Primitive`. `I64.to_str` casts, which meant every program that
    // prints a number carried both struct definitions and both tag enums
    // with nothing referencing them. `Primitive_TAG` is the witness -- it
    // appears once per variant, so a partial regression still trips it.
    // dyn dispatch on a LITERAL type name roots the exact `Type.method`
    // pair, not the `*.method` wildcard. Only the METHOD argument was exempt
    // from arg hoisting, so a literal TYPE name became a pooled-Str temp and
    // both the scavenger and the builder inventory saw an Ident instead of a
    // literal -- falling back to the wildcard, which keeps `to_str` on EVERY
    // type, the compiler's own Expr/NodeType model included. The dyn-heavy
    // fixtures cannot catch this: they reach dispatch through std/dyn_array,
    // whose `dyn_fn(elem_type, "clone")` takes a RUNTIME type and needs the
    // wildcard by construction. 3,130 -> 497 lines of C for this fixture.
    add_count(tests, "dyn_literal_no_ast_model", "build", "NodeType", 0,
        format(til_bin, " translate -c gen/c/dyn_literal.c test/dyn_literal.til '&&' cat gen/c/dyn_literal.c"))
    add_count(tests, "minimal_reach_no_comptime_type", "build", "Primitive_TAG", 0,
        format(til_bin, " translate -c gen/c/minimal_reach_ct.c test/minimal_reach.til '&&' cat gen/c/minimal_reach_ct.c"))
    add_count(tests, "minimal_reach_no_unread_global", "build", "UNREAD_GLOBAL", 0,
        format(til_bin, " translate -c gen/c/minimal_reach_ug.c test/minimal_reach.til '&&' cat gen/c/minimal_reach_ug.c"))
    // No generated helper exists only because __attribute__((unused)) lets
    // it compile: every emitted static has a real C reference. first_class
    // is the fixture with the most closure machinery -- lifted lambdas,
    // capture blocks, Body fields and their defaults.
    // Issue #326: a CLI main roots only the argv converters ITS signature
    // needs. cli_args takes `..Str`, which parses inline to a Str_clone, so
    // none of the Str.to_* family may appear -- the whole family used to be
    // seeded for every CLI or GUI program.
    add_count(tests, "cli_args_exact_argv_roots", "build", "Str_to_", 0,
        format(til_bin, " translate -c gen/c/cli_args_roots.c examples/cli_args.til '&&' cat gen/c/cli_args_roots.c"))
    // An accessor the builder splices at every call site gets no
    // out-of-line definition and no prototype. cli_args' `for a : Str in
    // args` loop calls Array.len and Array.unsafe_get on every iteration,
    // and both are inlined, so neither name may appear at all.
    add_count(tests, "cli_args_no_inlined_accessors", "build", "Array__Str_unsafe_get", 0,
        format(til_bin, " translate -c gen/c/cli_args_acc.c examples/cli_args.til '&&' cat gen/c/cli_args_acc.c"))
    // Issue #326: a library is scavenged like every other mode, with its
    // EXPORTED declarations as roots. test/pure.til is 43 lines and used to
    // emit 21,264 -- the whole of core and std, the compiler's own
    // Expr/NodeType model included -- because library mode skipped
    // scavenging outright.
    add_count(tests, "pure_lib_no_ast_model", "build", "NodeType", 0,
        format(til_bin, " translate -c gen/c/pure_reach.c test/pure.til '&&' cat gen/c/pure_reach.c"))
    // Issue #326: a variant's C constructor is emitted only where some
    // expression actually CONSTRUCTS it. Surviving the ns member sweep is not
    // enough -- an enum with any live value gets a generated
    // delete/eq/to_str/clone that names every variant in an `is_n` tag check,
    // which lowers to a compound-literal compare, not a call. The old blanket
    // rule declared a ctor for each of those, so pure.til carried prototypes
    // whose definitions the scavenger had already dropped: declared, never
    // defined, never called. `Type.Unknown` is the witness -- test/pure.til
    // reaches core's `Type` enum but never builds that variant.
    add_count(tests, "pure_no_unbuilt_variant_ctor", "build", "Type_Unknown", 0,
        format(til_bin, " translate -c gen/c/pure_variant.c test/pure.til '&&' cat gen/c/pure_variant.c"))
    // The auto-generated `size` method is emitted from the namespace index,
    // which says the member exists -- not that any C calls it. At a matching
    // build width the constfolder folds every `T.size()` to a literal, so
    // each one was a never-called `return sizeof(T);`: 55 of them in this
    // fixture. It is dead only in the C -- the INTERPRETER resolves
    // `T.size()` by runtime name off the AST, which is why `*.size` stays a
    // scavenger root for anything interpretable. `Color` is the witness: a
    // user enum whose size nothing asks for. The `both` entry runs the same
    // fixture interpreted, where that AST declaration still answers.
    // A bare `Enum.Variant` expression never lowers to a call -- the
    // builder splices the value in place as `(E){.tag = E_TAG_V}`,
    // `&(E){...}` or an inline malloc-and-tag in return position -- so
    // recording every field access as a construction site kept a
    // constructor no C calls. test/match.til is the fixture that is
    // nothing BUT bare variant expressions (match scrutinees and case
    // labels), and `Color_Red` must not appear at all; the tags it really
    // compiles to, `Color_TAG_Red`, are what the `both` entry exercises.
    // The generated dispatch that could call an otherwise-omitted method is
    // asked per METHOD, not per family. test/dyn_vecs.til is the fixture
    // that proves it: it dispatches through std/dyn_array, whose
    // `dyn_fn(elem_type, "clone")` registers `*.clone` and says nothing
    // about `unsafe_get` -- which is spliced at every call site, so no
    // out-of-line copy may survive. `U8_size` in the same output covers the
    // other half: core writes `size` by hand for the primitives, the
    // constfolder folds every call to a literal, and the definition is
    // reachable only through the interpreter's `*.size` root.
    add_count(tests, "dyn_vecs_no_uncalled_helpers", "build", "Array__Str_unsafe_get", 0,
        format(til_bin, " translate -c gen/c/dyn_vecs_h.c test/dyn_vecs.til '&&' cat gen/c/dyn_vecs_h.c"))
    add_count(tests, "dyn_vecs_no_uncalled_size", "build", "U8_size", 0,
        format(til_bin, " translate -c gen/c/dyn_vecs_sz.c test/dyn_vecs.til '&&' cat gen/c/dyn_vecs_sz.c"))
    add_count(tests, "match_no_uncalled_variant_ctor", "build", "Color_Red", 0,
        format(til_bin, " translate -c gen/c/match_ctor.c test/match.til '&&' cat gen/c/match_ctor.c"))
    // A core_func/ext_func namespace method has no emitted body -- an
    // enum's auto-generated `is` is lowered to a typed tag compare, an
    // ext_func's symbol lives in ext.c. Four of the six ns
    // forward-declaration loops skipped those; two did not, and
    // emit_func_forward_decl's own guard is gated on `top_level`, false for
    // a member. So each one got a prototype nothing defines and nothing
    // calls -- 61 in til's own output. `Color_is` is the witness.
    // An enum's clone/delete/eq are emitted only where a real call survives.
    // Stack-local payload-less enum deletes remain no-ops and are omitted;
    // clone calls use the same value-return ABI as every other til function.
    // A tag enum is anonymous: only the E_TAG_* enumerators are ever
    // referenced (the tag field is typed by its explicit width), so the
    // old `typedef enum {...} E_tag;` left one never-used typedef name per
    // enum -- zero uses across the whole corpus.
    add_count(tests, "enums_no_dead_tag_typedef", "build", "_tag;", 0,
        format(til_bin, " translate -c gen/c/enums_tt.c test/enums.til '&&' cat gen/c/enums_tt.c"))
    add_count(tests, "aliases_pod_clone_value_abi", "build", "static Point Point_clone(Point * self)", 2,
        format(til_bin, " translate -c gen/c/aliases_pc.c test/aliases.til '&&' cat gen/c/aliases_pc.c"))
    add_count(tests, "structs_pod_clone_value_abi", "build", "static CmpPoint CmpPoint_clone(CmpPoint * self)", 2,
        format(til_bin, " translate -c gen/c/structs_pc.c test/structs.til '&&' cat gen/c/structs_pc.c"))
    // A swap_replace on a Str target never calls swap_bytes -- the builder
    // writes the delete-copy-free sequence instead -- so the callee is not
    // a reachability root there and the definition goes with it. Safe to
    // sweep only because scavenge_imported erases swept names from the
    // scope registries; the first attempt left check_fcall_mut_args
    // resolving the swept name into a freed Expr (ASAN-caught here).
    add_count(tests, "strings_no_uncalled_swap_bytes", "build", "swap_bytes", 0,
        format(til_bin, " translate -c gen/c/strings_sw.c test/strings.til '&&' cat gen/c/strings_sw.c"))
    add_count(tests, "enums_no_uncalled_lifecycle", "build", "TagU8_delete", 0,
        format(til_bin, " translate -c gen/c/enums_lc.c test/enums.til '&&' cat gen/c/enums_lc.c"))
    add_count(tests, "enums_payload_clone_value_abi", "build", "static ColorG ColorG_clone(ColorG * self)", 2,
        format(til_bin, " translate -c gen/c/enums_pc.c test/enums.til '&&' cat gen/c/enums_pc.c"))
    // #302 stage 4 / #326: a drain-only delete must still be emitted --
    // both the scavenger's reachability walk and the builder's lifecycle
    // gate have to see the conjured `T_delete(_old, ...)` site. Fails to
    // COMPILE without either root ("implicit declaration").
    add_single(tests, "drain_only_delete", "build", 0, "",
        format(til_bin, " run test/drain_only_delete.til"))
    add_count(tests, "enums_no_orphan_prototype", "build", "Color_is", 0,
        format(til_bin, " translate -c gen/c/enums_proto.c test/enums.til '&&' cat gen/c/enums_proto.c"))
    // Clone calls now share the ordinary value-return ABI rather than a
    // POD-specific splice path.
    add_count(tests, "bug256_move_clone_value_abi", "build", "static Node Node_clone(Node * self)", 2,
        format(til_bin, " translate -c gen/c/bug256_mc.c test/bug256.til '&&' cat gen/c/bug256_mc.c"))
    // The prelude used to define print_single/print_flush in every
    // program. They are core ext_procs reached only through println/print,
    // so a program that never prints must not get them -- nor their
    // prototypes.
    add_count(tests, "no_print_prelude_when_unused", "build", "print_single", 0,
        format(til_bin, " translate -c gen/c/cce_pp.c test/capture_compile_error.til '&&' cat gen/c/cce_pp.c"))
    // Every prototype used to be emitted twice: the monolithic header and
    // emit_all_forward_declarations were two drifted copies of the same
    // four walks. One prototype, one definition, one mention at the call.
    add_count(tests, "hello_no_duplicate_prototypes", "build", "void println(Array__Str * parts)", 2,
        format(til_bin, " translate -c gen/c/hs_dp.c examples/hello_script.til '&&' cat gen/c/hs_dp.c"))
    // The __builtin_unreachable terminator answers a GCC mis-fire that
    // needs a CFG it cannot follow. A body whose LAST statement is a plain
    // `return` has none: the marker there is a dead statement after an
    // unconditional return, and every function in this fixture ends that
    // way.
    add_count(tests, "hello_no_unreachable_after_return", "build", "__builtin_unreachable", 0,
        format(til_bin, " translate -c gen/c/hs_ur.c examples/hello_script.til '&&' cat gen/c/hs_ur.c"))
    // ...and the bodies that DO need it keep it: test/option.til's
    // Option arms return from every branch of an exhaustive switch, which
    // is exactly the CFG GCC stops following under -finstrument-functions.
    add_count(tests, "option_keeps_needed_unreachable", "build", "__builtin_unreachable", 12,
        format(til_bin, " translate -c gen/c/opt_ur.c test/option.til '&&' cat gen/c/opt_ur.c"))
    // A delete's call_free Bool literal is read by value in both back
    // ends, and the C emitter overrides it for a stack local -- so
    // hoisting it manufactured a dead `Bool hoisted__Bool_N` binding at
    // every overridden site, cast away with the `(void)hoisted__` this
    // issue's invariant forbids (structs.til had the corpus's last 5).
    add_count(tests, "structs_no_void_hoisted_cast", "build", "(void)hoisted__", 0,
        format(til_bin, " translate -c gen/c/structs_vh.c test/structs.til '&&' cat gen/c/structs_vh.c"))
    // The reflection stubs opened with a blanket `(void)` on every
    // parameter -- casting names their own dispatch arms and error exits
    // READ, which is the Str_size mis-cast from the post-mortem all over
    // again. The exits already read type_name; the index-taking ones now
    // report the offending index too, so every parameter is genuinely
    // read and no cast survives. first_class.til emits the widest stub
    // set (struct_field_*, enum_variant_*, func_sig_*).
    add_count(tests, "first_class_no_stub_param_casts", "build", "(void)type_name", 0,
        format(til_bin, " translate -c gen/c/fc_vc.c test/first_class.til '&&' cat gen/c/fc_vc.c"))
    add_count(tests, "first_class_index_in_range_error", "build", "index %lld out of range", 12,
        format(til_bin, " translate -c gen/c/fc_ir.c test/first_class.til '&&' cat gen/c/fc_ir.c"))
    // An interface's ABSTRACT method has no definition anywhere --
    // implementers copy the defaults and supply their own bodies, and
    // dispatch goes to the copies -- so its prototype was a
    // declared-never-defined name, the corpus's last one that is not a
    // genuine external (ext.c / vendor).
    add_count(tests, "interfaces_no_abstract_prototype", "build", "Drawable_draw", 0,
        format(til_bin, " translate -c gen/c/if_ap.c test/interfaces.til '&&' cat gen/c/if_ap.c"))
    // A generic template's body is not a reachability blob: methods root
    // per qualified name, so Array.to_vec's Vec reference must not keep
    // Vec -- nor Vec's adopt_from -- in a program that never builds one.
    add_count(tests, "hello_no_template_blanket_root", "build", "adopt_from", 0,
        format(til_bin, " translate -c gen/c/hs_tb.c examples/hello_script.til '&&' cat gen/c/hs_tb.c"))
    // The literal pool is registered by the same rules the emitters spend
    // it by: dyn_type_to_str's 18 metadata strings pool only when that
    // declaration survives the scavenge, and a dyn_call/dyn_has_method
    // METHOD literal -- spliced into the C symbol name at every site --
    // never pools at all. interfaces.til exercises both (its pool held 20
    // entries nothing indexed).
    add_count(tests, "interfaces_pool_no_dead_metadata", "build", "(void *)\"StructDef\"", 0,
        format(til_bin, " translate -c gen/c/if_pm.c test/interfaces.til '&&' cat gen/c/if_pm.c"))
    // A typedef no emitted C mentions is not emitted: Dynamic's every
    // value position lowers to void*, so a program with no reflection
    // never spells the typedef out -- and one WITH reflection needs it
    // for the sizeof arms, both directions pinned here. The vendor
    // binding structs follow the same rule (a gui program that uses no
    // Vector4-taking function carries no Vector4 typedef).
    add_count(tests, "hello_no_dead_dynamic_typedef", "build", "} Dynamic;", 0,
        format(til_bin, " translate -c gen/c/hs_dy.c examples/hello_script.til '&&' cat gen/c/hs_dy.c"))
    add_count(tests, "dynamic_keeps_dynamic_typedef", "build", "} Dynamic;", 1,
        format(til_bin, " translate -c gen/c/dyn_dy.c test/dynamic.til '&&' cat gen/c/dyn_dy.c"))
    add_count(tests, "gui_no_dead_vendor_typedef", "build", "} Vector4;", 0,
        format(til_bin, " translate -c gen/c/hg_v4.c examples/hello_gui.til '&&' cat gen/c/hg_v4.c"))
    // A NICHE enum has no tag field -- the emitted code tests the pointer
    // against NULL -- so its E_TAG_* enumerators are constants nothing can
    // name; the block is not emitted (121 of them across the corpus).
    add_count(tests, "option_no_niche_tag_enumerators", "build", "Option__ref_OptSrc_TAG_None", 0,
        format(til_bin, " translate -c gen/c/opt_nt.c test/option.til '&&' cat gen/c/opt_nt.c"))
    // A CORE top-level function whose every call site sits inside a
    // definition the emit gates drop is not called by the emitted C.
    // UNREACHABLE is the witness: the initer plants a call in every
    // `guard_every` auto-clone body, so wherever those bodies are
    // omitted the definition is left with no caller (8 fixtures).
    // A program is a CLOSED WORLD, so its til functions carry `static`.
    // That is what puts the C compiler's -Wunused-function on permanent
    // duty over this issue's invariant: a future dead emission fails the
    // build instead of waiting to be surveyed. Exported core functions
    // remain non-static.
    // The bounds-checked `v[i]` is spliced at every call site, so the
    // out-of-line Vec.get has no caller -- the omission gate asks the
    // same predicate the emitter splices on, or the two disagree about
    // what exists and the definition is emitted with nothing calling it
    // (21 of them in til's own output the day the splice landed).
    add_count(tests, "vecs_no_uncalled_checked_get", "build", "Vec__I64_get(", 0,
        format(til_bin, " translate -c gen/c/vv_cg.c test/vecs.til '&&' cat gen/c/vv_cg.c"))
    add_count(tests, "hello_funcs_are_tu_local", "build", "static void println(Array__Str * parts)", 2,
        format(til_bin, " translate -c gen/c/hs_st.c examples/hello_script.til '&&' cat gen/c/hs_st.c"))
    // The GENERATED families join the audit too: a dyn wrapper exists
    // only to fill the closure value beside it, and the print prelude is
    // the program's own. Both bypassed emit_func_def, so both stayed
    // extern and unaudited -- ~1,870 definitions across the corpus.
    // The reflection stubs and variant constructors join too, and the
    // audit immediately found what the coarse name test had been hiding:
    // `builder_is_reflect_builtin_name` PREFIX-matched, so til's own
    // enum_variant_tag / _index / _type helpers made every self-translate
    // claim it needed reflection, emitting all seven enum_variant_* stubs
    // with no caller. The test names the builtins exactly now.
    // A program's GLOBALS are static too, which puts -Wunused-variable on
    // duty beside -Wunused-function. CAP_LIT/CAP_VIEW stay extern: the
    // hand-written ext.c stamps them, the same boundary as Str_clone.
    // TIL_CSTR's #define was unconditional -- a dead line in 121 of the
    // corpus's 140 generated files. It is emitted when some surviving
    // call actually passes a Str where an ext C function wants a char*,
    // asked with the same two predicates the emitter chooses on.
    // The closure runtime struct went into every program: TilClosure is
    // the C type of every FuncPtr / Body value, but 124 of the corpus's
    // 152 generated files have none. Its four sources are asked instead --
    // a value's type, a capture, the dyn dispatch inventory that emits
    // `static TilClosure` values, and dyn_size_of's Fn/Body sizeof arms.
    add_count(tests, "hello_no_closure_runtime", "build", "struct TilClosure {", 0,
        format(til_bin, " translate -c gen/c/hs_cr.c examples/hello_script.til '&&' cat gen/c/hs_cr.c"))
    add_count(tests, "closures_keep_closure_runtime", "build", "struct TilClosure {", 1,
        format(til_bin, " translate -c gen/c/cl_cr.c test/closures.til '&&' cat gen/c/cl_cr.c"))
    add_count(tests, "hello_no_unused_cstr_macro", "build", "#define TIL_CSTR", 0,
        format(til_bin, " translate -c gen/c/hs_cs.c examples/hello_script.til '&&' cat gen/c/hs_cs.c"))
    add_count(tests, "cstr_view_keeps_cstr_macro", "build", "#define TIL_CSTR", 1,
        format(til_bin, " translate -c gen/c/cv_cs.c test/cstr_view.til '&&' cat gen/c/cv_cs.c"))
    add_count(tests, "hello_globals_are_tu_local", "build", "static U32 CAP_LIT;", 0,
        format(til_bin, " translate -c gen/c/hs_gs.c examples/hello_script.til '&&' cat gen/c/hs_gs.c"))
    // Counted against gen/til/til.c, which `make` ALREADY produced to
    // build bin/til -- the first version re-translated src/til.til here,
    // adding a second copy of the suite's single slowest job in a
    // wall-visible category (the exact mistake self_translate's comment
    // warns about; the merge box's wall_ms jumped ~23s and stayed there).
    add_count(tests, "til_no_unneeded_reflect_family", "build", "static I64 enum_variant_count(", 0,
        "cat gen/til/til.c")
    // ...and a program that really does reflect still gets them.
    add_count(tests, "first_class_keeps_reflect_family", "build", "static I64 enum_variant_count(", 2,
        format(til_bin, " translate -c gen/c/fc_rf.c test/first_class.til '&&' cat gen/c/fc_rf.c"))
    add_count(tests, "closures_dyn_wrapper_is_tu_local", "build", "static void *Mode_clone_dyn(", 1,
        format(til_bin, " translate -c gen/c/ci_dw.c test/closures_interp.til '&&' cat gen/c/ci_dw.c"))
    add_count(tests, "hello_print_prelude_is_tu_local", "build", "static void print_single(Str *s)", 2,
        format(til_bin, " translate -c gen/c/hs_pp.c examples/hello_script.til '&&' cat gen/c/hs_pp.c"))
    add_count(tests, "hello_ext_c_boundary_stays_extern", "build", "\nStr Str_clone(Str * val) {", 1,
        format(til_bin, " translate -c gen/c/hs_sx.c examples/hello_script.til '&&' cat gen/c/hs_sx.c"))
    add_count(tests, "aliases_clone_keeps_unreachable", "build", "void UNREACHABLE(", 2,
        format(til_bin, " translate -c gen/c/al_ur.c test/aliases.til '&&' cat gen/c/al_ur.c"))
    // ...and it stays wherever a surviving body does call it: enums.til's
    // switch has a `case:` wildcard arm whose body calls UNREACHABLE.
    add_count(tests, "enums_keeps_called_unreachable", "build", "void UNREACHABLE(", 2,
        format(til_bin, " translate -c gen/c/en_ur.c test/enums.til '&&' cat gen/c/en_ur.c"))
    // The literal exposed DCE's trivial-delete matcher to CONSUMING
    // deletes: Array.unsafe_set's `T.delete(own self.unsafe_get(i),
    // false)` hoists its receiver into a ref temp, and with call_free a
    // literal the matcher saw `Str.delete(<ident>, false)` and pruned the
    // old-element drop -- an `own` arg is real semantics, never a temp
    // cleanup, and the matcher rejects it now. The two survivors here are
    // unsafe_set's drop plus Array.delete's per-element loop -- that loop
    // used to contribute TWO, because a range for-in emitted its body once
    // per direction; `0..self.cap` is statically ascending, so only the
    // ascending copy is built now.
    add_count(tests, "flow_keeps_consuming_deletes", "build", "Str_delete(hoisted__", 2,
        format(til_bin, " translate -c gen/c/flow_cd.c test/flow.til '&&' cat gen/c/flow_cd.c"))
    add_count(tests, "errors_clone_value_abi", "build", "static ErrorWithMessage ErrorWithMessage_clone(ErrorWithMessage * self)", 2,
        format(til_bin, " translate -c gen/c/errors_mc.c test/errors.til '&&' cat gen/c/errors_mc.c"))
    add_count(tests, "tilminal_vec_clone_value_abi", "build", "static Vec__Str Vec__Str_clone(Vec__Str * self)", 2,
        format(til_bin, " translate -c gen/c/tilminal_vc.c examples/tilminal.til '&&' cat gen/c/tilminal_vc.c"))
    add_count(tests, "str_clone_value_abi", "build", "Str Str_clone(Str * val)", 2,
        format(til_bin, " translate -c gen/c/hs_sc.c examples/hello_script.til '&&' cat gen/c/hs_sc.c"))
    // The forward header is written BEFORE the .c, so it has to gate on
    // the same settled inventory -- it used to see an empty one and omit
    // every lifecycle method the .c then defined. ext.c compiles against
    // this header, so Str_clone's value prototype is the witness.
    add_count(tests, "forward_header_gates_on_same_inventory", "build", "Str Str_clone(Str * val);", 1,
        format(til_bin, " translate -c gen/c/hs_fh.c examples/hello_script.til '&&' cat gen/c/hs_fh_forward.h"))
    add_count(tests, "enums_no_uncalled_size", "build", "Color_size", 0,
        format(til_bin, " translate -c gen/c/enums_size.c test/enums.til '&&' cat gen/c/enums_size.c"))
    add_count(tests, "first_class_no_dead_field_default", "build", "unused_default_op", 0,
        format(til_bin, " translate -c gen/c/first_class_fd.c test/first_class.til '&&' cat gen/c/first_class_fd.c"))
    add_count(tests, "first_class_no_unused_attrs", "build", "__attribute__((unused))", 0,
        format(til_bin, " translate -c gen/c/first_class_attrs.c test/first_class.til '&&' cat gen/c/first_class_attrs.c"))

    // Tests are registered slowest-first: run_all_parallel fills its parallel
    // slots in registration order and never reorders, so front-loading the
    // long-running jobs (GUI builds, then the slow both tests) keeps the
    // parallel tail short. The ordering below is based on per-test times from
    // a full `make test` run.

    // === GUI build tests (slowest: build + run with timeout) ===
    // Issue #266: GUI tests run as plain X clients of the single Xvfb that
    // the Makefile's outer `xvfb-run` starts for the whole suite (DISPLAY
    // is inherited). The old per-test `xvfb-run --auto-servernum` spawned
    // 16 nested X servers whose EXIT-trap teardowns raced on their /tmp
    // auth dirs: a failed `rm -r` there rewrote the healthy 124 exit
    // (from `timeout`) into xvfb-run's own exit 5.
    if en_gui == 1 {
        gui_files := array(Str,
            "examples/music_modes.til",
            "examples/piano.til",
            "examples/guitar.til",
            "examples/chess.til",
            "examples/checkers.til",
            "examples/go.til",
            "examples/snake.til",
            "examples/shootil.til",
            "examples/editor.til",
            "examples/minesweeper.til",
            "examples/font_test.til",
            "examples/popcorn.til",
            "examples/tilminal.til",
            "examples/game_of_life.til",
            "examples/hello_gui.til",
            "examples/raylib.til",
        )
        // GNU coreutils `timeout` is `gtimeout` on macOS (brew installs it
        // g-prefixed; stock macOS ships no `timeout` at all). Pick the right
        // name per host so GUI tests run on a mac, not just Linux (#25).
        mut timeout_cmd := "timeout"
        if host_os() == "macos" { timeout_cmd = "gtimeout" }
        // Interpreted gui smoke test (issue: raylib unreachable from the
        // interpreter). Every entry above BUILDS first, so the interpreted
        // FFI path had no coverage at all -- `til repl` in mode gui opened
        // no window while the suite stayed green. Runs under the suite's
        // outer xvfb-run like the rest of this block, and is skipped by
        // --no-gui with them.
        // Windowless on purpose (see the file header), so it needs no GL
        // context and keeps leak detection on, unlike an InitWindow test.
        add_single(tests, "interp_gui_ffi", "build", 0, "",
            format(til_bin, " test/gui_interp.til"))
        for gf : Str in gui_files {
            bn := test_basename(gf)
            mut run_args := ""
            if bn == "popcorn" { run_args = " --mute" }
            add_single(tests, format("build_", bn), "build", 124, "",
                format(til_bin, " build", asan_flag, " ", gf, " '&&' ", timeout_cmd, " ", GUI_TIMEOUT, " bin/", bn, run_args))
        }
    }

    // === both tests (sorted slowest-first) ===
    add_both(tests, "test/hashmaps.til", flags)
    add_both(tests, "test/dyn_hashmaps.til", flags)
    add_both(tests, "test/kwargs.til", flags)
    add_both(tests, "test/constfold.til", flags)
    add_both(tests, "test/strings.til", flags)
    add_both(tests, "test/enums.til", flags)
    add_both(tests, "test/option.til", flags)
    add_both(tests, "test/match.til", flags)
    add_both(tests, "test/lazy.til", flags)
    add_both(tests, "test/dynamic.til", flags)
    add_both(tests, "test/maps.til", flags)
    add_both(tests, "test/dyn_maps.til", flags)
    add_both(tests, "test/hashes.til", flags)
    add_both(tests, "test/operators.til", flags)
    add_both(tests, "test/flow.til", flags)
    add_both(tests, "test/asting.til", flags)
    // parsing.til drives the whole self-parser; interpreting it costs
    // ~15s for coverage the compiled run and every other test's parse
    // step already give. Compile-only. The interpreter payload bugs it
    // exposed (inline-enum-payload ownership, borrow-preserving ref
    // returns) are covered cheaply by test/enums_lifecycle.til's
    // regression tests, which stay on both backends.
    add_both(tests, "test/parsing.til", format(flags, " -no-interp"))
    add_both(tests, "test/structs.til", flags)
    add_both(tests, "test/interfaces.til", flags)
    add_both(tests, "test/types.til", flags)
    add_both(tests, "test/cast.til", flags)
    add_both(tests, "test/directives.til", flags)
    add_both(tests, "test/variadic.til", flags)
    add_both(tests, "test/loops.til", flags)
    add_both(tests, "test/aliases.til", flags)
    add_both(tests, "test/fn_ptr.til", flags)
    add_both(tests, "test/comparisons.til", flags)
    add_both(tests, "test/vecs.til", flags)
    add_both(tests, "test/dyn_vecs.til", flags)
    add_both(tests, "test/eval_heap.til", flags)
    add_both(tests, "test/ownership_shapes.til", flags)
    add_both(tests, "test/dynamic_ptr.til", flags)
    add_both(tests, "test/templ_vec.til", flags)
    add_both(tests, "test/templ_cross_unit.til", flags)
    add_both(tests, "test/templ_type_only.til", flags)
    add_both(tests, "test/priv.til", flags)
    add_both(tests, "test/trailing.til", flags)
    add_both(tests, "test/globals.til", flags)
    add_both(tests, "test/errors.til", flags)
    add_both(tests, "test/tuples.til", flags)
    add_both(tests, "test/auto.til", flags)
    add_both(tests, "test/first_class.til", flags)
    add_both(tests, "test/generic_infer_imports.til", flags)
    add_both(tests, "test/closures.til", flags)
    add_both(tests, "test/regression.til", flags)
    add_both(tests, "test/repl_editor.til", flags)
    add_both(tests, "test/files.til", flags)
    add_both(tests, "test/process.til", flags)
    add_both(tests, "test/circular_imports.til", flags)
    add_both(tests, "test/import_diamond.til", flags)
    // macros.til contains a macro that prints during constfolder; the line
    // appears in interpret output but not in compiled-run output, so
    // skip the run-vs-interp comparison.
    add_both(tests, "test/macros.til", format(flags, " -no-match"))
    add_both(tests, "test/sets.til", flags)
    add_both(tests, "test/dyn_sets.til", flags)
    add_both(tests, "test/hashsets.til", flags)
    add_both(tests, "test/local_defs.til", flags)
    add_both(tests, "test/shallow.til", flags)
    add_both(tests, "test/globals_cli.til", flags)
    add_both(tests, "test/own_fields.til", flags)
    add_both(tests, "test/bug256.til", flags)
    add_both(tests, "test/bug258.til", flags)
    add_both(tests, "test/bug315.til", flags)
    add_both(tests, "test/bug350.til", flags)
    // A mode-cli main that RETURNS a value: interpreting one panicked
    // ("return type read outside a call") until interpret_units gave
    // main the same return context every other call gets. Both
    // backends, standard both entry -- the interpreted leg's panic is
    // exactly what a both entry turns red on.
    add_both(tests, "test/main_return.til", flags)
    add_both(tests, "test/dead_temps.til", flags)
    add_both(tests, "test/minimal_reach.til", flags)
    add_both(tests, "test/dyn_literal.til", flags)
    add_both(tests, "test/mut_arg_str_lit.til", flags)
    add_both(tests, "test/mut_capture_str_lit.til", flags)
    add_both(tests, "test/literal_field_access.til", flags)
    add_both(tests, "test/float_literals.til", flags)
    // Issue #176: binding libc functions like setenv/getenv directly must
    // compile under -Werror and produce the expected behaviour; also covers
    // std/sys's get_env wrapper over that same libc getenv. On both
    // backends because they marshal the bindings separately -- the
    // interpreter goes through libffi and its own `returns ref` handling,
    // which is what borrows the environ pointer.
    add_both(tests, "test/ext_libc.til", flags)
    add_both(tests, "examples/priv_demo.til", flags)
    add_both(tests, "test/imports.til", flags)
    add_both(tests, "test/arrays.til", flags)
    add_both(tests, "test/dyn_arrays.til", flags)
    add_both(tests, "test/test_in_namespace.til", flags)
    add_both(tests, "test/forward_refs.til", flags)
    add_both(tests, "test/functions.til", flags)
    // TODO: namespaces.til fails the typer: MyNamespace.set is a proc with no
    // proc/ext_proc calls and the typer now demands it be a func. Update the
    // test (or the rule) then re-enable.
    // add_both(tests, "test/namespaces.til", flags)
    // topo_sort.til: re-enabled on both backends. The interp segfault
    // (a 3+-level nested inline-struct assign like c.b.a.x = 42 walked
    // only one chain link, then wrote through a null field decl) is fixed.
    add_both(tests, "test/topo_sort.til", flags)
    add_both(tests, "test/ref.til", flags)
    // enums_lifecycle ran compile-only for years: interpreting it tripped
    // the inline-enum-payload aliasing bug (write_field byte-copied the
    // ctor temp's payload and the temp's delete freed the shared Str
    // storage). Fixed -- both backends now.
    add_both(tests, "test/enums_lifecycle.til", flags)
    // doc_block_comments imports the lexer and builds Tokens (U32 fields),
    // so it runs compile-only like the lexing tests below (issue #182).
    add_both(tests, "test/doc_block_comments.til", mode_flags(0, en_run, asan_flag))
    // TODO: lexing.til and parsing.til fail interp mode after Token line/col I64->U32
    // (interpreter doesn't handle U32 struct fields correctly)
    // add_both(tests, "test/lexing.til", flags)
    // add_both(tests, "test/parsing.til", flags)
    // TODO(#114): help()/doc comments are REPL-only for now; doc_comments.til
    // assumes docs are populated for til test / til interpret.
    // add_both(tests, "test/doc_comments.til", flags)
    write_doc_doctests(DOC_DOCTEST_FILE)
    add_both(tests, DOC_DOCTEST_FILE, flags)

    // === 2 FFI tests ===
    ffi_exp := "gen/out/expected/ffi.out"
    File.writefile(ffi_exp, format("hello world", NL, "hello universe", NL))
    add_single(tests, "ffi_interp", "ffi", 0, ffi_exp,
        format(til_bin, " interpret examples/ffi/ext_module.til"))
    add_single(tests, "ffi_run", "ffi", 0, ffi_exp,
        format(til_bin, " run", asan_flag, " examples/ffi/ext_module.til"))
    ffi_scavenge_exp := "gen/out/expected/ffi_scavenge.out"
    File.writefile(ffi_scavenge_exp, "ok")
    add_single(tests, "ffi_scavenge_link_c_run", "ffi", 0, ffi_scavenge_exp,
        format(til_bin, " run", asan_flag, " test/ffi_scavenge_link_c.til"))
    // Issue #283: a real dlopen failure must be reported loudly at RUNTIME.
    // The diagnostic's eprint_single/ffi_last_error are ext_proc so the
    // const-folder never executes them at build time (which printed a bogus
    // line and dropped the runtime report). Assert the message appears exactly
    // once when interpreting a file whose FFI .so fails to load.
    //
    // The failure SHAPE is platform-dependent (issue #25): ELF defers
    // undefined symbols to dlopen time, so the .so builds and dlopen
    // fails; Mach-O's linker refuses the undefined symbol while BUILDING
    // the .so, so the loud runtime report is the compile failure instead.
    // Both paths exercise the same #283 guarantee: the interpreter
    // reports the FFI load problem at runtime rather than swallowing it.
    mut dlopen_fail_pat := "dlopen failed"
    if host_os() == "macos" { dlopen_fail_pat = "failed to compile FFI library" }
    add_count(tests, "ffi_dlopen_fail_interp", "ffi", dlopen_fail_pat, 1,
        format(til_bin, " interpret test/ffi_dlopen_fail.til"))

    // === library mode checks (pure/pura build are the heaviest here) ===
    add_single(tests, "pure_build", "library", 0, "",
        format(til_bin, " build", asan_flag, " test/pure.til"))
    add_single(tests, "pura_build", "library", 0, "",
        format(til_bin, " build", asan_flag, " test/pura.til"))
    add_single(tests, "pure_interp_forbidden", "library", 1, "",
        format(til_bin, " interpret test/pure.til"))
    add_single(tests, "pure_run_forbidden", "library", 1, "",
        format(til_bin, " run", asan_flag, " test/pure.til"))
    add_single(tests, "pura_interp_forbidden", "library", 1, "",
        format(til_bin, " interpret test/pura.til"))
    add_single(tests, "pura_run_forbidden", "library", 1, "",
        format(til_bin, " run", asan_flag, " test/pura.til"))

    // === build tests: svg2ttf + issues summary ===
    // svg2ttf: transparent 2-colour logo produces img/til_logo.ttf (exit=0);
    // the full-colour logo panics with "too many colours" (exit=1).
    // Compiled-run only (no interpret variant); the interpreted run takes
    // ~90s and dominates wall time. Categorised as "build" so its time goes
    // into build_ms rather than cli_ms in totals.
    run("mkdir -p img")
    add_single(tests, "svg2ttf_ok", "build", 0, "",
        format(til_bin,
            " run", asan_flag, " -o bin/c/svg2ttf_ok -c gen/c/svg2ttf_ok.c ",
            "examples/svg2ttf.til ",
            "img/logo-transparent.svg img/til_logo.ttf"))
    add_single(tests, "svg2ttf_too_many_colors", "build", 1, "",
        format(til_bin,
            " run", asan_flag, " -o bin/c/svg2ttf_too_many_colors -c gen/c/svg2ttf_too_many_colors.c ",
            "examples/svg2ttf.til ",
            "img/logo.svg tmp/svg2ttf_fail.ttf"))
    // The bindgen's output has to be til the compiler still accepts. Nothing
    // checked that, because `make update_c_libs` is a manual step and the
    // committed vendor/bindings/*.til carry hand-audited edits -- so as the
    // language tightened, the emitter kept writing forms the typer had come
    // to reject (`mut` on a struct field, `7.to_i32()` under an explicit
    // `: I32`, `ext_struct("")` for an untagged struct) and a regen produced
    // 305 type errors. raylib.h is the header that exercises structs, enums
    // and function decls together; translating the result typechecks it.
    add_single(tests, "bindgen_typechecks", "build", 0, "",
        format(til_bin, " bindings -o tmp/bindgen_raylib.til vendor/raylib/src/raylib.h",
            " '&&' ", til_bin, " translate tmp/bindgen_raylib.til"))
    // Regenerating over an audited file must reproduce it. A C header cannot
    // express til's qualifier axes, so every committed binding carries human
    // answers -- ext_proc tags, own/ref overrides, Option re-typings and the
    // comments explaining them -- that regeneration used to erase, which is
    // why nobody ran `make update_c_libs` and the generator drifted until its
    // output stopped type-checking (#333). tinyfd is the file with no
    // hand-ADDED declarations, so a byte-identical result is the whole
    // property, with no manual re-add step to subtract first.
    add_single(tests, "bindgen_preserves_audit", "build", 0, "",
        format("cp vendor/bindings/tinyfd.til tmp/audit_probe.til",
            " '&&' ", til_bin, " bindings -o tmp/audit_probe.til vendor/tinyfiledialogs/tinyfiledialogs.h",
            " '&&' diff tmp/audit_probe.til vendor/bindings/tinyfd.til"))
    // issues.til is fast enough to keep in the regular suite; it refreshes
    // issues/summary.org from the current issue files.
    add_single(tests, "issues_summary", "build", 0, "",
        format(til_bin,
            " run", asan_flag, " -o bin/c/issues_summary -c gen/c/issues_summary.c ",
            "examples/issues.til"))

    // === custom modes build tests ===
    add_single(tests, "build_sender", "build", 0, "",
        format(til_bin, " build", asan_flag, " -o bin/sender --extra-modes=examples/custom_modes.til examples/sender.til"))
    add_single(tests, "build_receiver", "build", 0, "",
        format(til_bin, " build", asan_flag, " -o bin/receiver --extra-modes=examples/custom_modes.til examples/receiver.til"))
    add_single(tests, "build_publisher", "build", 0, "",
        format(til_bin, " build", asan_flag, " -o bin/publisher --extra-modes=examples/custom_modes.til examples/publisher.til"))
    add_single(tests, "build_subscriber", "build", 0, "",
        format(til_bin, " build", asan_flag, " -o bin/subscriber --extra-modes=examples/custom_modes.til examples/subscriber.til"))
    // Interpreted nng smoke test. The four builds above never interpret, so
    // nothing noticed that the Makefile built no libnng.so twin and every
    // nng-mode program died at interpret startup on the fatal twin-load
    // panic (ffi_load_archive_twin) -- the same blind spot that hid #308,
    // one library over. Windowless and networkless: version + strerror
    // pointers and an inproc-free socket open/close.
    add_single(tests, "interp_nng_ffi", "build", 0, "",
        format(til_bin, " interpret --extra-modes=examples/custom_modes.til test/nng_interp.til"))

    // === til test command (issue #51): runs interpret + compile-and-run
    // and counts "tests passed" lines so both backends are exercised.
    add_count(tests, "til_test_cmd", "test", "tests passed", 2,
        format(til_bin, " test", asan_flag, " test/test_in_namespace.til"))

    // === parser / typer diagnostics ===
    add_count(tests, "typer_errors", "typer", "error:", 212,
        format(til_bin, " interpret test/typer_errors.til"))
    // #342: a splat whose elements do not match is reported, not passed
    // through to crash the callee -- four variadic shapes, the two literals,
    // and a Vec source, which the two backends used to disagree about.
    add_count(tests, "splat_elem_type", "typer", "splat of", 8,
        format(til_bin, " interpret test/typer_errors.til"))
    parity_cmd := format(til_bin, " interpret test/fcall_arg_parity_error.til")
    add_count(tests, "fcall_arg_parity_total", "typer", "error:", 12, parity_cmd)
    add_count(tests, "fcall_arg_parity_duplicate", "typer",
        "duplicate argument for parameter", 2, parity_cmd)
    add_count(tests, "fcall_arg_parity_missing", "typer",
        "missing argument for parameter", 2, parity_cmd)
    add_count(tests, "fcall_arg_parity_extra", "typer",
        "too many arguments: expected 2, got 3", 2, parity_cmd)
    add_count(tests, "fcall_arg_parity_named_order", "typer",
        "positional argument after named argument", 2, parity_cmd)
    add_count(tests, "fcall_arg_parity_type", "typer",
        "argument type mismatch", 2, parity_cmd)
    add_count(tests, "fcall_arg_parity_own", "typer",
        "must be marked", 2, parity_cmd)
    // #342: a `..` past the last bit of the per-argument bitmap is refused,
    // not silently dropped into the lowering as an ordinary element.
    add_count(tests, "splat_arg_limit", "typer",
        "must be among the first 63 arguments", 1,
        format(til_bin, " interpret test/splat_arg_limit_error.til"))
    add_count(tests, "capture_block_error", "typer",
        "is not captured", 2,
        format(til_bin, " interpret test/capture_block_error.til"))
    add_count(tests, "capture_func_error", "typer",
        "cannot capture immutable", 1,
        format(til_bin, " interpret test/capture_func_error.til"))
    // #54: an `[own x]` block capture consumes x; a later use is rejected.
    add_count(tests, "capture_block_own_error", "typer",
        "after ownership transfer", 1,
        format(til_bin, " interpret test/capture_block_own_error.til"))
    // #288: a core_func / core_proc is an inline-only primitive intrinsic and
    // cannot be indirected -- dyn_fn on one is a typer error (2 cases). Count
    // the enforcement substring, not "error:", since dyn_fn's Dynamic result
    // also (correctly) trips the "store Dynamic in '_'" diagnostic.
    add_count(tests, "core_func_errors", "typer",
        "cannot be indirected via dyn_fn", 2,
        format(til_bin, " interpret test/core_func_errors.til"))
    // A scope/namespace slot is only an Expr when the binding is callable.
    // Each of these used to deref a VALUE as a def and segfault the
    // interpreter; they now reach the diagnostic that was always there --
    // and both backends print it, so each one is a PAIR. The compiled half
    // is `run` where the error is raised by the emitted program (dyn_fn's
    // dispatcher) and `build` where the front end raises it before any C is
    // written (the main check, the introspection lookups).
    add_count(tests, "dyn_fn_value_member_error_interp", "interp",
        "dyn_fn: no method", 1,
        format(til_bin, " interpret test/dyn_fn_value_member_error.til"))
    add_count(tests, "dyn_fn_value_member_error_run", "interp",
        "dyn_fn: no method", 1,
        format(til_bin, " run", asan_flag, " -o bin/c/dyn_fn_value_member_error test/dyn_fn_value_member_error.til"))
    // The needle avoids the message's apostrophes: add_count single-quotes
    // it into the runner command line.
    add_count(tests, "main_value_error_interp", "interp",
        "this mode requires a", 1,
        format(til_bin, " interpret test/main_value_error.til"))
    add_count(tests, "main_value_error_build", "interp",
        "this mode requires a", 1,
        format(til_bin, " build -o bin/c/main_value_error test/main_value_error.til"))
    add_count(tests, "introspect_value_name_error_interp", "interp",
        "is not a struct", 1,
        format(til_bin, " interpret test/introspect_value_name_error.til"))
    add_count(tests, "introspect_value_name_error_build", "interp",
        "is not a struct", 1,
        format(til_bin, " build -o bin/c/introspect_value_name_error test/introspect_value_name_error.til"))
    // Issue #54: function closures run under both backends.
    add_single(tests, "closures_interp", "closures", 0, "",
        format(til_bin, " interpret test/closures_interp.til"))
    add_single(tests, "closures_compile", "closures", 0, "",
        format(til_bin, " run", asan_flag, " test/closures_interp.til"))
    add_single(tests, "closures_compile_escape", "closures", 0, "",
        format(til_bin, " run", asan_flag, " test/closures_compile_escape.til"))
    add_count(tests, "capture_escape_error", "typer",
        "returned closure borrows captured local", 1,
        format(til_bin, " interpret test/capture_escape_error.til"))
    // #54: the same escape via a GLOBAL slot rather than a return.
    add_count(tests, "capture_global_escape_error", "typer",
        "borrows captured local", 1,
        format(til_bin, " interpret test/capture_global_escape_error.til"))
    // #54: and via a global's FIELD.
    add_count(tests, "capture_global_field_escape_error", "typer",
        "borrows captured local", 1,
        format(til_bin, " interpret test/capture_global_field_escape_error.til"))
    // #54: a callee that STORES a parameter globally must own it.
    add_count(tests, "capture_callee_escape_error", "typer",
        "is stored where it outlives this call", 1,
        format(til_bin, " interpret test/capture_callee_escape_error.til"))
    add_count(tests, "capture_own_arg_escape_error", "typer",
        "own argument closure borrows captured local", 1,
        format(til_bin, " interpret test/capture_own_arg_escape_error.til"))
    add_count(tests, "capture_mut_escape_error", "typer",
        "returned closure borrows captured local", 1,
        format(til_bin, " interpret test/capture_mut_escape_error.til"))
    add_count(tests, "qualifier_shallow_local_error", "parser",
        "locals cannot use", 1,
        format(til_bin, " interpret test/qualifier_shallow_local_error.til"))
    add_count(tests, "qualifier_ref_param_error", "parser",
        "parameters are borrowed by default", 1,
        format(til_bin, " interpret test/qualifier_ref_param_error.til"))
    add_count(tests, "qualifier_returns_own_error", "parser",
        "returns are owned by default", 1,
        format(til_bin, " interpret test/qualifier_returns_own_error.til"))
    add_count(tests, "qualifier_const_local_error", "parser",
        "on local: locals are immutable by default", 1,
        format(til_bin, " interpret test/qualifier_const_local_error.til"))
    add_count(tests, "qualifier_const_param_error", "parser",
        "on parameter: parameters are immutable by default", 1,
        format(til_bin, " interpret test/qualifier_const_param_error.til"))
    add_count(tests, "qualifier_mut_payload_error", "parser",
        "on variant payload: payloads are mutable by default", 1,
        format(til_bin, " interpret test/qualifier_mut_payload_error.til"))
    add_count(tests, "qualifier_mut_field_error", "typer",
        "on struct field", 1,
        format(til_bin, " interpret test/qualifier_mut_field_error.til"))
    add_count(tests, "qualifier_const_namespace_error", "parser",
        "on namespace declaration: namespace decls are immutable by default", 1,
        format(til_bin, " interpret test/qualifier_const_namespace_error.til"))
    add_count(tests, "const_payload_error", "typer",
        "cannot assign to immutable variable", 1,
        format(til_bin, " interpret test/const_payload_error.til"))
    add_count(tests, "priv_error_interp", "typer",
        "is private to", 4,
        format(til_bin, " interpret test/priv_error.til"))
    add_count(tests, "priv_error_build", "typer",
        "is private to", 4,
        format(til_bin, " build", asan_flag, " test/priv_error.til"))
    // #154: unused-import check, on by default. The same file with an
    // unused import passes with --check-unused-imports=false.
    add_count(tests, "unused_import_error", "typer",
        "unused import", 1,
        format(til_bin, " interpret test/unused_import_error.til"))
    add_single(tests, "unused_import_error_off", "typer", 0, "",
        format(til_bin, " interpret --check-unused-imports=false test/unused_import_error.til"))
    add_single(tests, "unused_import_ok", "typer", 0, "",
        format(til_bin, " interpret test/unused_import_ok.til"))
    // Namespace-import alias: a member outside the imported file's
    // public decls fails at load time.
    add_count(tests, "import_ns_unknown_symbol", "typer",
        "no public symbol", 1,
        format(til_bin, " interpret test/import_ns_unknown_symbol.til"))
    add_count(tests, "priv_unused_error_interp", "typer",
        "unused priv", 7,
        format(til_bin, " interpret test/priv_unused_error.til"))
    add_count(tests, "priv_unused_error_build", "typer",
        "unused priv", 7,
        format(til_bin, " build", asan_flag, " test/priv_unused_error.til"))
    add_count(tests, "enum_switch_missing_case_interp", "typer",
        "non-exhaustive switch on enum", 4,
        format(til_bin, " interpret test/enum_switch_missing_case.til"))
    add_count(tests, "enum_switch_missing_case_build", "typer",
        "non-exhaustive switch on enum", 4,
        format(til_bin, " build", asan_flag, " test/enum_switch_missing_case.til"))
    // #334: a binding pattern sharing a `case a, b:` list is rejected, on
    // switch and match alike.
    add_count(tests, "multi_pattern_binding_interp", "typer",
        "cannot share a case with other patterns", 2,
        format(til_bin, " interpret test/multi_pattern_binding_error.til"))
    add_count(tests, "multi_pattern_binding_build", "typer",
        "cannot share a case with other patterns", 2,
        format(til_bin, " build", asan_flag, " test/multi_pattern_binding_error.til"))
    // A main() param whose type can't be parsed from a CLI argument is
    // rejected up front (validate_cli_main) on both backends.
    add_count(tests, "cli_unsupported_main_interp", "typer",
        "cannot be parsed from a CLI argument", 1,
        format(til_bin, " interpret test/cli_unsupported_main.til"))
    add_count(tests, "cli_unsupported_main_build", "typer",
        "cannot be parsed from a CLI argument", 1,
        format(til_bin, " build", asan_flag, " test/cli_unsupported_main.til"))
    // #242: missing-required-field cases live in test/typer_errors.til.
    // A no-default field with no explicit type stays illegal (parser).
    add_count(tests, "required_field_no_type_error", "parser",
        "expected", 1,
        format(til_bin, " interpret test/required_field_no_type_error.til"))

    // === CLI tests ===
    exp := "gen/out/expected/"

    File.writefile(format(exp, "cli_args_hello.out"), format("hello", NL, "world", NL))
    add_cli_pair(tests, "cli_args_hello", "examples/cli_args.til",
        "hello world", 0, format(exp, "cli_args_hello.out"), til_bin, asan_flag)
    add_single(tests, "cli_args_default_args", "cli", 0, format(exp, "cli_args_hello.out"),
        format(til_bin, " examples/cli_args.til hello world"))
    add_single(tests, "cli_args_dd_default_args", "cli", 0, format(exp, "cli_args_hello.out"),
        format(til_bin, " -- examples/cli_args.til hello world"))

    File.writefile(format(exp, "cli_args_empty.out"), "")
    add_cli_pair(tests, "cli_args_empty", "examples/cli_args.til",
        "", 0, format(exp, "cli_args_empty.out"), til_bin, asan_flag)

    mut fb_out := ""
    mut fbi := 1
    while fbi <= 100 {
        mut fb_line := ""
        if fbi % 15 == 0 {
            fb_line = "FizzBuzz"
        } else {
            if fbi % 3 == 0 {
                fb_line = "Fizz"
            } else {
                if fbi % 5 == 0 {
                    fb_line = "Buzz"
                } else {
                    fb_line = fbi.to_str()
                }
            }
        }
        fb_out = format(fb_out, fb_line, NL)
        fbi++
    }
    File.writefile(format(exp, "fizzbuzz.out"), fb_out)
    add_cli_pair(tests, "fizzbuzz", "examples/fizzbuzz.til",
        "", 0, format(exp, "fizzbuzz.out"), til_bin, asan_flag)

    // Issue #220: script-mode map/set literals must compile under -Werror.
    File.writefile(format(exp, "script_map_lit.out"),
        format("1", NL, "true", NL, "a", NL, "b", NL, "c", NL, "true", NL,
            "1", NL, "len=3 set=3", NL, "1", NL, "1", NL, "3", NL, "1", NL))
    add_cli_pair(tests, "script_map_lit", "test/script_map_lit.til",
        "", 0, format(exp, "script_map_lit.out"), til_bin, asan_flag)

    // A program-scope raw-allocator decl must give the global POINTER
    // storage like the function-local form; as a value global the
    // memset/ptr_add writes ran past a one-byte object (ASAN:
    // global-buffer-overflow).
    File.writefile(format(exp, "script_raw_alloc.out"), format("65", NL, "66", NL))
    add_cli_pair(tests, "script_raw_alloc", "test/script_raw_alloc.til",
        "", 0, format(exp, "script_raw_alloc.out"), til_bin, asan_flag)

    // An owned Dynamic declared from an erased-dynamic source (a deref()
    // result bound by ref) must copy the pointer word; the interpreter's
    // clone path deref'd the raw allocation itself and later freed a
    // garbage word (interpreter-only segfault; compiled mode was correct).
    File.writefile(format(exp, "script_dynamic_free.out"), format("ok", NL))
    add_cli_pair(tests, "script_dynamic_free", "test/script_dynamic_free.til",
        "", 0, format(exp, "script_dynamic_free.out"), til_bin, asan_flag)

    // The bang's synthesized panic prints the source location ONCE (via
    // panic's `loc` param) and a readable message; it used to pass the
    // location as a message part too, printing it twice and jamming it
    // against the type name. Exit code 1: panic exits non-zero.
    File.writefile(format(exp, "script_bang_panic_msg.out"),
        format("7", NL,
            "test/script_bang_panic_msg.til:14:10: panic: uncaught throw 'OutOfBounds'", NL))
    add_cli_pair(tests, "script_bang_panic_msg", "test/script_bang_panic_msg.til",
        "", 1, format(exp, "script_bang_panic_msg.out"), til_bin, asan_flag)

    // A bare TODO() keeps working and still points at the CALL SITE, not at
    // core/exit.til: `loc` defaults to __LOC__, which resolves at the caller.
    // With no message parts it prints plain "TODO" -- formatting an empty
    // parts list used to leave a dangling "TODO: ". This is the only place we
    // call TODO with no message; real markers should say what is missing.
    File.writefile(format(exp, "script_todo_loc.out"),
        format("before", NL,
            "test/script_todo_loc.til:10:1: panic: TODO", NL))
    add_cli_pair(tests, "script_todo_loc", "test/script_todo_loc.til",
        "", 1, format(exp, "script_todo_loc.out"), til_bin, asan_flag)

    // Top-level statements get the same throw/catch/bang lowering as a
    // function body: a subscript (`v[0]` -> `get(...)!`), an explicit bang
    // and a `?`/catch all work at the root of a `mode script` unit.
    File.writefile(format(exp, "script_toplevel_throws.out"),
        format("7", NL, "8", NL, "caught", NL, "42", NL, "8", NL))
    add_cli_pair(tests, "script_toplevel_throws", "test/script_toplevel_throws.til",
        "", 0, format(exp, "script_toplevel_throws.out"), til_bin, asan_flag)

    // Issue #312: a top-level numeric for-in loop in a `mode script` unit must
    // type-check (both interpreted and compiled) instead of panicking
    // OutOfBounds in infer_body_unit.
    File.writefile(format(exp, "bug312.out"),
        format("0", NL, "1", NL, "2", NL, "after", NL, "3", NL, "2", NL, "1", NL))
    add_cli_pair(tests, "bug312", "test/bug312.til",
        "", 0, format(exp, "bug312.out"), til_bin, asan_flag)

    File.writefile(format(exp, "cli_typed_alice42.out"), format("alice 42", NL))
    add_cli_pair(tests, "cli_typed_alice42", "examples/cli_typed.til",
        "alice 42", 0, format(exp, "cli_typed_alice42.out"), til_bin, asan_flag)

    File.writefile(format(exp, "hello_cli.out"), format("Hello World!", NL))
    add_cli_pair(tests, "hello_cli", "examples/hello_cli.til",
        "", 0, format(exp, "hello_cli.out"), til_bin, asan_flag)
    add_single(tests, "hello_cli_dd_default", "cli", 0, format(exp, "hello_cli.out"),
        format(til_bin, " -- examples/hello_cli.til"))
    add_single(tests, "hello_cli_dd_i", "cli", 0, format(exp, "hello_cli.out"),
        format(til_bin, " interpret -- examples/hello_cli.til"))
    add_single(tests, "hello_cli_dd_r", "cli", 0, format(exp, "hello_cli.out"),
        format(til_bin, " run", asan_flag, " -o bin/c/hello_cli_dd -c gen/c/hello_cli_dd.c -- examples/hello_cli.til"))

    File.writefile(format(exp, "variadic_add.out"), format("60", NL))
    add_cli_pair(tests, "variadic_add", "examples/cli_variadic_i64.til",
        "add 10 20 30", 0, format(exp, "variadic_add.out"), til_bin, asan_flag)

    File.writefile(format(exp, "variadic_mul.out"), format("24", NL))
    add_cli_pair(tests, "variadic_mul", "examples/cli_variadic_i64.til",
        "mul 2 3 4", 0, format(exp, "variadic_mul.out"), til_bin, asan_flag)

    File.writefile(format(exp, "variadic_add0.out"), format("0", NL))
    add_cli_pair(tests, "variadic_add0", "examples/cli_variadic_i64.til",
        "add", 0, format(exp, "variadic_add0.out"), til_bin, asan_flag)

    File.writefile(format(exp, "variadic_bool_f.out"), format("false", NL))
    add_cli_pair(tests, "variadic_bool_f", "examples/cli_variadic_bool.til",
        "true true false", 0, format(exp, "variadic_bool_f.out"), til_bin, asan_flag)

    File.writefile(format(exp, "variadic_bool_t.out"), format("true", NL))
    add_cli_pair(tests, "variadic_bool_t", "examples/cli_variadic_bool.til",
        "true true", 0, format(exp, "variadic_bool_t.out"), til_bin, asan_flag)

    // Every scalar CLI arg type (I8/U8/I16/U16/I32/U32/U64/USize/UPtr/F32),
    // both backends. Locks in the builder's cli_box_expr and the interpreter's
    // parse_cli_arg staying in lockstep.
    File.writefile(format(exp, "cli_scalars.out"),
        format("-8 200 -300 600 -70000 90000 12345678901 42 99 3.5 1e+150", NL))
    add_cli_pair(tests, "cli_scalars", "examples/cli_scalars.til",
        "-8 200 -300 600 -70000 90000 12345678901 42 99 3.5 1e150", 0,
        format(exp, "cli_scalars.out"), til_bin, asan_flag)
    // #333: the F64 primitive (64-bit float), full surface. Literals (1e100
    // proves real double width -- an F32 path prints inf), the numbers.til
    // method set (operators, cmp, clone via param-return, conversions,
    // 17-digit repr round-trip), Str.to_f64, an F64 CLI main arg, identical
    // in both backends.
    File.writefile(format(exp, "f64.out"),
        format("1.5", NL, "1e+100", NL, "0.125", NL, "2.75", NL, "3.25", NL,
               "6.5", NL, "true", NL, "1", NL, "2.5", NL, "1.5", NL, "1", NL,
               "7", NL, "true", NL))
    add_cli_pair(tests, "f64", "test/f64.til",
        "0.125 2.75", 0,
        format(exp, "f64.out"), til_bin, asan_flag)
    // ..F64 variadic main args: elem_size_for_type under interpret panicked
    // on F64 (hand-listed switch missed the new primitive; the loud panic
    // caught it) while compiled worked -- lock both backends.
    File.writefile(format(exp, "f64_variadic.out"),
        format("1.5", NL, "2.5e+10", NL))
    add_cli_pair(tests, "f64_variadic", "test/f64_variadic.til",
        "1.5 2.5e10", 0,
        format(exp, "f64_variadic.out"), til_bin, asan_flag)

    // Error cases (exit=1, no output check)
    add_cli_pair(tests, "cli_typed_err1", "examples/cli_typed.til", "alice", 1, "", til_bin, asan_flag)
    add_cli_pair(tests, "cli_typed_err2", "examples/cli_typed.til", "a b c", 1, "", til_bin, asan_flag)
    add_cli_pair(tests, "hello_cli_err", "examples/hello_cli.til", "extra", 1, "", til_bin, asan_flag)
    // Bad Bool value: both backends print the diagnostic and exit(1).
    add_cli_pair(tests, "cli_bool_err", "examples/cli_variadic_bool.til", "true maybe", 1, "", til_bin, asan_flag)

    // === Run all tests in parallel ===
    mut suite_end_ms := 0
    run_all_parallel(tests, j, fail, suite_end_ms)

    // --- Accumulate totals ---

    println("")
    mut total_interp_ms := 0
    mut total_compile_ms := 0
    mut total_run_ms := 0
    mut total_mem_inte := 0
    mut total_mem_comp := 0
    mut total_mem_run := 0
    mut both_passed : USize = 0
    mut both_total : USize = 0
    mut pi : USize = 0
    while pi < tests.len() {
        ref t : Test = tests[pi]
        switch t.kind {
        case .Both(md):
            both_total++
            if t.has_interp == 1 {
                total_interp_ms = total_interp_ms + md.interp_ms
                total_mem_inte = total_mem_inte + md.interp_mem
            }
            if t.has_run == 1 {
                total_compile_ms = total_compile_ms + md.compile_ms
                total_run_ms = total_run_ms + md.run_ms
                total_mem_comp = total_mem_comp + md.compile_mem
                total_mem_run = total_mem_run + md.run_mem
            }
            if t.ok == 1 { both_passed++ }
        case:
        }
        pi++
    }

    // --- Section totals from non-both tests ---

    mut ffi_ms := 0
    mut typer_ms := 0
    mut cli_ms := 0
    mut build_ms := 0
    mut build_mem := 0
    mut self_ms := 0
    mut self_mem := 0
    mut other_passed : USize = 0
    mut other_total : USize = 0
    pi = 0
    while pi < tests.len() {
        ref t : Test = tests[pi]
        if t.kind.is(TestKind.Both).not() {
            other_total++
            if t.ok == 1 { other_passed++ }
            if t.category == "ffi" { ffi_ms = ffi_ms + t.ms }
            if t.category == "typer" { typer_ms = typer_ms + t.ms }
            if t.category == "cli" { cli_ms = cli_ms + t.ms }
            if t.category == "self" {
                self_ms = self_ms + t.ms
                self_mem = self_mem + t.mem
            }
            if t.category == "build" {
                build_ms = build_ms + t.ms
                build_mem = build_mem + t.mem
            }
        }
        pi++
    }

    // --- Plot test (stays sequential) ---

    plot_start := clock_ms()
    test_csv := format("commit,interp_ms,compile_ms,run_ms,ffi_ms,typer_ms,cli_ms,wall_ms,passed,total,mem_inte,mem_comp,mem_run,mem_total,self_ms,self_mem", NL,
        "abc1234,1950,4000,1530,200,1710,1970,4640,32,32,500000,900000,300000,1700000,5200,600000", NL,
        "def5678,1890,3900,1510,190,1680,1950,4500,32,32,520000,880000,320000,1720000,5100,620000", NL)
    File.writefile("tmp/_test_plot.csv", test_csv)
    run(format(PLOT, " tmp/_test_plot.csv tmp/_test_plot.svg 0"))
    plot_svg := File.readfile("tmp/_test_plot.svg")
    mut plot_ok := 1
    if count_matches(plot_svg, "<svg") == 0 {
        println("FAIL: plot.til missing <svg tag")
        plot_ok = 0
        fail = 1
    }
    if count_matches(plot_svg, "<polyline") < 9 {
        println("FAIL: plot.til expected 9 polylines, got ", count_matches(plot_svg, "<polyline").to_str())
        plot_ok = 0
        fail = 1
    }
    if count_matches(plot_svg, "abc1234") == 0 {
        println("FAIL: plot.til missing commit label abc1234")
        plot_ok = 0
        fail = 1
    }
    if count_matches(plot_svg, "inte") == 0 {
        println("FAIL: plot.til missing legend label inte")
        plot_ok = 0
        fail = 1
    }
    if count_matches(plot_svg, "mem-total") != 0 {
        println("FAIL: plot.til should not draw mem-total legend")
        plot_ok = 0
        fail = 1
    }
    if count_matches(plot_svg, ">self<") == 0 {
        println("FAIL: plot.til missing legend label self")
        plot_ok = 0
        fail = 1
    }
    if count_matches(plot_svg, ">self-mem<") == 0 {
        println("FAIL: plot.til missing legend label self-mem")
        plot_ok = 0
        fail = 1
    }
    plot_ms := clock_ms() - plot_start

    // --- Summary ---

    total_passed := both_passed.add(other_passed) + plot_ok.to_usize()
    total_tests := both_total.add(other_total) + 1

    // Wall excludes the self-translate benchmark: suite_end_ms is when the last
    // non-"self" test finished, so self_ms stands on its own without inflating
    // wall (self runs in parallel and is usually the long pole).
    wall_ms := suite_end_ms - wall_start

    println("")
    println("=== Summary ===")
    if en_interp == 1 { println("interp:       ", ms_to_str(total_interp_ms)) }
    if en_run == 1 {
        println("compile:      ", ms_to_str(total_compile_ms))
        println("run:          ", ms_to_str(total_run_ms))
    }
    println("FFI tests:    ", ms_to_str(ffi_ms))
    println("Typer errors: ", ms_to_str(typer_ms))
    println("CLI tests:    ", ms_to_str(cli_ms))
    println("Plot test:    ", ms_to_str(plot_ms))
    println("Build tests:  ", ms_to_str(build_ms))
    println("Self-translate: ", ms_to_str(self_ms))
    println("Wall-clock:   ", ms_to_str(wall_ms))
    println("Passed:       ", total_passed.to_i64().to_str(), "/", total_tests.to_i64().to_str())
    println("")

    if fail == 0 {
        println("all tests passed")
    }

    // --- Benchmark CSV logging ---

    run("git rev-parse --short HEAD > tmp/_commit_hash")
    commit := File.readfile("tmp/_commit_hash").replace(NL, "")

    // gen/benchmark.csv -- both tests only (not tracked)
    run("mkdir -p gen")
    mut bench := Str.with_capacity(32768)
    bench.push_str("commit,file,interp_ms,compile_ms,run_ms,interp_ok,compile_ok,run_ok")
    bench.push_str(NL)
    mut bi : USize = 0
    while bi < tests.len() {
        ref bt : Test = tests[bi]
        switch bt.kind {
        case .Both(bmd):
            bench.push_str(format(commit, ",", bt.label, ",",
                bmd.interp_ms.to_str(), ",", bmd.compile_ms.to_str(), ",",
                bmd.run_ms.to_str(), ",",
                bmd.interp_ok.to_str(), ",", bmd.compile_ok.to_str(), ",",
                bmd.run_ok.to_str(), NL))
        case:
        }
        bi++
    }
    File.writefile("gen/benchmark.csv", bench)

    // doc/totals.csv -- all test totals (skip on failure)
    if fail == 0 {
        total_mem_total := total_mem_inte.add(total_mem_comp).add(total_mem_run) + build_mem
        totals_line := format(commit, ",",
            total_interp_ms.to_str(), ",",
            total_compile_ms.to_str(), ",", total_run_ms.to_str(), ",",
            ffi_ms.to_str(), ",", typer_ms.to_str(), ",",
            cli_ms.to_str(), ",", wall_ms.to_str(), ",",
            total_passed.to_i64().to_str(), ",", total_tests.to_i64().to_str(), ",",
            total_mem_inte.to_str(), ",",
            total_mem_comp.to_str(), ",",
            total_mem_run.to_str(), ",",
            total_mem_total.to_str(), ",",
            self_ms.to_str(), ",",
            self_mem.to_str())

        totals_path := "doc/totals.csv"
        // tests.til owns the header so the column set (incl self_ms / self_mem)
        // always matches the data and survives the merge's `git restore
        // doc/totals.csv`: the file is auto-generated and discarded, so the
        // header only persists if it is regenerated here.
        header := "commit,interp_ms,compile_ms,run_ms,ffi_ms,typer_ms,cli_ms,wall_ms,passed,total,mem_inte,mem_comp,mem_run,mem_total,self_ms,self_mem"
        existing := File.readfile(totals_path)
        mut totals_content := format(header, NL)
        lines := existing.split(NL)
        // Keep existing data rows (skip the old header at line 0 and blanks),
        // dropping any row for the current commit so a re-run replaces it.
        mut li : USize = 1
        while li < lines.len() {
            ref ln : Str = lines[li]
            if ln.len() > 0 {
                row_commit := ln.substr(0, ln.find(",").to_usize())
                if row_commit != commit {
                    totals_content = format(totals_content, ln, NL)
                }
            }
            li++
        }
        totals_content = format(totals_content, totals_line, NL)
        File.writefile(totals_path, totals_content)

        run(format(PLOT, " doc/totals.csv img/totals.svg 10 --no-x-labels"))
        println("Updated doc/totals.csv and img/totals.svg")
    }

    exit(fail)
}
