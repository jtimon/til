    // Issue #326: the generated C must be honest about liveness. The fixture
    // (test/dead_temps.til, run interpreted + compiled by the `both` entry
    // below) pins the BEHAVIOUR; these three pin the OUTPUT. A compiler temp
    // that goes dead has to be removed, not silenced with `(void)name;`; no
    // generated helper may exist only because __attribute__((unused)) lets it
    // compile; and the one cast that remains is on `_b`, the deliberately-
    // unused param spelling issue #86 defines. Each translates to its own
    // -c path so the three (and the `both` compile) never race on one file.
    //
    // Category "build", NOT "self": self_ms/self_mem are the self-translate
    // BENCHMARK, and they are plain SUMS over the category (self_mem adds
    // each test's whole peak RSS). Any extra test filed under "self" lands
    // in doc/totals.csv and img/totals.svg as a benchmark regression that
    // did not happen -- these three cost ~3 x 2s and ~3 x 1.1GB of peak RSS,
    // which is what made self_mem jump 11.8GB -> 15.1GB when they were first
    // registered here. Measured on identical input, the compiler's own
    // self-translate was 29.07s/262.8MB before #326 and 29.40s/261.7MB after.
    add_count(tests, "dead_temps_no_temp_casts", "build", "(void)hoisted__", 0,
        format(til_bin, " translate -c gen/c/dead_temps_casts.c test/dead_temps.til '&&' cat gen/c/dead_temps_casts.c"))
    add_count(tests, "dead_temps_no_unused_attrs", "build", "__attribute__((unused))", 0,
        format(til_bin, " translate -c gen/c/dead_temps_attrs.c test/dead_temps.til '&&' cat gen/c/dead_temps_attrs.c"))
    add_count(tests, "dead_temps_underscore_cast", "build", "(void)_b;", 1,
        format(til_bin, " translate -c gen/c/dead_temps_uscore.c test/dead_temps.til '&&' cat gen/c/dead_temps_uscore.c"))
    // ...and it is the ONLY cast in the file. The `_` prefix says a cast is
    // ALLOWED where a binding is deliberately unread, not that one is
    // always needed: every other `_`-prefixed temp this fixture generates
    // is read, most of them on the very next line.
    add_count(tests, "dead_temps_one_cast_total", "build", "(void)_", 1,
        format(til_bin, " translate -c gen/c/dead_temps_one.c test/dead_temps.til '&&' cat gen/c/dead_temps_one.c"))

    // #346: ownership and C representation are separate. The ordinary
    // aggregate function, its closure wrapper and its FuncSig cast all return
    // ReturnBox346 by value; only the bodyless dyn_type_to_str boundary uses
    // the one pointer-to-value adapter.
    add_count(tests, "aggregate_return_value_abi", "build",
        "static ReturnBox346 make_return_box346(Str * value)", 2,
        format(til_bin, " translate -c gen/c/aggregate_return_value.c test/fn_ptr.til '&&' cat gen/c/aggregate_return_value.c"))
    add_count(tests, "aggregate_return_no_pointer_abi", "build",
        "static ReturnBox346 *make_return_box346", 0,
        format(til_bin, " translate -c gen/c/aggregate_return_pointer.c test/fn_ptr.til '&&' cat gen/c/aggregate_return_pointer.c"))
    add_count(tests, "funcsig_aggregate_return_value_abi", "build",
        "((ReturnBox346 (*)(void *, Str *))", 1,
        format(til_bin, " translate -c gen/c/aggregate_return_funcsig.c test/fn_ptr.til '&&' cat gen/c/aggregate_return_funcsig.c"))
    add_count(tests, "closure_aggregate_return_value_abi", "build",
        "static ClosureBox346 closure_test_capturing_closure_owned_aggregate_return_0(void *til_env_raw)", 1,
        format(til_bin, " translate -c gen/c/aggregate_return_closure.c test/closures.til '&&' cat gen/c/aggregate_return_closure.c"))
    add_count(tests, "ext_owned_return_boundary_adapter", "build",
        "Str *_hp = (Str *)dyn_type_to_str", 1,
        format(til_bin, " translate -c gen/c/aggregate_return_ext.c test/fn_ptr.til '&&' cat gen/c/aggregate_return_ext.c"))
    add_count(tests, "aggregate_local_stack_storage", "build",
        "StackValue346 value = {0};", 1,
        format(til_bin, " translate -c gen/c/aggregate_local_stack.c test/structs.til '&&' cat gen/c/aggregate_local_stack.c"))
    add_count(tests, "aggregate_own_param_pointer_return", "build",
        "static StackValue346 priv__test_structs_til__move_stack_value346(StackValue346 * value)", 2,
        format(til_bin, " translate -c gen/c/aggregate_own_return.c test/structs.til '&&' cat gen/c/aggregate_own_return.c"))
    add_count(tests, "aggregate_own_escape_boxes", "build",
        "StackValue346 *_oa = malloc(TIL_BOX(StackValue346))", 1,
        format(til_bin, " translate -c gen/c/aggregate_own_escape.c test/structs.til '&&' cat gen/c/aggregate_own_escape.c"))
    add_count(tests, "funcsig_own_param_pointer_abi", "build",
        "static USize consume_owned_box346(ReturnBox346 * box)", 2,
        format(til_bin, " translate -c gen/c/aggregate_param_funcsig.c test/fn_ptr.til '&&' cat gen/c/aggregate_param_funcsig.c"))
    add_count(tests, "funcsig_own_primitive_param_value_abi", "build",
        "static I64 consume_owned_i64(I64 value)", 2,
        format(til_bin, " translate -c gen/c/primitive_param_funcsig.c test/fn_ptr.til '&&' cat gen/c/primitive_param_funcsig.c"))
    add_count(tests, "closure_own_param_pointer_abi", "build",
        "static USize closure_make_closure_owned_box_consumer346_0(void *til_env_raw, ClosureBox346 * box)", 1,
        format(til_bin, " translate -c gen/c/aggregate_param_closure.c test/closures.til '&&' cat gen/c/aggregate_param_closure.c"))
    add_count(tests, "self_method_own_param_pointer_abi", "build",
        "static void Expr_add_child(Expr * self, Expr * child)", 2,
        "cat boot/til.c")
    add_count(tests, "self_template_own_param_pointer_abi", "build",
        "static void Vec__Expr_push(Vec__Expr * self, Expr * val)", 2,
        "cat boot/til.c")
    add_count(tests, "self_scalar_own_param_value_abi", "build",
        "static void Vec__USize_push(Vec__USize * self, USize val)", 2,
        "cat boot/til.c")
    add_count(tests, "self_scalar_own_param_no_boxes", "build",
        "U32 *_oa = malloc(TIL_BOX(U32))", 0,
        "cat boot/til.c")
    add_count(tests, "delete_own_param_pointer_abi", "build",
        "static void Str_delete(Str * self, Bool call_free)", 2,
        "cat boot/til.c")
    add_count(tests, "scalar_delete_own_param_pointer_abi", "build",
        "static void I64_delete(I64 * self, Bool call_free)", 2,
        "cat boot/til.c")
    add_count(tests, "variadic_param_pointer_abi", "build",
        "static Str format(Array__Str * parts)", 2,
        "cat boot/til.c")
    add_count(tests, "variadic_param_stack_cleanup", "build",
        "Array__Str_delete(parts, (Bool){0});\n    { Str _ret = out;", 1,
        "cat boot/til.c")
    add_count(tests, "variadic_param_no_outer_boxes", "build",
        "Array__Str *_oa = malloc(TIL_BOX(Array__Str))", 0,
        "cat boot/til.c")
    add_count(tests, "enum_ctor_pointer_abi", "build",
        "NodeType_FCall(FCallData *", 2,
        "cat boot/til.c")
    add_count(tests, "enum_ctor_stack_payload", "build",
        "NodeType_FCall(({ FCallData *_oa = malloc(TIL_BOX(FCallData))", 0,
        "cat boot/til.c")
    add_count(tests, "enum_ctor_no_compound_constructor_payload", "build",
        "NodeType_Ident(&((IdentData[]){ ({ IdentData _sv", 0,
        "cat boot/til.c")
    add_count(tests, "enum_ctor_named_constructor_payload", "build",
        "NodeType_Ident(&hoisted__IdentData_", 2,
        "cat boot/til.c")
    add_count(tests, "enum_ctor_borrows_outer", "build",
        "r.data.FCall = *val;\n    return r;", 1,
        "cat boot/til.c")
    add_count(tests, "niche_enum_ctor_keeps_heap_payload", "build",
        "Option__Expr_Some(({ Expr *_oa = malloc(TIL_BOX(Expr))", 75,
        "cat boot/til.c")
    add_count(tests, "stack_delete_no_outer_box", "build",
        "Expr_delete(({ Expr *_oa = malloc(TIL_BOX(Expr))", 0,
        "cat boot/til.c")
    add_count(tests, "stack_delete_borrows_outer", "build",
        "Expr_delete(&def, (Bool){0})", 2,
        "cat boot/til.c")
    add_count(tests, "global_delete_borrows_outer", "build",
        "Map__Str_TokenType_delete(&priv___src_self_lexer_til__KEYWORDS, (Bool){0})", 1,
        "cat boot/til.c")
    add_count(tests, "expr_new_value_return_abi", "build",
        "static Expr Expr_new(NodeType * data, U32 line, U32 col)", 2,
        "cat boot/til.c")
    add_count(tests, "expr_new_no_pointer_return_abi", "build",
        "static Expr *Expr_new(NodeType * data, U32 line, U32 col)", 0,
