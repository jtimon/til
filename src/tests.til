    // Issue #326: a program that names no compiler AST type and no
    // reflection must not carry the compiler's data model into its output.
    // NodeType is the hub -- StructDef's fields reach Declaration, whose
    // field default reaches Expr, whose node_type reaches NodeType -- so one
    // needle guards the whole cluster. See test/minimal_reach.til; the
    // `both` entry below proves what survives still links and runs.
    add_count(tests, "minimal_reach_no_ast_model", "build", "NodeType", 0,
        format(til_bin, " translate -c gen/c/minimal_reach.c test/minimal_reach.til '&&' cat gen/c/minimal_reach.c"))
    // A reached type no longer roots all five of delete/clone/size/cmp/hash:
    // only the ones a real call site asks for survive. `hash` is the clearest
    // witness -- nothing in this fixture hashes anything, so every `_hash`
    // the old blanket rule emitted (ten of them, one per scalar) is gone.
    add_count(tests, "minimal_reach_no_dead_lifecycle", "build", "_hash", 0,
        format(til_bin, " translate -c gen/c/minimal_reach_lc.c test/minimal_reach.til '&&' cat gen/c/minimal_reach_lc.c"))
    // A user-unit top-level value used to be a blanket root: unread or not,
    // its global, its initializer and everything the initializer referenced
    // were emitted. Effect-free initializers (literal/ident) are ordinary
    // graph nodes now -- the fixture's UNREAD_GLOBAL must vanish while the
    // read KEPT_GLOBAL survives (the `both` entry proves the latter by
    // printing it). std/raylib.til is where this bites for real programs:
    // snake carried every unused SHADER_/TEXTURE_/KEY_ flag constant.
    // `cast` is declared `ext_func(e: Dynamic, T: Type)` but no such symbol
    // exists: the builder reads the target type name off the call and emits
    // a bare C cast. Its `T: Type` slot is a comptime type argument, the
    // same shape the macro-signature rule excludes, so walking the
    // signature rooted the `Type` enum and, through its payload,
    // `Primitive`. `I64.to_str` casts, which meant every program that
    // prints a number carried both struct definitions and both tag enums
    // with nothing referencing them. `Primitive_TAG` is the witness -- it
    // appears once per variant, so a partial regression still trips it.
    // dyn dispatch on a LITERAL type name roots the exact `Type.method`
    // pair, not the `*.method` wildcard. Only the METHOD argument was exempt
    // from arg hoisting, so a literal TYPE name became a pooled-Str temp and
    // both the scavenger and the builder inventory saw an Ident instead of a
    // literal -- falling back to the wildcard, which keeps `to_str` on EVERY
    // type, the compiler's own Expr/NodeType model included. The dyn-heavy
    // fixtures cannot catch this: they reach dispatch through std/dyn_array,
    // whose `dyn_fn(elem_type, "clone")` takes a RUNTIME type and needs the
    // wildcard by construction. 3,130 -> 497 lines of C for this fixture.
    add_count(tests, "dyn_literal_no_ast_model", "build", "NodeType", 0,
        format(til_bin, " translate -c gen/c/dyn_literal.c test/dyn_literal.til '&&' cat gen/c/dyn_literal.c"))
    add_count(tests, "minimal_reach_no_comptime_type", "build", "Primitive_TAG", 0,
        format(til_bin, " translate -c gen/c/minimal_reach_ct.c test/minimal_reach.til '&&' cat gen/c/minimal_reach_ct.c"))
    add_count(tests, "minimal_reach_no_unread_global", "build", "UNREAD_GLOBAL", 0,
        format(til_bin, " translate -c gen/c/minimal_reach_ug.c test/minimal_reach.til '&&' cat gen/c/minimal_reach_ug.c"))
    // No generated helper exists only because __attribute__((unused)) lets
    // it compile: every emitted static has a real C reference. first_class
    // is the fixture with the most closure machinery -- lifted lambdas,
    // capture blocks, Body fields and their defaults.
    // Issue #326: a CLI main roots only the argv converters ITS signature
    // needs. cli_args takes `..Str`, which parses inline to a Str_clone, so
    // none of the Str.to_* family may appear -- the whole family used to be
    // seeded for every CLI or GUI program.
    add_count(tests, "cli_args_exact_argv_roots", "build", "Str_to_", 0,
        format(til_bin, " translate -c gen/c/cli_args_roots.c examples/cli_args.til '&&' cat gen/c/cli_args_roots.c"))
    // An accessor the builder splices at every call site gets no
    // out-of-line definition and no prototype. cli_args' `for a : Str in
    // args` loop calls Array.len and Array.unsafe_get on every iteration,
    // and both are inlined, so neither name may appear at all.
    add_count(tests, "cli_args_no_inlined_accessors", "build", "Array__Str_unsafe_get", 0,
        format(til_bin, " translate -c gen/c/cli_args_acc.c examples/cli_args.til '&&' cat gen/c/cli_args_acc.c"))
    // Issue #326: a library is scavenged like every other mode, with its
    // EXPORTED declarations as roots. test/pure.til is 43 lines and used to
    // emit 21,264 -- the whole of core and std, the compiler's own
    // Expr/NodeType model included -- because library mode skipped
    // scavenging outright.
    add_count(tests, "pure_lib_no_ast_model", "build", "NodeType", 0,
        format(til_bin, " translate -c gen/c/pure_reach.c test/pure.til '&&' cat gen/c/pure_reach.c"))
    // Issue #326: a variant's C constructor is emitted only where some
    // expression actually CONSTRUCTS it. Surviving the ns member sweep is not
    // enough -- an enum with any live value gets a generated
    // delete/eq/to_str/clone that names every variant in an `is_n` tag check,
    // which lowers to a compound-literal compare, not a call. The old blanket
    // rule declared a ctor for each of those, so pure.til carried prototypes
    // whose definitions the scavenger had already dropped: declared, never
    // defined, never called. `Type.Unknown` is the witness -- test/pure.til
    // reaches core's `Type` enum but never builds that variant.
    add_count(tests, "pure_no_unbuilt_variant_ctor", "build", "Type_Unknown", 0,
        format(til_bin, " translate -c gen/c/pure_variant.c test/pure.til '&&' cat gen/c/pure_variant.c"))
    // The auto-generated `size` method is emitted from the namespace index,
    // which says the member exists -- not that any C calls it. At a matching
    // build width the constfolder folds every `T.size()` to a literal, so
    // each one was a never-called `return sizeof(T);`: 55 of them in this
    // fixture. It is dead only in the C -- the INTERPRETER resolves
    // `T.size()` by runtime name off the AST, which is why `*.size` stays a
    // scavenger root for anything interpretable. `Color` is the witness: a
    // user enum whose size nothing asks for. The `both` entry runs the same
    // fixture interpreted, where that AST declaration still answers.
    // A bare `Enum.Variant` expression never lowers to a call -- the
    // builder splices the value in place as `(E){.tag = E_TAG_V}`,
    // `&(E){...}` or an inline malloc-and-tag in return position -- so
    // recording every field access as a construction site kept a
    // constructor no C calls. test/match.til is the fixture that is
    // nothing BUT bare variant expressions (match scrutinees and case
    // labels), and `Color_Red` must not appear at all; the tags it really
    // compiles to, `Color_TAG_Red`, are what the `both` entry exercises.
    // The generated dispatch that could call an otherwise-omitted method is
    // asked per METHOD, not per family. test/dyn_vecs.til is the fixture
    // that proves it: it dispatches through std/dyn_array, whose
    // `dyn_fn(elem_type, "clone")` registers `*.clone` and says nothing
    // about `unsafe_get` -- which is spliced at every call site, so no
    // out-of-line copy may survive. `U8_size` in the same output covers the
    // other half: core writes `size` by hand for the primitives, the
    // constfolder folds every call to a literal, and the definition is
    // reachable only through the interpreter's `*.size` root.
    add_count(tests, "dyn_vecs_no_uncalled_helpers", "build", "Array__Str_unsafe_get", 0,
        format(til_bin, " translate -c gen/c/dyn_vecs_h.c test/dyn_vecs.til '&&' cat gen/c/dyn_vecs_h.c"))
    add_count(tests, "dyn_vecs_no_uncalled_size", "build", "U8_size", 0,
        format(til_bin, " translate -c gen/c/dyn_vecs_sz.c test/dyn_vecs.til '&&' cat gen/c/dyn_vecs_sz.c"))
    add_count(tests, "match_no_uncalled_variant_ctor", "build", "Color_Red", 0,
        format(til_bin, " translate -c gen/c/match_ctor.c test/match.til '&&' cat gen/c/match_ctor.c"))
    // A core_func/ext_func namespace method has no emitted body -- an
    // enum's auto-generated `is` is lowered to a typed tag compare, an
    // ext_func's symbol lives in ext.c. Four of the six ns
    // forward-declaration loops skipped those; two did not, and
    // emit_func_forward_decl's own guard is gated on `top_level`, false for
    // a member. So each one got a prototype nothing defines and nothing
    // calls -- 61 in til's own output. `Color_is` is the witness.
    // An enum's clone/delete/eq are emitted only where a real call survives.
    // Stack-local payload-less enum deletes remain no-ops and are omitted;
    // clone calls use the same value-return ABI as every other til function.
    // A tag enum is anonymous: only the E_TAG_* enumerators are ever
    // referenced (the tag field is typed by its explicit width), so the
    // old `typedef enum {...} E_tag;` left one never-used typedef name per
    // enum -- zero uses across the whole corpus.
    add_count(tests, "enums_no_dead_tag_typedef", "build", "_tag;", 0,
        format(til_bin, " translate -c gen/c/enums_tt.c test/enums.til '&&' cat gen/c/enums_tt.c"))
    add_count(tests, "aliases_pod_clone_value_abi", "build", "static Point Point_clone(Point * self)", 2,
        format(til_bin, " translate -c gen/c/aliases_pc.c test/aliases.til '&&' cat gen/c/aliases_pc.c"))
    add_count(tests, "structs_pod_clone_value_abi", "build", "static CmpPoint CmpPoint_clone(CmpPoint * self)", 2,
        format(til_bin, " translate -c gen/c/structs_pc.c test/structs.til '&&' cat gen/c/structs_pc.c"))
    // A swap_replace on a Str target never calls swap_bytes -- the builder
    // writes the delete-copy-free sequence instead -- so the callee is not
    // a reachability root there and the definition goes with it. Safe to
    // sweep only because scavenge_imported erases swept names from the
    // scope registries; the first attempt left check_fcall_mut_args
    // resolving the swept name into a freed Expr (ASAN-caught here).
    add_count(tests, "strings_no_uncalled_swap_bytes", "build", "swap_bytes", 0,
        format(til_bin, " translate -c gen/c/strings_sw.c test/strings.til '&&' cat gen/c/strings_sw.c"))
    add_count(tests, "enums_no_uncalled_lifecycle", "build", "TagU8_delete", 0,
        format(til_bin, " translate -c gen/c/enums_lc.c test/enums.til '&&' cat gen/c/enums_lc.c"))
    add_count(tests, "enums_payload_clone_value_abi", "build", "static ColorG ColorG_clone(ColorG * self)", 2,
        format(til_bin, " translate -c gen/c/enums_pc.c test/enums.til '&&' cat gen/c/enums_pc.c"))
    // #302 stage 4 / #326: a drain-only delete must still be emitted --
    // both the scavenger's reachability walk and the builder's lifecycle
    // gate have to see the conjured `T_delete(_old, ...)` site. Fails to
    // COMPILE without either root ("implicit declaration").
    add_single(tests, "drain_only_delete", "build", 0, "",
        format(til_bin, " run test/drain_only_delete.til"))
    // #269/#326: the "*.method" wildcard reaches the types the walk reached,
    // not every type declared. One `..Dynamic` call lowers to a Tuple, whose
    // delete dispatches by runtime name, and the wildcard that answers it used
    // to root delete+clone everywhere -- core/tuple.til imports ast, so the
    // compiler's own Expr/StructDef/NodeType model was emitted into a 40-line
    // script. The run row is the other half: a type the dispatch CAN land on
    // must still be there (WcKept keeps its dyn_call_delete arm).
    add_counts(tests, "scavenge_dyn_wildcard_prunes", "build",
        format(til_bin, " translate -c gen/c/sc_dw.c test/scavenge_dyn_wildcard.til '&&' cat gen/c/sc_dw.c"),
        CountCheck(needle = "WcUnused", expected_count = 0),
        CountCheck(needle = "Expr_delete", expected_count = 0),
        CountCheck(needle = "static void WcKept_delete(", expected_count = 2))
    add_single(tests, "scavenge_dyn_wildcard", "build", 0, "",
        format(til_bin, " run test/scavenge_dyn_wildcard.til"))
    add_count(tests, "enums_no_orphan_prototype", "build", "Color_is", 0,
        format(til_bin, " translate -c gen/c/enums_proto.c test/enums.til '&&' cat gen/c/enums_proto.c"))
    // Clone calls now share the ordinary value-return ABI rather than a
    // POD-specific splice path.
    add_count(tests, "bug256_move_clone_value_abi", "build", "static Node Node_clone(Node * self)", 2,
        format(til_bin, " translate -c gen/c/bug256_mc.c test/bug256.til '&&' cat gen/c/bug256_mc.c"))
    // The prelude used to define print_single/print_flush in every
    // program. They are core ext_procs reached only through println/print,
    // so a program that never prints must not get them -- nor their
    // prototypes.
    add_count(tests, "no_print_prelude_when_unused", "build", "print_single", 0,
        format(til_bin, " translate -c gen/c/cce_pp.c test/capture_compile_error.til '&&' cat gen/c/cce_pp.c"))
    // Every prototype used to be emitted twice: the monolithic header and
    // emit_all_forward_declarations were two drifted copies of the same
    // four walks. One prototype, one definition, one mention at the call.
    add_count(tests, "hello_no_duplicate_prototypes", "build", "void println(Array__Str * parts)", 2,
        format(til_bin, " translate -c gen/c/hs_dp.c examples/hello_script.til '&&' cat gen/c/hs_dp.c"))
    // The __builtin_unreachable terminator answers a GCC mis-fire that
    // needs a CFG it cannot follow. A body whose LAST statement is a plain
    // `return` has none: the marker there is a dead statement after an
    // unconditional return, and every function in this fixture ends that
    // way.
    add_count(tests, "hello_no_unreachable_after_return", "build", "__builtin_unreachable", 0,
        format(til_bin, " translate -c gen/c/hs_ur.c examples/hello_script.til '&&' cat gen/c/hs_ur.c"))
    // ...and the bodies that DO need it keep it: test/option.til's
    // Option arms return from every branch of an exhaustive switch, which
    // is exactly the CFG GCC stops following under -finstrument-functions.
    add_count(tests, "option_keeps_needed_unreachable", "build", "__builtin_unreachable", 15,
        format(til_bin, " translate -c gen/c/opt_ur.c test/option.til '&&' cat gen/c/opt_ur.c"))
    // dladdr sees exported symbols only. The profiler's Linux ELF fallback
    // must recover translation-unit-local generated functions such as
    // adopt__Str; TIL_PROF_TOP=0 puts every called function in both tables.
    // Linux is not incidental here: the walk this asserts on is the
    // `#ifdef __linux__` half of til_prof_bind_symbols, and elsewhere the
    // slots keep the names dladdr gave them, so adopt__Str never appears.
    if host_os() == "linux" {
        add_count(tests, "prof_resolves_static_symbols", "build", "adopt__Str", 2,
            format(til_bin, " build --prof -o tmp/prof_static examples/hello_script.til '&&' TIL_PROF_TOP=0 tmp/prof_static"))
    }
    // A delete's call_free Bool literal is read by value in both back
    // ends, and the C emitter overrides it for a stack local -- so
    // hoisting it manufactured a dead `Bool hoisted__Bool_N` binding at
    // every overridden site, cast away with the `(void)hoisted__` this
    // issue's invariant forbids (structs.til had the corpus's last 5).
    add_count(tests, "structs_no_void_hoisted_cast", "build", "(void)hoisted__", 0,
        format(til_bin, " translate -c gen/c/structs_vh.c test/structs.til '&&' cat gen/c/structs_vh.c"))
    // The reflection stubs opened with a blanket `(void)` on every
    // parameter -- casting names their own dispatch arms and error exits
    // READ, which is the Str_size mis-cast from the post-mortem all over
    // again. The exits already read type_name; the index-taking ones now
    // report the offending index too, so every parameter is genuinely
    // read and no cast survives. first_class.til retains the struct_field_*
    // and enum_variant_* stubs; its func_sig_* Vec results fold statically.
    add_count(tests, "first_class_no_stub_param_casts", "build", "(void)type_name", 0,
        format(til_bin, " translate -c gen/c/fc_vc.c test/first_class.til '&&' cat gen/c/fc_vc.c"))
    add_count(tests, "first_class_index_in_range_error", "build", "index %lld out of range", 9,
        format(til_bin, " translate -c gen/c/fc_ir.c test/first_class.til '&&' cat gen/c/fc_ir.c"))
    // An interface's ABSTRACT method has no definition anywhere --
    // implementers copy the defaults and supply their own bodies, and
    // dispatch goes to the copies -- so its prototype was a
    // declared-never-defined name, the corpus's last one that is not a
    // genuine external (ext.c / vendor).
    add_count(tests, "interfaces_no_abstract_prototype", "build", "Drawable_draw", 0,
        format(til_bin, " translate -c gen/c/if_ap.c test/interfaces.til '&&' cat gen/c/if_ap.c"))
    // A generic template's body is not a reachability blob: methods root
    // per qualified name, so Array.to_vec's Vec reference must not keep
    // Vec -- nor Vec's adopt_from -- in a program that never builds one.
    add_count(tests, "hello_no_template_blanket_root", "build", "adopt_from", 0,
        format(til_bin, " translate -c gen/c/hs_tb.c examples/hello_script.til '&&' cat gen/c/hs_tb.c"))
    // The literal pool is registered by the same rules the emitters spend
    // it by: dyn_type_to_str's 18 metadata strings pool only when that
    // declaration survives the scavenge, and a dyn_call/dyn_has_method
    // METHOD literal -- spliced into the C symbol name at every site --
    // never pools at all. interfaces.til exercises both (its pool held 20
    // entries nothing indexed).
    add_count(tests, "interfaces_pool_no_dead_metadata", "build", "(void *)\"StructDef\"", 0,
        format(til_bin, " translate -c gen/c/if_pm.c test/interfaces.til '&&' cat gen/c/if_pm.c"))
    // A typedef no emitted C mentions is not emitted: Dynamic's every
    // value position lowers to void*, so a program with no reflection
    // never spells the typedef out -- and one WITH reflection needs it
    // for the sizeof arms, both directions pinned here. The vendor
    // binding structs follow the same rule (a gui program that uses no
    // Vector4-taking function carries no Vector4 typedef).
    add_count(tests, "hello_no_dead_dynamic_typedef", "build", "} Dynamic;", 0,
        format(til_bin, " translate -c gen/c/hs_dy.c examples/hello_script.til '&&' cat gen/c/hs_dy.c"))
    add_count(tests, "dynamic_keeps_dynamic_typedef", "build", "} Dynamic;", 1,
        format(til_bin, " translate -c gen/c/dyn_dy.c test/dynamic.til '&&' cat gen/c/dyn_dy.c"))
    add_count(tests, "gui_no_dead_vendor_typedef", "build", "} Vector4;", 0,
        format(til_bin, " translate -c gen/c/hg_v4.c examples/hello_gui.til '&&' cat gen/c/hg_v4.c"))
    // A NICHE enum has no tag field -- the emitted code tests the pointer
    // against NULL -- so its E_TAG_* enumerators are constants nothing can
    // name; the block is not emitted (121 of them across the corpus).
    add_count(tests, "option_no_niche_tag_enumerators", "build", "Option__ref_OptSrc_TAG_None", 0,
        format(til_bin, " translate -c gen/c/opt_nt.c test/option.til '&&' cat gen/c/opt_nt.c"))
    // A CORE top-level function whose every call site sits inside a
    // definition the emit gates drop is not called by the emitted C.
    // UNREACHABLE is the witness: the initer plants a call in every
    // `guard_every` auto-clone body, so wherever those bodies are
    // omitted the definition is left with no caller (8 fixtures).
    // A program is a CLOSED WORLD, so its til functions carry `static`.
    // That is what puts the C compiler's -Wunused-function on permanent
    // duty over this issue's invariant: a future dead emission fails the
    // build instead of waiting to be surveyed. Exported core functions
    // remain non-static.
    // The bounds-checked `v[i]` is spliced at every call site, so the
    // out-of-line Vec.get has no caller -- the omission gate asks the
    // same predicate the emitter splices on, or the two disagree about
    // what exists and the definition is emitted with nothing calling it
    // (21 of them in til's own output the day the splice landed).
    add_count(tests, "vecs_no_uncalled_checked_get", "build", "Vec__I64_get(", 0,
        format(til_bin, " translate -c gen/c/vv_cg.c test/vecs.til '&&' cat gen/c/vv_cg.c"))
    add_count(tests, "hello_funcs_are_tu_local", "build", "static void println(Array__Str * parts)", 2,
        format(til_bin, " translate -c gen/c/hs_st.c examples/hello_script.til '&&' cat gen/c/hs_st.c"))
    // The GENERATED families join the audit too: a dyn wrapper exists
    // only to fill the closure value beside it, and the print prelude is
    // the program's own. Both bypassed emit_func_def, so both stayed
    // extern and unaudited -- ~1,870 definitions across the corpus.
    // The reflection stubs and variant constructors join too, and the
    // audit immediately found what the coarse name test had been hiding:
    // `builder_is_reflect_builtin_name` PREFIX-matched, so til's own
    // enum_variant_tag / _index / _type helpers made every self-translate
    // claim it needed reflection, emitting all seven enum_variant_* stubs
    // with no caller. The test names the builtins exactly now.
    // A program's GLOBALS are static too, which puts -Wunused-variable on
    // duty beside -Wunused-function. CAP_LIT/CAP_VIEW stay extern: the
    // hand-written ext.c stamps them, the same boundary as Str_clone.
    // TIL_CSTR's #define was unconditional -- a dead line in 121 of the
    // corpus's 140 generated files. It is emitted when some surviving
    // call actually passes a Str where an ext C function wants a char*,
    // asked with the same two predicates the emitter chooses on.
    // The closure runtime struct went into every program: TilClosure is
    // the C type of every FuncPtr / Body value, but 124 of the corpus's
    // 152 generated files have none. Its four sources are asked instead --
    // a value's type, a capture, the dyn dispatch inventory that emits
    // `static TilClosure` values, and dyn_size_of's Fn/Body sizeof arms.
    add_count(tests, "hello_no_closure_runtime", "build", "struct TilClosure {", 0,
        format(til_bin, " translate -c gen/c/hs_cr.c examples/hello_script.til '&&' cat gen/c/hs_cr.c"))
    add_count(tests, "closures_keep_closure_runtime", "build", "struct TilClosure {", 1,
        format(til_bin, " translate -c gen/c/cl_cr.c test/closures.til '&&' cat gen/c/cl_cr.c"))
    add_count(tests, "hello_no_unused_cstr_macro", "build", "#define TIL_CSTR", 0,
        format(til_bin, " translate -c gen/c/hs_cs.c examples/hello_script.til '&&' cat gen/c/hs_cs.c"))
    add_count(tests, "cstr_view_keeps_cstr_macro", "build", "#define TIL_CSTR", 1,
        format(til_bin, " translate -c gen/c/cv_cs.c test/cstr_view.til '&&' cat gen/c/cv_cs.c"))
    add_count(tests, "hello_globals_are_tu_local", "build", "static U32 CAP_LIT;", 0,
        format(til_bin, " translate -c gen/c/hs_gs.c examples/hello_script.til '&&' cat gen/c/hs_gs.c"))
    // Counted against gen/til/til.c, which `make` ALREADY produced to
    // build bin/til -- the first version re-translated src/til.til here,
    // adding a second copy of the suite's single slowest job in a
    // wall-visible category (the exact mistake self_translate's comment
    // warns about; the merge box's wall_ms jumped ~23s and stayed there).
    add_count(tests, "til_no_unneeded_reflect_family", "build", "static I64 enum_variant_count(", 0,
        "cat gen/til/til.c")
    // ...and a program that really does reflect still gets them.
    add_count(tests, "first_class_keeps_reflect_family", "build", "static I64 enum_variant_count(", 2,
        format(til_bin, " translate -c gen/c/fc_rf.c test/first_class.til '&&' cat gen/c/fc_rf.c"))
    // The wrapper is anchored on a type the file DECLARES and really does
    // dispatch by name (its DynVec(WordBox) does `dyn_fn("WordBox", "clone")`).
    // It used to name std/mode_type's Mode, which the file never mentions: the
    // "*.clone" wildcard rooted clone on every top-level type, so any name at
    // all had a wrapper. Now that the wildcard only reaches types the program
    // reaches, a wrapper exists exactly where a dispatch can land.
    add_count(tests, "closures_dyn_wrapper_is_tu_local", "build", "static void *WordBox_clone_dyn(", 1,
        format(til_bin, " translate -c gen/c/ci_dw.c test/closures_interp.til '&&' cat gen/c/ci_dw.c"))
    add_count(tests, "hello_print_prelude_is_tu_local", "build", "static void print_single(Str *s)", 2,
        format(til_bin, " translate -c gen/c/hs_pp.c examples/hello_script.til '&&' cat gen/c/hs_pp.c"))
    add_count(tests, "hello_ext_c_boundary_stays_extern", "build", "\nStr Str_clone(Str * val) {", 1,
        format(til_bin, " translate -c gen/c/hs_sx.c examples/hello_script.til '&&' cat gen/c/hs_sx.c"))
    add_count(tests, "aliases_clone_keeps_unreachable", "build", "void UNREACHABLE(", 2,
        format(til_bin, " translate -c gen/c/al_ur.c test/aliases.til '&&' cat gen/c/al_ur.c"))
    // ...and it stays wherever a surviving body does call it: enums.til's
    // switch has a `case:` wildcard arm whose body calls UNREACHABLE.
    add_count(tests, "enums_keeps_called_unreachable", "build", "void UNREACHABLE(", 2,
        format(til_bin, " translate -c gen/c/en_ur.c test/enums.til '&&' cat gen/c/en_ur.c"))
    // The literal exposed DCE's trivial-delete matcher to CONSUMING
    // deletes: Array.unsafe_set's `T.delete(own self.unsafe_get(i),
    // false)` hoists its receiver into a ref temp, and with call_free a
    // literal the matcher saw `Str.delete(<ident>, false)` and pruned the
    // old-element drop -- an `own` arg is real semantics, never a temp
    // cleanup, and the matcher rejects it now. The two survivors here are
    // unsafe_set's drop plus Array.delete's per-element loop -- that loop
    // used to contribute TWO, because a range for-in emitted its body once
    // per direction; `0..self.cap` is statically ascending, so only the
    // ascending copy is built now.
    add_count(tests, "flow_keeps_consuming_deletes", "build", "Str_delete(hoisted__", 2,
        format(til_bin, " translate -c gen/c/flow_cd.c test/flow.til '&&' cat gen/c/flow_cd.c"))
    add_count(tests, "errors_clone_value_abi", "build", "static ErrorWithMessage ErrorWithMessage_clone(ErrorWithMessage * self)", 2,
        format(til_bin, " translate -c gen/c/errors_mc.c test/errors.til '&&' cat gen/c/errors_mc.c"))
    add_count(tests, "tilminal_vec_clone_value_abi", "build", "static Vec__Str Vec__Str_clone(Vec__Str * self)", 2,
        format(til_bin, " translate -c gen/c/tilminal_vc.c examples/tilminal.til '&&' cat gen/c/tilminal_vc.c"))
    add_count(tests, "str_clone_value_abi", "build", "Str Str_clone(Str * val)", 2,
        format(til_bin, " translate -c gen/c/hs_sc.c examples/hello_script.til '&&' cat gen/c/hs_sc.c"))
    // Issue #326: the same for an enum's INLINE primitive payload -- the
    // generated destructor drops the whole arm (a tag compare, a payload
    // pointer, the call). Vec(I64).clear's per-element drop used to be the
    // one survivor in this fixture; the dead loop around it went too, so
    // nothing here deletes an I64 any more.
    add_count(tests, "enums_primitive_payload_arm_dropped", "build", "I64_delete(hoisted__I64", 0,
        format(til_bin, " translate -c gen/c/enums_pp.c test/enums.til '&&' cat gen/c/enums_pp.c"))
    // ...and a Str payload keeps its arm: that one has real cleanup.
    add_count(tests, "enums_keeps_str_payload_delete", "build", "Str_delete(hoisted__Str_Token_delete", 1,
        format(til_bin, " translate -c gen/c/enums_sp.c test/enums.til '&&' cat gen/c/enums_sp.c"))
    // Issue #326: the initer asks init_delete_is_noop -- "does deleting
    // this do anything?" -- rather than POD-ness, so an enum arm whose
    // payload is itself a payload-less enum is not generated either.
    // core's `Type.Primitive(Primitive)` is that shape.
    add_count(tests, "aliases_no_enum_payload_delete_arm", "build", "Primitive_delete", 0,
        format(til_bin, " translate -c gen/c/aliases_ep.c test/aliases.til '&&' cat gen/c/aliases_ep.c"))
    // ...and a HAND-WRITTEN delete is never skipped, however POD-shaped
    // its type: DeleteCustom counts its own calls.
    add_count(tests, "structs_keeps_hand_written_delete", "build", "DeleteCustom_delete", 10,
        format(til_bin, " translate -c gen/c/structs_hw.c test/structs.til '&&' cat gen/c/structs_hw.c"))
    // Issue #326: the no-op-delete gate reads the DESTRUCTOR BODY, so it
    // covers a POD struct field and a payload-less enum field too -- and
    // it is asked of the initer's `<place>.delete(false)` method shape,
    // not just the garbager's `T.delete(x, false)`. Once the last call
    // goes the definition goes with it: the site inventory asks the same
    // question. `DotShape` is a payload-less enum held as a field.
    add_count(tests, "enums_drops_enum_field_delete", "build", "DotShape_delete", 0,
        format(til_bin, " translate -c gen/c/enums_ef.c test/enums.til '&&' cat gen/c/enums_ef.c"))
    add_count(tests, "structs_drops_pod_field_delete", "build", "DerivedFieldInner_delete", 0,
        format(til_bin, " translate -c gen/c/structs_ef.c test/structs.til '&&' cat gen/c/structs_ef.c"))
    // Issue #326: a generated destructor's per-field cleanup skips a
    // BORROWED primitive field -- its delete is core's `if call_free {
    // free(own self) }` reached with call_free false. The all-POD
    // shortcut said as much for a struct whose fields are ALL like this;
    // `Person { name := "unknown", age := 0 }` got the dead call anyway.
    add_count(tests, "structs_no_primitive_field_delete", "build", "I64_delete(&self->age, 0);", 0,
        format(til_bin, " translate -c gen/c/structs_pf.c test/structs.til '&&' cat gen/c/structs_pf.c"))
    // ...and a field whose type has real cleanup keeps its call.
    add_count(tests, "structs_keeps_str_field_delete", "build", "Str_delete(&self->name, 0);", 3,
        format(til_bin, " translate -c gen/c/structs_sf.c test/structs.til '&&' cat gen/c/structs_sf.c"))
    // Issue #326: a destructor whose whole body is the `if call_free {
    // free(own self) }` tail -- every POD struct, every payload-less enum,
    // every primitive -- does nothing when call_free is false, so the call
    // is not emitted. til.c: 2,181 such calls -> 363, 1,824 lines.
    add_count(tests, "structs_no_noop_pod_delete", "build", "Point_delete(&a, 0);", 0,
        format(til_bin, " translate -c gen/c/structs_nd2.c test/structs.til '&&' cat gen/c/structs_nd2.c"))
    // ...unless the call is the binding's ONLY reader: dropping it would
    // leave a declaration nothing reads, and retiring the declaration too
    // is the ownership rewrite #302 owns. test_delete's `p := Point(x=3,
    // y=7); Point.delete(own p)` is exactly that shape.
    add_count(tests, "structs_keeps_sole_reader_delete", "build", "Point_delete(&p, (Bool){0});", 1,
        format(til_bin, " translate -c gen/c/structs_sr.c test/structs.til '&&' cat gen/c/structs_sr.c"))
    // A destructor with real field work keeps every call.
    add_count(tests, "errors_keeps_field_deletes", "build", "Str_delete(&self->msg, 0);", 6,
        format(til_bin, " translate -c gen/c/errors_fd.c test/errors.til '&&' cat gen/c/errors_fd.c"))
    // Issue #326: deleting an IMMUTABLE Str-literal local cannot do
    // anything. Both of Str.delete's branches test the cap, and such a
    // local IS the CAP_LIT wrapper -- its own file-scope static or a member
    // of the shared pool -- so the buffer is static and `call_free.and(cap
    // .neq(CAP_LIT))` is false whatever call_free says. 16,387 of the
    // corpus's 20,628 Str_delete calls were this; til.c lost 8,320 lines.
    add_count(tests, "structs_no_pool_literal_deletes", "build", "Str_delete(&_til_str_lits", 0,
        format(til_bin, " translate -c gen/c/structs_nd.c test/structs.til '&&' cat gen/c/structs_nd.c"))
    // ...and a MUTABLE one keeps its delete: `mut out := "..."` is
    // reassigned, so by the delete the cap is whatever the last write left.
    add_count(tests, "strings_keeps_mut_literal_delete", "build", "\n    Str_delete(&out, (Bool){0});", 2,
        format(til_bin, " translate -c gen/c/strings_md.c test/strings.til '&&' cat gen/c/strings_md.c"))
    // A `ref` decl's deliberately-unused (void) guard was written twice --
    // once in the Ref arm and once by the shared tail that runs for both
    // arms (840 duplicated statements across the corpus).
    add_count(tests, "enums_unused_guard_emitted_once", "build", "(void)_n;", 9,
        format(til_bin, " translate -c gen/c/enums_ug.c test/enums.til '&&' cat gen/c/enums_ug.c"))
    // Issue #326: an enum's auto-generated `eq` and its variant
    // constructors are ordinary namespace members, so the member walk
    // forward-declares them; the enum-auto-helper block that follows is
    // only for the enums whose members that walk SKIPS. It used to run
    // unconditionally -- 105 duplicate prototypes across the corpus, 38 in
    // this fixture alone. Two witnesses, one per family: the `eq`...
    add_count(tests, "enums_eq_declared_once", "build", "static Bool Color_eq(Color", 2,
        format(til_bin, " translate -c gen/c/enums_dp.c test/enums.til '&&' cat gen/c/enums_dp.c"))
    // ...and a payload constructor (one prototype, one definition each).
    add_count(tests, "enums_variant_ctor_declared_once", "build", "static Token Token_Num(I64", 2,
        format(til_bin, " translate -c gen/c/enums_dc.c test/enums.til '&&' cat gen/c/enums_dc.c"))
    // The forward header is written BEFORE the .c, so it has to gate on
    // the same settled inventory -- it used to see an empty one and omit
    // every lifecycle method the .c then defined. ext.c compiles against
    // this header, so Str_clone's value prototype is the witness.
    add_count(tests, "forward_header_gates_on_same_inventory", "build", "Str Str_clone(Str * val);", 1,
        format(til_bin, " translate -c gen/c/hs_fh.c examples/hello_script.til '&&' cat gen/c/hs_fh_forward.h"))
    // Issue #326: for a closed world every function in the .c is static, so
    // a prototype in the header advertises a symbol nothing can link --
    // 2,674 of boot/til_forward.h's 2,676. The header now declares only the
    // src/c/ext.c boundary, and that includes the two families that bypass
    // emit_func_forward_decl: an enum's auto-generated `eq`...
    add_count(tests, "enums_header_hides_enum_eq", "build", "Color_eq(", 0,
        format(til_bin, " translate -c gen/c/en_hdr.c test/enums.til '&&' cat gen/c/en_hdr_forward.h"))
    // ...and its variant constructors.
    add_count(tests, "enums_header_hides_variant_ctors", "build", "Color_Red(", 0,
        format(til_bin, " translate -c gen/c/en_hdrc.c test/enums.til '&&' cat gen/c/en_hdrc_forward.h"))
    // A LIBRARY's header is its ABI: nothing is static there, so the same
    // two families stay declared.
    add_count(tests, "pure_lib_header_keeps_exports", "build", "Color_Red(", 1,
        format(til_bin, " translate -c gen/c/pure_hdr.c test/pure.til '&&' cat gen/c/pure_hdr_forward.h"))
    // Exported globals get the same treatment -- til's own header used to
    // declare 110 of them `extern` while til.c defined every one `static`.
    // Counted against the gen/til/ pair `make` already produced, never a
    // second self-translate (see til_no_unneeded_reflect_family).
    add_count(tests, "til_header_hides_tu_local_globals", "build", "extern Str VERSION;", 0,
        "cat gen/til/til_forward.h")
    // ...while the ext.c boundary globals stay: ext.c reads CAP_LIT.
    add_count(tests, "til_header_keeps_ext_c_globals", "build", "extern USize CAP_LIT;", 1,
        "cat gen/til/til_forward.h")
    add_count(tests, "enums_no_uncalled_size", "build", "Color_size", 0,
        format(til_bin, " translate -c gen/c/enums_size.c test/enums.til '&&' cat gen/c/enums_size.c"))
    add_count(tests, "first_class_no_dead_field_default", "build", "unused_default_op", 0,
        format(til_bin, " translate -c gen/c/first_class_fd.c test/first_class.til '&&' cat gen/c/first_class_fd.c"))
    add_count(tests, "first_class_no_unused_attrs", "build", "__attribute__((unused))", 0,
        format(til_bin, " translate -c gen/c/first_class_attrs.c test/first_class.til '&&' cat gen/c/first_class_attrs.c"))
    // Issue #326: the preamble's macro definitions are swept the same way its
    // functions and globals are. A program that never boxes a value on the
    // heap -- 128 of the corpus's 250 outputs -- got the TIL_BOX definition
    // anyway.
    add_count(tests, "hello_cli_no_dead_box_macro", "build", "#define TIL_BOX", 0,
        format(til_bin, " translate -c gen/c/hello_box.c examples/hello_cli.til '&&' cat gen/c/hello_box.c"))
    // ...and the macro it DOES spell stays defined, in the same output.
    add_count(tests, "hello_cli_keeps_deref_macro", "build", "#define DEREF", 1,
        format(til_bin, " translate -c gen/c/hello_deref.c examples/hello_cli.til '&&' cat gen/c/hello_deref.c"))
    // A boxing program keeps both.
    add_count(tests, "enums_keeps_box_macro", "build", "#define TIL_BOX", 1,
        format(til_bin, " translate -c gen/c/enums_box.c test/enums.til '&&' cat gen/c/enums_box.c"))
    // Issue #326: `Vec(T).clear` walks its elements and deletes each one.
    // With an element whose destructor is the `if call_free { free(own
    // self) }` tail -- every primitive, every POD struct, every
    // payload-less enum -- and call_free false, that walk does nothing, so
    // the lowered loop goes, and its counter and bound with it: 275 loops
    // and 3,578 lines across the corpus, plus the O(n) they cost at
    // runtime. The block opener is the witness -- the body is the
    // `self.count = 0` tail alone.
    add_count(tests, "structs_no_dead_element_loop", "build", "Vec__I64_clear(Vec__I64 * self) {\n    {", 0,
        format(til_bin, " translate -c gen/c/structs_del.c test/structs.til '&&' cat gen/c/structs_del.c"))
    // ...and an element whose delete DOES something keeps its walk: Str's
    // frees the buffer whatever call_free says.
    add_count(tests, "structs_keeps_live_element_loop", "build", "Vec__Str_clear(Vec__Str * self) {\n    {", 1,
        format(til_bin, " translate -c gen/c/structs_sel.c test/structs.til '&&' cat gen/c/structs_sel.c"))
    // Issue #326: a wildcard `case:` arm carries no pattern, so its BODY is
    // child 0 -- and the liveness walk skipped child 0 of every Case, which
    // made every read inside one invisible. A binding the arm used on the
    // next line took an unused cast anyway: 810 of them in til's own
    // output, `!`-propagation temps and panic argument arrays above all.
    // Counted against the gen/til pair `make` already produced, never a
    // second self-translate (see til_no_unneeded_reflect_family).
    add_count(tests, "til_no_unused_cast_on_case_arm_read", "build", "(void)_bang_ret_", 0,
        "cat gen/til/til.c")
    // ...and the per-DECLARATION answer for a name the function declares
    // more than once: the `_sp`/`_op` payload pointers a generated `eq`
    // declares once per switch arm are read in the arms that read them, and
    // the function-wide ref set could not tell those arms apart.
    add_count(tests, "til_no_unused_cast_on_sibling_scope", "build", "(void)_sp;", 0,
        "cat gen/til/til.c")
    // Issue #326: a switch arm's `break` is what stops C falling into the
    // next one, and an arm that already left cannot reach it. 794 of those
    // in til's own output; the value-return wrapper is the witness, since
    // an arm ending in one always diverges.
    add_count(tests, "til_no_break_after_diverging_arm", "build", "return _ret; }\n        break;", 0,
        "cat gen/til/til.c")
    // ...and an empty then-branch spells the test backwards: the while
    // lowering hoists a condition that calls anything into a temp and then
    // wrote `if (c) {} else { break; }`, a block that cannot do anything,
    // 2,130 times in til's own output.
    add_count(tests, "til_loop_condition_tests_the_exit", "build", "if (_wcond_Bool_", 0,
        "cat gen/til/til.c")

    // Tests are registered slowest-first: run_all_parallel fills its parallel
    // slots in registration order and never reorders, so front-loading the
    // long-running jobs (GUI builds, then the slow both tests) keeps the
    // parallel tail short. The ordering below is based on per-test times from
    // a full `make test` run.

    // === GUI build tests (slowest: build + run with timeout) ===
    // Issue #266: GUI tests run as plain X clients of the single Xvfb that
    // the Makefile's outer `xvfb-run` starts for the whole suite (DISPLAY
    // is inherited). The old per-test `xvfb-run --auto-servernum` spawned
    // 16 nested X servers whose EXIT-trap teardowns raced on their /tmp
    // auth dirs: a failed `rm -r` there rewrote the healthy 124 exit
    // (from `timeout`) into xvfb-run's own exit 5.
    if en_gui == 1 {
        gui_files := array(Str,
            "examples/music_modes.til",
            "examples/piano.til",
            "examples/guitar.til",
            "examples/chess.til",
            "examples/checkers.til",
            "examples/go.til",
            "examples/snake.til",
            "examples/shootil.til",
            "examples/editor.til",
            "examples/minesweeper.til",
            "examples/font_test.til",
            "examples/popcorn.til",
            "examples/tilminal.til",
            "examples/game_of_life.til",
            "examples/hello_gui.til",
            "examples/raylib.til",
        )
        // GNU coreutils `timeout` is `gtimeout` on macOS (brew installs it
        // g-prefixed; stock macOS ships no `timeout` at all). Pick the right
        // name per host so GUI tests run on a mac, not just Linux (#25).
        mut timeout_cmd := "timeout"
        if host_os() == "macos" { timeout_cmd = "gtimeout" }
        // Interpreted gui smoke test (issue: raylib unreachable from the
        // interpreter). Every entry above BUILDS first, so the interpreted
        // FFI path had no coverage at all -- `til repl` in mode gui opened
        // no window while the suite stayed green. Runs under the suite's
        // outer xvfb-run like the rest of this block, and is skipped by
        // --no-gui with them.
        // Windowless on purpose (see the file header), so it needs no GL
        // context and keeps leak detection on, unlike an InitWindow test.
        add_single(tests, "interp_gui_ffi", "build", 0, "",
            format(til_bin, " test/gui_interp.til"))
        for gf : Str in gui_files {
            bn := test_basename(gf)
            mut run_args := ""
            if bn == "popcorn" { run_args = " --mute" }
            add_single(tests, format("build_", bn), "build", 124, "",
                format(til_bin, " build", asan_flag, " ", gf, " '&&' ", timeout_cmd, " ", GUI_TIMEOUT, " bin/", bn, run_args))
        }
    }

    // === both tests (sorted slowest-first) ===
    add_both(tests, "test/hashmaps.til", flags)
    add_both(tests, "test/dyn_hashmaps.til", flags)
    add_both(tests, "test/kwargs.til", flags)
    add_both(tests, "test/constfold.til", flags)
    add_both(tests, "test/strings.til", flags)
    add_both(tests, "test/enums.til", flags)
    add_both(tests, "test/option.til", flags)
    add_both(tests, "test/match.til", flags)
    add_both(tests, "test/lazy.til", flags)
    add_both(tests, "test/dynamic.til", flags)
    add_both(tests, "test/maps.til", flags)
    add_both(tests, "test/dyn_maps.til", flags)
    add_both(tests, "test/hashes.til", flags)
    add_both(tests, "test/operators.til", flags)
    add_both(tests, "test/flow.til", flags)
    add_both(tests, "test/asting.til", flags)
    // parsing.til drives the whole self-parser; interpreting it costs
    // ~15s for coverage the compiled run and every other test's parse
    // step already give. Compile-only. The interpreter payload bugs it
    // exposed (inline-enum-payload ownership, borrow-preserving ref
    // returns) are covered cheaply by test/enums_lifecycle.til's
    // regression tests, which stay on both backends.
    add_both(tests, "test/parsing.til", format(flags, " -no-interp"))
    add_both(tests, "test/structs.til", flags)
    add_both(tests, "test/interfaces.til", flags)
    add_both(tests, "test/types.til", flags)
    add_both(tests, "test/cast.til", flags)
    add_both(tests, "test/directives.til", flags)
    add_both(tests, "test/variadic.til", flags)
    add_both(tests, "test/loops.til", flags)
    add_both(tests, "test/aliases.til", flags)
    add_both(tests, "test/fn_ptr.til", flags)
    add_both(tests, "test/comparisons.til", flags)
    add_both(tests, "test/vecs.til", flags)
    add_both(tests, "test/dyn_vecs.til", flags)
    add_both(tests, "test/eval_heap.til", flags)
    add_both(tests, "test/ownership_shapes.til", flags)
    add_both(tests, "test/dynamic_ptr.til", flags)
    add_both(tests, "test/templ_vec.til", flags)
    add_both(tests, "test/templ_cross_unit.til", flags)
    add_both(tests, "test/templ_type_only.til", flags)
    add_both(tests, "test/priv.til", flags)
    add_both(tests, "test/trailing.til", flags)
    add_both(tests, "test/globals.til", flags)
    add_both(tests, "test/errors.til", flags)
    add_both(tests, "test/tuples.til", flags)
    add_both(tests, "test/auto.til", flags)
    add_both(tests, "test/first_class.til", flags)
    // The reflect primitives with a RUNTIME index -- the shape that reaches
    // the emitted dispatchers instead of folding. Both backends, because
    // the compiled half is the one that could not be built at all.
    add_both(tests, "test/reflect_runtime_index.til", flags)
    // ...and the types that ONLY a reflection call names, which the sweep
    // used to take with it.
    add_both(tests, "test/reflect_only_reference.til", flags)
    add_both(tests, "test/generic_infer_imports.til", flags)
    add_both(tests, "test/closures.til", flags)
    add_both(tests, "test/regression.til", flags)
    add_both(tests, "test/repl_editor.til", flags)
    add_both(tests, "test/files.til", flags)
    add_both(tests, "test/process.til", flags)
    add_both(tests, "test/circular_imports.til", flags)
    add_both(tests, "test/import_diamond.til", flags)
    // macros.til contains a macro that prints during constfolder; the line
    // appears in interpret output but not in compiled-run output, so
    // skip the run-vs-interp comparison.
    add_both(tests, "test/macros.til", format(flags, " -no-match"))
    add_both(tests, "test/sets.til", flags)
    add_both(tests, "test/dyn_sets.til", flags)
    add_both(tests, "test/hashsets.til", flags)
    add_both(tests, "test/local_defs.til", flags)
    add_both(tests, "test/shallow.til", flags)
    add_both(tests, "test/globals_cli.til", flags)
    add_both(tests, "test/own_fields.til", flags)
    add_both(tests, "test/bug256.til", flags)
    add_both(tests, "test/bug258.til", flags)
    add_both(tests, "test/bug315.til", flags)
    add_both(tests, "test/bug350.til", flags)
    // A mode-cli main that RETURNS a value: interpreting one panicked
    // ("return type read outside a call") until interpret_units gave
    // main the same return context every other call gets. Both
    // backends, standard both entry -- the interpreted leg's panic is
    // exactly what a both entry turns red on.
    add_both(tests, "test/main_return.til", flags)
    add_both(tests, "test/dead_temps.til", flags)
    add_both(tests, "test/minimal_reach.til", flags)
    add_both(tests, "test/dyn_literal.til", flags)
    add_both(tests, "test/mut_arg_str_lit.til", flags)
    add_both(tests, "test/mut_capture_str_lit.til", flags)
    add_both(tests, "test/literal_field_access.til", flags)
    add_both(tests, "test/float_literals.til", flags)
    // Issue #176: binding libc functions like setenv/getenv directly must
    // compile under -Werror and produce the expected behaviour; also covers
    // std/sys's get_env wrapper over that same libc getenv. On both
    // backends because they marshal the bindings separately -- the
    // interpreter goes through libffi and its own `returns ref` handling,
    // which is what borrows the environ pointer.
    add_both(tests, "test/ext_libc.til", flags)
    add_both(tests, "examples/priv_demo.til", flags)
    add_both(tests, "test/imports.til", flags)
    add_both(tests, "test/arrays.til", flags)
    add_both(tests, "test/dyn_arrays.til", flags)
    add_both(tests, "test/test_in_namespace.til", flags)
    add_both(tests, "test/forward_refs.til", flags)
    add_both(tests, "test/functions.til", flags)
    // TODO: namespaces.til fails the typer: MyNamespace.set is a proc with no
    // proc/ext_proc calls and the typer now demands it be a func. Update the
    // test (or the rule) then re-enable.
    // add_both(tests, "test/namespaces.til", flags)
    // topo_sort.til: re-enabled on both backends. The interp segfault
    // (a 3+-level nested inline-struct assign like c.b.a.x = 42 walked
    // only one chain link, then wrote through a null field decl) is fixed.
    add_both(tests, "test/topo_sort.til", flags)
    add_both(tests, "test/ref.til", flags)
    // enums_lifecycle ran compile-only for years: interpreting it tripped
    // the inline-enum-payload aliasing bug (write_field byte-copied the
    // ctor temp's payload and the temp's delete freed the shared Str
    // storage). Fixed -- both backends now.
    add_both(tests, "test/enums_lifecycle.til", flags)
    // doc_block_comments imports the lexer and builds Tokens (U32 fields),
    // so it runs compile-only like the lexing tests below (issue #182).
    add_both(tests, "test/doc_block_comments.til", mode_flags(0, en_run, asan_flag))
    // TODO: lexing.til and parsing.til fail interp mode after Token line/col I64->U32
    // (interpreter doesn't handle U32 struct fields correctly)
    // add_both(tests, "test/lexing.til", flags)
    // add_both(tests, "test/parsing.til", flags)
    // TODO(#114): help()/doc comments are REPL-only for now; doc_comments.til
    // assumes docs are populated for til test / til interpret.
    // add_both(tests, "test/doc_comments.til", flags)
    write_doc_doctests(DOC_DOCTEST_FILE)
    add_both(tests, DOC_DOCTEST_FILE, flags)
    // #395: ONE row per command, never a shell `&&` chain. run_all_parallel
    // splices a registered command into `<cmd> > <outfile> 2>&1`, and a shell
    // binds that redirect to the LAST command of a chain -- so the chained
    // form these doctests used ran only its first command inside test_runner,
    // sent the RESULT line to the suite's own stdout, and left an empty result
    // file that was never counted (the standing 434/435). A row per command
    // also gives each doctest its own timing and its own captured output when
    // it fails, which the chain could not.
    tutorial_run_files := write_tutorial_file_doctests()
    for tutorial_file in tutorial_run_files {
        // The label keys the result file, so a bare basename would collide
        // with the test/ file of the same name (test/namespaces.til).
        tutorial_label := format("tutorial_", test_basename(tutorial_file))
        if en_interp == 1 {
            add_single(tests, format(tutorial_label, "_i"), "docs", 0, "",
                format(til_bin, " interpret '", tutorial_file, "'"))
        }
        if en_run == 1 {
            // Explicit artifact paths, like add_cli_pair: these rows run in
            // PARALLEL now, and the defaults are keyed by source basename
            // (gen/til/<name>.c, bin/<name>), which is shared ground.
            add_single(tests, format(tutorial_label, "_r"), "docs", 0, "",
                format(til_bin, " run", asan_flag, " -o bin/c/", tutorial_label,
                    " -c gen/c/", tutorial_label, ".c '", tutorial_file, "'"))
        }
    }

    // === 2 FFI tests ===
    ffi_exp := "test/ffi.expected"
    add_single(tests, "ffi_interp", "ffi", 0, ffi_exp,
        format(til_bin, " interpret examples/ffi/ext_module.til"))
    add_single(tests, "ffi_run", "ffi", 0, ffi_exp,
        format(til_bin, " run", asan_flag, " examples/ffi/ext_module.til"))
    ffi_scavenge_exp := "test/ffi_scavenge.expected"
    // The compiler under test is passed IN: the program spawns a translate,
    // and it used to spawn the hardcoded bin/til even when the suite was
    // running bin/til_asan -- see the file's own comment.
    add_single(tests, "ffi_scavenge_link_c_run", "ffi", 0, ffi_scavenge_exp,
        format(til_bin, " run", asan_flag, " test/ffi_scavenge_link_c.til ", til_bin))
    // Issue #283: a real dlopen failure must be reported loudly at RUNTIME.
    // The diagnostic's eprint_single/ffi_last_error are ext_proc so the
    // const-folder never executes them at build time (which printed a bogus
    // line and dropped the runtime report). Assert the message appears exactly
    // once when interpreting a file whose FFI .so fails to load.
    //
    // The failure SHAPE is platform-dependent (issue #25): ELF defers
    // undefined symbols to dlopen time, so the .so builds and dlopen
    // fails; Mach-O's linker refuses the undefined symbol while BUILDING
    // the .so, so the loud runtime report is the compile failure instead.
    // Both paths exercise the same #283 guarantee: the interpreter
    // reports the FFI load problem at runtime rather than swallowing it.
    mut dlopen_fail_pat := "dlopen failed"
    if host_os() == "macos" { dlopen_fail_pat = "failed to compile FFI library" }
    // No paired compiled row, unlike the diagnostics below: compiling links
    // the symbol statically, so the same mistake is caught by ld with a
    // toolchain-worded message rather than by til. Asserting on that text
    // would be asserting on the linker.
    add_count(tests, "ffi_dlopen_fail_interp", "ffi", dlopen_fail_pat, 1,
        format(til_bin, " interpret test/ffi_dlopen_fail.til"))

    // === library mode checks (pure/pura build are the heaviest here) ===
    add_single(tests, "pure_build", "library", 0, "",
        format(til_bin, " build", asan_flag, " test/pure.til"))
    add_single(tests, "pura_build", "library", 0, "",
        format(til_bin, " build", asan_flag, " test/pura.til"))
    add_single(tests, "pure_interp_forbidden", "library", 1, "",
        format(til_bin, " interpret test/pure.til"))
    add_single(tests, "pure_run_forbidden", "library", 1, "",
        format(til_bin, " run", asan_flag, " test/pure.til"))
    add_single(tests, "pura_interp_forbidden", "library", 1, "",
        format(til_bin, " interpret test/pura.til"))
    add_single(tests, "pura_run_forbidden", "library", 1, "",
        format(til_bin, " run", asan_flag, " test/pura.til"))

    // === build tests: svg2ttf + issues summary ===
    // svg2ttf: transparent 2-colour logo produces img/til_logo.ttf (exit=0);
    // the full-colour logo panics with "too many colours" (exit=1).
    // Compiled-run only (no interpret variant); the interpreted run takes
    // ~90s and dominates wall time. Categorised as "build" so its time goes
    // into build_ms rather than cli_ms in totals.
    run("mkdir -p img")
    add_single(tests, "svg2ttf_ok", "build", 0, "",
        format(til_bin,
            " run", asan_flag, " -o bin/c/svg2ttf_ok -c gen/c/svg2ttf_ok.c ",
            "examples/svg2ttf.til ",
            "img/logo-transparent.svg img/til_logo.ttf"))
    add_single(tests, "svg2ttf_too_many_colors", "build", 1, "",
        format(til_bin,
            " run", asan_flag, " -o bin/c/svg2ttf_too_many_colors -c gen/c/svg2ttf_too_many_colors.c ",
            "examples/svg2ttf.til ",
            "img/logo.svg tmp/svg2ttf_fail.ttf"))
    // The bindgen's output has to be til the compiler still accepts. Nothing
    // checked that, because `make update_c_libs` is a manual step and the
    // committed vendor/bindings/*.til carry hand-audited edits -- so as the
    // language tightened, the emitter kept writing forms the typer had come
    // to reject (`mut` on a struct field, `7.to_i32()` under an explicit
    // `: I32`, `ext_struct("")` for an untagged struct) and a regen produced
    // 305 type errors. raylib.h is the header that exercises structs, enums
    // and function decls together; translating the result typechecks it.
    add_single(tests, "bindgen_typechecks", "build", 0, "",
        format(til_bin, " bindings -o tmp/bindgen_raylib.til vendor/raylib/src/raylib.h",
            " '&&' ", til_bin, " translate tmp/bindgen_raylib.til"))
    // Issue #326: an ext decl is an IMPORT -- it names a symbol some other
    // object file defines -- so it is not part of a library's ABI and no
    // consumer of one needs the prototype; only a call in the emitted .c
    // does. Every other gate makes an exception for a library's exports and
    // this one did too, which left 597 raylib prototypes in the generated
    // binding with nothing in the file calling them. Own output paths: two
    // tests cannot write one generated file.
    add_count(tests, "bindgen_lib_no_uncalled_ext_proto", "build", "ImageColorBrightness", 0,
        format(til_bin, " bindings -o tmp/bindgen_ray_ext.til vendor/raylib/src/raylib.h",
            " '&&' ", til_bin, " translate -c tmp/bindgen_ray_ext.c tmp/bindgen_ray_ext.til",
            " '&&' cat tmp/bindgen_ray_ext.c"))
    // Regenerating over an audited file must reproduce it. A C header cannot
    // express til's qualifier axes, so every committed binding carries human
    // answers -- ext_proc tags, own/ref overrides, Option re-typings and the
    // comments explaining them -- that regeneration used to erase, which is
    // why nobody ran `make update_c_libs` and the generator drifted until its
    // output stopped type-checking (#333). tinyfd is the file with no
    // hand-ADDED declarations, so a byte-identical result is the whole
    // property, with no manual re-add step to subtract first.
    add_single(tests, "bindgen_preserves_audit", "build", 0, "",
        format("cp vendor/bindings/tinyfd.til tmp/audit_probe.til",
            " '&&' ", til_bin, " bindings -o tmp/audit_probe.til vendor/tinyfiledialogs/tinyfiledialogs.h",
            " '&&' diff tmp/audit_probe.til vendor/bindings/tinyfd.til"))
    // issues.til is fast enough to keep in the regular suite; it refreshes
    // issues/summary.org from the current issue files.
    add_single(tests, "issues_summary", "build", 0, "",
        format(til_bin,
            " run", asan_flag, " -o bin/c/issues_summary -c gen/c/issues_summary.c ",
            "examples/issues.til"))

    // === custom modes build tests ===
    add_single(tests, "build_sender", "build", 0, "",
        format(til_bin, " build", asan_flag, " -o bin/sender --extra-modes=examples/custom_modes.til examples/sender.til"))
    add_single(tests, "build_receiver", "build", 0, "",
        format(til_bin, " build", asan_flag, " -o bin/receiver --extra-modes=examples/custom_modes.til examples/receiver.til"))
    add_single(tests, "build_publisher", "build", 0, "",
        format(til_bin, " build", asan_flag, " -o bin/publisher --extra-modes=examples/custom_modes.til examples/publisher.til"))
    add_single(tests, "build_subscriber", "build", 0, "",
        format(til_bin, " build", asan_flag, " -o bin/subscriber --extra-modes=examples/custom_modes.til examples/subscriber.til"))
    // Interpreted nng smoke test. The four builds above never interpret, so
    // nothing noticed that the Makefile built no libnng.so twin and every
    // nng-mode program died at interpret startup on the fatal twin-load
    // panic (ffi_load_archive_twin) -- the same blind spot that hid #308,
    // one library over. Windowless and networkless: version + strerror
    // pointers and an inproc-free socket open/close.
    add_single(tests, "interp_nng_ffi", "build", 0, "",
        format(til_bin, " interpret --extra-modes=examples/custom_modes.til test/nng_interp.til"))

    // === til test command (issue #51): runs interpret + compile-and-run
    // and counts "tests passed" lines so both backends are exercised.
    // Own -c: the same file is an add_both row above, and that row compiles
    // it to the derived gen/til/test_in_namespace.c too. The two have been
    // racing for that file whenever the runner scheduled them together --
    // found by the collision check, which is the whole point of it.
    add_count(tests, "til_test_cmd", "test", "tests passed", 2,
        format(til_bin, " test", asan_flag, " -c gen/c/til_test_cmd.c",
            " test/test_in_namespace.til"))

    // === parser / typer diagnostics ===
    //
    // Every diagnostic FILE is checked under both backends. They share one
    // front end, but not one configuration: ctx.compile_mode is false for
    // `interpret` and true for every compiling command, so "the typer says
    // the same thing either way" is a property to pin, not an identity --
    // #342's splat rows below are there because the two disagreed once.
    // Each backend runs once; its assertions check both the file's total and
    // the focused messages. A diagnostic that appeared, vanished, or moved
    // backends cannot silently trade places with an unrelated diagnostic.
    // #381: strict body-sweep lookup reports the ineligible generated method
    // exactly once; provisional field inference must not duplicate it. Count
    // both properties from the same interpreter output.
    // #358: array()/vec() plain elements are checked at the offending element;
    // the third case pins that array(Str, 1) is rejected rather than coerced.
    // #342: a splat whose elements do not match is reported, not passed
    // through to crash the callee -- four variadic shapes, the two literals,
    // and a Vec source, which the two backends used to disagree about. That
    // history is why this one is paired rather than left interpret-only.
    // #275 step 3: byte-copying a managed aggregate duplicates its owned
    // pointers. Both the naked source and the `to_ptr` laundering are
    // rejected, and the needle is separate from the total above so the two
    // cannot silently trade places with an unrelated diagnostic. Paired
    // because a ban the compiled backend did not also enforce would let the
    // duplication through in exactly the builds that keep the bytes.
    // #372: returning a Str view of an owned local is a use-after-free the
    // caller cannot see. Three shapes -- direct, view-of-view, and chained
    // in one expression -- and the needle is separate from the total so a
    // silent trade with an unrelated diagnostic shows up. Paired because
    // the compiled backend is where the freed bytes are actually read.
    // #373: dyn_call dispatching `delete` over an owned local releases it
    // twice -- once through the dispatched body, once through the local's
    // own scheduled delete -- and `own` cannot mark the transfer because
    // dyn_call's parameter is not own. A runtime fixture would abort the
    // suite rather than fail it, so the diagnostic IS the pinned behaviour.
    // #389: T.delete(own <inline field>, true) frees a pointer into the
    // middle of the holder -- the field is stored by value, so call_free
    // makes the callee's tail free an interior address. Both backends abort,
    // and only when the field's contents were heap-allocated, which is what
    // made it look intermittent.
    // #390: free(own <managed field>) reached through a FIELD. Two kinds,
    // two different wrongs: an inline field hands free an address inside the
    // holder (abort interpreted, a raw gcc error compiled), an owned field
    // frees its box and leaks what it owned. The needle counts both.
    // #392 follow-up: an aggregate at a plain or `mut` `: Dynamic` binding,
    // whatever its size. Its own needle, because the rule stopped being about
    // width: a struct that FITS in a word is still not a word, and four
    // spellings of it (alias, mut, constructor, call) died in the C compiler
    // while the interpreter took all four. Paired for the reason #342's rows
    // are -- this is a diagnostic the two backends have to agree on, and the
    // shape it covers is one they used to fail differently.
    add_counts(tests, "typer_errors_interp", "typer",
        format(til_bin, " interpret test/typer_errors.til"),
        CountCheck(needle = "error:", expected_count = 250),
        CountCheck(needle = "no value parameter mentions it", expected_count = 2),
        CountCheck(needle = "no named signature", expected_count = 1),
        CountCheck(needle = "conflicting evidence", expected_count = 2),
        CountCheck(needle = "no method 'to_str' for type 'NoCmp'", expected_count = 1),
        CountCheck(needle = "literal element", expected_count = 3),
        CountCheck(needle = "splat of", expected_count = 8),
        CountCheck(needle = "memcpy duplicates", expected_count = 2),
        CountCheck(needle = "the result is a view sharing", expected_count = 3),
        CountCheck(needle = "dyn_call cannot delete the local", expected_count = 1),
        CountCheck(needle = "frees the middle of the holder", expected_count = 1),
        CountCheck(needle = "does not free managed type", expected_count = 2),
        CountCheck(needle = "cannot return a borrow of local", expected_count = 2),
        CountCheck(needle = "binds the owned pointer field", expected_count = 3),
        CountCheck(needle = "where the address belongs", expected_count = 5),
        CountCheck(needle = "is an aggregate, not a word", expected_count = 5))
    add_counts(tests, "typer_errors_build", "typer",
        format(til_bin, " build", asan_flag, " test/typer_errors.til"),
        CountCheck(needle = "error:", expected_count = 250),
        CountCheck(needle = "literal element", expected_count = 3),
        CountCheck(needle = "splat of", expected_count = 8),
        CountCheck(needle = "memcpy duplicates", expected_count = 2),
        CountCheck(needle = "the result is a view sharing", expected_count = 3),
        CountCheck(needle = "dyn_call cannot delete the local", expected_count = 1),
        CountCheck(needle = "frees the middle of the holder", expected_count = 1),
        CountCheck(needle = "does not free managed type", expected_count = 2),
        CountCheck(needle = "cannot return a borrow of local", expected_count = 2),
        CountCheck(needle = "binds the owned pointer field", expected_count = 3),
        CountCheck(needle = "where the address belongs", expected_count = 5),
        CountCheck(needle = "is an aggregate, not a word", expected_count = 5))
    // One interpreter capture pins both the aggregate and each parity class.
    add_counts(tests, "fcall_arg_parity_total_interp", "typer",
        format(til_bin, " interpret test/fcall_arg_parity_error.til"),
        CountCheck(needle = "error:", expected_count = 12),
        CountCheck(needle = "duplicate argument for parameter", expected_count = 2),
        CountCheck(needle = "missing argument for parameter", expected_count = 2),
        CountCheck(needle = "too many arguments: expected 2, got 3", expected_count = 2),
        CountCheck(needle = "positional argument after named argument", expected_count = 2),
        CountCheck(needle = "argument type mismatch", expected_count = 2),
        CountCheck(needle = "must be marked", expected_count = 2))
    add_count(tests, "fcall_arg_parity_total_build", "typer", "error:", 12,
        format(til_bin, " build", asan_flag, " test/fcall_arg_parity_error.til"))
    // #342: a `..` past the last bit of the per-argument bitmap is refused,
    // not silently dropped into the lowering as an ordinary element.
    add_count(tests, "splat_arg_limit_interp", "typer",
        "must be among the first 63 arguments", 1,
        format(til_bin, " interpret test/splat_arg_limit_error.til"))
    add_count(tests, "splat_arg_limit_build", "typer",
        "must be among the first 63 arguments", 1,
        format(til_bin, " build", asan_flag, " test/splat_arg_limit_error.til"))
    // #392 stage B: a typed read of a `..Dynamic` element is checked against
    // the type the element actually carries, and a lie panics at RUNTIME --
    // so the compiled row has to `run`, not `build`. It used to answer 0
    // (the I64's bytes read as a Str header). The needle is the message
    // without its quoted type names, which keeps it stable if the wording
    // around them moves; matching the panic's source location would not, it
    // sits inside src/core/tuple.til and shifts with every edit there.
    add_count(tests, "tuple_typed_read_interp", "typer",
        "Tuple element 0 is a", 1,
        format(til_bin, " interpret test/tuple_typed_read_error.til"))
    add_count(tests, "tuple_typed_read_run", "typer",
        "Tuple element 0 is a", 1,
        format(til_bin, " run", asan_flag, " -o bin/c/tuple_typed_read",
            " -c gen/c/tuple_typed_read.c test/tuple_typed_read_error.til"))
    add_count(tests, "capture_block_error_interp", "typer",
        "is not captured", 2,
        format(til_bin, " interpret test/capture_block_error.til"))
    add_count(tests, "capture_block_error_build", "typer",
        "is not captured", 2,
        format(til_bin, " build", asan_flag, " test/capture_block_error.til"))
    add_count(tests, "capture_func_error_interp", "typer",
        "cannot capture immutable", 1,
        format(til_bin, " interpret test/capture_func_error.til"))
    add_count(tests, "capture_func_error_build", "typer",
        "cannot capture immutable", 1,
        format(til_bin, " build", asan_flag, " test/capture_func_error.til"))
    // #54: an `[own x]` block capture consumes x; a later use is rejected.
    add_count(tests, "capture_block_own_error_interp", "typer",
        "after ownership transfer", 1,
        format(til_bin, " interpret test/capture_block_own_error.til"))
    add_count(tests, "capture_block_own_error_build", "typer",
        "after ownership transfer", 1,
        format(til_bin, " build", asan_flag, " test/capture_block_own_error.til"))
    // #364: a local declared outside a loop and consumed under a guard
    // inside it is rejected, exactly like the unguarded form (3 cases).
    // #365: so is one the loop reassigns before or after the transfer,
    // in any order (4 more).
    add_count(tests, "loop_transfer_error_interp", "typer",
        "transferred inside a loop", 7,
        format(til_bin, " interpret test/loop_transfer_error.til"))
    add_count(tests, "loop_transfer_error_build", "typer",
        "transferred inside a loop", 7,
        format(til_bin, " build", asan_flag, " test/loop_transfer_error.til"))
    // #288: a core_func / core_proc is an inline-only primitive intrinsic and
    // cannot be indirected -- dyn_fn on one is a typer error (2 cases). Count
    // the enforcement substring, not "error:", since dyn_fn's Dynamic result
    // also (correctly) trips the "store Dynamic in '_'" diagnostic.
    add_count(tests, "core_func_errors_interp", "typer",
        "cannot be indirected via dyn_fn", 2,
        format(til_bin, " interpret test/core_func_errors.til"))
    add_count(tests, "core_func_errors_build", "typer",
        "cannot be indirected via dyn_fn", 2,
        format(til_bin, " build", asan_flag, " test/core_func_errors.til"))
    // A scope/namespace slot is only an Expr when the binding is callable.
    // Each of these used to deref a VALUE as a def and segfault the
    // interpreter; they now reach the diagnostic that was always there --
    // and both backends print it, so each one is a PAIR. The compiled half
    // is `run` where the error is raised by the emitted program (dyn_fn's
    // dispatcher) and `build` where the front end raises it before any C is
    // written (the main check, the introspection lookups).
    add_count(tests, "dyn_fn_value_member_error_interp", "interp",
        "dyn_fn: no method", 1,
        format(til_bin, " interpret test/dyn_fn_value_member_error.til"))
    add_count(tests, "dyn_fn_value_member_error_run", "interp",
        "dyn_fn: no method", 1,
        format(til_bin, " run", asan_flag, " -o bin/c/dyn_fn_value_member_error test/dyn_fn_value_member_error.til"))
    // The needle avoids the message's apostrophes: add_count single-quotes
    // it into the runner command line.
    add_count(tests, "main_value_error_interp", "interp",
        "this mode requires a", 1,
        format(til_bin, " interpret test/main_value_error.til"))
    add_count(tests, "main_value_error_build", "interp",
        "this mode requires a", 1,
        format(til_bin, " build -o bin/c/main_value_error test/main_value_error.til"))
    add_count(tests, "introspect_value_name_error_interp", "interp",
        "is not a struct", 1,
        format(til_bin, " interpret test/introspect_value_name_error.til"))
    add_count(tests, "introspect_value_name_error_build", "interp",
        "is not a struct", 1,
        format(til_bin, " build -o bin/c/introspect_value_name_error test/introspect_value_name_error.til"))
    // A reflection miss says WHICH miss it is, the same way on both sides:
    // a type that is not here (with the swept-type note, since that cause is
    // invisible in the source) versus an index that is not. The compiled
    // half is `run`: the dispatcher raises these at runtime, and a constant
    // argument would have been answered by the constfolder instead.
    //
    // Every compiled row spells its own -c. `-c` defaults to
    // gen/til/<basename>.c, so two rows built from ONE .til file share that
    // path -- and the runner runs rows in parallel, which had the two rows
    // below writing the same generated C while one of them compiled it. The
    // failure reads as a broken compiler, not a broken test: a function cut
    // in half mid-definition and every symbol after it "declared but never
    // defined". The interpret rows need no such care (they generate no C),
    // which is why the older pairs in this file get away with one command
    // per backend.
    add_count(tests, "reflect_missing_type_interp", "interp",
        "not found", 1,
        format(til_bin, " interpret test/reflect_missing_type_error.til nt"))
    add_count(tests, "reflect_missing_type_run", "interp",
        "not found", 1,
        format(til_bin, " run", asan_flag, " -o bin/c/reflect_missing_type",
            " -c gen/c/reflect_missing_type.c test/reflect_missing_type_error.til nt"))
    add_count(tests, "reflect_missing_type_note_interp", "interp",
        "dropped as unused", 1,
        format(til_bin, " interpret test/reflect_missing_type_error.til nt"))
    add_count(tests, "reflect_missing_type_note_run", "interp",
        "dropped as unused", 1,
        format(til_bin, " run", asan_flag, " -o bin/c/reflect_missing_type_note",
            " -c gen/c/reflect_missing_type_note.c test/reflect_missing_type_error.til nt"))
    add_count(tests, "reflect_index_out_of_range_interp", "interp",
        "index 92 out of range", 1,
        format(til_bin, " interpret test/reflect_index_out_of_range_error.til nt"))
    add_count(tests, "reflect_index_out_of_range_run", "interp",
        "index 92 out of range", 1,
        format(til_bin, " run", asan_flag, " -o bin/c/reflect_index_oor",
            " -c gen/c/reflect_index_oor.c test/reflect_index_out_of_range_error.til nt"))
    // Issue #54: function closures run under both backends.
    add_single(tests, "closures_interp", "closures", 0, "",
        format(til_bin, " interpret test/closures_interp.til"))
    add_single(tests, "closures_compile", "closures", 0, "",
        format(til_bin, " run", asan_flag, " test/closures_interp.til"))
    add_single(tests, "closures_compile_escape", "closures", 0, "",
        format(til_bin, " run", asan_flag, " test/closures_compile_escape.til"))
    add_count(tests, "capture_escape_error_interp", "typer",
        "returned closure borrows captured local", 1,
        format(til_bin, " interpret test/capture_escape_error.til"))
    add_count(tests, "capture_escape_error_build", "typer",
        "returned closure borrows captured local", 1,
        format(til_bin, " build", asan_flag, " test/capture_escape_error.til"))
    // #54: the same escape via a GLOBAL slot rather than a return.
    add_count(tests, "capture_global_escape_error_interp", "typer",
        "borrows captured local", 1,
        format(til_bin, " interpret test/capture_global_escape_error.til"))
    add_count(tests, "capture_global_escape_error_build", "typer",
        "borrows captured local", 1,
        format(til_bin, " build", asan_flag, " test/capture_global_escape_error.til"))
    // #54: and via a global's FIELD.
    add_count(tests, "capture_global_field_escape_error_interp", "typer",
        "borrows captured local", 1,
        format(til_bin, " interpret test/capture_global_field_escape_error.til"))
    add_count(tests, "capture_global_field_escape_error_build", "typer",
        "borrows captured local", 1,
        format(til_bin, " build", asan_flag, " test/capture_global_field_escape_error.til"))
    // #54: a callee that STORES a parameter globally must own it.
    add_count(tests, "capture_callee_escape_error_interp", "typer",
        "is stored where it outlives this call", 1,
        format(til_bin, " interpret test/capture_callee_escape_error.til"))
    add_count(tests, "capture_callee_escape_error_build", "typer",
        "is stored where it outlives this call", 1,
        format(til_bin, " build", asan_flag, " test/capture_callee_escape_error.til"))
    add_count(tests, "capture_own_arg_escape_error_interp", "typer",
        "own argument closure borrows captured local", 1,
        format(til_bin, " interpret test/capture_own_arg_escape_error.til"))
    add_count(tests, "capture_own_arg_escape_error_build", "typer",
        "own argument closure borrows captured local", 1,
        format(til_bin, " build", asan_flag, " test/capture_own_arg_escape_error.til"))
    add_count(tests, "capture_mut_escape_error_interp", "typer",
        "returned closure borrows captured local", 1,
        format(til_bin, " interpret test/capture_mut_escape_error.til"))
    add_count(tests, "capture_mut_escape_error_build", "typer",
        "returned closure borrows captured local", 1,
        format(til_bin, " build", asan_flag, " test/capture_mut_escape_error.til"))
    add_count(tests, "qualifier_shallow_local_error_interp", "parser",
        "locals cannot use", 1,
        format(til_bin, " interpret test/qualifier_shallow_local_error.til"))
    add_count(tests, "qualifier_shallow_local_error_build", "parser",
        "locals cannot use", 1,
        format(til_bin, " build", asan_flag, " test/qualifier_shallow_local_error.til"))
    add_count(tests, "qualifier_ref_param_error_interp", "parser",
        "parameters are borrowed by default", 1,
