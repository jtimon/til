        "non-exhaustive switch on enum", 4,
        format(til_bin, " build", asan_flag, " test/enum_switch_missing_case.til"))
    // #334: a binding pattern sharing a `case a, b:` list is rejected, on
    // switch and match alike.
    add_count(tests, "multi_pattern_binding_interp", "typer",
        "cannot share a case with other patterns", 2,
        format(til_bin, " interpret test/multi_pattern_binding_error.til"))
    add_count(tests, "multi_pattern_binding_build", "typer",
        "cannot share a case with other patterns", 2,
        format(til_bin, " build", asan_flag, " test/multi_pattern_binding_error.til"))
    // A main() param whose type can't be parsed from a CLI argument is
    // rejected up front (validate_cli_main) on both backends.
    add_count(tests, "cli_unsupported_main_interp", "typer",
        "cannot be parsed from a CLI argument", 1,
        format(til_bin, " interpret test/cli_unsupported_main.til"))
    add_count(tests, "cli_unsupported_main_build", "typer",
        "cannot be parsed from a CLI argument", 1,
        format(til_bin, " build", asan_flag, " test/cli_unsupported_main.til"))
    // #242: missing-required-field cases live in test/typer_errors.til.
    // A no-default field with no explicit type stays illegal (parser).
    add_count(tests, "required_field_no_type_error_interp", "parser",
        "expected", 1,
        format(til_bin, " interpret test/required_field_no_type_error.til"))
    add_count(tests, "required_field_no_type_error_build", "parser",
        "expected", 1,
        format(til_bin, " build", asan_flag, " test/required_field_no_type_error.til"))
    // #296: `{}` turns a FuncSig into an invalid function value. Reject the
    // empty non-void body while parsing so the intended correction is reported
    // once, before the unknown field type can produce typer cascades.
    add_count(tests, "empty_funcsig_body_error_interp", "parser",
        "did you mean a FuncSig", 1,
        format(til_bin, " interpret test/empty_funcsig_body_error.til"))
    add_count(tests, "empty_funcsig_body_error_build", "parser",
        "did you mean a FuncSig", 1,
        format(til_bin, " build", asan_flag, " test/empty_funcsig_body_error.til"))

    // === CLI tests ===
    // Expected outputs are reviewed goldens under test/*.expected, the same
    // artifacts the HolyC and JVM checks already use. They used to be
    // hardcoded strings this file wrote into gen/out/expected/ on every run
    // (issue #171), which put the expectation and the reimplementation of it
    // -- fizzbuzz's 100 lines were GENERATED here by a second fizzbuzz -- in
    // the test harness rather than under review. `bin/tests --regen` rewrites
    // them; the diff is the record of what a change did.
    exp := "test/"

    add_cli_pair(tests, "cli_args_hello", "examples/cli_args.til",
        "hello world", 0, format(exp, "cli_args_hello.expected"), til_bin, asan_flag)
    add_single(tests, "cli_args_default_args", "cli", 0, format(exp, "cli_args_hello.expected"),
        format(til_bin, " examples/cli_args.til hello world"))
    add_single(tests, "cli_args_dd_default_args", "cli", 0, format(exp, "cli_args_hello.expected"),
        format(til_bin, " -- examples/cli_args.til hello world"))

    add_cli_pair(tests, "cli_args_empty", "examples/cli_args.til",
        "", 0, format(exp, "cli_args_empty.expected"), til_bin, asan_flag)

    add_cli_pair(tests, "fizzbuzz", "examples/fizzbuzz.til",
        "", 0, format(exp, "fizzbuzz.expected"), til_bin, asan_flag)

    // Issue #220: script-mode map/set literals must compile under -Werror.
    add_cli_pair(tests, "script_map_lit", "test/script_map_lit.til",
        "", 0, format(exp, "script_map_lit.expected"), til_bin, asan_flag)

    // A program-scope raw-allocator decl must give the global POINTER
    // storage like the function-local form; as a value global the
    // memset/ptr_add writes ran past a one-byte object (ASAN:
    // global-buffer-overflow).
    add_cli_pair(tests, "script_raw_alloc", "test/script_raw_alloc.til",
        "", 0, format(exp, "script_raw_alloc.expected"), til_bin, asan_flag)

    // An owned Dynamic declared from an erased-dynamic source (a deref()
    // result bound by ref) must copy the pointer word; the interpreter's
    // clone path deref'd the raw allocation itself and later freed a
    // garbage word (interpreter-only segfault; compiled mode was correct).
    add_cli_pair(tests, "script_dynamic_free", "test/script_dynamic_free.til",
        "", 0, format(exp, "script_dynamic_free.expected"), til_bin, asan_flag)

    // Shared Str semantics used by the HolyC backend: literals, owned clones,
    // views, mutation, integer conversion, counted output, and explicit delete.
    add_cli_pair(tests, "script_str_runtime", "test/script_str_runtime.til",
        "", 0, format(exp, "script_str_runtime.expected"), til_bin, asan_flag)

    // #357 family at script scope: a Dynamic GLOBAL taking a pointer keeps
    // the address. The declaration used to gain a second star (`void **x`)
    // and, once that was fixed, the init declared a shadowing local instead
    // of assigning the global. Compiled-only; the interpreter always read it
    // right, so both backends must agree here.
    add_cli_pair(tests, "script_dynamic_global_ptr", "test/script_dynamic_global_ptr.til",
        "", 0, format(exp, "script_dynamic_global_ptr.expected"), til_bin, asan_flag)

    // #275: a script-scope binding the program deletes is not dropped a
    // second time by session teardown. Interpreter-only: the AST's
    // garbager-inserted delete released the payload and teardown ran the
    // destructor again over the same value.
    // Both call spellings are covered: the UFCS receiver form and the
    // explicit `Vec(I64).delete(own w, true)`, which reach the callee by
    // different routes and were independently broken. The `delete(false)`
    // case is the one a moved-out mark alone cannot express -- contents
    // released, box still ours -- so it is what separates the
    // payload_released fix from a transfer-marking one.
    add_cli_pair(tests, "script_own_delete_global", "test/script_own_delete_global.til",
        "", 0, format(exp, "script_own_delete_global.expected"), til_bin, asan_flag)

    // The bang's synthesized panic prints the source location ONCE (via
    // panic's `loc` param) and a readable message; it used to pass the
    // location as a message part too, printing it twice and jamming it
    // against the type name. Exit code 1: panic exits non-zero.
    add_cli_pair(tests, "script_bang_panic_msg", "test/script_bang_panic_msg.til",
        "", 1, format(exp, "script_bang_panic_msg.expected"), til_bin, asan_flag)

    // Same panic, reached through a STORE (`r = v[9]`). The check used to
    // be emitted after the assignment, so the store dereferenced the
    // ref-returning callee's NULL fallback return first and the program
    // died with "panic: null deref" instead of this message.
    add_cli_pair(tests, "script_bang_store_panic_msg", "test/script_bang_store_panic_msg.til",
        "", 1, format(exp, "script_bang_store_panic_msg.expected"), til_bin, asan_flag)

    // A bare TODO() keeps working and still points at the CALL SITE, not at
    // core/exit.til: `loc` defaults to __LOC__, which resolves at the caller.
    // With no message parts it prints plain "TODO" -- formatting an empty
    // parts list used to leave a dangling "TODO: ". This is the only place we
    // call TODO with no message; real markers should say what is missing.
    add_cli_pair(tests, "script_todo_loc", "test/script_todo_loc.til",
        "", 1, format(exp, "script_todo_loc.expected"), til_bin, asan_flag)

    // Top-level statements get the same throw/catch/bang lowering as a
    // function body: a subscript (`v[0]` -> `get(...)!`), an explicit bang
    // and a `?`/catch all work at the root of a `mode script` unit.
    add_cli_pair(tests, "script_toplevel_throws", "test/script_toplevel_throws.til",
        "", 0, format(exp, "script_toplevel_throws.expected"), til_bin, asan_flag)

    // Issue #312: a top-level numeric for-in loop in a `mode script` unit must
    // type-check (both interpreted and compiled) instead of panicking
    // OutOfBounds in infer_body_unit.
    add_cli_pair(tests, "bug312", "test/bug312.til",
        "", 0, format(exp, "bug312.expected"), til_bin, asan_flag)

    add_cli_pair(tests, "cli_typed_alice42", "examples/cli_typed.til",
        "alice 42", 0, format(exp, "cli_typed_alice42.expected"), til_bin, asan_flag)

    add_cli_pair(tests, "hello_cli", "examples/hello_cli.til",
        "", 0, format(exp, "hello_cli.expected"), til_bin, asan_flag)
    add_single(tests, "hello_cli_dd_default", "cli", 0, format(exp, "hello_cli.expected"),
        format(til_bin, " -- examples/hello_cli.til"))
    add_single(tests, "hello_cli_dd_i", "cli", 0, format(exp, "hello_cli.expected"),
        format(til_bin, " interpret -- examples/hello_cli.til"))
    add_single(tests, "hello_cli_dd_r", "cli", 0, format(exp, "hello_cli.expected"),
        format(til_bin, " run", asan_flag, " -o bin/c/hello_cli_dd -c gen/c/hello_cli_dd.c -- examples/hello_cli.til"))

    add_cli_pair(tests, "variadic_add", "examples/cli_variadic_i64.til",
        "add 10 20 30", 0, format(exp, "variadic_add.expected"), til_bin, asan_flag)

    add_cli_pair(tests, "variadic_mul", "examples/cli_variadic_i64.til",
        "mul 2 3 4", 0, format(exp, "variadic_mul.expected"), til_bin, asan_flag)

    add_cli_pair(tests, "variadic_add0", "examples/cli_variadic_i64.til",
        "add", 0, format(exp, "variadic_add0.expected"), til_bin, asan_flag)

    add_cli_pair(tests, "variadic_bool_f", "examples/cli_variadic_bool.til",
        "true true false", 0, format(exp, "variadic_bool_f.expected"), til_bin, asan_flag)

    add_cli_pair(tests, "variadic_bool_t", "examples/cli_variadic_bool.til",
        "true true", 0, format(exp, "variadic_bool_t.expected"), til_bin, asan_flag)

    // Every scalar CLI arg type (I8/U8/I16/U16/I32/U32/U64/USize/UPtr/F32),
    // both backends. Locks in the builder's cli_box_expr and the interpreter's
    // parse_cli_arg staying in lockstep.
    add_cli_pair(tests, "cli_scalars", "examples/cli_scalars.til",
        "-8 200 -300 600 -70000 90000 12345678901 42 99 3.5 1e150", 0,
        format(exp, "cli_scalars.expected"), til_bin, asan_flag)
    // #333: the F64 primitive (64-bit float), full surface. Literals (1e100
    // proves real double width -- an F32 path prints inf), the numbers.til
    // method set (operators, cmp, clone via param-return, conversions,
    // 17-digit repr round-trip), Str.to_f64, an F64 CLI main arg, identical
    // in both backends.
    add_cli_pair(tests, "f64", "test/f64.til",
        "0.125 2.75", 0,
        format(exp, "f64.expected"), til_bin, asan_flag)
    // ..F64 variadic main args: elem_size_for_type under interpret panicked
    // on F64 (hand-listed switch missed the new primitive; the loud panic
    // caught it) while compiled worked -- lock both backends.
    add_cli_pair(tests, "f64_variadic", "test/f64_variadic.til",
        "1.5 2.5e10", 0,
        format(exp, "f64_variadic.expected"), til_bin, asan_flag)

    // Error cases (exit=1, no output check)
    add_cli_pair(tests, "cli_typed_err1", "examples/cli_typed.til", "alice", 1, "", til_bin, asan_flag)
    add_cli_pair(tests, "cli_typed_err2", "examples/cli_typed.til", "a b c", 1, "", til_bin, asan_flag)
    add_cli_pair(tests, "hello_cli_err", "examples/hello_cli.til", "extra", 1, "", til_bin, asan_flag)
    // Bad Bool value: both backends print the diagnostic and exit(1).
    add_cli_pair(tests, "cli_bool_err", "examples/cli_variadic_bool.til", "true maybe", 1, "", til_bin, asan_flag)

    // === Golden-file harness (#171, #172) ===
    // The goldens above are only worth their weight if the harness cannot
    // drift them silently, so the three behaviours that guarantee that are
    // themselves tested. Run test_runner directly: what is under test is
    // the runner's own reporting, not the program it runs.
    //
    // A MISSING golden is a failure, never an expectation written from
    // whatever the program happened to print. This is the whole difference
    // between a reviewed artifact and a cache, and it is one deleted
    // `if File.exists` away from silently coming back.
    add_count(tests, "golden_missing_fails", "test",
        "missing expected output file", 1,
        format(RUNNER, " single golden_absent_probe 0 tmp/golden_absent_probe.expected -- ",
            til_bin, " interpret examples/hello_cli.til"))
    // A mismatch reports which lines moved, not two blobs to eyeball.
    // hello_cli against the variadic_add golden: "Hello World!" vs "60".
    add_counts(tests, "golden_mismatch_diffs", "test",
        format(RUNNER, " single golden_wrong_probe 0 test/variadic_add.expected -- ",
            til_bin, " interpret examples/hello_cli.til"),
        CountCheck(needle = "output mismatch", expected_count = 1),
        CountCheck(needle = "end diff -u expected actual", expected_count = 1))
    // --regen writes the golden instead of comparing. The suite never
    // passes it; only `make test_regen` does.
    add_count(tests, "golden_regen_writes", "test",
        "REGEN: golden_regen_probe", 1,
        format(RUNNER, " single golden_regen_probe 0 tmp/golden_regen_probe.expected --regen -- ",
            til_bin, " interpret examples/hello_cli.til"))

    // === Run all tests in parallel ===
    // Not one row starts until the table is known to be free of the
    // generated-C collision above: a race there reads as a compiler bug.
    clashes := check_gen_c_collisions(tests)
    if clashes > 0 {
        println(clashes.to_str(), " generated-C collision(s); no test was run")
        exit(1)
    }
    mut suite_end_ms := 0
    run_all_parallel(tests, j, fail, suite_end_ms)

    // --- Accumulate totals ---

    println("")
    mut total_interp_ms := 0
    mut total_compile_ms := 0
    mut total_run_ms := 0
    mut total_mem_inte := 0
    mut total_mem_comp := 0
    mut total_mem_run := 0
    mut both_passed : USize = 0
    mut both_total : USize = 0
    mut pi : USize = 0
    while pi < tests.len() {
        ref t : Test = tests[pi]
        switch t.kind {
        case .Both(md):
            both_total++
            if t.has_interp == 1 {
                total_interp_ms = total_interp_ms + md.interp_ms
                total_mem_inte = total_mem_inte + md.interp_mem
            }
            if t.has_run == 1 {
                total_compile_ms = total_compile_ms + md.compile_ms
                total_run_ms = total_run_ms + md.run_ms
                total_mem_comp = total_mem_comp + md.compile_mem
                total_mem_run = total_mem_run + md.run_mem
            }
            if t.ok == 1 { both_passed++ }
        case:
        }
        pi++
    }

    // --- Section totals from non-both tests ---

    mut ffi_ms := 0
    mut typer_ms := 0
    mut cli_ms := 0
    mut build_ms := 0
    mut build_mem := 0
    mut self_ms := 0
    mut self_mem := 0
    mut other_passed : USize = 0
    mut other_total : USize = 0
    pi = 0
    while pi < tests.len() {
        ref t : Test = tests[pi]
        if t.kind.is(TestKind.Both).not() {
            other_total++
            if t.ok == 1 { other_passed++ }
            if t.category == "ffi" { ffi_ms = ffi_ms + t.ms }
            if t.category == "typer" { typer_ms = typer_ms + t.ms }
            if t.category == "cli" { cli_ms = cli_ms + t.ms }
            if t.category == "self" {
                self_ms = self_ms + t.ms
                self_mem = self_mem + t.mem
            }
            if t.category == "build" {
                build_ms = build_ms + t.ms
                build_mem = build_mem + t.mem
            }
        }
        pi++
    }

    // --- Plot test (stays sequential) ---

    plot_start := clock_ms()
    test_csv := format("commit,interp_ms,compile_ms,run_ms,ffi_ms,typer_ms,cli_ms,wall_ms,passed,total,mem_inte,mem_comp,mem_run,mem_total,self_ms,self_mem", NL,
        "abc1234,1950,4000,1530,200,1710,1970,4640,32,32,500000,900000,300000,1700000,5200,600000", NL,
        "def5678,1890,3900,1510,190,1680,1950,4500,32,32,520000,880000,320000,1720000,5100,620000", NL)
    File.writefile("tmp/_test_plot.csv", test_csv)
    run(format(PLOT, " tmp/_test_plot.csv tmp/_test_plot.svg 0"))
    plot_svg := File.readfile("tmp/_test_plot.svg")
    mut plot_ok := 1
    if count_matches(plot_svg, "<svg") == 0 {
        println("FAIL: plot.til missing <svg tag")
        plot_ok = 0
        fail = 1
    }
    if count_matches(plot_svg, "<polyline") < 9 {
        println("FAIL: plot.til expected 9 polylines, got ", count_matches(plot_svg, "<polyline").to_str())
        plot_ok = 0
        fail = 1
    }
    if count_matches(plot_svg, "abc1234") == 0 {
        println("FAIL: plot.til missing commit label abc1234")
        plot_ok = 0
        fail = 1
    }
    if count_matches(plot_svg, "inte") == 0 {
        println("FAIL: plot.til missing legend label inte")
        plot_ok = 0
        fail = 1
    }
    if count_matches(plot_svg, "mem-total") != 0 {
        println("FAIL: plot.til should not draw mem-total legend")
        plot_ok = 0
        fail = 1
    }
    if count_matches(plot_svg, ">self<") == 0 {
        println("FAIL: plot.til missing legend label self")
        plot_ok = 0
        fail = 1
    }
    if count_matches(plot_svg, ">self-mem<") == 0 {
        println("FAIL: plot.til missing legend label self-mem")
        plot_ok = 0
        fail = 1
    }
    plot_ms := clock_ms() - plot_start

    // --- Summary ---

    total_passed := both_passed.add(other_passed) + plot_ok.to_usize()
    total_tests := both_total.add(other_total) + 1

    // Wall excludes the self-translate benchmark: suite_end_ms is when the last
    // non-"self" test finished, so self_ms stands on its own without inflating
    // wall (self runs in parallel and is usually the long pole).
    wall_ms := suite_end_ms - wall_start

    println("")
    println("=== Summary ===")
    if en_interp == 1 { println("interp:       ", ms_to_str(total_interp_ms)) }
    if en_run == 1 {
        println("compile:      ", ms_to_str(total_compile_ms))
        println("run:          ", ms_to_str(total_run_ms))
    }
    println("FFI tests:    ", ms_to_str(ffi_ms))
    println("Typer errors: ", ms_to_str(typer_ms))
    println("CLI tests:    ", ms_to_str(cli_ms))
    println("Plot test:    ", ms_to_str(plot_ms))
    println("Build tests:  ", ms_to_str(build_ms))
    println("Self-translate: ", ms_to_str(self_ms))
    println("Wall-clock:   ", ms_to_str(wall_ms))
    println("Passed:       ", total_passed.to_i64().to_str(), "/", total_tests.to_i64().to_str())
    println("")

    if fail == 0 {
        println("all tests passed")
    }

    // --- Benchmark CSV logging ---

    run("git rev-parse --short HEAD > tmp/_commit_hash")
    commit := File.readfile("tmp/_commit_hash").replace(NL, "")

    // gen/benchmark.csv -- both tests only (not tracked)
    run("mkdir -p gen")
    mut bench := Str.with_capacity(32768)
    bench.push_str("commit,file,interp_ms,compile_ms,run_ms,interp_ok,compile_ok,run_ok")
    bench.push_str(NL)
    mut bi : USize = 0
    while bi < tests.len() {
        ref bt : Test = tests[bi]
        switch bt.kind {
        case .Both(bmd):
            bench.push_str(format(commit, ",", bt.label, ",",
                bmd.interp_ms.to_str(), ",", bmd.compile_ms.to_str(), ",",
                bmd.run_ms.to_str(), ",",
                bmd.interp_ok.to_str(), ",", bmd.compile_ok.to_str(), ",",
                bmd.run_ok.to_str(), NL))
        case:
        }
        bi++
    }
    File.writefile("gen/benchmark.csv", bench)

    // doc/totals.csv -- all test totals (skip on failure)
    if fail == 0 {
        total_mem_total := total_mem_inte.add(total_mem_comp).add(total_mem_run) + build_mem
        totals_line := format(commit, ",",
            total_interp_ms.to_str(), ",",
            total_compile_ms.to_str(), ",", total_run_ms.to_str(), ",",
            ffi_ms.to_str(), ",", typer_ms.to_str(), ",",
            cli_ms.to_str(), ",", wall_ms.to_str(), ",",
            total_passed.to_i64().to_str(), ",", total_tests.to_i64().to_str(), ",",
            total_mem_inte.to_str(), ",",
            total_mem_comp.to_str(), ",",
            total_mem_run.to_str(), ",",
            total_mem_total.to_str(), ",",
            self_ms.to_str(), ",",
            self_mem.to_str())

        totals_path := "doc/totals.csv"
        // tests.til owns the header so the column set (incl self_ms / self_mem)
        // always matches the data and survives the merge's `git restore
        // doc/totals.csv`: the file is auto-generated and discarded, so the
        // header only persists if it is regenerated here.
        header := "commit,interp_ms,compile_ms,run_ms,ffi_ms,typer_ms,cli_ms,wall_ms,passed,total,mem_inte,mem_comp,mem_run,mem_total,self_ms,self_mem"
        existing := File.readfile(totals_path)
        mut totals_content := format(header, NL)
        lines := existing.split(NL)
        // Keep existing data rows (skip the old header at line 0 and blanks),
        // dropping any row for the current commit so a re-run replaces it.
        mut li : USize = 1
        while li < lines.len() {
            ref ln : Str = lines[li]
            if ln.len() > 0 {
                row_commit := ln.substr(0, ln.find(",").to_usize())
                if row_commit != commit {
                    totals_content = format(totals_content, ln, NL)
                }
            }
            li++
        }
        totals_content = format(totals_content, totals_line, NL)
        File.writefile(totals_path, totals_content)

        run(format(PLOT, " doc/totals.csv img/totals.svg 10 --no-x-labels"))
        println("Updated doc/totals.csv and img/totals.svg")
    }

    exit(fail)
}
