    // #84: mode theme owns a domain serializer rather than falling through
    // to C. The tracked Emacs artifact is the direct golden -- no second copy.
    // Invalid typed data must fail before writing plausible-looking Elisp.
    add_single(tests, "theme_elisp_exact", "build", 0, "",
        format(til_bin, " translate -o gen/til/theme-exact.el editor/themes/til-dark-theme.til '&&' cmp gen/til/theme-exact.el editor/themes/til-dark-theme.el"))
    add_single(tests, "theme_default_path", "build", 0, "",
        format(til_bin, " translate editor/themes/til-dark-theme.til '&&' cmp gen/til/til-dark-theme.el editor/themes/til-dark-theme.el"))
