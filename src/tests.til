mode cli

import("std/sys")
import("std/file")

NL := "\n"
TIL := "bin/til"
RUNNER := "bin/test_runner"
// `bin/tests --regen` (issue #172) rewrites every expected-output golden
// from what the tests actually print, instead of comparing against it. Set
// once in main and spliced by add_single into the runner invocations that
// have a golden; a global because the ~100 add_single call sites would
// otherwise all have to carry a flag none of them decides.
mut REGEN := ""
PLOT := "bin/plot"
GUI_TIMEOUT := "1"
DOC_DOCTEST_FILE := "tmp/doc_doctests.til"
TUTORIAL_DOCTEST_DIR := "tmp/tutorial_doctests"

count_matches := func(haystack: Str, needle: Str) returns I64 {
    if needle.is_empty() { return 0 }
    mut count := 0
    mut start : USize = 0
    while start <= haystack.len() - needle.len() {
        pos := haystack.substr(start, haystack.len() - start).find(needle)
        if pos == -1 { return count }
        count++
        pos_u : USize = pos.to_usize()
        start = start.add(pos_u) + needle.len()
    }
    return count
}

// Run a shell command, return exit code
run := proc(cmd: Str) returns I64 {
    pid := spawn_cmd(cmd)
    return wait_cmd(pid)
}

// --- Helpers ---

ms_to_str := func(ms: I64) returns Str {
    secs := ms / 1000
    frac := ms.mod(1000) / 10
    mut frac_str := frac.to_str()
    if frac < 10 { frac_str = format("0", frac_str) }
    return format(secs.to_str(), ".", frac_str, "s")
}

pad_right := func(s: Str, width: USize) returns Str {
    mut result := s.clone()
    while result.len() < width {
        result = format(result, " ")
    }
    return result
}

test_basename := func(path: Str) returns Str {
    mut last_slash : USize = 0
    mut has_slash := 0
    for si in 0..path.len() {
        if path.get(si) == '/' {
            last_slash = si
            has_slash = 1
        }
    }
    mut name := path
    if has_slash == 1 {
        name = path.substr(last_slash + 1, path.len().sub(last_slash) - 1)
    }
    if name.ends_with(".til") {
        name = name.strip_suffix(".til")
    }
    return name
}

parse_kv := func(line: Str, key: Str) returns I64 {
    needle := format(key, "=")
    pos := line.find(needle)
    if pos < 0 { return 0 }
    pos_u : USize = pos.to_usize()
    start := pos_u + needle.len()
    mut end := start
    while end.lt(line.len()).and(line.get(end).neq(' ')).and(line.get(end).neq(10)) {
        end++
    }
    return line.substr(start, end - start).to_i64()
}

mode_flags := func(en_interp: I64, en_run: I64, asan_flag: Str) returns Str {
    mut f := ""
    if en_interp == 0 { f = format(f, " -no-interp") }
    if en_run == 0 { f = format(f, " -no-run") }
    if asan_flag.len() > 0 { f = format(f, " ", asan_flag) }
    return f
}

doc_test_line_end := func(body: Str, pos: USize) returns USize {
    rest := body.substr(pos, body.len() - pos)
    line_rel := rest.find("\n")
    if line_rel < 0 { return body.len() }
    return pos + line_rel.to_usize()
}

doc_test_next_line_pos := func(body: Str, line_end: USize) returns USize {
    if line_end >= body.len() { return body.len() }
    return line_end + 1
}

doc_test_block_text := func(line: Str, path: Str, source_comment: Bool) returns Str {
    if source_comment.not() { return line }
    trimmed := line.trim()
    if trimmed.starts_with("///").not() { panic("unterminated doctest block in ", path) }
    mut text := trimmed.strip_prefix("///")
    if text.starts_with(" ") { text = text.strip_prefix(" ") }
    return text
}

doc_test_is_doctest_begin := func(line: Str, source_comment: Bool) returns Bool {
    if source_comment.and(line.trim().starts_with("///").not()) { return false }
    text := doc_test_block_text(line, "<doc-test>", source_comment)
    return text.trim().starts_with("#+begin_src").and(doc_test_header_has_flag(text, "doctest"))
}

doc_test_header_has_flag := func(header: Str, name: Str) returns Bool {
    text := header.trim()
    with_space := format(":", name, " ")
    at_end := format(":", name)
    return text.contains(with_space).or(text.ends_with(at_end))
}

doc_test_header_value := func(header: Str, name: Str) returns Str {
    text := header.trim()
    needle := format(":", name, " ")
    pos := text.find(needle)
    if pos < 0 { return "" }
    start := pos.to_usize() + needle.len()
    rest := text.substr(start, text.len() - start)
    end := rest.find(" ")
    if end < 0 { return rest }
    return rest.substr(0, end.to_usize())
}

doc_test_parent_dir := func(path: Str) returns Str {
    slash := path.rfind("/")
    if slash < 0 { return "." }
    return path.substr(0, slash.to_usize())
}

doc_test_push := func(mut out: Str, text: Str) {
    required := out.len() + text.len()
    if required <= out.cap { out.push_str(text); return }
    mut new_cap := out.cap * 2
    if new_cap < required { new_cap = required }
    mut grown := Str.with_capacity(new_cap)
    grown.push_str(out)
    grown.push_str(text)
    out = grown
}

append_doc_doctests := func(mut out: Str, path: Str, source: Str, count: USize, source_comment: Bool) returns USize {
    mut next_count := count
    mut pos : USize = 0
    mut line_number : USize = 1
    while pos < source.len() {
        line_end := doc_test_line_end(source, pos)
        line := source.substr(pos, line_end - pos)
        if doc_test_is_doctest_begin(line, source_comment) {
            block_line := line_number
            loc := format(path, ":", block_line.to_str())
            pos = doc_test_next_line_pos(source, line_end)
            line_number++
            doc_test_push(out, "// doctest source: ")
            doc_test_push(out, loc)
            doc_test_push(out, "\ndoctest_")
            doc_test_push(out, next_count.to_str())
            doc_test_push(out, " := test() {\n")
            mut found_end := false
            mut has_body := false
            while pos < source.len() {
                src_line_end := doc_test_line_end(source, pos)
                src_line := source.substr(pos, src_line_end - pos)
                body_line := doc_test_block_text(src_line, loc, source_comment)
                if body_line.trim().starts_with("#+end_src") {
                    found_end = true
                    pos = doc_test_next_line_pos(source, src_line_end)
                    line_number++
                    break
                }
                if body_line.trim().is_empty().not() { has_body = true }
                doc_test_push(out, body_line)
                doc_test_push(out, "\n")
                pos = doc_test_next_line_pos(source, src_line_end)
                line_number++
            }
            if found_end.not() { panic("unterminated doctest block in ", loc) }
            if has_body.not() { panic("empty doctest block in ", loc) }
            doc_test_push(out, "}\n\n")
            next_count++
            continue
        }
        pos = doc_test_next_line_pos(source, line_end)
        line_number++
    }
    return next_count
}

append_tracked_doc_doctests := proc(mut out: Str) returns USize {
    mut listing := ""
    result := run_cmd(listing, "git", "ls-files", "src/core/*.til", "src/std/*.til", "src/self/*.til", "src/modes/*.til", "src/til.til", "examples/lib/*.til", "vendor/bindings/*.til", "doc/tutorial/*.org")
    if result != 0 { panic("failed to list documented sources") }
    mut count : USize = 0
    mut pos : USize = 0
    while pos < listing.len() {
        line_end := doc_test_line_end(listing, pos)
        path := listing.substr(pos, line_end - pos).trim()
        if path.is_empty().not() {
            source := File.readfile(path)
            count = append_doc_doctests(out, path, source, count, path.ends_with(".til"))
        }
        pos = doc_test_next_line_pos(listing, line_end)
    }
    return count
}

write_tutorial_file_blocks := proc(path: Str, source: Str, mut run_files: Vec(Str)) {
    mut pos : USize = 0
    mut line_number : USize = 1
    while pos < source.len() {
        line_end := doc_test_line_end(source, pos)
        line := source.substr(pos, line_end - pos)
        header := line.trim()
        file_path := doc_test_header_value(header, "doctest-file")
        is_run := doc_test_header_has_flag(header, "doctest-run")
        if is_run.and(file_path.is_empty()) {
            panic("doctest-run requires doctest-file in ", path, ":", line_number.to_str())
        }
        if file_path.is_empty().not() {
            loc := format(path, ":", line_number.to_str())
            if header.starts_with("#+begin_src til").not() {
                panic("doctest-file must mark a til source block in ", loc)
            }
            if File.is_absolute(file_path).or(file_path.starts_with("..")).or(file_path.contains("/../")) {
                panic("doctest-file path must stay under ", TUTORIAL_DOCTEST_DIR, " in ", loc)
            }
            if file_path.ends_with(".til").not() {
                panic("doctest-file path must end in .til in ", loc)
            }
            pos = doc_test_next_line_pos(source, line_end)
            line_number++
            block_start := pos
            mut block_end := pos
            mut found_end := false
            mut has_body := false
            while pos < source.len() {
                src_line_end := doc_test_line_end(source, pos)
                body_line := source.substr(pos, src_line_end - pos)
                if body_line.trim().starts_with("#+end_src") {
                    found_end = true
                    block_end = pos
                    pos = doc_test_next_line_pos(source, src_line_end)
                    line_number++
                    break
                }
                if body_line.trim().is_empty().not() { has_body = true }
                pos = doc_test_next_line_pos(source, src_line_end)
                line_number++
            }
            if found_end.not() { panic("unterminated doctest-file block in ", loc) }
            if has_body.not() { panic("empty doctest-file block in ", loc) }
            block := source.substr(block_start, block_end - block_start)
            output_path := format(TUTORIAL_DOCTEST_DIR, "/", file_path)
            parent := doc_test_parent_dir(output_path)
            if mkdir_p(parent) != 0 { panic("could not create tutorial doctest directory ", parent) }
            File.appendfile(output_path, block)
            if is_run {
                for existing in run_files {
                    if existing == output_path { panic("duplicate doctest-run for ", output_path) }
                }
                run_files.push(own output_path.clone())
            }
            continue
        }
        pos = doc_test_next_line_pos(source, line_end)
        line_number++
    }
}

write_tutorial_file_doctests := proc() returns Vec(Str) {
    header := "#+begin_src til :doctest-file modules/app.til :doctest-run"
    if doc_test_header_value(header, "doctest-file") != "modules/app.til" {
        panic("tutorial doctest header regression: wrong file")
    }
    if doc_test_header_has_flag(header, "doctest-run").not() {
        panic("tutorial doctest header regression: missing run flag")
    }
    if doc_test_header_has_flag(header, "doctest") {
        panic("tutorial doctest header regression: file block mistaken for wrapped block")
    }

    File.remove_tree(TUTORIAL_DOCTEST_DIR)
    if mkdir_p(TUTORIAL_DOCTEST_DIR) != 0 {
        panic("could not create ", TUTORIAL_DOCTEST_DIR)
    }
    mut listing := ""
    result := run_cmd(listing, "git", "ls-files", "doc/tutorial/*.org")
    if result != 0 { panic("failed to list tutorial sources") }
    mut run_files := Vec(Str).new()
    mut pos : USize = 0
    while pos < listing.len() {
        line_end := doc_test_line_end(listing, pos)
        path := listing.substr(pos, line_end - pos).trim()
        if path.is_empty().not() {
            source := File.readfile(path)
            write_tutorial_file_blocks(path, source, run_files)
        }
        pos = doc_test_next_line_pos(listing, line_end)
    }
    return run_files
}

check_org_file_links := proc(path: Str, source: Str) {
    marker := "[[file:"
    parent := doc_test_parent_dir(path)
    mut pos : USize = 0
    while pos < source.len() {
        rest := source.substr(pos, source.len() - pos)
        rel_start := rest.find(marker)
        if rel_start < 0 { return }
        target_start := pos + rel_start.to_usize() + marker.len()
        target_rest := source.substr(target_start, source.len() - target_start)
        target_end := target_rest.find("]")
        if target_end < 0 { panic("unterminated file link in ", path) }
        mut target := target_rest.substr(0, target_end.to_usize())
        anchor := target.find("::")
        if anchor >= 0 { target = target.substr(0, anchor.to_usize()) }
        if target.is_empty() { panic("empty file link in ", path) }
        if File.is_absolute(target) {
            if File.exists(target).not() { panic("broken file link in ", path, ": ", target) }
        } else {
            resolved := format(parent, "/", target)
            if File.exists(resolved).not() { panic("broken file link in ", path, ": ", target) }
        }
        pos = target_start + target_end.to_usize() + 1
    }
}

check_handwritten_doc_links := proc() {
    mut listing := ""
    result := run_cmd(listing, "git", "ls-files", "doc/*.org")
    if result != 0 { panic("failed to list handwritten documentation") }
    mut pos : USize = 0
    while pos < listing.len() {
        line_end := doc_test_line_end(listing, pos)
        path := listing.substr(pos, line_end - pos).trim()
        if path.is_empty().not().and(path.starts_with("doc/gen/").not()) {
            source := File.readfile(path)
            check_org_file_links(path, source)
        }
        pos = doc_test_next_line_pos(listing, line_end)
    }
}

write_doc_doctests := proc(out_path: Str) {
    source_fixture := "/// #+begin_src til :doctest\n/// assert(true)\n/// #+end_src\n"
    org_fixture := "#+begin_src til :doctest\nassert(true)\n#+end_src\n"
    mut regression := Str.with_capacity(256)
    mut regression_count := append_doc_doctests(regression, "test/doc_fixture.til",
                                                 source_fixture, 0, true)
    if regression_count != 1 { panic("doctest extraction regression: wrong count") }
    if regression.contains("// doctest source: test/doc_fixture.til:1").not() { panic("doctest extraction regression: missing source location") }
    if regression.contains("assert(true)").not() { panic("doctest extraction regression: missing body") }
    regression_count = append_doc_doctests(regression, "doc/tutorial/fixture.org",
                                            org_fixture, regression_count, false)
    if regression_count != 2 { panic("org doctest extraction regression: wrong count") }
    if regression.contains("// doctest source: doc/tutorial/fixture.org:1").not() { panic("org doctest extraction regression: missing source location") }

    mut out := Str.with_capacity(4096)
    out.push_str("mode test\n\n")
    count := append_tracked_doc_doctests(out)
    if count == 0 { panic("no doc doctests found") }
    File.writefile(out_path, out)
}

// --- Data structures ---

BothData := struct {
    interp_ms := 0
    interp_ok := 0
    interp_mem := 0
    compile_ms := 0
    compile_ok := 0
    compile_mem := 0
    run_ms := 0
    run_ok := 0
    run_mem := 0
    output_match := 1
namespace:
    eq := func(a: BothData, b: BothData) returns Bool {
        return and(a.interp_ms.eq(b.interp_ms), a.interp_ok.eq(b.interp_ok),
                   a.interp_mem.eq(b.interp_mem),
                   a.compile_ms.eq(b.compile_ms),
                   a.compile_ok.eq(b.compile_ok),
                   a.compile_mem.eq(b.compile_mem),
                   a.run_ms.eq(b.run_ms),
                   a.run_ok.eq(b.run_ok),
                   a.run_mem.eq(b.run_mem),
                   a.output_match.eq(b.output_match))
    }
    to_str := func(_self: BothData) returns Str { return "BothData" }
}

TestKind := enum { Both: BothData, Single, Count }

CountCheck := struct {
    needle := ""
    expected_count := 0
}

Test := struct {
    label := ""
    cmd := ""
    outfile := ""
    category := ""
    kind := TestKind.Single
    // scheduling
    pid := 0
    start_ms := 0
    // common results
    ok := 0
    ms := 0
    mem := 0
    // both config flags
    has_interp := 0
    has_run := 0
}

Slot := struct {
    test_idx : USize = 0
    pid := 0
    start_ms := 0
}

// --- Output helpers ---

print_test_result := proc(t: Test) {
    switch t.kind {
    case .Both(md):
        mut line := pad_right(t.label, 42)
        if t.has_interp == 1 { line = format(line, "interp: ", pad_right(ms_to_str(md.interp_ms), 9)) }
        if t.has_run == 1 { line = format(line, "compile: ", pad_right(ms_to_str(md.compile_ms), 9), "run: ", pad_right(ms_to_str(md.run_ms), 9)) }
        if md.output_match == 0 { line = format(line, " MISMATCH") }
        println(line)
    case:
        if t.ok == 1 {
            println(pad_right(t.label, 42), ms_to_str(t.ms))
        }
    }
}

// --- Generated-C collision check ---
//
// A compiling command writes a .c file, and `-c` decides where: without it
// the path is gen/til/<basename>.c, derived from the .til. Two rows built
// from ONE .til therefore share that path, and rows run in parallel -- so
// one process rewrites the generated C while the other compiles it.
//
// The wreckage does not look like a test problem. The reflect rows that hit
// this reported a function cut in half mid-definition and every symbol after
// it "declared but never defined": a broken compiler, from a race between
// two tests. Registration is where it is cheap to notice, so the whole table
// is checked before anything runs.
//
// What is checked is the plain C path and only that. A row carrying
// `--target=` writes something else entirely (templeos .HC, jvm .java under
// gen/jvm/), and a row that spells its own -c or -o has already answered the
// question. Those are skipped rather than guessed at: predicting the
// artifact of every backend, from a command line, is how a guard starts
// crying wolf -- the first draft of this one flagged six honest rows.

// The token a shell word carries, minus the quoting the commands add around
// paths (`'test/x.til'`).
priv unquoted := func(tok: Str) returns Str {
    // Trim by index and clone ONCE. Reassigning `t = t.substr(..)` drops the
    // buffer the view it just made points into -- the first draft did, and
    // reported collisions between two files whose names were freed memory.
    mut start : USize = 0
    mut end : USize = tok.len()
    if tok.starts_with("'") { start = 1 }
    if end.gt(start).and(tok.ends_with("'")) { end = end - 1 }
    return tok.substr(start, end - start).clone()
}

// A row that asserts the compiler REFUSED writes no C: mode rejections
// ("mode theme does not support 'build'", "cannot run a library") are
// answered before codegen, so such a row cannot collide with anything and
// must not be paired. The runner spec in front of the `--` says so: a
// `single` row carries its expected exit, and a `count` row asserting an
// "error:" needle is asserting a refusal. This is the one judgement call in
// the check -- a row that asserts an error AND still writes C would be
// skipped -- and it is what keeps the check from flagging three honest rows
// that cannot be fixed by spelling -c (the theme one is rejected for
// carrying -c at all).
priv row_expects_refusal := func(cmd: Str) returns Bool {
    pos := cmd.find(" -- ")
    if pos < 0 { return false }
    spec := cmd.substr(0, pos.to_usize())
    if spec.find("error:") >= 0 { return true }
    single_at := spec.find(" single ")
    if single_at < 0 { return false }
    // ... single <label> <expected_exit> ...
    rest_start := single_at.to_usize() + 8
    rest := spec.substr(rest_start, spec.len() - rest_start)
    sp := rest.find(" ")
    if sp < 0 { return false }
    exit_start := sp.to_usize() + 1
    tail := rest.substr(exit_start, rest.len() - exit_start)
    mut exit_tok := tail.clone()
    sp2 := tail.find(" ")
    if sp2 >= 0 { exit_tok = tail.substr(0, sp2.to_usize()) }
    return exit_tok.eq("0").not()
}

// The til command a row runs, with the runner's own arguments stripped.
// Needles live before the `--` separator and are arbitrary text -- one of
// them is "error: -c is not supported with --target=jvm", which a scan of
// the whole string reads as a -c flag.
priv til_command_of := func(cmd: Str) returns Str {
    pos := cmd.find(" -- ")
    if pos < 0 { return cmd.clone() }
    start := pos.to_usize() + 4
    return cmd.substr(start, cmd.len() - start)
}

// The .til sources a command compiles to plain C without naming the output.
// Those are the ones whose generated-C path is derived, and so shareable.
priv collect_default_c_sources := func(cmd: Str, mut out: Vec(Str)) {
    // Bound, not inlined into the split: the parts are VIEWS into this
    // buffer, and a temporary would be freed before the loop reads them.
    til_cmd := til_command_of(cmd)
    toks := til_cmd.split(" ")
    mut compiles := false
    mut overridden := false
    mut retargeted := false
    mut skip_next := false
    for ti in 0..toks.len() {
        tok := unquoted(toks[ti])
        if skip_next {
            skip_next = false
            continue
        }
        if tok == "-c" {
            overridden = true
            skip_next = true
            continue
        }
        // `-o` names the BINARY for a C build -- `-o bin/c/foo` leaves the
        // generated C exactly where it was, which is how the reflect rows
        // collided while looking distinct. It DOES name the artifact for the
        // backends whose output is the file itself (`-o gen/til/x.el`), and
        // those spell an extension; a binary path has none.
        if tok == "-o" {
            skip_next = true
            if ti + 1 < toks.len() {
                nxt := unquoted(toks[ti + 1])
                if test_basename(nxt).find(".") >= 0 { overridden = true }
            }
            continue
        }
        if tok.starts_with("--target") {
            retargeted = true
            continue
        }
        // Any other flag, including the `--flag=path.til` shape
        // (--extra-modes=examples/custom_modes.til): a path handed to a flag
        // is not the source being compiled.
        if tok.starts_with("-") { continue }
        // A new invocation starts at every '&&' the suite chains with.
        if tok.eq("&&").or(tok.eq("'&&'")).or(tok.eq("'('")).or(tok.eq("')'")) {
            compiles = false
            overridden = false
            retargeted = false
            continue
        }
        // `both` is the runner's own compiling subcommand; interpret / ast /
        // doc write no C at all.
        if tok.eq("run").or(tok.eq("build")).or(tok.eq("translate")).or(tok.eq("test")).or(tok.eq("both")) {
            compiles = true
            continue
        }
        if tok.eq("interpret").or(tok.eq("ast")).or(tok.eq("doc")) {
            compiles = false
            continue
        }
        if tok.ends_with(".til") {
            if compiles.and(overridden.not()).and(retargeted.not()) {
                out.push(own tok.clone())
            }
            // One .til per invocation: what follows it is arguments.
            compiles = false
        }
    }
}

// Refuse a table where two rows compile one source to the same derived C
// path. Runs before the first row is spawned, so the report names both rows
// instead of leaving a half-written .c for the C compiler to trip over.
priv check_gen_c_collisions := proc(tests: Vec(Test)) returns I64 {
    mut sources := Vec(Str).new()
    mut owners := Vec(Str).new()
    mut clashes := 0
    for t : Test in tests {
        if row_expects_refusal(t.cmd) { continue }
        mut mine := Vec(Str).new()
        collect_default_c_sources(t.cmd, mine)
        for src : Str in mine {
            mut seen := -1
            for i in 0..sources.len() {
                if sources[i] == src { seen = i.to_i64() }
            }
            if seen >= 0 {
                println("FAIL: tests '", owners[seen.to_usize()], "' and '", t.label,
                    "' both compile ", src, " without naming an output, so both write gen/til/",
                    test_basename(src), ".<ext>")
                println("  note: give each compiling row its own '-c <path>', or check several",
                    " needles against ONE command with add_counts")
                clashes = clashes + 1
            } else {
                sources.push(own src.clone())
                owners.push(own t.label.clone())
            }
        }
    }
    return clashes
}

// --- Registration helpers ---

add_both := func(mut tests: Vec(Test), file: Str, flags: Str) {
    bn := test_basename(file)
    tests.push(own Test(
        label = file.clone(),
        cmd = format(RUNNER, " both '", file, "'", flags),
        outfile = format("gen/out/results/", bn, ".txt"),
        category = "both",
        kind = TestKind.Both(BothData()),
        has_interp = 1, has_run = 1
    ))
}

add_single := func(mut tests: Vec(Test), label: Str, category: Str,
    expected_exit: I64, expected_out: Str, cmd_suffix: Str) {
        mut runner_cmd := format(RUNNER, " single ", label, " ", expected_exit.to_str())
        if expected_out.len() > 0 {
            runner_cmd = format(runner_cmd, " ", expected_out, REGEN)
        }
        runner_cmd = format(runner_cmd, " -- ", cmd_suffix)
        tests.push(own Test(
            label = label.clone(),
            cmd = runner_cmd,
            outfile = format("gen/out/results/", label, ".txt"),
            category = category.clone(),
            kind = TestKind.Single
        ))
    }

add_count := func(mut tests: Vec(Test), label: Str, category: Str,
    needle: Str, expected_count: I64, cmd_suffix: Str) {
        quoted_needle := needle.replace("'", "'\\''")
        runner_cmd := format(RUNNER, " count ", label, " '", quoted_needle, "' ", expected_count.to_str(), " -- ", cmd_suffix)
        tests.push(own Test(
            label = label.clone(),
            cmd = runner_cmd,
            outfile = format("gen/out/results/", label, ".txt"),
            category = category.clone(),
            kind = TestKind.Count
        ))
    }

add_counts := func(mut tests: Vec(Test), label: Str, category: Str,
    cmd_suffix: Str, checks: ..CountCheck) {
        if checks.len() == 0 { panic("add_counts requires at least one check") }
        mut runner_cmd := format(RUNNER, " count ", label)
        for i in 0..checks.len() {
            ref check : CountCheck = checks[i]
            quoted_needle := check.needle.replace("'", "'\\''")
            runner_cmd = format(runner_cmd, " '", quoted_needle, "' ", check.expected_count.to_str())
        }
        runner_cmd = format(runner_cmd, " -- ", cmd_suffix)
        tests.push(own Test(
            label = label.clone(),
            cmd = runner_cmd,
            outfile = format("gen/out/results/", label, ".txt"),
            category = category.clone(),
            kind = TestKind.Count
        ))
    }

add_cli_pair := func(mut tests: Vec(Test), name: Str, file: Str,
    cli_args: Str, expected_exit: I64, expected_out: Str,
    til: Str, asan_flag: Str) {
        mut cmd_i := format(til, " interpret ", file)
        if cli_args.len() > 0 { cmd_i = format(cmd_i, " ", cli_args) }
        add_single(tests, format(name, "_i"), "cli", expected_exit, expected_out, cmd_i)
        mut cmd_r := format(til, " run", asan_flag, " -o bin/c/", name,
            " -c gen/c/", name, ".c ",
            file)
        if cli_args.len() > 0 { cmd_r = format(cmd_r, " ", cli_args) }
        add_single(tests, format(name, "_r"), "cli", expected_exit, expected_out, cmd_r)
    }

// --- Blind parallel runner ---

run_all_parallel := proc(mut tests: Vec(Test), j: USize, mut fail: I64, mut suite_end_ms: I64) {
    mut next : USize = 0
    mut active : USize = 0

    mut slots := Array(Slot).new(j)
    mut si : USize = 0
    while si < j {
        slots[si] = Slot()
        si++
    }

    // Spawn initial batch
    si = 0
    while si.lt(j).and(next.lt(tests.len())) {
        ref t : Test = tests[next]
        cmd := format(t.cmd, " > ", t.outfile, " 2>&1")
        start := clock_ms()
        pid := spawn_cmd(cmd)
        slots[si] = Slot(test_idx = next, pid = pid, start_ms = start)
        active++
        next++
        si++
    }

    // Poll loop
    while active > 0 {
        mut i : USize = 0
        while i < j {
            ref mut slot : Slot = slots[i]
            if slot.pid > 0 {
                status := check_cmd_status(slot.pid)
                if status != -1 {
                    ref mut t : Test = tests[slot.test_idx]
                    runner_out := File.readfile(t.outfile)

                    // Find RESULT line. #395: its ABSENCE is a failure, not a
                    // zero to carry quietly. test_runner prints the line on
                    // every path it takes, so no line means it never ran --
                    // which is what a shell operator in a registered command
                    // does, by taking the redirect (and the rest of the work)
                    // away from it. The old silence let one such test sit
                    // uncounted for as long as it existed, visible only as a
                    // "Passed: N-1/N" over the words "all tests passed".
                    mut result_line := ""
                    result_pos := runner_out.rfind("RESULT ")
                    if result_pos >= 0 {
                        result_pos_u : USize = result_pos.to_usize()
                        result_line = runner_out.substr(result_pos_u,
                            runner_out.len() - result_pos_u)
                    } else {
                        println("FAIL: ", t.label, " produced no RESULT line",
                            " -- test_runner did not run it (a shell operator",
                            " in the registered command takes the redirect)")
                        fail = 1
                    }

                    // Parse common fields
                    t.ok = parse_kv(result_line, "ok")
                    t.ms = parse_kv(result_line, "ms")
                    t.mem = parse_kv(result_line, "mem")
                    // Parse both-specific fields into payload
                    switch t.kind {
                    case .Both(md):
                        md.interp_ms = parse_kv(result_line, "interp_ms")
                        md.interp_ok = parse_kv(result_line, "interp_ok")
                        md.interp_mem = parse_kv(result_line, "interp_mem")
                        md.compile_ms = parse_kv(result_line, "compile_ms")
                        md.compile_ok = parse_kv(result_line, "compile_ok")
                        md.compile_mem = parse_kv(result_line, "compile_mem")
                        md.run_ms = parse_kv(result_line, "run_ms")
                        md.run_ok = parse_kv(result_line, "run_ok")
                        md.run_mem = parse_kv(result_line, "run_mem")
                        md.output_match = parse_kv(result_line, "match")
                        t.kind = TestKind.Both(md.clone())
                    case:
                    }

                    print_test_result(t)

                    // Suite wall excludes the self-translate benchmark: record
                    // when each non-"self" test finishes; the last one marks the
                    // end of the real suite (self runs in parallel past it).
                    if t.category != "self" { suite_end_ms = clock_ms() }

                    if status != 0 {
                        // Everything the runner said, minus the
                        // machine-readable RESULT line already parsed
                        // above. Relaying ONLY the FAIL/MISMATCH lines
                        // dropped the one thing a reader needs: the
                        // block print_captured_err writes -- the til
                        // panic, the ASAN report, the cc error, the
                        // test's own assertion dump. A failure that
                        // reproduces locally survives that filter; a
                        // CI-only one does not, and `FAIL: repl_pty
                        // exit=1 expected=0` with no second line is all
                        // the mac jobs could say for twenty red runs.
                        runner_lines := runner_out.split(NL)
                        mut li : USize = 0
                        while li < runner_lines.len() {
                            ref ln : Str = runner_lines[li]
                            if ln.starts_with("RESULT ").not() {
                                println(ln)
                            }
                            li++
                        }
                        fail = 1
                    }

                    active--
                    slot.pid = 0

                    if next < tests.len() {
                        ref nt : Test = tests[next]
                        cmd := format(nt.cmd, " > ", nt.outfile, " 2>&1")
                        start := clock_ms()
                        pid := spawn_cmd(cmd)
                        slots[i] = Slot(test_idx = next, pid = pid, start_ms = start)
                        active++
                        next++
                    }
                }
            }
            i++
        }
        if active > 0 {
            sleep_ms(10)
        }
    }
}

// --- Main ---

main := proc(args: ..Str) {
    wall_start := clock_ms()

    // Parse args: -jN, -no-interp, -no-run, --no-gui, --til-bin <path>, --asan
    mut j : USize = get_thread_count().to_usize()
    mut en_interp := 1
    mut en_run := 1
    mut en_gui := 1
    mut til_bin := TIL
    mut asan := 0
    mut i : USize = 0
    while i < args.len() {
        ref arg : Str = args[i]
        if arg.starts_with("-j") {
            j = arg.substr(2, arg.len() - 2).to_usize()
            if j < 1 { j = 1 }
        }
        if arg == "-no-interp" { en_interp = 0 }
        if arg == "-no-run" { en_run = 0 }
        if arg == "--no-gui" { en_gui = 0 }
        if arg.eq("--til-bin").and(i.add(1).lt(args.len())) {
            i++
            ref val : Str = args[i]
            til_bin = val.clone()
        }
        if arg == "--asan" { asan = 1 }
        if arg == "--regen" { REGEN = " --regen" }
        i++
    }

    // When --asan is set, asan_flag is spliced after "build"/"run"/"test"
    // so the underlying `til build` invocation produces an ASAN-instrumented
    // binary. Compiled binaries built this way run under ASAN and report
    // their own leaks when executed.
    mut asan_flag := ""
    if asan == 1 { asan_flag = " --asan" }

    mut fail := 0

    // Create output directories
    run("mkdir -p gen/out/interp gen/out/run gen/out/results gen/out/single tmp")
    check_handwritten_doc_links()

    mut tests := Vec(Test).new()
    mut flags := mode_flags(en_interp, en_run, asan_flag)
    if til_bin != TIL { flags = format(" --til-bin ", til_bin, flags) }

    // Self-translate: bin/til translate src/til.til -- the compiler translating
    // its own source, the largest input it handles and the single slowest job.
    // Registered FIRST so run_all_parallel spawns it in the first batch; it then
    // holds one of the j parallel slots for the whole run (usually the long
    // pole). Its time is collected via the "self" category into self_ms and is
    // deliberately EXCLUDED from wall_ms (run_all_parallel marks the suite end
    // from the last non-"self" test), so the benchmark does not inflate wall.
    // Exit must be 0: the compiler has to be able to translate itself.
    //
    // Issue #101: it is also the determinism guard, and ONE translation buys
    // both halves of it, so self_ms stays a single self-translate. The
    // comparison is against the pass-1 boot/ artifacts the build just
    // produced, which were written by a DIFFERENT compiler binary in a
    // DIFFERENT process (til_boot under `make test`, the self-applied
    // bin/til under two_pass):
    //   - REPEATABILITY falls out of that. Byte-identical output from two
    //     processes is exactly the property a second run of this compiler
    //     would test, and it tests it across a process boundary rather than
    //     within one. Every synthesized name (`hoisted__<T>_<N>`,
    //     `_lzr_<N>`, `_sw_<T>_<N>`, ...) comes from a Context counter
    //     advanced by an ordered AST/Vec walk, so a fresh LoadedProgram has
    //     to reproduce the bytes. This used to be checked by hand with
    //     occasional self-build diffs (#77).
    //   - SELF-APPLICATION is the other half: the compiler BUILT from pass
    //     1's output must re-emit pass 1's bytes -- the bootstrap fixed
    //     point. Both artifacts come from the same HEAD, which matters
    //     because VERSION embeds the current git commit.
    // A second translation would only re-test one process against itself,
    // for the price of doubling the suite's single slowest job.
    // A unique tmp/ path so the parallel suite cannot race another
    // translation, and so gen/til/til.c (pass 1's artifact) is left alone.
    // The '&&' tokens are quoted for the OUTER shell: test_runner joins its
    // post-`--` argv with spaces and re-runs the result under sh, which is
    // where they take effect.
    add_single(tests, "self_translate", "self", 0, "",
        format(til_bin, " translate -c tmp/self_det.c src/til.til",
            " '&&' cmp tmp/self_det.c boot/til.c",
            " '&&' cmp tmp/self_det_forward.h boot/til_forward.h"))

    // The two REPL drivers, registered EARLY for the same reason
    // self_translate is: run_all_parallel dispatches strictly in
    // registration order, so a long job listed last runs with nothing left
    // to overlap it and its whole duration lands on wall_ms. Both of these
    // are long in ELAPSED time while costing almost no CPU -- they spend it
    // waiting on a piped or pseudo-terminal REPL -- so started early they
    // hide entirely behind the rest of the suite. (Their durations still
    // sum into cli_ms, which measures elapsed time, not work.)
    //
    // repl_help drives bin/til's REPL over a piped script and self-checks,
    // exiting 0 on PASS / 1 on FAIL. It used to be a separate hand-run
    // `make test_repl_help` target outside the suite, so the suite could
    // pass green while the REPL was broken (it did, twice, during the
    // doc.til core->std move). Registered here it runs wherever bin/tests
    // runs -- make test, linux CI, and the mac jobs that invoke bin/tests
    // directly. Exit-code-only check (no expected_out).
    add_single(tests, "repl_help", "cli", 0, "", format(TIL, " run test/repl_help.til"))

    // #332: the REPL line editor's real-terminal half. Drives bin/til
    // through a pseudo-terminal with actual escape/control bytes and an
    // isolated XDG_STATE_HOME, and self-checks like repl_help does. The
    // pure state machine is test/repl_editor.til, in the both-backend list;
    // neither is a hand-run target, so the feature cannot regress behind
    // one again.
    add_single(tests, "repl_pty", "cli", 0, "", format(TIL, " run test/repl_pty.til"))

    // #347: the console half of the same editor, which had never been
    // RUN on any machine. The real session happens on the windows runner
    // (the workflow's "REPL console session on windows" step, against the
    // cross-built .exe); here it reports SKIP -- and in doing so keeps
    // test/wincon.c compiling and linking on every host, so the driver
    // cannot rot between windows runs.
    add_single(tests, "repl_wincon", "cli", 0, "",
        format(TIL, " run test/repl_wincon.til ", TIL))

    // `til install` end to end: install the compiler under tmp/ and
    // build a program with the RESULT, from another directory, against
    // the installed std and C runtime. Nothing covered install before,
    // which is how it stayed broken for two weeks after lib/ moved to
    // examples/lib/ and the installer kept copying the old path.
    add_single(tests, "install", "build", 0, "", format(TIL, " run test/install.til"))

    // #90: independently generated libraries own separate C namespaces.
    // The driver checks combined headers, static/shared links, and both Til bindings.
    add_single(tests, "library_namespace", "build", 0, "",
        format(TIL, " run test/library_namespace.til"))

    // The non-zero half of the value-returning-main contract: `return 7`
    // is process exit status 7 on both backends. The compiled `int main`
    // always did this; the interpreter used to discard the value and
    // exit 0 (behind the panic that test/main_return.til, in the both
    // list, pins -- a both entry demands exit 0, so the non-zero case
    // lives here as expected-exit singles, the same shape as the gui
    // tests' expected 124).
    add_single(tests, "main_return7_interp", "cli", 7, "",
        format(til_bin, " test/main_return7.til one two"))
    add_single(tests, "main_return7_run", "cli", 7, "",
        format(til_bin, " build", asan_flag, " -o bin/main_return7 test/main_return7.til '&&' bin/main_return7 one two"))

    // Issue #343: a Str view reaching a C string parameter must die at the
    // boundary, on BOTH backends and with the same message -- the compiled
    // TIL_CSTR macro and the interpreter's FFI marshalling test the same
    // byte. `count` rather than expected-exit singles because what matters
    // is WHICH failure fired: an exit 1 could be any panic, while the
    // message appearing exactly once says the terminator check is what
    // stopped it. The safe half (literal / owned / clone) rides
    // test/ext_libc.til, a both entry that must stay green.
    cstr_view_msg := "Str is not NUL-terminated"
    add_count(tests, "cstr_view_interp", "cli", cstr_view_msg, 1,
        format(til_bin, " test/cstr_view.til"))
    add_count(tests, "cstr_view_run", "cli", cstr_view_msg, 1,
        format(til_bin, " build", asan_flag, " -o bin/cstr_view test/cstr_view.til '&&' bin/cstr_view"))

    // Cmd's argv round trip (issue #349): spawn test/echo_argv.til's
    // binary through Cmd with the argument shapes a quoted command
    // line gets wrong and compare what the child's C runtime parsed.
    // This linux leg pins the driver and the execvp path; the SAME two
    // programs cross-compile to .exes in the windows-x64 host CI job
    // and run on a real windows runner, where they are the only
    // execution of win_quote_arg / CreateProcessA / win_env_block.
    // TIL_QUOTE_CASE feeds the case-insensitive env displacement probe.
    add_single(tests, "win_quoting", "build", 0, "",
        format(til_bin, " build", asan_flag, " test/echo_argv.til '&&' ",
            til_bin, " build", asan_flag, " -o bin/win_quoting test/win_quoting.til '&&' ",
            "TIL_QUOTE_CASE=parent bin/win_quoting bin/echo_argv"))

    // Issue #302 stage 0: the garbager decision-audit golden. Translating
    // the frozen fixture with TIL_GC_AUDIT set dumps the asap pass's
    // per-binding decisions and destructor sites; the byte-exact compare
    // against test/gc_audit.expected turns any decision change into a
    // reviewable diff. Regeneration recipe in test/gc_audit.til's header.
    add_single(tests, "gc_audit", "self", 0, "test/gc_audit.expected",
        format("TIL_GC_AUDIT=test/gc_audit.til ", til_bin, " translate test/gc_audit.til"))

    // #151: Linux performs the frontend and emits HolyC; TempleOS is the
    // compiler/runtime. The first accepted subset is the fully lowered shape
    // of examples/hello_script.til, and build must stop before looking for a
    // host `holyc` executable. Other modes fail explicitly rather than
    // falling through to C emission.
    add_single(tests, "holyc_hello_translate", "build", 0, "test/hello_templeos.expected",
        format(til_bin, " translate --target=templeos examples/hello_script.til '&&' cat gen/til/hello_script.HC"))
    add_single(tests, "holyc_fizzbuzz_translate", "build", 0, "test/fizzbuzz_templeos.expected",
        format(til_bin, " translate --target=templeos examples/fizzbuzz.til '&&' cat gen/til/fizzbuzz.HC"))
    add_single(tests, "holyc_imported_direct_calls_translate", "build", 0, "test/templeos_calls.expected",
        format(til_bin, " translate --target=templeos examples/templeos_calls.til '&&' cat gen/til/templeos_calls.HC"))
    add_single(tests, "holyc_scalar_semantics_translate", "build", 0, "test/templeos_scalars.expected",
        format(til_bin, " translate --target=templeos examples/templeos_scalars.til '&&' cat gen/til/templeos_scalars.HC"))
    add_single(tests, "holyc_shared_raw_alloc_translate", "build", 0, "test/templeos_raw_alloc.expected",
        format(til_bin, " translate --target=templeos -c gen/c/templeos_raw_alloc.HC test/script_raw_alloc.til '&&' cat gen/c/templeos_raw_alloc.HC"))
    add_single(tests, "holyc_shared_dynamic_free_translate", "build", 0, "test/templeos_dynamic_free.expected",
        format(til_bin, " translate --target=templeos -c gen/c/templeos_dynamic_free.HC test/script_dynamic_free.til '&&' cat gen/c/templeos_dynamic_free.HC"))
    add_single(tests, "holyc_shared_str_runtime_translate", "build", 0, "test/templeos_str_runtime.expected",
        format(til_bin, " translate --target=templeos -c gen/c/templeos_str_runtime.HC test/script_str_runtime.til '&&' cat gen/c/templeos_str_runtime.HC"))
    add_single(tests, "holyc_rejects_continue", "build", 1, "test/holyc_continue.expected",
        format(til_bin, " translate --target=templeos -c gen/c/holyc_continue.HC test/holyc_continue.til"))
    add_single(tests, "holyc_rejects_f64", "build", 1, "test/holyc_f64.expected",
        format(til_bin, " translate --target=templeos -c gen/c/holyc_f64.HC test/holyc_f64.til"))
    add_single(tests, "holyc_percent_is_data", "build", 0, "test/holyc_percent.expected",
        format(til_bin, " translate --target=templeos -c gen/c/holyc_percent.HC test/holyc_percent.til '&&' cat gen/c/holyc_percent.HC"))
    add_single(tests, "holyc_rejects_unsupported_mode", "build", 1, "test/holyc_mode.expected",
        format(til_bin, " translate --target=templeos -c gen/c/hello_pure.HC examples/hello_pure.til"))
    add_single(tests, "holyc_rejects_unsupported_shape", "build", 1, "test/holyc_shape.expected",
        format(til_bin, " translate --target=templeos -c gen/c/holyc_shape.HC test/holyc_unsupported.til"))
    add_single(tests, "holyc_counted_nul", "build", 0, "test/holyc_nul.expected",
        format(til_bin, " translate --target=templeos -c gen/c/holyc_nul.HC test/holyc_nul.til '&&' cat gen/c/holyc_nul.HC"))
    add_single(tests, "holyc_rejects_link_flags", "build", 1, "test/holyc_link.expected",
        format(til_bin, " translate --target=templeos -c gen/c/holyc_link.HC examples/hello_script.til -lunsupported"))
    add_single(tests, "holyc_build_requires_guest", "build", 1, "test/holyc_build.expected",
        format(til_bin, " build --target=templeos -c gen/c/hello_build.HC examples/hello_script.til"))
    add_single(tests, "templeos_target_width", "build", 0, "",
        format(til_bin, " interpret test/templeos_target.til"))
    // #379: needs_main modes require a proc entrypoint even when its body is
    // pure. Ordinary procs retain the existing purity diagnostic.
    add_single(tests, "entrypoint_no_proc_cli", "typer", 0, "",
        format(til_bin, " translate -c gen/c/entrypoint_no_proc_cli.c test/entrypoint_no_proc_cli.til"))
    add_single(tests, "entrypoint_no_proc_gui", "typer", 0, "",
        format(til_bin, " translate -c gen/c/entrypoint_no_proc_gui.c test/entrypoint_no_proc_gui.til"))
    add_count(tests, "ordinary_proc_without_proc_call", "typer",
        "proc has no proc/ext_proc calls; should be a func", 1,
        format(til_bin, " interpret test/proc_without_proc_call.til"))

    // #375 Stages B-F: JVM owns a distinct Java output tree, emits the lowered
    // entrypoint, scalar slots, aggregate classes, virtual-heap calls and typed
    // function carriers, and rejects C-only flags. None invokes a JDK, so the
    // default suite remains JDK-free; the CLI pairs pin the same corpora on
    // interpreter/C.
    add_single(tests, "jvm_skeleton", "build", 0, "test/jvm_skeleton.expected",
        format("'(' ", til_bin, " translate --target=jvm examples/hello_script.til '&&' cat gen/jvm/hello_script/src/til/generated/p_hello_x5fscript/Main.java ')'"))
    add_count(tests, "jvm_sources_include_runtime", "build", "src/jvm/TilRuntime.java", 1,
        format("'(' ", til_bin, " translate --target=jvm test/jvm_unsupported.til '&&' cat gen/jvm/jvm_unsupported/sources.args ')'"))
    add_count(tests, "jvm_direct_call_source", "build", "f_p_show", 2,
        format("'(' ", til_bin, " translate --target=jvm test/jvm_scalar_smoke.til '&&' cat gen/jvm/jvm_scalar_smoke/src/til/generated/p_jvm_x5fscalar_x5fsmoke/Unit_p_test_x2fjvm_x5fscalar_x5fsmoke_x2etil.java '&&' cat gen/jvm/jvm_scalar_smoke/src/til/generated/p_jvm_x5fscalar_x5fsmoke/Main.java ')'"))
    add_count(tests, "jvm_stage_d_cells", "build", "TilRuntime.I64Cell", 6,
        format("'(' ", til_bin, " translate --target=jvm test/jvm_stage_d.til '&&' cat gen/jvm/jvm_stage_d/src/til/generated/p_jvm_x5fstage_x5fd/*.java ')'"))
    add_cli_pair(tests, "jvm_stage_d", "test/jvm_stage_d.til", "", 0,
        "test/jvm_stage_d.expected", til_bin, asan_flag)
    add_cli_pair(tests, "jvm_stage_e", "test/jvm_stage_e.til", "", 0,
        "test/jvm_stage_e.expected", til_bin, asan_flag)
    add_count(tests, "jvm_stage_e_aggregate_source", "build", "final class S_p_JvmPoint", 1,
        format("'(' ", til_bin, " translate --target=jvm test/jvm_stage_e.til '&&' cat gen/jvm/jvm_stage_e/src/til/generated/p_jvm_x5fstage_x5fe/S_p_JvmPoint.java ')'"))
    add_count(tests, "jvm_stage_e_heap_source", "build", "TilRuntime.ptrAdd", 3,
        format("'(' ", til_bin, " translate --target=jvm test/script_raw_alloc.til '&&' cat gen/jvm/script_raw_alloc/src/til/generated/p_script_x5fraw_x5falloc/Main.java ')'"))
    add_cli_pair(tests, "jvm_stage_f", "test/jvm_stage_f.til", "", 0,
        "test/jvm_stage_f.expected", til_bin, asan_flag)
    add_count(tests, "jvm_stage_f_funcsig_source", "build", "@FunctionalInterface", 3,
        format("'(' ", til_bin, " translate --target=jvm test/jvm_stage_f.til '&&' cat gen/jvm/jvm_stage_f/src/til/generated/p_jvm_x5fstage_x5ff/F_*.java ')'"))
    add_count(tests, "jvm_rejects_c_path", "build", "error: -c is not supported with --target=jvm", 1,
        format(til_bin, " translate --target=jvm -c gen/jvm/nope.java examples/hello_script.til"))
