mode lib

import("ast")
import("bool")
import("dyn")
import("numbers")
import("str")

priv map_store_key := macro(K: Type, V: Type) returns FuncDef {
    if type_arg_is_ref(K) {
        return func(mut self: Map(K, V), i: USize, key: K) { self.keys.unsafe_set(i, key) }
    } else {
        return func(mut self: Map(K, V), i: USize, key: K) {
            mut copy: K = K.clone(key)
            adopt(K, self.key_slot(i), own copy)
        }
    }
}

priv map_set := macro(K: Type, V: Type) returns FuncDef {
    if type_arg_is_ref(V) {
        return func(mut self: Map(K, V), key: K, val: V) {
            mut lo: USize = 0
            mut hi := self.keys.count
            mut found := false
            while lo < hi {
                mid := lo + (hi - lo) / 2
                c := K.cmp(self.keys.unsafe_get(mid), key)
                if c < 0 { lo = mid + 1 }
                else { if c > 0 { hi = mid } else { found = true; lo = mid; hi = mid } }
            }
            if found { self.values.unsafe_set(lo, val) }
            else {
                self.open_slot(lo)
                self.store_key(lo, key)
                self.values.unsafe_set(lo, val)
            }
        }
    } else {
        return func(mut self: Map(K, V), key: K, own val: V) {
            mut lo: USize = 0
            mut hi := self.keys.count
            mut found := false
            while lo < hi {
                mid := lo + (hi - lo) / 2
                c := K.cmp(self.keys.unsafe_get(mid), key)
                if c < 0 { lo = mid + 1 }
                else { if c > 0 { hi = mid } else { found = true; lo = mid; hi = mid } }
            }
            if found { self.values.unsafe_set(lo, own val) }
            else {
                self.open_slot(lo)
                self.store_key(lo, key)
                adopt(V, self.value_slot(lo), own val)
            }
        }
    }
}

/// Ordered map from typed keys to typed values.
Map := struct<K: Type, V: Type> {
    keys : Vec(K)
    values : Vec(V)

namespace:
    /// Create an empty Map of the types provided for the key and values respectively.
    /// The key type must implement ~cmp~.
    new := func() returns Map(K, V) {
        return Map(K, V)(keys = Vec(K).new(), values = Vec(V).new())
    }

    /// Create an empty Map pre-sized for ~n~ entries, so inserting up to
    /// ~n~ reallocs neither backing Vec (Vec.with_capacity's
    /// counterpart). n=0 behaves like new(): lazy-empty, no allocation.
    with_capacity := func(n: USize) returns Map(K, V) {
        return Map(K, V)(keys = Vec(K).with_capacity(n),
                         values = Vec(V).with_capacity(n))
    }

    len := func(self: Map(K, V)) returns USize { return self.keys.count }

    /// Drop all live keys and values but keep the allocated storage so the Map can be reused.
    clear := func(mut self: Map(K, V)) {
        self.keys.clear()
        self.values.clear()
    }

    /// True if a value exists for the given key.
    has := func(self: Map(K, V), key: K) returns Bool {
        mut lo : USize = 0
        mut hi : USize = self.keys.count
        while lo < hi {
            mid : USize = lo.add(hi.sub(lo) / 2)
            c : I64 = K.cmp(self.keys.unsafe_get(mid), key)
            if c < 0 { lo = mid + 1 }
            else {
                if c > 0 { hi = mid }
                else { return true }
            }
        }
        return false
    }

    /// Return a ref to the value for ~key~. Throws KeyNotFound if
    /// ~key~ is absent; call as ~map.get(k)!~ (or ~map[k]~) to panic
    /// on a missing key.
    get := func(self: Map(K, V), key: K) returns ref V throws KeyNotFound {
        mut lo : USize = 0
        mut hi : USize = self.keys.count
        while lo < hi {
            mid : USize = lo.add(hi.sub(lo) / 2)
            c : I64 = K.cmp(self.keys.unsafe_get(mid), key)
            if c < 0 { lo = mid + 1 }
            else {
                if c > 0 { hi = mid }
                else { return self.values.unsafe_get(mid) }
            }
        }
        throw KeyNotFound()
    }

    priv key_size := func() returns USize {
        if type_arg_is_ref(K).and(type_arg_is_interface(K).not()) { return UPtr.size() }
        return K.size()
    }
    priv value_size := func() returns USize {
        if type_arg_is_ref(V).and(type_arg_is_interface(V).not()) { return UPtr.size() }
        return V.size()
    }
    priv key_slot := func(self: Map(K, V), i: USize) returns ref Dynamic {
        return ptr_add(self.keys.data, i.to_uptr().mul(Map(K, V).key_size().to_uptr()))
    }
    priv value_slot := func(self: Map(K, V), i: USize) returns ref Dynamic {
        return ptr_add(self.values.data, i.to_uptr().mul(Map(K, V).value_size().to_uptr()))
    }
    priv store_key := map_store_key(K, V)
    // Make an uninitialized hole. Do not delete the duplicated bytes at lo:
    // their ownership, if any, now belongs to the shifted slot at lo + 1.
    priv open_slot := func(mut self: Map(K, V), lo: USize) {
        key_bytes := Map(K, V).key_size().to_uptr()
        value_bytes := Map(K, V).value_size().to_uptr()
        if self.keys.count == self.keys.cap {
            mut capacity := self.keys.cap * 2
            if capacity == 0 { capacity = 1 }
            self.keys.data = realloc(own self.keys.data, capacity.to_uptr().mul(key_bytes))
            self.values.data = realloc(own self.values.data, capacity.to_uptr().mul(value_bytes))
            self.keys.cap = capacity
            self.values.cap = capacity
        }
        memmove(self.key_slot(lo + 1), self.key_slot(lo), (self.keys.count - lo).to_uptr().mul(key_bytes))
        memmove(self.value_slot(lo + 1), self.value_slot(lo), (self.values.count - lo).to_uptr().mul(value_bytes))
        self.keys.count++
        self.values.count++
    }
    /// Insert or overwrite. Ref-qualified keys/values borrow their sources;
    /// other keys are cloned and other values are taken by ownership.
    set := map_set(K, V)

    /// Remove ~key~, dropping its key and value. Returns false if absent.
    remove := func(mut self: Map(K, V), key: K) returns Bool {
        mut lo : USize = 0
        mut hi : USize = self.keys.count
        while lo < hi {
            mid : USize = lo.add(hi.sub(lo) / 2)
            c : I64 = K.cmp(self.keys.unsafe_get(mid), key)
            if c < 0 { lo = mid + 1 }
            else {
                if c > 0 { hi = mid }
                else {
                    self.keys.remove_at(mid)!
                    self.values.remove_at(mid)!
                    return true
                }
            }
        }
        return false
    }

    delete := func(own self: Map(K, V), call_free: Bool = true) {
        own self.keys.delete(false)
        own self.values.delete(false)
        if call_free { free(own self) }
    }

    clone := func(self: Map(K, V)) returns Map(K, V) {
        // Cloning the sorted key/value Vecs directly preserves order and
        // keeps the key/value arrays aligned.
        return Map(K, V)(keys = self.keys.clone(), values = self.values.clone())
    }
}
