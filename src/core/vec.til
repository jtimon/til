mode lib

import("ast")
import("bool")
import("dyn")
import("numbers")
import("str")

vec := ext_func(T: Type, elements: ..Dynamic) returns Vec {}

/// Dynamic array of typed elements. Checked indexing throws [[til:OutOfBounds]].
Vec := struct<T: Type> {
    own data : U8 = 0
    count : USize = 0
    cap : USize = 0

namespace:
    /// Create a new empty Vec for elements of type T. Lazy: no allocation
    /// until the first push -- an empty Vec is (data=NULL, count=0, cap=0),
    /// and the grow sites below seed cap 0->1 on the first insert. This keeps
    /// the many containers that stay empty (e.g. the unused maps in a fresh
    /// Scope) allocation-free, which is the dominant per-call interpreter cost.
    new := func() returns Vec(T) {
        return Vec(T)(cap = 0)
    }

    /// Create an empty Vec pre-sized for ~n~ elements, so pushing up to ~n~
    /// items reallocs zero times. Use at call sites where the final length is
    /// known up front (cloning a Vec of known length, building a fixed arg
    /// list, ...) to avoid the 1->2->4->...->n grow-and-realloc churn that
    /// ~new()~ + repeated ~push~ pays. n=0 behaves like new(): lazy-empty,
    /// no allocation (the grow sites seed cap 0->1 on the first insert).
    with_capacity := func(n: USize) returns Vec(T) {
        if n == 0 { return Vec(T)(cap = 0) }
        return Vec(T)(data = malloc(n.mul(T.size())), cap = n)
    }

    len := func(self: Vec(T)) returns USize { return self.count }

    /// Drop all live elements via elem_delete but keep the allocated
    /// storage and element-type metadata so the Vec can be reused.
    clear := func(mut self: Vec(T)) {
        for i in 0..self.count {
            T.delete(own ptr_add(self.data, i.mul(T.size())), false)
        }
        self.count = 0
    }

    /// Drop the elements flagged in ~marks~ (a byte-per-element buffer,
    /// nonzero = drop, at least self.count entries) via elem_delete, then
    /// compact the survivors forward and update count. This is the
    /// container home for the scavenger's mark/sweep/compact, which used
    /// to reach into data/count directly.
    delete_marked := func(mut self: Vec(T), marks: Dynamic) {
        n := self.count
        mut i : USize = 0
        while i < n {
            ref mark : Bool = ptr_add(marks, i)
            if mark {
                T.delete(own ptr_add(self.data, i.mul(T.size())), false)
                memset(ptr_add(self.data, i.mul(T.size())), 0, T.size())
            }
            i++
        }
        mut w : USize = 0
        mut r : USize = 0
        while r < n {
            ref mark : Bool = ptr_add(marks, r)
            if mark.not() {
                if w != r {
                    memcpy(ptr_add(self.data, w.mul(T.size())), ptr_add(self.data, r.mul(T.size())), T.size())
                }
                w++
            }
            r++
        }
        self.count = w
    }

    /// Append an element to the end. ~val~ is owned: after this call the
    /// caller must not use the value passed -- clone it first if needed.
    push := func(mut self: Vec(T), own val: T) {
        if self.count == self.cap {
            // cap 0 (lazy-empty) doubles to 0, so seed the first grow to 1.
            // realloc(NULL, n) behaves as malloc(n).
            mut new_cap := self.cap * 2
            if self.cap == 0 { new_cap = 1 }
            self.data = realloc(own self.data, new_cap.mul(T.size()))
            self.cap = new_cap
        }
        adopt(T, ptr_add(self.data, self.count.mul(T.size())), own val)
        self.count = self.count + 1
    }

    /// Consume the contents of ~other~ by appending them to ~self~.
    /// ~other~ is taken by ownership and will be empty after the call.
    append := func(mut self: Vec(T), own other: Vec(T)) {
        if other.count == 0 {
            return
        }
        needed := self.count + other.count
        if needed > self.cap {
            mut new_cap := self.cap
            if new_cap == 0 { new_cap = 1 }
            while needed > new_cap {
                new_cap = new_cap * 2
            }
            self.data = realloc(own self.data, new_cap.mul(T.size()))
            self.cap = new_cap
        }
        memcpy(ptr_add(self.data, self.count.mul(T.size())), other.data, other.count.mul(T.size()))
        self.count = needed
        other.count = 0
    }

    /// Take the contents out: the returned Vec owns self's buffer and
    /// self is left lazy-empty. No element is copied or cloned.
    ///
    /// This is how a struct FIELD hands its contents over
    /// (~mut old := body.children.take()~): a field cannot be an ~own~
    /// argument or receiver, because the callee would then free the
    /// ADDRESS OF THE FIELD -- the compiler dies with "free(): invalid
    /// pointer" compiling itself. Everything the caller can give away
    /// uses the two move forms below instead.
    take := func(mut self: Vec(T)) returns Vec(T) {
        // Raw-allocated and byte-filled, the way pop() builds its
        // result: Vec(T).new() would give `data` its field default,
        // which for an `own U8` field is a one-byte box that the header
        // copy immediately overwrites -- an allocation, a free, and a
        // leak if the free is forgotten (ASAN caught 488 of them).
        mut out : Vec(T) = malloc(Vec(T).size())
        adopt_from(out, self, Vec(T).size())
        return out
    }

    /// Give self's contents to ~dest~, which drops whatever it held.
    /// SELF is consumed, so the receiver is the owned one and the call
    /// spells the type out: ~Vec(T).move_to(own src, dest)~.
    ///
    /// The three fields move as BYTES on purpose:
    /// ~dest.data = self.data~ drops dest's old pointer (right) and then
    /// ~self.data = 0~ drops the pointer dest just adopted -- a double
    /// free, which is what the emitted C does with field assignment.
    /// Blanking the source leaves a genuinely valid lazy-empty Vec, so
    /// a later push on it allocates afresh instead of reallocating a
    /// buffer that now belongs to someone else.
    move_to := func(own self: Vec(T), mut dest: Vec(T)) {
        for i in 0..dest.count {
            T.delete(own ptr_add(dest.data, i.mul(T.size())), false)
        }
        free(own dest.data)
        adopt_from(dest, self, Vec(T).size())
    }

    /// Take ~other~'s contents, dropping whatever self held. OTHER is
    /// consumed -- it is the value being emptied, so it is the owned
    /// argument: ~dest.move_from(own src)~.
    move_from := func(mut self: Vec(T), own other: Vec(T)) {
        // Spelled out because the owned side is the RECEIVER, and UFCS
        // has nowhere to put `own` for it.
        Vec(T).move_to(own other, self)
    }

    /// Unchecked element access: return a reference to the element at
    /// index ~i~ with NO bounds check. The caller must prove ~i < len()~.
    /// This is the unchecked core that ~get~ wraps; for-in uses it
    /// directly because its ~_fi < len()~ termination test already
    /// proves the index in bounds (issue #284).
    unsafe_get := func(self: Vec(T), i: USize) returns ref T {
        return ptr_add(self.data, i.mul(T.size()))
    }

    /// Return a reference to the element at index ~i~. Throws
    /// OutOfBounds if ~i~ is past the end; call as ~vec[i]~
    /// to panic on a bad index. The reference is valid until the
    /// next mutation.
    get := func(self: Vec(T), shallow i: USize) returns ref T throws OutOfBounds {
        // In-range case FIRST so the throw is the body's LAST statement.
        // The throws lowering guards every statement that FOLLOWS a throw
        // with `if _err_kind == 0 { ... }`, and that guard re-reads the
        // error slot through its out-param pointer -- a null-checked DEREF
        // plus a compare and a branch, on the hot path of every `v[i]` in
        // the language, to re-learn what the line above just decided.
        // Nothing follows the throw here, so nothing is guarded.
        if i < self.count {
            return self.unsafe_get(i)
        }
        throw OutOfBounds()
    }

    /// Remove and return the last element. Panics if empty. The caller
    /// takes ownership of the returned value.
    pop := func(mut self: Vec(T)) returns T {
        if self.count == 0 {
            panic("Vec.pop: empty vec")
        }
        last := self.count - 1
        mut out : T = malloc(T.size())
        adopt_from(out, ptr_add(self.data, last.mul(T.size())), T.size())
        self.count = last
        return out
    }

    /// Remove and drop the element at ~i~, shifting later elements left.
    remove_at := func(mut self: Vec(T), i: USize) throws OutOfBounds {
        if i >= self.count {
            throw OutOfBounds()
        }
        T.delete(own self.unsafe_get(i), false)
        tail := self.count.sub(i).sub(1)
        if tail > 0 {
            memmove(self.unsafe_get(i), self.unsafe_get(i.add(1)), tail.mul(T.size()))
        }
        self.count = self.count - 1
        memset(self.unsafe_get(self.count), 0, T.size())
    }

    /// Split off the first ~n~ elements into a new Vec. Panics if ~n~
    /// exceeds self.len(). The remaining elements shift to the front.
    take_prefix := func(mut self: Vec(T), n: USize) returns Vec(T) {
        if n > self.count {
            panic("Vec.take_prefix: count ", n.to_str(), " out of bounds (len ", self.count.to_str(), ")")
        }
        mut prefix_cap : USize = 1
        if n > 0 {
            prefix_cap = n
        }
        mut prefix_data : U8 = malloc(prefix_cap.mul(T.size()))
        if n > 0 {
            memcpy(prefix_data, self.data, n.mul(T.size()))
        }
        tail_count := self.count - n
        if tail_count > 0 {
            memmove(self.data, ptr_add(self.data, n.mul(T.size())), tail_count.mul(T.size()))
        }
        if n > 0 {
            memset(ptr_add(self.data, tail_count.mul(T.size())), 0, n.mul(T.size()))
        }
        self.count = tail_count
        return Vec(T)(data = prefix_data, count = n, cap = prefix_cap)
    }

    /// Drop the elements from index ~n~ to the end, freeing each via
    /// elem_delete, and set count to ~n~ (the survivors [0, n) are left
    /// untouched). Panics if ~n~ exceeds len. This is the container home
    /// for a pop-and-free-the-tail loop shrinking a Vec back to a mark.
    truncate := func(mut self: Vec(T), n: USize) {
        if n > self.count {
            panic("Vec.truncate: count ", n.to_str(), " out of bounds (len ", self.count.to_str(), ")")
        }
        for i in n..self.count {
            T.delete(own ptr_add(self.data, i.mul(T.size())), false)
        }
        self.count = n
    }

    /// Overwrite the element at index ~i~ without a bounds check, dropping
    /// the old value. Caller guarantees ~i < self.count~; the write-side
    /// mirror of unsafe_get (issue #284).
    unsafe_set := func(mut self: Vec(T), i: USize, own val: T) {
        T.delete(own self.unsafe_get(i), false)
        adopt(T, self.unsafe_get(i), own val)
    }

    /// Overwrite the element at index ~i~. ~val~ is owned. Throws
    /// OutOfBounds if ~i~ is past the end; call as ~vec[i] = val~
    /// (or ~vec.set(i, own val)!~) to panic on a bad index.
    set := func(mut self: Vec(T), i: USize, own val: T) throws OutOfBounds {
        if i >= self.count {
            throw OutOfBounds()
        }
        self.unsafe_set(i, own val)
    }

    /// Move bytes of src[i] into self (push). Source slot is zeroed so that
    /// src's eventual elem_delete on it is a no-op (relies on the same
    /// count==0/data==NULL convention used by take_children and Vec.delete).
    push_take := func(mut self: Vec(T), mut src: Vec(T), i: USize) {
        if i >= src.count {
            panic("Vec.push_take: index ", i.to_str(), " out of bounds (len ", src.count.to_str(), ")")
        }
        if self.count == self.cap {
            mut new_cap := self.cap * 2
            if self.cap == 0 { new_cap = 1 }
            self.data = realloc(own self.data, new_cap.mul(T.size()))
            self.cap = new_cap
        }
        adopt_from(ptr_add(self.data, self.count.mul(T.size())),
                   ptr_add(src.data, i.mul(T.size())), T.size())
        self.count = self.count + 1
    }

    /// Drop each element via elem_delete, free storage, then free self
    /// unless ~call_free~ is false.
    delete := func(own self: Vec(T), call_free: Bool = true) {
        self.clear()
        free(own self.data)
        if call_free { free(own self) }
    }

    /// Deep-copy the Vec and all its elements via elem_clone.
    clone := func(self: Vec(T)) returns Vec(T) {
        // A lazy-empty source clones to another lazy-empty Vec (no malloc(0)).
        if self.cap == 0 { return Vec(T)(cap = 0) }
        mut new_data : U8 = malloc(self.cap.mul(T.size()))
        for i in 0..self.count {
            ref src : T = ptr_add(self.data, i.mul(T.size()))
            mut cloned : T = T.clone(src)
            adopt(T, ptr_add(new_data, i.mul(T.size())), own cloned)
        }
        return Vec(T)(data = new_data, count = self.count, cap = self.cap)
    }
}
