mode lib

import("bool")
import("map")
import("numbers")
import("option")
import("str")
import("vec")

// builtin types

// --- Primitive enum ---

/// Real primitive types. Issue #203 migrates them one at a time;
/// I16 first because it has the smallest call-site surface.
Primitive := enum {
    I16,
    U16,
    I8,
    U8,
    U32,
    I32,
    U64,
    I64,
    F32,
    Bool,
    // #333: 64-bit float (C double). Appended after Bool so every
    // pre-existing variant keeps its tag value.
    F64,
}

// --- Type enum ---

/// Type representation for the til compiler. Carries payload for named
/// types (Struct/Enum/Custom) and is tag-only for builtins.
Type := enum {
    Unknown, None,
    // All scalar primitives now live under Type.Primitive(Primitive). The
    // builtin metatypes below carry no payload (Struct/Enum/Custom carry a
    // name).
    Struct: Str, StructDef,
    Enum: Str, EnumDef,
    FuncDef, FuncPtr, Dynamic,
    Custom: Str,
    // Primitive is appended at the end so the tag values for existing
    // variants are preserved -- master's til_boot has its tag values baked
    // into its compiled C, and inserting a new variant in the middle would
    // shift everything after it and mis-decode Type values created by
    // master's compiled code while bootstrapping.
    Primitive: Primitive,
    // Issue #58 / #147: FuncPtr with the FuncSig alias name
    // (e.g. `Type.FuncPtrSig("BinaryOp")`). Tag-only `Type.FuncPtr` stays
    // for the wildcard "some function pointer" cases; sites that know
    // the FuncSig name use this variant. Same append-at-end rule as
    // Primitive: keeps the existing tags stable for bootstrapping.
    FuncPtrSig: Str,
    // Issue #55: first-class executable statement bodies. Backends may use
    // the same closure carrier as FuncPtr internally, but the source type is
    // distinct.
    Body,
}

// The compiler-facing Type helper funcs (til_type_name_c, is_primitive,
// is_funcptr, is_aggregate) live in src/self/context.til; dyn_type_to_str,
// til_type_name and the reflection assemblers (struct_def_of, enum_def_of,
// func_sig_of) live in src/core/dyn.til next to the introspection
// primitives they wrap.

// --- FuncType enum ---
/// Classifies a til function declaration: func, proc, test, macro, or external.
FuncType := enum {
    Func, Proc, Test, Macro, ExtFunc, ExtProc, LazyFunc, LazyProc,
    // #288: core_func/core_proc -- primitive intrinsics. Parsed and typed
    // exactly like ext_func/ext_proc, but every backend MUST lower them
    // natively (no emitted symbol, no per-backend impl) and the typer
    // FORBIDS indirecting them (dyn_fn / FuncPtr field / FFI). Appended at
    // the END so existing tag values stay stable for til_boot's committed
    // boot/ (enum tags are part of the committed bootstrap ABI).
    CoreFunc, CoreProc,
    // core_lazy_func: a bodyless lazy core primitive (and/or). Like a
    // core_func, every backend lowers it natively (C: the short-circuiting
    // && / || operators) and it can never be indirected; like a lazy_func,
    // its arguments are evaluated call-by-name (the loader splices the
    // compiler-known match expansion at parse-time call sites). Appended at
    // the END so existing tag values stay stable for til_boot's boot/.
    CoreLazyFunc,
namespace:
    // Enum-variant-name form (as written in the FuncType enum above), for
    // NodeType.head_str / Expr.to_str output. Distinct from func_type_name
    // (src/self/parser.til) which returns the til keyword (snake_case).
    variant_name := func(self: FuncType) returns Str {
        switch self {
        case .Func:    return "Func"
        case .Proc:    return "Proc"
        case .Test:    return "Test"
        case .Macro:   return "Macro"
        case .ExtFunc: return "ExtFunc"
        case .ExtProc: return "ExtProc"
        case .LazyFunc: return "LazyFunc"
        case .LazyProc: return "LazyProc"
        case .CoreFunc: return "CoreFunc"
        case .CoreProc: return "CoreProc"
        case .CoreLazyFunc: return "CoreLazyFunc"
        }
    }
    // ext_func / ext_proc: the FFI boundary. The body is user-written C, so
    // nothing here is emitted, walked, or auto-cleaned.
    is_ext := func(self: FuncType) returns Bool {
        switch self {
        case .ExtFunc, .ExtProc: return true
        case: return false
        }
    }
    // core_func / core_proc / core_lazy_func: primitive intrinsics. Every
    // backend lowers them natively (no symbol emitted) and none can be
    // indirected through a FuncPtr or dyn_fn.
    is_core := func(self: FuncType) returns Bool {
        switch self {
        case .CoreFunc, .CoreProc, .CoreLazyFunc: return true
        case: return false
        }
    }
    // lazy_func / lazy_proc: USER-DEFINED call-by-name declarations, whose
    // own body the loader splices into each call site.
    // core_lazy_func is call-by-name too but is deliberately NOT here: it is
    // bodyless, so the loader splices a compiler-known expansion instead
    // (and/or -> a short-circuiting match). The two are the if / else-if
    // branches of expand_lazy_in_expr, so folding CoreLazyFunc into this set
    // would send and/or down the user-lazy path. It lives in is_core.
    is_lazy := func(self: FuncType) returns Bool {
        switch self {
        case .LazyFunc, .LazyProc: return true
        case: return false
        }
    }
    // An ordinary til-bodied func / proc -- the declarations that get
    // auto-shallow inference and auto-generated methods.
    is_plain := func(self: FuncType) returns Bool {
        switch self {
        case .Func, .Proc: return true
        case: return false
        }
    }
    // Every proc flavour: a callee that may have side effects, which is what
    // the "func cannot call proc" rule and the proc_calls_count bookkeeping
    // test for.
    // LazyProc is absent on purpose and is NOT a gap: the loader rewrites a
    // spliced lazy_proc back to FuncType.Proc (expand_lazy_in_expr), so no
    // LazyProc callee survives to the typer, where every one of these checks
    // runs.
    is_proc := func(self: FuncType) returns Bool {
        switch self {
        case .Proc, .ExtProc, .CoreProc: return true
        case: return false
        }
    }
    // No til body to walk, type, or emit: the C boundary plus the natively
    // lowered intrinsics. Stated as the union so a new ext_* or core_*
    // variant only has to join its own set above.
    is_bodyless := func(self: FuncType) returns Bool {
        return self.is_ext().or(self.is_core())
    }
}

// Stable reflection encoding. Keep this explicit: enum declaration order is
// bootstrap ABI, but runtime metadata must not depend on an implicit cast.
func_type_to_i64 := func(ft: FuncType) returns I64 {
    switch ft {
    case .Func: return 0
    case .Proc: return 1
    case .Test: return 2
    case .Macro: return 3
    case .ExtFunc: return 4
    case .ExtProc: return 5
    case .LazyFunc: return 6
    case .LazyProc: return 7
    case .CoreFunc: return 8
    case .CoreProc: return 9
    case .CoreLazyFunc: return 10
    }
}

func_type_from_i64 := func(tag: I64) returns FuncType {
    switch tag {
    case 0: return FuncType.Func
    case 1: return FuncType.Proc
    case 2: return FuncType.Test
    case 3: return FuncType.Macro
    case 4: return FuncType.ExtFunc
    case 5: return FuncType.ExtProc
    case 6: return FuncType.LazyFunc
    case 7: return FuncType.LazyProc
    case 8: return FuncType.CoreFunc
    case 9: return FuncType.CoreProc
    case 10: return FuncType.CoreLazyFunc
    case: panic(__LOC__, "invalid FuncType reflection tag: ", tag.to_str())
    }
}

/// Argument ownership mode: Own (takes ownership), Ref (borrow), Shallow (trivial copy).
OwnType := enum {
    Own, Ref, Shallow,
}

own_type_to_i64 := func(own_type: OwnType) returns I64 {
    switch own_type {
    case .Own: return 0
    case .Ref: return 1
    case .Shallow: return 2
    }
}

own_type_from_i64 := func(tag: I64) returns OwnType {
    switch tag {
    case 0: return OwnType.Own
    case 1: return OwnType.Ref
    case 2: return OwnType.Shallow
    case: panic(__LOC__, "invalid OwnType reflection tag: ", tag.to_str())
    }
}

// --- Declaration struct ---

// #302 stage 1: the storage decision the garbager settles for a local
// Decl, RECORDED on the Declaration so downstream stages (builder,
// interpreter) execute it instead of re-deriving it from expression
// shapes. Unset = the pass did not classify the binding (params, ref
// locals, bodies the garbager never processed).
GcStorage := enum { Unset, Stack, HeapBox }

// #321: explicit early instantiation. Declaration embeds Option(Expr)
// BY VALUE below, so the C emitter must define Option__Expr before
// Declaration -- but auto-synthesized instances are appended to the END
// of the unit, and the Expr -> NodeType -> Declaration -> Option__Expr
// dependency cycle forces the topo sort's scan-order fallback (the
// niche skip in topo_emit_struct_enum_defs_lp breaks the cycle, but the
// BOOT compiler building pass 1 predates it). A decl named exactly the
// genname is kept in place by init_normalize_direct_type_gen_aliases,
// so the instance sits here, ahead of its first consumer, under both
// emitters.
Option__Expr := Option(Expr)

// Construct a declaration type from source/reflection spelling without any
// scope knowledge. USize/UPtr and user names deliberately remain Custom so
// declaration spelling survives until a semantic-use site resolves them.
declaration_type_from_name := func(name: Str) returns Type {
    if name == "I64"  { return Type.Primitive(Primitive.I64) }
    if name == "U8"   { return Type.Primitive(Primitive.U8) }
    if name == "I8"   { return Type.Primitive(Primitive.I8) }
    if name == "I16"  { return Type.Primitive(Primitive.I16) }
    if name == "U16"  { return Type.Primitive(Primitive.U16) }
    if name == "I32"  { return Type.Primitive(Primitive.I32) }
    if name == "U32"  { return Type.Primitive(Primitive.U32) }
    if name == "U64"  { return Type.Primitive(Primitive.U64) }
    if name == "F32"  { return Type.Primitive(Primitive.F32) }
    if name == "F64"  { return Type.Primitive(Primitive.F64) }
    if name == "Bool" { return Type.Primitive(Primitive.Bool) }
    if name == "Str" { return Type.Struct("Str") }
    if name == "StructDef" { return Type.Struct("StructDef") }
    if name == "EnumDef" { return Type.Struct("EnumDef") }
    if name == "Fn" { return Type.FuncPtr }
    if name == "Body" { return Type.Body }
    if name == "Dynamic" { return Type.Dynamic }
    if name.len() == 0 { return Type.Unknown }
    return Type.Custom(name.clone())
}

/// Variable/field/parameter declaration node.
Declaration := struct {
    name := ""
    doc := ""
    is_mut := false
    // #211: set by the parser when a struct FIELD carries an explicit
    // `mut`. Fields are mutable by default, so the keyword is redundant
    // and the typer rejects it. Meaningless for locals/params/ns-decls.
    redundant_mut := false
    is_priv := false
    used := false
    own_type := OwnType.Shallow
    til_type := Type.Unknown
    // #321: None = no default/initializer expression. This used to be an
    // owned Expr whose absence had TWO spellings -- a NULL that predated
    // the ctor default, and the NoDefaultArg sentinel node -- guarded by
    // is_null()-then-node_type checks at every consumer. The niche makes
    // Option(Expr) the same one word, and absence one honest tag.
    // (NodeType.NoDefaultArg itself survives in its OTHER role: the
    // desugarer's unfilled call-arg slot placeholder.)
    default_value := Option__Expr.None
    // Issue #93: when init_declarations_unit hoists a nested struct/enum/
    // func from inside a function body to file scope, it stores the
    // original unmangled identifier here so unused-priv diagnostics can
    // report it (and the enclosing parent function name, derived by
    // stripping the trailing "_<orig_name>" from the mangled `name`)
    // in source terms instead of leaking the synthetic mangled name.
    orig_name := ""
    // #302 stage 1: settled by the garbager (record_storage_decisions)
    // after promotion; see GcStorage above. Appended at the END so the
    // committed boot's Declaration layout stays stable.
    gc_storage := GcStorage.Unset
    // C symbol backing an ext_global declaration. Empty for ordinary
    // declarations. The declaration remains the source-level binding while
    // compiled and interpreted reads/writes use this external storage.
    external_symbol := ""
namespace:
    eq := func(a: Declaration, b: Declaration) returns Bool { return a.name == b.name }
    to_str := func(self: Declaration) returns Str { return self.name }
    // Source/ABI spelling of this declaration's type. This is intentionally
    // distinct from semantic resolution so USize/UPtr and aliases survive.
    type_name := func(self: Declaration) returns Str {
        switch self.til_type {
        case .Struct(name): return name.clone()
        case .Enum(name): return name.clone()
        case .Custom(name): return name.clone()
        case .FuncPtrSig(name): return name.clone()
        case .Primitive(Primitive.I8): return "I8"
        case .Primitive(Primitive.U8): return "U8"
        case .Primitive(Primitive.I16): return "I16"
        case .Primitive(Primitive.U16): return "U16"
        case .Primitive(Primitive.I32): return "I32"
        case .Primitive(Primitive.U32): return "U32"
        case .Primitive(Primitive.I64): return "I64"
        case .Primitive(Primitive.U64): return "U64"
        case .Primitive(Primitive.F32): return "F32"
        case .Primitive(Primitive.F64): return "F64"
        case .Primitive(Primitive.Bool): return "Bool"
        case .None: return "None"
        case .StructDef: return "StructDef"
        case .EnumDef: return "EnumDef"
        case .FuncDef: return "FunctionDef"
        case .FuncPtr: return "Fn"
        case .Body: return "Body"
        case .Dynamic: return "Dynamic"
        case: return ""
        }
    }
    /// The default-value expression, borrowed. PANICS on None: callers
    /// either sit under an is_some() guard or know absence is impossible
    /// for their decl kind (e.g. an initer-built member whose default IS
    /// the definition). Prefer a switch when the None arm does real work.
    default_expr := func(self: Declaration) returns ref Expr {
        switch self.default_value {
        case .Some(dv): return dv
        case .None: panic(__LOC__, "default_expr on a Declaration with no default: ", self.name)
        }
    }
}

// --- FuncSig / FunctionDef structs ---
/// Callable contract shared by function signatures and definitions.
FuncSig := struct {
    func_type := FuncType.Func
    params := Vec(Declaration).new()
    return_type := ""
    // Issue #198: list of error type names declared in the
    // ~throws T1, T2, ...~ clause of the signature. Empty Vec when
    // the function does not throw. Names match Type.Custom payloads
    // (e.g. ~"DivideByZero"~, ~"Str"~).
    throw_types := Vec(Str).new()
    variadic_index : I32 = -1
    kwargs_index : I32 = -1
    return_own_type := OwnType.Own
    // Issue #223: set by the parser ONLY when the return type carries an
    // explicit `shallow` qualifier. The redundant-shallow diagnostic must
    // test this, NOT return_own_type, because the typer's auto-shallow pass
    // overwrites return_own_type Own->Shallow for primitives -- which would
    // make the check misfire on any RE-inference of the def (e.g. a capturing
    // closure re-typed as a UFCS-receiver-call arg). This flag preserves the
    // user's original intent across re-inference so the check stays idempotent.
    return_shallow_explicit := false
namespace:
    eq := func(a: FuncSig, b: FuncSig) returns Bool {
        if a.func_type != b.func_type { return false }
        if a.params.len() != b.params.len() { return false }
        for i in 0..a.params.len() {
            ref ap : Declaration = a.params[i]
            ref bp : Declaration = b.params[i]
            if ap.til_type != bp.til_type { return false }
            if ap.own_type != bp.own_type { return false }
            if ap.is_mut != bp.is_mut { return false }
        }
        if a.return_type != b.return_type { return false }
        if a.return_own_type != b.return_own_type { return false }
        if a.variadic_index != b.variadic_index { return false }
        if a.kwargs_index != b.kwargs_index { return false }
        if a.throw_types.len() != b.throw_types.len() { return false }
        for i in 0..a.throw_types.len() {
            if a.throw_types[i] != b.throw_types[i] { return false }
        }
        return true
    }
    to_str := func(self: FuncSig) returns Str { return self.return_type }
}

/// Function-definition metadata layered over its callable signature.
FunctionDef := struct {
    sig := FuncSig()
    // #187 step 2: set true on FuncDefs emitted by initer's auto-gen
    // helpers (clone/delete/size/eq/to_str/variant constructors).
    // The unused-priv-member check skips field/ns reads inside these
    // bodies so genuinely-unused priv members don't get masked by
    // boilerplate references.
    auto_generated := false
    is_enum_variant_ctor := false
    // Issue #54: explicit capture list for closures, e.g.
    // `func(a: I64) returns I64 [scale] { ... }`. Each entry is a
    // Declaration carrying the captured name plus its modifier
    // (is_mut / own_type). Empty for ordinary (non-capturing) functions.
    captures := Vec(Declaration).new()
    // C backend name for the generated env-backed closure call function.
    // Empty until the typer assigns one to a capturing FuncDef.
    closure_name := ""
    // #303: true when calling this function never returns control to the
    // caller. Seeded on core exit (an ext_func whose libc binding is
    // noreturn), then inferred bottom-up by the typer for any function
    // whose body cannot reach its end or a return statement (see
    // fn_never_returns in context.til): panic ends in exit, UNREACHABLE
    // and TODO end in panic, and user functions with the same shape
    // qualify too. Read through the resolved direct callee when control-flow
    // divergence is derived.
    noreturn := false
    // #344: parameter-indexed summary of the borrow this function hands
    // back. Bit i is set when parameter i's storage -- or a borrow that
    // parameter i carries -- can reach the returned value, on ANY return
    // path. Same indexing as FCallData's own_args / ref_args bitmaps, so a
    // call site maps the bits onto its actual arguments and learns which
    // caller storage the result aliases. Zero for the overwhelming majority
    // of functions (only `returns ref T` and enum-with-ref-payload returns
    // can carry one), and zero is also the conservative answer for a
    // callee the summary pass could not resolve.
    ref_return_params : U64 = 0
    // #354: the two sibling relations ref_return_params conflated. Bit i
    // of ref_return_into_params: the returned value CARRIES a pointer
    // INTO parameter i's own storage (get_binding wrapping a map ref in
    // an Option). Bit i of ref_return_carried_params: the returned value
    // carries pointers to what parameter i itself CARRIES (clone copying
    // a holder's ref fields). ref_return_params keeps meaning the return
    // can alias parameter i's storage directly. The call site maps each
    // to what it actually reaches: full roots / own storage / carried
    // roots. Appended at the END so the committed boot's layout stays
    // stable.
    ref_return_into_params : U64 = 0
    ref_return_carried_params : U64 = 0
    // Owning top-level declaration for a namespace FuncDef. The declaration
    // supplies the aggregate name; its definition supplies the member name on
    // rare qualified-identity lookups. This borrow is stable for the AST's
    // lifetime and avoids storing two name pointers on every FunctionDef.
    namespace_decl := Option(ref Declaration).None
namespace:
    eq := func(a: FunctionDef, b: FunctionDef) returns Bool { return a.sig == b.sig }
    to_str := func(self: FunctionDef) returns Str { return self.sig.to_str() }
}

// --- FCall payload struct ---
/// Per-callsite data for function calls: parse-time flags (does_throw,
/// is_bang), argument bitmaps, result type. The variadic
/// and kwargs block positions and counts are not stored -- they all
/// derive from the resolved callee's param layout plus the structural
/// markers in fcall.children:
///   - kwargs_count : trailing-NamedArg count (fcall_kwargs_count).
///   - kwargs_index : resolved FuncDef param count
///     (derive_fcall_kwargs_index).
///   - variadic_count : children layout + nparam + has-kwargs
///     (fcall_variadic_count).
///   - variadic_index : implicit at ~1 + fdef_data.sig.variadic_index~
///     post-desugar. Step 7 of #147 closes here: the trailing typer
///     resolution artifact is gone.
FCallData := struct {
    // Issue #198: parser sets this when the call is followed by ~?~,
    // marking it as a call to a throwing function. The typer
    // validates that does_throw matches the callee's throws set.
    does_throw := false
    // Issue #202: parser sets this when the call is followed by ~!~,
    // the "panic on throw" sugar. The typer desugars f(args)! into
    // f(args)? followed by an auto-injected catch (e: T) { panic } per
    // declared throw type, then clears the flag.
    is_bang := false
    own_args : U64 = 0
    keep_outer_args : U64 = 0
    swap_replace := false
    // Issue #206 slice 3: payload-resident result type. The typer
    // writes the resolved callee return type here via the
    // set_til_type method at FCall infer time, and
    // ~til_type~ reads it back via the chokepoint's FCall
    // dispatch case. Callees declared without a ~returns~ clause
    // resolve to ~Type.None~ -- common for callees written as
    // ~proc~, but not a func/proc distinction (per CLAUDE.md
    // "func vs proc is not Pascal", the only rule is "func cannot
    // call proc"; both kinds may or may not return a value).
    til_type := Type.Unknown
    // #320: bitmap of `ref`-qualified TYPE arguments (`make_opt(ref T)`),
    // mirroring own_args' indexing. Only meaningful on type-gen macro
    // instantiations; init expansion consumes it (mangling `__ref_T` and
    // marking substituted enum payloads / struct fields borrowed), and
    // the typer rejects any call that still carries a bit after init.
    // Appended at the END so the committed boot's layout stays stable.
    ref_args : U64 = 0
    // #342: bitmap of `..`-splatted arguments, mirroring own_args' /
    // ref_args' indexing. Nonzero records THAT some argument carried
    // `..`, and each bit records WHICH, which is what a mixed variadic
    // block (`format("<", ..arr)`) needs in order to lower -- without it
    // the desugar cannot tell the splatted array from an ordinary
    // element and wraps it as one, so the callee reads the Array
    // header's bytes as its element type.
    // Appended at the END so the committed boot's layout stays stable.
    splat_args : U64 = 0
namespace:
    eq := func(_a: FCallData, _b: FCallData) returns Bool {
        return true
    }
    to_str := func(_self: FCallData) returns Str { return "FCall" }
}

LiteralNumData := struct {
    text := ""
    til_type := Type.Unknown
namespace:
    eq := func(a: LiteralNumData, b: LiteralNumData) returns Bool { return a.text == b.text }
    to_str := func(self: LiteralNumData) returns Str { return self.text }
    to_i64 := func(self: LiteralNumData) returns I64 { return self.text.to_i64() }
    to_u8 := func(self: LiteralNumData) returns U8 { return self.text.to_u8() }
    to_i8 := func(self: LiteralNumData) returns I8 { return self.text.to_i8() }
    to_i16 := func(self: LiteralNumData) returns I16 { return self.text.to_i16() }
    to_u16 := func(self: LiteralNumData) returns U16 { return self.text.to_u16() }
    to_i32 := func(self: LiteralNumData) returns I32 { return self.text.to_i32() }
    to_u32 := func(self: LiteralNumData) returns U32 { return self.text.to_u32() }
    to_u64 := func(self: LiteralNumData) returns U64 { return self.text.to_u64() }
    to_usize := func(self: LiteralNumData) returns USize { return self.text.to_usize() }
    to_f32 := func(self: LiteralNumData) returns F32 { return self.text.to_f32() }
    literal_num_text := func(self: LiteralNumData) returns ref Str { return self.text }

    /// Does the literal's TEXT spell a float? The lexer accepts a fractional
    /// part ('.' then a digit) and an exponent (e/E, optional sign, digits)
    /// only on the non-prefixed decimal path, so a 0x/0b/0o literal is an
    /// integer even though hex digits include 'e' and 'E'. Callers that infer
    /// a type FROM a literal need this; a literal that narrows from context
    /// (declaration or parameter type) keeps that type instead.
    is_float := func(self: LiteralNumData) returns Bool {
        if self.text.starts_with("0x").or(self.text.starts_with("0X")) { return false }
        if self.text.starts_with("0b").or(self.text.starts_with("0B")) { return false }
        if self.text.starts_with("0o").or(self.text.starts_with("0O")) { return false }
        return self.text.contains(".").or(self.text.contains("e")).or(self.text.contains("E"))
    }
}

IdentData := struct {
    name : Sym = 0
    til_type := Type.Unknown
namespace:
    eq := func(a: IdentData, b: IdentData) returns Bool { return a.name == b.name }
    ident_sym := func(self: IdentData) returns Sym { return self.name }
    ident_name := func(self: IdentData, names: Vec(Str)) returns ref Str {
        return names.unsafe_get(self.name.cast(USize) - 1)
    }
}

// Issue #292: a Context-local identifier for one canonical name. Zero is
// reserved for "not interned", so real symbols start at one.
Sym := U32

FieldAccessData := struct {
    name : Sym = 0
    til_type := Type.Unknown
namespace:
    eq := func(a: FieldAccessData, b: FieldAccessData) returns Bool { return a.name == b.name }
    field_access_sym := func(self: FieldAccessData) returns Sym { return self.name }
    field_access_name := func(self: FieldAccessData, names: Vec(Str)) returns ref Str {
        return names.unsafe_get(self.name.cast(USize) - 1)
    }
}

/// Struct definition: field declarations, namespace methods, c_tag.
/// Issue #147 step 4: total_struct_size dropped from the AST in favour
/// of ctx.struct_layouts[name].total_size, populated by
/// compute_struct_layout at typer time.
StructDef : StructDef = struct {
    // Issue #307: members are stored in DECLARATION order in plain Vecs
    // (fields order IS the C layout order), so every walk is an ordinary
    // for-in over the collection. Each collection has a name -> position
    // index Map beside it, and the name's SINGLE copy in the data model
    // is the index key: stored member Declarations carry name == "".
    // Append via push_field / push_member so vec and index never drift.
    // `own` (pointer-sized in the layout): StructDef/EnumDef live INLINE
    // in the NodeType payload union, and EnumDef is the union's largest
    // member -- growing it grows every Expr in every program. Boxing the
    // member containers keeps the union at its pre-#307 size; defs are
    // few, Exprs are hundreds of thousands.
    own fields : Vec(Declaration) = Vec(Declaration).new()
    own ns_decls : Vec(Declaration) = Vec(Declaration).new()
    own fields_index : Map(Str, USize) = Map(Str, USize).new()
    own ns_index : Map(Str, USize) = Map(Str, USize).new()
    c_tag := ""
    // Issue #251: set by parse_interface_def. The body desugars to this
    // StructDef (empty fields, ns_decls = methods); the typer uses the
    // flag to enforce the interface contract (members must be
    // ext_func/ext_proc abstract or func/proc concrete) as aggregatable
    // type errors.
    is_interface := false
    // Issue #251: set by parse_interface_def when a (redundant)
    // `namespace:` marker appears inside an interface body, so the typer
    // can reject it. An interface has no fields, so there is nothing to
    // separate methods from.
    interface_ns_marker := false
    // Issue #251: the interface name from `struct implements Iface { ... }`,
    // empty when the struct implements nothing. The typer verifies the
    // struct provides every abstract (ext_func/ext_proc) method of Iface
    // with a matching signature.
    implements_name := ""
namespace:
    eq := func(a: StructDef, b: StructDef) returns Bool {
        return a.fields.len() == b.fields.len()
    }
    to_str := func(_self: StructDef) returns Str { return "StructDef" }
    /// Append a field: the index key becomes the single owner of the
    /// field's name; the stored Declaration carries none. Appends never
    /// shift declaration positions, so there is nothing to fix up.
    push_field := func(mut self: StructDef, own fd: Declaration) {
        pos : USize = self.fields.len()
        self.fields_index.set(fd.name, own pos.clone())
        fd.name = ""
        self.fields.push(own fd)
    }
    /// Append a namespace member (see push_field). A duplicate name
    /// re-points the index at the newest declaration.
    push_member := func(mut self: StructDef, own nd: Declaration) {
        pos : USize = self.ns_decls.len()
        self.ns_index.set(nd.name, own pos.clone())
        nd.name = ""
        self.ns_decls.push(own nd)
    }
    /// Field name at declaration position i: reverse lookup over the
    /// index (O(members), tiny and emit-time only). Panics if the index
    /// has no entry for that position (see member_name_of).
    field_name_at := func(self: StructDef, i: USize) returns ref Str {
        return member_name_of(self.fields_index, i).unwrap()
    }
    /// Field Declaration at declaration position i (name == "").
    field_at := func(self: StructDef, i: USize) returns ref Declaration {
        return self.fields.unsafe_get(i)
    }
    /// Namespace member name at declaration position i.
    member_name_at := func(self: StructDef, i: USize) returns ref Str {
        return member_name_of(self.ns_index, i).unwrap()
    }
    /// Namespace member Declaration at declaration position i.
    member_at := func(self: StructDef, i: USize) returns ref Declaration {
        return self.ns_decls.unsafe_get(i)
    }
}

/// Reverse index lookup shared by every *_name_at accessor: the name whose
/// stored position is ~pos~, None for a position no entry points at (one
/// shadowed by a later duplicate name). The three *_name_at wrappers
/// unwrap it: their call sites all walk positions the def itself reports
/// and use the name unchecked, so a miss means the index and the decl Vec
/// disagree, and unwrap says so loudly instead of handing back a null Str.
///
/// Instantiating Option in this unit needed two prerequisites: the #303
/// noreturn seed made order-independent (seed_noreturn_chain, loader.til),
/// since Option.unwrap ends in ~case: panic~ and core.til imports ast
/// before exit; and the borrowed-Str call-shape fix, since
/// this is the first Option(ref Str) interpreted code calls.
member_name_of := func(idx: Map(Str, USize), pos: USize) returns Option(ref Str) {
    for mi in 0..idx.len() {
        if idx.values.unsafe_get(mi) == pos { return safe_ref(idx.keys.unsafe_get(mi)) }
    }
    return Option(ref Str).None
}

/// Issue #307: one record per variant instead of the five position-parallel
/// collections EnumDef used to carry (variants Vec(Str) + payload_types
/// Map(I64, Str) + payload_consts Vec(Bool) + tag_values Vec(I64) +
/// payload_refs Vec(Bool)). The record's position in EnumDef.variants is
/// the declaration index the per-variant data used to be keyed by.
VariantDef := struct {
    name := ""
    /// Leading /// doc comment run, like Declaration.doc for fields.
    doc := ""
    // Payload type name; "" means the variant carries no payload.
    payload_type := ""
    // #211: true when the payload was declared `const Type`.
    payload_const := false
    // #264 follow-up: the discriminant value (`enum { A = 5 }`); defaults
    // to the declaration index (the parser auto-increments, enum_def_of
    // fills the index).
    tag_value : I64 = 0
    // #320: true when the payload was declared `ref Type` -- a BORROWED
    // payload stored as a bare pointer: the enum does not own the
    // pointee (clone copies the pointer, delete skips it).
    payload_ref := false
    // #321: true when the payload's type resolves to a FuncPtr/FuncSig.
    // The parser cannot know (a named alias like `BinaryOp` spells the
    // pointer through a typedef), so the initer stamps it with the scope
    // in hand. enum_is_niche consults it: funcptr payloads are a distinct
    // C shape (TilClosure *) with their own delete/clone special cases,
    // so they stay off the owned-payload niche.
    payload_funcsig := false
namespace:
    eq := func(a: VariantDef, b: VariantDef) returns Bool { return a.name == b.name }
    to_str := func(self: VariantDef) returns Str { return self.name }
}

/// Enum definition: variants, namespace methods.
/// Issue #147 step 4: total_enum_size dropped from the AST in favour
/// of ctx.struct_layouts[name].total_size, populated by
/// compute_enum_layout at typer time.
/// Issue #307: ns_decls gets the same name-keyed storage as StructDef's
/// (see the StructDef doc comment); variants stays a plain Vec because
/// its order IS the tag assignment and it holds the names themselves.
EnumDef : StructDef = struct {
    // own: see StructDef -- keeps the NodeType union at its pre-#307 size.
    own ns_decls : Vec(Declaration) = Vec(Declaration).new()
    own ns_index : Map(Str, USize) = Map(Str, USize).new()
    // Issue #307: one VariantDef record per variant, in declaration order
    // (the order IS the tag assignment). See VariantDef above.
    variants := Vec(VariantDef).new()
    // Issue #251: the interface name from `enum implements Iface { ... }`,
    // empty when the enum implements nothing. Like StructDef.implements_name,
    // the typer verifies the enum provides every abstract (ext_func/ext_proc)
    // method of Iface with a matching signature. Enums carry methods in their
    // namespace just as structs do, so conformance checks identically.
    implements_name := ""
    // #264: discriminant (tag) type chosen via `enum(Type) { ... }`.
    // Empty means unspecified, which defaults to U32 (the historical
    // C-`enum`-backed width).
    tag_type := ""
namespace:
    eq := func(a: EnumDef, b: EnumDef) returns Bool {
        return a.variants.len() == b.variants.len()
    }
    to_str := func(_self: EnumDef) returns Str { return "EnumDef" }
    /// Append a namespace member (see StructDef.push_member).
    push_member := func(mut self: EnumDef, own nd: Declaration) {
        pos : USize = self.ns_decls.len()
        self.ns_index.set(nd.name, own pos.clone())
        nd.name = ""
        self.ns_decls.push(own nd)
    }
    /// Namespace member name at declaration position i.
    member_name_at := func(self: EnumDef, i: USize) returns ref Str {
        return member_name_of(self.ns_index, i).unwrap()
    }
    /// Namespace member Declaration at declaration position i.
    member_at := func(self: EnumDef, i: USize) returns ref Declaration {
        return self.ns_decls.unsafe_get(i)
    }
}

// Issue #147/#247: per-field and whole-type memory layout lives in
// Context.struct_layouts keyed by type name. The former AST layout fields are
// gone; struct_name is the field's struct/enum type name (""
// for primitives / Dynamic / FuncPtr) so lookups go by name rather than a
// dangling ref into the parse tree.
FieldLayout := struct {
    offset : USize = 0
    size : USize = 0
    struct_name := ""
    // #286: per-field info the cache-driven deep free / clone read instead of
    // the dangling AST struct_def. own_type distinguishes own-pointer fields
    // from inline; is_str marks a Str field (free its c_str); is_enum marks an
    // enum-typed field (struct_name names an enum, not a struct).
    own_type := OwnType.Shallow
    is_str := false
    is_enum := false
    is_funcptr := false
namespace:
    eq := func(a: FieldLayout, b: FieldLayout) returns Bool {
        return a.offset.eq(b.offset).and(a.size.eq(b.size)).and(a.struct_name.eq(b.struct_name))
    }
    to_str := func(self: FieldLayout) returns Str { return self.offset.to_str() }
}

// Whole-type layout. For enums only total_size is meaningful (fields stays
// empty); the per-variant payload types live on EnumDef.variants.
StructLayout := struct {
    total_size : USize = 0
    align : USize = 1
    fields := Vec(FieldLayout).new()
    is_interface := false
namespace:
    eq := func(a: StructLayout, b: StructLayout) returns Bool {
        return a.total_size.eq(b.total_size).and(a.align.eq(b.align))
    }
    to_str := func(self: StructLayout) returns Str { return self.total_size.to_str() }
}

// --- NodeType payload enum (25 variants) ---

/// Payload for assignment nodes: which name is being assigned to.
AssignData := struct {
    name := ""
    save_old_delete := false
    is_payload_alias := false
    swap_replace := false
    // #302 stage 4: set by the garbager when the RHS clone of a dying
    // local was elided into a move (`lhs = local.clone()` rewritten to
    // bare `lhs = local` at the local's last use). The rewrite is the
    // mechanism; this flag is the explicit record, so downstream
    // phases can read the decision instead of re-recognizing the
    // rewritten shape. Appended at the end to minimise layout
    // disturbance for til_boot.
    is_move := false
namespace:
    eq := func(a: AssignData, b: AssignData) returns Bool { return a.name == b.name }
    to_str := func(self: AssignData) returns Str { return self.name }
}

FieldAssignData := struct {
    name := ""
    save_old_delete := false
    transfers_own := false
    // #302 stage 4: same explicit move record as AssignData.is_move,
    // for the `holder.f = T.clone(local)` elision. Appended at the end.
    is_move := false
namespace:
    eq := func(a: FieldAssignData, b: FieldAssignData) returns Bool { return a.name == b.name }
    to_str := func(self: FieldAssignData) returns Str { return self.name }
}

/// Payload for ~for name in range~ loop nodes. The two-variable
/// key/value form ~for k, v in map~ fills name2/is_mut2; name2 is
/// empty for the ordinary single-variable form.
ForInData := struct {
    name := ""
    is_mut := false
    til_type := Type.Unknown
    name2 := ""
    is_mut2 := false
namespace:
    eq := func(a: ForInData, b: ForInData) returns Bool { return a.name == b.name }
    to_str := func(self: ForInData) returns Str { return self.name }
}

/// Literal (constant) node kinds: the leaf values written directly in
/// source. Grouped under NodeType.Literal so "is this any literal?"
/// is a single check (NodeType.Literal) instead of a four-way chain.
Literal := enum {
    Str: Str,
    Num: LiteralNumData,
    Bool: Bool,
    Null,
    MapLit,
    SetLit,
}

/// Payload for NodeType.Match: a ~match~ expression yields a value, so
/// the typer records the common arm type here (mirrors FCallData.til_type).
MatchData := struct {
    til_type := Type.Unknown
    // Name of the result temp the lowering declares; set when a match is
    // spliced as a statement so the shared switch desugar (infer_switch_stmt)
    // knows what to assign each arm's value to. Empty on a bare/user match.
    result_temp := ""
namespace:
    eq := func(a: MatchData, b: MatchData) returns Bool { return a.til_type == b.til_type }
    to_str := func(_self: MatchData) returns Str { return "" }
}

/// Payload for NodeType.Case (issue #334): how many patterns precede the
/// guard/body children. Child layout: [pattern x N, guard?, body]. The body
/// is always the LAST child; pattern_count == 0 is the default ~case:~ arm
/// ([body] alone); a guard exists iff children.len() > pattern_count + 1.
/// Only pattern_count is stored -- everything else derives from it and the
/// child count, so there is no second copy of the shape to drift.
CaseData := struct {
    pattern_count : USize = 1
namespace:
    eq := func(a: CaseData, b: CaseData) returns Bool { return a.pattern_count == b.pattern_count }
    to_str := func(_self: CaseData) returns Str { return "" }
}

/// Payload for NodeType.CaptureBlock (issue #54): a bare ~[a, mut b] { ... }~
/// block carrying an explicit capture list. The captures restrict which
/// outer-scope locals the block body may reference -- a compile-time
/// "insurance policy". Each capture is a Declaration (name + is_mut);
/// the block stays inline at runtime, so the only effect is the typer's
/// scope-restriction check. Child 0 is the Body.
CaptureBlockData := struct {
    captures := Vec(Declaration).new()
    closure_name := ""
namespace:
    eq := func(a: CaptureBlockData, b: CaptureBlockData) returns Bool {
        return a.captures.len() == b.captures.len()
    }
    to_str := func(_self: CaptureBlockData) returns Str { return "CaptureBlock" }
}

/// Post-typecheck value for a compile-time Array/Vec result. Element values
/// are the Expr children; the payload keeps the types needed for an empty
/// sequence, its runtime capacity, and a deterministic C-template ordinal.
/// No parser or typer path produces this node.
PrecomputedSequenceData := struct {
    til_type := Type.Unknown
    element_type := Type.Unknown
    capacity : USize = 0
    ordinal : USize = 0
namespace:
    eq := func(a: PrecomputedSequenceData, b: PrecomputedSequenceData) returns Bool {
        return a.til_type.eq(b.til_type)
            .and(a.element_type.eq(b.element_type))
            .and(a.capacity == b.capacity)
            .and(a.ordinal == b.ordinal)
    }
    to_str := func(_self: PrecomputedSequenceData) returns Str { return "PrecomputedSequence" }
}

// Shared Type values for Expr.til_type()'s synthesized arms: node kinds
// whose type is not stored in a payload (a Str literal is always
// Type.Struct("Str"), an If is always Type.None, ...) return a ref to
// these instead of constructing a fresh Type per query.
TYPE_NONE : Type = Type.None
TYPE_UNKNOWN : Type = Type.Unknown
TYPE_DYNAMIC : Type = Type.Dynamic
TYPE_FUNCPTR : Type = Type.FuncPtr
TYPE_BODY : Type = Type.Body
TYPE_BOOL : Type = Type.Primitive(Primitive.Bool)
TYPE_I64 : Type = Type.Primitive(Primitive.I64)
TYPE_F32 : Type = Type.Primitive(Primitive.F32)
TYPE_F64 : Type = Type.Primitive(Primitive.F64)
TYPE_STR : Type = Type.Struct("Str")
TYPE_STRUCTDEF : Type = Type.Struct("StructDef")
TYPE_ENUMDEF : Type = Type.Struct("EnumDef")
TYPE_MAP : Type = Type.Struct("Map")
TYPE_SET : Type = Type.Struct("Set")

/// AST node kind. Each variant carries an optional payload (struct, string, bool).
NodeType := enum {
    Body,
    Literal: Literal,
    Ident: IdentData,
    Decl: Declaration,
    Assign: AssignData,
    FCall: FCallData,
    FuncDef: FunctionDef,
    StructDef: StructDef,
    EnumDef: EnumDef,
    FieldAccess: FieldAccessData,
    FieldAssign: FieldAssignData,
    Return,
    If,
    While,
    ForIn: ForInData,
    NamedArg: Str,
    Break,
    Continue,
    Switch,
    // Issue #244: `match` is the expression form of `switch`. Same arm
    // shape as Switch ([subject, Case...]), but each Case body is a
    // single value-expression and the whole node yields a value (the
    // common arm type, stored in MatchData). The typer lowers a Match to
    // a result temp + a synthetic Switch that assigns each arm's value.
    Match: MatchData,
    Case: CaseData,
    NoDefaultArg,
    // Issue #198: error handling. Throw has 1 child (the thrown
    // expression). Catch has 3 children: Ident (var name), Ident
    // (caught type), Body. The typer validates and then lowers
    // both away to plain til (mut locals + if), so no downstream
    // stage ever evaluates them.
    Throw,
    Catch,
    // Issue #36: rest-pattern marker for struct field matching.
    // `case Point(x = 0, ..):` parses the `..` token into this node
    // and stores it as a child of the FCall pattern. The typer reads
    // its presence to allow missing-field cases and rejects patterns
    // that omit fields without the marker.
    RestPattern,
    // Issue #54: bare capture block `[a, mut b] { ... }`. Child 0 is the
    // Body; the payload holds the capture list. The typer restricts the
    // body's visible outer locals to the captured names; downstream
    // stages treat it as the inline block it wraps.
    CaptureBlock: CaptureBlockData,
    // Issue #281: post-parse sentinel for `__LOC__`. The parser emits this
    // instead of expanding __LOC__ to a Str at parse time, so resolution is
    // deferred to the typer. At a DIRECT use site infer_expr resolves it to
    // the node's own line/col + ctx.path (same as the old parse-time __LOC__).
    // As a parameter/field DEFAULT it is left for the default-fill, which
    // stamps the CALL SITE's coords (resolve_default_value) -- so a defaulted
    // `loc: Str = __LOC__` reports the caller, the C++ source_location model.
    // It never reaches the interpreter or C backend: it is always rewritten to
    // a Literal.Str first. Appended at the end of the enum so existing variant
    // tags stay stable for bootstrapping.
    Loc,
    // Issue #55: Body literal used as a value. Child 0 is the executable
    // Body; captures carry the same explicit list as closures. Appended after
    // Loc so existing NodeType tags stay stable.
    BodyValue: CaptureBlockData,
    // Issue #262: compile-time list pattern in a match case head, used by the
    // recursive form of variadic lazy callables (vand/vor):
    //   case []:        -> zero children (the empty-operands base case)
    //   case [x, ..tl]: -> two children, Ident(x) and Ident(tl) (head/tail)
    // Only legal on the variadic param of a recursive variadic lazy body; the
    // loader's recursion-unroll consumes it before typing, and the typer
    // rejects any ListPattern that survives to it. Appended after BodyValue
    // so existing NodeType tags stay stable.
    ListPattern,
    // Issue #70 preparation: internal recursively serializable Array/Vec
    // value. Appended so every existing NodeType tag remains stable.
    PrecomputedSequence: PrecomputedSequenceData,
namespace:
    // is() compares only the outer enum tag, so is(NodeType.Literal(Literal.X))
    // cannot tell the literal kinds apart -- it matches any Literal. These
    // switch-based predicates discriminate the inner Literal variant. Use
    // node_type.is(NodeType.Literal) directly when "any literal" is wanted.
    is_literal_str := func(self: NodeType) returns Bool {
        switch self { case NodeType.Literal(Literal.Str): return true case: return false }
    }
    is_literal_num := func(self: NodeType) returns Bool {
        switch self { case NodeType.Literal(Literal.Num): return true case: return false }
    }
    is_literal_bool := func(self: NodeType) returns Bool {
        switch self { case NodeType.Literal(Literal.Bool): return true case: return false }
    }
    is_literal_null := func(self: NodeType) returns Bool {
        switch self { case NodeType.Literal(Literal.Null): return true case: return false }
    }
    is_map_lit := func(self: NodeType) returns Bool {
        switch self { case NodeType.Literal(Literal.MapLit): return true case: return false }
    }
    is_set_lit := func(self: NodeType) returns Bool {
        switch self { case NodeType.Literal(Literal.SetLit): return true case: return false }
    }
    // Any literal except Null: the str/num/bool constants. Hoisting and
    // redundant-clone checks treat these as inlinable values while Null
    // needs separate handling.
    is_nonnull_literal := func(self: NodeType) returns Bool {
        switch self {
        case .Literal(Literal.Str):  return true
        case .Literal(Literal.Num):  return true
        case .Literal(Literal.Bool): return true
        case: return false
        }
    }
    // Head string used inside the parentheses by Expr.to_str: the NodeType's
    // variant name plus any inline payload (identifier, literal text, decl
    // name, etc.). Names are kept as written in the enum (no case conversion).
    head_str := func(self: NodeType, names: Vec(Str)) returns Str {
        switch self {
        case .Body:           return "Body"
        case .Literal(Literal.Str(s)):  return format("LiteralStr \"", s, "\"")
        case .Literal(Literal.Num(s)):  return format("LiteralNum ", Str.clone(s.literal_num_text()))
        case .Literal(Literal.Bool(b)):
            if b { return "LiteralBool true" }
            return "LiteralBool false"
        case .Literal(Literal.Null):    return "LiteralNull"
        case .Ident(s):       return format("Ident ", Str.clone(s.ident_name(names)))
        case .Decl(d):
            if d.is_mut { return format("Decl mut ", d.name) }
            return format("Decl ", d.name)
        case .Assign(a):      return format("Assign ", a.name)
        case .FCall:          return "FCall"
        case .FuncDef(f):     return format("FuncDef ", f.sig.func_type.variant_name())
        case .StructDef:      return "StructDef"
        case .EnumDef:        return "EnumDef"
        case .FieldAccess(s): return format("FieldAccess ", s.field_access_name(names))
        case .FieldAssign(fad): return format("FieldAssign ", fad.name)
        case .Return:         return "Return"
        case .If:             return "If"
        case .While:          return "While"
        case .ForIn(fi):
            mut head := "ForIn "
            if fi.is_mut { head = "ForIn mut " }
            if fi.name2.len() > 0 {
                mut tail := format(", ", fi.name2)
                if fi.is_mut2 { tail = format(", mut ", fi.name2) }
                return format(head, fi.name, tail)
            }
            return format(head, fi.name)
        case .NamedArg(s):    return format("NamedArg ", s)
        case .Break:          return "Break"
        case .Continue:       return "Continue"
        case .Literal(Literal.MapLit):         return "MapLit"
        case .Literal(Literal.SetLit):         return "SetLit"
        case .Switch:         return "Switch"
        case .Match:          return "Match"
        case .Case:           return "Case"
        case .NoDefaultArg:   return "NoDefaultArg"
        case .Loc:            return "Loc"
        case .Throw:          return "Throw"
        case .Catch:          return "Catch"
        case .CaptureBlock:   return "CaptureBlock"
        case .BodyValue:      return "BodyValue"
        case .RestPattern:    return "RestPattern"
        case .ListPattern:    return "ListPattern"
        case .PrecomputedSequence: return "PrecomputedSequence"
        }
    }
}

// --- Expr struct ---

/// AST expression node with line/col, children, and node-specific payload.
Expr := struct {
    node_type := NodeType.Body
    children := Vec(Expr).new()
    line : U32 = 0
    col : U32 = 0
    // Set only on target-neutral values reconstructed from successful
    // compile-time evaluation. Source-written constructors remain false.
    constfold_value : Bool = false

namespace:
    /// Null-safe delete. The auto-generated version dereferences ~self~
    /// unconditionally, so the asap pass deleting an owned-but-null Expr
    /// (e.g. a fold helper that returns NULL on failure) SEGVs. Guarding
    /// here lets functions return owned ~Expr~ that may be null without
    /// the caller having to clone-and-leak to dodge the deep delete.
    delete := func(own self: Expr, call_free: Bool = true) {
        // Raw-address probe through the to_ptr launder (#321 step 3):
        // the #302 drain contract hands deletes zeroed/moved-out slots.
        if to_ptr(self).is_null() { return }
        NodeType.delete(own self.node_type, false)
        self.children.clear()
        free(own self.children.data)
        if call_free { free(own self) }
    }
    /// Print a diagnostic error with file path and source location.
    error := proc(self: Expr, path: Str, msg: Str) {
        println(path, ":", self.line.to_str(), ":", self.col.to_str(), ": error: ", msg)
    }
    /// Like error() but adds "not implemented yet" note.
    todo_error := proc(self: Expr, path: Str, msg: Str) {
        self.error(path, msg)
        println("  note: this language feature is not implemented yet")
    }
    /// Like error() but adds "bug in the language" note.
    lang_error := proc(self: Expr, path: Str, msg: Str) {
        self.error(path, msg)
        println("  note: this is a bug in the language, please report it")
    }
    /// Take ownership of ~child~ and append it to the children list.
    add_child := func(mut self: Expr, own child: Expr) {
        self.children.push(own child)
    }
    /// Clone ~child~ and append the clone to the children list.
    push_child_clone := func(mut self: Expr, child: Expr) {
        self.children.push(own child.clone())
    }
    /// Append other's children into self via raw memcpy (no cloning).
    /// Zeroes other's count so it no longer owns the moved items.
    take_children := func(mut self: Expr, mut other: Expr) {
        if other.children.count == 0 { return }
        needed := self.children.count + other.children.count
        if needed > self.children.cap {
            mut new_cap := self.children.cap
            if new_cap == 0 { new_cap = 1 }
            while needed > new_cap {
                new_cap = new_cap * 2
            }
            self.children.data = realloc(own self.children.data, new_cap.mul(Expr.size()))
            self.children.cap = new_cap
        }
        memcpy(ptr_add(self.children.data, self.children.count.mul(Expr.size())),
            other.children.data, other.children.count.mul(Expr.size()))
        self.children.count = needed
        other.children.count = 0
        // Free other's source buffer before nulling: the bytes were
        // memcpy'd into self, but other's malloc'd buffer would leak.
        free(own other.children.data)
        // #321: NULL left the language. core cannot reach the self/ raw
        // layer's bits_word, so the null rides in through a Dynamic local
        // (a Dynamic-typed 0 IS the null pointer -- the typer rewrites it).
        nul : Dynamic = 0
        other.children.data = nul
        // ...and drop the capacity with it. A holder that is REUSED after
        // a take (#328's per-unit pending queue) would otherwise see
        // count < cap over a NULL data pointer and push straight into it.
        other.children.cap = 0
    }
    /// Create a new Expr with the given node_type and source location.
    new := func(data: NodeType, line: U32, col: U32) returns Expr {
        return Expr(node_type = data.clone(), line = line, col = col)
    }
    eq := func(_self: Expr, _other: Expr) returns Bool {
        TODO("Expr.eq")
        return false
    }
    // Returns a BORROWED view of the node's type: the typer establishes
    // every type once (stamped into the payload, or one of the shared
    // TYPE_* constants for kinds whose type never varies); later phases
    // only read. Callers that store the result clone at their site.
    til_type := func(self: Expr) returns ref Type {
        switch self.node_type {
        case .Body:        return TYPE_NONE
        case .Literal(Literal.Str):  return TYPE_STR
        case .Literal(Literal.Num(nd)):
            // An un-narrowed numeric literal reports its DEFAULT type. That
            // default follows the text: a fractional or exponent literal is a
            // float, everything else an integer. Answering I64 for `1.5` made
            // every consumer treat it as an integer -- the constfolder then
            // converted the literal's own text and died with
            // "Str.to_i64: invalid char in '1.5'", pointing into src/core with
            // no user file or line. F32 is til's only float type.
            if nd.til_type.is(Type.Unknown) {
                if nd.is_float() { return TYPE_F32 }
                return TYPE_I64
            }
            return nd.til_type
        case .Literal(Literal.Bool): return TYPE_BOOL
        case .Literal(Literal.Null): return TYPE_DYNAMIC
        case .Ident(id):   return id.til_type
        case .Decl(dd):    return dd.til_type
        case .Assign:
            if self.children.len() == 0 { return TYPE_UNKNOWN }
            return self.children[0].til_type()
        case .Literal(Literal.MapLit):      return TYPE_MAP
        case .Literal(Literal.SetLit):      return TYPE_SET
        case .NamedArg:
            if self.children.len() == 0 { return TYPE_UNKNOWN }
            return self.children[0].til_type()
        case .FCall(fcd):  return fcd.til_type
        case .FuncDef:     return TYPE_FUNCPTR
        case .BodyValue:   return TYPE_BODY
        case .StructDef:   return TYPE_STRUCTDEF
        case .EnumDef:     return TYPE_ENUMDEF
        case .FieldAccess(fd): return fd.til_type
        case .FieldAssign: return TYPE_NONE
        case .Return:
            if self.children.len() == 0 { return TYPE_NONE }
            return self.children[0].til_type()
        case .If, .While: return TYPE_NONE
        case .ForIn(fd):   return fd.til_type
        case .Break, .Continue, .Switch: return TYPE_NONE
        case .Match(md):   return md.til_type
        case .Case:        return TYPE_NONE
        case .NoDefaultArg:return TYPE_UNKNOWN
        // Issue #281: the __LOC__ sentinel stands in for a Str location literal
        // until infer_expr / the default-fill resolves it, so it types as Str.
        case .Loc:         return TYPE_STR
        case .Throw:
            if self.children.len() == 0 { return TYPE_NONE }
            return self.children[0].til_type()
        case .Catch:       return TYPE_NONE
        case .RestPattern, .ListPattern: return TYPE_UNKNOWN
        case .CaptureBlock: return TYPE_NONE
        case .PrecomputedSequence(sd): return sd.til_type
        }
        return TYPE_UNKNOWN
    }
    set_til_type := func(mut self: Expr, shallow t: Type) {
        switch self.node_type {
        case .Literal(Literal.Num(nd)):
            nd.til_type = t
        case .Ident(id):
            id.til_type = t
        case .Decl(dd):
            dd.til_type = t
        case .FCall(fcd):
            fcd.til_type = t
        case .FieldAccess(fd):
            fd.til_type = t
        case .ForIn(fd):
            fd.til_type = t
        case .Match(md):
            md.til_type = t
        case .PrecomputedSequence(sd):
            sd.til_type = t
        case .Throw:
            if self.children.len() > 0 {
                self.children[0].set_til_type(t)
            }
        case:
        }
    }
    // Backing implementation for to_str. Produces format B-hybrid:
    //   leaf (no children):        (Head)
    //   with children:             ((Head)\n  c1\n  c2 ...)
    // where Head = NodeType variant name + inline payload (see
    // NodeType.head_str).
    to_str_indent_with_symbols := func(self: Expr, names: Vec(Str), indent: U32) returns Str {
        mut out := ""
        for _ in 0..indent {
            out = format(out, "  ")
        }
        head := self.node_type.head_str(names)
        if self.children.len() == 0 {
            return format(out, "(", head, ")")
        }
        out = format(out, "((", head, ")")
        for c : Expr in self.children {
            out = format(out, "\n", c.to_str_indent_with_symbols(names, indent + 1))
        }
        return format(out, ")")
    }
    to_str_with_symbols := func(self: Expr, names: Vec(Str)) returns Str {
        return self.to_str_indent_with_symbols(names, 0)
    }
    // Generic T.to_str contract. An Expr no longer carries enough state to
    // render FieldAccess names by itself; every real AST renderer has a pool.
    to_str := func(_self: Expr) returns Str {
        panic("Expr.to_str needs a SymbolPool; use to_str_with_symbols")
    }
}

// --- Payload accessors (issue #253) ---

// Borrow the payload of an Expr whose NodeType variant the caller ALREADY
// knows, so a site that means "extract this payload" reads as one binding:
//
//     ref fd : FunctionDef = funcdef_of(e)
//
// instead of a whole switch whose default can never run. The borrow aliases
// the node, so writes through it land in the AST (the parser builds struct
// and enum bodies exactly this way).
//
// A mismatch is a broken invariant, not a case to handle, so these die
// loudly. `loc` defaults to the CALL SITE -- see the __LOC__ note at the top
// of core/exit.til -- so the panic points at the code that made the wrong
// assumption rather than at this file. Where the variant is genuinely in
// question, switch on it (or use an Option-returning lookup) instead: an
// accessor is for "extract or die", never for "check whether".
//
// No trailing `return` after UNREACHABLE: it is noreturn, so the body
// diverges on that path and the builder closes it with
// __builtin_unreachable() (see stmt_always_diverges in self/context.til).

ident_of := func(e: Expr, loc: Str = __LOC__) returns ref IdentData {
    switch e.node_type {
    case .Ident(d):
        return d
    case:
        UNREACHABLE("expected Ident", loc = loc)
    }
}

decl_of := func(e: Expr, loc: Str = __LOC__) returns ref Declaration {
    switch e.node_type {
    case .Decl(d):
        return d
    case:
        UNREACHABLE("expected Decl", loc = loc)
    }
}

fcall_of := func(e: Expr, loc: Str = __LOC__) returns ref FCallData {
    switch e.node_type {
    case .FCall(d):
        return d
    case:
        UNREACHABLE("expected FCall", loc = loc)
    }
}

funcdef_of := func(e: Expr, loc: Str = __LOC__) returns ref FunctionDef {
    switch e.node_type {
    case .FuncDef(d):
        return d
    case:
        UNREACHABLE("expected FuncDef", loc = loc)
    }
}

fieldaccess_of := func(e: Expr, loc: Str = __LOC__) returns ref FieldAccessData {
    switch e.node_type {
    case .FieldAccess(d):
        return d
    case:
        UNREACHABLE("expected FieldAccess", loc = loc)
    }
}

structdef_of := func(e: Expr, loc: Str = __LOC__) returns ref StructDef {
    switch e.node_type {
    case .StructDef(d):
        return d
    case:
        UNREACHABLE("expected StructDef", loc = loc)
    }
}

enumdef_of := func(e: Expr, loc: Str = __LOC__) returns ref EnumDef {
    switch e.node_type {
    case .EnumDef(d):
        return d
    case:
        UNREACHABLE("expected EnumDef", loc = loc)
    }
}

case_of := func(e: Expr, loc: Str = __LOC__) returns ref CaseData {
    switch e.node_type {
    case .Case(d):
        return d
    case:
        UNREACHABLE("expected Case", loc = loc)
    }
}

// --- Case-node shape readers (issue #334) ---
// A Case's children are [pattern x N, guard?, body]; the payload records N.
// Every reader must go through these instead of doing arithmetic on
// children.len(): the count alone cannot tell a second pattern from a guard.
// (The body needs no helper -- it is always the LAST child.)

case_pattern_count := func(cn: Expr) returns USize {
    return case_of(cn).pattern_count
}

case_has_guard := func(cn: Expr) returns Bool {
    return cn.children.len() > case_pattern_count(cn) + 1
}
