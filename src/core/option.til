mode lib

import("bool")

/// Optional value, ala Rust's Option<T> (#320): Some carries a value of
/// type T, None carries nothing. ONE template serves owned payloads
/// (Option(X)) and borrowed ones (Option(ref X)) via ref-qualified type
/// arguments; a borrowed Some shares its pointee (the enum does not own
/// it). Option(ref T) is the shape #321's NULL removal migrates ref
/// fields and lookup returns onto.
Option := macro(T: Type) returns EnumDef {
    return enum {
        None
        Some: T
    namespace:
        is_some := func(self: Option(T)) returns Bool {
            switch self {
            case .Some(_v): return true
            case: return false
            }
        }
        is_none := func(self: Option(T)) returns Bool {
            return self.is_some().not()
        }
        unwrap_or := func(self: Option(T), default_v: T) returns T {
            switch self {
            case .Some(v): return v
            case: return default_v
            }
        }
        /// The contained value; PANICS on None, ala Rust's unwrap. For the
        /// ~if o.is_none() { ... }~ + ~o.unwrap()~ idiom, where the caller
        /// has already handled absence and unwrapping cannot fail. Prefer
        /// a ~switch~ when both arms do real work, and ~unwrap_or~ when a
        /// default is meaningful -- reach for this only when None is
        /// unreachable by construction, so it fails loudly if that ever
        /// stops being true.
        unwrap := func(self: Option(T)) returns T {
            switch self {
            case .Some(v): return v
            case: panic(__LOC__, "unwrap of a None Option")
            }
        }
        /// The contained value, MOVED out; PANICS on None, like unwrap.
        /// unwrap only BORROWS self, so for an owned payload it must hand
        /// back a deep clone; this consumes the Option instead, so the
        /// payload's bytes move and only the enum shell is freed (#321).
        /// Use it wherever the caller takes ownership of what the Option
        /// held -- an ~Option(Expr)~ returned by an AST helper, say, where
        /// a clone would copy a whole subtree and break node identity.
        take := func(own self: Option(T)) returns T {
            switch self {
            case .Some(v): return v
            case: panic(__LOC__, "take of a None Option")
            }
        }
    }
}
