mode lib

import("array")
import("ast")
import("bool")
import("dyn")
import("numbers")
import("str")
import("vec")

/// Heterogeneous sequence of values with mixed types.
Tuple := struct {
    own data : U8 = 0
    total_size : USize = 0
    cap : USize = 0
    type_names := Vec(Str).new()
    type_sizes := Vec(USize).new()

namespace:
    /// Create an empty Tuple.
    new := func() returns Tuple {
        return Tuple(data = malloc(8), cap = 8)
    }

    len := func(self: Tuple) returns USize { return self.type_names.len() }

    /// Internal helper that keeps tuple metadata as string type names.
    push_type_name := func(mut self: Tuple, own elem_type: Str, own val: Dynamic) {
        elem_size : USize = dyn_size_of(elem_type)
        new_total := self.total_size + elem_size
        if new_total > self.cap {
            mut new_cap := self.cap * 2
            while new_cap < new_total {
                new_cap = new_cap * 2
            }
            self.data = realloc(own self.data, new_cap)
            self.cap = new_cap
        }
        memcpy(ptr_add(self.data, self.total_size), val, elem_size)
        free(own val)
        self.type_names.push(own elem_type.clone())
        self.type_sizes.push(own elem_size.clone())
        self.total_size = new_total
    }

    /// Append a value of the given type. ~val~ is owned.
    push := func(mut self: Tuple, T: Type, own val: Dynamic) {
        elem_type := dyn_type_to_str(T)
        self.push_type_name(own elem_type, own val)
    }

    /// Ref to element at index ~i~. Panics if out of bounds.
    get := func(self: Tuple, i: USize) returns ref Dynamic {
        if i >= self.type_names.len() {
            panic("Tuple.get: index ", i.to_str(), " out of bounds (len ", self.type_names.len().to_str(), ")")
        }
        mut offset : USize = 0
        for j in 0..i {
            offset = offset + self.type_sizes[j]
        }
        return ptr_add(self.data, offset)
    }

    /// #392: append every element of a raw Dynamic array, each pushed AS
    /// "Dynamic" -- a word copied, never dereferenced, deleted as a no-op --
    /// so raw pointers keep raw semantics inside the tuple. The ..Dynamic
    /// variadic lowering splats an Array(Dynamic) through this; written in
    /// til (like Array.concat / Array.to_vec before it) because the desugar
    /// runs inside infer_body and a hand-built loop there would carry
    /// til_types and ownership no later pass re-checks. ~arr~ is borrowed:
    /// a splatted array stays usable at the call site.
    push_all_dynamic := func(mut self: Tuple, arr: Array(Dynamic)) {
        for i in 0..arr.len() {
            mut val : U8 = malloc(8)
            memcpy(val, arr.unsafe_get(i), 8)
            self.push_type_name(own "Dynamic", own val)
        }
    }

    /// #392 stage B: panic unless element ~i~ really is a ~want~. A Tuple
    /// element carries its type, so reading one at a typed binding can be
    /// CHECKED -- the gradual-typing bargain, where a lie about a dynamic
    /// value fails at runtime instead of quietly reinterpreting bytes
    /// (reading an I64 element as a Str used to answer len 0).
    ///
    /// An element tagged "Dynamic" is exempt: that tag means a raw word --
    /// a C pointer, a #302 raw allocation, a splatted Array(Dynamic)
    /// element -- whose reinterpretation is the caller's business and
    /// always was. Dynamic means you are on your own, and this keeps it so.
    ///
    /// A typed read reaches this through ~get_checked~ below; calling it
    /// by hand, ahead of an unchecked read, reads the same way.
    expect_type := func(self: Tuple, i: USize, want: Str) {
        if i >= self.type_names.len() {
            panic("Tuple.expect_type: index ", i.to_str(), " out of bounds (len ",
                  self.type_names.len().to_str(), ")")
        }
        ref got : Str = self.type_names[i]
        if got == "Dynamic" { return }
        if got.eq(want).not() {
            panic("Tuple element ", i.to_str(), " is a '", got, "', read as a '", want,
                  "'; ask type_at(", i.to_str(), ") before reading a dynamic value")
        }
    }

    /// #392 stage B: ~get~ with the READ's static type in hand. A typed
    /// binding (`ref a : I64 = t.get(0)`) lowers to this, so the read is
    /// checked against what the element actually is instead of
    /// reinterpreting its bytes. ~expect_type~ decides; see it for why a
    /// "Dynamic" element is exempt.
    get_checked := func(self: Tuple, i: USize, want: Str) returns ref Dynamic {
        self.expect_type(i, want)
        return self.get(i)
    }

    /// Type name of the element at index ~i~. Panics if ~i~ is past
    /// the end.
    type_at := func(self: Tuple, i: USize) returns ref Str {
        return self.type_names[i]
    }

    /// Byte size of the element at index ~i~. Panics if ~i~ is past
    /// the end.
    size_at := func(self: Tuple, i: USize) returns ref USize {
        return self.type_sizes[i]
    }

    delete := func(own self: Tuple, call_free: Bool = true) {
        mut offset : USize = 0
        for i in 0..self.type_names.len() {
            ref tn : Str = self.type_names[i]
            ref ts : USize = self.type_sizes[i]
            dyn_call(tn, "delete", 2, ptr_add(self.data, offset), false)
            offset = offset + ts
        }
        free(own self.data)
        self.type_names.clear()
        self.type_sizes.clear()
        free(own self.type_names.data)
        free(own self.type_sizes.data)
        if call_free { free(own self) }
    }

    clone := func(self: Tuple) returns Tuple {
        mut new_cap := self.cap
        if new_cap == 0 { new_cap = 8 }
        mut new_data : U8 = malloc(new_cap)
        mut offset : USize = 0
        for i in 0..self.type_names.len() {
            ref tn : Str = self.type_names[i]
            ref ts : USize = self.type_sizes[i]
            cloned : Dynamic = dyn_call_ret(tn, "clone", 1, ptr_add(self.data, offset))
            memcpy(ptr_add(new_data, offset), cloned, ts)
            free(own cloned)
            offset = offset + ts
        }
        return Tuple(data = new_data, total_size = self.total_size, cap = new_cap,
                     type_names = self.type_names.clone(),
                     type_sizes = self.type_sizes.clone())
    }
}
