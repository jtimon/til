mode lib

import("str")

print_single := ext_proc(s: Str) {}
eprint_single := ext_proc(s: Str) {}
print_flush := ext_proc() {}

/// Print strings to stdout followed by a newline.
//
// REM: unreachable from til source as of the parser's println desugar --
// `println(a, b)` is rewritten to `print(a, b, "\n")` before this proc can
// ever be resolved (parser.til, desugar_println_call). It survives only to
// keep the BOOTSTRAP compiler working: til_boot is built from the previous
// commit, its parser has no desugar, and it still resolves the source tree's
// `println(...)` call sites against this declaration. Once the desugar has
// been merged to master, til_boot has it baked in, and this proc plus the
// print_flush extern below can go (doc/self.org, "Staged migration across
// master merges").
println := proc(parts: ..Str) {
    for s : Str in parts {
        print_single(s)
    }
    print_flush()
}

/// Print strings to stdout without a newline.
print := proc(parts: ..Str) {
    for s : Str in parts {
        print_single(s)
    }
}

// File handle I/O (the File struct and cfile_* externs) lives in
// src/std/file.til -- import("std/file") -- and stdin line input
// (in_read_line) in src/std/sys.til, so restricted modes can ban
// filesystem and stdin access by banning the import (see #215/#216).
