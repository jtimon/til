mode lib

import("ast")
import("bool")
import("dyn")
import("numbers")
import("str")
import("vec")

array := ext_func(T: Type, elements: ..Dynamic) returns Array {}

priv array_ref_store := macro(Element: Type) returns FuncDef {
    if type_arg_is_interface(Element) {
        return func(mut self: Array(Element), i: USize, val: Element) {
            memcpy(self.slot(i), val, Element.size().to_uptr())
        }
    } else {
        return func(mut self: Array(Element), i: USize, val: Element) { write_ptr(self.slot(i), val) }
    }
}

/// Fixed-capacity array of typed elements.
Array := macro(T: Type) returns StructDef {
    if type_arg_is_ref(T) {
        return struct {
            own data: U8 = 0
            const cap: USize = 0
        namespace:
            priv slot_size := func() returns USize {
                if type_arg_is_interface(T) { return T.size() }
                return UPtr.size()
            }
            priv slot := func(self: Array(T), i: USize) returns ref Dynamic {
                return ptr_add(self.data, i.to_uptr().mul(Array(T).slot_size().to_uptr()))
            }
            priv store := array_ref_store(T)
            new := func(cap: USize) returns Array(T) {
                if cap == 0 { return Array(T)() }
                return Array(T)(data = calloc(cap.to_uptr(), Array(T).slot_size().to_uptr()), cap = cap)
            }
            len := func(self: Array(T)) returns USize { return self.cap }
            unsafe_get := func(self: Array(T), i: USize) returns ref T {
                // new() leaves slots uninitialized; neither an ordinary null
                // reference nor an empty interface handle is a valid element.
                if deref(self.slot(i)).is_null() { panic("Array.get: uninitialized borrowed element") }
                if type_arg_is_interface(T) { return self.slot(i) }
                return deref(self.slot(i))
            }
            get := func(self: Array(T), shallow i: USize) returns ref T throws OutOfBounds {
                if i < self.cap { return self.unsafe_get(i) }
                throw OutOfBounds()
            }
            unsafe_set := func(mut self: Array(T), i: USize, val: T) { self.store(i, val) }
            set := func(mut self: Array(T), i: USize, val: T) throws OutOfBounds {
                if i < self.cap { self.unsafe_set(i, val); return }
                throw OutOfBounds()
            }
            clone := func(self: Array(T)) returns Array(T) {
                mut out := Array(T).new(self.cap)
                if self.cap > 0 { memcpy(out.data, self.data, self.cap.to_uptr().mul(Array(T).slot_size().to_uptr())) }
                return out
            }
            concat := func(self: Array(T), other: Array(T)) returns Array(T) {
                mut out := Array(T).new(self.cap + other.cap)
                if self.cap > 0 { memcpy(out.data, self.data, self.cap.to_uptr().mul(Array(T).slot_size().to_uptr())) }
                if other.cap > 0 { memcpy(out.slot(self.cap), other.data, other.cap.to_uptr().mul(Array(T).slot_size().to_uptr())) }
                return out
            }
            to_vec := func(self: Array(T)) returns Vec(T) {
                for i in 0..self.cap { self.unsafe_get(i) }
                mut out := Vec(T).with_capacity(self.cap)
                if self.cap > 0 { memcpy(out.data, self.data, self.cap.to_uptr().mul(Array(T).slot_size().to_uptr())) }
                out.count = self.cap
                return out
            }
            delete := func(own self: Array(T), call_free: Bool = true) {
                free(own self.data)
                if call_free { free(own self) }
            }
        }
    } else {
    return struct {
    own data : U8 = 0
    const cap : USize = 0

namespace:
    /// Create a zero-initialized Array with the given capacity.
    new := func(cap: USize) returns Array(T) {
        return Array(T)(data = calloc(cap.to_uptr(), T.size().to_uptr()), cap = cap)
    }

    len := func(self: Array(T)) returns USize { return self.cap }

    /// Unchecked element access: ref to the element at index ~i~ with
    /// NO bounds check. The caller must prove ~i < len()~. This is the
    /// unchecked core that ~get~ wraps; for-in uses it directly because
    /// its ~_fi < len()~ termination test already proves the index in
    /// bounds (issue #284).
    unsafe_get := func(self: Array(T), i: USize) returns ref T {
        return ptr_add(self.data, i.to_uptr().mul(T.size().to_uptr()))
    }

    /// Ref to the element at index ~i~. Throws OutOfBounds if ~i~ is
    /// past the end; call as ~arr.get(i)!~ to panic on a bad index.
    get := func(self: Array(T), shallow i: USize) returns ref T throws OutOfBounds {
        // Throw LAST, so the throws lowering has no following statement to
        // wrap in its `if _err_kind == 0` re-check. Same shape as Vec.get.
        if i < self.cap {
            return self.unsafe_get(i)
        }
        throw OutOfBounds()
    }

    /// Overwrite the element at index ~i~ without a bounds check, dropping
    /// the old value. Caller guarantees ~i < self.cap~; the write-side
    /// mirror of unsafe_get (issue #284).
    unsafe_set := func(mut self: Array(T), i: USize, own val: T) {
        T.delete(own self.unsafe_get(i), false)
        adopt(T, self.unsafe_get(i), own val)
    }

    /// Overwrite the element at index ~i~. Drops the old value. ~val~ is
    /// owned. Throws OutOfBounds if ~i~ is past the end; call as
    /// ~arr[i] = val~ (or ~arr.set(i, own val)!~) to panic on a bad index.
    set := func(mut self: Array(T), i: USize, own val: T) throws OutOfBounds {
        if i >= self.cap {
            throw OutOfBounds()
        }
        self.unsafe_set(i, own val)
    }

    delete := func(own self: Array(T), call_free: Bool = true) {
        for i in 0..self.cap {
            T.delete(own ptr_add(self.data, i.to_uptr().mul(T.size().to_uptr())), false)
        }
        free(own self.data)
        if call_free { free(own self) }
    }

    /// #342: a fresh Array holding ~self~'s elements followed by ~other~'s.
    /// Both sources keep theirs -- every element is cloned, exactly as
    /// ~clone~ does -- so neither is moved out from under its owner. The
    /// mixed-splat variadic lowering builds its collector with this: the
    /// fixed arguments become one Array, the splatted Array is the other,
    /// and the call is then the pure-splat form the desugar already handles.
    concat := func(self: Array(T), other: Array(T)) returns Array(T) {
        total : USize = self.cap.add(other.cap)
        mut new_data : U8 = malloc(total.to_uptr().mul(T.size().to_uptr()))
        for i in 0..self.cap {
            ref src : T = ptr_add(self.data, i.to_uptr().mul(T.size().to_uptr()))
            mut cloned : T = T.clone(src)
            adopt(T, ptr_add(new_data, i.to_uptr().mul(T.size().to_uptr())), own cloned)
        }
        for j in 0..other.cap {
            ref osrc : T = ptr_add(other.data, j.to_uptr().mul(T.size().to_uptr()))
            mut ocloned : T = T.clone(osrc)
            adopt(T, ptr_add(new_data, self.cap.add(j).to_uptr().mul(T.size().to_uptr())), own ocloned)
        }
        return Array(T)(data = new_data, cap = total)
    }

    /// #342: a fresh Vec holding a clone of every element, ~self~ intact.
    /// The ~vec(T, x, ..arr)~ lowering ends here: a splat's length is a
    /// runtime value, so the literal's block is folded into one Array with
    /// ~concat~ and converted, instead of the desugar hand-building a push
    /// loop whose nodes no later pass would infer.
    to_vec := func(self: Array(T)) returns Vec(T) {
        mut out : Vec(T) = Vec(T).with_capacity(self.cap)
        for i in 0..self.cap {
            ref src : T = ptr_add(self.data, i.to_uptr().mul(T.size().to_uptr()))
            mut cloned : T = T.clone(src)
            out.push(own cloned)
        }
        return out
    }

    clone := func(self: Array(T)) returns Array(T) {
        mut new_data : U8 = malloc(self.cap.to_uptr().mul(T.size().to_uptr()))
        for i in 0..self.cap {
            ref src : T = ptr_add(self.data, i.to_uptr().mul(T.size().to_uptr()))
            mut cloned : T = T.clone(src)
            adopt(T, ptr_add(new_data, i.to_uptr().mul(T.size().to_uptr())), own cloned)
        }
        return Array(T)(data = new_data, cap = self.cap)
    }
}
    }
}
