mode lib

import("ast")
import("bool")
import("dyn")
import("numbers")
import("str")

/// Unordered collection of unique typed elements.
Set := struct<T: Type> {
    own data : U8 = 0
    count : USize = 0
    cap : USize = 0

namespace:
    /// Create an empty Set. T must implement ~cmp~. Allocates nothing:
    /// like Vec.new, an empty Set is lazy (cap 0) and ~add~ seeds the
    /// first slot. Short-lived empty Sets are common -- the garbager
    /// builds four per statement for its per-statement name facts, most
    /// of them never added to.
    new := func() returns Set(T) {
        return Set(T)(cap = 0)
    }

    /// Create an empty Set pre-sized for ~n~ elements, so adding up to
    /// ~n~ reallocs zero times (Vec.with_capacity's counterpart). Use it
    /// where the final size is known or well predicted; ~new()~ grows
    /// 0->1->2->4, which is the right default but costs a realloc per
    /// doubling. n=0 behaves like new(): lazy-empty, no allocation.
    with_capacity := func(n: USize) returns Set(T) {
        if n == 0 { return Set(T)(cap = 0) }
        return Set(T)(data = malloc(n.mul(T.size())), cap = n)
    }

    len := func(self: Set(T)) returns USize { return self.count }

    /// Drop all live elements but keep the allocated storage so the Set can be reused.
    clear := func(mut self: Set(T)) {
        for i in 0..self.count {
            T.delete(own ptr_add(self.data, i.mul(T.size())), false)
        }
        self.count = 0
    }

    /// True if the set contains an element equal to ~val~.
    has := func(self: Set(T), val: T) returns Bool {
        mut lo : USize = 0
        mut hi := self.count
        while lo < hi {
            mid := lo.add(hi.sub(lo) / 2)
            ref cur : T = ptr_add(self.data, mid.mul(T.size()))
            c : I64 = T.cmp(cur, val)
            if c < 0 { lo = mid + 1 }
            else {
                if c > 0 { hi = mid }
                else { return true }
            }
        }
        return false
    }

    /// Insert ~val~ into the set (sorted order). If an equal element
    /// already exists, ~val~ is dropped. ~val~ is owned.
    add := func(mut self: Set(T), own val: T) {
        mut lo : USize = 0
        mut hi := self.count
        mut found := false
        while lo < hi {
            mid := lo.add(hi.sub(lo) / 2)
            ref cur : T = ptr_add(self.data, mid.mul(T.size()))
            c : I64 = T.cmp(cur, val)
            if c < 0 { lo = mid + 1 }
            else {
                if c > 0 { hi = mid }
                else { found = true; lo = mid; hi = mid }
            }
        }
        if found {
            // Nothing blanks the box between the two: the memset that
            // used to sit here was dead either way. For a literal Str the
            // builder gates it on `cap != TIL_CAP_LIT` (the same guard the
            // free carries), so it never ran; for a real box it zeroed
            // bytes that the next line frees.
            T.delete(own val, false)
            free(own val)
        } else {
            if self.count == self.cap {
                // cap 0 (lazy-empty) doubles to 0, so seed the first grow
                // to 1. realloc(NULL, n) behaves as malloc(n).
                mut new_cap := self.cap * 2
                if self.cap == 0 { new_cap = 1 }
                self.data = realloc(own self.data, new_cap.mul(T.size()))
                self.cap = new_cap
            }
            memmove(ptr_add(self.data, lo.add(1).mul(T.size())),
                    ptr_add(self.data, lo.mul(T.size())),
                    self.count.sub(lo).mul(T.size()))
            adopt(T, ptr_add(self.data, lo.mul(T.size())), own val)
            self.count = self.count + 1
        }
    }

    /// Remove the element equal to ~val~, dropping it. Returns false if
    /// absent (Map.remove's counterpart: ~add~ is the Set's ~set~, so
    /// this is its removal half). Later elements shift left to keep the
    /// storage sorted and dense.
    remove := func(mut self: Set(T), val: T) returns Bool {
        mut lo : USize = 0
        mut hi := self.count
        while lo < hi {
            mid := lo.add(hi.sub(lo) / 2)
            ref cur : T = ptr_add(self.data, mid.mul(T.size()))
            c : I64 = T.cmp(cur, val)
            if c < 0 { lo = mid + 1 }
            else {
                if c > 0 { hi = mid }
                else {
                    T.delete(own ptr_add(self.data, mid.mul(T.size())), false)
                    tail := self.count.sub(mid).sub(1)
                    if tail > 0 {
                        memmove(ptr_add(self.data, mid.mul(T.size())),
                                ptr_add(self.data, mid.add(1).mul(T.size())),
                                tail.mul(T.size()))
                    }
                    self.count = self.count - 1
                    memset(ptr_add(self.data, self.count.mul(T.size())), 0, T.size())
                    return true
                }
            }
        }
        return false
    }

    delete := func(own self: Set(T), call_free: Bool = true) {
        self.clear()
        free(own self.data)
        if call_free { free(own self) }
    }

    clone := func(self: Set(T)) returns Set(T) {
        // A lazy-empty source clones to another lazy-empty Set (no
        // malloc(0)), mirroring Vec.clone.
        if self.cap == 0 { return Set(T)(cap = 0) }
        new_data : U8 = malloc(self.cap.mul(T.size()))
        for i in 0..self.count {
            ref src : T = ptr_add(self.data, i.mul(T.size()))
            mut cloned : T = T.clone(src)
            adopt(T, ptr_add(new_data, i.mul(T.size())), own cloned)
        }
        return Set(T)(data = new_data, count = self.count, cap = self.cap)
    }
}
