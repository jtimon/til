mode lib

import("ast")
import("bool")
import("dyn")
import("numbers")

priv set_ref_store := macro(Element: Type) returns FuncDef {
    if type_arg_is_interface(Element) {
        return func(mut self: Set(Element), i: USize, val: Element) {
            memcpy(self.slot(i), val, Element.size().to_uptr())
        }
    } else {
        return func(mut self: Set(Element), i: USize, val: Element) { write_ptr(self.slot(i), val) }
    }
}

/// Unordered collection of unique typed elements.
Set := macro(T: Type) returns StructDef {
    if type_arg_is_ref(T) {
        return struct {
            own data: U8 = 0
            count: USize = 0
            cap: USize = 0
        namespace:
            priv slot_size := func() returns USize {
                if type_arg_is_interface(T) { return T.size() }
                return UPtr.size()
            }
            priv slot := func(self: Set(T), i: USize) returns ref Dynamic {
                return ptr_add(self.data, i.to_uptr().mul(Set(T).slot_size().to_uptr()))
            }
            priv store := set_ref_store(T)
            new := func() returns Set(T) { return Set(T)() }
            with_capacity := func(n: USize) returns Set(T) {
                if n == 0 { return Set(T)() }
                return Set(T)(data = malloc(n.to_uptr().mul(Set(T).slot_size().to_uptr())), cap = n)
            }
            len := func(self: Set(T)) returns USize { return self.count }
            unsafe_get := func(self: Set(T), i: USize) returns ref T {
                if type_arg_is_interface(T) { return self.slot(i) }
                return deref(self.slot(i))
            }
            clear := func(mut self: Set(T)) { self.count = 0 }
            priv position := func(self: Set(T), val: T) returns USize {
                mut lo: USize = 0
                mut hi := self.count
                while lo < hi {
                    mid := lo + (hi - lo) / 2
                    if T.cmp(self.unsafe_get(mid), val) < 0 { lo = mid + 1 }
                    else { hi = mid }
                }
                return lo
            }
            has := func(self: Set(T), val: T) returns Bool {
                i := self.position(val)
                if i < self.count { return T.cmp(self.unsafe_get(i), val) == 0 }
                return false
            }
            add := func(mut self: Set(T), val: T) {
                i := self.position(val)
                if i < self.count {
                    if T.cmp(self.unsafe_get(i), val) == 0 { return }
                }
                if self.count == self.cap {
                    mut capacity := self.cap * 2
                    if capacity == 0 { capacity = 1 }
                    self.data = realloc(own self.data, capacity.to_uptr().mul(Set(T).slot_size().to_uptr()))
                    self.cap = capacity
                }
                memmove(self.slot(i + 1), self.slot(i), (self.count - i).to_uptr().mul(Set(T).slot_size().to_uptr()))
                self.store(i, val)
                self.count++
            }
            remove := func(mut self: Set(T), val: T) returns Bool {
                i := self.position(val)
                if i >= self.count { return false }
                if T.cmp(self.unsafe_get(i), val) == 0 {
                    remaining := self.count - i - 1
                    if remaining > 0 { memmove(self.slot(i), self.slot(i + 1), remaining.to_uptr().mul(Set(T).slot_size().to_uptr())) }
                    self.count--
                    return true
                }
                return false
            }
            clone := func(self: Set(T)) returns Set(T) {
                mut out := Set(T).with_capacity(self.cap)
                if self.count > 0 { memcpy(out.data, self.data, self.count.to_uptr().mul(Set(T).slot_size().to_uptr())) }
                out.count = self.count
                return out
            }
            delete := func(own self: Set(T), call_free: Bool = true) {
                free(own self.data)
                if call_free { free(own self) }
            }
        }
    } else {
    return struct {
    own data : U8 = 0
    count : USize = 0
    cap : USize = 0

namespace:
    /// Create an empty Set. T must implement ~cmp~. Allocates nothing:
    /// like Vec.new, an empty Set is lazy (cap 0) and ~add~ seeds the
    /// first slot. Short-lived empty Sets are common -- the garbager
    /// builds four per statement for its per-statement name facts, most
    /// of them never added to.
    new := func() returns Set(T) {
        return Set(T)(cap = 0)
    }

    /// Create an empty Set pre-sized for ~n~ elements, so adding up to
    /// ~n~ reallocs zero times (Vec.with_capacity's counterpart). Use it
    /// where the final size is known or well predicted; ~new()~ grows
    /// 0->1->2->4, which is the right default but costs a realloc per
    /// doubling. n=0 behaves like new(): lazy-empty, no allocation.
    with_capacity := func(n: USize) returns Set(T) {
        if n == 0 { return Set(T)(cap = 0) }
        return Set(T)(data = malloc(n.to_uptr().mul(T.size().to_uptr())), cap = n)
    }

    len := func(self: Set(T)) returns USize { return self.count }

    /// Unchecked element access: return a reference to the element at
    /// index ~i~ (in sorted order) with NO bounds check. The caller must
    /// prove ~i < len()~. This is what makes ~for x in set~ work: for-in
    /// uses ~unsafe_get~ when a type has it, and its ~_fi < len()~
    /// termination test proves the index in bounds (issue #284).
    unsafe_get := func(self: Set(T), i: USize) returns ref T {
        return ptr_add(self.data, i.to_uptr().mul(T.size().to_uptr()))
    }

    /// Drop all live elements but keep the allocated storage so the Set can be reused.
    clear := func(mut self: Set(T)) {
        for i in 0..self.count {
            T.delete(own ptr_add(self.data, i.to_uptr().mul(T.size().to_uptr())), false)
        }
        self.count = 0
    }

    /// True if the set contains an element equal to ~val~.
    has := func(self: Set(T), val: T) returns Bool {
        mut lo : USize = 0
        mut hi := self.count
        while lo < hi {
            mid := lo.add(hi.sub(lo) / 2)
            ref cur : T = ptr_add(self.data, mid.to_uptr().mul(T.size().to_uptr()))
            c : I64 = T.cmp(cur, val)
            if c < 0 { lo = mid + 1 }
            else {
                if c > 0 { hi = mid }
                else { return true }
            }
        }
        return false
    }

    /// Insert ~val~ into the set (sorted order). If an equal element
    /// already exists, ~val~ is dropped. ~val~ is owned.
    add := func(mut self: Set(T), own val: T) {
        mut lo : USize = 0
        mut hi := self.count
        mut found := false
        while lo < hi {
            mid := lo.add(hi.sub(lo) / 2)
            ref cur : T = ptr_add(self.data, mid.to_uptr().mul(T.size().to_uptr()))
            c : I64 = T.cmp(cur, val)
            if c < 0 { lo = mid + 1 }
            else {
                if c > 0 { hi = mid }
                else { found = true; lo = mid; hi = mid }
            }
        }
        if found {
            // Nothing blanks the box between the two: the memset that
            // used to sit here was dead either way. For a literal Str the
            // builder gates it on `cap != TIL_CAP_LIT` (the same guard the
            // free carries), so it never ran; for a real box it zeroed
            // bytes that the next line frees.
            T.delete(own val, false)
            free(own val)
        } else {
            if self.count == self.cap {
                // cap 0 (lazy-empty) doubles to 0, so seed the first grow
                // to 1. realloc(NULL, n) behaves as malloc(n).
                mut new_cap := self.cap * 2
                if self.cap == 0 { new_cap = 1 }
                self.data = realloc(own self.data, new_cap.to_uptr().mul(T.size().to_uptr()))
                self.cap = new_cap
            }
            memmove(ptr_add(self.data, lo.add(1).to_uptr().mul(T.size().to_uptr())),
                    ptr_add(self.data, lo.to_uptr().mul(T.size().to_uptr())),
                    self.count.sub(lo).to_uptr().mul(T.size().to_uptr()))
            adopt(T, ptr_add(self.data, lo.to_uptr().mul(T.size().to_uptr())), own val)
            self.count = self.count + 1
        }
    }

    /// Remove the element equal to ~val~, dropping it. Returns false if
    /// absent (Map.remove's counterpart: ~add~ is the Set's ~set~, so
    /// this is its removal half). Later elements shift left to keep the
    /// storage sorted and dense.
    remove := func(mut self: Set(T), val: T) returns Bool {
        mut lo : USize = 0
        mut hi := self.count
        while lo < hi {
            mid := lo.add(hi.sub(lo) / 2)
            ref cur : T = ptr_add(self.data, mid.to_uptr().mul(T.size().to_uptr()))
            c : I64 = T.cmp(cur, val)
            if c < 0 { lo = mid + 1 }
            else {
                if c > 0 { hi = mid }
                else {
                    T.delete(own ptr_add(self.data, mid.to_uptr().mul(T.size().to_uptr())), false)
                    tail := self.count.sub(mid).sub(1)
                    if tail > 0 {
                        memmove(ptr_add(self.data, mid.to_uptr().mul(T.size().to_uptr())),
                                ptr_add(self.data, mid.add(1).to_uptr().mul(T.size().to_uptr())),
                                tail.to_uptr().mul(T.size().to_uptr()))
                    }
                    self.count = self.count - 1
                    memset(ptr_add(self.data, self.count.to_uptr().mul(T.size().to_uptr())), 0, T.size().to_uptr())
                    return true
                }
            }
        }
        return false
    }

    delete := func(own self: Set(T), call_free: Bool = true) {
        self.clear()
        free(own self.data)
        if call_free { free(own self) }
    }

    clone := func(self: Set(T)) returns Set(T) {
        // A lazy-empty source clones to another lazy-empty Set (no
        // malloc(0)), mirroring Vec.clone.
        if self.cap == 0 { return Set(T)(cap = 0) }
        mut new_data : U8 = malloc(self.cap.to_uptr().mul(T.size().to_uptr()))
        for i in 0..self.count {
            ref src : T = ptr_add(self.data, i.to_uptr().mul(T.size().to_uptr()))
            mut cloned : T = T.clone(src)
            adopt(T, ptr_add(new_data, i.to_uptr().mul(T.size().to_uptr())), own cloned)
        }
        return Set(T)(data = new_data, count = self.count, cap = self.cap)
    }
}
    }
}
