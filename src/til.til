mode cli

BASE_VERSION := "0.0.1-"

get_version := macro() returns shallow Str {
    mut hash : Str = ""
    run_cmd(hash, "git", "rev-parse", "--short", "HEAD")
    hash = hash.replace("\n", "")
    return format(BASE_VERSION, hash)
}

VERSION := get_version()

// Import self-hosted modules
import("std/sys")
import("std/file")
import("self/loader")
import("self/builder")
import("self/interpreter")
import("self/binder")
import("self/repl_editor")
link("vendor/raylib/src/libraylib.a")
link("m")
link("pthread")
link("rt")
link("vendor/tinyfiledialogs/libtinyfd.a")
link("vendor/nng/libnng.a")
link("atomic")

link("dl")

// --- External C bridges ---

get_bin_dir := ext_proc() returns Str {}
get_cwd_str := ext_proc() returns Str {}

// --- CLI ---

// The one prompt string, built the same way for both input paths. The
// editor needs it as a value (redraw has to know its width); the
// redirected path just prints it, byte for byte what it printed before.
priv repl_prompt := func(mode_name: Str, continuation: Bool) returns Str {
    if continuation { return format("til[", mode_name, "]... ") }
    return format("til[", mode_name, "]> ")
}

// Read one line of REPL input. Returns the line (without trailing newline);
// sets `eof` when stdin is exhausted, which an empty line alone does not
// distinguish (both come back as "").
//
// Interactive (#332): the til editor in src/self/repl_editor.til owns the
// prompt, the keys, and the history. Redirected: the unchanged
// in_read_line path, with no terminal escapes and no history I/O.
priv repl_read_line := proc(mut ed: ReplEditor, mode_name: Str, continuation: Bool, mut eof: Bool) returns Str {
    prompt := repl_prompt(mode_name, continuation)
    if ed.interactive {
        return repl_editor_read_line(ed, prompt, eof)
    }
    print_single(prompt)
    mut line := ""
    ok := in_read_line(line)
    eof = ok.not()
    if eof { return "" }
    return line
}

// Net bracket depth of a token stream; positive means the block is still open.
// Counted over TOKENS, so a brace inside a string literal or a comment does
// not open a block.
priv repl_tokens_open_depth := func(tokens: Vec(Token)) returns I64 {
    mut depth : I64 = 0
    for t : Token in tokens {
        if t.type.is(TokenType.LParen).or(t.type.is(TokenType.LBracket)).or(t.type.is(TokenType.LBrace)) {
            depth = depth + 1
        } else if t.type.is(TokenType.RParen).or(t.type.is(TokenType.RBracket)).or(t.type.is(TokenType.RBrace)) {
            depth = depth - 1
        }
    }
    return depth
}

// Read one REPL submission: a line, plus continuation lines for as long as
// brackets stay open. Every line used to be submitted on its own, so anything
// spanning lines was impossible at the prompt -- `C := struct {` alone is a
// syntax error, and the rest of the definition then landed as garbage
// statements ("undefined symbol 'c'"). Squeezing a struct with a `namespace:`
// block onto one line was the only way to declare one.
//
// EOF mid-block hands back what was typed so the parser reports the
// unterminated construct; an empty line inside an open block is just a blank
// line, not the end of input.
//
// `eof` tells the caller which of the two empty results it got: in_read_line
// returns "" for both an empty line and end of input, so pressing Enter at the
// prompt used to end the session.
repl_read_block := proc(mut ed: ReplEditor, mode_name: Str, mut eof: Bool) returns Str {
    mut block := repl_read_line(ed, mode_name, false, eof)
    if eof { return "" }
    while repl_tokens_open_depth(tokenize(block, "<repl>")) > 0 {
        next := repl_read_line(ed, mode_name, true, eof)
        if eof { return block }
        block = format(block, "\n", next)
    }
    return block
}

// Run init+typecheck on a REPL-loaded program. Returns the type-error
// count instead of panicking, so the REPL can decide what to do.
repl_typecheck := proc(mut lp: LoadedProgram) returns I32 {
    return type_program_errors(lp, false)
}

repl_capture_eval_current := proc(mut session: InterpSession, mut lp: LoadedProgram, out_path: Str, block_start_line: U32, eval_doc_line: Bool, doc_init_line: U32, mut aborted: Bool) returns Str {
    mut interpret_fwd_path := ""
    mut result : I32 = 0
    stdio_capture_begin(out_path)
    if lp.link_c_paths.len() > 0 {
        system_cmd("mkdir -p tmp")
        interpret_fwd_path = format("tmp/ffi_", clock_ms().to_str(), "_forward.h")
        result = build_forward_header_lp(interpret_fwd_path, lp)
    }
    if result == 0 { result = interp_session_prepare_context(session, lp, interpret_fwd_path) }
    if result == 0 {
        interp_session_eval_core_once(session, lp)
        interp_session_eval_imported_once(session, lp)
        aborted = interp_session_eval_current_root(session, lp, block_start_line, eval_doc_line, doc_init_line)
        interp_session_finish_context(lp)
    }
    stdio_capture_end()
    return File.readfile(out_path)
}

repl_capture_eval_tail := proc(mut session: InterpSession, mut lp: LoadedProgram, out_path: Str, start_idx: USize, count: USize, mut aborted: Bool) returns Str {
    mut interpret_fwd_path := ""
    mut result : I32 = 0
    stdio_capture_begin(out_path)
    if lp.link_c_paths.len() > 0 {
        system_cmd("mkdir -p tmp")
        interpret_fwd_path = format("tmp/ffi_", clock_ms().to_str(), "_forward.h")
        result = build_forward_header_lp(interpret_fwd_path, lp)
    }
    if result == 0 { result = interp_session_prepare_context(session, lp, interpret_fwd_path) }
    if result == 0 {
        interp_session_eval_core_once(session, lp)
        interp_session_eval_imported_once(session, lp)
        aborted = interp_session_eval_current_tail(session, lp, start_idx, count)
        interp_session_finish_context(lp)
    }
    stdio_capture_end()
    return File.readfile(out_path)
}

repl_source_line_count := func(s: Str) returns U32 {
    if s.len() == 0 { return 0 }
    mut lines : U32 = 1
    for i in 0..s.len() {
        ref ch : I8 = s.unsafe_get(i)
        if ch.eq('\n') { lines++ }
    }
    return lines
}

repl_ast_has_loader_directive := func(e: Expr) returns Bool {
    switch e.node_type {
    case .FCall:
        if e.children.len() > 0 {
            ref callee : Expr = e.children[0]
            switch callee.node_type {
            case .Ident(name):
                ref cname : Str = name.ident_name()
                if cname.eq("import").or(cname.eq("link")).or(cname.eq("link_c")) { return true }
            case:
            }
        }
    case:
    }
    for child : Expr in e.children {
        if repl_ast_has_loader_directive(child) { return true }
    }
    return false
}

repl_ast_has_lazy_def := func(e: Expr) returns Bool {
    switch e.node_type {
    case .FuncDef(fd):
        if fd.func_type.is_lazy() { return true }
    case:
    }
    for child : Expr in e.children {
        if repl_ast_has_lazy_def(child) { return true }
    }
    return false
}

repl_ast_has_known_variadic_call := func(e: Expr) returns Bool {
    switch e.node_type {
    case .FCall:
        if e.children.len() > 0 {
            ref callee : Expr = e.children[0]
            switch callee.node_type {
            case .Ident(name):
                ref cname : Str = name.ident_name()
                if or(cname.eq("println"), cname.eq("print"),
                      cname.eq("format"),
                      cname.eq("panic"), cname.eq("TODO"),
                      cname.eq("UNREACHABLE"), cname.eq("expect"),
                      cname.eq("array"), cname.eq("vec")) { return true }
            case:
            }
        }
    case:
    }
    for child : Expr in e.children {
        if repl_ast_has_known_variadic_call(child) { return true }
    }
    return false
}

// parse_errors is not optional bookkeeping: parse REPORTS a syntax error and
// hands back a PARTIAL ast. Dropping the count meant the partial body typed
// cleanly, the turn was declared a success, and the offending line joined the
// accumulated source -- where every later full load re-parsed it, reprinting
// the error once per echo-ladder attempt and running nothing new ever again.
// One `undefined_thing` bricked the prompt.
repl_delta_from_source := proc(path: Str, source: Str, mut anon_type_counter: I64, mut parse_errors: I32 = 0) returns Expr {
    tokens := tokenize(source, path)
    mut mode_out := ""
    return parse(tokens, source, path, mode_out, anon_type_counter, parse_errors)
}

// Is there an assignment `=` at bracket depth 0? `==` is its own token
// (EqEq), and a `=` inside brackets is a named call argument
// (`P(x = 1)`) or similar, so only a depth-0 Eq makes the line a
// statement rather than an expression.
priv repl_tokens_assign_at_top := func(tokens: Vec(Token)) returns Bool {
    mut depth : I64 = 0
    for t : Token in tokens {
        if t.type.is(TokenType.LParen).or(t.type.is(TokenType.LBracket)).or(t.type.is(TokenType.LBrace)) {
            depth = depth + 1
        } else if t.type.is(TokenType.RParen).or(t.type.is(TokenType.RBracket)).or(t.type.is(TokenType.RBrace)) {
            depth = depth - 1
        } else if depth == 0 {
            if t.type.is(TokenType.Eq) { return true }
        }
    }
    return false
}

repl_peek_needs_expr_wrap := func(block: Str, tokens: Vec(Token)) returns Bool {
    if block.trim().starts_with("mode ") { return false }
    if tokens.len() < 2 { return false }
    if tokens[0].type.is(TokenType.Ident).not() { return false }
    ref nt : Token = tokens[1]
    if nt.type.is(TokenType.ColonEq).or(nt.type.is(TokenType.Colon)).or(nt.type.is(TokenType.Eq)) { return false }
    if nt.type.is(TokenType.PlusPlus).or(nt.type.is(TokenType.MinusMinus)) { return false }
    // `p.x` and `p.items[0]` are EXPRESSIONS the user wants echoed, but til
    // has no bare-expression statement, so parsing them unwrapped made the
    // parser demand the `=` of a field assignment and PANIC -- taking the
    // whole REPL session down on `p.x`. Wrap them unless the line really is
    // an assignment (`p.x = 5`), which must stay a statement. A method call
    // that returns nothing still lands here; the wrapped attempt fails to
    // type and the caller retries it unwrapped, exactly as before.
    if nt.type.is(TokenType.Dot).or(nt.type.is(TokenType.LBracket)) {
        return repl_tokens_assign_at_top(tokens).not()
    }
    if nt.type.is(TokenType.LParen) { return false }
    return true
}

// Decide whether the user's input is syntactically eligible for Python-style
// auto-echo by storing `(...).to_str()` in a private temp and printing it.
// Statement-level forms
// never wrap; expression-like forms try the wrapper and fall back to the raw
// input if the wrapped source does not typecheck.
repl_parse_allows_wrap := func(peek_ast: Expr) returns Bool {
    if peek_ast.children.len() == 0 { return false }
    ref puser : Expr = peek_ast.children[peek_ast.children.len() - 1]
    switch puser.node_type {
    case .Decl, .Assign, .FieldAssign, .FuncDef,
         .StructDef, .EnumDef, .Return, .If, .While,
         .ForIn, .Switch, .Case, .Break, .Continue,
         .Body: return false
    // A `catch` block (and a bare `throw`) is a statement, and it is the LAST
    // one on the only line shape that can express a catch at the prompt:
    // `ref r : I64 = a.get(5)? catch (err: T) { ... }`. Missing from this list,
    // it fell through to "wrap it as an expression" and the turn died on
    // "unexpected token 'ref'" inside the generated `(...).to_str()`.
    case .Catch, .Throw: return false
    case:
    }
    return true
}

repl_ast_has_help_call := func(e: Expr) returns Bool {
    switch e.node_type {
    case .FCall:
        if e.children.len() > 0 {
            ref callee : Expr = e.children[0]
            switch callee.node_type {
            case .Ident(name):
                if name.ident_name() == "help" { return true }
            case:
            }
        }
    case:
    }
    for child : Expr in e.children {
        if repl_ast_has_help_call(child) { return true }
    }
    return false
}

repl_ast_updates_doc_cache := func(e: Expr) returns Bool {
    switch e.node_type {
    case .Decl, .FuncDef, .StructDef, .EnumDef: return true
    case .FCall:
        if e.children.len() > 0 {
            ref callee : Expr = e.children[0]
            switch callee.node_type {
            case .Ident(name):
                if name.ident_name() == "import" { return true }
            case:
            }
        }
    case:
    }
    for child : Expr in e.children {
        if repl_ast_updates_doc_cache(child) { return true }
    }
    return false
}

repl_refresh_user_doc_cache := proc(mode_str: Str, accum: Str, tmp_path: Str, bin_dir: Str, cwd: Str, ext_c_path: Str, extra_modes: Vec(Str), mut user_info_cache: Str, mut user_docs_cache: Str) {
    if accum.len() == 0 {
        user_info_cache = ""
        user_docs_cache = ""
        return
    }

    mut combined := ""
    combined = combined.format("mode ", mode_str, "\n")
    // Committed turns may contain help() calls, whose symbols live in
    // std/doc since it left core (same injection as run_repl_session).
    combined = combined.format("_doc := import(\"", bin_dir, "/src/std/doc\")\n")
    combined = combined.format(accum)
    File.writefile(tmp_path, combined)

    mut doc_lp := load_program(tmp_path, bin_dir, cwd, ext_c_path, extra_modes, cwd)
    // accum holds only turns that already loaded, so a failure here means an
    // imported file moved or was edited mid-session. help() loses the user's
    // own symbols for this turn rather than the session losing everything.
    if doc_lp.load_errors > 0 {
        user_info_cache = ""
        user_docs_cache = ""
        return
    }
    type_errors := type_program_errors(doc_lp, false)
    if type_errors > 0 { panic("REPL user doc cache refresh failed") }

    mut user_merged := Expr.new(NodeType.Body, 0, 0)
    for u : ProgramUnit in doc_lp.units {
        ref iu : ImportUnit = doc_lp.ctx.imported[u.path]
        for stmt : Expr in iu.ast.children { user_merged.add_child(own stmt.clone()) }
    }
    user_info_cache = Str.with_capacity(65536)
    user_docs_cache = Str.with_capacity(65536)
    collect_decl_packed(user_merged, doc_lp.ctx.scope, user_info_cache, user_docs_cache)
    ffi_cleanup(doc_lp.ctx)
}

// Run one REPL session in a given mode. On EOF, leaves next_mode_out empty.
// If a `mode X` statement is entered, sets next_mode_out = X so the caller
// can restart the session in the new mode.
//
// Strategy: keep the accumulated source for load/type/prepare, but keep one
// interpreter session alive and evaluate only the current accepted input.
run_repl_session := proc(mut ed: ReplEditor, mode_name_in: Str, mut next_mode_out: Str, extra_modes: Vec(Str)) {
    mut mode_str := mode_name_in.clone()
    if mode_str.len() == 0 { mode_str = "script" }

    bin_dir := get_bin_dir()
    cwd := get_cwd_str()
    ext_c_path := bin_dir.format("/src/c/ext.c")
    // std/doc no longer lives in core, but help() must stay ambient in the
    // REPL, so every program the REPL loads imports it explicitly. The path
    // is absolute (the loader resolves those as-is) because tmp_path's
    // directory floats with the user's cwd; the `_doc :=` prefix opts out
    // of the unused-import check for turns that never call help().
    doc_import_line := format("_doc := import(\"", bin_dir, "/src/std/doc\")\n")
    doc_index_path := bin_dir.format("/", REPL_DOC_INDEX)
    // Accumulated user source across REPL inputs for this session.
    mut accum := ""
    mut user_info_cache := ""
    mut user_docs_cache := ""
    mut user_docs_dirty := false
    mut docs_active := false

    user_argv := Vec(Str).new()
    mut session := InterpSession()
    interp_session_start(session, user_argv)
    session.is_repl = true

    system_cmd("mkdir -p tmp")
    tmp_path := format("tmp/repl_", process_id().to_str(), ".til")
    out_path := format("tmp/repl_", process_id().to_str(), ".out")
    File.writefile(tmp_path, format("mode ", mode_str, "\n", doc_import_line))
    mut cached_lp := load_program(tmp_path, bin_dir, cwd, ext_c_path, extra_modes, cwd)
    // The base program is `mode X` plus the injected std/doc import, so a
    // failure here is a broken install, not anything the user typed.
    if cached_lp.load_errors > 0 { panic("REPL base program failed to load") }
    cached_errors := repl_init_cached_program(cached_lp)
    if cached_errors > 0 { panic("REPL cached base program failed to typecheck") }
    mut committed_raw : Dynamic = interp_program_to_heap(own cached_lp)
    interp_session_retain_program(session, committed_raw)
    mut repl_has_loader_directives := false
    mut repl_has_lazy_defs := false
    mut repl_has_full_state := false
    mut repl_anon_type_counter : I64 = 0
    mut repl_echo_counter : I64 = 0

    while true {
        mut at_eof := false
        block := repl_read_block(ed, mode_str, at_eof)
        if at_eof {
            println("")
            break
        }
        // A blank line is a blank line. It used to be indistinguishable from
        // EOF, so pressing Enter ended the session.
        if block.trim().len() == 0 { continue }

        // Peek at the line to detect a `mode X` directive. If the user
        // entered one, return so the outer driver can restart the session
        // in the new mode (discarding prior declarations).
        mut peek_source := block.clone()
        mut peek_tokens := tokenize(peek_source, "<repl>")
        wrapped := repl_peek_needs_expr_wrap(block, peek_tokens)
        if wrapped {
            peek_source = format("(", block, ")")
            peek_tokens = tokenize(peek_source, "<repl>")
        }
        mut peek_mode_out := ""
        mut peek_parse_errors : I32 = 0
        mut peek_ast := parse(peek_tokens, peek_source, "<repl>", peek_mode_out, repl_anon_type_counter, peek_parse_errors, wrapped)
        // The wrap only makes sense for a line that IS a single expression.
        // Several statements on one line -- `v.get(5)? catch (err: T) { ... }`,
        // the only way to type a catch at the prompt -- become a syntax error
        // inside the parens, and the turn was dropped without the raw form ever
        // being tried. The wrapped attempt is parsed quietly for exactly this
        // reason: its failure is speculative, not the user's error.
        if peek_parse_errors.gt(0).and(wrapped) {
            peek_source = block.clone()
            peek_tokens = tokenize(peek_source, "<repl>")
            peek_parse_errors = 0
            peek_ast = parse(peek_tokens, peek_source, "<repl>", peek_mode_out, repl_anon_type_counter, peek_parse_errors)
        }
        // A syntax error used to end the PROCESS here, so one typo threw away
        // the whole session. parse has already printed it; drop the turn and
        // prompt again.
        if peek_parse_errors > 0 { continue }
        if peek_mode_out.len() > 0 {
            next_mode_out = peek_mode_out.clone()
            interp_session_free(session)
            return
        }
        _discard := peek_ast.children.len()

        mut block_eff := block.clone()
        mut turn_out := ""
        mut ran_ok := false
        // The turn ran but its code panicked (h_exit unwound instead of
        // terminating the session). Its output still goes to the user, but the
        // line must not join `accum` or the committed program: a full load
        // replays accum from scratch, so a panicking line would fire again on
        // every later turn, and the statement's own bindings never finished
        // being declared.
        mut turn_aborted := false
        current_has_help := repl_ast_has_help_call(peek_ast)
        current_has_loader_directive := repl_ast_has_loader_directive(peek_ast)
        current_has_lazy_def := repl_ast_has_lazy_def(peek_ast)
        current_has_known_variadic_call := repl_ast_has_known_variadic_call(peek_ast)
        init_docs_this_turn := current_has_help.and(docs_active.not().or(user_docs_dirty))
        if current_has_help.and(user_docs_dirty) {
            repl_refresh_user_doc_cache(mode_str, accum, tmp_path, bin_dir, cwd, ext_c_path, extra_modes, user_info_cache, user_docs_cache)
        }
        mut doc_line := ""
        if init_docs_this_turn {
            doc_line = build_doc_init_line_org_files(doc_index_path, user_info_cache, user_docs_cache)
        }
        // Preamble layout: line 1 mode, line 2 the injected std/doc import,
        // line 3 the doc-init call (doc_line, only when need_docs). accum and
        // the user block follow.
        doc_init_line : U32 = 3
        mut block_start_line : U32 = 3
        if doc_line.len() > 0 { block_start_line++ }
        block_start_line = block_start_line + repl_source_line_count(accum)
        use_full_load := or(repl_has_loader_directives,
                            current_has_loader_directive,
                            repl_has_lazy_defs,
                            current_has_lazy_def,
                            repl_has_full_state,
                            current_has_known_variadic_call)
        commit_compiler_state := use_full_load.not().or(current_has_known_variadic_call.not()).or(repl_ast_updates_doc_cache(peek_ast))

        // Auto-echo, tried in two shapes before giving up on the wrap.
        //
        // `(expr).to_str()` is what turns a value into something print_single
        // takes -- but the typer rejects to_str on a value that is ALREADY a
        // Str ("redundant self-conversion"), so every Str-valued expression at
        // the prompt failed to type, fell through to the raw statement, and
        // printed NOTHING: `format("a","b")`, `s.substr(0,1)`, a bare `s`. A
        // bare literal was worse -- `"hi"` reached "unexpected statement type,
        // this is a bug in the language", blamed on the injected doc import.
        // So when the conversion is what fails, retry with the value as-is;
        // print_single takes a Str, which is exactly the case to_str rejected.
        //
        // Both attempts stay inside the quiet block below (their type errors
        // are captured, not shown): failing is how the ladder picks a shape.
        mut wrap_attempt : USize = 0
        while repl_parse_allows_wrap(peek_ast).and(ran_ok.not()).and(wrap_attempt < 2) {
            echo_name := format("repl_auto_echo_", repl_echo_counter.to_str())
            repl_echo_counter++
            mut echo_value := format("(", block, ").to_str()")
            if wrap_attempt > 0 { echo_value = format("(", block, ")") }
            wrap_attempt++
            block_eff = format("priv ", echo_name, " := ", echo_value, "\nprint_single(", echo_name, ")\nprint_single(\"\\n\")")
            mut trial_counter := repl_anon_type_counter
            mut combined := ""
            combined = combined.format("mode ", mode_str, "\n")
            combined = combined.format(doc_import_line)
            combined = combined.format(doc_line)
            combined = combined.format(accum)
            if accum.len() > 0 { combined = combined.format("\n") }
            combined = combined.format(block_eff)
            mut run_lp := LoadedProgram()
            if use_full_load {
                File.writefile(tmp_path, combined)
                run_lp = load_program(tmp_path, bin_dir, cwd, ext_c_path, extra_modes, cwd)
            } else {
                ref committed_lp : LoadedProgram = to_ptr(committed_raw)
                run_lp = repl_clone_loaded_program(committed_lp)
            }
            run_raw : Dynamic = interp_program_to_heap(own run_lp)
            ref mut run_heap : LoadedProgram = to_ptr(run_raw)
            stdio_capture_begin(out_path)
            mut run_errs : I32 = 0
            mut run_tail_start : USize = 0
            mut run_tail_count : USize = 0
            if run_heap.load_errors > 0 {
                // An import the user typed could not be found or did not
                // parse. resolve_imports already printed why; count it as a
                // failed turn so the line is dropped and the session lives.
                run_errs = run_heap.load_errors
            } else if use_full_load {
                run_errs = init_and_type_program_errors(run_heap, false)
            } else {
                mut delta_source := ""
                delta_source = delta_source.format("mode ", mode_str, "\n")
                delta_source = delta_source.format(doc_line)
                delta_source = delta_source.format(block_eff)
                mut delta_parse_errs : I32 = 0
                mut delta := repl_delta_from_source(tmp_path, delta_source, trial_counter, delta_parse_errs)
                ref run_root : ProgramUnit = run_heap.units[run_heap.units.len() - 1]
                ref run_iu : ImportUnit = run_heap.ctx.imported[run_root.path]
                run_errs = delta_parse_errs
                if run_errs == 0 { run_errs = repl_type_delta_program(run_heap, delta) }
                if run_errs == 0 {
                    repl_prepare_delta_program(run_heap, delta)
                    run_tail_start = run_iu.ast.children.len()
                    run_iu.ast.take_children(delta)
                    run_tail_count = run_iu.ast.children.len().sub(run_tail_start)
                }
            }
            stdio_capture_end()
            if run_errs == 0 {
                if use_full_load {
                    repl_finish_prepare_program(run_heap)
                    turn_out = repl_capture_eval_current(session, run_heap, out_path, block_start_line, init_docs_this_turn, doc_init_line, turn_aborted)
                } else {
                    mut eval_start := run_tail_start
                    if doc_line.len() > 0 { if init_docs_this_turn.not() { eval_start++ } }
                    turn_out = repl_capture_eval_tail(session, run_heap, out_path, eval_start, run_tail_start.add(run_tail_count).sub(eval_start), turn_aborted)
                }
                interp_session_retain_program(session, run_raw)
                if commit_compiler_state.and(turn_aborted.not()) { committed_raw = run_raw }
                ran_ok = true
                repl_anon_type_counter = trial_counter
            } else {
                interp_program_free(run_raw)
            }
        }
        // Neither wrap typed: the line is not an expression to echo (a method
        // call returning nothing, say). Run it verbatim, loudly.
        if ran_ok.not() {
            block_eff = block.clone()
        }

        if ran_ok.not() {
            mut trial_counter2 := repl_anon_type_counter
            mut combined2 := ""
            combined2 = combined2.format("mode ", mode_str, "\n")
            combined2 = combined2.format(doc_import_line)
            combined2 = combined2.format(doc_line)
            combined2 = combined2.format(accum)
            if accum.len() > 0 { combined2 = combined2.format("\n") }
            combined2 = combined2.format(block_eff)
            mut typed_lp := LoadedProgram()
            if use_full_load {
                File.writefile(tmp_path, combined2)
                typed_lp = load_program(tmp_path, bin_dir, cwd, ext_c_path, extra_modes, cwd)
            } else {
                ref committed_lp2 : LoadedProgram = to_ptr(committed_raw)
                typed_lp = repl_clone_loaded_program(committed_lp2)
            }
            typed_raw : Dynamic = interp_program_to_heap(own typed_lp)
            ref mut typed_heap : LoadedProgram = to_ptr(typed_raw)
            mut typer_errs : I32 = 0
            mut typed_tail_start : USize = 0
            mut typed_tail_count : USize = 0
            if typed_heap.load_errors > 0 {
                typer_errs = typed_heap.load_errors
            } else if use_full_load {
                typer_errs = repl_typecheck(typed_heap)
            } else {
                mut delta_source2 := ""
                delta_source2 = delta_source2.format("mode ", mode_str, "\n")
                delta_source2 = delta_source2.format(doc_line)
                delta_source2 = delta_source2.format(block_eff)
                mut delta2_parse_errs : I32 = 0
                mut delta2 := repl_delta_from_source(tmp_path, delta_source2, trial_counter2, delta2_parse_errs)
                ref typed_root : ProgramUnit = typed_heap.units[typed_heap.units.len() - 1]
                ref typed_iu : ImportUnit = typed_heap.ctx.imported[typed_root.path]
                typer_errs = delta2_parse_errs
                if typer_errs == 0 { typer_errs = repl_type_delta_program(typed_heap, delta2) }
                if typer_errs == 0 {
                    repl_prepare_delta_program(typed_heap, delta2)
                    typed_tail_start = typed_iu.ast.children.len()
                    typed_iu.ast.take_children(delta2)
                    typed_tail_count = typed_iu.ast.children.len().sub(typed_tail_start)
                }
            }
            if typer_errs == 0 {
                if use_full_load {
                    finish_init_and_type_program(typed_heap)
                    repl_finish_prepare_program(typed_heap)
                    turn_out = repl_capture_eval_current(session, typed_heap, out_path, block_start_line, init_docs_this_turn, doc_init_line, turn_aborted)
                } else {
                    mut eval_start2 := typed_tail_start
                    if doc_line.len() > 0 { if init_docs_this_turn.not() { eval_start2++ } }
                    turn_out = repl_capture_eval_tail(session, typed_heap, out_path, eval_start2, typed_tail_start.add(typed_tail_count).sub(eval_start2), turn_aborted)
                }
                interp_session_retain_program(session, typed_raw)
                if commit_compiler_state.and(turn_aborted.not()) { committed_raw = typed_raw }
                ran_ok = true
                repl_anon_type_counter = trial_counter2
            } else {
                interp_program_free(typed_raw)
            }
        }

        if ran_ok {
            if current_has_help { docs_active = true }
            if init_docs_this_turn { user_docs_dirty = false }
            if repl_ast_updates_doc_cache(peek_ast) { user_docs_dirty = true }
            if turn_out.len() > 0 { print_single(turn_out) }

            // Only commit good lines to accumulated source. If typecheck
            // failed, drop the line so it doesn't pollute future turns
            // (the typer would replay the same error on every input). A line
            // that panicked is dropped for the same reason: a full load
            // replays accum from the top and would panic again every turn.
            if turn_aborted.not() {
                if accum.len() > 0 { accum = accum.format("\n") }
                accum = accum.format(block_eff)
                repl_has_loader_directives = repl_has_loader_directives.or(current_has_loader_directive)
                repl_has_lazy_defs = repl_has_lazy_defs.or(current_has_lazy_def)
                repl_has_full_state = repl_has_full_state.or(current_has_known_variadic_call.and(repl_ast_updates_doc_cache(peek_ast)))
            }
        }
    }
    interp_session_free(session)
}

// Outer REPL driver: restarts the session when a `mode X` statement is entered.
run_repl := proc(initial_mode: Str, extra_modes: Vec(Str)) {
    println(format("til ", VERSION, " REPL -- Ctrl-D to exit"))
    // One editor for the whole REPL, constructed before the first
    // session and passed by mutation through every one of them: a
    // `mode X` restart discards declarations, not history (#332).
    mut editor := ReplEditor()
    repl_editor_start(editor)
    mut next_mode := initial_mode.clone()
    if next_mode.len() == 0 { next_mode = "script" }
    while next_mode.len() > 0 {
        cur := next_mode.clone()
        next_mode = ""
        run_repl_session(editor, cur, next_mode, extra_modes)
    }
}

usage := proc() {
    println("Usage: til [<command>] [<path>]")
    println("       til [<command>] [--] [<path>]")
    println("")
    println("With no arguments, starts the interactive REPL (mode script).")
    println("Use -- before <path> to stop option parsing.")
    println("")
    println("Commands:")
    println("  repl       Start the interactive REPL")
    println("  interpret  Read and interpret a .til file")
    println("  translate  Generate C source (no compilation)")
    println("  build      Compile a .til file to a binary")
    println("  install    Build and install a .til program or library")
    println("  run        Compile and run a .til file")
    println("  test       Run test() functions interpreted, then compiled")
    println("  doc        Emit org-mode and HTML docs under doc/gen/")
    println("  ast        Print the parsed AST as a Lisp-like S-expression")
    println("  bindings   Generate a `mode lib` .til binding from a C header")
    println("  help       Print this message")
    println("")
    println("Options:")
    println("  --usize=64  Opt into U64 container index/size widths (default is U32,")
    println("              which saves memory; UPtr always follows pointer width).")
    println("")
    println("bindings audit -- the generated file is a starting point, not a finished")
    println("binding: C headers cannot express three til-side qualifier axes, so the")
    println("generator defaults to the safe side of each and a human tunes the rest")
    println("(the checklist lives in doc/ffi.org):")
    println("  purity:      the func/proc split is about purity only -- whether a")
    println("               binding returns a value is irrelevant to it, and an")
    println("               ext_proc may return one. The generator cannot see purity, so")
    println("               it guesses ext_func (which the constfolder may fold at")
    println("               compile time); flip impure ones to ext_proc by hand. The")
    println("               one safe inference it does make: a void C function is")
    println("               only useful for its side effects, so those come out")
    println("               ext_proc already.")
    println("  ownership:   pointer returns come out `returns ref` (til never frees),")
    println("               pointer params as borrows (`mut` when non-const); `own`,")
    println("               meaning transfer, is always a manual call.")
    println("  nullability: struct pointer fields come out NULLABLE, spelled")
    println("               `field : Option(ref T) = Option(ref T).None`; tighten the")
    println("               ones the C docs promise are never NULL to a mandatory")
    println("               `ref field : T`. Function params and returns come out as")
    println("               bare pointers; a genuinely nullable one (a NULL filter")
    println("               arg, a NULL-on-cancel result) is hand-changed to")
    println("               `shallow Option(ref T)` -- the shallow is required, or")
    println("               the call does not match the C ABI.")
}

CliArgs := struct {
    command := ""
    path := ""
    custom_bin := ""
    custom_c := ""
    target_str := ""
    cc := ""
    install_prefix := ""
    path_idx : USize = 1
    early_return := false
    asan := false
    prof := false
    // #309: --usize overrides the USize container-width alias. 0 = follow the
    // source default (U32); 32 pins U32; 64 opts back into U64 even on a
    // 64-bit host (UPtr always stays pointer-width).
    usize_bits : I64 = 0
    // #154: unused-import type errors, on by default;
    // --check-unused-imports=false disables for one invocation.
    check_unused_imports := true
    own extra_modes := Vec(Str).new()
}

parse_args := proc(args: Array(Str)) returns CliArgs {
    mut cli := CliArgs()
    if args.len() == 0 {
        run_repl("script", cli.extra_modes)
        cli.early_return = true
        return cli
    }

    ref cmd_ref : Str = args[0]
    cli.command = cmd_ref.clone()

    if cli.command == "--" {
        if args.len() == 1 {
            println("error: missing source path after --")
            usage()
            exit(1)
        }
        ref p : Str = args[1]
        cli.command = "interpret"
        cli.path = p.clone()
        cli.path_idx = 1
        return cli
    }

    if args.len() == 1 {
        if cli.command.eq("--version").or(cli.command.eq("-v")) {
            println(VERSION)
            cli.early_return = true
            return cli
        }
        if cli.command.eq("help").or(cli.command.eq("--help")) {
            usage()
            cli.early_return = true
            return cli
        }
        if cli.command == "repl" {
            run_repl("script", cli.extra_modes)
            cli.early_return = true
            return cli
        }
        cli.path = cli.command
        cli.command = "interpret"
        return cli
    }

    if cli.command == "repl" {
        mut mode_arg := "script"
        while cli.path_idx < args.len() {
            ref flag : Str = args[cli.path_idx]
            if flag.starts_with("--extra-modes=") {
                cli.extra_modes.push(own flag.strip_prefix("--extra-modes=").clone())
            } else if flag.starts_with("-").not() {
                mode_arg = flag.clone()
            }
            cli.path_idx++
        }
        run_repl(mode_arg, cli.extra_modes)
        cli.early_return = true
        return cli
    }

    if and(cli.command.starts_with("-").not(),
           cli.command.eq("interpret").not(),
           cli.command.eq("translate").not(),
           cli.command.eq("build").not(),
           cli.command.eq("install").not(),
           cli.command.eq("run").not(), cli.command.eq("test").not(),
           cli.command.eq("doc").not(), cli.command.eq("ast").not(),
           cli.command.eq("bindings").not(),
           cli.command.eq("help").not(),
           cli.command.eq("--help").not(),
           cli.command.eq("--version").not(),
           cli.command.eq("-v").not()) {
        cli.command = "interpret"
        cli.path_idx = 0
    } else if cli.command.starts_with("-") {
        // If it starts with '-', it's a flag, meaning there's no command specified.
        // It's just `til --flag ... file.til`
        cli.command = "interpret"
        cli.path_idx = 0
    }

    // Scan for -o/-c/--target/--cc/--prefix flags before source file
    while cli.path_idx < args.len() {
        ref flag : Str = args[cli.path_idx]
        if flag == "--" {
            cli.path_idx++
            break
        } else if flag.eq("-o").and(cli.path_idx.add(1).lt(args.len())) {
            ref oval : Str = args[cli.path_idx + 1]
            cli.custom_bin = oval.clone()
            cli.path_idx = cli.path_idx + 2
        } else if flag.eq("-c").and(cli.path_idx.add(1).lt(args.len())) {
            ref cval : Str = args[cli.path_idx + 1]
            cli.custom_c = cval.clone()
            cli.path_idx = cli.path_idx + 2
        } else if flag.starts_with("--target=") {
            cli.target_str = flag.strip_prefix("--target=").clone()
            cli.path_idx++
        } else if flag.starts_with("--cc=") {
            cli.cc = flag.strip_prefix("--cc=").clone()
            cli.path_idx++
        } else if flag.starts_with("--usize=") {
            // #309: force the USize container-width alias. 32 = U32 even on a
            // 64-bit host (UPtr stays pointer-width); 64 = the current default.
            uval := flag.strip_prefix("--usize=")
            if uval == "32" {
                cli.usize_bits = 32
            } else if uval == "64" {
                cli.usize_bits = 64
            } else {
                println(format("error: --usize expects 32 or 64, got '", uval, "'"))
                exit(1)
            }
            cli.path_idx++
        } else if flag.eq("--prefix").and(cli.path_idx.add(1).lt(args.len())) {
            ref pval : Str = args[cli.path_idx + 1]
            cli.install_prefix = pval.clone()
            cli.path_idx = cli.path_idx + 2
        } else if flag.starts_with("--prefix=") {
            cli.install_prefix = flag.strip_prefix("--prefix=").clone()
            cli.path_idx++
        } else if flag == "--asan" {
            cli.asan = true
            cli.path_idx++
        } else if flag == "--prof" {
            cli.prof = true
            cli.path_idx++
        } else if flag == "--check-unused-imports" {
            cli.check_unused_imports = true
            cli.path_idx++
        } else if flag.starts_with("--check-unused-imports=") {
            val := flag.strip_prefix("--check-unused-imports=")
            if val == "false" {
                cli.check_unused_imports = false
            } else if val == "true" {
                cli.check_unused_imports = true
            } else {
                println(format("error: --check-unused-imports expects true or false, got '", val, "'"))
                exit(1)
            }
            cli.path_idx++
        } else if flag.starts_with("--extra-modes=") {
            cli.extra_modes.push(own flag.strip_prefix("--extra-modes=").clone())
            cli.path_idx++
        } else {
            break
        }
    }
    if cli.path_idx >= args.len() {
        println("error: missing source path")
        usage()
        exit(1)
    }
    ref p : Str = args[cli.path_idx]
    cli.path = p.clone()
    return cli
}

// Split trailing args (after the source path) into -l flags (appended to
// lp.link_flags) and user argv (returned).
collect_user_argv := func(mut lp: LoadedProgram, args: Array(Str), start_idx: USize) returns Vec(Str) {
    mut user_argv := Vec(Str).new()
    mut ai := start_idx
    while ai < args.len() {
        ref arg : Str = args[ai]
        if arg.starts_with("-l") {
            mut lib := arg.strip_prefix("-l")
            if lib.len().eq(0).and(ai.add(1).lt(args.len())) {
                ai++
                ref next_arg : Str = args[ai]
                lib = next_arg.clone()
            }
            lp.link_flags = lp.link_flags.format(" -l", lib)
        } else {
            user_argv.push(own arg.clone())
        }
        ai++
    }
    return user_argv
}

// --- Main ---

main := proc(args: ..Str) {
    cli := parse_args(args)
    if cli.early_return { return }

    if cli.command.eq("help").or(cli.command.eq("--help")) {
        usage()
        return
    }

    // `bindings` runs the C-header -> til translator (src/self/binder.til).
    // Skip the load_program pipeline -- the input is a .h, not a .til, and
    // -o carries the output path.
    if cli.command == "bindings" {
        if cli.custom_bin.len() == 0 {
            println("error: bindings requires -o <output.til>")
            usage()
            exit(1)
        }
        generate_bindings(cli.path, cli.custom_bin)
        return
    }

    bin_dir := get_bin_dir()
    cwd := get_cwd_str()
    ext_c_path := bin_dir.format("/src/c/ext.c")

    mut target := detect_current_target()
    if cli.target_str.len() > 0 { target = target_from_str(cli.target_str) }

    mut lp := load_program(cli.path, bin_dir, cwd, ext_c_path, cli.extra_modes)
    // An unresolvable / unparsable import used to panic inside load_program.
    // It reports and returns now (so the REPL can drop the turn); a file
    // compile still stops here, with the message resolve_imports printed.
    if lp.load_errors > 0 { exit(1) }
    lp.target = target
    // #309: --usize override must be set before prepare_program stamps the
    // USize/UPtr alias widths (retarget_loaded_aliases / the ctx register).
    lp.usize_override_bits = cli.usize_bits
    // #154 prototype: unused-import type errors, opt-in per invocation.
    lp.ctx.check_unused_imports = cli.check_unused_imports
    user_argv := collect_user_argv(lp, args, cli.path_idx + 1)

    // `ast` prints the raw parsed AST -- skip init/typecheck/constfolder/scavenge
    // so output matches the parser's direct output and stays cheap on large
    // programs (full pipeline on src/til.til takes minutes).
    if cli.command == "ast" {
        cmd_ast(lp)
        return
    }

    // `doc` only needs a typed AST; constfolder + scavenge are codegen prep.
    if cli.command == "doc" {
        init_and_type_program(lp, false)
        result := cmd_doc(lp, VERSION)
        if result != 0 { exit(result.cast(I64)) }
        return
    }

    // Issue #54: tell the typer whether we are headed for the C backend.
    // Capturing closures run only under the interpreter for now, so the
    // typer rejects them when compiling. `interpret`/`ast`/`doc` stay in
    // interpret mode; every backend command compiles.
    lp.ctx.compile_mode = cli.command.eq("interpret").not()
        .and(cli.command.eq("ast").not())
        .and(cli.command.eq("doc").not())

    prepare_program(lp, cli.command == "test")

    mut result : I32 = 0
    switch cli.command {
    case "interpret":
        if lp.cur_mode.is_library {
            panic("cannot interpret a library -- use translate or build")
        }
        result = cmd_interpret(lp, user_argv)
    case "test":
        eprint_single("=== interpret ===\n")
        result = cmd_interpret(lp, user_argv)
        if result == 0 {
            eprint_single("=== compile + run ===\n")
            result = cmd_test_build_run(lp, cli.custom_bin, cli.custom_c, target, cli.cc, cli.asan, cli.prof)
        }
    case "translate":
        result = cmd_translate(lp, cli.custom_c, target)
    case "build":
        result = cmd_build(lp, cli.custom_bin, cli.custom_c, target, cli.cc, cli.asan, cli.prof)
    case "install":
        result = cmd_install(lp, cli.install_prefix, target, cli.cc, cli.asan, cli.prof)
    case "run":
        result = cmd_run(lp, cli.custom_bin, cli.custom_c, user_argv, target, cli.cc, cli.asan, cli.prof)
    case:
        println(format("error: unknown command '", cli.command, "'"))
        usage()
        result = 1
    }

    ffi_cleanup(lp.ctx)
    lexer_cleanup()
    if result != 0 { exit(result.cast(I64)) }
}
