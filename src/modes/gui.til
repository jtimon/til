mode lib

import("../../vendor/bindings/raylib")
import("../../vendor/bindings/tinyfd")
// Each target's own raylib and tinyfd builds (issue #422); bin/make
// builds any of them by its path. wasm32 has raylib only: a browser page
// gets no native file dialogs.
link("vendor/raylib/build-linux-x64/libraylib.a", "linux-x64")
link("vendor/raylib/build-linux-arm64/libraylib.a", "linux-arm64")
link("vendor/raylib/build-linux-riscv64/libraylib.a", "linux-riscv64")
link("vendor/raylib/build-linux-x86/libraylib.a", "linux-x86")
link("vendor/raylib/build-linux-arm32/libraylib.a", "linux-arm32")
link("vendor/raylib/build-linux-riscv32/libraylib.a", "linux-riscv32")
link("vendor/raylib/build-windows-x64/libraylib.a", "windows-x64")
link("vendor/raylib/build-windows-x86/libraylib.a", "windows-x86")
link("vendor/raylib/build-macos-x64/libraylib.a", "macos-x64")
link("vendor/raylib/build-macos-arm64/libraylib.a", "macos-arm64")
link("vendor/raylib/build-wasm32/libraylib.a", "wasm32")
link("vendor/tinyfiledialogs/build-linux-x64/libtinyfd.a", "linux-x64")
link("vendor/tinyfiledialogs/build-linux-arm64/libtinyfd.a", "linux-arm64")
link("vendor/tinyfiledialogs/build-linux-riscv64/libtinyfd.a", "linux-riscv64")
link("vendor/tinyfiledialogs/build-linux-x86/libtinyfd.a", "linux-x86")
link("vendor/tinyfiledialogs/build-linux-arm32/libtinyfd.a", "linux-arm32")
link("vendor/tinyfiledialogs/build-linux-riscv32/libtinyfd.a", "linux-riscv32")
link("vendor/tinyfiledialogs/build-windows-x64/libtinyfd.a", "windows-x64")
link("vendor/tinyfiledialogs/build-windows-x86/libtinyfd.a", "windows-x86")
link("vendor/tinyfiledialogs/build-macos-x64/libtinyfd.a", "macos-x64")
link("vendor/tinyfiledialogs/build-macos-arm64/libtinyfd.a", "macos-arm64")
// What raylib and tinyfd call into on each system.
link("m", "linux-x64 linux-arm64 linux-riscv64 linux-x86 linux-arm32 linux-riscv32")
link("pthread", "linux-x64 linux-arm64 linux-riscv64 linux-x86 linux-arm32 linux-riscv32")
