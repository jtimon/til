    gui_archive_goals(out, "windows-x64", gui_windows_x64, "")
    gui_archive_goals(out, "windows-x86", gui_windows_x86, "")
    gui_archive_goals(out, "macos-arm64", gui_macos_arm64, "(SDK-less off a mac)")
    gui_archive_goals(out, "macos-x64", gui_macos_x64, "(SDK-less off a mac)")
    out.push(own Command(name = MAC_STUBS_STAMP, alias_of = "build_mac", is_path = true, go = build_mac_framework_stubs))
    out.push(own Command(name = raylib_lib("wasm32"), is_path = true, go = build_raylib_web,
        about = "wasm32 raylib (emcc, vendored emsdk), for mode gui"))
    return out
}

/// One target's raylib and tinyfd archive goals; either builds both.
gui_archive_goals := func(mut out: Vec(Command), target: Str, go: Handler, note: Str) {
    mut about := format(target, " raylib + tinyfd, for mode gui")
    if note.is_empty().not() { about = format(target, " raylib + tinyfd ", note, ", for mode gui") }
    out.push(own Command(name = raylib_lib(target), is_path = true, go = go, about = about.clone()))
    out.push(own Command(name = tinyfd_lib(target), is_path = true, go = go, about = about))
}

usage := proc() {
    println("Usage: bin/make [options] [<goal>...]")
    println("")
    println("The til build program. Run it from the repository root.")
    println("`make <goals>` builds it and hands the goals over, so both")
    println("spellings are the same build.")
    println("")
    println("Commands:")
    for c : Command in commands() {
        if c.alias_of.is_empty().and(c.is_path.not()) {
            println(format("  ", pad(c.name, 22), c.about))
        }
    }
    println("")
    println("Artifact goals (also reachable by the command that owns them):")
    for c : Command in commands() {
        if c.is_path {
            mut note := c.about.clone()
            if note.is_empty() { note = format("built by `", c.alias_of, "`") }
            println(format("  ", pad(c.name, 48), note))
        }
    }
    println("")
    println("Aliases:")
    for c : Command in commands() {
        if c.alias_of.is_empty().or(c.is_path).not() {
            println(format("  ", pad(c.name, 22), "Alias for ", c.alias_of))
        }
    }
    println("")
    println("Options:")
    println(format("  ", pad("-jN", 22), "Run the test suite with N jobs"))
    println(format("  ", pad("--riscv32-cc=<path>", 22), "riscv32 gcc for the riscv32 GUI archives"))
    println(format("  ", pad("--linux-x64-cc=<path>", 22), "linux-x64 cross gcc off a linux-x64 host"))
    println(format("  ", pad("", 22), "(default x86_64-linux-gnu-gcc)"))
    println("")
    println("RISCV32_CC, LINUX_X64_CC, EMCC, EMAR and EMRANLIB are read from the")
    println("environment; make passes them through unchanged.")
    println("`install` installs under /usr/local; for anywhere else run")
    println("`bin/til install --prefix=<path> src/til.til` directly.")
    println("")
    println("bin/til_boot comes from the last commit and is built by the")
    println("Makefile; recovery is `git checkout HEAD boot/ && make test`.")
}

/// ~s~ padded with spaces to ~width~ columns -- always at least one, so
/// a name longer than the column (the artifact goals' paths) is still
/// separated from the text after it (issue #435).
pad := func(s: Str, width: USize) returns Str {
    mut out := format(s, " ")
    while out.len() < width {
        out = format(out, " ")
    }
    return out
}

dispatch := proc(mut b: Build, name: Str) {
    for c : Command in commands() {
        if c.name == name {
            c.go(b)
            return
        }
    }
    println(format("bin/make: unknown goal '", name, "'"))
    println("")
    usage()
    exit(1)
}

// --- Self-rebuild ---
//
// nob.h's GO_REBUILD_URSELF: the build program keeps itself current.
// The previous executable is preserved until the new one exists, so a
// build that does not compile leaves a program that still runs, and
// the replacement is run with the arguments this invocation was given
// -- never continued with the old code.

self_bin := func(host: Host) returns Str {
    return format("bin/make", host.exe_suffix())
}

self_backup := func(host: Host) returns Str {
    return format("bin/make.previous", host.exe_suffix())
}

/// What bin/make is built from: this file, the library it imports, and
/// the C runtime it links.
///
/// bin/til_boot is deliberately NOT in the list, even though it is what
/// compiles this program. The Makefile relinks the bootstrap compiler
/// on every invocation -- its input is a commit, not a file -- so its
/// mtime is always newer, and keying on it would rebuild and re-exec
/// the build program on every single run for nothing.
self_sources := proc() returns Vec(Str) {
    mut out := Vec(Str).new()
    out.push(own SELF_SRC.clone())
    out.push(own "src/self/install.til")
    add_matching(out, "src/core", ".til")
    add_matching(out, "src/std", ".til")
    add_matching(out, "src/c", ".c")
    add_matching(out, "src/c", ".h")
    return out
}

/// Recover from an interrupted rebuild before deciding anything else:
/// a backup with no program beside it is the only copy left, and a
/// backup beside a program is last run's, kept because Windows could
/// not delete the image that was running.
settle_previous := proc(host: Host) {
    backup := self_backup(host)
    if File.exists(backup).not() { return }
    if File.exists(self_bin(host)) {
        File.remove(backup)
        return
    }
    File.rename(backup, self_bin(host))
}

rebuild_self_if_stale := proc(host: Host, build_uid: Str, args: ..Str) {
    settle_previous(host)
    self_path := self_bin(host)
    if needs_rebuild(self_path, self_sources()).not() { return }
    require_boot()
    println("bin/make: rebuilding the build program from make.til")

    backup := self_backup(host)
    if File.exists(self_path) { File.rename(self_path, backup) }
    build := build_user_command(build_uid)
    build.args(BOOT, "build", "-o", self_path, SELF_SRC)
    println(build.render())
    if build.run() != 0 {
        if File.exists(backup) { File.rename(backup, self_path) }
        println("bin/make: rebuild failed -- the previous build program is still in place")
        exit(1)
    }
    // Windows cannot delete a running image; there the leftover goes
    // on the next run's settle_previous, which is no longer running it.
    if host.os != "windows" { File.remove(backup) }

    again := Cmd.new(self_path)
    mut i : USize = 0
    while i < args.len() {
        ref a : Str = args[i]
        again.arg(a)
        i++
    }
    status := again.run()
    if status < 0 {
        println(format("bin/make: killed by signal ", (0 - status).to_str()))
        exit(1)
    }
    exit(status)
}

// --- Entry point ---

// sudo supplies the original identity. An ordinary invocation never
// needs sudo; a nested sudo -u build has SUDO_UID=0 and stays unprivileged.
sudo_build_uid := proc(host: Host) returns Str {
    uid := get_env("SUDO_UID")
    if uid.is_empty().or(uid.eq("0")).or(host.os.eq("windows")) { return "" }
    // Ask through the exit status: a capture would itself create local
    // temporary files while this process still has root privileges.
    identity := Cmd.new("sh", "-c", "uid=$(id -u) || exit 2; test \"$uid\" = 0")
    status := identity.run()
    if status == 1 { return "" }
    if status != 0 { panic("could not determine the build user") }
    return uid
}

build_user_command := proc(uid: Str) returns Cmd {
    if uid.is_empty() { return Cmd.new() }
    command := Cmd.new("sudo", "-u", format("#", uid),
        "-g", format("#", get_env("SUDO_GID")), "--", "env")
    // sudo resets the environment, so carry the existing build settings
    // explicitly instead of losing cross-toolchain selections.
    for name : Str in "RISCV32_CC LINUX_X64_CC EMCC EMAR EMRANLIB".split(" ") {
        env_name := name.clone()
        value := get_env(env_name)
        if value.len() > 0 { command.arg(format(name, "=", value)) }
    }
    return command
}

main := proc(args: ..Str) {
    host := Host.detect()
    build_uid := sudo_build_uid(host)
    rebuild_self_if_stale(host, build_uid, ..args)

    mut b := Build.new()
    mut goals := Vec(Str).new()
    mut i : USize = 0
    while i < args.len() {
        ref arg : Str = args[i]
        if arg.starts_with("-j") {
            b.jobs = arg.strip_prefix("-j").clone()
        } else if arg.starts_with("--riscv32-cc=") {
            b.riscv32_cc = arg.strip_prefix("--riscv32-cc=").clone()
        } else if arg.starts_with("--linux-x64-cc=") {
            b.linux_x64_cc = arg.strip_prefix("--linux-x64-cc=").clone()
        } else if arg.eq("-h").or(arg.eq("--help")) {
            goals.push(own "help")
        } else if arg.starts_with("-") {
            println(format("bin/make: unknown option '", arg, "'"))
            exit(1)
        } else {
            goals.push(own arg.clone())
        }
        i++
    }
    // No goals is the default build, exactly like make.
    if goals.len() == 0 { goals.push(own "all") }

    // Every goal shares one Build, so a prerequisite reached by two of
    // them runs once.
    for goal : Str in goals {
        if build_uid.is_empty() {
            dispatch(b, goal)
        } else {
            command := build_user_command(build_uid)
            command.arg(self_bin(host))
            if b.jobs.len() > 0 { command.arg(format("-j", b.jobs)) }
            if b.riscv32_cc.len() > 0 {
                command.arg(format("--riscv32-cc=", b.riscv32_cc))
            }
            command.arg(format("--linux-x64-cc=", b.linux_x64_cc))
            if goal == "install" {
                command.arg("bin/til")
            } else {
                command.arg(goal)
            }
            command.run_checked()
            if goal == "install" { copy_compiler_install(host) }
        }
    }
}
