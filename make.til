mode cli

// The til build program (issue #345).
//
// Build policy lives here, as ordinary til code, not in a second
// language embedded in a Makefile. The model is nob.h, not Zig's build
// system: this is a program that runs commands in order, with mtime
// checks and explicit dependencies between plain functions -- no
// dependency graph engine, no build database, no configuration
// language. What Zig contributes is the part that makes multi-goal
// invocations cheap: naming an artifact does not build it, and a step
// that has run once in this process does not run again.
//
// The Makefile keeps exactly the chicken-and-egg part it must own:
// producing bin/til_boot from the last commit, compiling this file into
// bin/make with it, and handing the requested goals over. Everything
// else is here.
//
// bin/make is a generated artifact under the ignored bin/ tree. It is
// never committed and never installed; it is rebuilt from this source
// whenever the source is newer, by Make and by bin/make itself.
//
// Run it from the repository root, like make.

import("src/std/sys")
import("src/std/file")
import("src/self/install")
import("src/self/fasm_build")

// The working directory, for the absolute paths some vendored build
// systems insist on. Same bridge src/til.til binds; not in std/sys
// because nothing but a build tool has wanted it yet.
get_cwd_str := ext_proc() returns Str {}
til_setenv := ext_proc(name: I8, value: I8, shallow overwrite: I32) returns shallow I32 {}

BOOT := "bin/til_boot"
TIL := "bin/til"
ASAN := "bin/til_asan"
DEBUG := "bin/til_debug"
SELF_SRC := "make.til"

// raylib and tinyfd are built per --target into
// vendor/{raylib,tinyfiledialogs}/build-<target> (issue #422);
// raylib_lib and tinyfd_lib name the archives, the paths
// src/modes/gui.til's link()s name.
RAYLIB_DIR := "vendor/raylib"
TINYFD_DIR := "vendor/tinyfiledialogs"
TINYFD_SRC := "vendor/tinyfiledialogs/tinyfiledialogs.c"
// nng is built per --target into vendor/nng/build-<target> (issue #422);
// nng_lib names the archive, the path the server modes' link()s name.
NNG_DIR := "vendor/nng"
// libsecp256k1 is built per --target too (issue #422); secp256k1_lib
// names the archive, the path std/crypto's link()s name.
SECP256K1_DIR := "vendor/secp256k1"
RAYLIB_WIN64_DLL := "vendor/raylib/build-windows-x64/libraylib.dll"
TINYFD_WIN64_DLL := "vendor/tinyfiledialogs/build-windows-x64/libtinyfd.dll"
// libffi is built per --target into vendor/libffi/build-<target>
// (issue #422): the host's by the Makefile, the rest by LibffiCross.
LIBFFI_DIR := "vendor/libffi"
MAC_STUBS_STAMP := "vendor/macos/frameworks/.stamp"
EMSDK_DIR := "vendor/emscripten"
EMSDK_VERSION := "6.0.0"
EMSDK_STAMP := "vendor/emscripten/.til-emsdk-6.0.0"

// --- Host ---

/// What this build is running ON. Not the target: cross-builds pick
/// their target explicitly, and every one of them can be produced from
/// more than one host.
Host := struct {
    os := ""
    arch := ""

namespace:
    detect := proc() returns Host {
        return Host(os = host_os(), arch = host_arch())
    }

    is_mac := func(self: Host) returns Bool {
        return self.os == "macos"
    }

    /// What an executable is called here. Windows insists on .exe;
    /// nothing else adds a suffix.
    exe_suffix := func(self: Host) returns Str {
        if self.os == "windows" { return ".exe" }
        return ""
    }

    /// The suite opens real windows for the mode-gui tests, so on Linux
    /// it runs under a virtual X server. macOS has no X11 and runs them
    /// bare; windows is not a suite host at all.
    needs_xvfb := func(self: Host) returns Bool {
        return self.os == "linux"
    }

    /// GNU coreutils ~timeout~ is ~gtimeout~ on macOS.
    timeout_cmd := func(self: Host) returns Str {
        if self.is_mac() { return "gtimeout" }
        return "timeout"
    }

    /// This host's --target name ("linux-x64", "macos-arm64", ...): the
    /// os and arch spellings are the target's own.
    target_name := func(self: Host) returns Str {
        return format(self.os, "-", self.arch)
    }

    /// The mac target matching this mac: a native sweep follows the
    /// host's arch.
    mac_target := func(self: Host) returns Str {
        if self.arch == "arm64" { return "macos-arm64" }
        return "macos-x64"
    }
}

// --- Build state ---

/// Everything one invocation of the build program carries: the host it
/// runs on, the options it was given, and the steps it has already
/// finished. One Build is shared by every requested goal, which is what
/// makes ~bin/make build_win_host win_server~ do the shared work once.
Build := struct {
    host : Host
    // -jN for the test runner. Empty means "the runner's own default".
    jobs := ""
    // No distro ships a riscv32 gcc, so the compiler is a parameter:
    // --riscv32-cc=<path>, or RISCV32_CC in the environment.
    riscv32_cc := ""
    // linux-x64 is a CROSS target only off a linux-x64 host (issue #420),
    // whose compiler's name depends on the host: x86_64-linux-gnu-gcc is
    // the distro cross gcc (e.g. on an arm64 linux host), and the default;
    // a mac's (messense's tap) is x86_64-unknown-linux-gnu-gcc.
    // --linux-x64-cc=<path>, or LINUX_X64_CC in the environment.
    linux_x64_cc := ""
    emcc := ""
    emar := ""
    emranlib := ""
    // Names of the steps that have run in THIS process.
    done : Set(Str)

namespace:
    new := proc() returns Build {
        cwd := get_cwd_str()
        emsdk := format(cwd, "/", EMSDK_DIR, "/upstream/emscripten")
        em_config := format(cwd, "/", EMSDK_DIR, "/.emscripten")
        emcc_override := get_env("EMCC")
        if emcc_override.len().eq(0) {
            if til_setenv("EM_CONFIG".c_str, em_config.c_str, 1) != 0 {
                panic("could not set EM_CONFIG")
            }
        }
        return Build(
            host = Host.detect(),
            done = Set(Str).new(),
            riscv32_cc = get_env("RISCV32_CC"),
            linux_x64_cc = env_or("LINUX_X64_CC", "x86_64-linux-gnu-gcc"),
            emcc = env_or("EMCC", format(emsdk, "/emcc")),
            emar = env_or("EMAR", format(emsdk, "/emar")),
            emranlib = env_or("EMRANLIB", format(emsdk, "/emranlib")))
    }

    /// True the first time a step is reached in this process, false
    /// every later time. Marking happens on entry, not on exit: a step
    /// that fails ends the process, so there is no half-finished state
    /// for a second caller to observe.
    begin := func(mut self: Build, step: Str) returns Bool {
        if self.done.has(step) { return false }
        self.done.add(own step.clone())
        return true
    }
}

/// An environment variable, or ~fallback~ when it is unset or empty.
env_or := proc(name: Str, fallback: Str) returns Str {
    value := get_env(name)
    if value.is_empty() { return fallback }
    return value
}

// --- Small helpers over the process and filesystem primitives ---

/// Run a command, printing it first, and stop the build if it fails.
/// The one-liner form of Cmd.run_checked for commands with no options.
run := proc(parts: ..Str) {
    c := Cmd.new()
    mut i : USize = 0
    while i < parts.len() {
        ref p : Str = parts[i]
        c.arg(p)
        i++
    }
    c.run_checked()
}

/// The same for an argv built up in a Vec -- what the loops over
/// target data produce.
run_argv := proc(argv: Vec(Str)) {
    c := Cmd.new()
    for a : Str in argv {
        c.arg(a)
    }
    c.run_checked()
}

/// True when ~path~ names a program this host can run. Probing by
/// running it is the portable question: ~command -v~ is shell syntax
/// and ~which~ is not everywhere. The probe's own output is captured
/// so a missing tool stays quiet -- the caller decides what to say.
have_tool := proc(name: Str) returns Bool {
    probe := Cmd.new(name, "--version")
    probe.capture()
    return probe.run() == 0
}

/// A cross recipe's C compiler, checked where the build starts (issue
/// #435) instead of left to fail deep inside cmake or configure as
/// "compiler not found". ~cc~ may carry flags; its first word is the
/// program. ~option~ is the bin/make option that names another
/// compiler, if the recipe has one.
require_cross_cc := proc(cc: Str, option: Str, what: Str) {
    mut tool := cc.clone()
    space := cc.find(" ")
    if space >= 0 { tool = cc.substr(0, space.to_usize()).clone() }
    if have_tool(tool) { return }
    if option.is_empty() {
        panic("the ", what, " build needs the C compiler '", tool, "', which is not installed")
    }
    panic("the ", what, " build needs the C compiler '", tool, "', which is not installed -- pass ", option, " to name this host's one")
}

/// True when ~output~ is missing, or older than any of ~inputs~. The
/// whole dependency check: no manifest, no hashes, no cache -- the
/// small description is recomputed every run and mtimes answer it.
///
/// An empty input list means what a Make rule with no prerequisites
/// means: build it once, then leave it alone.
///
/// A declared input that does not exist is a bug in the description,
/// not a reason to rebuild: it fails here rather than turning into a
/// confusing compiler error later.
needs_rebuild := proc(output: Str, inputs: Vec(Str)) returns Bool {
    out_time := file_mtime(output)
    if out_time < 0 { return true }
    for input : Str in inputs {
        in_time := file_mtime(input)
        if in_time < 0 {
            panic("build input '", input, "' does not exist (needed by '", output, "')")
        }
        if in_time > out_time { return true }
    }
    return false
}

no_inputs := func() returns Vec(Str) {
    return Vec(Str).new()
}

/// Append every entry of ~dir~ ending in ~suffix~ to ~out~, as paths.
/// The Makefile's $(wildcard src/core/*.til), with the same shallow
/// one-directory meaning, and sorted for the same reason make sorts:
/// so a sweep's output does not depend on the file system's order.
add_matching := proc(mut out: Vec(Str), dir: Str, suffix: Str) {
    mut names := Vec(Str).new()
    for name : Str in Dir.list(dir) {
        if name.ends_with(suffix) {
            names.push(own format(dir, "/", name))
        }
    }
    sort_names(names)
    out.append(own names)
}

/// Insertion sort by byte order. Small lists (a directory of sources),
/// no dependency on anything but Str comparison. Sorted because make's
/// $(wildcard) is: a sweep's order should not follow the file system's.
sort_names := func(mut names: Vec(Str)) {
    mut i : USize = 1
    while i < names.len() {
        mut j := i
        while j > 0 {
            ref prev : Str = names[j - 1]
            ref cur : Str = names[j]
            if prev.lt(cur) { break }
            earlier := cur.clone()
            later := prev.clone()
            names.unsafe_set(j - 1, own earlier)
            names.unsafe_set(j, own later)
            j = j - 1
        }
        i++
    }
}

copy := proc(src: Str, dst: Str) {
    if copy_file(src, dst) != 0 {
        panic("could not copy '", src, "' to '", dst, "'")
    }
}

/// Every .til source the compiler is built from: the Makefile's
/// CORE + STD + SELF + LIB_TIL + src/til.til.
compiler_sources := proc() returns Vec(Str) {
    mut out := Vec(Str).new()
    add_matching(out, "src/core", ".til")
    add_matching(out, "src/std", ".til")
    add_matching(out, "src/self", ".til")
    add_matching(out, "examples/lib", ".til")
    add_matching(out, "vendor/bindings", ".til")
    out.push(own "src/til.til")
    return out
}

/// bin/til_boot is the Makefile's to build: it comes from the last
/// commit through git, not from the working tree, so nothing here can
/// reconstruct it. Say that instead of failing later on a missing file.
require_boot := proc() {
    if File.is_file(BOOT).not() {
        panic(BOOT, " is missing -- run `make` first: the bootstrap compiler is built from the last commit, which only the Makefile does")
    }
}

/// The host's libffi is the Makefile's too: the checked-in compiler C
/// calls into it, so it has to exist before bin/til_boot can link.
require_libffi := proc(b: Build) {
    stamp := format(LIBFFI_DIR, "/build-", b.host.target_name(), "/.built")
    if File.exists(stamp).not() {
        panic(stamp, " is missing -- run `make` first: the host's libffi is built by the Makefile, before the bootstrap compiler that links it")
    }
}

/// One target's libffi archive: the path src/self/interpreter.til's
/// link() line names for that target.
libffi_lib := func(target: Str) returns Str {
    return format(LIBFFI_DIR, "/build-", target, "/.libs/libffi.a")
}

// --- Native link flags ---
//
// The Darwin/Linux differences that used to be spread through the first
// 150 lines of the Makefile, in one place each.

/// What raylib needs from the system at final link. macOS keeps the
/// desktop frameworks; -lrt does not exist there (its contents live in
/// libSystem).
raylib_sys_flags := func(host: Host) returns Vec(Str) {
    mut out := Vec(Str).new()
    if host.is_mac() {
        out.push(own "-framework")
        out.push(own "OpenGL")
        out.push(own "-framework")
        out.push(own "Cocoa")
        out.push(own "-framework")
        out.push(own "IOKit")
        out.push(own "-framework")
        out.push(own "CoreAudio")
        out.push(own "-framework")
        out.push(own "CoreVideo")
        return out
    }
    out.push(own "-lrt")
    return out
}

/// Same for nng: -latomic on Linux, nothing on macOS.
nng_sys_flags := func(host: Host) returns Vec(Str) {
    mut out := Vec(Str).new()
    if host.is_mac().not() { out.push(own "-latomic") }
    return out
}

/// "Keep every member of this archive", spelled for the host's linker:
/// GNU ld brackets the archive, Apple's ld64 takes -force_load and
/// rejects the GNU flags outright.
force_load_args := func(host: Host, archive: Str) returns Vec(Str) {
    mut out := Vec(Str).new()
    if host.is_mac() {
        out.push(own format("-Wl,-force_load,", archive))
        return out
    }
    out.push(own "-Wl,--whole-archive")
    out.push(own archive.clone())
    out.push(own "-Wl,--no-whole-archive")
    return out
}

// --- Native vendor artifacts ---

/// Loadable twins of the vendored archives, for the INTERPRETER only.
///
/// The two backends need different artifacts from the same library. A
/// COMPILED program links the .a and stays self-contained. INTERPRETED
/// code calls through libffi, which needs the function's ADDRESS at run
/// time, and a static archive can never provide one: it cannot be
/// dlopen'd, and it contributes nothing to bin/til either, since a
/// linker keeps only the members the compiler references and the
/// compiler never calls raylib.
///
/// So each .a gets a .so beside it, force-linked so every member is
/// kept; src/self/interpreter.til dlopens the sibling .so of any
/// archive a program links. Built here, once, rather than by the
/// interpreter at run time: same link either way, but this keeps ~cc~
/// off the REPL's per-turn path.
/// EVERY archive a mode's link() names needs a twin here. nng was left
/// out when this mechanism landed, so every program in an nng mode --
/// even one that never called nng -- died at interpret startup on the
/// fatal twin-load panic in ffi_load_archive_twin. The compiled path
/// never noticed, and neither did the suite: the nng tests only build.
build_ffi_twins := proc(mut b: Build) {
    if b.begin("ffi_twins").not() { return }
    build_gui_pair(b, b.host.target_name())
    build_nng(b)
    build_secp256k1(b)

    // The host's raylib and tinyfd: the twins beside the archives
    // src/modes/gui.til's link()s name for the host target.
    raylib_host_lib := raylib_lib(b.host.target_name())
    raylib_so := format(raylib_host_lib.strip_suffix(".a"), ".so")
    mut raylib_inputs := Vec(Str).new()
    raylib_inputs.push(own raylib_host_lib.clone())
    if needs_rebuild(raylib_so, raylib_inputs) {
        mut argv := Vec(Str).new()
        argv.push(own "cc")
        argv.push(own "-shared")
        argv.push(own "-fPIC")
        argv.push(own "-o")
        argv.push(own raylib_so.clone())
        argv.append(own force_load_args(b.host, raylib_host_lib))
        argv.push(own "-lm")
        argv.push(own "-lpthread")
        argv.append(own raylib_sys_flags(b.host))
        run_argv(argv)
    }

    tinyfd_host_lib := tinyfd_lib(b.host.target_name())
    tinyfd_so := format(tinyfd_host_lib.strip_suffix(".a"), ".so")
    mut tinyfd_inputs := Vec(Str).new()
    tinyfd_inputs.push(own tinyfd_host_lib.clone())
    if needs_rebuild(tinyfd_so, tinyfd_inputs) {
        mut argv := Vec(Str).new()
        argv.push(own "cc")
        argv.push(own "-shared")
        argv.push(own "-fPIC")
        argv.push(own "-o")
        argv.push(own tinyfd_so.clone())
        argv.append(own force_load_args(b.host, tinyfd_host_lib))
        run_argv(argv)
    }

    // The host's nng: the interpreter loads the twin beside the archive
    // the server modes' link() names for the host target.
    nng_host_lib := nng_lib(b.host.target_name())
    nng_so := format(nng_host_lib.strip_suffix(".a"), ".so")
    mut nng_inputs := Vec(Str).new()
    nng_inputs.push(own nng_host_lib.clone())
    if needs_rebuild(nng_so, nng_inputs) {
        mut argv := Vec(Str).new()
        argv.push(own "cc")
        argv.push(own "-shared")
        argv.push(own "-fPIC")
        argv.push(own "-o")
        argv.push(own nng_so.clone())
        argv.append(own force_load_args(b.host, nng_host_lib))
        argv.push(own "-lpthread")
        argv.append(own nng_sys_flags(b.host))
        run_argv(argv)
    }

    // The host's libsecp256k1: the twin beside the archive std/crypto's
    // link() names for the host target.
    secp_host_lib := secp256k1_lib(b.host.target_name())
    secp_so := format(secp_host_lib.strip_suffix(".a"), ".so")
    mut secp_inputs := Vec(Str).new()
    secp_inputs.push(own secp_host_lib.clone())
    if needs_rebuild(secp_so, secp_inputs) {
        mut argv := Vec(Str).new()
        argv.push(own "cc")
        argv.push(own "-shared")
        argv.push(own "-fPIC")
        argv.push(own "-o")
        argv.push(own secp_so.clone())
        argv.append(own force_load_args(b.host, secp_host_lib))
        run_argv(argv)
    }
    // The host's libffi (issue #422): a program that imports the libffi
    // binding links it through link() like any other archive, so an
    // interpreted one loads this twin. The Makefile builds the archive
    // --with-pic for it.
    require_libffi(b)
    ffi_host_lib := libffi_lib(b.host.target_name())
    ffi_so := format(ffi_host_lib.strip_suffix(".a"), ".so")
    mut ffi_inputs := Vec(Str).new()
    ffi_inputs.push(own ffi_host_lib.clone())
    if needs_rebuild(ffi_so, ffi_inputs) {
        mut argv := Vec(Str).new()
        argv.push(own "cc")
        argv.push(own "-shared")
        argv.push(own "-fPIC")
        argv.push(own "-o")
        argv.push(own ffi_so.clone())
        argv.append(own force_load_args(b.host, ffi_host_lib))
        run_argv(argv)
    }
}

/// The host's own nng, what bin/til and the interpreter's twin link.
build_nng := proc(mut b: Build) {
    build_nng_target(b, b.host.target_name())
}

/// libsecp256k1 (issue #235), built from the vendored upstream release
/// via cmake. Static only, with exactly the modules BIP-340 needs:
/// extrakeys (x-only public keys) and schnorrsig. ECDH, recovery,
/// musig, ellswift and silent payments are switched off, as are the
/// benchmarks, tests and examples, so the build is the library alone
/// and needs no system package. The upstream test suite is run by hand
/// when the vendored release is imported or updated (see the REM in
/// doc/ffi.org), not here.
///
/// The host's own archive (built like every other target's by
/// build_secp256k1_target, issue #422): what std/crypto links for the
/// host, and what the interpreter's twin is made from.
build_secp256k1 := proc(mut b: Build) {
    build_secp256k1_target(b, b.host.target_name())
}

/// The cmake configure command every libsecp256k1 build shares: the
/// library alone, with exactly the modules BIP-340 needs. One list, so
/// the native archive and the windows cross archives cannot drift to
/// different module sets.
secp256k1_cmake_configure := func(build_dir: Str) returns Vec(Str) {
    mut argv := Vec(Str).new()
    argv.push(own "cmake")
    argv.push(own "-S")
    argv.push(own "vendor/secp256k1")
    argv.push(own "-B")
    argv.push(own build_dir.clone())
    argv.push(own "-DCMAKE_BUILD_TYPE=Release")
    argv.push(own "-DBUILD_SHARED_LIBS=OFF")
    argv.push(own "-DSECP256K1_ENABLE_MODULE_ECDH=OFF")
    argv.push(own "-DSECP256K1_ENABLE_MODULE_RECOVERY=OFF")
    argv.push(own "-DSECP256K1_ENABLE_MODULE_EXTRAKEYS=ON")
    argv.push(own "-DSECP256K1_ENABLE_MODULE_SCHNORRSIG=ON")
    argv.push(own "-DSECP256K1_ENABLE_MODULE_MUSIG=OFF")
    argv.push(own "-DSECP256K1_ENABLE_MODULE_ELLSWIFT=OFF")
    argv.push(own "-DSECP256K1_ENABLE_MODULE_SILENTPAYMENTS=OFF")
    argv.push(own "-DSECP256K1_BUILD_BENCHMARK=OFF")
    argv.push(own "-DSECP256K1_BUILD_TESTS=OFF")
    argv.push(own "-DSECP256K1_BUILD_EXHAUSTIVE_TESTS=OFF")
    argv.push(own "-DSECP256K1_BUILD_CTIME_TESTS=OFF")
    argv.push(own "-DSECP256K1_BUILD_EXAMPLES=OFF")
    argv.push(own "-DSECP256K1_INSTALL=OFF")
    // Upstream auto-detects valgrind/memcheck.h and, when found, compiles
    // in its client requests and adds the header's directory to the
    // include path. That instrumentation serves the ctime tests, which
    // are not built here; left on, it made the archive depend on whether
    // the HOST has valgrind installed, and put the host's /usr/include in
    // front of mingw's own headers in the windows cross builds.
    argv.push(own "-DSECP256K1_VALGRIND=OFF")
    return argv
}

/// Everything a native til build links or dlopens. bin/til_boot needs
/// none of it -- it links libffi and nothing else vendored, which is
/// why the Makefile's bootstrap does not build these.
build_vendor := proc(mut b: Build) {
    if b.begin("vendor").not() { return }
    if fasm_prepare(get_cwd_str(), false) != 0 { exit(1) }
    build_gui_pair(b, b.host.target_name())
    build_ffi_twins(b)
    build_nng(b)
    build_secp256k1(b)
}

// --- Steps ---
//
// One function per artifact. Each calls the steps it depends on, asks
// Build whether it has already run, compares its output against its
// declared inputs, and only then does the work. That is the useful part
// of a dependency graph -- explicit edges, laziness, and one run per
// invocation -- without a scheduler to build first.

/// bin/til, and the committed C it regenerates. The compiler uses compact
/// U32 container metadata internally; programs it builds remain target-width
/// by default because --usize=32 applies only while compiling src/til.til.
/// The single-pass build: HEAD's compiler translates the current sources.
build_til := proc(mut b: Build) {
    if b.begin("til").not() { return }
    require_boot()
    build_vendor(b)
    mut inputs := compiler_sources()
    inputs.push(own BOOT.clone())
    if needs_rebuild(TIL, inputs).not() { return }
    run(BOOT, "build", "--usize=32", "-o", TIL, "-c", "gen/til/til.c", "src/til.til")
    regenerate_boot()
}

/// Pass 2: rebuild with the compiler pass 1 just produced, so the
/// committed boot/til.c is the new compiler applied to itself.
///
/// The Makefile needs ~$(MAKE) -o bin/til_boot -o bin/til~ here to stop
/// a recursive make from re-running pass 1 and overwriting exactly the
/// artifacts this step exists to produce. Nothing like that is needed
/// in a program: pass 1 already ran, so build_til is a no-op for the
/// rest of this invocation, and the sequence is just two statements.
build_two_pass := proc(mut b: Build) {
    if b.begin("two_pass").not() { return }
    build_til(b)
    // Keep --force-rebuild for older compilers that still implement #170's
    // timestamp shortcut. The bootstrap C path is explicit in both passes.
    run(TIL, "build", "--usize=32", "--force-rebuild", "-o", TIL, "-c", "gen/til/til.c", "src/til.til")
    regenerate_boot()
}

/// The one source-tree mutation a normal build performs, and the
/// reason it performs it: the next commit's til_boot is compiled from
/// this C.
regenerate_boot := proc() {
    copy("gen/til/til.c", "boot/til.c")
    copy("gen/til/til_forward.h", "boot/til_forward.h")
}

build_asan := proc(mut b: Build) {
    if b.begin("asan").not() { return }
    build_til(b)
    mut inputs := compiler_sources()
    inputs.push(own TIL.clone())
    if needs_rebuild(ASAN, inputs).not() { return }
    run(TIL, "build", "--usize=32", "--asan", "-o", ASAN, "src/til.til")
}

/// The gdb build: the one link of the compiler that does not go
/// through til, so it needs the native flags spelled out.
build_debug := proc(mut b: Build) {
    if b.begin("debug").not() { return }
    build_til(b)
    require_libffi(b)
    mut inputs := Vec(Str).new()
    inputs.push(own "boot/til.c")
    add_matching(inputs, "src/c", ".c")
    add_matching(inputs, "src/c", ".h")
    if needs_rebuild(DEBUG, inputs).not() { return }

    mut argv := Vec(Str).new()
    argv.push(own "cc")
    argv.push(own "-g")
    argv.push(own "-O0")
    argv.push(own "-Wall")
    argv.push(own "-Wextra")
    argv.push(own "-Werror")
    argv.push(own "-fsigned-char")
    argv.push(own "-Iboot")
    argv.push(own "-Isrc")
    argv.push(own "-Isrc/c")
    argv.push(own "boot/til.c")
    add_matching(argv, "src/c", ".c")
    argv.push(own "-rdynamic")
    argv.push(own "-ldl")
    argv.push(own format("-L", LIBFFI_DIR, "/build-", b.host.target_name(), "/.libs"))
    argv.push(own "-lffi")
    argv.push(own format("-L", RAYLIB_DIR, "/build-", b.host.target_name()))
    argv.push(own "-lraylib")
    argv.push(own "-lm")
    argv.push(own "-lpthread")
    argv.append(own raylib_sys_flags(b.host))
    argv.push(own format("-L", TINYFD_DIR, "/build-", b.host.target_name()))
    argv.push(own "-ltinyfd")
    argv.push(own format("-L", NNG_DIR, "/build-", b.host.target_name()))
    argv.push(own "-lnng")
    argv.push(own "-lpthread")
    argv.append(own nng_sys_flags(b.host))
    argv.push(own "-o")
    argv.push(own DEBUG.clone())
    run_argv(argv)
}

/// A til program built from one source with an explicit output path,
/// depending on bin/til and the standard library it was compiled from.
build_program := proc(mut b: Build, step: Str, source: Str, output: Str) {
    if b.begin(step).not() { return }
    build_til(b)
    mut inputs := compiler_sources()
    inputs.push(own TIL.clone())
    inputs.push(own source.clone())
    if needs_rebuild(output, inputs).not() { return }
    run(TIL, "build", "-o", output, source)
}

build_test_runner := proc(mut b: Build) {
    build_program(b, "test_runner", "src/test_runner.til", "bin/test_runner")
}

build_plot := proc(mut b: Build) {
    build_program(b, "plot", "examples/plot.til", "bin/plot")
}

build_tests := proc(mut b: Build) {
    build_program(b, "tests", "src/tests.til", "bin/tests")
}

/// Explicit USize-width regressions (issue #309), interpreted and compiled,
/// including compile-time interpreter folding and cross-width self-translation
/// under ASAN.
check_usize64 := proc(mut b: Build) {
    if b.begin("check_usize64").not() { return }
    build_til(b)
    build_asan(b)
    mkdir_p("tmp")
    run(TIL, "--usize=64", "test/usize64.til")
    run(TIL, "build", "--usize=64", "-o", "tmp/usize64", "test/usize64.til")
    run("tmp/usize64")
    run(TIL, "build", "--usize=64", "-o", "tmp/usize64_sizes", "test/usize64_sizes.til")
    run("tmp/usize64_sizes")
    run(ASAN, "build", "--usize=64", "-o", "tmp/usize64_comptime", "test/usize64_comptime.til")
    run("tmp/usize64_comptime")
    run(TIL, "build", "--asan", "--usize=32", "-o", "tmp/til_usize32_asan", "src/til.til")
    run("tmp/til_usize32_asan", "translate", "--force-rebuild", "-c", "tmp/til_usize32_to_64.c", "src/til.til")
}

/// The emitted C must compile clean under gcc AND clang: the local
/// loop is gcc-only, so a diagnostic only clang implements (the
/// -Wswitch-bool that broke every macOS job) is otherwise invisible
/// until CI. A syntax-only pass over the freshly emitted compiler
/// covers the whole class in a couple of seconds.
check_clang := proc(mut b: Build) {
    if b.begin("check_clang").not() { return }
    build_til(b)
    if have_tool("clang").not() {
        println("check_clang: clang not installed on this host, skipping")
        return
    }
    run("clang", "-fsyntax-only", "-Wall", "-Wextra", "-Werror", "-fsigned-char",
        "-Isrc", "-Isrc/c", "-Iboot", "boot/til.c")
    println("check_clang: generated C is clang-clean")
}

/// The suite runner, with the host's window server and the caller's
/// -j. Built here rather than spelled out at each call site so the
/// three suite commands cannot drift apart.
suite_cmd := proc(b: Build, extra: ..Str) returns Cmd {
    c := Cmd.new()
    if b.host.needs_xvfb() {
        c.arg("xvfb-run")
        c.arg("--auto-servernum")
    }
    c.arg("bin/tests")
    mut i : USize = 0
    while i < extra.len() {
        ref e : Str = extra[i]
        c.arg(e)
        i++
    }
    if b.jobs.is_empty().not() {
        c.arg(format("-j", b.jobs))
    }
    return c
}

/// test/constfold.c is a committed fixture regenerated by every suite
/// run: the constfolder's own emitted C, kept under review as a file
/// rather than as a golden string inside a test.
refresh_constfold := proc() {
    copy("gen/til/test/constfold.c", "test/constfold.c")
}

/// The full suite under ASAN. The default before committing.
run_test := proc(mut b: Build) {
    if b.begin("test").not() { return }
    build_til(b)
    build_asan(b)
    build_test_runner(b)
    build_plot(b)
    build_tests(b)
    check_usize64(b)
    check_clang(b)
    c := suite_cmd(b, "--til-bin", ASAN, "--asan")
    c.run_checked()
    refresh_constfold()
}

/// The suite without ASAN: faster, at the cost of not catching leaks
/// or heap errors in the compiler or in the programs it builds.
run_test_fast := proc(mut b: Build) {
    if b.begin("test_fast").not() { return }
    build_til(b)
    build_test_runner(b)
    build_plot(b)
    build_tests(b)
    check_usize64(b)
    check_clang(b)
    c := suite_cmd(b)
    c.run_checked()
    refresh_constfold()
}

/// Rewrite every expected-output golden (test/*.expected) from what the
/// tests actually print -- issue #172. Deliberately NOT part of any suite
/// run: the goldens are reviewed artifacts, so refreshing them is an
/// explicit act whose result is read as a git diff. Without ASAN, because
/// a leak report appended to a program's output would be frozen into the
/// expectation.
run_test_regen := proc(mut b: Build) {
    if b.begin("test_regen").not() { return }
    build_til(b)
    build_test_runner(b)
    build_plot(b)
    build_tests(b)
    c := suite_cmd(b, "--regen")
    c.run_checked()
    refresh_constfold()
}

/// The suite without the GUI tests, for hosts with no window server.
run_test_nogui := proc(mut b: Build) {
    if b.begin("test_nogui").not() { return }
    build_til(b)
    build_test_runner(b)
    build_plot(b)
    build_tests(b)
    c := Cmd.new("bin/tests", "--no-gui")
    if b.jobs.is_empty().not() { c.arg(format("-j", b.jobs)) }
    c.run_checked()
}

/// The two-pass equivalent of ~test~: everything runs against the
/// self-applied compiler. Use for a "Two-pass: "-prefixed commit.
run_test_two_pass := proc(mut b: Build) {
    if b.begin("test_two_pass").not() { return }
    build_two_pass(b)
    // Deliberately not build_asan: pass 2 replaced bin/til after the
    // mtime check that step would make, and this ASAN compiler has to
    // come from the self-applied one.
    run(TIL, "build", "--usize=32", "--asan", "-o", ASAN, "src/til.til")
    b.begin("asan")
    check_usize64(b)
    check_clang(b)
    run(TIL, "build", "-o", "bin/test_runner", "src/test_runner.til")
    run(TIL, "build", "-o", "bin/plot", "examples/plot.til")
    run(TIL, "build", "-o", "bin/tests", "src/tests.til")
    b.begin("test_runner")
    b.begin("plot")
    b.begin("tests")
    c := suite_cmd(b, "--til-bin", ASAN, "--asan")
    c.run_checked()
    refresh_constfold()
}

/// The REPL help() smoke test. On demand: the REPL runs the whole
/// compiler pipeline per turn, which is too expensive for the suite.
run_test_repl_help := proc(mut b: Build) {
    if b.begin("test_repl_help").not() { return }
    build_til(b)
    mkdir_p("tmp")
    run(TIL, "run", "test/repl_help.til")
}

/// Native TempleOS acceptance under QEMU TCG, at both USize widths.
run_test_templeos := proc(mut b: Build) {
    if b.begin("test_templeos").not() { return }
    build_til(b)
    if mkdir_p("tmp/templeos") != 0 { panic("could not create TempleOS test directory") }
    run(TIL, "run", "-o", "tmp/templeos/runner", "-c", "tmp/templeos/runner.c", "test/templeos.til")
}

/// The JVM corpus (#375): every program in test/jvm.til built through
/// javac -Werror and run, at both USize widths, against the
/// interpreter. On demand: it needs a JDK 17+, which the default suite
/// deliberately does not.
run_test_jvm := proc(mut b: Build) {
    if b.begin("test_jvm").not() { return }
    build_til(b)
    mkdir_p("tmp/jvm")
    run(TIL, "run", "-o", "tmp/jvm/runner", "-c", "tmp/jvm/runner.c", "test/jvm.til")
}

/// doc/gen/ and the UML outputs. On demand: doc generation over
/// src/til.til runs the full init+typer pipeline.
run_doc := proc(mut b: Build) {
    if b.begin("doc").not() { return }
    build_til(b)
    File.remove_tree("doc/gen")
    run(TIL, "doc", "src/til.til")
    run(TIL, "run", "examples/uml.til")
}

/// issues/summary.org, regenerated from issues/open/. What to run
/// instead of the suite when only issue files changed.
run_summary := proc(mut b: Build) {
    if b.begin("summary").not() { return }
    build_til(b)
    mkdir_p("tmp")
    run(TIL, "run", "examples/issues.til")
}

/// Install the compiler. Prefix is til's own option and defaults to
/// /usr/local; the Makefile never passed one, and neither does this.
/// ~bin/til install --prefix=<path> src/til.til~ is the way to choose.
run_install := proc(mut b: Build) {
    if b.begin("install").not() { return }
    build_til(b)
    copy_compiler_install(b.host)
}

// No compiler invocation here: all checkout writes must have finished
// as the build user before sudo's privileged process copies the result.
copy_compiler_install := proc(host: Host) {
    prefix := default_install_prefix()
    destination := format(prefix, "/bin/til", host.exe_suffix())
    if install_executable(TIL, destination, get_cwd_str(), prefix) != 0 {
        exit(1)
    }
}

/// Regenerate the in-tree FFI bindings from the C headers. MANUAL, and
/// destructive: the committed vendor/bindings/*.til files start life as
/// generator output and are hand-curated afterwards, because C headers
/// cannot express til's qualifier axes (proc vs func for purity, own vs
/// ref for pointer ownership, never-NULL promises). Running this blows
/// those edits away -- redo the audit in doc/ffi.org before committing.
///
/// raylib needs two headers: raylib.h plus rcamera.h, which raylib.h
/// does not include but which ships the camera helpers. Each is
/// generated separately and the two are joined, dropping the second
/// file's ~mode lib~ line so the result has exactly one mode header.
run_update_c_libs := proc(mut b: Build) {
    if b.begin("update_c_libs").not() { return }
    build_til(b)
    mkdir_p("tmp")
    mkdir_p("vendor/bindings")
    run(TIL, "bindings", "-o", "vendor/bindings/tinyfd.til",
        "vendor/tinyfiledialogs/tinyfiledialogs.h")
    run(TIL, "bindings", "-o", "vendor/bindings/libffi.til",
        "vendor/libffi/build-linux-x64/include/ffi.h")
    run(TIL, "bindings", "-o", "vendor/bindings/nng.til",
        "vendor/nng/include/nng/nng.h")
    // secp256k1_schnorrsig.h includes secp256k1.h and
    // secp256k1_extrakeys.h from the same directory, and the binder
    // keeps every declaration from the input header's directory, so
    // this one pass covers the whole enabled API (context, x-only
    // keys, BIP-340 signatures).
    run(TIL, "bindings", "-o", "vendor/bindings/secp256k1.til",
        "vendor/secp256k1/include/secp256k1_schnorrsig.h")
    // raylib.til is TWO headers in one audited file, so both passes must be
    // seeded from it or the audit-preservation pass reads a stale tmp file
    // and the 161 raylib audits are lost anyway. Seed the rcamera pass
    // FIRST (a copy of the whole committed file), then regenerate the
    // raylib half in place. Each pass lists the OTHER half's declarations
    // as "not produced by this header" -- expected here, not a loss: the
    // raylib pass names the rcamera tail (~14), the rcamera pass names the
    // raylib half (~600), and the append below reunites them.
    copy("vendor/bindings/raylib.til", "tmp/rcamera.til")
    run(TIL, "bindings", "-o", "vendor/bindings/raylib.til", "vendor/raylib/src/raylib.h")
    run(TIL, "bindings", "-o", "tmp/rcamera.til", "vendor/raylib/src/rcamera.h")
    File.appendfile("vendor/bindings/raylib.til", without_mode_line(File.readfile("tmp/rcamera.til")))
}

/// A generated binding with its ~mode lib~ header line removed, so it
/// can be appended to another one. The Makefile spelled this as a sed
/// script; one line of text handling does not need a process.
without_mode_line := func(source: Str) returns Str {
    mut out := Str.with_capacity(source.len())
    mut first := true
    for line : Str in source.split("\n") {
        if line == "mode lib" { continue }
        // Join with the separator rather than terminate with it:
        // split() keeps the empty field after a file's final newline,
        // so terminating would add one newline per rebuild.
        if first.not() { out.push_str("\n") }
        out.push_str(line)
        first = false
    }
    return out
}

/// Remove the build artifacts, leaving vendor/ alone.
///
/// bin/make is itself in bin/, so this deletes the running program.
/// POSIX unlinks a running image without complaint. Windows refuses,
/// so there the program is renamed aside and the leftover is removed
/// by the next run, once it is no longer mapped -- a failed deletion
/// is never skipped quietly.
run_clean := proc(mut b: Build) {
    if b.begin("clean").not() { return }
    self_path := self_bin(b.host)
    if b.host.os == "windows" {
        if File.exists(self_path) { File.rename(self_path, self_backup(b.host)) }
    }
    clear_dir("bin")
    clear_dir("gen")
    File.remove_tree("tmp/boot")
}

/// Remove the vendored libraries' build artifacts so the next build
/// makes them again from the committed sources. Separate from ~clean~
/// so normal rebuilds stay fast; needed after upgrading a vendored
/// library, where a stale stamp would keep linking the old archive.
/// git clean rather than each library's own ~make clean~: after a tree
/// swap the leftover build system belongs to the OLD version.
/// Emsdk's control tree is committed; its node/upstream/config/stamp
/// install outputs are ignored and therefore removed by the same command.
run_clean_vendor := proc(mut b: Build) {
    if b.begin("clean_vendor").not() { return }
    // FASM's executable is also its bootstrap seed; retain it so changed
    // assembly can rebuild itself without another external bootstrap.
    run("git", "clean", "-fdx", "vendor/raylib", "vendor/tinyfiledialogs",
        "vendor/nng", "vendor/secp256k1", "vendor/libffi", EMSDK_DIR)
}

/// ~rm -rf <dir>/*~: the entries go, the directory stays.
clear_dir := proc(dir: Str) {
    if File.is_dir(dir).not() { return }
    for name : Str in Dir.list(dir) {
        File.remove_tree(format(dir, "/", name))
    }
}

// --- GUI archives ---
//
// raylib and tinyfd for every target (issue #422), as data plus one
// recipe each rather than near-identical recipes per target. The reasons
// a target differs live next to the target, which is where the
// Makefile's comments used to be.

GuiTarget := struct {
    // The --target name; the archives go under build-<target>.
    target := ""
    // A cross build's toolchain; the host's own archives use the host's.
    // Empty only for riscv32 before --riscv32-cc is given.
    cc := ""
    ar := ""
    // The bin/make option that picks cc, for the missing-compiler report.
    cc_option := ""
    // raylib's PLATFORM_OS, needed by the mingw builds.
    platform_os := ""
    // Extra flags for raylib's CUSTOM_CFLAGS, and for the tinyfd
    // compile (only the -m32 builds need anything there).
    raylib_cflags := ""
    tinyfd_cflags := ""
    // The mac targets' arch: off a mac (or for the mac that is not this
    // one) their archives are the SDK-less recipes under macOS cross.
    mac_arch := ""
    // wasm32: raylib only, through emscripten (build_raylib_web).
    web := false
}

/// One target's raylib archive: the path src/modes/gui.til's link() line
/// names for that target.
raylib_lib := func(target: Str) returns Str {
    return format(RAYLIB_DIR, "/build-", target, "/libraylib.a")
}

/// One target's tinyfd archive, likewise.
tinyfd_lib := func(target: Str) returns Str {
    return format(TINYFD_DIR, "/build-", target, "/libtinyfd.a")
}

/// The vendored X11 headers every Linux GUI build compiles against.
/// They are arch-independent, and GLFW dlopens libX11 on the target
/// device at run time, so no per-arch X11 sysroot is needed to build or
/// link -- only the cross compiler.
x11_cflags := proc() returns Str {
    return format("-DSUPPORT_CLIPBOARD_IMAGE=0 -I", get_cwd_str(), "/vendor/x11/include")
}

/// Every GUI target, as data. src/modes/gui.til lists the same ones.
gui_targets := proc(b: Build) returns Vec(GuiTarget) {
    mut out := Vec(GuiTarget).new()
    out.push(own GuiTarget(target = "linux-x64",
        cc = b.linux_x64_cc.clone(), ar = cross_ar(b.linux_x64_cc),
        cc_option = "--linux-x64-cc=<path> (or LINUX_X64_CC)", raylib_cflags = x11_cflags()))
    // The 64-bit linux cross targets (issue #420), with the distro
    // cross gcc.
    out.push(own GuiTarget(target = "linux-arm64",
        cc = "aarch64-linux-gnu-gcc", ar = "aarch64-linux-gnu-ar",
        raylib_cflags = x11_cflags()))
    out.push(own GuiTarget(target = "linux-riscv64",
        cc = "riscv64-linux-gnu-gcc", ar = "riscv64-linux-gnu-ar",
        raylib_cflags = x11_cflags()))
    // linux-x86: the host compiler in 32-bit mode, so only gcc-multilib
    // is required -- the same dependency the CLI target already needs.
    out.push(own GuiTarget(target = "linux-x86", cc = "gcc", ar = "ar",
        raylib_cflags = format("-m32 ", x11_cflags()), tinyfd_cflags = "-m32"))
    out.push(own GuiTarget(target = "linux-arm32",
        cc = "arm-linux-gnueabihf-gcc", ar = "arm-linux-gnueabihf-ar",
        raylib_cflags = x11_cflags()))
    // No distro ships a riscv32 gcc: CI downloads the Bootlin
    // toolchain and passes it in, and the matching ar is derived from
    // the compiler's name.
    out.push(own GuiTarget(target = "linux-riscv32",
        cc = b.riscv32_cc.clone(), ar = cross_ar(b.riscv32_cc),
        cc_option = "--riscv32-cc=<path> (or RISCV32_CC)", raylib_cflags = x11_cflags()))
    // mingw supplies the win32 GL/GDI backend, so the windows builds
    // need no sysroot and no X11 headers.
    out.push(own GuiTarget(target = "windows-x64", platform_os = "WINDOWS",
        cc = "x86_64-w64-mingw32-gcc", ar = "x86_64-w64-mingw32-ar"))
    out.push(own GuiTarget(target = "windows-x86", platform_os = "WINDOWS",
        cc = "i686-w64-mingw32-gcc", ar = "i686-w64-mingw32-ar"))
    // A mac host builds its own arch natively, against the vendored X11
    // headers like before; anything else is build_mac_raylib/tinyfd.
    for arch : Str in MAC_ARCHES.split(" ") {
        out.push(own GuiTarget(target = format("macos-", arch), mac_arch = arch.clone(),
            raylib_cflags = x11_cflags()))
    }
    out.push(own GuiTarget(target = "wasm32", web = true))
    return out
}

/// The ar beside a gcc named by path or prefix (x86_64-linux-gnu-gcc ->
/// x86_64-linux-gnu-ar).
cross_ar := func(cc: Str) returns Str {
    if cc.is_empty() { return "" }
    if cc.ends_with("-gcc") {
        return format(cc.strip_suffix("-gcc"), "-ar")
    }
    return format(cc, "-ar")
}

gui_target := proc(b: Build, target: Str) returns GuiTarget {
    for t : GuiTarget in gui_targets(b) {
        if t.target == target { return t.clone() }
    }
    panic("no gui build for --target=", target)
    return GuiTarget()
}

/// A cross build's compiler, checked where the build starts, not three
/// commands later as "riscv32--gcc: not found".
require_gui_cc := proc(t: GuiTarget) {
    if t.cc.is_empty() {
        panic("pass --riscv32-cc=<path to riscv32 gcc> (or set RISCV32_CC), e.g. the Bootlin toolchain")
    }
    require_cross_cc(t.cc, t.cc_option, format("gui ", t.target))
}

/// raylib for one target. Its Makefile builds .o files in its own source
/// directory, so the sources are staged under tmp/ first and every
/// target's objects stay apart.
build_gui_raylib := proc(mut b: Build, target: Str) {
    t := gui_target(b, target)
    is_host := target == b.host.target_name()
    if t.web {
        build_raylib_web(b)
        return
    }
    if t.mac_arch.is_empty().not().and(is_host.not()) {
        build_mac_raylib(b, t.mac_arch)
        return
    }
    if b.begin(format("raylib-", target)).not() { return }
    output := raylib_lib(target)
    if needs_rebuild(output, no_inputs()).not() { return }
    if is_host.not() { require_gui_cc(t) }

    stage := format("tmp/raylib-", target)
    File.remove_tree(stage)
    mkdir_p(stage)
    if copy_tree("vendor/raylib/src", stage) != 0 {
        panic("could not stage raylib sources in ", stage)
    }
    run("make", "-C", stage, "clean")

    mut argv := Vec(Str).new()
    argv.push(own "make")
    argv.push(own "-C")
    argv.push(own stage.clone())
    argv.push(own "PLATFORM=PLATFORM_DESKTOP")
    if t.platform_os.is_empty().not() {
        argv.push(own format("PLATFORM_OS=", t.platform_os))
    }
    if is_host.not() {
        argv.push(own format("CC=", t.cc))
        argv.push(own format("AR=", t.ar))
    }
    if t.raylib_cflags.is_empty().not() {
        argv.push(own format("CUSTOM_CFLAGS=", t.raylib_cflags))
    }
    argv.push(own "RAYLIB_RELEASE_PATH=.")
    run_argv(argv)

    mkdir_p(format(RAYLIB_DIR, "/build-", target))
    copy(format(stage, "/libraylib.a"), output)
}

/// tinyfiledialogs for one target: one .c file that only needs libc, so
/// every toolchain builds it the same way. The host's is -fPIC, because
/// build_ffi_twins relinks it into the interpreter's shared twin; this
/// file is an input, so an archive built before a flag change is rebuilt.
build_gui_tinyfd := proc(mut b: Build, target: Str) {
    t := gui_target(b, target)
    is_host := target == b.host.target_name()
    if t.web { panic("tinyfd has no wasm32 build: a browser page gets no native file dialogs") }
    if t.mac_arch.is_empty().not().and(is_host.not()) {
        build_mac_tinyfd(b, t.mac_arch)
        return
    }
    if b.begin(format("tinyfd-", target)).not() { return }
    output := tinyfd_lib(target)
    mut inputs := Vec(Str).new()
    inputs.push(own TINYFD_SRC.clone())
    inputs.push(own SELF_SRC.clone())
    if needs_rebuild(output, inputs).not() { return }
    if is_host.not() { require_gui_cc(t) }
    mkdir_p("tmp")
    obj := format("tmp/tinyfiledialogs-", target, ".o")

    mut cc := "cc"
    mut ar := "ar"
    if is_host.not() {
        cc = t.cc.clone()
        ar = t.ar.clone()
    }
    mut argv := Vec(Str).new()
    argv.push(own cc)
    if is_host {
        argv.push(own "-Wall")
        argv.push(own "-Wextra")
        argv.push(own "-fPIC")
    }
    if t.tinyfd_cflags.is_empty().not() { argv.push(own t.tinyfd_cflags.clone()) }
    argv.push(own "-c")
    argv.push(own "-o")
    argv.push(own obj.clone())
    argv.push(own TINYFD_SRC.clone())
    run_argv(argv)
    mkdir_p(format(TINYFD_DIR, "/build-", target))
    File.remove(output)
    run(ar, "rcs", output, obj)
}

/// Both of one target's gui archives.
build_gui_pair := proc(mut b: Build, target: Str) {
    build_gui_raylib(b, target)
    build_gui_tinyfd(b, target)
}

// --- Windows cross ---

/// libffi for every target but the host (issues #420, #422), for runtime
/// ext_func dispatch in programs built for them -- til itself among
/// them, so the interpreter works on those hosts (til.exe on windows).
/// Each configures OUT of tree into vendor/libffi/build-<target>, the
/// directory the Makefile uses for the host's own, so the archive path
/// is fixed whatever triple config.sub makes of --host and is the one
/// src/self/interpreter.til's link() line names.
LibffiCross := struct {
    // The --target name, and the build directory's suffix: build-<name>.
    name := ""
    // configure's --host. With CC given, it only selects libffi's
    // backend and the prefixed binutils.
    host := ""
    // Empty only for riscv32 before --riscv32-cc is given.
    cc := ""
    // The bin/make option that picks cc, for the missing-compiler report.
    cc_option := ""
    // For riscv32, the Bootlin binutils, which are not on PATH under
    // --host's prefix; for a mac archive from a non-mac host, llvm's
    // (GNU ar cannot index Mach-O objects).
    ar := ""
    ranlib := ""
    // Mac archives from a non-mac host: configure links its probe
    // programs, which takes lld and the vendored libSystem.tbd, as for
    // til's own mac cross links (targets.til's target_link_extra_args).
    ldflags := ""
    sdkless_mac := false

namespace:
    dir := func(self: LibffiCross) returns Str {
        return format(LIBFFI_DIR, "/build-", self.name)
    }

    lib := func(self: LibffiCross) returns Str {
        return format(self.dir(), "/.libs/libffi.a")
    }
}

/// Every libffi target, as data; src/self/interpreter.til links the same
/// ones (the host's entry is the Makefile's to build).
libffi_cross_targets := proc(b: Build) returns Vec(LibffiCross) {
    mut out := Vec(LibffiCross).new()
    out.push(own LibffiCross(name = "linux-x64", host = "x86_64-linux-gnu", cc = b.linux_x64_cc.clone(),
        cc_option = "--linux-x64-cc=<path> (or LINUX_X64_CC)"))
    out.push(own LibffiCross(name = "linux-arm64", host = "aarch64-linux-gnu", cc = "aarch64-linux-gnu-gcc"))
    out.push(own LibffiCross(name = "linux-riscv64", host = "riscv64-linux-gnu", cc = "riscv64-linux-gnu-gcc"))
    // The host gcc in 32-bit mode, like every linux-x86 build here.
    // libffi's closures.c reaches asm/types.h, which only gcc-multilib's
    // /usr/include/asm link supplies; the directory it points to goes
    // LAST (-idirafter, as in targets.til's target_prefix_args) so a
    // system x86_64 ffi.h there cannot shadow libffi's own.
    out.push(own LibffiCross(name = "linux-x86", host = "i686-linux-gnu",
        cc = "gcc -m32 -idirafter /usr/include/x86_64-linux-gnu"))
    out.push(own LibffiCross(name = "linux-arm32", host = "arm-linux-gnueabihf", cc = "arm-linux-gnueabihf-gcc"))
    // No distro ships a riscv32 gcc: --riscv32-cc / RISCV32_CC, as for
    // the riscv32 gui and libsecp256k1 archives.
    mut riscv32_ranlib := ""
    if b.riscv32_cc.ends_with("-gcc") {
        riscv32_ranlib = format(b.riscv32_cc.strip_suffix("-gcc"), "-ranlib")
    }
    out.push(own LibffiCross(name = "linux-riscv32", host = "riscv32-linux-gnu", cc = b.riscv32_cc.clone(),
        cc_option = "--riscv32-cc=<path> (or RISCV32_CC)",
        ar = cross_ar(b.riscv32_cc), ranlib = riscv32_ranlib))
    // mingw: windows AS A HOST (til.exe links libffi for its ext_func
    // dispatch) and any windows program that calls ext_func at run time.
    out.push(own LibffiCross(name = "windows-x64", host = "x86_64-w64-mingw32", cc = "x86_64-w64-mingw32-gcc"))
    out.push(own LibffiCross(name = "windows-x86", host = "i686-w64-mingw32", cc = "i686-w64-mingw32-gcc"))
    for arch : Str in MAC_ARCHES.split(" ") {
        // The deployment targets til links mac programs for (targets.til's
        // target_prefix_args), as for the mac libsecp256k1 archives.
        mut t := LibffiCross(name = format("macos-", arch), host = "x86_64-apple-darwin",
            cc = "clang -target x86_64-apple-macos10.12")
        if arch == "arm64" {
            t.host = "aarch64-apple-darwin"
            t.cc = "clang -target arm64-apple-macos11"
        }
        // On a mac the real SDK serves the other arch too; elsewhere the
        // vendored SDK-less headers and libSystem.tbd, like the mac gui
        // archives.
        if b.host.is_mac().not() {
            t.cc = format(t.cc, " -nostdlibinc -isystem ", get_cwd_str(), "/vendor/macos/include")
            t.ldflags = format("-fuse-ld=lld -L", get_cwd_str(), "/vendor/macos")
            t.ar = "llvm-ar"
            t.ranlib = "llvm-ranlib"
            t.sdkless_mac = true
        }
        out.push(own t)
    }
    return out
}

build_libffi_out_of_tree := proc(mut b: Build, name: Str) {
    if b.begin(format("libffi-", name)).not() { return }
    mut found := false
    mut t := LibffiCross()
    for c : LibffiCross in libffi_cross_targets(b) {
        if c.name == name {
            t = c.clone()
            found = true
        }
    }
    if found.not() { panic("no libffi build for --target=", name) }
    // The host's own is the Makefile's (the bootstrap links it).
    if name == b.host.target_name() {
        require_libffi(b)
        return
    }
    if t.cc.is_empty() {
        panic("pass --riscv32-cc=<path to riscv32 gcc> (or set RISCV32_CC), e.g. the Bootlin toolchain")
    }
    if t.sdkless_mac { check_mac_cross_tools(b) }
    if needs_rebuild(t.lib(), no_inputs()).not() { return }
    require_cross_cc(t.cc, t.cc_option, t.dir())
    if mkdir_p(t.dir()) != 0 { panic("could not create ", t.dir()) }
    // --disable-multi-os-directory: the archive is linked from the build
    // directory, never installed, and the install-dir probe is a gcc
    // option clang rejects with an error line per configure.
    configure := Cmd.new("../configure", format("--host=", t.host), format("CC=", t.cc),
        "--disable-shared", "--enable-static", "--disable-docs", "--disable-multi-os-directory", "--quiet")
    if t.ar.is_empty().not() { configure.arg(format("AR=", t.ar)) }
    if t.ranlib.is_empty().not() { configure.arg(format("RANLIB=", t.ranlib)) }
    if t.ldflags.is_empty().not() { configure.arg(format("LDFLAGS=", t.ldflags)) }
    configure.cwd(t.dir())
    configure.run_checked()
    run("make", "-C", t.dir())
}

/// nng, one archive per --target (issue #422): vendor/nng/build-<target>/
/// libnng.a, the path the server modes' link() lines name for that target
/// (examples/lib/custom_modes/nng_base.til; src/til.til links the same).
/// Built from the vendored source via cmake, static only, no
/// tests/tools/TLS. POSITION_INDEPENDENT_CODE because the host's archive
/// is relinked into the interpreter's shared twin (build_ffi_twins);
/// without it posix_debug.c.o's relocation against stdout fails that
/// link ("recompile with -fPIC").
NngTarget := struct {
    target := ""
    // CMAKE_SYSTEM_NAME and CMAKE_SYSTEM_PROCESSOR for a cross build.
    system := ""
    processor := ""
    // Empty only for riscv32 before --riscv32-cc is given.
    cc := ""
    // The bin/make option that picks cc, for the missing-compiler report.
    cc_option := ""
    cflags := ""
    // CMAKE_C_COMPILER_TARGET: clang's triple for the mac archives.
    clang_target := ""
    // Mac archives from a non-mac host: the vendored SDK-less headers,
    // lld and libSystem.tbd for cmake's probe links, llvm's binutils.
    sdkless_mac := false
    // mingw: nng's cmake rejects "legacy mingw" unless three C11 symbols
    // probe true, and mingw only exposes timespec_get under the UCRT. We
    // do NOT build against the UCRT: a UCRT nng imports ucrtbase.dll, and
    // since mingw's startup is msvcrt the program ends up importing both,
    // which real Windows refuses to load (wine tolerated it, which hid the
    // bug). So the three probes are forced true, TIME_UTC is defined so
    // nng compiles, and the one genuinely missing function is supplied by
    // ext.c's msvcrt shim.
    mingw := false

namespace:
    lib := func(self: NngTarget) returns Str {
        return nng_lib(self.target)
    }
}

nng_lib := func(target: Str) returns Str {
    return format(NNG_DIR, "/build-", target, "/libnng.a")
}

/// Every nng target, as data. The server modes list the same targets
/// (examples/custom_modes.til); wasm32 has no sockets, so it is not one.
nng_targets := proc(b: Build) returns Vec(NngTarget) {
    mut out := Vec(NngTarget).new()
    out.push(own NngTarget(target = "linux-x64", system = "Linux", processor = "x86_64",
        cc = b.linux_x64_cc.clone(), cc_option = "--linux-x64-cc=<path> (or LINUX_X64_CC)"))
    out.push(own NngTarget(target = "linux-arm64", system = "Linux", processor = "aarch64", cc = "aarch64-linux-gnu-gcc"))
    out.push(own NngTarget(target = "linux-riscv64", system = "Linux", processor = "riscv64", cc = "riscv64-linux-gnu-gcc"))
    // The host gcc in 32-bit mode, like every linux-x86 build here.
    out.push(own NngTarget(target = "linux-x86", system = "Linux", processor = "i686", cc = "gcc", cflags = "-m32"))
    out.push(own NngTarget(target = "linux-arm32", system = "Linux", processor = "arm", cc = "arm-linux-gnueabihf-gcc"))
    out.push(own NngTarget(target = "linux-riscv32", system = "Linux", processor = "riscv32",
        cc = b.riscv32_cc.clone(), cc_option = "--riscv32-cc=<path> (or RISCV32_CC)"))
    out.push(own NngTarget(target = "windows-x64", system = "Windows", processor = "x86_64",
        cc = "x86_64-w64-mingw32-gcc", mingw = true))
    out.push(own NngTarget(target = "windows-x86", system = "Windows", processor = "i686",
        cc = "i686-w64-mingw32-gcc", mingw = true))
    for arch : Str in MAC_ARCHES.split(" ") {
        // til's mac deployment targets (targets.til's target_prefix_args).
        mut t := NngTarget(target = format("macos-", arch), system = "Darwin", processor = "x86_64",
            cc = "clang", clang_target = "x86_64-apple-macos10.12")
        if arch == "arm64" {
            t.processor = "arm64"
            t.clang_target = "arm64-apple-macos11"
        }
        if b.host.is_mac().not() {
            t.cflags = format("-nostdlibinc -isystem ", get_cwd_str(), "/vendor/macos/include")
            t.sdkless_mac = true
        }
        out.push(own t)
    }
    return out
}

build_nng_target := proc(mut b: Build, target: Str) {
    if b.begin(format("nng-", target)).not() { return }
    mut found := false
    mut t := NngTarget()
    for c : NngTarget in nng_targets(b) {
        if c.target == target {
            t = c.clone()
            found = true
        }
    }
    if found.not() { panic("no nng build for --target=", target) }
    // The host's own archive is a plain native build; any other target
    // is a cross build with its compiler.
    is_host := target == b.host.target_name()
    if is_host.not() {
        if t.cc.is_empty() {
            panic("pass --riscv32-cc=<path to riscv32 gcc> (or set RISCV32_CC), e.g. the Bootlin toolchain")
        }
        if t.sdkless_mac { check_mac_cross_tools(b) }
    }
    dir := format(NNG_DIR, "/build-", target)
    mut inputs := Vec(Str).new()
    inputs.push(own SELF_SRC.clone())
    if needs_rebuild(t.lib(), inputs).not() { return }
    if is_host.not() { require_cross_cc(t.cc, t.cc_option, dir) }
    mut argv := Vec(Str).new()
    argv.push(own "cmake")
    argv.push(own "-S")
    argv.push(own NNG_DIR.clone())
    argv.push(own "-B")
    argv.push(own dir.clone())
    argv.push(own "-DCMAKE_BUILD_TYPE=Release")
    argv.push(own "-DBUILD_SHARED_LIBS=OFF")
    argv.push(own "-DNNG_TESTS=OFF")
    argv.push(own "-DNNG_ENABLE_NNGCAT=OFF")
    argv.push(own "-DNNG_ENABLE_TLS=OFF")
    argv.push(own "-DCMAKE_POSITION_INDEPENDENT_CODE=ON")
    mut cflags := t.cflags.clone()
    if is_host.not() {
        argv.push(own format("-DCMAKE_SYSTEM_NAME=", t.system))
        argv.push(own format("-DCMAKE_SYSTEM_PROCESSOR=", t.processor))
        argv.push(own format("-DCMAKE_C_COMPILER=", t.cc))
        if t.clang_target.is_empty().not() {
            argv.push(own format("-DCMAKE_C_COMPILER_TARGET=", t.clang_target))
        }
        if t.mingw {
            prefix := t.cc.strip_suffix("-gcc")
            argv.push(own format("-DCMAKE_CXX_COMPILER=", prefix, "-g++"))
            argv.push(own format("-DCMAKE_RC_COMPILER=", prefix, "-windres"))
        }
        if t.sdkless_mac {
            argv.push(own format("-DCMAKE_EXE_LINKER_FLAGS=-fuse-ld=lld -L", get_cwd_str(), "/vendor/macos"))
            // :STRING keeps the bare names for PATH lookup at build time; as
            // the default FILEPATH cmake resolves them against the cwd.
            argv.push(own "-DCMAKE_AR:STRING=llvm-ar")
            argv.push(own "-DCMAKE_RANLIB:STRING=llvm-ranlib")
        }
    }
    if t.mingw {
        if cflags.is_empty() { cflags = "-DTIME_UTC=1" }
        else { cflags = format(cflags, " -DTIME_UTC=1") }
        argv.push(own "-DNNG_HAVE_TIMESPEC_GET=1")
        argv.push(own "-DNNG_HAVE_CONDVAR=1")
        argv.push(own "-DNNG_HAVE_SNPRINTF=1")
    }
    if cflags.is_empty().not() { argv.push(own format("-DCMAKE_C_FLAGS=", cflags)) }
    run_argv(argv)
    run("cmake", "--build", dir, "--parallel")
}

/// One libsecp256k1 archive per --target (issues #235, #422):
/// vendor/secp256k1/build-<target>/lib/libsecp256k1.a, the path
/// std/crypto's link() names for that target. The library is plain C99
/// with no system dependencies, so the compiler is the whole toolchain
/// change; static, so upstream's header selects plain `extern` for every
/// API symbol (til emits its own prototypes anyway, never the header's
/// dllimport form). Each archive builds in its own directory.
SecpTarget := struct {
    target := ""
    // CMAKE_SYSTEM_NAME and CMAKE_SYSTEM_PROCESSOR for a cross build.
    system := ""
    processor := ""
    // Empty only for riscv32 before --riscv32-cc is given.
    cc := ""
    // The bin/make option that picks cc, for the missing-compiler report.
    cc_option := ""
    // CMAKE_C_FLAGS: -m32 for linux-x86, the SDK-less header path for a
    // mac cross build.
    cflags := ""
    // CMAKE_C_COMPILER_TARGET: clang's triple for the mac archives.
    clang_target := ""
    // Mac archives from a non-mac host: Mach-O objects need llvm-ar, and
    // cmake's compiler probe must not try to link (there is no SDK).
    sdkless_mac := false
    // wasm32 (issue #420): configured through emscripten's own cmake
    // toolchain file from the vendored emsdk, which supplies emcc, emar
    // and the platform settings, instead of system/processor/cc.
    emscripten := false

namespace:
    dir := func(self: SecpTarget) returns Str {
        return format(SECP256K1_DIR, "/build-", self.target)
    }

    lib := func(self: SecpTarget) returns Str {
        return secp256k1_lib(self.target)
    }
}

secp256k1_lib := func(target: Str) returns Str {
    return format(SECP256K1_DIR, "/build-", target, "/lib/libsecp256k1.a")
}

/// Every libsecp256k1 target, as data; std/crypto lists the same ones.
secp256k1_targets := proc(b: Build) returns Vec(SecpTarget) {
    mut out := Vec(SecpTarget).new()
    out.push(own SecpTarget(target = "linux-x64",
        system = "Linux", processor = "x86_64", cc = b.linux_x64_cc.clone(),
        cc_option = "--linux-x64-cc=<path> (or LINUX_X64_CC)"))
    out.push(own SecpTarget(target = "windows-x64",
        system = "Windows", processor = "x86_64", cc = "x86_64-w64-mingw32-gcc"))
    out.push(own SecpTarget(target = "windows-x86",
        system = "Windows", processor = "i686", cc = "i686-w64-mingw32-gcc"))
    out.push(own SecpTarget(target = "linux-arm64",
        system = "Linux", processor = "aarch64", cc = "aarch64-linux-gnu-gcc"))
    out.push(own SecpTarget(target = "linux-riscv64",
        system = "Linux", processor = "riscv64", cc = "riscv64-linux-gnu-gcc"))
    // The host gcc in 32-bit mode, like every linux-x86 build here: only
    // gcc-multilib is needed.
    out.push(own SecpTarget(target = "linux-x86",
        system = "Linux", processor = "i686", cc = "gcc", cflags = "-m32"))
    out.push(own SecpTarget(target = "linux-arm32",
        system = "Linux", processor = "arm", cc = "arm-linux-gnueabihf-gcc"))
    // No distro ships a riscv32 gcc: --riscv32-cc / RISCV32_CC, as for
    // the riscv32 gui archives.
    out.push(own SecpTarget(target = "linux-riscv32",
        system = "Linux", processor = "riscv32", cc = b.riscv32_cc.clone(),
        cc_option = "--riscv32-cc=<path> (or RISCV32_CC)"))
    // emcc, with emscripten's libc: the same toolchain every wasm32
    // program links with.
    out.push(own SecpTarget(target = "wasm32", emscripten = true))
    for arch : Str in MAC_ARCHES.split(" ") {
        // The deployment targets til links mac programs for
        // (targets.til's target_prefix_args), not mac_triple's macos11:
        // an x64 archive built for 11 makes ld64.lld warn on every link
        // of a program targeting 10.12.
        mut t := SecpTarget(target = format("macos-", arch),
            system = "Darwin", cc = "clang",
            processor = "x86_64", clang_target = "x86_64-apple-macos10.12")
        if arch == "arm64" {
            t.processor = "arm64"
            t.clang_target = "arm64-apple-macos11"
        }
        // On a mac the real SDK serves the other arch too; elsewhere the
        // vendored SDK-less headers, like the mac gui archives.
        if b.host.is_mac().not() {
            t.cflags = format("-nostdlibinc -isystem ", get_cwd_str(), "/vendor/macos/include")
            t.sdkless_mac = true
        }
        out.push(own t)
    }
    return out
}

/// One target's archive. The host's own is a plain native build, with
/// POSITION_INDEPENDENT_CODE because build_ffi_twins relinks it into the
/// interpreter's shared twin (this file is an input, so an archive built
/// before a flag change is rebuilt); any other target is a cross build
/// with its compiler.
build_secp256k1_target := proc(mut b: Build, target: Str) {
    if b.begin(format("secp256k1-", target)).not() { return }
    mut found := false
    mut t := SecpTarget()
    for c : SecpTarget in secp256k1_targets(b) {
        if c.target == target {
            t = c.clone()
            found = true
        }
    }
    if found.not() { panic("no libsecp256k1 build for --target=", target) }
    is_host := target == b.host.target_name()
    if t.emscripten { build_emsdk(b) }
    else if is_host.not().and(t.cc.is_empty()) {
        panic("pass --riscv32-cc=<path to riscv32 gcc> (or set RISCV32_CC), e.g. the Bootlin toolchain")
    }
    if is_host.not().and(t.sdkless_mac) { check_mac_cross_tools(b) }
    mut inputs := Vec(Str).new()
    inputs.push(own SELF_SRC.clone())
    if needs_rebuild(t.lib(), inputs).not() { return }
    if is_host.not().and(t.emscripten.not()) { require_cross_cc(t.cc, t.cc_option, t.dir()) }
    mut argv := secp256k1_cmake_configure(t.dir())
    if is_host {
        argv.push(own "-DCMAKE_POSITION_INDEPENDENT_CODE=ON")
    } else if t.emscripten {
        if b.emcc.ends_with("/emcc").not() {
            panic("cannot find emscripten's cmake toolchain next to EMCC=", b.emcc)
        }
        argv.push(own format("-DCMAKE_TOOLCHAIN_FILE=", b.emcc.strip_suffix("/emcc"),
            "/cmake/Modules/Platform/Emscripten.cmake"))
    } else {
        argv.push(own format("-DCMAKE_SYSTEM_NAME=", t.system))
        argv.push(own format("-DCMAKE_SYSTEM_PROCESSOR=", t.processor))
        argv.push(own format("-DCMAKE_C_COMPILER=", t.cc))
        if t.cflags.is_empty().not() { argv.push(own format("-DCMAKE_C_FLAGS=", t.cflags)) }
        if t.clang_target.is_empty().not() {
            argv.push(own format("-DCMAKE_C_COMPILER_TARGET=", t.clang_target))
        }
        if t.sdkless_mac {
            argv.push(own "-DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY")
            argv.push(own "-DCMAKE_AR=llvm-ar")
            argv.push(own "-DCMAKE_RANLIB=llvm-ranlib")
        }
    }
    run_argv(argv)
    run("cmake", "--build", t.dir(), "--parallel")
}

/// The windows-HOST twin of the windows-x64 archive: what til.exe's
/// interpreter loads for a program importing std/crypto, the way bin/til
/// loads libsecp256k1.so (see build_ffi_twins and ffi_load_archive_twin).
/// The archive force-linked into a DLL; the library carries no dllexport
/// annotations in a static build, so every symbol is exported -- spelled
/// out with --export-all-symbols rather than left to ld's default. Beside
/// the archive, because the interpreter derives the twin from the link()
/// path it resolved: on a windows host, std/crypto's windows-x64 one.
build_secp256k1_win_twin := proc(mut b: Build) {
    if b.begin("secp256k1_win_twin").not() { return }
    build_secp256k1_target(b, "windows-x64")
    build_win_twin(secp256k1_lib("windows-x64"), SECP256K1_WIN64_DLL, "")
}

SECP256K1_WIN64_DLL := "vendor/secp256k1/build-windows-x64/lib/libsecp256k1.dll"

/// The windows-host twins of the mode gui archives (issue #420): what
/// til.exe's interpreter loads for a mode gui program, beside the
/// windows-x64 archives src/modes/gui.til links for the host target
/// there (issue #422). A DLL must resolve everything at link time, so
/// each one names the windows system libraries its archive calls into --
/// among those gui.til links a windows gui program against.
build_gui_win_twins := proc(mut b: Build) {
    if b.begin("gui_win_twins").not() { return }
    build_gui_pair(b, "windows-x64")
    build_win_twin(raylib_lib("windows-x64"), RAYLIB_WIN64_DLL, "-lgdi32 -lopengl32 -lwinmm")
    build_win_twin(tinyfd_lib("windows-x64"), TINYFD_WIN64_DLL, "-lole32 -lcomdlg32 -luuid")
}

/// Force-link a win64 archive into a DLL with every symbol exported, plus
/// the system libraries it needs (space-separated -l flags). The static
/// archives carry no dllexport annotations, so --export-all-symbols is
/// what exports them; spelled out rather than left to ld's default.
build_win_twin := proc(archive: Str, dll: Str, sys_libs: Str) {
    mut inputs := Vec(Str).new()
    inputs.push(own archive.clone())
    if needs_rebuild(dll, inputs).not() { return }
    mut argv := Vec(Str).new()
    argv.push(own "x86_64-w64-mingw32-gcc")
    argv.push(own "-shared")
    argv.push(own "-o")
    argv.push(own dll.clone())
    argv.push(own "-Wl,--export-all-symbols")
    argv.push(own "-Wl,--whole-archive")
    argv.push(own archive.clone())
    argv.push(own "-Wl,--no-whole-archive")
    for lib : Str in sys_libs.split(" ") {
        if lib.is_empty().not() { argv.push(own lib.clone()) }
    }
    run_argv(argv)
}

/// The nng custom-mode examples, consumed via --extra-modes and
/// linking libnng. Shared by the windows and macOS server sweeps.
server_examples := func() returns Vec(Str) {
    mut out := Vec(Str).new()
    out.push(own "examples/sender.til")
    out.push(own "examples/receiver.til")
    out.push(own "examples/publisher.til")
    out.push(own "examples/subscriber.til")
    return out
}

contains_name := func(names: Vec(Str), name: Str) returns Bool {
    for n : Str in names {
        if n == name { return true }
    }
    return false
}

/// The ~mode~ an example declares, "" when it declares none.
example_mode := proc(path: Str) returns Str {
    for line : Str in File.readfile(path).split("\n") {
        if line.starts_with("mode ") {
            return line.strip_prefix("mode ").trim().clone()
        }
    }
    return ""
}

/// The windows example sweep. Excluded: raylib.til is a direct-FFI
/// demo with hardcoded Linux link() paths (not mode gui);
/// custom_modes.til is a mode-DEFINITIONS file consumed via
/// --extra-modes, not a standalone program; bench_hashmap.til has a
/// stale parse error on every platform. The server examples need
/// --extra-modes plus the win64 nng, so they build through win_server.
windows_examples := proc() returns Vec(Str) {
    mut excluded := server_examples()
    excluded.push(own "examples/raylib.til")
    excluded.push(own "examples/custom_modes.til")
    excluded.push(own "examples/bench_hashmap.til")
    mut all := Vec(Str).new()
    add_matching(all, "examples", ".til")
    mut out := Vec(Str).new()
    for path : Str in all {
        if contains_name(excluded, path) { continue }
        out.push(own path.clone())
    }
    return out
}

/// The macOS example sweep: the modes that link nothing a mac-only SDK
/// would have to provide. mode gui is included -- raylib's RGFW
/// backend cross-builds for mac from linux against the SDK-less
/// framework shims. raylib.til (direct-FFI demo, linux link() paths)
/// and bench_hashmap.til (does not parse anywhere) stay out;
/// custom_modes.til is ~mode mode~ and never matches.
mac_examples := proc() returns Vec(Str) {
    mut all := Vec(Str).new()
    add_matching(all, "examples", ".til")
    mut out := Vec(Str).new()
    for path : Str in all {
        switch path {
        case "examples/raylib.til", "examples/bench_hashmap.til": continue
        case:
        }
        mode := example_mode(path)
        switch mode {
        case "cli", "script", "pure", "lib", "gui":
            out.push(own path.clone())
        case:
        }
    }
    return out
}

/// examples/foo.til -> foo.
example_name := func(path: Str) returns Str {
    mut base := path.clone()
    if base.starts_with("examples/") { base = base.strip_prefix("examples/").clone() }
    if base.ends_with(".til") { base = base.strip_suffix(".til").clone() }
    return base
}

/// The windows-x64 example sweep: every portable and GUI example as an
/// .exe beside the linux binaries.
build_win := proc(mut b: Build) {
    if b.begin("build_win").not() { return }
    build_til(b)
    build_gui_pair(b, "windows-x64")
    for path : Str in windows_examples() {
        output := format("bin/", example_name(path), ".exe")
        mut inputs := Vec(Str).new()
        inputs.push(own path.clone())
        inputs.push(own TIL.clone())
        inputs.push(own raylib_lib("windows-x64"))
        inputs.push(own tinyfd_lib("windows-x64"))
        if needs_rebuild(output, inputs) {
            run(TIL, "build", "--target=windows-x64", path)
        }
    }
    build_win_server(b)
}

/// The windows-x86 sweep. Same examples through the i686 toolchain,
/// with a -x86 suffix so the outputs sit beside the win64 ones. The
/// nng server examples stay win64-only: there is no win32 nng build.
build_win32 := proc(mut b: Build) {
    if b.begin("build_win32").not() { return }
    build_til(b)
    build_gui_pair(b, "windows-x86")
    for path : Str in windows_examples() {
        output := format("bin/", example_name(path), "-x86.exe")
        mut inputs := Vec(Str).new()
        inputs.push(own path.clone())
        inputs.push(own TIL.clone())
        inputs.push(own raylib_lib("windows-x86"))
        inputs.push(own tinyfd_lib("windows-x86"))
        if needs_rebuild(output, inputs) {
            run(TIL, "build", "--target=windows-x86", "-o", output, path)
        }
    }
}

build_win_server := proc(mut b: Build) {
    if b.begin("win_server").not() { return }
    build_til(b)
    build_nng_target(b, "windows-x64")
    for path : Str in server_examples() {
        run(TIL, "build", "--target=windows-x64",
            "--extra-modes=examples/custom_modes.til",
            "-o", format("bin/", example_name(path), ".exe"), path)
    }
}

/// til.exe: the compiler itself cross-built for a windows HOST. Like
/// the native compiler it links the win64 libffi AND libnng so the
/// interpreter's ext_func dispatch works when til runs ON windows.
build_win_host := proc(mut b: Build) {
    if b.begin("build_win_host").not() { return }
    build_til(b)
    build_libffi_out_of_tree(b, "windows-x64")
    build_nng_target(b, "windows-x64")
    // Not linked into til.exe: the interpreter loads these at run time.
    build_secp256k1_win_twin(b)
    build_gui_win_twins(b)
    mut inputs := compiler_sources()
    inputs.push(own TIL.clone())
    inputs.push(own libffi_lib("windows-x64"))
    inputs.push(own nng_lib("windows-x64"))
    if needs_rebuild("bin/til.exe", inputs).not() { return }
    run(TIL, "build", "--target=windows-x64", "--usize=32", "-o", "bin/til.exe", "src/til.til")
}

// --- macOS cross ---

/// Preflight for every SDK-less mac artifact. Checked where the build
/// starts rather than left to surface as a bare "llvm-ar: not found"
/// halfway through: clang emits the Mach-O objects, ld.lld links them,
/// llvm-ar indexes the archives (GNU ar cannot read Mach-O members),
/// and llvm-nm feeds the stub generator.
check_mac_cross_tools := proc(mut b: Build) {
    if b.begin("check_mac_cross_tools").not() { return }
    require_mac_tool("clang", "clang -- install the toolchain with: apt-get install clang lld llvm")
    require_mac_tool("ld.lld", "the lld linker (the mac cross-link runs clang -fuse-ld=lld) -- install the toolchain with: apt-get install clang lld llvm")
    require_mac_tool("llvm-ar", "llvm-ar (GNU ar cannot archive Mach-O objects) -- install the toolchain with: apt-get install clang lld llvm")
    require_mac_tool("llvm-nm", "llvm-nm (the framework stub generator reads symbols with it) -- install the toolchain with: apt-get install clang lld llvm")
}

require_mac_tool := proc(tool: Str, explanation: Str) {
    if have_tool(tool).not() {
        panic("the macOS cross-build needs ", explanation)
    }
}

MAC_ARCHES := "arm64 x64"

/// clang's target triple for one of our mac arch names.
mac_triple := func(arch: Str) returns Str {
    if arch == "arm64" { return "arm64-apple-macos11" }
    return "x86_64-apple-macos11"
}

/// tinyfd for macOS, cross-built anywhere: one .c file that only needs
/// libc (it shells out to osascript), so the SDK-less vendored headers
/// are enough.
build_mac_tinyfd := proc(mut b: Build, arch: Str) {
    if b.begin(format("tinyfd-macos-", arch)).not() { return }
    check_mac_cross_tools(b)
    output := tinyfd_lib(format("macos-", arch))
    if needs_rebuild(output, no_inputs()).not() { return }
    mkdir_p("tmp")
    mkdir_p(format(TINYFD_DIR, "/build-macos-", arch))
    obj := format("tmp/tinyfd-macos-", arch, ".o")
    run("clang", "-target", mac_triple(arch), "-nostdlibinc",
        "-isystem", "vendor/macos/include", "-c", TINYFD_SRC, "-o", obj)
    run("llvm-ar", "rcs", output, obj)
}

/// raylib cross-built for macOS FROM LINUX -- no mac, no Apple SDK.
///
/// Mac has no redistributable SDK like mingw, BUT raylib's RGFW desktop
/// backend drives Cocoa through the objc runtime and only needs
/// framework TYPE headers, vendored as SDK-less shims (Cocoa/OpenGL
/// bind at run time). miniaudio dlopens CoreAudio and glad runtime-links
/// OpenGL, so neither leaves link symbols; the rest resolve against the
/// generated .tbd stubs. rglfw.c is NOT built -- that is the GLFW
/// backend, which RGFW replaces.
build_mac_raylib := proc(mut b: Build, arch: Str) {
    if b.begin(format("raylib-macos-", arch)).not() { return }
    check_mac_cross_tools(b)
    output := raylib_lib(format("macos-", arch))
    if needs_rebuild(output, no_inputs()).not() { return }

    stage := format("tmp/raylib-macos-", arch)
    File.remove_tree(stage)
    mkdir_p(stage)
    mut objects := Vec(Str).new()
    for module : Str in mac_raylib_modules() {
        obj := format(stage, "/", module, ".o")
        run("clang", "-target", mac_triple(arch), "-c", "-O1",
            "-DPLATFORM_DESKTOP_RGFW", "-DGRAPHICS_API_OPENGL_33",
            "-isystem", "vendor/macos/include",
            "-Ivendor/macos/frameworks-shim", "-Ivendor/raylib/src",
            "-Wno-static-in-inline",
            format("vendor/raylib/src/", module, ".c"), "-o", obj)
        objects.push(own obj)
    }
    mkdir_p(format(RAYLIB_DIR, "/build-macos-", arch))
    mut argv := Vec(Str).new()
    argv.push(own "llvm-ar")
    argv.push(own "rcs")
    argv.push(own output.clone())
    argv.append(own objects)
    run_argv(argv)
}

mac_raylib_modules := func() returns Vec(Str) {
    mut out := Vec(Str).new()
    out.push(own "rcore")
    out.push(own "rshapes")
    out.push(own "rtextures")
    out.push(own "rtext")
    out.push(own "rmodels")
    out.push(own "raudio")
    return out
}

/// Framework .tbd link stubs, generated ON LINUX from the archives'
/// true external symbols: the generator maps each by symbol prefix to
/// its owning framework, so it needs neither ~nm -m~ (which only
/// annotates linked Mach-O on a mac) nor an SDK. The real
/// Cocoa/OpenGL dylibs live on every mac and bind at run time, exactly
/// like the vendored libSystem.tbd.
build_mac_framework_stubs := proc(mut b: Build) {
    if b.begin("mac_framework_stubs").not() { return }
    check_mac_cross_tools(b)
    build_til(b)
    build_mac_raylib(b, "arm64")
    build_mac_raylib(b, "x64")
    mut inputs := Vec(Str).new()
    inputs.push(own TIL.clone())
    inputs.push(own raylib_lib("macos-arm64"))
    inputs.push(own raylib_lib("macos-x64"))
    inputs.push(own "examples/gen_framework_stubs.til")
    if needs_rebuild(MAC_STUBS_STAMP, inputs).not() { return }
    File.remove_tree("vendor/macos/frameworks")
    mkdir_p("vendor/macos/frameworks")
    run(TIL, "run", "examples/gen_framework_stubs.til", "--linux-map",
        "vendor/macos/frameworks", raylib_lib("macos-arm64"), raylib_lib("macos-x64"))
    File.writefile(MAC_STUBS_STAMP, "")
}

/// build_mac mirrors build_win, and is host-split.
///
/// On a mac it sweeps every example natively (arch following the host)
/// plus the server examples against the host's nng. On any other host it
/// CROSS-compiles for BOTH mac arches with the vendored SDK-less
/// toolchain, server examples included: their nng cross-builds SDK-less
/// too (issue #422).
build_mac := proc(mut b: Build) {
    if b.begin("build_mac").not() { return }
    build_til(b)
    if b.host.is_mac() {
        build_vendor(b)
        target := format("--target=", b.host.mac_target())
        for path : Str in mac_examples() {
            run(TIL, "build", target, path)
        }
        for path : Str in server_examples() {
            run(TIL, "build", target, "--extra-modes=examples/custom_modes.til", path)
        }
        return
    }
    check_mac_cross_tools(b)
    build_mac_raylib(b, "arm64")
    build_mac_raylib(b, "x64")
    build_mac_tinyfd(b, "arm64")
    build_mac_tinyfd(b, "x64")
    build_mac_framework_stubs(b)
    for path : Str in mac_examples() {
        name := example_name(path)
        run(TIL, "build", "--target=macos-arm64", "-o",
            format("bin/", name, "-macos-arm64"), path)
        run(TIL, "build", "--target=macos-x64", "-o",
            format("bin/", name, "-macos-x64"), path)
    }
    build_nng_target(b, "macos-arm64")
    build_nng_target(b, "macos-x64")
    for path : Str in server_examples() {
        name := example_name(path)
        for arch : Str in MAC_ARCHES.split(" ") {
            run(TIL, "build", format("--target=macos-", arch), "--extra-modes=examples/custom_modes.til",
                "-o", format("bin/", name, "-macos-", arch), path)
        }
    }
}

// --- Browser WASM ---

/// Install the pinned Emscripten payload from the committed emsdk control
/// tree. node/, upstream/, .emscripten and this stamp are generated and
/// ignored; clean_vendor removes them without deleting the control tree.
build_emsdk := proc(mut b: Build) {
    if b.begin("emsdk").not() { return }
    if File.exists(EMSDK_STAMP).and(File.exists(b.emcc)) { return }
    run(format(EMSDK_DIR, "/emsdk"), "install", EMSDK_VERSION)
    run(format(EMSDK_DIR, "/emsdk"), "activate", EMSDK_VERSION)
    File.writefile(EMSDK_STAMP, "")
}

build_raylib_web := proc(mut b: Build) {
    if b.begin("raylib_web").not() { return }
    build_emsdk(b)
    output := raylib_lib("wasm32")
    if needs_rebuild(output, no_inputs()).not() { return }
    stage := "tmp/raylib-web"
    File.remove_tree(stage)
    mkdir_p(stage)
    if copy_tree("vendor/raylib/src", stage) != 0 {
        panic("could not stage raylib sources in ", stage)
    }
    run("make", "-C", stage, "clean")
    run("make", "-C", stage, "PLATFORM=PLATFORM_WEB", format("CC=", b.emcc),
        format("AR=", b.emar), format("RANLIB=", b.emranlib),
        "RAYLIB_LIB_NAME=raylib-web", "RAYLIB_RELEASE_PATH=.")
    mkdir_p(format(RAYLIB_DIR, "/build-wasm32"))
    copy(format(stage, "/libraylib-web.web.a"), output)
}

build_wasm := proc(mut b: Build) {
    if b.begin("build_wasm").not() { return }
    build_two_pass(b)
    build_raylib_web(b)
    source := "examples/shootil.til"
    output := "bin/shootil.html"
    mut inputs := Vec(Str).new()
    inputs.push(own source.clone())
    inputs.push(own TIL.clone())
    inputs.push(own raylib_lib("wasm32"))
    if needs_rebuild(output, inputs).not() { return }
    run(TIL, "build", "--target=wasm32", format("--cc=", b.emcc), "-o", output, source)
}

// --- Command registry ---
//
// One table. Dispatch reads it, help prints it, and an alias is the
// same handler under a second name rather than a copied recipe -- so
// the three views cannot drift apart the way a Makefile's recipes and
// its hand-written `help` echo lines do. Artifact paths are entries
// too: `bin/make vendor/raylib/build-linux-x86/libraylib.a` is the goal CI
// asks for, and it resolves here rather than through a pattern rule.

Handler := proc(mut Build)

Command := struct {
    name := ""
    about := ""
    // Non-empty when this name is an alias: it runs `alias_of`'s
    // handler and is listed as an alias rather than as a command.
    alias_of := ""
    // True for the artifact paths, listed apart from the verbs.
    is_path := false
    go : Handler
}

cmd_help := proc(mut b: Build) {
    if b.begin("help").not() { return }
    usage()
}

// Handlers for the goals whose step function takes an argument. A
// registry of first-class handlers wants one function per goal; these
// are the thin bindings that provide it.
gui_linux_x64 := proc(mut b: Build) { build_gui_pair(b, "linux-x64") }
gui_linux_arm64 := proc(mut b: Build) { build_gui_pair(b, "linux-arm64") }
gui_linux_riscv64 := proc(mut b: Build) { build_gui_pair(b, "linux-riscv64") }
gui_linux_x86 := proc(mut b: Build) { build_gui_pair(b, "linux-x86") }
gui_linux_arm32 := proc(mut b: Build) { build_gui_pair(b, "linux-arm32") }
gui_linux_riscv32 := proc(mut b: Build) { build_gui_pair(b, "linux-riscv32") }
gui_windows_x64 := proc(mut b: Build) { build_gui_pair(b, "windows-x64") }
gui_windows_x86 := proc(mut b: Build) { build_gui_pair(b, "windows-x86") }
gui_macos_arm64 := proc(mut b: Build) { build_gui_pair(b, "macos-arm64") }
gui_macos_x64 := proc(mut b: Build) { build_gui_pair(b, "macos-x64") }
libffi_linux_x64 := proc(mut b: Build) { build_libffi_out_of_tree(b, "linux-x64") }
libffi_windows_x64 := proc(mut b: Build) { build_libffi_out_of_tree(b, "windows-x64") }
libffi_windows_x86 := proc(mut b: Build) { build_libffi_out_of_tree(b, "windows-x86") }
libffi_linux_arm64 := proc(mut b: Build) { build_libffi_out_of_tree(b, "linux-arm64") }
libffi_linux_riscv64 := proc(mut b: Build) { build_libffi_out_of_tree(b, "linux-riscv64") }
libffi_linux_x86 := proc(mut b: Build) { build_libffi_out_of_tree(b, "linux-x86") }
libffi_linux_arm32 := proc(mut b: Build) { build_libffi_out_of_tree(b, "linux-arm32") }
libffi_linux_riscv32 := proc(mut b: Build) { build_libffi_out_of_tree(b, "linux-riscv32") }
libffi_macos_arm64 := proc(mut b: Build) { build_libffi_out_of_tree(b, "macos-arm64") }
libffi_macos_x64 := proc(mut b: Build) { build_libffi_out_of_tree(b, "macos-x64") }
nng_linux_x64 := proc(mut b: Build) { build_nng_target(b, "linux-x64") }
nng_linux_arm64 := proc(mut b: Build) { build_nng_target(b, "linux-arm64") }
nng_linux_riscv64 := proc(mut b: Build) { build_nng_target(b, "linux-riscv64") }
nng_linux_x86 := proc(mut b: Build) { build_nng_target(b, "linux-x86") }
nng_linux_arm32 := proc(mut b: Build) { build_nng_target(b, "linux-arm32") }
nng_linux_riscv32 := proc(mut b: Build) { build_nng_target(b, "linux-riscv32") }
nng_windows_x64 := proc(mut b: Build) { build_nng_target(b, "windows-x64") }
nng_windows_x86 := proc(mut b: Build) { build_nng_target(b, "windows-x86") }
nng_macos_arm64 := proc(mut b: Build) { build_nng_target(b, "macos-arm64") }
nng_macos_x64 := proc(mut b: Build) { build_nng_target(b, "macos-x64") }
secp256k1_linux_x64 := proc(mut b: Build) { build_secp256k1_target(b, "linux-x64") }
secp256k1_linux_arm64 := proc(mut b: Build) { build_secp256k1_target(b, "linux-arm64") }
secp256k1_linux_riscv64 := proc(mut b: Build) { build_secp256k1_target(b, "linux-riscv64") }
secp256k1_linux_x86 := proc(mut b: Build) { build_secp256k1_target(b, "linux-x86") }
secp256k1_linux_arm32 := proc(mut b: Build) { build_secp256k1_target(b, "linux-arm32") }
secp256k1_linux_riscv32 := proc(mut b: Build) { build_secp256k1_target(b, "linux-riscv32") }
secp256k1_windows_x64 := proc(mut b: Build) { build_secp256k1_target(b, "windows-x64") }
secp256k1_windows_x86 := proc(mut b: Build) { build_secp256k1_target(b, "windows-x86") }
secp256k1_macos_x64 := proc(mut b: Build) { build_secp256k1_target(b, "macos-x64") }
secp256k1_macos_arm64 := proc(mut b: Build) { build_secp256k1_target(b, "macos-arm64") }
secp256k1_wasm32 := proc(mut b: Build) { build_secp256k1_target(b, "wasm32") }

commands := func() returns Vec(Command) {
    mut out := Vec(Command).new()
    out.push(own Command(name = "til", go = build_til,
        about = "Build bin/til and regenerate boot/"))
    out.push(own Command(name = "all", alias_of = "til", go = build_til))
    out.push(own Command(name = "two_pass", go = build_two_pass,
        about = "Build, then rebuild with the fresh bin/til"))
    out.push(own Command(name = "asan", go = build_asan,
        about = "Build bin/til_asan"))
    out.push(own Command(name = "debug", go = build_debug,
        about = "Build bin/til_debug for gdb"))
    out.push(own Command(name = "vendor", go = build_vendor,
        about = "Build the vendored native libraries til links"))
    out.push(own Command(name = "test_runner", go = build_test_runner,
        about = "Build bin/test_runner"))
    out.push(own Command(name = "plot", go = build_plot,
        about = "Build bin/plot"))
    out.push(own Command(name = "tests", go = build_tests,
        about = "Build bin/tests"))
    out.push(own Command(name = "test", go = run_test,
        about = "Build + run the full ASAN suite"))
    out.push(own Command(name = "test_asan", alias_of = "test", go = run_test))
    out.push(own Command(name = "test_asan_full", alias_of = "test", go = run_test))
    out.push(own Command(name = "test_fast", go = run_test_fast,
