    out.push(own Command(name = "vendor/libffi/build-linux-arm32/.libs/libffi.a", is_path = true, go = libffi_linux_arm32,
        about = "linux-arm32 libffi, for runtime ext_func (til itself on that host)"))
    out.push(own Command(name = "vendor/libffi/build-linux-riscv32/.libs/libffi.a", is_path = true, go = libffi_linux_riscv32,
