        about = "linux-x86 libsecp256k1, for programs importing std/crypto"))
    out.push(own Command(name = secp256k1_lib("linux-arm32"), is_path = true, go = secp256k1_linux_arm32,
        about = "linux-arm32 libsecp256k1, for programs importing std/crypto"))
    out.push(own Command(name = secp256k1_lib("linux-riscv32"), is_path = true, go = secp256k1_linux_riscv32,
        about = "linux-riscv32 libsecp256k1 (needs --riscv32-cc=), for std/crypto"))
    out.push(own Command(name = secp256k1_lib("windows-x64"), is_path = true, go = secp256k1_windows_x64,
        about = "windows-x64 libsecp256k1, for programs importing std/crypto"))
    out.push(own Command(name = secp256k1_lib("windows-x86"), is_path = true, go = secp256k1_windows_x86,
        about = "windows-x86 libsecp256k1, for programs importing std/crypto"))
    out.push(own Command(name = secp256k1_lib("macos-x64"), is_path = true, go = secp256k1_macos_x64,
        about = "macos-x64 libsecp256k1 (SDK-less off a mac), for std/crypto"))
    out.push(own Command(name = secp256k1_lib("macos-arm64"), is_path = true, go = secp256k1_macos_arm64,
