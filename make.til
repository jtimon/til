    out.push(own Command(name = secp256k1_lib("linux-x64"), is_path = true, go = secp256k1_linux_x64,
        about = "linux-x64 libsecp256k1 (--linux-x64-cc= off a linux-x64 host), for std/crypto"))
    out.push(own Command(name = secp256k1_lib("linux-arm64"), is_path = true, go = secp256k1_linux_arm64,
        about = "linux-arm64 libsecp256k1, for programs importing std/crypto"))
    out.push(own Command(name = secp256k1_lib("linux-riscv64"), is_path = true, go = secp256k1_linux_riscv64,
