        about = "linux-x86 nng, for the server modes"))
    out.push(own Command(name = nng_lib("linux-arm32"), is_path = true, go = nng_linux_arm32,
        about = "linux-arm32 nng, for the server modes"))
    out.push(own Command(name = nng_lib("linux-riscv32"), is_path = true, go = nng_linux_riscv32,
        about = "linux-riscv32 nng (needs --riscv32-cc=), for the server modes"))
    out.push(own Command(name = nng_lib("windows-x64"), alias_of = "win_server", is_path = true, go = nng_windows_x64))
    out.push(own Command(name = nng_lib("windows-x86"), is_path = true, go = nng_windows_x86,
        about = "windows-x86 nng, for the server modes"))
