        about = "wasm32 libsecp256k1 (emcc, vendored emsdk), for std/crypto"))
    out.push(own Command(name = SECP256K1_WIN64_DLL, alias_of = "build_win_host", is_path = true, go = build_secp256k1_win_twin))
    out.push(own Command(name = RAYLIB_WIN64_DLL, alias_of = "build_win_host", is_path = true, go = build_gui_win_twins))
    out.push(own Command(name = TINYFD_WIN64_DLL, alias_of = "build_win_host", is_path = true, go = build_gui_win_twins))
    gui_archive_goals(out, "linux-x64", gui_linux_x64, "(--linux-x64-cc= off a linux-x64 host)")
