    out.push(own Command(name = "vendor/libffi/build-linux-riscv64/.libs/libffi.a", is_path = true, go = libffi_linux_riscv64,
        about = "linux-riscv64 libffi, for runtime ext_func (til itself on that host)"))
    out.push(own Command(name = "vendor/libffi/build-linux-x86/.libs/libffi.a", is_path = true, go = libffi_linux_x86,
