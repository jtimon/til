mode cli

import("../src/std/sys")
import("../src/std/file")
import("../src/self/targets")

realpath_str := ext_proc(path: Str) returns Str {}

WORK := "tmp/build_outputs"

check_command := proc(command: Cmd, expected: Str) {
    command.cwd(WORK)
    command.capture()
    status := command.run()
    if status != 0 { panic(command.render(), ": ", command.out(), command.err()) }
    if command.out() != expected {
        panic(command.render(), " expected '", expected, "', got '", command.out(), "'")
    }
}

mtime := proc(path: Str) returns I64 {
    return file_mtime(format(WORK, "/", path))
}

expect_same := proc(path: Str, before: I64, why: Str) {
    if mtime(path) != before { panic(why, ": ", path, " was rewritten") }
}

expect_newer := proc(path: Str, before: I64, why: Str) {
    if mtime(path) <= before { panic(why, ": ", path, " was not rewritten") }
}

// file_mtime has sub-second resolution, but writes take their mtime from a
// coarse kernel clock, and #442 treats an input as new as its output as
// newer. A short pause puts an edit in a later tick than the outputs around
// it, so the rebuild it causes is settled before the next comparison.
next_tick := proc() {
    sleep_ms(50)
}

edit := proc(path: Str, content: Str) {
    next_tick()
    File.writefile(path, content)
    next_tick()
}

main := proc(args: ..Str) {
    compiler := realpath_str(args[0])
    File.remove_tree(WORK)
    mkdir_p(format(WORK, "/foo"))
    mkdir_p(format(WORK, "/bar"))
    File.writefile(format(WORK, "/foo/main.til"), "mode script\nprintln(\"first406\")\n")
    File.writefile(format(WORK, "/bar/main.til"), "mode script\nprintln(\"second406\")\n")
    File.writefile(format(WORK, "/width.til"), "mode script\nprintln(USize.size().to_str())\n")
    File.writefile(format(WORK, "/linked.til"),
        "mode script\nlink_c(\"value.c\")\nvalue := ext_proc() returns shallow I64 {}\nprintln(value().to_str())\n")
    File.writefile(format(WORK, "/value.c"), "#include <stdint.h>\nint64_t value(void) { return 17; }\n")
    File.writefile(format(WORK, "/foo/linked.til"), File.readfile(format(WORK, "/linked.til")))
    File.writefile(format(WORK, "/foo/value.c"), "#include <stdint.h>\nint64_t value(void) { return 41; }\n")
    // #442: a target whose own source never changes, with a direct and a
    // transitive import and a link_c source whose result is in a header.
    mkdir_p(format(WORK, "/deps"))
    File.writefile(format(WORK, "/deps/main.til"),
        "mode script\nimport(\"direct\")\nlink_c(\"probe.c\")\nprobe := ext_proc() returns shallow I64 {}\nprintln(direct_word(), \" \", probe().to_str())\n")
    File.writefile(format(WORK, "/deps/direct.til"),
        "mode lib\nimport(\"transitive\")\ndirect_word := func() returns Str { return format(\"direct1-\", transitive_word()) }\n")
    File.writefile(format(WORK, "/deps/transitive.til"),
        "mode lib\ntransitive_word := func() returns Str { return \"transitive1\" }\n")
    File.writefile(format(WORK, "/deps/probe.c"), "#include <stdint.h>\n#include \"probe.h\"\nint64_t probe(void) { return PROBE; }\n")
    File.writefile(format(WORK, "/deps/probe.h"), "#define PROBE 1\n")
    // Make every later output strictly newer than its .til dependencies, so
    // the old timestamp shortcut really would take the wrong fast path.
    next_tick()

    check_command(Cmd.new(compiler, "run", "foo/main.til"), "first406\n")
    check_command(Cmd.new(compiler, "run", "bar/main.til"), "second406\n")
    mut ext := ""
    if host_os() == "windows" { ext = ".exe" }
    for stem : Str in array(Str, "foo/main", "bar/main") {
        if File.is_file(format(WORK, "/bin/", stem, ext)).not() {
            panic("missing directory-preserving executable: ", stem)
        }
        if File.is_file(format(WORK, "/gen/til/", stem, ".c")).not() {
            panic("missing directory-preserving C: ", stem)
        }
    }
    // Dot components and absolute spellings of the same source share the
    // source-relative location. The outside-cwd case stays below bin/gen.
    check_command(Cmd.new(compiler, "run", "./foo/../bar/main.til"), "second406\n")
    check_command(Cmd.new(compiler, "run", realpath_str(format(WORK, "/foo/main.til"))), "first406\n")
    outside := Cmd.new(compiler, "build", "../foo/main.til")
    outside.cwd(format(WORK, "/bar"))
    outside.capture()
    if outside.run() != 0 { panic(outside.out(), outside.err()) }
    outside_abs := realpath_str(format(WORK, "/foo/main.til"))
    outside_unrooted := outside_abs.strip_prefix("/")
    outside_extensionless := outside_unrooted.strip_suffix(".til")
    outside_stem := outside_extensionless.replace(":", "")
    if File.is_file(format(WORK, "/bar/bin/", outside_stem, ext)).not() {
        panic("outside source escaped the output tree")
    }

    shared := format("shared", ext)
    check_command(Cmd.new(compiler, "build", "-o", shared, "foo/main.til"), "")
    check_command(Cmd.new(compiler, "build", "-o", shared, "bar/main.til"), "")
    check_command(Cmd.new(format("./", shared)), "second406\n")
    check_command(Cmd.new(compiler, "run", "-o", shared, "foo/main.til"), "first406\n")

    for source : Str in array(Str, "foo/main.til", "bar/main.til") {
        check_command(Cmd.new(compiler, "translate", "-c", "shared.c", source),
            "Generated: shared.c\nGenerated: shared_forward.h\n")
    }
    c := File.readfile(format(WORK, "/shared.c"))
    if c.contains("second406").not().or(c.contains("first406")) {
        panic("translate reused another program's C")
    }
    // An existing file is not evidence of what compiler/options emitted it.
    File.writefile(format(WORK, "/shared.c"), "invalid stale compiler output\n")
    check_command(Cmd.new(compiler, "translate", "-c", "shared.c", "bar/main.til"),
        "Generated: shared.c\nGenerated: shared_forward.h\n")
    if File.readfile(format(WORK, "/shared.c")).contains("second406").not() {
        panic("translate trusted an existing output")
    }

    check_command(Cmd.new(compiler, "run", "--usize=32", "width.til"), "4\n")
    check_command(Cmd.new(compiler, "run", "--usize=64", "width.til"), "8\n")
    check_command(Cmd.new(compiler, "run", "--force-rebuild", "--usize=32", "width.til"), "4\n")
    rejected := Cmd.new(compiler, "build", "--cc=no-such-compiler-406", "foo/main.til")
    rejected.cwd(WORK)
    rejected.capture()
    if rejected.run() == 0 { panic("build ignored a changed C compiler") }

    // A bare source name must resolve link_c beside that source, just like
    // ./ and absolute spellings. A subdirectory's own C file must win over
    // the identically named file in cwd, in both execution paths.
    for command : Str in array(Str, "interpret", "run") {
        for source : Str in array(Str, "linked.til", "./linked.til",
            "foo/../linked.til", realpath_str(format(WORK, "/linked.til"))) {
            check_command(Cmd.new(compiler, command, source), "17\n")
        }
        check_command(Cmd.new(compiler, command, "foo/linked.til"), "41\n")
    }
    // A link_c edit invalidates the executable, not the translation.
    linked_c := mtime("gen/til/linked.c")
    edit(format(WORK, "/value.c"), "#include <stdint.h>\nint64_t value(void) { return 29; }\n")
    check_command(Cmd.new(compiler, "run", "linked.til"), "29\n")
    expect_same("gen/til/linked.c", linked_c, "link_c edit retranslated")

    // #442: an identical second invocation reuses the C and the executable,
    // run straight after the first: nanosecond mtimes order an output and
    // the inputs written within the same second.
    deps_bin := format("bin/deps/main", ext)
    check_command(Cmd.new(compiler, "run", "deps/main.til"), "direct1-transitive1 1\n")
    mut c_time := mtime("gen/til/deps/main.c")
    mut bin_time := mtime(deps_bin)
    if c_time % 1000000000 == 0 && bin_time % 1000000000 == 0 {
        panic("file_mtime lost sub-second resolution")
    }
    check_command(Cmd.new(compiler, "run", "deps/main.til"), "direct1-transitive1 1\n")
    check_command(Cmd.new(compiler, "build", "deps/main.til"), "")
    check_command(Cmd.new(compiler, "translate", "deps/main.til"),
        "Generated: gen/til/deps/main.c\nGenerated: gen/til/deps/main_forward.h\n")
    expect_same("gen/til/deps/main.c", c_time, "unchanged run retranslated")
    expect_same(deps_bin, bin_time, "unchanged run recompiled")

    // A header the link_c source includes: compile only.
    edit(format(WORK, "/deps/probe.h"), "#define PROBE 2\n")
    check_command(Cmd.new(compiler, "run", "deps/main.til"), "direct1-transitive1 2\n")
    expect_same("gen/til/deps/main.c", c_time, "header edit retranslated")
    expect_newer(deps_bin, bin_time, "header edit")
    bin_time = mtime(deps_bin)

    // A direct import edit, the target source untouched: both phases.
    edit(format(WORK, "/deps/direct.til"),
        "mode lib\nimport(\"transitive\")\ndirect_word := func() returns Str { return format(\"direct2-\", transitive_word()) }\n")
    check_command(Cmd.new(compiler, "run", "deps/main.til"), "direct2-transitive1 2\n")
    expect_newer("gen/til/deps/main.c", c_time, "direct import edit")
    expect_newer(deps_bin, bin_time, "direct import edit")
    c_time = mtime("gen/til/deps/main.c")
    bin_time = mtime(deps_bin)

    // A transitive import edit: translate alone rewrites only the C.
    edit(format(WORK, "/deps/transitive.til"),
        "mode lib\ntransitive_word := func() returns Str { return \"transitive2\" }\n")
    check_command(Cmd.new(compiler, "translate", "deps/main.til"),
        "Generated: gen/til/deps/main.c\nGenerated: gen/til/deps/main_forward.h\n")
    expect_newer("gen/til/deps/main.c", c_time, "transitive import edit")
    expect_same(deps_bin, bin_time, "translate compiled")
    c_time = mtime("gen/til/deps/main.c")
    check_command(Cmd.new(compiler, "run", "deps/main.til"), "direct2-transitive2 2\n")
    expect_same("gen/til/deps/main.c", c_time, "current translation retranslated")
    expect_newer(deps_bin, bin_time, "stale executable after retranslation")

    // A missing executable is compiled from the current translation.
    File.remove(format(WORK, "/", deps_bin))
    check_command(Cmd.new(compiler, "run", "deps/main.til"), "direct2-transitive2 2\n")
    expect_same("gen/til/deps/main.c", c_time, "missing executable retranslated")
    bin_time = mtime(deps_bin)

    // An option stamps the phase it shapes (#442): --opt the executable
    // only, --usize the translation too.
    next_tick()
    check_command(Cmd.new(compiler, "run", "--opt=2", "deps/main.til"), "direct2-transitive2 2\n")
    expect_same("gen/til/deps/main.c", c_time, "--opt retranslated")
    expect_newer(deps_bin, bin_time, "--opt")
    bin_time = mtime(deps_bin)
    next_tick()
    check_command(Cmd.new(compiler, "run", "--usize=64", "deps/main.til"), "direct2-transitive2 2\n")
    expect_newer("gen/til/deps/main.c", c_time, "--usize")
    expect_newer(deps_bin, bin_time, "--usize")
    c_time = mtime("gen/til/deps/main.c")
    bin_time = mtime(deps_bin)
    // A translation that does not end in its stamp (an interrupted one, or
    // a file someone else wrote) is regenerated, however new it is.
    c_text := File.readfile(format(WORK, "/gen/til/deps/main.c"))
    next_tick()
    File.writefile(format(WORK, "/gen/til/deps/main.c"), c_text.substr(0, c_text.len() / 2))
    check_command(Cmd.new(compiler, "run", "--usize=64", "deps/main.til"), "direct2-transitive2 2\n")
    expect_newer("gen/til/deps/main.c", c_time, "truncated translation")
    c_time = mtime("gen/til/deps/main.c")
    bin_time = mtime(deps_bin)

    // TIL_GC_AUDIT prints while translating, so an audited translation is
    // never reused: the second identical command must print the dump too.
    for attempt in 0..2 {
        audit := Cmd.new(compiler, "translate", "deps/main.til")
        audit.env("TIL_GC_AUDIT", "deps/main.til")
        audit.cwd(WORK)
        audit.capture()
        if audit.run() != 0 { panic(audit.render(), ": ", audit.out(), audit.err()) }
        if format(audit.out(), audit.err()).contains("GC-CFG body").not() {
            panic("TIL_GC_AUDIT translation ", attempt.to_str(), " printed no audit: ", audit.out(), audit.err())
        }
    }
    c_time = mtime("gen/til/deps/main.c")

    // --force-rebuild regenerates both phases with nothing changed.
    next_tick()
    check_command(Cmd.new(compiler, "run", "--force-rebuild", "--usize=64", "deps/main.til"), "direct2-transitive2 2\n")
    expect_newer("gen/til/deps/main.c", c_time, "--force-rebuild")
    expect_newer(deps_bin, bin_time, "--force-rebuild")
    if detect_current_target().is(Target.LinuxX64) {
        File.writefile(format(WORK, "/foo/backend.til"), "mode cli\nmain := proc() { println(\"first backend\") }\n")
        File.writefile(format(WORK, "/bar/backend.til"), "mode cli\nmain := proc() { println(\"second backend\") }\n")
        // Translation needs neither the assembler nor LLVM tools. Every
        // backend must retain the source hierarchy and its exact reporting.
        for backend in array(Str, "fasm", "mlir") {
            mut suffix := ".fasm"
            if backend == "mlir" { suffix = ".mlir" }
            for directory in array(Str, "foo", "bar") {
                source := format(directory, "/backend.til")
                generated := format("gen/", backend, "/", directory, "/backend", suffix)
                check_command(Cmd.new(compiler, "translate", format("--backend=", backend), source),
                    format("Generated: ", generated, "\n"))
                expect(File.is_file(format(WORK, "/", generated)), "missing backend source: ", generated)
                if backend == "mlir" {
                    expect(File.is_file(format(WORK, "/gen/til/", directory, "/backend.c")), "missing MLIR support C")
                    expect(File.is_file(format(WORK, "/gen/til/", directory, "/backend_forward.h")), "missing MLIR support header")
                }
            }
        }
    }
    println("build outputs passed")
}
