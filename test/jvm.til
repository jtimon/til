mode cli

import("../src/std/sys")

// #375 Stage G: the JVM corpus, run on demand by `make test_jvm`. The
// default suite stays JDK-free, which is how a USize regression left
// every JVM fixture failing in javac without anything noticing; this is
// the leg that runs the JDK. Each program is built by the builder's real
// path (`til run --target=jvm`: javac --release 17 -Xlint:all -Werror, a
// verified JAR) at both USize widths, and its stdout, stderr and exit
// status must equal the interpreter's at the same width -- stderr is where
// a test-mode program reports its tests, so leaving it out let a back end
// that ran no test at all look like one whose tests passed. A missing JDK fails loudly
// through the builder's own probe -- this target is opt-in, so a skip
// would only hide that the corpus did not run.

// Programs the JVM back end runs today. Grow this list as #375 lands
// features; a program moves here from EXCLUDED below once it passes.
CORPUS := array(Str,
    "examples/hello_script.til",
    "examples/fizzbuzz.til",
    "test/jvm_scalar_smoke.til",
    "test/jvm_stage_d.til",
    "test/jvm_stage_e.til",
    "test/jvm_stage_f.til",
    "test/script_raw_alloc.til",
    "test/script_dynamic_free.til",
    "test/maps.til",
    "test/sets.til",
    "test/fn_ptr.til",
    "test/loops.til",
    "test/closures.til",
    "test/structs.til",
    "test/vecs.til",
    "test/enums.til")

// Not yet: each fails loudly with the first diagnostic shown -- refused
// at translation, or rejected by javac -- never a silently wrong program
// (#375's acceptance). Kept here so the gap is a list, not a guess:
//   test/script_str_runtime.til     parameter type for 'parts' (FuncDef Func)
//   test/script_struct_runtime.til  javac: a `returns ref` struct field
//                                   returned where a raw Ptr is expected
//   test/strings.til                javac: a module-level constant read
//                                   inside a function (no JVM globals yet)
//   test/arrays.til                 javac: a `ref` scalar field holding a
//                                   raw address (AccessorIndexView.data)

// What one run left: stdout, stderr and exit status.
priv Outcome := struct {
    out := ""
    err := ""
    status : I64 = 0
}

// The JVM launcher announces options it picked up from the environment
// (`Picked up JAVA_TOOL_OPTIONS: ...`) on stderr before the program runs.
// That line belongs to the host, not to the program, so it is dropped.
priv program_stderr := func(err: Str) returns Str {
    mut out := Str.with_capacity(err.len())
    for line : Str in err.split("\n") {
        if line.starts_with("Picked up ").not() {
            if out.len().gt(0) { out.push_str("\n") }
            out.push_str(line)
        }
    }
    return out
}

priv run_captured := proc(command: Cmd) returns Outcome {
    command.capture()
    status := command.run()
    return Outcome(out = command.out(), err = command.err(), status = status)
}

main := proc() {
    mut failures : I64 = 0
    for bits : Str in array(Str, "32", "64") {
        usize := format("--usize=", bits)
        for source : Str in CORPUS {
            expected := run_captured(Cmd.new("timeout", "300", "bin/til", "interpret", usize, source))
            actual := run_captured(Cmd.new("timeout", "300", "bin/til", "run", "--target=jvm", usize, source))
            jvm_err := program_stderr(actual.err)
            same := actual.status.eq(expected.status).and(actual.out.eq(expected.out))
                .and(jvm_err.eq(program_stderr(expected.err)))
            if same {
                println("jvm ", usize, " ", source, ": ok")
            } else {
                failures++
                println("jvm ", usize, " ", source, ": FAIL (status ", actual.status.to_str(),
                    ", interpreter ", expected.status.to_str(), ")")
                println("--- interpreter stdout\n", expected.out)
                println("--- jvm stdout\n", actual.out)
                println("--- interpreter stderr\n", expected.err)
                println("--- jvm stderr\n", actual.err)
            }
        }
    }
    if failures > 0 {
        panic("JVM corpus: ", failures.to_str(), " failure(s)")
    }
    println("JVM corpus passed: ", CORPUS.len().to_str(), " programs at both USize widths")
}
