mode test

// Negative test (#415): a field's value cannot be moved out of its holder.
// The holder still owns it and would delete it again -- at its scope end,
// on `h = ...` / `h.f = ...`, or in the caller that lent it. Pass a clone,
// or swap the value out first. A consuming constructor field is an `own`
// parameter the source need not spell, so it is the same error.

take_field415 := func(own s: Str) returns USize { return s.len() }
replace_field415 := func(own s: Str) returns Str { return s }

FieldHolder415 := struct {
    name := ""
}

FieldOuter415 := struct {
    inner := FieldHolder415()
}

// 1. A local's field.
local_field415 := func() {
    h := FieldHolder415(name = "head")
    take_field415(own h.name)
}

// 2. The in-place transform: the field is still moved out while the RHS runs.
replace_in_place415 := func() {
    mut h := FieldHolder415(name = "head")
    h.name = replace_field415(own h.name)
}

// 3. A lent holder's field: the caller would find it gone.
lent_field415 := func(mut h: FieldHolder415) {
    h.name = "body"
    take_field415(own h.name)
}

// 4. A nested field.
nested_field415 := func() {
    o := FieldOuter415(inner = FieldHolder415(name = "head"))
    take_field415(own o.inner.name)
}

// 5. A constructor field takes its argument by value.
ctor_field415 := func() {
    a := FieldHolder415(name = "head")
    b := FieldHolder415(name = a.name)
    assert_eq(Str, b.name, "head")
}

// 6. So does an enum variant's payload.
variant_field415 := func() {
    a := FieldHolder415(name = "head")
    o := Option(Str).Some(a.name)
    assert(o.is_some())
}

test_field_transfer_errors := test() {
    local_field415()
    replace_in_place415()
    mut h := FieldHolder415(name = "head")
    lent_field415(h)
    nested_field415()
    ctor_field415()
    variant_field415()
}
