mode test

// Negative test (#415): a field moved out by `own h.f`. Whatever deletes
// `h` next would free the moved value again, so the field must get a new
// value before `h` is read, replaced or left, and a refill must know
// whether the old value is still there to free.

take_field415 := func(own s: Str) returns USize { return s.len() }

FieldHolder415 := struct {
    name := ""
}

// 1. Moved out and never given a new value: h's scope-end delete would
// free it again.
drop_field415 := func() {
    mut h := FieldHolder415(name = "head")
    h.name = "body"
    take_field415(own h.name)
}

// 2. Read while moved.
read_field415 := func() {
    mut h := FieldHolder415(name = "head")
    take_field415(own h.name)
    n := h.name.len()
    h.name = "next"
    assert_eq(USize, n, 4)
}

// 3. Refilled where it is moved on some paths only: no runtime flag says
// whether the old value still needs freeing.
maybe_field415 := func(flag: Bool) {
    mut h := FieldHolder415(name = "head")
    if flag { take_field415(own h.name) }
    h.name = "next"
}

// 4. The whole holder replaced while the field is moved: the old holder's
// delete would free it.
replace_holder415 := func() {
    mut h := FieldHolder415(name = "head")
    take_field415(own h.name)
    h = FieldHolder415(name = "next")
}

// 5. A lent holder's field moved out: the caller would find it gone.
drain_field415 := func(mut h: FieldHolder415) {
    h.name = "body"
    take_field415(own h.name)
}

test_field_transfer_errors := test() {
    drop_field415()
    read_field415()
    maybe_field415(true)
    replace_holder415()
    mut h := FieldHolder415(name = "head")
    drain_field415(h)
}
