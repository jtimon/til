mode script

// Issue #309 regression, COMPILE-ONLY. Built with --usize=64, the emitted
// structs use U64 container widths (via ext.h -DTIL_USIZE64), and the size
// intrinsics (X.size() / dyn_size_of) emit C sizeof on a width-mismatched
// target, so they report that wide width. On a 64-bit pointer target,
// Str = ptr(8)+count(8)+cap(8) = 24; Vec has the same layout.
//
// This file is driven ONLY as a compiled binary by the Makefile check_usize64
// target -- NOT interpreted: the compile-time interpreter manipulates the
// compiler's own HOST-resident structs, so X.size() is the host width under
// the interpreter. The target-layout assertion therefore belongs in compiled
// code.

// #313: stored references are native pointers in the native layout.
RefPair := struct {
    ref first : I64
    ref second : I64
}

// #472: a generator condition asks size_for_target(), the TARGET layout
// (typer.til target_value_size_align), which must model own pointer fields the way the
// emitted struct stores them: here tag(4) + pad(4) + own name(8, a native pointer) = 16.
Holder := struct {
    tag : U32 = 0
    own name : Str = ""
}
holder_size_gen := macro() returns FuncDef {
    if Holder.size_for_target() == 16 {
        return func() returns USize { return 16 }
    } else {
        return func() returns USize { return 0 }
    }
}
holder_size := holder_size_gen()

// #472 (F2): a size reaching the program through compile-time evaluation.
// The compiler evaluates these in its OWN layout, which is only the target's
// when the two happen to match, so it must not bake the results: the call
// and the namespace initializers are left for the program, where
// Holder.size() is 16. A compiler built with the other layout used to
// bake its own number here.
holder_twice := func() returns USize { return Holder.size() * 2 }
// #472 (F3): compile-time code that needs the BUILT program's size asks
// size_for_target(). A macro body runs inside the compiler, where a plain
// size() is the compiler's own layout; this one must bake 16 whichever
// compiler builds it.
holder_bytes_at_compile_time := macro() returns shallow USize { return Holder.size_for_target() }
HolderSizes := struct {
namespace:
    BYTES : USize = Holder.size()
    DOUBLE : USize = HolderSizes.BYTES * 2
}

check := proc(label: Str, got: USize, want: USize) {
    if got.neq(want) {
        println(format("FAIL: ", label, " = ", got.to_str(), ", want ", want.to_str()))
        exit(1)
    }
}

check("Str.size()", Str.size(), 24)
check("Vec(Str).size()", Vec(Str).size(), 24)
check("Vec(I64).size()", Vec(I64).size(), 24)
check("dyn_size_of Str", dyn_size_of("Str"), 24)
check("RefPair.size()", RefPair.size(), 16)
check("Holder.size()", Holder.size(), 16)
check("generator Holder.size()", holder_size(), 16)
check("folded call holder_twice()", holder_twice(), 32)
check("Holder.size_for_target()", Holder.size_for_target(), 16)
check("size_for_target() in a macro body", holder_bytes_at_compile_time(), 16)
check("Str.size_for_target()", Str.size_for_target(), Str.size())
check("USize.size_for_target()", USize.size_for_target(), USize.size())
check("namespace constant from a size", HolderSizes.BYTES, 16)
check("namespace constant from that constant", HolderSizes.DOUBLE, 32)

// A vec must stride at the wide width too: 3 pushes stay addressable and
// round-trip (a host-width 16-byte stride over 24-byte structs would misplace
// elements).
mut v := Vec(Str).new()
v.push(own "a")
v.push(own "bb")
v.push(own "ccc")
check("vec len", v.len(), 3)
ref e0 : Str = v.unsafe_get(0)
ref e2 : Str = v.unsafe_get(2)
if e0.eq("a").and(e2.eq("ccc")).not() { println("FAIL: vec stride"); exit(1) }

println("usize64 sizes OK")
