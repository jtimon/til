mode cli
import("../src/std/sys")
import("../src/std/file")
import("../src/self/targets")
realpath_str := ext_proc(path: Str) returns Str {}

main := proc(compiler_arg: Str) {
    compiler := realpath_str(compiler_arg)
    work := "tmp/fasm_options"
    mkdir_p(work)
    File.writefile(format(work, "/main.til"), "mode cli\nmain := proc() {}\n")
    if detect_current_target().is(Target.LinuxX64) {
        good := Cmd.new(compiler, "translate", "--backend=fasm", "main.til")
        good.cwd(work).capture()
        good_status := good.run()
        expect(good_status == 0, good.out(), good.err())
        assembly := File.readfile(format(work, "/gen/fasm/main.fasm"))
        expect(assembly.contains("format ELF64 executable 3"), assembly)
        for command_name in array(Str, "translate", "build", "run") {
            arguments := Cmd.new(compiler, command_name, "--backend=fasm", "main.til", "unexpected")
            arguments.cwd(work).capture()
            expect(arguments.run() != 0, "FASM entry arguments accepted: ", command_name)
            expect(arguments.out() == "error: FASM entry point takes no arguments\n", arguments.out(), arguments.err())
        }
        File.writefile(format(work, "/runtime.til"), "mode script\nprintln(\"hello\",\"%\\x00Z\")\npanic(\"bad\",loc=\"probe:1:1\")\n")
        runtime := Cmd.new(compiler, "translate", "--backend=fasm", "runtime.til")
        runtime.cwd(work).capture()
        runtime_status := runtime.run()
        expect(runtime_status == 0, runtime.out(), runtime.err())
        runtime_source := File.readfile(format(work, "/gen/fasm/runtime.fasm"))
        expect(runtime_source.contains("/src/self/codegen/ext.fasm'") && runtime_source.contains("call rt_println") && runtime_source.contains("call rt_panic"), runtime_source)
        File.writefile(format(work, "/bad.til"), "mode cli\nbad := func(x: F32) returns F32 { return x }\nmain := proc() { bad(1.0) }\n")
        bad := Cmd.new(compiler, "translate", "--backend=fasm", "bad.til")
        bad.cwd(work).capture()
        expect(bad.run() != 0, "unsupported float accepted")
        expect(bad.out().contains("FASM backend:") && bad.out().contains("bad.til:"), bad.out(), bad.err())
        for flag in array(Str, "--asan", "--prof", "--cpu=baseline", "--opt=0", "--cc=cc") {
            rejected := Cmd.new(compiler, "build", "--backend=fasm", flag, "main.til")
            rejected.cwd(work).capture()
            expect(rejected.run() != 0, flag)
            expect(rejected.out().contains("FASM backend does not support"), rejected.out(), rejected.err())
        }
        File.writefile(format(work, "/divide.til"), "mode cli\ndivide := func(a: I64,b: I64) returns I64 { return a / b }\nmain := proc() { mut x : I64 = 10; x = x + 1; exit(divide(x,2)) }\n")
        divide := Cmd.new(compiler, "translate", "--backend=fasm", "divide.til")
        divide.cwd(work).capture()
        divide_status := divide.run()
        expect(divide_status == 0, divide.out(), divide.err())
        divide_source := File.readfile(format(work, "/gen/fasm/divide.fasm"))
        expect(divide_source.contains("idiv rcx"), divide_source)
        File.writefile(format(work, "/control.til"), File.readfile("test/scalar_control.til"))
        control := Cmd.new(compiler, "translate", "--backend=fasm", "control.til")
        control.cwd(work).capture()
        control_status := control.run()
        expect(control_status == 0, control.out(), control.err())
        control_source := File.readfile(format(work, "/gen/fasm/control.fasm"))
        expect(control_source.contains(".loop") && control_source.contains("sar rax, cl"), control_source)
        File.writefile(format(work, "/aggregates.til"), File.readfile("test/aggregate_control.til"))
        File.writefile(format(work, "/globals_lib.til"), "mode lib\nmut count : I64 = 1\nadvance := func() returns I64 { count++; return count }\n")
        File.writefile(format(work, "/globals.til"), "mode cli\nimport(\"./globals_lib\")\nmut value := advance()\nmain := proc() { value = advance(); println(value.to_str()) }\n")
        for width in array(Str, "32", "64") {
            aggregates := Cmd.new(compiler, "translate", "--backend=fasm", format("--usize=", width), "aggregates.til")
            aggregates.cwd(work).capture()
            aggregate_status := aggregates.run()
            expect(aggregate_status == 0, aggregates.out(), aggregates.err())
            aggregate_source := File.readfile(format(work, "/gen/fasm/aggregates.fasm"))
            expect(aggregate_source.contains("call rt_cfile_open") && aggregate_source.contains("call rt_memcpy"), aggregate_source)
            globals := Cmd.new(compiler, "translate", "--backend=fasm", format("--usize=", width), "globals.til")
            globals.cwd(work).capture()
            globals_status := globals.run()
            expect(globals_status == 0, globals.out(), globals.err())
            global_source := File.readfile(format(work, "/gen/fasm/globals.fasm"))
            expect(global_source.contains("segment readable writeable") && global_source.contains("qword [global"), global_source)
        }
        File.writefile(format(work, "/bad_field.til"), "mode cli\nBad := struct { value: F32 = 0.0 }\nmain := proc() { mut b := Bad(); b.value = 1.0; println(b.value.to_str()) }\n")
        bad_field := Cmd.new(compiler, "translate", "--backend=fasm", "bad_field.til")
        bad_field.cwd(work).capture()
        expect(bad_field.run() != 0, "unsupported float field accepted")
        expect(bad_field.out().contains("FASM backend:") && bad_field.out().contains("bad_field.til:"), bad_field.out(), bad_field.err())
        File.writefile(format(work, "/bad_global.til"), "mode cli\nmut value : F32 = 1.0\nmain := proc() { println(value.to_str()) }\n")
        bad_global := Cmd.new(compiler, "translate", "--backend=fasm", "bad_global.til")
        bad_global.cwd(work).capture()
        expect(bad_global.run() != 0, "unsupported float global accepted")
        expect(bad_global.out().contains("unsupported global type or initializer") && bad_global.out().contains("bad_global.til:"), bad_global.out(), bad_global.err())
        File.writefile(format(work, "/library.til"), "mode pure\nvalue := func() returns I64 { return 1 }\n")
        library := Cmd.new(compiler, "translate", "--backend=fasm", "library.til")
        library.cwd(work).capture()
        expect(library.run() != 0, "unsupported library accepted")
        expect(library.out().contains("mode cli or script only"), library.out(), library.err())
    }
    wrong_target := Cmd.new(compiler, "translate", "--backend=fasm", "--target=linux-arm64", "main.til")
    wrong_target.cwd(work).capture()
    expect(wrong_target.run() != 0, "unsupported target accepted")
    expect(wrong_target.out().contains("Linux x86-64 hosts and targets only"), wrong_target.out(), wrong_target.err())
    wrong_command := Cmd.new(compiler, "interpret", "--backend=fasm", "main.til")
    wrong_command.cwd(work).capture()
    expect(wrong_command.run() != 0, "unsupported command accepted")
    expect(wrong_command.out().contains("--backend requires translate, build or run"), wrong_command.out(), wrong_command.err())
    println("fasm_options PASS")
}
