mode test

// Issue #198: throw/catch error handling, rstil-style.
// Lowering lives in the typer so the interpreter and builder both
// run these without any new error-handling code paths.

AAAError := struct {}

// #443: guard uses of a failed reference result and later operands, not
// just statements following the enclosing expression.
nested_pair := func(a: Array(F32), b: Array(F32)) returns F32 throws OutOfBounds {
    return a.get(0)? + b.get(0)?
}

nested_mark := func(mut trace: I64, digit: I64) returns F32 {
    trace = trace * 10 + digit
    return digit.to_f32()
}

nested_consume := func(a: F32, b: F32, mut calls: I64) returns F32 {
    calls++
    return a + b
}

nested_arguments := func(a: Array(F32), mut trace: I64, mut calls: I64) returns F32 throws OutOfBounds {
    return nested_consume(nested_mark(trace, 1) + a.get(0)?, nested_mark(trace, 2), calls)
}

test_nested_question_returns_and_arguments := test() {
    a := array(F32, 4)
    empty := Array(F32).new(0)
    assert_eq(F32, nested_pair(a, a)!, 8)
    mut caught := 0
    nested_pair(empty, a)? catch (err: OutOfBounds) { caught++ }
    nested_pair(a, empty)? catch (err: OutOfBounds) { caught++ }
    assert_eq(I64, caught, 2)
    mut trace := 0
    mut calls := 0
    nested_arguments(empty, trace, calls)? catch (err: OutOfBounds) { caught++ }
    assert_eq(I64, trace, 1)
    assert_eq(I64, calls, 0)
    trace = 0
    assert_eq(F32, nested_arguments(a, trace, calls)!, 7)
    assert_eq(I64, trace, 12)
    assert_eq(I64, calls, 1)
}

test_nested_question_initializers_and_stores := test() {
    a := array(F32, 4)
    empty := Array(F32).new(0)
    mut caught := 0
    good := a.get(0)? + a.get(0)?
    assert_eq(F32, good, 8)
    catch (err: OutOfBounds) { assert(false) }
    bad := a.get(0)? + empty.get(0)?
    assert_eq(F32, bad, 8)
    catch (err: OutOfBounds) { caught++ }
    mut target : F32 = 99
    target = a.get(0)? + empty.get(0)?
    catch (err: OutOfBounds) { caught++ }
    assert_eq(F32, target, 99)
    target = nested_outer_bang(-1)?
    catch (err: OutOfBounds) { caught++ }
    assert_eq(F32, target, 99)
    assert_eq(I64, caught, 3)
}

NestedReader := func(values: Array(F32), index: USize) returns ref F32 throws OutOfBounds

nested_read := func(values: Array(F32), index: USize) returns ref F32 throws OutOfBounds {
    return values.get(index)?
}

nested_callback_pair := func(reader: NestedReader, values: Array(F32)) returns F32 throws OutOfBounds {
    return reader(values, 0)? + reader(values, 1)?
}

nested_conditions := func(values: Array(F32), mut branches: I64) throws OutOfBounds {
    if values.get(0)? > 0 { branches++ }
    while values.get(0)? > 0 {
        branches++
        break
    }
}

test_nested_question_callbacks_and_conditions := test() {
    values := array(F32, 4, 5)
    empty := Array(F32).new(0)
    short_values := array(F32, 4)
    assert_eq(F32, nested_callback_pair(nested_read, values)!, 9)
    mut caught := 0
    nested_callback_pair(nested_read, empty)? catch (err: OutOfBounds) { caught++ }
    nested_callback_pair(nested_read, short_values)? catch (err: OutOfBounds) { caught++ }
    mut branches := 0
    nested_conditions(empty, branches)? catch (err: OutOfBounds) { caught++ }
    assert_eq(I64, branches, 0)
    nested_conditions(values, branches)!
    assert_eq(I64, branches, 2)
    assert_eq(I64, caught, 3)
}

nested_change := func(mut values: Array(F32)) returns ref F32 throws OutOfBounds {
    ref mut v : F32 = values.get(0)?
    v = v + 10
    return v
}

nested_snapshot := func(mut values: Array(F32)) returns F32 throws OutOfBounds {
    return values.get(0)? + nested_change(values)?
}

test_nested_question_value_snapshot := test() {
    mut values := array(F32, 1)
    assert_eq(F32, nested_snapshot(values)!, 12)
    assert_eq(F32, values[0], 11)
}

nested_pick_ref := func(values: Array(F32), marker: F32) returns ref F32 throws OutOfBounds {
    if marker < 0 { throw OutOfBounds() }
    return values.get(0)?
}

nested_ref_initializer := func(values: Array(F32)) returns F32 throws OutOfBounds {
    ref selected : F32 = nested_pick_ref(values, values.get(0)?)?
    return selected.clone()
}

nested_ref_initializer_bang := func(values: Array(F32)) returns F32 throws OutOfBounds {
    ref selected : F32 = nested_pick_ref(values, values.get(0)?)!
    return selected.clone()
}

nested_ref_return_bang := func(values: Array(F32)) returns ref F32 throws OutOfBounds {
    return nested_pick_ref(values, values.get(0)?)!
}

test_nested_question_reference_lifetimes := test() {
    values := array(F32, 4)
    empty := Array(F32).new(0)
    assert_eq(F32, nested_ref_initializer(values)!, 4)
    assert_eq(F32, nested_ref_initializer_bang(values)!, 4)
    ref selected : F32 = nested_ref_return_bang(values)!
    assert_eq(F32, selected, 4)
    mut caught := 0
    nested_ref_initializer(empty)? catch (err: OutOfBounds) { caught++ }
    nested_ref_initializer_bang(empty)? catch (err: OutOfBounds) { caught++ }
    nested_ref_return_bang(empty)? catch (err: OutOfBounds) { caught++ }
    assert_eq(I64, caught, 3)
}

nested_owned := func(value: F32) returns Str { return format("value ", value) }

nested_format := func(values: Array(F32)) returns Str throws OutOfBounds {
    return format("value ", values.get(0)?)
}

nested_outer_bang := func(value: F32) returns F32 throws OutOfBounds {
    if value < 0 { throw OutOfBounds() }
    return value
}

nested_question_inside_bang := func(values: Array(F32)) returns F32 throws OutOfBounds {
    return nested_outer_bang(values.get(0)?)!
}

test_nested_question_variadic_and_bang := test() {
    values := array(F32, 4)
    empty := Array(F32).new(0)
    assert_eq(Str, nested_format(values)!, "value 4")
    assert_eq(F32, nested_question_inside_bang(values)!, 4)
    mut caught := 0
    nested_format(empty)? catch (err: OutOfBounds) { caught++ }
    nested_question_inside_bang(empty)? catch (err: OutOfBounds) { caught++ }
    assert_eq(I64, caught, 2)
}

test_nested_question_owned_result := test() {
    values := array(F32, 4)
    empty := Array(F32).new(0)
    good := nested_owned(values.get(0)?)
    assert_eq(Str, good, "value 4")
    catch (err: OutOfBounds) { assert(false) }
    mut caught := false
    bad := nested_owned(empty.get(0)?)
    assert_eq(Str, bad, "unreachable")
    catch (err: OutOfBounds) { caught = true }
    assert(caught)
}

// #444: an unhandled error exits before the loop condition/iterator is
// evaluated again. A handled error still permits the next iteration.
propagation_loop := func(values: Array(I64), mut attempts: I64, mut conditions: I64) throws OutOfBounds {
    while propagation_condition(conditions) {
        attempts++
        label := format("iteration ", attempts)
        assert(label.len() > 0)
        values.get(0)?
    }
}

propagation_condition := func(mut conditions: I64) returns Bool {
    conditions++
    return conditions < 4
}

test_loop_propagation_stops_backedge := test() {
    values := Array(I64).new(0)
    mut attempts : I64 = 0
    mut conditions : I64 = 0
    mut caught := false
    propagation_loop(values, attempts, conditions)? catch (err: OutOfBounds) { caught = true }
    assert(caught)
    assert_eq(I64, attempts, 1)
    assert_eq(I64, conditions, 1)
}

propagation_nested_loop := func(values: Array(I64), mut attempts: I64) throws OutOfBounds {
    for i in 0..3 {
        for j in 0..3 {
            assert(i >= 0 && j >= 0)
            attempts++
            values.get(0)?
        }
    }
}

test_nested_for_propagation := test() {
    values := Array(I64).new(0)
    mut attempts : I64 = 0
    mut caught := false
    propagation_nested_loop(values, attempts)? catch (err: OutOfBounds) { caught = true }
    assert(caught)
    assert_eq(I64, attempts, 1)
}

test_loop_local_catch_continues := test() {
    values := Array(I64).new(0)
    mut attempts : I64 = 0
    mut caught : I64 = 0
    while attempts < 3 {
        attempts++
        values.get(0)? catch (err: OutOfBounds) { caught++ }
    }
    assert_eq(I64, attempts, 3)
    assert_eq(I64, caught, 3)
}

propagation_bad_condition := func(mut calls: I64) returns Bool throws AAAError {
    calls++
    throw AAAError()
}

propagation_condition_loop := func(mut calls: I64, mut bodies: I64) throws AAAError {
    while calls < 3 && propagation_bad_condition(calls)?.not() {
        bodies++
    }
}

test_throwing_loop_condition := test() {
    mut calls : I64 = 0
    mut bodies : I64 = 0
    mut caught := false
    propagation_condition_loop(calls, bodies)? catch (err: AAAError) { caught = true }
    assert(caught)
    assert_eq(I64, calls, 1)
    assert_eq(I64, bodies, 0)
}

throwing_index := func(values: Vec(I64), index: USize) returns I64 throws AAAError, OutOfBounds {
    if values.len() == 0 { throw AAAError() }
    ref value : I64 = values.get(index)?
    return value.clone()
}

throwing_bang_index := func(values: Vec(I64)) returns I64 throws AAAError {
    if values.len() == 0 { throw AAAError() }
    return values[0].clone()
}

test_simplest_catch := test() {
    values := vec(I64, 42)
    assert(throwing_bang_index(values)! == 42)
    assert(throwing_index(values, 0)! == 42)
    mut caught_bounds := false
    throwing_index(values, 1)?
    catch (error: AAAError) { assert(false) }
    catch (error: OutOfBounds) { caught_bounds = true }
    assert(caught_bounds)
    mut catched := false
    if I64.eq(1, 1) {
        throw AAAError()
    }
    assert(false)  // unreachable on the error path
    catch (err: AAAError) {
        catched = true
    }
    assert(catched)
}

// A fieldless catch binding is constructed only in the taken arm. This keeps
// ordinary catches tag-only while preserving source-level values when used.
test_fieldless_catch_binding := test() {
    mut catched := false
    throw AAAError()
    catch (err: AAAError) {
        assert(err.eq(AAAError()))
        catched = true
    }
    assert(catched)
}

make_fieldless_error := func(mut calls: I64) returns AAAError {
    calls++
    return AAAError()
}

// A non-constructor fieldless throw expression must still run exactly once;
// its owned empty result is discarded on the throw path rather than leaked.
test_fieldless_throw_expression := test() {
    mut calls := 0
    mut catched := false
    throw make_fieldless_error(calls)
    catch (err: AAAError) {
        catched = true
    }
    assert(catched)
    assert_eq(I64, calls, 1)
}

ErrorWithMessage := struct {
    msg: Str = "default error message"
}

mixed_throw := func(empty: Bool) throws AAAError, ErrorWithMessage {
    if empty { throw AAAError() }
    throw ErrorWithMessage(msg = "rich error")
}

test_mixed_fieldless_and_payload_errors := test() {
    mut caught_empty := false
    mut caught_rich := ""
    mixed_throw(true)?
    catch (empty: AAAError) {
        caught_empty = empty.eq(AAAError())
    }
    catch (rich: ErrorWithMessage) {
        caught_rich = rich.msg
    }
    assert(caught_empty)
    assert(caught_rich.eq(""))

    mixed_throw(false)?
    catch (empty: AAAError) {
        caught_empty = empty.eq(AAAError())
    }
    catch (rich: ErrorWithMessage) {
        caught_rich = rich.msg
    }
    assert(caught_rich.eq("rich error"))
}

test_catch_with_fields := test() {
    mut caught_msg := ""
    mut catched := false
    if I64.eq(1, 1) {
        my_error := ErrorWithMessage()
        throw my_error
    }
    catch (err: ErrorWithMessage) {
        caught_msg = err.msg
        catched = true
    }
    assert(catched)
    assert(caught_msg.eq("default error message"))
}

// DivideByZero is defined in src/core/i64.til alongside I64.safe_div.

defaulted_tuple := func(fail: Bool, count: I64 = 7, text: Str = "default") returns Tuple throws ErrorWithMessage {
    if fail { throw ErrorWithMessage(msg = text.clone()) }
    mut result := Tuple.new()
    result.push(I64, own count.clone())
    result.push(Str, own text.clone())
    return result
}

// Hidden throw arguments must not occupy the source positions of explicitly
// supplied defaults. Exercise omitted, positional, named and mixed forms.
test_throwing_tuple_defaults := test() {
    omitted := defaulted_tuple(false)!
    positional := defaulted_tuple(false, 11, "positional")!
    named := defaulted_tuple(false, text = "named")!
    mixed := defaulted_tuple(false, 13, text = "mixed")!
    ref omitted_count : I64 = omitted.get(0)
    ref positional_count : I64 = positional.get(0)
    ref named_count : I64 = named.get(0)
    ref mixed_count : I64 = mixed.get(0)
    ref positional_text : Str = positional.get(1)
    ref named_text : Str = named.get(1)
    ref mixed_text : Str = mixed.get(1)
    assert(omitted_count == 7 && positional_count == 11 && named_count == 7 && mixed_count == 13)
    assert(positional_text == "positional" && named_text == "named" && mixed_text == "mixed")
    mut caught := false
    unexpected := defaulted_tuple(true, 17, "failure")?
    assert(unexpected.len() == 2)
    catch (err: ErrorWithMessage) {
        assert(err.msg == "failure")
        caught = true
    }
    assert(caught)
}

ConstructedResult := struct {
    value := 0
namespace:
    new := func(required: I64) returns ConstructedResult {
        return ConstructedResult(value = required)
    }
}

throwing_constructed := func(fail: Bool) returns ConstructedResult throws AAAError {
    if fail { throw AAAError() }
    return ConstructedResult.new(42)
}

// The unused error-path return initializes fields without calling a public
// constructor, which can require arguments or have effects of its own.
test_throwing_constructor_result := test() {
    value := throwing_constructed(false)!
    assert(value.value == 42)
    mut caught := false
    unexpected := throwing_constructed(true)?
    assert(unexpected.value == 42)
    catch (err: AAAError) { caught = true }
    assert(caught)
}

unsafe_div := func(a: I64, b: I64) returns I64 {
    result := a.safe_div(b)?
    catch (err: DivideByZero) {
        return 0
    }
    return result
}

test_unsafe_div := test() {
    assert(unsafe_div(42, 0).eq(0))
    assert(unsafe_div(42, 2).eq(21))
}

// Issue #281 follow-up: safe_div now reports the caller. DivideByZero gained a
// msg field and safe_div a defaulted loc, so a divide-by-zero names the CALL
// site, not i64.til's throw line -- consistent with safe_add/sub/mul.
test_safe_div_reports_caller := test() {
    mut caught := ""
    cl := __LINE__
    _ := I64.safe_div(1, 0)?
    catch (e: DivideByZero) {
        caught = e.msg.clone()
    }
    call_line := cl.add(1)
    expect(caught.find("errors.til").neq(-1),
           "safe_div DivideByZero names the CALLER file, not i64.til")
    expect(caught.find(format(":", call_line.to_str(), ":")).neq(-1),
           "safe_div DivideByZero points at the CALL line, not i64.til's throw")
    expect(caught.find("safe_div").neq(-1), "carries the safe_div message")
}

test_catch_str_error := test() {
    mut caught := false
    mut error_msg := ""
    if I64.eq(1, 1) {
        throw "This is a test error message"
    }
    catch (err: Str) {
        caught = true
        error_msg = err
    }
    assert(caught)
    assert(error_msg.eq("This is a test error message"))
}

test_catch_error_with_str_field := test() {
    mut caught := false
    mut caught_msg := ""
    if I64.eq(1, 1) {
        mut my_error := ErrorWithMessage()
        my_error.msg = "Custom error message"
        throw my_error
    }
    catch (err: ErrorWithMessage) {
        caught = true
        caught_msg = err.msg
    }
    assert(caught)
    assert(caught_msg.eq("Custom error message"))
}

// ==========================================================
// Bug #34 regression: code AFTER catch runs in both paths;
// code BETWEEN throwing call and catch is skipped on error.
// ==========================================================

Bug34Error := struct {
    msg: Str = ""
}

bug34_maybe_throw := func(should_throw: Bool) throws Bug34Error {
    if should_throw {
        throw Bug34Error()
    }
}

test_bug34_after_catch_success := test() {
    mut after_catch_ran := false
    bug34_maybe_throw(false)?
    catch (err: Bug34Error) {
    }
    after_catch_ran = true
    assert(after_catch_ran)
}

test_bug34_after_catch_error := test() {
    mut after_catch_ran := false
    bug34_maybe_throw(true)?
    catch (err: Bug34Error) {
    }
    after_catch_ran = true
    assert(after_catch_ran)
}

test_bug34_between_throw_and_catch := test() {
    mut caught := false
    bug34_maybe_throw(true)?
    caught = false  // should NOT run on error path
    catch (err: Bug34Error) {
        caught = true
    }
    assert(caught)
}

test_bug34_between_success := test() {
    mut between_ran := false
    mut caught := false
    bug34_maybe_throw(false)?
    between_ran = true
    catch (err: Bug34Error) {
        caught = true
    }
    assert(caught.not())
    assert(between_ran)
}

// The two bug34 between-tests above used to pass VACUOUSLY: the guard
// group that skips post-throw statements on the error path consumed the
// later catch too, nesting its `if _err_kind == tag` under
// `if _err_kind == 0` -- so on the error path the catch, the asserts,
// and everything after were silently skipped and the test counted as
// green. This helper routes the outcome through its return value: if the
// group ever swallows the catch again, the `return` is swallowed with it
// and the function falls through to its fallback return (0), which the
// asserts below cannot mistake for success.
priv bug34_between_probe := func(should_throw: Bool) returns I64 {
    mut caught := 0
    mut between := 0
    bug34_maybe_throw(should_throw)?
    between = 1
    catch (err: Bug34Error) {
        caught = 10
    }
    return caught.add(between)
}

test_bug34_between_not_vacuous := test() {
    // error path: catch ran, between skipped
    assert_eq(I64, bug34_between_probe(true), 10)
    // success path: between ran, catch skipped
    assert_eq(I64, bug34_between_probe(false), 1)
}

// A `throw` inside a catch body runs AFTER the catch's _err_kind reset,
// so it leaves the error pending exactly like a throw outside one, and
// the statements after such a catch must not run on that path. They did:
// `after_ran = true` executed and the function returned normally with
// _err_kind already set to the re-thrown tag.
RethrowOuter := struct {}

rethrow_as_outer := func(should_throw: Bool, mut after_ran: Bool) throws RethrowOuter {
    bug34_maybe_throw(should_throw)?
    catch (err: Bug34Error) { throw RethrowOuter() }
    after_ran = true
}

test_rethrow_in_catch_guards_rest := test() {
    mut ran := false
    mut caught := false
    rethrow_as_outer(true, ran)?
    catch (err: RethrowOuter) { caught = true }
    assert(caught)
    assert(ran.not())
    rethrow_as_outer(false, ran)?
    catch (err: RethrowOuter) { assert(false) }
    assert(ran)
}

// A `ref` local bound by a throwing call, with a catch that diverges: the
// binding is only ever read on the no-error path, so the later use is
// legal. The rejected shapes (a use inside the catch, or after a catch
// that falls through) are in test/typer_errors.til.
ref_get_or := func(i: USize) returns I64 {
    arr := array(I64, 10, 20, 30)
    ref x : I64 = arr.get(i)?
    catch (err: OutOfBounds) { return -1 }
    return x.clone()
}

test_ref_binding_divergent_catch := test() {
    assert_eq(I64, ref_get_or(1), 20)
    assert_eq(I64, ref_get_or(9), -1)
}

// ==========================================================
// Multi-catch tests
// ==========================================================

TestErrorA := struct {}
TestErrorB := struct {}

throw_a_maybe := func(should_throw: Bool) throws TestErrorA {
    if should_throw {
        throw TestErrorA()
    }
}

throw_b_maybe := func(should_throw: Bool) throws TestErrorB {
    if should_throw {
        throw TestErrorB()
    }
}

test_non_consecutive_catches := test() {
    mut after_a_ran := false
    mut after_b_ran := false
    mut caught_a := false
    mut caught_b := false

    throw_a_maybe(true)?
    after_a_ran = true
    catch (err: TestErrorA) {
        caught_a = true
    }

    throw_b_maybe(true)?
    after_b_ran = true
    catch (err: TestErrorB) {
        caught_b = true
    }

    assert(after_a_ran.not())
    assert(after_b_ran.not())
    assert(caught_a)
    assert(caught_b)
}

MultiThrowError := struct {}

multi_throw_maybe := func(should_throw: Bool) throws MultiThrowError {
    if should_throw {
        throw MultiThrowError()
    }
}

test_multi_throw_single_catch := test() {
    mut after_first_ran := false
    mut after_second_ran := false
    mut caught := false

    multi_throw_maybe(true)?
    after_first_ran = true
    multi_throw_maybe(false)?
    after_second_ran = true
    catch (err: MultiThrowError) {
        caught = true
    }

    assert(after_first_ran.not())
    assert(after_second_ran.not())
    assert(caught)
}

test_multi_throw_success := test() {
    mut after_first_ran := false
    mut after_second_ran := false
    mut caught := false

    multi_throw_maybe(false)?
    after_first_ran = true
    multi_throw_maybe(false)?
    after_second_ran = true
    catch (err: MultiThrowError) {
        caught = true
    }

    assert(after_first_ran)
    assert(after_second_ran)
    assert(caught.not())
}

// ==========================================================
// Caller/callee with different throws sets
// ==========================================================

CallerCalleeErrorA := struct {}
CallerCalleeErrorB := struct {}

callee2_throws_both := func(throw_a: Bool, throw_b: Bool) throws CallerCalleeErrorA, CallerCalleeErrorB {
    if throw_b {
        throw CallerCalleeErrorB()
    }
    if throw_a {
        throw CallerCalleeErrorA()
    }
}

callee1_throws_a_only := func(throw_a: Bool, throw_b: Bool) returns Bool throws CallerCalleeErrorA {
    mut caught_b := false
    callee2_throws_both(throw_a, throw_b)?
    catch (err: CallerCalleeErrorB) {
        caught_b = true
    }
    return caught_b
}

test_caller_callee_different_throws := test() {
    caught_b_internally := callee1_throws_a_only(false, true)?
    catch (err: CallerCalleeErrorA) {
    }
    assert(caught_b_internally)

    mut after_callee1_ran := false
    mut caught_a := false
    _ := callee1_throws_a_only(true, false)?
    after_callee1_ran = true
    catch (err: CallerCalleeErrorA) {
        caught_a = true
    }
    assert(after_callee1_ran.not())
    assert(caught_a)
}

// ==========================================================
// Issue #202: bang operator -- panic-on-throw shorthand
// ==========================================================

bang_throws := func(should_throw: Bool) returns I64 throws CallerCalleeErrorA {
    if should_throw {
        throw CallerCalleeErrorA()
    }
    return 42
}

// Success path: bang on a call that doesn't throw returns normally.
test_bang_success := test() {
    result := bang_throws(false)!
    assert(result.eq(42))
}

// Bang inside a Return: hoisted to a temp so the catch+panic
// executes BEFORE the return statement, otherwise unreachable.
bang_return_wrapper := func(x: Bool) returns I64 throws CallerCalleeErrorA {
    return bang_throws(x)!
}

test_bang_in_return := test() {
    result := bang_return_wrapper(false)!
    assert(result.eq(42))
}

// Nested-bang positions: bang inside an arg or method-chain receiver
// gets hoisted into a temp before the enclosing statement. Without
// hoisting these would slip past the stmt-level handler and trip the
// typer's arity check on the lowered throwing-call signature.
test_bang_nested_in_arg := test() {
    // bang inside an FCall arg
    assert(bang_throws(false)!.eq(42))
}

test_bang_nested_in_chain := test() {
    // bang on the receiver of a method chain
    s := bang_throws(false)!.to_str()
    assert(s.eq("42"))
}

test_bang_inside_bang := test() {
    // outer bang on a call whose arg is itself a bang
    inner := bang_throws(false)!
    outer := bang_return_wrapper(false)!
    assert(inner.eq(42))
    assert(outer.eq(42))
}

