// ==========================================================
// Array.get throws OutOfBounds (catch-friendly indexed access;
// callers use arr.get(i)! to keep the panic-on-OOB behavior).
// ==========================================================

// The catch has to DIVERGE for `v` to be readable after it: on the error
// path `v` is the callee's NULL fallback return, and the checker rejects a
// use after a catch that falls through. assert(false) aborts at runtime
// but assert is conditional, not noreturn; panic is.
test_array_get_ok := test() {
    arr := array(I64, 10, 20, 30)
    ref v : I64 = arr.get(1)?
    catch (err: OutOfBounds) {
        panic("unexpected OutOfBounds")
    }
    assert(v.eq(20))
}

test_array_get_oob := test() {
    arr := array(I64, 10, 20, 30)
    mut caught := false
    ref _v : I64 = arr.get(99)?
    catch (err: OutOfBounds) {
        caught = true
    }
    assert(caught)
}

// The bang form panics on OOB (same as the old behavior). The
// success path returns the element normally.
test_array_get_bang_ok := test() {
    arr := array(I64, 5, 6, 7)
    ref v : I64 = arr.get(2)!
    assert(v.eq(7))
}

test_vec_get_oob := test() {
    mut v := vec(I64)
    v.push(own 10)
    v.push(own 20)
    mut caught := false
    ref _x : I64 = v.get(99)?
    catch (e: OutOfBounds) {
        caught = e.eq(OutOfBounds())
    }
    assert(caught)
}

// ==========================================================
// Assigning the result of a ref-returning `?` call.
//
// The lowering groups the statements AFTER a throwing call under
// `if _err_kind == 0`, but the throwing statement itself has to run
// unguarded -- it is what sets _err_kind. For `r = a.get(5)?` that put
// the STORE on the error path too: `get` had fallen through to its
// synthesized fallback return, NULL for a `returns ref` signature, and
// the assignment dereferenced it ("panic: null deref") before the catch
// could run. The call is now hoisted into a ref temp so only the store
// moves under the guard. `ref x : T = a.get(5)?` never crashed (binding
// a ref does not dereference it), which is why the tests above passed.
// ==========================================================

ThrowStoreHolder := struct {
    x : I64 = 0
}

test_assign_from_ref_throw_oob := test() {
    arr := array(I64, 10, 20, 30)
    mut r : I64 = -1
    r = arr.get(99)?
    catch (err: OutOfBounds) { r = 42 }
    assert_eq(I64, r, 42)
}

test_assign_from_ref_throw_ok := test() {
    arr := array(I64, 10, 20, 30)
    mut r : I64 = -1
    r = arr.get(1)?
    catch (err: OutOfBounds) { r = 42 }
    assert_eq(I64, r, 20)
}

// The throwing call nested inside the stored expression: `.add(1)` reads
// the same null ref, so the whole store has to move under the guard.
test_assign_from_nested_ref_throw_oob := test() {
    arr := array(I64, 10, 20, 30)
    mut r : I64 = -1
    r = arr.get(99)?.add(1)
    catch (err: OutOfBounds) { r = 42 }
    assert_eq(I64, r, 42)
}

test_assign_from_nested_ref_throw_ok := test() {
    arr := array(I64, 10, 20, 30)
    mut r : I64 = -1
    r = arr.get(1)?.add(1)
    catch (err: OutOfBounds) { r = 42 }
    assert_eq(I64, r, 21)
}

test_field_assign_from_ref_throw_oob := test() {
    arr := array(I64, 10, 20, 30)
    mut h := ThrowStoreHolder()
    h.x = arr.get(99)?
    catch (err: OutOfBounds) { h.x = 42 }
    assert_eq(I64, h.x, 42)
}

test_field_assign_from_ref_throw_ok := test() {
    arr := array(I64, 10, 20, 30)
    mut h := ThrowStoreHolder()
    h.x = arr.get(1)?
    catch (err: OutOfBounds) { h.x = 42 }
    assert_eq(I64, h.x, 20)
}

// An owned element type: the hoisted temp is a ref alias, so the store
// still copies out of the container exactly once on the success path and
// touches nothing on the error path.
test_assign_from_ref_throw_owned_elem := test() {
    mut v := vec(Str)
    v.push(own "hello")
    mut s := ""
    s = v.get(0)?
    catch (err: OutOfBounds) { s = "boom" }
    assert_eq(Str, s, "hello")
    mut s2 := ""
    s2 = v.get(9)?
    catch (err: OutOfBounds) { s2 = "boom" }
    assert_eq(Str, s2, "boom")
}

// The statements after the guarded store still run on the success path.
test_assign_from_ref_throw_after_ok := test() {
    arr := array(I64, 10, 20, 30)
    mut r : I64 = -1
    mut after := 0
    r = arr.get(1)?
    catch (err: OutOfBounds) { r = 42 }
    after = 5
    assert_eq(I64, r, 20)
    assert_eq(I64, after, 5)
}

// ==========================================================
// Issue #225 prep: statement-level `?`/`!` on method calls.
//
// A free-function call already parsed a trailing `?`/`!` at statement
// position (`f(x)?` works), but a method call did not -- a bare
// `obj.m(args)!` only parsed in expression position. Subscript
// assignment `a[b] = c` lowers to `a.set(b, own c)!`, a throwing
// method call in statement position, so the statement parser must
// accept the suffix. These exercise that shape directly with a
// throwing void method (no subscript involved).
// ==========================================================

StmtThrowError := struct { msg: Str = "" }

StmtThrower := struct {
    n: I64 = 0
namespace:
    bump := func(mut self: StmtThrower, by: I64) throws StmtThrowError {
        if by.lt(0) {
            throw StmtThrowError(msg = "negative bump")
        }
        self.n = self.n.add(by)
    }
}

// `!` on a statement-level method call: no throw on this path, so no
// panic; the call runs to completion.
test_stmt_method_bang_ok := test() {
    mut t := StmtThrower()
    t.bump(5)!
    assert_eq(I64, t.n, 5)
    t.bump(3)!
    assert_eq(I64, t.n, 8)
}

// `?` on a statement-level method call, throw path: the catch runs and
// the statements after the throwing call (inside bump) do not.
test_stmt_method_question_throws := test() {
    mut t := StmtThrower()
    mut caught := false
    mut emsg := ""
    t.bump(-1)?
    catch (err: StmtThrowError) {
        caught = true
        emsg = err.msg
    }
    assert(caught)
    assert(emsg.eq("negative bump"))
    assert_eq(I64, t.n, 0)
}

// `?` on a statement-level method call, success path: the catch is
// skipped and the call's effect is visible.
test_stmt_method_question_ok := test() {
    mut t := StmtThrower()
    mut caught := false
    t.bump(2)?
    catch (err: StmtThrowError) {
        caught = true
    }
    assert(caught.not())
    assert_eq(I64, t.n, 2)
}

// Issue #281: a THROWING helper with a defaulted `loc: Str = __LOC__` reports
// the CALLER's location in its thrown error, not the helper's own definition
// line. This is the issue's primary payoff (cf. Vec.get's OutOfBounds), proven
// on a user helper: a defaulted param now works on a throwing function -- its
// synthetic _err_* out-params are injected before the trailing default so they
// still line up positionally (append_err_out_params).
LocCheckErr := struct { msg := "" }

guard_nonneg := func(x: I64, loc: Str = __LOC__) returns I64 throws LocCheckErr {
    if x.lt(0) {
        throw LocCheckErr(msg = format(loc, ": negative input"))
    }
    return x
}

test_throwing_helper_reports_caller := test() {
    mut caught := ""
    cl := __LINE__
    guard_nonneg(-5)?
    catch (e: LocCheckErr) {
        caught = e.msg.clone()
    }
    // The throwing call is the line right after cl's capture.
    call_line := cl.add(1)
    expect(caught.find("errors.til").neq(-1),
           "throwing helper error names the CALLER file, not its own")
    expect(caught.find(format(":", call_line.to_str(), ":")).neq(-1),
           "throwing helper error points at the CALL line, not guard_nonneg's def")
    expect(caught.find("negative input").neq(-1), "carries the formatted message")

    // Success path returns normally (no throw); '!' handles the throws clause.
    ok := guard_nonneg(7)!
    assert_eq(I64, ok, 7)
}

// Issue #201 (throw-lowering): a throwing function may declare locals AFTER a
// guarded throw and use them across later statements. The lowering guards the
// whole post-throw remainder with ONE `if _err_kind == 0` block; the old bug
// wrapped each statement in its own guard, scoping every post-throw local to
// its own block, so `acc` / `doubled` below were "undefined" on the next line.
post_guard_locals := func(x: I64) returns I64 throws OutOfBounds {
    if x.lt(0) {
        throw OutOfBounds()
    }
    mut acc : I64 = x
    acc = acc.add(10)
    doubled := acc.mul(2)
    return doubled
}

test_throw_post_guard_locals := test() {
    // Success path: locals declared after the guarded throw compute, flow
    // into one another, then into the return.
    ok := post_guard_locals(4)!
    assert_eq(I64, ok, 28)

    // Error path: the guarded throw still fires and is catchable.
    mut caught := false
    post_guard_locals(-1)?
    catch (e: OutOfBounds) { caught = true }
    assert(caught)
}

// #328: a generic with a STATIC throw type works with omitted type
// arguments. Its throws metadata is published under the SOURCE name --
// the caller's throw lowering runs before inference has a monomorphized
// name to key on -- and the concrete declaration inherits the extended
// signature from the clone.
Rejected328 := struct { why := "" }

gchecked328 := func(T: Type, v: T, fail: Bool) returns T throws Rejected328 {
    if fail {
        throw Rejected328(why = "rejected")
    }
    return v
}

test_generic_infer_static_throw := test() {
    n : I64 = 5
    // Success path, type argument omitted.
    ok := gchecked328(n, false)!
    assert_eq(I64, ok, 5)
    // Throwing path, type argument omitted.
    mut caught := false
    gchecked328(n, true)?
    catch (e: Rejected328) { caught = true }
    assert(caught)
    // The explicit form selects the same concrete implementation.
    also_ok := gchecked328(I64, n, false)!
    assert_eq(I64, also_ok, 5)
}

// A thrown PARAMETER. Neither body scan can see one -- a parameter is not
// a Decl anywhere in the body -- so the throw's type came back empty and
// the declared clause was reported as never thrown. Worse, the scan for a
// prior declaration started at `len()` instead of the last index, so with
// no prior statement at all it indexed an empty vector: `throw e` as the
// FIRST statement of a nested body crashed the compiler outright.
ParamThrowErr := struct { why := "" }

param_throw_nested := func(e: ParamThrowErr, fail: Bool) returns I64 throws ParamThrowErr {
    if fail { throw e }
    return 1
}

param_throw_tail := func(e: ParamThrowErr, fail: Bool) returns I64 throws ParamThrowErr {
    if fail.not() { return 2 }
    throw e
}

test_throw_param_first_stmt_of_nested_body := test() {
    err := ParamThrowErr(why = "nested")
    ok := param_throw_nested(err, false)!
    assert_eq(I64, ok, 1)
    mut caught := false
    param_throw_nested(err, true)?
    catch (e: ParamThrowErr) { caught = true }
    assert(caught)
}

test_throw_param_in_tail_position := test() {
    err := ParamThrowErr(why = "tail")
    ok := param_throw_tail(err, false)!
    assert_eq(I64, ok, 2)
    mut caught := false
    param_throw_tail(err, true)?
    catch (e: ParamThrowErr) { caught = true }
    assert(caught)
}

// #328 follow-up: with a thrown parameter resolvable, a generic whose
// `throws` clause IS its type parameter works under explicit type
// application. Inferring one stays refused -- the caller's error slots
// are built before inference could resolve T (see test/typer_errors.til).
gdep_throw328 := func(T: Type, v: T, fail: Bool) returns I64 throws T {
    if fail { throw v }
    return 3
}

test_generic_dependent_throw_explicit := test() {
    err := ParamThrowErr(why = "generic")
    ok := gdep_throw328(ParamThrowErr, err, false)!
    assert_eq(I64, ok, 3)
    mut caught := false
    gdep_throw328(ParamThrowErr, err, true)?
    catch (e: ParamThrowErr) { caught = true }
    assert(caught)
}

// A PRIMITIVE throw type. Its struct def exists only to carry namespace
// methods, so it has zero fields -- and throw_type_has_payload read "no
// fields" as "marker error": the payload was dropped and the bare thrown
// expression was pushed as a statement, which no backend could evaluate
// ("unexpected statement type ... this is a bug in the language").
prim_throw_param := func(v: I64, fail: Bool) returns I64 throws I64 {
    if fail { throw v }
    return v
}

prim_throw_lit := func(fail: Bool) returns I64 throws I64 {
    if fail { throw 42 }
    return 1
}

gdep_prim328 := func(T: Type, v: T, fail: Bool) returns I64 throws T {
    if fail { throw v }
    return 3
}

test_throw_primitive_param := test() {
    ok := prim_throw_param(5, false)!
    assert_eq(I64, ok, 5)
    mut payload : I64 = 0
    prim_throw_param(7, true)?
    catch (e: I64) { payload = e }
    assert_eq(I64, payload, 7)
}

test_throw_primitive_literal := test() {
    mut payload : I64 = 0
    prim_throw_lit(true)?
    catch (e: I64) { payload = e }
    assert_eq(I64, payload, 42)
}

// #328: a dependent `throws T` generic under EXPLICIT application now
// also works when T is a primitive, not only a struct.
test_generic_dependent_throw_primitive := test() {
    mut payload : I64 = 0
    gdep_prim328(I64, 9, true)?
    catch (e: I64) { payload = e }
    assert_eq(I64, payload, 9)
}
