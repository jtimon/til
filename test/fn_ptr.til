mode test

fn_double := func(n: I64) returns I64 {
    return n.mul(2)
}

fn_add := func(a: I64, b: I64) returns I64 {
    return a.add(b)
}

fn_negate := func(n: I64) returns I64 {
    return 0.sub(n)
}

greet := func(mut x: I64) {
    x = x.add(100)
}

apply := func(f: Fn(I64) returns I64, x: I64) returns I64 {
    return f(x)
}

apply2 := func(f: Fn(I64, I64) returns I64, a: I64, b: I64) returns I64 {
    return f(a, b)
}

// Fn(...) without a returns clause is a proc signature.
mutate := proc(f: Fn(mut I64), mut x: I64) {
    f(x)
}

test_basic_fn_ptr := test() {
    f := fn_double
    assert_eq(I64, f(5), 10)
    assert_eq(I64, f(0), 0)
    assert_eq(I64, f(3), 6)
}

test_pass_fn_as_arg := test() {
    assert_eq(I64, apply(fn_double, 5), 10)
    assert_eq(I64, apply(fn_double, 3), 6)
    assert_eq(I64, apply(fn_negate, 7), -7)
}

test_pass_fn_two_args := test() {
    assert_eq(I64, apply2(fn_add, 3, 4), 7)
    assert_eq(I64, apply2(fn_add, 10, 20), 30)
}

test_fn_ptr_mut_param := test() {
    mut val := 42
    mutate(greet, val)
    assert_eq(I64, val, 142)
}

// --- FuncSig type definitions ---

BinaryOp := func(I64, I64) returns I64

fn_mul := func(a: I64, b: I64) returns I64 {
    return a.mul(b)
}

apply_binop := func(op: BinaryOp, a: I64, b: I64) returns I64 {
    return op(a, b)
}

test_funcsig_named_param := test() {
    assert_eq(I64, apply_binop(fn_add, 3, 5), 8)
    assert_eq(I64, apply_binop(fn_mul, 3, 5), 15)
}

test_funcsig_decl_type := test() {
    f : BinaryOp = fn_add
    assert_eq(I64, f(10, 20), 30)

    g : BinaryOp = fn_mul
    assert_eq(I64, g(4, 5), 20)
}

test_funcsig_reassign := test() {
    mut f : BinaryOp = fn_add
    assert_eq(I64, f(2, 3), 5)
    f = fn_mul
    assert_eq(I64, f(2, 3), 6)
}

UnaryOp := func(I64) returns I64

apply_unary := func(op: UnaryOp, x: I64) returns I64 {
    return op(x)
}

test_funcsig_unary := test() {
    assert_eq(I64, apply_unary(fn_double, 7), 14)
    assert_eq(I64, apply_unary(fn_negate, 5), -5)
}

DynCallbacks := struct {
namespace:
    length := func(text: Str) returns USize { return text.len() }
    twice := func(text: Str) returns USize { return text.len() * 2 }
    double := func(n: I64) returns I64 { return n * 2 }
    negate := func(n: I64) returns I64 { return 0 - n }
    sum := func(a: I64, b: I64) returns I64 { return a + b }
    float_add := func(a: F64, b: F64) returns F64 { return a + b }
    mutate := func(mut n: I64) { n = n + 9 }
    make := func(text: Str) returns ReturnBox346 { return ReturnBox346(value = text.clone()) }
    consume := func(own box: ReturnBox346) returns USize { return box.value.len() }
}
DynLength := func(Str) returns USize

test_local_dyn_fn := test() {
    mut callback: DynLength = dyn_fn("DynCallbacks", "length")
    assert_eq(USize, callback("initial"), 7)
    copy := callback
    assert_eq(USize, copy("copy"), 4)
    doubled: DynLength = dyn_fn("DynCallbacks", "twice")
    callback = doubled
    assert_eq(USize, callback("after"), 10)
    assert_eq(USize, copy("after"), 5)
}

Mutator := func(mut I64)

DynFloat := func(F64, F64) returns F64
runtime_dyn_callback := func(type_name: Str, method: Str) returns UnaryOp {
    if method == "double" { return dyn_fn(type_name, "double") }
    return dyn_fn(type_name, "negate")
}

test_typed_dyn_fn_scalars := test() {
    clone: UnaryOp = dyn_fn("I64", "clone")
    assert_eq(I64, clone(23), 23)
    mut callback: UnaryOp = dyn_fn("DynCallbacks", "double")
    assert_eq(I64, callback(7), 14)
    callback = dyn_fn("DynCallbacks", "negate")
    assert_eq(I64, callback(7), -7)
    assert_eq(I64, apply_unary(dyn_fn("DynCallbacks", "double"), 9), 18)
    handler := Handler(on_click = dyn_fn("DynCallbacks", "sum"))
    assert_eq(I64, handler.on_click(3, 4), 7)
    floats: DynFloat = dyn_fn("DynCallbacks", "float_add")
    assert_eq(F64, floats(1.25, 2.5), 3.75)
    mutate_value: Mutator = dyn_fn("DynCallbacks", "mutate")
    mut n := 10
    mutate_value(n)
    assert_eq(I64, n, 19)
}

test_typed_dyn_fn_runtime_selection := test() {
    mut methods := Vec(Str).new()
    methods.push(own "double")
    methods.push(own "negate")
    for method : Str in methods {
        callback := runtime_dyn_callback("DynCallbacks", method)
        if method == "double" { assert_eq(I64, callback(5), 10) }
        else { assert_eq(I64, callback(5), -5) }
    }
}

test_typed_dyn_fn_owned_aggregate := test() {
    make: ReturnBoxMaker346 = dyn_fn("DynCallbacks", "make")
    consume: OwnedBoxValueFn346 = dyn_fn("DynCallbacks", "consume")
    box := make("owned")
    assert_eq(USize, consume(own box), 5)
}

ErasedCloneAlias := CloneFn
ErasedOwnedDelete := func(own Dynamic, Bool)

test_dyn_fn_erased_and_typed := test() {
    type_name := "Str"
    clone: ErasedCloneAlias = dyn_fn(type_name, "clone")
    drop: ErasedOwnedDelete = dyn_fn(type_name, "delete")
    text := "erased clone"
    raw: Dynamic = clone(text)
    ref copied: Str = to_ptr(raw)
    assert_eq(Str, copied, text)
    drop(own raw, true)
    typed_clone: UnaryOp = dyn_fn("I64", "clone")
    assert_eq(I64, typed_clone(23), 23)
}

apply_mutator := func(f: Mutator, mut x: I64) {
    f(x)
}

test_funcsig_proc := test() {
    mut val := 10
    apply_mutator(greet, val)
    assert_eq(I64, val, 110)
}

// --- FuncSig form declarations ---

sum_sig : func(I64, I64) returns I64 = (a, b) {
    return a.add(b)
}

negate_sig : func(I64) returns I64 = (x) {
    return 0.sub(x)
}

greet_sig : func(mut I64) = (x) {
    x = x.add(100)
}

test_funcsig_form_basic := test() {
    assert_eq(I64, sum_sig(3, 5), 8)
    assert_eq(I64, negate_sig(7), -7)
}

test_funcsig_form_proc := test() {
    mut val := 10
    greet_sig(val)
    assert_eq(I64, val, 110)
}

test_funcsig_form_as_value := test() {
    f : BinaryOp = sum_sig
    assert_eq(I64, f(10, 20), 30)
    assert_eq(I64, apply_binop(sum_sig, 4, 6), 10)
}

// --- Named FuncSig form ---

sum_named : BinaryOp = (a, b) {
    return a.add(b)
}

negate_named : UnaryOp = (x) {
    return 0.sub(x)
}

greet_named : Mutator = (x) {
    x = x.add(100)
}

test_named_funcsig_form := test() {
    assert_eq(I64, sum_named(3, 5), 8)
    assert_eq(I64, negate_named(7), -7)
    assert_eq(I64, apply_binop(sum_named, 4, 6), 10)
}

test_named_funcsig_form_proc := test() {
    mut val := 10
    greet_named(val)
    assert_eq(I64, val, 110)
}

test_named_funcsig_form_as_value := test() {
    f : BinaryOp = sum_named
    assert_eq(I64, f(10, 20), 30)
}

// --- Returning FuncSig-typed values ---

get_binop := func(which: Str) returns BinaryOp {
    if which.eq("add") {
        return fn_add
    }
    return fn_mul
}

test_return_funcsig := test() {
    op := get_binop("add")
    assert_eq(I64, op(3, 5), 8)
    op2 := get_binop("mul")
    assert_eq(I64, op2(3, 5), 15)
}

test_return_funcsig_pass := test() {
    op := get_binop("add")
    assert_eq(I64, apply_binop(op, 10, 20), 30)
}

// --- Struct fields with FuncSig type ---

Handler := struct {
    on_click : BinaryOp = fn_add
}

test_struct_field_funcsig := test() {
    h := Handler(on_click = fn_add)
    assert_eq(I64, h.on_click(3, 5), 8)
}

test_struct_field_reassign := test() {
    mut h := Handler(on_click = fn_add)
    assert_eq(I64, h.on_click(3, 5), 8)
    h.on_click = fn_mul
    assert_eq(I64, h.on_click(3, 5), 15)
}

// --- FuncSig type aliases ---

Callback := BinaryOp

apply_callback := func(cb: Callback, a: I64, b: I64) returns I64 {
    return cb(a, b)
}

test_funcsig_alias := test() {
    assert_eq(I64, apply_callback(fn_add, 3, 5), 8)
    assert_eq(I64, apply_callback(fn_mul, 4, 5), 20)
    f : Callback = fn_add
    assert_eq(I64, f(10, 20), 30)
}

test_struct_field_default := test() {
    h := Handler()
    assert_eq(I64, h.on_click(3, 5), 8)
}

// --- Enum payloads with FuncSig type ---

Action := enum { Click: BinaryOp, Idle }

test_enum_funcsig_payload := test() {
    a := Action.Click(fn_add)
    switch a {
    case Action.Click(op):
        assert_eq(I64, op(3, 5), 8)
    case:
        UNREACHABLE()
    }
}

test_enum_funcsig_payload_mul := test() {
    a := Action.Click(fn_mul)
    switch a {
    case Action.Click(op):
        assert_eq(I64, op(4, 5), 20)
    case:
        UNREACHABLE()
    }
}

test_enum_funcsig_idle := test() {
    a : Action = Action.Idle
    expect(a.is(Action.Idle), "Idle is_Idle")
    expect(a.is(Action.Click).not(), "Idle not Click")
}

// --- FuncSig with returns shallow ---

BoolFn := func(I64) returns Bool

is_positive := func(n: I64) returns Bool { return n.gt(0) }

call_bool_fn := func(f: BoolFn, x: I64) returns Bool { return f(x) }

test_funcsig_shallow_return := test() {
    expect(call_bool_fn(is_positive, 5), "5 is positive")
    expect(call_bool_fn(is_positive, -3).not(), "-3 is not positive")
}

test_funcsig_shallow_return_direct := test() {
    f : BoolFn = is_positive
    expect(f(10), "10 is positive")
    expect(f(-1).not(), "-1 is not positive")
}

// #346: ordinary owned aggregates use the same by-value C return ABI through
// direct calls and FuncSig/closure dispatch. The Str field keeps this from
// collapsing to a POD-only special case.
ReturnBox346 := struct { value := "" }
ReturnBoxMaker346 := func(Str) returns ReturnBox346

make_return_box346 := func(value: Str) returns ReturnBox346 {
    return ReturnBox346(value = value.clone())
}

apply_return_box346 := func(make: ReturnBoxMaker346, value: Str) returns ReturnBox346 {
    return make(value)
}

type_name_return346 := func(T: Type) returns Str {
    return dyn_type_to_str(T)
}

test_owned_aggregate_return_abi := test() {
    direct := make_return_box346("direct")
    assert_eq(Str, direct.value, "direct")

    make : ReturnBoxMaker346 = make_return_box346
    indirect := apply_return_box346(make, "indirect")
    assert_eq(Str, indirect.value, "indirect")

    assert_eq(Str, type_name_return346(I64), "I64")
}

OwnedBoxValueFn346 := func(own ReturnBox346) returns USize

consume_owned_box346 := func(own box: ReturnBox346) returns USize {
    return box.value.len()
}

apply_owned_box346 := func(f: OwnedBoxValueFn346, own box: ReturnBox346) returns USize {
    return f(own box)
}

test_owned_aggregate_parameter_abi := test() {
    direct := ReturnBox346(value = "direct")
    assert_eq(USize, consume_owned_box346(own direct), 6)
    indirect := ReturnBox346(value = "indirect")
    assert_eq(USize, apply_owned_box346(consume_owned_box346, own indirect), 8)
}

OwnedI64Fn := func(own I64) returns I64

consume_owned_i64 := func(own value: I64) returns I64 {
    return value.add(1)
}

apply_owned_i64 := func(f: OwnedI64Fn, own value: I64) returns I64 {
    return f(own value)
}

test_owned_primitive_parameter_abi := test() {
    assert_eq(I64, consume_owned_i64(own 6), 7)
    assert_eq(I64, apply_owned_i64(consume_owned_i64, own 8), 9)
}
