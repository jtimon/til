mode lib

link_c("library_namespace_b_link.c")

LibraryNamespaceBCallback := func(I64) returns I64

library_link_helper := ext_func(shallow value: I64) returns shallow I64 {}

library_namespace_b_value := func() returns I64 {
    values := array(I64, 20, 22)
    return values[0].clone() + values[1].clone()
}

library_namespace_b_link_value := func() returns I64 {
    return library_link_helper(22)
}

library_namespace_b_core_string := func() returns I64 {
    byte := Str.from_byte(98)
    text := "beta"
    view := Str.from_c_str(text.c_str)
    return byte.len().to_i64() + view.strip_suffix("ta").len().to_i64()
}

library_namespace_b_parse_u64 := func(value: Dynamic) returns U64 {
    return Str.from_c_str(value).to_u64()
}

library_namespace_b_parse_f64 := func(value: Dynamic, length: USize) returns F64 {
    return Str.from_c_str(value).substr(0, length).to_f64()
}

library_namespace_b_join_parts := func(parts: Vec(Str), separator: Str) returns Str {
    return join(parts, separator)
}

library_namespace_b_join_count := func(text: Dynamic, delim: Dynamic, separator: Dynamic) returns I64 {
    parts := Str.from_c_str(text).split(Str.from_c_str(delim))
    return join(parts, Str.from_c_str(separator)).len().to_i64()
}

library_namespace_b_append_part := func(mut parts: Vec(Str), value: Str) {
    parts.push(own value.clone())
}

library_namespace_b_consume_parts := func(own parts: Vec(Str)) returns USize {
    return parts.len()
}
