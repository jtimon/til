mode test

// Negative test (issue #54): storing a closure that BORROWS a captured local
// into a GLOBAL is the same escape as returning one -- the global outlives the
// call, so the captured stack slot dangles as soon as the function returns
// (ASAN reports stack-use-after-return). Rejected with the same fix advice:
// capture it `own` or `shallow` instead.

Thunk := func() returns I64
zero := func() returns I64 { return 0 }
mut g_slot : Thunk = zero

set_global := func() {
    local := 42
    g_slot = func() returns I64 [local] { return local }
}

// A block-local named like the global IS a local: storing the closure there
// is not an escape and must not be reported. The expected count in
// src/tests.til (2: set_global and set_global_after_shadow) pins that.
set_shadowing_local := func(go: Bool) returns I64 {
    local := 9
    mut r := 0
    if go {
        mut g_slot : Thunk = zero
        g_slot = func() returns I64 [local] { return local }
        r = g_slot()
    }
    return r
}

// A block-local shadow ends with its block: the assignment after it writes
// the global again, and is the same escape.
set_global_after_shadow := func(go: Bool) {
    local := 7
    if go {
        mut g_slot : Thunk = zero
        g_slot()
    }
    g_slot = func() returns I64 [local] { return local }
}

test_escape := test() {
    set_global()
    assert_eq(I64, g_slot(), 42)
}
