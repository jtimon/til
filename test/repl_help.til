mode cli

import("../src/std/sys")
import("../src/std/file")

// REPL smoke test for #157: pipe several turns into bin/til, capture stdout,
// and verify help(), expression output, and persisted declarations all work.
// Registered in the regular suite (src/tests.til, cli category) -- it used
// to be only the hand-run `make test_repl_help` target, which let the suite
// pass green while the REPL was broken. The Makefile target remains as a
// shortcut for running just this test.

count_matches := func(haystack: Str, needle: Str) returns I64 {
    if needle.is_empty() { return 0 }
    mut count := 0
    mut start : USize = 0
    while start.lte(haystack.len().sub(needle.len())) {
        pos := haystack.substr(start, haystack.len().sub(start)).find(needle)
        if pos.eq(-1) { return count }
        count++
        pos_u : USize = pos.to_usize()
        start = start.add(pos_u).add(needle.len())
    }
    return count
}

main := proc() {
    File.writefile("tmp/repl_help_input", "println(\"a\")\n1 + 1\nx := 7\nprintln(x.to_str())\n1 + missing\nhelp(\"println\")\nhelp(\"println\")\nhelp(\"Array__Dynamic.unsafe_get\")\n1 + 1\ny := 9\nhelp(\"y\")\nP := struct { px := 5 py := 7 }\np := P(px = 1, py = 2)\nprintln(format(\"ctor=\", p.px.to_str(), \",\", p.py.to_str()))\nq := P()\nprintln(format(\"defaults=\", q.px.to_str(), \",\", q.py.to_str()))\nq.px\nq.py = 31\nq.py\n1 +\n(1))\nprintln(\"survived syntax errors\")\nq.py\nv := Vec(I64).new()\nv.push(own 3)\nv.push(own 4)\nprintln(format(\"veclen=\", v.len().to_str()))\nprintln(format(\"vec0=\", v[0].to_str()))\ns := Str.clone(\"abc\")\nprintln(format(\"str=\", s))\nprintln(v[9].to_str())\npanic(\"boom\")\nprintln(\"survived panic\")\nprintln(format(\"veclen2=\", v.len().to_str(), \",str2=\", s))\nK := struct {\n    n : I64 = 0\nnamespace:\n    bump := func(mut self: K) {\n        self.n = self.n + 1\n    }\n}\nmut k := K()\nk.bump()\nk.bump()\nprintln(format(\"bump=\", k.n.to_str()))\n\n   \nprintln(format(\"blanks=\", k.n.to_str()))\nref cv : I64 = v.get(9)? catch (err: OutOfBounds) { println(\"caught oob\") }\nref cw : I64 = v.get(0)? catch (err: OutOfBounds) { println(\"unreachable\") }\nprintln(format(\"caught_then=\", cw.to_str()))\nbadimp := import(\"does/not/exist\")\nprintln(\"survived bad import\")\nsys := import(\"src/std/sys\")\nprintln(format(\"hostos=\", sys.host_os().len().gt(0).to_str()))\nsys.nonexistent()\nprintln(\"survived member typo\")\nsys\nprintln(\"survived alias echo\")\nformat(\"ec\", \"ho\")\ns.substr(1, 2)\n\"litecho\"\ns\nundefined_thing\nprintln(\"survived undefined\")\nprintln(format(\"still_here=\", x.to_str()))\n")
    // #332: redirected stdin/stdout keeps the in_read_line path -- same
    // prompts, same output, same EOF behavior, and NO history I/O. The
    // per-user state locations are pointed at tmp/ so that last part can
    // be asserted instead of assumed (and so a real ~/.local/state is
    // never touched by the suite).
    _clean := system_cmd("rm -rf tmp/repl_help_state tmp/repl_help_home")
    pid := spawn_cmd("XDG_STATE_HOME=tmp/repl_help_state HOME=tmp/repl_help_home bin/til < tmp/repl_help_input > tmp/repl_help_output 2>&1")
    _exit_code := wait_cmd(pid)

    output := File.readfile("tmp/repl_help_output")
    // A redirected REPL neither creates the state directory nor writes a
    // history file into it.
    mut no_history := 1
    if File.exists("tmp/repl_help_state") { no_history = 0 }
    if File.exists("tmp/repl_help_state/til/repl_history") { no_history = 0 }
    if File.exists("tmp/repl_help_home/.local/state/til/repl_history") { no_history = 0 }
    // ...and emits no terminal escapes: the editor's redraw vocabulary
    // starts with ESC [, which must not appear in a piped session.
    no_escapes := count_matches(output, format(Str.from_byte(27), "["))
    needle := "Print strings to stdout followed by a newline."
    n := count_matches(output, needle)
    bad := count_matches(output, "undefined symbol: println")
    missing := count_matches(output, "undefined symbol 'missing'")
    bad_y := count_matches(output, "undefined symbol: y")
    two := count_matches(output, "til[script]> 2\n")
    a := count_matches(output, "til[script]> a\n")
    seven := count_matches(output, "til[script]> 7\n")
    user_info := count_matches(output, "y is a I64")
    member_doc := count_matches(output, "Unchecked element access: ref to the element at index `i`")
    // A struct DECLARED in one turn, then instantiated with named arguments
    // in a later one. The delta path used to re-run the typer over the AST
    // body_pre_passes had already desugared, and the typer is not idempotent
    // over its own output: the ctor's NamedArg children were gone by then, so
    // this reported "struct instantiation requires named arguments" for code
    // that had just typed cleanly, and the struct itself went unregistered
    // ("undefined function 'P'"). Only REPL turns that skip the full load
    // reach that path, so a file compiled the same source fine.
    ctor := count_matches(output, "ctor=1,2")
    defaults := count_matches(output, "defaults=5,7")
    named_err := count_matches(output, "requires named arguments")
    undef_p := count_matches(output, "undefined function 'P'")
    // A bare field access is an EXPRESSION to echo, but til has no
    // bare-expression statement, so the REPL used to parse `q.px` unwrapped,
    // the parser demanded the `=` of a field assignment, and the panic took
    // the whole session down. `q.py = 31` must still parse as the assignment
    // it is -- echoing 5 then 31 proves both halves.
    field_echo := count_matches(output, "til[script]> 5\n")
    field_after_assign := count_matches(output, "til[script]> 31\n")
    // A syntax error used to END THE PROCESS: the parser reported malformed
    // input by panicking, so one typo threw away the whole session. It now
    // reports and unwinds like the typer always has. Both bad turns must be
    // reported, the session must reach the turn after them, and the binding
    // made before them must still be there.
    syntax_err := count_matches(output, "error: unexpected token")
    stray_close := count_matches(output, "error: expected statement, found ')'")
    survived := count_matches(output, "survived syntax errors")
    state_kept := count_matches(output, "til[script]> 31\n")
    // A binding holding heap data, mutated across turns. The asap pass ran
    // over each delta with the PERSISTENT program scope, so every accumulated
    // binding got a scope-end delete in a body that had not declared it: `v`
    // was destroyed at the end of every later turn (count reset, buffer
    // freed), the next push memcpy'd into freed memory, and the session died
    // on "corrupted size vs. prev_size in fastbins".
    veclen := count_matches(output, "veclen=2")
    vec0 := count_matches(output, "vec0=3")
    strval := count_matches(output, "str=abc")
    // The throw lowering PREPENDS `_err_kind` at the head of the body, with
    // the body's line, so the REPL's line-based slice skipped it and the
    // lowered `get` call was evaluated with an argument that was never
    // declared: "argument binding not found: _err_kind".
    oob := count_matches(output, "uncaught throw 'OutOfBounds'")
    err_kind_bug := count_matches(output, "argument binding not found")
    // panic/TODO/UNREACHABLE/assert all end in exit(1), which used to take the
    // whole process down: one bad turn threw away every binding the user had.
    panicked := count_matches(output, ": panic: boom")
    survived_panic := count_matches(output, "survived panic")
    state_after_panic := count_matches(output, "veclen2=2,str2=abc")
    // Multi-line input: a struct with a namespace block, typed the way it is
    // written in a file. Every line used to be submitted on its own, so the
    // first one was a syntax error and the rest landed as garbage statements.
    multiline := count_matches(output, "bump=2")
    // in_read_line returns "" for both an empty line and EOF, and the loop
    // treated "" as EOF, so pressing Enter ended the session.
    blanks := count_matches(output, "blanks=2")
    // The only line shape that expresses a catch at the prompt: the throwing
    // statement and its catch block together. repl_parse_allows_wrap did not
    // list Catch, so the line was wrapped as an expression and died on
    // "unexpected token 'ref'" inside the generated `(...).to_str()`.
    caught_oob := count_matches(output, "caught oob")
    caught_wrong := count_matches(output, "unreachable")
    caught_then := count_matches(output, "caught_then=3")
    // An import that cannot be resolved is user error -- a typo is enough --
    // but load_program panicked on it, so it ended the whole session.
    bad_import := count_matches(output, "could not find import 'does/not/exist.til'")
    survived_import := count_matches(output, "survived bad import")
    // Imports resolve against the importing FILE's directory, and the REPL's
    // file is its tmp/ scratch pad: `import("src/std/sys")` looked in
    // tmp/src/std/ and only `../src/std/sys` worked. The prompt resolves
    // against the user's cwd now, which is where the user thinks he is.
    cwd_import := count_matches(output, "hostos=true")
    // A member the alias does not export -- reachable by echoing the alias
    // itself, since the auto-echo wraps `sys` as `sys.to_str` -- panicked from
    // inside the alias-rewrite walk and took the session with it.
    ns_member := count_matches(output, "no public symbol 'nonexistent'")
    survived_ns := count_matches(output, "survived member typo")
    survived_alias := count_matches(output, "survived alias echo")
    // The auto-echo wraps as `(expr).to_str()`, which the typer rejects on a
    // value that is already a Str ("redundant self-conversion"). Every
    // Str-valued expression therefore printed NOTHING, and a bare literal hit
    // "unexpected statement type / this is a bug in the language". The wrap
    // retries with the value as-is now.
    echo_format := count_matches(output, "til[script]> echo\n")
    echo_substr := count_matches(output, "til[script]> bc\n")
    echo_literal := count_matches(output, "til[script]> litecho\n")
    echo_binding := count_matches(output, "til[script]> abc\n")
    lang_bug := count_matches(output, "this is a bug in the language")
    // repl_delta_from_source dropped parse's error count, so a syntax error
    // left a PARTIAL body that typed cleanly, the turn counted as a success,
    // and the line joined the accumulated source -- replayed by every later
    // full load, once per echo-ladder attempt, with nothing new ever running
    // again. Exactly one report, and the turns after it still work.
    poison := count_matches(output, "after identifier 'undefined_thing'")
    survived_poison := count_matches(output, "survived undefined")
    state_after_poison := count_matches(output, "still_here=7")
    if and(n.eq(2), bad.eq(0), missing.eq(1), bad_y.eq(0), two.eq(2),
           a.eq(1), seven.eq(1), user_info.eq(1), member_doc.eq(1),
           ctor.eq(1), defaults.eq(1), named_err.eq(0), undef_p.eq(0),
           field_echo.eq(1), syntax_err.eq(1), stray_close.eq(1),
           survived.eq(1), state_kept.eq(2), veclen.eq(1), vec0.eq(1),
           strval.eq(1), oob.eq(1), err_kind_bug.eq(0), panicked.eq(1),
           survived_panic.eq(1), state_after_panic.eq(1), multiline.eq(1),
           blanks.eq(1), caught_oob.eq(1), caught_wrong.eq(0),
           caught_then.eq(1), bad_import.eq(1), survived_import.eq(1),
           cwd_import.eq(1), ns_member.eq(1), survived_ns.eq(1),
           survived_alias.eq(1), echo_format.eq(1), echo_substr.eq(1),
           echo_literal.eq(1), echo_binding.eq(1), lang_bug.eq(0),
           poison.eq(1), survived_poison.eq(1), state_after_poison.eq(1),
           no_history.eq(1), no_escapes.eq(0)) {
        println("repl_help PASS")
        return
    }
    println("repl_help FAIL: doc matches=", n.to_str(), ", undefined matches=", bad.to_str(), ", missing matches=", missing.to_str(), ", undefined y matches=", bad_y.to_str(), ", expression matches=", two.to_str(), ", a matches=", a.to_str(), ", seven matches=", seven.to_str(), ", user info matches=", user_info.to_str(), ", member doc matches=", member_doc.to_str(), ", ctor matches=", ctor.to_str(), ", defaults matches=", defaults.to_str(), ", named-arg errors=", named_err.to_str(), ", undefined P=", undef_p.to_str(), ", field echo=", field_echo.to_str(), ", field after assign=", field_after_assign.to_str(), ", syntax errs=", syntax_err.to_str(), ", stray close=", stray_close.to_str(), ", survived=", survived.to_str(), ", state kept=", state_kept.to_str(), ", veclen=", veclen.to_str(), ", vec0=", vec0.to_str(), ", str=", strval.to_str(), ", oob=", oob.to_str(), ", err_kind bug=", err_kind_bug.to_str(), ", panicked=", panicked.to_str(), ", survived panic=", survived_panic.to_str(), ", state after panic=", state_after_panic.to_str(), ", multiline=", multiline.to_str(), ", blanks=", blanks.to_str(), ", caught oob=", caught_oob.to_str(), ", caught wrong=", caught_wrong.to_str(), ", caught then=", caught_then.to_str(), ", bad import=", bad_import.to_str(), ", survived import=", survived_import.to_str(), ", cwd import=", cwd_import.to_str(), ", ns member=", ns_member.to_str(), ", survived ns=", survived_ns.to_str(), ", survived alias=", survived_alias.to_str(), ", echo format=", echo_format.to_str(), ", echo substr=", echo_substr.to_str(), ", echo literal=", echo_literal.to_str(), ", echo binding=", echo_binding.to_str(), ", lang bug=", lang_bug.to_str(), ", poison=", poison.to_str(), ", survived poison=", survived_poison.to_str(), ", state after poison=", state_after_poison.to_str(), ", no history=", no_history.to_str(), ", escapes=", no_escapes.to_str())
    println("--- captured output ---")
    print(output)
    exit(1)
}
