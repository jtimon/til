mode lib

// Shared by the tests that load a library they just built by its name
// (link("-l...")): the place the loader looks, on every host.

import("../src/std/sys")
import("../src/std/file")

// Run `command` with the libraries in `dir` loadable by name:
// LD_LIBRARY_PATH on Linux, DYLD_LIBRARY_PATH on macOS, and on Windows the
// directory first on PATH, where Windows looks for a DLL loaded by name
// (CI run 3133: "libffi_lib_layout_probe.dll: The specified module could
// not be found"). A relative `dir` is the child's, as with the other two.
library_search_in := proc(command: Cmd, dir: Str) {
    command.env("LD_LIBRARY_PATH", dir)
    command.env("DYLD_LIBRARY_PATH", dir)
    if host_os() == "windows" {
        command.env("PATH", format(dir.replace("/", "\\"), ";", get_env("PATH")))
    }
}

// The AddressSanitizer runtime a Windows program built with --asan
// imports, llvm-mingw's libclang_rt.asan_dynamic-x86_64.dll, and the DLLs
// it imports in turn from the same directory: libc++, which imports
// libunwind. Windows resolves a DLL's imports from the program's directory
// and PATH, not from the importing DLL's directory (CI run 3217: with the
// runtime alone beside it, a host still failed with 0xC0000135).
WINDOWS_ASAN_DLLS := array(Str, "libclang_rt.asan_dynamic-x86_64.dll", "libc++.dll", "libunwind.dll")

// Copy those DLLs beside a program built with --asan that runs with an
// empty PATH, as such a test does the program's other DLLs. They come from
// the directory on this process's PATH that holds the runtime (the
// windows-x64-asan CI job puts it there).
copy_windows_asan_runtime := proc(dest_dir: Str) {
    mut found := ""
    for dir : Str in get_env("PATH").split(";") {
        if dir.len() == 0 { continue }
        if File.is_file(format(dir, "/", WINDOWS_ASAN_DLLS[0])) {
            found = dir.clone()
            break
        }
    }
    if found.len() == 0 { panic(WINDOWS_ASAN_DLLS[0], " is on no PATH directory: ", get_env("PATH")) }
    for name : Str in WINDOWS_ASAN_DLLS {
        if copy_file(format(found, "/", name), format(dest_dir, "/", name)) != 0 {
            panic("cannot copy ", found, "/", name, " to ", dest_dir)
        }
    }
}
