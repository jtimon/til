mode script

// Regression: an owned Dynamic declared from an erased-dynamic source (a
// deref() result bound by ref) must copy the POINTER WORD. The
// interpreter's clone path assumed every Dynamic binding is a boxed slot
// and deref'd the raw allocation itself, boxing a garbage word that the
// later free(own ...) then freed -- interpreter-only segfault; compiled
// mode copies the word and frees the real block.

slot : U8 = malloc(UPtr.size())
write_ptr(slot, malloc(4))
ref back : Dynamic = deref(slot)
recovered : Dynamic = back
free(own recovered)
free(own slot)
println("ok")

// #275: the same free-through-alias with the block NAMED. `b` binds the
// allocation ITSELF (a #302 raw alloc is its own datum), so after the
// alias frees it, interpreter teardown used to free it a second time --
// ASAN double-free, interpreted only. A raw allocation is the program's
// to free, exactly as in compiled mode.
slot2 : U8 = malloc(UPtr.size())
b : I8 = malloc(4)
write_ptr(slot2, b)
ref back2 : Dynamic = deref(slot2)
recovered2 : Dynamic = back2
free(own recovered2)
free(own slot2)
println("ok2")
