mode cli
Cell := struct { number: I64 = 0 }
borrow := func(cell: Cell) returns ref Cell { return cell }
CounterRef := struct { ref value: I64 }
increment := func(counter: CounterRef) {
    ref mut value: I64 = counter.value
    value++
}
forward := func(counter: CounterRef) { increment(counter) }
assign := func(counter: CounterRef, number: I64) {
    ref mut value: I64 = counter.value
    value = number
}
bad_indirect_scalar_write := func() {
    count: I64 = 0
    counter := CounterRef(value = count)
    increment(counter)
    forward(counter)
    assign(counter, 29)
}
main := proc() {
    mut first := Cell(number=1)
    mut second := Cell()
    second.number = 2
    ref mut alias : Cell = borrow(first)
    ref source : Cell = borrow(second)
    alias = source
    alias.number = 9
    println(first.number.to_str(), second.number.to_str())
}
