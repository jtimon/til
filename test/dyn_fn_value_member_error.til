mode script

// dyn_has_method answers no for a value member now, so the ordinary way in
// is closed -- but dyn_fn is callable directly, so the guard stays. The
// interpreter used to clone that member's slot as a callable, reading the
// VALUE as the box address (7 -> 0x7) and segfaulting; it now says what is
// wrong. See hb_func_def / ns_func_def in src/self/interpreter.til.
//
// Both backends must answer the same way here too: interpreted this is h_dyn_fn,
// compiled it is the emitted dispatcher's fallback (emit_dyn_fn_wrappers),
// which is built from FuncDef members only and so cannot tell an absent
// member from a value one -- hence the shared "no method" wording.
Widget := struct {
    x : I64 = 0

namespace:
    limit : I64 = 7
}

f : Dynamic = dyn_fn("Widget", "limit")
print("unreachable\n")
