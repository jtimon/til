mode cli

import("../gen/til/library_namespace_a")
import("../gen/til/library_namespace_b")

main := proc() returns I64 {
    if library_namespace_a_value() != 21 { return 1 }
    if library_namespace_b_value() != 42 { return 2 }
    values := library_namespace_a_values()
    if values.cap != 2 { return 3 }
    return 0
}
