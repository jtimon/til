mode test

// Calls can be typed before the interface's declaration is visited.
forward_interface_value := func(view: CounterContract) returns I64 { return view.value() }

// Issue #251: an interface is an abstract-class-like contract that desugars
// to a fieldless struct. A member is either ABSTRACT -- declared with
// a bodyless `func`/`proc` signature (or legacy `ext_func`/`ext_proc`), provided by
// conforming types -- or a CONCRETE default -- an ordinary `func`/`proc`
// with a real body, supplied by the interface itself. No fields, no
// `namespace:` marker. The rejection cases live in test/typer_errors.til.
// These tests pin down that interfaces compile end-to-end (interpret AND
// build) and that concrete defaults are callable.

// Collection: the get/len contract that `for ... in` relies on -- both
// abstract.
Collection := interface {
    get := func(self: Collection, i: U32) returns Dynamic
    len := ext_func(self: Collection) returns USize {}
}

// Drawable: an abstract method plus two concrete defaults. `label` ignores
// self; `describe` calls the abstract `self.draw()`, so once copied into an
// implementer (#268) it dispatches to that implementer's own draw.
Drawable := interface {
    draw := func(self: Drawable) returns Str
    label := func(_self: Drawable) returns Str { return "shape" }
    describe := func(self: Drawable) returns Str { return self.draw() }
}

// Circle conforms to Drawable: it provides the abstract `draw`. The typer
// verifies this at the struct definition; the interface's `self: Drawable`
// matches `self: Circle` by Self-substitution.
Circle := struct implements Drawable {
    r := 1
namespace:
    draw := func(_self: Circle) returns Str { return "circle" }
}

// An enum conforms to an interface exactly as a struct does: it carries
// methods in its namespace, so it provides the abstract `draw` there and the
// typer verifies it (Self-substitution maps `self: Drawable` to `self:
// Polygon`).
Polygon := enum implements Drawable {
    Tri,
    Quad,
namespace:
    draw := func(_self: Polygon) returns Str { return "polygon" }
}

// Labeled provides the abstract `draw` AND defines its own `label`, which
// overrides the interface default -- the copy must keep Labeled's version.
// It does not define `describe`, so it still inherits that default.
Labeled := struct implements Drawable {
    n := 0
namespace:
    draw := func(_self: Labeled) returns Str { return "labeled" }
    label := func(_self: Labeled) returns Str { return "custom" }
}

// Usable as a parameter type ...
collection_tag := func(_c: Collection) returns I64 {
    return 7
}

// ... and the value can be passed on through another call.
relay := func(c: Collection) returns I64 {
    return collection_tag(c)
}

drawable_tag := func(_d: Drawable) returns I64 {
    return 9
}

// #432: an interface has no values of its own (`Collection()` is a typer
// error, pinned in test/typer_errors.til); a value is always a boxed struct
// or enum that implements it.
Counted := struct implements Collection {
    n: U32 = 3
namespace:
    get := func(self: Counted, _i: U32) returns Dynamic { return to_ptr(self) }
    len := func(self: Counted) returns USize { return self.n.to_usize() }
}

test_interface_usable_as_param_type := test() {
    assert_eq(I64, collection_tag(Counted()), 7)
}

test_interface_value_passed_through := test() {
    assert_eq(I64, relay(Counted()), 7)
}

test_second_interface_type := test() {
    assert_eq(I64, drawable_tag(Circle(r = 1)), 9)
}

// A concrete default method is a real, callable implementation, reached
// through a boxed implementer that does not override it.
test_interface_concrete_default_method := test() {
    d: Drawable = Circle(r = 1)
    assert_eq(Str, d.label(), "shape")
}

// A conforming struct compiles and its provided method is callable.
test_implements_conformance := test() {
    c := Circle(r = 2)
    assert_eq(Str, c.draw(), "circle")
}

// A conforming enum compiles and its provided method is callable.
test_enum_implements_conformance := test() {
    p := Polygon.Tri
    assert_eq(Str, p.draw(), "polygon")
}

// #268: the interface's concrete default is copied into the implementer's
// namespace, so it is callable directly on the concrete value -- for both a
// struct and an enum.
test_struct_inherits_default := test() {
    c := Circle(r = 1)
    assert_eq(Str, c.label(), "shape")
}

test_enum_inherits_default := test() {
    p := Polygon.Quad
    assert_eq(Str, p.label(), "shape")
}

// #268: a default that calls an abstract method (`self.draw()`) dispatches to
// the implementer's own method, because Self was substituted on copy.
test_default_calls_self_method := test() {
    c := Circle(r = 1)
    assert_eq(Str, c.describe(), "circle")
    p := Polygon.Tri
    assert_eq(Str, p.describe(), "polygon")
}

// #268: a type that defines its own copy of a default method overrides it;
// methods it does not define are still inherited.
test_default_override := test() {
    l := Labeled(n = 1)
    assert_eq(Str, l.label(), "custom")
    assert_eq(Str, l.describe(), "labeled")
}

// #269: dynamic dispatch. An interface-typed parameter accepts any
// conforming value -- the typer boxes it with the concrete type's name --
// and an abstract-method call on it dispatches to the RUNTIME type's
// implementation via the dyn_call machinery, in both backends.
render := func(d: Drawable) returns Str {
    return d.draw()
}

test_dispatch_struct := test() {
    c := Circle(r = 1)
    assert_eq(Str, render(c), "circle")
    l := Labeled(n = 1)
    assert_eq(Str, render(l), "labeled")
}

test_dispatch_enum := test() {
    p := Polygon.Tri
    assert_eq(Str, render(p), "polygon")
}

// Defaults now dispatch to the concrete type's override or copied body.
// describe's inner self.draw() must still reach that type's implementation.
describe_of := func(d: Drawable) returns Str {
    return d.describe()
}

test_default_through_iface_dispatches := test() {
    c := Circle(r = 1)
    assert_eq(Str, describe_of(c), "circle")
}

// #251 follow-up: a conforming concrete bound to an interface-typed LOCAL
// (`d : Drawable = c`) boxes exactly like an interface-typed argument, and an
// abstract-method call on that local dispatches to the runtime type -- a
// struct (Circle) and an enum (Polygon). The binding owns a copy of the
// concrete; for an immutable source the copy is elided into a borrow (#432),
// which is sound because the source outlives the binding.
test_local_binding_dispatch := test() {
    c := Circle(r = 1)
    d : Drawable = c
    assert_eq(Str, d.draw(), "circle")
    p := Polygon.Tri
    pd : Drawable = p
    assert_eq(Str, pd.draw(), "polygon")
}

// #251 follow-up: a conforming concrete RETURNED where an interface is
// declared is boxed with OWNED semantics -- the box outlives the function,
// so iface_val is a heap deep-copy, not a borrow that would dangle. A fresh
// temporary (`return Circle(r=1)`), a struct, and an enum all box and then
// dispatch to the runtime type through the returned interface value.
make_drawable := func(which: Bool) returns Drawable {
    if which { return Circle(r = 1) }
    return Polygon.Tri
}

test_return_dispatch := test() {
    assert_eq(Str, make_drawable(true).draw(), "circle")
    assert_eq(Str, make_drawable(false).draw(), "polygon")
}

// The returned owned box also dispatches an inherited default whose body
// calls an abstract method (describe -> self.draw()); the box survives being
// bound to a local and freed at scope end.
test_return_default_dispatch := test() {
    d := make_drawable(true)
    assert_eq(Str, d.describe(), "circle")
}

// #251 follow-up: an interface-typed FIELD holds an owned box -- a conforming
// concrete given at construction is boxed (deep-copied) and dispatches to the
// runtime type. The holder's auto-gen clone/delete recurse into the box, so
// construct/use/destroy exercises the owned box's clone+free (ASAN-checked).
DrawHolder := struct {
    shape: Drawable
}

test_field_dispatch := test() {
    hc := DrawHolder(shape = Circle(r = 1))
    assert_eq(Str, hc.shape.draw(), "circle")
    hp := DrawHolder(shape = Polygon.Tri)
    assert_eq(Str, hp.shape.draw(), "polygon")
}

// A resource-owning implementer makes lifetime failures observable: drawing
// reads heap data as well as the concrete struct's storage.
CaptionShape := struct implements Drawable {
    text: Str
namespace:
    draw := func(self: CaptionShape) returns Str { return self.text.clone() }
}

make_text_drawable := func(mut calls: I64) returns CaptionShape {
    calls++
    return CaptionShape(text = format("temporary ", "factory"))
}

return_interface_temporary := func(mut calls: I64) returns Drawable {
    d: Drawable = make_text_drawable(calls)
    return d
}

return_interface_constructor := func() returns Drawable {
    d: Drawable = CaptionShape(text = format("temporary ", "constructor"))
    return d
}

return_interface_temporary_holder := func(mut calls: I64) returns DrawHolder {
    d: Drawable = make_text_drawable(calls)
    return DrawHolder(shape = d)
}

test_interface_temporary_lifetimes := test() {
    mut calls := 0
    local: Drawable = make_text_drawable(calls)
    assert_eq(Str, local.draw(), "temporary factory")
    escaped := return_interface_temporary(calls)
    assert_eq(Str, escaped.draw(), "temporary factory")
    ctor := return_interface_constructor()
    assert_eq(Str, ctor.draw(), "temporary constructor")
    holder := return_interface_temporary_holder(calls)
    assert_eq(Str, holder.shape.draw(), "temporary factory")
    assert_eq(I64, calls, 3)
}

// #432: an interface-typed local follows the plain aggregate rule. A bare
// binding owns an independent copy of a named concrete; `ref` borrows it.
// Copying a lent box into a value field copies the payload too, so a holder
// never aliases the caller's concrete.
borrow_interface_holder := func(d: Drawable) returns DrawHolder {
    return DrawHolder(shape = d)
}

test_interface_named_local_copy := test() {
    mut value := CaptionShape(text = format("before ", "change"))
    d: Drawable = value
    holder := borrow_interface_holder(d)
    value.text = format("after ", "change")
    assert_eq(Str, d.draw(), "before change")
    assert_eq(Str, holder.shape.draw(), "before change")
    assert_eq(Str, value.draw(), "after change")
}

test_interface_ref_local_aliases := test() {
    mut value := CaptionShape(text = format("before ", "alias"))
    ref view: Drawable = value
    value.text = format("after ", "alias")
    assert_eq(Str, view.draw(), "after alias")
    holder := borrow_interface_holder(view)
    value.text = format("final ", "alias")
    assert_eq(Str, view.draw(), "final alias")
    assert_eq(Str, holder.shape.draw(), "after alias")
}

// The copy of an IMMUTABLE local is elided -- no write and no lifetime can
// tell it from a borrow -- and materialized only where the binding leaves
// the frame: a return, a value field, an `own` argument. CloneProbe counts
// the copies that are actually made.
CloneProbe := struct implements Drawable {
    text: Str
namespace:
    mut clones := 0
    draw := func(self: CloneProbe) returns Str { return self.text.clone() }
    clone := func(self: CloneProbe) returns CloneProbe {
        CloneProbe.clones = CloneProbe.clones + 1
        return CloneProbe(text = self.text.clone())
    }
}

return_elided_copy := func() returns Drawable {
    source := CloneProbe(text = format("returned ", "copy"))
    d: Drawable = source
    return d
}

return_elided_copy_holder := func() returns DrawHolder {
    source := CloneProbe(text = format("holder ", "copy"))
    d: Drawable = source
    return DrawHolder(shape = d)
}

return_elided_copy_via_param := func() returns DrawHolder {
    source := CloneProbe(text = format("relayed ", "copy"))
    d: Drawable = source
    return borrow_interface_holder(d)
}

test_interface_elided_copy := test() {
    source := CloneProbe(text = format("elided ", "copy"))
    before := CloneProbe.clones
    d: Drawable = source
    assert_eq(Str, d.draw(), "elided copy")
    assert_eq(Str, d.describe(), "elided copy")
    assert_eq(I64, CloneProbe.clones, before)
    mut copied: Drawable = source
    assert_eq(I64, CloneProbe.clones, before + 1)
    assert_eq(Str, copied.draw(), "elided copy")
    copied = Polygon.Tri
    assert_eq(Str, copied.draw(), "polygon")
    assert_eq(Str, source.draw(), "elided copy")
    assert_eq(I64, CloneProbe.clones, before + 1)
}

test_interface_elided_copy_escapes := test() {
    before := CloneProbe.clones
    returned := return_elided_copy()
    assert_eq(Str, returned.draw(), "returned copy")
    assert_eq(I64, CloneProbe.clones, before + 1)
    holder := return_elided_copy_holder()
    assert_eq(Str, holder.shape.draw(), "holder copy")
    assert_eq(I64, CloneProbe.clones, before + 2)
    relayed := return_elided_copy_via_param()
    assert_eq(Str, relayed.shape.draw(), "relayed copy")
    assert_eq(I64, CloneProbe.clones, before + 3)
}

test_interface_elided_copy_owned_argument := test() {
    source := CloneProbe(text = format("deposited ", "copy"))
    view: Drawable = source
    before := CloneProbe.clones
    mut values := Vec(own Drawable).new()
    values.push(own view)
    assert_eq(I64, CloneProbe.clones, before + 1)
    assert_eq(Str, values[0].draw(), "deposited copy")
    assert_eq(Str, view.draw(), "deposited copy")
    if true {
        inner := CloneProbe(text = format("inner ", "copy"))
        inner_view: Drawable = inner
        values.push(own inner_view)
    }
    assert_eq(Str, values[1].draw(), "inner copy")
    assert_eq(I64, CloneProbe.clones, before + 2)
}

return_interface_enum_temporary := func() returns Drawable {
    d: Drawable = Polygon.Quad
    return d
}

test_interface_enum_temporary_lifetime := test() {
    d := return_interface_enum_temporary()
    assert_eq(Str, d.draw(), "polygon")
}

// Argument boxing must own fresh concrete values even when the callee lends
// its parameter: the returned box/holder can outlive the caller's temporary.
relay_drawable := func(d: Drawable) returns Drawable { return d }

make_argument_caption := func(mut calls: I64) returns CaptionShape {
    calls++
    return CaptionShape(text = format("argument ", calls.to_str()))
}

return_argument_factory := func(mut calls: I64) returns Drawable {
    return relay_drawable(make_argument_caption(calls))
}

return_argument_holder := func(mut calls: I64) returns DrawHolder {
    return borrow_interface_holder(make_argument_caption(calls))
}

return_argument_constructor := func(n: I64) returns Drawable {
    return relay_drawable(CaptionShape(text = format("constructor ", n.to_str())))
}

return_argument_constructor_holder := func(n: I64) returns DrawHolder {
    return borrow_interface_holder(CaptionShape(text = format("holder ", n.to_str())))
}

test_interface_argument_escapes := test() {
    mut calls := 0
    d := return_argument_factory(calls)
    h := return_argument_holder(calls)
    c := return_argument_constructor(3)
    ch := return_argument_constructor_holder(4)
    assert_eq(Str, d.draw(), "argument 1")
    assert_eq(Str, h.shape.draw(), "argument 2")
    assert_eq(Str, c.draw(), "constructor 3")
    assert_eq(Str, ch.shape.draw(), "holder 4")
    assert_eq(I64, calls, 2)
}

// A borrowed PARAMETER is a borrow of the box itself, not proof that its
// payload is borrowed. Copying it into an owned field must call box.clone().
return_existing_box_holder := func(mut calls: I64) returns DrawHolder {
    d: Drawable = make_argument_caption(calls)
    return borrow_interface_holder(d)
}

test_interface_argument_box_copy := test() {
    mut calls := 0
    h := return_existing_box_holder(calls)
    assert_eq(Str, h.shape.draw(), "argument 1")
    assert_eq(I64, calls, 1)
}

ArgumentRelay := struct {
namespace:
    wrap := func(d: Drawable) returns DrawHolder { return DrawHolder(shape = d) }
}

generic_argument_holder := func(T: Type, tag: T, d: Drawable) returns DrawHolder {
    assert_eq(T, tag, tag)
    return DrawHolder(shape = d)
}

return_namespace_argument := func(mut calls: I64) returns DrawHolder {
    return ArgumentRelay.wrap(make_argument_caption(calls))
}

return_generic_argument := func(mut calls: I64) returns DrawHolder {
    return generic_argument_holder(I64, 7, make_argument_caption(calls))
}

return_inferred_generic_argument := func(calls: I64) returns DrawHolder {
    return generic_argument_holder(7, CaptionShape(text = format("generic ", calls.to_str())))
}

// #434: a bounded type parameter is the STATIC form of an interface
// parameter: one copy of the function per concrete type, the bound checked
// at the call site, and `d.draw()` a direct call on the concrete -- no box,
// no dispatcher. `d: Drawable` (dynamic) and `T: Type implements Drawable,
// d: T` (static) coexist; the bare spelling keeps its dynamic meaning.
static_draw := func(T: Type implements Drawable, d: T) returns Str {
    return format(d.label(), ":", d.draw())
}

static_describe := func(T: Type implements Drawable, d: T) returns Str {
    return format(static_draw(d), "/", d.describe())
}

test_interface_bound_static_dispatch := test() {
    assert_eq(Str, static_draw(Circle(r = 1)), "shape:circle")
    assert_eq(Str, static_draw(Polygon.Tri), "shape:polygon")
    assert_eq(Str, static_draw(Labeled(n = 1)), "custom:labeled")
    c := Circle(r = 2)
    assert_eq(Str, static_draw(Circle, c), "shape:circle")
    assert_eq(Str, static_describe(c), "shape:circle/circle")
    assert_eq(Str, static_describe(Polygon.Quad), "shape:polygon/polygon")
    // The interface's own boxed value satisfies the bound; inside that copy
    // the calls dispatch on the box as for any `d: Drawable`.
    view: Drawable = Labeled(n = 2)
    assert_eq(Str, static_draw(view), "custom:labeled")
}

// #434: a struct or enum implements several interfaces: every one is
// checked in full, each one's defaults are copied in, a box of either
// interface can hold the value, and a two-interface bound is satisfiable.
// A default two implemented interfaces both provide is copied from neither:
// the implementer must override it (the rejection is in typer_errors).
Named := interface {
    name := ext_func(self: Named) returns Str {}
    greet := func(self: Named) returns Str { return format("hi ", self.name()) }
    label := func(_self: Named) returns Str { return "named" }
}

Badge := struct implements Drawable, Named {
    text: Str
namespace:
    draw := func(self: Badge) returns Str { return format("badge ", self.text) }
    name := func(self: Badge) returns Str { return self.text.clone() }
    label := func(_self: Badge) returns Str { return "badge" }
}

Mood := enum implements Named, Drawable {
    Happy,
namespace:
    draw := func(_self: Mood) returns Str { return "mood" }
    name := func(_self: Mood) returns Str { return "happy" }
    label := func(_self: Mood) returns Str { return "enum" }
}

both_sides := func(T: Type implements Drawable, Named, v: T) returns Str {
    return format(v.draw(), "/", v.greet(), "/", v.label(), "/", v.describe())
}

test_interface_multiple_implements := test() {
    b := Badge(text = format("b", "1"))
    assert_eq(Str, both_sides(b), "badge b1/hi b1/badge/badge b1")
    assert_eq(Str, both_sides(Mood.Happy), "mood/hi happy/enum/mood")
    assert_eq(Str, static_draw(b), "badge:badge b1")
    d: Drawable = b
    n: Named = b
    assert_eq(Str, d.describe(), "badge b1")
    assert_eq(Str, n.greet(), "hi b1")
    assert_eq(Str, render(Mood.Happy), "mood")
    mut names := Vec(own Named).new()
    names.push(own b)
    names.push(own Mood.Happy)
    assert_eq(Str, names[0].name(), "b1")
    assert_eq(Str, names[1].greet(), "hi happy")
}

test_interface_argument_call_paths := test() {
    mut calls := 0
    ns := return_namespace_argument(calls)
    explicit := return_generic_argument(calls)
    inferred := return_inferred_generic_argument(calls)
    assert_eq(Str, ns.shape.draw(), "argument 1")
    assert_eq(Str, explicit.shape.draw(), "argument 2")
    assert_eq(Str, inferred.shape.draw(), "generic 2")
    assert_eq(I64, calls, 2)
}

borrow_caption := func(value: CaptionShape) returns ref CaptionShape { return value }

// A named concrete passed to a borrowed parameter is lent, but leaving the
// callee by value -- a return, a value field -- copies its payload (#432).
test_interface_argument_copies_out := test() {
    mut value := CaptionShape(text = format("before ", "argument"))
    direct := relay_drawable(value)
    holder := borrow_interface_holder(borrow_caption(value))
    value.text = format("after ", "argument")
    assert_eq(Str, direct.draw(), "before argument")
    assert_eq(Str, holder.shape.draw(), "before argument")
    assert_eq(Str, value.draw(), "after argument")
}

CaptionChoice := enum implements Drawable {
    Text: Str,
namespace:
    draw := func(self: CaptionChoice) returns Str {
        switch self {
        case .Text(text): return text.clone()
        }
    }
}

return_enum_argument := func(n: I64) returns DrawHolder {
    return borrow_interface_holder(CaptionChoice.Text(format("enum ", n.to_str())))
}

test_interface_argument_enum_payload := test() {
    holder := return_enum_argument(5)
    assert_eq(Str, holder.shape.draw(), "enum 5")
}

// An enum concrete follows the same local rule as a struct (#432).
test_interface_enum_local_copy := test() {
    choice := CaptionChoice.Text(format("enum ", "source"))
    view: Drawable = choice
    assert_eq(Str, view.draw(), "enum source")
    mut copied: Drawable = choice
    assert_eq(Str, copied.draw(), "enum source")
    copied = Polygon.Quad
    assert_eq(Str, copied.draw(), "polygon")
    assert_eq(Str, choice.draw(), "enum source")
    mut values := Vec(own Drawable).new()
    values.push(own view)
    assert_eq(Str, values[0].draw(), "enum source")
    assert_eq(Str, view.draw(), "enum source")
}

borrow_drawable := func(value: Drawable) returns ref Drawable { return value }

test_interface_reassignment := test() {
    mut calls := 0
    mut d: Drawable = make_argument_caption(calls)
    assert_eq(Str, d.draw(), "argument 1")
    d = CaptionChoice.Text(format("replacement ", calls.to_str()))
    assert_eq(Str, d.draw(), "replacement 1")
    d = make_argument_caption(calls)
    assert_eq(Str, d.draw(), "argument 2")
    d = d
    assert_eq(Str, d.draw(), "argument 2")
    saved := d.clone()
    d = CaptionShape(text = format("constructor ", calls.to_str()))
    assert_eq(Str, saved.draw(), "argument 2")
    assert_eq(Str, d.draw(), "constructor 2")
    mut source := CaptionShape(text = format("before ", "assignment"))
    d = source
    source.text = format("after ", "assignment")
    assert_eq(Str, d.draw(), "before assignment")
    assert_eq(Str, source.draw(), "after assignment")
    assert_eq(I64, calls, 2)
}

return_reassigned_holder := func(n: I64) returns DrawHolder {
    mut holder := DrawHolder(shape = Circle(r = 1))
    source := CaptionShape(text = format("field ", n.to_str()))
    holder.shape = source
    return holder
}

test_interface_field_reassignment := test() {
    mut holder := return_reassigned_holder(3)
    assert_eq(Str, holder.shape.draw(), "field 3")
    holder.shape = CaptionChoice.Text(format("new ", "field"))
    assert_eq(Str, holder.shape.draw(), "new field")
    holder.shape = holder.shape
    assert_eq(Str, holder.shape.draw(), "new field")
    owned := return_argument_constructor(4)
    holder.shape = borrow_drawable(owned)
    assert_eq(Str, holder.shape.draw(), "constructor 4")
    assert_eq(Str, owned.draw(), "constructor 4")
}

make_interface_collection := func(n: I64) returns Vec(own Drawable) {
    mut values := Vec(own Drawable).new()
    source := CaptionShape(text = format("named ", n.to_str()))
    values.push(own source)
    values.push(own CaptionChoice.Text(format("enum ", n.to_str())))
    box: Drawable = CaptionShape(text = format("boxed ", n.to_str()))
    values.push(own box)
    return values
}

test_interface_collection_lifetimes := test() {
    mut values := make_interface_collection(5)
    assert_eq(Str, values[0].draw(), "named 5")
    assert_eq(Str, values[1].draw(), "enum 5")
    mut count := 0
    for value in values {
        assert_eq(Str, value.label(), "shape")
        count++
    }
    assert_eq(I64, count, 3)
    copies := values.clone()
    popped := values.pop()
    values.clear()
    assert_eq(Str, popped.draw(), "boxed 5")
    assert_eq(Str, copies[0].draw(), "named 5")
    assert_eq(Str, copies[1].draw(), "enum 5")
    assert_eq(Str, copies[2].draw(), "boxed 5")
}

// A deposited box owns its payload: a collection never aliases a local (#432).
test_interface_collection_copies := test() {
    mut source := CaptionShape(text = format("deposited ", "before"))
    view: Drawable = source
    mut values := Vec(own Drawable).new()
    values.push(own view)
    source.text = format("deposited ", "after")
    assert_eq(Str, values[0].draw(), "deposited before")
    popped := values.pop()
    assert_eq(Str, popped.draw(), "deposited before")
    assert_eq(Str, source.draw(), "deposited after")
}

// Count destruction of the OLD payload independently of any new temporary
// or clone. Each replacement must add exactly one old-payload destruction.
StorageProbe := struct implements Drawable {
    id: I64
namespace:
    mut old_drops := 0
    draw := func(self: StorageProbe) returns Str { return self.id.to_str() }
    delete := func(own self: StorageProbe, call_free: Bool = true) {
        if self.id == 1 { StorageProbe.old_drops = StorageProbe.old_drops + 1 }
        if call_free { free(own self) }
    }
}

test_interface_replacement_destruction := test() {
    mut d: Drawable = StorageProbe(id = 1)
    assert_eq(Str, d.draw(), "1")
    before_local := StorageProbe.old_drops
    d = StorageProbe(id = 2)
    assert_eq(I64, StorageProbe.old_drops, before_local + 1)
    assert_eq(Str, d.draw(), "2")

    mut outer: Drawable = StorageProbe(id = 1)
    assert_eq(Str, outer.draw(), "1")
    before_outer := StorageProbe.old_drops
    if true { outer = StorageProbe(id = 2) }
    assert_eq(I64, StorageProbe.old_drops, before_outer + 1)
    assert_eq(Str, outer.draw(), "2")

    mut holder := DrawHolder(shape = StorageProbe(id = 1))
    assert_eq(Str, holder.shape.draw(), "1")
    before_field := StorageProbe.old_drops
    holder.shape = StorageProbe(id = 2)
    assert_eq(I64, StorageProbe.old_drops, before_field + 1)
    assert_eq(Str, holder.shape.draw(), "2")

    mut array := Array(own Drawable).new(1)
    array.set(0, own StorageProbe(id = 1))!
    assert_eq(Str, array[0].draw(), "1")
    before_array := StorageProbe.old_drops
    array.set(0, own StorageProbe(id = 2))!
    assert_eq(I64, StorageProbe.old_drops, before_array + 1)
    assert_eq(Str, array[0].draw(), "2")

    mut map := Map(Str, own Drawable).new()
    map.set("item", own StorageProbe(id = 1))
    assert_eq(Str, map["item"].draw(), "1")
    before_map := StorageProbe.old_drops
    map.set("item", own StorageProbe(id = 2))
    assert_eq(I64, StorageProbe.old_drops, before_map + 1)
    assert_eq(Str, map["item"].draw(), "2")
}

// Full contracts retain ownership/mutability and borrowed returns. Exercise
// the concrete methods here as well as conformance: higher-arity/own-argument
// dynamic dispatch is a separate lowering contract.
FullContract := interface {
    read := ext_func(self: FullContract) returns Str {}
    add := func(mut self: FullContract, n: I64) returns I64
    take := ext_func(self: FullContract, own text: Str) returns Str {}
    borrow := func(self: FullContract) returns ref Str
    announce := proc(self: FullContract)
    consume := func(own self: FullContract) returns Str
    take_number := ext_func(self: FullContract, own n: I64) returns I64 {}
    label := func(self: FullContract) returns Str { return self.read() }
}

ContractValue := struct implements FullContract {
    text: Str
    n := 0
namespace:
    read := func(self: ContractValue) returns Str { return self.text.clone() }
    add := func(mut self: ContractValue, n: I64) returns I64 {
        self.n = self.n + n
        return self.n
    }
    take := func(_self: ContractValue, own text: Str) returns Str { return text }
    borrow := func(self: ContractValue) returns ref Str { return self.text }
    announce := proc(_self: ContractValue) { print("") }
    consume := func(own self: ContractValue) returns Str { return self.text.clone() }
    take_number := func(_self: ContractValue, own n: I64) returns I64 { return n }
    label := func(self: ContractValue) returns Str { return format("override ", self.text) }
}

test_interface_full_contract := test() {
    mut value := ContractValue(text = "contract")
    assert_eq(I64, value.add(3), 3)
    assert_eq(Str, value.take(own "owned"), "owned")
    ref text: Str = value.borrow()
    assert_eq(Str, text, "contract")
    assert_eq(Str, value.label(), "override contract")
    value.announce()
}

// The implementation precedes its interface. Aliases and auto-shallow Self,
// scalar returns, and inherited defaults must not depend on inference order.
ContractCount := I64
CounterValue := struct implements CounterContract {
    n: ContractCount = 7
namespace:
    value := func(self: CounterValue) returns ContractCount { return self.n }
    copy := func(self: CounterValue) returns CounterValue { return self.clone() }
    consume := func(own self: CounterValue) returns ContractCount { return self.n }
    count := func(_self: CounterValue, items: ..Str) returns USize { return items.len() }
    same := func(self: CounterValue, other: CounterValue) returns Bool { return self.n == other.n }
    merge := func(self: CounterValue, own other: CounterValue) returns I64 { return self.n + other.n }
}

CounterContract := interface {
    value := func(self: CounterContract) returns I64
    copy := ext_func(self: CounterContract) returns CounterContract {}
    consume := ext_func(own self: CounterContract) returns I64 {}
    count := func(self: CounterContract, items: ..Str) returns USize
    same := ext_func(self: CounterContract, other: CounterContract) returns Bool {}
    merge := ext_func(self: CounterContract, own other: CounterContract) returns I64 {}
    twice := func(self: CounterContract) returns I64 { return self.value() * 2 }
}

test_interface_normalized_contract := test() {
    value := CounterValue()
    copied := value.copy()
    assert_eq(I64, copied.value(), 7)
    assert_eq(I64, value.twice(), 14)
    assert_eq(USize, value.count("a", "b"), 2)
    assert_eq(I64, CounterValue.consume(own copied), 7)
}

ConsumeContract := interface {
    take := ext_func(self: ConsumeContract, own text: Str) returns Str {}
}
ContractEnum := enum implements ConsumeContract {
    Value,
namespace:
    take := func(_self: ContractEnum, own text: Str) returns Str { return text }
}

test_interface_enum_owned_contract := test() {
    value := ContractEnum.Value
    assert_eq(Str, value.take(own "enum contract"), "enum contract")
}

ContractFailure := struct {}
FallibleContract := interface {
    value := func(self: FallibleContract) returns I64 throws ContractFailure
}
FallibleValue := struct implements FallibleContract {
    n := 0
namespace:
    value := func(self: FallibleValue) returns I64 throws ContractFailure {
        if self.n == 0 { throw ContractFailure() }
        return self.n
    }
}

test_interface_throw_contract := test() {
    value := FallibleValue(n = 9)
    assert_eq(I64, value.value()!, 9)
}

make_full_contract := func(mut calls: I64) returns FullContract {
    calls++
    return ContractValue(text = format("receiver ", calls.to_str()))
}
make_dispatch_argument := func(mut calls: I64) returns Str {
    calls++
    return format("argument ", calls.to_str())
}

test_interface_dispatch_once_and_owned_args := test() {
    mut calls := 0
    assert_eq(Str, make_full_contract(calls).read(), "receiver 1")
    assert_eq(I64, calls, 1)
    assert_eq(Str, make_full_contract(calls).take(own make_dispatch_argument(calls)), "argument 3")
    assert_eq(I64, calls, 3)
    view := make_full_contract(calls)
    number := 17
    assert_eq(I64, view.take_number(own number), 17)
}

dispatch_announce := proc(view: FullContract) { view.announce() }

test_interface_dispatch_mut_and_ref := test() {
    mut value := ContractValue(text = "borrowed", n = 1)
    ref mut view: FullContract = value
    assert_eq(I64, view.add(4), 5)
    assert_eq(I64, value.n, 5)
    ref text: Str = view.borrow()
    assert_eq(Str, text, "borrowed")
    dispatch_announce(view)
    mut copy: FullContract = value
    assert_eq(I64, copy.add(1), 6)
    assert_eq(I64, value.n, 5)
}

Finishable := interface {
    finish := ext_func(own self: Finishable) returns I64 {}
}
FinishValue := struct implements Finishable {
    n: I64
namespace:
    mut drops := 0
    finish := func(own self: FinishValue) returns I64 { return self.n }
    delete := func(own self: FinishValue, call_free: Bool = true) {
        FinishValue.drops = FinishValue.drops + 1
        if call_free { free(own self) }
    }
}

FinishChoice := enum implements Finishable {
    Value: I64,
namespace:
    finish := func(own self: FinishChoice) returns I64 {
        switch self {
        case .Value(n): return n
        }
    }
}

test_interface_dispatch_owned_self := test() {
    owned: Finishable = FinishValue(n = 5)
    before_owned := FinishValue.drops
    assert_eq(I64, Finishable.finish(own owned), 5)
    assert_eq(I64, FinishValue.drops, before_owned + 1)
    source := FinishValue(n = 7)
    borrowed: Finishable = source
    before_borrowed := FinishValue.drops
    assert_eq(I64, Finishable.finish(own borrowed), 7)
    assert_eq(I64, FinishValue.drops, before_borrowed + 1)
    assert_eq(I64, source.n, 7)
    choice: Finishable = FinishChoice.Value(11)
    assert_eq(I64, Finishable.finish(own choice), 11)
}

test_interface_dispatch_self_values := test() {
    view: CounterContract = CounterValue(n = 7)
    copy := view.copy()
    assert_eq(I64, forward_interface_value(view), 7)
    assert_eq(I64, copy.value(), 7)
    assert(view.same(copy))
    assert_eq(I64, view.merge(own copy), 14)
    assert_eq(USize, view.count("a", "b"), 2)
    assert_eq(I64, CounterContract.consume(own view), 7)
}

dispatch_fallible := func(view: FallibleContract) returns I64 throws ContractFailure {
    return view.value()?
}

test_interface_dispatch_throws := test() {
    good := FallibleValue(n = 9)
    bad := FallibleValue(n = 0)
    assert_eq(I64, dispatch_fallible(good)!, 9)
    mut caught := false
    dispatch_fallible(bad)?
    catch (err: ContractFailure) { caught = err.eq(ContractFailure()) }
    assert(caught)
}

DispatchFailure := struct { message := "" }
CheckedBorrow := interface {
    get := ext_func(self: CheckedBorrow) returns ref Str throws DispatchFailure {}
}
CheckedValue := struct implements CheckedBorrow {
    text: Str
namespace:
    get := func(self: CheckedValue) returns ref Str throws DispatchFailure {
        if self.text.len() == 0 { throw DispatchFailure(message = "empty") }
        return self.text
    }
}

test_interface_dispatch_ref_throws := test() {
    good: CheckedBorrow = CheckedValue(text = "checked")
    ref text: Str = good.get()!
    assert_eq(Str, text, "checked")
    bad: CheckedBorrow = CheckedValue(text = "")
    mut message := ""
    bad.get()?
    catch (err: DispatchFailure) { message = err.message }
    assert_eq(Str, message, "empty")
}

DefaultFlow := interface {
    label := func(_self: DefaultFlow) returns Str { return "default" }
    indirect := func(_self: DefaultFlow) returns Str { return "indirect default" }
    nested := func(self: DefaultFlow) returns Str { return self.label() }
    take := func(_self: DefaultFlow, own text: Str) returns Str { return text }
    finish := func(own self: DefaultFlow) returns Str { return self.label() }
    copy := func(self: DefaultFlow) returns DefaultFlow { return self.clone() }
    len := func(_self: DefaultFlow) returns USize { return 1 }
    combine := func(_self: DefaultFlow, a: I64, b: I64) returns I64 { return a + b }
    constant := func() returns I64 { return 9 }
}
PlainFlow := struct implements DefaultFlow {
    n := 1
namespace:
    mut drops := 0
    delete := func(own self: PlainFlow, call_free: Bool = true) {
        PlainFlow.drops = PlainFlow.drops + 1
        if call_free { free(own self) }
    }
}
OverrideFlow := struct implements DefaultFlow {
    n := 2
namespace:
    mut labels := 0
    label := func(_self: OverrideFlow) returns Str {
        OverrideFlow.labels = OverrideFlow.labels + 1
        return "override"
    }
    indirect := func(self: OverrideFlow) returns Str { return format("indirect ", self.label()) }
    take := func(_self: OverrideFlow, own text: Str) returns Str { return format("override ", text) }
    len := func(_self: OverrideFlow) returns USize { return 2 }
    combine := func(_self: OverrideFlow, a: I64, b: I64) returns I64 { return a * b }
}
EnumFlow := enum implements DefaultFlow {
    Value,
namespace:
    label := func(_self: EnumFlow) returns Str { return "enum" }
}

runtime_default_len := func(view: DefaultFlow) returns USize { return view.len() }

test_interface_default_virtual_selection := test() {
    plain: DefaultFlow = PlainFlow()
    changed: DefaultFlow = OverrideFlow()
    choice: DefaultFlow = EnumFlow.Value
    assert_eq(Str, plain.label(), "default")
    assert_eq(Str, changed.label(), "override")
    assert_eq(Str, choice.label(), "enum")
    assert_eq(Str, changed.nested(), "override")
    assert_eq(Str, choice.nested(), "enum")
    assert_eq(USize, runtime_default_len(plain), 1)
    assert_eq(USize, runtime_default_len(changed), 2)
    assert_eq(I64, plain.combine(3, 4), 7)
    assert_eq(I64, changed.combine(3, 4), 12)
    assert_eq(I64, DefaultFlow.constant(), 9)
}

test_interface_default_owned_results := test() {
    plain: DefaultFlow = PlainFlow()
    changed: DefaultFlow = OverrideFlow()
    choice: DefaultFlow = EnumFlow.Value
    second: DefaultFlow = PlainFlow(n = 5)
    plain_copy := plain.copy()
    changed_copy := changed.copy()
    choice_copy := choice.copy()
    assert_eq(Str, plain_copy.label(), "default")
    assert_eq(Str, changed_copy.label(), "override")
    assert_eq(Str, choice_copy.label(), "enum")
    before := PlainFlow.drops
    assert_eq(Str, DefaultFlow.finish(own plain_copy), "default")
    assert_eq(I64, PlainFlow.drops, before + 1)
    assert_eq(Str, plain.label(), "default")
    assert_eq(Str, DefaultFlow.finish(own changed_copy), "override")
    assert_eq(Str, DefaultFlow.finish(own choice_copy), "enum")
    mut calls := 0
    assert_eq(Str, plain.take(own make_dispatch_argument(calls)), "argument 1")
    assert_eq(Str, changed.take(own make_dispatch_argument(calls)), "override argument 2")
    assert_eq(Str, second.take(own make_dispatch_argument(calls)), "argument 3")
    second_copy := second.copy()
    assert_eq(Str, DefaultFlow.finish(own second_copy), "default")
    assert_eq(Str, DefaultFlow.finish(own second), "default")
    assert_eq(Str, DefaultFlow.finish(own plain), "default")
    assert_eq(I64, PlainFlow.drops, before + 4)
    assert_eq(Str, DefaultFlow.finish(own changed), "override")
    assert_eq(Str, DefaultFlow.finish(own choice), "enum")
    assert_eq(I64, calls, 3)
}

DefaultLabel := func(DefaultFlow) returns Str
DefaultCallbacks := struct { label: DefaultLabel }
make_default_flow := func(mut calls: I64) returns DefaultFlow {
    calls++
    return OverrideFlow(n = calls)
}

test_interface_default_callable_once := test() {
    mut calls := 0
    before_labels := OverrideFlow.labels
    assert_eq(Str, make_default_flow(calls).nested(), "override")
    assert_eq(I64, calls, 1)
    assert_eq(I64, OverrideFlow.labels, before_labels + 1)
    callbacks := DefaultCallbacks(label = dyn_fn("DefaultFlow", "indirect"))
    view := make_default_flow(calls)
    assert_eq(Str, callbacks.label(view), "indirect override")
    plain_view: DefaultFlow = PlainFlow()
    assert_eq(Str, callbacks.label(plain_view), "indirect default")
    assert_eq(I64, calls, 2)
    assert_eq(I64, OverrideFlow.labels, before_labels + 2)
}

test_interface_local_dyn_fn := test() {
    label: DefaultLabel = dyn_fn("DefaultFlow", "indirect")
    view: DefaultFlow = OverrideFlow()
    assert_eq(Str, label(view), "indirect override")
    plain_view: DefaultFlow = PlainFlow()
    assert_eq(Str, label(plain_view), "indirect default")
}

DefaultNumberCell := struct { n := 3 }
default_number_cell := DefaultNumberCell()
DefaultBorrow := interface {
    get := func(_self: DefaultBorrow, own _text: Str) returns ref I64 { return default_number_cell.n }
}
BorrowFlow := struct implements DefaultBorrow {
    n := 7
namespace:
    get := func(self: BorrowFlow, own _text: Str) returns ref I64 { return self.n }
}
// Inherits the default: its borrowed result is the global cell.
InheritedBorrowFlow := struct implements DefaultBorrow {
    n := 0
}

test_interface_default_ref_override := test() {
    mut view: DefaultBorrow = BorrowFlow()
    ref mut number: I64 = view.get(own "unused")
    number++
    assert_eq(I64, view.get(own "unused"), 8)
    assert_eq(I64, default_number_cell.n, 3)
    inherited: DefaultBorrow = InheritedBorrowFlow()
    ref base: I64 = inherited.get(own "unused")
    assert_eq(I64, base, 3)
}

MultiContract := interface {
    combine := func(self: MultiContract, a: I64 = 2, b: I64 = 3) returns I64
    take := func(mut self: MultiContract, own left: Str, mut count: I64, own right: Str) returns Str
    checked := func(self: MultiContract, a: I64, b: I64) returns I64 throws DispatchFailure
}
MultiValue := struct implements MultiContract {
    n := 0
namespace:
    combine := func(self: MultiValue, a: I64 = 20, b: I64 = 30) returns I64 { return self.n + a * 10 + b }
    take := func(mut self: MultiValue, own left: Str, mut count: I64, own right: Str) returns Str {
        self.n = self.n + 1
        count = count + self.n
        return format(left, "/", right)
    }
    checked := func(self: MultiValue, a: I64, b: I64) returns I64 throws DispatchFailure {
        if b == 0 { throw DispatchFailure(message = format("zero after ", a.to_str())) }
        return self.n + a / b
    }
}

test_interface_multi_defaults := test() {
    view: MultiContract = MultiValue(n = 1)
    assert_eq(I64, view.combine(4, 5), 46)
    assert_eq(I64, view.combine(), 24)
    assert_eq(I64, view.combine(4), 44)
    assert_eq(I64, view.combine(b = 7, a = 6), 68)
    assert_eq(I64, view.combine(b = 7), 28)
}

make_multi_contract := func(mut calls: I64) returns MultiContract {
    calls++
    return MultiValue(n = calls)
}

test_interface_multi_owned_mut_and_order := test() {
    mut calls := 0
    mut count := 0
    assert_eq(Str, make_multi_contract(calls).take(own make_dispatch_argument(calls), count,
        own make_dispatch_argument(calls)), "argument 2/argument 3")
    assert_eq(I64, calls, 3)
    assert_eq(I64, count, 2)
    mut source := MultiValue(n = 4)
    ref mut view: MultiContract = source
    left := format("owned ", "left")
    right := format("owned ", "right")
    assert_eq(Str, view.take(own left, count, own right), "owned left/owned right")
    assert_eq(I64, source.n, 5)
    assert_eq(I64, count, 7)
}

dispatch_multi_checked := func(view: MultiContract, a: I64, b: I64) returns I64 throws DispatchFailure {
    return view.checked(a, b)?
}

test_interface_multi_throws := test() {
    view: MultiContract = MultiValue(n = 2)
    assert_eq(I64, dispatch_multi_checked(view, 12, 3)!, 6)
    mut message := ""
    dispatch_multi_checked(view, 7, 0)?
    catch (err: DispatchFailure) { message = err.message }
    assert_eq(Str, message, "zero after 7")
}

MultiEnumContract := interface {
    combine := ext_func(self: MultiEnumContract, a: I64, b: I64, c: I64) returns I64 {}
}
MultiChoice := enum implements MultiEnumContract {
    Value: I64,
namespace:
    combine := func(self: MultiChoice, a: I64, b: I64, c: I64) returns I64 {
        switch self {
        case .Value(n): return n + a * 100 + b * 10 + c
        }
    }
}

test_interface_multi_enum := test() {
    view: MultiEnumContract = MultiChoice.Value(4)
    assert_eq(I64, view.combine(1, 2, 3), 127)
}

// Both interfaces deliberately follow their implementer. Shared requirements
// are not ambiguous defaults; one implementation satisfies both contracts.
SignatureValue := struct implements RequiredValue, OtherRequiredValue {
    n := 7
namespace:
    value := func(self: SignatureValue) returns I64 { return self.n }
}
RequiredValue := interface {
    value := func(self: RequiredValue) returns I64
    // An explicit empty body is a real, inheritable default.
    nothing := func(_self: RequiredValue) {}
}
OtherRequiredValue := interface {
    value := func(self: OtherRequiredValue) returns I64
}
DefaultValue := interface {
    value := func(_self: DefaultValue) returns I64 { return 11 }
}
InheritedRequirement := struct implements RequiredValue, DefaultValue {}

read_required := func(T: Type implements RequiredValue, OtherRequiredValue, value: T) returns I64 {
    return value.value()
}

test_interface_signature_requirements := test() {
    value := SignatureValue()
    assert_eq(I64, read_required(value), 7)
    first: RequiredValue = value
    second: OtherRequiredValue = value
    assert_eq(I64, first.value(), 7)
    assert_eq(I64, second.value(), 7)
    first.nothing()
    inherited: RequiredValue = InheritedRequirement()
    assert_eq(I64, inherited.value(), 11)
    inherited.nothing()
}

NestedSlot := macro(T: Type, N: USize) returns StructDef {
    return struct {
        item: T
        count: USize = N
    }
}
NestedVectorAlias := Vec(own Nested_Copies)
NestedOptionAlias := Option(own Nested_Copies)
NestedSlotAlias := NestedSlot(own Nested_Copies, 2)
Nested_Copies := interface {
    value := func(self: Nested_Copies) returns I64
    copies := func(self: Nested_Copies) returns NestedVectorAlias {
        mut result: NestedVectorAlias = Vec(own Nested_Copies).new()
        result.push(own self.clone())
        return result
    }
    optional := func(self: Nested_Copies) returns NestedOptionAlias {
        return Option(own Nested_Copies).Some(own self.clone())
    }
    nested := func(self: Nested_Copies) returns Option(NestedVectorAlias) {
        return Option(Vec(own Nested_Copies)).Some(own self.copies())
    }
    borrowed := func(self: Nested_Copies) returns Option(ref Nested_Copies) {
        return Option(ref Nested_Copies).Some(self)
    }
    slot := func(self: Nested_Copies) returns NestedSlotAlias {
        return NestedSlot(own Nested_Copies, 2)(item = self.clone())
    }
    first := func(_self: Nested_Copies, items: NestedVectorAlias) returns I64 { return items[0].value() }
    type_name := func(_self: Nested_Copies) returns Str { return dyn_type_to_str(Nested_Copies) }
    copied_value := func(self: Nested_Copies) returns I64 {
        values := self.copies()
        return values[0].value()
    }
}
NestedRecord := struct implements Nested_Copies {
    n := 7
namespace:
    value := func(self: NestedRecord) returns I64 { return self.n }
}
NestedChoice := enum implements Nested_Copies {
    Value: I64,
namespace:
    value := func(self: NestedChoice) returns I64 {
        switch self { case .Value(n): return n }
    }
}
read_nested_record := func(value: NestedRecord) returns I64 { return value.n }
read_nested_choice := func(value: NestedChoice) returns I64 { return value.value() }
bounded_nested := func(T: Type implements Nested_Copies, value: T) returns I64 {
    values := value.copies()
    return value.first(values)
}

test_interface_nested_default_types := test() {
    record := NestedRecord()
    records := record.copies()
    assert_eq(I64, read_nested_record(records[0]), 7)
    assert_eq(I64, read_nested_record(record.optional().unwrap()), 7)
    nested_records := record.nested().unwrap()
    assert_eq(I64, read_nested_record(nested_records[0]), 7)
    assert_eq(I64, read_nested_record(record.borrowed().unwrap()), 7)
    slot := record.slot()
    assert_eq(I64, read_nested_record(slot.item), 7)
    assert_eq(USize, slot.count, 2)
    assert_eq(I64, record.first(records), 7)
    assert_eq(Str, record.type_name(), "NestedRecord")
    choice := NestedChoice.Value(9)
    choices := choice.copies()
    assert_eq(I64, read_nested_choice(choices[0]), 9)
    assert_eq(I64, read_nested_choice(choice.optional().unwrap()), 9)
    assert_eq(I64, read_nested_choice(choice.borrowed().unwrap()), 9)
    assert_eq(Str, choice.type_name(), "NestedChoice")
    assert_eq(I64, bounded_nested(record), 7)
    assert_eq(I64, bounded_nested(choice), 9)
    assert_eq(I64, record.copied_value(), 7)
    view: Nested_Copies = record
    assert_eq(I64, view.copied_value(), 7)
    assert_eq(Str, view.type_name(), "NestedRecord")
}

draw_values := func(T: Type implements Drawable, values: Vec(T)) returns Str {
    mut result := ""
    for value: T in values { result = format(result, value.draw(), ";") }
    return result
}

test_interface_bound_loop_type := test() {
    mut circles := Vec(Circle).new()
    circles.push(own Circle())
    circles.push(own Circle(r = 2))
    assert_eq(Str, draw_values(Circle, circles), "circle;circle;")
    // A different concrete type forces the inferred instantiation path too.
    mut polygons := Vec(Polygon).new()
    polygons.push(own Polygon.Tri)
    assert_eq(Str, draw_values(polygons), "polygon;")
    empty := Vec(Circle).new()
    assert_eq(Str, draw_values(empty), "")
}
