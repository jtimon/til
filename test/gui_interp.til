mode gui

// Regression: raylib was unreachable from the INTERPRETER, so `til repl` in
// mode gui ran `InitWindow(800, 600, "hi".c_str)` and opened nothing.
//
// `link("vendor/raylib/src/libraylib.a")` puts a PATH in link_flags, and a
// static archive cannot be dlopen'd. The archive contributed nothing to
// bin/til either -- a linker only pulls in the members the compiler itself
// references, and the compiler never calls raylib -- so dlsym(RTLD_DEFAULT)
// found none of it. Registration then silently skipped every raylib function
// and the calls fell through to the body-less-function path, which returns
// zero: InitWindow "succeeded" with no window, GetRandomValue(5, 5) gave 0.
//
// The Makefile now relinks each archive into a shared twin beside it with
// --whole-archive, and the interpreter dlopens that twin
// (ffi_load_archive_twin). This test is INTERPRETED on purpose -- every other
// gui test builds first, which is exactly why the interpreted path stayed
// broken with a green suite.
//
// It deliberately opens NO window. What regressed is symbol reachability and
// libffi dispatch, not rendering, and every raylib entry point used here is
// pure CPU. The first version called InitWindow and asserted IsWindowReady,
// which made it the only test in the suite that required a working GL
// context -- the compiled gui tests just run for a second and expect
// `timeout` to kill them, so they pass even when no window ever appears.
// That version failed wherever GLFW could not initialize (an X server
// without GLX, or no display at all) for reasons unrelated to the bug it
// guards. Keeping it windowless also keeps leak detection ON: the GLFW
// driver leaks that forced ASAN_OPTIONS=detect_leaks=0 only happen once a
// window is created.

// raylib matrices come back as 16 separate floats, so a layout that shifted
// by one field would still land near the right magnitudes; compare each slot
// against what it must hold.
priv near := func(got: F32, want: F32, slot: Str) {
    d := got - want
    if d < -0.001 {
        panic("matrix slot ", slot, " is ", got.to_str(), ", expected ", want.to_str())
    }
    if d > 0.001 {
        panic("matrix slot ", slot, " is ", got.to_str(), ", expected ", want.to_str())
    }
}

main := proc() {
    // Plain scalar args and return. Before the fix this silently answered 0,
    // because an unresolved ext symbol fell through to a body-less function.
    SetRandomSeed(12345)
    fixed := GetRandomValue(7, 7)
    if fixed != 7 {
        panic("raylib GetRandomValue did not dispatch through libffi, got: ", fixed.to_str())
    }

    // A struct passed BY VALUE across the bridge, still without a window:
    // ColorToInt packs the four components into 0xRRGGBBAA. Keep the red
    // component under 0x80 so the packed value stays inside I32, which is
    // what the binding returns.
    packed := ColorToInt(Color(r = 17, g = 34, b = 51, a = 68))
    expected : I32 = 0x11223344
    if packed != expected {
        panic("raylib ColorToInt did not receive the Color by value, got: ", packed.to_str())
    }

    // #308: a Bool coming back across the bridge, feeding `!`. That is what
    // `while !WindowShouldClose()` does in examples/hello_gui.til, and it was
    // the first thing the interpreter hit there: an ext call that produced no
    // value at all left `not` with a Value.None argument, and the panic named
    // narrow_bool_arg -- the operator, not the raylib call that came back
    // empty. FileExists is the windowless stand-in: same `returns shallow
    // Bool` ext_proc, and the argument is a string literal's `.c_str`, the
    // other idiom every gui example opens with (InitWindow's title).
    if !FileExists("test/gui_interp.til".c_str) {
        panic("raylib FileExists did not find this very file")
    }
    if FileExists("test/no_such_file.til".c_str) {
        panic("raylib FileExists invented a file that does not exist")
    }

    // The drawing idiom, on the CPU. ColorToInt above is an ext_FUNC;
    // ClearBackground and DrawRectangle are ext_PROCs taking a Color by
    // value, and both need a GL context. ImageDrawRectangle is their
    // in-memory twin -- same struct-by-value argument, no window -- and
    // GetImageColor reads the result back, so a Color that arrived garbled
    // shows up as the wrong pixel instead of passing unnoticed.
    black := Color(r = 0, g = 0, b = 0, a = 255)
    red := Color(r = 230, g = 41, b = 55, a = 255)
    mut canvas := GenImageColor(8, 8, black)
    ImageDrawRectangle(canvas, 2, 2, 4, 4, red)
    inside := GetImageColor(canvas, 3, 3)
    outside := GetImageColor(canvas, 0, 0)
    UnloadImage(canvas)
    if ColorToInt(inside) != ColorToInt(red) {
        panic("raylib ImageDrawRectangle did not receive the Color by value, got: ",
              inside.r.to_str(), ",", inside.g.to_str(), ",", inside.b.to_str())
    }
    if ColorToInt(outside) != ColorToInt(black) {
        panic("raylib GenImageColor did not receive the Color by value, got: ",
              outside.r.to_str(), ",", outside.g.to_str(), ",", outside.b.to_str())
    }

    // A 64-byte struct BOTH ways, still windowless: GetCameraMatrix takes a
    // Camera3D by value and returns a Matrix by value.
    //
    // Matrix used to be `ext_struct("Matrix") {}` -- fieldless, because the
    // bindgen refused `float m0, m4, m8, m12;` (several declarators on one C
    // line) and downgraded the whole struct to opaque. Compiled code never
    // noticed, since it includes raylib.h and gets the real type, but the
    // interpreter built a size-0 ffi_type from those zero fields, libffi
    // rejected it at prep, and every `shallow Matrix` signature went
    // unregistered -- so this call panicked with "ext function is not
    // registered" rather than returning anything.
    //
    // A camera at the origin looking down -Z with +Y up has the identity as
    // its view matrix, which pins all 16 slots to exact values.
    cam := Camera3D(
        position = Vector3(x = 0.0, y = 0.0, z = 0.0),
        target = Vector3(x = 0.0, y = 0.0, z = -1.0),
        up = Vector3(x = 0.0, y = 1.0, z = 0.0),
        fovy = 45.0,
        projection = 0,
    )
    view := GetCameraMatrix(cam)
    near(view.m0, 1.0, "m0")
    near(view.m4, 0.0, "m4")
    near(view.m8, 0.0, "m8")
    near(view.m12, 0.0, "m12")
    near(view.m1, 0.0, "m1")
    near(view.m5, 1.0, "m5")
    near(view.m9, 0.0, "m9")
    near(view.m13, 0.0, "m13")
    near(view.m2, 0.0, "m2")
    near(view.m6, 0.0, "m6")
    near(view.m10, 1.0, "m10")
    near(view.m14, 0.0, "m14")
    near(view.m3, 0.0, "m3")
    near(view.m7, 0.0, "m7")
    near(view.m11, 0.0, "m11")
    near(view.m15, 1.0, "m15")
}
