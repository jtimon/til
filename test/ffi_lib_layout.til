mode cli

import("../src/std/sys")
import("../src/std/file")

// #313 follow-up: a library's values cross an interpreted call in the
// interpreter's layout, and the library shares the interpreter's allocator.
// A library built for the other layout (--usize=64 under the default
// compact interpreter, --usize=32 under a native one) used to segfault the
// first call that read one of its structs (a native pointer read as a cage
// offset, a U32 count read as a U64 one); it now exports the layout it was
// built for and the interpreter refuses it at load. Built flipping the
// suite's own layout, and it must be refused.
//
// args: the compiler, then the flags the suite builds its programs with.

WORK := "tmp/ffi_lib_layout"

has_flag := func(args: Array(Str), flag: Str) returns Bool {
    for i in 1..args.len() {
        if args[i] == flag { return true }
    }
    return false
}

expect_refused := proc(args: Array(Str), flip: Str) {
    ref compiler : Str = args[0]
    build := Cmd.new(compiler, "build")
    for i in 1..args.len() { build.arg(args[i]) }
    // The last layout flag wins.
    build.arg(flip)
    build.arg(format(WORK, "/ffi_lib_layout_probe.til"))
    build.run_checked()
    consumer := Cmd.new(compiler, "interpret", format(WORK, "/consumer.til"))
    consumer.env("LIBRARY_PATH", "gen/lib")
    consumer.env("LD_LIBRARY_PATH", "gen/lib")
    consumer.env("DYLD_LIBRARY_PATH", "gen/lib")
    consumer.capture()
    status := consumer.run()
    if status == 0 { panic("library built ", flip, " was loaded: ", consumer.out()) }
    if consumer.err().contains("built for layout").not() {
        panic("library built ", flip, " was not refused for its layout (status ", status.to_str(), "): ",
            consumer.out(), consumer.err())
    }
    // A COMPILED consumer of that library must not link: it refers to the
    // library by a symbol named for its own layout, which the library does
    // not export. It used to link and misread the library's values.
    compiled := Cmd.new(compiler, "build")
    for i in 1..args.len() { compiled.arg(args[i]) }
    compiled.args("-o", format(WORK, "/consumer_bin"), format(WORK, "/consumer.til"))
    compiled.env("LIBRARY_PATH", "gen/lib")
    compiled.capture()
    if compiled.run() == 0 { panic("a compiled consumer linked a library built ", flip) }
    if compiled.out().contains("was built for another layout").not() {
        panic("compiled consumer failed without the layout note: ", compiled.out(), compiled.err())
    }
    // A C consumer compiled for the other layout is refused by the header.
    File.writefile(format(WORK, "/c_consumer.c"), "#include \"ffi_lib_layout_probe.h\"\nint main(void) { return 0; }\n")
    mut wrong_define := "-DTIL_USIZE32"
    if flip == "--usize=32" { wrong_define = "-DTIL_USIZE64" }
    c_consumer := Cmd.new("cc", "-fsyntax-only", "-fsigned-char", wrong_define, "-Igen/til", "-Isrc/self/codegen", format(WORK, "/c_consumer.c"))
    c_consumer.capture()
    if c_consumer.run() == 0 { panic("a C consumer compiled against a library built ", flip, " with ", wrong_define) }
    if c_consumer.err().contains("was built for layout").not() { panic("C consumer not refused by the header: ", c_consumer.err()) }
}

// The matching case: built at the suite's own layout, the compiled consumer
// links, runs and reads the library's struct.
expect_linked := proc(args: Array(Str)) {
    ref compiler : Str = args[0]
    build := Cmd.new(compiler, "build")
    for i in 1..args.len() { build.arg(args[i]) }
    build.arg(format(WORK, "/ffi_lib_layout_probe.til"))
    build.run_checked()
    compiled := Cmd.new(compiler, "build")
    for i in 1..args.len() { compiled.arg(args[i]) }
    compiled.args("-o", format(WORK, "/consumer_bin"), format(WORK, "/consumer.til"))
    compiled.env("LIBRARY_PATH", "gen/lib")
    compiled.run_checked()
    run := Cmd.new(format(WORK, "/consumer_bin"))
    run.env("LD_LIBRARY_PATH", "gen/lib")
    run.env("DYLD_LIBRARY_PATH", "gen/lib")
    run.capture()
    if run.run() != 0 { panic("matching compiled consumer failed: ", run.out(), run.err()) }
    if run.out().contains("layout probe loaded").not() { panic("matching compiled consumer: ", run.out()) }
}

main := proc(args: ..Str) {
    mkdir_p(WORK)
    File.writefile(format(WORK, "/ffi_lib_layout_probe.til"), format(
        "mode lib\n",
        "LayoutProbe := struct { count: USize = 3; own tail : Str = \"\" }\n",
        "layout_make := func() returns LayoutProbe { return LayoutProbe(count = 4, tail = format(\"tail \", \"seven\")) }\n"))
    File.writefile(format(WORK, "/consumer.til"), format(
        "import(\"../../gen/til/ffi_lib_layout_probe\")\n",
        "made := layout_make()\n",
        "assert(made.count == 4)\n",
        "println(\"layout probe loaded\")\n"))
    // The interpreter runs at its own layout here (no --usize): the suite's.
    mut flip := "--usize=64"
    if has_flag(args, "--usize=64") { flip = "--usize=32" }
    expect_refused(args, flip)
    expect_linked(args)

    // A til library with NO layout record (one built before the export) is
    // refused as well, where it used to load unchecked. Stood in for by a C
    // library whose binding declares a name under the library's til prefix,
    // which is what identifies a til library; a plain C binding still loads.
    mut extension := ".so"
    mut shared_flag := "-shared"
    if host_os() == "macos" { extension = ".dylib"; shared_flag = "-dynamiclib" }
    File.writefile(format(WORK, "/old.c"), "long til_layoutold__value(void) { return 7; }\nlong plain_value(void) { return 9; }\n")
    for name in vec(Str, "layoutold", "layoutplain") {
        Cmd.new("cc", shared_flag, "-fPIC", "-o", format("gen/lib/lib", name, extension), format(WORK, "/old.c")).run_checked()
    }
    File.writefile(format(WORK, "/old_consumer.til"), format(
        "mode script\nlink(\"layoutold\")\n",
        "til_layoutold__value := ext_proc() returns shallow I64 {}\n",
        "println(til_layoutold__value().to_str())\n"))
    File.writefile(format(WORK, "/plain_consumer.til"), format(
        "mode script\nlink(\"layoutplain\")\n",
        "plain_value := ext_proc() returns shallow I64 {}\n",
        "println(plain_value().to_str())\n"))
    old := Cmd.new(args[0], "interpret", format(WORK, "/old_consumer.til"))
    old.env("LD_LIBRARY_PATH", "gen/lib")
    old.env("DYLD_LIBRARY_PATH", "gen/lib")
    old.capture()
    if old.run() == 0 { panic("a til library with no layout record was loaded: ", old.out()) }
    if old.err().contains("no layout record").not() { panic("not refused for its missing layout: ", old.out(), old.err()) }
    plain := Cmd.new(args[0], "interpret", format(WORK, "/plain_consumer.til"))
    plain.env("LD_LIBRARY_PATH", "gen/lib")
    plain.env("DYLD_LIBRARY_PATH", "gen/lib")
    plain.capture()
    if plain.run() != 0 { panic("a C library was refused: ", plain.out(), plain.err()) }
    if plain.out().contains("9").not() { panic("C library call failed: ", plain.out()) }
    println("ffi lib layout passed")
}
