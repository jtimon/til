mode test

// Regression: a numeric literal with no type to narrow from reported itself
// as I64 regardless of its text, so `f := 1.5` became an I64 binding and then
// died converting its own text -- "Str.to_i64: invalid char in '1.5'", raised
// inside src/core with no user file or line.
//
// The default lives in Expr.til_type, which answers for an un-narrowed
// Literal.Num. It follows the text now: fractional or exponent forms are F64,
// everything else I64. A literal that DOES narrow
// from a declaration, parameter or field type is unaffected -- its til_type is
// already set, so the default never applies.
//
// This could not change a working program: an I64-typed literal with
// fractional text panicked in both backends, so nothing could depend on it.

takes_f32 := func(x: F32) returns F32 { return x }

test_bare_float_literal_is_f64 := test() {
    f := 1.5
    assert_eq(F64, f, 1.5)
    large := 1.0e100
    assert_eq(F64, large, 1.0e100)
}

test_float_literal_arithmetic := test() {
    assert_eq(F64, 1.5 + 2.25, 3.75)
    assert_eq(F64, 7.5 / 2.0, 3.75)
}

test_exponent_literal_is_float := test() {
    e := 3.5e2
    assert_eq(F64, e, 350.0)
}

// The text decides, so integers keep defaulting to I64 -- including a hex
// literal whose digits contain 'E', which must not be read as an exponent.
test_integer_literals_still_i64 := test() {
    i := 42
    assert_eq(I64, i, 42)
    h := 0xE1
    assert_eq(I64, h, 225)
}

// Narrowing from context still wins over the text-based default.
test_context_narrowing_unaffected := test() {
    a : F32 = 1.5
    assert_eq(F32, a, 1.5)
    assert_eq(F32, takes_f32(2.5), 2.5)
    left : F32 = 1.5
    assert_eq(F32, left + 2.25, 3.75)
    b : I64 = 7
    assert_eq(I64, b, 7)
}

Point := struct {
    x := 2.5
    y := 3
}

CompactPoint := struct {
    x : F32 = 0
    y : F32 = 0
}

CompactHolder := struct {
    point : CompactPoint = CompactPoint()
}

test_struct_field_default_follows_text := test() {
    p := Point()
    assert_eq(F64, p.x, 2.5)
    assert_eq(I64, p.y, 3)
}

test_f32_constructor_literals_keep_field_width := test() {
    nested := CompactHolder(point = CompactPoint(x = 1.5, y = 2.5))
    assert_eq(F32, nested.point.x, 1.5)
    assert_eq(F32, nested.point.y, 2.5)
}

// Runtime operands prevent constant folding from hiding a disagreement
// between the interpreter's arithmetic and the generated backend code.
runtime_f32 := proc(value: F32) returns F32 {
    noop_proc()
    return value
}

runtime_f64 := proc(value: F64) returns F64 {
    noop_proc()
    return value
}

test_ieee_f32_division := test() {
    one := runtime_f32(1.0)
    negative := runtime_f32(-1.0)
    zero := runtime_f32(0.0)
    minus_zero := runtime_f32(-0.0)
    assert_eq(Str, (one / zero).to_repr(), "inf")
    assert_eq(Str, (one / minus_zero).to_repr(), "-inf")
    assert_eq(Str, (negative / zero).to_repr(), "-inf")
    assert_eq(Str, (negative / minus_zero).to_repr(), "inf")
    nan_value := zero / zero
    assert(nan_value != nan_value)
    assert(nan_value.lt(one).not())
    mut caught := false
    _quotient := one.safe_div(minus_zero)?
    catch (err: DivideByZero) { caught = true }
    assert(caught)
}

test_ieee_f64_division := test() {
    one := runtime_f64(1.0)
    negative := runtime_f64(-1.0)
    zero := runtime_f64(0.0)
    minus_zero := runtime_f64(-0.0)
    assert_eq(Str, (one / zero).to_repr(), "inf")
    assert_eq(Str, (one / minus_zero).to_repr(), "-inf")
    assert_eq(Str, (negative / zero).to_repr(), "-inf")
    assert_eq(Str, (negative / minus_zero).to_repr(), "inf")
    nan_value := zero / zero
    assert(nan_value != nan_value)
    assert(nan_value.eq(one).not())
    assert(nan_value.lt(one).not())
    assert(nan_value.lte(one).not())
    assert(nan_value.gt(one).not())
    assert(nan_value.gte(one).not())
    mut caught := false
    _quotient := one.safe_div(minus_zero)?
    catch (err: DivideByZero) { caught = true }
    assert(caught)
    propagated := one.safe_div(nan_value)!
    assert(propagated != propagated)
}

MixedFloatCall:=func(a:F64,b:I64,c:F32,d:F64,e:I16,f:F32) returns F64
mixed_float_sum:=func(a:F64,b:I64,c:F32,d:F64,e:I16,f:F32) returns F64 {
    return a+b.cast(F64)+c.cast(F64)+d+e.cast(F64)+f.cast(F64)
}
float_adjust:=func(mut value:F32) { value=value+0.5 }
float_borrow:=func(mut value:F64) returns ref F64 { value=value+0.25; return value }
FloatPair:=struct { small:F32=0; wide:F64=0 }
FloatPairCall:=func(value:F32) returns FloatPair
FloatConversion:=func(value:I64) returns F64
FloatFormat:=func(value:F64) returns Str
make_float_pair:=func(value:F32) returns FloatPair { return FloatPair(small=value,wide=value.cast(F64)+0.25) }

test_float_call_boundaries:=test() {
    seed:=runtime_f64(1.5)
    assert_eq(F64,mixed_float_sum(seed,2,3.5,4.25,5,6.5),22.75)
    call:MixedFloatCall=mixed_float_sum
    assert_eq(F64,call(seed,2,3.5,4.25,5,6.5),22.75)
    bias:=seed
    captured:MixedFloatCall=func(a:F64,b:I64,c:F32,d:F64,e:I16,f:F32) returns F64 [own bias] {
        return mixed_float_sum(a,b,c,d,e,f)+bias
    }
    assert_eq(F64,captured(seed,2,3.5,4.25,5,6.5),24.25)
    body_bias:=seed
    mut observed:F64=0
    body:Body=[own body_bias,mut observed] { observed=body_bias }
    body()
    assert_eq(F64,observed,seed)
    mut narrow:=runtime_f32(1.25)
    float_adjust(narrow)
    assert_eq(F32,narrow,1.75)
    mut wide:=seed
    ref mut alias:F64=float_borrow(wide)
    alias=alias+0.5
    assert_eq(F64,wide,2.25)
    make:FloatPairCall=make_float_pair
    pair:=make(narrow)
    assert_eq(F32,pair.small,1.75)
    assert_eq(F64,pair.wide,2.0)
    convert:FloatConversion=dyn_fn("F64","from_i64")
    assert_eq(F64,convert(2),2.0)
    format_value:FloatFormat=dyn_fn("F64","to_repr")
    assert_eq(Str,format_value(seed),"1.5")
}

FloatReading:=interface {
    read:=func(self:FloatReading) returns F64
    add:=func(mut self:FloatReading,amount:F32) returns F32
}
FloatMeter:=struct implements FloatReading {
    small:F32=0
    wide:F64=0
namespace:
    read:=func(self:FloatMeter) returns F64 { return self.wide }
    add:=func(mut self:FloatMeter,amount:F32) returns F32 { self.small=self.small+amount; return self.small }
}
test_float_interface_and_templates:=test() {
    mut meter:=FloatMeter(small=runtime_f32(1.25),wide=runtime_f64(2.5))
    ref mut view:FloatReading=meter
    assert_eq(F64,view.read(),2.5)
    assert_eq(F32,view.add(0.5),1.75)
    assert_eq(F32,meter.small,1.75)
    values:=array(F32,1.25,2.5,3.75)
    copied:=values.clone()
    assert_eq(F32,copied[0]+copied[1]+copied[2],7.5)
    large:=runtime_f32(16777216.0)
    assert_eq(F32,large+1.0,large)
}

parse_runtime_f32:=proc(text:Str) returns F32 { noop_proc(); return text.to_f32() }
parse_runtime_f64:=proc(text:Str) returns F64 { noop_proc(); return text.to_f64() }
float_bits32:=func(value:F32) returns U32 { mut bits:U32=0; memcpy(to_ptr(bits),to_ptr(value),4); return bits }
float_bits64:=func(value:F64) returns U64 { mut bits:U64=0; memcpy(to_ptr(bits),to_ptr(value),8); return bits }

test_float_text_prefixes_and_specials:=test() {
    assert_eq(F64,parse_runtime_f64(" \t-1_2.5e-1tail"),-1.25)
    assert_eq(F32,parse_runtime_f32("0X1.8P+2tail"),6.0)
    assert_eq(F64,parse_runtime_f64("12e+"),12.0)
    assert_eq(U64,float_bits64(parse_runtime_f64("-x")),0)
    assert_eq(U64,float_bits64(parse_runtime_f64("-0")),9223372036854775808)
    assert_eq(U32,float_bits32(parse_runtime_f32("-0x0p999999")),2147483648)
    assert_eq(Str,parse_runtime_f64("-INFINITY").to_repr(),"-inf")
    nan64:=parse_runtime_f64("-nan(0x123)")
    nan32:=parse_runtime_f32("nan(0123)")
    assert(nan64!=nan64)
    assert(nan32!=nan32)
    backing:="1e999"
    view:=backing.substr(0,2)
    assert_eq(F64,parse_runtime_f64(view),1.0)
    embedded:="1\x00Ze999"
    assert_eq(F64,parse_runtime_f64(embedded),1.0)
}

test_float_text_rounding_boundaries:=test() {
    // Parsing to F64 and narrowing would double-round this one to 1.0.
    assert_eq(U32,float_bits32(parse_runtime_f32("1.0000000596046448")),1065353217)
    midpoint:="1.00000000000000011102230246251565404236316680908203125"
    assert_eq(F64,parse_runtime_f64(midpoint),1.0)
    mut above:=Str.with_capacity(1000)
    above.push_str(midpoint)
    for _ in 0..850 { above.push_str("0") }
    above.push_str("1")
    assert_eq(U64,float_bits64(parse_runtime_f64(above)),4607182418800017409)
    mut below:=Str.with_capacity(1000)
    below.push_str("1.00000000000000011102230246251565404236316680908203124")
    for _ in 0..850 { below.push_str("9") }
    assert_eq(F64,parse_runtime_f64(below),1.0)
    assert_eq(U64,float_bits64(parse_runtime_f64("0x1p-1075")),0)
    assert_eq(U64,float_bits64(parse_runtime_f64("0x8.000000000000000p-1078")),0)
    assert_eq(U64,float_bits64(parse_runtime_f64("0x8.000000000000001p-1078")),1)
    assert_eq(U64,float_bits64(parse_runtime_f64("0x1.0000000000000000000000000000000000000001p-1075")),1)
    assert_eq(U64,float_bits64(parse_runtime_f64("5e-324")),1)
    assert_eq(U32,float_bits32(parse_runtime_f32("0x1p-150")),0)
    assert_eq(U32,float_bits32(parse_runtime_f32("0x1.000001p-150")),1)
    assert_eq(U32,float_bits32(parse_runtime_f32("0x8.000000000000001p-153")),1)
    assert_eq(U32,float_bits32("0x1.000001p-150".to_f32()),1)
    assert_eq(Str,parse_runtime_f64("1e999999999999999999999999").to_repr(),"inf")
    assert_eq(U64,float_bits64(parse_runtime_f64("-1e-999999999999999999999")),9223372036854775808)
}

test_float_text_long_exponent_cancellation:=test() {
    mut whole:=Str.with_capacity(2100)
    whole.push_str("1")
    for _ in 0..2000 { whole.push_str("0") }
    whole.push_str("e-2000")
    assert_eq(F64,parse_runtime_f64(whole),1.0)
    mut fraction:=Str.with_capacity(2100)
    fraction.push_str("0.")
    for _ in 0..2000 { fraction.push_str("0") }
    fraction.push_str("1e2001")
    assert_eq(F32,parse_runtime_f32(fraction),1.0)
}
