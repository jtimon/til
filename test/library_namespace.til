mode cli

import("../src/std/sys")
import("../src/std/file")

main := proc() {
    build_a := Cmd.new("bin/til", "build", "test/library_namespace_a.til")
    build_b := Cmd.new("bin/til", "build", "test/library_namespace_b.til")
    println(build_a.render())
    println(build_b.render())
    build_a.start()
    build_b.start()
    status_a := build_a.wait()
    status_b := build_b.wait()
    if status_a != 0 { panic("library_namespace_a build exited with ", status_a.to_str()) }
    if status_b != 0 { panic("library_namespace_b build exited with ", status_b.to_str()) }

    py_a := File.readfile("gen/til/library_namespace_a.py")
    py_b := File.readfile("gen/til/library_namespace_b.py")
    if py_a.contains("USize").or(py_b.contains("USize")) {
        panic("generated Python binding contains unresolved USize")
    }

    Cmd.new("cc", "-Werror", "-Igen/til", "-Isrc/c", "test/library_namespace.c",
        "gen/lib/liblibrary_namespace_a.a", "gen/lib/liblibrary_namespace_b.a",
        "-lm", "-o", "tmp/library_namespace_static").run_checked()
    Cmd.new("tmp/library_namespace_static").run_checked()

    Cmd.new("cc", "-Werror", "-Igen/til", "-Isrc/c", "test/library_namespace.c",
        "-Lgen/lib", "-llibrary_namespace_a", "-llibrary_namespace_b",
        "-Wl,-rpath,gen/lib", "-lm", "-o", "tmp/library_namespace_shared").run_checked()
    Cmd.new("tmp/library_namespace_shared").run_checked()

    consumer := Cmd.new("bin/til", "run", "test/library_namespace_consumer.til")
    consumer.env("LIBRARY_PATH", "gen/lib")
    consumer.env("LD_LIBRARY_PATH", "gen/lib")
    consumer.env("DYLD_LIBRARY_PATH", "gen/lib")
    consumer.run_checked()
}
