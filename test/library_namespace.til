mode cli

import("../src/std/sys")
import("../src/std/file")

require_contains := func(text: Str, expected: Str) returns Bool {
    if text.contains(expected).not() { panic("missing generated binding text: ", expected) }
    return true
}

require_absent := func(text: Str, unexpected: Str) returns Bool {
    if text.contains(unexpected) { panic("unexpected generated binding text: ", unexpected) }
    return true
}

line_starting_with := func(text: Str, prefix: Str) returns Str {
    for line : Str in text.split("\n") {
        if line.starts_with(prefix) { return line.clone() }
    }
    panic("missing generated line: ", prefix)
    return ""
}

check_parse_failure := proc(executable: Str, kind: Str, input: Str, message: Str) {
    cmd := Cmd.new(executable, kind, input)
    cmd.capture()
    if cmd.run() != 1 { panic("shared numeric parser did not exit with status 1: ", input) }
    if cmd.err().len() != 0 { panic("shared numeric parser wrote stderr: ", cmd.err()) }
    output := cmd.out()
    require_contains(output, "src/core/str.til:")
    if output.ends_with(format(": panic: ", message, "\n")).not() {
        panic("shared numeric parser diagnostic mismatch: ", output)
    }
}

check_core_failures := proc(executable: Str) {
    for kind in 1..5 {
        cmd := Cmd.new(executable, kind.to_str())
        cmd.capture()
        if cmd.run() != 1 { panic("shared core failure did not exit with status 1") }
        if cmd.err().len() != 0 { panic("shared core panic changed output stream: ", cmd.err()) }
        output := cmd.out()
        if kind == 4 {
            if output != "namespace-test: panic: left/right\n" { panic("shared panic output mismatch: ", output) }
        } else {
            require_contains(output, "src/core/str.til:")
            mut message := "Str.get: index out of bounds"
            if kind == 2 { message = "Str.push_str: capacity exceeded" }
            if kind == 3 { message = "Str.push_str: cannot mutate a string view or literal" }
            if output.ends_with(format(": panic: ", message, "\n")).not() {
                panic("shared core panic output mismatch: ", output)
            }
        }
    }
    check_parse_failure(executable, "i", "", "Str.to_i64: empty string")
    check_parse_failure(executable, "i", "-", "Str.to_i64: no digits")
    check_parse_failure(executable, "i", "0x", "Str.to_i64: no digits in '0x'")
    check_parse_failure(executable, "i", "_", "Str.to_i64: no digits in '_'")
    check_parse_failure(executable, "i", "0b2", "Str.to_i64: invalid char in '0b2'")
    check_parse_failure(executable, "i", "12z", "Str.to_i64: invalid char in '12z'")
    check_parse_failure(executable, "i", "9223372036854775808", "Str.to_i64: out of range in '9223372036854775808'")
    check_parse_failure(executable, "i", "-9223372036854775809", "Str.to_i64: out of range in '-9223372036854775809'")
    check_parse_failure(executable, "u", "18446744073709551616", "Str.to_u64: out of range in '18446744073709551616'")
    check_parse_failure(executable, "u", "-9223372036854775809", "Str.to_u64: out of range in '-9223372036854775809'")
}

main := proc() {
    til_bin := "bin/til"
    build_a := Cmd.new(til_bin, "build", "test/library_namespace_a.til")
    build_b := Cmd.new(til_bin, "build", "test/library_namespace_b.til")
    println(build_a.render())
    println(build_b.render())
    build_a.start()
    build_b.start()
    status_a := build_a.wait()
    status_b := build_b.wait()
    if status_a != 0 { panic("library_namespace_a build exited with ", status_a.to_str()) }
    if status_b != 0 { panic("library_namespace_b build exited with ", status_b.to_str()) }

    py_a := File.readfile("gen/til/library_namespace_a.py")
    py_b := File.readfile("gen/til/library_namespace_b.py")
    fwd_a := File.readfile("gen/til/library_namespace_a_forward.h")
    fwd_b := File.readfile("gen/til/library_namespace_b_forward.h")
    runtime_alias_a := line_starting_with(fwd_a, "#define I64_clone ")
    runtime_alias_b := line_starting_with(fwd_b, "#define I64_clone ")
    if runtime_alias_a != runtime_alias_b { panic("libraries do not share one versioned runtime namespace") }
    require_contains(runtime_alias_a, "til_tilrt_x2d")
    require_absent(runtime_alias_a, "til_library_x5fnamespace")
    core_alias_a := line_starting_with(fwd_a, "#define Str_cmp ")
    core_alias_b := line_starting_with(fwd_b, "#define Str_cmp ")
    if core_alias_a != core_alias_b { panic("libraries do not share one versioned core namespace") }
    require_contains(core_alias_a, "til_tilcore_x2d")
    require_absent(core_alias_a, "til_library_x5fnamespace")
    core_str_a := line_starting_with(fwd_a, "#define Str ")
    core_str_b := line_starting_with(fwd_b, "#define Str ")
    if core_str_a != core_str_b { panic("libraries do not share one canonical Str type") }
    require_contains(core_str_a, "til_tilcore_x2d")
    core_cap_a := line_starting_with(fwd_a, "#define CAP_VIEW ")
    core_cap_b := line_starting_with(fwd_b, "#define CAP_VIEW ")
    if core_cap_a != core_cap_b { panic("libraries do not share canonical Str globals") }
    require_contains(core_cap_a, "til_tilcore_x2d")
    core_clone_a := line_starting_with(fwd_a, "#define Str_clone ")
    core_clone_b := line_starting_with(fwd_b, "#define Str_clone ")
    if core_clone_a != core_clone_b { panic("libraries do not share allocating Str functions") }
    require_contains(core_clone_a, "til_tilcore_x2d")
    for core_name : Str in array(Str, "Array__Str", "Array__Str_new", "Array__Str_delete",
            "Array__Str_clone", "adopt__Str", "panic", "format", "println", "print_single",
            "print_flush", "Str_get", "Str_push_str", "Str_replace", "concat3",
            "Str_to_i64", "Str_to_u64", "Str_to_i8", "Str_to_u8", "Str_to_i16", "Str_to_u16",
            "Str_to_i32", "Str_to_u32", "Str_to_usize", "Str_to_f32", "Str_to_f64",
            "digit_value", "I64_MIN", "I64_MAX", "U64_MAX",
            "Vec__Str", "Vec__Str_new", "Vec__Str_with_capacity", "Vec__Str_size",
            "Vec__Str_len", "Vec__Str_unsafe_get", "Vec__Str_get", "Vec__Str_push",
            "Vec__Str_clear", "Vec__Str_delete", "Vec__Str_clone", "Str_split", "join") {
        prefix := format("#define ", core_name, " ")
        alias_a := line_starting_with(fwd_a, prefix)
        alias_b := line_starting_with(fwd_b, prefix)
        if alias_a != alias_b { panic("inconsistent shared core symbol: ", core_name) }
        require_contains(alias_a, "til_tilcore_x2d")
    }
    parser_alias := line_starting_with(fwd_a, "#define Str_to_i64 ")
    core_prefix := parser_alias.strip_prefix("#define Str_to_i64 ").strip_suffix("Str_to_i64")
    helper_target := format(" ", core_prefix, "str_parse_integer_magnitude\n")
    require_contains(fwd_a, helper_target)
    require_contains(fwd_b, helper_target)
    if py_a.contains("USize").or(py_b.contains("USize")) {
        panic("generated Python binding contains unresolved USize")
    }
    til_a := File.readfile("gen/til/library_namespace_a.til")
    require_contains(til_a, "LibraryNamespaceACallback := func(I64) returns")
    require_contains(til_a, "LibraryNamespaceACallbackAlias := LibraryNamespaceACallback")
    require_contains(til_a, "library_namespace_a_value_alias := func() returns I64")
    require_contains(til_a, "ref borrowed : I64")
    require_contains(til_a, "priv secret : U32 := 17")
    require_contains(til_a, "binding_layout_BindingPoint := func(self: BindingPoint)")
    require_contains(til_a, "shallow point: BindingPoint")
    require_contains(til_a, "returns Array(I64)")
    require_contains(til_a, "value: I64 = 31")
    require_contains(til_a, "library_namespace_a_count := ext_global(I64, \"til_library_x5fnamespace_x5fa__library_namespace_a_count\")")
    require_contains(til_a, "mut library_namespace_a_state := ext_global(I64, \"til_library_x5fnamespace_x5fa__library_namespace_a_state\")")
    require_contains(til_a, "library_namespace_a_origin := ext_global(BindingPoint, \"til_library_x5fnamespace_x5fa__library_namespace_a_origin\")")
    require_contains(til_a, "mut library_namespace_a_point_state := ext_global(BindingPoint, \"til_library_x5fnamespace_x5fa__library_namespace_a_point_state\")")
    require_contains(til_a, "COUNT := ext_global(I64, \"til_library_x5fnamespace_x5fa__BindingPoint_COUNT\")")
    require_contains(til_a, "mut STATE := ext_global(I64, \"til_library_x5fnamespace_x5fa__BindingPoint_STATE\")")
    require_contains(til_a, "ref library_namespace_a_origin_ref : BindingPoint = ext_global(BindingPoint, \"til_library_x5fnamespace_x5fa__library_namespace_a_origin_ref\")")
    require_contains(til_a, "value: I64 = BindingPoint.COUNT")
    require_contains(til_a, "value: Str = \"a\\\"b\\\\c\"")
    require_contains(til_a, "throws BindingError")
    require_absent(til_a, "library_namespace_a_private_value")
    require_absent(til_a, "hidden :=")
    require_absent(til_a, "library_namespace_a_private_state")
    require_absent(til_a, "HIDDEN_STATE")
    require_absent(til_a, "binding__Array__I64")

    require_contains(py_a, "('scalar', ctypes.c_longlong)")
    require_contains(py_a, "class Vec__Str(ctypes.Structure):")
    require_contains(py_b, "class Vec__Str(ctypes.Structure):")
    require_contains(py_a, "_runtime_name = 'libtilrt-")
    require_contains(py_b, "_runtime_name = 'libtilrt-")
    require_contains(py_a, "_core_name = 'libtilcore-")
    require_contains(py_b, "_core_name = 'libtilcore-")
    require_contains(py_a, "('borrowed', ctypes.POINTER(ctypes.c_longlong))")
    require_contains(py_a, "('size', ctypes.c_ulonglong)")
    require_contains(py_a, "('ptr', ctypes.c_ulonglong)")
    require_contains(py_a, "library_namespace_a_point.argtypes = [BindingPoint]")
    require_contains(py_a, "library_namespace_a_point.restype = BindingPoint")
    require_contains(py_a, "library_namespace_a_dynamic.argtypes = [ctypes.c_void_p]")
    require_contains(py_a, "('tag', ctypes.c_ushort)")
    require_contains(py_a, "('Number', ctypes.c_longlong)")
    require_contains(py_a, "('_til_payload_align', ctypes.c_void_p)")
    require_contains(py_a, "('data', ctypes.POINTER(ctypes.c_longlong))")
    require_contains(py_a, "LibraryNamespaceACallback = ctypes.c_void_p")
    require_contains(py_a, "library_namespace_a_value_alias = library_namespace_a_value")
    require_contains(py_a, "library_namespace_a_count = ctypes.c_longlong.in_dll")
    require_contains(py_a, "BindingPoint_STATE = ctypes.c_longlong.in_dll")
    require_contains(py_a, "library_namespace_a_origin_ref = ctypes.POINTER(BindingPoint).in_dll")
    require_absent(py_a, "ctypes.POINTER(ctypes.c_void_p)")
    require_absent(py_a, "library_namespace_a_private_value")
    require_absent(py_a, "library_namespace_a_private_state")
    require_absent(py_a, "BindingPoint_HIDDEN_STATE")

    py_check := "import sys; sys.path.insert(0, 'gen/til'); import library_namespace_a as a; assert a.library_namespace_a_count.value == 17; assert a.library_namespace_a_state.value == 23; assert a.BindingPoint_COUNT.value == 5; assert a.BindingPoint_STATE.value == 6; assert a.library_namespace_a_origin.scalar == 19; assert a.library_namespace_a_point_state.scalar == 20; assert not hasattr(a, 'library_namespace_a_private_state'); assert not hasattr(a, 'BindingPoint_HIDDEN_STATE'); assert a.BindingTag_TAG_Empty == 3; assert a.BindingTag_TAG_Number == 7; tag = a.BindingTag(); tag.tag = a.BindingTag_TAG_Empty; assert tag.tag == 3; assert a.library_namespace_a_global_sum() == 51; a.library_namespace_a_state.value = 30; a.BindingPoint_STATE.value = 8; a.library_namespace_a_point_state.scalar = 24; assert a.library_namespace_a_global_sum() == 60; assert a.library_namespace_a_point_state.scalar == 24; assert a.library_namespace_a_origin_ref.contents.scalar == 19; assert a.library_namespace_a_origin_ref.contents.size == 29"
    Cmd.new("python3", "-c", py_check).run_checked()

    // -fsigned-char: this consumer is the one C compile in the suite that
    // the til driver does NOT run, so it must carry the flag itself --
    // ext.h's signed-char guard #errors without it wherever plain char is
    // unsigned (aarch64/arm linux; a no-op on x86), which kept the
    // linux-arm64 (native) job red while every x86 job passed.
    Cmd.new("cc", "-Werror", "-fsigned-char", "-Igen/til", "-Isrc/c", "test/library_namespace.c",
        "gen/lib/liblibrary_namespace_a.a", "gen/lib/liblibrary_namespace_b.a",
        "-lm", "-o", "tmp/library_namespace_static").run_checked()
    Cmd.new("tmp/library_namespace_static").run_checked()
    check_core_failures("tmp/library_namespace_static")

    Cmd.new("cc", "-Werror", "-fsigned-char", "-Igen/til", "-Isrc/c", "test/library_namespace.c",
        "-Lgen/lib", "-llibrary_namespace_a", "-llibrary_namespace_b",
        "-Wl,-rpath,gen/lib", "-lm", "-o", "tmp/library_namespace_shared").run_checked()
    Cmd.new("tmp/library_namespace_shared").run_checked()
    check_core_failures("tmp/library_namespace_shared")

    consumer := Cmd.new("bin/til", "run", "-c", "gen/c/library_namespace_consumer.c",
                        "test/library_namespace_consumer.til")
    consumer.env("LIBRARY_PATH", "gen/lib")
    consumer.env("LD_LIBRARY_PATH", "gen/lib")
    consumer.env("DYLD_LIBRARY_PATH", "gen/lib")
    consumer.run_checked()

    // Issue #326: the scavenger roots `*.size` unconditionally -- get_elem_size
    // builds that call from a type name it only learns at runtime -- so a
    // generated binding's `BindingRef.size` wrapper survives the sweep. The C
    // emitter drops the wrapper (nothing calls it), and the ext prototype its
    // body referenced has to go with it: five `..._size` symbols were declared
    // here with nothing defining and nothing calling them.
    consumer_c := File.readfile("gen/c/library_namespace_consumer.c")
    require_absent(consumer_c, "_BindingRef_size(void);")
    require_absent(consumer_c, "_BindingPoint_size(void);")
    // ...while the binding call the consumer DOES reach keeps its prototype.
    require_contains(consumer_c, "_BindingPoint_delete(BindingPoint *, Bool);")

    // Issue #326: an element walk whose per-element delete does nothing is
    // dead. `Vec.truncate`'s range is `n..self.count`, whose direction is
    // not statically known, so the typer hoists the direction test into a
    // third decl and picks between two whiles with an If -- the same dead
    // block, two decls longer, and the last shape in the corpus still
    // carrying one.
    lib_a_c := File.readfile("gen/til/library_namespace_a.c")
    require_contains(lib_a_c, "    }\n    self->count = (n);\n}")

    // Issue #326: the .c carries its own copy of the library name map --
    // one `#define <name> <prefix><name>` per exported symbol -- so that
    // what it defines lands in the library's namespace. The names come from
    // the AST, the forward header, ext.h, ext.c and every link_c source,
    // because the OTHER translation units that include the forward header
    // need them all; the emit gates then drop whatever THIS .c has no use
    // for. 230 of this library's 401 aliases renamed a name the file never
    // spells, and an alias for an absent symbol renames nothing and can
    // only capture something later.
    require_absent(lib_a_c, "#define F64_to_str til_")
    // ...while the header keeps its full map, for the translation units
    // that define what this .c does not.
    require_contains(File.readfile("gen/til/library_namespace_a_forward.h"),
                     "#define F64_to_str til_")
    // An alias the .c does spell stays.
    require_contains(lib_a_c, "#define Array__I64_clone til_")

    interpreted := Cmd.new(til_bin, "interpret", "test/library_namespace_consumer.til")
    interpreted.env("LIBRARY_PATH", "gen/lib")
    interpreted.env("LD_LIBRARY_PATH", "gen/lib")
    interpreted.env("DYLD_LIBRARY_PATH", "gen/lib")
    interpreted.run_checked()

    // Borrowed foreign places survive a cloned Context and rebuilt FFI cache
    // on each REPL turn; their address must still name the library's storage.
    File.writefile("tmp/library_namespace_repl_input",
        "lib := import(\"gen/til/library_namespace_a\")\nref w := lib.library_widths_ref()\nlib.library_set_widths(307)\nprintln(format(\"foreign-repl=\", w.second.to_str()))\nref t := lib.library_text_ref()\nlib.library_set_text()\nprintln(format(\"foreign-text=\", t))\n")
    repl := Cmd.new("sh", "-c", "bin/til < tmp/library_namespace_repl_input")
    repl.env("LIBRARY_PATH", "gen/lib")
    repl.env("LD_LIBRARY_PATH", "gen/lib")
    repl.env("DYLD_LIBRARY_PATH", "gen/lib")
    repl.capture()
    repl.run_checked()
    output := format(repl.out(), repl.err())
    require_contains(output, "foreign-repl=307")
    require_contains(output, "foreign-text=changed abroad")
    require_absent(output, "panic:")
    require_absent(output, "error:")
}
