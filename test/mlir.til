mode cli
// Opt-in LLVM 18 integration test. Not part of the tool-independent suite.
// bin/til run test/mlir.til bin/til
import("../src/std/sys")
import("../src/std/file")
realpath_str := ext_proc(path: Str) returns Str {}

priv checked := proc(command: Cmd, work: Str) {
    command.cwd(work).capture()
    status := command.run()
    expect(status == 0, command.render(), "\n", command.out(), command.err())
}

priv check_control_flow := proc(compiler: Str, work: Str) {
    File.writefile(format(work, "/flow.til"), format(
        "mode pure\nF4 := Simd(F32,4)\nCount := USize\n",
        "sum_to := func(n: Count) returns Count { mut i: Count = 0; mut total: Count = 0; while i < n { i++; if i == 2 { continue }; if i == 5 { break }; total = total + i }; return total }\n",
        "repeat := func(v: F4,n: USize) returns F4 { mut result := F4.zero(); mut i: USize = 0; while i < n { result = result + v; i++ }; return result }\n",
        "nested := func(n: USize) returns USize { mut total: USize = 0; mut i: USize = 0; while i < n { i++; mut j: USize = 0; while j < 4 { j++; if j == 2 { continue }; if j == 4 { break }; total = total + j } }; return total }\n",
        "early := func(n: I64) returns I64 { if n < 0 { return -1 } else { mut left := n; while left > 0 { if left == 3 { return 30 }; left-- }; return 0 } }\n",
        "choose := func(a: I64,b: I64) returns Bool { return a < b }\n",
        "unsigned_choice := func(a: U64,b: U64) returns Bool { return a < b }\n",
        "flip := func(a: Bool,b: Bool) returns Bool { mut result := a; if b { result = result.not() }; return result }\n",
        "combined := func(a: I64,b: I64) returns Bool { return choose(a,b) && flip(false,true) }\n",
        "float_choice := func(a: F32,b: F32) returns Bool { return a != b }\n",
        "wrap := func(a: USize) returns USize { mut result := a; result++; return result }\n",
        "snapshot := func(a: USize) returns USize { mut value := a; before := value; value++; return before }\n",
        "signed_wrap := func(a: I32) returns I32 { mut result := a; result++; return result }\n",
        "branch_local := func(a: Bool) returns I64 { mut result: I64 = 0; if a { value: I64 = 17; result = value } else { value: I64 = 23; result = value }; return result }\n",
        "shadow := func(a: Bool) returns I64 { mut value: I64 = 7; value++; mut result: I64 = 0; if a { value: I64 = 20; result = value } else { value: I64 = 30; result = value }; return value + result }\n",
        "drain := func(a: F32) returns F32 { mut value := a; while value > 0 { value = value - 1 }; return value }\n",
        "once := func(a: I64) returns I64 { while true { if a > 0 { return a }; return 0 } }\n",
        "wide_identity := func(a: I64) returns I64 { return a }\n",
        "widen_assign := func(a: I32) returns I64 { mut value: I64 = 0; value = a; return value }\n",
        "widen_return := func(a: I32) returns I64 { return a }\n",
        "widen_call := func(a: I32) returns I64 { value: I64 = a; return wide_identity(value) }\n",
        "widen_local := func(a: I32) returns I64 { value: I64 = a; return value }\n",
        "widen_unsigned := func(a: U32) returns U64 { mut value: U64 = 0; value = a; return value }\n",
        "below := func(a: USize,b: USize) returns Bool { return a < b }\n",
        "checks := func(n: USize) returns USize { mut count: USize = 0; mut i: USize = 0; while below(i,n) { i++; count++; if i == n + 3 { break } }; return count }\n"))
    checks := format(
        "main := proc() { assert_eq(USize,sum_to(0),0); assert_eq(USize,sum_to(1),1); assert_eq(USize,sum_to(4),8); assert_eq(USize,sum_to(10),8);\n",
        "assert_eq(USize,nested(3),12); assert_eq(I64,early(-7),-1); assert_eq(I64,early(2),0); assert_eq(I64,early(5),30);\n",
        "assert(choose(-1,1)); assert(unsigned_choice(18446744073709551615,1).not()); assert(combined(-1,1)); assert(combined(1,-1).not()); assert(flip(true,true).not());\n",
        "assert_eq(USize,wrap(USize.MAX),0); assert_eq(I32,signed_wrap(I32.MAX),I32.MIN); assert_eq(I64,branch_local(true),17); assert_eq(I64,branch_local(false),23);\n",
        "assert_eq(USize,checks(0),0); assert_eq(USize,checks(7),7); v := repeat(Simd(F32,4).new(1,2,3,4),3); assert(v.eq(Simd(F32,4).new(3,6,9,12)).all()); println(\"control flow PASS\") }\n")
    File.writefile(format(work, "/flow_reference.til"), format("mode cli\nimport(\"flow\")\n", checks))
    File.writefile(format(work, "/flow_caller.c"), format(
        "#include <assert.h>\n#include <stdint.h>\n#include <stdbool.h>\n#include <math.h>\n",
        "#ifdef COUNT32\ntypedef uint32_t Count;\n#else\ntypedef uint64_t Count;\n#endif\n",
        "typedef struct {float a,b,c,d;} F4;\nextern Count sum_to(Count),nested(Count),wrap(Count),checks(Count),snapshot(Count);\nextern F4 repeat(F4,Count); extern int64_t early(int64_t),branch_local(bool),shadow(bool),once(int64_t); extern int32_t signed_wrap(int32_t); extern float drain(float);\n",
        "extern bool choose(int64_t,int64_t),unsigned_choice(uint64_t,uint64_t),flip(bool,bool),combined(int64_t,int64_t),float_choice(float,float);\n",
        "extern int64_t widen_assign(int32_t),widen_return(int32_t),widen_call(int32_t),widen_local(int32_t); extern uint64_t widen_unsigned(uint32_t);\n",
        "int main(void){for(Count n=0;n<12;n++){Count expected=0; for(Count i=1;i<=n && i<5;i++){if(i!=2)expected+=i;} assert(sum_to(n)==expected);assert(nested(n)==4*n);assert(checks(n)==n); F4 v=repeat((F4){1,2,3,4},n);assert(v.a==n && v.b==2*n && v.c==3*n && v.d==4*n);}\n",
        "assert(early(-7)==-1 && early(2)==0 && early(5)==30); assert(choose(INT64_MIN,1)); assert(!choose(INT64_MAX,-1)); assert(!unsigned_choice(UINT64_MAX,1));\n",
        "assert(!flip(true,true) && flip(false,true) && flip(true,false)); assert(combined(-1,1) && !combined(1,-1)); assert(float_choice(NAN,1) && !float_choice(-0.0f,0.0f));\n",
        "assert(wrap((Count)-1)==0); assert(sum_to((Count)-1)==8); assert(snapshot((Count)-1)==(Count)-1);\n#ifndef COUNT32\nassert(wrap(UINT64_C(4294967296))==UINT64_C(4294967297));\n#endif\n",
        "assert(widen_assign(-1)==-1 && widen_return(INT32_MIN)==INT32_MIN && widen_call(-9)==-9 && widen_local(-7)==-7); assert(widen_unsigned(UINT32_MAX)==UINT64_C(4294967295));\n",
        "assert(signed_wrap(INT32_MAX)==INT32_MIN); assert(branch_local(true)==17 && branch_local(false)==23); assert(shadow(true)==28 && shadow(false)==38); assert(once(9)==9 && once(-1)==0); assert(drain(3.5f)==-0.5f && signbit(drain(-0.0f)) && isnan(drain(NAN))); assert(checks(100000)==100000); assert(nested(1000000)==4000000); return 0;}\n"))
    File.writefile(format(work, "/flow_consumer.til"), format(
        "mode cli\nlink(\"gen/lib/libflow.so\")\nF4 := Simd(F32,4)\n",
        "sum_to := ext_func(shallow n: USize) returns shallow USize {}\nnested := ext_func(shallow n: USize) returns shallow USize {}\nchecks := ext_func(shallow n: USize) returns shallow USize {}\nwrap := ext_func(shallow n: USize) returns shallow USize {}\n",
        "repeat := ext_func(shallow v: F4,shallow n: USize) returns shallow F4 {}\nearly := ext_func(shallow n: I64) returns shallow I64 {}\nsigned_wrap := ext_func(shallow n: I32) returns shallow I32 {}\n",
        "choose := ext_func(shallow a: I64,shallow b: I64) returns shallow Bool {}\nunsigned_choice := ext_func(shallow a: U64,shallow b: U64) returns shallow Bool {}\ncombined := ext_func(shallow a: I64,shallow b: I64) returns shallow Bool {}\n",
        "flip := ext_func(shallow a: Bool,shallow b: Bool) returns shallow Bool {}\nbranch_local := ext_func(shallow a: Bool) returns shallow I64 {}\n", checks))
    for width in array(Str, "32", "64") {
        width_flag := format("--usize=", width)
        for command in array(Str, "interpret", "run") {
            reference := Cmd.new(compiler, command, width_flag, "flow_reference.til")
            checked(reference, work)
        }
        for level in array(Str, "0", "2", "3") {
            build := Cmd.new(compiler, "build", "--backend=mlir", width_flag, format("--opt=", level), "flow.til")
            checked(build, work)
            cc := Cmd.new("clang-18", "-O2", "-Wall", "-Wextra", "-Werror", "flow_caller.c", "gen/lib/libflow.a", "-lm", "-o", "flow_caller")
            if width == "32" { cc.arg("-DCOUNT32") }
            checked(cc, work)
            run := Cmd.new("./flow_caller")
            checked(run, work)
            consumer := Cmd.new(compiler, "run", width_flag, "flow_consumer.til")
            checked(consumer, work)
        }
    }
}

priv check_buffers := proc(compiler: Str, work: Str) {
    File.writefile(format(work, "/buffers.til"), format(
        "mode pure\nF4 := Simd(F32,4)\n",
        "buffer_len := func(a: Array(F32)) returns USize { return a.len() }\n",
        "alias_len := func(a: Array(F32)) returns USize { ref view: Array(F32) = a; return view.len() }\n",
        "load4_checked := func(a: Array(F32), i: USize) returns F4 throws OutOfBounds { return F4.load(a,i)? }\n",
        "forward_load := func(a: Array(F32), i: USize) returns F4 throws OutOfBounds { return load4_checked(a,i)? }\n",
        "lane_checked := func(a: Array(F32), i: USize) returns F32 throws OutOfBounds { v := F4.load(a,i)?; return v[2] }\n",
        "store4_checked := func(mut a: Array(F32), i: USize, value: F4) throws OutOfBounds { value.store(a,i)? }\n",
        "read_checked := func(a: Array(F32), i: USize) returns F32 throws OutOfBounds { ref v: F32 = a.get(i)?; return v.clone() }\n",
        "write_checked := func(mut a: Array(F32), i: USize, value: F32) throws OutOfBounds { a.set(i, own value.clone())? }\n",
        "increment_checked := func(mut a: Array(F32), i: USize) throws OutOfBounds { ref mut v: F32 = a.get(i)?; v = v + 1 }\n",
        "add_buffers := func(a: Array(F32), b: Array(F32), mut out: Array(F32)) throws OutOfBounds { mut i: USize = 0; while i < a.len() { if a.len()-i >= 4 { x := F4.load(a,i)?; y := F4.load(b,i)?; sum := x+y; sum.store(out,i)?; i=i+4 } else { out.set(i,own (a.get(i)?+b.get(i)?))?; i++ } } }\n",
        "dot_buffers := func(a: Array(F32), b: Array(F32)) returns F32 throws OutOfBounds { mut sums := F4.zero(); mut i: USize = 0; while a.len()-i >= 4 { x := F4.load(a,i)?; y := F4.load(b,i)?; sums = sums+x*y; i=i+4 }; if i < a.len() { mut p0: F32=0; mut p1: F32=0; mut p2: F32=0; p0=a.get(i)?*b.get(i)?; i++; if i<a.len() { p1=a.get(i)?*b.get(i)?; i++ }; if i<a.len() { p2=a.get(i)?*b.get(i)? }; sums=sums+F4.new(p0,p1,p2,0) }; return sums.reduce_add() }\n"))
    File.writefile(format(work, "/buffer_caller.c"), format(
        "#include <assert.h>\n#include <stdint.h>\n#include <string.h>\n#include <math.h>\n",
        "#ifdef COUNT32\ntypedef uint32_t Count;\n#else\ntypedef uint64_t Count;\n#endif\n",
        "typedef struct {float *data; Count cap;} Buffer; typedef struct {float x,y,z,w;} F4;\n",
        "extern Count buffer_len(const Buffer*),alias_len(const Buffer*); extern F4 load4_checked(const Buffer*,Count,int64_t*),forward_load(const Buffer*,Count,int64_t*);\n",
        "extern void store4_checked(Buffer*,Count,F4,int64_t*),write_checked(Buffer*,Count,float,int64_t*),increment_checked(Buffer*,Count,int64_t*),add_buffers(const Buffer*,const Buffer*,Buffer*,int64_t*);\n",
        "extern float read_checked(const Buffer*,Count,int64_t*),lane_checked(const Buffer*,Count,int64_t*),dot_buffers(const Buffer*,const Buffer*,int64_t*);\n",
        "static void equal(float a,float b){if(isnan(b))assert(isnan(a));else assert(memcmp(&a,&b,4)==0);}\n",
        "static float dot(const Buffer*a,const Buffer*b){float s[4]={0};for(Count i=0;i<a->cap;i++){float p=a->data[i]*b->data[i];s[i%4]=s[i%4]+p;}return (s[0]+s[2])+(s[1]+s[3]);}\n",
        "int main(void){float aa[24],bb[24],oo[24];int64_t err=0;Buffer empty={0,0},wide={0,(Count)-1};assert(buffer_len(&wide)==(Count)-1 && alias_len(&wide)==(Count)-1);add_buffers(&empty,&empty,&empty,&err);assert(err==0);equal(dot_buffers(&empty,&empty,&err),0);assert(err==0);\n",
        "for(Count n=0;n<=17;n++){for(unsigned j=0;j<24;j++){aa[j]=(float)j*0.25f;bb[j]=3.0f-(float)j*0.125f;oo[j]=-99;}Buffer a={aa+1,n},b={bb+1,n},o={oo+1,n};float before_a[24],before_b[24];memcpy(before_a,aa,sizeof aa);memcpy(before_b,bb,sizeof bb);err=0;add_buffers(&a,&b,&o,&err);assert(err==0);for(Count i=0;i<n;i++)equal(o.data[i],a.data[i]+b.data[i]);equal(oo[0],-99);equal(oo[n+1],-99);equal(dot_buffers(&a,&b,&err),dot(&a,&b));assert(err==0);assert(memcmp(aa,before_a,sizeof aa)==0 && memcmp(bb,before_b,sizeof bb)==0);}\n",
        "Buffer a={aa+1,8},o={oo+1,8};Count starts[]={0,1,4,5,8,9,(Count)-1,(Count)-2,(Count)-3,(Count)-4};F4 value={7,8,9,10};\n",
        "for(unsigned k=0;k<sizeof starts/sizeof starts[0];k++){Count i=starts[k];int good=i<=8 && 8-i>=4;err=0;F4 got=forward_load(&a,i,&err);assert(err==(good?0:1));if(good)assert(memcmp(&got,a.data+i,16)==0);for(unsigned j=0;j<24;j++)oo[j]=-99;float before[24];memcpy(before,oo,sizeof oo);err=0;store4_checked(&o,i,value,&err);assert(err==(good?0:1));if(good){memcpy(before+1+i,&value,16);}assert(memcmp(before,oo,sizeof oo)==0);err=0;float scalar=read_checked(&a,i,&err);assert(err==(i<8?0:1));if(i<8)equal(scalar,a.data[i]);err=0;write_checked(&o,i,23,&err);assert(err==(i<8?0:1));}\n",
        "err=0;equal(lane_checked(&a,1,&err),a.data[3]);assert(err==0);err=0;lane_checked(&empty,0,&err);assert(err==1);\n",
        "err=0;load4_checked(&empty,0,&err);assert(err==1);err=0;read_checked(&empty,0,&err);assert(err==1);err=0;store4_checked(&empty,(Count)-1,value,&err);assert(err==1);err=0;write_checked(&empty,0,1,&err);assert(err==1);\n",
        "const uint32_t bits[4]={0x7f800001u,0xffc12345u,0x80000000u,1u};memcpy(aa+1,bits,16);err=0;F4 raw=load4_checked(&a,0,&err);assert(err==0 && memcmp(&raw,bits,16)==0);store4_checked(&o,1,raw,&err);assert(err==0 && memcmp(o.data+1,bits,16)==0);float single=read_checked(&a,0,&err);assert(memcmp(&single,bits,4)==0);\n",
        "float cancel[5]={1e20f,1,-1e20f,3,0},ones[5]={1,1,1,1,1};Buffer c={cancel,5},one={ones,5};err=0;equal(dot_buffers(&c,&one,&err),4);assert(err==0);\n",
        "for(unsigned j=0;j<24;j++){aa[j]=(float)j;bb[j]=1;oo[j]=-99;}Buffer long_a={aa+1,9},small_b={bb+1,4},long_o={oo+1,9};err=0;add_buffers(&long_a,&small_b,&long_o,&err);assert(err==1);for(unsigned j=0;j<9;j++)equal(long_o.data[j],j<4?long_a.data[j]+1:-99);\n",
        "for(unsigned j=0;j<24;j++)oo[j]=-99;\nlong_a.cap=5;err=0;add_buffers(&long_a,&small_b,&long_o,&err);assert(err==1);equal(long_o.data[4],-99);err=0;dot_buffers(&long_a,&small_b,&err);assert(err==1);\n",
        "Buffer b={bb+1,9};long_a.cap=9;long_o.cap=6;for(unsigned j=0;j<24;j++)oo[j]=-99;err=0;add_buffers(&long_a,&b,&long_o,&err);assert(err==1);equal(oo[5],-99);equal(oo[6],-99);\n",
        "err=0;increment_checked(&long_a,1,&err);assert(err==0);equal(long_a.data[1],3);err=0;increment_checked(&empty,0,&err);assert(err==1);\n",
        "float old[9];memcpy(old,long_a.data,sizeof old);err=0;add_buffers(&long_a,&b,&long_a,&err);assert(err==0);for(unsigned j=0;j<9;j++)equal(long_a.data[j],old[j]+1);\n",
        "float overlap[12],expected[12],first[4];for(unsigned j=0;j<12;j++){overlap[j]=(float)j;expected[j]=(float)j;}for(unsigned j=0;j<4;j++){first[j]=expected[j]+1;}memcpy(expected+1,first,16);for(unsigned j=4;j<7;j++){expected[j+1]=expected[j]+1;}Buffer source={overlap,7},shifted={overlap+1,7};err=0;add_buffers(&source,&b,&shifted,&err);assert(err==0 && memcmp(overlap,expected,sizeof overlap)==0);return 0;}\n"))
    checks := format(
        "main := proc() { for n in 0..10 { mut a := Array(F32).new(n.to_usize()); mut b := Array(F32).new(n.to_usize()); mut out := Array(F32).new(n.to_usize()+1); for i in 0..n { a.set(i.to_usize(),own (i+1).to_f32())!; b.set(i.to_usize(),own 2.0)! }; out.set(n.to_usize(),own -99.0)!; add_buffers(a,b,out)!; mut expected: F32=0; for i in 0..n { assert_eq(F32,out[i.to_usize()],(i+3).to_f32()); expected=expected+(i+1).to_f32()*2 }; assert_eq(F32,out[n.to_usize()],-99); assert_eq(F32,dot_buffers(a,b)!,expected) };\n",
        "a := array(F32,1,2,3,4,5); b := array(F32,2,2,2,2); mut out := Array(F32).new(5); out.set(4,own -99.0)!; mut caught:=false; add_buffers(a,b,out)? catch(err:OutOfBounds){caught=true}; assert(caught); assert_eq(F32,out[0],3); assert_eq(F32,out[4],-99);\n",
        "mut range_error:=false; load4_checked(a,USize.MAX)? catch(err:OutOfBounds){range_error=true}; assert(range_error); println(\"buffers PASS\") }\n")
    File.writefile(format(work, "/buffer_reference.til"), format("mode cli\nimport(\"buffers\")\n", checks))
    File.writefile(format(work, "/buffer_consumer.til"), format(
        "mode cli\nlink(\"gen/lib/libbuffers.so\")\nF4:=Simd(F32,4)\n",
        "add_buffers := ext_func(a: Array(F32),b: Array(F32),mut out: Array(F32)) throws OutOfBounds {}\n",
        "dot_buffers := ext_func(a: Array(F32),b: Array(F32)) returns shallow F32 throws OutOfBounds {}\n",
        "load4_checked := ext_func(a: Array(F32),shallow i: USize) returns shallow F4 throws OutOfBounds {}\n", checks))
    for width in array(Str, "32", "64") {
        flag := format("--usize=", width)
        for command in array(Str, "interpret", "run") {
            reference := Cmd.new(compiler, command, flag, "buffer_reference.til")
            checked(reference, work)
        }
        for level in array(Str, "0", "2", "3") {
            build := Cmd.new(compiler, "build", "--backend=mlir", flag, format("--opt=", level), "buffers.til")
            checked(build, work)
            cc := Cmd.new("clang-18", "-O2", "-ffp-contract=off", "-Wall", "-Wextra", "-Werror", "buffer_caller.c", "gen/lib/libbuffers.a", "-lm", "-o", "buffer_caller")
            if width == "32" { cc.arg("-DCOUNT32") }
            checked(cc, work)
            run := Cmd.new("./buffer_caller")
            checked(run, work)
            consumer := Cmd.new(compiler, "run", flag, "--asan", "buffer_consumer.til")
            checked(consumer, work)
        }
    }
}

priv check_integer_vectors := proc(compiler: Str, work: Str) {
    mut source := "mode pure\nS4:=Simd(I32,4)\nU4:=Simd(U32,4)\nM4:=Simd(Bool,4)\nF4:=Simd(F32,4)\n"
    mut declarations := "#include <assert.h>\n#include <stdint.h>\n#include <string.h>\n#ifdef COUNT32\ntypedef uint32_t Count;\n#else\ntypedef uint64_t Count;\n#endif\ntypedef struct{int32_t v[4];}S4;typedef struct{uint32_t v[4];}U4;typedef struct{uint8_t v[4];}M4;typedef struct{float v[4];}F4;typedef struct{void *data;Count cap;}Buffer;\n"
    for element in array(Str, "I32", "U32") {
        mut prefix := "s_"; mut vector := "S4"; mut cscalar := "int32_t"
        if element=="U32" { prefix="u_"; vector="U4"; cscalar="uint32_t" }
        for op in array(Str, "add", "sub", "mul", "div", "band", "bor", "bxor", "eq", "neq", "lt", "lte", "gt", "gte") {
            mut result := vector.clone()
            if op=="eq" || op=="neq" || op=="lt" || op=="lte" || op=="gt" || op=="gte" { result="M4" }
            source=format(source,prefix,op,":=func(a:",vector,",b:",vector,") returns ",result," {return a.",op,"(b)}\n")
            declarations=format(declarations,"extern ",result," ",prefix,op,"(",vector,",",vector,");\n")
        }
        source=format(source,
            prefix,"new:=func(a:",element,",b:",element,",c:",element,",d:",element,") returns ",vector," {return ",vector,".new(a,b,c,d)}\n",
            prefix,"splat:=func(a:",element,") returns ",vector," {return ",vector,".splat(a)}\n",
            prefix,"zero:=func() returns ",vector," {return ",vector,".zero()}\n",
            prefix,"bnot:=func(a:",vector,") returns ",vector," {return a.bnot()}\n",
            prefix,"sum:=func(a:",vector,") returns ",element," {return a.reduce_add()}\n",
            prefix,"select:=func(m:M4,a:",vector,",b:",vector,") returns ",vector," {return ",vector,".select(m,a,b)}\n",
            prefix,"forward:=func(a:",vector,",b:",vector,") returns ",vector," {return ",prefix,"add(",prefix,"sub(a,b),b)}\n",
            prefix,"three:=func(a:",vector,",b:",vector,",c:",vector,") returns ",vector," {return a+b+c}\n",
            prefix,"mixed:=func(x:",element,",a:",vector,",pick:Bool,b:",vector,") returns ",vector," {mut v:=b.clone();if pick {v=a.clone()};v.set(0,own x)!;return v}\n",
            prefix,"float_mix:=func(a:",vector,",f:F4,b:",vector,") returns ",vector," {if f[0]>0 {return a+b};return a-b}\n",
            prefix,"lane:=func(a:",vector,",i:USize) returns ",element," throws OutOfBounds {return a.get(i)?}\n",
            prefix,"set:=func(a:",vector,",i:USize,x:",element,") returns ",vector," {mut v:=a.clone();v.set(i,own x)? catch(err:OutOfBounds){};return v}\n",
            prefix,"load:=func(a:Array(",element,"),i:USize) returns ",vector," throws OutOfBounds {return ",vector,".load(a,i)?}\n",
            prefix,"store:=func(mut a:Array(",element,"),i:USize,v:",vector,") throws OutOfBounds {v.store(a,i)?}\n",
            prefix,"read:=func(a:Array(",element,"),i:USize) returns I64 throws OutOfBounds {ref value:",element,"=a.get(i)?;return value.clone()}\n",
            prefix,"write:=func(mut a:Array(",element,"),i:USize,x:",element,") throws OutOfBounds {a.set(i,own x)?}\n",
            prefix,"increment:=func(mut a:Array(",element,"),i:USize) throws OutOfBounds {ref mut value:",element,"=a.get(i)?;value=value+1}\n")
        declarations=format(declarations,
            "extern ",vector," ",prefix,"new(",cscalar,",",cscalar,",",cscalar,",",cscalar,"),",prefix,"splat(",cscalar,"),",prefix,"zero(void),",prefix,"bnot(",vector,"),",prefix,"select(M4,",vector,",",vector,"),",prefix,"forward(",vector,",",vector,"),",prefix,"three(",vector,",",vector,",",vector,"),",prefix,"mixed(",cscalar,",",vector,",uint8_t,",vector,"),",prefix,"float_mix(",vector,",F4,",vector,"),",prefix,"set(",vector,",Count,",cscalar,"),",prefix,"load(Buffer*,Count,int64_t*);\n",
            "extern ",cscalar," ",prefix,"sum(",vector,"),",prefix,"lane(",vector,",Count,int64_t*);extern int64_t ",prefix,"read(Buffer*,Count,int64_t*);extern void ",prefix,"store(Buffer*,Count,",vector,",int64_t*),",prefix,"write(Buffer*,Count,",cscalar,",int64_t*),",prefix,"increment(Buffer*,Count,int64_t*);\n")
    }
    File.writefile(format(work,"/integer_simd.til"),source)
    File.writefile(format(work,"/integer_caller.c"),format(declarations,
        "static void bits(S4 s,U4 u){assert(memcmp(&s,&u,16)==0);}\nint main(void){const uint32_t p[]={0,1,0xffffffff,0x80000000,0x7fffffff,0x80000001,0xfffffff0,65537,0xa5a5a5a5};for(unsigned i=0;i<9;i++)for(unsigned j=0;j<9;j++){U4 a,b;for(unsigned k=0;k<4;k++){a.v[k]=p[(i+k)%9];b.v[k]=p[(j+k*2)%9];}S4 sa,sb;memcpy(&sa,&a,16);memcpy(&sb,&b,16);U4 add=u_add(a,b),sub=u_sub(a,b),mul=u_mul(a,b),div=u_div(a,b),and=u_band(a,b),or=u_bor(a,b),xor=u_bxor(a,b),not=u_bnot(a),sd;S4 signed_div=s_div(sa,sb);memcpy(&sd,&signed_div,16);uint32_t sum=0;for(unsigned k=0;k<4;k++){assert(add.v[k]==a.v[k]+b.v[k]);assert(sub.v[k]==a.v[k]-b.v[k]);assert(mul.v[k]==(uint32_t)((uint64_t)a.v[k]*b.v[k]));assert(div.v[k]==(b.v[k]?a.v[k]/b.v[k]:0));assert(sd.v[k]==(sb.v[k]?(uint32_t)((int64_t)sa.v[k]/sb.v[k]):0));assert(and.v[k]==(a.v[k]&b.v[k]) && or.v[k]==(a.v[k]|b.v[k]) && xor.v[k]==(a.v[k]^b.v[k]) && not.v[k]==~a.v[k]);sum+=a.v[k];}bits(s_add(sa,sb),add);bits(s_sub(sa,sb),sub);bits(s_mul(sa,sb),mul);bits(s_band(sa,sb),and);bits(s_bor(sa,sb),or);bits(s_bxor(sa,sb),xor);bits(s_bnot(sa),not);assert(u_sum(a)==sum && (uint32_t)s_sum(sa)==sum);bits(s_forward(sa,sb),a);U4 uf=u_forward(a,b);assert(memcmp(&uf,&a,16)==0);\n",
        "M4 se=s_eq(sa,sb),sn=s_neq(sa,sb),sl=s_lt(sa,sb),sle=s_lte(sa,sb),sg=s_gt(sa,sb),sge=s_gte(sa,sb),ue=u_eq(a,b),un=u_neq(a,b),ul=u_lt(a,b),ule=u_lte(a,b),ug=u_gt(a,b),uge=u_gte(a,b);for(unsigned k=0;k<4;k++){assert(se.v[k]==(sa.v[k]==sb.v[k]) && sn.v[k]==(sa.v[k]!=sb.v[k]) && sl.v[k]==(sa.v[k]<sb.v[k]) && sle.v[k]==(sa.v[k]<=sb.v[k]) && sg.v[k]==(sa.v[k]>sb.v[k]) && sge.v[k]==(sa.v[k]>=sb.v[k]));assert(ue.v[k]==(a.v[k]==b.v[k]) && un.v[k]==(a.v[k]!=b.v[k]) && ul.v[k]==(a.v[k]<b.v[k]) && ule.v[k]==(a.v[k]<=b.v[k]) && ug.v[k]==(a.v[k]>b.v[k]) && uge.v[k]==(a.v[k]>=b.v[k]));}\n",
        "for(unsigned pattern=0;pattern<16;pattern++){M4 m;for(unsigned k=0;k<4;k++)m.v[k]=(pattern>>k)&1;U4 r=u_select(m,a,b);for(unsigned k=0;k<4;k++)assert(r.v[k]==(m.v[k]?a.v[k]:b.v[k]));bits(s_select(m,sa,sb),r);}U4 three=u_three(a,b,a);for(unsigned k=0;k<4;k++)assert(three.v[k]==a.v[k]+b.v[k]+a.v[k]);bits(s_three(sa,sb,sa),three);for(unsigned pick=0;pick<2;pick++){U4 mixed=u_mixed(0x80000000,a,pick,b);assert(mixed.v[0]==0x80000000);for(unsigned k=1;k<4;k++)assert(mixed.v[k]==(pick?a.v[k]:b.v[k]));bits(s_mixed(INT32_MIN,sa,pick,sb),mixed);F4 f={{(float)pick,0,0,0}};U4 r=u_float_mix(a,f,b);assert(memcmp(&r,pick?&add:&sub,16)==0);bits(s_float_mix(sa,f,sb),r);}\n",
        "U4 made=u_new(a.v[0],a.v[1],a.v[2],a.v[3]);assert(memcmp(&made,&a,16)==0);bits(s_new(sa.v[0],sa.v[1],sa.v[2],sa.v[3]),a);U4 spl=u_splat(a.v[0]);bits(s_splat(sa.v[0]),spl);for(unsigned k=0;k<4;k++)assert(spl.v[k]==a.v[0]);const Count indices[]={0,1,2,3,4,(Count)-1};for(unsigned q=0;q<6;q++){Count k=indices[q];int64_t err=0;uint32_t lane=u_lane(a,k,&err);assert(err==(k>=4));if(k<4)assert(lane==a.v[k]);err=0;int32_t si=s_lane(sa,k,&err);assert(err==(k>=4));if(k<4)assert(si==sa.v[k]);U4 r=u_set(a,k,0xffffffff);bits(s_set(sa,k,-1),r);for(unsigned n=0;n<4;n++)assert(r.v[n]==(n==k?0xffffffff:a.v[n]));}}\n",
        "U4 zero=u_zero();S4 sz=s_zero();uint32_t zeros[4]={0};assert(memcmp(&zero,zeros,16)==0 && memcmp(&sz,zeros,16)==0);uint32_t storage[12],out[12],before[12];for(unsigned k=0;k<12;k++){storage[k]=0x80000000+k;out[k]=0xfeedface;}Buffer input={storage+1,8},output={out+1,8},empty={0,0};const Count starts[]={0,1,4,5,8,(Count)-1};for(unsigned q=0;q<6;q++){Count i=starts[q];int good=i<=8 && 8-i>=4;int64_t err=0;U4 v=u_load(&input,i,&err);assert(err==!good);if(good)assert(memcmp(&v,storage+1+i,16)==0);err=0;S4 sv=s_load(&input,i,&err);assert(err==!good);if(good)assert(memcmp(&sv,storage+1+i,16)==0);memcpy(before,out,sizeof out);err=0;u_store(&output,i,u_splat(7),&err);assert(err==!good);if(good)for(unsigned k=0;k<4;k++)before[1+i+k]=7;assert(memcmp(before,out,sizeof out)==0);memcpy(before,out,sizeof out);err=0;s_store(&output,i,s_splat(-7),&err);assert(err==!good);if(good)for(unsigned k=0;k<4;k++)before[1+i+k]=(uint32_t)-7;assert(memcmp(before,out,sizeof out)==0);err=0;int64_t sr=s_read(&input,i,&err);assert(err==(i>=8));if(i<8)assert(sr==(int32_t)storage[1+i]);err=0;int64_t ur=u_read(&input,i,&err);assert(err==(i>=8));if(i<8)assert(ur==storage[1+i]);}\n",
        "int64_t err=0;s_load(&empty,0,&err);assert(err==1);err=0;u_load(&empty,(Count)-1,&err);assert(err==1);err=0;s_write(&output,0,-1,&err);assert(err==0 && out[1]==0xffffffff);s_increment(&output,0,&err);assert(err==0 && out[1]==0);u_write(&output,0,0xffffffff,&err);u_increment(&output,0,&err);assert(err==0 && out[1]==0);memcpy(before,out,sizeof out);err=0;u_write(&output,(Count)-1,1,&err);assert(err==1 && memcmp(before,out,sizeof out)==0);return 0;}\n"))
    checks := "main:=proc(){a:=s_new(I32.MIN,I32.MAX,-1,0);b:=s_new(-1,1,0,1);d:=s_div(a,b);assert_eq(I32,s_lane(d,0)!,I32.MIN);assert_eq(I32,s_lane(d,2)!,0);added:=s_add(a,b);assert_eq(I32,s_lane(added,1)!,I32.MIN);u:=u_new(U32.MAX,0,1,2147483648);v:=u_splat(1);q:=u_add(u,v);assert_eq(U32,u_lane(q,0)!,0);sum:=u_sum(u);assert_eq(U32,sum,2147483648);mut input:=array(I32,-1,-2,3,4,5);assert_eq(I64,s_read(input,0)!,-1);loaded:=s_load(input,1)!;assert_eq(I32,s_lane(loaded,0)!,-2);s_store(input,0,a)!;assert_eq(I32,input[0],I32.MIN);mut caught:=false;s_load(input,USize.MAX)? catch(err:OutOfBounds){caught=true};assert(caught);println(\"integer SIMD PASS\")}\n"
    File.writefile(format(work,"/integer_reference.til"),format("mode cli\nimport(\"integer_simd\")\n",checks))
    File.writefile(format(work,"/integer_consumer.til"),format(
        "mode cli\nlink(\"gen/lib/libinteger_simd.so\")\nS4:=Simd(I32,4)\nU4:=Simd(U32,4)\n",
        "s_new:=ext_func(shallow a:I32,shallow b:I32,shallow c:I32,shallow d:I32) returns shallow S4 {}\ns_div:=ext_func(shallow a:S4,shallow b:S4) returns shallow S4 {}\ns_add:=ext_func(shallow a:S4,shallow b:S4) returns shallow S4 {}\ns_lane:=ext_func(shallow a:S4,shallow i:USize) returns shallow I32 throws OutOfBounds {}\n",
        "u_new:=ext_func(shallow a:U32,shallow b:U32,shallow c:U32,shallow d:U32) returns shallow U4 {}\nu_splat:=ext_func(shallow a:U32) returns shallow U4 {}\nu_add:=ext_func(shallow a:U4,shallow b:U4) returns shallow U4 {}\nu_lane:=ext_func(shallow a:U4,shallow i:USize) returns shallow U32 throws OutOfBounds {}\nu_sum:=ext_func(shallow a:U4) returns shallow U32 {}\n",
        "s_read:=ext_func(a:Array(I32),shallow i:USize) returns shallow I64 throws OutOfBounds {}\ns_load:=ext_func(a:Array(I32),shallow i:USize) returns shallow S4 throws OutOfBounds {}\ns_store:=ext_func(mut a:Array(I32),shallow i:USize,shallow v:S4) throws OutOfBounds {}\n",checks))
    for width in array(Str,"32","64") {
        flag:=format("--usize=",width)
        for command in array(Str,"interpret","run") { reference:=Cmd.new(compiler,command,flag,"integer_reference.til");checked(reference,work) }
        for level in array(Str,"0","2","3") {
            build:=Cmd.new(compiler,"build","--backend=mlir",flag,format("--opt=",level),"integer_simd.til");checked(build,work)
            cc:=Cmd.new("clang-18","-O2","-fsanitize=address","-Wall","-Wextra","-Werror","integer_caller.c","gen/lib/libinteger_simd.a","-lm","-o","integer_caller")
            if width=="32" {cc.arg("-DCOUNT32")};checked(cc,work)
            native:=Cmd.new("./integer_caller");checked(native,work)
            consumer:=Cmd.new(compiler,"run","--asan",flag,"integer_consumer.til");checked(consumer,work)
        }
    }
}

priv check_runtime := proc(compiler: Str, work: Str) {
    File.writefile(format(work, "/runtime_strings.til"), format(
        "mode lib\n",
        "decorate:=func(s:Str) returns Str { return format(\"[\",s,\"]\") }\n",
        "literal:=func() returns Str { return \"literal\" }\n",
        "consume:=func(own s:Str) returns USize { return s.len() }\n",
        "owned_length:=func(s:Str) returns USize { temp:=decorate(s); return consume(own temp) }\n",
        "replace:=func(s:Str) returns Str { mut out:=s.clone(); out=format(out,\"!\"); return out }\n",
        "pass_owned:=func(own s:Str) returns Str { return s }\nroundtrip:=func(s:Str) returns Str { copy:=s.clone(); return pass_owned(own copy) }\n",
        "append:=func(mut s:Str) { s.push_str(\"!\") }\n"))
    checks := "main:=proc(){mut s:=Str.with_capacity(64);s.push_str(\"one\");println(decorate(s));append(s);println(s);s=replace(s);println(s);println(owned_length(s).to_str());print(\"A\\0B\\t\\\"\\\\\");print_flush();eprint_single(\"stderr\\n\");println(literal());}\n"
    File.writefile(format(work, "/runtime_reference.til"), format("mode cli\nimport(\"runtime_strings\")\n", checks))
    File.writefile(format(work, "/runtime_local.til"), format(
        "mode cli\n",
        "decorate:=func(s:Str) returns Str {return format(\"[\",s,\"]\")}\n",
        "literal:=func() returns Str {return \"literal\"}\n",
        "consume:=func(own s:Str) returns USize {return s.len()}\n",
        "owned_length:=func(s:Str) returns USize {temp:=decorate(s);return consume(own temp)}\n",
        "replace:=func(s:Str) returns Str {mut out:=s.clone();out=format(out,\"!\");return out}\n",
        "append:=func(mut s:Str){s.push_str(\"!\")}\n", checks))
    File.writefile(format(work, "/runtime_consumer.til"), format(
        "mode cli\nlink(\"gen/lib/libruntime_strings.so\")\n",
        "decorate:=ext_func(s:Str) returns shallow Str {}\nliteral:=ext_func() returns shallow Str {}\n",
        "replace:=ext_func(s:Str) returns shallow Str {}\nowned_length:=ext_func(s:Str) returns shallow USize {}\nappend:=ext_func(mut s:Str) {}\n", checks))
    File.writefile(format(work, "/runtime_caller.c"), format(
        "#include <assert.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#ifdef COUNT32\ntypedef uint32_t Count;\n#else\ntypedef uint64_t Count;\n#endif\n",
        "typedef struct{char *data;Count count,cap;}Str;extern Str decorate(Str*),replace(Str*),roundtrip(Str*),literal(void);extern Count owned_length(Str*);extern void append(Str*);\n",
        "int main(void){char input[32]=\"a\\0b\";Str s={input,3,31};for(int i=0;i<1000;i++){Str r=decorate(&s);assert(r.count==5 && memcmp(r.data,\"[a\\0b]\",5)==0);free(r.data);r=replace(&s);assert(r.count==4 && memcmp(r.data,\"a\\0b!\",4)==0);free(r.data);r=roundtrip(&s);assert(r.count==3 && memcmp(r.data,input,3)==0);free(r.data);assert(owned_length(&s)==5);r=literal();assert(r.count==7 && r.cap==(Count)-2 && memcmp(r.data,\"literal\",7)==0);}append(&s);assert(s.count==4 && input[3]=='!');return 0;}\n"))
    File.writefile(format(work, "/runtime_panic.til"), "mode cli\nmain:=proc(){mut s:=Str.with_capacity(8);s.push_str(\"boom\");panic(\"user \",s,\"!\")}\n")
    for width in array(Str, "32", "64") {
        flag := format("--usize=", width)
        reference := Cmd.new(compiler, "run", flag, "runtime_reference.til")
        checked(reference, work)
        interpreted := Cmd.new(compiler, "interpret", flag, "runtime_reference.til")
        checked(interpreted, work)
        assert_eq(Str, interpreted.out(), reference.out())
        assert_eq(Str, interpreted.err(), reference.err())
        panic_reference := Cmd.new(compiler, "run", flag, "runtime_panic.til")
        panic_reference.cwd(work).capture()
        panic_status := panic_reference.run()
        expect(panic_status==1, panic_reference.out(), panic_reference.err())
        for level in array(Str, "0", "2", "3") {
            build := Cmd.new(compiler, "build", "--backend=mlir", flag, format("--opt=",level), "runtime_strings.til")
            checked(build, work)
            cc := Cmd.new("clang-18", "-O2", "-fsanitize=address", "-Wall", "-Wextra", "-Werror", "runtime_caller.c", "gen/lib/libruntime_strings.a", "-lm", "-o", "runtime_caller")
            if width=="32" {cc.arg("-DCOUNT32")}
            checked(cc, work)
            native := Cmd.new("./runtime_caller")
            checked(native, work)
            consumer := Cmd.new(compiler, "run", "--asan", flag, "runtime_consumer.til")
            checked(consumer, work)
            assert_eq(Str, consumer.out(), reference.out())
            assert_eq(Str, consumer.err(), reference.err())
            local := Cmd.new(compiler, "run", "--backend=mlir", flag, format("--opt=",level), "runtime_local.til")
            checked(local, work)
            assert_eq(Str, local.out(), reference.out())
            assert_eq(Str, local.err(), reference.err())
            failure := Cmd.new(compiler, "run", "--backend=mlir", flag, format("--opt=",level), "runtime_panic.til")
            failure.cwd(work).capture()
            status := failure.run()
            expect(status==1, failure.out(), failure.err())
            assert_eq(Str, failure.out(), panic_reference.out())
            assert_eq(Str, failure.err(), panic_reference.err())
        }
    }
}

priv check_float_arithmetic := proc(compiler: Str, work: Str) {
    File.writefile(format(work, "/float_arithmetic.til"), format(
        "mode pure\nF4:=Simd(F32,4)\n",
        "divide:=func(a:F32,b:F32) returns F32 { return a/b }\n",
        "divide4:=func(a:F4,b:F4) returns F4 { return a/b }\n",
        "fused:=func(a:F32,b:F32,c:F32) returns F32 { return a.fma(b,c) }\n",
        "fused4:=func(a:F4,b:F4,c:F4) returns F4 { return a.fma(b,c) }\n",
        "separate:=func(a:F32,b:F32,c:F32) returns F32 { return a*b+c }\n",
        "separate4:=func(a:F4,b:F4,c:F4) returns F4 { return a*b+c }\n",
        "broadcast:=func(a:F32) returns F4 { return F4.splat(a) }\n",
        "priv step:=func(mut trace:Array(F32),value:F32,digit:F32) returns F32 throws OutOfBounds { ref old:F32=trace.get(0)?; trace.set(0,own (old*10+digit))?; return value }\n",
        "ordered_fma:=func(mut trace:Array(F32)) returns F32 throws OutOfBounds { return step(trace,4097,1)?.fma(step(trace,4097,2)?,step(trace,-16785408,3)?) }\n",
        "ordered_div:=func(mut trace:Array(F32)) returns F32 throws OutOfBounds { return step(trace,6,1)?/step(trace,2,2)? }\n"))
    File.writefile(format(work, "/float_caller.c"), format(
        "#include <assert.h>\n#include <stdint.h>\n#include <string.h>\n#include <math.h>\n#ifdef COUNT32\ntypedef uint32_t Count;\n#else\ntypedef uint64_t Count;\n#endif\n",
        "typedef struct{float v[4];}F4;typedef struct{float *data;Count cap;}Buffer;extern float divide(float,float),fused(float,float,float),separate(float,float,float),ordered_fma(Buffer*,int64_t*),ordered_div(Buffer*,int64_t*);extern F4 divide4(F4,F4),fused4(F4,F4,F4),separate4(F4,F4,F4);\n",
        "static void same(float a,float b){if(isnan(b))assert(isnan(a));else assert(memcmp(&a,&b,4)==0);}\n",
        "int main(void){const float v[]={0.0f,-0.0f,1,-1,INFINITY,-INFINITY,NAN,0x1p-149f,0x1p-126f,0x1.fffffep127f,4097,-16785408};\n",
        "for(unsigned i=0;i<12;i++)for(unsigned j=0;j<12;j++){same(divide(v[i],v[j]),v[i]/v[j]);F4 a,b;for(unsigned n=0;n<4;n++){a.v[n]=v[(i+n)%12];b.v[n]=v[(j+n*2)%12];}F4 q=divide4(a,b);for(unsigned n=0;n<4;n++)same(q.v[n],a.v[n]/b.v[n]);for(unsigned k=0;k<12;k++){same(fused(v[i],v[j],v[k]),fmaf(v[i],v[j],v[k]));float product=v[i]*v[j];same(separate(v[i],v[j],v[k]),product+v[k]);F4 c;for(unsigned n=0;n<4;n++)c.v[n]=v[(k+n)%12];F4 f=fused4(a,b,c),s=separate4(a,b,c);for(unsigned n=0;n<4;n++){same(f.v[n],fmaf(a.v[n],b.v[n],c.v[n]));float p=a.v[n]*b.v[n];same(s.v[n],p+c.v[n]);}}}\n",
        "same(fused(4097,4097,-16785408),1);same(separate(4097,4097,-16785408),0);float trace=0;Buffer b={&trace,1},empty={0,0};int64_t error=0;same(ordered_fma(&b,&error),1);assert(error==0 && trace==123);trace=0;same(ordered_div(&b,&error),3);assert(error==0 && trace==12);ordered_fma(&empty,&error);assert(error==1);return 0;}\n"))
    checks := "main:=proc(){mut seed:F32=4097;seed=seed+0;assert_eq(F32,fused(seed,seed,-16785408),1);assert_eq(F32,separate(seed,seed,-16785408),0);a:=broadcast(seed);c:=broadcast(-16785408);f:=fused4(a,a,c);s:=separate4(a,a,c);assert_eq(F32,f[2],1);assert_eq(F32,s[2],0);q:=divide4(broadcast(6),broadcast(2));assert_eq(F32,q[3],3);positive:=divide(1,0);negative:=divide(1,-0.0);nan:=divide(0,0);assert(positive>1e30);assert(negative< -1e30);assert(nan!=nan);println(\"float arithmetic PASS\") }\n"
    File.writefile(format(work, "/float_reference.til"), format("mode cli\nimport(\"float_arithmetic\")\n", checks))
    File.writefile(format(work, "/float_consumer.til"), format(
        "mode cli\nlink(\"gen/lib/libfloat_arithmetic.so\")\nF4:=Simd(F32,4)\n",
        "divide:=ext_func(shallow a:F32,shallow b:F32) returns shallow F32 {}\nfused:=ext_func(shallow a:F32,shallow b:F32,shallow c:F32) returns shallow F32 {}\nseparate:=ext_func(shallow a:F32,shallow b:F32,shallow c:F32) returns shallow F32 {}\n",
        "divide4:=ext_func(shallow a:F4,shallow b:F4) returns shallow F4 {}\nfused4:=ext_func(shallow a:F4,shallow b:F4,shallow c:F4) returns shallow F4 {}\nseparate4:=ext_func(shallow a:F4,shallow b:F4,shallow c:F4) returns shallow F4 {}\nbroadcast:=ext_func(shallow a:F32) returns shallow F4 {}\n", checks))
    File.writefile(format(work, "/float_main.til"), "mode cli\nF4:=Simd(F32,4)\nmain:=proc(){mut a:F32=4097;a=a+0;if a.fma(a,-16785408)!=1 { F4.zero().get(4)! }}\n")
    for width in array(Str, "32", "64") {
        flag := format("--usize=", width)
        for command in array(Str, "interpret", "run") {
            reference := Cmd.new(compiler, command, flag, "float_reference.til")
            checked(reference, work)
        }
        for level in array(Str, "0", "2", "3") {
            build := Cmd.new(compiler, "build", "--backend=mlir", "--cpu=baseline", flag, format("--opt=", level), "float_arithmetic.til")
            checked(build, work)
            cc := Cmd.new("clang-18", "-O2", "-ffp-contract=off", "-Wall", "-Wextra", "-Werror", "float_caller.c", "gen/lib/libfloat_arithmetic.a", "-lm", "-o", "float_caller")
            if width=="32" { cc.arg("-DCOUNT32") }
            checked(cc, work)
            native := Cmd.new("./float_caller")
            checked(native, work)
            consumer := Cmd.new(compiler, "run", "--asan", flag, "float_consumer.til")
            checked(consumer, work)
            executable := Cmd.new(compiler, "run", "--backend=mlir", "--cpu=baseline", flag, format("--opt=", level), "float_main.til")
            checked(executable, work)
        }
    }
}

priv check_lanes := proc(compiler: Str, work: Str) {
    File.writefile(format(work, "/lanes.til"), format(
        "mode pure\nF4:=Simd(F32,4)\nM4:=Simd(Bool,4)\n",
        "make_float:=func() returns F4 { return F4.new(1,2,3,4) }\nmake_mask:=func() returns M4 { return M4.new(true,false,true,false) }\n",
        "read_float:=func(a:F4,i:USize) returns F32 throws OutOfBounds { return a.get(i)? }\n",
        "read_mask:=func(a:M4,i:USize) returns Bool throws OutOfBounds { return a.get(i)? }\n",
        "write_float:=func(a:F4,i:USize,x:F32) returns F4 { mut v:=a.clone(); v.set(0,own 17)!; v.set(i,own x)? catch(err:OutOfBounds){}; return v }\n",
        "write_mask:=func(a:M4,i:USize,x:Bool) returns M4 { mut v:=a.clone(); v.set(0,own true)!; v.set(i,own x)? catch(err:OutOfBounds){}; return v }\n",
        "bang_float:=func(a:F4,i:USize) returns F32 { return a.get(i)! }\n",
        "bang_mask:=func(a:M4,i:USize) returns Bool { return a.get(i)! }\n",
        "bang_set_float:=func(a:F4,i:USize) returns F4 { mut v:=a.clone(); v.set(i,own 9)!; return v }\n",
        "bang_set_mask:=func(a:M4,i:USize) returns M4 { mut v:=a.clone(); v.set(i,own true)!; return v }\n",
        "repeated:=func(a:F4) returns USize { mut errors:USize=0; mut i:USize=0; while i<8 { a.get(i)? catch(err:OutOfBounds){errors++}; i++ }; return errors }\n"))
    File.writefile(format(work, "/lane_reference.til"), format(
        "mode cli\nimport(\"lanes\")\nmain:=proc(){a:=make_float(); m:=make_mask(); assert_eq(USize,repeated(a),4);\n",
        "for i in 0..4 { index:=i.to_usize(); assert_eq(F32,read_float(a,index)!,a.get(index)!); assert_eq(Bool,read_mask(m,index)!,m.get(index)!); v:=write_float(a,index,9); assert_eq(F32,v.get(index)!,9); n:=write_mask(m,index,false); assert(n.get(index)!.not()) };\n",
        "v:=write_float(a,USize.MAX,9); assert_eq(F32,v[0],17); assert_eq(F32,v[3],4); n:=write_mask(m,USize.MAX,false); assert(n[0]); assert(n[3].not()); println(\"lanes PASS\") }\n"))
    File.writefile(format(work, "/lane_panic.til"), "mode cli\nimport(\"lanes\")\nmain:=proc(which:I64,index:USize){a:=make_float();m:=make_mask();if which==0 {bang_float(a,index)} else if which==1 {bang_mask(m,index)} else if which==2 {bang_set_float(a,index)} else {bang_set_mask(m,index)} }\n")
    File.writefile(format(work, "/lane_caller.c"), format(
        "#include <assert.h>\n#include <stdint.h>\n#include <string.h>\n#include <stdlib.h>\n#ifdef COUNT32\ntypedef uint32_t Count;\n#else\ntypedef uint64_t Count;\n#endif\n",
        "typedef struct{float v[4];}F4;typedef struct{uint8_t v[4];}M4;extern float read_float(F4,Count,int64_t*),bang_float(F4,Count);extern uint8_t read_mask(M4,Count,int64_t*),bang_mask(M4,Count);extern F4 write_float(F4,Count,float),bang_set_float(F4,Count);extern M4 write_mask(M4,Count,uint8_t),bang_set_mask(M4,Count);extern Count repeated(F4);\n",
        "int main(int argc,char **argv){const uint32_t bits[]={0x7f800001,0xffc12345,0x80000000,1};F4 a;memcpy(&a,bits,16);M4 m={{1,0,1,0}};if(argc>1){switch(atoi(argv[1])){case 0:bang_float(a,4);break;case 1:bang_mask(m,4);break;case 2:bang_set_float(a,4);break;default:bang_set_mask(m,4);}return 99;}assert(repeated(a)==4);\n",
        "const Count indices[]={0,1,2,3,4,7,(Count)-1};for(unsigned q=0;q<7;q++){Count i=indices[q];int64_t error=0;float f=read_float(a,i,&error);assert(error==(i>=4));if(i<4){uint32_t got;memcpy(&got,&f,4);assert(got==bits[i]);}F4 out=write_float(a,i,a.v[1]);uint32_t got[4],seventeen;float value=17;memcpy(&seventeen,&value,4);memcpy(got,&out,16);for(unsigned k=0;k<4;k++)assert(got[k]==(i==k?bits[1]:(k==0?seventeen:bits[k])));\n",
        "for(unsigned pattern=0;pattern<16;pattern++){for(unsigned k=0;k<4;k++)m.v[k]=(pattern>>k)&1;error=0;uint8_t b=read_mask(m,i,&error);assert(error==(i>=4));if(i<4)assert(b==m.v[i]);for(unsigned x=0;x<2;x++){M4 n=write_mask(m,i,x);for(unsigned k=0;k<4;k++)assert(n.v[k]==(i==k?x:(k==0?1:m.v[k])));}}}return 0;}\n"))
    for width in array(Str, "32", "64") {
        flag := format("--usize=", width)
        for command in array(Str, "interpret", "run") {
            reference := Cmd.new(compiler, command, flag, "lane_reference.til")
            checked(reference, work)
        }
        mut messages := Vec(Str).new()
        for i in 0..4 {
            reference := Cmd.new(compiler, "run", flag, "lane_panic.til", i.to_str(), "4")
            message := panic_output(reference, work)
            interpreted := Cmd.new(compiler, "interpret", flag, "lane_panic.til", i.to_str(), "4")
            assert_eq(Str, panic_output(interpreted, work), message)
            messages.push(own message)
        }
        for level in array(Str, "0", "2", "3") {
            build := Cmd.new(compiler, "build", "--backend=mlir", flag, format("--opt=", level), "./lanes.til")
            checked(build, work)
            cc := Cmd.new("clang-18", "-O2", "-Wall", "-Wextra", "-Werror", "lane_caller.c", "gen/lib/liblanes.a", "-lm", "-o", "lane_caller")
            if width=="32" { cc.arg("-DCOUNT32") }
            checked(cc, work)
            native := Cmd.new("./lane_caller")
            checked(native, work)
            for i in 0..4 {
                failure := Cmd.new("./lane_caller", i.to_str())
                assert_eq(Str, panic_output(failure, work), messages[i.to_usize()])
            }
        }
    }
}

priv check_masks := proc(compiler: Str, work: Str) {
    File.writefile(format(work, "/masks.til"), format(
        "mode pure\nF4:=Simd(F32,4)\nM4:=Simd(Bool,4)\n",
        "make4 := func(a:F32,b:F32,c:F32,d:F32) returns F4 { return F4.new(a,b,c,d) }\n",
        "equal := func(a:F4,b:F4) returns M4 { return a==b }\n",
        "unequal := func(a:F4,b:F4) returns M4 { return a!=b }\n",
        "less := func(a:F4,b:F4) returns M4 { return a<b }\n",
        "less_equal := func(a:F4,b:F4) returns M4 { return a<=b }\n",
        "greater := func(a:F4,b:F4) returns M4 { return a>b }\n",
        "greater_equal := func(a:F4,b:F4) returns M4 { return a>=b }\n",
        "choose := func(m:M4,a:F4,b:F4) returns F4 { return F4.select(m,a,b) }\n",
        "choose_mask := func(m:M4,a:M4,b:M4) returns M4 { return M4.select(m,a,b) }\n",
        "both := func(a:M4,b:M4) returns M4 { return a.band(b) }\n",
        "either := func(a:M4,b:M4) returns M4 { return a.bor(b) }\n",
        "different := func(a:M4,b:M4) returns M4 { return a.bxor(b) }\n",
        "invert := func(a:M4) returns M4 { return a.bnot() }\n",
        "same_mask := func(a:M4,b:M4) returns M4 { return a.eq(b) }\n",
        "different_mask := func(a:M4,b:M4) returns M4 { return a.neq(b) }\n",
        "every := func(a:M4) returns Bool { return a.all() }\n",
        "some := func(a:M4) returns Bool { return a.any() }\n",
        "lane := func(a:M4) returns Bool { return a[2] }\n",
        "construct := func(a:Bool,b:Bool,c:Bool,d:Bool) returns M4 { return M4.new(a,b,c,d) }\n",
        "splat := func(a:Bool) returns M4 { return M4.splat(a) }\n",
        "zero := func() returns M4 { return M4.zero() }\n",
        "forward := func(a:F4,b:F4) returns M4 { mut m:=equal(a,b); if m.any() { m=invert(m) }; return m }\n"))
    File.writefile(format(work, "/mask_caller.c"), format(
        "#include <assert.h>\n#include <stdint.h>\n#include <string.h>\n#include <math.h>\n",
        "typedef struct{float v[4];}F4;typedef struct{uint8_t v[4];}M4;\n",
        "extern M4 equal(F4,F4),unequal(F4,F4),less(F4,F4),less_equal(F4,F4),greater(F4,F4),greater_equal(F4,F4),forward(F4,F4);\n",
        "extern F4 choose(M4,F4,F4);extern M4 choose_mask(M4,M4,M4),both(M4,M4),either(M4,M4),different(M4,M4),same_mask(M4,M4),different_mask(M4,M4),invert(M4),construct(uint8_t,uint8_t,uint8_t,uint8_t),splat(uint8_t),zero(void);\n",
        "extern uint8_t every(M4),some(M4),lane(M4);\n",
        "static void check(M4 m,unsigned bits){for(unsigned k=0;k<4;k++)assert(m.v[k]==((bits>>k)&1));}\n",
        "int main(void){const float values[]={0.0f,-0.0f,1,-1,INFINITY,-INFINITY,NAN,0x1p-149f};\n",
        "for(unsigned i=0;i<8;i++)for(unsigned j=0;j<8;j++){F4 a,b;for(unsigned k=0;k<4;k++){a.v[k]=values[(i+k)%8];b.v[k]=values[(j+k)%8];}M4 e=equal(a,b),n=unequal(a,b),l=less(a,b),le=less_equal(a,b),g=greater(a,b),ge=greater_equal(a,b);unsigned bits=0;for(unsigned k=0;k<4;k++){assert(e.v[k]==(a.v[k]==b.v[k]));assert(n.v[k]==(a.v[k]!=b.v[k]));assert(l.v[k]==(a.v[k]<b.v[k]));assert(le.v[k]==(a.v[k]<=b.v[k]));assert(g.v[k]==(a.v[k]>b.v[k]));assert(ge.v[k]==(a.v[k]>=b.v[k]));bits|=(unsigned)e.v[k]<<k;}check(forward(a,b),bits?bits^15:bits);}\n",
        "const uint32_t abits[4]={0x7f800001,0xffc12345,0x80000000,1},bbits[4]={0x7fc12345,0x7f800001,0,0xff800000};F4 a,b;memcpy(&a,abits,16);memcpy(&b,bbits,16);\n",
        "check(zero(),0);check(splat(0),0);check(splat(1),15);for(unsigned i=0;i<16;i++){M4 m;for(unsigned k=0;k<4;k++)m.v[k]=(i>>k)&1;check(construct(m.v[0],m.v[1],m.v[2],m.v[3]),i);assert(every(m)==(i==15)&&some(m)==(i!=0)&&lane(m)==m.v[2]);check(invert(m),i^15);F4 selected=choose(m,a,b);uint32_t got[4];memcpy(got,&selected,16);for(unsigned k=0;k<4;k++)assert(got[k]==(m.v[k]?abits[k]:bbits[k]));for(unsigned j=0;j<16;j++){M4 n;for(unsigned k=0;k<4;k++)n.v[k]=(j>>k)&1;check(both(m,n),i&j);check(either(m,n),i|j);check(different(m,n),i^j);check(same_mask(m,n),(i^j)^15);check(different_mask(m,n),i^j);check(choose_mask(m,n,invert(n)),(i&j)|((i^15)&(j^15)));}}return 0;}\n"))
    checks := "main := proc() { a:=make4(1,2,3,4); b:=make4(1,9,3,0); m:=equal(a,b); m0:=m[0]; m1:=m[1]; m2:=m[2]; m3:=m[3]; assert(m0 && m1.not() && m2 && m3.not()); assert(some(m) && every(m).not()); assert(every(either(m,invert(m)))); assert(some(both(m,invert(m))).not()); assert(every(same_mask(construct(true,false,true,false),m))); chosen:=choose(m,a,b); assert_eq(F32,chosen[1],9); assert_eq(F32,chosen[3],0); assert(every(different_mask(forward(a,b),m))); println(\"masks PASS\") }\n"
    File.writefile(format(work, "/mask_reference.til"), format("mode cli\nimport(\"masks\")\n", checks))
    File.writefile(format(work, "/mask_consumer.til"), format(
        "mode cli\nlink(\"gen/lib/libmasks.so\")\nF4:=Simd(F32,4)\nM4:=Simd(Bool,4)\n",
        "make4:=ext_func(shallow a:F32,shallow b:F32,shallow c:F32,shallow d:F32) returns shallow F4 {}\n",
        "equal:=ext_func(shallow a:F4,shallow b:F4) returns shallow M4 {}\nforward:=ext_func(shallow a:F4,shallow b:F4) returns shallow M4 {}\n",
        "choose:=ext_func(shallow m:M4,shallow a:F4,shallow b:F4) returns shallow F4 {}\n",
        "both:=ext_func(shallow a:M4,shallow b:M4) returns shallow M4 {}\neither:=ext_func(shallow a:M4,shallow b:M4) returns shallow M4 {}\n",
        "same_mask:=ext_func(shallow a:M4,shallow b:M4) returns shallow M4 {}\ndifferent_mask:=ext_func(shallow a:M4,shallow b:M4) returns shallow M4 {}\n",
        "invert:=ext_func(shallow a:M4) returns shallow M4 {}\nsome:=ext_func(shallow a:M4) returns shallow Bool {}\nevery:=ext_func(shallow a:M4) returns shallow Bool {}\n",
        "construct:=ext_func(shallow a:Bool,shallow b:Bool,shallow c:Bool,shallow d:Bool) returns shallow M4 {}\n", checks))
    for width in array(Str, "32", "64") {
        flag := format("--usize=", width)
        for command in array(Str, "interpret", "run") {
            reference := Cmd.new(compiler, command, flag, "mask_reference.til")
            checked(reference, work)
        }
        for level in array(Str, "0", "2", "3") {
            build := Cmd.new(compiler, "build", "--backend=mlir", flag, format("--opt=", level), "masks.til")
            checked(build, work)
            cc := Cmd.new("clang-18", "-O2", "-Wall", "-Wextra", "-Werror", "mask_caller.c", "gen/lib/libmasks.a", "-lm", "-o", "mask_caller")
            checked(cc, work)
            native := Cmd.new("./mask_caller")
            checked(native, work)
            consumer := Cmd.new(compiler, "run", "--asan", flag, "mask_consumer.til")
            checked(consumer, work)
        }
    }
}

priv panic_output := proc(command: Cmd, work: Str) returns Str {
    command.cwd(work).capture()
    status := command.run()
    expect(status == 1, command.render(), command.out(), command.err())
    expect(command.out().contains(": panic: uncaught throw 'OutOfBounds'"), command.out(), command.err())
    expect(command.err().len() == 0, command.err())
    return command.out()
}

priv check_exceptions := proc(compiler: Str, work: Str) {
    File.writefile(format(work, "/exceptions.til"), format(
        "mode pure\nF4:=Simd(F32,4)\n",
        "read_bang := func(a: Array(F32),i: USize) returns F32 { return a.get(i)!.clone() }\n",
        "load_bang := func(a: Array(F32),i: USize) returns F4 { return F4.load(a,i)! }\n",
        "read_or := func(a: Array(F32),i: USize,fallback: F32) returns F32 { ref value: F32=a.get(i)? catch(err:OutOfBounds){return fallback}; return value.clone() }\n",
        "recover_lane := func(a: Array(F32),i: USize) returns F32 { mut v:=F4.zero(); v=F4.load(a,i)? catch(err:OutOfBounds){v=F4.splat(7)}; return v[2] }\n",
        "count_failures := func(a: Array(F32),limit: USize) returns USize { mut failures: USize=0; mut i: USize=0; while i<limit { a.get(i)? catch(err:OutOfBounds){failures++}; i++ }; return failures }\n",
        "recover_add := func(a: Array(F32),b: Array(F32),mut out: Array(F32)) returns USize { mut i: USize=0; while i<a.len() { out.set(i,own (a.get(i)?+b.get(i)?))? catch(err:OutOfBounds){return i}; i++ }; return i }\n",
        "rethrow_read := func(a: Array(F32),i: USize) returns F32 throws OutOfBounds { ref value: F32=a.get(i)? catch(err:OutOfBounds){throw OutOfBounds()}; return value.clone() }\n",
        "recover_forward := func(a: Array(F32),i: USize) returns F32 { mut value: F32=0; value=rethrow_read(a,i)? catch(err:OutOfBounds){value=17}; return value }\n",
        "nested_bang := func(a: Array(F32),mut out: Array(F32)) returns F32 { out.set(0,own a.get(0)?.clone())! catch(err:OutOfBounds){return 23}; return 0 }\n"))
    source := realpath_str(format(work, "/exceptions.til"))
    quoted_source := source.strip_suffix(".til").replace("\\", "\\\\").replace("\"", "\\\"")
    File.writefile(format(work, "/exception_reference.til"), format(
        "mode cli\nimport(\"", quoted_source, "\")\nmain := proc() { a:=array(F32,1,2,3,4); empty:=Array(F32).new(0); mut out:=Array(F32).new(4);\n",
        "assert_eq(F32,read_or(a,1,99),2); assert_eq(F32,read_or(empty,0,99),99); assert_eq(F32,recover_lane(a,0),3); assert_eq(F32,recover_lane(a,1),7);\n",
        "assert_eq(USize,count_failures(a,7),3); assert_eq(USize,count_failures(empty,3),3); assert_eq(USize,recover_add(a,empty,out),0);\n",
        "assert_eq(USize,recover_add(a,a,out),4); assert_eq(F32,out[3],8); assert_eq(F32,recover_forward(empty,0),17); assert_eq(F32,recover_forward(a,0),1);\n",
        "assert_eq(F32,nested_bang(empty,out),23); assert_eq(F32,nested_bang(a,out),0); assert_eq(F32,read_bang(a,2),3); v:=load_bang(a,0); assert_eq(F32,v[3],4); println(\"exceptions PASS\") }\n"))
    File.writefile(format(work, "/exception_panic.til"), format(
        "mode cli\nimport(\"", quoted_source, "\")\nmain := proc(which: I64) { a:=array(F32,1,2,3,4); if which==0 { read_bang(a,4) } else { load_bang(a,1) }; println(\"UNREACHED\") }\n"))
    File.writefile(format(work, "/exception_caller.c"), format(
        "#include <assert.h>\n#include <stdint.h>\n#include <stdlib.h>\n",
        "#ifdef COUNT32\ntypedef uint32_t Count;\n#else\ntypedef uint64_t Count;\n#endif\n",
        "typedef struct {float *data;Count cap;} Buffer;typedef struct {float x,y,z,w;} F4;\n",
        "extern float read_bang(const Buffer*,Count),read_or(const Buffer*,Count,float),recover_lane(const Buffer*,Count),recover_forward(const Buffer*,Count),rethrow_read(const Buffer*,Count,int64_t*);\n",
        "extern F4 load_bang(const Buffer*,Count);extern Count count_failures(const Buffer*,Count),recover_add(const Buffer*,const Buffer*,Buffer*);extern float nested_bang(const Buffer*,Buffer*);\n",
        "int main(int argc,char **argv){float values[4]={1,2,3,4},output[6]={-99,-99,-99,-99,-99,-99};Buffer a={values,4},empty={0,0},out={output+1,4},short_b={values,2};\n",
        "if(argc>1){if(atoi(argv[1])==0)read_bang(&a,4);else load_bang(&a,1);return 99;}\n",
        "assert(read_or(&a,1,99)==2 && read_or(&empty,0,99)==99);assert(recover_lane(&a,0)==3 && recover_lane(&a,1)==7);\n",
        "assert(count_failures(&a,7)==3 && count_failures(&empty,3)==3);assert(recover_add(&a,&short_b,&out)==2);assert(output[0]==-99 && output[1]==2 && output[2]==4 && output[3]==-99 && output[5]==-99);\n",
        "assert(recover_add(&a,&a,&out)==4 && output[4]==8);assert(recover_forward(&empty,0)==17 && recover_forward(&a,0)==1);int64_t error=0;rethrow_read(&empty,0,&error);assert(error==1);\n",
        "assert(nested_bang(&empty,&out)==23 && output[1]==2);assert(nested_bang(&a,&out)==0 && output[1]==1);assert(read_bang(&a,2)==3);F4 v=load_bang(&a,0);assert(v.x==1 && v.w==4);return 0;}\n"))
    for width in array(Str, "32", "64") {
        flag := format("--usize=", width)
        for command in array(Str, "interpret", "run") {
            reference := Cmd.new(compiler, command, flag, "exception_reference.til")
            checked(reference, work)
        }
        mut messages := Vec(Str).new()
        for argument in array(Str, "0", "1") {
            reference := Cmd.new(compiler, "run", flag, "exception_panic.til", argument)
            message := panic_output(reference, work)
            interpreted := Cmd.new(compiler, "interpret", flag, "exception_panic.til", argument)
            assert_eq(Str, panic_output(interpreted, work), message)
            messages.push(own message)
        }
        for level in array(Str, "0", "2", "3") {
            build := Cmd.new(compiler, "build", "--backend=mlir", flag, format("--opt=", level), "./exceptions.til")
            checked(build, work)
            cc := Cmd.new("clang-18", "-O2", "-Wall", "-Wextra", "-Werror", "exception_caller.c", "gen/lib/libexceptions.a", "-lm", "-o", "exception_caller")
            if width=="32" { cc.arg("-DCOUNT32") }
            checked(cc, work)
            native := Cmd.new("./exception_caller")
            checked(native, work)
            for i in 0..2 {
                failure := Cmd.new("./exception_caller", i.to_str())
                assert_eq(Str, panic_output(failure, work), messages[i.to_usize()])
            }
        }
    }
}

main := proc(compiler_arg: Str) {
    compiler := realpath_str(compiler_arg)
    work := "tmp/mlir_integration"
    mkdir_p(work)
    File.writefile(format(work, "/arithmetic.til"), format(
        "mode pure\nF4 := Simd(F32,4)\nscalar_add := func(a: F32, b: F32) returns F32 { return a + b }\nadd4 := func(a: F4, b: F4) returns F4 { return a + b }\npriv helper := func(a: F4, b: F4) returns F4 { return add4(a,b) }\ntwice := func(a: F4, b: F4) returns F4 { first := helper(a, b); return add4(first, b) }\nfour := func(a: F4, b: F4, c: F4, d: F4) returns F4 { ab := add4(a,b); cd := add4(c,d); return add4(ab,cd) }\nconstant := func() returns F32 { return 0.1 }\n",
        "make4 := func(a: F32,b: F32,c: F32,d: F32) returns F4 { return F4.new(a,b,c,d) }\n",
        "splat4 := func(a: F32) returns F4 { return F4.splat(a) }\nzero4 := func() returns F4 { return F4.zero() }\n",
        "literal4 := func() returns F4 { return F4.new(0.1,-0.0,3,4) }\n",
        "mul4 := func(a: F4,b: F4) returns F4 { return a*b }\n",
        "reduce4 := func(a: F4) returns F32 { return a.reduce_add() }\ndot4 := func(a: F4,b: F4) returns F32 { return (a*b).reduce_add() }\n",
        "reverse4 := func(a: F4) returns F4 { return F4.new(a[3],a[2],a[1],a[0]) }\n",
        "madd4 := func(a: F4,b: F4,c: F4) returns F4 { return a*b+c }\n",
        "scalar_madd := func(a: F32,b: F32,c: F32) returns F32 { return a*b+c }\n"))
    File.writefile(format(work, "/caller.c"), format(
        "#include <assert.h>\n#include <math.h>\n#include <stdint.h>\n#include <string.h>\n",
        "typedef struct { float lane0,lane1,lane2,lane3; } F4;\n",
        "extern F4 add4(F4,F4); extern F4 twice(F4,F4); extern F4 four(F4,F4,F4,F4); extern float scalar_add(float,float); extern float constant(void);\n",
        "extern F4 make4(float,float,float,float), splat4(float), zero4(void), literal4(void), reverse4(F4), mul4(F4,F4), madd4(F4,F4,F4);\nextern float reduce4(F4), dot4(F4,F4), scalar_madd(float,float,float);\n",
        "static void equal(float a,float b) { if (isnan(a)) assert(isnan(b)); else assert(memcmp(&a,&b,4)==0); }\n",
        "int main(void) { const float v[]={0.0f,-0.0f,1.0f,-2.5f,0x1p-149f,0x1p-126f,0x1p24f,INFINITY,-INFINITY,NAN};\n",
        "equal(constant(),0.1f);\nfor(unsigned i=0;i<10;i++) {\nfor(unsigned j=0;j<10;j++) {\n",
        "F4 a={v[i],v[(i+1)%10],v[(i+2)%10],v[(i+3)%10]}, b={v[j],v[(j+2)%10],v[(j+4)%10],v[(j+6)%10]};\n",
        "F4 r=add4(a,b), s=twice(a,b), t=four(a,b,b,a); float aa[4],bb[4],rr[4],ss[4],tt[4]; memcpy(aa,&a,16); memcpy(bb,&b,16); memcpy(rr,&r,16); memcpy(ss,&s,16); memcpy(tt,&t,16);\n",
        "F4 m=mul4(a,b), ma=madd4(a,b,a); float mm[4],maa[4]; memcpy(mm,&m,16); memcpy(maa,&ma,16);\n",
        "for(unsigned k=0;k<4;k++){float once=aa[k]+bb[k], product=aa[k]*bb[k]; equal(rr[k],once); equal(ss[k],once+bb[k]); equal(tt[k],once+(bb[k]+aa[k])); equal(mm[k],product); equal(maa[k],product+aa[k]);}\nequal(scalar_add(v[i],v[j]),v[i]+v[j]);\n",
        "equal(reduce4(a),(aa[0]+aa[2])+(aa[1]+aa[3])); equal(dot4(a,b),(mm[0]+mm[2])+(mm[1]+mm[3]));\n}\n}\n",
        "F4 cancel={1e20f,1,-1e20f,3}, ones=splat4(1); equal(reduce4(cancel),4); equal(dot4(cancel,ones),4); equal(reduce4(splat4(-0.0f)),-0.0f);\n",
        "equal(scalar_madd(4097,4097,-16785408),0); F4 unfused=madd4(splat4(4097),splat4(4097),splat4(-16785408)); equal(unfused.lane0,0);\n",
        "const uint32_t raw[4]={0x7f800001u,0xffc12345u,0x80000000u,1u}; F4 rawv; memcpy(&rawv,raw,16); F4 copy=make4(rawv.lane0,rawv.lane1,rawv.lane2,rawv.lane3), rev=reverse4(rawv), spl=splat4(rawv.lane0); uint32_t revbits[4],splbits[4]; memcpy(revbits,&rev,16); memcpy(splbits,&spl,16); assert(memcmp(&copy,raw,16)==0);\n",
        "for(unsigned k=0;k<4;k++){assert(revbits[k]==raw[3-k]); assert(splbits[k]==raw[0]);}\nF4 z=zero4(),lit=literal4(); const uint32_t zeros[4]={0}; assert(memcmp(&z,zeros,16)==0); equal(lit.lane0,0.1f); equal(lit.lane1,-0.0f); equal(lit.lane2,3); equal(lit.lane3,4);\nreturn 0;\n}\n"))
    reference_checks := format(
        "bits := func(value: F32) returns U32 { mut out: U32 = 0; memcpy(to_ptr(out),to_ptr(value),4); return out }\n",
        "from_bits := func(value: U32) returns F32 { mut out: F32 = 0; memcpy(to_ptr(out),to_ptr(value),4); return out }\n",
        "same := func(a: F32,b: F32) { if b != b { assert(a != a) } else { assert_eq(U32,bits(a),bits(b)) } }\n",
        "main := proc() { patterns := array(U32,0,0x80000000,0x3f800000,0xc0200000,1,0x00800000,0x7f800000,0xff800000,0x7fc12345);\n",
        "for p in patterns { for q in patterns { a := from_bits(p); b := from_bits(q); va := make4(a,b,a,b); vb := splat4(b); product := a*b; square := b*b; expected := (product+product)+(square+square); same(dot4(va,vb),expected); same(reduce4(va),(a+a)+(b+b)) } }\n",
        "cancel := make4(1e20,1,-1e20,3); same(dot4(cancel,splat4(1)),4); same(reduce4(splat4(from_bits(0x80000000))),from_bits(0x80000000)); same(scalar_madd(4097,4097,-16785408),0);\n",
        "rev := reverse4(make4(1,2,3,4)); assert(rev.eq(F4.new(4,3,2,1)).all()); println(\"SIMD reference PASS\") }\n")
    File.writefile(format(work, "/reference.til"), format("mode cli\nimport(\"arithmetic\")\n", reference_checks))
    File.writefile(format(work, "/simd_consumer.til"), format(
        "mode cli\nlink(\"gen/lib/libarithmetic.so\")\nF4 := Simd(F32,4)\n",
        "make4 := ext_func(shallow a: F32,shallow b: F32,shallow c: F32,shallow d: F32) returns shallow F4 {}\n",
        "splat4 := ext_func(shallow a: F32) returns shallow F4 {}\nreverse4 := ext_func(shallow a: F4) returns shallow F4 {}\n",
        "reduce4 := ext_func(shallow a: F4) returns shallow F32 {}\ndot4 := ext_func(shallow a: F4,shallow b: F4) returns shallow F32 {}\n",
        "scalar_madd := ext_func(shallow a: F32,shallow b: F32,shallow c: F32) returns shallow F32 {}\n", reference_checks))
    File.writefile(format(work, "/consumer.til"),
        "mode cli\nlink(\"gen/lib/libarithmetic.so\")\nF4 := Simd(F32,4)\nadd4 := ext_func(shallow a: F4, shallow b: F4) returns shallow F4 {}\nmain := proc() { a := F4.new(1,2,3,4); b := F4.new(4,3,2,1); result := add4(a,b); expected := F4.splat(5); assert(result.eq(expected).all()) }\n")
    File.writefile(format(work, "/main.til"), "mode cli\npriv noop := func() {}\nmain := proc() { noop() }\n")
    for command in array(Str, "interpret", "run") {
        reference := Cmd.new(compiler, command, "reference.til")
        checked(reference, work)
    }
    for level in array(Str, "0", "2", "3") {
        build := Cmd.new(compiler, "build", "--backend=mlir", format("--opt=", level), "arithmetic.til")
        checked(build, work)
        cc := Cmd.new("clang-18", "-O2", "-ffp-contract=off", "-Wall", "-Wextra", "-Werror", "caller.c", "gen/lib/libarithmetic.a", "-lm", "-o", "caller")
        checked(cc, work)
        run := Cmd.new("./caller")
        checked(run, work)
        consumer := Cmd.new(compiler, "run", "--opt=2", "consumer.til")
        checked(consumer, work)
        simd_consumer := Cmd.new(compiler, "run", "--opt=2", "simd_consumer.til")
        checked(simd_consumer, work)
        main_run := Cmd.new(compiler, "run", "--backend=mlir", "-o", "custom executable", "main.til")
        checked(main_run, work)
    }
    check_control_flow(compiler, work)
    check_buffers(compiler, work)
    check_exceptions(compiler, work)
    check_masks(compiler, work)
    check_lanes(compiler, work)
    check_float_arithmetic(compiler, work)
    check_runtime(compiler, work)
    check_integer_vectors(compiler, work)
    println("mlir PASS")
}
