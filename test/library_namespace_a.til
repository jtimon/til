mode lib

link_c("library_namespace_a_link.c")
link_c("library_namespace_a_extra_link.c")

LibraryNamespaceACallback := func(I64) returns I64
LibraryNamespaceACallbackAlias := LibraryNamespaceACallback

library_link_helper := ext_func(shallow value: I64) returns shallow I64 {}
library_extra_helper := ext_func(shallow value: I64) returns shallow I64 {}

BindingPoint := struct {
    scalar : I64 = 7
    size : USize = 11
    ptr : UPtr = 13
    priv secret : U32 = 17
namespace:
    COUNT : I64 = 5
    mut STATE : I64 = 6
    priv HIDDEN_STATE : I64 = 99
    priv hidden := func(value: I64) returns I64 {
        return value + BindingPoint.HIDDEN_STATE - BindingPoint.HIDDEN_STATE
    }
    identity := func(shallow value: BindingPoint) returns shallow BindingPoint {
        return BindingPoint(
            scalar=BindingPoint.hidden(value.scalar),
            size=value.size,
            ptr=value.ptr,
            secret=value.secret)
    }
}

BindingRef := struct {
    ref borrowed : I64
}

BindingTag := enum(U16) {
    Empty = 3,
    Number: I64 = 7,
}

BindingNiche := enum {
    None,
    Borrowed: ref I64,
}

BindingError := struct {}

priv library_namespace_a_private_value := func() returns I64 { return 21 }

library_namespace_a_count : I64 = 17
mut library_namespace_a_state : I64 = 23
library_namespace_a_origin : BindingPoint = BindingPoint(scalar=19, size=29, ptr=39)
mut library_namespace_a_point_state : BindingPoint = BindingPoint(scalar=20, size=30, ptr=40)
priv library_namespace_a_private_state : I64 = 101

library_namespace_a_global_sum := func() returns I64 {
    return library_namespace_a_count + library_namespace_a_state
        + BindingPoint.COUNT + BindingPoint.STATE
        + library_namespace_a_private_state - 101
}

library_namespace_a_value := func() returns I64 {
    return library_namespace_a_private_value()
}

library_namespace_a_value_alias := library_namespace_a_value

library_namespace_a_values := func() returns Array(I64) {
    return array(I64, 10, 11)
}

library_namespace_a_link_value := func() returns I64 {
    return library_link_helper(11)
}

library_namespace_a_extra_link_value := func() returns I64 {
    return library_extra_helper(10)
}

library_namespace_a_point := func(shallow point: BindingPoint) returns shallow BindingPoint {
    return BindingPoint.identity(point)
}

library_namespace_a_dynamic := func(value: Dynamic) returns Dynamic {
    return value
}

library_namespace_a_default := func(value: I64 = 31) returns I64 {
    return value
}

library_namespace_a_nonliteral_default := func(value: I64 = BindingPoint.COUNT) returns I64 {
    return value
}

library_namespace_a_string_default := func(value: Str = "a\"b\\c") returns I64 {
    return value.len().to_i64()
}

library_namespace_a_throwing := func(value: I64) returns I64 throws BindingError {
    if value < 0 { throw BindingError() }
    return value
}
