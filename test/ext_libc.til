mode cli

// Issue #176 regression test: binding libc string-pointer functions directly
// via ext_func used to fail C compilation under -Werror with two distinct
// errors:
//   1. "conflicting types for 'setenv'" -- til emits its own U8 * prototype
//      that clashes with stdlib.h's 'const char *' declaration.
//   2. "-Wpointer-sign" / "-Wdiscarded-qualifiers" at the call site, because
//      til passes U8 * where the libc prototype expects 'const char *'.
//
// The fix in src/self/builder.til adds these libc symbols to is_skip_ext_decl
// (so til does not emit a prototype that conflicts with stdlib.h) and emits
// the matching diagnostic pragmas at the top of the generated .c so the call
// site compiles cleanly.

setenv := ext_func(name: I8, value: I8, shallow overwrite: I32) returns shallow I32 {}
getenv := ext_func(name: I8) returns ref I8 {}
unsetenv := ext_func(name: I8) returns shallow I32 {}

main := proc() {
    rc1 := setenv("TIL_ISSUE_176".c_str, "expected".c_str, 1)
    if rc1.neq(0) {
        println("setenv failed")
        return
    }
    ref v : I8 = getenv("TIL_ISSUE_176".c_str)
    if is_null(v) {
        println("getenv returned NULL")
        return
    }
    rc2 := unsetenv("TIL_ISSUE_176".c_str)
    if rc2.neq(0) {
        println("unsetenv failed")
        return
    }

    // A CHAINED clone reaching a C string parameter. The clone is a
    // temporary and the garbager frees it at the end of the statement, so
    // the emitted C is `clone; call; delete` -- safe for any callee that
    // reads the pointer DURING the call, which is nearly every C string
    // API (this setenv, DrawText, unlink, fopen). It is only a callee that
    // RETAINS the pointer past the call that dangles, and no C string API
    // in the tree does. See doc/ffi.org, "Passing a Str to a C string
    // parameter"; that section teaches binding the clone because it is
    // correct in both cases, but the chain must not silently start
    // reading freed memory here.
    backed := "TIL_ISSUE_176_CHAINZZZ"
    name := backed.substr(0, 19)
    rc3 := setenv(name.clone().c_str, "chained".c_str, 1)
    if rc3.neq(0) {
        println("chained setenv failed")
        return
    }
    ref v2 : I8 = getenv("TIL_ISSUE_176_CHAIN".c_str)
    if is_null(v2) {
        println("chained getenv returned NULL")
        return
    }
    if Str.from_c_str(v2).neq("chained") {
        println("chained setenv stored the wrong value")
        return
    }
    _rc4 := unsetenv("TIL_ISSUE_176_CHAIN".c_str)

    println("ok")
}
