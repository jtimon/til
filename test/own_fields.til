mode test

Point := struct {
    x := 0
    y := 0
}

Line := struct {
    own start := Point(x=0, y=0)
    own end := Point(x=0, y=0)
}

# Test 1: own field access with constructor args
test_own_field_access := test() {
    line := Line(start=Point(x=1, y=2), end=Point(x=3, y=4))
    assert_eq(I64, line.start.x, 1)
    assert_eq(I64, line.start.y, 2)
    assert_eq(I64, line.end.x, 3)
    assert_eq(I64, line.end.y, 4)
}

# Test 2: default constructor
test_own_field_defaults := test() {
    line := Line()
    assert_eq(I64, line.start.x, 0)
    assert_eq(I64, line.start.y, 0)
    assert_eq(I64, line.end.x, 0)
    assert_eq(I64, line.end.y, 0)
}

# Test 3: clone struct with own fields
test_own_field_clone := test() {
    line := Line(start=Point(x=1, y=2), end=Point(x=3, y=4))
    line2 := line.clone()
    assert_eq(I64, line2.start.x, 1)
    assert_eq(I64, line2.end.y, 4)
}

# Test 4: field assignment through own field
test_own_field_nested_assign := test() {
    mut line := Line(start=Point(x=1, y=2), end=Point(x=3, y=4))
    line.start.x = 10
    assert_eq(I64, line.start.x, 10)
    assert_eq(I64, line.start.y, 2)
}

# Test 5: own field replacement
test_own_field_replace := test() {
    mut line := Line(start=Point(x=1, y=2), end=Point(x=3, y=4))
    line.start = Point(x=100, y=200)
    assert_eq(I64, line.start.x, 100)
    assert_eq(I64, line.start.y, 200)
}

# Test 6: clone independence
test_own_field_clone_independence := test() {
    mut line := Line(start=Point(x=1, y=2), end=Point(x=3, y=4))
    line2 := line.clone()
    line.start.x = 99
    assert_eq(I64, line2.start.x, 1)
    assert_eq(I64, line.start.x, 99)
}

# #196.A: own-mut enum field round-trip in interpret mode
EnumF := enum {
    A,
    B: I64,
}

OwnEnumW := struct {
    own e := EnumF.A
}

test_own_field_enum_default := test() {
    w := OwnEnumW()
    assert(w.e.is(EnumF.A))
}

test_own_field_enum_assign := test() {
    mut w := OwnEnumW()
    w.e = EnumF.B(42)
    assert(w.e.is(EnumF.B))
}

// #274: these are ordinary borrowed method calls through owned fields.
// Equal contents in distinct allocations compare equal, and inspecting an
// owned value must not consume it or its fields.
test_generated_owned_value_methods := test() {
    mut a := Line(start=Point(x=1, y=2), end=Point(x=3, y=4))
    b := Line(start=Point(x=1, y=2), end=Point(x=3, y=4))
    assert(a.eq(b))
    assert_eq(Str, a.to_str(), "Line(start=Point(x=1, y=2), end=Point(x=3, y=4))")
    a.end.y = 5
    assert(a.eq(b).not())
    assert_eq(I64, b.end.y, 4)
    assert_eq(I64, a.end.y, 5)

    first := OwnEnumW(e=EnumF.B(7))
    second := OwnEnumW(e=EnumF.B(7))
    assert(first.eq(second))
    assert_eq(Str, first.to_str(), "OwnEnumW(e=B(7))")
}

BorrowedName := struct {
    ref text : Str
}

BorrowedNumber := struct {
    ref value : I64
}

test_generated_borrowed_number_methods := test() {
    mut value := 7
    other := 7
    a := BorrowedNumber(value=value)
    b := BorrowedNumber(value=other)
    assert(a.eq(b))
    assert_eq(Str, a.to_str(), "BorrowedNumber(value=7)")
    value = 8
    assert(a.eq(b).not())
    assert_eq(I64, value, 8)
    assert_eq(I64, other, 7)
}

OwnedName := struct {
    own text : Str = ""
}

test_generated_borrowed_value_methods := test() {
    mut text := Str.clone("hello")
    other := Str.clone("hello")
    a := BorrowedName(text=text)
    b := BorrowedName(text=other)
    assert(a.eq(b))
    assert_eq(Str, a.to_str(), "BorrowedName(text=hello)")
    text = "changed"
    assert(a.eq(b).not())
    assert_eq(Str, a.to_str(), "BorrowedName(text=changed)")
    assert_eq(Str, text, "changed")
    assert_eq(Str, other, "hello")

    owned := OwnedName(text="owned")
    same := OwnedName(text="owned")
    assert(OwnedName.eq(owned, same))
    assert_eq(Str, OwnedName.to_str(owned), "OwnedName(text=owned)")
    assert_eq(Str, owned.text, "owned")
}

DeepNode := struct {
    value := 0
    next := Option(ref DeepNode).None
}

test_generated_recursive_value_methods := test() {
    tail := DeepNode(value=2)
    other_tail := DeepNode(value=2)
    head := DeepNode(value=1, next=safe_ref(tail))
    other_head := DeepNode(value=1, next=safe_ref(other_tail))
    assert(head.eq(other_head))
    assert_eq(Str, head.to_str(), "DeepNode(value=1, next=Some(DeepNode(value=2, next=None)))")
    assert(head.eq(tail).not())
    assert_eq(I64, tail.value, 2)
    assert_eq(I64, other_tail.value, 2)
}

// A request before the definition must check the new body once, then let
// the later namespace sweep reuse it. Field defaults also request methods
// after their provisional field-only inference has finished.
test_generated_forward_value_methods := test() {
    a := ForwardOwned(text="forward")
    b := ForwardOwned(text="forward")
    assert(a.eq(b))
    assert_eq(Str, a.to_str(), "ForwardOwned(text=forward)")
    snapshot := DeepSnapshot()
    assert_eq(Str, snapshot.text, "ForwardOwned(text=default)")
}

ForwardOwned := struct {
    own text : Str = ""
}

deep_snapshot_text := func() returns Str {
    value := ForwardOwned(text="default")
    return value.to_str()
}

DeepSnapshot := struct {
    text := deep_snapshot_text()
}

CustomOwned := struct {
    own text : Str = ""
namespace:
    eq := func(a: CustomOwned, b: CustomOwned) returns Bool {
        return a.text.len().eq(b.text.len())
    }
    to_str := func(self: CustomOwned) returns Str {
        return format("custom:", self.text)
    }
}

test_generated_value_methods_preserve_overrides := test() {
    a := CustomOwned(text="one")
    b := CustomOwned(text="two")
    assert(a.eq(b))
    assert_eq(Str, a.to_str(), "custom:one")
}
