mode lib

// Fixture for the generated JNI binding (issue #463): one exported function
// per supported parameter/return shape, plus throwing and unsupported ones.

JniBad := struct {}

JniCounter := struct {
    n : I64 = 0
namespace:
    twice := func(x: I64) returns I64 { return x * 2 }
}

jni_add_i8 := func(a: I8, b: I8) returns I8 { return a + b }
jni_add_u8 := func(a: U8, b: U8) returns U8 { return a + b }
jni_add_i16 := func(a: I16, b: I16) returns I16 { return a + b }
jni_add_u16 := func(a: U16, b: U16) returns U16 { return a + b }
jni_add_i32 := func(a: I32, b: I32) returns I32 { return a + b }
jni_add_u32 := func(a: U32, b: U32) returns U32 { return a + b }
jni_add_i64 := func(a: I64, b: I64) returns I64 { return a + b }
jni_add_u64 := func(a: U64, b: U64) returns U64 { return a + b }
jni_add_usize := func(a: USize, b: USize) returns USize { return a + b }
jni_half_f32 := func(a: F32) returns F32 { return a / 2.0 }
jni_half_f64 := func(a: F64) returns F64 { return a / 2.0 }
jni_not := func(a: Bool) returns Bool { return a.not() }

jni_str_len := func(s: Str) returns I64 { return s.len().to_i64() }

jni_greet := func(name: Str) returns Str {
    return format("hello, ", name)
}

jni_take := func(own s: Str) returns Str {
    return format("<", s, ">")
}

jni_safe_div := func(a: I64, b: I64) returns I64 throws DivideByZero, JniBad {
    if b == 0 { throw DivideByZero(msg = "b is zero") }
    if b < 0 { throw JniBad() }
    return a / b
}

jni_noop := func() {}

jni_bump := func(mut n: I64) { n = n + 1 }

JniPerson := struct {
    name : Str = "anon"
    age : I64 = 0
    active : Bool = true
}

jni_person := func(name: Str, age: I64) returns JniPerson {
    return JniPerson(name = name.clone(), age = age)
}

jni_person_describe := func(p: JniPerson) returns Str {
    return format(p.name, ":", p.age.to_str())
}

jni_person_consume := func(own p: JniPerson) returns I64 { return p.age }

jni_person_birthday := func(mut p: JniPerson) { p.age = p.age + 1 }

jni_append := func(mut s: Str, suffix: Str) { s = format(s, suffix) }

jni_flip := func(mut b: Bool) { b = b.not() }

JniShape := enum {
    Empty,
    Circle: I64,
    Label: Str,
    Owner: JniPerson,
}

jni_shape_area := func(s: JniShape) returns I64 {
    switch s {
    case .Circle(r): return r * r
    case .Owner(p): return p.age
    case: return 0
    }
}

JniHolder := struct {
    own person : JniPerson = JniPerson()
    count : I64 = 0
}

jni_holder := func(name: Str) returns JniHolder {
    return JniHolder(person = JniPerson(name = name.clone(), age = 1), count = 2)
}

jni_holder_person := func(h: JniHolder) returns ref JniPerson { return h.person }

jni_holder_name := func(h: JniHolder) returns ref Str { return h.person.name }

JniMapFn := func(I64) returns I64
JniStrFn := func(Str) returns Str
JniPersonFn := func(JniPerson) returns I64
JniMakeFn := func(I64) returns JniPerson

jni_apply := func(f: JniMapFn, x: I64) returns I64 { return f(x) + f(x + 1) }

jni_apply_str := func(f: JniStrFn, s: Str) returns Str { return f(s) }

jni_apply_person := func(f: JniPersonFn, p: JniPerson) returns I64 { return f(p) }

jni_make := func(f: JniMakeFn, age: I64) returns Str {
    p := f(age)
    return jni_person_describe(p)
}

jni_join := func(parts: Vec(Str), sep: Str) returns Str { return join(parts, sep) }

jni_split := func(text: Str) returns Vec(Str) { return text.split(",") }

jni_push := func(mut parts: Vec(Str), value: Str) { parts.push(own value.clone()) }

JniVecFn := func(Vec(Str)) returns I64

jni_count := func(f: JniVecFn, text: Str) returns I64 {
    parts := text.split(",")
    return f(parts)
}
