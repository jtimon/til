mode lib
import("std/file")
import("std/unicode")

UNICODE_CASE_TOTAL : USize = 766

// Find LF from a valid byte offset, or return len. Skip newline-free words
// with the standard zero-byte test after XOR with eight LF bytes. memcpy
// permits unaligned reads; the count check keeps every read inside the Str.
// Only zero-byte existence matters, so this works in either byte order.
unicode_case_line_end := func(text: Str, start: USize) returns USize {
    mut at := start
    mut word : U64 = malloc(8)
    while text.count - at >= 8 {
        memcpy(word, ptr_add(text.c_str, at), 8)
        different := word.bxor(0x0a0a0a0a0a0a0a0a)
        matches := (different - 0x0101010101010101).band(different.bnot()).band(0x8080808080808080)
        if matches != 0 { break }
        at = at + 8
    }
    // Finish within a possible match word, or in the final partial word.
    while at < text.count {
        if text.unsafe_get(at) == '\n' { return at }
        at++
    }
    return at
}

check_unicode_cases := proc() {
    mut cases : USize = 0
    data := File.readfile("test/unicode_grapheme_cases.txt")
    // Keep line views and parse each body once, without searching for token
    // ends and then reading the same hexadecimal digits a second time.
    mut offset : USize = 0
    while offset < data.len() {
        line_end := unicode_case_line_end(data, offset)
        line := data.substr(offset, line_end - offset)
        offset = line_end
        if offset < data.len() { offset++ }
        comment := line.find("#")
        mut body_end := line.len()
        if comment >= 0 { body_end = comment.to_usize() }
        body := line.substr(0, body_end).trim()
        if body.len() == 0 { continue }
        // The corpus's hexadecimal spelling is longer than its UTF-8 output.
        body_length := body.len()
        mut text := Str.with_capacity(body_length); mut expected := Vec(USize).new()
        mut at : USize = 0
        while at < body_length {
            byte := body.unsafe_get(at).cast(U8)
            if byte == 32 { at++; continue }
            if byte == 0xc3 {
                // U+00F7 (boundary) / U+00D7 (joined), in the unchanged UCD
                // UTF-8 corpus. Check both bytes and the token separator.
                assert(at + 1 < body_length)
                marker := body.unsafe_get(at + 1).cast(U8)
                if marker == 0xb7 { expected.push(own text.len()) }
                else { assert(marker == 0x97) }
                at = at + 2
                assert(at == body_length || body.unsafe_get(at) == ' ')
                continue
            }
            mut code : I64 = 0
            while at < body_length {
                digit_byte := body.unsafe_get(at).cast(U8)
                if digit_byte == 32 { at++; break }
                mut digit := digit_byte.to_i64() - 48
                if digit_byte >= 65 && digit_byte <= 70 { digit = digit_byte.to_i64() - 65 + 10 }
                else { assert(digit_byte >= 48 && digit_byte <= 57) }
                code = code * 16 + digit
                at++
            }
            text.push_str(Str.from_codepoint(code))
        }
        assert(expected[0] == 0)
        assert(expected[expected.len() - 1] == text.len())
        // The official corpus tests every UAX #29 boundary in both directions.
        // Navigation/clamping contracts have separate byte-position coverage;
        // repeating them here rescans each cluster many times per corpus case.
        for i in 1..expected.len() {
            start := expected[i - 1].clone(); end := expected[i].clone()
            if grapheme_next(text, start) != end || grapheme_previous(text, end) != start { panic("grapheme conformance: ", line) }
        }
        cases++
    }
    assert(cases == UNICODE_CASE_TOTAL)
    println("PASS: ", cases, " Unicode 17.0 forward/backward grapheme conformance cases")
}
