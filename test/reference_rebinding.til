mode cli

Cell := struct { number: I64 = 0; text: Str = "" }
Holder := struct { cell: Cell = Cell(); ref link: Cell }

make_cell := func(number: I64, text: Str) returns Cell {
    return Cell(number=number, text=text.clone())
}
borrow_cell := func(cell: Cell) returns ref Cell { return cell }
borrow_number := func(number: I64) returns ref I64 { return number }
borrow_size := func(size: USize) returns ref USize { return size }
choose_cell := func(mut calls: I64, first: Cell, second: Cell, choice: Bool) returns ref Cell {
    calls++
    if choice { return first }
    return second
}
assign_parameter := func(mut target: I64, value: I64) { target = value }

// #466: assigning a namespace variant through a reference replaces the
// referenced enum slot's value; it must not retarget the reference.
Drops := struct { count: I64 = 0 }
Tracked := struct {
    ref drops: Drops
    active := false
    text := ""
namespace:
    clone := func(self: Tracked) returns Tracked {
        return Tracked(drops=self.drops, active=self.active, text=self.text.clone())
    }
    delete := func(own self: Tracked, call_free: Bool = true) {
        // Array.new zeroes unused slots: only initialized payloads count.
        if self.active { self.drops.count++ }
        Str.delete(own self.text, false)
        if call_free { free(own self) }
    }
}
NicheChoice := enum { Some: Tracked, None }
TaggedChoice := enum { Empty, Value: Tracked, Count: I64 }

namespace_variant_through_reference := func() {
    // Each replaced payload is destroyed exactly once at the assignment;
    // replacing the enclosing owner destroys only payloads it still owns.
    niche_drops := Drops()
    mut niches := Array(NicheChoice).new(2)
    niches[0] = NicheChoice.Some(Tracked(drops=niche_drops, active=true, text=format("niche", " payload")))
    niches[1] = NicheChoice.Some(Tracked(drops=niche_drops, active=true, text=format("kept", " payload")))
    ref mut niche : NicheChoice = niches[0]
    niche = NicheChoice.None
    assert(niche_drops.count == 1)
    assert(niches[0].is(NicheChoice.None))
    assert(niches[1].is(NicheChoice.Some))
    niches = Array(NicheChoice).new(1)
    assert(niche_drops.count == 2)
    assert(niches.len() == 1)

    tagged_drops := Drops()
    mut tagged := Array(TaggedChoice).new(2)
    tagged[0] = TaggedChoice.Value(Tracked(drops=tagged_drops, active=true, text=format("tagged", " payload")))
    tagged[1] = TaggedChoice.Count(7)
    ref mut slot : TaggedChoice = tagged[0]
    slot = TaggedChoice.Empty
    assert(tagged_drops.count == 1)
    assert(tagged[0].is(TaggedChoice.Empty))
    assert(tagged[1].is(TaggedChoice.Count))
    tagged = Array(TaggedChoice).new(1)
    assert(tagged_drops.count == 1)
    assert(tagged.len() == 1)

    local_drops := Drops()
    mut single := TaggedChoice.Value(Tracked(drops=local_drops, active=true, text=format("local", " payload")))
    ref mut local : TaggedChoice = single
    local = TaggedChoice.Empty
    assert(local_drops.count == 1)
    assert(single.is(TaggedChoice.Empty))
    single = TaggedChoice.Count(1)
    assert(local_drops.count == 1)
    assert(single.is(TaggedChoice.Count))
}

late_borrow := proc(seed: I64) {
    mut first := make_cell(seed, "first")
    mut second := make_cell(seed, "later")
    second.number = seed + 1
    ref mut alias : Cell = borrow_cell(first)
    ref mut source : Cell = borrow_cell(second)
    alias = source
    alias.number++
    // Neither source reference nor owner is read after the rebind. The new
    // owner must remain alive through uses of the destination reference.
    println(alias.text)
}

scoped_borrow := func(seed: I64) {
    mut first := make_cell(seed, "first")
    mut second := make_cell(seed, "second")
    mut third := make_cell(seed, "third")
    ref mut source : Cell = borrow_cell(first)
    source.number++
    ref mut alias : Cell = source
    {
        ref mut source : Cell = borrow_cell(second)
        source.number++
        {
            ref mut source : Cell = borrow_cell(third)
            source.number++
            alias = source
        }
        // The acquired loan survives scope exit, but the source name is
        // restored to the immediately enclosing reference before rebinding.
        assert(alias.text.eq("third"))
        alias = source
    }
    assert(alias.text.eq("second"))
    alias = source
    assert(alias.text.eq("first"))
}

main := proc() {
    mut seed : I64 = 0
    seed++
    mut first := make_cell(seed, "one")
    mut second := make_cell(seed, "two")
    second.number = 2
    ref mut alias : Cell = borrow_cell(first)
    ref mut source : Cell = borrow_cell(second)
    ref snapshot : Cell = alias
    alias = source
    alias.number = 9
    assert(first.number == 1)
    assert(second.number == 9)
    assert(snapshot.number == 1)
    assert(first.text.eq("one"))
    assert(second.text.eq("two"))
    // Rebinding again must retain the binding's reference classification.
    alias = source
    alias.number = 10
    assert(second.number == 10)
    {
        mut alias := make_cell(seed, "shadow")
        alias = make_cell(seed + 1, "shadow replacement")
        assert(alias.number == 2)
    }
    assert(alias.number == 10)

    mut holder := Holder(cell=make_cell(seed, "field"), link=first)
    holder.cell.number = 3
    alias = holder.cell
    alias.number = 30
    assert(holder.cell.number == 30)
    assert(first.number == 1)
    alias = holder.link
    alias.number = 40
    assert(first.number == 40)
    assert(holder.cell.number == 30)

    mut calls := 0
    alias = choose_cell(calls, first, second, false)
    alias.number = 50
    assert(calls == 1)
    assert(second.number == 50)
    assert(first.number == 40)
    ref mut first_reference : Cell = borrow_cell(first)
    for i in 0..4 {
        if i.mod(2) == 0 { alias = first_reference }
        else { alias = source }
        alias.number++
    }
    assert(first.number == 42)
    assert(second.number == 52)

    mut left := 10
    mut right := 0
    right = 20
    ref mut number : I64 = borrow_number(left)
    ref mut next_number : I64 = borrow_number(right)
    ref before : I64 = number
    number = next_number
    number = 21
    assert(left == 10)
    assert(right == 21)
    assert(before == 10)
    assign_parameter(left, right)
    assert(left == 21)
    number = 22
    assert(right == 22)

    mut original_size : USize = 0
    ref mut length : USize = borrow_size(original_size)
    mut text := Str.with_capacity(8)
    text.push_str("four")
    length = text.count
    length = 2
    assert(original_size == 0)
    assert(text.len() == 2)
    assert(text.cap == 8)

    namespace_variant_through_reference()
    late_borrow(seed)
    scoped_borrow(seed)
    println("reference rebinding passed")
}
