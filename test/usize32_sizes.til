mode script

// Issues #309 / #313 regression, COMPILE-ONLY: the default, compact layout.
// Built with --usize=32, containers use U32 widths and every own pointer
// field is a 4-byte cage offset (ext.h TIL_OWN_PTR), so on a 64-bit host
// Str = c_str(4)+count(4)+cap(4) = 12 and Vec has the same layout; the
// native layout (--usize=64) is 24 (test/usize64_sizes.til). Map holds two
// Vecs inline: 24.
//
// Driven ONLY as a compiled binary by make.til's layout_regressions step --
// NOT interpreted: the compile-time interpreter manipulates the compiler's
// own HOST structs, so X.size() is the host width under the interpreter.

// #313 (reopened): stored references. A ref field is still an 8-byte
// native pointer under the compact layout -- only own fields are cage
// offsets -- so two refs take 16 bytes, as natively. Completing reference
// compression makes RefPair 8 here; update this pin when it lands.
RefPair := struct {
    ref first : I64
    ref second : I64
}

// #472: a generator condition reads the TARGET layout (typer.til
// target_value_size_align), which must model own pointer fields the way the
// emitted struct stores them: here tag(4) + own name(4, a cage offset) = 8.
Holder := struct {
    tag : U32 = 0
    own name : Str = ""
}
holder_size_gen := macro() returns FuncDef {
    if Holder.size() == 8 {
        return func() returns USize { return 8 }
    } else {
        return func() returns USize { return 0 }
    }
}
holder_size := holder_size_gen()

// #472 (F2): a size reaching the program through compile-time evaluation.
// The compiler evaluates these in its OWN layout, which is only the target's
// when the two happen to match, so it must not bake the results: the call
// and the namespace initializers are left for the program, where
// Holder.size() is 8. A compiler built with the other layout used to
// bake its own number here.
holder_twice := func() returns USize { return Holder.size() * 2 }
HolderSizes := struct {
namespace:
    BYTES : USize = Holder.size()
    DOUBLE : USize = HolderSizes.BYTES * 2
}

check := proc(label: Str, got: USize, want: USize) {
    if got.neq(want) {
        println(format("FAIL: ", label, " = ", got.to_str(), ", want ", want.to_str()))
        exit(1)
    }
}

check("Str.size()", Str.size(), 12)
check("Vec(Str).size()", Vec(Str).size(), 12)
check("Vec(I64).size()", Vec(I64).size(), 12)
check("Map(Str, I64).size()", Map(Str, I64).size(), 24)
check("dyn_size_of Str", dyn_size_of("Str"), 12)
check("RefPair.size() (stored refs, still native)", RefPair.size(), 16)
check("Holder.size()", Holder.size(), 8)
check("generator Holder.size()", holder_size(), 8)
check("folded call holder_twice()", holder_twice(), 16)
check("namespace constant from a size", HolderSizes.BYTES, 8)
check("namespace constant from that constant", HolderSizes.DOUBLE, 16)

// Elements stride at the compressed width: 3 pushes stay addressable.
mut v := Vec(Str).new()
v.push(own "a")
v.push(own "bb")
v.push(own "ccc")
check("vec len", v.len(), 3)
ref e0 : Str = v.unsafe_get(0)
ref e2 : Str = v.unsafe_get(2)
if e0.eq("a").and(e2.eq("ccc")).not() { println("FAIL: vec stride"); exit(1) }

// A view stores a pointer into the middle of its buffer: byte offsets, not
// 16-byte units, are what make that representable.
whole := format("abc", "defgh")
mid := whole.substr(3, 4)
if mid.eq("defg").not() { println("FAIL: substr view"); exit(1) }

println("usize32 sizes OK")
