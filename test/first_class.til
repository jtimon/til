mode test

import("../src/std/dyn_vec")
import("../src/std/dyn_array")
import("../src/std/dyn_map")
import("../src/std/dyn_hashmap")

// --- Lambda functions: anonymous inline FuncDef literals (issue #61) ---
// A lambda is the same syntax as a named function definition, just
// without a name. Param/return types are explicit (per #58 rule:
// "parameters always require explicit types"). No captures (closures
// are #54).

BinaryOp := func(I64, I64) returns I64
UnaryOp := func(I64) returns I64

apply_binop := func(op: BinaryOp, a: I64, b: I64) returns I64 {
    return op(a, b)
}

apply_unary := func(op: UnaryOp, x: I64) returns I64 {
    return op(x)
}

// --- Lambda as positional FCall argument ---

test_lambda_basic_add := test() {
    assert_eq(I64, apply_binop(func(a: I64, b: I64) returns I64 { return a.add(b) }, 3, 4), 7)
}

test_lambda_basic_mul := test() {
    assert_eq(I64, apply_binop(func(a: I64, b: I64) returns I64 { return a.mul(b) }, 6, 7), 42)
}

test_lambda_distinct_call_sites := test() {
    assert_eq(I64, apply_binop(func(a: I64, b: I64) returns I64 { return a.sub(b) }, 10, 3), 7)
    assert_eq(I64, apply_binop(func(a: I64, b: I64) returns I64 { return a.add(b.mul(2)) }, 1, 5), 11)
}

// --- Lambda as named FCall argument ---

test_lambda_named_arg := test() {
    assert_eq(I64, apply_unary(op = func(x: I64) returns I64 { return x.mul(3) }, x = 4), 12)
}

// --- Lambda nested across multiple FCalls ---

test_lambda_nested_calls := test() {
    inner := apply_unary(func(x: I64) returns I64 { return x.add(1) }, 5)
    assert_eq(I64, inner, 6)
    outer := apply_binop(func(a: I64, b: I64) returns I64 { return a.mul(b) }, inner, 7)
    assert_eq(I64, outer, 42)
}

// --- Lambda as UFCS method-call argument ---

Wrapper := struct {
    val : I64 = 0

namespace:
    apply := func(self: Wrapper, op: UnaryOp) returns I64 {
        return op(self.val)
    }
}

test_lambda_ufcs_method_arg := test() {
    w := Wrapper(val = 6)
    assert_eq(I64, w.apply(func(x: I64) returns I64 { return x.mul(7) }), 42)
}

// --- Lambda as RHS of FuncSig-typed declaration ---

test_lambda_as_value_unary := test() {
    f : UnaryOp = func(x: I64) returns I64 { return x.mul(2) }
    assert_eq(I64, f(7), 14)
    assert_eq(I64, apply_unary(f, 5), 10)
}

test_capturing_lambda_as_value_unary := test() {
    scale := 10
    f : UnaryOp = func(x: I64) returns I64 [scale] { return x.mul(scale) }
    assert_eq(I64, f(7), 70)
    assert_eq(I64, apply_unary(f, 5), 50)
}

test_inferred_capturing_lambda_value_unary := test() {
    scale := 10
    f := func(x: I64) returns I64 [scale] { return x.mul(scale) }
    assert_eq(I64, f(3), 30)
}

test_lambda_as_value_binary := test() {
    g : BinaryOp = func(a: I64, b: I64) returns I64 { return a.add(b) }
    assert_eq(I64, g(3, 4), 7)
    assert_eq(I64, apply_binop(g, 10, 20), 30)
}

// --- Lambda as struct-field default value ---

Handler := struct {
    on_click : BinaryOp = func(a: I64, b: I64) returns I64 { return a.add(b) }
}

test_struct_field_lambda_default := test() {
    h := Handler()
    assert_eq(I64, h.on_click(3, 5), 8)
}

test_struct_field_lambda_ctor := test() {
    h := Handler(on_click = func(a: I64, b: I64) returns I64 { return a.mul(b) })
    assert_eq(I64, h.on_click(4, 6), 24)
}

test_struct_field_funcptr_clone := test() {
    h := Handler(on_click = func(a: I64, b: I64) returns I64 { return a.sub(b) })
    h2 := h.clone()
    assert_eq(I64, h.on_click(10, 3), 7)
    assert_eq(I64, h2.on_click(10, 3), 7)
}

// --- FuncSig-form lambda (type separated from param names) ---

test_funcsig_form_lambda_unary := test() {
    assert_eq(I64, apply_unary(func(I64) returns I64 = (a) { return a.mul(2) }, 7), 14)
}

test_funcsig_form_lambda_binary := test() {
    assert_eq(I64, apply_binop(func(I64, I64) returns I64 = (a, b) { return a.add(b) }, 3, 4), 7)
}

test_funcsig_form_lambda_as_value := test() {
    f : BinaryOp = func(I64, I64) returns I64 = (a, b) { return a.sub(b) }
    assert_eq(I64, f(10, 3), 7)
}

test_named_funcsig_form_capturing_lambda := test() {
    scale := 10
    f : UnaryOp = (x) [scale] { return x.mul(scale) }
    assert_eq(I64, f(3), 30)
}

// --- FuncSig as first-class Type value (issue #58) ---
// A bodyless `func(...) returns ...` (FuncSig) is a Type alias for
// Type.FuncPtr. Using its name where a Type is expected must round-trip
// to "Fn", not to the function's return type.

fn_add := func(a: I64, b: I64) returns I64 { return a.add(b) }
fn_mul := func(a: I64, b: I64) returns I64 { return a.mul(b) }

test_dyn_type_to_str_funcsig := test() {
    assert_eq(Str, "Fn", dyn_type_to_str(BinaryOp))
    assert_eq(Str, "Fn", dyn_type_to_str(Type.FuncPtr))
}

test_vec_funcsig_create := test() {
    ops := DynVec.new(BinaryOp)
    assert_eq(USize, ops.len(), 0)
}

test_vec_funcsig_push_len := test() {
    mut ops := DynVec.new(BinaryOp)
    ops.push(own fn_add)
    ops.push(own fn_mul)
    assert_eq(USize, ops.len(), 2)
}

// Round-trip: push fn_add / fn_mul into a DynVec.new(BinaryOp), pull each
// slot out via a FuncSig-typed ref binding (`ref g : BinaryOp = ops[i]`)
// and call it. The ref-binding reads the slot through
// reinterpret_ptr_value's FuncSig branch -- which only works once the
// FFI bridge round-trips Value.Func through Vec.push without losing the
// pointer (Value.Func cases in ext_dispatch_ffi, issue #58).
test_vec_funcsig_call_through_ref := test() {
    mut ops := DynVec.new(BinaryOp)
    ops.push(own fn_add)
    ops.push(own fn_mul)
    ref g : BinaryOp = ops[0]
    assert_eq(I64, g(3, 4), 7)
    ref h : BinaryOp = ops[1]
    assert_eq(I64, h(3, 4), 12)
}

// Inline `cast(<dyn>, BinaryOp)(args)` -- a fn ptr pulled directly out
// of a typed Vec, cast to the matching FuncSig, and invoked, all in one
// expression (issue #58). Three pieces had to line up: the parser
// accepts a postfix `(args)` on any expression; the typer's cast accepts
// Dynamic -> FuncPtr against the user FuncSig and the outer FCall
// resolves the sig through cast's preserved Ident child; codegen emits
// `(*(void **)slot)` for the dynamic-to-fn-ptr read, then the standard
// indirect-call cast on top.
test_vec_funcsig_cast_call_inline := test() {
    mut ops := DynVec.new(BinaryOp)
    ops.push(own fn_add)
    ops.push(own fn_mul)
    ref raw0 : Dynamic = ops[0]
    ref raw1 : Dynamic = ops[1]
    assert_eq(I64, cast(raw0, BinaryOp)(3, 4), 7)
    assert_eq(I64, cast(raw1, BinaryOp)(3, 4), 12)
}

// Calling a call's RESULT, without binding it first. The signature comes
// off the inner call's own Type.FuncPtrSig payload -- the same name
// `cast(raw, BinaryOp)(3, 4)` spells out in an argument -- so both shapes
// share one validation path in the typer and one indirect-call emit in
// the builder. This used to crash the compiler on an UNREACHABLE, then
// (once that became a diagnostic) was rejected outright.
PickOp := func(I64) returns I64
pick_double := func(x: I64) returns I64 { return x.mul(2) }
pick_op := func() returns PickOp { return pick_double }
pick_binop := func(flag: Bool) returns BinaryOp {
    if flag { return fn_add }
    return fn_mul
}

test_call_a_call_result := test() {
    assert_eq(I64, pick_op()(5), 10)
    assert_eq(I64, pick_binop(true)(3, 4), 7)
    assert_eq(I64, pick_binop(false)(3, 4), 12)
}

test_call_a_call_result_nested := test() {
    assert_eq(I64, pick_op()(pick_op()(3)), 12)
}

// --- First-class Body values (issue #55) ---

run_body_twice := proc(b: Body) {
    b()
    b()
}

BodyHolder := struct {
    on_done : Body = { }
}

test_body_basic_call := test() {
    mut x := 0
    b : Body = [mut x] { x = x.add(1) }
    b()
    b()
    assert_eq(I64, x, 2)
}

test_body_as_proc_arg := test() {
    mut x := 0
    b : Body = [mut x] { x = x.add(1) }
    run_body_twice(b)
    assert_eq(I64, x, 2)
}

test_body_struct_field := test() {
    mut x := 0
    h := BodyHolder(on_done = [mut x] { x = x.add(3) })
    h.on_done()
    assert_eq(I64, x, 3)
}

// Issue #326: a field default is never emitted in place -- the typer
// substitutes it into every construction site that OMITS the field, which
// is why the builder no longer emits closure machinery for the original.
// These two pin that substitution: without them, dropping a default's
// closure function/value would compile and no test would notice.
TripleHolder := struct {
    op : UnaryOp = func(x: I64) returns I64 { return x.mul(3) }
}

test_func_field_default_omitted := test() {
    h := TripleHolder()
    assert_eq(I64, h.op(7), 21)
}

CounterHolder := struct {
    step : Body = { }
}

// The other direction: a default that no constructor OMITS is not a
// reachability edge either, because the typer only substitutes it where
// the field is missing. unused_default_op is named nowhere else, so
// first_class_no_dead_field_default asserts it is absent from the C --
// examples/lib/alphabeta.til's `h : Heuristic = default_heuristic` used to
// emit a callerless function in chess and go for exactly this reason.
unused_default_op := func(x: I64) returns I64 { return x.mul(5) }

DefaultedHolder := struct {
    op : UnaryOp = unused_default_op
}

test_supplied_field_default_is_not_rooted := test() {
    h := DefaultedHolder(op = func(x: I64) returns I64 { return x.add(1) })
    assert_eq(I64, h.op(4), 5)
}

test_body_field_default_omitted := test() {
    h := CounterHolder()
    h.step()
}

test_dyn_type_to_str_body := test() {
    assert_eq(Str, "Body", dyn_type_to_str(Body))
}

test_dyn_storage_kind_callable_types := test() {
    assert_eq(USize, dyn_storage_kind("Dynamic"), ELEM_POD)
    assert_eq(USize, dyn_storage_kind("Str"), ELEM_BOXED)
    assert_eq(USize, dyn_storage_kind("Fn"), ELEM_FN)
    assert_eq(USize, dyn_storage_kind("Body"), ELEM_FN)
    assert_eq(USize, dyn_storage_kind("BinaryOp"), ELEM_FN)
}

test_vec_body_cast_call_inline := test() {
    mut x := 0
    mut bodies := DynVec.new(Body)
    b : Body = [mut x] { x = x.add(1) }
    bodies.push(own b)
    ref raw : Dynamic = bodies[0]
    cast(raw, Body)()
    assert_eq(I64, x, 1)
}

test_dyn_map_body_value := test() {
    mut x := 0
    mut bodies := DynMap.new(Str, Body)
    b : Body = [mut x] { x = x.add(4) }
    bodies.set("run", own b)
    ref raw : Dynamic = bodies["run"]
    cast(raw, Body)()
    assert_eq(I64, x, 4)

    b2 : Body = [mut x] { x = x.add(5) }
    bodies.set("run", own b2)
    ref raw2 : Dynamic = bodies["run"]
    cast(raw2, Body)()
    assert_eq(I64, x, 9)
}

test_dyn_hashmap_body_value := test() {
    mut x := 0
    mut bodies := DynHashMap.new(Str, Body)
    b : Body = [mut x] { x = x.add(6) }
    bodies.set("run", own b)
    ref raw : Dynamic = bodies.get("run")!
    cast(raw, Body)()
    assert_eq(I64, x, 6)

    b2 : Body = [mut x] { x = x.add(7) }
    bodies.set("run", own b2)
    ref raw2 : Dynamic = bodies.get("run")!
    cast(raw2, Body)()
    assert_eq(I64, x, 13)
    bodies.remove("run")
}

test_dyn_vec_static_callable_clone := test() {
    mut ops := DynVec.new(BinaryOp)
    ops.push(own fn_add)
    copied := ops.clone()
    ref raw : Dynamic = copied[0]
    assert_eq(I64, cast(raw, BinaryOp)(8, 5), 13)
}

test_dyn_vec_capturing_funcsig_shallow_clone := test() {
    step : I64 = 2
    mut ops := DynVec.new(UnaryOp)
    op : UnaryOp = func(x: I64) returns I64 [shallow mut step] {
        step = step.add(1)
        return x.mul(step)
    }
    ops.push(own op)
    copied := ops.clone()
    ref original : Dynamic = ops[0]
    ref duplicate : Dynamic = copied[0]
    assert_eq(I64, cast(original, UnaryOp)(5), 15)
    assert_eq(I64, step, 2)
    assert_eq(I64, cast(duplicate, UnaryOp)(5), 15)
    assert_eq(I64, cast(duplicate, UnaryOp)(5), 20)
    assert_eq(I64, step, 2)
}

test_dyn_vec_capturing_funcsig_own_mut_clone := test() {
    step : I64 = 2
    mut ops := DynVec.new(UnaryOp)
    op : UnaryOp = func(x: I64) returns I64 [own mut step] {
        step = step.add(1)
        return x.mul(step)
    }
    ops.push(own op)
    copied := ops.clone()
    ref original : Dynamic = ops[0]
    ref duplicate : Dynamic = copied[0]
    assert_eq(I64, cast(original, UnaryOp)(5), 15)
    assert_eq(I64, cast(duplicate, UnaryOp)(5), 15)
    assert_eq(I64, cast(duplicate, UnaryOp)(5), 20)
}

test_dyn_vec_body_shallow_mut_clone := test() {
    step : I64 = 1
    mut seen := 0
    mut bodies := DynVec.new(Body)
    b : Body = [shallow mut step, mut seen] {
        step = step.add(1)
        seen = step
    }
    bodies.push(own b)
    copied := bodies.clone()
    ref original : Dynamic = bodies[0]
    cast(original, Body)()
    assert_eq(I64, seen, 2)
    assert_eq(I64, step, 1)
    ref duplicate : Dynamic = copied[0]
    cast(duplicate, Body)()
    assert_eq(I64, seen, 2)
    cast(duplicate, Body)()
    assert_eq(I64, seen, 3)
    assert_eq(I64, step, 1)
}

test_dyn_vec_capturing_body_clone := test() {
    mut calls := 0
    mut bodies := DynVec.new(Body)
    b : Body = [mut calls] { calls = calls.add(1) }
    bodies.push(own b)
    copied := bodies.clone()
    ref original : Dynamic = bodies[0]
    cast(original, Body)()
    ref duplicate : Dynamic = copied[0]
    cast(duplicate, Body)()
    assert_eq(I64, calls, 2)
}

test_dyn_vec_body_clone_owned_capture := test() {
    text := format("still alive")
    mut bodies := DynVec.new(Body)
    b : Body = [own text] { assert_eq(Str, text, "still alive") }
    bodies.push(own b)
    copied := bodies.clone()
    bodies.clear()
    ref duplicate : Dynamic = copied[0]
    cast(duplicate, Body)()
}

test_dyn_vec_body_clone_owned_callable_capture := test() {
    text := format("nested clone")
    inner : Body = [own text] { assert_eq(Str, text, "nested clone") }
    mut bodies := DynVec.new(Body)
    outer : Body = [own inner] { inner() }
    bodies.push(own outer)
    copied := bodies.clone()
    bodies.clear()
    ref duplicate : Dynamic = copied[0]
    cast(duplicate, Body)()
}

test_dyn_array_body_clone := test() {
    mut calls := 0
    mut bodies := DynArray.new(Body, 2)
    b : Body = [mut calls] { calls = calls.add(2) }
    bodies.set(0, own b)!
    copied := bodies.clone()
    ref original : Dynamic = bodies[0]
    cast(original, Body)()
    ref duplicate : Dynamic = copied[0]
    cast(duplicate, Body)()
    assert_eq(I64, calls, 4)
}

test_dyn_map_body_clone := test() {
    text := format("map clone")
    mut bodies := DynMap.new(Str, Body)
    b : Body = [own text] { assert_eq(Str, text, "map clone") }
    bodies.set("run", own b)
    copied := bodies.clone()
    bodies.clear()
    ref duplicate : Dynamic = copied["run"]
    cast(duplicate, Body)()
}

test_dyn_hashmap_body_clone := test() {
    text := format("hash clone")
    mut bodies := DynHashMap.new(Str, Body)
    b : Body = [own text] { assert_eq(Str, text, "hash clone") }
    bodies.set("run", own b)
    copied := bodies.clone()
    bodies.clear()
    ref duplicate : Dynamic = copied.get("run")!
    cast(duplicate, Body)()
}

test_dyn_vec_body_lifecycle := test() {
    mut calls := 0

    mut cleared := DynVec.new(Body)
    clear_body : Body = [mut calls] { calls = calls.add(1) }
    cleared.push(own clear_body)
    cleared.clear()

    mut removed := DynVec.new(Body)
    remove_body : Body = [mut calls] { calls = calls.add(10) }
    keep_after_remove : Body = [mut calls] { calls = calls.add(2) }
    removed.push(own remove_body)
    removed.push(own keep_after_remove)
    removed.remove_at(0)!
    ref remove_survivor : Dynamic = removed[0]
    cast(remove_survivor, Body)()

    mut truncated := DynVec.new(Body)
    keep_after_truncate : Body = [mut calls] { calls = calls.add(4) }
    truncate_body : Body = [mut calls] { calls = calls.add(10) }
    truncated.push(own keep_after_truncate)
    truncated.push(own truncate_body)
    truncated.truncate(1)
    ref truncate_survivor : Dynamic = truncated[0]
    cast(truncate_survivor, Body)()

    mut marked := DynVec.new(Body)
    keep_marked : Body = [mut calls] { calls = calls.add(8) }
    delete_marked_body : Body = [mut calls] { calls = calls.add(10) }
    marked.push(own keep_marked)
    marked.push(own delete_marked_body)
    marks : U8 = malloc(2)
    memset(marks, 0, 2)
    memset(ptr_add(marks, 1), 1, 1)
    marked.delete_marked(marks)
    free(own marks)
    ref marked_survivor : Dynamic = marked[0]
    cast(marked_survivor, Body)()

    mut appended := DynVec.new(Body)
    append_left : Body = [mut calls] { calls = calls.add(16) }
    appended.push(own append_left)
    mut append_source := DynVec.new(Body)
    append_right : Body = [mut calls] { calls = calls.add(32) }
    append_source.push(own append_right)
    appended.append(own append_source)
    ref appended_right : Dynamic = appended[1]
    cast(appended_right, Body)()

    mut moved := DynVec.new(Body)
    old_moved : Body = [mut calls] { calls = calls.add(10) }
    moved.push(own old_moved)
    mut move_source := DynVec.new(Body)
    moved_body : Body = [mut calls] { calls = calls.add(64) }
    move_source.push(own moved_body)
    moved.move_from(move_source)
    ref moved_value : Dynamic = moved[0]
    cast(moved_value, Body)()

    mut split := DynVec.new(Body)
    prefix_body : Body = [mut calls] { calls = calls.add(128) }
    tail_body : Body = [mut calls] { calls = calls.add(256) }
    split.push(own prefix_body)
    split.push(own tail_body)
    prefix := split.take_prefix(1)
    ref prefix_value : Dynamic = prefix[0]
    cast(prefix_value, Body)()
    ref tail_value : Dynamic = split[0]
    cast(tail_value, Body)()

    mut popped_vec := DynVec.new(Body)
    pop_body : Body = [mut calls] { calls = calls.add(512) }
    popped_vec.push(own pop_body)
    popped : Body = popped_vec.pop()
    popped()

    mut oob := DynVec.new(Body)
    oob_body : Body = [mut calls] { calls = calls.add(10) }
    mut caught := false
    oob.set(0, own oob_body)?
    catch (_err: OutOfBounds) { caught = true }
    assert(caught)
    assert_eq(I64, calls, 1006)
}

test_dyn_array_body_set_oob := test() {
    mut calls := 0
    mut bodies := DynArray.new(Body, 1)
    b : Body = [mut calls] { calls = calls.add(1) }
    mut caught := false
    bodies.set(1, own b)?
    catch (_err: OutOfBounds) { caught = true }
    assert(caught)
    assert_eq(I64, calls, 0)
}

test_dyn_maps_body_remove_and_clear := test() {
    mut calls := 0
    mut ordered := DynMap.new(Str, Body)
    ordered_drop : Body = [mut calls] { calls = calls.add(10) }
    ordered_keep : Body = [mut calls] { calls = calls.add(1) }
    ordered.set("drop", own ordered_drop)
    ordered.set("keep", own ordered_keep)
    assert(ordered.remove("drop"))
    ref ordered_value : Dynamic = ordered["keep"]
    cast(ordered_value, Body)()
    ordered.clear()

    mut hashed := DynHashMap.new(Str, Body)
    hashed_drop : Body = [mut calls] { calls = calls.add(10) }
    hashed_keep : Body = [mut calls] { calls = calls.add(2) }
    hashed.set("drop", own hashed_drop)
    hashed.set("keep", own hashed_keep)
    assert(hashed.remove("drop"))
    ref hashed_value : Dynamic = hashed.get("keep")!
    cast(hashed_value, Body)()
    hashed.clear()
    assert_eq(I64, calls, 3)
}

// --- Explicit FuncDef / FunctionDef metatype annotation (issue #58) ---
// rstil's first_class.org uses `FuncDef` as the metatype name for
// concrete function definitions; til's internal struct is named
// `FunctionDef`. Both names should be accepted for the annotation.

triple_funcdef : FuncDef = func(x: I64) returns I64 { return x.mul(3) }
double_funcdef : FunctionDef = func(x: I64) returns I64 { return x.mul(2) }

test_explicit_funcdef_annotation := test() {
    assert_eq(I64, triple_funcdef(5), 15)
    assert_eq(I64, double_funcdef(7), 14)
}

// --- First-class structs (issue #56), verified-working foundation ---
// StructDef-as-value (Vec(StructDef).new() by value, struct_def_of,
// anonymous struct construction, `func(T) returns T`) is covered below
// alongside the named foundation; `func(T) returns T` (full generics)
// still depends on #58's metatype-reflection foundation.

Point56 := struct {
    x: I64 = 0
    y: I64 = 0
}

// A struct type can be passed where a `Type` parameter is expected and
// round-trips through dyn_type_to_str back to its own name.
type_name_of := func(T: Type) returns Str {
    return dyn_type_to_str(T)
}

test_struct_type_as_type_arg := test() {
    assert_eq(Str, "Point56", type_name_of(Point56))
}

// The StructDef metatype round-trips to "StructDef" both as the bare
// type name and via the Type enum variant.
test_structdef_metatype_str := test() {
    assert_eq(Str, "StructDef", dyn_type_to_str(StructDef))
    assert_eq(Str, "StructDef", dyn_type_to_str(Type.StructDef))
}

// Struct instances (not definitions) are first-class values: storable in
// a Vec keyed on the concrete struct type.
test_vec_of_struct_instances := test() {
    mut points := Vec(Point56).new()
    points.push(own Point56(x=10, y=20))
    points.push(own Point56(x=30, y=40))
    assert_eq(USize, points.len(), 2)
}

// --- Anonymous struct instantiation (issue #56) ---
// `struct { ... }(args)` constructs an instance of an inline anonymous
// struct. init lifts the literal to a top-level AnonStructN type, so it
// works in both interpret and compile mode and at function-body scope.

test_anon_struct_ctor := test() {
    p := struct {
        x: I64 = 0
        y: I64 = 0
    }(x=10, y=20)
    assert_eq(I64, p.x, 10)
    assert_eq(I64, p.y, 20)
}

test_anon_struct_defaults := test() {
    q := struct {
        a: I64 = 7
    }()
    assert_eq(I64, q.a, 7)
}

// --- Anonymous enum literals (issue #57) ---
// `enum { ... }.Variant` (and `.Variant(payload)`) reference a variant of
// an inline anonymous enum. init lifts the literal to a top-level
// AnonEnumN type, so it works in both interpret and compile mode.

test_anon_enum_variant := test() {
    c := enum {
        Red, Green, Blue
    }.Green
    assert_eq(Str, c.to_str(), "Green")
}

test_anon_enum_payload := test() {
    v := enum {
        Num: I64
        Nothing
    }.Num(42)
    assert_eq(Str, v.to_str(), "Num(42)")
}

// Structurally-identical anon literals unify to one generated type, so a
// value built from one literal matches a `switch` case built from another
// -- including payload extraction.
test_anon_enum_switch := test() {
    c := enum { Red, Green, Blue }.Green
    switch c {
    case enum { Red, Green, Blue }.Red:
        assert_eq(I64, 0, 1)
    case enum { Red, Green, Blue }.Green:
        assert(true)
    case enum { Red, Green, Blue }.Blue:
        assert_eq(I64, 0, 1)
    }
}

test_anon_enum_payload_switch := test() {
    v := enum { Num: I64, Nothing }.Num(7)
    mut got := 0
    switch v {
    case enum { Num: I64, Nothing }.Num(x):
        got = x
    case enum { Num: I64, Nothing }.Nothing:
        got = -1
    }
    assert_eq(I64, got, 7)
}

// Conversely, literals that differ observably (here, a field default) stay
// distinct types and keep their own defaults.
test_anon_struct_distinct_defaults := test() {
    a := struct { x: I64 = 1 }()
    b := struct { x: I64 = 2 }()
    assert_eq(I64, a.x, 1)
    assert_eq(I64, b.x, 2)
}

// --- Anonymous defs in type positions (issue #56/#57) ---
// `struct { ... }` / `enum { ... }` may also appear where a type is
// expected (param, return, field, local-decl annotation). The same
// generated type backs a type-position literal and a structurally
// identical value-position one, so a value flows into the annotated slot.

anon_sum_xy := func(p: struct {
    x: I64 = 0
    y: I64 = 0
}) returns I64 {
    return p.x.add(p.y)
}

test_anon_param_type := test() {
    arg := struct {
        x: I64 = 0
        y: I64 = 0
    }(x=3, y=4)
    assert_eq(I64, anon_sum_xy(arg), 7)
}

anon_make_pt := func() returns struct {
    x: I64 = 0
    y: I64 = 0
} {
    return struct {
        x: I64 = 0
        y: I64 = 0
    }(x=5, y=6)
}

test_anon_return_type := test() {
    p := anon_make_pt()
    assert_eq(I64, p.x.add(p.y), 11)
}

// Anon enum as return type. Returning a bare tag-only enum variant used to
// hit a pre-existing compile-mode codegen bug; issue #70's bootstrapping
// fix (0678984) cleared it for both named and anonymous enums.
anon_make_color := func() returns enum { Red, Green, Blue } {
    return enum { Red, Green, Blue }.Green
}

test_anon_enum_return_type := test() {
    assert_eq(Str, anon_make_color().to_str(), "Green")
}

anon_name_of := func(c: enum { Red, Green, Blue }) returns Str {
    return c.to_str()
}

test_anon_enum_param_type := test() {
    assert_eq(Str, anon_name_of(enum { Red, Green, Blue }.Blue), "Blue")
}

test_anon_local_decl_type := test() {
    p: struct { x: I64 = 0 } = struct { x: I64 = 0 }(x=9)
    assert_eq(I64, p.x, 9)
}

AnonFieldHolder := struct {
    inner: struct { v: I64 = 0 } = struct { v: I64 = 0 }()
}

test_anon_field_type := test() {
    h := AnonFieldHolder(inner = struct { v: I64 = 0 }(v=42))
    assert_eq(I64, h.inner.v, 42)
}

// --- Bare anonymous defs as values (issue #56) ---
// `own struct { ... }` as a call argument resolves to a runtime
// StructDef value (the definition itself, distinct from instantiation
// or type-position usage), built via struct_def_of against the
// underlying generated AnonStructN name. Symmetric for enums via
// enum_def_of. The `own` prefix is the signal that the caller wants
// the definition AS A VALUE; bare `struct { ... }` without `own`
// elsewhere in an arg position remains a type reference for
// introspection-style `func(T: Type)` callees.

test_anon_struct_as_value := test() {
    mut defs := Vec(StructDef).new()
    defs.push(own struct {
        x: I64 = 0
        y: I64 = 0
    })
    defs.push(own struct {
        a: I64 = 0
    })
    assert_eq(USize, defs.len(), 2)
}

test_anon_enum_as_value := test() {
    mut enums := Vec(EnumDef).new()
    enums.push(own enum { Red, Green, Blue })
    enums.push(own enum { On, Off })
    assert_eq(USize, enums.len(), 2)
}

// --- Anonymous defs as introspection-func args (issue #57/#58) ---
// A bare `struct { ... }` / `enum { ... }` passed as a call argument
// resolves to the underlying generated type name -- so the same
// `func(T: Type)` signature that introspects a named type also accepts
// an inline anonymous one. This also covers the named-type case
// without the previous "keep_alive" workaround: the scavenger now
// follows the `Type.Enum(...)` / `Type.Struct(...)` form that the
// typer rewrites a Type-typed ident into, so the type stays live.

count_variants_of := func(T: Type) returns I64 {
    return enum_variant_count(til_type_name(T))
}

count_fields_of := func(T: Type) returns I64 {
    return struct_field_count(til_type_name(T))
}

NamedColor3 := enum { Red, Green, Blue }

test_named_enum_as_type_arg := test() {
    assert_eq(I64, count_variants_of(NamedColor3), 3)
}

test_anon_enum_as_type_arg := test() {
    assert_eq(I64, count_variants_of(enum { Red, Green, Blue }), 3)
    assert_eq(I64, count_variants_of(enum { A, B, C, D }), 4)
    assert_eq(I64, count_variants_of(enum { X: I64, Y, Z: Str }), 3)
}

test_anon_struct_as_type_arg := test() {
    assert_eq(I64, count_fields_of(struct {
        x: I64 = 0
        y: I64 = 0
    }), 2)
}

// --- Anonymous defs as macro Type-arg (issue #57) ---
// Same shape as the func(T: Type) introspection pattern, but the callee
// is a macro -- it evaluates at compile time. Both named and anonymous
// types resolve through the Type metatype param.

count_variants_macro := macro(T: Type) returns I64 {
    return enum_variant_count(til_type_name(T))
}

NamedColor3M := enum { Red, Green, Blue }

test_named_enum_as_macro_arg := test() {
    assert_eq(I64, count_variants_macro(NamedColor3M), 3)
}

test_anon_enum_as_macro_arg := test() {
    assert_eq(I64, count_variants_macro(enum { Red, Green, Blue }), 3)
    assert_eq(I64, count_variants_macro(enum { A, B, C, D }), 4)
}

// --- Macros as type generators (issue #57) ---
// A macro returning StructDef/EnumDef acts as a generic type generator
// at decl scope: `Pair := make_pair(I64)` desugars to
// `Pair := struct { first: I64 = 0, second: I64 = 0 }`. init expands the
// macro body's return literal with the type-parameters substituted out
// for the call-site args, so the rest of the pipeline treats the Decl
// like any other named struct/enum (constructor, field access, methods).
// Mirrors rstil's macro-returns-StructDef path (precomp.rs ~309).

make_pair := macro(T: Type) returns StructDef {
    return struct {
        first: T
        second: T
    }
}
PairI64 := make_pair(I64)

test_macro_struct_gen := test() {
    p := PairI64(first=3, second=4)
    assert_eq(I64, p.first.add(p.second), 7)
}

// No `= 0` default: a macro cannot spell "the zero of T" for every T
// (`value : Str = 0` is a type error now, the same as it always was for a
// hand-written field), and an explicitly typed field needs no default --
// it just becomes mandatory in the struct literal, which is how both
// tests below already build these.
make_kv := macro(K: Type, V: Type) returns StructDef {
    return struct {
        key: K
        value: V
    }
}
KVI64Str := make_kv(I64, Str)

test_macro_struct_gen_multi_param := test() {
    kv := KVI64Str(key=42, value="answer")
    assert_eq(I64, kv.key, 42)
    assert_eq(Str, kv.value, "answer")
}

make_opt := macro(T: Type) returns EnumDef {
    return enum {
        None
        Some: T
    }
}
OptI64 := make_opt(I64)

test_macro_enum_gen := test() {
    o := OptI64.Some(99)
    assert_eq(Str, o.to_str(), "Some(99)")
}

// Issue #243 follow-up: enum-generator macros get the same template type
// substitution into namespace methods as struct-generators. Without
// the FuncDef dispatch in init_subst_enum_params, the method's `val: T`
// and `self: make_pair_enum(T)` stayed as-is and the typer rejected them.
make_pair_enum := macro(T: Type) returns EnumDef {
    return enum {
        Empty
        One: T
    namespace:
        unwrap_or := func(self: make_pair_enum(T), default_v: T) returns T {
            switch self {
            case make_pair_enum(T).One(v): return v
            case: return default_v
            }
        }
    }
}
PairEnumI64 := make_pair_enum(I64)

test_macro_enum_ns_t_and_self := test() {
    assert_eq(I64, PairEnumI64.One(7).unwrap_or(0), 7)
    assert_eq(I64, PairEnumI64.Empty.unwrap_or(42), 42)
}

// --- Issue #56 close-out: macro StructDef + user namespace method.
// The merge with the auto-generated clone/delete is automatic; the
// auto-gen runs on the substituted struct literal and the user
// namespace methods are kept as-is. Symmetric with
// test_macro_enum_ns_t_and_self on the enum side (#57).
make_box56 := macro(T: Type) returns StructDef {
    return struct {
        v: T = 0
    namespace:
        twice := func(self: make_box56(T)) returns T { return self.v.add(self.v) }
    }
}
BoxI64 := make_box56(I64)

test_macro_struct_ns_method := test() {
    b := BoxI64(v = 5)
    assert_eq(I64, b.twice(), 10)
}

// Issue #56 close-out: INFER_TYPE -- a field declared without an
// explicit `: Type` annotation but with a default value pulled from a
// macro arg infers its type from the substituted default.
make_holder56 := macro(N: I64) returns StructDef {
    return struct {
        val := N
    }
}
Holder56 := make_holder56(42)

test_macro_struct_infer_type := test() {
    h := Holder56()
    assert_eq(I64, h.val, 42)
}

// Issue #56 close-out: constfolder of a default-value EXPRESSION inside an
// expanded struct. The default is `N.add(1)` -- after N is substituted,
// the expression evaluates at compile time.
make_sized56 := macro(N: I64) returns StructDef {
    return struct {
        size: I64 = N.add(1)
    }
}
Sized5 := make_sized56(4)

test_macro_struct_constfolder_default := test() {
    s := Sized5()
    assert_eq(I64, s.size, 5)
}

// Issue #57 close-out: reflection helper to count an arbitrary enum's
// variants. `enum_def_of` + `variants.len()` round-trips through the
// registered enum metadata.
Dir57 := enum { N57; S57; E57; W57 }

count_variants57 := func(E: Type) returns I64 {
    name := dyn_type_to_str(E)
    def := enum_def_of(name)
    return def.variants.len().to_i64()
}

test_macro_enum_count_variants := test() {
    assert_eq(I64, count_variants57(Dir57), 4)
}

// --- Function generators (issue #57) ---
// A macro returning FuncDef is the symmetric analog of macros returning
// StructDef / EnumDef: `id_i64 := make_id(I64)` expands to
// `id_i64 := func(x: I64) returns I64 { return x }`. init's pre-pass
// substitutes type-params in the function literal's signature and body,
// then the rest of the pipeline registers the decl as a normal func.

make_id := macro(T: Type) returns FuncDef {
    return func(x: T) returns T { return x }
}

id_i64 := make_id(I64)
id_str := make_id(Str)

test_macro_func_gen_i64 := test() {
    assert_eq(I64, id_i64(42), 42)
}

test_macro_func_gen_str := test() {
    assert_eq(Str, id_str("hi"), "hi")
}

// --- Function generators with value-typed params (issue #57) ---
// A macro param like `N: I64` is a regular value, not a type; the
// inliner substitutes Ident(N) inside the function body's expressions
// with a clone of the call-site arg, so `make_adder(5)` bakes the
// literal 5 into the generated function. Declaration types (`x: T`)
// still substitute the receiver's ident name; value args leave those
// types unchanged.

make_adder := macro(N: I64) returns FuncDef {
    return func(x: I64) returns I64 { return x.add(N) }
}
add5 := make_adder(5)
add100 := make_adder(100)

test_macro_func_gen_value_param := test() {
    assert_eq(I64, add5(3), 8)
    assert_eq(I64, add100(1), 101)
}

make_typed_adder := macro(T: Type, N: I64) returns FuncDef {
    return func(x: T) returns T { return x.add(N) }
}
add_i64_5 := make_typed_adder(I64, 5)

test_macro_func_gen_mixed_params := test() {
    assert_eq(I64, add_i64_5(7), 12)
}

// --- Conditional macro bodies (issue #58) ---
// init's pre-pass evaluates `T.is(Type.<Variant>)` at expand time and
// picks the matching branch's return literal. Else-if chains and bare
// else both work; StructDef / EnumDef / FuncDef returns are all
// supported in every branch.

make_tagged := macro(T: Type) returns StructDef {
    if T.is(Type.Primitive(Primitive.I64)) {
        return struct {
            value: I64 = 0
            tag:   I32 = 1
        }
    } else if T.is(Type.Primitive(Primitive.I32)) {
        return struct {
            value: I64 = 0
            tag:   I32 = 2
        }
    } else {
        return struct {
            value: I64 = 0
            tag:   I32 = 3
        }
    }
}
TaggedI64 := make_tagged(I64)
TaggedI32 := make_tagged(I32)
TaggedF32 := make_tagged(F32)

test_cond_macro_struct_else_if := test() {
    a := TaggedI64(value = 1)
    b := TaggedI32(value = 2)
    c := TaggedF32(value = 3)
    assert_eq(I32, a.tag, 1)
    assert_eq(I32, b.tag, 2)
    assert_eq(I32, c.tag, 3)
}

make_default_fn := macro(T: Type) returns FuncDef {
    if T.is(Type.Primitive(Primitive.I64)) {
        return func() returns I64 { return 42 }
    } else {
        return func() returns I64 { return 0 }
    }
}
answer_fn := make_default_fn(I64)
zero_fn   := make_default_fn(F32)

test_cond_macro_funcdef := test() {
    assert_eq(I64, answer_fn(), 42)
    assert_eq(I64, zero_fn(), 0)
}

make_greeter := macro(name: Str) returns FuncDef {
    return func() returns Str { return name }
}
greeter_hi := make_greeter("hello")

test_macro_func_gen_str_param := test() {
    assert_eq(Str, greeter_hi(), "hello")
}

// --- Variant access on enum instance ---
// `v.SomeVariant` where v is an enum instance produces the variant
// constructor / tag value, same as `Opt.Some`. Previously errored in
// interpret mode with "field access on non-struct"; the typer accepted
// it for compile mode via the ns_decls lookup.

OptVAI := enum { None, Some: I64 }

test_enum_instance_variant_access := test() {
    v := OptVAI.Some(42)
    assert(v.is(v.Some))
}

// --- Struct introspection primitives (issue #56/#58) ---
// struct_field_* query a registered struct type's fields by name. The
// queried type must be live in the program (an unused type is DCE'd
// away), so the constructor call in the previous test keeps Point56 alive.

test_struct_field_primitives := test() {
    assert_eq(I64, struct_field_count("Point56"), 2)
    assert_eq(Str, "x", struct_field_name("Point56", 0))
    assert_eq(Str, "y", struct_field_name("Point56", 1))
    assert_eq(I64, struct_field_is_mut("Point56", 0), 1)
    assert_eq(I64, struct_field_is_mut("Point56", 1), 1)
    assert_eq(Str, "I64", struct_field_type("Point56", 0))
}

// --- struct_def_of assembler (issue #56/#58) ---
// Builds a StructDef value from the struct_field_* primitives (in
// src/core/ast.til). Also exercises the #213 fix: returning an owned
// aggregate holding a Vec of structs-with-owned-fields.

test_struct_def_of := test() {
    def := struct_def_of("Point56")
    assert_eq(USize, def.fields.len(), 2)
    // #307: names live in the map keys; read via the decl-order accessors.
    assert_eq(Str, "x", def.field_name_at(0))
    ref f0 : Declaration = def.field_at(0)
    expect(f0.til_type.is(Type.Unknown).not(), "f0 type is known")
    assert_eq(Str, "I64", f0.type_name())
    expect(f0.is_mut, "f0 is_mut")
    assert_eq(Str, "y", def.field_name_at(1))
    ref f1 : Declaration = def.field_at(1)
    expect(f1.til_type.is(Type.Unknown).not(), "f1 type is known")
    assert_eq(Str, "I64", f1.type_name())
}

// --- Enum introspection primitives (issue #57/#58) ---
// enum_variant_* query a registered enum type's variants by name. Like
// the struct primitives, the type must be live (the switch below keeps
// Shape56 alive). Mixes payload and payload-less variants.

Shape56 := enum {
    Circle: I64,
    Square,
    Label: Str,
}

test_enum_variant_primitives := test() {
    s := Shape56.Square
    expect(s.is(Shape56.Square), "Shape56 stays live")
    assert_eq(I64, enum_variant_count("Shape56"), 3)
    assert_eq(Str, "Circle", enum_variant_name("Shape56", 0))
    assert_eq(Str, "Square", enum_variant_name("Shape56", 1))
    assert_eq(Str, "Label", enum_variant_name("Shape56", 2))
    assert_eq(I64, enum_variant_has_payload("Shape56", 0), 1)
    assert_eq(I64, enum_variant_has_payload("Shape56", 1), 0)
    assert_eq(I64, enum_variant_has_payload("Shape56", 2), 1)
    assert_eq(Str, "I64", enum_variant_payload_type("Shape56", 0))
    assert_eq(Str, "", enum_variant_payload_type("Shape56", 1))
    assert_eq(Str, "Str", enum_variant_payload_type("Shape56", 2))
}

// #307 follow-up: the record-completing primitives. Explicit tags (#264)
// and a const payload (#211) round-trip through introspection.
TagConst56 := enum(U16) { Plain = 5, const Locked: I64 = 9, Open: Str }

test_enum_variant_record_primitives := test() {
    s := TagConst56.Plain
    expect(s.is(TagConst56.Plain), "TagConst56 stays live")
    assert_eq(I64, enum_variant_tag_value("TagConst56", 0), 5)
    assert_eq(I64, enum_variant_tag_value("TagConst56", 1), 9)
    assert_eq(I64, enum_variant_tag_value("TagConst56", 2), 10)
    assert_eq(I64, enum_variant_payload_is_const("TagConst56", 0), 0)
    assert_eq(I64, enum_variant_payload_is_const("TagConst56", 1), 1)
    assert_eq(I64, enum_variant_payload_is_const("TagConst56", 2), 0)
    assert_eq(I64, enum_variant_payload_is_ref("TagConst56", 1), 0)
}

// --- enum_def_of assembler (issue #57/#58) ---
// Builds an EnumDef value from the enum_variant_* primitives.

test_enum_def_of := test() {
    def := enum_def_of("Shape56")
    assert_eq(USize, def.variants.len(), 3)
    ref v0 : VariantDef = def.variants[0]
    ref v1 : VariantDef = def.variants[1]
    ref v2 : VariantDef = def.variants[2]
    assert_eq(Str, "Circle", v0.name)
    assert_eq(Str, "Square", v1.name)
    assert_eq(Str, "Label", v2.name)
    expect(v0.payload_type.len() > 0, "Circle has payload")
    expect(v1.payload_type.len() == 0, "Square no payload")
    assert_eq(Str, "I64", v0.payload_type)
    assert_eq(Str, "Str", v2.payload_type)
    assert_eq(I64, 1, v1.tag_value)
}

// #307 follow-up: enum_def_of is lossless -- explicit tags and payload
// flags land in the VariantDef records.
test_enum_def_of_lossless := test() {
    keep := TagConst56.Plain
    expect(keep.is(TagConst56.Plain), "TagConst56 stays live")
    def := enum_def_of("TagConst56")
    assert_eq(USize, def.variants.len(), 3)
    ref d0 : VariantDef = def.variants[0]
    ref d1 : VariantDef = def.variants[1]
    assert_eq(I64, 5, d0.tag_value)
    assert_eq(I64, 9, d1.tag_value)
    expect(d0.payload_const.not(), "Plain not const")
    expect(d1.payload_const, "Locked payload is const")
    expect(d1.payload_ref.not(), "Locked payload not ref")
    assert_eq(Str, "I64", d1.payload_type)
}

// --- FuncSig introspection primitives (issue #58) ---
// func_sig_* query a registered FuncSig (a bodyless func/proc) for its
// parameter types, return type, and throw types by name. The FuncSig
// must be live (kept so by the real calls below). til funcs have at most
// one return type, so func_sig_return_count is 0 or 1; parameter names
// are not part of a signature, only types.

apply_bin58 := func(op: BinaryOp, a: I64, b: I64) returns I64 { return op(a, b) }
add58 := func(a: I64, b: I64) returns I64 { return a.add(b) }

test_func_sig_primitives := test() {
    assert_eq(I64, apply_bin58(add58, 3, 4), 7)  // keep BinaryOp live
    assert_eq(I64, func_sig_param_count("BinaryOp"), 2)
    assert_eq(Str, "I64", func_sig_param_type("BinaryOp", 0))
    assert_eq(Str, "I64", func_sig_param_type("BinaryOp", 1))
    assert_eq(I64, func_sig_return_count("BinaryOp"), 1)
    assert_eq(Str, "I64", func_sig_return_type("BinaryOp", 0))
    assert_eq(I64, func_sig_throw_count("BinaryOp"), 0)
}

// --- func_sig_of assembler (issue #58) ---
// Builds a FunctionDef (signature) value from the func_sig_* primitives.

test_func_sig_of := test() {
    assert_eq(I64, apply_bin58(add58, 1, 1), 2)  // keep BinaryOp live
    sig := func_sig_of("BinaryOp")
    assert_eq(USize, sig.params.len(), 2)
    ref p0 : Declaration = sig.params[0]
    expect(p0.til_type.is(Type.Unknown).not(), "first param type is known")
    expect(sig.params[1].til_type.is(Type.Unknown).not(), "second param type is known")
    assert_eq(Str, "I64", p0.type_name())
    assert_eq(Str, "I64", sig.params[1].type_name())
    assert_eq(Str, "I64", sig.return_type)
    assert_eq(USize, sig.throw_types.len(), 0)
}

// --- Direct generic functions: func(T: Type, ...) (issue #58 "Phase now") ---
// A top-level func/proc whose param list uses a `Type`-named param as the
// type of another param (or the return type) is a GENERIC function. It is
// called directly with the type-arg inline -- `gid(I64, 42)` -- and init
// monomorphizes it per distinct type-arg tuple, dropping the type-args at
// the call site and synthesizing one concrete copy per tuple (deduped).
// Distinct from a plain `func(t: Type)` runtime-Type-value param, which is
// left untouched. Distinct from the macro path (`macro(T: Type) returns
// FuncDef`), which requires a separate naming step.

Point58g := struct { x: I64 = 0; y: I64 = 0 }

gid := func(T: Type, v: T) returns T { return v }
gdefault := func(T: Type) returns T { return T() }
gcombine := func(A: Type, B: Type, a: A, b: B) returns A { return a.add(b) }

uses_gid := func(n: I64) returns I64 { return gid(I64, n) }

test_generic_func_identity := test() {
    assert_eq(I64, gid(I64, 42), 42)
}
test_generic_func_constructor := test() {
    p := gdefault(Point58g)
    assert_eq(I64, p.x, 0)
}
test_generic_func_multi_param := test() {
    assert_eq(I64, gcombine(I64, I64, 7, 8), 15)
}
test_generic_func_dedup := test() {
    // Two uses of gid(I64, ..) share one monomorphization.
    assert_eq(I64, gid(I64, 1).add(gid(I64, 2)), 3)
}
test_generic_func_nested_call := test() {
    assert_eq(I64, uses_gid(99), 99)
}

// Composition: a generic func calling another generic func with the
// type-param threaded through. The synthesized body of gid2__I64
// contains `gid(I64, v)` after substitution; the post-substitute walk
// expands that to `gid__I64(v)`, otherwise the typer sees an
// unresolved generic-shaped call.
gid58g := func(T: Type, v: T) returns T { return v }
gid58g_compose := func(T: Type, v: T) returns T { return gid58g(T, v) }

test_generic_func_compose := test() {
    assert_eq(I64, gid58g_compose(I64, 99), 99)
}

// own value-args flow through the generic-call rewrite. The source
// `own a` marker is carried onto the rewritten `store__Item(vec, own a)`
// so the monomorphized callee receives ownership and consumes it
// (pushes into the Vec). ASAN-clean when the callee actually consumes
// the value (a callee that takes `own` and drops it on the floor leaks,
// exactly as a non-generic `own` func would -- that is user error, not
// a monomorphizer bug).
GItem58 := struct { n : USize = 0 }

gstore58 := func(mut into: Vec(GItem58), own v: GItem58) { into.push(own v) }

test_generic_func_own_arg := test() {
    mut vec := Vec(GItem58).new()
    a := GItem58(n = 5)
    gstore58(vec, own a)
    assert_eq(USize, vec.len(), 1)
    ref got : GItem58 = vec[0]
    assert_eq(USize, got.n, 5)
}

// Canonical swap (issue #58 example): mut value-args through a generic.
gswap58 := func(T: Type, mut a: T, mut b: T) {
    t := a
    a = b
    b = t
}

test_generic_func_swap := test() {
    mut x := 3
    mut y := 7
    gswap58(I64, x, y)
    assert_eq(I64, x, 7)
    assert_eq(I64, y, 3)
}

// #328 Task 1: every kind of real type token is accepted in a generic's
// `Type` slot, including the PRIVATE ones this unit has not mangled or
// registered yet when generic expansion runs, and a type ALIAS. The alias
// case also pins canonicalization: `MyInt328` and `I64` name the same
// monomorphization, so there is one concrete `gid328` for both.
priv PrivPoint328 := struct {
    x := 0
namespace:
    eq := func(a: PrivPoint328, b: PrivPoint328) returns Bool { return a.x.eq(b.x) }
    to_str := func(self: PrivPoint328) returns Str { return self.x.to_str() }
}
priv PrivTag328 := enum { One, Two }
priv PrivBin328 := func(a: I64, b: I64) returns I64
priv MyInt328 := I64

priv add328 := func(a: I64, b: I64) returns I64 { return a.add(b) }

gid328 := func(T: Type, v: T) returns T { return v }
gapply328 := func(T: Type, op: T, a: I64, b: I64) returns I64 { return op(a, b) }

test_generic_func_type_tokens := test() {
    p := gid328(PrivPoint328, PrivPoint328(x = 3))
    assert_eq(I64, p.x, 3)
    t := gid328(PrivTag328, PrivTag328.Two)
    assert_eq(Bool, t.is(PrivTag328.Two), true)
    assert_eq(I64, gapply328(PrivBin328, add328, 2, 5), 7)
    // `returns T` under a FuncSig T: the interpreter's Return arm used to
    // reframe the read-out fn pointer as if borrowed (its binding is a Ref
    // param), cloning it and leaking the owned box -- 8 bytes per call.
    f := gid328(PrivBin328, add328)
    assert_eq(I64, f(2, 5), 7)
    // Alias and its target select the same concrete implementation.
    assert_eq(I64, gid328(MyInt328, 11), 11)
    assert_eq(I64, gid328(I64, 12), 12)
}

// The minimal non-generic shape of the same leak: return a FuncSig-typed
// PARAMETER, bind the result, call it. Runs under the suite's ASAN, which
// is what guards the Return arm's ref-ness rule from regressing.
idf328 := func(v: PrivBin328) returns PrivBin328 { return v }

test_funcptr_param_return := test() {
    g := idf328(add328)
    assert_eq(I64, g(2, 5), 7)
}

// Siblings of the same class (audit after 4119d99e: every flow of a
// callable read out of a binding, since a callable reads back as a
// FRESH OWNED box while non-callables read back as borrows). Each shape
// pins one flow; all run under the suite's ASAN in both backends.
cflow_local328 := func(v: PrivBin328) returns I64 {
    w : PrivBin328 = v
    return w(2, 5)
}
cflow_chain_inner328 := func(v: PrivBin328) returns I64 { return v(2, 5) }
cflow_chain328 := func(v: PrivBin328) returns I64 { return cflow_chain_inner328(v) }
cflow_overwrite328 := func(a: PrivBin328, b: PrivBin328) returns I64 {
    mut w : PrivBin328 = a
    w = b
    return w(2, 5)
}
cflow_branch328 := func(v: PrivBin328, k: I64) returns PrivBin328 {
    if k == 1 { return v }
    return add328
}

test_callable_flow_shapes := test() {
    assert_eq(I64, cflow_local328(add328), 7)
    assert_eq(I64, cflow_chain328(add328), 7)
    assert_eq(I64, cflow_overwrite328(add328, add328), 7)
    fb1 := cflow_branch328(add328, 1)
    assert_eq(I64, fb1(2, 5), 7)
    fb2 := cflow_branch328(add328, 0)
    assert_eq(I64, fb2(2, 5), 7)
}

// #328 Task 2: one concrete-instantiation path. A generic reached through
// a user alias and through the alias's canonical primitive is ONE
// implementation (`gcanon328__I64`), because the shared constructor
// canonicalizes every type-argument spelling before it forms the name.
// USize keeps its own target-independent name.
priv Weight328 := USize

gcanon328 := func(T: Type, v: T) returns T { return v }

test_generic_func_canonical_name := test() {
    assert_eq(I64, gcanon328(MyInt328, 4), 4)
    assert_eq(I64, gcanon328(I64, 5), 5)
    w : USize = 6
    assert_eq(USize, gcanon328(Weight328, w), 6)
    assert_eq(USize, gcanon328(USize, w), 6)
}

// #328 Task 2: dropping a leading `Type` parameter shifts the variadic and
// kwargs block markers with it, so the value arguments still align.
gsum328 := func(T: Type, base: T, rest: ..I64) returns T {
    mut acc := base
    for i in 0..rest.len() {
        acc = acc.add(rest[i])
    }
    return acc
}
gopts328 := func(T: Type, v: T, opts: ...) returns Str {
    if opts.has("tag") {
        ref t : Str = opts.get("tag")
        return format(t, "=", v.to_str())
    }
    return v.to_str()
}

test_generic_func_type_param_layout := test() {
    assert_eq(I64, gsum328(I64, 1, 2, 3, 4), 10)
    assert_eq(I64, gsum328(I64, 7), 7)
    assert_eq(Str, gopts328(I64, 9), "9")
    assert_eq(Str, gopts328(I64, 9, tag = "n"), "n=9")
}

// #328 Task 6: OMITTED type arguments. `gid(v)` deduces T from the value
// argument, so the type only has to be written where it is genuinely
// ambiguous. A typed non-literal operand is hard evidence; a struct, an
// enum, a field, a call result and a named-FuncSig local all qualify.
E328 := enum { One328, Two328 }
Sig328 := func(a: I64, b: I64) returns I64
mkpoint328 := func() returns Point58g { return Point58g(x = 6, y = 7) }
holds328 := struct { n : USize = 0 }

test_generic_infer_hard_evidence := test() {
    n : I64 = 42
    assert_eq(I64, gid(n), 42)
    p := Point58g(x = 3, y = 4)
    assert_eq(I64, gid(p).x, 3)
    tag := E328.Two328
    assert_eq(Bool, gid(tag).is(E328.Two328), true)
    h := holds328(n = 9)
    assert_eq(USize, gid(h.n), 9)
    assert_eq(I64, gid(mkpoint328()).y, 7)
    op : Sig328 = add58
    assert_eq(I64, gapply328(op, 2, 5), 7)
    s : Str = "til"
    assert_eq(Str, gid(s), "til")
    b : Bool = true
    assert_eq(Bool, gid(b), true)
    // The explicit form still works and selects the SAME implementation.
    assert_eq(I64, gid(I64, 11), 11)
}

// #328 Task 5: name-forming provenance. A `USize` operand contributes
// the target-INDEPENDENT `USize`, not the target's primitive, whether it
// arrives as a typed local, a field, or a call result -- so all three and
// the explicit spelling land on one implementation.
usize_id328 := func(n: USize) returns USize { return n }
holds_usize328 := struct { n : USize = 0 }

test_generic_infer_declared_name := test() {
    w : USize = 3
    assert_eq(USize, gid(w), 3)
    assert_eq(USize, gid(usize_id328(w)), 3)
    hu := holds_usize328(n = 4)
    assert_eq(USize, gid(hu.n), 4)
    assert_eq(USize, gid(USize, w), 3)
}

// #328 Task 7: literals. A typed operand fixes T and the literal narrows
// against it (with the ordinary range check); with literals only, an
// integer picks I64 and a fractional/exponent literal picks F32. Str and
// Bool literals are exact evidence on their own.
gpick328 := func(T: Type, a: T, b: T) returns T {
    if a.eq(b) { return b }
    return a
}

test_generic_infer_literals := test() {
    assert_eq(I64, gid(7), 7)
    assert_eq(F32, gid(1.5), 1.5)
    assert_eq(F32, gid(2e1), 20.0)
    narrow : I32 = 5
    assert_eq(I32, gpick328(narrow, 3), 5)
    assert_eq(Str, gid("til"), "til")
    assert_eq(Bool, gid(true), true)
}

// #328 follow-up: a type parameter reached through a generated instance
// name. The parser mangles `v: Vec(T)` to `Vec__T` and `m: Map(K, V)` to
// `Map__K_V`, so the formal and its operand are two spellings of one
// shape and the argument falls out of lining the segments up. This is
// what makes such a function a template at all -- before it, `Vec__T`
// was an undefined type and `T` an unused parameter, so not even the
// explicit form worked.
gcount328 := func(T: Type, v: Vec(T)) returns USize { return v.len() }
gentries328 := func(K: Type, V: Type, m: Map(K, V)) returns USize { return m.len() }

test_generic_infer_nested_type_args := test() {
    mut xs := Vec(I64).new()
    xs.push(own 7)
    // Explicit and inferred select the same implementation.
    assert_eq(USize, gcount328(I64, xs), 1)
    assert_eq(USize, gcount328(xs), 1)
    mut names := Vec(Str).new()
    names.push(own "til")
    assert_eq(USize, gcount328(names), 1)
    // Two parameters, each bound from its own segment.
    mut m := Map(Str, I64).new()
    m.set("a", own 1)
    m.set("b", own 2)
    assert_eq(USize, gentries328(m), 2)
    assert_eq(USize, gentries328(Str, I64, m), 2)
}

// #328 Task 8: an inferred call keeps every call-shape rule an explicit
// one has -- the trailing optional location still resolves at the CALLER,
// a named argument still reaches its parameter, a `..T` variadic still
// collects its run, and a concrete body may itself queue another
// monomorphization (two batches: gtwo328 -> gid58g_compose -> gid58g).
gloc328 := func(T: Type, v: T, loc: Str = __LOC__) returns Str {
    if v.eq(v) { return loc.clone() }
    return loc.clone()
}
gvarsum328 := func(T: Type, base: T, rest: ..T) returns T {
    mut acc := base
    for i in 0..rest.len() {
        acc = acc.add(rest[i])
    }
    return acc
}
gtwo328 := func(T: Type, v: T) returns T { return gid58g_compose(v) }

test_generic_infer_call_shapes := test() {
    n : I64 = 5
    assert_eq(Bool, gloc328(n).contains("first_class.til"), true)
    assert_eq(Str, gloc328(n, loc = "explicit"), "explicit")
    // Explicit application creates the Array instance the inferred call
    // then reuses; both select one implementation.
    assert_eq(I64, gvarsum328(I64, 1, 2, 3, 4), 10)
    assert_eq(I64, gvarsum328(n, 2, 3), 10)
    assert_eq(I64, gid58g_compose(n), 5)
    assert_eq(I64, gtwo328(n), 5)
    // The headline case: no type argument on either side.
    got : I64 = 42
    assert_eq(got, 42)
    name : Str = "til"
    assert_eq(name, "til")
    assert_eq(got, 42, loc = __LOC__)
}

// #328 Task 9: inference changes TYPE application only. own/mut transfer,
// write-through and the borrowed `ref Type` monomorphization all keep
// their existing meaning.
gswap328 := func(T: Type, mut a: T, mut b: T) {
    t := a
    a = b
    b = t
}
gtake328 := func(T: Type, mut into: Vec(GItem58), own v: T) { into.push(own v) }

test_generic_infer_ownership := test() {
    mut x : I64 = 3
    mut y : I64 = 7
    gswap328(x, y)
    assert_eq(I64, x, 7)
    assert_eq(I64, y, 3)
    mut vec := Vec(GItem58).new()
    a := GItem58(n = 5)
    gtake328(vec, own a)
    assert_eq(USize, vec.len(), 1)
    ref got : GItem58 = vec[0]
    assert_eq(USize, got.n, 5)
    // A borrowed monomorphization stays an EXPLICIT `ref Type` operation;
    // it is never inferred from destination context.
    mut src : OptQBlob = OptQBlob(n = 2)
    ref r : OptQBlob = gpick_ref(ref OptQBlob, src)
    src.n = 10
    assert_eq(I64, r.n, 10)
}

// #328 Task 10: a late concrete body is cloned from the LIVE prepared
// source, so a nested definition inside it is substituted and lifted like
// any other -- `T` never survives into the lifted signature -- and lifted
// names cannot collide with the unit's earlier lambdas.
glifted328 := func(T: Type, v: T) returns T {
    same := func(x: T) returns T { return x }
    return same(v)
}

test_generic_infer_lambda := test() {
    n : I64 = 4
    assert_eq(I64, glifted328(n), 4)
    s : Str = "til"
    assert_eq(Str, glifted328(s), "til")
}

// `func<T: Type>(...)` angle-bracket sugar (parser-level): desugars to
// `macro(T: Type) returns FuncDef { return func(...) { ... } }`, mirroring
// how `struct<T: Type> { ... }` desugars to a StructDef-returning macro
// (TemplVec, #267). Reuses parse_generic_params and the existing
// init_hoist_inline_macros / init_expand_type_gen_macros pipeline: the
// inner `gid_angle(I64)` gets lifted to a synthesized monomorphization, so
// the curried call `gid_angle(I64)(7)` resolves to a concrete function
// call -- exactly analogous to `TemplVec(I64).new()`.
gid_angle := func<T: Type>(v: T) returns T { return v }
gswap_angle := func<T: Type>(mut a: T, mut b: T) {
    t := a
    a = b
    b = t
}

test_generic_func_angle_identity := test() {
    assert_eq(I64, gid_angle(I64)(7), 7)
}

// #328 follow-up: the sugar form infers an OMITTED type argument from its
// value arguments, exactly as the direct `func(T: Type, v: T)` form does.
// Before, every call through the name read as a type application, so
// `gid_angle(7)` instantiated the macro with the VALUE as its type and
// reported "undefined type 'n1_7'". The inferred and the explicit call
// name the SAME instance (`gid_angle__I64`), so the two coexist.
APoint328 := struct { x := 0 }
MyI328 := I64
ATempl328 := struct<T: Type> {
    n : T = 0
namespace:
    to_str := func(self: ATempl328(T)) returns Str { return self.n.to_str() }
}
gpair_angle := func<K: Type, V: Type>(k: K, _v: V) returns K { return k }
gproc_angle := proc<T: Type>(mut xs: Vec(Str), v: T) {
    xs.push(own v.to_str())
    print_flush()
}
// A file-scope decl reaches init's top-level expansion loop directly,
// without passing the inline hoist -- the second place the rule is needed.
gangle_toplevel := gid_angle(APoint328(x = 3))

test_generic_func_angle_inferred := test() {
    assert_eq(I64, gid_angle(7), 7)
    assert_eq(I64, gid_angle(I64)(8), 8)
    assert_eq(Str, gid_angle("hi"), "hi")
    p := gid_angle(APoint328(x = 5))
    assert_eq(I64, p.x, 5)
    assert_eq(I64, gangle_toplevel.x, 3)
    assert_eq(I64, gpair_angle(4, "s"), 4)
    // The proc flavour infers the same way the func flavour does.
    mut xs := Vec(Str).new()
    gproc_angle(xs, 6)
    assert_eq(Str, xs[0], "6")
}

// Telling a TYPE argument from a VALUE one is the whole of the rule, and
// the two shapes that are neither a bare name nor a literal decide it: a
// NESTED type application `ATempl328(I64)` is a type, while a struct
// CONSTRUCTOR `APoint328(x = 3)` is a value even though its callee also
// names a type. Reading the constructor as a type argument is what the
// bug did; reading the nested application as a value breaks the explicit
// form that has always worked, so both directions are pinned here.
test_generic_func_angle_nested_type_arg := test() {
    v := gid_angle(ATempl328(I64))(ATempl328(I64)(n = 4))
    assert_eq(I64, v.n, 4)
    // A type ALIAS names a type, and a value declared through it infers
    // to the alias target rather than to the alias name.
    assert_eq(I64, gid_angle(MyI328)(9), 9)
    aliased : MyI328 = 11
    assert_eq(I64, gid_angle(aliased), 11)
}
test_generic_func_angle_swap := test() {
    mut x := 1
    mut y := 2
    gswap_angle(I64)(x, y)
    assert_eq(I64, x, 2)
    assert_eq(I64, y, 1)
}

// --- #320 Gap 1: ref-qualified type arguments ---
// One macro serves owned AND borrowed instantiations: `make_optq(ref X)`
// marks the substituted payload borrowed (stage-a ref-payload machinery)
// and mangles the distinct type `make_optq__ref_X`. Self-references
// `make_optq(T)` inside the body land on the same instantiation in both
// type position (mangled-name segment surgery) and value position (the
// ref bit rides the substituted call).
OptQBlob := struct {
    n := 0
namespace:
    eq := func(a: OptQBlob, b: OptQBlob) returns Bool { return a.n.eq(b.n) }
    to_str := func(self: OptQBlob) returns Str { return self.n.to_str() }
}

make_optq := macro(T: Type) returns EnumDef {
    return enum {
        NoneQ
        SomeQ: T
    namespace:
        some_str := func(self: make_optq(T)) returns Str {
            switch self {
            case make_optq(T).SomeQ(p): return p.to_str()
            case: return "none"
            }
        }
    }
}

OptQOwn := make_optq(OptQBlob)
OptQRef := make_optq(ref OptQBlob)

test_ref_type_arg_borrows := test() {
    mut src := OptQBlob(n = 4)
    o := OptQRef.SomeQ(src)
    // The payload is a borrow: mutating the source is visible through it.
    src.n = 11
    assert_eq(Str, o.some_str(), "11")
    assert_eq(Str, o.to_str(), format("SomeQ(", src.to_str(), ")"))
    assert_eq(I64, src.n, 11)
}

test_ref_type_arg_distinct_from_owned := test() {
    own_o := OptQOwn.SomeQ(OptQBlob(n = 5))
    assert_eq(Str, own_o.some_str(), "5")
    n := OptQRef.NoneQ
    assert_eq(Str, n.some_str(), "none")
}

// Annotation position resolves to the SAME `__ref_X` instantiation, so
// params can name it without going through the alias.
optq_read := func(o: make_optq(ref OptQBlob)) returns Str {
    return o.some_str()
}

test_ref_type_arg_annotation_position := test() {
    src := OptQBlob(n = 7)
    o := OptQRef.SomeQ(src)
    assert_eq(Str, optq_read(o), "7")
    assert_eq(I64, src.n, 7)
}

// #320: ref-qualified type args on DIRECT generic funcs -- `returns T`
// under a ref T monomorphizes to a borrowed return.
gpick_ref := func(T: Type, a: T) returns T { return a }

test_generic_func_ref_type_arg := test() {
    mut src := OptQBlob(n = 2)
    ref r : OptQBlob = gpick_ref(ref OptQBlob, src)
    src.n = 10
    assert_eq(I64, r.n, 10)
    assert_eq(I64, src.n, 10)
    // The owned instantiation of the same generic coexists.
    assert_eq(I64, gpick_ref(I64, 5), 5)
}

// A funcptr-returning call, invoked INLINE (`f(...)(args)`) instead of
// bound first. The result type has to name a signature to validate the
// inner arg list against, and init's type_from_name_init used to hand
// back a BARE Type.FuncPtr for a FuncSig name -- the alias name dropped.
// Any call site typed before the returning function's own Decl then read
// that nameless binding and got "cannot call this expression directly".
// `inline_after328` is declared BELOW its caller on purpose: that order is
// what a monomorphized generic instance always has, which is why the
// generic form failed even with the source in the obvious order.
inline_sig328 := func(x: I64) returns I64
inline_double328 := func(x: I64) returns I64 { return x * 2 }

test_funcptr_return_called_inline := test() {
    assert_eq(I64, inline_after328()(5), 10)
    assert_eq(I64, gpick_inline328(inline_sig328, inline_double328)(6), 12)
}

inline_after328 := func() returns inline_sig328 { return inline_double328 }
gpick_inline328 := func(T: Type, f: T) returns T { return f }

direct_shadow_target := func(x: I64) returns I64 { return x + 7 }
indirect_shadow_target := func() returns I64 { return 29 }

test_direct_and_indirect_callee_identity := test() {
    assert_eq(I64, direct_shadow_target(4), 11)
    saved := direct_shadow_target
    assert_eq(I64, saved(5), 12)
    direct_shadow_target := indirect_shadow_target
    assert_eq(I64, direct_shadow_target(), 29)
}

test_builtin_name_callable_shadows := test() {
    cast := indirect_shadow_target
    free := indirect_shadow_target
    array := indirect_shadow_target
    dyn_fn := indirect_shadow_target
    assert_eq(I64, cast(), 29)
    assert_eq(I64, free(), 29)
    assert_eq(I64, array(), 29)
    assert_eq(I64, dyn_fn(), 29)
}

test_block_callable_shadow_identity := test() {
    {
        direct_shadow_target := indirect_shadow_target
        assert_eq(I64, direct_shadow_target(), 29)
    }
    assert_eq(I64, direct_shadow_target(9), 16)
}
