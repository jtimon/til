mode test

import("../src/std/file")
// mkdir_p, for the directory tests at the bottom.
import("../src/std/sys")

test_file_write_and_read := test() {
    path := "tmp/_test_file_io.txt"
    f := File.new(path, true)
    f.write("hello ")
    f.write("world")

    f2 := File.new(path, false)
    content := f2.read_all()

    assert_eq(Str, content, "hello world")
}

test_file_read_all := test() {
    path := "tmp/_test_file_read.txt"
    File.writefile(path, "abc123")

    f := File.new(path, false)
    content := f.read_all()

    assert_eq(Str, content, "abc123")
}

test_file_multiple_writes := test() {
    path := "tmp/_test_file_multi.txt"
    f := File.new(path, true)
    for i in 0..5 {
        f.write(i.to_str())
        f.write(" ")
    }

    content := File.readfile(path)
    assert_eq(Str, content, "0 1 2 3 4 ")
}

// readfile's result is an OWNED Str, so it must carry the NUL every owned
// Str carries: reading it back as a C string has to stop at the file's
// last byte. cfile_read_all used to malloc exactly count bytes and write
// no terminator, so c_str_len walked off the end of the allocation --
// garbage length here, and a heap-buffer-overflow read under ASAN.
test_file_readfile_is_nul_terminated := test() {
    path := "tmp/_test_file_readfile_nul.txt"
    File.writefile(path, "abcdef")

    content := File.readfile(path)
    assert_eq(USize, content.len(), 6)
    assert_eq(Str, Str.from_c_str(content.c_str), "abcdef")

    // The empty file is the edge case: a zero-length read still needs the
    // terminator byte, and the buffer is malloc'd for it.
    empty_path := "tmp/_test_file_readfile_nul_empty.txt"
    File.writefile(empty_path, "")
    empty := File.readfile(empty_path)
    assert_eq(USize, empty.len(), 0)
    assert_eq(Str, Str.from_c_str(empty.c_str), "")
}

// readfile grows its buffer to EOF rather than sizing it from ftell, so a
// file past the initial capacity (64K) exercises the realloc path: the
// result must be the whole file, still terminated, with no byte lost at a
// chunk boundary.
test_file_readfile_larger_than_one_chunk := test() {
    path := "tmp/_test_file_readfile_big.txt"
    line := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcde\n"
    mut expected := Str.with_capacity(line.len().mul(4096))
    f := File.new(path, true)
    for _ in 0..4096 {
        f.write(line)
        expected.push_str(line)
    }

    content := File.readfile(path)
    assert_eq(USize, content.len(), 262144)
    assert_eq(Str, content, expected)
    assert_eq(USize, Str.from_c_str(content.c_str).len(), 262144)
}

test_file_fwrite := test() {
    path := "tmp/_test_file_fwrite.txt"
    f := File.new(path, true)
    f.fwrite("x=", 3, ", y=", 4, "\n")
    parts := array(Str, "a", "b")
    f.fwrite(..parts)
    tail_parts := array(Str, "a", "b")
    f.fwrite(..parts).fwrite(..tail_parts)

    content := File.readfile(path)
    assert_eq(Str, content, "x=3, y=4\nababab")
}

test_file_seek_tell_read := test() {
    path := "tmp/_test_file_cursor.txt"
    File.writefile(path, "hello world")

    f := File.new(path, false)
    assert_eq(I64, f.tell(), 0)

    // Partial read from the start advances the cursor.
    first := f.read(5)
    assert_eq(Str, first, "hello")
    assert_eq(I64, f.tell(), 5)

    // Seek to an absolute offset, then read a region.
    f.seek(6)
    assert_eq(I64, f.tell(), 6)
    rest := f.read(5)
    assert_eq(Str, rest, "world")
}

test_file_seek_cur_and_end := test() {
    path := "tmp/_test_file_relseek.txt"
    File.writefile(path, "hello world")

    f := File.new(path, false)

    // seek_end(0) parks the cursor at EOF, so tell() gives the file size.
    f.seek_end(0)
    assert_eq(I64, f.tell(), 11)

    // Relative seek from the start: read "wor", then step back 3 and reread.
    f.seek(6)
    mid := f.read(3)
    assert_eq(Str, mid, "wor")
    f.seek_cur(-3)
    again := f.read(3)
    assert_eq(Str, again, "wor")

    // Negative offset from the end reads the final bytes.
    f.seek_end(-5)
    tail := f.read(5)
    assert_eq(Str, tail, "world")
}

test_file_read_past_eof := test() {
    path := "tmp/_test_file_eof.txt"
    File.writefile(path, "abc")

    f := File.new(path, false)
    // Asking for more bytes than remain returns only what is there.
    got := f.read(100)
    assert_eq(Str, got, "abc")
    assert_eq(I64, f.tell(), 3)
}

test_file_update_in_place := test() {
    path := "tmp/_test_file_update.txt"
    File.writefile(path, "hello world")

    // Patch a region without rewriting the whole file.
    f := File.update(path)
    f.seek(6)
    f.write("there")

    content := File.readfile(path)
    assert_eq(Str, content, "hello there")
}

test_file_remove := test() {
    path := "tmp/_test_file_remove.txt"
    File.writefile(path, "gone soon")
    assert_eq(Str, File.readfile(path), "gone soon")

    File.remove(path)
    // Assert the entry is actually gone. Re-reading after a rewrite is
    // not enough: writefile truncates, so it passes either way -- which
    // is how a silently no-op cfile_remove went unnoticed.
    assert(File.exists(path).not())

    File.writefile(path, "fresh")
    assert_eq(Str, File.readfile(path), "fresh")

    File.remove(path)
    // Removing a path that is already gone is not an error.
    File.remove(path)
}

// A path that is a VIEW, not an owned Str or a literal. substr returns
// Str(c_str = ptr_add(...), cap = CAP_VIEW) pointing into the middle of
// another buffer, so there is NO NUL at count -- here the next byte is
// 'Z'. Every C function taking a path must therefore copy through dup_n
// rather than cast c_str; without that, unlink/fopen/stat see
// "tmp/_test_view_path.txtZZZ" and quietly operate on the wrong path (or
// none). Compiled code is what this pins down: the interpreter
// materialises substr as an owned copy, so only the compiled backend
// hands a genuinely unterminated buffer to C.
test_file_c_boundary_takes_views := test() {
    backed := "tmp/_test_view_path.txtZZZ"
    path := backed.substr(0, 23)
    assert_eq(Str, path, "tmp/_test_view_path.txt")

    File.remove(path)
    assert(File.exists(path).not())

    File.writefile(path, "view-written")
    assert(File.exists(path))
    assert_eq(Str, File.readfile(path), "view-written")

    File.appendfile(path, "-more")
    assert_eq(Str, File.readfile(path), "view-written-more")

    File.remove(path)
    assert(File.exists(path).not())
    // The backing buffer is untouched: nothing wrote through the view.
    assert_eq(Str, backed, "tmp/_test_view_path.txtZZZ")
}

test_file_exists := test() {
    path := "tmp/_test_file_exists.txt"
    File.remove(path)
    assert(File.exists(path).not())

    File.writefile(path, "here")
    assert(File.exists(path))

    File.remove(path)
    assert(File.exists(path).not())

    // A directory is an existing entry too.
    assert(File.exists("tmp"))
}

test_file_append := test() {
    path := "tmp/_test_file_append.txt"
    File.remove(path)

    // Appending to a missing path creates it.
    File.appendfile(path, "one")
    assert_eq(Str, File.readfile(path), "one")

    // Every later append keeps what is already there, where writefile
    // would truncate.
    File.appendfile(path, " two")
    File.appendfile(path, " three")
    assert_eq(Str, File.readfile(path), "one two three")

    File.writefile(path, "reset")
    assert_eq(Str, File.readfile(path), "reset")

    // The handle form appends the same way.
    f := File.append(path)
    f.write(" tail")
    assert_eq(Str, File.readfile(path), "reset tail")
}

// --- Directories and whole-tree operations (issue #345) ---

// exists() answers "is there anything here"; is_dir/is_file answer
// WHAT is here, which is what a build program needs before deciding
// whether to walk a path or compile it.
test_file_path_types := test() {
    dir := "tmp/_test_path_types"
    File.remove_tree(dir)
    mkdir_p(dir)
    path := format(dir, "/plain.txt")
    File.writefile(path, "x")

    assert(File.is_dir(dir))
    assert(File.is_file(dir).not())
    assert(File.is_file(path))
    assert(File.is_dir(path).not())

    // A path that is not there is neither -- "does it exist" is a
    // separate question, with a separate answer.
    missing := format(dir, "/absent")
    assert(File.exists(missing).not())
    assert(File.is_dir(missing).not())
    assert(File.is_file(missing).not())

    File.remove_tree(dir)
}

// File.is_absolute asks about the STRING, so unlike everything else in
// this file it needs no fixture and holds on every host: a windows path
// is absolute when read on linux too, which is the entire point.
//
// Issue #347: this decision used to live in the loader as
// `starts_with("/")` alone, and no windows absolute path satisfies that.
// Every one of them read as RELATIVE and had the importing file's
// directory glued in front of it, which is why `til.exe repl` could not
// start on windows at all -- the REPL is the only thing in the tree that
// injects an absolute import. It took the windows console session in CI
// to find that, because nothing could ask the question here.
test_path_is_absolute_posix := test() {
    assert(File.is_absolute("/"))
    assert(File.is_absolute("/usr/lib/til/src/std/doc.til"))
    assert(File.is_absolute("//server/share/x.til"))
}

test_path_is_absolute_windows := test() {
    // get_bin_dir normalizes '\' to '/', so the first is the spelling the
    // REPL actually builds -- but user source may write either.
    assert(File.is_absolute("D:/a/til/til/src/std/doc.til"))
    assert(File.is_absolute("C:\\Program Files\\til\\lib.til"))
    assert(File.is_absolute("z:/lower/drive/letter"))
    assert(File.is_absolute("C:/"))
}

test_path_is_absolute_relative_stays_relative := test() {
    assert(File.is_absolute("").not())
    assert(File.is_absolute("std/doc").not())
    assert(File.is_absolute("../src/std/doc").not())
    assert(File.is_absolute("./x").not())
    // A bare drive is the process's CURRENT directory on that drive:
    // relative, and joining it to a base is as wrong as not joining a
    // rooted one.
    assert(File.is_absolute("D:").not())
    assert(File.is_absolute("D:x").not())
    // Not a drive letter, so the colon is just a character in a name.
    assert(File.is_absolute("1:/x").not())
    assert(File.is_absolute("ab:/x").not())
}

// Dir.list reports the entries themselves, never "." or ".." -- every
// caller that forgot to skip those walked its own parent.
test_dir_list := test() {
    dir := "tmp/_test_dir_list"
    File.remove_tree(dir)
    mkdir_p(format(dir, "/sub"))
    File.writefile(format(dir, "/a.txt"), "a")
    File.writefile(format(dir, "/b.txt"), "b")

    names := Dir.list(dir)
    assert_eq(USize, names.len(), 3)
    mut seen_a := false
    mut seen_b := false
    mut seen_sub := false
    for name : Str in names {
        if name == "a.txt" { seen_a = true }
        if name == "b.txt" { seen_b = true }
        if name == "sub" { seen_sub = true }
        assert(name != ".")
        assert(name != "..")
    }
    assert(seen_a)
    assert(seen_b)
    assert(seen_sub)

    // Streaming one entry at a time reports the same set.
    d := Dir.open(dir)
    mut streamed : USize = 0
    while d.next().is_empty().not() {
        streamed++
    }
    assert_eq(USize, streamed, 3)

    File.remove_tree(dir)
}

// remove_tree is `rm -rf`: a whole subtree, and a missing path is
// already removed rather than an error.
test_file_remove_tree := test() {
    dir := "tmp/_test_remove_tree"
    File.remove_tree(dir)
    mkdir_p(format(dir, "/one/two"))
    File.writefile(format(dir, "/top.txt"), "top")
    File.writefile(format(dir, "/one/mid.txt"), "mid")
    File.writefile(format(dir, "/one/two/deep.txt"), "deep")
    assert(File.is_dir(dir))

    File.remove_tree(dir)
    assert(File.exists(dir).not())

    // Removing what is not there is a no-op, not a failure.
    File.remove_tree(dir)

    // A single file is a tree of one.
    lone := "tmp/_test_remove_tree_file.txt"
    File.writefile(lone, "x")
    File.remove_tree(lone)
    assert(File.exists(lone).not())
}

// The self-rebuild primitive: a new file is built beside the old one
// and then takes its place in a single step.
test_file_rename := test() {
    old_path := "tmp/_test_rename_old.txt"
    new_path := "tmp/_test_rename_new.txt"
    File.remove(old_path)
    File.remove(new_path)

    File.writefile(new_path, "replacement")
    File.writefile(old_path, "original")
    File.rename(new_path, old_path)

    assert(File.exists(new_path).not())
    assert_eq(Str, File.readfile(old_path), "replacement")

    File.remove(old_path)
}
