mode test

test_i64_set := test() {
    mut s := Set(I64).new()
    s.add(own 3)
    s.add(own 1)
    s.add(own 2)
    assert_eq(USize, s.len(), 3)
    assert(s.has(1))
    assert(s.has(2))
    assert(s.has(3))
    assert(s.has(4).not())

    // Duplicates ignored
    s.add(own 2)
    assert_eq(USize, s.len(), 3)
}

test_str_set := test() {
    mut ss := Set(Str).new()
    ss.add(own "banana")
    ss.add(own "apple")
    ss.add(own "cherry")
    assert_eq(USize, ss.len(), 3)
    assert(ss.has("apple"))
    assert(ss.has("banana"))
    assert(ss.has("cherry"))
    assert(ss.has("date").not())
    ss.add(own "apple")
    assert_eq(USize, ss.len(), 3)
}

// --- Set literal tests ---

test_set_literal_i64 := test() {
    s := {3, 1, 2}
    assert_eq(USize, s.len(), 3)
    assert(s.has(1))
    assert(s.has(2))
    assert(s.has(3))
    assert(s.has(4).not())
}

test_set_literal_str := test() {
    s := {"apple", "banana", "cherry"}
    assert_eq(USize, s.len(), 3)
    assert(s.has("apple"))
    assert(s.has("banana"))
    assert(s.has("cherry"))
    assert(s.has("date").not())
}

// An ANNOTATED set literal -- the set half of test_map_literal_typed in
// test/maps.til, same rule: the annotation is checked against the instance
// the elements name, since the literal node carries no type itself.
test_set_literal_typed := test() {
    s : Set(I64) = {3, 1, 2}
    assert_eq(USize, s.len(), 3)
    assert(s.has(2))
}

// #323 API symmetry: Set.remove is add's removal half (Map.remove's
// counterpart), returning whether anything was removed.
test_set_remove := test() {
    mut s := Set(I64).new()
    s.add(own 3)
    s.add(own 1)
    s.add(own 2)
    assert(s.remove(2))
    assert_eq(USize, s.len(), 2)
    assert(s.has(2).not())
    assert(s.has(1))
    assert(s.has(3))
    // Absent element: no-op, reports false.
    assert(s.remove(2).not())
    assert_eq(USize, s.len(), 2)
    // Drain, including the last element.
    assert(s.remove(1))
    assert(s.remove(3))
    assert_eq(USize, s.len(), 0)
}

test_set_remove_str_frees_elem := test() {
    // ASAN would flag a leak if the removed Str's c_str were dropped
    // without being freed.
    mut s := Set(Str).new()
    s.add(own "alpha")
    s.add(own "beta")
    assert(s.remove("alpha"))
    assert(s.has("alpha").not())
    assert(s.has("beta"))
}

// Set.with_capacity mirrors Vec.with_capacity: pre-sized, so adding up
// to n reallocs zero times. n=0 stays lazy-empty.
test_set_with_capacity := test() {
    mut s := Set(I64).with_capacity(8)
    assert_eq(USize, s.len(), 0)
    assert(s.cap.gte(8))
    for i in 0..8 { s.add(own i) }
    assert_eq(USize, s.len(), 8)
    assert(s.has(0))
    assert(s.has(7))
    assert(s.has(8).not())
}

test_set_with_capacity_zero_is_lazy := test() {
    mut s := Set(Str).with_capacity(0)
    assert_eq(USize, s.len(), 0)
    assert_eq(USize, s.cap, 0)
    // Still usable: add seeds the first grow.
    s.add(own "x")
    assert(s.has("x"))
    assert_eq(USize, s.len(), 1)
}

// for-in over a Set walks its elements in sorted order (Set.unsafe_get).
test_set_for_in_sorted := test() {
    mut s := Set(I64).new()
    s.add(own 30)
    s.add(own 10)
    s.add(own 20)
    s.add(own 10)
    mut seen := Vec(I64).new()
    for x in s { seen.push(own x.clone()) }
    assert_eq(USize, seen.len(), 3)
    assert_eq(I64, seen[0], 10)
    assert_eq(I64, seen[1], 20)
    assert_eq(I64, seen[2], 30)
    for i, x in s { assert_eq(I64, x, seen[i]) }
}

test_set_for_in_str := test() {
    mut s := Set(Str).new()
    s.add(own "beta")
    s.add(own "alpha")
    mut joined := ""
    for name in s { joined = format(joined, name, ";") }
    assert_eq(Str, joined, "alpha;beta;")
    mut empty := Set(Str).new()
    for _ in empty { panic("an empty Set yields nothing") }
    empty.add(own "x")
    assert(empty.has("x"))
}
