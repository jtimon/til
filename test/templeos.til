mode cli

import("../src/std/file")
import("../src/std/sys")
import("checkers_fixture")

get_cwd_str := ext_proc() returns Str {}

WORK := "tmp/templeos"
IMAGE := "til-templeos-test"
ISO_URL := "https://templeos.org/Downloads/TempleOS.ISO"
ISO_SHA := "5d0fc944e5d89c155c0fc17c148646715bc1db6fa5750c0b913772cfec19ba26"

captured := proc(command: Cmd) returns Str {
    command.capture()
    status := command.run()
    if status != 0 { panic(command.render(), ": ", command.out(), command.err()) }
    return command.out()
}

container := proc(uid: Str, args: ..Str) returns Cmd {
    cwd := get_cwd_str()
    command := Cmd.new("docker", "run", "--rm", "--user", uid,
        "-v", format(cwd, "/", WORK, ":/work"), "-w", "/work", IMAGE)
    for arg : Str in args { command.arg(arg) }
    return command
}

// Keyboard setup belongs to this test, not to an untracked host fixture.
// Expect owns and reaps QEMU synchronously, including its timeout path.
guest_driver := func(input_commands: Str = "") returns Str {
    return format(
        "set timeout 120\nlog_user 0\n",
        "spawn qemu-system-x86_64 -accel tcg -m 512 -smp 1 -drive file=guest.raw,format=raw,if=ide -cdrom TempleOS.ISO -boot d -display none -monitor stdio -debugcon file:debug.log -global isa-debugcon.iobase=0xe9 -device isa-debug-exit,iobase=0xf4,iosize=0x04\n",
        "proc abort_guest {} {\n global deadline\n after cancel $deadline\n expect_before\n set timeout 5\n catch {send \"screendump /work/screen.ppm\\r\"}\n catch {send \"quit\\r\"}\n",
        " expect {eof {} timeout {exec kill -KILL [exp_pid]; expect eof}}\n wait\n exit 124\n}\n",
        "set deadline [after 180000 abort_guest]\nexpect_before {\n timeout {abort_guest}\n eof {after cancel $deadline; exit [lindex [wait] 3]}\n}\n",
        "expect \"(qemu)\"\nafter 20000\nsend \"sendkey n\\r\"\nexpect \"(qemu)\"\n",
        "after 5000\nsend \"sendkey n\\r\"\nexpect \"(qemu)\"\nafter 5000\n",
        "proc type_text {text} {\n foreach ch [split $text \"\"] {\n switch -- $ch {\n",
        " \"(\" {set key shift-9}\n \")\" {set key shift-0}\n \"\\\"\" {set key shift-apostrophe}\n",
        " \":\" {set key shift-semicolon}\n \";\" {set key semicolon}\n \"/\" {set key slash}\n",
        " \".\" {set key dot}\n \" \" {set key spc}\n \"*\" {set key shift-8}\n \"=\" {set key equal}\n",
        " \"'\" {set key apostrophe}\n \",\" {set key comma}\n \"_\" {set key shift-minus}\n",
        " \"-\" {set key minus}\n \">\" {set key shift-dot}\n",
        " default {if {[string is upper $ch]} {set key shift-[string tolower $ch]} else {set key $ch}}\n",
        " }\n send \"sendkey $key 30\\r\"\n expect \"(qemu)\"\n after 50\n }\n",
        " send \"sendkey ret\\r\"\n expect \"(qemu)\"\n}\n",
        "type_text {CBlkDev *bd=BlkDevNextFreeSlot('C',BDT_ATA);bd->base0=0x1F0;bd->base1=0x3F6;bd->unit=0;BlkDevAdd(bd,I64_MIN,FALSE,TRUE);}\nafter 2000\n",
        "type_text {ExeFile(\"C:/Home/Once.HC\");}\n",
        input_commands,
        "expect eof\nafter cancel $deadline\nexit [lindex [wait] 3]\n")
}

run_guest := proc(uid: Str, name: Str, expected: Str, outcome: Str, input_commands: Str = "") {
    // Every case gets a fresh writable disk, including failure cases.
    setup := container(uid, "sh", "-ec",
        "truncate -s 0 guest.raw; truncate -s 64M guest.raw; printf 'label: dos\nstart=2048,type=c\n' | sfdisk --quiet guest.raw; mformat -F -i guest.raw@@1048576 ::; mmd -i guest.raw@@1048576 ::/Home; mcopy -o -i guest.raw@@1048576 Once.HC ::/Home/Once.HC; mcopy -o -i guest.raw@@1048576 Ext.HC ::/Home/Ext.HC; mcopy -o -i guest.raw@@1048576 TILTEST.HC ::/Home/TILTEST.HC")
    setup.stdout_to(format(WORK, "/setup.log"))
    setup.stderr_to_stdout()
    if setup.run() != 0 { panic("guest disk setup failed; see ", WORK, "/setup.log") }
    File.writefile(format(WORK, "/run.exp"), guest_driver(input_commands))
    command := container(uid, "expect", "run.exp")
    command.stdout_to(format(WORK, "/run.log"))
    command.stderr_to_stdout()
    status := command.run()
    if status == 37 {
        container(uid, "mcopy", "-o", "-i", "guest.raw@@1048576", "::/Home/ERROR.LOG",
            format(name, "_compiler.log")).run_checked()
    }
    mut expected_status : I64 = 33
    mut end := "TILTEST:PASS\n"
    switch outcome {
    case "pass":
    case "panic": expected_status = 35; end = "TILTEST:PANIC\n"
    case "error": expected_status = 37; end = "TILTEST:ERROR\n"
    case "timeout": expected_status = 124; end = ""
    case: panic("unknown guest outcome '", outcome, "'")
    }
    if status != expected_status {
        panic(name, ": QEMU status ", status.to_str(), "; see ", WORK, "/run.log and debug.log")
    }
    actual := File.readfile(format(WORK, "/debug.log"))
    framed := format("TILTEST:BEGIN\n", expected, end)
    File.writefile(format(WORK, "/", name, ".log"), actual)
    if actual != framed {
        panic(name, ": guest output mismatch; expected '", framed, "', got '", actual, "'")
    }
    println("TempleOS: ", name, " passed")
}

width_checks := func(bits: Str) returns Str {
    mut bytes := "8"
    mut str_bytes := "24"
    mut array_bytes := "16"
    if bits == "32" { bytes = "4"; str_bytes = "16"; array_bytes = "12" }
    return format("\nif (sizeof(TIL_USIZE)!=", bytes,
        " || sizeof(TilStr)!=", str_bytes, " || sizeof(TilStrArray)!=", array_bytes,
        ") TilPanicZ(\"width ABI mismatch\\n\");\n",
        "TilStr width_probe; TilStrInitLit(&width_probe,\"\",0);\n",
        "if (width_probe.cap!=TIL_STR_CAP_LIT) TilPanicZ(\"literal sentinel mismatch\\n\");\n",
        "TilStrBorrowedView(&width_probe,&width_probe);\n",
        "if (width_probe.cap!=TIL_STR_CAP_VIEW) TilPanicZ(\"view sentinel mismatch\\n\");\n",
        "TilStrArray width_array; width_array.data=NULL;\n",
        "width_probe.count=TIL_STR_CAP_LIT; width_array.cap=TIL_STR_CAP_LIT;\n",
        "if (sizeof(TIL_USIZE)==8 && (width_probe.count!=0xFFFFFFFFFFFFFFFF || width_array.cap!=0xFFFFFFFFFFFFFFFF)) TilPanicZ(\"U64 count truncated\\n\");\n")
}

file_boundary_checks := func() returns Str {
    return format(
        "\nTilStr raw_path,raw_content,raw_read;\n",
        "TilStrInitLit(&raw_path,\"RAW.Z\",5); TilStrInitLit(&raw_content,\"A\\x00Ztrailing\",3);\n",
        "TilFileWrite(&raw_path,&raw_content); TilFileRead(&raw_read,&raw_path);\n",
        "if (!TilStrEq(&raw_read,&raw_content)) TilPanicZ(\"raw .Z roundtrip failed\\n\");\n",
        "TilStrDelete(&raw_read,FALSE);\n",
        "CFile *raw_file=FOpen(\"RAW.Z\",\"r\");\n",
        "if (!raw_file || FSize(raw_file)!=3) TilPanicZ(\"write changed logical length\\n\");\n",
        "U8 *sector=TilCAlloc(1,BLK_SIZE);\n",
        "if (!FBlkRead(raw_file,sector,0,1)) TilPanicZ(\"sector read failed\\n\");\n",
        "I64 byte=3; while (byte<BLK_SIZE) { if (sector[byte]) TilPanicZ(\"write leaked bytes beyond count\\n\"); byte++; }\n",
        "FClose(raw_file); TilFree(sector);\n",
        "TilStrInitLit(&raw_content,\"\",0); TilFileWrite(&raw_path,&raw_content);\n",
        "TilFileRead(&raw_read,&raw_path); if (raw_read.count) TilPanicZ(\"empty file not truncated\\n\");\n",
        "TilStrDelete(&raw_read,FALSE);\n")
}

failure_case := proc(uid: Str, bits: Str, name: Str, source: Str, expected: Str,
    setup: Str, needs_file: Bool = true) {
    path := format(WORK, "/", name, ".til")
    mut imports := ""
    if needs_file { imports = "import(\"std/file\")\n" }
    File.writefile(path, format("mode script\n", imports, source))
    Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
        "-c", format(WORK, "/TILTEST.HC"), path).run_checked()
    program := File.readfile(format(WORK, "/TILTEST.HC"))
    File.writefile(format(WORK, "/TILTEST.HC"), program.replace("\nTilMain;\n",
        format("\n", setup, "\nTilMain;\n")))
    run_guest(uid, format(name, "_", bits), expected, "panic")
}

gui_keyboard_checks := proc(identity: Str, bits: Str) {
    // Model physical state along with deterministic task messages. The example
    // and focus regression separately exercise the real PS/2/window-manager path.
    Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
        "-c", format(WORK, "/TILTEST.HC"), "examples/gui_rectangle.til").run_checked()
    File.appendfile(format(WORK, "/TILTEST.HC"), format(
        "\nU0 KeyboardMessage(I64 message,I64 ch,I64 scan) {\n",
        "BEqu(kbd.down_bitmap2,(scan>>32)&255,message==MSG_KEY_DOWN); Msg(message,ch,scan); }\n",
        "\nU0 KeyboardBoundaryChecks() {\n",
        "U32 old_physical[8]; MemCpy(old_physical,kbd.down_bitmap2,sizeof(old_physical));\n",
        "TilGuiInitWindow(640,480,\"keyboard boundaries\");\n",
        "if (TilGuiGetKeyPressed || TilGuiGetCharPressed || !TilGuiIsKeyUp(65)) TilPanicZ(\"initial input\\n\");\n",
        "if (TilGuiKeyCode(0x3600000036)!=344 || TilGuiKeyCode(0x9D0000009D)!=345 || TilGuiKeyCode(0x4700000047)!=327 || TilGuiKeyCode(0xC7000000C7)!=268) TilPanicZ(\"physical keys\\n\");\n",
        "KeyboardMessage(MSG_KEY_DOWN,'a',0x1E0000001E); TilGuiPollInput;\n",
        "if (!TilGuiIsKeyDown(65) || !TilGuiIsKeyPressed(65) || TilGuiIsKeyPressedRepeat(65) || TilGuiGetKeyPressed!=65 || TilGuiGetKeyPressed || TilGuiGetCharPressed!='a' || TilGuiGetCharPressed) TilPanicZ(\"key press\\n\");\n",
        "TilGuiPollInput; if (!TilGuiIsKeyDown(65) || TilGuiIsKeyPressed(65)) TilPanicZ(\"held key\\n\");\n",
        "KeyboardMessage(MSG_KEY_DOWN,'a',0x1E0000001E); TilGuiPollInput;\n",
        "if (!TilGuiIsKeyPressedRepeat(65) || TilGuiIsKeyPressed(65) || TilGuiGetKeyPressed || TilGuiGetCharPressed!='a') TilPanicZ(\"key repeat\\n\");\n",
        "KeyboardMessage(MSG_KEY_UP,'a',0x11E0000011E); TilGuiPollInput;\n",
        "if (!TilGuiIsKeyReleased(65) || !TilGuiIsKeyUp(65) || TilGuiIsKeyPressedRepeat(65)) TilPanicZ(\"key release\\n\");\n",
        "KeyboardMessage(MSG_KEY_DOWN,'B',0x23000000230); KeyboardMessage(MSG_KEY_UP,'B',0x33000000330);\n",
        "KeyboardMessage(MSG_KEY_DOWN,0,0xCD0000004D); KeyboardMessage(MSG_KEY_UP,0,0x1CD0000014D); TilGuiPollInput;\n",
        "if (TilGuiGetKeyPressed!=66 || TilGuiGetKeyPressed!=262 || TilGuiGetKeyPressed || TilGuiGetCharPressed!='B' || TilGuiGetCharPressed || TilGuiIsKeyPressed(66) || TilGuiIsKeyDown(66)) TilPanicZ(\"queue order or short tap\\n\");\n",
        "KeyboardMessage(MSG_KEY_DOWN,'c',0x2E0000002E); TilGuiPollInput; TilGuiPollInput;\n",
        "if (TilGuiGetKeyPressed || TilGuiGetCharPressed || TilGuiIsKeyReleased(65)) TilPanicZ(\"stale frame input\\n\");\n",
        "KeyboardMessage(MSG_KEY_DOWN,1,0x41E0000041E); TilGuiPollInput; if (TilGuiGetCharPressed) TilPanicZ(\"control text\\n\");\n",
        "TilGuiSetExitKey(0); KeyboardMessage(MSG_KEY_DOWN,CH_ESC,0x100000001); TilGuiPollInput;\n",
        "if (TilGuiWindowShouldClose) TilPanicZ(\"disabled exit key\\n\");\n",
        "TilGuiSetExitKey(257); KeyboardMessage(MSG_KEY_DOWN,'\\n',0x1C0000001C); TilGuiPollInput;\n",
        "if (!TilGuiWindowShouldClose || TilGuiGetCharPressed) TilPanicZ(\"exit key\\n\");\n",
        "TilGuiCloseWindow; TilGuiInitWindow(640,480,\"reopened\");\n",
        "if (TilGuiWindowShouldClose || TilGuiGetKeyPressed || TilGuiGetCharPressed || TilGuiIsKeyDown(67)) TilPanicZ(\"reopen state\\n\");\n",
        "TilGuiCloseWindow; MemCpy(kbd.down_bitmap2,old_physical,sizeof(old_physical)); }\nKeyboardBoundaryChecks;\n"))
    run_guest(identity, format("gui_keyboard_boundaries_", bits), "", "pass")
    Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
        "-c", format(WORK, "/TILTEST.HC"), "examples/gui_keyboard.til").run_checked()
    File.appendfile(format(WORK, "/TILTEST.HC"), "\nTilMain;\n")
    input := format("after 4000\n",
        "foreach key {a shift-b backspace shift-4 shift-spc shift-1 ctrl-a c right right left ret} {\n",
        "send \"sendkey $key 80\\r\"\nexpect \"(qemu)\"\nafter 500\n}\n")
    run_guest(identity, format("gui_keyboard_", bits), "GUI keyboard: a$ !c cursor=1\n", "pass", input)
}

gui_keyboard_focus_checks := proc(identity: Str, bits: Str) {
    Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
        "-c", format(WORK, "/TILTEST.HC"), "examples/gui_rectangle.til").run_checked()
    File.appendfile(format(WORK, "/TILTEST.HC"), format(
        "\nBool KeyboardPeerReady=FALSE;\n",
        "U0 KeyboardFocusPeer() {\n",
        "Fs->win_inhibit=WIG_USER_TASK_DFT; KeyboardPeerReady=TRUE;\n",
        "while (TRUE) { FlushMsgs; Sleep(10); } }\n",
        "U0 KeyboardFocusChecks() {\n",
        "CTask *owner=Fs,*peer=Spawn(&KeyboardFocusPeer,NULL,\"keyboard peer\");\n",
        "while (!KeyboardPeerReady) Yield;\n",
        "TilGuiInitWindow(640,480,\"keyboard focus\"); TilGuiSetTargetFPS(30);\n",
        "while (!TilGuiIsKeyDown(65)) TilGuiEndDrawing;\n",
        "if (!TilGuiIsKeyPressed(65) || !TilGuiIsKeyDown(340) || !Bt(kbd.down_bitmap2,0x1E) || !Bt(kbd.down_bitmap2,0x2A)) TilPanicZ(\"initial physical press\\n\");\n",
        "while (TilGuiGetKeyPressed) {} while (TilGuiGetCharPressed) {}\n",
        "WinFocus(peer); TilGuiPollInput;\n",
        "if (TilGuiIsKeyDown(65) || !TilGuiIsKeyUp(65) || !TilGuiIsKeyReleased(65) || TilGuiIsKeyDown(340) || !TilGuiIsKeyReleased(340) || TilGuiIsKeyPressed(65) || TilGuiIsKeyPressedRepeat(65) || TilGuiGetKeyPressed || TilGuiGetCharPressed) TilPanicZ(\"focus loss retained held key\\n\");\n",
        "TilGuiPollInput; if (TilGuiIsKeyReleased(65) || TilGuiIsKeyReleased(340)) TilPanicZ(\"focus release persisted\\n\");\n",
        "while (Bt(kbd.down_bitmap2,0x1E)) Sleep(10);\n",
        "while (!Bt(kbd.down_bitmap2,0x30)) Sleep(10);\n",
        "TilGuiPollInput; if (TilGuiIsKeyDown(66) || TilGuiGetKeyPressed || TilGuiGetCharPressed) TilPanicZ(\"background key reached GUI\\n\");\n",
        "WinFocus(owner); TilGuiPollInput;\n",
        "if (TilGuiIsKeyDown(65) || TilGuiIsKeyDown(340) || TilGuiIsKeyDown(66) || TilGuiIsKeyPressed(66) || TilGuiGetKeyPressed || TilGuiGetCharPressed) TilPanicZ(\"refocus resurrected background key\\n\");\n",
        "while (Bt(kbd.down_bitmap2,0x30)) TilGuiEndDrawing;\n",
        "while (!TilGuiIsKeyDown(67)) TilGuiEndDrawing;\n",
        "if (!TilGuiIsKeyPressed(67) || TilGuiIsKeyPressedRepeat(67) || TilGuiGetKeyPressed!=67 || TilGuiGetCharPressed!='c') TilPanicZ(\"fresh press after refocus\\n\");\n",
        "while (TilGuiIsKeyDown(67)) TilGuiEndDrawing;\n",
        "while (!TilGuiIsKeyDown(68)) TilGuiEndDrawing;\n",
        "TilGuiGetKeyPressed; TilGuiGetCharPressed;\n",
        "WinFocus(peer); while (Bt(kbd.down_bitmap2,0x20)) Sleep(10); WinFocus(owner);\n",
        "TilGuiPollInput;\n",
        "if (TilGuiIsKeyDown(68) || !TilGuiIsKeyReleased(68) || TilGuiGetKeyPressed || TilGuiGetCharPressed || TilGuiIsKeyPressedRepeat(68)) TilPanicZ(\"between-frame focus release lost\\n\");\n",
        "TilGuiPollInput; if (TilGuiIsKeyReleased(68)) TilPanicZ(\"between-frame release persisted\\n\");\n",
        "TilGuiCloseWindow; Kill(peer); TilRawWrite(\"GUI keyboard focus passed\\n\",26); }\n",
        "KeyboardFocusChecks;\n"))
    input := format("after 4000\n",
        "send \"sendkey shift-a 800\\r\"\nexpect \"(qemu)\"\nafter 1200\n",
        "send \"sendkey b 300\\r\"\nexpect \"(qemu)\"\nafter 700\n",
        "send \"sendkey c 150\\r\"\nexpect \"(qemu)\"\nafter 500\n",
        "send \"sendkey d 300\\r\"\nexpect \"(qemu)\"\n")
    run_guest(identity, format("gui_keyboard_focus_", bits), "GUI keyboard focus passed\n", "pass", input)
}

gui_scissor_checks := proc(identity: Str, bits: Str) {
    Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
        "-c", format(WORK, "/TILTEST.HC"), "examples/gui_scissor.til").run_checked()
    program := File.readfile(format(WORK, "/TILTEST.HC"))
    // The native AutoComplete task is always on top and overlaps the panes.
    // Check the application's unobscured composited pixels, then restore it.
    File.appendfile(format(WORK, "/TILTEST.HC"),
        "\nBool scissor_old_ac=AutoComplete(OFF); TilMain; AutoComplete(scissor_old_ac);\n")
    run_guest(identity, format("gui_scissor_", bits), "GUI scissor passed\n", "pass")

    File.writefile(format(WORK, "/TILTEST.HC"), format(program,
        "\nU0 ScissorLifecycleChecks() {\n",
        "TilGuiColor blue,red,white; MemSet(&blue,0,sizeof(blue)); MemSet(&red,0,sizeof(red)); MemSet(&white,255,sizeof(white));\n",
        "blue.b=170; blue.a=255; red.r=170; red.a=255;\n",
        "TilGuiInitWindow(640,480,\"scissor lifetime\"); TilGuiSetTargetFPS(0);\n",
        "TilGuiBeginDrawing; TilGuiClearBackground(&blue); TilGuiBeginScissorMode(4,4,2,2);\n",
        "TilGuiDrawRectangle(0,0,16,16,&red); TilGuiEndDrawing;\n",
        "if (GrPeek(TilGuiFront,4,4)!=RED || GrPeek(TilGuiFront,3,4)!=BLUE || GrPeek(TilGuiFront,6,4)!=BLUE) TilPanicZ(\"initial scissor bounds\\n\");\n",
        "TilGuiBeginDrawing; TilGuiClearBackground(&white); TilGuiEndDrawing;\n",
        "if (GrPeek(TilGuiFront,4,4)!=WHITE || GrPeek(TilGuiFront,3,4)!=BLACK || GrPeek(TilGuiFront,6,4)!=BLACK) TilPanicZ(\"scissor lost across frame swap\\n\");\n",
        "TilGuiEndScissorMode; TilGuiBeginScissorMode(0,0,0,0); TilGuiCloseWindow;\n",
        "TilGuiInitWindow(640,480,\"scissor reopened\"); TilGuiBeginDrawing;\n",
        "TilGuiClearBackground(&blue); TilGuiDrawRectangle(4,4,2,2,&white); TilGuiEndDrawing;\n",
        "if (GrPeek(TilGuiFront,200,200)!=BLUE || GrPeek(TilGuiFront,4,4)!=WHITE) TilPanicZ(\"scissor leaked across reopen\\n\");\n",
        "TilGuiCloseWindow; TilRawWrite(\"GUI scissor lifecycle passed\\n\",29); }\nScissorLifecycleChecks;\n"))
    run_guest(identity, format("gui_scissor_lifecycle_", bits), "GUI scissor lifecycle passed\n", "pass")

    File.writefile(format(WORK, "/TILTEST.HC"), format(program,
        "\nTilGuiBeginScissorMode(0,0,-1,16);\n"))
    run_guest(identity, format("gui_scissor_negative_", bits), "GUI scissor requires nonnegative extents\n", "panic")
}

// Injected input is paced at 500ms per monitor command. The facade samples
// mouse buttons per frame (TilGuiPollInput reconciles them with ms.lb/ms.rb),
// so a press, move and release that all land inside one guest frame are
// never seen as a drag; under QEMU TCG a frame of this demo can run well
// past 150ms. Runs 2843-2847 lost drags, wheel clicks and a cursor key at
// 150-300ms pacing.
gui_mouse_input := func() returns Str {
    return format("after 4000\nfor {set run 0} {$run<2} {incr run} {\n",
        "foreach command {\"mouse_move 160 160\" \"mouse_button 1\" \"mouse_move 80 0\" \"mouse_button 0\" \"mouse_button 2\" \"mouse_button 0\" \"mouse_move 600 0\" \"mouse_button 1\" \"mouse_move -120 0\" \"mouse_button 0\" \"mouse_move 8 24\"} {\n",
        "send \"$command\\r\"\nexpect \"(qemu)\"\nafter 500\n}\n",
        "send \"sendkey ret 80\\r\"\nexpect \"(qemu)\"\nafter 600\n}\n")
}

gui_mouse_checks := proc(identity: Str, bits: Str) {
    Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
        "-c", format(WORK, "/TILTEST.HC"), "test/holyc_i32_divmod.til").run_checked()
    run_guest(identity, format("i32_divmod_", bits), "I32 divmod passed\n", "pass")
    Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
        "-c", format(WORK, "/TILTEST.HC"), "examples/gui_mouse.til").run_checked()
    program := File.readfile(format(WORK, "/TILTEST.HC"))
    // Loading the module once and calling TilMain twice exercises manual VM reuse.
    File.appendfile(format(WORK, "/TILTEST.HC"),
        "\nBool mouse_old_ac=AutoComplete(OFF); MsSet(0,0); TilMain; MsSet(0,0); TilMain; AutoComplete(mouse_old_ac);\n")
    expected := "GUI mouse: pane=1 selection=2..5 resets=1 dragging=false\n"
    run_guest(identity, format("gui_mouse_", bits), format(expected, expected), "pass", gui_mouse_input())

    File.writefile(format(WORK, "/TILTEST.HC"), format(program,
        "\nBool MousePeerReady=FALSE;\n",
        "U0 MouseFocusPeer() { Fs->win_inhibit=WIG_USER_TASK_DFT|WIF_SELF_MS_L|WIF_SELF_MS_R; MousePeerReady=TRUE; while (TRUE) { FlushMsgs; Sleep(10); } }\n",
        "U0 MouseBoundaryChecks() {\n",
        "CTask *owner=Fs,*peer=Spawn(&MouseFocusPeer,NULL,\"mouse peer\"); I64 old_inhibit=Fs->win_inhibit; TilGuiVector2 position;\n",
        "while (!MousePeerReady) Yield; TilGuiInitWindow(640,480,\"mouse boundaries\");\n",
        "if (TilGuiIsMouseButtonDown(0) || !TilGuiIsMouseButtonUp(0) || TilGuiIsMouseButtonPressed(0) || TilGuiIsMouseButtonReleased(0)) TilPanicZ(\"initial mouse state\\n\");\n",
        "MsSet(80,90,0,TRUE,FALSE); Msg(MSG_MS_L_DOWN,80,90); TilGuiPollInput; TilGuiGetMousePosition(&position);\n",
        "if (TilGuiGetMouseX!=80 || TilGuiGetMouseY!=90 || TilF32Load(position.x)!=80.0 || TilF32Load(position.y)!=90.0) TilPanicZ(\"mouse position ABI\\n\");\n",
        "if (!TilGuiIsMouseButtonDown(0) || !TilGuiIsMouseButtonPressed(0) || !TilGuiIsMouseButtonPressed(0)) TilPanicZ(\"mouse press\\n\");\n",
        "TilGuiPollInput; if (!TilGuiIsMouseButtonDown(0) || TilGuiIsMouseButtonPressed(0)) TilPanicZ(\"held mouse state\\n\");\n",
        "MsSet(120,90,0,TRUE,TRUE); Msg(MSG_MS_R_DOWN,120,90); TilGuiPollInput;\n",
        "if (!TilGuiIsMouseButtonDown(0) || !TilGuiIsMouseButtonPressed(1) || TilGuiGetMouseX!=120) TilPanicZ(\"mouse drag/chord\\n\");\n",
        "MsSet(120,90,0,FALSE,TRUE); Msg(MSG_MS_L_UP,120,90); TilGuiPollInput;\n",
        "if (!TilGuiIsMouseButtonReleased(0) || TilGuiIsMouseButtonDown(0) || !TilGuiIsMouseButtonDown(1)) TilPanicZ(\"mouse release\\n\");\n",
        "WinFocus(peer); TilGuiPollInput; if (TilGuiIsMouseButtonDown(1) || !TilGuiIsMouseButtonReleased(1)) TilPanicZ(\"mouse stuck on blur\\n\");\n",
        "TilGuiPollInput; if (TilGuiIsMouseButtonReleased(1)) TilPanicZ(\"mouse release persisted\\n\");\n",
        "MsSet(120,90,0,FALSE,FALSE); Sleep(40); WinFocus(owner); TilGuiPollInput;\n",
        "if (TilGuiIsMouseButtonDown(1) || TilGuiIsMouseButtonPressed(1)) TilPanicZ(\"mouse resurrected on refocus\\n\");\n",
        "MsSet(120,90,0,TRUE,FALSE); Msg(MSG_MS_L_DOWN,120,90); TilGuiPollInput;\n",
        "WinFocus(peer); MsSet(120,90,0,FALSE,FALSE); Sleep(40); WinFocus(owner); TilGuiPollInput;\n",
        "if (TilGuiIsMouseButtonDown(0) || !TilGuiIsMouseButtonReleased(0)) TilPanicZ(\"between-frame mouse release lost\\n\");\n",
        "TilGuiPollInput; MsSet(120,90,0,TRUE,FALSE); Msg(MSG_MS_L_DOWN,120,90); MsSet(120,90,0,FALSE,FALSE); Msg(MSG_MS_L_UP,120,90); TilGuiPollInput;\n",
        "if (TilGuiIsMouseButtonPressed(0) || TilGuiIsMouseButtonReleased(0)) TilPanicZ(\"same-frame mouse tap\\n\");\n",
        "WinHorz(10,79); MsSet(72,90); TilGuiPollInput; TilGuiGetMousePosition(&position);\n",
        "if (TilGuiGetMouseX!=-8 || TilF32Load(position.x)!=-8.0 || TilGuiGetMouseY!=90) TilPanicZ(\"mouse client coordinates\\n\");\n",
        "if (TilGuiIsMouseButtonDown(-1) || TilGuiIsMouseButtonUp(8)) TilPanicZ(\"invalid mouse button\\n\");\n",
        "TilGuiCloseWindow; if (Fs->win_inhibit!=old_inhibit) TilPanicZ(\"mouse window policy not restored\\n\");\n",
        "TilGuiInitWindow(640,480,\"mouse reopened\"); if (TilGuiIsMouseButtonDown(0) || TilGuiIsMouseButtonReleased(0)) TilPanicZ(\"mouse reopen state\\n\");\n",
        "TilGuiCloseWindow; Kill(peer); TilRawWrite(\"GUI mouse boundaries passed\\n\",28); }\nMouseBoundaryChecks;\n"))
    run_guest(identity, format("gui_mouse_boundaries_", bits), "GUI mouse boundaries passed\n", "pass")
    File.writefile(format(WORK, "/TILTEST.HC"), format(program, "\nTilGuiIsMouseButtonDown(3);\n"))
    run_guest(identity, format("gui_mouse_unsupported_", bits), "GUI mouse POC supports left/right/middle buttons\n", "panic")
}

gui_wheel_checks := proc(identity: Str, bits: Str) {
    Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
        "-c", format(WORK, "/TILTEST.HC"), "examples/gui_mouse.til").run_checked()
    program := File.readfile(format(WORK, "/TILTEST.HC"))
    File.appendfile(format(WORK, "/TILTEST.HC"),
        "\nBool wheel_old_ac=AutoComplete(OFF); MsSet(0,0,0); TilMain; AutoComplete(wheel_old_ac);\n")
    input := format("after 4000\n",
        "foreach command {\"mouse_move 160 160\" \"mouse_move 0 0 -1\" \"mouse_move 0 0 -1\" \"mouse_move 0 0 -1\" \"mouse_move 0 0 1\" \"mouse_move 640 0\" \"mouse_move 0 0 -1\"} {\n",
        "send \"$command\\r\"\nexpect \"(qemu)\"\nafter 500\n}\n",
        "send \"sendkey ret 80\\r\"\nexpect \"(qemu)\"\n")
    run_guest(identity, format("gui_wheel_", bits),
        "GUI mouse: pane=0 selection=0..0 resets=0 dragging=false\nGUI wheel: left=2 right=1\n", "pass", input)

    File.writefile(format(WORK, "/TILTEST.HC"), format(program,
        "\nBool WheelPeerReady=FALSE;\n",
        "U0 WheelFocusPeer() { Fs->win_inhibit=WIG_USER_TASK_DFT; LBts(&Fs->display_flags,DISPLAYf_SHOW); WinHorz(0,79); WinVert(0,59); WheelPeerReady=TRUE; while (TRUE) { FlushMsgs; Sleep(10); } }\n",
        "U0 WheelBoundaryChecks() {\n",
        "CTask *owner=Fs,*peer=Spawn(&WheelFocusPeer,NULL,\"wheel peer\"); CCtrl *old_head=Fs->next_ctrl; I64 old_inhibit=Fs->win_inhibit,row=5,i; F32 fraction=0; TilGuiVector2 move;\n",
        "while (!WheelPeerReady) Yield; TilGuiInitWindow(640,480,\"wheel boundaries\");\n",
        "if (TilF32Load(TilGuiGetMouseWheelMove)!=0.0) TilPanicZ(\"initial wheel delta\\n\");\n",
        "for (i=0;i<3;i++) mouse_scroll(TilF32Round(0.25),&row,&fraction); if (row!=5) TilPanicZ(\"fractional scroll moved early\\n\");\n",
        "mouse_scroll(TilF32Round(0.25),&row,&fraction); if (row!=4 || TilF32Load(fraction)!=0.0) TilPanicZ(\"fractional scroll accumulation\\n\");\n",
        "mouse_scroll(TilF32Round(-200.0),&row,&fraction); if (row!=97) TilPanicZ(\"scroll bottom clamp\\n\"); mouse_scroll(TilF32Round(200.0),&row,&fraction); if (row!=0) TilPanicZ(\"scroll top clamp\\n\");\n",
        "(*TilGuiWheelControl->wheel_chg)(TilGuiWheelControl,-1); (*TilGuiWheelControl->wheel_chg)(TilGuiWheelControl,-2); TilGuiPollInput;\n",
        "TilGuiGetMouseWheelMoveV(&move);\n",
        "if (sizeof(move)!=8 || TilF32Load(move.x)!=0.0 || TilF32Load(move.y)!=2.0 || TilF32Load(TilGuiGetMouseWheelMove)!=2.0 || TilF32Load(TilGuiGetMouseWheelMove)!=2.0) TilPanicZ(\"last wheel snapshot or ABI\\n\");\n",
        "TilGuiPollInput; if (TilF32Load(TilGuiGetMouseWheelMove)!=0.0) TilPanicZ(\"wheel frame expiry\\n\");\n",
        "(*TilGuiWheelControl->wheel_chg)(TilGuiWheelControl,5); (*TilGuiWheelControl->wheel_chg)(TilGuiWheelControl,-5); TilGuiPollInput;\n",
        "if (TilF32Load(TilGuiGetMouseWheelMove)!=5.0) TilPanicZ(\"opposite wheel event replacement\\n\");\n",
        "(*TilGuiWheelControl->wheel_chg)(TilGuiWheelControl,0); TilGuiPollInput; if (TilF32Load(TilGuiGetMouseWheelMove)!=0.0) TilPanicZ(\"zero wheel event replacement\\n\");\n",
        "(*TilGuiWheelControl->wheel_chg)(TilGuiWheelControl,-4); WinFocus(peer); TilGuiPollInput;\n",
        "if (TilF32Load(TilGuiGetMouseWheelMove)!=0.0) TilPanicZ(\"wheel retained across blur\\n\");\n",
        "WinFocus(owner); TilGuiPollInput; if (TilF32Load(TilGuiGetMouseWheelMove)!=0.0) TilPanicZ(\"wheel replayed on refocus\\n\");\n",
        "(*TilGuiWheelControl->wheel_chg)(TilGuiWheelControl,2); TilGuiPollInput;\n",
        "if (TilF32Load(TilGuiGetMouseWheelMove)!=-2.0) TilPanicZ(\"fresh wheel after refocus\\n\");\n",
        "TilGuiPollInput; WinFocus(peer); MsSet(200,200,ms.pos.z+3); Sleep(100); WinFocus(owner); TilGuiPollInput;\n",
        "if (TilF32Load(TilGuiGetMouseWheelMove)!=0.0) TilPanicZ(\"background wheel replayed between polls\\n\");\n",
        "(*TilGuiWheelControl->wheel_chg)(TilGuiWheelControl,-9); TilGuiCloseWindow;\n",
        "if (Fs->next_ctrl!=old_head || Fs->win_inhibit!=old_inhibit) TilPanicZ(\"wheel control lifetime\\n\");\n",
        "TilGuiInitWindow(640,480,\"wheel reopened\"); if (TilF32Load(TilGuiGetMouseWheelMove)!=0.0) TilPanicZ(\"wheel reopen delta\\n\");\n",
        "TilGuiCloseWindow; Kill(peer); TilRawWrite(\"GUI wheel boundaries passed\\n\",28); }\nWheelBoundaryChecks;\n"))
    run_guest(identity, format("gui_wheel_boundaries_", bits), "GUI wheel boundaries passed\n", "pass")
}

gui_middle_checks := proc(identity: Str, bits: Str) {
    Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
        "-c", format(WORK, "/TILTEST.HC"), "examples/gui_mouse.til").run_checked()
    program := File.readfile(format(WORK, "/TILTEST.HC"))
    File.appendfile(format(WORK, "/TILTEST.HC"),
        "\nBool middle_old_ac=AutoComplete(OFF); MsSet(0,0,0); TilMain; MsSet(0,0,0); TilMain; AutoComplete(middle_old_ac);\n")
    input := format("after 4000\nfor {set run 0} {$run<2} {incr run} {\n",
        "foreach command {\"mouse_move 160 160\" \"mouse_move 0 0 -1\" \"mouse_move 0 0 -1\" \"mouse_move 640 0\" \"mouse_move 0 0 -1\"} {\n",
        "send \"$command\\r\"\nexpect \"(qemu)\"\nafter 500\n}\n",
        "if {$run==0} {send \"mouse_move -640 0\\r\"\nexpect \"(qemu)\"\nafter 500}\n",
        "send \"mouse_button 4\\r\"\nexpect \"(qemu)\"\nafter 500\n",
        "if {$run==0} {send \"mouse_move 640 0\\r\"} else {send \"mouse_move -640 0\\r\"}\nexpect \"(qemu)\"\nafter 500\n",
        "send \"mouse_button 0\\r\"\nexpect \"(qemu)\"\nafter 500\n",
        "send \"sendkey ret 80\\r\"\nexpect \"(qemu)\"\nafter 600\n}\n")
    mouse_line := "GUI mouse: pane=0 selection=0..0 resets=0 dragging=false\n"
    run_guest(identity, format("gui_middle_", bits), format(mouse_line,
        "GUI wheel: left=0 right=1\nGUI middle: resets=1\n", mouse_line,
        "GUI wheel: left=2 right=0\nGUI middle: resets=1\n"), "pass", input)

    File.writefile(format(WORK, "/TILTEST.HC"), format(program,
        "\nBool MiddlePeerReady=FALSE;\n",
        "U0 MiddleFocusPeer() { Fs->win_inhibit=WIG_USER_TASK_DFT; LBts(&Fs->display_flags,DISPLAYf_SHOW); WinHorz(0,79); WinVert(0,59); MiddlePeerReady=TRUE; while (TRUE) { FlushMsgs; Sleep(10); } }\n",
        "U0 MiddleBoundaryChecks() {\n",
        "CTask *owner=Fs,*peer=Spawn(&MiddleFocusPeer,NULL,\"middle peer\"); CCtrl *old_head=Fs->next_ctrl; Bool old_middle=ms_hard.bttns[2]; I64 old_inhibit=Fs->win_inhibit;\n",
        "while (!MiddlePeerReady) Yield; ms_hard.bttns[2]=TRUE; TilGuiInitWindow(640,480,\"middle boundaries\"); TilGuiPollInput;\n",
        "if (TilGuiIsMouseButtonDown(2) || !TilGuiIsMouseButtonUp(2) || TilGuiIsMouseButtonPressed(2) || TilGuiIsMouseButtonReleased(2)) TilPanicZ(\"pre-open middle hold became press\\n\");\n",
        "ms_hard.bttns[2]=FALSE; TaskDerivedValsUpdate(owner,FALSE); TilGuiPollInput; if (TilGuiIsMouseButtonReleased(2)) TilPanicZ(\"unowned middle release\\n\");\n",
        "ms_hard.bttns[2]=TRUE; TaskDerivedValsUpdate(owner,FALSE); TilGuiPollInput;\n",
        "if (!TilGuiIsMouseButtonPressed(2) || !TilGuiIsMouseButtonDown(2) || !TilGuiIsMouseButtonPressed(2) || TilGuiIsMouseButtonUp(2)) TilPanicZ(\"middle press snapshot\\n\");\n",
        "TilGuiPollInput; if (!TilGuiIsMouseButtonDown(2) || TilGuiIsMouseButtonPressed(2)) TilPanicZ(\"held middle snapshot\\n\");\n",
        "MsSet(120,90,0,TRUE,TRUE); Msg(MSG_MS_L_DOWN,120,90); Msg(MSG_MS_R_DOWN,120,90); TilGuiPollInput;\n",
        "if (!TilGuiIsMouseButtonDown(0) || !TilGuiIsMouseButtonDown(1) || !TilGuiIsMouseButtonDown(2)) TilPanicZ(\"middle chord\\n\");\n",
        "ms_hard.bttns[2]=FALSE; TilGuiPollInput;\n",
        "if (!TilGuiIsMouseButtonReleased(2) || !TilGuiIsMouseButtonUp(2) || !TilGuiIsMouseButtonDown(0) || !TilGuiIsMouseButtonDown(1)) TilPanicZ(\"middle physical release\\n\");\n",
        "MsSet(120,90,0,FALSE,FALSE); Msg(MSG_MS_L_UP,120,90); Msg(MSG_MS_R_UP,120,90); TilGuiPollInput; if (TilGuiIsMouseButtonReleased(2)) TilPanicZ(\"middle release persisted\\n\");\n",
        "ms_hard.bttns[2]=TRUE; TaskDerivedValsUpdate(owner,FALSE); ms_hard.bttns[2]=FALSE; TaskDerivedValsUpdate(owner,FALSE); TilGuiPollInput;\n",
        "if (TilGuiIsMouseButtonPressed(2) || TilGuiIsMouseButtonReleased(2)) TilPanicZ(\"same-frame middle tap\\n\");\n",
        "ms_hard.bttns[2]=TRUE; TaskDerivedValsUpdate(owner,FALSE); TilGuiPollInput; WinFocus(peer); TilGuiPollInput;\n",
        "if (TilGuiIsMouseButtonDown(2) || !TilGuiIsMouseButtonReleased(2)) TilPanicZ(\"middle stuck on blur\\n\");\n",
        "WinFocus(owner); TilGuiPollInput; if (TilGuiIsMouseButtonDown(2) || TilGuiIsMouseButtonPressed(2) || TilGuiIsMouseButtonReleased(2)) TilPanicZ(\"middle hold resurrected on refocus\\n\");\n",
        "ms_hard.bttns[2]=FALSE; TaskDerivedValsUpdate(owner,FALSE); TilGuiPollInput; ms_hard.bttns[2]=TRUE; TaskDerivedValsUpdate(owner,FALSE); TilGuiPollInput;\n",
        "if (!TilGuiIsMouseButtonPressed(2)) TilPanicZ(\"fresh middle after refocus\\n\");\n",
        "WinFocus(peer); ms_hard.bttns[2]=FALSE; Sleep(100); ms_hard.bttns[2]=TRUE; Sleep(100); WinFocus(owner); TilGuiPollInput;\n",
        "if (TilGuiIsMouseButtonDown(2) || TilGuiIsMouseButtonPressed(2) || !TilGuiIsMouseButtonReleased(2)) TilPanicZ(\"background middle replayed between polls\\n\");\n",
        "TilGuiPollInput; if (TilGuiIsMouseButtonReleased(2)) TilPanicZ(\"background middle release persisted\\n\");\n",
        "ms_hard.bttns[2]=FALSE; TaskDerivedValsUpdate(owner,FALSE); TilGuiPollInput; ms_hard.bttns[2]=TRUE; TaskDerivedValsUpdate(owner,FALSE); TilGuiPollInput;\n",
        "WinFocus(peer); ms_hard.bttns[2]=FALSE; Sleep(100); WinFocus(owner); TilGuiPollInput; if (TilGuiIsMouseButtonDown(2) || !TilGuiIsMouseButtonReleased(2)) TilPanicZ(\"between-frame middle release lost\\n\");\n",
        "TilGuiCloseWindow; if (Fs->next_ctrl!=old_head || Fs->win_inhibit!=old_inhibit) TilPanicZ(\"middle sampler lifetime\\n\");\n",
        "ms_hard.bttns[2]=TRUE; TilGuiInitWindow(640,480,\"middle reopened\"); TilGuiPollInput;\n",
        "if (TilGuiIsMouseButtonDown(2) || TilGuiIsMouseButtonPressed(2) || TilGuiIsMouseButtonReleased(2)) TilPanicZ(\"middle reopen state\\n\");\n",
        "TilGuiCloseWindow; ms_hard.bttns[2]=old_middle; Kill(peer); TilRawWrite(\"GUI middle boundaries passed\\n\",29); }\nMiddleBoundaryChecks;\n"))
    run_guest(identity, format("gui_middle_boundaries_", bits), "GUI middle boundaries passed\n", "pass")
}

gui_checkers_checks := proc(identity: Str, bits: Str) {
    File.writefile("tmp/checkers_acceptance.til", checkers_acceptance_source(File.readfile("examples/checkers.til")))
    Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
        "-c", format(WORK, "/TILTEST.HC"), "tmp/checkers_acceptance.til").run_checked()
    // The shared fixture drives each platform's actual input path. Here the
    // callback-equivalent test hooks deliver TempleOS mouse state/messages.
    File.appendfile(format(WORK, "/TILTEST.HC"), format(
        "\nU0 gui_mouse_move(I32 x,I32 y) { MsSet(TilGuiViewX+x*TilGuiViewWidth/TilGuiWidth,TilGuiViewY+y*TilGuiViewHeight/TilGuiHeight); }\n",
        "U0 gui_mouse_button(I32 button,I32 action) { if (button!=0) TilPanicZ(\"checkers test button\\n\"); MsSet(ms.pos.x,ms.pos.y,0,action!=0,FALSE); if (action) Msg(MSG_MS_L_DOWN,ms.pos.x,ms.pos.y); else Msg(MSG_MS_L_UP,ms.pos.x,ms.pos.y); }\n",
        "Bool checkers_old_ac=AutoComplete(OFF); MsSet(0,0); TilMain; AutoComplete(checkers_old_ac);\n"))
    run_guest(identity, format("gui_checkers_", bits), "Checkers interaction passed\n", "pass")
    Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
        "-c", format(WORK, "/TILTEST.HC"), "test/gui_shapes.til").run_checked()
    File.appendfile(format(WORK, "/TILTEST.HC"),
        "\nBool shapes_old_ac=AutoComplete(OFF); MsSet(0,0); TilMain; AutoComplete(shapes_old_ac);\n")
    run_guest(identity, format("gui_shapes_", bits), "GUI shapes passed\n", "pass")
}

main := proc() {
    if mkdir_p(WORK) != 0 { panic("could not create ", WORK) }
    uid := captured(Cmd.new("id", "-u")).replace("\n", "")
    gid := captured(Cmd.new("id", "-g")).replace("\n", "")
    identity := format(uid, ":", gid)
    Cmd.new("docker", "build", "-f", "test/templeos.Dockerfile", "-t", IMAGE, "test").run_checked()
    container(identity, "curl", "--fail", "--location", "--connect-timeout", "30", "--max-time", "180", "--retry", "3",
        "-o", "TempleOS.ISO", ISO_URL).run_checked()
    digest := captured(container(identity, "sha256sum", "TempleOS.ISO"))
    if digest.starts_with(ISO_SHA).not() { panic("TempleOS ISO checksum mismatch: ", digest) }
    File.writefile(format(WORK, "/Once.HC"), File.readfile("test/templeos.HC"))
    File.writefile(format(WORK, "/Ext.HC"), File.readfile("src/holyc/ext.HC"))

    sources := array(Str, "examples/hello_script.til", "examples/fizzbuzz.til",
        "examples/templeos_calls.til", "examples/templeos_scalars.til",
        "test/script_raw_alloc.til", "test/script_dynamic_free.til",
        "test/script_str_runtime.til", "test/script_struct_runtime.til",
        "test/holyc_f64.til", "test/holyc_continue.til",
        "test/holyc_primitives.til", "test/holyc_float_primitives.til")
    goldens := array(Str, "", "test/fizzbuzz.expected", "", "",
        "test/script_raw_alloc.expected", "test/script_dynamic_free.expected",
        "test/script_str_runtime.expected", "test/script_struct_runtime.expected", "", "", "", "")
    for bits : Str in array(Str, "32", "64") {
        for i, source in sources {
            host := Cmd.new("timeout", "120", "bin/til", "interpret", format("--usize=", bits), source)
            mut expected := captured(host)
            if goldens[i].len() > 0 {
                golden := File.readfile(goldens[i])
                if expected != golden { panic(source, ": interpreter output differs from golden") }
                expected = golden.clone()
            }
            Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
                "-c", format(WORK, "/TILTEST.HC"), source).run_checked()
            File.appendfile(format(WORK, "/TILTEST.HC"), width_checks(bits))
            run_guest(identity, format("corpus_", i.to_str(), "_", bits), expected, "pass")
        }
        Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
            "-c", format(WORK, "/TILTEST.HC"), "test/holyc_terminal_model_support.til").run_checked()
        run_guest(identity, format("terminal_model_support_", bits), "Terminal model support passed\n", "pass")
        Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
            "-c", format(WORK, "/TILTEST.HC"), "test/globals_cli.til").run_checked()
        File.appendfile(format(WORK, "/TILTEST.HC"), "\nTilMain;\n")
        cli_globals := captured(Cmd.new("bin/til", "interpret", format("--usize=", bits), "test/globals_cli.til"))
        run_guest(identity, format("cli_globals_", bits), cli_globals, "pass")
        Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
            "-c", format(WORK, "/TILTEST.HC"), "examples/cli_typed.til").run_checked()
        File.appendfile(format(WORK, "/TILTEST.HC"),
            "\nTilStr guest_name; TilStrInitLit(&guest_name,\"TempleOS\",8); TilMain(&guest_name,42);\n")
        run_guest(identity, format("cli_typed_", bits), "TempleOS 42\n", "pass")
        cli_arguments := format("\nTilStrArray guest_args; TilStrArrayNew(&guest_args,2);\n",
            "TilStr guest_first,guest_second; TilStrInitLit(&guest_first,\"alpha\",5); TilStrInitLit(&guest_second,\"beta\",4);\n",
            "TilStrArraySet(&guest_args,0,&guest_first); TilStrArraySet(&guest_args,1,&guest_second);\n")
        Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
            "-c", format(WORK, "/TILTEST.HC"), "examples/cli_args.til").run_checked()
        File.appendfile(format(WORK, "/TILTEST.HC"), format(cli_arguments, "TilMain(&guest_args);\n"))
        run_guest(identity, format("cli_variadic_", bits), "alpha\nbeta\n", "pass")
        Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
            "-c", format(WORK, "/TILTEST.HC"), "test/main_return7.til").run_checked()
        File.appendfile(format(WORK, "/TILTEST.HC"), format(cli_arguments,
            "if (TilMain(&guest_args)!=7) TilPanicZ(\"CLI return value mismatch\\n\");\n"))
        run_guest(identity, format("cli_return_", bits), "args=2\n", "pass")
        Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
            "-c", format(WORK, "/TILTEST.HC"), "examples/gui_rectangle.til").run_checked()
        File.appendfile(format(WORK, "/TILTEST.HC"), "\nTilMain;\n")
        run_guest(identity, format("gui_rectangle_", bits), "GUI rectangle passed\n", "pass")
        Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
            "-c", format(WORK, "/TILTEST.HC"), "examples/gui_terminal_grid.til").run_checked()
        File.appendfile(format(WORK, "/TILTEST.HC"), "\nTilMain;\n")
        run_guest(identity, format("gui_terminal_grid_", bits), "GUI terminal grid passed\n", "pass")
        gui_scissor_checks(identity, bits)
        gui_keyboard_checks(identity, bits)
        gui_keyboard_focus_checks(identity, bits)
        gui_mouse_checks(identity, bits)
        gui_wheel_checks(identity, bits)
        gui_middle_checks(identity, bits)
        gui_checkers_checks(identity, bits)
        Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
            "-c", format(WORK, "/TILTEST.HC"), "test/script_str_runtime.til").run_checked()
        redsea_program := File.readfile(format(WORK, "/TILTEST.HC"))
        redsea_setup := format(
            "TilStr ext_path,ext_bytes; TilStrInitLit(&ext_path,\"Ext.HC\",6); TilFileRead(&ext_bytes,&ext_path);\n",
            "Fmt('C',TRUE,FALSE,FSt_REDSEA); Cd(\"C:/\"); DirMk(\"Home\"); Cd(\"C:/Home\");\n",
            "if (Fs->cur_dv->fs_type!=FSt_REDSEA) TilPanicZ(\"RedSea format failed\\n\");\n",
            "TilFileWrite(&ext_path,&ext_bytes); TilStrDelete(&ext_bytes,FALSE);\nTilMain;\n")
        File.writefile(format(WORK, "/TILTEST.HC"), redsea_program.replace("\nTilMain;\n", format("\n", redsea_setup)))
        run_guest(identity, format("redsea_filesystem_", bits), File.readfile("test/script_str_runtime.expected"), "pass")
        File.writefile(format(WORK, "/boundary.til"), "mode script\nprintln(\"boundary checks\")\n")
        Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
            "-c", format(WORK, "/TILTEST.HC"), format(WORK, "/boundary.til")).run_checked()
        File.appendfile(format(WORK, "/TILTEST.HC"), format(width_checks(bits), file_boundary_checks()))
        run_guest(identity, format("boundaries_", bits), "boundary checks\n", "pass")
        File.writefile(format(WORK, "/input.til"), format("mode script\nimport(\"std/sys\")\n",
            "mut line := Str.with_capacity(3)\nline.push_str(\"old\")\n",
            "if in_read_line(line).not() { panic(\"missing first line\") }\nprintln(line)\n",
            "if in_read_line(line).not() { panic(\"missing blank line\") }\n",
            "if line.len() == 0 { println(\"blank input\") }\n"))
        input_expected := captured(Cmd.new("sh", "-ec", format(
            "printf 'native line\\n\\n' | bin/til interpret --usize=", bits, " ", WORK, "/input.til")))
        if input_expected != "native line\nblank input\n" { panic("host line input mismatch") }
        Cmd.new("bin/til", "translate", "--target=templeos", format("--usize=", bits),
            "-c", format(WORK, "/TILTEST.HC"), format(WORK, "/input.til")).run_checked()
        run_guest(identity, format("line_input_", bits), input_expected, "pass",
            "after 2000\ntype_text {native line}\nafter 500\ntype_text {}\n")
        failure_case(identity, bits, "missing", "content := File.readfile(\"MISSING.HC\")\nprintln(content)\n",
            "cfile_open: could not open 'MISSING.HC'\n", "")
        failure_case(identity, bits, "parent_read", "content := File.readfile(\"CHILD/PARENT.HC\")\nprintln(content)\n",
            "cfile_open: could not open 'CHILD/PARENT.HC'\n",
            "DirMk(\"CHILD\"); TilStr parent_path,parent_content; TilStrInitLit(&parent_path,\"PARENT.HC\",9); TilStrInitLit(&parent_content,\"parent\",6); TilFileWrite(&parent_path,&parent_content);")
        failure_case(identity, bits, "alternate_read", "content := File.readfile(\"ALT.HC\")\nprintln(content)\n",
            "cfile_open: could not open 'ALT.HC'\n",
            "TilStr alt_path,alt_content; TilStrInitLit(&alt_path,\"ALT.HC.Z\",8); TilStrInitLit(&alt_content,\"raw\",3); TilFileWrite(&alt_path,&alt_content);")
        failure_case(identity, bits, "missing_parent", "File.writefile(\"BADDIR/NEW.HC\",\"bad\")\n",
            "File.writefile: could not write 'BADDIR/NEW.HC'\n", "")
        failure_case(identity, bits, "directory_write", "File.writefile(\"C:/Home\",\"bad\")\n",
            "File.writefile: could not write 'C:/Home'\n", "")
        failure_case(identity, bits, "invalid_name", "File.writefile(\"BAD?.HC\",\"bad\")\n",
            "File.writefile: could not write 'BAD?.HC'\n", "")
        failure_case(identity, bits, "capacity_overflow", "mut cap : USize = 0\ncap.dec()\ntext := Str.with_capacity(cap)\nprintln(text)\n",
            "Str.with_capacity: capacity overflow\n", "", false)
        failure_case(identity, bits, "missing_update", "file := File.update(\"MISSING.HC\")\nprintln(file.tell().to_str())\n",
            "cfile_open_update: could not open 'MISSING.HC'\n", "")
        failure_case(identity, bits, "bad_seek", "File.writefile(\"IO.HC\",\"io\")\nfile := File.new(\"IO.HC\",false)\nfile.seek(-1)\n",
            "cfile_seek: invalid position\n", "")
        failure_case(identity, bits, "write_offset_overflow", "File.writefile(\"IO.HC\",\"io\")\nfile := File.update(\"IO.HC\")\nfile.seek(9223372036854775807).write(\"X\")\n",
            "cfile_write_str: size overflow\n", "")
        failure_case(identity, bits, "missing_directory", "dir := Dir.open(\"MISSING\")\nprintln(dir.next())\n",
            "cdir_open: could not open 'MISSING'\n", "")
        failure_case(identity, bits, "remove_directory", "File.remove(\"C:/Home\")\n",
            "cfile_remove: cannot remove a directory\n", "")
        failure_case(identity, bits, "dyn_missing_method", format(
            "LookupTarget := struct { value := 1 namespace: read := func(self: LookupTarget) returns I64 { return self.value } }\n",
            "LookupGetter := func(LookupTarget) returns I64\n",
            "lookup := func(method: Str) returns LookupGetter { return dyn_fn(\"LookupTarget\", method) }\n",
            "mut method := \"absent\"\ncallback := lookup(method)\n",
            "println(callback(LookupTarget()).to_str())\n"),
            "dyn_fn: no method LookupTarget.absent\n", "", false)
        File.writefile(format(WORK, "/TILTEST.HC"), "This_Is_Not_A_TempleOS_Symbol;\n")
        run_guest(identity, format("compiler_error_", bits), "", "error")
    }
    File.writefile(format(WORK, "/TILTEST.HC"), "while (TRUE) {}\n")
    run_guest(identity, "timeout", "", "timeout")
    println("TempleOS guest corpus passed")
}
