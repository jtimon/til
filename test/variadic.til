mode test

// variadic args
variadic_sum := func(nums: ..I64) returns I64 {
    mut total := 0
    for n : I64 in nums {
        total = total.add(n)
    }
    return total
}

test_variadic := test() {
    assert_eq(I64, variadic_sum(1, 2, 3), 6)
    assert_eq(I64, variadic_sum(10), 10)
    assert_eq(I64, variadic_sum(), 0)
}

// proc-based variadic test (not constant-foldable)
variadic_print := proc(nums: ..I64) {
    for i in 0..nums.len() {
        ref n: I64 = nums.get(i)!
        print(n.to_str())
        if i.lt(nums.len().sub(1)) { print(",") }
    }
    println("")
}

test_variadic_proc := test() {
    variadic_print(10, 20, 30)
}

// Variadic Str
variadic_concat := func(parts: ..Str) returns Str {
    mut result := ""
    for p : Str in parts {
        result = format(result, p)
    }
    return result
}

test_variadic_str := test() {
    assert_eq(Str, variadic_concat("a", "b", "c"), "abc")
    assert_eq(Str, variadic_concat("hi"), "hi")
    assert_eq(Str, variadic_concat(), "")
}

// #157: ..Str varargs auto-wrap non-Str args via T.to_str(). Allows
// `print(1+1)` etc. to work like Python while keeping types honest --
// types without a to_str method still error at the typer.
test_variadic_str_auto_to_str := test() {
    assert_eq(Str, variadic_concat("x=", 42), "x=42")
    assert_eq(Str, variadic_concat(1, "+", 2, "=", 3), "1+2=3")
    assert_eq(Str, variadic_concat(true, " ", false), "true false")
    assert_eq(Str, variadic_concat("ok=", true), "ok=true")
}

// Variadic Bool
variadic_all := func(flags: ..Bool) returns Bool {
    for f : Bool in flags {
        if f.not() { return false }
    }
    return true
}

test_variadic_bool := test() {
    assert(variadic_all(true, true, true))
    assert(variadic_all(true, false, true).not())
    // Empty variadic: vacuously true
    assert(variadic_all())
}

// Positional param + variadic tail
prefix_sum := func(prefix: I64, nums: ..I64) returns I64 {
    mut total := prefix
    for n : I64 in nums {
        total = total.add(n)
    }
    return total
}

test_variadic_with_positional := test() {
    assert_eq(I64, prefix_sum(100, 1, 2, 3), 106)
    assert_eq(I64, prefix_sum(100), 100)
    assert_eq(I64, prefix_sum(0, 5), 5)
}

// Issue #186: a user-defined variadic call nested inside another
// variadic call (println). Before the fix the outer desugar wrapped
// only println's args into an Array, leaving the inner say(...) with
// raw args -- gcc rejected the call as "too many arguments".
say_flags := func(bools: ..Bool) returns Str {
    mut out := ""
    for b : Bool in bools { if b { out = format(out, "T") } else { out = format(out, "F") } }
    return out
}

bug186_variadic_nested_in_variadic := test() {
    assert_eq(Str, say_flags(true, false, true), "TFT")
    // Nested user-defined variadic inside a variadic format-style
    // call: pass the result of one variadic into another variadic.
    assert_eq(Str, variadic_concat(say_flags(true, false), say_flags(true)), "TFT")
}

// Sibling-position variant of #186 / #188: when a stmt contains
// multiple SIBLING variadic fcalls (i.e. peers in the same arg list,
// not nested inside one another), find_variadic_fcall returned only
// the first one in DFS order. The first got desugared into _va_Array_0
// + Array.set..., the rest stayed raw and gcc rejected them. The
// containing call doesn't have to be variadic itself for this to bite.
// Fix: after rewriting a variadic fcall, recurse process_call_desugars
// on stmt to catch any remaining sibling variadic fcalls.
add2_i64 := func(a: I64, b: I64) returns I64 { return a.add(b) }

bug189_sibling_variadic := test() {
    // add2_i64 is regular but takes two variadic-call results -- two
    // SIBLINGS in the same arg list.
    assert_eq(I64, add2_i64(variadic_sum(1, 2), variadic_sum(3, 4)), 10)
    // Mixed: a sibling variadic alongside a raw arg.
    assert_eq(I64, add2_i64(variadic_sum(1, 2, 3), 100), 106)
}

// --- merged from test/splat.til ---

sum := func(nums: ..I64) returns I64 {
    mut total := 0
    for n : I64 in nums {
        total = total.add(n)
    }
    return total
}

// Forward variadic to another variadic function
double_sum := func(nums: ..I64) returns I64 {
    return sum(..nums)
}

test_splat_forward := test() {
    assert_eq(I64, double_sum(1, 2, 3), 6)
    assert_eq(I64, double_sum(10), 10)
    assert_eq(I64, double_sum(), 0)
}

// Splat an array into a variadic call
test_splat_array := test() {
    a := array(I64, 1, 2, 3)
    assert_eq(I64, sum(..a), 6)
}

// Forward Str variadic to format
my_format := func(parts: ..Str) returns Str {
    return format(..parts)
}

test_splat_format := test() {
    assert_eq(Str, my_format("hello", " ", "world"), "hello world")
}

test_splat_empty := test() {
    assert_eq(I64, sum(), 0)
    assert_eq(I64, double_sum(), 0)
    assert_eq(Str, my_format(), "")
}

// #342: a `..` splat may share the variadic block with other arguments. The
// splatted array's elements expand in place among them, in source order --
// the parser records WHICH argument carried the `..` (FCallData.splat_args)
// and the desugar folds the block into one Array with Array.concat, handing
// the call the pure-splat form. Before this, the splatted Array was wrapped
// as a single element and the callee read its header bytes as the element
// type (garbage output), and latterly the whole shape was a type error.
test_mixed_splat := test() {
    arr := array(Str, "a", "b")
    assert_eq(Str, format("<", ..arr), "<ab")
    assert_eq(Str, format(..arr, ">"), "ab>")
    assert_eq(Str, format("[", ..arr, "]"), "[ab]")
}

test_mixed_splat_multiple := test() {
    a := array(Str, "a", "b")
    b := array(Str, "y", "z")
    assert_eq(Str, format(..a, "-", ..b), "ab-yz")
    assert_eq(Str, format(..a, ..b), "abyz")
}

// concat clones, so a splatted array is not moved out of the caller and can
// be splatted again.
test_mixed_splat_source_intact := test() {
    a := array(Str, "a", "b")
    assert_eq(Str, format("<", ..a), "<ab")
    assert_eq(Str, format("<", ..a), "<ab")
    ref a0 : Str = a[0]
    assert_eq(Str, a0, "a")
    assert_eq(USize, a.len(), 2)
}

// #342: splat_args is indexed by child position, so every pass that inserts,
// drops or reorders call children has to renumber it exactly as it renumbers
// own_args. Two did not, and both lost the splat silently -- the bit named the
// argument beside it, so the splatted Array was wrapped as one element again.

// UFCS inserts the receiver at position 1.
SplatHolder := struct {
    tag := ""
namespace:
    join := func(self: SplatHolder, parts: ..Str) returns Str {
        return format(self.tag, format(..parts))
    }
}

test_mixed_splat_ufcs := test() {
    h := SplatHolder(tag = "T:")
    a := array(Str, "a", "b")
    assert_eq(Str, h.join("x", ..a), "T:xab")
    assert_eq(Str, h.join(..a, "x"), "T:abx")
    // the receiver written out, which never went through the shift
    assert_eq(Str, SplatHolder.join(h, "x", ..a), "T:xab")
    // and the pure-splat form, which derives the presence from the same bitmap
    assert_eq(Str, h.join(..a), "T:ab")
}

// Monomorphizing drops the `Type` argument, closing the gap it held.
priv splat_generic_count := func(T: Type, parts: ..T) returns USize {
    return parts.len()
}

test_mixed_splat_generic := test() {
    a := array(Str, "a", "b")
    assert_eq(USize, splat_generic_count(Str, "x", ..a), 3)
    assert_eq(USize, splat_generic_count(Str, ..a, "x", "y"), 4)
    assert_eq(USize, splat_generic_count(Str, ..a), 2)
}

// #342: with the type argument OMITTED, a splat says the same thing about `..T`
// that a plain element does -- it stands for the array's ELEMENTS. Reading the
// Array itself made the pure form deduce T = Array__Str and then demand an
// Array__Array__Str instance ("pass it explicitly"), and the mixed form called
// Str and Array__Str conflicting evidence.
//
priv splat_deduced_prefix := func(T: Type, sep: Str, parts: ..T) returns USize {
    return parts.len().add(sep.len())
}

test_splat_deduced_type_arg := test() {
    a := array(Str, "a", "b")
    // #359: this same private generic is also applied explicitly above;
    // deduction must reuse that concrete declaration.
    assert_eq(USize, splat_generic_count(..a), 2)
    assert_eq(USize, splat_generic_count("x", ..a), 3)
    assert_eq(USize, splat_generic_count(..a, "x", "y"), 4)
    // deduction still lines up when a fixed parameter precedes the run
    assert_eq(USize, splat_deduced_prefix("-", "x", ..a), 4)
    // and the element type is what is deduced, not merely Str-shaped
    n := array(I64, 7, 8, 9)
    assert_eq(USize, splat_generic_count(1, ..n), 4)
    assert_eq(USize, splat_generic_count(..n), 3)
}

// #342: the element-type check that the mismatched splats in
// test/typer_errors.til exercise has to let a MATCHING one through, in every
// position, and an Array built any way round is a valid source.
priv splat_sum := func(nums: ..I64) returns I64 {
    mut total := 0
    for n : I64 in nums { total = total.add(n) }
    return total
}

test_splat_elem_type_accepted := test() {
    a := array(I64, 1, 2)
    mut b := Array(I64).new(2)
    b[0] = 10
    b[1] = 20
    assert_eq(I64, splat_sum(..a), 3)
    assert_eq(I64, splat_sum(100, ..a), 103)
    assert_eq(I64, splat_sum(..a, 100), 103)
    assert_eq(I64, splat_sum(..a, ..b), 33)
    assert_eq(I64, splat_sum(..a, 100, ..b), 133)
}

// #342: splatting a CALL RESULT. The array literal inside the callee is what
// matters here: desugar_array_vec_fcall briefly consumed the instance name
// from two branches, so the garbager freed it on the branch that also handed
// it to Type.Struct and an ordinary literal double-freed. It crashed in the
// compiler, not the program, and only once the freed name was reused -- which
// is why the corpus stayed green while `..mk()` segfaulted. Under ASAN the
// shape is checked every run.
// #363: private type mangling must use the same spelling for the variadic
// parameter's element type and its synthesized Array instance.
priv SplatPoint := struct { n := 0 }

priv splat_point_sum := func(ps: ..SplatPoint) returns I64 {
    mut total := 0
    for p : SplatPoint in ps { total = total.add(p.n) }
    return total
}

priv splat_make_points := func() returns Array(SplatPoint) {
    return array(SplatPoint, SplatPoint(n = 2), SplatPoint(n = 3))
}

priv splat_make_ints := func() returns Array(I64) {
    return array(I64, 3, 4)
}

test_splat_call_result := test() {
    assert_eq(I64, splat_point_sum(SplatPoint(n = 1), SplatPoint(n = 2)), 3)
    assert_eq(I64, splat_point_sum(..splat_make_points()), 5)
    assert_eq(I64, splat_point_sum(SplatPoint(n = 10), ..splat_make_points()), 15)
    assert_eq(I64, splat_sum(..splat_make_ints()), 7)
    assert_eq(I64, splat_sum(1, ..splat_make_ints()), 8)
}

// #342: a ..Dynamic variadic exempts every ELEMENT from the type check, but
// not a splat: a plain argument converts to Dynamic one value at a time, while
// a splatted array would need each of its elements converted over a runtime
// length. An Array(Dynamic) is the one that matches, and it must still pass.
priv splat_dyn_count := func(xs: ..Dynamic) returns USize { return xs.len() }

test_splat_dynamic_variadic := test() {
    d := array(Dynamic, 1, 2)
    assert_eq(USize, splat_dyn_count(..d), 2)
    assert_eq(USize, splat_dyn_count(9, ..d), 3)
    assert_eq(USize, splat_dyn_count(..d, 9), 3)
    assert_eq(USize, splat_dyn_count(9, ..d, 9), 4)
    // Plain arguments cover both a Bool narrower than a word (#361) and a Str
    // whose typed clone must remain owned while the fold erases it to Dynamic
    // (#362).
    assert_eq(USize, splat_dyn_count(true, ..d), 3)
    assert_eq(USize, splat_dyn_count(1, "a"), 2)
    assert_eq(USize, splat_dyn_count("a", ..d), 3)
}

// #392 stage A: a ..Dynamic variadic block lowers through Tuple, so each
// element carries its TYPE beside its bytes. Before this the collector was an
// Array(Dynamic) of untyped words: a Str element was truncated to its first 8
// bytes (compiled leaked its storage, #362 could only fix the interpreter),
// and a callee had no way to ask what an element was. type_at is the runtime
// introspection, get(i) points at the element's full stored bytes, and a raw
// Dynamic element (or a splat of an Array(Dynamic)) rides along as a word
// tagged "Dynamic" with today's raw semantics.
priv dyn_type_list := func(xs: ..Dynamic) returns Str {
    mut out := ""
    for i in 0..xs.len() {
        out = format(out, xs.type_at(i), ",")
    }
    return out
}

priv dyn_first_str := func(xs: ..Dynamic) returns Str {
    ref s : Str = xs.get(0)
    return s.clone()
}

// #392 stage B: reading an element at a TYPED binding is checked against the
// type the element carries -- `ref s : Str = xs.get(i)` lowers to
// `xs.get_checked(i, "Str")` and panics when element i is not a Str (the
// lying read is test/tuple_typed_read_error.til; it aborts, so it cannot run
// here). These read CORRECTLY, at several types and at an index that is not a
// literal, and must be untouched by the check.
priv dyn_read_each := func(xs: ..Dynamic) returns Str {
    mut out := ""
    for i in 0..xs.len() {
        if xs.type_at(i) == "I64" {
            ref n : I64 = xs.get(i)
            out = format(out, n.to_str(), " ")
        } else if xs.type_at(i) == "Bool" {
            ref b : Bool = xs.get(i)
            out = format(out, b.to_str(), " ")
        } else {
            ref s : Str = xs.get(i)
            out = format(out, s, " ")
        }
    }
    return out
}

// #394: what a splatted Array(Dynamic) element is WORTH, not just what it is
// tagged. The type names below were right on both backends while the values
// were garbage compiled: Tuple sizes each element through a runtime
// dyn_size_of(<tag>), and "Dynamic" answered 1 there, so the word was stored
// in one byte and everything after it sat seven bytes early. Sizes are
// asserted beside the values because the size IS the defect; the values are
// how it surfaced.
priv dyn_word_list := func(xs: ..Dynamic) returns Str {
    mut out := ""
    for i in 0..xs.len() {
        ref n : I64 = xs.get(i)
        out = format(out, n.to_str(), "/", xs.size_at(i).to_str(), ",")
    }
    return out
}

// #392 follow-up: `xs[i]` inside a ..Dynamic callee. Two things had to be
// true for this to work, and neither was. The parser writes `x[i]` as
// `x.get(i)!` before anything knows whether the resolved get throws, and
// Tuple's does not. And the throws walk seeded this parameter's receiver type
// with the ARRAY instance rather than stage A's carrier, so `xs.get(i)`
// resolved against Array__Dynamic -- whose get DOES throw -- and took err
// out-args that Tuple.get has no parameters for. The call then failed arity
// ("too many arguments: expected 1, got 2"), which named nothing a reader
// could act on. Reads at index 0 and at a loop index, so the seeding is
// exercised by more than a literal.
priv dyn_sub_read := func(xs: ..Dynamic) returns Str {
    ref first : I64 = xs[0]
    mut out := first.to_str()
    for i in 1..xs.len() {
        ref s : Str = xs[i]
        out = format(out, "|", s)
    }
    return out
}

test_dynamic_variadic_tuple := test() {
    v := format("run", "time")
    assert_eq(Str, dyn_sub_read(7, v, "tail"), "7|runtime|tail")
    assert_eq(Str, dyn_type_list(1, v, true), "I64,Str,Bool,")
    // the value survives the crossing, and the source outlives the call
    assert_eq(Str, dyn_first_str(v), "runtime")
    assert_eq(Str, v, "runtime")
    d := array(Dynamic, 1, 2)
    assert_eq(Str, dyn_type_list(9, ..d), "I64,Dynamic,Dynamic,")
    assert_eq(Str, dyn_word_list(9, ..d), "9/8,1/8,2/8,")
    assert_eq(Str, dyn_type_list(), "")
    // asking type_at first, then reading at that type, is the pattern the
    // check exists to reward -- every branch below reads what is there
    assert_eq(Str, dyn_read_each(1, v, true), "1 runtime true ")
}
