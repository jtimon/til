U0 TilFunction_default_delete(U8 *env, U8 *arg0, Bool arg1)
{
  default_delete(arg0, arg1);
}
TilClosure TilValue_default_delete;
U0 TilTypeToStr(TilStr *out, Type *type)
{
  switch (type->tag) {
    case 0: TilStrInitLit(out,"",0); return;
    case 1: TilStrInitLit(out,"",0); return;
    case 2: TilStrClone(out,&type->payload_Struct); return;
    case 3: TilStrInitLit(out,"StructDef",9); return;
    case 4: TilStrClone(out,&type->payload_Enum); return;
    case 5: TilStrInitLit(out,"EnumDef",7); return;
    case 6: TilStrInitLit(out,"FunctionDef",11); return;
    case 7: TilStrInitLit(out,"Fn",2); return;
    case 8: TilStrInitLit(out,"Dynamic",7); return;
    case 9: TilStrClone(out,&type->payload_Custom); return;
    case 10: switch (type->payload_Primitive) {
      case 0: TilStrInitLit(out,"I16",3); return;
      case 1: TilStrInitLit(out,"U16",3); return;
      case 2: TilStrInitLit(out,"I8",2); return;
      case 3: TilStrInitLit(out,"U8",2); return;
      case 4: TilStrInitLit(out,"U32",3); return;
      case 5: TilStrInitLit(out,"I32",3); return;
      case 6: TilStrInitLit(out,"U64",3); return;
      case 7: TilStrInitLit(out,"I64",3); return;
      case 8: TilStrInitLit(out,"F32",3); return;
      case 9: TilStrInitLit(out,"Bool",4); return;
      case 10: TilStrInitLit(out,"F64",3); return;
    } break;
    case 11: TilStrClone(out,&type->payload_FuncPtrSig); return;
    case 12: TilStrInitLit(out,"Body",4); return;
    case 13: TilStrInitLit(out,"StructSym",9); return;
    case 14: TilStrInitLit(out,"EnumSym",7); return;
    case 15: TilStrInitLit(out,"CustomSym",9); return;
    case 16: TilStrInitLit(out,"FuncPtrSigSym",13); return;
  }
  TilStrInitLit(out,"?",1);
}

U64 TilNameStorageKind(TilStr *name)
{
  if (TilStrNameEq(name,"I8")) return 0;
  if (TilStrNameEq(name,"U8")) return 0;
  if (TilStrNameEq(name,"I16")) return 0;
  if (TilStrNameEq(name,"U16")) return 0;
  if (TilStrNameEq(name,"I32")) return 0;
  if (TilStrNameEq(name,"U32")) return 0;
  if (TilStrNameEq(name,"I64")) return 0;
  if (TilStrNameEq(name,"U64")) return 0;
  if (TilStrNameEq(name,"F32")) return 0;
  if (TilStrNameEq(name,"F64")) return 0;
  if (TilStrNameEq(name,"Bool")) return 0;
  if (TilStrNameEq(name,"USize")) return 0;
  if (TilStrNameEq(name,"UPtr")) return 0;
  if (TilStrNameEq(name,"Dynamic")) return 0;
  if (TilStrNameEq(name,"Fn") || TilStrNameEq(name,"Body")) return 2;
  return 1;
}

U64 TilTypeStorageKind(Type *type)
{
  switch (type->tag) {
    case 7: return 2;
    case 8: return 0;
    case 10: return 0;
    case 11: return 2;
    case 12: return 2;
    case 16: return 2;
  }
  TilStr name;
  TilTypeToStr(&name,type);
  U64 result=TilNameStorageKind(&name);
  TilStrDelete(&name,FALSE);
  return result;
}

