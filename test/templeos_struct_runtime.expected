class StructNullable {
  I64 value;
  StructNullable * next;
};

U0 StructNullable_Clone(StructNullable *out, StructNullable *src)
{
  out->value = src->value;
  out->next = src->next;
}

U0 StructNullable_Delete(StructNullable *self, Bool call_free)
{
  if (call_free) TilFree(self);
}

Bool StructNullable_Eq(StructNullable *a, StructNullable *b)
{
  if (!(a->value == b->value)) return FALSE;
  if ((a->next == NULL) != (b->next == NULL)) return FALSE;
  if (a->next != NULL && !StructNullable_Eq(a->next, b->next)) return FALSE;
  return TRUE;
}

class StructBorrowTag {
  U8 tag;
  union {
    StructPoint * payload_Borrowed;
    I64 payload_Number;
  };
};

StructBorrowTag StructBorrowTag_Literal_Empty;
StructBorrowTag_Literal_Empty.tag = 0;

U0 StructBorrowTag_CopyValue(StructBorrowTag *out, StructBorrowTag *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    return;
  }
  if (src->tag == 1) {
    out->payload_Borrowed = src->payload_Borrowed;
    return;
  }
  if (src->tag == 2) {
    out->payload_Number = src->payload_Number;
    return;
  }
  TilPanicZ("invalid StructBorrowTag tag");
}

U0 StructBorrowTag_Clone(StructBorrowTag *out, StructBorrowTag *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    return;
  }
  if (src->tag == 1) {
    out->payload_Borrowed = src->payload_Borrowed;
    return;
  }
  if (src->tag == 2) {
    out->payload_Number = src->payload_Number;
    return;
  }
  TilPanicZ("invalid StructBorrowTag tag");
}

U0 StructBorrowTag_Delete(StructBorrowTag *src, Bool call_free)
{
  if (src->tag == 0) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 1) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 2) {
    if (call_free) TilFree(src);
    return;
  }
  TilPanicZ("invalid StructBorrowTag tag");
}

Bool StructBorrowTag_Eq(StructBorrowTag *a, StructBorrowTag *b)
{
  if (a->tag != b->tag) return FALSE;
  if (a->tag == 0) {
    return TRUE;
  }
  if (a->tag == 1) {
    return StructPoint_Eq(a->payload_Borrowed, b->payload_Borrowed);
  }
  if (a->tag == 2) {
    return a->payload_Number == b->payload_Number;
  }
  TilPanicZ("invalid StructBorrowTag tag");
  return FALSE;
}

class Vec__StructNamedPoint {
  StructNamedPoint *data;
  U64 count;
  U64 cap;
};

U0 Vec__StructNamedPoint_CopyValue(Vec__StructNamedPoint *out, Vec__StructNamedPoint *src)
{
  out->data = src->data;
  out->count = src->count;
  out->cap = src->cap;
}

U0 Vec__StructNamedPoint_New(Vec__StructNamedPoint *out)
{
  out->data = NULL;
  out->count = 0;
  out->cap = 0;
}

U0 Vec__StructNamedPoint_WithCapacity(Vec__StructNamedPoint *out, U64 cap)
{
  out->data = NULL;
  if (cap && cap > I64_MAX / sizeof(StructNamedPoint)) TilPanicZ("til: allocation size overflow
");
  if (cap) out->data = (TilMAlloc(cap * sizeof(StructNamedPoint)))(StructNamedPoint *);
  out->count = 0;
  out->cap = cap;
}

U0 Vec__StructNamedPoint_Clone(Vec__StructNamedPoint *out, Vec__StructNamedPoint *src)
{
  out->data = (TilCAlloc(src->cap, sizeof(StructNamedPoint)))(StructNamedPoint *);
  out->count = src->count;
  out->cap = src->cap;
  U64 i = 0;
  while (i < src->count) {
    StructNamedPoint_Clone(&out->data[i], &src->data[i]);
    i++;
  }
}

StructNamedPoint *Vec__StructNamedPoint_UnsafeGet(Vec__StructNamedPoint *self, U64 i)
{
  return &self->data[i];
}

U0 Vec__StructNamedPoint_UnsafeSet(Vec__StructNamedPoint *self, U64 i, StructNamedPoint *value)
{
  StructNamedPoint_Delete(&self->data[i], FALSE);
  TilMemCpy(&self->data[i], value, sizeof(StructNamedPoint));
  TilMemSet(value, 0, sizeof(StructNamedPoint));
}

StructNamedPoint *Vec__StructNamedPoint_Get(Vec__StructNamedPoint *self, U64 i, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->count) {
    *err_kind = 1;
    return NULL;
  }
  return Vec__StructNamedPoint_UnsafeGet(self, i);
}

U0 Vec__StructNamedPoint_Set(Vec__StructNamedPoint *self, U64 i, StructNamedPoint *value, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->count) {
    *err_kind = 1;
    return;
  }
  Vec__StructNamedPoint_UnsafeSet(self, i, value);
}

U0 Vec__StructNamedPoint_Push(Vec__StructNamedPoint *self, StructNamedPoint *value)
{
  if (self->count == self->cap) {
    if (self->cap > I64_MAX/2) TilPanicZ("Vec.push: capacity overflow
");
    U64 new_cap = self->cap * 2;
    if (!new_cap) new_cap = 1;
    if (new_cap > I64_MAX / sizeof(StructNamedPoint)) TilPanicZ("til: allocation size overflow
");
    self->data = (TilReAlloc(self->data, new_cap * sizeof(StructNamedPoint)))(StructNamedPoint *);
    self->cap = new_cap;
  }
  TilMemCpy(&self->data[self->count], value, sizeof(StructNamedPoint));
  TilMemSet(value, 0, sizeof(StructNamedPoint));
  self->count++;
}

U0 Vec__StructNamedPoint_Pop(StructNamedPoint *out, Vec__StructNamedPoint *self)
{
  if (!self->count) TilPanicZ("Vec.pop: empty vec
");
  self->count--;
  TilMemCpy(out, &self->data[self->count], sizeof(StructNamedPoint));
  TilMemSet(&self->data[self->count], 0, sizeof(StructNamedPoint));
}

U0 Vec__StructNamedPoint_Clear(Vec__StructNamedPoint *self)
{
  U64 i = 0;
  while (i < self->count) {
    StructNamedPoint_Delete(&self->data[i], FALSE);
    i++;
  }
  self->count = 0;
}

U0 Vec__StructNamedPoint_Delete(Vec__StructNamedPoint *self, Bool call_free)
{
  Vec__StructNamedPoint_Clear(self);
  TilFree(self->data);
  self->data = NULL;
  self->cap = 0;
  self->count = 0;
  if (call_free) TilFree(self);
}

U0 Vec__StructNamedPoint_Take(Vec__StructNamedPoint *out, Vec__StructNamedPoint *self)
{
  Vec__StructNamedPoint_CopyValue(out, self);
  self->data = NULL;
  self->count = 0;
  self->cap = 0;
}

U0 Vec__StructNamedPoint_Append(Vec__StructNamedPoint *self, Vec__StructNamedPoint *other)
{
  if (!other->count) {
    Vec__StructNamedPoint_Delete(other, FALSE);
    return;
  }
  if (other->count > I64_MAX - self->count) TilPanicZ("Vec.append: size overflow
");
  U64 needed = self->count + other->count;
  if (needed > self->cap) {
    U64 next_cap = self->cap;
    if (!next_cap) next_cap = 1;
    while (next_cap < needed) {
      if (next_cap > I64_MAX / 2) TilPanicZ("Vec.append: capacity overflow
");
      next_cap = next_cap * 2;
    }
    if (next_cap > I64_MAX / sizeof(StructNamedPoint)) TilPanicZ("Vec.append: allocation overflow
");
    self->data = (TilReAlloc(self->data, next_cap * sizeof(StructNamedPoint)))(StructNamedPoint *);
    self->cap = next_cap;
  }
  TilMemCpy(&self->data[self->count], other->data, other->count * sizeof(StructNamedPoint));
  self->count = needed;
  other->count = 0;
  Vec__StructNamedPoint_Delete(other, FALSE);
}

U0 Vec__StructNamedPoint_MoveTo(Vec__StructNamedPoint *src, Vec__StructNamedPoint *dest)
{
  Vec__StructNamedPoint_Delete(dest, FALSE);
  Vec__StructNamedPoint_Take(dest, src);
}

U0 Vec__StructNamedPoint_Truncate(Vec__StructNamedPoint *self, U64 n)
{
  if (n > self->count) TilPanicZ("Vec.truncate: out of bounds
");
  U64 i = n;
  while (i < self->count) {
    StructNamedPoint_Delete(&self->data[i], FALSE);
    i++;
  }
  self->count = n;
}

U0 Vec__StructNamedPoint_RemoveAt(Vec__StructNamedPoint *self, U64 i, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->count) { *err_kind = 1; return; }
  StructNamedPoint_Delete(&self->data[i], FALSE);
  U64 last = self->count - 1;
  if (i < last) TilMemMove(&self->data[i], &self->data[i+1], (last-i)*sizeof(StructNamedPoint));
  self->count = last;
  TilMemSet(&self->data[last], 0, sizeof(StructNamedPoint));
}

U0 Vec__StructNamedPoint_PushTake(Vec__StructNamedPoint *self, Vec__StructNamedPoint *src, U64 i)
{
  if (i >= src->count) TilPanicZ("Vec.push_take: out of bounds
");
  if (self->count == self->cap) {
    if (self->cap > I64_MAX/2) TilPanicZ("Vec.push_take: capacity overflow
");
    U64 next_cap = self->cap * 2;
    if (!next_cap) next_cap = 1;
    if (next_cap > I64_MAX/sizeof(StructNamedPoint)) TilPanicZ("Vec.push_take: allocation overflow
");
    self->data = (TilReAlloc(self->data, next_cap*sizeof(StructNamedPoint)))(StructNamedPoint *);
    self->cap = next_cap;
  }
  TilMemCpy(&self->data[self->count], &src->data[i], sizeof(StructNamedPoint));
  TilMemSet(&src->data[i], 0, sizeof(StructNamedPoint));
  self->count++;
}

U0 Vec__StructNamedPoint_TakePrefix(Vec__StructNamedPoint *out, Vec__StructNamedPoint *self, U64 n)
{
  if (n > self->count) TilPanicZ("Vec.take_prefix: out of bounds
");
  U64 cap = n;
  if (!cap) cap = 1;
  if (cap > I64_MAX/sizeof(StructNamedPoint)) TilPanicZ("Vec.take_prefix: allocation overflow
");
  out->data = (TilMAlloc(cap*sizeof(StructNamedPoint)))(StructNamedPoint *);
  out->count = n;
  out->cap = cap;
  if (n) TilMemCpy(out->data, self->data, n*sizeof(StructNamedPoint));
  U64 tail = self->count - n;
  if (tail) TilMemMove(self->data, &self->data[n], tail*sizeof(StructNamedPoint));
  if (n) TilMemSet(&self->data[tail], 0, n*sizeof(StructNamedPoint));
  self->count = tail;
}

U0 Vec__StructNamedPoint_DeleteMarked(Vec__StructNamedPoint *self, U8 *marks)
{
  U64 i = 0;
  while (i < self->count) {
    if (marks[i]) {
      StructNamedPoint_Delete(&self->data[i], FALSE);
      TilMemSet(&self->data[i], 0, sizeof(StructNamedPoint));
    }
    i++;
  }
  U64 w = 0;
  U64 r = 0;
  while (r < self->count) {
    if (!marks[r]) {
      if (w != r) TilMemCpy(&self->data[w], &self->data[r], sizeof(StructNamedPoint));
      w++;
    }
    r++;
  }
  self->count = w;
}

class Array__StructNamedPoint {
  StructNamedPoint *data;
