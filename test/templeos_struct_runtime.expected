{
  out->value = src->value;
}

U0 StructForwardPoint_Delete(StructForwardPoint *self, Bool call_free)
{
  if (call_free) TilFree(self);
}

U0 StructSelfRef_Clone(StructSelfRef *out, StructSelfRef *src)
{
  out->value = src->value;
  out->next = src->next;
}

U0 StructSelfRef_Delete(StructSelfRef *self, Bool call_free)
{
  if (call_free) TilFree(self);
}

U0 StructNullable_Clone(StructNullable *out, StructNullable *src)
{
  out->value = src->value;
  out->next = src->next;
}

U0 StructNullable_Delete(StructNullable *self, Bool call_free)
{
  if (call_free) TilFree(self);
}

Bool StructNullable_Eq(StructNullable *a, StructNullable *b)
{
  if (!(a->value == b->value)) return FALSE;
  if ((a->next == NULL) != (b->next == NULL)) return FALSE;
  if (a->next != NULL && !StructNullable_Eq(a->next, b->next)) return FALSE;
  return TRUE;
}

StructBorrowTag StructBorrowTag_Literal_Empty;
StructBorrowTag_Literal_Empty.tag = 0;

U0 StructBorrowTag_CopyValue(StructBorrowTag *out, StructBorrowTag *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    return;
  }
  if (src->tag == 1) {
    out->payload_Borrowed = src->payload_Borrowed;
    return;
  }
  if (src->tag == 2) {
    out->payload_Number = src->payload_Number;
    return;
  }
  TilPanicZ("invalid StructBorrowTag tag");
}

U0 StructBorrowTag_Clone(StructBorrowTag *out, StructBorrowTag *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    return;
  }
  if (src->tag == 1) {
    out->payload_Borrowed = src->payload_Borrowed;
    return;
  }
  if (src->tag == 2) {
    out->payload_Number = src->payload_Number;
    return;
  }
  TilPanicZ("invalid StructBorrowTag tag");
}

U0 StructBorrowTag_Delete(StructBorrowTag *src, Bool call_free)
{
  if (src->tag == 0) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 1) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 2) {
    if (call_free) TilFree(src);
    return;
  }
  TilPanicZ("invalid StructBorrowTag tag");
}

Bool StructBorrowTag_Eq(StructBorrowTag *a, StructBorrowTag *b)
{
  if (a->tag != b->tag) return FALSE;
  if (a->tag == 0) {
    return TRUE;
  }
  if (a->tag == 1) {
    return StructPoint_Eq(a->payload_Borrowed, b->payload_Borrowed);
  }
  if (a->tag == 2) {
    return a->payload_Number == b->payload_Number;
  }
  TilPanicZ("invalid StructBorrowTag tag");
  return FALSE;
}

