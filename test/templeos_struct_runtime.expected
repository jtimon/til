U0 Vec__StructNamedPoint_DeleteMarked(Vec__StructNamedPoint *self, U8 *marks)
{
  U64 i = 0;
  while (i < self->count) {
    if (marks[i]) {
      StructNamedPoint_Delete(&self->data[i], FALSE);
      TilMemSet(&self->data[i], 0, sizeof(StructNamedPoint));
