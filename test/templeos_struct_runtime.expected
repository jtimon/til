  if (TilStrNameEq(name,"Vec__call_Vec_I64")) return sizeof(Vec__call_Vec_I64);
  if (TilStrNameEq(name,"WideSignal")) return sizeof(U64);
  TilReflectMissing("dyn_size_of",name);
  return 0;
}

Bool TilDynHasMethod(TilStr *name,TilStr *method)
{
  if (TilStrNameEq(name,"Array__I64") && TilStrNameEq(method,"new")) return TRUE;
  if (TilStrNameEq(name,"Array__I64") && TilStrNameEq(method,"unsafe_get")) return TRUE;
  if (TilStrNameEq(name,"Array__I64") && TilStrNameEq(method,"get")) return TRUE;
  if (TilStrNameEq(name,"Array__I64") && TilStrNameEq(method,"unsafe_set")) return TRUE;
  if (TilStrNameEq(name,"Array__I64") && TilStrNameEq(method,"set")) return TRUE;
  if (TilStrNameEq(name,"Array__I64") && TilStrNameEq(method,"delete")) return TRUE;
  if (TilStrNameEq(name,"Array__I64") && TilStrNameEq(method,"concat")) return TRUE;
  if (TilStrNameEq(name,"Array__I64") && TilStrNameEq(method,"to_vec")) return TRUE;
