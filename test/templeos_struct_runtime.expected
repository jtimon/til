    if (index==7) { TilStrInitLit(out,"FuncPtr",7); return; }
    if (index==8) { TilStrInitLit(out,"Dynamic",7); return; }
    if (index==9) { TilStrInitLit(out,"Custom",6); return; }
    if (index==10) { TilStrInitLit(out,"Primitive",9); return; }
    if (index==11) { TilStrInitLit(out,"FuncPtrSig",10); return; }
    if (index==12) { TilStrInitLit(out,"Body",4); return; }
    if (index==13) { TilStrInitLit(out,"StructSym",9); return; }
    if (index==14) { TilStrInitLit(out,"EnumSym",7); return; }
    if (index==15) { TilStrInitLit(out,"CustomSym",9); return; }
    if (index==16) { TilStrInitLit(out,"FuncPtrSigSym",13); return; }
    TilReflectIndex("enum_variant_name",name,index);
