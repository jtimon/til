U0 Vec__Str_Push(Vec__Str *self, TilStr *value)
{
  if (self->count == self->cap) {
    if (self->cap > I64_MAX/2) TilPanicZ("Vec.push: capacity overflow
");
    U64 new_cap = self->cap * 2;
    if (!new_cap) new_cap = 1;
    if (new_cap > I64_MAX / sizeof(TilStr)) TilPanicZ("til: allocation size overflow
");
    self->data = (TilReAlloc(self->data, new_cap * sizeof(TilStr)))(TilStr *);
    self->cap = new_cap;
  }
  TilMemCpy(&self->data[self->count], value, sizeof(TilStr));
  TilMemSet(value, 0, sizeof(TilStr));
  self->count++;
}

U0 Vec__Str_Pop(TilStr *out, Vec__Str *self)
{
  if (!self->count) TilPanicZ("Vec.pop: empty vec
");
  self->count--;
  TilMemCpy(out, &self->data[self->count], sizeof(TilStr));
  TilMemSet(&self->data[self->count], 0, sizeof(TilStr));
}

