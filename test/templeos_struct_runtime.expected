U0 Vec__StructNamedPoint_Append(Vec__StructNamedPoint *self, Vec__StructNamedPoint *other)
{
  if (!other->count) {
    Vec__StructNamedPoint_Delete(other, FALSE);
    return;
  }
  if (other->count > I64_MAX - self->count) TilPanicZ("Vec.append: size overflow
");
  U64 needed = self->count + other->count;
  if (needed > self->cap) {
    U64 next_cap = self->cap;
    if (!next_cap) next_cap = 1;
    while (next_cap < needed) {
      if (next_cap > I64_MAX / 2) TilPanicZ("Vec.append: capacity overflow
");
      next_cap = next_cap * 2;
    }
    if (next_cap > I64_MAX / sizeof(StructNamedPoint)) TilPanicZ("Vec.append: allocation overflow
");
    self->data = (TilReAlloc(self->data, next_cap * sizeof(StructNamedPoint)))(StructNamedPoint *);
    self->cap = next_cap;
  }
  TilMemCpy(&self->data[self->count], other->data, other->count * sizeof(StructNamedPoint));
  self->count = needed;
  other->count = 0;
  Vec__StructNamedPoint_Delete(other, FALSE);
}

