    I64 cmp = TilStrCmp(&self->keys.data[mid], value);
    if (cmp < 0) lo = mid+1;
    else if (cmp > 0) hi = mid;
    else { *index = mid; return TRUE; }
  }
  *index = lo;
  return FALSE;
}

Bool Map__Str_I64_Has(Map__Str_I64 *self, TilStr *value)
{
  U64 i;
  return Map__Str_I64_Find(self, value, &i);
}

I64 *Map__Str_I64_Get(Map__Str_I64 *self, TilStr *value, I64 *err_kind)
{
  U64 i;
  *err_kind = 0;
  if (Map__Str_I64_Find(self, value, &i)) return &self->values.data[i];
  *err_kind = 4;
  return NULL;
}

U0 Map__Str_I64_Set(Map__Str_I64 *self, TilStr *value, I64 val)
{
  U64 i;
  if (Map__Str_I64_Find(self, value, &i)) {
    self->values.data[i] = val;
    return;
  }
  if (self->keys.count == self->keys.cap) {
    if (self->keys.cap > I64_MAX/2) TilPanicZ("Map: capacity overflow\n");
    U64 cap = self->keys.cap*2;
    if (!cap) cap = 1;
    if (cap > I64_MAX/sizeof(TilStr) || cap > I64_MAX/sizeof(I64)) TilPanicZ("Map: allocation overflow\n");
    self->keys.data = (TilReAlloc(self->keys.data, cap*sizeof(TilStr)))(TilStr *);
    self->values.data = (TilReAlloc(self->values.data, cap*sizeof(I64)))(I64 *);
    self->keys.cap = cap;
    self->values.cap = cap;
  }
  U64 tail = self->keys.count-i;
  if (tail) {
    TilMemMove(&self->keys.data[i+1], &self->keys.data[i], tail*sizeof(TilStr));
    TilMemMove(&self->values.data[i+1], &self->values.data[i], tail*sizeof(I64));
  }
  TilStrClone(&self->keys.data[i], value);
  self->values.data[i] = val;
  self->keys.count++;
  self->values.count++;
}

Bool Map__Str_I64_Remove(Map__Str_I64 *self, TilStr *value)
{
  U64 i;
  if (!Map__Str_I64_Find(self, value, &i)) return FALSE;
  I64 err_kind = 0;
  Vec__Str_RemoveAt(&self->keys, i, &err_kind);
  Vec__I64_RemoveAt(&self->values, i, &err_kind);
  return TRUE;
}

U0 StructSegment_Clone(StructSegment *out, StructSegment *src)
{
  StructPoint_Clone(&out->start, &src->start);
  StructPoint_Clone(&out->finish, &src->finish);
  out->active = src->active;
}

U0 StructSegment_Delete(StructSegment *self, Bool call_free)
{
  StructPoint_Delete(&self->start, FALSE);
  StructPoint_Delete(&self->finish, FALSE);
  if (call_free) TilFree(self);
}

Bool StructSegment_Eq(StructSegment *a, StructSegment *b)
{
  if (!StructPoint_Eq(&a->start, &b->start)) return FALSE;
  if (!StructPoint_Eq(&a->finish, &b->finish)) return FALSE;
  if (!(a->active == b->active)) return FALSE;
  return TRUE;
}

PayloadValue PayloadValue_Literal_Empty;
PayloadValue_Literal_Empty.tag = 0;

U0 PayloadValue_CopyValue(PayloadValue *out, PayloadValue *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    return;
  }
  if (src->tag == 1) {
    out->payload_Byte = src->payload_Byte;
    return;
  }
  if (src->tag == 2) {
    out->payload_Count = src->payload_Count;
    return;
  }
  if (src->tag == 3) {
    TilStrCopyValue(&out->payload_Text, &src->payload_Text);
    return;
  }
  if (src->tag == 4) {
    out->payload_Record.number = src->payload_Record.number;
    TilStrCopyValue(&out->payload_Record.name, &src->payload_Record.name);
    return;
  }
  TilPanicZ("invalid PayloadValue tag");
}

U0 PayloadValue_Clone(PayloadValue *out, PayloadValue *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    return;
  }
  if (src->tag == 1) {
    out->payload_Byte = src->payload_Byte;
    return;
  }
  if (src->tag == 2) {
    out->payload_Count = src->payload_Count;
    return;
  }
  if (src->tag == 3) {
    TilStrClone(&out->payload_Text, &src->payload_Text);
    return;
  }
  if (src->tag == 4) {
    PayloadRecord_Clone(&out->payload_Record, &src->payload_Record);
    return;
  }
  TilPanicZ("invalid PayloadValue tag");
}

U0 PayloadValue_Delete(PayloadValue *src, Bool call_free)
{
  if (src->tag == 0) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 1) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 2) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 3) {
    TilStrDelete(&src->payload_Text, FALSE);
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 4) {
    PayloadRecord_Delete(&src->payload_Record, FALSE);
    if (call_free) TilFree(src);
    return;
  }
  TilPanicZ("invalid PayloadValue tag");
}

Bool PayloadValue_Eq(PayloadValue *a, PayloadValue *b)
{
  if (a->tag != b->tag) return FALSE;
  if (a->tag == 0) {
    return TRUE;
  }
  if (a->tag == 1) {
    return a->payload_Byte == b->payload_Byte;
  }
  if (a->tag == 2) {
    return a->payload_Count == b->payload_Count;
  }
  if (a->tag == 3) {
    return TilStrEq(&a->payload_Text, &b->payload_Text);
  }
  if (a->tag == 4) {
    return PayloadRecord_Eq(&a->payload_Record, &b->payload_Record);
  }
  TilPanicZ("invalid PayloadValue tag");
  return FALSE;
}

U0 StructForwardRef_Clone(StructForwardRef *out, StructForwardRef *src)
{
  out->point = src->point;
}

U0 StructForwardRef_Delete(StructForwardRef *self, Bool call_free)
