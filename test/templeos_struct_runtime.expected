    return 3;
  }
  if (TilStrNameEq(name,"OrderedTag")) {
    return 3;
  }
  if (TilStrNameEq(name,"PayloadEnvelope")) {
    return 2;
  }
  if (TilStrNameEq(name,"PayloadValue")) {
    return 5;
  }
  if (TilStrNameEq(name,"Primitive")) {
    return 11;
  }
  if (TilStrNameEq(name,"ReverseTag")) {
    return 2;
  }
  if (TilStrNameEq(name,"Signal")) {
    return 3;
  }
  if (TilStrNameEq(name,"SmallSignal")) {
