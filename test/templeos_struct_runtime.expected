  if (TilStrNameEq(name,"OrderedNestedKey")) return sizeof(OrderedNestedKey);
  if (TilStrNameEq(name,"OrderedPayload")) return sizeof(OrderedPayload);
  if (TilStrNameEq(name,"OrderedTag")) return sizeof(U16);
  if (TilStrNameEq(name,"PayloadEnvelope")) return sizeof(PayloadEnvelope);
  if (TilStrNameEq(name,"PayloadRecord")) return sizeof(PayloadRecord);
  if (TilStrNameEq(name,"PayloadValue")) return sizeof(PayloadValue);
  if (TilStrNameEq(name,"Primitive")) return sizeof(U8);
  if (TilStrNameEq(name,"ReverseTag")) return sizeof(U16);
  if (TilStrNameEq(name,"Set__CustomOrderedKey")) return sizeof(Set__CustomOrderedKey);
  if (TilStrNameEq(name,"Set__I64")) return sizeof(Set__I64);
  if (TilStrNameEq(name,"Set__OrderedNestedKey")) return sizeof(Set__OrderedNestedKey);
  if (TilStrNameEq(name,"Set__OrderedPayload")) return sizeof(Set__OrderedPayload);
  if (TilStrNameEq(name,"Set__Str")) return sizeof(Set__Str);
  if (TilStrNameEq(name,"Signal")) return sizeof(U16);
  if (TilStrNameEq(name,"SmallSignal")) return sizeof(U8);
  if (TilStrNameEq(name,"Str")) return sizeof(TilStr);
  if (TilStrNameEq(name,"StructBorrowTag")) return sizeof(StructBorrowTag);
  if (TilStrNameEq(name,"StructBorrowed")) return sizeof(StructBorrowed);
  if (TilStrNameEq(name,"StructForwardPoint")) return sizeof(StructForwardPoint);
  if (TilStrNameEq(name,"StructForwardRef")) return sizeof(StructForwardRef);
  if (TilStrNameEq(name,"StructNamedPoint")) return sizeof(StructNamedPoint);
  if (TilStrNameEq(name,"StructNullable")) return sizeof(StructNullable);
  if (TilStrNameEq(name,"StructOwned")) return sizeof(StructOwned);
  if (TilStrNameEq(name,"StructPoint")) return sizeof(StructPoint);
  if (TilStrNameEq(name,"StructSegment")) return sizeof(StructSegment);
  if (TilStrNameEq(name,"StructSelfRef")) return sizeof(StructSelfRef);
  if (TilStrNameEq(name,"Type")) return sizeof(Type);
  if (TilStrNameEq(name,"U16")) return sizeof(U16);
  if (TilStrNameEq(name,"U32")) return sizeof(U32);
  if (TilStrNameEq(name,"U64")) return sizeof(U64);
  if (TilStrNameEq(name,"U8")) return sizeof(U8);
  if (TilStrNameEq(name,"UPtr")) return sizeof(U64);
  if (TilStrNameEq(name,"USize")) return sizeof(U64);
  if (TilStrNameEq(name,"Vec__CustomOrderedKey")) return sizeof(Vec__CustomOrderedKey);
  if (TilStrNameEq(name,"Vec__I64")) return sizeof(Vec__I64);
  if (TilStrNameEq(name,"Vec__OrderedKey")) return sizeof(Vec__OrderedKey);
  if (TilStrNameEq(name,"Vec__OrderedTag")) return sizeof(Vec__OrderedTag);
  if (TilStrNameEq(name,"Vec__PayloadValue")) return sizeof(Vec__PayloadValue);
  if (TilStrNameEq(name,"Vec__ReverseTag")) return sizeof(Vec__ReverseTag);
  if (TilStrNameEq(name,"Vec__Str")) return sizeof(Vec__Str);
  if (TilStrNameEq(name,"Vec__StructNamedPoint")) return sizeof(Vec__StructNamedPoint);
  if (TilStrNameEq(name,"Vec__call_Vec_I64")) return sizeof(Vec__call_Vec_I64);
  if (TilStrNameEq(name,"WideSignal")) return sizeof(U64);
  TilReflectMissing("dyn_size_of",name);
  return 0;
}

