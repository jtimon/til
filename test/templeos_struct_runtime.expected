Bool Map__OrderedKey_Str_Find(Map__OrderedKey_Str *self, OrderedKey *value, U64 *index)
{
  U64 lo = 0;
  U64 hi = self->keys.count;
  while (lo < hi) {
    U64 mid = lo + (hi-lo)/2;
    I64 cmp = OrderedKey_Cmp(&self->keys.data[mid], value);
    if (cmp < 0) lo = mid+1;
    else if (cmp > 0) hi = mid;
    else { *index = mid; return TRUE; }
  }
  *index = lo;
  return FALSE;
}

