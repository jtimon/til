class StructSegment {
  StructPoint start;
  StructPoint finish;
  Bool active;
};

U0 StructSegment_Clone(StructSegment *out, StructSegment *src)
{
  StructPoint_Clone(&out->start, &src->start);
  StructPoint_Clone(&out->finish, &src->finish);
  out->active = src->active;
}

U0 StructSegment_Delete(StructSegment *self, Bool call_free)
{
  StructPoint_Delete(&self->start, FALSE);
  StructPoint_Delete(&self->finish, FALSE);
  if (call_free) TilFree(self);
}

Bool StructSegment_Eq(StructSegment *a, StructSegment *b)
{
  if (!StructPoint_Eq(&a->start, &b->start)) return FALSE;
  if (!StructPoint_Eq(&a->finish, &b->finish)) return FALSE;
  if (!(a->active == b->active)) return FALSE;
  return TRUE;
}

class PayloadValue {
  U8 tag;
  union {
    U8 payload_Byte;
    I64 payload_Count;
    TilStr payload_Text;
    PayloadRecord payload_Record;
  };
};

PayloadValue PayloadValue_Literal_Empty;
PayloadValue_Literal_Empty.tag = 0;

U0 PayloadValue_CopyValue(PayloadValue *out, PayloadValue *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    return;
  }
  if (src->tag == 1) {
    out->payload_Byte = src->payload_Byte;
    return;
  }
  if (src->tag == 2) {
    out->payload_Count = src->payload_Count;
    return;
  }
  if (src->tag == 3) {
    TilStrCopyValue(&out->payload_Text, &src->payload_Text);
    return;
  }
  if (src->tag == 4) {
    out->payload_Record.number = src->payload_Record.number;
    TilStrCopyValue(&out->payload_Record.name, &src->payload_Record.name);
    return;
  }
