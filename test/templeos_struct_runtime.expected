class StructPoint {
  I64 x;
  I64 y;
};

U0 StructPoint_Clone(StructPoint *out, StructPoint *src)
{
  out->x = src->x;
  out->y = src->y;
}

U0 StructPoint_Delete(StructPoint *self)
{
}

Bool StructPoint_Eq(StructPoint *a, StructPoint *b)
{
  if (a->x != b->x)
    return FALSE;
  if (a->y != b->y)
    return FALSE;
  return TRUE;
}

class StructNamedPoint {
  StructPoint point;
  TilStr name;
};

U0 StructNamedPoint_Clone(StructNamedPoint *out, StructNamedPoint *src)
{
  StructPoint_Clone(&out->point, &src->point);
  TilStrClone(&out->name, &src->name);
}

U0 StructNamedPoint_Delete(StructNamedPoint *self)
{
  StructPoint_Delete(&self->point);
  TilStrDelete(&self->name, FALSE);
}

Bool StructNamedPoint_Eq(StructNamedPoint *a, StructNamedPoint *b)
{
  if (!StructPoint_Eq(&a->point, &b->point))
    return FALSE;
  if (!TilStrEq(&a->name, &b->name))
    return FALSE;
  return TRUE;
}

class StructSegment {
  StructPoint start;
  StructPoint finish;
  Bool active;
};

U0 StructSegment_Clone(StructSegment *out, StructSegment *src)
{
  StructPoint_Clone(&out->start, &src->start);
  StructPoint_Clone(&out->finish, &src->finish);
  out->active = src->active;
}

U0 StructSegment_Delete(StructSegment *self)
{
  StructPoint_Delete(&self->start);
  StructPoint_Delete(&self->finish);
}

Bool StructSegment_Eq(StructSegment *a, StructSegment *b)
{
  if (!StructPoint_Eq(&a->start, &b->start))
    return FALSE;
  if (!StructPoint_Eq(&a->finish, &b->finish))
    return FALSE;
  if (a->active != b->active)
    return FALSE;
  return TRUE;
}

