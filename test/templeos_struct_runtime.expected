  return &array->data[i];
}

U0 TilStrArrayConcat(TilStrArray *out, TilStrArray *a, TilStrArray *b)
{
  if (b->cap > I64_MAX - a->cap) TilPanicZ("Array(Str).concat: capacity overflow
");
  U64 total = a->cap + b->cap;
  TilStrArrayNew(out, total);
  U64 i = 0;
  while (i < a->cap) { TilStrClone(&out->data[i], &a->data[i]); i++; }
  U64 j = 0;
  while (j < b->cap) { TilStrClone(&out->data[a->cap+j], &b->data[j]); j++; }
}

U0 TilStrArrayToVec(Vec__Str *out, TilStrArray *src)
{
  Vec__Str_WithCapacity(out, src->cap);
  U64 i = 0;
  while (i < src->cap) { TilStrClone(&out->data[i], &src->data[i]); i++; }
  out->count = src->cap;
}

