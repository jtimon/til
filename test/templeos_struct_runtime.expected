  U8 tag;
  union {
    TilStr payload_Struct;
    TilStr payload_Enum;
    TilStr payload_Custom;
    U8 payload_Primitive;
    TilStr payload_FuncPtrSig;
    U32 payload_StructSym;
    U32 payload_EnumSym;
    U32 payload_CustomSym;
    U32 payload_FuncPtrSigSym;
  };
};

