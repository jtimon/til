U0 Vec__PayloadValue_CopyValue(Vec__PayloadValue *out, Vec__PayloadValue *src)
{
  out->data = src->data;
  out->count = src->count;
  out->cap = src->cap;
}

U0 Vec__PayloadValue_New(Vec__PayloadValue *out)
{
  out->data = NULL;
  out->count = 0;
  out->cap = 0;
}

U0 Vec__PayloadValue_WithCapacity(Vec__PayloadValue *out, U64 cap)
{
  out->data = NULL;
  if (cap && cap > I64_MAX / sizeof(PayloadValue)) TilPanicZ("til: allocation size overflow
");
  if (cap) out->data = (TilMAlloc(cap * sizeof(PayloadValue)))(PayloadValue *);
  out->count = 0;
  out->cap = cap;
}

U0 Vec__PayloadValue_Clone(Vec__PayloadValue *out, Vec__PayloadValue *src)
{
  out->data = (TilCAlloc(src->cap, sizeof(PayloadValue)))(PayloadValue *);
  out->count = src->count;
  out->cap = src->cap;
  U64 i = 0;
  while (i < src->count) {
    PayloadValue_Clone(&out->data[i], &src->data[i]);
    i++;
  }
}

PayloadValue *Vec__PayloadValue_UnsafeGet(Vec__PayloadValue *self, U64 i)
{
  return &self->data[i];
}

U0 Vec__PayloadValue_UnsafeSet(Vec__PayloadValue *self, U64 i, PayloadValue *value)
{
  PayloadValue_Delete(&self->data[i], FALSE);
  TilMemCpy(&self->data[i], value, sizeof(PayloadValue));
  TilMemSet(value, 0, sizeof(PayloadValue));
}

PayloadValue *Vec__PayloadValue_Get(Vec__PayloadValue *self, U64 i, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->count) {
    *err_kind = 1;
    return NULL;
  }
  return Vec__PayloadValue_UnsafeGet(self, i);
}

U0 Vec__PayloadValue_Set(Vec__PayloadValue *self, U64 i, PayloadValue *value, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->count) {
    *err_kind = 1;
    return;
  }
  Vec__PayloadValue_UnsafeSet(self, i, value);
}

U0 Vec__PayloadValue_Push(Vec__PayloadValue *self, PayloadValue *value)
{
  if (self->count == self->cap) {
    if (self->cap > I64_MAX/2) TilPanicZ("Vec.push: capacity overflow
");
    U64 new_cap = self->cap * 2;
    if (!new_cap) new_cap = 1;
    if (new_cap > I64_MAX / sizeof(PayloadValue)) TilPanicZ("til: allocation size overflow
");
    self->data = (TilReAlloc(self->data, new_cap * sizeof(PayloadValue)))(PayloadValue *);
    self->cap = new_cap;
  }
  TilMemCpy(&self->data[self->count], value, sizeof(PayloadValue));
  TilMemSet(value, 0, sizeof(PayloadValue));
  self->count++;
}

U0 Vec__PayloadValue_Pop(PayloadValue *out, Vec__PayloadValue *self)
{
  if (!self->count) TilPanicZ("Vec.pop: empty vec
");
  self->count--;
  TilMemCpy(out, &self->data[self->count], sizeof(PayloadValue));
  TilMemSet(&self->data[self->count], 0, sizeof(PayloadValue));
}

U0 Vec__PayloadValue_Clear(Vec__PayloadValue *self)
{
  U64 i = 0;
  while (i < self->count) {
    PayloadValue_Delete(&self->data[i], FALSE);
    i++;
  }
  self->count = 0;
}

U0 Vec__PayloadValue_Delete(Vec__PayloadValue *self, Bool call_free)
{
  Vec__PayloadValue_Clear(self);
  TilFree(self->data);
  self->data = NULL;
  self->cap = 0;
  self->count = 0;
  if (call_free) TilFree(self);
}

U0 Vec__PayloadValue_Take(Vec__PayloadValue *out, Vec__PayloadValue *self)
{
  Vec__PayloadValue_CopyValue(out, self);
  self->data = NULL;
  self->count = 0;
  self->cap = 0;
}

U0 Vec__PayloadValue_Append(Vec__PayloadValue *self, Vec__PayloadValue *other)
{
  if (!other->count) {
    Vec__PayloadValue_Delete(other, FALSE);
    return;
  }
  if (other->count > I64_MAX - self->count) TilPanicZ("Vec.append: size overflow
");
  U64 needed = self->count + other->count;
  if (needed > self->cap) {
    U64 next_cap = self->cap;
    if (!next_cap) next_cap = 1;
    while (next_cap < needed) {
      if (next_cap > I64_MAX / 2) TilPanicZ("Vec.append: capacity overflow
");
      next_cap = next_cap * 2;
    }
    if (next_cap > I64_MAX / sizeof(PayloadValue)) TilPanicZ("Vec.append: allocation overflow
");
    self->data = (TilReAlloc(self->data, next_cap * sizeof(PayloadValue)))(PayloadValue *);
    self->cap = next_cap;
  }
  TilMemCpy(&self->data[self->count], other->data, other->count * sizeof(PayloadValue));
  self->count = needed;
  other->count = 0;
  Vec__PayloadValue_Delete(other, FALSE);
}

U0 Vec__PayloadValue_MoveTo(Vec__PayloadValue *src, Vec__PayloadValue *dest)
{
  Vec__PayloadValue_Delete(dest, FALSE);
  Vec__PayloadValue_Take(dest, src);
}

U0 Vec__PayloadValue_Truncate(Vec__PayloadValue *self, U64 n)
{
  if (n > self->count) TilPanicZ("Vec.truncate: out of bounds
");
  U64 i = n;
  while (i < self->count) {
    PayloadValue_Delete(&self->data[i], FALSE);
    i++;
  }
  self->count = n;
}

U0 Vec__PayloadValue_RemoveAt(Vec__PayloadValue *self, U64 i, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->count) { *err_kind = 1; return; }
  PayloadValue_Delete(&self->data[i], FALSE);
  U64 last = self->count - 1;
  if (i < last) TilMemMove(&self->data[i], &self->data[i+1], (last-i)*sizeof(PayloadValue));
  self->count = last;
  TilMemSet(&self->data[last], 0, sizeof(PayloadValue));
}

U0 Vec__PayloadValue_PushTake(Vec__PayloadValue *self, Vec__PayloadValue *src, U64 i)
{
  if (i >= src->count) TilPanicZ("Vec.push_take: out of bounds
");
  if (self->count == self->cap) {
    if (self->cap > I64_MAX/2) TilPanicZ("Vec.push_take: capacity overflow
");
    U64 next_cap = self->cap * 2;
    if (!next_cap) next_cap = 1;
    if (next_cap > I64_MAX/sizeof(PayloadValue)) TilPanicZ("Vec.push_take: allocation overflow
");
    self->data = (TilReAlloc(self->data, next_cap*sizeof(PayloadValue)))(PayloadValue *);
    self->cap = next_cap;
  }
  TilMemCpy(&self->data[self->count], &src->data[i], sizeof(PayloadValue));
  TilMemSet(&src->data[i], 0, sizeof(PayloadValue));
  self->count++;
}

U0 Vec__PayloadValue_TakePrefix(Vec__PayloadValue *out, Vec__PayloadValue *self, U64 n)
{
  if (n > self->count) TilPanicZ("Vec.take_prefix: out of bounds
");
  U64 cap = n;
  if (!cap) cap = 1;
  if (cap > I64_MAX/sizeof(PayloadValue)) TilPanicZ("Vec.take_prefix: allocation overflow
");
  out->data = (TilMAlloc(cap*sizeof(PayloadValue)))(PayloadValue *);
  out->count = n;
  out->cap = cap;
  if (n) TilMemCpy(out->data, self->data, n*sizeof(PayloadValue));
  U64 tail = self->count - n;
  if (tail) TilMemMove(self->data, &self->data[n], tail*sizeof(PayloadValue));
  if (n) TilMemSet(&self->data[tail], 0, n*sizeof(PayloadValue));
  self->count = tail;
}

U0 Vec__PayloadValue_DeleteMarked(Vec__PayloadValue *self, U8 *marks)
{
  U64 i = 0;
  while (i < self->count) {
    if (marks[i]) {
      PayloadValue_Delete(&self->data[i], FALSE);
      TilMemSet(&self->data[i], 0, sizeof(PayloadValue));
    }
    i++;
  }
  U64 w = 0;
  U64 r = 0;
  while (r < self->count) {
    if (!marks[r]) {
      if (w != r) TilMemCpy(&self->data[w], &self->data[r], sizeof(PayloadValue));
      w++;
    }
    r++;
  }
  self->count = w;
}

PayloadEnvelope PayloadEnvelope_Literal_Empty;
PayloadEnvelope_Literal_Empty.tag = 0;

U0 PayloadEnvelope_CopyValue(PayloadEnvelope *out, PayloadEnvelope *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    return;
  }
  if (src->tag == 1) {
    PayloadValue_CopyValue(&out->payload_Wrapped, &src->payload_Wrapped);
    return;
  }
  TilPanicZ("invalid PayloadEnvelope tag");
}

U0 PayloadEnvelope_Clone(PayloadEnvelope *out, PayloadEnvelope *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    return;
  }
  if (src->tag == 1) {
    PayloadValue_Clone(&out->payload_Wrapped, &src->payload_Wrapped);
    return;
  }
  TilPanicZ("invalid PayloadEnvelope tag");
}

U0 PayloadEnvelope_Delete(PayloadEnvelope *src, Bool call_free)
{
  if (src->tag == 0) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 1) {
    PayloadValue_Delete(&src->payload_Wrapped, FALSE);
    if (call_free) TilFree(src);
    return;
  }
  TilPanicZ("invalid PayloadEnvelope tag");
}

Bool PayloadEnvelope_Eq(PayloadEnvelope *a, PayloadEnvelope *b)
{
  if (a->tag != b->tag) return FALSE;
  if (a->tag == 0) {
    return TRUE;
  }
  if (a->tag == 1) {
    return PayloadValue_Eq(&a->payload_Wrapped, &b->payload_Wrapped);
  }
  TilPanicZ("invalid PayloadEnvelope tag");
  return FALSE;
}

