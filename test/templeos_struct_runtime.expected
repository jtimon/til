U64 TilTakeWord(U8 *box,U64 size,Bool free_box)
{
  U64 word=0; TilMemCpy(&word,box,size);
  if (free_box) TilFree(box);
  return word;
}

U0 TilStrArrayClone(TilStrArray *out, TilStrArray *src)
{
  TilStrArrayNew(out, src->cap);
  U64 i = 0;
  while (i < src->cap) {
    TilStrClone(&out->data[i], &src->data[i]);
    i++;
  }
}

U0 TilStrArrayCopyValue(TilStrArray *out, TilStrArray *src)
{
  out->data = src->data;
  out->cap = src->cap;
}

TilStr *TilStrArrayGet(TilStrArray *array, U64 i, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= array->cap) { *err_kind = 1; return NULL; }
  return &array->data[i];
}

U0 TilStrArrayConcat(TilStrArray *out, TilStrArray *a, TilStrArray *b)
{
  if (b->cap > I64_MAX - a->cap) TilPanicZ("Array(Str).concat: capacity overflow
");
  U64 total = a->cap + b->cap;
  TilStrArrayNew(out, total);
  U64 i = 0;
  while (i < a->cap) { TilStrClone(&out->data[i], &a->data[i]); i++; }
  U64 j = 0;
  while (j < b->cap) { TilStrClone(&out->data[a->cap+j], &b->data[j]); j++; }
}

U0 TilStrArrayToVec(Vec__Str *out, TilStrArray *src)
{
  Vec__Str_WithCapacity(out, src->cap);
  U64 i = 0;
  while (i < src->cap) { TilStrClone(&out->data[i], &src->data[i]); i++; }
  out->count = src->cap;
}

U0 TilPanicParts(TilStrArray *parts, TilStr *loc)
{
  TilStrWrite(loc);
  TilRawWrite(": ", 2);
  TilPrintln(parts);
  TilPanicZ("");
}

