class Vec__PayloadValue {
  PayloadValue *data;
  U64 count;
  U64 cap;
};

U0 Vec__PayloadValue_CopyValue(Vec__PayloadValue *out, Vec__PayloadValue *src)
{
  out->data = src->data;
  out->count = src->count;
  out->cap = src->cap;
}

U0 Vec__PayloadValue_New(Vec__PayloadValue *out)
{
  out->data = NULL;
  out->count = 0;
  out->cap = 0;
}

U0 Vec__PayloadValue_WithCapacity(Vec__PayloadValue *out, U64 cap)
{
  out->data = NULL;
  if (cap && cap > I64_MAX / sizeof(PayloadValue)) TilPanicZ("til: allocation size overflow
");
  if (cap) out->data = (TilMAlloc(cap * sizeof(PayloadValue)))(PayloadValue *);
  out->count = 0;
  out->cap = cap;
}

U0 Vec__PayloadValue_Clone(Vec__PayloadValue *out, Vec__PayloadValue *src)
{
  out->data = (TilCAlloc(src->cap, sizeof(PayloadValue)))(PayloadValue *);
  out->count = src->count;
  out->cap = src->cap;
  U64 i = 0;
  while (i < src->count) {
    PayloadValue_Clone(&out->data[i], &src->data[i]);
    i++;
  }
}

PayloadValue *Vec__PayloadValue_UnsafeGet(Vec__PayloadValue *self, U64 i)
{
  return &self->data[i];
}

U0 Vec__PayloadValue_UnsafeSet(Vec__PayloadValue *self, U64 i, PayloadValue *value)
{
  PayloadValue_Delete(&self->data[i], FALSE);
  TilMemCpy(&self->data[i], value, sizeof(PayloadValue));
  TilMemSet(value, 0, sizeof(PayloadValue));
}

PayloadValue *Vec__PayloadValue_Get(Vec__PayloadValue *self, U64 i, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->count) {
    *err_kind = 1;
    return NULL;
  }
  return Vec__PayloadValue_UnsafeGet(self, i);
}

U0 Vec__PayloadValue_Set(Vec__PayloadValue *self, U64 i, PayloadValue *value, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->count) {
    *err_kind = 1;
    return;
  }
  Vec__PayloadValue_UnsafeSet(self, i, value);
}

U0 Vec__PayloadValue_Push(Vec__PayloadValue *self, PayloadValue *value)
{
  if (self->count == self->cap) {
    if (self->cap > I64_MAX/2) TilPanicZ("Vec.push: capacity overflow
");
    U64 new_cap = self->cap * 2;
    if (!new_cap) new_cap = 1;
    if (new_cap > I64_MAX / sizeof(PayloadValue)) TilPanicZ("til: allocation size overflow
");
    self->data = (TilReAlloc(self->data, new_cap * sizeof(PayloadValue)))(PayloadValue *);
    self->cap = new_cap;
  }
  TilMemCpy(&self->data[self->count], value, sizeof(PayloadValue));
  TilMemSet(value, 0, sizeof(PayloadValue));
  self->count++;
}

U0 Vec__PayloadValue_Pop(PayloadValue *out, Vec__PayloadValue *self)
{
  if (!self->count) TilPanicZ("Vec.pop: empty vec
");
  self->count--;
  TilMemCpy(out, &self->data[self->count], sizeof(PayloadValue));
  TilMemSet(&self->data[self->count], 0, sizeof(PayloadValue));
}

U0 Vec__PayloadValue_Clear(Vec__PayloadValue *self)
{
  U64 i = 0;
  while (i < self->count) {
    PayloadValue_Delete(&self->data[i], FALSE);
    i++;
  }
  self->count = 0;
}

U0 Vec__PayloadValue_Delete(Vec__PayloadValue *self, Bool call_free)
{
  Vec__PayloadValue_Clear(self);
  TilFree(self->data);
  self->data = NULL;
  self->cap = 0;
  self->count = 0;
  if (call_free) TilFree(self);
}

U0 Vec__PayloadValue_Take(Vec__PayloadValue *out, Vec__PayloadValue *self)
{
  Vec__PayloadValue_CopyValue(out, self);
  self->data = NULL;
  self->count = 0;
