Bool TilDynHasMethodLiteral(TilStr *name,U8 *data,TIL_USIZE count)
{
  TilStr method; TilStrInitLit(&method,data,count);
  return TilDynHasMethod(name,&method);
}

I64 TilReflect_enum_variant_count(TilStr *name)
{
  if (TilStrNameEq(name,"CallableAction")) {
    return 2;
  }
  if (TilStrNameEq(name,"DefaultSignal")) {
    return 2;
  }
  if (TilStrNameEq(name,"MediumSignal")) {
    return 2;
  }
  if (TilStrNameEq(name,"OrderedPayload")) {
    return 3;
  }
  if (TilStrNameEq(name,"OrderedTag")) {
    return 3;
  }
  if (TilStrNameEq(name,"PayloadEnvelope")) {
    return 2;
  }
  if (TilStrNameEq(name,"PayloadValue")) {
    return 5;
  }
  if (TilStrNameEq(name,"Primitive")) {
    return 11;
  }
  if (TilStrNameEq(name,"ReverseTag")) {
    return 2;
  }
  if (TilStrNameEq(name,"Signal")) {
    return 3;
  }
  if (TilStrNameEq(name,"SmallSignal")) {
    return 2;
  }
  if (TilStrNameEq(name,"StructBorrowTag")) {
    return 3;
  }
  if (TilStrNameEq(name,"Type")) {
    return 17;
  }
  if (TilStrNameEq(name,"WideSignal")) {
    return 3;
  }
  TilReflectMissing("enum_variant_count",name);
  return 0;
}

U0 TilReflect_enum_variant_name(TilStr *out,TilStr *name,I64 index)
{
  if (TilStrNameEq(name,"CallableAction")) {
    if (index==0) { TilStrInitLit(out,"Empty",5); return; }
    if (index==1) { TilStrInitLit(out,"Run",3); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"DefaultSignal")) {
    if (index==0) { TilStrInitLit(out,"First",5); return; }
    if (index==1) { TilStrInitLit(out,"Second",6); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"MediumSignal")) {
    if (index==0) { TilStrInitLit(out,"Low",3); return; }
    if (index==1) { TilStrInitLit(out,"High",4); return; }
    TilReflectIndex("enum_variant_name",name,index);
