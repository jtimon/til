U0 Array__StructNamedPoint_Concat(Array__StructNamedPoint *out, Array__StructNamedPoint *a, Array__StructNamedPoint *b)
{
  if (b->cap > I64_MAX - a->cap) TilPanicZ("Array.concat: size overflow
");
  Array__StructNamedPoint_New(out, a->cap + b->cap);
  U64 i = 0;
  while (i < a->cap) {
    StructNamedPoint_Clone(&out->data[i], &a->data[i]);
    i++;
  }
  U64 j = 0;
  while (j < b->cap) {
    StructNamedPoint_Clone(&out->data[a->cap+j], &b->data[j]);
    j++;
  }
}

U0 Array__StructNamedPoint_ToVec(Vec__StructNamedPoint *out, Array__StructNamedPoint *src)
{
  Vec__StructNamedPoint_WithCapacity(out, src->cap);
  U64 i = 0;
  while (i < src->cap) {
    StructNamedPoint_Clone(&out->data[i], &src->data[i]);
    i++;
  }
  out->count = src->cap;
}

