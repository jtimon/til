class OrderedPayload {
  U8 tag;
  union {
    TilStr payload_Word;
    I64 payload_Number;
  };
};

OrderedPayload OrderedPayload_Literal_Empty;
OrderedPayload_Literal_Empty.tag = 0;

U0 OrderedPayload_CopyValue(OrderedPayload *out, OrderedPayload *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    return;
  }
  if (src->tag == 1) {
    TilStrCopyValue(&out->payload_Word, &src->payload_Word);
    return;
  }
  if (src->tag == 2) {
    out->payload_Number = src->payload_Number;
    return;
  }
  TilPanicZ("invalid OrderedPayload tag");
}

U0 OrderedPayload_Clone(OrderedPayload *out, OrderedPayload *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    return;
  }
  if (src->tag == 1) {
    TilStrClone(&out->payload_Word, &src->payload_Word);
    return;
  }
  if (src->tag == 2) {
    out->payload_Number = src->payload_Number;
    return;
  }
  TilPanicZ("invalid OrderedPayload tag");
}

U0 OrderedPayload_Delete(OrderedPayload *src, Bool call_free)
{
  if (src->tag == 0) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 1) {
    TilStrDelete(&src->payload_Word, FALSE);
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 2) {
    if (call_free) TilFree(src);
    return;
  }
  TilPanicZ("invalid OrderedPayload tag");
}

Bool OrderedPayload_Eq(OrderedPayload *a, OrderedPayload *b)
{
  if (a->tag != b->tag) return FALSE;
  if (a->tag == 0) {
    return TRUE;
  }
  if (a->tag == 1) {
    return TilStrEq(&a->payload_Word, &b->payload_Word);
  }
  if (a->tag == 2) {
    return a->payload_Number == b->payload_Number;
  }
  TilPanicZ("invalid OrderedPayload tag");
  return FALSE;
}

extern I64 OrderedPayload_Cmp(OrderedPayload *a, OrderedPayload *b);

