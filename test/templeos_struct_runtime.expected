U0 TilStrArrayClone(TilStrArray *out, TilStrArray *src)
{
  TilStrArrayNew(out, src->cap);
  U64 i = 0;
  while (i < src->cap) {
    TilStrClone(&out->data[i], &src->data[i]);
    i++;
  }
}

