U0 StructPoint_Clone(StructPoint *out, StructPoint *src)
{
  out->x = src->x;
  out->y = src->y;
}

U0 StructPoint_Delete(StructPoint *self, Bool call_free)
{
  if (call_free) TilFree(self);
}

Bool StructPoint_Eq(StructPoint *a, StructPoint *b)
{
  if (!(a->x == b->x)) return FALSE;
  if (!(a->y == b->y)) return FALSE;
  return TRUE;
}

U0 StructNamedPoint_Clone(StructNamedPoint *out, StructNamedPoint *src)
{
  StructPoint_Clone(&out->point, &src->point);
  TilStrClone(&out->name, &src->name);
}

U0 StructNamedPoint_Delete(StructNamedPoint *self, Bool call_free)
{
  StructPoint_Delete(&self->point, FALSE);
  TilStrDelete(&self->name, FALSE);
  if (call_free) TilFree(self);
}

Bool StructNamedPoint_Eq(StructNamedPoint *a, StructNamedPoint *b)
{
  if (!StructPoint_Eq(&a->point, &b->point)) return FALSE;
  if (!TilStrEq(&a->name, &b->name)) return FALSE;
  return TRUE;
}

U0 PayloadRecord_Clone(PayloadRecord *out, PayloadRecord *src)
{
  out->number = src->number;
  TilStrClone(&out->name, &src->name);
}

