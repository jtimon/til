{
  U64 i;
  return Map__OrderedKey_Str_Find(self, value, &i);
}

TilStr *Map__OrderedKey_Str_Get(Map__OrderedKey_Str *self, OrderedKey *value, I64 *err_kind)
{
  U64 i;
  *err_kind = 0;
  if (Map__OrderedKey_Str_Find(self, value, &i)) return &self->values.data[i];
  *err_kind = 4;
  return NULL;
}

U0 Map__OrderedKey_Str_Set(Map__OrderedKey_Str *self, OrderedKey *value, TilStr *val)
{
  U64 i;
  if (Map__OrderedKey_Str_Find(self, value, &i)) {
    TilStrDelete(&self->values.data[i], FALSE);
    TilMemCpy(&self->values.data[i], val, sizeof(TilStr));
    TilMemSet(val, 0, sizeof(TilStr));
    return;
  }
  if (self->keys.count == self->keys.cap) {
    if (self->keys.cap > I64_MAX/2) TilPanicZ("Map: capacity overflow\n");
    U64 cap = self->keys.cap*2;
    if (!cap) cap = 1;
    if (cap > I64_MAX/sizeof(OrderedKey) || cap > I64_MAX/sizeof(TilStr)) TilPanicZ("Map: allocation overflow\n");
    self->keys.data = (TilReAlloc(self->keys.data, cap*sizeof(OrderedKey)))(OrderedKey *);
    self->values.data = (TilReAlloc(self->values.data, cap*sizeof(TilStr)))(TilStr *);
    self->keys.cap = cap;
    self->values.cap = cap;
  }
  U64 tail = self->keys.count-i;
  if (tail) {
    TilMemMove(&self->keys.data[i+1], &self->keys.data[i], tail*sizeof(OrderedKey));
    TilMemMove(&self->values.data[i+1], &self->values.data[i], tail*sizeof(TilStr));
  }
  OrderedKey_Clone(&self->keys.data[i], value);
  TilMemCpy(&self->values.data[i], val, sizeof(TilStr));
  TilMemSet(val, 0, sizeof(TilStr));
  self->keys.count++;
  self->values.count++;
}

Bool Map__OrderedKey_Str_Remove(Map__OrderedKey_Str *self, OrderedKey *value)
{
  U64 i;
  if (!Map__OrderedKey_Str_Find(self, value, &i)) return FALSE;
  I64 err_kind = 0;
  Vec__OrderedKey_RemoveAt(&self->keys, i, &err_kind);
  Vec__Str_RemoveAt(&self->values, i, &err_kind);
  return TRUE;
}

