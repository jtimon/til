U0 Vec__Str_CopyValue(Vec__Str *out, Vec__Str *src)
{
  out->data = src->data;
  out->count = src->count;
  out->cap = src->cap;
}

U0 Vec__Str_New(Vec__Str *out)
{
  out->data = NULL;
  out->count = 0;
  out->cap = 0;
}

U0 Vec__Str_WithCapacity(Vec__Str *out, U64 cap)
{
  out->data = NULL;
  if (cap && cap > I64_MAX / sizeof(TilStr)) TilPanicZ("til: allocation size overflow
");
  if (cap) out->data = (TilMAlloc(cap * sizeof(TilStr)))(TilStr *);
  out->count = 0;
  out->cap = cap;
}

U0 Vec__Str_Clone(Vec__Str *out, Vec__Str *src)
{
  out->data = (TilCAlloc(src->cap, sizeof(TilStr)))(TilStr *);
  out->count = src->count;
  out->cap = src->cap;
  U64 i = 0;
  while (i < src->count) {
    TilStrClone(&out->data[i], &src->data[i]);
    i++;
  }
}

TilStr *Vec__Str_UnsafeGet(Vec__Str *self, U64 i)
{
  return &self->data[i];
}

U0 Vec__Str_UnsafeSet(Vec__Str *self, U64 i, TilStr *value)
{
  TilStrDelete(&self->data[i], FALSE);
  TilMemCpy(&self->data[i], value, sizeof(TilStr));
  TilMemSet(value, 0, sizeof(TilStr));
}

TilStr *Vec__Str_Get(Vec__Str *self, U64 i, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->count) {
    *err_kind = 1;
    return NULL;
  }
  return Vec__Str_UnsafeGet(self, i);
}

U0 Vec__Str_Set(Vec__Str *self, U64 i, TilStr *value, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->count) {
    *err_kind = 1;
    return;
  }
  Vec__Str_UnsafeSet(self, i, value);
}

U0 Vec__Str_Push(Vec__Str *self, TilStr *value)
{
  if (self->count == self->cap) {
    if (self->cap > I64_MAX/2) TilPanicZ("Vec.push: capacity overflow
");
    U64 new_cap = self->cap * 2;
    if (!new_cap) new_cap = 1;
    if (new_cap > I64_MAX / sizeof(TilStr)) TilPanicZ("til: allocation size overflow
");
    self->data = (TilReAlloc(self->data, new_cap * sizeof(TilStr)))(TilStr *);
    self->cap = new_cap;
  }
  TilMemCpy(&self->data[self->count], value, sizeof(TilStr));
  TilMemSet(value, 0, sizeof(TilStr));
  self->count++;
}

U0 Vec__Str_Pop(TilStr *out, Vec__Str *self)
{
  if (!self->count) TilPanicZ("Vec.pop: empty vec
");
  self->count--;
  TilMemCpy(out, &self->data[self->count], sizeof(TilStr));
  TilMemSet(&self->data[self->count], 0, sizeof(TilStr));
}

U0 Vec__Str_Clear(Vec__Str *self)
{
  U64 i = 0;
  while (i < self->count) {
    TilStrDelete(&self->data[i], FALSE);
    i++;
  }
  self->count = 0;
}

U0 Vec__Str_Delete(Vec__Str *self, Bool call_free)
{
  Vec__Str_Clear(self);
  TilFree(self->data);
  self->data = NULL;
  self->cap = 0;
  self->count = 0;
  if (call_free) TilFree(self);
}

U0 Vec__Str_Take(Vec__Str *out, Vec__Str *self)
{
  Vec__Str_CopyValue(out, self);
  self->data = NULL;
  self->count = 0;
  self->cap = 0;
}

U0 Vec__Str_Append(Vec__Str *self, Vec__Str *other)
{
  if (!other->count) {
    Vec__Str_Delete(other, FALSE);
    return;
  }
  if (other->count > I64_MAX - self->count) TilPanicZ("Vec.append: size overflow
");
  U64 needed = self->count + other->count;
  if (needed > self->cap) {
    U64 next_cap = self->cap;
    if (!next_cap) next_cap = 1;
    while (next_cap < needed) {
      if (next_cap > I64_MAX / 2) TilPanicZ("Vec.append: capacity overflow
");
      next_cap = next_cap * 2;
    }
    if (next_cap > I64_MAX / sizeof(TilStr)) TilPanicZ("Vec.append: allocation overflow
");
    self->data = (TilReAlloc(self->data, next_cap * sizeof(TilStr)))(TilStr *);
    self->cap = next_cap;
  }
  TilMemCpy(&self->data[self->count], other->data, other->count * sizeof(TilStr));
  self->count = needed;
  other->count = 0;
  Vec__Str_Delete(other, FALSE);
}

U0 Vec__Str_MoveTo(Vec__Str *src, Vec__Str *dest)
{
  Vec__Str_Delete(dest, FALSE);
  Vec__Str_Take(dest, src);
}

U0 Vec__Str_Truncate(Vec__Str *self, U64 n)
{
  if (n > self->count) TilPanicZ("Vec.truncate: out of bounds
");
  U64 i = n;
  while (i < self->count) {
    TilStrDelete(&self->data[i], FALSE);
    i++;
  }
  self->count = n;
}

U0 Vec__Str_RemoveAt(Vec__Str *self, U64 i, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->count) { *err_kind = 1; return; }
  TilStrDelete(&self->data[i], FALSE);
  U64 last = self->count - 1;
  if (i < last) TilMemMove(&self->data[i], &self->data[i+1], (last-i)*sizeof(TilStr));
  self->count = last;
  TilMemSet(&self->data[last], 0, sizeof(TilStr));
}

U0 Vec__Str_PushTake(Vec__Str *self, Vec__Str *src, U64 i)
{
  if (i >= src->count) TilPanicZ("Vec.push_take: out of bounds
");
  if (self->count == self->cap) {
    if (self->cap > I64_MAX/2) TilPanicZ("Vec.push_take: capacity overflow
");
    U64 next_cap = self->cap * 2;
    if (!next_cap) next_cap = 1;
    if (next_cap > I64_MAX/sizeof(TilStr)) TilPanicZ("Vec.push_take: allocation overflow
");
    self->data = (TilReAlloc(self->data, next_cap*sizeof(TilStr)))(TilStr *);
    self->cap = next_cap;
  }
  TilMemCpy(&self->data[self->count], &src->data[i], sizeof(TilStr));
  TilMemSet(&src->data[i], 0, sizeof(TilStr));
  self->count++;
}

U0 Vec__Str_TakePrefix(Vec__Str *out, Vec__Str *self, U64 n)
{
  if (n > self->count) TilPanicZ("Vec.take_prefix: out of bounds
");
  U64 cap = n;
  if (!cap) cap = 1;
  if (cap > I64_MAX/sizeof(TilStr)) TilPanicZ("Vec.take_prefix: allocation overflow
");
  out->data = (TilMAlloc(cap*sizeof(TilStr)))(TilStr *);
  out->count = n;
  out->cap = cap;
  if (n) TilMemCpy(out->data, self->data, n*sizeof(TilStr));
  U64 tail = self->count - n;
  if (tail) TilMemMove(self->data, &self->data[n], tail*sizeof(TilStr));
  if (n) TilMemSet(&self->data[tail], 0, n*sizeof(TilStr));
  self->count = tail;
}

U0 Vec__Str_DeleteMarked(Vec__Str *self, U8 *marks)
{
  U64 i = 0;
  while (i < self->count) {
    if (marks[i]) {
      TilStrDelete(&self->data[i], FALSE);
      TilMemSet(&self->data[i], 0, sizeof(TilStr));
    }
    i++;
  }
  U64 w = 0;
  U64 r = 0;
  while (r < self->count) {
    if (!marks[r]) {
      if (w != r) TilMemCpy(&self->data[w], &self->data[r], sizeof(TilStr));
      w++;
    }
    r++;
  }
  self->count = w;
}

Type Type_Literal_Unknown;
Type_Literal_Unknown.tag = 0;

Type Type_Literal_None;
Type_Literal_None.tag = 1;

Type Type_Literal_StructDef;
Type_Literal_StructDef.tag = 3;

Type Type_Literal_EnumDef;
Type_Literal_EnumDef.tag = 5;

Type Type_Literal_FuncDef;
Type_Literal_FuncDef.tag = 6;

Type Type_Literal_FuncPtr;
Type_Literal_FuncPtr.tag = 7;

Type Type_Literal_Dynamic;
Type_Literal_Dynamic.tag = 8;

Type Type_Literal_Body;
Type_Literal_Body.tag = 12;

U0 Type_CopyValue(Type *out, Type *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    return;
  }
  if (src->tag == 1) {
    return;
  }
  if (src->tag == 2) {
    TilStrCopyValue(&out->payload_Struct, &src->payload_Struct);
    return;
  }
  if (src->tag == 3) {
    return;
  }
  if (src->tag == 4) {
    TilStrCopyValue(&out->payload_Enum, &src->payload_Enum);
    return;
  }
  if (src->tag == 5) {
    return;
  }
  if (src->tag == 6) {
    return;
  }
  if (src->tag == 7) {
    return;
  }
  if (src->tag == 8) {
    return;
  }
  if (src->tag == 9) {
    TilStrCopyValue(&out->payload_Custom, &src->payload_Custom);
    return;
  }
  if (src->tag == 10) {
    out->payload_Primitive = src->payload_Primitive;
    return;
  }
  if (src->tag == 11) {
    TilStrCopyValue(&out->payload_FuncPtrSig, &src->payload_FuncPtrSig);
    return;
  }
  if (src->tag == 12) {
    return;
  }
  if (src->tag == 13) {
    out->payload_StructSym = src->payload_StructSym;
    return;
  }
  if (src->tag == 14) {
    out->payload_EnumSym = src->payload_EnumSym;
    return;
  }
  if (src->tag == 15) {
    out->payload_CustomSym = src->payload_CustomSym;
    return;
  }
  if (src->tag == 16) {
    out->payload_FuncPtrSigSym = src->payload_FuncPtrSigSym;
    return;
  }
  TilPanicZ("invalid Type tag");
}

U0 Type_Clone(Type *out, Type *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    return;
  }
  if (src->tag == 1) {
    return;
  }
  if (src->tag == 2) {
    TilStrClone(&out->payload_Struct, &src->payload_Struct);
    return;
  }
  if (src->tag == 3) {
    return;
  }
  if (src->tag == 4) {
    TilStrClone(&out->payload_Enum, &src->payload_Enum);
    return;
  }
  if (src->tag == 5) {
    return;
  }
  if (src->tag == 6) {
    return;
  }
  if (src->tag == 7) {
    return;
  }
  if (src->tag == 8) {
    return;
  }
  if (src->tag == 9) {
    TilStrClone(&out->payload_Custom, &src->payload_Custom);
    return;
  }
  if (src->tag == 10) {
    out->payload_Primitive = src->payload_Primitive;
    return;
  }
  if (src->tag == 11) {
    TilStrClone(&out->payload_FuncPtrSig, &src->payload_FuncPtrSig);
    return;
  }
  if (src->tag == 12) {
    return;
  }
  if (src->tag == 13) {
    out->payload_StructSym = src->payload_StructSym;
    return;
  }
  if (src->tag == 14) {
    out->payload_EnumSym = src->payload_EnumSym;
    return;
  }
  if (src->tag == 15) {
    out->payload_CustomSym = src->payload_CustomSym;
    return;
  }
  if (src->tag == 16) {
    out->payload_FuncPtrSigSym = src->payload_FuncPtrSigSym;
    return;
  }
  TilPanicZ("invalid Type tag");
}

U0 Type_Delete(Type *src, Bool call_free)
{
  if (src->tag == 0) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 1) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 2) {
    TilStrDelete(&src->payload_Struct, FALSE);
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 3) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 4) {
    TilStrDelete(&src->payload_Enum, FALSE);
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 5) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 6) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 7) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 8) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 9) {
    TilStrDelete(&src->payload_Custom, FALSE);
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 10) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 11) {
    TilStrDelete(&src->payload_FuncPtrSig, FALSE);
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 12) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 13) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 14) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 15) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 16) {
    if (call_free) TilFree(src);
    return;
  }
  TilPanicZ("invalid Type tag");
}

U0 StructPoint_Clone(StructPoint *out, StructPoint *src)
{
  out->x = src->x;
  out->y = src->y;
}

U0 StructPoint_Delete(StructPoint *self, Bool call_free)
{
  if (call_free) TilFree(self);
}

Bool StructPoint_Eq(StructPoint *a, StructPoint *b)
{
  if (!(a->x == b->x)) return FALSE;
  if (!(a->y == b->y)) return FALSE;
  return TRUE;
}

U0 StructNamedPoint_Clone(StructNamedPoint *out, StructNamedPoint *src)
{
  StructPoint_Clone(&out->point, &src->point);
  TilStrClone(&out->name, &src->name);
}

U0 StructNamedPoint_Delete(StructNamedPoint *self, Bool call_free)
{
  StructPoint_Delete(&self->point, FALSE);
  TilStrDelete(&self->name, FALSE);
  if (call_free) TilFree(self);
}

Bool StructNamedPoint_Eq(StructNamedPoint *a, StructNamedPoint *b)
{
  if (!StructPoint_Eq(&a->point, &b->point)) return FALSE;
  if (!TilStrEq(&a->name, &b->name)) return FALSE;
  return TRUE;
}

U0 PayloadRecord_Clone(PayloadRecord *out, PayloadRecord *src)
{
  out->number = src->number;
  TilStrClone(&out->name, &src->name);
}

U0 PayloadRecord_Delete(PayloadRecord *self, Bool call_free)
{
  TilStrDelete(&self->name, FALSE);
  if (call_free) TilFree(self);
}

Bool PayloadRecord_Eq(PayloadRecord *a, PayloadRecord *b)
{
  if (!(a->number == b->number)) return FALSE;
  if (!TilStrEq(&a->name, &b->name)) return FALSE;
  return TRUE;
}

U0 StructBorrowed_Clone(StructBorrowed *out, StructBorrowed *src)
{
  out->point = src->point;
  out->count = src->count;
  out->label = src->label;
}

U0 StructBorrowed_Delete(StructBorrowed *self, Bool call_free)
{
  if (call_free) TilFree(self);
}

Bool StructBorrowed_Eq(StructBorrowed *a, StructBorrowed *b)
{
  if (!StructPoint_Eq(a->point, b->point)) return FALSE;
  if (!((*((TilCheckPtr(a->count))(I64 *))) == (*((TilCheckPtr(b->count))(I64 *))))) return FALSE;
  if (!TilStrEq(a->label, b->label)) return FALSE;
  return TRUE;
}

U0 StructOwned_Clone(StructOwned *out, StructOwned *src)
{
  if (src->named) {
    out->named = (TilMAlloc(sizeof(StructNamedPoint)))(StructNamedPoint *);
    StructNamedPoint_Clone(out->named, src->named);
  } else {
    out->named = NULL;
  }
  if (src->label) {
    out->label = (TilMAlloc(sizeof(TilStr)))(TilStr *);
    TilStrClone(out->label, src->label);
  } else {
    out->label = NULL;
  }
}

U0 StructOwned_Delete(StructOwned *self, Bool call_free)
{
  if (self->named) StructNamedPoint_Delete(self->named, TRUE);
  if (self->label) TilStrDelete(self->label, TRUE);
