U0 Array__StructNamedPoint_Delete(Array__StructNamedPoint *self, Bool call_free)
{
  U64 i = 0;
  while (i < self->cap) {
    StructNamedPoint_Delete(&self->data[i], FALSE);
    i++;
  }
  TilFree(self->data);
  self->data = NULL;
  self->cap = 0;
  if (call_free) TilFree(self);
}

U0 Array__StructNamedPoint_Concat(Array__StructNamedPoint *out, Array__StructNamedPoint *a, Array__StructNamedPoint *b)
{
  if (b->cap > I64_MAX - a->cap) TilPanicZ("Array.concat: size overflow
");
  Array__StructNamedPoint_New(out, a->cap + b->cap);
  U64 i = 0;
  while (i < a->cap) {
    StructNamedPoint_Clone(&out->data[i], &a->data[i]);
    i++;
  }
  U64 j = 0;
  while (j < b->cap) {
    StructNamedPoint_Clone(&out->data[a->cap+j], &b->data[j]);
    j++;
  }
}

U0 Array__StructNamedPoint_ToVec(Vec__StructNamedPoint *out, Array__StructNamedPoint *src)
{
  Vec__StructNamedPoint_WithCapacity(out, src->cap);
  U64 i = 0;
  while (i < src->cap) {
    StructNamedPoint_Clone(&out->data[i], &src->data[i]);
    i++;
  }
  out->count = src->cap;
}

class Set__I64 {
  I64 *data;
  U64 count;
  U64 cap;
};

U0 Set__I64_CopyValue(Set__I64 *out, Set__I64 *src)
{
  out->data = src->data;
  out->count = src->count;
  out->cap = src->cap;
}

U0 Set__I64_New(Set__I64 *out)
{
  out->data = NULL;
  out->count = 0;
  out->cap = 0;
}

U0 Set__I64_WithCapacity(Set__I64 *out, U64 n)
{
  if (n > I64_MAX/sizeof(I64)) TilPanicZ("Set: allocation overflow\n");
  out->data = NULL;
  if (n) out->data = (TilMAlloc(n*sizeof(I64)))(I64 *);
  out->count = 0;
  out->cap = n;
}

U0 Set__I64_Clone(Set__I64 *out, Set__I64 *src)
{
  Set__I64_WithCapacity(out, src->cap);
  U64 i = 0;
  while (i < src->count) {
    out->data[i] = src->data[i];
    i++;
  }
  out->count = src->count;
}

U0 Set__I64_Clear(Set__I64 *self)
{
  U64 i = 0;
  while (i < self->count) {
    i++;
  }
  self->count = 0;
}

U0 Set__I64_Delete(Set__I64 *self, Bool call_free)
{
  Set__I64_Clear(self);
  TilFree(self->data);
  self->data = NULL;
  self->cap = 0;
  if (call_free) TilFree(self);
}

Bool Set__I64_Find(Set__I64 *self, I64 value, U64 *index)
{
  U64 lo = 0;
  U64 hi = self->count;
  while (lo < hi) {
    U64 mid = lo + (hi-lo)/2;
    I64 cmp = (self->data[mid] > value) - (self->data[mid] < value);
    if (cmp < 0) lo = mid+1;
    else if (cmp > 0) hi = mid;
    else { *index = mid; return TRUE; }
  }
  *index = lo;
  return FALSE;
}

Bool Set__I64_Has(Set__I64 *self, I64 value)
{
  U64 i;
  return Set__I64_Find(self, value, &i);
}

U0 Set__I64_Add(Set__I64 *self, I64 value)
{
  U64 i;
  if (Set__I64_Find(self, value, &i)) {
    return;
  }
  if (self->count == self->cap) {
    if (self->cap > I64_MAX/2) TilPanicZ("Set: capacity overflow\n");
    U64 cap = self->cap*2;
    if (!cap) cap = 1;
    if (cap > I64_MAX/sizeof(I64)) TilPanicZ("Set: allocation overflow\n");
    self->data = (TilReAlloc(self->data, cap*sizeof(I64)))(I64 *);
    self->cap = cap;
  }
  U64 tail = self->count-i;
  if (tail) TilMemMove(&self->data[i+1], &self->data[i], tail*sizeof(I64));
  self->data[i] = value;
  self->count++;
}

Bool Set__I64_Remove(Set__I64 *self, I64 value)
{
  U64 i;
  if (!Set__I64_Find(self, value, &i)) return FALSE;
  U64 last = self->count-1;
  if (i < last) TilMemMove(&self->data[i], &self->data[i+1], (last-i)*sizeof(I64));
  self->count = last;
  TilMemSet(&self->data[last], 0, sizeof(I64));
  return TRUE;
}

