U0 Vec__Dynamic_CopyValue(Vec__Dynamic *out, Vec__Dynamic *src)
{
  out->data = src->data;
  out->count = src->count;
  out->cap = src->cap;
}

U0 Vec__Dynamic_New(Vec__Dynamic *out)
{
  out->data = NULL;
  out->count = 0;
  out->cap = 0;
}

U0 Vec__Dynamic_WithCapacity(Vec__Dynamic *out, U64 cap)
{
  out->data = NULL;
  if (cap && cap > I64_MAX / sizeof(U8 *)) TilPanicZ("til: allocation size overflow
");
  if (cap) out->data = (TilMAlloc(cap * sizeof(U8 *)))(U8 * *);
  out->count = 0;
  out->cap = cap;
}

U0 Vec__Dynamic_Clone(Vec__Dynamic *out, Vec__Dynamic *src)
{
  out->data = (TilCAlloc(src->cap, sizeof(U8 *)))(U8 * *);
  out->count = src->count;
  out->cap = src->cap;
  U64 i = 0;
  while (i < src->count) {
    out->data[i] = src->data[i];
    i++;
  }
}

U8 * *Vec__Dynamic_UnsafeGet(Vec__Dynamic *self, U64 i)
{
  return &self->data[i];
}

U0 Vec__Dynamic_UnsafeSet(Vec__Dynamic *self, U64 i, U8 * value)
{
  self->data[i] = value;
}

U8 * *Vec__Dynamic_Get(Vec__Dynamic *self, U64 i, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->count) {
    *err_kind = 1;
    return NULL;
  }
  return Vec__Dynamic_UnsafeGet(self, i);
}

U0 Vec__Dynamic_Set(Vec__Dynamic *self, U64 i, U8 * value, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->count) {
    *err_kind = 1;
    return;
  }
  Vec__Dynamic_UnsafeSet(self, i, value);
}

U0 Vec__Dynamic_Push(Vec__Dynamic *self, U8 * value)
{
  if (self->count == self->cap) {
    if (self->cap > I64_MAX/2) TilPanicZ("Vec.push: capacity overflow
");
    U64 new_cap = self->cap * 2;
    if (!new_cap) new_cap = 1;
    if (new_cap > I64_MAX / sizeof(U8 *)) TilPanicZ("til: allocation size overflow
");
    self->data = (TilReAlloc(self->data, new_cap * sizeof(U8 *)))(U8 * *);
    self->cap = new_cap;
  }
  self->data[self->count] = value;
  self->count++;
}

U8 * Vec__Dynamic_Pop(Vec__Dynamic *self)
{
  if (!self->count) TilPanicZ("Vec.pop: empty vec
");
  self->count--;
  return self->data[self->count];
}

U0 Vec__Dynamic_Clear(Vec__Dynamic *self)
{
  self->count = 0;
}

U0 Vec__Dynamic_Delete(Vec__Dynamic *self, Bool call_free)
{
  Vec__Dynamic_Clear(self);
  TilFree(self->data);
  self->data = NULL;
  self->cap = 0;
  self->count = 0;
  if (call_free) TilFree(self);
}

U0 Vec__Dynamic_Take(Vec__Dynamic *out, Vec__Dynamic *self)
{
  Vec__Dynamic_CopyValue(out, self);
  self->data = NULL;
  self->count = 0;
  self->cap = 0;
}

U0 Vec__Dynamic_Append(Vec__Dynamic *self, Vec__Dynamic *other)
{
  if (!other->count) {
    Vec__Dynamic_Delete(other, FALSE);
    return;
  }
  if (other->count > I64_MAX - self->count) TilPanicZ("Vec.append: size overflow
");
  U64 needed = self->count + other->count;
  if (needed > self->cap) {
    U64 next_cap = self->cap;
    if (!next_cap) next_cap = 1;
    while (next_cap < needed) {
      if (next_cap > I64_MAX / 2) TilPanicZ("Vec.append: capacity overflow
");
      next_cap = next_cap * 2;
    }
    if (next_cap > I64_MAX / sizeof(U8 *)) TilPanicZ("Vec.append: allocation overflow
");
    self->data = (TilReAlloc(self->data, next_cap * sizeof(U8 *)))(U8 * *);
    self->cap = next_cap;
  }
  TilMemCpy(&self->data[self->count], other->data, other->count * sizeof(U8 *));
  self->count = needed;
  other->count = 0;
  Vec__Dynamic_Delete(other, FALSE);
}

U0 Vec__Dynamic_MoveTo(Vec__Dynamic *src, Vec__Dynamic *dest)
{
  Vec__Dynamic_Delete(dest, FALSE);
  Vec__Dynamic_Take(dest, src);
}

U0 Vec__Dynamic_Truncate(Vec__Dynamic *self, U64 n)
{
  if (n > self->count) TilPanicZ("Vec.truncate: out of bounds
");
  U64 i = n;
  while (i < self->count) {
    i++;
  }
  self->count = n;
}

U0 Vec__Dynamic_RemoveAt(Vec__Dynamic *self, U64 i, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->count) { *err_kind = 1; return; }
  U64 last = self->count - 1;
  if (i < last) TilMemMove(&self->data[i], &self->data[i+1], (last-i)*sizeof(U8 *));
  self->count = last;
  TilMemSet(&self->data[last], 0, sizeof(U8 *));
}

U0 Vec__Dynamic_PushTake(Vec__Dynamic *self, Vec__Dynamic *src, U64 i)
{
  if (i >= src->count) TilPanicZ("Vec.push_take: out of bounds
");
  if (self->count == self->cap) {
    if (self->cap > I64_MAX/2) TilPanicZ("Vec.push_take: capacity overflow
");
    U64 next_cap = self->cap * 2;
    if (!next_cap) next_cap = 1;
    if (next_cap > I64_MAX/sizeof(U8 *)) TilPanicZ("Vec.push_take: allocation overflow
");
    self->data = (TilReAlloc(self->data, next_cap*sizeof(U8 *)))(U8 * *);
    self->cap = next_cap;
  }
  self->data[self->count] = src->data[i];
  src->data[i] = 0;
  self->count++;
}

U0 Vec__Dynamic_TakePrefix(Vec__Dynamic *out, Vec__Dynamic *self, U64 n)
{
  if (n > self->count) TilPanicZ("Vec.take_prefix: out of bounds
");
  U64 cap = n;
  if (!cap) cap = 1;
  if (cap > I64_MAX/sizeof(U8 *)) TilPanicZ("Vec.take_prefix: allocation overflow
");
  out->data = (TilMAlloc(cap*sizeof(U8 *)))(U8 * *);
  out->count = n;
  out->cap = cap;
  if (n) TilMemCpy(out->data, self->data, n*sizeof(U8 *));
  U64 tail = self->count - n;
  if (tail) TilMemMove(self->data, &self->data[n], tail*sizeof(U8 *));
  if (n) TilMemSet(&self->data[tail], 0, n*sizeof(U8 *));
  self->count = tail;
}

U0 Vec__Dynamic_DeleteMarked(Vec__Dynamic *self, U8 *marks)
{
  U64 i = 0;
  while (i < self->count) {
    if (marks[i]) {
      TilMemSet(&self->data[i], 0, sizeof(U8 *));
    }
    i++;
  }
  U64 w = 0;
  U64 r = 0;
  while (r < self->count) {
    if (!marks[r]) {
      if (w != r) TilMemCpy(&self->data[w], &self->data[r], sizeof(U8 *));
      w++;
    }
    r++;
  }
  self->count = w;
}

