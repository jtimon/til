Bool Set__I64_Find(Set__I64 *self, I64 value, U64 *index)
{
  U64 lo = 0;
  U64 hi = self->count;
  while (lo < hi) {
    U64 mid = lo + (hi-lo)/2;
    I64 cmp = (self->data[mid] > value) - (self->data[mid] < value);
    if (cmp < 0) lo = mid+1;
    else if (cmp > 0) hi = mid;
    else { *index = mid; return TRUE; }
  }
  *index = lo;
  return FALSE;
}

Bool Set__I64_Has(Set__I64 *self, I64 value)
{
  U64 i;
  return Set__I64_Find(self, value, &i);
}

U0 Set__I64_Add(Set__I64 *self, I64 value)
{
  U64 i;
  if (Set__I64_Find(self, value, &i)) {
    return;
  }
  if (self->count == self->cap) {
    if (self->cap > I64_MAX/2) TilPanicZ("Set: capacity overflow\n");
    U64 cap = self->cap*2;
    if (!cap) cap = 1;
    if (cap > I64_MAX/sizeof(I64)) TilPanicZ("Set: allocation overflow\n");
    self->data = (TilReAlloc(self->data, cap*sizeof(I64)))(I64 *);
    self->cap = cap;
  }
  U64 tail = self->count-i;
  if (tail) TilMemMove(&self->data[i+1], &self->data[i], tail*sizeof(I64));
  self->data[i] = value;
  self->count++;
}

Bool Set__I64_Remove(Set__I64 *self, I64 value)
{
  U64 i;
  if (!Set__I64_Find(self, value, &i)) return FALSE;
  U64 last = self->count-1;
  if (i < last) TilMemMove(&self->data[i], &self->data[i+1], (last-i)*sizeof(I64));
  self->count = last;
  TilMemSet(&self->data[last], 0, sizeof(I64));
  return TRUE;
}

