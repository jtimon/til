U0 StructSegment_Clone(StructSegment *out, StructSegment *src)
{
  StructPoint_Clone(&out->start, &src->start);
  StructPoint_Clone(&out->finish, &src->finish);
  out->active = src->active;
}

U0 StructSegment_Delete(StructSegment *self, Bool call_free)
{
  StructPoint_Delete(&self->start, FALSE);
  StructPoint_Delete(&self->finish, FALSE);
  if (call_free) TilFree(self);
}

Bool StructSegment_Eq(StructSegment *a, StructSegment *b)
{
  if (!StructPoint_Eq(&a->start, &b->start)) return FALSE;
  if (!StructPoint_Eq(&a->finish, &b->finish)) return FALSE;
  if (!(a->active == b->active)) return FALSE;
  return TRUE;
}

PayloadValue PayloadValue_Literal_Empty;
PayloadValue_Literal_Empty.tag = 0;

U0 PayloadValue_CopyValue(PayloadValue *out, PayloadValue *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    return;
  }
  if (src->tag == 1) {
    out->payload_Byte = src->payload_Byte;
    return;
  }
  if (src->tag == 2) {
    out->payload_Count = src->payload_Count;
    return;
  }
  if (src->tag == 3) {
    TilStrCopyValue(&out->payload_Text, &src->payload_Text);
    return;
  }
  if (src->tag == 4) {
    out->payload_Record.number = src->payload_Record.number;
    TilStrCopyValue(&out->payload_Record.name, &src->payload_Record.name);
    return;
  }
  TilPanicZ("invalid PayloadValue tag");
}

U0 PayloadValue_Clone(PayloadValue *out, PayloadValue *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    return;
  }
  if (src->tag == 1) {
    out->payload_Byte = src->payload_Byte;
    return;
  }
  if (src->tag == 2) {
    out->payload_Count = src->payload_Count;
    return;
  }
  if (src->tag == 3) {
    TilStrClone(&out->payload_Text, &src->payload_Text);
    return;
  }
  if (src->tag == 4) {
    PayloadRecord_Clone(&out->payload_Record, &src->payload_Record);
    return;
  }
  TilPanicZ("invalid PayloadValue tag");
}

U0 PayloadValue_Delete(PayloadValue *src, Bool call_free)
{
  if (src->tag == 0) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 1) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 2) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 3) {
    TilStrDelete(&src->payload_Text, FALSE);
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 4) {
    PayloadRecord_Delete(&src->payload_Record, FALSE);
    if (call_free) TilFree(src);
    return;
  }
  TilPanicZ("invalid PayloadValue tag");
}

Bool PayloadValue_Eq(PayloadValue *a, PayloadValue *b)
{
  if (a->tag != b->tag) return FALSE;
  if (a->tag == 0) {
    return TRUE;
  }
  if (a->tag == 1) {
    return a->payload_Byte == b->payload_Byte;
  }
  if (a->tag == 2) {
    return a->payload_Count == b->payload_Count;
  }
  if (a->tag == 3) {
    return TilStrEq(&a->payload_Text, &b->payload_Text);
  }
  if (a->tag == 4) {
    return PayloadRecord_Eq(&a->payload_Record, &b->payload_Record);
  }
  TilPanicZ("invalid PayloadValue tag");
  return FALSE;
}

U0 StructForwardRef_Clone(StructForwardRef *out, StructForwardRef *src)
{
  out->point = src->point;
}

U0 StructForwardRef_Delete(StructForwardRef *self, Bool call_free)
{
  if (call_free) TilFree(self);
}

U0 Vec__PayloadValue_CopyValue(Vec__PayloadValue *out, Vec__PayloadValue *src)
{
  out->data = src->data;
  out->count = src->count;
  out->cap = src->cap;
}

U0 Vec__PayloadValue_New(Vec__PayloadValue *out)
{
  out->data = NULL;
  out->count = 0;
  out->cap = 0;
}

U0 Vec__PayloadValue_WithCapacity(Vec__PayloadValue *out, U64 cap)
{
  out->data = NULL;
  if (cap && cap > I64_MAX / sizeof(PayloadValue)) TilPanicZ("til: allocation size overflow
");
  if (cap) out->data = (TilMAlloc(cap * sizeof(PayloadValue)))(PayloadValue *);
  out->count = 0;
  out->cap = cap;
}

U0 Vec__PayloadValue_Clone(Vec__PayloadValue *out, Vec__PayloadValue *src)
{
  out->data = (TilCAlloc(src->cap, sizeof(PayloadValue)))(PayloadValue *);
  out->count = src->count;
  out->cap = src->cap;
  U64 i = 0;
  while (i < src->count) {
    PayloadValue_Clone(&out->data[i], &src->data[i]);
    i++;
  }
}

PayloadValue *Vec__PayloadValue_UnsafeGet(Vec__PayloadValue *self, U64 i)
{
  return &self->data[i];
}

U0 Vec__PayloadValue_UnsafeSet(Vec__PayloadValue *self, U64 i, PayloadValue *value)
{
  PayloadValue_Delete(&self->data[i], FALSE);
  TilMemCpy(&self->data[i], value, sizeof(PayloadValue));
  TilMemSet(value, 0, sizeof(PayloadValue));
}

PayloadValue *Vec__PayloadValue_Get(Vec__PayloadValue *self, U64 i, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->count) {
    *err_kind = 1;
    return NULL;
  }
  return Vec__PayloadValue_UnsafeGet(self, i);
}

U0 Vec__PayloadValue_Set(Vec__PayloadValue *self, U64 i, PayloadValue *value, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->count) {
    *err_kind = 1;
    return;
  }
  Vec__PayloadValue_UnsafeSet(self, i, value);
}

U0 Vec__PayloadValue_Push(Vec__PayloadValue *self, PayloadValue *value)
{
  if (self->count == self->cap) {
    if (self->cap > I64_MAX/2) TilPanicZ("Vec.push: capacity overflow
");
    U64 new_cap = self->cap * 2;
    if (!new_cap) new_cap = 1;
    if (new_cap > I64_MAX / sizeof(PayloadValue)) TilPanicZ("til: allocation size overflow
");
    self->data = (TilReAlloc(self->data, new_cap * sizeof(PayloadValue)))(PayloadValue *);
    self->cap = new_cap;
  }
  TilMemCpy(&self->data[self->count], value, sizeof(PayloadValue));
  TilMemSet(value, 0, sizeof(PayloadValue));
  self->count++;
}

U0 Vec__PayloadValue_Pop(PayloadValue *out, Vec__PayloadValue *self)
{
  if (!self->count) TilPanicZ("Vec.pop: empty vec
");
  self->count--;
  TilMemCpy(out, &self->data[self->count], sizeof(PayloadValue));
  TilMemSet(&self->data[self->count], 0, sizeof(PayloadValue));
}

U0 Vec__PayloadValue_Clear(Vec__PayloadValue *self)
{
  U64 i = 0;
  while (i < self->count) {
    PayloadValue_Delete(&self->data[i], FALSE);
    i++;
  }
  self->count = 0;
}

U0 Vec__PayloadValue_Delete(Vec__PayloadValue *self, Bool call_free)
{
  Vec__PayloadValue_Clear(self);
  TilFree(self->data);
  self->data = NULL;
  self->cap = 0;
  self->count = 0;
  if (call_free) TilFree(self);
}

U0 Vec__PayloadValue_Take(Vec__PayloadValue *out, Vec__PayloadValue *self)
{
  Vec__PayloadValue_CopyValue(out, self);
  self->data = NULL;
  self->count = 0;
