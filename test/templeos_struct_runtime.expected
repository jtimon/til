    if (index==6) { TilStrInitLit(out,"U64",3); return; }
    if (index==7) { TilStrInitLit(out,"I64",3); return; }
    if (index==8) { TilStrInitLit(out,"F32",3); return; }
    if (index==9) { TilStrInitLit(out,"Bool",4); return; }
    if (index==10) { TilStrInitLit(out,"F64",3); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"ReverseTag")) {
    if (index==0) { TilStrInitLit(out,"First",5); return; }
    if (index==1) { TilStrInitLit(out,"Second",6); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"Signal")) {
    if (index==0) { TilStrInitLit(out,"Cold",4); return; }
    if (index==1) { TilStrInitLit(out,"Warm",4); return; }
    if (index==2) { TilStrInitLit(out,"Hot",3); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"SmallSignal")) {
    if (index==0) { TilStrInitLit(out,"Low",3); return; }
    if (index==1) { TilStrInitLit(out,"High",4); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"StructBorrowTag")) {
    if (index==0) { TilStrInitLit(out,"Empty",5); return; }
    if (index==1) { TilStrInitLit(out,"Borrowed",8); return; }
    if (index==2) { TilStrInitLit(out,"Number",6); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"Type")) {
    if (index==0) { TilStrInitLit(out,"Unknown",7); return; }
    if (index==1) { TilStrInitLit(out,"None",4); return; }
    if (index==2) { TilStrInitLit(out,"Struct",6); return; }
    if (index==3) { TilStrInitLit(out,"StructDef",9); return; }
