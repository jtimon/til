U0 Type_CopyValue(Type *out, Type *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    return;
  }
  if (src->tag == 1) {
    return;
  }
  if (src->tag == 2) {
    TilStrCopyValue(&out->payload_Struct, &src->payload_Struct);
    return;
  }
  if (src->tag == 3) {
    return;
  }
  if (src->tag == 4) {
    TilStrCopyValue(&out->payload_Enum, &src->payload_Enum);
    return;
  }
  if (src->tag == 5) {
    return;
  }
  if (src->tag == 6) {
    return;
  }
  if (src->tag == 7) {
    return;
  }
  if (src->tag == 8) {
