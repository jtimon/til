class StructBorrowed {
  StructPoint * point;
  I64 * count;
  TilStr * label;
};

U0 StructBorrowed_Clone(StructBorrowed *out, StructBorrowed *src)
{
  out->point = src->point;
  out->count = src->count;
  out->label = src->label;
}

U0 StructBorrowed_Delete(StructBorrowed *self, Bool call_free)
{
  if (call_free) TilFree(self);
}

Bool StructBorrowed_Eq(StructBorrowed *a, StructBorrowed *b)
{
  if (!StructPoint_Eq(a->point, b->point)) return FALSE;
  if (!((*((TilCheckPtr(a->count))(I64 *))) == (*((TilCheckPtr(b->count))(I64 *))))) return FALSE;
  if (!TilStrEq(a->label, b->label)) return FALSE;
  return TRUE;
}

class StructOwned {
  StructNamedPoint * named;
  TilStr * label;
};

U0 StructOwned_Clone(StructOwned *out, StructOwned *src)
{
  if (src->named) {
    out->named = (TilMAlloc(sizeof(StructNamedPoint)))(StructNamedPoint *);
    StructNamedPoint_Clone(out->named, src->named);
  } else {
    out->named = NULL;
  }
  if (src->label) {
    out->label = (TilMAlloc(sizeof(TilStr)))(TilStr *);
    TilStrClone(out->label, src->label);
  } else {
    out->label = NULL;
  }
}

U0 StructOwned_Delete(StructOwned *self, Bool call_free)
{
  if (self->named) StructNamedPoint_Delete(self->named, TRUE);
  if (self->label) TilStrDelete(self->label, TRUE);
  if (call_free) TilFree(self);
}

