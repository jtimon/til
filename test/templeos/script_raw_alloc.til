mode script

// Regression: a PROGRAM-SCOPE raw-allocator decl (`buf : U8 = malloc(n)`)
// must give the global pointer storage, exactly like the same declaration
// inside a function (#302's raw_alloc form). It used to be emitted as a
// VALUE global: the initializer allocated the block, copied one
// indeterminate byte out of it into the global, freed it again, and every
// later memset / ptr_add then wrote past a one-byte object -- ASAN reports
// a global-buffer-overflow (WRITE of size n into a global of size 1), and
// without ASAN it silently corrupts whatever follows in BSS.

n : USize = 4
buf : U8 = malloc(n)
memset(buf, 0, n)
memcpy(buf, 65, 1)
off : UPtr = 1
memcpy(ptr_add(buf, off), 66, 1)
ref a : U8 = ptr_add(buf, 0)
ref b : U8 = ptr_add(buf, off)
println(a.to_i64().to_str())
println(b.to_i64().to_str())
free(own buf)

// A scalar RHS writes a typed allocation's pointee; its bit pattern is
// never an allocation address. Cover words, borrowed RHSs, and call results.
mut assigned_f32 : F32 = malloc(4)
assigned_f32 = -1.5
assigned_f32 = assigned_f32.add(0.25)
if assigned_f32.eq(-1.25) { println("raw f32 assignment") }
free(own assigned_f32)
mut assigned_f64 : F64 = malloc(8)
mut source_f64 : F64 = -2.5
assigned_f64 = source_f64
assigned_f64 = assigned_f64.mul(2.0)
if assigned_f64.eq(-5.0) { println("raw f64 assignment") }
free(own assigned_f64)
mut assigned_i64 : I64 = malloc(8)
assigned_i64 = 123
println(assigned_i64.to_str())
free(own assigned_i64)

raw_alloc_local := func() returns Bool {
    mut local : F32 = malloc(4)
    local = -1.5
    result := local.eq(-1.5)
    free(own local)
    return result
}
if raw_alloc_local() { println("raw local assignment") }
