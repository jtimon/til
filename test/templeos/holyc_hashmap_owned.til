mode cli
import("../../src/std/hashmap")

Callback := func(I64) returns I64
DropCount := struct { closed : I64 = 0; created : I64 = 0 }
Resource := struct {
    text: Str
    ref count: DropCount
namespace:
    delete := func(own self: Resource, call_free: Bool = true) {
        self.count.closed++
        own self.text.delete(false)
        if call_free { free(own self) }
    }
}
make_callback := func(mut count: DropCount, label: Str) returns Callback {
    count.created++
    resource := Resource(text = label.clone(), count = count)
    return func(value: I64) returns I64 [own resource] { return value + resource.text.len().to_i64() }
}
Items := struct { words: Vec(Str) }
Payload := enum { Empty, Text: Str, Items: Items, Run: Callback }
AliasPayload := enum { Empty, Count: USize, Address: UPtr }

check_alias_payloads := func() {
    mut values := HashMap(I64, AliasPayload).new()
    values.set(1, own AliasPayload.Count(USize.MAX))
    values.set(2, own AliasPayload.Address(UPtr.MAX))
    snapshot := values.clone()
    values.clear()
    ref count : AliasPayload = snapshot.get(1)!
    switch count {
    case .Count(value): if value != USize.MAX { panic("HashMap USize payload width") }
    case: panic("HashMap USize payload tag")
    }
    ref address : AliasPayload = snapshot.get(2)!
    switch address {
    case .Address(value): if value != UPtr.MAX { panic("HashMap UPtr payload width") }
    case: panic("HashMap UPtr payload tag")
    }
}

check_nested_vectors := func() {
    mut values := HashMap(I64, Vec(Str)).new()
    for i in 0..32 {
        mut words := Vec(Str).new()
        words.push(own format("item", i.to_str()))
        words.push(own format("tail", i.to_str()))
        values.set(i, own words)
    }
    mut snapshot := values.clone()
    for i in 0..32 {
        mut replacement := Vec(Str).new()
        replacement.push(own format("new", i.to_str()))
        values.set(i, own replacement)
    }
    for i in 0..32 {
        ref original : Vec(Str) = snapshot.get(i)!
        ref current : Vec(Str) = values.get(i)!
        if original.len() != 2 || original.get(0)! != format("item", i.to_str()) || current.len() != 1 || current.get(0)! != format("new", i.to_str()) {
            panic("nested HashMap vector clone/replacement")
        }
    }
    for i in 0..16 { if values.remove(i).not() { panic("nested HashMap vector removal") } }
    values.clear()
    snapshot.clear()
    mut final_words := Vec(Str).new()
    final_words.push(own format("reused"))
    values.set(99, own final_words)
    if values.get(99)!.get(0)! != "reused" { panic("nested HashMap vector reuse") }
}

check_callbacks := func() {
    mut count := DropCount()
    {
        mut callbacks := HashMap(I64, Callback).new()
        callbacks.set(1, own make_callback(count, "first"))
        callbacks.set(2, own make_callback(count, "second"))
        ref first : Callback = callbacks.get(1)!
        if first(10) != 15 { panic("HashMap stored callback") }
        mut snapshot := callbacks.clone()
        callbacks.set(1, own make_callback(count, "replacement"))
        if count.closed != 1 { panic("HashMap callback replacement cleanup") }
        ref old : Callback = snapshot.get(1)!
        ref replacement : Callback = callbacks.get(1)!
        if memcmp(old, to_ptr(old), Callback.size().to_uptr()) != 0 { panic("HashMap callable storage address") }
        if old(10) != 15 || replacement(10) != 21 { panic("HashMap callback deep clone") }
        if callbacks.remove(2).not() || count.closed != 2 { panic("HashMap callback removal cleanup") }
        callbacks.clear()
        if count.closed != 3 { panic("HashMap callback clear cleanup") }
        {
            ref original : Callback = snapshot.get(1)!
            ref slot : Dynamic = to_ptr(original)
            restored : Callback = Callback.clone(slot)
            if restored(10) != 15 { panic("HashMap callback slot clone") }
            Callback.delete(own restored, false)
            again : Callback = Callback.clone(slot)
            if again(10) != 15 { panic("HashMap callback second slot clone") }
            Callback.delete(own again)
        }
        if count.closed != 5 { panic("HashMap callback slot clone cleanup") }
        snapshot.clear()
        if count.closed != 7 { panic("HashMap callback clone cleanup") }
    }
    if count.closed != 7 || count.created != 3 { panic("HashMap callback double cleanup") }
}

check_payloads := func() {
    mut count := DropCount()
    {
        mut values := HashMap(Str, Payload).new()
        values.set("empty", own Payload.Empty)
        values.set("text", own Payload.Text(format("payload text")))
        mut words := Vec(Str).new()
        words.push(own format("payload item"))
        values.set("items", own Payload.Items(Items(words = words)))
        values.set("run", own Payload.Run(make_callback(count, "enum")))
        if count.closed != 1 { panic("HashMap enum constructor temporary cleanup") }
        mut snapshot := values.clone()
        values.set("text", own Payload.Text(format("replaced text")))
        if values.remove("run").not() || count.closed != 2 { panic("HashMap enum callback removal") }
        ref original_text : Payload = snapshot.get("text")!
        switch original_text {
        case .Text(text): if text != "payload text" { panic("HashMap enum text clone") }
        case: panic("HashMap enum text tag")
        }
        ref original_items : Payload = snapshot.get("items")!
        switch original_items {
        case .Items(items): if items.words.get(0)! != "payload item" { panic("HashMap enum nested clone") }
        case: panic("HashMap enum nested tag")
        }
        ref original_run : Payload = snapshot.get("run")!
        switch original_run {
        case .Run(callback): if callback(10) != 14 { panic("HashMap enum callback clone") }
        case: panic("HashMap enum callback tag")
        }
        values.clear()
        if count.closed != 2 { panic("HashMap enum duplicate callback cleanup") }
        snapshot.clear()
        if count.closed != 3 { panic("HashMap enum clone cleanup") }
    }
    if count.closed != 3 || count.created != 1 { panic("HashMap enum double cleanup") }
}

main := proc() {
    check_alias_payloads()
    check_nested_vectors()
    check_callbacks()
    check_payloads()
    println("HolyC owned HashMap values passed")
}
