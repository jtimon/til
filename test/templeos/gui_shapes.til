mode gui

same_color := func(a: Color, b: Color) returns Bool {
    return a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a
}
check_gray := func(color: Color) {
    if color.r != color.g || color.r != color.b || color.r == 0 || color.r == 255 { panic("GUI alpha blending") }
}
check_glyph := func(image: Image, x: I32, y: I32, size: I64) {
    mut ink := 0
    for gy in 0..size {
        for gx in 0..size {
            pixel := GetImageColor(image, x + gx.to_i32(), y + gy.to_i32())
            if pixel.r > 0 { ink++ }
        }
    }
    if ink == 0 || ink == size * size { panic("GUI fractional font scale") }
}
main := proc() {
    init_window(640, 480, "GUI shape acceptance")
    SetTargetFPS(30)
    black := Color(r=0, g=0, b=0, a=255)
    blue := Color(r=0, g=0, b=170, a=255)
    red := Color(r=170, g=0, b=0, a=255)
    white := Color(r=255, g=255, b=255, a=255)
    BeginDrawing()
    ClearBackground(black)
    DrawRectangle(20, 20, 80, 80, blue)
    DrawRectangle(30, 30, 20, 20, Color(r=255, g=255, b=255, a=0))
    DrawRectangle(340, 20, 20, 20, Color(r=255, g=255, b=255, a=128))
    DrawCircle(140, 100, 20, Color(r=255, g=255, b=255, a=128))
    BeginScissorMode(120, 90, 15, 20)
    DrawCircle(140, 100, 20, red)
    EndScissorMode()
    DrawCircle(260, 100, 10.5, white)
    DrawText("X".c_str, 200, 200, 20, white)
    DrawText("X".c_str, 240, 200, 14, white)
    EndDrawing()
    image := LoadImageFromScreen()
    if same_color(GetImageColor(image, 40, 40), blue).not() { panic("GUI transparent rectangle") }
    check_gray(GetImageColor(image, 350, 30))
    check_gray(GetImageColor(image, 145, 100))
    if same_color(GetImageColor(image, 130, 100), red).not() { panic("GUI circle scissor") }
    if same_color(GetImageColor(image, 260, 100), white).not() || same_color(GetImageColor(image, 272, 100), black).not() { panic("GUI circle bounds") }
    check_glyph(image, 200, 200, 20)
    check_glyph(image, 240, 200, 14)
    UnloadImage(image)
    CloseWindow()
    println("GUI shapes passed")
}
