  if (TilStrNameEq(name,"CallableOwnedDeleter")) return sizeof(TilClosure *);
  if (TilStrNameEq(name,"CallableRefGetter")) return sizeof(TilClosure *);
  if (TilStrNameEq(name,"CallableReplacer")) return sizeof(TilClosure *);
