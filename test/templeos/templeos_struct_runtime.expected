  if (TilStrNameEq(name,"Map__Str_I64")) return sizeof(Map__Str_I64);
  if (TilStrNameEq(name,"MediumSignal")) return sizeof(U32);
  if (TilStrNameEq(name,"OrderedKey")) return sizeof(OrderedKey);
  if (TilStrNameEq(name,"OrderedNestedKey")) return sizeof(OrderedNestedKey);
  if (TilStrNameEq(name,"OrderedPayload")) return sizeof(OrderedPayload);
  if (TilStrNameEq(name,"OrderedTag")) return sizeof(U16);
  if (TilStrNameEq(name,"OwnType")) return sizeof(U8);
