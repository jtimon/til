  return Map__ReverseTag_I64_Find(self, value, &i);
}

I64 *Map__ReverseTag_I64_Get(Map__ReverseTag_I64 *self, U16 value, I64 *err_kind)
{
  U64 i;
  *err_kind = 0;
  if (Map__ReverseTag_I64_Find(self, value, &i)) return &((self->values.data)(I64 *))[i];
  *err_kind = 4;
  return NULL;
}

U0 Map__ReverseTag_I64_Set(Map__ReverseTag_I64 *self, U16 value, I64 val)
{
  U64 i;
  if (Map__ReverseTag_I64_Find(self, value, &i)) {
    ((self->values.data)(I64 *))[i] = val;
    return;
  }
  if (self->keys.count == self->keys.cap) {
    if (self->keys.cap > I64_MAX/2) TilPanicZ("Map: capacity overflow\n");
    U64 cap = self->keys.cap*2;
    if (!cap) cap = 1;
    if (cap > I64_MAX/sizeof(U16) || cap > I64_MAX/sizeof(I64)) TilPanicZ("Map: allocation overflow\n");
    self->keys.data = (TilReAlloc(self->keys.data, cap*sizeof(U16)))(U16 *);
    self->values.data = (TilReAlloc(self->values.data, cap*sizeof(I64)))(I64 *);
    self->keys.cap = cap;
    self->values.cap = cap;
  }
  U64 tail = self->keys.count-i;
  if (tail) {
    TilMemMove(&((self->keys.data)(U16 *))[i+1], &((self->keys.data)(U16 *))[i], tail*sizeof(U16));
    TilMemMove(&((self->values.data)(I64 *))[i+1], &((self->values.data)(I64 *))[i], tail*sizeof(I64));
  }
  ((self->keys.data)(U16 *))[i] = value;
  ((self->values.data)(I64 *))[i] = val;
  self->keys.count++;
  self->values.count++;
}

Bool Map__ReverseTag_I64_Remove(Map__ReverseTag_I64 *self, U16 value)
{
  U64 i;
  if (!Map__ReverseTag_I64_Find(self, value, &i)) return FALSE;
  I64 err_kind = 0;
  Vec__ReverseTag_RemoveAt(&self->keys, i, &err_kind);
  Vec__I64_RemoveAt(&self->values, i, &err_kind);
  return TRUE;
}

