U0 Vec__Str_TakePrefix(Vec__Str *out, Vec__Str *self, U64 n)
{
  if (n > self->count) TilPanicZ("Vec.take_prefix: out of bounds
");
  U64 cap = n;
  if (!cap) cap = 1;
  if (cap > I64_MAX/sizeof(TilStr)) TilPanicZ("Vec.take_prefix: allocation overflow
");
  out->data = (TilMAlloc(cap*sizeof(TilStr)))(TilStr *);
  out->count = n;
  out->cap = cap;
  if (n) TilMemCpy(out->data, self->data, n*sizeof(TilStr));
  U64 tail = self->count - n;
  if (tail) TilMemMove(self->data, &((self->data)(TilStr *))[n], tail*sizeof(TilStr));
  if (n) TilMemSet(&((self->data)(TilStr *))[tail], 0, n*sizeof(TilStr));
  self->count = tail;
}

U0 Vec__Str_DeleteMarked(Vec__Str *self, U8 *marks)
{
  U64 i = 0;
  while (i < self->count) {
    if (marks[i]) {
      TilStrDelete(&((self->data)(TilStr *))[i], FALSE);
      TilMemSet(&((self->data)(TilStr *))[i], 0, sizeof(TilStr));
    }
    i++;
  }
  U64 w = 0;
  U64 r = 0;
  while (r < self->count) {
    if (!marks[r]) {
      if (w != r) TilMemCpy(&((self->data)(TilStr *))[w], &((self->data)(TilStr *))[r], sizeof(TilStr));
      w++;
    }
    r++;
  }
  self->count = w;
}

