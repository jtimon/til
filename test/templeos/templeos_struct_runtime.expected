Bool Type_Eq(Type *a, Type *b)
{
  if (a->tag != b->tag) return FALSE;
  if (a->tag == 0) {
    return TRUE;
  }
  if (a->tag == 1) {
    return TRUE;
  }
  if (a->tag == 2) {
    return TilStrEq(&a->payload_Struct, &b->payload_Struct);
  }
  if (a->tag == 3) {
    return TRUE;
  }
  if (a->tag == 4) {
    return TilStrEq(&a->payload_Enum, &b->payload_Enum);
  }
  if (a->tag == 5) {
    return TRUE;
  }
  if (a->tag == 6) {
    return TRUE;
  }
  if (a->tag == 7) {
    return TRUE;
  }
  if (a->tag == 8) {
    return TRUE;
  }
  if (a->tag == 9) {
    return TilStrEq(&a->payload_Custom, &b->payload_Custom);
  }
  if (a->tag == 10) {
    return a->payload_Primitive == b->payload_Primitive;
  }
  if (a->tag == 11) {
    return TilStrEq(&a->payload_FuncPtrSig, &b->payload_FuncPtrSig);
  }
  if (a->tag == 12) {
    return TRUE;
  }
  if (a->tag == 13) {
    return a->payload_StructSym == b->payload_StructSym;
  }
  if (a->tag == 14) {
    return a->payload_EnumSym == b->payload_EnumSym;
  }
  if (a->tag == 15) {
    return a->payload_CustomSym == b->payload_CustomSym;
  }
  if (a->tag == 16) {
    return a->payload_FuncPtrSigSym == b->payload_FuncPtrSigSym;
  }
  TilPanicZ("invalid Type tag");
  return FALSE;
}

