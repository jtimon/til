{
  out->data = (TilCAlloc(cap, sizeof(I64)))(I64 *);
  out->cap = cap;
}

U0 Array__I64_Clone(Array__I64 *out, Array__I64 *src)
{
  out->data = (TilCAlloc(src->cap, sizeof(I64)))(I64 *);
  out->cap = src->cap;
  U64 i = 0;
  while (i < src->cap) {
    ((out->data)(I64 *))[i] = ((src->data)(I64 *))[i];
    i++;
  }
}

I64 *Array__I64_UnsafeGet(Array__I64 *self, U64 i)
{
  return &((self->data)(I64 *))[i];
}

U0 Array__I64_UnsafeSet(Array__I64 *self, U64 i, I64 value)
{
  ((self->data)(I64 *))[i] = value;
}

I64 *Array__I64_Get(Array__I64 *self, U64 i, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->cap) {
    *err_kind = 1;
    return NULL;
  }
  return Array__I64_UnsafeGet(self, i);
}

U0 Array__I64_Set(Array__I64 *self, U64 i, I64 value, I64 *err_kind)
{
  *err_kind = 0;
  if (i >= self->cap) {
    *err_kind = 1;
    return;
  }
