Bool TilDynHasMethodLiteral(TilStr *name,U8 *data,TIL_USIZE count)
{
  TilStr method; TilStrInitLit(&method,data,count);
  return TilDynHasMethod(name,&method);
}

I64 TilReflect_enum_variant_count(TilStr *name)
{
  if (TilStrNameEq(name,"CallableAction")) {
    return 2;
  }
  if (TilStrNameEq(name,"DefaultSignal")) {
    return 2;
  }
  if (TilStrNameEq(name,"MediumSignal")) {
    return 2;
  }
  if (TilStrNameEq(name,"OrderedPayload")) {
    return 3;
  }
  if (TilStrNameEq(name,"OrderedTag")) {
    return 3;
  }
  if (TilStrNameEq(name,"OwnType")) {
    return 3;
  }
  if (TilStrNameEq(name,"PayloadEnvelope")) {
    return 2;
  }
  if (TilStrNameEq(name,"PayloadValue")) {
    return 5;
  }
  if (TilStrNameEq(name,"Primitive")) {
    return 11;
  }
  if (TilStrNameEq(name,"ReverseTag")) {
    return 2;
  }
  if (TilStrNameEq(name,"Signal")) {
    return 3;
  }
  if (TilStrNameEq(name,"SmallSignal")) {
    return 2;
  }
  if (TilStrNameEq(name,"StructBorrowTag")) {
    return 3;
  }
  if (TilStrNameEq(name,"Type")) {
    return 17;
  }
  if (TilStrNameEq(name,"WideSignal")) {
    return 3;
  }
  TilReflectMissing("enum_variant_count",name);
  return 0;
}

U0 TilReflect_enum_variant_name(TilStr *out,TilStr *name,I64 index)
{
  if (TilStrNameEq(name,"CallableAction")) {
    if (index==0) { TilStrInitLit(out,"Empty",5); return; }
    if (index==1) { TilStrInitLit(out,"Run",3); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"DefaultSignal")) {
    if (index==0) { TilStrInitLit(out,"First",5); return; }
    if (index==1) { TilStrInitLit(out,"Second",6); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"MediumSignal")) {
    if (index==0) { TilStrInitLit(out,"Low",3); return; }
    if (index==1) { TilStrInitLit(out,"High",4); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"OrderedPayload")) {
    if (index==0) { TilStrInitLit(out,"Empty",5); return; }
    if (index==1) { TilStrInitLit(out,"Word",4); return; }
    if (index==2) { TilStrInitLit(out,"Number",6); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"OrderedTag")) {
    if (index==0) { TilStrInitLit(out,"First",5); return; }
    if (index==1) { TilStrInitLit(out,"Second",6); return; }
    if (index==2) { TilStrInitLit(out,"Third",5); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"OwnType")) {
    if (index==0) { TilStrInitLit(out,"Own",3); return; }
    if (index==1) { TilStrInitLit(out,"Ref",3); return; }
    if (index==2) { TilStrInitLit(out,"Shallow",7); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"PayloadEnvelope")) {
    if (index==0) { TilStrInitLit(out,"Empty",5); return; }
    if (index==1) { TilStrInitLit(out,"Wrapped",7); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"PayloadValue")) {
    if (index==0) { TilStrInitLit(out,"Empty",5); return; }
    if (index==1) { TilStrInitLit(out,"Byte",4); return; }
    if (index==2) { TilStrInitLit(out,"Count",5); return; }
    if (index==3) { TilStrInitLit(out,"Text",4); return; }
    if (index==4) { TilStrInitLit(out,"Record",6); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"Primitive")) {
    if (index==0) { TilStrInitLit(out,"I16",3); return; }
    if (index==1) { TilStrInitLit(out,"U16",3); return; }
    if (index==2) { TilStrInitLit(out,"I8",2); return; }
    if (index==3) { TilStrInitLit(out,"U8",2); return; }
    if (index==4) { TilStrInitLit(out,"U32",3); return; }
    if (index==5) { TilStrInitLit(out,"I32",3); return; }
    if (index==6) { TilStrInitLit(out,"U64",3); return; }
    if (index==7) { TilStrInitLit(out,"I64",3); return; }
    if (index==8) { TilStrInitLit(out,"F32",3); return; }
    if (index==9) { TilStrInitLit(out,"Bool",4); return; }
    if (index==10) { TilStrInitLit(out,"F64",3); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"ReverseTag")) {
    if (index==0) { TilStrInitLit(out,"First",5); return; }
    if (index==1) { TilStrInitLit(out,"Second",6); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"Signal")) {
    if (index==0) { TilStrInitLit(out,"Cold",4); return; }
    if (index==1) { TilStrInitLit(out,"Warm",4); return; }
    if (index==2) { TilStrInitLit(out,"Hot",3); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"SmallSignal")) {
    if (index==0) { TilStrInitLit(out,"Low",3); return; }
    if (index==1) { TilStrInitLit(out,"High",4); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"StructBorrowTag")) {
    if (index==0) { TilStrInitLit(out,"Empty",5); return; }
    if (index==1) { TilStrInitLit(out,"Borrowed",8); return; }
    if (index==2) { TilStrInitLit(out,"Number",6); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"Type")) {
    if (index==0) { TilStrInitLit(out,"Unknown",7); return; }
    if (index==1) { TilStrInitLit(out,"None",4); return; }
    if (index==2) { TilStrInitLit(out,"Struct",6); return; }
    if (index==3) { TilStrInitLit(out,"StructDef",9); return; }
    if (index==4) { TilStrInitLit(out,"Enum",4); return; }
    if (index==5) { TilStrInitLit(out,"EnumDef",7); return; }
    if (index==6) { TilStrInitLit(out,"FuncDef",7); return; }
    if (index==7) { TilStrInitLit(out,"FuncPtr",7); return; }
    if (index==8) { TilStrInitLit(out,"Dynamic",7); return; }
    if (index==9) { TilStrInitLit(out,"Custom",6); return; }
    if (index==10) { TilStrInitLit(out,"Primitive",9); return; }
    if (index==11) { TilStrInitLit(out,"FuncPtrSig",10); return; }
    if (index==12) { TilStrInitLit(out,"Body",4); return; }
    if (index==13) { TilStrInitLit(out,"StructSym",9); return; }
    if (index==14) { TilStrInitLit(out,"EnumSym",7); return; }
    if (index==15) { TilStrInitLit(out,"CustomSym",9); return; }
    if (index==16) { TilStrInitLit(out,"FuncPtrSigSym",13); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  if (TilStrNameEq(name,"WideSignal")) {
    if (index==0) { TilStrInitLit(out,"Low",3); return; }
    if (index==1) { TilStrInitLit(out,"Other",5); return; }
    if (index==2) { TilStrInitLit(out,"High",4); return; }
    TilReflectIndex("enum_variant_name",name,index);
  }
  TilReflectMissing("enum_variant_name",name);
}

