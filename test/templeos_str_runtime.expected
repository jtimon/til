  out->count = 0;
  out->cap = 0;
}

U0 Vec__Str_WithCapacity(Vec__Str *out, U64 cap)
{
  out->data = NULL;
  if (cap && cap > I64_MAX / sizeof(TilStr)) TilPanicZ("til: allocation size overflow
");
  if (cap) out->data = (TilMAlloc(cap * sizeof(TilStr)))(TilStr *);
  out->count = 0;
  out->cap = cap;
}

U0 Vec__Str_Clone(Vec__Str *out, Vec__Str *src)
{
