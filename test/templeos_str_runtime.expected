Bool Set__F32_Find(Set__F32 *self, F32 value, U64 *index)
{
  U64 lo = 0;
  U64 hi = self->count;
  while (lo < hi) {
    U64 mid = lo + (hi-lo)/2;
    I64 cmp = TilF64Compare(TilF32Load(self->data[mid]), TilF32Load(value), 6);
    if (cmp < 0) lo = mid+1;
    else if (cmp > 0) hi = mid;
    else { *index = mid; return TRUE; }
  }
  *index = lo;
  return FALSE;
}

Bool Set__F32_Has(Set__F32 *self, F32 value)
{
  U64 i;
  return Set__F32_Find(self, value, &i);
}

U0 Set__F32_Add(Set__F32 *self, F32 value)
{
  U64 i;
  if (Set__F32_Find(self, value, &i)) {
    return;
  }
  if (self->count == self->cap) {
    if (self->cap > I64_MAX/2) TilPanicZ("Set: capacity overflow\n");
    U64 cap = self->cap*2;
    if (!cap) cap = 1;
    if (cap > I64_MAX/sizeof(F32)) TilPanicZ("Set: allocation overflow\n");
    self->data = (TilReAlloc(self->data, cap*sizeof(F32)))(F32 *);
    self->cap = cap;
  }
  U64 tail = self->count-i;
  if (tail) TilMemMove(&self->data[i+1], &self->data[i], tail*sizeof(F32));
  self->data[i] = value;
  self->count++;
}

Bool Set__F32_Remove(Set__F32 *self, F32 value)
{
  U64 i;
  if (!Set__F32_Find(self, value, &i)) return FALSE;
  U64 last = self->count-1;
  if (i < last) TilMemMove(&self->data[i], &self->data[i+1], (last-i)*sizeof(F32));
  self->count = last;
  TilMemSet(&self->data[last], 0, sizeof(F32));
  return TRUE;
}

