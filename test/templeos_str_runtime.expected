  self->count = last;
  TilMemSet(&self->data[last], 0, sizeof(TilStr));
}

U0 Vec__Str_PushTake(Vec__Str *self, Vec__Str *src, U64 i)
{
  if (i >= src->count) TilPanicZ("Vec.push_take: out of bounds
");
  if (self->count == self->cap) {
