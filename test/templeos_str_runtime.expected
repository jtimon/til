Bool Set__F32_Find(Set__F32 *self, F32 value, U64 *index)
{
  U64 lo = 0;
  U64 hi = self->count;
  while (lo < hi) {
    U64 mid = lo + (hi-lo)/2;
    I64 cmp = TilF64Compare(TilF32Load(self->data[mid]), TilF32Load(value), 6);
    if (cmp < 0) lo = mid+1;
