U0 Vec__Str_DeleteMarked(Vec__Str *self, U8 *marks)
{
  U64 i = 0;
  while (i < self->count) {
    if (marks[i]) {
      TilStrDelete(&self->data[i], FALSE);
      TilMemSet(&self->data[i], 0, sizeof(TilStr));
    }
    i++;
  }
  U64 w = 0;
  U64 r = 0;
  while (r < self->count) {
    if (!marks[r]) {
