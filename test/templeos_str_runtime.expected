Bool FloatPair_Eq(FloatPair *a, FloatPair *b)
{
  if (!TilF64Compare(TilF32Load(a->small), TilF32Load(b->small), 0)) return FALSE;
  if (!TilF64Compare(a->large, b->large, 0)) return FALSE;
  return TRUE;
}

U0 FloatPayload_CopyValue(FloatPayload *out, FloatPayload *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    out->payload_Small = src->payload_Small;
    return;
  }
  if (src->tag == 1) {
    out->payload_Large = src->payload_Large;
    return;
  }
  TilPanicZ("invalid FloatPayload tag");
}

U0 FloatPayload_Clone(FloatPayload *out, FloatPayload *src)
{
  out->tag = src->tag;
  if (src->tag == 0) {
    out->payload_Small = src->payload_Small;
    return;
  }
  if (src->tag == 1) {
    out->payload_Large = src->payload_Large;
    return;
  }
  TilPanicZ("invalid FloatPayload tag");
}

U0 FloatPayload_Delete(FloatPayload *src, Bool call_free)
{
  if (src->tag == 0) {
    if (call_free) TilFree(src);
    return;
  }
  if (src->tag == 1) {
    if (call_free) TilFree(src);
    return;
  }
  TilPanicZ("invalid FloatPayload tag");
}

Bool FloatPayload_Eq(FloatPayload *a, FloatPayload *b)
{
  if (a->tag != b->tag) return FALSE;
  if (a->tag == 0) {
    return TilF64Compare(TilF32Load(a->payload_Small), TilF32Load(b->payload_Small), 0);
  }
  if (a->tag == 1) {
    return TilF64Compare(a->payload_Large, b->payload_Large, 0);
  }
  TilPanicZ("invalid FloatPayload tag");
  return FALSE;
}

