U0 Vec__Str_Truncate(Vec__Str *self, U64 n)
{
  if (n > self->count) TilPanicZ("Vec.truncate: out of bounds
");
  U64 i = n;
  while (i < self->count) {
    TilStrDelete(&self->data[i], FALSE);
    i++;
