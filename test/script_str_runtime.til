mode script

import("../src/std/file")

str_runtime_middle := func(s: Str) returns Str {
    return s.substr(1, 3).clone()
}

str_runtime_len := func(s: Str) returns I64 {
    return s.len().to_i64()
}

str_runtime_push := func(mut s: Str) {
    s.push_str("!")
}

str_runtime_consume := func(own s: Str) returns I64 {
    n := s.len().to_i64()
    own s.delete()
    return n
}

literal := "  1234  "
copy := literal.clone()
view := copy.substr(2, 4)
borrowed := view.borrowed_view()

mut out := Str.with_capacity(8)
out.push_str("ab")
out.push_str(borrowed)

println(out)
number := literal.trim().to_i64()
println(number.to_str())
println(out.len().to_i64().to_str())

mut reassigned := Str.with_capacity(8)
reassigned.push_str("abcdef")
reassigned = reassigned.substr(1, 4).clone()
returned := str_runtime_middle(reassigned)
println(returned)
println(str_runtime_len(returned).to_str())
println("multi:", returned, ":", str_runtime_len(returned).to_str())
mut mutable := Str.with_capacity(4)
mutable.push_str("xy")
str_runtime_push(mutable)
println(mutable)
owned := mutable.clone()
println(str_runtime_consume(own owned).to_str())

own out.delete()
own copy.delete()
own reassigned.delete()
own returned.delete()
own mutable.delete()

if File.exists("src/holyc/ext.HC") {
    println("file exists")
    if File.exists("src/holyc") { println("directory exists") }
    host_fs_view := "src/holyc/ext.HC.trailing".substr(0, 16)
    if File.exists(host_fs_view) { println("view exists") }
    host_read := File.readfile(host_fs_view)
    println(host_read.substr(0, 4))
    println(host_read.len().to_i64().to_str())
    own host_read.delete()
} else {
    if File.exists("Ext.HC") { println("file exists") }
    if File.exists("C:/Home") { println("directory exists") }
    guest_fs_view := "Ext.HC.trailing".substr(0, 6)
    if File.exists(guest_fs_view) { println("view exists") }
    guest_read := File.readfile(guest_fs_view)
    println(guest_read.substr(0, 4))
    println(guest_read.len().to_i64().to_str())
    own guest_read.delete()
}
if File.exists("missing.HC").not() { println("file missing") }
if cfile_exists("missing.HC").not() { println("primitive missing") }
