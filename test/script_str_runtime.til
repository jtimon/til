println(updated.substr(0, 11))
if updated.substr(11, 3).eq("\x00\x00!") { println("zero-filled gap") }
own updated.delete()
if true {
    appender := File.append(fs_data)
    appender.seek(0).write("tail")
    println(appender.tell().to_str())
    own appender.delete(false)
}
File.appendfile(fs_data, "+")
File.writefile(fs_moved, "replaced")
