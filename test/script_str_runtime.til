mode script

import("../src/std/file")
import("../src/std/sys")

str_runtime_middle := func(s: Str) returns Str {
    return s.substr(1, 3).clone()
}

str_runtime_len := func(s: Str) returns I64 {
    return s.len().to_i64()
}

str_runtime_push := func(mut s: Str) {
    s.push_str("!")
}

str_runtime_consume := func(own s: Str) returns I64 {
    n := s.len().to_i64()
    own s.delete()
    return n
}

literal := "  1234  "
copy := literal.clone()
view := copy.substr(2, 4)
borrowed := view.borrowed_view()

mut out := Str.with_capacity(8)
out.push_str("ab")
out.push_str(borrowed)

println(out)
number := literal.trim().to_i64()
println(number.to_str())
println(out.len().to_i64().to_str())

mut reassigned := Str.with_capacity(8)
reassigned.push_str("abcdef")
reassigned = reassigned.substr(1, 4).clone()
returned := str_runtime_middle(reassigned)
println(returned)
println(str_runtime_len(returned).to_str())
println("multi:", returned, ":", str_runtime_len(returned).to_str())
mut mutable := Str.with_capacity(4)
mutable.push_str("xy")
str_runtime_push(mutable)
println(mutable)
owned := mutable.clone()
println(str_runtime_consume(own owned).to_str())

own out.delete()
own copy.delete()
own reassigned.delete()
own returned.delete()
own mutable.delete()

if File.exists("src/holyc/ext.HC") {
    println("file exists")
    if File.exists("src/holyc") { println("directory exists") }
    host_fs_view := "src/holyc/ext.HC.trailing".substr(0, 16)
    if File.exists(host_fs_view) { println("view exists") }
    if File.is_file(host_fs_view) { println("regular file") }
    if File.is_dir("src/holyc") { println("directory kind") }
    if File.is_dir(host_fs_view).not().and(File.is_file("src/holyc").not()) {
        println("kinds distinct")
    }
    if cpath_is_file(host_fs_view).and(cpath_is_dir("src/holyc")) {
        println("primitive kinds")
    }
    host_read := File.readfile(host_fs_view)
    println(host_read.substr(0, 4))
    if host_read.len() > 4 { println("counted file read") }
    own host_read.delete()
} else {
    if File.exists("Ext.HC") { println("file exists") }
    if File.exists("C:/Home") { println("directory exists") }
    guest_fs_view := "Ext.HC.trailing".substr(0, 6)
    if File.exists(guest_fs_view) { println("view exists") }
    if File.is_file(guest_fs_view) { println("regular file") }
    if File.is_dir("C:/Home") { println("directory kind") }
    if File.is_dir(guest_fs_view).not().and(File.is_file("C:/Home").not()) {
        println("kinds distinct")
    }
    if cpath_is_file(guest_fs_view).and(cpath_is_dir("C:/Home")) {
        println("primitive kinds")
    }
    guest_read := File.readfile(guest_fs_view)
    println(guest_read.substr(0, 4))
    if guest_read.len() > 4 { println("counted file read") }
    own guest_read.delete()
}
if File.exists("missing.HC").not() { println("file missing") }
if cfile_exists("missing.HC").not() { println("primitive missing") }
if File.is_dir("missing.HC").not().and(File.is_file("missing.HC").not()) {
    println("missing kind")
}
if cpath_is_dir("missing.HC").not().and(cpath_is_file("missing.HC").not()) {
    println("primitive kinds missing")
}

mut write_path := "TILWRITE.HC.trailing".substr(0, 11)
if File.exists("src/holyc/ext.HC") {
    write_path = "tmp/TILWRITE.HC.trailing".substr(0, 15)
}
File.writefile(write_path, "longer content")
File.writefile(write_path, "A\x00Z")
written := File.readfile(write_path)
if written.eq("A\x00Z") { println("write roundtrip") }
println(written.len().to_i64().to_str())
own written.delete()
File.writefile(write_path, "")
empty_written := File.readfile(write_path)
if empty_written.is_empty() { println("empty write") }
own empty_written.delete()

mut fs_dir := "TILFS"
mut fs_data := "TILFS/DATA.HC"
mut fs_moved := "TILFS/MOVED.HC"
if File.exists("src/holyc/ext.HC") {
    fs_dir = "tmp/TILFS"
    fs_data = "tmp/TILFS/DATA.HC"
    fs_moved = "tmp/TILFS/MOVED.HC"
}
File.remove_tree(fs_dir)
if mkdir_p(fs_dir) != 0 { panic("could not create filesystem test directory") }
File.remove(fs_data)
File.remove(fs_moved)
if true {
    writer := File.new(fs_data, true)
    if File.exists(fs_data) { println("opened file exists") }
    if File.readfile(fs_data).is_empty() { println("open truncates immediately") }
    writer.write("abcdefgh").write("ijk")
    println(writer.tell().to_str())
    own writer.delete(false)
}
if true {
    reader := File.new(fs_data, false)
    println(reader.read(4))
    reader.seek_cur(2)
    println(reader.read(3))
    reader.seek_end(-2)
    println(reader.read(8))
    reader.seek(100)
    if reader.read(3).is_empty() { println("past eof") }
    println(reader.read_all())
    println(reader.tell().to_str())
    own reader.delete(false)
}
if true {
    updater := File.update(fs_data)
    updater.seek(3).write("XYZ")
    updater.seek_end(2).write("!")
    own updater.delete(false)
}
updated := File.readfile(fs_data)
println(updated.substr(0, 11))
if updated.substr(11, 3).eq("\x00\x00!") { println("zero-filled gap") }
own updated.delete()
if true {
    appender := File.append(fs_data)
    appender.seek(0).write("tail")
    println(appender.tell().to_str())
    own appender.delete(false)
}
File.appendfile(fs_data, "+")
File.writefile(fs_moved, "replaced")
File.rename(fs_data, fs_moved)
if File.exists(fs_data).not().and(File.exists(fs_moved)) { println("renamed") }
moved := File.readfile(fs_moved)
if moved.substr(14, 5).eq("tail+") { println("append kept content") }
println(moved.len().to_i64().to_str())
own moved.delete()
if true {
    directory := Dir.open(fs_dir)
    mut entries : I64 = 0
    while true {
        entry := directory.next()
        if entry.is_empty() { break }
        if entry.eq("MOVED.HC") { println("directory found file") }
        entries++
    }
    println(entries.to_str())
    own directory.delete(false)
}
names := Dir.list(fs_dir)
println(names.len().to_i64().to_str())
own names.delete(false)
File.remove(fs_moved)
File.remove(fs_moved)
if File.exists(fs_moved).not() { println("removed, missing remove ok") }

mut tree_src := "TILFS/TREE"
mut tree_dst := "TILFS/NEW"
mut tree_leaf := "TILFS/TREE/LEAF.HC"
mut moved_leaf := "TILFS/NEW/LEAF.HC"
if File.exists("src/holyc/ext.HC") {
    tree_src = "tmp/TILFS/TREE"
    tree_dst = "tmp/TILFS/NEW"
    tree_leaf = "tmp/TILFS/TREE/LEAF.HC"
    moved_leaf = "tmp/TILFS/NEW/LEAF.HC"
}
if mkdir_p(tree_src) != 0 { panic("could not create tree source") }
if mkdir_p(tree_dst) != 0 { panic("could not create tree destination") }
File.writefile(tree_leaf, "leaf")
File.rename(tree_src, tree_dst)
if File.is_dir(tree_src).not().and(File.is_file(moved_leaf)) { println("directory rename") }
println(File.readfile(moved_leaf))
File.remove_tree(fs_dir)
if File.exists(fs_dir).not() { println("tree cleanup") }

mut sector_content := Str.with_capacity(1030)
for _ in 0..1030 { sector_content.push_str("x") }
File.writefile(write_path, sector_content)
if true {
    sector_update := File.update(write_path)
    sector_update.seek(510).write("ABCD")
    own sector_update.delete(false)
}
if true {
    sector_reader := File.new(write_path, false)
    sector_reader.seek(508)
    println(sector_reader.read(8))
    println(sector_reader.read(5000).len().to_i64().to_str())
    println(sector_reader.read_all().len().to_i64().to_str())
    own sector_reader.delete(false)
}
if true {
    sparse_update := File.update(write_path)
    sparse_update.seek(1800).write("Z")
    own sparse_update.delete(false)
}
sparse_bytes := File.readfile(write_path)
mut zero_span := Str.with_capacity(770)
for _ in 0..770 { zero_span.push_str("\x00") }
if sparse_bytes.substr(1030, 770).eq(zero_span) { println("multi-sector gap") }
println(sparse_bytes.len().to_i64().to_str())
own sparse_bytes.delete()
own zero_span.delete()
own sector_content.delete()
File.remove(write_path)
