if File.exists(fs_data).not().and(File.exists(fs_moved)) { println("renamed") }
moved := File.readfile(fs_moved)
if moved.substr(14, 5).eq("tail+") { println("append kept content") }
println(moved.len().to_i64().to_str())
own moved.delete()
if true {
