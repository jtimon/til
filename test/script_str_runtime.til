    if File.is_file(host_fs_view) { println("regular file") }
    if File.is_dir("src/holyc") { println("directory kind") }
    if File.is_dir(host_fs_view).not().and(File.is_file("src/holyc").not()) {
        println("kinds distinct")
    }
    if cpath_is_file(host_fs_view).and(cpath_is_dir("src/holyc")) {
        println("primitive kinds")
    }
    host_read := File.readfile(host_fs_view)
    println(host_read.substr(0, 4))
    if host_read.len() > 4 { println("counted file read") }
    own host_read.delete()
} else {
    if File.exists("Ext.HC") { println("file exists") }
    if File.exists("C:/Home") { println("directory exists") }
    guest_fs_view := "Ext.HC.trailing".substr(0, 6)
    if File.exists(guest_fs_view) { println("view exists") }
    if File.is_file(guest_fs_view) { println("regular file") }
    if File.is_dir("C:/Home") { println("directory kind") }
    if File.is_dir(guest_fs_view).not().and(File.is_file("C:/Home").not()) {
        println("kinds distinct")
    }
    if cpath_is_file(guest_fs_view).and(cpath_is_dir("C:/Home")) {
        println("primitive kinds")
    }
    guest_read := File.readfile(guest_fs_view)
    println(guest_read.substr(0, 4))
    if guest_read.len() > 4 { println("counted file read") }
    own guest_read.delete()
}
