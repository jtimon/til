mode cli
import("../src/std/hashmap")

collision_hash := func(data: Dynamic, n: USize) returns U64 { return fnv1a(data,n).band(0) }
hash_width := func(_: Dynamic, n: USize) returns U64 { return n.to_u64() }
OwnedValue := struct { text: Str; number: I64 }
make_hasher := func(seed: U64) returns HashFn {
    return func(data: Dynamic, n: USize) returns U64 [shallow seed] { return fnv1a(data,n).bxor(seed) }
}

main := proc() {
    // Hash the entire primitive, not the one-byte empty StructDef layout.
    small : I16 = 258
    medium : U32 = 65537
    large : I64 = 65537
    if small.hash(hash_width)!=2 || medium.hash(hash_width)!=4 || large.hash(hash_width)!=8 { panic("primitive hash width") }
    mut defaults := HashMap(I64,I64).new()
    for i in 0..128 { defaults.set(i.mul(256),own i.clone()) }
    for i in 0..128 {
        key := i.mul(256)
        if defaults.get(key)! != i || defaults.stored_hash(key)! != key.hash(fnv1a) { panic("default HashMap hasher") }
    }
    if defaults.stored_hash(0)! == defaults.stored_hash(256)! { panic("primitive hash ignored upper bytes") }
    HashMap(I64,I64).hasher = make_hasher(17)
    mut captured := HashMap(I64,I64).new()
    captured.set(19,own 23)
    captured_key : I64 = 19
    if captured.get(19)! != 23 || captured.stored_hash(19)! != captured_key.hash(fnv1a).bxor(17) { panic("capturing namespace hasher") }
    HashMap(I64,I64).hasher = collision_hash
    mut numbers := HashMap(I64,I64).new()
    if numbers.len() != 0 || numbers.has(1) || numbers.remove(1) { panic("empty HashMap") }
    for i in 0..128 { numbers.set(i,own i.clone()) }
    if numbers.len() != 128 { panic("HashMap growth") }
    for i in 0..128 {
        if numbers.get(i)! != i || numbers.stored_hash(i)! != 0 { panic("HashMap collision lookup") }
    }
    for i in 0..128 { numbers.set(i,own i.add(1000)) }
    if numbers.len() != 128 { panic("HashMap replacement count") }
    for i in 0..128 { if numbers.get(i)! != i+1000 { panic("HashMap replacement") } }
    mut copy := numbers.clone()
    for i in 0..64 { if numbers.remove(i).not() { panic("HashMap removal") } }
    if numbers.len() != 64 || numbers.has(0) || numbers.remove(0) { panic("HashMap missing removal") }
    for i in 64..128 { if numbers.get(i)! != i+1000 { panic("HashMap swap removal chains") } }
    if copy.len() != 128 || copy.get(0)! != 1000 { panic("HashMap clone independence") }
    mut caught := false
    ref _ : I64 = numbers.get(0)?
    catch (err: KeyNotFound) { caught = true }
    if caught.not() { panic("HashMap missing-key error") }
    numbers.clear()
    if numbers.len() != 0 || numbers.has(127) { panic("HashMap clear") }
    numbers.set(7,own 77)
    if numbers.get(7)! != 77 { panic("HashMap reuse") }
    copy.clear()

    HashMap(Str,Str).hasher = collision_hash
    mut words := HashMap(Str,Str).with_capacity(64)
    for i in 0..64 {
        key := format("key",i.to_str())
        value := format("value",i.to_str())
        words.set(key,own value)
    }
    for i in 0..64 {
        key := format("key",i.to_str())
        if words.get(key)! != format("value",i.to_str()) { panic("owned HashMap strings") }
    }
    mut words_copy := words.clone()
    for i in 0..64 {
        key := format("key",i.to_str())
        value := format("replacement",i.to_str())
        words.set(key,own value)
    }
    if words_copy.get("key0")! != "value0" || words.get("key0")! != "replacement0" { panic("HashMap string clone/replacement") }
    for i in 0..32 { if words.remove(format("key",i.to_str())).not() { panic("HashMap string removal") } }
    for i in 32..64 { if words.get(format("key",i.to_str()))! != format("replacement",i.to_str()) { panic("HashMap string chain repair") } }
    words.clear()
    words.set("fresh",own format("new value"))
    if words.len() != 1 || words.get("fresh")! != "new value" { panic("HashMap string reuse") }
    words_copy.clear()

    // Owned aggregate values transfer, replace, clone and drop their strings.
    for round in 0..8 {
        mut values := HashMap(Str,OwnedValue).new()
        for i in 0..32 { values.set(format("key",i.to_str()),own OwnedValue(text = format("value",i.to_str()),number = i)) }
        snapshot := values.clone()
        for i in 0..32 {
            values.set(format("key",i.to_str()),own OwnedValue(text = format("replaced",i.to_str()),number = round))
        }
        for i in 0..32 {
            key := format("key",i.to_str())
            if snapshot.get(key)!.text != format("value",i.to_str()) || values.get(key)!.number != round { panic("aggregate HashMap ownership") }
            if values.remove(key).not() { panic("aggregate HashMap remove") }
        }
        values.clear()
    }
    HashMap(I64,I64).hasher = fnv1a
    HashMap(Str,Str).hasher = fnv1a
    println("HolyC HashMap passed")
}
