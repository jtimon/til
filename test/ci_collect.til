mode cli

import("../src/std/sys")
import("../src/std/file")
import("../src/self/targets")

// Issue #473 (C8): the collector that compares hash lists between CI
// producers (examples/ci_collect.til), against fixture directories. What it
// must never do is call two things equal that it did not compare.
//
// Argument: the compiler.

WORK := "tmp/ci_collect_test"

HASH_A := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
HASH_B := "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
HASH_C := "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"

// Start a fixture directory.
fixture := proc(name: Str) returns Str {
    directory := format(WORK, "/", name)
    mkdir_p(directory)
    return directory
}

// One producer's list, in a directory of its own, as CI downloads them.
list := proc(directory: Str, producer: Str, lines: ..Str) {
    mkdir_p(format(directory, "/hashes-", producer))
    mut text := ""
    for line : Str in lines { text = format(text, line, "\n") }
    File.writefile(format(directory, "/hashes-", producer, "/", producer, ".txt"), text)
}

// Run the collector; check its status and that its output holds every
// expected piece and none of the excluded ones (those start with "!").
collect := proc(collector: Str, directory: Str, mode: Str, expected_status: I64, pieces: ..Str) {
    command := Cmd.new(collector, "collect", directory)
    if mode.len() > 0 { command.arg(mode) }
    command.capture()
    status := command.run()
    output := format(command.out(), command.err())
    if status != expected_status {
        panic(directory, ": exited with ", status.to_str(), ", expected ", expected_status.to_str(), "\n", output)
    }
    for piece : Str in pieces {
        if piece.starts_with("!") {
            if output.contains(piece.strip_prefix("!")) { panic(directory, ": output must not hold '", piece.strip_prefix("!"), "'\n", output) }
        } else if output.contains(piece).not() {
            panic(directory, ": output lacks '", piece, "'\n", output)
        }
    }
}

main := proc(args: ..Str) {
    if args.len() != 1 { panic("usage: ci_collect <compiler>") }
    // The list the producers and test/translate_layouts.til walk names every
    // target there is.
    names := target_names()
    if names.len().to_i64() != enum_variant_count("Target") {
        panic("target_names() has ", names.len().to_str(), " names, Target has ", enum_variant_count("Target").to_str(), " variants")
    }
    for name : Str in names {
        if target_to_str(target_from_str(name)) != name { panic("target_names(): ", name, " is not a target's own name") }
    }

    File.remove_tree(WORK)
    mkdir_p(WORK)
    collector := format(WORK, "/ci_collect")
    Cmd.new(args[0], "build", "-o", collector, "-c", format(WORK, "/ci_collect.c"), "examples/ci_collect.til").run_checked()

    first := format(HASH_A, " frontend linux-x64 c 32 hello.til parsed:./a.til")
    second := format(HASH_B, " frontend linux-x64 c 32 hello.til typed:./a.til")

    // Two producers, the same lists.
    equal := fixture("equal")
    list(equal, "one", first, second)
    list(equal, "two", first, second)
    collect(collector, equal, "", 0, "2 producers (one, two), 2 items equal", "2 equal, 0 different, 0 missing, 0 not compared", "!DIFFERENT", "!MISSING")

    // One byte of one producer's file changed: its hash is another one.
    different := fixture("different")
    list(different, "one", first, second)
    list(different, "two", first, format(HASH_C, " frontend linux-x64 c 32 hello.til typed:./a.til"))
    collect(collector, different, "", 1, "DIFFERENT frontend linux-x64 c 32: hello.til typed:./a.til",
        format("one ", HASH_B), format("two ", HASH_C), "1 equal, 1 different")
    // `report` prints the same and does not fail.
    collect(collector, different, "report", 0, "DIFFERENT frontend linux-x64 c 32: hello.til typed:./a.til", "1 equal, 1 different")

    // Three producers, one apart.
    three := fixture("three")
    list(three, "one", first)
    list(three, "two", first)
    list(three, "three", format(HASH_C, " frontend linux-x64 c 32 hello.til parsed:./a.til"))
    collect(collector, three, "", 1, "DIFFERENT", format("three ", HASH_C), "0 equal, 1 different")

    // A producer that takes part in a group but leaves an item out.
    missing := fixture("missing")
    list(missing, "one", first, second)
    list(missing, "two", first)
    collect(collector, missing, "", 1, "MISSING frontend linux-x64 c 32: two has no hello.til typed:./a.til", "1 equal, 0 different, 1 missing")

    // A list for another width: a group of its own, so nothing is compared
    // and nothing is called equal.
    other_width := fixture("other_width")
    list(other_width, "one", first)
    list(other_width, "two", format(HASH_A, " frontend linux-x64 c 64 hello.til parsed:./a.til"))
    collect(collector, other_width, "", 0, "frontend linux-x64 c 32: 1 producers (one), 0 items equal, 1 from one producer only (not compared)",
        "frontend linux-x64 c 64: 1 producers (two)", "0 equal, 0 different, 0 missing, 2 not compared")
    // The same for another target.
    other_target := fixture("other_target")
    list(other_target, "one", format(HASH_A, " source linux-x64 c 32 hello.til hello.c"))
    list(other_target, "two", format(HASH_A, " source windows-x64 c 32 hello.til hello.c"))
    collect(collector, other_target, "", 0, "0 equal, 0 different, 0 missing, 2 not compared")

    // One producer only.
    alone := fixture("alone")
    list(alone, "one", first, second)
    collect(collector, alone, "", 0, "1 producers (one), 0 items equal, 2 from one producer only (not compared)", "0 equal")

    // One producer translated a program another refused.
    refused := fixture("refused")
    list(refused, "one", format(HASH_A, " source templeos-x86 c 32 option.til option.c"))
    list(refused, "two", "refused source templeos-x86 c 32 option.til -")
    collect(collector, refused, "", 1, "MISSING source templeos-x86 c 32: two has no option.til option.c",
        "MISSING source templeos-x86 c 32: one has no option.til -")
    // Both refusing is agreement.
    both_refused := fixture("both_refused")
    list(both_refused, "one", "refused source templeos-x86 c 32 option.til -")
    list(both_refused, "two", "refused source templeos-x86 c 32 option.til -")
    collect(collector, both_refused, "", 0, "1 equal, 0 different, 0 missing")

    // Binaries (#472 level 3) are compared whatever toolchain each producer
    // used: what has to agree is the bytes. The toolchain is a trial item,
    // so different toolchains are printed and never fail by themselves.
    hello_a := format(HASH_A, " binary macos-arm64 c 32 hello.til hello")
    hello_c := format(HASH_C, " binary macos-arm64 c 32 hello.til hello")
    tools_a := format(HASH_A, " binary-trial macos-arm64 c 32 - toolchain")
    tools_b := format(HASH_B, " binary-trial macos-arm64 c 32 - toolchain")
    same_binary := fixture("same_binary")
    list(same_binary, "one", tools_a, hello_a)
    list(same_binary, "two", tools_a, hello_a)
    collect(collector, same_binary, "", 0, "2 equal, 0 different, 0 missing, 0 not compared, 0 different on trial")
    // Another binary is a difference, and fails.
    other_binary := fixture("other_binary")
    list(other_binary, "one", tools_a, hello_a)
    list(other_binary, "two", tools_a, hello_c)
    collect(collector, other_binary, "", 1, "DIFFERENT binary macos-arm64 c 32: hello.til hello", "1 equal, 1 different")
    // Different toolchains that give the same binary: equal, and the
    // toolchains are printed as a trial difference.
    other_tools := fixture("other_tools")
    list(other_tools, "one", tools_a, hello_a)
    list(other_tools, "two", tools_b, hello_a)
    collect(collector, other_tools, "", 0, "DIFFERENT (trial, does not fail) binary macos-arm64 c 32: - toolchain",
        "1 equal, 0 different, 0 missing, 0 not compared, 1 different on trial", "!NOT COMPARABLE")
    // Different toolchains and another binary: the binary fails.
    other_tools_binary := fixture("other_tools_binary")
    list(other_tools_binary, "one", tools_a, hello_a)
    list(other_tools_binary, "two", tools_b, hello_c)
    collect(collector, other_tools_binary, "", 1, "DIFFERENT binary macos-arm64 c 32: hello.til hello",
        "0 equal, 1 different, 0 missing, 0 not compared, 1 different on trial")

    // Proven Android binaries are strict even when toolchain identities
    // differ. APK groups contain only SDK producers, not every native host.
    android_tools := format(HASH_A, " binary-trial android-x64 c 32 - toolchain")
    android_native := format(HASH_A, " binary android-x64 c 32 hello.til hello")
    apk_payload := format(HASH_B, " apk android-x64 c 32 gui.til aligned.apk")
    apk_library := format(HASH_C, " apk android-x64 c 32 gui.til libgui.so")
    android := fixture("android")
    list(android, "linux", android_tools, android_native, apk_payload, apk_library)
    list(android, "mac", format(HASH_B, " binary-trial android-x64 c 32 - toolchain"), android_native, apk_payload, apk_library)
    list(android, "arm", android_tools, android_native)
    collect(collector, android, "", 0, "apk android-x64 c 32: 2 producers", "binary android-x64 c 32: 3 producers",
        "3 equal, 0 different, 0 missing, 0 not compared, 1 different on trial", "!MISSING")

    android_changed := fixture("android_changed")
    list(android_changed, "linux", android_tools, android_native)
    list(android_changed, "arm", android_tools, format(HASH_C, " binary android-x64 c 32 hello.til hello"))
    collect(collector, android_changed, "", 1, "DIFFERENT binary android-x64 c 32: hello.til hello", "1 different")

    apk_changed := fixture("apk_changed")
    list(apk_changed, "linux", android_native, apk_payload, apk_library)
    list(apk_changed, "mac", android_native, format(HASH_A, " apk android-x64 c 32 gui.til aligned.apk"), apk_library)
    list(apk_changed, "arm", android_native)
    collect(collector, apk_changed, "", 1, "DIFFERENT apk android-x64 c 32: gui.til aligned.apk", "!MISSING")

    apk_missing := fixture("apk_missing")
    list(apk_missing, "linux", android_native, apk_payload, apk_library)
    list(apk_missing, "mac", android_native, apk_library)
    list(apk_missing, "arm", android_native)
    collect(collector, apk_missing, "", 1, "MISSING apk android-x64 c 32: mac has no gui.til aligned.apk",
        "2 equal, 0 different, 1 missing", "!arm has no")

    apk_alone := fixture("apk_alone")
    list(apk_alone, "linux", android_native, apk_payload, apk_library)
    list(apk_alone, "arm", android_native)
    collect(collector, apk_alone, "", 0, "apk android-x64 c 32: 1 producers", "1 equal, 0 different, 0 missing, 2 not compared")

    // Only Checkers is exercised by the two runtime jobs. They must agree
    // with both SDK cross-builders without having to list hello_gui too.
    tested := fixture("android_tested_apk")
    tested_key := " tested-apk android-x64 c 32 examples/checkers.til aligned.apk"
    same := format(HASH_A, tested_key)
    list(tested, "linux-x64", same, apk_payload)
    list(tested, "macos-arm64", same, apk_payload)
    list(tested, "android-api-28", same)
    list(tested, "android-api-36", same)
    collect(collector, tested, "", 0, "tested-apk android-x64 c 32: 4 producers", "2 equal, 0 different, 0 missing")
    list(tested, "android-api-36", format(HASH_C, tested_key))
    collect(collector, tested, "", 1, "DIFFERENT tested-apk android-x64 c 32: examples/checkers.til aligned.apk")

    // An artifact on trial: a difference is printed and does not fail.
    trial_tools := format(HASH_A, " binary-trial linux-arm64 c 32 - toolchain")
    trial := fixture("trial")
    list(trial, "one", trial_tools, format(HASH_A, " binary-trial linux-arm64 c 32 src/til.til til"),
        format(HASH_A, " binary-trial linux-arm64 c 32 src/til.til til:.text"))
    list(trial, "two", trial_tools, format(HASH_C, " binary-trial linux-arm64 c 32 src/til.til til"),
        format(HASH_A, " binary-trial linux-arm64 c 32 src/til.til til:.text"))
    collect(collector, trial, "", 0, "DIFFERENT (trial, does not fail) binary linux-arm64 c 32: src/til.til til",
        "2 equal, 0 different, 0 missing, 0 not compared, 1 different on trial")
    // A producer on trial beside strict ones (a mac's own build beside the
    // Linux hosts' cross builds): its lines are compared with theirs, a
    // difference it is part of does not fail, and what it leaves out is
    // reported and does not fail either. Among the strict producers a
    // difference still fails.
    strict_two := format(HASH_A, " binary macos-arm64 c 32 hello.til hello")
    lib_line := format(HASH_A, " binary macos-arm64 c 32 lib.til lib")
    beside := fixture("beside")
    list(beside, "one", tools_a, strict_two, lib_line)
    list(beside, "two", tools_a, strict_two, lib_line)
    list(beside, "mac", tools_b, format(HASH_C, " binary-trial macos-arm64 c 32 hello.til hello"))
    collect(collector, beside, "", 0, "DIFFERENT (trial, does not fail) binary macos-arm64 c 32: hello.til hello",
        "MISSING (trial, does not fail) binary macos-arm64 c 32: mac has no lib.til lib",
        "binary macos-arm64 c 32: 3 producers (mac, one, two)",
        "1 equal, 0 different, 0 missing, 0 not compared, 2 different on trial")
    beside_equal := fixture("beside_equal")
    list(beside_equal, "one", tools_a, strict_two)
    list(beside_equal, "two", tools_a, strict_two)
    list(beside_equal, "mac", tools_a, format(HASH_A, " binary-trial macos-arm64 c 32 hello.til hello"))
    collect(collector, beside_equal, "", 0, "2 equal, 0 different, 0 missing, 0 not compared, 0 different on trial")
    beside_strict := fixture("beside_strict")
    list(beside_strict, "one", tools_a, strict_two)
    list(beside_strict, "two", tools_a, format(HASH_C, " binary macos-arm64 c 32 hello.til hello"))
    list(beside_strict, "mac", tools_a, format(HASH_A, " binary-trial macos-arm64 c 32 hello.til hello"))
    collect(collector, beside_strict, "", 1, "DIFFERENT binary macos-arm64 c 32: hello.til hello",
        "1 equal, 1 different, 0 missing, 0 not compared, 0 different on trial")

    // A line that is not a hash-list line stops the collector.
    malformed := fixture("malformed")
    list(malformed, "one", first, "frontend linux-x64 c 32 hello.til parsed:./a.til")
    collect(collector, malformed, "report", 1, "one.txt:2: expected 7 fields, found 6")
    not_a_hash := fixture("not_a_hash")
    list(not_a_hash, "one", "abc frontend linux-x64 c 32 hello.til parsed:./a.til")
    collect(collector, not_a_hash, "report", 1, "not a sha256")
    twice := fixture("twice")
    list(twice, "one", first, first)
    collect(collector, twice, "report", 1, "lists frontend linux-x64 c 32 hello.til parsed:./a.til twice")

    // No list at all is not a pass.
    empty := fixture("empty")
    collect(collector, empty, "", 1, "no hash list")

    println("ci collect passed")
}
