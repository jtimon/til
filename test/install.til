mode cli

import("../src/std/sys")
import("../src/std/file")
import("../src/self/install")

// `til install` end to end, because nothing covered it and it was
// broken for two weeks without anyone noticing.
//
// When lib/ moved to examples/lib/, install_compiler_support kept
// copying <root>/lib -- a directory that no longer existed -- so every
// install planted the binary and then failed on "install compiler
// library sources", leaving a til whose support tree was half there.
// The suite had no install test of any kind, so the whole target was
// invisible to it.
//
// This installs the compiler under tmp/ and then USES the result: the
// installed til must compile and run a program from a different
// directory, against the installed std, C runtime and boot. That is
// what the support tree exists for, so anything missing from it fails
// here instead of on a user's machine.
//
// Not part of `both`: it is a driver, not a test() file. Run through
// `bin/til run test/install.til` like the other cli-driven tests.

PREFIX := "tmp/install_test"
WORK := "tmp/install_test_work"

require := proc(path: Str) {
    if File.is_file(path).not() {
        panic("install did not produce '", path, "'")
    }
}

main := proc() returns I64 {
    File.remove_tree(PREFIX)
    File.remove_tree(WORK)
    mkdir_p(WORK)

    install := Cmd.new("bin/til", "install", "--usize=32", format("--prefix=", PREFIX), "src/til.til")
    install.run_checked()

    // make install uses the same copy-only phase after its unprivileged
    // build. Reinstall from those existing artifacts, then exercise that
    // installation below. Copying must not rebuild checkout outputs.
    binary_time := file_mtime("bin/til")
    c_time := file_mtime("gen/til/til.c")
    boot_time := file_mtime("boot/til.c")
    File.remove_tree(PREFIX)
    if install_executable("bin/til", format(PREFIX, "/bin/til"), ".", PREFIX) != 0 {
        panic("copy-only compiler installation failed")
    }
    if file_mtime("bin/til") != binary_time { panic("copy-only install rebuilt bin/til") }
    if file_mtime("gen/til/til.c") != c_time { panic("copy-only install regenerated C") }
    if file_mtime("boot/til.c") != boot_time { panic("copy-only install regenerated boot") }

    // The binary, and every source tree an installed compiler needs to
    // build a program: til sources it type-checks against, the C
    // runtime and the generated compiler C it links. Plus what mode gui
    // stands on (issue #348): the FFI bindings the mode imports, and
    // each linked archive with the .so twin the interpreter dlopens.
    // Both handwritten documentation trees and the generated reference
    // are part of the installed compiler support tree.
    require(format(PREFIX, "/bin/til"))
    require(format(PREFIX, "/lib/til/src/core/core.til"))
    require(format(PREFIX, "/lib/til/src/std/file.til"))
    require(format(PREFIX, "/lib/til/vendor/bindings/raylib.til"))
    require(format(PREFIX, "/lib/til/vendor/bindings/tinyfd.til"))
    require(format(PREFIX, "/lib/til/vendor/raylib/src/libraylib.a"))
    require(format(PREFIX, "/lib/til/vendor/raylib/src/libraylib.so"))
    require(format(PREFIX, "/lib/til/vendor/tinyfiledialogs/libtinyfd.a"))
    require(format(PREFIX, "/lib/til/vendor/tinyfiledialogs/libtinyfd.so"))
    require(format(PREFIX, "/lib/til/src/modes/gui.til"))
    require(format(PREFIX, "/lib/til/src/c/ext.c"))
    require(format(PREFIX, "/lib/til/src/holyc/ext.HC"))
    require(format(PREFIX, "/lib/til/boot/til.c"))
    require(format(PREFIX, "/lib/til/doc/concepts/index.org"))
    require(format(PREFIX, "/lib/til/doc/concepts/ownership.org"))
    require(format(PREFIX, "/lib/til/doc/tutorial/index.org"))
    require(format(PREFIX, "/lib/til/doc/tutorial/1_getting_started.org"))
    require(format(PREFIX, "/lib/til/doc/gen/index.org"))

    // Paths are relative to WORK, where the program is compiled: the
    // installed til is found through its own location, not through this
    // repository's working directory.
    installed_til := "../install_test/bin/til"
    File.writefile(format(WORK, "/installed_probe.til"), format(
        "mode cli\n\n",
        "import(\"std/file\")\n\n",
        "main := proc() returns I64 {\n",
        "    File.writefile(\"probe.txt\", \"installed til works\")\n",
        "    print(File.readfile(\"probe.txt\"))\n",
        "    return 0\n",
        "}\n"))

    build := Cmd.new(installed_til, "build", "installed_probe.til")
    build.cwd(WORK)
    build.run_checked()

    run := Cmd.new("./bin/installed_probe")
    run.cwd(WORK)
    run.capture()
    status := run.run()
    if status != 0 {
        panic("the program built by the installed til exited with ", status.to_str())
    }
    if run.out() != "installed til works" {
        panic("the program built by the installed til printed '", run.out(), "'")
    }

    // #413: an isolated external project, a non-default install prefix,
    // nested imports and a cwd different from the entrypoint's directory.
    // Local std/core and a neighboring src tree must not shadow the selected
    // compiler, but ./std and ./core must still reach project modules.
    mkdir_p(format(WORK, "/project/nested/std"))
    mkdir_p(format(WORK, "/project/nested/core"))
    mkdir_p(format(WORK, "/project/std"))
    mkdir_p(format(WORK, "/project/core"))
    mkdir_p(format(WORK, "/project/src/std"))
    File.writefile(format(WORK, "/project/std/sys.til"), "mode lib\nlocal_std := 17\n")
    File.writefile(format(WORK, "/project/core/str.til"), "mode lib\nlocal_core := 25\n")
    File.writefile(format(WORK, "/project/nested/std/sys.til"), "not a valid module\n")
    File.writefile(format(WORK, "/project/nested/core/str.til"), "not a valid module\n")
    File.writefile(format(WORK, "/project/src/std/sys.til"), "mode lib\nlegacy_local := 9\n")
    File.writefile(format(WORK, "/project/nested/helper.til"), format(
        "mode lib\n",
        "import(\"std/sys\", process_id)\n",
        "strings := import(\"core/str\")\n",
        "import(\"../src/std/sys\", legacy_local)\n",
        "nested_probe := proc() returns Str {\n",
        "    if process_id() <= 0 { panic(\"std/sys was not loaded\") }\n",
        "    if legacy_local != 9 { panic(\"legacy local resolution changed\") }\n",
        "    return strings.Str.clone(\"x\")\n",
        "}\n"))
    File.writefile(format(WORK, "/project/natural.til"), format(
        "mode cli\n",
        "import(\"std/sys\", process_id)\n",
        "import(\"core/str\", Str)\n",
        "import(\"core/core\", noop_proc)\n",
        "import(\"./std/sys\", local_std)\n",
        "import(\"./core/str\", local_core)\n",
        "import(\"nested/helper\", nested_probe)\n",
        "main := proc() {\n",
        "    noop_proc()\n",
        "    value : Str = nested_probe()\n",
        "    if value != \"x\" { panic(\"core identity mismatch\") }\n",
        "    if process_id() <= 0 { panic(\"std/sys was not loaded\") }\n",
        "    if local_std + local_core != 42 { panic(\"explicit local imports failed\") }\n",
        "    println(\"natural imports work\")\n",
        "}\n"))
    for action : Str in "interpret run".split(" ") {
        natural := Cmd.new(installed_til, action, "project/natural.til")
        natural.cwd(WORK)
        natural.capture()
        if natural.run() != 0 { panic("installed natural imports failed: ", natural.out(), natural.err()) }
        if natural.out() != "natural imports work\n" { panic("natural imports output: ", natural.out()) }
    }

    // A missing reserved module never falls through to a local module with
    // that name. Keep both namespace names in the diagnostic coverage.
    for space : Str in "std core".split(" ") {
        File.writefile(format(WORK, "/project/", space, "/missing_413.til"), "mode lib\nvalue := 42\n")
        File.writefile(format(WORK, "/project/missing.til"), format(
            "import(\"", space, "/missing_413\", value)\nprintln(value.to_str())\n"))
        missing := Cmd.new(installed_til, "project/missing.til")
        missing.cwd(WORK)
        missing.capture()
        if missing.run() == 0 { panic("missing reserved import resolved locally") }
        if missing.out().contains(format("could not find import '", space, "/missing_413.til'")).not() {
            panic("missing reserved import diagnostic: ", missing.out(), missing.err())
        }
    }

    // A fresh compiler-only install has no lib/ search directory. On Unix
    // the old lib/../src traversal fails there. Exercise it after installing
    // a library below; natural imports above work without that directory.
    File.writefile(format(WORK, "/project/legacy.til"), format(
        "mode cli\n",
        "import(\"../src/std/sys\", process_id)\n",
        "natural := import(\"std/sys\")\n",
        "main := proc() { if process_id() != natural.process_id() { panic(\"legacy mismatch\") } }\n"))

    // A generated shared library installs its exact-version runtime beside
    // it, and the installed Python binding finds both from outside the repo.
    File.writefile(format(WORK, "/installed_lib.til"), format(
        "mode lib\n\n",
        "installed_value := func() returns I64 { return 77 }\n",
        "installed_parse := func(value: Dynamic) returns U64 { return Str.from_c_str(value).to_u64() }\n",
        "installed_split_join := func(value: Dynamic) returns I64 { parts := Str.from_c_str(value).split(\"|\"); return join(parts, \":\").len().to_i64() }\n",
        "installed_format := func() returns I64 { return format(\"hello\", \"!\").replace(\"!\", \"\").len().to_i64() }\n",
        "installed_failure := func() { panic(\"installed\", \" core panic\", loc = \"installed-test\") }\n"))
    lib_install := Cmd.new(installed_til, "install", "--prefix=../install_test", "installed_lib.til")
    lib_install.cwd(WORK)
    lib_install.run_checked()
    // Installing a library creates the existing lib/ search directory. Now
    // the historical fallback works and shares the natural import's identity.
    for action : Str in "interpret run".split(" ") {
        legacy := Cmd.new(installed_til, action, "project/legacy.til")
        legacy.cwd(WORK)
        legacy.run_checked()
    }
    mut shared_ext := ".so"
    if host_os() == "macos" { shared_ext = ".dylib" }
    else if host_os() == "windows" { shared_ext = ".dll" }
    require(format(PREFIX, "/lib/libinstalled_lib", shared_ext))
    require(format(PREFIX, "/lib/til/lib/installed_lib.py"))
    mut runtime_count : USize = 0
    mut core_count : USize = 0
    for installed_name : Str in Dir.list(format(PREFIX, "/lib")) {
        if installed_name.starts_with("libtilrt-").and(installed_name.ends_with(shared_ext)) {
            runtime_count++
        }
        if installed_name.starts_with("libtilcore-").and(installed_name.ends_with(shared_ext)) {
            core_count++
        }
    }
    if runtime_count != 1 { panic("library install produced ", runtime_count.to_str(), " shared runtimes") }
    if core_count != 1 { panic("library install produced ", core_count.to_str(), " shared cores") }
    installed_forward := File.readfile(format(WORK, "/gen/til/installed_lib_forward.h"))
    mut canonical_parser := false
    for line : Str in installed_forward.split("\n") {
        if line.starts_with("#define priv__").and(line.ends_with("__str_parse_integer_magnitude")) {
            canonical_parser = line.contains(" til_tilcore_x2d")
        }
    }
    if canonical_parser.not() { panic("installed private numeric parser has no canonical core name") }
    py := Cmd.new("python3", "-c",
        "import sys, ctypes; sys.path.insert(0, '../install_test/lib/til/lib'); import installed_lib; assert installed_lib.installed_value() == 77; assert installed_lib.installed_format() == 5; assert installed_lib.installed_parse(ctypes.c_char_p(b'18446744073709551615')) == 18446744073709551615; assert installed_lib.installed_split_join(ctypes.c_char_p(b'alpha|beta|gamma')) == 16")
    py.cwd(WORK)
    py.run_checked()
    py_failure := Cmd.new("python3", "-c",
        "import sys; sys.path.insert(0, '../install_test/lib/til/lib'); import installed_lib; installed_lib.installed_failure()")
    py_failure.cwd(WORK)
    py_failure.capture()
    if py_failure.run() != 1 { panic("installed shared panic did not exit with status 1") }
    if py_failure.out() != "installed-test: panic: installed core panic\n" {
        panic("installed shared panic output mismatch: ", py_failure.out())
    }
    if py_failure.err().len() != 0 { panic("installed shared panic wrote stderr: ", py_failure.err()) }

    // The gui leg (issue #348): mode gui from OUTSIDE the repo, both
    // backends, deliberately windowless (like test/gui_interp.til --
    // what #348 broke is import/link/dlopen resolution, not rendering,
    // and windowless keeps this leg green on display-less hosts and in
    // --no-gui runs). GetRandomValue is pure CPU but only answers
    // through real FFI dispatch: interpreted it needs the installed
    // libraylib.so twin, compiled it needs the installed archive.
    File.writefile(format(WORK, "/installed_gui.til"), format(
        "mode gui\n\n",
        "main := proc() {\n",
        "    SetRandomSeed(7)\n",
        "    v := GetRandomValue(3, 3)\n",
        "    if v != 3 { panic(\"GetRandomValue(3, 3) gave \", v.to_str()) }\n",
        "    println(\"installed gui works\")\n",
        "}\n"))

    interp := Cmd.new(installed_til, "installed_gui.til")
    interp.cwd(WORK)
    interp.capture_out()
    interp_status := interp.run()
    if interp_status != 0 {
        panic("the installed til could not interpret mode gui, exited with ", interp_status.to_str())
    }
    if interp.out().contains("installed gui works").not() {
        panic("interpreted mode gui printed '", interp.out(), "'")
    }

    gui_build := Cmd.new(installed_til, "build", "installed_gui.til")
    gui_build.cwd(WORK)
    gui_build.run_checked()

    gui_run := Cmd.new("./bin/installed_gui")
    gui_run.cwd(WORK)
    gui_run.capture_out()
    gui_status := gui_run.run()
    if gui_status != 0 {
        panic("the gui program built by the installed til exited with ", gui_status.to_str())
    }
    if gui_run.out().contains("installed gui works").not() {
        panic("the gui program built by the installed til printed '", gui_run.out(), "'")
    }

    // The missing-libffi report. The install prefix deliberately ships
    // no libffi archive, which makes this the one place the check fires
    // hermetically on every host: a program whose generated C calls
    // libffi (it imports the installed binding and calls ffi_prep_cif)
    // must FAIL the build with the actionable report, before any linker
    // spew -- the archive used to be dropped silently here and the
    // failure surfaced as a screenful of unresolved ffi_* symbols. The
    // asserted substring is the platform-independent part; the path and
    // build hint in the full message are per-target.
    File.writefile(format(WORK, "/installed_ffi.til"), format(
        "mode cli\n\n",
        "import(\"../install_test/lib/til/vendor/bindings/libffi\")\n\n",
        "main := proc() {\n",
        "    mut rt := ffi_type()\n",
        "    mut cif := ffi_cif(rtype = rt)\n",
        "    ref mut atypes : Dynamic = to_ptr(rt)\n",
        "    status := ffi_prep_cif(cif, 0, 0, rt, atypes)\n",
        "    println(status.to_str())\n",
        "}\n"))
    ffi_build := Cmd.new(installed_til, "build", "installed_ffi.til")
    ffi_build.cwd(WORK)
    ffi_build.capture()
    ffi_status := ffi_build.run()
    if ffi_status == 0 {
        panic("a libffi-calling build against the archive-less install tree succeeded; the missing-archive check did not fire")
    }
    if ffi_build.out().contains("libffi archive is not built").not() {
        panic("the missing-libffi failure did not carry the report; got '", ffi_build.out(), ffi_build.err(), "'")
    }
    if ffi_build.out().contains("build it first:").not() {
        panic("the missing-libffi report lost its build hint; got '", ffi_build.out(), "'")
    }

    repl := Cmd.new("sh", "-c", "printf '%s\\n' 'help(\"println\")' | ../install_test/bin/til")
    repl.cwd(WORK)
    repl.capture()
    repl_status := repl.run()
    if repl_status != 0 { panic("installed til REPL exited with ", repl_status.to_str()) }
    if repl.out().contains("Print strings to stdout followed by a newline.").not() {
        panic("installed til REPL help failed: ", repl.out(), repl.err())
    }

    println("install PASS")
    return 0
}
