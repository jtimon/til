mode cli

import("./tilvm_cases")

// Keep the standalone all-cases order. The suite builds this host once and
// selects each family in a separate process with isolated guest files.
main := proc(root: Str, families: ..Str) returns I64 {
    if families.len() > 1 { panic("expected at most one TilVm test family") }
    if families.len() == 1 { return run_tilvm_family(root, families[0]) }
    record_error := shared_record_callback_tests(root)
    assert(record_error.message == "record borrow error")
    shared_error := shared_cell_callback_tests(root)
    assert(shared_error.code == 21 && shared_error.message == "shared error")
    kwargs_callback_tests(root)
    variadic_callback_tests(root)
    nested_callback_tests(root)
    enum_callback_tests(root)
    record_callback_tests(root)
    multiple_error_callback_tests(root)
    throwing_callback_tests(root)
    throwing_schema_tests(root)
    checked_lookup(root)
    callback_tests(root)
    typed_callback_tests(root)
    return lifecycle_tests(root)
}
