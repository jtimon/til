mode cli

import("std/tilvm")
import("std/file")

// A standalone host: test/install_tilvm.til builds this against the installed SDK.
// Run from an independent directory with an empty PATH. All guest files are
// created AFTER host compilation; neither the Til nor C compiler is needed.
expect_failure := proc(mut vm: TilVm, source: Str, phase: Str, detail: Str, line: U32) {
    File.writefile("guest.til", source)
    mut failed := false
    vm.load_file("guest.til")?
    catch (err: TilVmError) {
        failed = true
        expect(err.phase == phase, err.to_str())
        assert(err.diagnostics.len() > 0)
        ref d : TilVmDiagnostic = err.diagnostics[0]
        expect(d.path == "guest.til", err.to_str())
        expect(d.line == line, err.to_str())
        expect(d.message.contains(detail), err.to_str())
    }
    assert(failed)
}

implicit_teardown := proc(root: Str) {
    mut vm := TilVm.new(root)
    vm.load_file("guest.til")!
    // ASAP inserts TilVm.delete here, which calls its private close helper.
}

HostNumber := I64
HostBinary := func(HostNumber, HostNumber) returns HostNumber
HostSize := func(USize) returns USize
HostScalars := func(Bool, I32, U64, F32, F64) returns Bool
HostText := func(Str) returns Str
HostOwned := func(own Str) returns Str
HostOwnedMutable := func(own mut Str) returns Str
HostOwnedAction := proc(own Str)
HostMutable := proc(mut Str)
HostRead := func(Str)
HostVariadic := func(values: ..I64) returns I64
HostKeywords := func(values: ...) returns I64
HostThrow := struct {}
HostThrowing := func(I64) returns I64 throws HostThrow
HostBorrowed := func(Str) returns ref Str
HostReader := func() returns Str
HostTick := proc() returns I64
HostReal := func(F64) returns F64
HostMutableInt := proc(mut I32)
HostShallow := func(Str) returns shallow Str
HostAccumulator := proc(I64) returns I64
HostRecord := struct { value := 0 }
HostRecordCall := func(HostRecord) returns I64

lookup_contract := func(signature: Type) returns FuncSig {
    return func_sig_of(til_type_name(signature))
}

lookup_failure := proc(mut session: InterpSession, mut program: LoadedProgram,
    name: Str, signature: FuncSig, detail: Str) {
    program.ctx.diagnostics = Vec(SourceDiagnostic).new()
    result := interp_session_lookup_function(session, program, name, signature)
    assert(result.is_none())
    assert(program.ctx.diagnostics.len() == 1)
    expect(program.ctx.diagnostics[0].message.contains(detail), program.ctx.diagnostics[0].render())
    // A bad lookup is validation, not a failed guest invocation or reload.
    assert(program.ctx.eval.eval_aborted.not())
    assert(session.retained_programs.len() == 1)
}

call_checked := proc(mut session: InterpSession, mut program: LoadedProgram,
    name: Str, signature: Type, mut arguments: Tuple) returns Tuple {
    result := interp_session_call_function(session, program, name, lookup_contract(signature), arguments)
    if result.is_none() {
        for diagnostic in program.ctx.diagnostics { diagnostic.print() }
        panic("guest call failed: ", name)
    }
    assert(program.ctx.eval.eval_aborted.not())
    return Option(Tuple).take(own result)
}

// Exercise the evaluator seam through the installed SDK. The returned
// binding is a session borrow, not a new public native-callable representation.
checked_lookup := proc(root: Str) {
    File.writefile("lookup_guest.til", format(
        "mode lib\nGuestNumber := I64\n",
        "binary := func(left: GuestNumber, right: GuestNumber) returns GuestNumber { return left + right }\n",
        "size := func(value: USize) returns USize { return value }\n",
        "scalars := func(flag: Bool, a: I32, b: U64, c: F32, d: F64) returns Bool { return flag && a >= 0 && b >= 0 && c <= d.to_f32() }\n",
        "real := func(value: F64) returns F64 { return value * 2.0 }\n",
        "increment := proc(mut value: I32) { noop_proc(); value = value + 2 }\n",
        "text := func(value: Str) returns Str { return value.clone() }\n",
        "owned := func(own value: Str) returns Str { return value }\n",
        "owned_changed := func(own mut value: Str) returns Str { value = format(value, \"#\"); return value }\n",
        "fail_owned := proc(own value: Str) { noop_proc(); panic(value) }\n",
        "changed := proc(mut value: Str) { value = format(value, \"!\"); noop_proc() }\n",
        "read := func(value: Str) { assert(value.len() >= 0) }\n",
        "variadic := func(values: ..I64) returns I64 { return values.len().to_i64() }\n",
        "keywords := func(values: ...) returns I64 { return values.len().to_i64() }\n",
        "HostThrow := struct {}\nthrowing := func(value: I64) returns I64 throws HostThrow { if value < 0 { throw HostThrow() }; return value }\n",
        "borrowed := func(value: Str) returns ref Str { return value }\n",
        "view := func(value: Str) returns shallow Str { return value.substr(1, 3) }\n",
        "literal := func() returns Str { return \"guest literal\" }\n",
        "empty := func() returns Str { return \"\" }\n",
        "GuestReader := func() returns Str\n",
        "make_reader := func(value: Str) returns GuestReader { saved := value.clone(); return func() returns Str [own saved] { return saved.clone() } }\n",
        "reader := make_reader(\"retained capture\")\n",
        "Accumulator := proc(I64) returns I64\n",
        "make_accumulator := func() returns Accumulator { total := 0; return proc(value: I64) returns I64 [own mut total] { noop_proc(); total = total + value; return total } }\n",
        "mut accumulator := make_accumulator()\nreplace_accumulator := proc() { noop_proc(); accumulator = make_accumulator() }\n",
        "mut calls := 0\ntick := proc() returns I64 { calls = calls + 1; noop_proc(); return calls }\n",
        "fail_call := proc(mut value: Str) { noop_proc(); value = format(value, \"?\"); panic(\"call failed\") }\n",
        "quit_call := proc(mut value: Str) { noop_proc(); value = format(value, \"!\"); exit(0) }\n",
        "priv helper := func(a: I64, b: I64) returns I64 { return a + b }\nhelper_alias := helper\n",
        "alias := binary\nnumber := 7\nGuestSig := func(I64) returns I64\n",
        "GuestRecord := struct { value := 0 }\nrecord := func(value: GuestRecord) returns I64 { return value.value }\n"))
    mut lp := load_program("lookup_guest.til", realpath_str(root), realpath_str("."),
        format(realpath_str(root), "/src/c/ext.c"), Vec(Str).new(), "", true)
    assert(lp.load_errors == 0)
    if init_and_type_program_errors(lp, false) != 0 {
        for diagnostic in lp.ctx.diagnostics { diagnostic.print() }
        panic("lookup guest should typecheck")
    }
    mut raw : Dynamic = interp_program_to_heap(own lp)
    ref mut program : LoadedProgram = to_ptr(raw)
    mut session := InterpSession(capture_output = true)
    interp_session_start(session, Vec(Str).new())
    interp_session_retain_program(session, raw)
    assert(interp_session_prepare_context(session, program, "") == 0)
    interp_session_eval_core_once(session, program)
    interp_session_eval_user_units(session, program)
    assert(program.ctx.eval.eval_aborted.not())

    binary := lookup_contract(HostBinary)
    found := interp_session_lookup_function(session, program, "binary", binary)
    assert(found.is_some())
    assert(hb_func_def(found.unwrap()).is_some())
    assert(interp_session_lookup_function(session, program, "alias", binary).is_some())
    assert(interp_session_lookup_function(session, program, "helper_alias", binary).is_some())
    assert(interp_session_lookup_function(session, program, "size", lookup_contract(HostSize)).is_some())
    assert(interp_session_lookup_function(session, program, "scalars", lookup_contract(HostScalars)).is_some())
    assert(interp_session_lookup_function(session, program, "text", lookup_contract(HostText)).is_some())
    assert(interp_session_lookup_function(session, program, "owned", lookup_contract(HostOwned)).is_some())
    assert(interp_session_lookup_function(session, program, "changed", lookup_contract(HostMutable)).is_some())
    assert(interp_session_lookup_function(session, program, "read", lookup_contract(HostRead)).is_some())
    assert(interp_session_lookup_function(session, program, "variadic", lookup_contract(HostVariadic)).is_some())
    assert(interp_session_lookup_function(session, program, "keywords", lookup_contract(HostKeywords)).is_some())
    assert(interp_session_lookup_function(session, program, "throwing", lookup_contract(HostThrowing)).is_some())
    assert(interp_session_lookup_function(session, program, "borrowed", lookup_contract(HostBorrowed)).is_some())
    reader := interp_session_lookup_function(session, program, "reader", lookup_contract(HostReader))
    assert(reader.is_some())
    reader_def := hb_func_def(reader.unwrap())
    assert(funcdef_of(reader_def.unwrap()).captures.len() > 0)

    // Even a caller who discovers a compiler-mangled private name cannot
    // use it as an exported guest symbol. Exported aliases remain callable.
    ref entry : ImportUnit = program.ctx.imported[program.units[program.units.len() - 1].path]
    mut private_checked := false
    for statement in entry.ast.children {
        switch statement.node_type {
        case .Decl(d):
            if d.is_priv {
                lookup_failure(session, program, d.name, binary, "not exported")
                private_checked = true
            }
        case:
        }
    }
    assert(private_checked)

    lookup_failure(session, program, "missing", binary, "not found")
    lookup_failure(session, program, "print_single", lookup_contract(HostRead), "not exported")
    lookup_failure(session, program, "number", binary, "not a function")
    lookup_failure(session, program, "GuestSig", binary, "no function implementation")
    lookup_failure(session, program, "record", binary, "signature mismatch")
    lookup_failure(session, program, "text", lookup_contract(HostOwned), "signature mismatch")
    lookup_failure(session, program, "changed", lookup_contract(HostRead), "signature mismatch")
    lookup_failure(session, program, "variadic", binary, "signature mismatch")
    lookup_failure(session, program, "keywords", lookup_contract(HostVariadic), "signature mismatch")
    lookup_failure(session, program, "binary", lookup_contract(HostThrowing), "signature mismatch")
    lookup_failure(session, program, "text", lookup_contract(HostBorrowed), "signature mismatch")
    assert(interp_session_lookup_function(session, program, "binary", binary).is_some())

    mut numbers := Tuple.new()
    numbers.push(I64, own 19)
    numbers.push(I64, own 23)
    sum := call_checked(session, program, "binary", HostBinary, numbers)
    ref answer : I64 = sum.get(0)
    assert(answer == 42)
    alias_sum := call_checked(session, program, "alias", HostBinary, numbers)
    ref alias_answer : I64 = alias_sum.get(0)
    assert(alias_answer == 42)
    mut scalar_values := Tuple.new()
    scalar_values.push(Bool, own true)
    narrow : I32 = 17
    scalar_values.push(I32, own narrow)
    scalar_values.push(U64, own U64.MAX.clone())
    small : F32 = 1.25
    large : F64 = 2.5
    scalar_values.push(F32, own small)
    scalar_values.push(F64, own large)
    boolean_result := call_checked(session, program, "scalars", HostScalars, scalar_values)
    ref boolean : Bool = boolean_result.get(0)
    assert(boolean)
    mut real_argument := Tuple.new()
    real_value : F64 = 1.75
    real_argument.push(F64, own real_value)
    real_result := call_checked(session, program, "real", HostReal, real_argument)
    ref doubled : F64 = real_result.get(0)
    assert(doubled == 3.5)
    mut int_argument := Tuple.new()
    initial_int : I32 = 40
    int_argument.push(I32, own initial_int)
    int_result := call_checked(session, program, "increment", HostMutableInt, int_argument)
    ref updated_int : I32 = int_argument.get(0)
    assert(updated_int == 42 && int_result.len() == 0)
    mut no_arguments := Tuple.new()
    for i in 1..4 {
        count := call_checked(session, program, "tick", HostTick, no_arguments)
        ref got : I64 = count.get(0)
        assert(got == i)
    }

    mut text_values := Tuple.new()
    // Runtime-owned input, not a folded immutable literal whose backing
    // bytes the interpreter may legitimately share.
    File.writefile("call_input.txt", "host value")
    text_values.push(Str, own File.readfile("call_input.txt"))
    retained_result := call_checked(session, program, "owned", HostOwned, text_values)
    ref original_text : Str = text_values.get(0)
    ref owned_result : Str = retained_result.get(0)
    assert(original_text == "host value" && owned_result == "host value")
    assert(original_text.c_str.ptr_eq(owned_result.c_str).not())
    changed := call_checked(session, program, "changed", HostMutable, text_values)
    assert(changed.len() == 0)
    ref updated_text : Str = text_values.get(0)
    assert(updated_text == "host value!")
    copied_borrow := call_checked(session, program, "borrowed", HostBorrowed, text_values)
    ref copied_text : Str = copied_borrow.get(0)
    assert(copied_text == "host value!")
    assert(updated_text.c_str.ptr_eq(copied_text.c_str).not())
    captured_result := call_checked(session, program, "reader", HostReader, no_arguments)
    ref captured_text : Str = captured_result.get(0)
    assert(captured_text == "retained capture")
    literal_result := call_checked(session, program, "literal", HostReader, no_arguments)
    empty_result := call_checked(session, program, "empty", HostReader, no_arguments)
    view_result := call_checked(session, program, "view", HostShallow, text_values)
    own_mut_result := call_checked(session, program, "owned_changed", HostOwnedMutable, text_values)
    ref own_mut_text : Str = own_mut_result.get(0)
    ref own_mut_input : Str = text_values.get(0)
    assert(own_mut_text == "host value!#" && own_mut_input == "host value!")

    // Validation fails before any invocation, preserving both arguments
    // and the count maintained by earlier successful calls.
    rejected := interp_session_call_function(session, program, "binary", binary, text_values)
    assert(rejected.is_none() && program.ctx.eval.eval_aborted.not())
    assert(program.ctx.diagnostics[0].message.contains("count mismatch"))
    mut wrong_type := Tuple.new()
    wrong_type.push(Str, own "not an integer")
    wrong_type.push(I64, own 3)
    rejected_type := interp_session_call_function(session, program, "binary", binary, wrong_type)
    assert(rejected_type.is_none() && program.ctx.eval.eval_aborted.not())
    assert(program.ctx.diagnostics[0].message.contains("type/width mismatch"))
    keyword_result := interp_session_call_function(session, program, "keywords", lookup_contract(HostKeywords), no_arguments)
    assert(keyword_result.is_some() && program.ctx.eval.eval_aborted.not())
    ref keyword_count : I64 = keyword_result.unwrap().get(0)
    assert(keyword_count == 0)

    failed := interp_session_call_function(session, program, "fail_call", lookup_contract(HostMutable), text_values)
    assert(failed.is_none() && program.ctx.eval.eval_aborted)
    assert(program.ctx.eval.exit_status.unwrap() == 1)
    ref after_failure : Str = text_values.get(0)
    assert(after_failure == "host value!?")
    failure_result := interp_session_result(program.ctx)
    assert(failure_result.aborted && failure_result.output.len() > 0)
    // The engine leaves state for its driver; another invocation explicitly
    // starts a new operation. It does not reload initializers or roll back.
    count_after_failure := call_checked(session, program, "tick", HostTick, no_arguments)
    ref final_count : I64 = count_after_failure.get(0)
    assert(final_count == 4)
    failed_owned := interp_session_call_function(session, program, "fail_owned", lookup_contract(HostOwnedAction), text_values)
    assert(failed_owned.is_none() && program.ctx.eval.exit_status.unwrap() == 1)
    ref after_owned_failure : Str = text_values.get(0)
    assert(after_owned_failure == "host value!?")
    File.writefile("other_call_guest.til", "mode lib\nmut calls := 100\ntick := proc() returns I64 { noop_proc(); calls = calls + 1; return calls }\n")
    mut other_lp := load_program("other_call_guest.til", realpath_str(root), realpath_str("."),
        format(realpath_str(root), "/src/c/ext.c"), Vec(Str).new(), "", true)
    assert(other_lp.load_errors == 0 && init_and_type_program_errors(other_lp, false) == 0)
    mut other_raw : Dynamic = interp_program_to_heap(own other_lp)
    ref mut other_program : LoadedProgram = to_ptr(other_raw)
    mut other_session := InterpSession(capture_output = true)
    interp_session_start(other_session, Vec(Str).new())
    interp_session_retain_program(other_session, other_raw)
    assert(interp_session_prepare_context(other_session, other_program, "") == 0)
    interp_session_eval_core_once(other_session, other_program)
    interp_session_eval_user_units(other_session, other_program)
    other_count := call_checked(other_session, other_program, "tick", HostTick, no_arguments)
    ref other_value : I64 = other_count.get(0)
    assert(other_value == 101)
    own_count := call_checked(session, program, "tick", HostTick, no_arguments)
    ref own_value : I64 = own_count.get(0)
    assert(own_value == 5)
    interp_session_free(other_session)
    continued := call_checked(session, program, "tick", HostTick, no_arguments)
    ref continued_value : I64 = continued.get(0)
    assert(continued_value == 6)
    quit := interp_session_call_function(session, program, "quit_call", lookup_contract(HostMutable), text_values)
    assert(quit.is_none() && program.ctx.eval.eval_aborted)
    assert(program.ctx.eval.exit_status.unwrap() == 0)

    interp_session_free(session)
    // Host results are owned copies, not views into dead guest arguments,
    // globals, closure captures or the just-freed SDK program structures.
    ref survived_owned : Str = retained_result.get(0)
    ref survived_borrow : Str = copied_borrow.get(0)
    ref survived_capture : Str = captured_result.get(0)
    ref survived_literal : Str = literal_result.get(0)
    ref survived_empty : Str = empty_result.get(0)
    ref survived_view : Str = view_result.get(0)
    assert(survived_owned == "host value")
    assert(survived_borrow == "host value!")
    assert(survived_capture == "retained capture")
    assert(survived_literal == "guest literal")
    assert(survived_empty.len() == 0 && Str.from_c_str(survived_empty.c_str).len() == 0)
    assert(survived_view == "ost")
}

expect_lookup_failure := proc(mut vm: TilVm, name: Str, detail: Str, location: Str = "", signature: Type = Type.None) {
    callback := vm.lookup(name, signature)?
    catch (err: TilVmError) {
        assert(err.phase == "lookup")
        expect(err.to_str().contains(detail), err.to_str())
        if location.len() > 0 {
            expect(err.diagnostics[0].path.ends_with(location), err.to_str())
            assert(err.diagnostics[0].line == 2)
        }
        return
    }
    own callback.delete()
    panic("lookup unexpectedly succeeded: ", name)
}

HostKeyBinding := struct { own callback: TilVmCallback }

retain_callback := proc(mut vm: TilVm) returns HostKeyBinding {
    callback := vm.lookup("on_key")!
    return HostKeyBinding(callback = callback)
}

callback_owner_lifetime := proc(root: Str) {
    mut vm := TilVm.new(root)
    vm.load_file("callback_guest.til")!
    mut binding := retain_callback(vm)
    // vm has no explicit use after lookup. Its borrow in callback must keep
    // the whole session alive through both calls and callback destruction.
    binding.callback.call()!
    binding.callback.call()!
}

callback_explicit_teardown := proc(root: Str) {
    mut vm := TilVm.new(root)
    vm.load_file("callback_guest.til")!
    mut callback := vm.lookup("on_key")!
    callback.call()!
    own callback.delete()
    own vm.delete()
    // Both resources can die before the rest of the host's scope.
    print_flush()
}

callback_tests := proc(root: Str) {
    File.writefile("callback_import.til", "mode lib\nimported_arg := func(value: I64) { assert(value >= 0) }\n")
    File.writefile("callback_guest.til", format(
        "mode lib\nimport(\"./callback_import\")\nmut count := 0\n",
        "on_key := proc() { noop_proc(); count++; assert(count <= 2) }\n",
        "check_two := proc() { noop_proc(); assert(count == 2) }\n",
        "bad := proc() { noop_proc(); panic(\"callback failure\") }\n",
        "quit := func() { exit(0) }\n",
        "with_arg := func(value: I64) { assert(value >= 0) }\n",
        "with_result := func() returns Str { return \"result\" }\n",
        "Failure := struct {}\nthrowing := func() throws Failure { throw Failure() }\n",
        "number := 7\nSignature := proc()\n",
        "priv hidden := proc() { noop_proc() }\nexported := hidden\n",
        "Callback := proc()\n",
        "make_callback := func() returns Callback {\n",
        "    text := format(\"captured\", \" string\")\n",
        "    return proc() [own mut text] { noop_proc(); text = format(text, \"!\"); assert(text.len() <= 17) }\n",
        "}\nclosure := make_callback()\n"))
    mut vm := TilVm.new(root)
    expect_lookup_failure(vm, "on_key", "load a module")
    vm.load_file("callback_guest.til")!
    expect_lookup_failure(vm, "missing", "not found")
    expect_lookup_failure(vm, "print_flush", "not exported")
    expect_lookup_failure(vm, "number", "not a function")
    expect_lookup_failure(vm, "Signature", "no function implementation")
    expect_lookup_failure(vm, "with_arg", "no arguments")
    expect_lookup_failure(vm, "with_result", "no arguments")
    expect_lookup_failure(vm, "throwing", "throws clause")
    expect_lookup_failure(vm, "imported_arg", "no arguments", "callback_import.til")
    mut callback := vm.lookup("on_key")!
    callback.call()!
    // Another VM can be destroyed while this retained callback stays live.
    callback_owner_lifetime(root)
    callback_explicit_teardown(root)
    callback.call()!
    mut check := vm.lookup("check_two")!
    check.call()!
    mut closure := vm.lookup("closure")!
    closure.call()!
    mut copied_closure := closure.clone()
    closure.call()!
    own closure.delete()
    // A normal owning copy has independent captures, still borrowing the VM.
    copied_closure.call()!
    mut alias := vm.lookup("exported")!
    alias.call()!
    mut bad := vm.lookup("bad")!
    mut failed := false
    bad.call()?
    catch (err: TilVmError) {
        failed = true
        assert(err.phase == "call")
        expect(err.to_str().contains("callback failure"), err.to_str())
    }
    assert(failed)
    mut quit := vm.lookup("quit")!
    mut exited := false
    quit.call()?
    catch (err: TilVmError) {
        exited = true
        assert_eq(I64, err.exit_status.unwrap(), 0)
    }
    assert(exited)
    // Abort state is reset at invocation, not by destroying the live VM.
    check.call()!
}

expect_call_failure := proc(mut callback: TilVmCallback, mut arguments: Tuple, detail: Str, path: Str = "lookup_guest.til", keywords: KwargsMap = KwargsMap.new()) returns TilVmError {
    result := callback.call(arguments, keywords = keywords)?
    catch (err: TilVmError) {
        assert(err.phase == "call")
        expect(err.to_str().contains(detail), err.to_str())
        assert(err.diagnostics.len() > 0)
        expect(err.diagnostics[0].path.ends_with(path), err.to_str())
        assert(err.diagnostics[0].line > 0)
        return err
    }
    own result.delete()
    panic("callback unexpectedly succeeded")
}

// Results must be ordinary host values, not new borrows of the callback,
// its VM, or input Tuple. Explicit destruction makes this a static lifetime
// check as well as an ASAN check of literals, views and borrowed results.
callback_result := proc(root: Str, name: Str, signature: Type, mut arguments: Tuple) returns Tuple {
    mut vm := TilVm.new(root)
    vm.load_file("lookup_guest.til")!
    mut callback := vm.lookup(name, signature)!
    result := callback.call(arguments)!
    own callback.delete()
    own vm.delete()
    return result
}

typed_callback_tests := proc(root: Str) {
    mut vm := TilVm.new(root)
    vm.load_file("lookup_guest.til")!
    expect_lookup_failure(vm, "binary", "signature mismatch", signature = HostOwned)
    expect_lookup_failure(vm, "owned", "signature mismatch", signature = HostText)
    expect_lookup_failure(vm, "changed", "signature mismatch", signature = HostRead)
    expect_lookup_failure(vm, "borrowed", "signature mismatch", signature = HostText)
    mut variadic := vm.lookup("variadic", HostVariadic)!
    empty_tail := variadic.call()!
    ref empty_count : I64 = empty_tail.get(0)
    assert(empty_count == 0)
    mut keywords := vm.lookup("keywords", HostKeywords)!
    empty_keywords := keywords.call()!
    ref keyword_count : I64 = empty_keywords.get(0)
    assert(keyword_count == 0)
    mut throwing := vm.lookup("throwing", HostThrowing)!
    mut throw_args := Tuple.new()
    throw_args.push(I64, own -1)
    mut caught_throw := false
    call_throwing(HostThrow)(throwing, throw_args)?
    catch (e: HostThrow) { caught_throw = true }
    catch (e: TilVmError) { panic(e.to_str()) }
    assert(caught_throw)
    expect_lookup_failure(vm, "record", "signature mismatch", signature = HostRecordCall)
    expect_lookup_failure(vm, "binary", "named function-signature type", signature = Str)

    mut numbers := Tuple.new()
    numbers.push(I64, own 19)
    numbers.push(I64, own 23)
    mut binary := vm.lookup("alias", HostBinary)!
    sum := binary.call(numbers)!
    ref answer : I64 = sum.get(0)
    assert(answer == 42)
    mut empty := Tuple.new()
    bad_count := expect_call_failure(binary, empty, "count mismatch")
    assert(bad_count.exit_status.is_none())
    mut wrong := Tuple.new()
    wrong.push(Str, own "wrong")
    wrong.push(I64, own 23)
    bad_type := expect_call_failure(binary, wrong, "type/width mismatch")
    assert(bad_type.exit_status.is_none())
    // Reject a corrupt host width before reading or running guest code.
    numbers.type_sizes[0] = 4
    bad_width := expect_call_failure(binary, numbers, "type/width mismatch")
    numbers.type_sizes[0] = I64.size()
    assert(bad_width.exit_status.is_none())
    recovered := binary.call(numbers)!
    ref recovered_answer : I64 = recovered.get(0)
    assert(recovered_answer == 42)

    mut scalars := vm.lookup("scalars", HostScalars)!
    mut packed := Tuple.new()
    packed.push(Bool, own true)
    narrow : I32 = 17
    packed.push(I32, own narrow.clone())
    packed.push(U64, own U64.MAX.clone())
    small : F32 = 1.25
    large : F64 = 2.5
    packed.push(F32, own small)
    packed.push(F64, own large.clone())
    scalar_result := scalars.call(packed)!
    ref flag : Bool = scalar_result.get(0)
    assert(flag)
    mut real := vm.lookup("real", HostReal)!
    mut real_args := Tuple.new()
    real_args.push(F64, own large.clone())
    real_result := real.call(real_args)!
    ref doubled : F64 = real_result.get(0)
    assert(doubled == 5.0)
    mut size := vm.lookup("size", HostSize)!
    mut size_args := Tuple.new()
    size_args.push(USize, own USize.MAX.clone())
    size_result := size.call(size_args)!
    ref size_value : USize = size_result.get(0)
    assert(size_value == USize.MAX)
    mut increment := vm.lookup("increment", HostMutableInt)!
    mut int_args := Tuple.new()
    int_args.push(I32, own narrow.clone())
    no_result := increment.call(int_args)!
    ref updated_int : I32 = int_args.get(0)
    assert(updated_int == 19 && no_result.len() == 0)

    mut text := Tuple.new()
    text.push(Str, own File.readfile("call_input.txt"))
    mut owned := vm.lookup("owned", HostOwned)!
    owned_result := owned.call(text)!
    ref host_text : Str = text.get(0)
    ref guest_copy : Str = owned_result.get(0)
    assert(host_text == "host value" && guest_copy == host_text)
    assert(host_text.c_str.ptr_eq(guest_copy.c_str).not())
    mut changed := vm.lookup("changed", HostMutable)!
    changed.call(text)!
    ref updated_text : Str = text.get(0)
    assert(updated_text == "host value!")
    mut owned_mut := vm.lookup("owned_changed", HostOwnedMutable)!
    owned_mut_result := owned_mut.call(text)!
    ref owned_mut_text : Str = owned_mut_result.get(0)
    ref unchanged_input : Str = text.get(0)
    assert(owned_mut_text == "host value!#" && unchanged_input == "host value!")

    mut accumulator := vm.lookup("accumulator", HostAccumulator)!
    mut steps := Tuple.new()
    steps.push(I64, own 1)
    first := accumulator.call(steps)!
    ref first_count : I64 = first.get(0)
    expect(first_count == 1, format("first retained accumulator call returned ", first_count.to_str()))
    mut copied := accumulator.clone()
    second := accumulator.call(steps)!
    copied_second := copied.call(steps)!
    ref second_count : I64 = second.get(0)
    ref copied_count : I64 = copied_second.get(0)
    assert(second_count == 2 && copied_count == 2)
    mut replace := vm.lookup("replace_accumulator")!
    replace.call()!
    retained := accumulator.call(steps)!
    ref retained_count : I64 = retained.get(0)
    assert(retained_count == 3)
    mut replacement := vm.lookup("accumulator", HostAccumulator)!
    fresh := replacement.call(steps)!
    ref fresh_count : I64 = fresh.get(0)
    assert(fresh_count == 1)

    mut tick := vm.lookup("tick", HostTick)!
    invalid_tick := expect_call_failure(tick, steps, "count mismatch")
    assert(invalid_tick.exit_status.is_none())
    tick_result := tick.call()!
    ref tick_count : I64 = tick_result.get(0)
    assert(tick_count == 1)
    mut fail := vm.lookup("fail_call", HostMutable)!
    failure := expect_call_failure(fail, text, "call failed")
    assert(failure.exit_status.unwrap() == 1)
    ref after_failure : Str = text.get(0)
    assert(after_failure == "host value!?")
    mut fail_owned := vm.lookup("fail_owned", HostOwnedAction)!
    owned_failure := expect_call_failure(fail_owned, text, "host value!?")
    assert(owned_failure.exit_status.unwrap() == 1)
    mut quit := vm.lookup("quit_call", HostMutable)!
    exit_error := expect_call_failure(quit, text, "status 0")
    assert(exit_error.exit_status.unwrap() == 0)
    // Failure preserves global state and retained captures, even after exit(0).
    tick_after_failure := tick.call()!
    ref next_tick : I64 = tick_after_failure.get(0)
    assert(next_tick == 2)
    after_abort := copied.call(steps)!
    ref captured_count : I64 = after_abort.get(0)
    assert(captured_count == 3)

    literal := callback_result(root, "literal", HostReader, empty)
    borrowed := callback_result(root, "borrowed", HostBorrowed, text)
    view := callback_result(root, "view", HostShallow, text)
    captured := callback_result(root, "reader", HostReader, empty)
    empty_text := callback_result(root, "empty", HostReader, empty)
    own text.delete()
    ref literal_text : Str = literal.get(0)
    ref borrowed_text : Str = borrowed.get(0)
    ref view_text : Str = view.get(0)
    ref captured_text : Str = captured.get(0)
    ref zero_text : Str = empty_text.get(0)
    assert(literal_text == "guest literal" && borrowed_text == "host value!?!")
    assert(view_text == "ost" && captured_text == "retained capture")
    assert(zero_text.len() == 0 && Str.from_c_str(zero_text.c_str).len() == 0)
    assert(failure.to_str().contains("call failed") && exit_error.exit_status.unwrap() == 0)
}

TransformError := struct { code: I32 = 0; message := "" }
ThrowTransform := proc(mut Str, I64) returns Str throws TransformError
WrongTransform := proc(mut Str, I64) returns Str throws HostThrow

throwing_callback_tests := proc(root: Str) {
    File.writefile("guest.til", format(
        "mode lib\nTransformError := struct { code: I32 = 0; message := \"\" }\n",
        "mut count := 0\n",
        "message := format(\"guest \", \"view payload\")\n",
        "read_count := proc() returns I64 { noop_proc(); return count }\n",
        "transform := proc(mut text: Str, action: I64 = 0) returns Str throws TransformError {\n",
        "noop_proc(); count = count + 1; text = format(text, \"!\");\n",
        "if action == 1 { throw TransformError(code = 7, message = format(\"failure \", count.to_str())) };\n",
        "if action == 2 { panic(\"guest panic\") }; if action == 3 { exit(0) };\n",
        "if action == 4 { throw TransformError(code = 8, message = \"guest literal\") };\n",
        "if action == 5 { throw TransformError(code = 9, message = message.substr(6, 12)) };\n",
        "return text.clone() }\n"))
    mut vm := TilVm.new(root)
    vm.load_file("guest.til")!
    mut callback := vm.lookup("transform", ThrowTransform)!
    expect_lookup_failure(vm, "transform", "signature mismatch", signature = WrongTransform)
    mut read_count := vm.lookup("read_count", HostTick)!
    mut wrong_args := Tuple.new()
    wrong_args.push(Str, own format("unchanged", " input"))
    wrong_args.push(I64, own 0)
    mut wrong_error := false
    call_throwing(HostThrow)(callback, wrong_args)?
    catch (err: HostThrow) { panic("wrong error type executed guest code") }
    catch (err: TilVmError) { wrong_error = err.to_str().contains("error type does not match") }
    assert(wrong_error)
    mut rejected_plain := false
    callback.call(wrong_args)?
    catch (err: TilVmError) { rejected_plain = err.to_str().contains("requires call_throwing") }
    assert(rejected_plain)
    mut empty := Tuple.new()
    mut rejected_count := false
    call_throwing(TransformError)(callback, empty)?
    catch (err: TransformError) { panic("invalid arguments executed guest code") }
    catch (err: TilVmError) { rejected_count = err.to_str().contains("count mismatch") }
    assert(rejected_count)
    mut bad_types := Tuple.new()
    bad_types.push(Str, own format("unchanged", " input"))
    bad_types.push(Bool, own true)
    mut rejected_type := false
    call_throwing(TransformError)(callback, bad_types)?
    catch (err: TransformError) { panic("wrong argument type executed guest code") }
    catch (err: TilVmError) { rejected_type = err.to_str().contains("type/width mismatch") }
    assert(rejected_type)
    count_result := read_count.call()!
    ref initial_count : I64 = count_result.get(0)
    assert(initial_count == 0)
    ref unchanged : Str = wrong_args.get(0)
    assert(unchanged == "unchanged input")
    mut kept := Vec(TransformError).new()
    for action in 0..6 {
        mut args := Tuple.new()
        args.push(Str, own format("host", " text"))
        args.push(I64, own action.clone())
        mut caught := false
        result := call_throwing(TransformError)(callback, args)?
        catch (err: TransformError) {
            assert(action == 1 || action >= 4)
            kept.push(own err.clone())
            caught = true
        }
        catch (err: TilVmError) {
            assert(action == 2 || action == 3)
            if action == 2 { assert(err.to_str().contains("guest panic")) }
            if action == 3 { assert(err.exit_status.unwrap() == 0) }
            caught = true
        }
        if action == 0 { ref text : Str = result.get(0); assert(text == "host text!") }
        else { assert(caught) }
        ref updated : Str = args.get(0)
        assert(updated == "host text!")
    }
    mut args := Tuple.new()
    args.push(Str, own format("ag", "ain"))
    args.push(I64, own 0)
    result := call_throwing(TransformError)(callback, args)!
    final_count_result := read_count.call()!
    ref final_count : I64 = final_count_result.get(0)
    assert(final_count == 7)
    own read_count.delete()
    own callback.delete()
    own vm.delete()
    ref text : Str = result.get(0)
    assert(text == "again!")
    assert(kept[0].code == 7 && kept[0].message == "failure 2")
    assert(kept[1].code == 8 && kept[1].message == "guest literal")
    assert(kept[2].code == 9 && kept[2].message == "view payload")
}

throwing_schema_tests := proc(root: Str) {
    // Identical type names do not excuse differing field types or ownership.
    for fields : Str in array(Str, "code: I64 = 0; message := \"\"",
        "code: I32 = 0; ref message: Str = \"\"") {
        File.writefile("guest.til", format("mode lib\nTransformError := struct { ", fields, " }\n",
            "transform := proc(mut text: Str, action: I64) returns Str throws TransformError {\n",
            "noop_proc(); text = \"executed\"; if action == 1 { throw TransformError() }; return text.clone() }\n"))
        mut vm := TilVm.new(root)
        vm.load_file("guest.til")!
        expect_lookup_failure(vm, "transform", "shared callback error schema", signature = ThrowTransform)
    }
}

TransformFailed := struct { code: I32 = 0; message := "" }
MultiTransform := proc(mut Str, I64) returns Str throws TransformError, TransformFailed, HostThrow
MultiAlias := MultiTransform
WrongOrder := proc(mut Str, I64) returns Str throws TransformFailed, TransformError, HostThrow
invoke_multi := call_throwing(MultiTransform)

multiple_error_callback_tests := proc(root: Str) {
    File.writefile("guest.til", format(
        "mode lib\nTransformError := struct { code: I32 = 0; message := \"\" }\n",
        "TransformFailed := struct { code: I32 = 0; message := \"\" }\nHostThrow := struct {}\n",
        "mut count := 0\nmessage := format(\"guest \", \"payload\")\n",
        "read_count := proc() returns I64 { noop_proc(); return count }\n",
        "transform := proc(mut text: Str, action: I64 = 0) returns Str throws TransformError, TransformFailed, HostThrow {\n",
        "noop_proc(); count = count + 1; text = format(text, \"!\");\n",
        "if action == 1 { throw TransformError(code = 11, message = \"first error\") };\n",
        "if action == 2 { throw TransformFailed(code = 22, message = message.substr(6, 7)) };\n",
        "if action == 3 { throw HostThrow() }; if action == 4 { panic(\"multi panic\") };\n",
        "if action == 5 { exit(0) }; return text.clone() }\n"))
    mut vm := TilVm.new(root)
    vm.load_file("guest.til")!
    mut callback := vm.lookup("transform", MultiTransform)!
    expect_lookup_failure(vm, "transform", "signature mismatch", signature = WrongOrder)
    expect_lookup_failure(vm, "transform", "signature mismatch", signature = ThrowTransform)
    mut args := Tuple.new()
    args.push(Str, own format("host", " input"))
    args.push(I64, own 0)
    mut rejected := false
    call_throwing(WrongOrder)(callback, args)?
    catch (err: TransformError) { panic("unexpected guest error") }
    catch (err: TransformFailed) { panic("unexpected guest error") }
    catch (err: HostThrow) { panic("unexpected guest error") }
    catch (err: TilVmError) { rejected = err.to_str().contains("adapter signature") }
    assert(rejected)
    mut reader := vm.lookup("read_count", HostTick)!
    before := reader.call()!
    ref before_count : I64 = before.get(0)
    assert(before_count == 0)
    mut first := TransformError()
    mut second := TransformFailed()
    for action in 0..6 {
        mut input := Tuple.new()
        input.push(Str, own format("host", " input"))
        input.push(I64, own action.clone())
        mut caught := false
        output := invoke_multi(callback, input)?
        catch (err: TransformError) { assert(action == 1); first = err; caught = true }
        catch (err: TransformFailed) { assert(action == 2); second = err; caught = true }
        catch (err: HostThrow) { assert(action == 3); caught = true }
        catch (err: TilVmError) {
            assert(action == 4 || action == 5)
            if action == 4 { assert(err.to_str().contains("multi panic")) }
            if action == 5 { assert(err.exit_status.unwrap() == 0) }
            caught = true
        }
        if action == 0 { ref text : Str = output.get(0); assert(text == "host input!") }
        else { assert(caught) }
        ref updated : Str = input.get(0)
        assert(updated == "host input!")
    }
    output := call_throwing(MultiAlias)(callback, args)!
    after := reader.call()!
    ref after_count : I64 = after.get(0)
    assert(after_count == 7)
    own reader.delete()
    own callback.delete()
    own vm.delete()
    ref text : Str = output.get(0)
    assert(text == "host input!")
    assert(first.code == 11 && first.message == "first error")
    assert(second.code == 22 && second.message == "payload")
    // Validate every declared schema, including an error after a valid one.
    File.writefile("guest.til", format(
        "mode lib\nTransformError := struct { code: I32 = 0; message := \"\" }\n",
        "TransformFailed := struct { code: I64 = 0; message := \"\" }\nHostThrow := struct {}\n",
        "transform := proc(mut text: Str, action: I64) returns Str throws TransformError, TransformFailed, HostThrow {\n",
        "noop_proc(); text = \"executed\"; if action == 1 { throw TransformError() };\n",
        "if action == 2 { throw TransformFailed() }; if action == 3 { throw HostThrow() }; return text.clone() }\n"))
    mut bad_schema := TilVm.new(root)
    bad_schema.load_file("guest.til")!
    expect_lookup_failure(bad_schema, "transform", "shared callback error schema", signature = MultiTransform)
}

CallbackRecord := struct { number: I32 = 0; enabled := false; text := "" }
RecordTransform := proc(mut CallbackRecord, I64) returns CallbackRecord throws TransformError
RecordOwned := proc(own mut CallbackRecord) returns CallbackRecord
RecordBorrowed := func() returns ref CallbackRecord
RecordReader := func() returns CallbackRecord

record_callback_tests := proc(root: Str) {
    File.writefile("guest.til", format(
        "mode lib\nCallbackRecord := struct { number: I32 = 0; enabled := false; text := \"\" }\n",
        "TransformError := struct { code: I32 = 0; message := \"\" }\n",
        "stored := CallbackRecord(number = 42, enabled = true, text = \"guest literal\")\n",
        "mut calls := 0\nread_calls := proc() returns I64 { noop_proc(); return calls }\n",
        "borrowed := func() returns ref CallbackRecord { return stored }\n",
        "reader := func() returns CallbackRecord { return CallbackRecord(number = 43, enabled = true, text = stored.text.substr(6, 7)) }\n",
        "transform := proc(mut value: CallbackRecord, action: I64) returns CallbackRecord throws TransformError {\n",
        "noop_proc(); calls = calls + 1; value.number = value.number + 1; value.enabled = true; value.text = format(value.text, \"!\");\n",
        "if action == 1 { throw TransformError(code = 7, message = \"record failure\") };\n",
        "if action == 2 { panic(\"record panic\") }; if action == 3 { exit(0) }; return value.clone() }\n",
        "consume := proc(own mut value: CallbackRecord) returns CallbackRecord { noop_proc(); value.number = 99; value.text = format(value.text, \" owned\"); return value.clone() }\n"))
    mut vm := TilVm.new(root)
    vm.load_file("guest.til")!
    mut transform := vm.lookup("transform", RecordTransform)!
    mut bad_arguments := Tuple.new()
    bad_arguments.push(HostRecord, own HostRecord(value = 123))
    bad_arguments.push(I64, own 0)
    mut rejected := false
    call_throwing(RecordTransform)(transform, bad_arguments)?
    catch (err: TransformError) { panic("invalid record input executed guest code") }
    catch (err: TilVmError) { rejected = err.to_str().contains("type/width mismatch") }
    assert(rejected)
    mut read_calls := vm.lookup("read_calls", HostTick)!
    before := read_calls.call()!
    ref count : I64 = before.get(0)
    assert(count == 0)
    own read_calls.delete()
    mut kept := Tuple.new()
    for action in 0..4 {
        mut arguments := Tuple.new()
        arguments.push(CallbackRecord, own CallbackRecord(number = 10, text = format("host", " text")))
        arguments.push(I64, own action.clone())
        mut caught := false
        result := call_throwing(TransformError)(transform, arguments)?
        catch (err: TransformError) { assert(action == 1); assert(err.message == "record failure"); caught = true }
        catch (err: TilVmError) {
            assert(action == 2 || action == 3)
            if action == 2 { assert(err.to_str().contains("record panic")) }
            if action == 3 { assert(err.exit_status.unwrap() == 0) }
            caught = true
        }
        if action == 0 { kept = result }
        else { assert(caught) }
        ref updated : CallbackRecord = arguments.get(0)
        assert(updated.number == 11 && updated.enabled && updated.text == "host text!")
    }
    mut owned := vm.lookup("consume", RecordOwned)!
    mut inputs := Tuple.new()
    inputs.push(CallbackRecord, own CallbackRecord(number = 5, text = format("host", " owned")))
    consumed := owned.call(inputs)!
    ref unchanged : CallbackRecord = inputs.get(0)
    assert(unchanged.number == 5 && unchanged.text == "host owned")
    inputs.push(I64, own 0)
    recovered := call_throwing(RecordTransform)(transform, inputs)!
    mut borrow := vm.lookup("borrowed", RecordBorrowed)!
    borrowed := borrow.call()!
    mut reader := vm.lookup("reader", RecordReader)!
    viewed := reader.call()!
    own reader.delete()
    own borrow.delete()
    own owned.delete()
    own transform.delete()
    own vm.delete()
    ref success : CallbackRecord = kept.get(0)
    ref moved : CallbackRecord = consumed.get(0)
    ref literal : CallbackRecord = borrowed.get(0)
    ref view : CallbackRecord = viewed.get(0)
    ref again : CallbackRecord = recovered.get(0)
    assert(success.number == 11 && success.text == "host text!")
    assert(moved.number == 99 && moved.text == "host owned owned")
    assert(literal.number == 42 && literal.text == "guest literal")
    assert(view.number == 43 && view.text == "literal")
    assert(again.number == 6 && again.text == "host owned!")

    for fields : Str in array(Str,
        "number: I64 = 0; enabled := false; text := \"\"",
        "number: I32 = 0; enabled := false; ref text: Str = \"\"",
        "number: I32 = 0; enabled := false; text := Nested()") {
        File.writefile("guest.til", format(
            "mode lib\nNested := struct { text := \"\" }\nCallbackRecord := struct { ", fields, " }\n",
            "consume := proc(own mut value: CallbackRecord) returns CallbackRecord { noop_proc(); value.number = 99; return value.clone() }\n",
            "reader := func() returns CallbackRecord { return CallbackRecord() }\n"))
        mut invalid := TilVm.new(root)
        invalid.load_file("guest.til")!
        expect_lookup_failure(invalid, "consume", "argument schema", signature = RecordOwned)
        expect_lookup_failure(invalid, "reader", "result schema", signature = RecordReader)
    }
}

CallbackEnum := enum(U8) { Empty = 5, Number: I64 = 7, Text: Str = 9, Record: CallbackRecord = 11 }
CallbackMaybe := enum { None, Some: CallbackRecord }
CallbackState := enum(U16) { Idle = 400, Busy = 900 }
CallbackAction := func() returns I64
CallbackCallable := enum { None, Some: CallbackAction }
EnumRoundtrip := func(CallbackEnum) returns CallbackEnum
EnumTransform := proc(mut CallbackEnum, I64) returns CallbackEnum throws CallbackEnum
EnumBorrowed := func() returns ref CallbackEnum
EnumOwned := proc(own mut CallbackEnum) returns CallbackEnum
MaybeRoundtrip := func(CallbackMaybe) returns CallbackMaybe
StateRoundtrip := func(CallbackState) returns CallbackState
CallableRoundtrip := func(CallbackCallable) returns CallbackCallable

enum_callback_tests := proc(root: Str) {
    File.writefile("guest.til", format(
        "mode lib\nCallbackRecord := struct { number: I32 = 0; enabled := false; text := \"\" }\n",
        "CallbackEnum := enum(U8) { Empty = 5, Number: I64 = 7, Text: Str = 9, Record: CallbackRecord = 11 }\n",
        "CallbackMaybe := enum { None, Some: CallbackRecord }\n",
        "CallbackState := enum(U16) { Idle = 400, Busy = 900 }\nstate := func(value: CallbackState) returns CallbackState { return value }\n",
        "CallbackAction := func() returns I64\nCallbackCallable := enum { None, Some: CallbackAction }\n",
        "callable := func(value: CallbackCallable) returns CallbackCallable { return value.clone() }\n",
        "message := format(\"guest \", \"payload\")\nstored := CallbackEnum.Text(\"guest literal\")\n",
        "roundtrip := func(value: CallbackEnum) returns CallbackEnum { return value.clone() }\n",
        "borrowed := func() returns ref CallbackEnum { return stored }\n",
        "consume := proc(own mut value: CallbackEnum) returns CallbackEnum { noop_proc(); value = CallbackEnum.Text(\"owned result\"); return value.clone() }\n",
        "maybe := func(value: CallbackMaybe) returns CallbackMaybe { return value.clone() }\n",
        "transform := proc(mut value: CallbackEnum, action: I64) returns CallbackEnum throws CallbackEnum {\n",
        "noop_proc(); value = CallbackEnum.Text(\"updated\");\n",
        "if action == 1 { throw CallbackEnum.Text(message.substr(6, 7)) };\n",
        "if action == 2 { panic(\"enum panic\") }; if action == 3 { exit(0) }; return value.clone() }\n"))
    mut vm := TilVm.new(root)
    vm.load_file("guest.til")!
    mut roundtrip := vm.lookup("roundtrip", EnumRoundtrip)!
    expect_lookup_failure(vm, "callable", "argument schema", signature = CallableRoundtrip)
    mut state := vm.lookup("state", StateRoundtrip)!
    mut state_args := Tuple.new()
    state_args.push(CallbackState, own CallbackState.Busy)
    state_result := state.call(state_args)?
    catch (error: TilVmError) { panic(error.to_str()) }
    mut saved := Vec(Tuple).new()
    for value : CallbackEnum in array(CallbackEnum, CallbackEnum.Empty, CallbackEnum.Number(73),
        CallbackEnum.Text(format("host ", "text")), CallbackEnum.Record(CallbackRecord(number = 8, text = format("record ", "text")))) {
        mut args := Tuple.new()
        args.push(CallbackEnum, own value.clone())
        result := roundtrip.call(args)!
        ref actual : CallbackEnum = result.get(0)
        assert(actual == value)
        saved.push(own result)
    }
    mut transform := vm.lookup("transform", EnumTransform)!
    mut kept_error := CallbackEnum.Empty
    for action in 0..4 {
        mut args := Tuple.new()
        args.push(CallbackEnum, own CallbackEnum.Record(CallbackRecord(text = format("old ", "payload"))))
        args.push(I64, own action.clone())
        mut caught := false
        result := call_throwing(EnumTransform)(transform, args)?
        catch (error: CallbackEnum) { assert(action == 1); kept_error = error; caught = true }
        catch (error: TilVmError) {
            assert(action == 2 || action == 3)
            if action == 2 { assert(error.to_str().contains("enum panic")) }
            if action == 3 { assert(error.exit_status.unwrap() == 0) }
            caught = true
        }
        if action == 0 { saved.push(own result) } else { assert(caught) }
        ref updated : CallbackEnum = args.get(0)
        assert(updated == CallbackEnum.Text("updated"))
    }
    mut borrow := vm.lookup("borrowed", EnumBorrowed)!
    literal := borrow.call()!
    mut consume := vm.lookup("consume", EnumOwned)!
    mut own_args := Tuple.new()
    own_args.push(CallbackEnum, own CallbackEnum.Text(format("host ", "owned")))
    consumed := consume.call(own_args)!
    ref unchanged : CallbackEnum = own_args.get(0)
    assert(unchanged == CallbackEnum.Text("host owned"))
    mut maybe := vm.lookup("maybe", MaybeRoundtrip)?
    catch (error: TilVmError) { panic(error.to_str()) }
    mut some_args := Tuple.new()
    some_args.push(CallbackMaybe, own CallbackMaybe.Some(CallbackRecord(number = 91, text = format("boxed ", "text"))))
    some := maybe.call(some_args)!
    mut none_args := Tuple.new()
    none_args.push(CallbackMaybe, own CallbackMaybe.None)
    none := maybe.call(none_args)!
    own maybe.delete()
    own consume.delete()
    own state.delete()
    own borrow.delete()
    own transform.delete()
    own roundtrip.delete()
    own vm.delete()
    ref text : CallbackEnum = saved[2].get(0)
    ref record : CallbackEnum = saved[3].get(0)
    ref lit : CallbackEnum = literal.get(0)
    ref owned_result : CallbackEnum = consumed.get(0)
    ref boxed : CallbackMaybe = some.get(0)
    ref absent : CallbackMaybe = none.get(0)
    ref state_value : CallbackState = state_result.get(0)
    assert(state_value == CallbackState.Busy)
    assert(text == CallbackEnum.Text("host text"))
    assert(record == CallbackEnum.Record(CallbackRecord(number = 8, text = "record text")))
    assert(lit == CallbackEnum.Text("guest literal"))
    assert(owned_result == CallbackEnum.Text("owned result"))
    assert(kept_error == CallbackEnum.Text("payload"))
    assert(boxed == CallbackMaybe.Some(CallbackRecord(number = 91, text = "boxed text")))
    assert(absent.is(CallbackMaybe.None))
    // A different tag width can have the SAME overall union size.
    for declaration : Str in array(Str,
        "enum(U32) { Empty = 5, Number: I64 = 7, Text: Str = 9, Record: CallbackRecord = 11 }",
        "enum(U8) { Empty = 6, Number: I64 = 7, Text: Str = 9, Record: CallbackRecord = 11 }",
        "enum(U8) { Empty = 5, Number: I64 = 7, Text: ref Str = 9, Record: CallbackRecord = 11 }") {
        File.writefile("guest.til", format("mode lib\nCallbackRecord := struct { number: I32 = 0; enabled := false; text := \"\" }\n",
            "CallbackEnum := ", declaration, "\nroundtrip := func(value: CallbackEnum) returns CallbackEnum { return value.clone() }\n"))
        mut invalid := TilVm.new(root)
        invalid.load_file("guest.til")!
        expect_lookup_failure(invalid, "roundtrip", "argument schema", signature = EnumRoundtrip)
    }
}

NestedInner := struct { text := ""; marker: I32 = 0; state := CallbackState.Idle }
NestedChoice := enum { Empty, Inner: NestedInner, State: CallbackState, Text: Str }
NestedUnion := enum { Empty, Value: NestedChoice }
NestedOuter := struct { left := NestedInner(); right := NestedInner(); choice := NestedChoice.Empty; maybe := NestedUnion.Empty }
NestedFailure := enum { Empty, Request: NestedOuter, Flag: CallbackState }
NestedTransform := proc(mut NestedOuter, I64) returns NestedOuter throws NestedFailure
NestedOwned := proc(own mut NestedOuter) returns NestedOuter
NestedRead := func() returns ref NestedOuter
NestedValueRead := func() returns NestedOuter
NestedThrowOnly := func() throws NestedFailure
CallbackLink := enum { None, Some: CallbackNode }
CallbackNode := struct { number: I64 = 0; next := CallbackLink.None; text := "" }
NodeRoundtrip := func(CallbackNode) returns CallbackNode

check_nested_value := func(value: NestedOuter) {
    assert(value.left.text == "payload" && value.left.marker == 17 && value.left.state == CallbackState.Busy)
    assert(value.right.text == "nested literal")
    assert(value.choice == NestedChoice.Inner(NestedInner(text = "payload", marker = 33, state = CallbackState.Busy)))
    assert(value.maybe == NestedUnion.Value(NestedChoice.State(CallbackState.Busy)))
}

nested_callback_tests := proc(root: Str) {
    schemas := format(
        "CallbackState := enum(U16) { Idle = 400, Busy = 900 }\n",
        "NestedInner := struct { text := \"\"; marker: I32 = 0; state := CallbackState.Idle }\n",
        "NestedChoice := enum { Empty, Inner: NestedInner, State: CallbackState, Text: Str }\n",
        "NestedUnion := enum { Empty, Value: NestedChoice }\n",
        "NestedOuter := struct { left := NestedInner(); right := NestedInner(); choice := NestedChoice.Empty; maybe := NestedUnion.Empty }\n",
        "NestedFailure := enum { Empty, Request: NestedOuter, Flag: CallbackState }\n",
        "CallbackLink := enum { None, Some: CallbackNode }\nCallbackNode := struct { number: I64 = 0; next := CallbackLink.None; text := \"\" }\n")
    File.writefile("guest.til", format("mode lib\n", schemas,
        "message := format(\"guest \", \"payload\")\nstored := NestedOuter(left = NestedInner(text = \"stored literal\"))\n",
        "borrowed := func() returns ref NestedOuter { return stored }\n",
        "node := func(value: CallbackNode) returns CallbackNode { return value.clone() }\n",
        "consume := proc(own mut value: NestedOuter) returns NestedOuter { noop_proc(); value.left.text = \"owned change\"; return value.clone() }\n",
        "transform := proc(mut value: NestedOuter, action: I64) returns NestedOuter throws NestedFailure {\n",
        "noop_proc(); value.left = NestedInner(text = message.substr(6, 7), marker = 17, state = CallbackState.Busy);\n",
        "value.right.text = \"nested literal\";\n",
        "value.choice = NestedChoice.Inner(NestedInner(text = message.substr(6, 7), marker = 33, state = CallbackState.Busy));\n",
        "value.maybe = NestedUnion.Value(NestedChoice.State(CallbackState.Busy));\n",
        "if action == 1 { throw NestedFailure.Request(value.clone()) };\n",
        "if action == 2 { panic(\"nested panic\") }; if action == 3 { exit(0) }; return value.clone() }\n"))
    mut vm := TilVm.new(root)
    vm.load_file("guest.til")!
    mut transform := vm.lookup("transform", NestedTransform)!
    mut kept := Tuple.new()
    mut failure := NestedFailure.Empty
    for action in 0..4 {
        mut args := Tuple.new()
        args.push(NestedOuter, own NestedOuter(left = NestedInner(text = format("old ", "left")),
            choice = NestedChoice.Text(format("old ", "choice")),
            maybe = NestedUnion.Value(NestedChoice.Text(format("old ", "nested")))))
        args.push(I64, own action.clone())
        mut caught := false
        result := call_throwing(NestedTransform)(transform, args)?
        catch (error: NestedFailure) { assert(action == 1); failure = error; caught = true }
        catch (error: TilVmError) {
            assert(action == 2 || action == 3)
            if action == 2 { assert(error.to_str().contains("nested panic")) }
            if action == 3 { assert(error.exit_status.unwrap() == 0) }
            caught = true
        }
        if action == 0 { kept = result } else { assert(caught) }
        ref updated : NestedOuter = args.get(0)
        check_nested_value(updated)
    }
    mut consume := vm.lookup("consume", NestedOwned)!
    mut owned_args := Tuple.new()
    owned_args.push(NestedOuter, own NestedOuter(left = NestedInner(text = format("host ", "owned"))))
    consumed := consume.call(owned_args)!
    ref original : NestedOuter = owned_args.get(0)
    assert(original.left.text == "host owned")
    mut borrow := vm.lookup("borrowed", NestedRead)!
    borrowed := borrow.call()!
    mut node := vm.lookup("node", NodeRoundtrip)!
    mut node_args := Tuple.new()
    node_args.push(CallbackNode, own CallbackNode(number = 41, text = format("root ", "text"),
        next = CallbackLink.Some(CallbackNode(number = 42, text = format("child ", "text")))))
    copied_node := node.call(node_args)!
    own node.delete()
    own borrow.delete()
    own consume.delete()
    own transform.delete()
    own vm.delete()
    ref result : NestedOuter = kept.get(0)
    check_nested_value(result)
    switch failure {
    case .Request(value): check_nested_value(value)
    case: panic("nested declared error was not preserved")
    }
    ref owned : NestedOuter = consumed.get(0)
    ref stored : NestedOuter = borrowed.get(0)
    assert(owned.left.text == "owned change" && stored.left.text == "stored literal")
    ref tree : CallbackNode = copied_node.get(0)
    assert(tree.text == "root text" && tree.number == 41)
    switch tree.next {
    case .Some(child): assert(child.text == "child text" && child.number == 42 && child.next.is(CallbackLink.None))
    case: panic("nested owned box was not preserved")
    }
    for bad_schema : Str in array(Str,
        schemas.replace("marker: I32", "marker: I64"),
        schemas.replace("enum(U16)", "enum(U32)"),
        schemas.replace("text := \"\"", "ref text: Str = \"\"")) {
        File.writefile("guest.til", format("mode lib\n", bad_schema,
            "consume := proc(own mut value: NestedOuter) returns NestedOuter { noop_proc(); value.left.marker = 99; return value.clone() }\n",
            "reader := func() returns NestedOuter { return NestedOuter() }\n",
            "failure := func() throws NestedFailure { throw NestedFailure.Empty }\n"))
        mut invalid := TilVm.new(root)
        invalid.load_file("guest.til")?
        catch (error: TilVmError) { panic(error.to_str()) }
        expect_lookup_failure(invalid, "consume", "argument schema", signature = NestedOwned)
        expect_lookup_failure(invalid, "reader", "result schema", signature = NestedValueRead)
        expect_lookup_failure(invalid, "failure", "error schema", signature = NestedThrowOnly)
    }
}

VariadicSum := func(I64, values: ..I64) returns I64
VariadicJoin := proc(mut Str, parts: ..Str, mut suffix: Str = "!") returns Str throws TransformError
VariadicInner := struct { text := ""; state := CallbackState.Idle }
VariadicOuter := struct { inner := VariadicInner() }
VariadicRecords := func(values: ..VariadicOuter) returns VariadicOuter
VariadicStates := func(values: ..CallbackState) returns I64
VariadicDynamic := proc(values: ..Dynamic) returns Str

variadic_callback_tests := proc(root: Str) {
    File.writefile("guest.til", format(
        "mode lib\nTransformError := struct { code: I32 = 0; message := \"\" }\n",
        "CallbackState := enum(U16) { Idle = 400, Busy = 900 }\n",
        "VariadicInner := struct { text := \"\"; state := CallbackState.Idle }\nVariadicOuter := struct { inner := VariadicInner() }\n",
        "mut calls := 0\nread_calls := proc() returns I64 { noop_proc(); return calls }\n",
        "sum := func(base: I64, values: ..I64) returns I64 { mut total := base; for value: I64 in values { total = total + value }; return total }\n",
        "join_values := proc(mut prefix: Str, parts: ..Str, mut suffix: Str = \"!\") returns Str throws TransformError {\n",
        "noop_proc(); calls = calls + 1; prefix = format(prefix, \"+\"); action := suffix.clone(); suffix = format(suffix, \"?\"); mut out := prefix.clone(); for part: Str in parts { out = format(out, part) };\n",
        "if action == \"error\" { throw TransformError(code = 17, message = out.clone()) }; if action == \"panic\" { panic(\"variadic panic\") }; if action == \"exit\" { exit(0) }; return format(out, suffix) }\n",
        "records := func(values: ..VariadicOuter) returns VariadicOuter { if values.len() == 0 { return VariadicOuter() }; return values[0].clone() }\n",
        "states := func(values: ..CallbackState) returns I64 { mut total: I64 = 0; for value: CallbackState in values { if value == CallbackState.Busy { total = total + 1 } }; return total }\n",
        "dynamic := proc(values: ..Dynamic) returns Str { noop_proc(); calls = calls + 1; if values.len() == 0 { return \"empty\" }; ref n: I64 = values.get(0); ref text: Str = values.get(1); ref record: VariadicOuter = values.get(2); ref state: CallbackState = values.get(3); assert(state == CallbackState.Busy); return format(n.to_str(), text, record.inner.text) }\n"))
    mut vm := TilVm.new(root)
    vm.load_file("guest.til")?
    catch (error: TilVmError) { panic(error.to_str()) }
    mut sum := vm.lookup("sum", VariadicSum)!
    mut numbers := Tuple.new()
    numbers.push(I64, own 3)
    zero := sum.call(numbers)!
    ref zero_value : I64 = zero.get(0)
    assert(zero_value == 3)
    for i in 0..70 { numbers.push(I64, own i.clone()) }
    total := sum.call(numbers)!
    ref total_value : I64 = total.get(0)
    assert(total_value == 2418)
    mut missing := Tuple.new()
    missing_error := expect_call_failure(sum, missing, "count mismatch", path = "guest.til")
    assert(missing_error.exit_status.is_none())
    mut join := vm.lookup("join_values", VariadicJoin)?
    catch (error: TilVmError) { panic(error.to_str()) }
    mut wrong := Tuple.new()
    wrong.push(Str, own format("pre", "fix"))
    wrong.push(I64, own 9)
    wrong.push(Str, own "!")
    mut rejected := false
    call_throwing(VariadicJoin)(join, wrong)?
    catch (error: TransformError) { panic("bad tail executed the guest") }
    catch (error: TilVmError) { rejected = error.to_str().contains("type/width mismatch") }
    assert(rejected)
    mut reader := vm.lookup("read_calls", HostTick)!
    before := reader.call()!
    ref count : I64 = before.get(0)
    assert(count == 0)
    mut saved_error := TransformError()
    mut saved := Tuple.new()
    for suffix: Str in array(Str, "!", "error", "panic", "exit") {
        mut args := Tuple.new()
        args.push(Str, own format("pre", "fix"))
        args.push(Str, own format("tail", "1"))
        args.push(Str, own format("tail", "2"))
        args.push(Str, own suffix.clone())
        mut caught := false
        result := call_throwing(VariadicJoin)(join, args)?
        catch (error: TransformError) { assert(suffix == "error"); saved_error = error; caught = true }
        catch (error: TilVmError) {
            assert(suffix == "panic" || suffix == "exit")
            if suffix == "panic" { assert(error.to_str().contains("variadic panic")) }
            if suffix == "exit" { assert(error.exit_status.unwrap() == 0) }
            caught = true
        }
        if suffix == "!" { saved = result } else { assert(caught) }
        ref prefix: Str = args.get(0)
        ref tail: Str = args.get(1)
        ref ending: Str = args.get(3)
        assert(prefix == "prefix+" && tail == "tail1")
        assert(ending == format(suffix, "?"))
    }
    mut no_tail := Tuple.new()
    no_tail.push(Str, own "prefix")
    no_tail.push(Str, own "!")
    recovered := call_throwing(VariadicJoin)(join, no_tail)!
    mut records := vm.lookup("records", VariadicRecords)!
    mut record_args := Tuple.new()
    record_args.push(VariadicOuter, own VariadicOuter(inner = VariadicInner(text = format("nested ", "tail"))))
    record_result := records.call(record_args)!
    mut states := vm.lookup("states", VariadicStates)!
    mut state_args := Tuple.new()
    state_args.push(CallbackState, own CallbackState.Idle)
    state_args.push(CallbackState, own CallbackState.Busy)
    state_args.push(CallbackState, own CallbackState.Idle)
    state_result := states.call(state_args)!
    ref state_count: I64 = state_result.get(0)
    assert(state_count == 1)
    mut dynamic := vm.lookup("dynamic", VariadicDynamic)!
    empty_dynamic := dynamic.call()!
    ref empty_text: Str = empty_dynamic.get(0)
    assert(empty_text == "empty")
    mut mixed := Tuple.new()
    mixed.push(I64, own 7)
    mixed.push(Str, own " mixed ")
    mixed.push(VariadicOuter, own VariadicOuter(inner = VariadicInner(text = format("nested ", "dynamic"))))
    mixed.push(CallbackState, own CallbackState.Busy)
    mixed_result := dynamic.call(mixed)!
    before_bad := reader.call()!
    mut raw_tail := Tuple.new()
    raw_tail.push(Dynamic, own 0)
    raw_error := expect_call_failure(dynamic, raw_tail, "unsupported variadic element schema", path = "guest.til")
    assert(raw_error.exit_status.is_none())
    mut unknown_tail := Tuple.new()
    unknown_tail.push(HostRecord, own HostRecord(value = 123))
    unknown_error := expect_call_failure(dynamic, unknown_tail, "unsupported variadic element schema", path = "guest.til")
    assert(unknown_error.exit_status.is_none())
    after_bad := reader.call()!
    ref before_count: I64 = before_bad.get(0)
    ref after_count: I64 = after_bad.get(0)
    assert(before_count == after_count)
    own dynamic.delete()
    own states.delete()
    own records.delete()
    own reader.delete()
    own join.delete()
    own sum.delete()
    own vm.delete()
    ref text: Str = saved.get(0)
    ref again: Str = recovered.get(0)
    ref record: VariadicOuter = record_result.get(0)
    ref dynamic_text: Str = mixed_result.get(0)
    assert(text == "prefix+tail1tail2!?" && again == "prefix+!?")
    assert(saved_error.code == 17 && saved_error.message == "prefix+tail1tail2")
    assert(record.inner.text == "nested tail" && dynamic_text == "7 mixed nested dynamic")
}

KeywordOnly := proc(options: ...) returns Str
KeywordMixed := proc(mut Str, parts: ..Str, mut suffix: Str = "!", options: ...) returns Str throws TransformError
KeywordCapture := proc(options: ...)

capture_keyword_views := proc(mut callback: TilVmCallback) {
    mut options := KwargsMap.new()
    key_owner := format("key", " trailing")
    value_owner := format("snapshot", " trailing")
    options.set(key_owner.substr(0, 3), "Str", Str.size(), own value_owner.substr(0, 8).clone())
    callback.call(keywords = options)!
}

kwargs_callback_tests := proc(root: Str) {
    File.writefile("guest.til", format(
        "mode lib\nTransformError := struct { code: I32 = 0; message := \"\" }\n",
        "CallbackState := enum(U16) { Idle = 400, Busy = 900 }\n",
        "VariadicInner := struct { text := \"\"; state := CallbackState.Idle }\nVariadicOuter := struct { inner := VariadicInner() }\n",
        "mut calls := 0\nread_calls := proc() returns I64 { noop_proc(); return calls }\n",
        "mut held := KwargsMap.new()\ncapture_keywords := proc(options: ...) { noop_proc(); held = options.clone() }\n",
        "read_held := func() returns Str { ref value: Str = held.get(\"key\"); return value.clone() }\n",
        "keyword_only := proc(options: ...) returns Str { noop_proc(); calls = calls + 1; if options.len() == 0 { return \"empty\" }; ref n: I64 = options.get(\"number\"); ref text: Str = options.get(\"text\"); ref record: VariadicOuter = options.get(\"record\"); ref state: CallbackState = options.get(\"state\"); assert(state == CallbackState.Busy); return format(n.to_str(), text, record.inner.text) }\n",
        "keyword_mixed := proc(mut prefix: Str, parts: ..Str, mut suffix: Str = \"!\", options: ...) returns Str throws TransformError {\n",
        "noop_proc(); calls = calls + 1; prefix = format(prefix, \"+\"); suffix = format(suffix, \"?\"); mut out := prefix.clone(); for part: Str in parts { out = format(out, part) };\n",
        "if options.has(\"prefix\") { ref named: Str = options.get(\"prefix\"); assert(named == \"map only\") };\n",
        "if options.has(\"mode\") { ref mode: Str = options.get(\"mode\"); if mode == \"error\" { throw TransformError(code = 19, message = out.clone()) }; if mode == \"panic\" { panic(\"kwargs panic\") }; if mode == \"exit\" { exit(0) } }; return format(out, suffix) }\n"))
    mut vm := TilVm.new(root)
    vm.load_file("guest.til")?
    catch (error: TilVmError) { panic(error.to_str()) }
    mut only := vm.lookup("keyword_only", KeywordOnly)!
    empty := only.call()!
    ref empty_text : Str = empty.get(0)
    assert(empty_text == "empty")
    mut options := KwargsMap.new()
    options.set("number", "I64", I64.size(), own 7)
    options.set("text", "Str", Str.size(), own format(" key", "words "))
    options.set("record", "VariadicOuter", VariadicOuter.size(), own VariadicOuter(inner = VariadicInner(text = format("nested ", "value"))))
    options.set("state", "CallbackState", CallbackState.size(), own CallbackState.Busy)
    result := only.call(keywords = options)!
    mut reader := vm.lookup("read_calls", HostTick)!
    mut no_args := Tuple.new()
    no_collector := expect_call_failure(reader, no_args, "no kwargs collector", path = "guest.til", keywords = options)
    assert(no_collector.exit_status.is_none())
    before := reader.call()!
    mut malformed := KwargsMap.new()
    malformed.items.set("empty", own Tuple.new())
    malformed_error := expect_call_failure(only, no_args, "exactly one typed value", path = "guest.til", keywords = malformed)
    assert(malformed_error.exit_status.is_none())
    mut raw := KwargsMap.new()
    raw.set("raw", "Dynamic", Dynamic.size(), own 0)
    raw_error := expect_call_failure(only, no_args, "unsupported keyword schema", path = "guest.til", keywords = raw)
    assert(raw_error.exit_status.is_none())
    mut unknown := KwargsMap.new()
    unknown.set("unknown", "HostRecord", HostRecord.size(), own HostRecord(value = 9))
    unknown_error := expect_call_failure(only, no_args, "unsupported keyword schema", path = "guest.til", keywords = unknown)
    assert(unknown_error.exit_status.is_none())
    mut wrong_width := KwargsMap.new()
    wrong_width.set("number", "I64", I64.size(), own 7)
    ref mut width_entry : Tuple = wrong_width.items.values[0]
    width_entry.type_sizes.unsafe_set(0, own 1)
    width_error := expect_call_failure(only, no_args, "keyword type/width mismatch", path = "guest.til", keywords = wrong_width)
    assert(width_error.exit_status.is_none())
    after := reader.call()!
    ref before_count : I64 = before.get(0)
    ref after_count : I64 = after.get(0)
    assert(before_count == after_count)
    mut mixed := vm.lookup("keyword_mixed", KeywordMixed)!
    mut named_fixed := KwargsMap.new()
    named_fixed.set("prefix", "Str", Str.size(), own "map only")
    mut missing_fixed := false
    call_throwing(KeywordMixed)(mixed, no_args, keywords = named_fixed)?
    catch (error: TransformError) { panic("missing positional inputs executed the guest") }
    catch (error: TilVmError) { missing_fixed = error.to_str().contains("count mismatch") }
    assert(missing_fixed)
    mut kept := Tuple.new()
    mut kept_error := TransformError()
    for mode: Str in array(Str, "ok", "error", "panic", "exit") {
        mut args := Tuple.new()
        args.push(Str, own format("pre", "fix"))
        args.push(Str, own format(" tail", "1"))
        args.push(Str, own format(" tail", "2"))
        args.push(Str, own "!")
        mut keywords := KwargsMap.new()
        keywords.set("mode", "Str", Str.size(), own mode.clone())
        keywords.set("prefix", "Str", Str.size(), own "map only")
        mut caught := false
        output := call_throwing(KeywordMixed)(mixed, args, keywords = keywords)?
        catch (error: TransformError) { assert(mode == "error"); kept_error = error; caught = true }
        catch (error: TilVmError) {
            assert(mode == "panic" || mode == "exit")
            if mode == "panic" { assert(error.to_str().contains("kwargs panic")) }
            if mode == "exit" { assert(error.exit_status.unwrap() == 0) }
            caught = true
        }
        if mode == "ok" { kept = output } else { assert(caught) }
        ref prefix: Str = args.get(0)
        ref suffix: Str = args.get(3)
        ref original_mode: Str = keywords.get("mode")
        assert(prefix == "prefix+" && suffix == "!?" && original_mode == mode)
    }
    mut fixed := Tuple.new()
    fixed.push(Str, own "prefix")
    fixed.push(Str, own "!")
    recovered := call_throwing(TransformError)(mixed, fixed)!
    mut single_args := Tuple.new()
    single_args.push(Str, own "single")
    single_args.push(Str, own "!")
    mut single_keywords := KwargsMap.new()
    single_keywords.set("mode", "Str", Str.size(), own "error")
    mut single_caught := false
    call_throwing(TransformError)(mixed, single_args, keywords = single_keywords)?
    catch (error: TransformError) { single_caught = error.code == 19 && error.message == "single+" }
    catch (error: TilVmError) { panic(error.to_str()) }
    assert(single_caught)
    mut capture := vm.lookup("capture_keywords", KeywordCapture)!
    capture_keyword_views(capture)
    mut held_reader := vm.lookup("read_held", HostReader)!
    held := held_reader.call()!
    own held_reader.delete()
    own capture.delete()
    own mixed.delete()
    own reader.delete()
    own only.delete()
    own vm.delete()
    ref text: Str = result.get(0)
    ref joined: Str = kept.get(0)
    ref again: Str = recovered.get(0)
    ref snapshot: Str = held.get(0)
    assert(text == "7 keywords nested value")
    assert(joined == "prefix+ tail1 tail2!?" && again == "prefix+!?")
    assert(kept_error.code == 19 && kept_error.message == "prefix+ tail1 tail2")
    assert(snapshot == "snapshot")
}

main := proc(root: Str) returns I64 {
    kwargs_callback_tests(root)
    variadic_callback_tests(root)
    nested_callback_tests(root)
    enum_callback_tests(root)
    record_callback_tests(root)
    multiple_error_callback_tests(root)
    throwing_callback_tests(root)
    throwing_schema_tests(root)
    checked_lookup(root)
    callback_tests(root)
    typed_callback_tests(root)
    mut vm := TilVm.new(root)
    expect_failure(vm, "mode lib\nbroken := func( {\n", "load", "expected", 2)
    expect_failure(vm, "mode lib\n/* unterminated\n", "load", "unterminated comment", 2)
    expect_failure(vm, "mode lib\nbad: I64 = \"wrong\"\n", "type", "I64", 2)
    expect_failure(vm, "mode lib\nimport(\"./missing_vm_module\")\n", "load", "could not find import", 2)
    expect_failure(vm, "mode cli\n", "load", "mode lib", 1)
    expect_failure(vm, "mode lib\nexit(0)\n", "eval", "status 0", 2)
    expect_failure(vm, "mode lib\nexit(1)\n", "eval", "status 1", 2)
    expect_failure(vm, "mode lib\ncode := proc() returns I64 { noop_proc(); exit(13); return 0 }\nexit(code())\n", "eval", "status 13", 2)
    expect_failure(vm, "mode lib\npanic(\"vm panic detail\")\n", "eval", "vm panic detail", 2)
    expect_failure(vm, "mode lib\nvalues := vec(I64, 1)\nprintln(values[5].to_str())\n", "eval", "OutOfBounds", 3)
    expect_failure(vm, "mode lib\nfail := proc(own a: Str, own b: Str) { noop_proc(); panic(a, b) }\nfail(own format(\"first\", \" argument\"), own format(\"second\", \" argument\"))\n", "eval", "first argument", 2)
    expect_failure(vm, "mode lib\nprintln(dyn_size_of(\"NoSuchType\").to_str())\n", "eval", "unknown type", 2)
    expect_failure(vm, "mode lib\nprintln(struct_field_count(\"NoSuchType\").to_str())\n", "eval", "not found", 2)
    expect_failure(vm, "mode lib\nprintln(struct_field_name(\"Str\", 99))\n", "eval", "out of range", 2)
    expect_failure(vm, "mode lib\nprintln(1.div(0).to_str())\n", "eval", "division by zero", 2)
    expect_failure(vm, "mode lib\nforeign := ext_proc() {}\nforeign()\n", "eval", "native function is not registered", 3)
    expect_failure(vm, "mode lib\nforeign := ext_global(I64, \"unknown_native_global\")\n", "eval", "external global symbol not found", 2)
    expect_failure(vm, "mode lib\nNativeState := struct { namespace: value := ext_global(I64, \"unknown_namespace_global\") }\n", "load", "external global symbol not found", 2)
    expect_failure(vm, "mode lib\nlink_c(\"missing.c\")\n", "load", "cannot compile link_c", 1)

    File.writefile("guest.til", "mode lib\nmessage := format(\"guest \", \"loaded\")\nprintln(message)\n")
    vm.load_file("guest.til")!
    // A second live VM can load and die without invalidating the first.
    implicit_teardown(root)
    mut rejected := false
    vm.load_file("guest.til")?
    catch (err: TilVmError) {
        rejected = true
        assert(err.to_str().contains("already has a module"))
    }
    assert(rejected)
    own vm.delete()
    implicit_teardown(root)
    println("TilVm host survived errors and teardown")
    return 0
}
