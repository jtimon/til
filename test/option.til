mode test

// Core Option(T) (#320): one template, owned (Option(X)) and borrowed
// (Option(ref X)) instantiations.

OptSrc := struct {
    n := 0
namespace:
    eq := func(a: OptSrc, b: OptSrc) returns Bool { return a.n.eq(b.n) }
    to_str := func(self: OptSrc) returns Str { return self.n.to_str() }
}

OptI := Option(I64)
OptRefSrc := Option(ref OptSrc)

test_option_owned_basics := test() {
    some := OptI.Some(42)
    none := OptI.None
    expect(some.is_some(), "Some is_some")
    expect(some.is_none().not(), "Some not is_none")
    expect(none.is_none(), "None is_none")
    assert_eq(I64, some.unwrap_or(0), 42)
    assert_eq(I64, none.unwrap_or(7), 7)
}

// #322: switching through the alias name works for template enums.
test_option_alias_switch := test() {
    o := OptI.Some(9)
    mut got := -1
    switch o {
    case OptI.Some(v): got = v
    case OptI.None: got = 0
    }
    assert_eq(I64, got, 9)
}

test_option_ref_borrows := test() {
    mut src := OptSrc(n = 1)
    o := OptRefSrc.Some(src)
    // The payload is a borrow: source mutations are visible through it.
    src.n = 5
    mut got := -1
    switch o {
    case OptRefSrc.Some(p): got = p.n
    case OptRefSrc.None: got = 0
    }
    assert_eq(I64, got, 5)
    expect(o.is_some(), "ref Some is_some")
    expect(OptRefSrc.None.is_none(), "ref None is_none")
    assert_eq(I64, src.n, 5)
}

test_option_ref_unwrap_or := test() {
    mut src := OptSrc(n = 3)
    fallback := OptSrc(n = 0)
    o := OptRefSrc.Some(src)
    // Option(ref T).unwrap_or returns the BORROW (returns T -> returns
    // ref OptSrc under the ref instantiation).
    ref r : OptSrc = o.unwrap_or(fallback)
    src.n = 8
    assert_eq(I64, r.n, 8)
    assert_eq(I64, src.n, 8)
    assert_eq(I64, fallback.n, 0)
}

// Annotation position: Option(ref X) as a parameter type resolves to the
// same instantiation as the alias.
opt_src_str := func(o: Option(ref OptSrc)) returns Str {
    switch o {
    case Option(ref OptSrc).Some(p): return p.to_str()
    case Option(ref OptSrc).None: return "none"
    }
}

test_option_annotation_position := test() {
    src := OptSrc(n = 6)
    assert_eq(Str, opt_src_str(OptRefSrc.Some(src)), "6")
    assert_eq(Str, opt_src_str(OptRefSrc.None), "none")
    assert_eq(I64, src.n, 6)
}

// #320: a SELF-REFERENTIAL Option(ref T) field -- the Option sits inline
// in the struct while its payload points back at that same struct. The C
// emitter must order the enum body before the struct; a ref payload is a
// bare pointer, so it is not a layout dependency (without that, the topo
// sort deadlocks and the fallback emits an incomplete field type).
OptNode := struct {
    val := 0
    next := Option(ref OptNode).None
}

test_option_self_referential_field := test() {
    mut tail := OptNode(val = 2)
    head := OptNode(val = 1, next = Option(ref OptNode).Some(tail))
    mut got := -1
    switch head.next {
    case Option(ref OptNode).Some(n): got = n.val
    case Option(ref OptNode).None: got = 0
    }
    assert_eq(I64, got, 2)
    // The link is a borrow: mutating the target is visible through it.
    tail.val = 9
    switch head.next {
    case Option(ref OptNode).Some(n2): got = n2.val
    case Option(ref OptNode).None: got = 0
    }
    assert_eq(I64, got, 9)
    assert_eq(I64, tail.val, 9)
    assert_eq(I64, head.val, 1)
}

// #320/#321: a ref-payload argument may be a REF-RETURNING CALL, not just
// a variable or field -- the same borrow-source rule a `ref` declaration
// already uses. The referent outlives the call, so the borrow is sound.
OptSrcHolder := struct {
    inner := OptSrc(n = 0)
}

opt_inner_ref := func(h: OptSrcHolder) returns ref OptSrc { return h.inner }

test_option_ref_payload_from_ref_returning_call := test() {
    mut h := OptSrcHolder(inner = OptSrc(n = 4))
    o := OptRefSrc.Some(opt_inner_ref(h))
    // Still a borrow of h.inner: the write is visible through the Option.
    h.inner.n = 6
    mut got := -1
    switch o {
    case OptRefSrc.Some(p): got = p.n
    case OptRefSrc.None: got = 0
    }
    assert_eq(I64, got, 6)
    assert_eq(I64, h.inner.n, 6)
}

test_option_unwrap := test() {
    some := OptI.Some(12)
    assert_eq(I64, some.unwrap(), 12)
    // The idiom it exists for: absence handled first, so unwrap cannot fail.
    mut total := 0
    for v in 0..3 {
        o := OptI.Some(v)
        if o.is_none() { continue }
        total = total.add(o.unwrap())
    }
    assert_eq(I64, total, 3)
}

test_option_ref_unwrap := test() {
    mut src := OptSrc(n = 2)
    o := OptRefSrc.Some(src)
    // Under the ref instantiation unwrap returns the BORROW.
    ref got : OptSrc = o.unwrap()
    src.n = 8
    assert_eq(I64, got.n, 8)
    assert_eq(I64, src.n, 8)
}

// #321: a borrowed STR payload. Every other case here uses a struct
// payload, and that gap hid a real interpreter bug: call_copies_ref_str
// classified any ext-callee ref-Str result as an owned COPY, so the
// interpreter freed the BORROWED Str a case binding yields (the binding
// is `deref(get_payload(..))`, and deref is an ext_func the caller stamps
// with the payload type). Compiled mode was always fine; interpreted mode
// corrupted the heap. Str is the payload that matters because the
// interpreter manages its buffer, so it must be exercised on its own.
OptStrHolder := struct {
    keys := Vec(Str).new()
}

priv opt_str_pick := func(h: OptStrHolder) returns Option(ref Str) {
    for i in 0..h.keys.len() {
        return Option(ref Str).Some(h.keys.unsafe_get(i))
    }
    return Option(ref Str).None
}

test_option_ref_str_payload := test() {
    mut h := OptStrHolder()
    h.keys.push(own Str.clone("alpha"))
    h.keys.push(own Str.clone("beta"))

    // unwrap yields the borrow, and the source keeps owning it.
    ref got : Str = opt_str_pick(h).unwrap()
    assert_eq(Str, got, "alpha")
    assert_eq(Str, h.keys.unsafe_get(0), "alpha")

    // the switch form must borrow too, not copy-and-free
    switch opt_str_pick(h) {
    case Option(ref Str).Some(v): assert_eq(Str, v, "alpha")
    case Option(ref Str).None: expect(false, "expected Some")
    }

    empty := OptStrHolder()
    expect(opt_str_pick(empty).is_none(), "empty holder yields None")
    assert_eq(USize, h.keys.len(), 2)
}

test_option_niche_layout := test() {
    // #320 niche: Option(ref T) is ONE pointer wide -- None IS the null
    // bit pattern, so there is no tag. The owned instantiation cannot use
    // the niche (an owned payload has no spare bit pattern) and keeps the
    // tagged layout.
    assert_eq(USize, Option(ref OptSrc).size(), UPtr.size())
    expect(Option(OptSrc).size().gt(UPtr.size()), "owned Option stays tagged")
}

// #321: a function returning Option(ref T) hands a BORROW back, exactly
// like `returns ref` does, so auto-shallow (#223) must not demote its
// aggregate params to by-value copies. It used to: the emitted C took
// `Option__ref_OptCell pick(OptCell c)` and stored `&c`, so the returned
// borrow pointed at the callee's dead stack frame and every write through
// it was silently lost. The `returns ref` twin below is the control --
// both must write through to the caller's value.
OptCell := struct {
    n := 0
}

opt_cell_pick := func(c: OptCell) returns Option(ref OptCell) {
    return Option(ref OptCell).Some(c)
}

opt_cell_pick_ref := func(c: OptCell) returns ref OptCell {
    return c
}

test_option_ref_return_param_not_shallowed := test() {
    via_ref := OptCell(n = 1)
    ref mut r : OptCell = opt_cell_pick_ref(via_ref)
    r.n = 7
    assert_eq(I64, via_ref.n, 7)

    via_opt := OptCell(n = 1)
    ref mut o : OptCell = opt_cell_pick(via_opt).unwrap()
    o.n = 42
    assert_eq(I64, via_opt.n, 42)
}
