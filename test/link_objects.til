mode cli
import("std/sys")
import("std/file")

// Extracted from terminal_session.til when tilminal moved to Tiled. This
// protects the compiler, independently of any terminal implementation.
// Force A's cc wrapper to build B after A's bridge compiles but before A
// links. A directory-wide user_0.o makes A link B's implementation.
// The wrapper is a compiled Til program on every host: no shell script or
// batch-file argument re-parsing, and no Windows skip.
main := proc(compiler: Str) {
    windows := host_os() == "windows"
    mut exe := ""
    if windows { exe = ".exe" }
    dir := "tmp/link_objects"
    if mkdir_p(dir) != 0 { panic("cannot create link regression directory") }
    for item in array(Str, "first", "second") {
        mut value := "11"
        if item == "second" { value = "22" }
        File.writefile(format(dir, "/", item, "_bridge.c"), format(
            "#include \"ext.h\"\nI64 link_value(void) { return ", value, "; }\n"))
        File.writefile(format(dir, "/", item, ".til"), format(
            "mode cli\nlink_c(\"", item, "_bridge.c\")\n",
            "link_value := ext_proc() returns shallow I64 {}\n",
            "main := proc() { if link_value() != ", value,
            " { panic(\"linked another program's bridge\") } }\n"))
    }
    first_bin := format(dir, "/first", exe)
    second_bin := format(dir, "/second", exe)
    // A stale B would hide a wrapper that never matched A's link command.
    File.remove(second_bin)
    wrapper := format(dir, "/cc", exe)
    wrapper_source := format(dir, "/cc.til")
    compiler_literal := compiler.replace("\\", "\\\\").replace("\"", "\\\"")
    File.writefile(wrapper_source, format(
        "mode cli\nimport(\"std/sys\")\nmain := proc(args: ..Str) {\n",
        "    mut linking := false\n",
        "    for i in 0..args.len() {\n",
        "        if args[i] == \"-o\" && i + 1 < args.len() {\n",
        "            if args[i + 1] == \"", first_bin, "\" { linking = true }\n",
        "        }\n    }\n",
        "    if linking {\n",
        "        Cmd.new(\"", compiler_literal, "\", \"build\", \"--force-rebuild\", \"-o\", \"", second_bin,
        "\", \"-c\", \"", dir, "/second.c\", \"", dir, "/second.til\").run_checked()\n",
        "    }\n",
        "    mut cc := \"cc\"\n",
        "    if host_os() == \"windows\" { cc = \"gcc\" }\n",
        "    command := Cmd.new(cc)\n",
        "    for arg in args { command.arg(arg) }\n",
        "    exit(command.run())\n}\n"))
    Cmd.new(compiler, "build", "--force-rebuild", "-o", wrapper,
        "-c", format(dir, "/cc.c"), wrapper_source).run_checked()
    // compile_c invokes its compiler through the host shell. cmd.exe needs
    // native separators in the command name; the forwarded argv uses Cmd.
    mut cc_command := wrapper.clone()
    if windows { cc_command = wrapper.replace("/", "\\") }
    Cmd.new(compiler, "build", "--force-rebuild", format("--cc=", cc_command),
        "-o", first_bin, "-c", format(dir, "/first.c"), format(dir, "/first.til")).run_checked()
    if File.exists(second_bin).not() { panic("compiler wrapper did not build B during A's link") }
    Cmd.new(first_bin).run_checked()
    Cmd.new(second_bin).run_checked()

    // #482: reuse the first fixture to test a stateful archive through BOTH
    // direct calls and link_c. The helper references only nng.c's setter,
    // not the separate pair constructor. Linking an archive into the FFI
    // bridge used to create a second socket table: direct pair0_open came
    // from the shared twin, but this helper saw "Object closed".
    File.writefile(format(dir, "/first_bridge.c"), format(
        "#include \"ext.h\"\n",
        "extern int nng_socket_set_ms(nng_socket, const char *, int);\n",
        "I32 link_nng_timeout(nng_socket socket) {\n",
        "    return nng_socket_set_ms(socket, \"recv-timeout\", 1234);\n}\n"))
    File.writefile(format(dir, "/first.til"), format(
        "mode cli\nimport(\"../../examples/lib/custom_modes/nng_base\")\n",
        "link_c(\"first_bridge.c\")\n",
        "link_nng_timeout := ext_proc(shallow socket: nng_socket) returns shallow I32 {}\n",
        "main := proc() {\n",
        "    mut socket := nng_socket(id=0)\n",
        "    check(nng_pair0_open(socket), \"direct open\")\n",
        "    check(link_nng_timeout(socket), \"helper timeout\")\n",
        "    mut timeout : I32 = 0\n",
        "    check(nng_socket_get_ms(socket, \"recv-timeout\".c_str, timeout), \"direct get\")\n",
        "    assert(timeout == 1234)\n",
        "    check(nng_close(socket), \"direct close\")\n",
        "    nng_fini()\n",
        "    println(\"nng link_c instance PASS\")\n}\n"))
    for action in array(Str, "run", "interpret") {
        command := Cmd.new(compiler, action)
        if action == "run" {
            command.args("--force-rebuild", "-o", first_bin, "-c", format(dir, "/first.c"))
        }
        command.arg(format(dir, "/first.til")).capture()
        status := command.run()
        if (status != 0).or(command.out().contains("nng link_c instance PASS").not()) {
            panic("NNG helper/direct instance regression (", action, ", exit ", status,
                "): ", command.out(), command.err())
        }
    }
    println("link_objects PASS")
}
