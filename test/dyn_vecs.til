mode test

import("../src/std/dyn_vec")

test_dyn_vec_push_get := test() {
    mut v := DynVec.new(I64)
    v.push(own 42)
    v.push(own 99)
    v.push(own 7)

    ref a : I64 = v[0]
    ref b : I64 = v[1]
    ref c : I64 = v[2]

    assert_eq(I64, a, 42)
    assert_eq(I64, b, 99)
    assert_eq(I64, c, 7)
    assert_eq(USize, v.len(), 3)
}

test_dyn_vec_grow := test() {
    mut v := DynVec.new(I64)
    // default cap is 4, push 8 to force growth
    v.push(own 1)
    v.push(own 2)
    v.push(own 3)
    v.push(own 4)
    v.push(own 5)
    v.push(own 6)
    v.push(own 7)
    v.push(own 8)

    assert_eq(USize, v.len(), 8)
    ref first : I64 = v[0]
    ref last : I64 = v[7]
    assert_eq(I64, first, 1)
    assert_eq(I64, last, 8)
}

test_dyn_vec_strings := test() {
    mut v := DynVec.new(Str)
    v.push(own "hello")
    v.push(own "world")

    ref a : Str = v[0]
    ref b : Str = v[1]

    assert_eq(Str, a, "hello")
    assert_eq(Str, b, "world")
    assert_eq(USize, v.len(), 2)
}

test_dyn_vec_set := test() {
    mut v := DynVec.new(I64)
    v.push(own 10)
    v.push(own 20)
    v.push(own 30)

    // set middle element
    v.set(1, own 99)!
    ref a : I64 = v[0]
    ref b : I64 = v[1]
    ref c : I64 = v[2]
    assert_eq(I64, a, 10)
    assert_eq(I64, b, 99)
    assert_eq(I64, c, 30)

    // set first element
    v.set(0, own 42)!
    ref d : I64 = v[0]
    assert_eq(I64, d, 42)
}

test_dyn_vec_set_str := test() {
    mut v := DynVec.new(Str)
    v.push(own "aaa")
    v.push(own "bbb")

    v.set(0, own "xxx")!
    ref a : Str = v[0]
    ref b : Str = v[1]
    assert_eq(Str, a, "xxx")
    assert_eq(Str, b, "bbb")
}

// Issue #225 (Dyn* follow-up): subscript assignment now works on
// DynVec too -- `v[i] = x` -> `v.set(i, own x)!`.
test_dyn_vec_subscript_assign := test() {
    mut v := DynVec.new(I64)
    v.push(own 10)
    v.push(own 20)
    v.push(own 30)
    v[0] = 100
    idx : USize = 1
    v[idx.add(1)] = 300
    ref a : I64 = v[0]
    ref b : I64 = v[1]
    ref c : I64 = v[2]
    assert_eq(I64, a, 100)
    assert_eq(I64, b, 20)
    assert_eq(I64, c, 300)
}

// OOB set throws; the bang form panics, the `?` form catches. Str
// element so the owned value's throw-path cleanup runs under ASAN.
test_dyn_vec_subscript_assign_oob := test() {
    mut v := DynVec.new(Str)
    v.push(own "a")
    mut caught := false
    v.set(5, own "unstored")?
    catch (err: OutOfBounds) {
        caught = true
    }
    assert(caught)
}

test_dyn_vec_get_oob := test() {
    mut v := DynVec.new(I64)
    v.push(own 10)
    v.push(own 20)
    mut caught := false
    ref _x : Dynamic = v.get(99)?
    catch (e: OutOfBounds) {
        caught = e.eq(OutOfBounds())
    }
    assert(caught)
}

test_dyn_vec_size := test() {
    assert_eq(USize, I64.size(), 8)
    assert_eq(USize, U8.size(), 1)
    assert_eq(USize, Str.size(), dyn_size_of("Str"))
    assert_eq(USize, Bool.size(), 1)
    assert_eq(USize, DynVec.size(), Str.size() * 2 + Dynamic.size())
}

test_dyn_vec_dynamic := test() {
    mut v := DynVec.new(Dynamic)
    // Use pointer-sized allocs so FFI DynVec.push reads valid memory.
    // Fill each with a distinct non-zero sentinel so the post-push
    // is(a, b) check verifies stored bytes really differ (ASAN's
    // malloc returns zeroed/uniform bytes, which would otherwise
    // make uninitialized buffers compare equal).
    mut p1 : U8 = malloc(Dynamic.size().to_uptr())
    mut p2 : U8 = malloc(Dynamic.size().to_uptr())
    memset(p1, 170, Dynamic.size().to_uptr())
    memset(p2, 187, Dynamic.size().to_uptr())
    v.push(own p1)
    v.push(own p2)

    ref a : Dynamic = v[0]
    ref b : Dynamic = v[1]

    expect(is_null(a).not(), "first dynamic pointer should not be null")
    expect(is_null(b).not(), "second dynamic pointer should not be null")
    expect(ptr_eq(a, b).not(), "distinct dynamic pointers stay distinct")
}

test_dyn_vec_pop := test() {
    mut v := DynVec.new(I64)
    v.push(own 11)
    v.push(own 22)
    v.push(own 33)

    popped : I64 = v.pop()
    assert_eq(I64, popped, 33)
    assert_eq(USize, v.len(), 2)

    ref a : I64 = v[0]
    ref b : I64 = v[1]
    assert_eq(I64, a, 11)
    assert_eq(I64, b, 22)

    v.push(own 44)
    assert_eq(I64, popped, 33)

    ref c : I64 = v[2]
    assert_eq(I64, c, 44)
    free(own popped)
}

test_dyn_vec_take_prefix := test() {
    mut v := DynVec.new(I64)
    v.push(own 10)
    v.push(own 20)
    v.push(own 30)
    v.push(own 40)

    prefix := v.take_prefix(2)

    assert_eq(USize, prefix.len(), 2)
    assert_eq(USize, v.len(), 2)

    ref p0 : I64 = prefix[0]
    ref p1 : I64 = prefix[1]
    ref v0 : I64 = v[0]
    ref v1 : I64 = v[1]

    assert_eq(I64, p0, 10)
    assert_eq(I64, p1, 20)
    assert_eq(I64, v0, 30)
    assert_eq(I64, v1, 40)
}

test_dyn_vec_take_prefix_str := test() {
    mut v := DynVec.new(Str)
    v.push(own "aa")
    v.push(own "bb")
    v.push(own "cc")

    prefix := v.take_prefix(1)

    assert_eq(USize, prefix.len(), 1)
    assert_eq(USize, v.len(), 2)

    ref p0 : Str = prefix[0]
    ref v0 : Str = v[0]
    ref v1 : Str = v[1]

    assert_eq(Str, p0, "aa")
    assert_eq(Str, v0, "bb")
    assert_eq(Str, v1, "cc")
}

test_dyn_vec_append := test() {
    mut a := DynVec.new(I64)
    mut b := DynVec.new(I64)
    a.push(own 1)
    a.push(own 2)
    b.push(own 3)
    b.push(own 4)

    a.append(own b)

    assert_eq(USize, a.len(), 4)
    ref a0 : I64 = a[0]
    ref a1 : I64 = a[1]
    ref a2 : I64 = a[2]
    ref a3 : I64 = a[3]
    assert_eq(I64, a0, 1)
    assert_eq(I64, a1, 2)
    assert_eq(I64, a2, 3)
    assert_eq(I64, a3, 4)
}

test_dyn_vec_append_str := test() {
    mut a := DynVec.new(Str)
    mut b := DynVec.new(Str)
    a.push(own "aa")
    b.push(own "bb")
    b.push(own "cc")

    a.append(own b)

    assert_eq(USize, a.len(), 3)
    ref a0 : Str = a[0]
    ref a1 : Str = a[1]
    ref a2 : Str = a[2]
    assert_eq(Str, a0, "aa")
    assert_eq(Str, a1, "bb")
    assert_eq(Str, a2, "cc")
}

test_dyn_vec_take_prefix_append_roundtrip := test() {
    mut v := DynVec.new(I64)
    v.push(own 5)
    v.push(own 6)
    v.push(own 7)
    v.push(own 8)

    mut prefix := v.take_prefix(2)
    prefix.append(own v)

    assert_eq(USize, prefix.len(), 4)
    ref p0 : I64 = prefix[0]
    ref p1 : I64 = prefix[1]
    ref p2 : I64 = prefix[2]
    ref p3 : I64 = prefix[3]
    assert_eq(I64, p0, 5)
    assert_eq(I64, p1, 6)
    assert_eq(I64, p2, 7)
    assert_eq(I64, p3, 8)
}

// #323 API symmetry: the four Vec methods DynVec was missing.
test_dyn_vec_with_capacity := test() {
    mut v := DynVec.with_capacity(I64, 8)
    assert_eq(USize, v.len(), 0)
    assert(v.cap.gte(8))
    for i in 0..8 { v.push(own i) }
    assert_eq(USize, v.len(), 8)
    ref first : I64 = v.get(0)!
    ref last : I64 = v.get(7)!
    assert_eq(I64, first, 0)
    assert_eq(I64, last, 7)
}

test_dyn_vec_remove_at := test() {
    mut v := DynVec.new(I64)
    v.push(own 10)
    v.push(own 20)
    v.push(own 30)
    v.remove_at(1)!
    assert_eq(USize, v.len(), 2)
    ref a : I64 = v.get(0)!
    ref b : I64 = v.get(1)!
    assert_eq(I64, a, 10)
    assert_eq(I64, b, 30)
}

test_dyn_vec_remove_at_str_frees := test() {
    mut v := DynVec.new(Str)
    v.push(own "alpha")
    v.push(own "beta")
    v.remove_at(0)!
    assert_eq(USize, v.len(), 1)
    ref s : Str = v.get(0)!
    assert_eq(Str, s, "beta")
}

test_dyn_vec_truncate := test() {
    mut v := DynVec.new(Str)
    for i in 0..5 { v.push(own format("s", i.to_str())) }
    v.truncate(2)
    assert_eq(USize, v.len(), 2)
    ref s0 : Str = v.get(0)!
    ref s1 : Str = v.get(1)!
    assert_eq(Str, s0, "s0")
    assert_eq(Str, s1, "s1")
    v.truncate(0)
    assert_eq(USize, v.len(), 0)
}

test_dyn_vec_delete_marked := test() {
    mut v := DynVec.new(Str)
    for i in 0..4 { v.push(own format("e", i.to_str())) }
    mut marks : U8 = malloc(4)
    memset(marks, 0, 4)
    memset(ptr_add(marks, 1), 1, 1)
    memset(ptr_add(marks, 3), 1, 1)
    v.delete_marked(marks)
    free(own marks)
    assert_eq(USize, v.len(), 2)
    ref k0 : Str = v.get(0)!
    ref k1 : Str = v.get(1)!
    assert_eq(Str, k0, "e0")
    assert_eq(Str, k1, "e2")
}

// DynVec.take -- self's elements move into the returned DynVec and self is
// left empty, keeping the element metadata that lets it be pushed to again
// (Vec.take's counterpart).
test_dyn_vec_take := test() {
    mut v := DynVec.new(Str)
    v.push(own "a")
    v.push(own "b")

    taken := v.take()

    assert_eq(USize, taken.len(), 2)
    assert_eq(USize, v.len(), 0)
    ref t0 : Str = taken[0]
    ref t1 : Str = taken[1]
    assert_eq(Str, t0, "a")
    assert_eq(Str, t1, "b")

    v.push(own "c")
    assert_eq(USize, v.len(), 1)
    ref v0 : Str = v[0]
    assert_eq(Str, v0, "c")
}

test_dyn_vec_take_empty := test() {
    mut v := DynVec.new(I64)
    taken := v.take()
    assert_eq(USize, taken.len(), 0)
    assert_eq(USize, v.len(), 0)
}

// DynVec.move_to -- dest drops whatever it held and takes self's contents,
// leaving self empty. The argument-flipped spelling of move_from.
test_dyn_vec_move_to := test() {
    mut src := DynVec.new(Str)
    mut dest := DynVec.new(Str)
    src.push(own "x")
    src.push(own "y")
    dest.push(own "old")

    src.move_to(dest)

    assert_eq(USize, dest.len(), 2)
    assert_eq(USize, src.len(), 0)
    ref d0 : Str = dest[0]
    ref d1 : Str = dest[1]
    assert_eq(Str, d0, "x")
    assert_eq(Str, d1, "y")
}
