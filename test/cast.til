mode test

// Issue #212: integer cast via UFCS `e.cast(T)`. Two families supported:
//
//   - Same-size reinterpret (any signedness combo):
//       U8<->I8 (1B), I16<->U16 (2B), I32<->U32 (4B), I64<->U64 (8B)
//     Bits unchanged; out-of-range values wrap rather than panic.
//
//   - Same-signedness widening (src.size < target.size, both signed
//     or both unsigned): U8->U16/U32/U64, I8->I16/I32/I64,
//     U16->U32/U64, I16->I32/I64, U32->U64, I32->I64. The numeric
//     value is preserved -- zero-extend for unsigned, sign-extend for
//     signed. Cross-signedness widening is intentionally rejected (it
//     changes how the bits are interpreted).

test_cast_u8_i8 := test() {
    // 0xFF reinterpreted as I8 is -1.
    a : U8 = 255
    assert_eq(I64, a.cast(I8).cast(I64), -1)

    // -1 reinterpreted as U8 is 255 (round trip).
    b : I8 = -1
    assert_eq(I64, b.cast(U8).to_i64(), 255)

    // Small in-range value is unchanged.
    c : U8 = 42
    assert_eq(I64, c.cast(I8).cast(I64), 42)

    // High bit set: 0x80 -> I8 minimum.
    d : U8 = 128
    assert_eq(I64, d.cast(I8).cast(I64), -128)
}

test_cast_u16_i16 := test() {
    // 0xFFFF reinterpreted as I16 is -1.
    a : U16 = 65535
    assert_eq(I64, a.cast(I16).cast(I64), -1)

    // -1 reinterpreted as U16 is 65535 (round trip).
    b : I16 = -1
    assert_eq(I64, b.cast(U16).to_i64(), 65535)

    // High bit set: 0x8000 -> I16 minimum.
    c : U16 = 32768
    assert_eq(I64, c.cast(I16).cast(I64), -32768)
}

test_cast_u32_i32 := test() {
    // 0xFFFFFFFF reinterpreted as I32 is -1.
    a : U32 = 4294967295
    assert_eq(I64, a.cast(I32).cast(I64), -1)

    // Small in-range value is unchanged.
    b : U32 = 42
    assert_eq(I64, b.cast(I32).cast(I64), 42)

    // High bit set: 0x80000000 -> I32 minimum.
    c : U32 = 2147483648
    assert_eq(I64, c.cast(I32).cast(I64), -2147483648)
}

test_cast_i32_u32 := test() {
    // -1 reinterpreted as U32 is 0xFFFFFFFF.
    a : I32 = -1
    assert_eq(I64, a.cast(U32).to_i64(), 4294967295)

    b : I32 = 100
    assert_eq(I64, b.cast(U32).to_i64(), 100)
}

test_cast_u64_i64 := test() {
    a : U64 = 1000
    assert_eq(I64, a.cast(I64), 1000)

    // -1 as U64 is 2^64-1; cast back to I64 is -1 again (round trip).
    c : I64 = -1
    d : U64 = c.cast(U64)
    assert_eq(Str, d.to_str(), "18446744073709551615")
    assert_eq(I64, d.cast(I64), -1)
}

test_cast_plain_call := test() {
    // Non-UFCS spelling works too.
    a : U32 = 4294967295
    assert_eq(I64, cast(a, I32).cast(I64), -1)
}

test_cast_widen_unsigned := test() {
    // Unsigned widening: value preserved, high bits zero-filled.
    a : U8 = 200
    assert_eq(I64, a.cast(U16).to_i64(), 200)
    assert_eq(I64, a.cast(U32).to_i64(), 200)
    assert_eq(I64, a.cast(U64).cast(I64), 200)

    b : U16 = 65535
    assert_eq(I64, b.cast(U32).to_i64(), 65535)
    assert_eq(I64, b.cast(U64).cast(I64), 65535)

    c : U32 = 4000000000
    assert_eq(Str, c.cast(U64).to_str(), "4000000000")
}

test_cast_widen_signed := test() {
    // Signed widening preserves the numeric value: -1 in any signed
    // width is still -1 after widening (sign-extended bits).
    a : I8 = -1
    assert_eq(I64, a.cast(I16).cast(I64), -1)
    assert_eq(I64, a.cast(I32).cast(I64), -1)
    assert_eq(I64, a.cast(I64), -1)

    // Negative in-range value also rides through.
    b : I8 = -128
    assert_eq(I64, b.cast(I32).cast(I64), -128)

    // Positive value: trivial.
    c : I16 = 30000
    assert_eq(I64, c.cast(I32).cast(I64), 30000)
    assert_eq(I64, c.cast(I64), 30000)

    d : I32 = -123456789
    assert_eq(I64, d.cast(I64), -123456789)
}

// assert_eq is generic over the element type T (it used to be I64-only, so
// non-I64 values had to be widened with .to_i64() / .cast(I64) just to be
// compared). It now takes a `T: Type` arg and compares via T.eq, so each
// width is asserted against its own native type -- no widening crutch.
test_assert_eq_generic := test() {
    assert_eq(I64, -1, -1)
    assert_eq(U8, 200, 200)
    assert_eq(U16, 65535, 65535)
    assert_eq(I32, 30000, 30000)
    assert_eq(U32, 4000000000, 4000000000)
    assert_eq(U64, 4000000000, 4000000000)
    assert_eq(USize, 42, 42)
}

// Proc boundaries keep runtime conversions distinct from folded literals.
priv runtime_i8 := proc(v: F64) returns I8 { noop_proc(); return v.cast(I8) }
priv runtime_u8 := proc(v: F64) returns U8 { noop_proc(); return v.cast(U8) }
priv runtime_i16 := proc(v: F64) returns I16 { noop_proc(); return v.cast(I16) }
priv runtime_u16 := proc(v: F64) returns U16 { noop_proc(); return v.cast(U16) }
priv runtime_i32 := proc(v: F64) returns I32 { noop_proc(); return v.cast(I32) }
priv runtime_u32 := proc(v: F64) returns U32 { noop_proc(); return v.cast(U32) }
priv runtime_i64 := proc(v: F64) returns I64 { noop_proc(); return v.cast(I64) }
priv runtime_u64 := proc(v: F64) returns U64 { noop_proc(); return v.cast(U64) }
priv runtime_float := proc(v: U64) returns F32 { noop_proc(); return v.cast(F32) }
priv runtime_double := proc(v: I64) returns F64 { noop_proc(); return v.cast(F64) }

test_numeric_casts := test() {
    assert_eq(I8, runtime_i8(-128.99), -128)
    assert_eq(I8, (-128.99).cast(I8), -128)
    assert_eq(U8, runtime_u8(-0.99), 0)
    assert_eq(U8, runtime_u8(255.99), 255)
    assert_eq(I16, runtime_i16(-32768.99), -32768)
    assert_eq(U16, runtime_u16(65535.99), 65535)
    assert_eq(I32, runtime_i32(-2147483648.99), I32.MIN)
    assert_eq(U32, runtime_u32(4294967295.99), U32.MAX)
    assert_eq(I64, runtime_i64(-9223372036854775808.0), I64.MIN)
    assert_eq(I64, runtime_i64(9223372036854774784.0), 9223372036854774784)
    assert_eq(U64, runtime_u64(18446744073709549568.0), 18446744073709549568)
    assert_eq(U64, 18446744073709549568.0.cast(U64), 18446744073709549568)
    assert_eq(U64, runtime_u64(9223372036854775808.0), 9223372036854775808)
    assert_eq(F32, runtime_float(16777217), 16777216)
    assert_eq(F32, runtime_float(16777219), 16777220)
    assert_eq(F64, runtime_double(-9007199254740993), -9007199254740992.0)
    assert_eq(F32, U64.MAX.cast(F32), U64.MAX.to_f32())
    assert_eq(F64, U64.MAX.cast(F64), U64.MAX.to_f64())
    assert_eq(F32, I64.MIN.cast(F32), I64.MIN.to_f32())
    small : I8 = -1
    assert_eq(F64, small.cast(F64), -1.0)
    wide_float : F64 = 1.25
    assert_eq(F32, wide_float.cast(F32).cast(F64).cast(F32), 1.25)
    single : F32 = -1.75
    assert_eq(I32, single.cast(I32), -1)
    assert_eq(U32, (-0.75).cast(U32), 0)
}

S4 := Simd(I32,4)
U4 := Simd(U32,4)
F4 := Simd(F32,4)
D4 := Simd(F64,4)

test_numeric_simd_casts := test() {
    mut seed : I32 = -1
    seed = seed+0
    signed_values := S4.new(seed,I32.MIN,16777217,16777219)
    unsigned_values := signed_values.cast(U32)
    assert_eq(U32,unsigned_values[0],U32.MAX)
    assert_eq(I32,unsigned_values.cast(I32)[0],-1)
    floats := signed_values.cast(F32)
    assert_eq(F32,floats[0],-1)
    assert_eq(F32,floats[2],16777216)
    assert_eq(F32,floats[3],16777220)
    positive := U4.new(U32.MAX,2147483648,16777217,16777219).cast(F32)
    assert_eq(F32,positive[0],4294967296)
    assert_eq(F32,positive[1],2147483648)
    trunc := F4.new(-1.75,1.75,-0.75,2147483520).cast(I32)
    assert_eq(I32,trunc[0],-1)
    assert_eq(I32,trunc[2],0)
    assert_eq(I32,trunc[3],2147483520)
    explicit_values := F4.new(-1.75,1.75,-0.75,2147483520)
    plain := cast(explicit_values,S4)
    assert_eq(I32,plain[0],-1)
    wide := D4.new(-128.99,255.99,65535.99,4294967295.99).cast(I64)
    assert_eq(I64,wide[0],-128)
    assert_eq(I64,wide[3],4294967295)
}
