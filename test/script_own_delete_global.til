mode script

// #275: a script-scope binding deleted by the program is NOT dropped again
// by session teardown. The garbager puts `Vec.delete(v, false)` in the AST
// for a script global -- drop the innards, leave the box, exactly what the
// compiled backend emits -- and teardown then ran heap_drop_by_type over
// the same value, freeing the container's buffer twice (ASAN: double-free
// through free_container_data; without ASAN, glibc aborted with "corrupted
// size vs. prev_size"). Compiled mode was correct throughout, so this was
// an interpreter-only divergence.
//
// The reads after each delete are the point: they prove the value was
// still usable up to the delete, so a fix that simply skipped the delete
// would not pass.

mut v := Vec(I64).new()
v.push(own 42)
v.push(own 7)
println(v.len().to_str())
own v.delete(true)

mut t := Tuple.new()
t.push(I64, own 5)
println(t.len().to_str())
own t.delete()

Holder := struct { inner := Vec(I64).new() }
mut h := Holder()
h.inner.push(own 9)
println(h.inner.len().to_str())
own h.delete()

// The EXPLICIT namespace spelling, not just the UFCS receiver form above.
// The two reach the callee by different routes -- the UFCS form goes
// through the receiver-desugaring path, this one binds the argument
// directly -- and both were independently broken, so a fix on one route
// would not have covered the other. (This one is what made "not the UFCS
// own-bit renumbering" a reliable finding while the bug was being chased:
// it fails identically without the fix.)
mut w := Vec(I64).new()
w.push(own 1)
w.push(own 2)
w.push(own 3)
println(w.len().to_str())
Vec(I64).delete(own w, true)

// call_free = FALSE, the other half of the destructor's contract: drop the
// contents, leave the box. This is the shape a moved-out mark alone cannot
// express -- "contents released, box still mine" -- so it distinguishes the
// payload_released fix from a transfer-marking one, which leaves this case
// aborting while `delete(true)` passes.
mut x := Vec(I64).new()
x.push(own 11)
println(x.len().to_str())
own x.delete(false)

println("ok")
