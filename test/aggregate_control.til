mode script
import("std/file")

Record := struct { mark: U8 = 0; number: I64 = 0; text: Str = "" }
Plain := struct { number: I64 = 0 }
Envelope := struct { prefix: U8 = 0; record: Record = Record(); tail: USize = 0 }
Owned := struct {
    own record: Record = Record()
namespace:
    clone := func(self: Owned) returns Owned { return Owned(record=self.record.clone()) }
}
Counts := struct { drops: I64 = 0 }
Tracked := struct {
    ref counts: Counts
    active := false
    text := ""
namespace:
    clone := func(self: Tracked) returns Tracked {
        return Tracked(counts=self.counts, active=self.active, text=self.text.clone())
    }
    delete := func(own self: Tracked, call_free: Bool = true) {
        // Array.new zeroes unused slots: only initialized resources count.
        if self.active { self.counts.drops++ }
        Str.delete(own self.text, false)
        if call_free { free(own self) }
    }
}
make_record := func(n: I64, text: Str) returns Record {
    return Record(mark=3, number=n, text=text.clone())
}
make_plain := proc(n: I64) returns Plain { println("plain"); return Plain(number=n) }
replace := func(mut value: Record, n: I64, text: Str) {
    value = make_record(n, text)
}
borrow := func(value: Record) returns ref Record { return value }
consume := func(own value: Tracked) { assert(value.text.len() > 0) }
make_tracked := func(counts: Counts, text: Str) returns Tracked {
    return Tracked(counts=counts, active=true, text=text.clone())
}
replace_tracked := func(mut value: Tracked, text: Str) {
    value = make_tracked(value.counts, text)
}
constants := func() returns Array(Record) {
    return array(Record, Record(number=1, text="constant"), Record(number=2, text="second"))
}
show_constants := proc(values: Array(Record)) { println(values[0].text) }
check_bounds := proc(values: Array(Record), index: USize) {
    ref value : Record = values.get(index)?
    catch (e: OutOfBounds) { println("bounds"); return }
    println(value.text)
}
track_lifetimes := func(mut counts: Counts, source: Str) {
    mut tracked := Tracked(counts=counts, active=true, text=source.clone())
    tracked_copy := tracked.clone()
    tracked = Tracked(counts=counts, active=true, text="again")
    assert(counts.drops == 1)
    consume(own tracked_copy)
    assert(counts.drops == 2)
    replace_tracked(tracked, "again")
    assert(counts.drops == 3)
    mut tracked_array := Array(Tracked).new(2)
    tracked_array[0] = tracked.clone()
    tracked_array[1] = tracked.clone()
    tracked_array[0] = tracked.clone()
    expect(counts.drops == 4, "drops after array replacement: ", counts.drops.to_str())
    // Keep both owners live through that observation: cleanup is last-use.
    assert(tracked.active)
    assert(tracked_array[0].active)
}

EnumTag := enum(U16) { First = 17, Second = 513 }
EnumWideTag := enum(U64) { First = 0, Second = 4294967296 }
EnumScalar := enum(U16) { Empty = 5, Byte: U8 = 19, Flag: Bool = 37, Count: USize = 601 }
EnumValue := enum { Empty, Number: I64, Text: Str, Item: Record }
EnumBorrow := enum { Empty, One: ref Record, Other: ref Record }
EnumRef := enum(U16) { Some: ref Record = 19, None = 37 }
EnumOwned := enum { Some: Tracked, None }
EnumDrop := enum { Empty, Value: Tracked, Text: Str }
EnumNested := enum { Empty, Inner: EnumScalar, Text: Str }
EnumHolder := struct { mark: U8 = 0; value: EnumValue = EnumValue.Empty; tail: USize = 0 }
EnumTemplate := enum { Some: Record, None }

enum_value := func(n: I64) returns EnumValue {
    if n == 0 { return EnumValue.Empty }
    return EnumValue.Number(n)
}
enum_wide_tag := func(n: I64) returns EnumWideTag {
    if n == 0 { return EnumWideTag.First }
    return EnumWideTag.Second
}
consume_enum := func(own value: EnumDrop) { assert(value.is(EnumDrop.Value)) }
consume_niche := func(own value: EnumOwned) { assert(value.is(EnumOwned.Some)) }
enum_constants := func() returns Array(EnumValue) {
    return array(EnumValue, EnumValue.Number(3), EnumValue.Text("constant enum"), EnumValue.Empty)
}
enum_owned_constants := func() returns Array(EnumTemplate) {
    return array(EnumTemplate, EnumTemplate.Some(Record(number=3,text="owned enum")), EnumTemplate.None)
}
enum_once := func(mut calls: I64, seed: I64) returns EnumValue {
    calls++
    return EnumValue.Number(seed)
}
check_enums := func(seed: I64, counts: Counts) {
    tag := EnumTag.Second
    assert(tag.is(EnumTag.Second))
    assert(tag.eq(EnumTag.First).not())
    assert(EnumTag.First.cmp(tag) < 0)
    assert(tag.to_str().eq("Second"))
    assert(EnumTag.size() == 2)
    wide := enum_wide_tag(seed)
    assert(wide.is(EnumWideTag.Second))
    assert(EnumWideTag.First.cmp(wide) < 0)
    switch tag { case .First, .Second: assert(tag.is(EnumTag.Second)) }
    switch wide { case .First: panic("wrong wide tag"); case .Second: assert(wide.is(EnumWideTag.Second)) }

    mut narrow := EnumScalar.Byte(seed.to_u8())
    switch narrow {
    case .Byte(byte): byte = byte + 1
    case: panic("wrong narrow enum variant")
    }
    switch narrow {
    case .Byte(byte): assert(byte.to_i64() == seed + 1)
    case: panic("lost narrow enum payload")
    }
    narrow = EnumScalar.Flag(true)
    switch narrow { case .Flag(flag): assert(flag); case: panic("wrong Bool payload") }
    narrow = EnumScalar.Count(seed.to_usize())
    switch narrow { case .Count(count): assert(count == seed.to_usize()); case: panic("wrong USize payload") }
    nested := EnumNested.Inner(narrow.clone())
    switch nested { case EnumNested.Inner(EnumScalar.Count(count)): assert(count == seed.to_usize()); case: panic("wrong nested pattern") }
    mut calls := 0
    selected := enum_once(calls,seed)
    switch selected { case .Number(n): assert(n == seed); case: panic("wrong switch result") }
    expect(calls == 1, "enum scrutinee calls: ", calls.to_str())
    mut matched := false
    switch seed { case 0..5: panic("wrong range arm"); case 6..8: matched = true; case: panic("missing range arm") }
    assert(matched)
    mut loop_hits := 0
    for i in 0..4 {
        switch i { case 0: continue; case 2: break; case: loop_hits++ }
    }
    assert(loop_hits == 1)

    mut value := enum_value(seed)
    switch value { case .Number(n): assert(n == seed); case: panic("wrong returned enum") }
    value = EnumValue.Text(format("enum", seed.to_str()))
    switch value { case .Text(text): text = format(text,"!"); case: panic("wrong Str payload") }
    copy := value.clone()
    value = EnumValue.Item(make_record(seed,"record"))
    assert(copy.to_str().eq(format("Text(enum",seed.to_str(),"!)")))
    switch value { case .Item(record): assert(record.text.eq("record")); case: panic("wrong record payload") }
    mut record := make_record(seed,"borrow")
    mut borrowed_value := EnumBorrow.One(record)
    switch borrowed_value { case .One(borrowed): borrowed.number = borrowed.number + 1; case: panic("wrong borrowed payload") }
    assert(record.number == seed + 1)

    some := EnumRef.Some(record)
    assert(some.is(EnumRef.Some))
    assert(EnumRef.None.is(EnumRef.Some).not())
    switch some { case .Some(borrowed): assert(borrowed.text.eq("borrow")); case .None: panic("lost niche pointer") }
    option := safe_ref(record)
    assert(option.is_some())
    assert(option.unwrap().number == seed + 1)
    mut number := seed
    number_option := safe_ref(number)
    ref mut number_alias : I64 = number_option.unwrap()
    number_alias = number_alias + 2
    assert(number == seed + 2)
    empty_number := Option(ref I64).None
    assert(empty_number.is_none())
    assert(empty_number.unwrap_or(number) == seed + 2)
    owned_option := Option(Record).Some(make_record(seed,"taken"))
    taken := Option(Record).take(own owned_option)
    assert(taken.number == seed && taken.text.eq("taken"))

    mut holder := EnumHolder(mark=9,value=copy.clone(),tail=17)
    holder.value = EnumValue.Number(seed)
    switch holder.value { case .Number(n): assert(n == seed); case: panic("wrong enum field") }
    assert(holder.mark == 9 && holder.tail == 17)
    mut constants := enum_constants()
    constants[0] = EnumValue.Number(seed)
    original := enum_constants()
    switch original[0] { case .Number(n): assert(n == 3); case: panic("mutated enum template") }
    switch constants[1] { case .Text(text): assert(text.eq("constant enum")); case: panic("wrong template payload") }
    mut owned_constants := enum_owned_constants()
    own_constant_copy := enum_owned_constants()
    owned_constants[0] = EnumTemplate.None
    switch own_constant_copy[0] { case .Some(item): assert(item.text.eq("owned enum")); case: panic("mutated owned niche template") }

    before := counts.drops
    mut dropped := EnumDrop.Value(make_tracked(counts,"tagged"))
    dropped_copy := dropped.clone()
    dropped = EnumDrop.Empty
    assert(counts.drops == before + 1)
    consume_enum(own dropped_copy)
    assert(counts.drops == before + 2)
    assert(dropped.is(EnumDrop.Empty))
    mut owned := EnumOwned.Some(make_tracked(counts,"niche"))
    owned_copy := owned.clone()
    owned = EnumOwned.None
    assert(counts.drops == before + 3)
    consume_niche(own owned_copy)
    assert(counts.drops == before + 4)
    assert(owned.is(EnumOwned.None))
}

UnaryAction := func(value: I64) returns I64
SixAction := func(a: I64,b: I64,c: I64,d: I64,e: I64,f: I64) returns I64
SixRecordAction := func(a: I64,b: I64,c: I64,d: I64,e: I64,f: I64) returns Record
BorrowAction := func(mut value: I64) returns ref I64
SizeAction := func() returns USize
SizeFactory := func(counts: Counts) returns SizeAction
SlotAction := func(mut action: UnaryAction, seed: I64) returns ref UnaryAction
RecordAction := func(number: I64) returns Record
TextPrinter := proc(text: Str)
ActionHolder := struct { action: UnaryAction }
SizeHolder := struct { action: SizeAction }
BodyHolder := struct { action: Body = {} }
action_add := func(value: I64) returns I64 { return value + 1 }
action_borrow := func(mut value: I64) returns ref I64 { value++; return value }
action_record := func(number: I64) returns Record { return make_record(number,"callable record") }
action_print := proc(text: Str) { print_single(text) }
constant_actions := func() returns Array(ActionHolder) {
    return array(ActionHolder,ActionHolder(action=action_add))
}
invoke_action := func(action: UnaryAction, value: I64) returns I64 { return action(value) }
invoke_body := proc(action: Body) { action(); action() }
make_action := func(seed: I64) returns UnaryAction {
    total := seed
    return func(value: I64) returns I64 [own mut total] {
        total = total + value
        return total
    }
}
replace_action := func(mut action: UnaryAction, seed: I64) { action = make_action(seed) }
borrow_action_slot := func(mut action: UnaryAction, seed: I64) returns ref UnaryAction {
    action = make_action(seed)
    return action
}
make_size_action := func(counts: Counts) returns SizeAction {
    resource := make_tracked(counts,"captured resource")
    return func() returns USize [own resource] { return resource.text.len() }
}
make_owned_size_action := func(own resource: Tracked) returns SizeAction {
    return func() returns USize [own resource] { return resource.text.len() }
}
traced_factory := func(mut trace: I64) returns UnaryAction {
    trace = trace * 10 + 1
    initial := 1
    return func(value: I64) returns I64 [own initial] { return initial + value }
}
traced_argument := func(mut trace: I64) returns I64 { trace = trace * 10 + 2; return 5 }
check_callables := proc(seed: I64, counts: Counts) {
    action : UnaryAction = action_add
    assert(invoke_action(action,seed) == seed + 1)
    alias := action_add
    assert(alias(seed) == seed + 1)
    actions := constant_actions()
    assert(actions[0].action(seed) == seed + 1)
    output : TextPrinter = action_print
    output("callable builtins passed\n")
    mut stateful : UnaryAction = make_action(seed)
    assert(stateful(2) == seed + 2)
    replace_action(stateful,seed + 10)
    assert(stateful(1) == seed + 11)
    holder := ActionHolder(action=stateful)
    copied := holder.clone()
    assert(holder.action(2) == seed + 13)
    assert(copied.action(3) == seed + 14)
    assert(make_action(seed)(3) == seed + 3)
    mut trace := 0
    assert(traced_factory(trace)(traced_argument(trace)) == 6)
    assert(trace == 12)
    mut replaceable : UnaryAction = make_action(seed)
    slot_getter : SlotAction = borrow_action_slot
    slot_getter(replaceable,seed + 30)
    assert(replaceable(1) == seed + 31)
    ref mut slot_alias : UnaryAction = slot_getter(replaceable,seed + 40)
    assert(slot_alias(1) == seed + 41)
    replace_action(slot_alias,seed + 50)
    assert(replaceable(2) == seed + 52)
    record_action : RecordAction = action_record
    returned_record := record_action(seed)
    assert(returned_record.number == seed && returned_record.text.eq("callable record"))
    record_action(seed)

    start := seed
    private : UnaryAction = func(value: I64) returns I64 [shallow mut start] {
        start = start + value
        return start
    }
    assert(private(4) == seed + 4)
    assert(private(2) == seed + 6)
    assert(start == seed)
    // A stored closure passed to a borrowing parameter is the stored one,
    // not a copy: its private state persists across calls. The interpreter
    // used to pass a clone of the field, losing the state and leaking it.
    private_holder := ActionHolder(action=func(value: I64) returns I64 [shallow mut start] {
        start = start + value
        return start
    })
    assert(invoke_action(private_holder.action,4) == seed + 4)
    assert(invoke_action(private_holder.action,2) == seed + 6)
    bias := seed
    six : SixAction = func(a: I64,b: I64,c: I64,d: I64,e: I64,f: I64) returns I64 [own bias] {
        return a+b+c+d+e+f+bias
    }
    assert(six(1,2,3,4,5,6) == seed + 21)
    record_bias := seed
    six_record : SixRecordAction = func(a: I64,b: I64,c: I64,d: I64,e: I64,f: I64) returns Record [own record_bias] {
        return make_record(a+b+c+d+e+f+record_bias,"six record")
    }
    combined := six_record(1,2,3,4,5,6)
    assert(combined.number == seed + 21 && combined.text.eq("six record"))
    mut number := seed
    by_reference : UnaryAction = func(value: I64) returns I64 [mut number] { number = number + value; return number }
    borrow_action : BorrowAction = action_borrow
    ref mut reference : I64 = borrow_action(number)
    reference = reference + 3
    assert(number == seed + 4)
    assert(by_reference(1) == seed + 5)

    mut observed : I64 = 0
    inner : Body = [mut observed] { observed++ }
    outer : Body = [own inner] { inner() }
    body_holder := BodyHolder(action=outer)
    body_copy := body_holder.clone()
    invoke_body(body_holder.action)
    invoke_body(body_copy.action)
    assert(observed == 4)
    [shallow mut start, mut observed] { start++; observed = observed + start }
    assert(observed == seed + 5)
    assert(start == seed)

    before := counts.drops
    factory : SizeFactory = make_size_action
    resource_action : SizeAction = factory(counts)
    resource_holder := SizeHolder(action=resource_action)
    resource_copy := resource_holder.clone()
    assert(resource_holder.action() == 17)
    own resource_holder.delete()
    assert(counts.drops == before + 1)
    assert(resource_copy.action() == 17)
    own resource_copy.delete()
    assert(counts.drops == before + 2)
    assert(make_size_action(counts)() == 17)
    assert(counts.drops == before + 3)
    assert(make_owned_size_action(own make_tracked(counts,"owned input"))() == 11)
    assert(counts.drops == before + 4)
}

mut seed : I64 = 6
seed++
make_plain(seed)
mut source := Str.with_capacity(16)
source.push_str("alpha")
mut first := make_record(seed, source)
copy := first.clone()
first.text = first.text.substr(0, 2).clone()
assert(copy.text.eq("alpha"))
assert(first.text.eq("al"))
replace(first, seed + 1, "beta")
assert(first.number == 8)
assert(first.text.eq("beta"))
mut other := make_record(seed, "reference")
mut ref_owner := make_record(seed, "old reference")
ref mut alias : Record = borrow(ref_owner)
alias.number = 99
assert(ref_owner.number == 99)
assert(other.number == seed)
other.text = "changed elsewhere"
assert(ref_owner.text.eq("old reference"))
assert(first.number == 8)
mut nested := Envelope(prefix=9, record=first.clone(), tail=17)
nested.record.number = nested.record.number + 10
assert(nested.record.number == 18)
assert(first.number == 8)
assert(nested.prefix == 9)
assert(nested.tail == 17)
// mark (padded to number's 8-byte alignment), number, text; the total
// rounds up to 8. Not `Str.size() + 16`: a --usize=32 Str (#313) is 12 bytes.
assert(Record.size() == (Str.size() + 16 + 7) / 8 * 8)
mut boxed := Owned(record=make_record(seed, "owned"))
boxed_copy := boxed.clone()
boxed.record.text = "replacement"
assert(boxed.record.text.eq("replacement"))
assert(boxed_copy.record.text.eq("owned"))
boxed = Owned(record=make_record(seed + 1, "new box"))
assert(boxed.record.number == 8)

mut records := Array(Record).new(2)
records[0] = copy.clone()
records[1] = nested.record.clone()
records_copy := records.clone()
ref mut changed_record : Record = records[0]
changed_record.text = "array replacement"
assert(records_copy[0].text.eq("alpha"))
mut sum := 0
for value in records_copy { sum = sum + value.number }
assert(sum == 25)
check_bounds(records_copy, records_copy.len())
mut folded := constants()
original := constants()
ref mut changed_constant : Record = folded[0]
changed_constant.text = "changed"
show_constants(original)

mut counts := Counts()
track_lifetimes(counts, source)
expect(counts.drops == 7, "drops after scope: ", counts.drops.to_str())
make_tracked(counts, source)
expect(counts.drops == 8, "discarded aggregate was not destroyed: ", counts.drops.to_str())

File.writefile("tmp/aggregate_control_file", source)
File.appendfile("tmp/aggregate_control_file", "!")
contents := File.readfile("tmp/aggregate_control_file")
assert(contents.eq("alpha!"))
File.remove("tmp/aggregate_control_file")
assert(File.exists("tmp/aggregate_control_file").not())
check_enums(seed,counts)
check_callables(seed,counts)
println("aggregate control passed")
