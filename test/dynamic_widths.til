mode cli

import("../src/std/sys")
import("../src/std/file")
import("../src/self/targets")

realpath_str := ext_proc(path: Str) returns Str {}

WORK := "tmp/dynamic_widths"

execute := proc(cmd: Cmd) returns Str {
    cmd.cwd(WORK)
    cmd.capture()
    if cmd.run() != 0 { panic(cmd.render(), ": ", cmd.out(), cmd.err()) }
    return cmd.out()
}

reject := proc(cmd: Cmd, diagnostic: Str) {
    cmd.cwd(WORK)
    cmd.capture()
    status := cmd.run()
    output := format(cmd.out(), cmd.err())
    if status == 0 || output.contains(diagnostic).not() {
        panic("missing diagnostic '", diagnostic, "' for ", cmd.render(), ": ", output)
    }
}

expect_output := proc(cmd: Cmd, expected: Str) {
    actual := execute(cmd)
    if actual != expected { panic(cmd.render(), ": expected '", expected, "', got '", actual, "'") }
}

// #400: target word checks must not read the host layout cache. Pointer-only
// aggregates shrink, while fixed U64 values and two-word aggregates do not fit.
priv check_dynamic_widths := proc(compiler: Str) {
    File.writefile(format(WORK, "/dynamic_fit.til"),
        "mode script\nimport(\"dynamic_shallow\")\na := make_words()\nprintln(a.len().to_str())\n")
    // One failing translation must report all three independent rejections.
    // Match each diagnostic, rather than accepting the first error as proof
    // that the other operands were checked.
    File.writefile(format(WORK, "/dynamic_wide.til"),
        "mode script\nx : U64 = 123\na := array(Dynamic, x)\nprintln(a.len().to_str())\ny : U64 = 456\nmut v := Vec(Dynamic).new()\nv.push(own y)\nprintln(v.len().to_str())\nPair := struct { a: UPtr; b: UPtr }\np := Pair(a = 1, b = 2)\npa := array(Dynamic, p)\nprintln(pa.len().to_str())\n")
    File.writefile(format(WORK, "/dynamic_shallow.til"),
        format("mode lib\nWord := struct { bits: UPtr }\nNested := struct { word: Word }\nPair := struct { a: U32; b: U32 }\nread_word := func(x: Nested) returns UPtr { return x.word.bits }\nread_pair := func(x: Pair) returns U32 { return x.a + x.b }\nmake_words := func() returns Array(Dynamic) { x := Nested(word = Word(bits = 123)); return array(Dynamic, x) }\n",
        "priv make_size_count := macro() returns FuncDef {\nif USize.size() <= UPtr.size() { return func(count: USize) returns UPtr { return count.to_uptr() } }\nelse { return func(count: USize) returns UPtr { converted := count.to_uptr(); if converted.cast(U64) != count.cast(U64) { panic(\"usize_to_uptr: byte count exceeds pointer width\") }; return converted } }\n}\nconvert_count := make_size_count()\n",
        "size_is_two := macro(T: Type) returns FuncDef { if T.size() == 2 { return func() returns Bool { return true } } else { return func() returns Bool { return false } } }\n",
        "check_dynamic := proc(name: Str) {\nif Dynamic.size() != UPtr.size() { panic(\"Dynamic width\") }\nif dyn_size_of(name) != Dynamic.size() { panic(\"runtime width\") }\nx : UPtr = 123\ny : UPtr = 456\na := array(Dynamic, x, y)\nmut v := Vec(Dynamic).new()\nv.push(own x)\nv.push(own y)\nmut t := Tuple.new()\nt.push_all_dynamic(a)\nref first : UPtr = t.get(0)\nref second : UPtr = t.get(1)\nref last : UPtr = v.unsafe_get(1)\nif first != 123 || second != 456 || last != 456 { panic(\"word copy/stride\") }\nif t.size_at(0) != Dynamic.size() { panic(\"tuple width\") }\nprintln(\"dynamic widths passed\")\n}\n"))
    File.writefile(format(WORK, "/dynamic_width.til"),
        "mode cli\nimport(\"dynamic_shallow\")\nCountAlias := U16\nalias_is_two := size_is_two(CountAlias)\nmain := proc(name: Str) { if alias_is_two().not() { panic(\"imported size generator\") }; check_dynamic(name) }\n")
    // Core runs first: overflow must be caught by the migrated core factory,
    // rather than being hidden by the imported fixture's identical check.
    File.writefile(format(WORK, "/pointer_count.til"),
        "mode cli\nimport(\"dynamic_shallow\")\nmain := proc(counts: ..Str) { for count : Str in counts { converted := usize_to_uptr(count.to_usize()); if converted != convert_count(count.to_usize()) { panic(\"size generator conversion\") }; println(converted.to_str()) } }\n")
    mut count_executable := "./bin/pointer_count"
    if host_os() == "windows" { count_executable = "./bin/pointer_count.exe" }
    for width : Str in array(Str, "32", "64") {
        flag := format("--usize=", width)
        expect_output(Cmd.new(compiler, "run", flag, "dynamic_width.til", "Dynamic"), "dynamic widths passed\n")
        expect_output(Cmd.new(compiler, "interpret", flag, "dynamic_width.til", "Dynamic"), "dynamic widths passed\n")
        // Build once per width; varying a runtime argument must not rebuild
        // the same program. Batch successful interpretations for the same
        // reason. Overflow cases still need separate processes: panic exits.
        _built := execute(Cmd.new(compiler, "build", flag, "pointer_count.til"))
        wide_native := width.eq("64").and(target_uptr_name(detect_current_target()) == "U64")
        native_code := File.readfile(format(WORK, "/gen/til/pointer_count.c"))
        needs_check := width.eq("64").and(wide_native.not())
        if native_code.contains("usize_to_uptr: byte count exceeds pointer width") != needs_check {
            panic("wrong native byte-count macro branch: ", flag)
        }
        if wide_native {
            expected := "0\n4294967295\n4294967296\n18446744073709551615\n"
            expect_output(Cmd.new(count_executable, "0", "4294967295", "4294967296", "18446744073709551615"), expected)
            expect_output(Cmd.new(compiler, "interpret", flag, "pointer_count.til", "0", "4294967295", "4294967296", "18446744073709551615"), expected)
        } else {
            expect_output(Cmd.new(count_executable, "0", "4294967295"), "0\n4294967295\n")
            expect_output(Cmd.new(compiler, "interpret", flag, "pointer_count.til", "0", "4294967295"), "0\n4294967295\n")
        }
        if width.eq("64").and(wide_native.not()) {
            for count : Str in array(Str, "4294967296", "18446744073709551615") {
                reject(Cmd.new(count_executable, count), "usize_to_uptr: byte count exceeds pointer width")
                reject(Cmd.new(compiler, "interpret", flag, "pointer_count.til", count),
                    "usize_to_uptr: byte count exceeds pointer width")
            }
        }
    }
    for target : Str in array(Str, "linux-x86", "linux-arm32", "linux-riscv32", "windows-x86", "wasm32") {
        tf := format("--target=", target)
        for width : Str in array(Str, "32", "64") {
            flag := format("--usize=", width)
            rejected := Cmd.new(compiler, "translate", tf, flag, "dynamic_wide.til")
            rejected.cwd(WORK)
            rejected.capture()
            status := rejected.run()
            output := format(rejected.out(), rejected.err())
            for diagnostic : Str in array(Str, "one 4-byte word", "() literal is 'U64' (8 bytes)",
                "but 'U64' is 8 bytes, so parameter 'val'", "() literal is 'Pair' (8 bytes)") {
                if status.eq(0).or(output.contains(diagnostic).not()) {
                    panic("missing diagnostic '", diagnostic, "' for ", rejected.render(), ": ", output)
                }
            }
            // Translate the shared library once: its exports cover word-fit,
            // parameter ABI, Dynamic size emission and the whole runtime probe.
            // The native/QEMU wrappers call these same bodies.
            _shallow := execute(Cmd.new(compiler, "translate", tf, flag, "-c", "dynamic_shallow.c", "dynamic_shallow.til"))
            emitted := File.readfile(format(WORK, "/dynamic_shallow.c"))
            if emitted.contains("read_word(Nested x)").and(emitted.contains("read_pair(Pair * x)")).not() {
                panic("target auto-shallow classification: ", target, " ", flag)
            }
            if emitted.contains("Dynamic_size(void) {\n    return sizeof(void *);").not() {
                panic("Dynamic.size lost target sizeof: ", target, " ", flag)
            }
            // Inspect C before optimization: only the narrowing specialization
            // may contain the overflow path. Runtime tests below check its limits.
            if emitted.contains("usize_to_uptr: byte count exceeds pointer width") != width.eq("64") {
                panic("wrong target byte-count macro branch: ", target, " ", flag)
            }
        }
    }
    // All five targets above select the same U32 pointer type. Their emitted
    // specialization is checked separately, but interpreting that same scalar
    // conversion only needs one target per USize width. Pointer-bearing
    // container storage stays host-sized and is exercised by the native runs.
    for width : Str in array(Str, "32", "64") {
        flag := format("--usize=", width)
        expect_output(Cmd.new(compiler, "interpret", "--target=linux-x86", flag,
            "pointer_count.til", "0", "4294967295"), "0\n4294967295\n")
        if width == "64" {
            for count : Str in array(Str, "4294967296", "18446744073709551615") {
                reject(Cmd.new(compiler, "interpret", "--target=linux-x86", flag,
                    "pointer_count.til", count), "usize_to_uptr: byte count exceeds pointer width")
            }
        }
    }
}

main := proc(args: ..Str) {
    compiler := realpath_str(args[0])
    File.remove_tree(WORK)
    mkdir_p(WORK)
    check_dynamic_widths(compiler)
    // A well-typed runtime value is not a compile-time input. Failure must
    // diagnose the unavailable value, never select the false branch.
    File.writefile(format(WORK, "/dynamic_wide.til"),
        "mode script\nmut runtime_limit: USize = 8\nchoose := macro(T: Type) returns FuncDef { if T.size() <= runtime_limit { return func() returns I64 { return 1 } } else { return func() returns I64 { return 2 } } }\nchosen := choose(U8)\nprintln(chosen().to_str())\n")
    reject(Cmd.new(compiler, "translate", "dynamic_wide.til"),
        "not known at compile time")
    // Exercise target aggregate layout through an ordinary custom method.
    // The skipped raw allocation must not fail merely because it was typed.
    File.writefile(format(WORK, "/dynamic_wide.til"),
        "mode script\nRecord := struct { address: UPtr; byte: U8 }\nCustom := struct { namespace:\nsize := func() returns USize { values := array(Record, Record(address = 11, byte = 3), Record(address = 22, byte = 5)); ref second: Record = values.unsafe_get(1); return second.byte.to_usize() }\n}\nchoose := macro(skip: Bool) returns FuncDef { if skip || Custom.size() == 5 { return func() returns Bool { return true } } else { return func() returns Bool { return false } } }\nselected := choose(true)\nassert(selected())\n")
    _skipped := execute(Cmd.new(compiler, "translate", "--target=linux-x86", "--usize=64", "dynamic_wide.til"))
    source := File.readfile(format(WORK, "/dynamic_wide.til"))
    File.writefile(format(WORK, "/dynamic_wide.til"), source.replace("choose(true)", "choose(false)"))
    if target_uptr_name(detect_current_target()) == "U64" {
        reject(Cmd.new(compiler, "translate", "--target=linux-x86", "--usize=64", "dynamic_wide.til"),
            "with different host and target storage sizes")
    }
    println("dynamic width options passed")
}
