mode cli
import("unicode_cases")

main := proc() {
    assert(!unicode_scalar(-1) && !unicode_scalar(0xd800) && !unicode_scalar(0x110000))
    bad_prefix := format(Str.from_byte(0xe2), Str.from_byte(0x82), "A")
    assert(grapheme_next(bad_prefix, 0) == 2 && grapheme_previous(bad_prefix, 2) == 0)
    assert(grapheme_next("", 0) == 0 && grapheme_previous("", 0) == 0)
    assert(grapheme_floor("", 10) == 0 && grapheme_ceil("", 10) == 0)
    check_unicode_cases(0, UNICODE_CASE_FIRST_END)
}
