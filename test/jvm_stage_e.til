mode cli

JvmPoint := struct {
    x := 1
    y := 2
}

JvmBorrow := struct {
    ref point : JvmPoint
    ref scalar : I64
}

JvmToken := enum { Num: I64, Eof }

JvmOwned := struct {
    text := "owned"
}

// A type alias has no runtime value of its own.
JvmPointAlias := JvmPoint

// An owned aggregate field: the generated delete probes it with to_ptr.
JvmOwner := struct {
    own inner := JvmOwned()
}

// Tags past the int a Java switch takes.
JvmWide := enum(U64) { Low = 7, High = 4294967303 }

// A borrowed payload, and an I64 one whose eq/clone bindings share names
// with the borrowed arm's.
JvmRefTag := enum { Borrowed: ref JvmPoint, Number: I64 }

// An owned aggregate payload: clone must copy it, not share it.
JvmBox := enum { Pt: JvmPoint, Nothing }

// A struct clone clones its enum field the same way.
JvmBoxHolder := struct {
    box := JvmBox.Nothing
}

// #416: an owned Str payload, written through its binding.
JvmNote := enum { Text: Str, Empty }

// Borrows of locals that are later reassigned.
JvmLender := struct {
    ref p : JvmPoint
    ref s : Str
}

jvm_heap_text := proc(s: Str) returns Str {
    noop_proc()
    mut out := Str.with_capacity(8)
    out.push_str(s)
    return out
}

take_jvm_point := func(own p: JvmPoint) returns I64 {
    return p.x
}

bump_jvm_field := func(mut n: I64) { n.inc() }

// #416: assigning to a payload binding writes the enum's payload.
retitle_jvm_note := func(mut n: JvmNote) {
    switch n {
    case .Text(t): t = "changed"
    case .Empty:
    }
}

replace_jvm_box := func(mut b: JvmBox) {
    switch b {
    case .Pt(p): p = JvmPoint(x = 6)
    case .Nothing:
    }
}

bump_jvm_box := func(mut b: JvmBox) {
    switch b {
    case .Pt(p): p.x = 9
    case .Nothing:
    }
}

show_jvm_box := proc(b: JvmBox) {
    switch b {
    case .Pt(p): println("box ", p.x.to_str())
    case .Nothing: println("nothing")
    }
}

// A scalar payload binding is a ref into the enum: the write lands in it.
bump_jvm_token := func(mut t: JvmToken) {
    switch t {
    case .Num(n): n.inc()
    case .Eof:
    }
}

main := proc() {
    mut point := JvmPoint()
    point.x = 7
    copy := point.clone()

    mut scalar : I64 = 8
    borrowed := JvmBorrow(point = point, scalar = scalar)
    bump_jvm_field(borrowed.scalar)

    mut token := JvmToken.Num(41)
    bump_jvm_token(token)

    mut buf : U8 = malloc(JvmPoint.size())
    memset(buf, 0, JvmPoint.size())
    memcpy(buf, 65, 1)
    ref first : U8 = ptr_add(buf, 0)
    ref borrowed_scalar : I64 = borrowed.scalar

    println(copy.x.to_str(), " ", borrowed_scalar.to_str(), " ",
        token.is(JvmToken.Num).to_str(), " ", first.to_i64().to_str())
    free(own buf)
    switch token {
    case .Num(n): println("token ", n.to_str())
    case .Eof:
    }

    mut values := Vec(I64).new()
    values.push(own 3)
    values.push(own 4)
    ref second : I64 = values[1]

    mut table := Map(Str, I64).new()
    table.set("answer", own 42)
    ref answer : I64 = table["answer"]

    mut unique := Set(I64).new()
    unique.add(own 7)
    println(second.to_str(), " ", answer.to_str(), " ", unique.has(7).to_str())

    mut original := JvmOwned()
    cloned := original.clone()
    own original.delete(false)
    println(cloned.text)

    moved_from := JvmOwned(text = "moved")
    mut moved_to := JvmOwned(text = "old")
    moved_to = moved_from
    println(moved_to.text)

    alias_point := JvmPointAlias(x = 3)
    owner := JvmOwner()
    println(alias_point.x.to_str(), " ", owner.inner.text)

    wide := JvmWide.High
    switch wide {
    case .Low: println("wide low")
    case .High: println("wide high")
    }

    same_point := JvmPoint(x = 7)
    if JvmRefTag.Borrowed(point).eq(JvmRefTag.Borrowed(same_point)) { println("ref payloads equal") }
    if JvmRefTag.Number(4).eq(JvmRefTag.Number(5)).not() { println("numbers differ") }

    mut box := JvmBox.Pt(JvmPoint(x = 1))
    box_copy := box.clone()
    bump_jvm_box(box)
    show_jvm_box(box)
    show_jvm_box(box_copy)

    mut holder := JvmBoxHolder(box = JvmBox.Pt(JvmPoint(x = 2)))
    holder_copy := holder.clone()
    bump_jvm_box(holder.box)
    show_jvm_box(holder.box)
    show_jvm_box(holder_copy.box)

    mut note := JvmNote.Text("orig")
    retitle_jvm_note(note)
    switch note {
    case .Text(t): println("note ", t)
    case .Empty:
    }
    replace_jvm_box(box)
    show_jvm_box(box)
    // A borrowed payload's binding is the lent value itself.
    mut lent := JvmRefTag.Borrowed(point)
    switch lent {
    case .Borrowed(q): q = JvmPoint(x = 11)
    case .Number(_):
    }
    println("lent ", point.x.to_str())

    // A ref to a local sees the local's reassignment: the local's object
    // is its storage, written in place.
    mut lent_point := JvmPoint(x = 2)
    mut lent_text := jvm_heap_text("one")
    lender := JvmLender(p = lent_point, s = lent_text)
    lent_point = JvmPoint(x = 5)
    lent_text = jvm_heap_text("two")
    println("lender ", lender.p.x.to_str(), " ", lender.s)

    // A value handed away by `own` belongs to its receiver: reassigning
    // the old variable must not reach into the Vec, the callee, the
    // payload or the field that now holds it.
    mut moved_points := Vec(JvmPoint).new()
    mut to_vec := JvmPoint(x = 3)
    moved_points.push(own to_vec)
    to_vec = JvmPoint(x = 4)
    mut to_fn := JvmPoint(x = 6)
    got := take_jvm_point(own to_fn)
    to_fn = JvmPoint(x = 7)
    mut to_payload := JvmPoint(x = 8)
    boxed := JvmBox.Pt(to_payload)
    to_payload = JvmPoint(x = 9)
    mut to_field := JvmOwned(text = "field")
    field_owner := JvmOwner(inner = to_field)
    to_field = JvmOwned(text = "local")
    println("moved ", moved_points[0].x.to_str(), " ", to_vec.x.to_str(), " ",
        got.to_str(), " ", to_fn.x.to_str(), " ", to_payload.x.to_str(), " ",
        field_owner.inner.text, " ", to_field.text)
    show_jvm_box(boxed)
}
