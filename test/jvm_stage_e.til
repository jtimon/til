mode cli

JvmPoint := struct {
    x := 1
    y := 2
}

JvmBorrow := struct {
    ref point : JvmPoint
    ref scalar : I64
}

JvmToken := enum { Num: I64, Eof }

JvmOwned := struct {
    text := "owned"
}

// A type alias has no runtime value of its own.
JvmPointAlias := JvmPoint

// An owned aggregate field: the generated delete probes it with to_ptr.
JvmOwner := struct {
    own inner := JvmOwned()
}

// Tags past the int a Java switch takes.
JvmWide := enum(U64) { Low = 7, High = 4294967303 }

// A borrowed payload, and an I64 one whose eq/clone bindings share names
// with the borrowed arm's.
JvmRefTag := enum { Borrowed: ref JvmPoint, Number: I64 }

// An owned aggregate payload: clone must copy it, not share it.
JvmBox := enum { Pt: JvmPoint, Nothing }

// A struct clone clones its enum field the same way.
JvmBoxHolder := struct {
    box := JvmBox.Nothing
}

bump_jvm_field := func(mut n: I64) { n.inc() }

bump_jvm_box := func(mut b: JvmBox) {
    switch b {
    case .Pt(p): p.x = 9
    case .Nothing:
    }
}

show_jvm_box := proc(b: JvmBox) {
    switch b {
    case .Pt(p): println("box ", p.x.to_str())
    case .Nothing: println("nothing")
    }
}

// A scalar payload binding is a ref into the enum: the write lands in it.
bump_jvm_token := func(mut t: JvmToken) {
    switch t {
    case .Num(n): n.inc()
    case .Eof:
    }
}

main := proc() {
    mut point := JvmPoint()
    point.x = 7
    copy := point.clone()

    mut scalar : I64 = 8
    borrowed := JvmBorrow(point = point, scalar = scalar)
    bump_jvm_field(borrowed.scalar)

    mut token := JvmToken.Num(41)
    bump_jvm_token(token)

    mut buf : U8 = malloc(JvmPoint.size())
    memset(buf, 0, JvmPoint.size())
    memcpy(buf, 65, 1)
    ref first : U8 = ptr_add(buf, 0)
    ref borrowed_scalar : I64 = borrowed.scalar

    println(copy.x.to_str(), " ", borrowed_scalar.to_str(), " ",
        token.is(JvmToken.Num).to_str(), " ", first.to_i64().to_str())
    free(own buf)
    switch token {
    case .Num(n): println("token ", n.to_str())
    case .Eof:
    }

    mut values := Vec(I64).new()
    values.push(own 3)
    values.push(own 4)
    ref second : I64 = values[1]

    mut table := Map(Str, I64).new()
    table.set("answer", own 42)
    ref answer : I64 = table["answer"]

    mut unique := Set(I64).new()
    unique.add(own 7)
    println(second.to_str(), " ", answer.to_str(), " ", unique.has(7).to_str())

    mut original := JvmOwned()
    cloned := original.clone()
    own original.delete(false)
    println(cloned.text)

    moved_from := JvmOwned(text = "moved")
    mut moved_to := JvmOwned(text = "old")
    moved_to = moved_from
    println(moved_to.text)

    alias_point := JvmPointAlias(x = 3)
    owner := JvmOwner()
    println(alias_point.x.to_str(), " ", owner.inner.text)

    wide := JvmWide.High
    switch wide {
    case .Low: println("wide low")
    case .High: println("wide high")
    }

    same_point := JvmPoint(x = 7)
    if JvmRefTag.Borrowed(point).eq(JvmRefTag.Borrowed(same_point)) { println("ref payloads equal") }
    if JvmRefTag.Number(4).eq(JvmRefTag.Number(5)).not() { println("numbers differ") }

    mut box := JvmBox.Pt(JvmPoint(x = 1))
    box_copy := box.clone()
    bump_jvm_box(box)
    show_jvm_box(box)
    show_jvm_box(box_copy)

    mut holder := JvmBoxHolder(box = JvmBox.Pt(JvmPoint(x = 2)))
    holder_copy := holder.clone()
    bump_jvm_box(holder.box)
    show_jvm_box(holder.box)
    show_jvm_box(holder_copy.box)
}
