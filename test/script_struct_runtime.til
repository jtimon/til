mode script

StructSegment := struct {
    start := StructPoint()
    finish := StructPoint()
    active := false
}

StructPoint := struct {
    x := 0
    y := 0
}

StructNamedPoint := struct {
    point := StructPoint()
    name := ""
}

make_struct_named_point := func(name: Str) returns StructNamedPoint {
    return StructNamedPoint(point=StructPoint(x=17, y=19), name=name.clone())
}

struct_named_point_score := func(named: StructNamedPoint) returns I64 {
    return named.point.x + named.point.y + named.name.len().to_i64()
}

rename_struct_named_point := func(mut named: StructNamedPoint) {
    named.name = "beta"
}

mut point := StructPoint(x=2, y=3)
point.x = 7
segment := StructSegment(
    start=StructPoint(x=5, y=7),
    finish=StructPoint(x=11, y=13),
    active=true
)

println((point.x + point.y).to_str())
println((segment.start.x + segment.finish.y).to_str())
if segment.active { println("active") }
mut segment_copy := segment.clone()
if segment.eq(segment_copy) { println("segment equal") }
segment_copy.finish.y = 14
if segment.neq(segment_copy) { println("segment different") }

mut source := Str.with_capacity(5)
source.push_str("alpha")
mut named := make_struct_named_point(source)
copy := named.clone()
if named.eq(copy) { println("named equal") }
rename_struct_named_point(named)
if named.neq(copy) { println("named different") }
println(copy.name)
println(named.name)
println(struct_named_point_score(copy).to_str())
println(struct_named_point_score(named).to_str())
own named.delete()
own copy.delete()
own source.delete()
own segment_copy.delete()

Signal := enum(U16) { Cold = 7, Warm = 12, Hot }
signal_next := func(signal: Signal) returns Signal {
    switch signal {
    case .Cold: return Signal.Warm
    case .Warm: return Signal.Hot
    case .Hot: return Signal.Cold
    }
}
mut current_signal := Signal.Cold
mut turns := 0
while turns < 3 {
    switch current_signal {
    case .Cold: println("cold")
    case .Warm, .Hot: println("warm or hot")
    }
    if current_signal.is(Signal.Warm) { println("is warm") }
    if current_signal.eq(Signal.Hot) { println("equals hot") }
    if current_signal.neq(Signal.Cold) { println("not cold") }
    current_signal = signal_next(current_signal)
    turns++
}
switch current_signal {
case .Hot: println("unexpected hot")
case: println("default cold")
}

WideSignal := enum(U64) { Low = 7, Other = 8, High = 4294967303 }
wide_from_signal := func(signal: Signal) returns WideSignal {
    if signal.is(Signal.Cold) { return WideSignal.High }
    return WideSignal.Low
}
wide := wide_from_signal(current_signal)
if wide.is(WideSignal.High) { println("wide high") }
if wide.neq(WideSignal.Low) { println("wide distinct") }
switch wide {
case .Low: println("unexpected low")
case .High: println("wide switch")
case: println("unexpected wide tag")
}

SmallSignal := enum(U8) { Low = 0, High = 255 }
small_from_signal := func(signal: Signal) returns SmallSignal {
    if signal.is(Signal.Cold) { return SmallSignal.High }
    return SmallSignal.Low
}
small := small_from_signal(current_signal)
if small.eq(SmallSignal.High) { println("small high") }

DefaultSignal := enum { First, Second }
default_from_signal := func(signal: Signal) returns DefaultSignal {
    if signal.is(Signal.Cold) { return DefaultSignal.Second }
    return DefaultSignal.First
}
default_signal := default_from_signal(current_signal)
if default_signal.is(DefaultSignal.Second) { println("default second") }

MediumSignal := enum(U32) { Low = 0, High = 4294967295 }
medium_from_signal := func(signal: Signal) returns MediumSignal {
    if signal.is(Signal.Cold) { return MediumSignal.High }
    return MediumSignal.Low
}
medium := medium_from_signal(current_signal)
if medium.is(MediumSignal.High) { println("medium high") }

counted_signal := func(mut point: StructPoint) returns Signal {
    point.x = point.x + 1
    return Signal.Warm
}
switch counted_signal(point) {
case .Warm:
    switch current_signal {
    case .Cold: println("nested cold")
    case: println("unexpected nested tag")
    }
case: println("unexpected counted tag")
}
if point.x == 8 { println("evaluated once") }

PayloadEnvelope := enum { Empty, Wrapped: PayloadValue }
PayloadValue := enum { Empty, Byte: U8, Count: I64, Text: Str, Record: PayloadRecord }
PayloadRecord := struct {
    number : I64 = 0
    name : Str = ""
}

make_payload_text := func(text: Str) returns PayloadValue {
    if text.is_empty() { return PayloadValue.Empty }
    return PayloadValue.Text(text.clone())
}
replace_payload := func(mut value: PayloadValue, text: Str) {
    value = make_payload_text(text)
}
show_payload := proc(value: PayloadValue) {
    switch value {
    case .Empty: println("payload empty")
    case .Byte(byte): println("payload byte ", byte.to_i64().to_str())
    case .Count(count): println("payload count ", count.to_str())
    case .Text(text): println("payload text ", text)
    case .Record(record): println("payload record ", record.number.to_str(), ":", record.name)
    }
}

mut payload_source := Str.with_capacity(7)
payload_source.push_str("payload")
mut text_payload := make_payload_text(payload_source)
text_payload_copy := text_payload.clone()
if text_payload.eq(text_payload_copy) { println("payload equal") }
switch text_payload {
case .Text(text): text = text.substr(0, 4).clone()
case:
}
if text_payload.neq(text_payload_copy) { println("payload clone independent") }
show_payload(text_payload)
own text_payload.delete()
show_payload(text_payload_copy)

mut count_payload := PayloadValue.Count(41)
switch count_payload {
case .Count(count): count = count + 1
case:
}
show_payload(count_payload)
byte_payload := PayloadValue.Byte(255)
show_payload(byte_payload)
empty_payload := PayloadValue.Empty
show_payload(empty_payload)
if empty_payload.eq(PayloadValue.Empty) { println("empty variant equal") }
show_payload(PayloadValue.Empty)
if empty_payload.neq(byte_payload) { println("payload tags differ") }
if count_payload.is(PayloadValue.Count) { println("payload is count") }

mut record_payload := PayloadValue.Record(PayloadRecord(number=9, name=payload_source.clone()))
record_payload_copy := record_payload.clone()
switch record_payload {
case .Record(record): record.name = record.name.substr(0, 4).clone()
case:
}
if record_payload.neq(record_payload_copy) { println("record clone independent") }
show_payload(record_payload)
own record_payload.delete()
show_payload(record_payload_copy)

envelope := PayloadEnvelope.Wrapped(record_payload_copy.clone())
envelope_copy := envelope.clone()
if envelope.eq(envelope_copy) { println("nested payload equal") }
switch envelope {
case .Wrapped(value):
    switch value {
    case .Record(value): println("shadow payload ", value.name)
    case:
    }
    show_payload(value)
case .Empty: println("unexpected empty envelope")
}
own envelope.delete()
own envelope_copy.delete()

replace_payload(count_payload, payload_source)
show_payload(count_payload)
switch count_payload {
case .Text(text): text = text.substr(1, 6).clone()
case:
}
show_payload(count_payload)
count_payload = PayloadValue.Empty
show_payload(count_payload)

own text_payload_copy.delete()
own record_payload_copy.delete()
own count_payload.delete()
own byte_payload.delete()
own empty_payload.delete()
own payload_source.delete()
