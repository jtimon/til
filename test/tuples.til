mode test

test_tuple_i64 := test() {
    mut t := Tuple.new()
    t.push(I64, own 42)
    t.push(I64, own 99)
    t.push(I64, own 7)

    ref a : I64 = t.get(0)
    ref b : I64 = t.get(1)
    ref c : I64 = t.get(2)

    assert_eq(I64, a, 42)
    assert_eq(I64, b, 99)
    assert_eq(I64, c, 7)
    assert_eq(USize, t.len(), 3)
}

test_tuple_strings := test() {
    mut t := Tuple.new()
    t.push(Str, own "hello")
    t.push(Str, own "world")

    ref a : Str = t.get(0)
    ref b : Str = t.get(1)

    assert_eq(Str, a, "hello")
    assert_eq(Str, b, "world")
    assert_eq(USize, t.len(), 2)
}

test_tuple_mixed := test() {
    mut t := Tuple.new()
    t.push(I64, own 42)
    t.push(Str, own "hello")
    t.push(Bool, own true)

    ref a : I64 = t.get(0)
    ref b : Str = t.get(1)
    ref c : Bool = t.get(2)

    assert_eq(I64, a, 42)
    assert_eq(Str, b, "hello")
    assert(c)
    assert_eq(USize, t.len(), 3)
}

test_tuple_type_at := test() {
    mut t := Tuple.new()
    t.push(I64, own 10)
    t.push(Str, own "world")

    ref tn0 : Str = t.type_at(0)
    ref tn1 : Str = t.type_at(1)
    assert_eq(Str, tn0, "I64")
    assert_eq(Str, tn1, "Str")

    ref sz0 : USize = t.size_at(0)
    ref sz1 : USize = t.size_at(1)
    assert_eq(USize, sz0, 8)
    assert_eq(USize, sz1, Str.size())
}

// #394: an element tagged "Dynamic" is a raw MACHINE WORD, and its slot has
// to be that wide on both backends. Tuple sizes elements through
// dyn_size_of(<type name>) -- a runtime, string-keyed call the constfolder
// cannot reach -- and the compiled dispatcher used to answer 1 for "Dynamic":
// sizeof of the `char _;` placeholder the C backend writes for a field-less
// StructDef, rather than the width `Dynamic.size()` promises. The word was
// truncated to its low byte and every element pushed after it sat seven bytes
// early, so this pins the size AND a second element landing after it.
test_tuple_dynamic_word := test() {
    mut t := Tuple.new()
    t.push(Dynamic, own 4242)
    t.push(I64, own 77)

    ref tn : Str = t.type_at(0)
    assert_eq(Str, tn, "Dynamic")
    ref sz : USize = t.size_at(0)
    assert_eq(USize, sz, Dynamic.size())

    ref word : I64 = t.get(0)
    ref after : I64 = t.get(1)
    assert_eq(I64, word, 4242)
    assert_eq(I64, after, 77)
}

// #392 follow-up: `t[i]` reaches Tuple.get. The parser writes `x[i]` as
// `x.get(i)!`, and Tuple.get does not throw -- it panics on a bad index -- so
// the synthesized bang used to be reported as "function does not throw, remove
// the '!' after the call", pointing at a column where the source has no `!`.
// The subscript is the same call `t.get(i)` makes, so #392 stage B's typed-read
// check applies to it too.
test_tuple_subscript := test() {
    mut t := Tuple.new()
    t.push(I64, own 42)
    t.push(Str, own "hello")

    ref a : I64 = t[0]
    ref b : Str = t[1]
    assert_eq(I64, a, 42)
    assert_eq(Str, b, "hello")
}

test_tuple_clone := test() {
    mut t := Tuple.new()
    t.push(I64, own 42)
    t.push(Str, own "hello")

    t2 := t.clone()
    ref a : I64 = t2.get(0)
    ref b : Str = t2.get(1)
    assert_eq(I64, a, 42)
    assert_eq(Str, b, "hello")
    assert_eq(USize, t2.len(), 2)
}

test_tuple_grow := test() {
    mut t := Tuple.new()
    // Push enough data to force realloc (initial cap = 8 bytes)
    t.push(I64, own 1)
    t.push(I64, own 2)
    t.push(I64, own 3)
    t.push(I64, own 4)

    assert_eq(USize, t.len(), 4)
    ref first : I64 = t.get(0)
    ref last : I64 = t.get(3)
    assert_eq(I64, first, 1)
    assert_eq(I64, last, 4)
}

// #275: dyn_call's reflective path DISPATCHES delete, it does not
// reimplement it. Tuple.delete reaches each element through
// `dyn_call(tn, "delete", 2, ...)`, and that arm used to call
// heap_drop_by_type + heap_free directly: a user-defined delete never ran
// interpreted (the compiled backend ran it), and dropping the fields here
// AND in the body double-freed. The counter proves the body ran, in both
// backends -- an assert alone would pass on a delete that never happened.
mut dyn_delete_ran : I64 = 0

DynDeleteProbe := struct {
    tag := ""
namespace:
    delete := func(own self: DynDeleteProbe, call_free: Bool = true) {
        dyn_delete_ran = dyn_delete_ran + 1
        own self.tag.delete(false)
        if call_free { free(own self) }
    }
}

test_tuple_dyn_delete_runs_user_body := test() {
    dyn_delete_ran = 0
    mut t := Tuple.new()
    t.push(DynDeleteProbe, own DynDeleteProbe(tag = "probe"))
    own t.delete()
    assert_eq(I64, dyn_delete_ran, 1)
}
