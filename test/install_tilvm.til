mode cli

import("../src/std/sys")
import("../src/std/file")
import("../src/self/install")

// Build the installed ASAN host once, then run the semantic families in
// separate processes and guest directories. The SDK is read-only during
// execution. install.til covers rebuilding the compiler through `til install`.

run_families := proc(work: Str, fixture: Str) {
    families := array(Str, "lifecycle", "calls", "lookup", "references", "values")
    mut children := Vec(Cmd).new()
    for family : Str in families {
        directory := format(work, "/", family)
        mkdir_p(directory)
        child := Cmd.new("../bin/tilvm_host", format("../../install_", fixture, "/lib/til"), family)
        child.cwd(directory)
        child.env("PATH", "")
        child.capture()
        child.start()
        children.push(own child)
    }
    // Reap every child before reporting failures, so one failed family
    // cannot leave the others running after the test row has finished.
    mut failures := ""
    for i, child in children {
        status := child.wait()
        if status != 0 {
            failures = format(failures, families[i], " exited ", status.to_str(), ": ", child.out(), child.err(), "\n")
        } else if child.out().contains("TilVm host survived errors and teardown").not() {
            failures = format(failures, families[i], " did not finish: ", child.out(), child.err(), "\n")
        } else {
            println("install TilVm ", families[i], " PASS")
        }
    }
    if failures.len() > 0 { panic("installed TilVm families failed: ", failures) }
}

main := proc(fixture: Str = "tilvm") returns I64 {
    prefix := format("tmp/install_", fixture)
    work := format(prefix, "_work")
    File.remove_tree(prefix)
    File.remove_tree(work)
    mkdir_p(work)
    if install_executable("bin/til", format(prefix, "/bin/til"), ".", prefix) != 0 {
        panic("copy-only TilVm compiler installation failed")
    }
    installed_til := format("../install_", fixture, "/bin/til")

    // #370: SDK imports still resolve through installed logical namespaces.
    // The local module is test code, copied alongside the selected host.
    // Guest files do not exist until that compiled host creates them.
    File.writefile(format(work, "/tilvm_cases.til"), File.readfile("test/tilvm_cases.til"))
    File.writefile(format(work, "/tilvm_host.til"), File.readfile(format("test/", fixture, ".til")))
    vm_build := Cmd.new(installed_til, "build", "--asan", "-o", "bin/tilvm_host", "tilvm_host.til")
    vm_build.cwd(work)
    vm_build.run_checked()
    if fixture == "tilvm" {
        run_families(work, fixture)
        println("install TilVm PASS")
        return 0
    }
    vm_run := Cmd.new("./bin/tilvm_host", format("../install_", fixture, "/lib/til"))
    vm_run.cwd(work)
    vm_run.env("PATH", "")
    vm_run.capture()
    if vm_run.run() != 0 { panic("installed TilVm host failed: ", vm_run.out(), vm_run.err()) }
    if vm_run.out().contains("TilVm host survived errors and teardown").not() {
        panic("installed TilVm host did not finish: ", vm_run.out(), vm_run.err())
    }
    println("install TilVm PASS")
    return 0
}
