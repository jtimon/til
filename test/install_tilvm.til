mode cli

import("../src/std/sys")
import("../src/std/file")
import("../src/self/install")

// The central suite schedules one build prerequisite and separate family
// jobs. Each family runs one child synchronously in its own guest directory;
// the SDK and host executable are read-only products of this invocation's
// build. The standalone command still builds and runs all cases in order.

run_family := proc(work: Str, fixture: Str, family: Str) {
    directory := format(work, "/", family)
    File.remove_tree(directory)
    mkdir_p(directory)
    child := Cmd.new("../bin/tilvm_host", format("../../install_", fixture, "/lib/til"), family)
    child.cwd(directory)
    child.env("PATH", "")
    child.capture()
    if child.run() != 0 { panic("installed TilVm ", family, " failed: ", child.out(), child.err()) }
    if child.out().contains("TilVm host survived errors and teardown").not() {
        panic("installed TilVm ", family, " did not finish: ", child.out(), child.err())
    }
    println("install TilVm ", family, " PASS")
}

main := proc(args: ..Str) returns I64 {
    if args.len() > 2 { panic("expected fixture and optional build/family action") }
    mut fixture := "tilvm"
    mut action := "all"
    if args.len() > 0 { fixture = args[0].borrowed_view() }
    if args.len() > 1 { action = args[1].borrowed_view() }
    prefix := format("tmp/install_", fixture)
    work := format(prefix, "_work")
    if action.eq("all").or(action.eq("build")).not() {
        if fixture != "tilvm" { panic("family action requires the shared TilVm host") }
        switch action {
        case "lifecycle", "calls", "lookup", "references", "values":
            run_family(work, fixture, action)
            return 0
        case: panic("unknown TilVm family: ", action)
        }
    }
    File.remove_tree(prefix)
    File.remove_tree(work)
    mkdir_p(work)
    if install_executable("bin/til", format(prefix, "/bin/til"), ".", prefix) != 0 {
        panic("copy-only TilVm compiler installation failed")
    }
    installed_til := format("../install_", fixture, "/bin/til")

    // #370: SDK imports still resolve through installed logical namespaces.
    // The local module is test code, copied alongside the selected host.
    // Guest files do not exist until that compiled host creates them.
    File.writefile(format(work, "/tilvm_cases.til"), File.readfile("test/tilvm_cases.til"))
    File.writefile(format(work, "/tilvm_host.til"), File.readfile(format("test/", fixture, ".til")))
    vm_build := Cmd.new(installed_til, "build", "--asan", "-o", "bin/tilvm_host", "tilvm_host.til")
    vm_build.cwd(work)
    vm_build.run_checked()
    if action == "build" {
        println("install TilVm build PASS")
        return 0
    }
    vm_run := Cmd.new("./bin/tilvm_host", format("../install_", fixture, "/lib/til"))
    vm_run.cwd(work)
    vm_run.env("PATH", "")
    vm_run.capture()
    if vm_run.run() != 0 { panic("installed TilVm host failed: ", vm_run.out(), vm_run.err()) }
    if vm_run.out().contains("TilVm host survived errors and teardown").not() {
        panic("installed TilVm host did not finish: ", vm_run.out(), vm_run.err())
    }
    println("install TilVm PASS")
    return 0
}
