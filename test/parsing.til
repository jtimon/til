mode test

import("../src/self/lexer")
import("../src/self/parser")

// Helper: tokenize + parse
parse_src := proc(src: Str, symbols: SymbolPool) returns Expr {
    tokens := tokenize(src, "test")
    mut mode_str := ""
    mut anon_counter : I64 = 0
    return parse(tokens, src, "test", mode_str, anon_counter, symbols)
}

assert_builtin_primitive := func(name: Str, expected: Primitive) {
    mut actual := Primitive.I64
    expect(builtin_primitive_from_name(name, actual), "expected builtin primitive ", name)
    assert(actual.is(expected))
}

test_builtin_primitive_name_dispatch := test() {
    assert_builtin_primitive("I64", Primitive.I64)
    assert_builtin_primitive("U8", Primitive.U8)
    assert_builtin_primitive("I8", Primitive.I8)
    assert_builtin_primitive("I16", Primitive.I16)
    assert_builtin_primitive("U16", Primitive.U16)
    assert_builtin_primitive("I32", Primitive.I32)
    assert_builtin_primitive("U32", Primitive.U32)
    assert_builtin_primitive("U64", Primitive.U64)
    assert_builtin_primitive("F32", Primitive.F32)
    assert_builtin_primitive("F64", Primitive.F64)
    assert_builtin_primitive("Bool", Primitive.Bool)

    mut out := Primitive.Bool
    assert(builtin_primitive_from_name("I65", out).not())
    assert(builtin_primitive_from_name("U33", out).not())
    assert(builtin_primitive_from_name("Boo1", out).not())
    assert(builtin_primitive_from_name("Dynamic", out).not())
}

test_empty := test() {
    symbols := SymbolPool()
    root := parse_src("", symbols)
    assert(root.node_type.is(NodeType.Body))
    assert_eq(USize, root.children.len(), 0)
}

test_declaration := test() {
    symbols := SymbolPool()
    root := parse_src("x := 42", symbols)
    assert_eq(USize, root.children.len(), 1)
    ref decl : Expr = root.children[0]
    assert_eq(Str, node_name(decl.node_type), "decl")
    switch decl.node_type {
    case NodeType.Decl(dd):
        assert_eq(Str, dd.name, "x")
        expect(dd.til_type.is(Type.Unknown), "untyped declaration starts unknown")
    case:
        UNREACHABLE()
    }
    assert_eq(USize, decl.children.len(), 1)
    ref val : Expr = decl.children[0]
    assert_eq(Str, node_name(val.node_type), "num")
}

test_typed_decl := test() {
    symbols := SymbolPool()
    root := parse_src("x : I64 = 0", symbols)
    ref decl : Expr = root.children[0]
    switch decl.node_type {
    case NodeType.Decl(dd):
        assert_eq(Str, dd.name, "x")
        assert_eq(Str, dd.type_name(), "I64")
    case:
        UNREACHABLE()
    }
}

test_assignment := test() {
    symbols := SymbolPool()
    root := parse_src("x = 1", symbols)
    ref assign : Expr = root.children[0]
    assert_eq(Str, node_name(assign.node_type), "assign")
    switch assign.node_type {
    case NodeType.Assign(ad):
        assert_eq(Str, ad.name, "x")
    case:
        UNREACHABLE()
    }
    assert_eq(USize, assign.children.len(), 1)
}

test_call := test() {
    symbols := SymbolPool()
    root := parse_src("foo(1, 2)", symbols)
    ref call : Expr = root.children[0]
    assert_eq(Str, node_name(call.node_type), "fcall")
    assert_eq(USize, call.children.len(), 3)
    ref callee : Expr = call.children[0]
    assert_eq(Str, node_name(callee.node_type), "ident")
    switch callee.node_type {
    case NodeType.Ident(ci):
        assert_eq(Str, ci.ident_name(symbols.names), "foo")
    case:
        UNREACHABLE()
    }
}

test_method_call := test() {
    symbols := SymbolPool()
    root := parse_src("x.foo(1)", symbols)
    ref call : Expr = root.children[0]
    assert_eq(Str, node_name(call.node_type), "fcall")
    assert_eq(USize, call.children.len(), 2)
    ref callee : Expr = call.children[0]
    assert_eq(Str, node_name(callee.node_type), "field_access")
    switch callee.node_type {
    case NodeType.FieldAccess(cf):
        assert_eq(Str, cf.field_access_name(symbols.names), "foo")
    case:
        UNREACHABLE()
    }
}

test_method_call_on_subscript_receiver := test() {
    symbols := SymbolPool()
    root := parse_src("e.children[0].set_til_type(t)", symbols)
    ref call : Expr = root.children[0]
    assert_eq(Str, node_name(call.node_type), "fcall")
    ref callee : Expr = call.children[0]
    assert_eq(Str, node_name(callee.node_type), "field_access")
    switch callee.node_type {
    case NodeType.FieldAccess(cf):
        assert_eq(Str, cf.field_access_name(symbols.names), "set_til_type")
    case:
        UNREACHABLE()
    }
}

// Statement-level method chain on a call result: the statement parser
// used to reject the '.' after 'foo()' ("expected statement, found '.'").
test_stmt_chain_on_call := test() {
    symbols := SymbolPool()
    root := parse_src("foo().bar(1)", symbols)
    ref call : Expr = root.children[0]
    assert_eq(Str, node_name(call.node_type), "fcall")
    ref callee : Expr = call.children[0]
    assert_eq(Str, node_name(callee.node_type), "field_access")
    switch callee.node_type {
    case NodeType.FieldAccess(cf):
        assert_eq(Str, cf.field_access_name(symbols.names), "bar")
    case:
        UNREACHABLE()
    }
    ref recv : Expr = callee.children[0]
    assert_eq(Str, node_name(recv.node_type), "fcall")
}

// Statement-level field assignment through a call result
// (`HashMap(I64, I64).hasher = fnv1a` in examples/bench_hashmap.til).
test_stmt_field_assign_on_call := test() {
    symbols := SymbolPool()
    root := parse_src("box(1).field = 2", symbols)
    ref fa : Expr = root.children[0]
    assert_eq(Str, node_name(fa.node_type), "field_assign")
    switch fa.node_type {
    case NodeType.FieldAssign(fad):
        assert_eq(Str, fad.name, "field")
    case:
        UNREACHABLE()
    }
    assert_eq(USize, fa.children.len(), 2)
    ref recv : Expr = fa.children[0]
    assert_eq(Str, node_name(recv.node_type), "fcall")
}

test_if_else := test() {
    symbols := SymbolPool()
    root := parse_src("if true { x = 1 } else { x = 2 }", symbols)
    ref node : Expr = root.children[0]
    assert_eq(Str, node_name(node.node_type), "if")
    assert_eq(USize, node.children.len(), 3)
}

test_while := test() {
    symbols := SymbolPool()
    root := parse_src("while true { x = 1 }", symbols)
    ref node : Expr = root.children[0]
    assert_eq(Str, node_name(node.node_type), "while")
    assert_eq(USize, node.children.len(), 2)
}

test_func_def := test() {
    symbols := SymbolPool()
    root := parse_src("f := func(x: I64) returns I64 { return x }", symbols)
    ref decl : Expr = root.children[0]
    assert_eq(Str, node_name(decl.node_type), "decl")
    assert_eq(USize, decl.children.len(), 1)
    ref fdef : Expr = decl.children[0]
    assert_eq(Str, node_name(fdef.node_type), "func_def")
    switch fdef.node_type {
    case NodeType.FuncDef(fd):
        assert_eq(Str, func_type_name(fd.sig.func_type), "func")
        assert_eq(Str, fd.sig.return_type, "I64")
        assert_eq(USize, fd.sig.params.len(), 1)
    case:
        UNREACHABLE()
    }
}

test_struct_def := test() {
    symbols := SymbolPool()
    root := parse_src("P := struct { mut x := 0 }", symbols)
    ref decl : Expr = root.children[0]
    assert_eq(Str, node_name(decl.node_type), "decl")
    ref sdef : Expr = decl.children[0]
    assert_eq(Str, node_name(sdef.node_type), "struct_def")
    switch sdef.node_type {
    case NodeType.StructDef(sd):
        assert_eq(USize, sd.fields.len(), 1)
    case:
        UNREACHABLE()
    }
}

test_switch := test() {
    symbols := SymbolPool()
    root := parse_src("switch x { case 1: y = 1 case 2: y = 2 case: y = 0 }", symbols)
    ref node : Expr = root.children[0]
    assert_eq(Str, node_name(node.node_type), "switch")
    assert_eq(USize, node.children.len(), 4)
    ref c1 : Expr = node.children[1]
    assert_eq(USize, c1.children.len(), 2)
    ref cd : Expr = node.children[3]
    assert_eq(USize, cd.children.len(), 1)
}

test_for_in := test() {
    symbols := SymbolPool()
    root := parse_src("for i in 0..10 { x = i }", symbols)
    ref node : Expr = root.children[0]
    assert_eq(Str, node_name(node.node_type), "for_in")
    switch node.node_type {
    case NodeType.ForIn(fi):
        assert_eq(Str, fi.name, "i")
    case:
        UNREACHABLE()
    }
    assert_eq(USize, node.children.len(), 2)
}

// #472 (moved from test/lexing.til, which then imports only the lexer).
// Parsing the same source with fresh state twice interns the same names
// in source order and synthesizes the same anonymous type names.
parse_fresh := proc(src: Str, symbols: SymbolPool, mut counter: I64) returns Expr {
    tokens := tokenize(src, "p.til")
    mut mode_str := ""
    return parse(tokens, src, "p.til", mode_str, counter, symbols)
}

test_repeat_parse := test() {
    src := "zeta := struct { b : I64 = 0 }\nalpha := func(x: zeta) returns I64 { return x.b }\npair := enum { One, Two }\np := struct { q : I64 = 1 }(q=2)\nc := enum { Red, Green }.Green\nd := struct { q : I64 = 1 }(q=3)\ne := alpha(zeta(b=1))\n"
    symbols1 := SymbolPool()
    mut counter1 : I64 = 0
    ast1 := parse_fresh(src, symbols1, counter1)
    symbols2 := SymbolPool()
    mut counter2 : I64 = 0
    // A separate buffer holding the same bytes.
    src_copy := src.clone()
    ast2 := parse_fresh(src_copy, symbols2, counter2)
    assert_eq(I64, counter1, counter2)
    // Two distinct inline literals are lifted; the repeated struct shape
    // reuses its first name.
    assert_eq(I64, counter1, 2)
    assert_eq(USize, symbols1.names.len(), symbols2.names.len())
    for i in 0..symbols1.names.len() {
        assert_eq(Str, symbols1.names[i], symbols2.names[i])
    }
    // Symbols are numbered by first reference in source order (lifted
    // anonymous type names when they are lifted), not by spelling or by
    // hash bucket.
    mut order := Vec(Str).new()
    order.push(own "zeta")
    order.push(own "x")
    order.push(own "b")
    order.push(own "AnonStruct0")
    order.push(own "AnonEnum1")
    order.push(own "Green")
    order.push(own "alpha")
    assert_eq(USize, symbols1.names.len(), order.len())
    for i in 0..order.len() {
        assert_eq(Str, symbols1.names[i], order[i])
    }
    assert_eq(Str, ast1.to_str_with_symbols(symbols1.names), ast2.to_str_with_symbols(symbols2.names))
    assert_eq(USize, ast1.children.len(), ast2.children.len())
    for i in 0..ast1.children.len() {
        ref c1 : Expr = ast1.children[i]
        ref c2 : Expr = ast2.children[i]
        assert_eq(U32, c1.line, c2.line)
        assert_eq(U32, c1.col, c2.col)
        assert_eq(Str, node_name(c1.node_type), node_name(c2.node_type))
    }
}
