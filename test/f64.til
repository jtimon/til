mode cli

// The part-1 gap: returning a borrowed param inserts T.clone, which now
// resolves to F64.clone.
id64 := func(w: F64) returns F64 { return w }

main := proc(s: Str, d: F64) {
    x : F64 = 1.5
    println(id64(x).to_str())
    // precision beyond F32: 1e100 overflows a float to inf
    big : F64 = 1.0e100
    println(big.to_str())
    println(s.to_f64().to_str())
    println(d.to_str())
    // operators desugar to the F64.add/mul/div/lt core_funcs
    y := x * 2.0 + 0.25
    println(y.to_str())
    println((y / 0.5).to_str())
    println((x < y).to_str())
    println(F64.cmp(big, x).to_str())
    // conversions, both directions, and int sources
    f : F32 = 2.5
    println(f.to_f64().to_str())
    println(x.to_f32().to_str())
    println(x.to_i64().to_str())
    seven := 7
    println(seven.to_f64().to_str())
    // round-trip repr at full double precision
    third : F64 = 1.0 / 3.0
    println(third.to_repr().to_f64().eq(third).to_str())
}
