mode cli

// Direct ext bindings: the F64 method surface (numbers.til core_funcs:
// clone/add/to_str/...) arrives in the follow-up commit once a bootstrap
// compiler that knows F64 exists; the C functions are already in ext.c.
F64_to_str := ext_func(shallow v: F64) returns Str {}
str_parse_f64 := ext_func(s: Str) returns shallow F64 {}
F64_cmp := ext_func(shallow a: F64, shallow b: F64) returns shallow I64 {}
F64_to_f32 := ext_func(shallow v: F64) returns shallow F32 {}
F32_to_f64 := ext_func(shallow v: F32) returns shallow F64 {}

show := func(w: F64) returns Str { return F64_to_str(w) }

main := proc(s: Str) {
    x : F64 = 1.5
    println(show(x))
    // precision beyond F32: 1e100 overflows a float to inf
    big : F64 = 1.0e100
    println(show(big))
    parsed : F64 = str_parse_f64(s)
    println(show(parsed))
    println(F64_cmp(big, x).to_str())
    f : F32 = 2.5
    println(show(F32_to_f64(f)))
    println(F64_to_f32(x).to_str())
}
