mode lib
// Issue #422: each link() applies only to the targets it lists. The
// linux-arm64 archive never exists, so that build reports it, with the
// mode's build_hint; the linux-x64 -l flag is distinctive, so a build's
// command line shows which links applied.
link("test/imports/no_such_dir_422/libtarget_only.a", "linux-arm64")
link("tilmode422", "linux-x64")
mode_targets_answer := func() returns I64 { return 422 }
