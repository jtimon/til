mode test

Point := struct {
    x := 0
    y := 0
}

Person := struct {
    name := "unknown"
    age := 0
}

NameBox := struct {
    name := "default"
}

Flags := struct {
    active := false
    visible := true
}

Entity := struct {
    const id := 0
    name := "unnamed"
}

test_basic_struct := test() {
    mut p := Point()
    assert_eq(I64, p.x, 0)
    assert_eq(I64, p.y, 0)
    p.x = 5
    p.y = 10
    assert_eq(I64, p.x, 5)
    assert_eq(I64, p.y, 10)
}

test_mixed_types := test() {
    mut bob := Person()
    assert_eq(Str, bob.name, "unknown")
    assert_eq(I64, bob.age, 0)
    bob.name = "Bob"
    bob.age = 30
    assert_eq(Str, bob.name, "Bob")
    assert_eq(I64, bob.age, 30)
}

test_bool_fields := test() {
    mut f := Flags()
    assert(f.active.not())
    assert(f.visible)
    f.active = true
    assert(f.active)
}

test_named_args := test() {
    p2 := Point(x=5)
    assert_eq(I64, p2.x, 5)
    assert_eq(I64, p2.y, 0)
    p3 := Point(y=10)
    assert_eq(I64, p3.x, 0)
    assert_eq(I64, p3.y, 10)
    p4 := Point(x=3, y=7)
    assert_eq(I64, p4.x, 3)
    assert_eq(I64, p4.y, 7)
    alice := Person(name="Alice", age=25)
    assert_eq(Str, alice.name, "Alice")
    assert_eq(I64, alice.age, 25)
}

test_struct_ctor_clone_preserves_source := test() {
    name := "Alice"
    box := NameBox(name=name.clone())
    assert_eq(Str, box.name, "Alice")
    assert_eq(Str, name, "Alice")
}

test_explicit_annotation := test() {
    p5 : Point = Point()
    assert_eq(I64, p5.x, 0)
    p6 : Point = Point(x=42, y=99)
    assert_eq(I64, p6.x, 42)
    assert_eq(I64, p6.y, 99)
}

test_immutable_fields := test() {
    mut e1 := Entity(id=1, name="hero")
    assert_eq(I64, e1.id, 1)
    assert_eq(Str, e1.name, "hero")
    e1.name = "villain"
    assert_eq(Str, e1.name, "villain")
    assert_eq(I64, e1.id, 1)
    e2 := Entity()
    assert_eq(I64, e2.id, 0)
    assert_eq(Str, e2.name, "unnamed")
    e3 := Entity(id=99)
    assert_eq(I64, e3.id, 99)
}

// #242: a field declared with an explicit type and no default is
// required at instantiation; fields with a default stay optional.
Required := struct {
    a : U16 = 0
    b : Str
    c := -1
}

test_required_field := test() {
    r := Required(b = "x")
    assert_eq(U16, r.a, 0)
    assert_eq(Str, r.b, "x")
    assert_eq(I64, r.c, -1)
    r2 := Required(a = 7, b = "y", c = 9)
    assert_eq(U16, r2.a, 7)
    assert_eq(Str, r2.b, "y")
    assert_eq(I64, r2.c, 9)
}

MixedReq := struct {
    x := 1
    label : Str
}

test_mixed_required_optional := test() {
    // Omitting the defaulted field is fine; the required one is supplied.
    m := MixedReq(label = "hi")
    assert_eq(I64, m.x, 1)
    assert_eq(Str, m.label, "hi")
}

// #321 step 1: a ref field with no default is required at instantiation,
// and the ctor arg may be a VALUE field access -- the emitter must borrow
// it (take its address), same as a plain `holder.f = src` field assign.
RefReqSrc := struct {
    tag := 0
    label := "src"
}

RefReq := struct {
    ref name : Str
    n := 0
}

test_required_ref_field_from_field_access := test() {
    mut src := RefReqSrc(label = "borrowed")
    r := RefReq(name = src.label)
    assert_eq(Str, r.name, "borrowed")
    assert_eq(I64, r.n, 0)
    // Write-through: the field borrows src.label, it does not copy it.
    src.label = "changed"
    assert_eq(Str, r.name, "changed")
    // Keep the borrowed source alive past the last read through r.
    assert_eq(Str, src.label, "changed")
}

test_independence := test() {
    mut a := Point()
    b := Point()
    a.x = 1
    assert_eq(I64, a.x, 1)
    assert_eq(I64, b.x, 0)
}

Line := struct {
    start := Point()
    end := Point()
}

test_nested_structs := test() {
    mut l1 := Line()
    assert_eq(I64, l1.start.x, 0)
    assert_eq(I64, l1.start.y, 0)
    assert_eq(I64, l1.end.x, 0)
    assert_eq(I64, l1.end.y, 0)
    l2 := Line(start=Point(x=1, y=2), end=Point(x=3, y=4))
    assert_eq(I64, l2.start.x, 1)
    assert_eq(I64, l2.start.y, 2)
    assert_eq(I64, l2.end.x, 3)
    assert_eq(I64, l2.end.y, 4)
    l3 := Line(end=Point(x=10))
    assert_eq(I64, l3.start.x, 0)
    assert_eq(I64, l3.end.x, 10)
    l1.start.x = 42
    assert_eq(I64, l1.start.x, 42)
    l1.end.y = 99
    assert_eq(I64, l1.end.y, 99)
    l4 := Line()
    assert_eq(I64, l4.start.x, 0)
}

OverrideToStr := struct {
    value := 0
namespace:
    to_str := func(self: OverrideToStr) returns Str { return format("override:", self.value.to_str()) }
}

test_generated_struct_eq_to_str := test() {
    p := Point(x=3, y=7)
    same := Point(x=3, y=7)
    different := Point(x=3, y=8)
    assert(p.eq(same))
    assert(p.eq(different).not())
    assert_eq(Str, p.to_str(), "Point(x=3, y=7)")

    bob := Person(name="Bob", age=30)
    assert_eq(Str, bob.to_str(), "Person(name=Bob, age=30)")

    line := Line(start=Point(x=1, y=2), end=Point(x=3, y=4))
    assert_eq(Str, line.to_str(), "Line(start=Point(x=1, y=2), end=Point(x=3, y=4))")
    assert(line.eq(Line(start=Point(x=1, y=2), end=Point(x=3, y=4))))
    assert(line.eq(Line(start=Point(x=1, y=2), end=Point(x=3, y=5))).not())

    custom := OverrideToStr(value=9)
    assert_eq(Str, custom.to_str(), "override:9")
}

Counter := struct {
    value := 0
    namespace:
    mut instance_count := 0
    default_name := "Counter"
}

test_namespace := test() {
    assert_eq(I64, Counter.instance_count, 0)
    assert_eq(Str, Counter.default_name, "Counter")
    Counter.instance_count = 42
    assert_eq(I64, Counter.instance_count, 42)
    mut c1 := Counter()
    assert_eq(I64, c1.instance_count, 42)
    assert_eq(Str, c1.default_name, "Counter")
    Counter.instance_count = 100
    mut c2 := Counter()
    assert_eq(I64, c2.instance_count, 100)
    assert_eq(I64, c1.instance_count, 100)
    c1.value = 5
    c2.value = 10
    assert_eq(I64, c1.value, 5)
    assert_eq(I64, c2.value, 10)
    assert_eq(Str, I64.to_str(42), "42")
    assert_eq(Str, Bool.to_str(true), "true")
}

Greeter := struct {
    namespace:
    greet := func(name: Str) returns Str {
        return format("hello, ", name)
    }
}

Describable := struct {
    val := 0
    namespace:
    describe := func(d: Describable) returns Str {
        return format("val=", d.val.to_str())
    }
}

test_ufcs := test() {
    x := 42
    assert_eq(Str, x.to_str(), "42")
    assert_eq(Str, 0.to_str(), "0")
    y := true
    assert_eq(Str, y.to_str(), "true")
    assert_eq(Str, false.to_str(), "false")
    assert_eq(Str, Greeter.greet("world"), "hello, world")
    d := Describable(val=42)
    assert_eq(Str, d.describe(), "val=42")
    assert_eq(Str, Describable.describe(d), "val=42")
}

test_clone := test() {
    // Clone a simple struct
    mut p := Point(x=3, y=7)
    p2 := p.clone()
    assert_eq(I64, p2.x, 3)
    assert_eq(I64, p2.y, 7)
    // Mutating original doesn't affect clone
    p.x = 99
    assert_eq(I64, p2.x, 3)
    assert_eq(I64, p.x, 99)

    // Clone a nested struct (Line has Point fields)
    mut l := Line(start=Point(x=1, y=2), end=Point(x=3, y=4))
    l2 := l.clone()
    assert_eq(I64, l2.start.x, 1)
    assert_eq(I64, l2.end.y, 4)
    l.start.x = 99
    assert_eq(I64, l2.start.x, 1)

    // Clone builtins (must go through a local -- `.clone()` on a literal
    // receiver is a typer error; the literal is already a fresh value).
    num := 42
    s   := "hello"
    bv  := true
    num_c := num.clone()
    s_c   := s.clone()
    bv_c  := bv.clone()
    assert_eq(I64, num_c, 42)
    assert_eq(Str, s_c, "hello")
    assert(bv_c)
}

test_delete := test() {
    p := Point(x=3, y=7)
    Point.delete(own p)

    l := Line(start=Point(x=1, y=2), end=Point(x=3, y=4))
    Line.delete(own l)

    x := 42
    I64.delete(own x)
    s := "hello"
    Str.delete(own s)
    b := true
    Bool.delete(own b)
}

// Custom clone: adds 1 to val, proving auto-generated clone was skipped
CloneCustom := struct {
    val := 0
    namespace:
    clone := func(self: CloneCustom) returns CloneCustom {
        return CloneCustom(val=self.val.add(1))
    }
}

// Custom delete: increments namespace counter, proving auto-generated delete was skipped
DeleteCustom := struct {
    id := 0
    namespace:
    mut delete_count := 0
    delete := func(own self: DeleteCustom, call_free: Bool = true) {
        DeleteCustom.delete_count = DeleteCustom.delete_count.add(1)
        if call_free { free(own self) }
    }
}

test_custom_clone := test() {
    c := CloneCustom(val=5)
    d := c.clone()
    assert_eq(I64, d.val, 6)
    e := d.clone()
    assert_eq(I64, e.val, 7)
}

test_custom_delete := test() {
    assert_eq(I64, DeleteCustom.delete_count, 0)
    t := DeleteCustom(id=1)
    DeleteCustom.delete(own t)
    assert_eq(I64, DeleteCustom.delete_count, 1)
    t2 := DeleteCustom(id=2)
    DeleteCustom.delete(own t2)
    assert_eq(I64, DeleteCustom.delete_count, 2)
}

Container := struct {
    items := Vec(I64).new()
}

test_vec_in_struct := test() {
    mut c := Container()
    c.items.push(own 10)
    c.items.push(own 20)
    c.items.push(own 30)
    assert_eq(USize, c.items.len(), 3)
    assert_eq(I64, c.items[0], 10)
    assert_eq(I64, c.items[1], 20)
    assert_eq(I64, c.items[2], 30)
}

test_nested_struct_field_mutation := test() {
    mut l := Line()
    l.start.x = 42
    l.start.y = 99
    assert_eq(I64, l.start.x, 42)
    assert_eq(I64, l.start.y, 99)
    assert_eq(I64, l.end.x, 0)
    assert_eq(I64, l.end.y, 0)
}

test_field_access_copy := test() {
    mut c := Container()
    c.items.push(own 1)
    c.items.push(own 2)
    copy := c.items
    c.items.push(own 3)
    assert_eq(USize, c.items.len(), 3)
    assert_eq(USize, copy.len(), 2)
}

test_field_reassign := test() {
    mut bob := Person()
    assert_eq(Str, bob.name, "unknown")
    bob.name = "Alice"
    assert_eq(Str, bob.name, "Alice")
    bob.name = "Charlie"
    assert_eq(Str, bob.name, "Charlie")
}

# --- type aliases ---

Point2 := Point

test_struct_type_alias := test() {
    # Construct via alias
    mut p := Point2(x=10, y=20)
    assert_eq(I64, p.x, 10)
    assert_eq(I64, p.y, 20)

    # Explicit type annotation with alias
    q : Point2 = Point2(x=5)
    assert_eq(I64, q.x, 5)
    assert_eq(I64, q.y, 0)

    # Alias and original are interchangeable
    r : Point = Point2(x=1, y=2)
    assert_eq(I64, r.x, 1)
    s : Point2 = Point(x=3, y=4)
    assert_eq(I64, s.x, 3)

    # Clone via alias
    p2 := p.clone()
    assert_eq(I64, p2.x, 10)
    p.x = 99
    assert_eq(I64, p2.x, 10)
}

Line2 := Line

test_nested_struct_alias := test() {
    l := Line2(start=Point(x=1, y=2), end=Point2(x=3, y=4))
    assert_eq(I64, l.start.x, 1)
    assert_eq(I64, l.end.x, 3)
}

// --- ext_struct tests ---

// Anonymous ext_struct (like libffi's ffi_cif)
AnonPair := ext_struct {
    a : I32 = 0
    b : I32 = 0
}

test_ext_struct_anon := test() {
    p := AnonPair(a = 3, b = 7)
    assert_eq(I32, p.a, 3)
    assert_eq(I32, p.b, 7)
}

// Custom tag ext_struct (like libffi's _ffi_type -> ffi_type)
TaggedThing := ext_struct("_tagged_thing") {
    val : I64 = 0
}

test_ext_struct_custom_tag := test() {
    t := TaggedThing(val = 42)
    assert_eq(I64, t.val, 42)
}

// --- #307 follow-up: namespace constants may reference siblings ---
// declared LATER (both the typer's member sweep, the emitted C ns-init
// order, and interpreter_init_ns follow ns_const_eval_order, not
// declaration order). Covers explicit-typed and inferred constants,
// a chain through a middle constant, and a constant calling a sibling
// method declared after it.

FwdConst := struct {
    v := 0
namespace:
    a : I64 = FwdConst.b + 1
    b : I64 = FwdConst.c + 1
    c : I64 = 2
    d := FwdConst.a + FwdConst.c
    e : I64 = FwdConst.twice(3)
    twice := func(n: I64) returns I64 { return n * 2 }
}

test_ns_const_forward_refs := test() {
    assert_eq(I64, FwdConst.c, 2)
    assert_eq(I64, FwdConst.b, 3)
    assert_eq(I64, FwdConst.a, 4)
    assert_eq(I64, FwdConst.d, 6)
    assert_eq(I64, FwdConst.e, 6)
}

// USize is the interface: a width alias is never resolved into a
// monomorphization name, so `Map(Str, USize)` / `Vec(USize)` spell the
// SAME instance (Map__Str_USize / Vec__USize) from every position --
// struct-field annotation, free-function param, value ctor -- regardless
// of declaration order or of what width the target resolves USize to.
// Before the fix, a namespace method typed against a LATER-declared free
// function saw the alias-spelled param while its own field had the
// resolved spelling baked in ("expected Map__Str_USize, got
// Map__Str_U32"). The callee is declared AFTER the struct on purpose.
UsizeHolder := struct {
    own m : Map(Str, USize) = Map(Str, USize).new()
    own v : Vec(USize) = Vec(USize).new()
namespace:
    get_via_free := func(self: UsizeHolder, name: Str) returns USize {
        return usize_holder_idx_get(self.m, name)
    }
    first_via_free := func(self: UsizeHolder) returns USize {
        return usize_holder_vec_first(self.v)
    }
}

usize_holder_idx_get := func(idx: Map(Str, USize), name: Str) returns USize {
    ref p : USize = idx.get(name)?
    catch (e: KeyNotFound) { return 999 }
    return p.clone()
}

usize_holder_vec_first := func(v: Vec(USize)) returns USize {
    return v.unsafe_get(0).clone()
}

test_usize_alias_instance_names := test() {
    mut h := UsizeHolder()
    h.m.set("a", own 7)
    h.v.push(own 41)
    assert_eq(USize, h.get_via_free("a"), 7)
    assert_eq(USize, h.get_via_free("missing"), 999)
    assert_eq(USize, h.first_via_free(), 41)
}

// #335: cmp is derived for a struct whose fields are all comparable --
// lexicographic in declaration order, the same order eq walks. That makes
// a struct usable as a Set element, a Map key and a range bound; before,
// each of those failed with "no namespace function 'cmp'".
CmpPoint := struct {
    x := 0
    y := 0
}

test_struct_derived_cmp := test() {
    // First field decides; ties fall through to the next.
    assert_eq(I64, CmpPoint.cmp(CmpPoint(x = 1, y = 2), CmpPoint(x = 2, y = 0)), -1)
    assert_eq(I64, CmpPoint.cmp(CmpPoint(x = 2, y = 0), CmpPoint(x = 1, y = 9)), 1)
    assert_eq(I64, CmpPoint.cmp(CmpPoint(x = 1, y = 2), CmpPoint(x = 1, y = 3)), -1)
    assert_eq(I64, CmpPoint.cmp(CmpPoint(x = 1, y = 2), CmpPoint(x = 1, y = 2)), 0)
    // lt/gt/lte/gte derive from cmp in turn.
    assert(CmpPoint(x = 1, y = 0).lt(CmpPoint(x = 1, y = 1)))
    assert(CmpPoint(x = 2, y = 0).gt(CmpPoint(x = 1, y = 9)))
    assert(CmpPoint(x = 1, y = 1).gte(CmpPoint(x = 1, y = 1)))
}

test_struct_in_set := test() {
    mut s := Set(CmpPoint).new()
    s.add(own CmpPoint(x = 2, y = 0))
    s.add(own CmpPoint(x = 1, y = 1))
    s.add(own CmpPoint(x = 1, y = 1))
    assert_eq(USize, s.len(), 2)
    assert(s.has(CmpPoint(x = 2, y = 0)))
    assert(s.has(CmpPoint(x = 9, y = 9)).not())
}

test_struct_as_map_key := test() {
    // Monomorphizing Map.set over a struct key used to emit
    // `CmpPoint cloned_key = key;` -- the elided POD clone forgot that a
    // wider-than-a-word struct param is a POINTER in C.
    mut m := Map(CmpPoint, Str).new()
    m.set(CmpPoint(x = 1, y = 1), own "one")
    m.set(CmpPoint(x = 2, y = 2), own "two")
    assert_eq(USize, m.len(), 2)
    assert_eq(Str, m[CmpPoint(x = 2, y = 2)], "two")
}

// A user type named after a template FORMAL param is still a real type:
// `Map(K, I64)` where K is the user's struct is a genuine instantiation,
// not map.til's own `Map(K, V)` placeholder. The placeholder dropper used
// to match on the NAME alone and delete the instance, leaving every use
// referencing an undefined Map__K_I64.
K := struct {
    n := 0
}

V := struct {
    n := 0
}

test_template_formal_name_collision := test() {
    mut m := Map(K, I64).new()
    m.set(K(n = 1), own 10)
    m.set(K(n = 2), own 20)
    assert_eq(USize, m.len(), 2)
    assert_eq(I64, m[K(n = 2)], 20)

    mut mv := Map(Str, V).new()
    mv.set("a", own V(n = 5))
    assert_eq(USize, mv.len(), 1)

    mut sv := Set(K).new()
    sv.add(own K(n = 1))
    sv.add(own K(n = 1))
    assert_eq(USize, sv.len(), 1)
}

// A field's type is derived from its DEFAULT when it carries no
// annotation, and the deriver has to see through a `T(Args).new()`
// constructor call: that is an FCall whose callee is a FieldAccess
// (`Inner.new`), not the bare `T(...)` shape. It used to return "" for
// this, so the field read as untyped and the struct was silently denied
// its generated to_str -- which only became visible when something
// asked for one. Annotating the field always worked, which is what hid
// the gap. (The container to_str that first exposed this was reverted;
// a user type with its own to_str pins the deriver directly.)
DerivedFieldInner := struct {
    n := 0
namespace:
    new := func() returns DerivedFieldInner { return DerivedFieldInner(n = 7) }
    to_str := func(self: DerivedFieldInner) returns Str {
        return format("Inner(", self.n.to_str(), ")")
    }
}

DerivedFieldOuter := struct {
    label := ""
    inner := DerivedFieldInner.new()
}

test_field_type_derived_through_new_call := test() {
    o := DerivedFieldOuter(label = "x")
    assert_eq(I64, o.inner.n, 7)
    // The generated to_str exists only because the field's type was
    // derived through `DerivedFieldInner.new()`.
    assert_eq(Str, o.to_str(), "DerivedFieldOuter(label=x, inner=Inner(7))")
}

PlainCallInner := struct {
    label := "seven"
    n := 7
}

make_plain_call_inner := func() returns PlainCallInner {
    return PlainCallInner()
}

PlainCallOuter := struct {
    inner := make_plain_call_inner()
}

test_field_type_inferred_from_plain_function_call := test() {
    o := PlainCallOuter()
    assert_eq(I64, o.inner.n, 7)
    assert_eq(Str, o.to_str(), "PlainCallOuter(inner=PlainCallInner(label=seven, n=7))")
    c := o.clone()
    assert(c.eq(o))
    assert_eq(I64, c.cmp(o), 0)
}

// --- #340: field init shorthand -------------------------------------
//
// In a struct literal a bare identifier that names a field stands for
// `field = field`, exactly as in Rust (RFC 1682): purely name
// coincidence, freely mixed with explicit `field = value` args, and
// order never mattered because a struct literal is name-keyed.

ShorthandUser := struct {
    su_name := ""
    su_pass := ""
    su_age := 0
}

test_field_init_shorthand := test() {
    su_name := "jorge"
    su_pass := "hunter2"
    u := ShorthandUser(su_name, su_pass, su_age = 41)
    assert_eq(Str, u.to_str(), "ShorthandUser(su_name=jorge, su_pass=hunter2, su_age=41)")
}

test_field_init_shorthand_order_and_mixing := test() {
    su_pass := "pw"
    su_name := "nm"
    // shorthand after an explicit arg, and in a different order than the
    // fields are declared: both are fine.
    v := ShorthandUser(su_age = 7, su_pass, su_name)
    assert_eq(Str, v.to_str(), "ShorthandUser(su_name=nm, su_pass=pw, su_age=7)")
}

test_field_init_shorthand_matches_longhand := test() {
    su_name := "same"
    su_other := "same"
    // Only a BARE identifier is the shorthand: `su_name.clone()` stays a
    // positional argument and is still rejected. The shorthand also
    // transfers its variable exactly like the longhand does, which is why
    // each literal below gets its own source.
    a := ShorthandUser(su_name)
    b := ShorthandUser(su_name = su_other)
    assert_eq(Bool, a.eq(b), true)
}

// #346: semantic ownership is independent from the outer C storage. These
// managed values stay in frame slots until an own parameter or field needs a
// pointer-shaped transfer boundary.
StackValue346 := struct {
    text := ""
}

StackOwner346 := struct {
    own value := StackValue346()
}

priv mutate_stack_value346 := func(mut value: StackValue346) {
    value.text = "mutated heap-backed text for stack value 346"
}

priv return_stack_value346 := func(flag: Bool) returns StackValue346 {
    mut value := StackValue346(text = "early heap-backed text for stack value 346")
    if flag { return value }
    value.text = "late heap-backed text for stack value 346"
    return value
}

priv move_stack_value346 := func(own value: StackValue346) returns StackValue346 {
    return value
}

test_owned_aggregate_stack_lifecycle346 := test() {
    mut text := format("initial heap-backed text for stack value ", 346.to_str())
    text = "replacement heap-backed text for stack value 346"

    mut value := StackValue346(text = text)
    copy := value.clone()
    value = StackValue346(text = "reassigned heap-backed text for stack value 346")
    ref borrowed : Str = value.text
    mutate_stack_value346(value)
    assert_eq(Str, borrowed, "mutated heap-backed text for stack value 346")
    assert_eq(Str, copy.text, "replacement heap-backed text for stack value 346")

    early := return_stack_value346(true)
    assert_eq(Str, early.text, "early heap-backed text for stack value 346")

    moved := move_stack_value346(own value)
    owner := StackOwner346(value = moved)
    assert_eq(Str, owner.value.text, "mutated heap-backed text for stack value 346")
}
