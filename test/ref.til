mode test

# --- ref returns with I64 ---

min := func(a: I64, b: I64) returns ref I64 {
    if a.lt(b) { return a } else { return b }
}

test_ref_i64 := test() {
    x := 3
    y := 7
    ref m := min(x, y)
    assert_eq(I64, m, 3)
}

# --- ref returns with Str ---

shorter := func(a: Str, b: Str) returns ref Str {
    if a.len().lt(b.len()) { return a } else { return b }
}

test_ref_str := test() {
    a := "hi"
    b := "hello"
    ref s := shorter(a, b)
    assert_eq(Str, s, "hi")
}

# --- ref from parameter ---

identity := func(x: I64) returns ref I64 {
    return x
}

test_ref_from_param := test() {
    v := 42
    ref r := identity(v)
    assert_eq(I64, r, 42)
}

# --- ref from owned compound local ---

RefPoint := struct {
    x := 0
    y := 0
}

test_ref_from_owned_compound := test() {
    p := RefPoint(x = 42, y = 99)
    ref r : RefPoint = p
    assert_eq(I64, r.x, 42)
    assert_eq(I64, r.y, 99)
}

# --- ref from field access ---

RefBox := struct {
    n := 0
    namespace:
    get_n := func(self: RefBox) returns ref I64 {
        return self.n
    }
}

test_ref_from_field_return := test() {
    b := RefBox(n = 9)
    ref n : I64 = b.get_n()
    assert_eq(I64, n, 9)
}

test_ref_decl_from_field := test() {
    b := RefBox(n = 11)
    ref n : I64 = b.n
    assert_eq(I64, n, 11)
}

# --- ref Dynamic from owned compound ---

test_ref_dynamic_from_struct := test() {
    p := RefPoint(x = 10, y = 20)
    ref d : Dynamic = p
    ref p2 : RefPoint = d
    assert_eq(I64, p2.x, 10)
    assert_eq(I64, p2.y, 20)
}

# --- NULL literal + ref struct fields ---
# (test_null_ref_local removed: #177 closed the loophole that let test()
# bodies initialize a ref binding to NULL. Same rule as #168 step 1b for
# func bodies. NULL ref-binding init now fails uniformly at module scope,
# in func/proc bodies, in test() bodies, and in macros.)
# (test_null_borrowed_arg removed: #321 step 3 forbids is_null on typed
# values, so "a borrowed compound param can receive NULL" is no longer
# an observable -- or intended -- state. A maybe-absent borrow param is
# an Option(ref T) now; only raw Dynamic pointers can be null.)

// #321 step 2: a ref field can no longer default to NULL; the
// maybe-absent borrow is an Option(ref T) field (niche layout keeps it
// pointer-sized), the linked-node pattern's new spelling.
RefNode := struct {
    const value := 0
    next := Option(ref RefNode).None
}

test_ref_struct_field := test() {
    mut a := RefNode(value = 10)
    b := RefNode(value = 20)
    a.next = safe_ref(b)
    assert_eq(I64, a.value, 10)
    assert_eq(I64, a.next.unwrap().value, 20)

    // clone copies the pointer (not deep clone)
    c := a.clone()
    assert_eq(I64, c.value, 10)
    assert_eq(I64, c.next.unwrap().value, 20)
}

# --- Issue #226 / #227: ref mut primitive must deref-write ---
#
# Both compile (#226) and interp (#227) paths now deref-write
# when assigning a value through a `ref mut x : Primitive` binding
# whose RHS was a raw pointer expression. The compile fix lives
# in builder.til (do_rebind skip for params); the interp fix lives
# in this file (ref_primitive_ptrs side table + write_* dispatch
# on Assign).

ref226_param_rhs := func(len: USize) returns U32 {
    mut buf : U8 = malloc(8)
    write_u32(buf, 0)
    ref mut slot : U32 = ptr_add(buf, 0)
    slot = len
    // Re-read via a fresh ref binding: this triggers
    // reinterpret_ptr_value which loads the U32 at `buf`, so we
    // verify the original storage actually got the write rather
    // than just trusting `slot`'s local cell.
    ref read_back : U32 = ptr_add(buf, 0)
    out : U32 = read_back
    free(own buf)
    return out
}

test_ref_mut_primitive_assign := test() {
    got := ref226_param_rhs(42)
    assert_eq(U32, got, 42)
}

# --- #344: a write through a returned borrow credits its root ---
#
# The three shapes the borrow-provenance tracking has to follow. Each
# function's only write to its `mut` parameter goes through a borrow some
# other function handed back, so the honest `mut` used to be reported as
# "never written through" and the only spelling that compiled was the
# non-mut one -- exactly the form the two backends disagree about. The
# assertions below prove the write really lands in the caller's storage,
# under both backends.

Bp344Inner := struct {
    n := 0
}

Bp344Outer := struct {
    inner := Bp344Inner()
    other := Bp344Inner()
}

# One parameter, one root: the accessor from issue #344's probe 2.
bp344_inner_of := func(o: Bp344Outer) returns ref Bp344Inner {
    return o.inner
}

bp344_bump := func(mut o: Bp344Outer) {
    ref mut i : Bp344Inner = bp344_inner_of(o)
    i.n = i.n + 1
}

test_borrow_root_through_accessor := test() {
    mut o := Bp344Outer()
    bp344_bump(o)
    bp344_bump(o)
    assert_eq(I64, o.inner.n, 2)
    assert_eq(I64, o.other.n, 0)
}

# Two parameters, both reachable from the return: provenance is a SET, so
# writing through the result must credit whichever argument the branch
# picked -- both `mut` qualifiers below are load-bearing.
bp344_pick := func(a: Bp344Inner, b: Bp344Inner, take_a: Bool) returns ref Bp344Inner {
    if take_a { return a }
    return b
}

bp344_bump_both := func(mut x: Bp344Inner, mut y: Bp344Inner) {
    ref mut first : Bp344Inner = bp344_pick(x, y, true)
    first.n = first.n + 1
    ref mut second : Bp344Inner = bp344_pick(x, y, false)
    second.n = second.n + 10
}

test_borrow_root_multi_root_return := test() {
    mut x := Bp344Inner()
    mut y := Bp344Inner()
    bp344_bump_both(x, y)
    assert_eq(I64, x.n, 1)
    assert_eq(I64, y.n, 10)
}

# A borrow carried through an Option payload and unwrapped by a switch:
# the payload binding inherits the scrutinee's roots, so wrapping the
# accessor result does not launder the write away from `o`.
bp344_maybe_inner := func(o: Bp344Outer) returns Option(ref Bp344Inner) {
    return safe_ref(o.other)
}

bp344_bump_payload := func(mut o: Bp344Outer) {
    switch bp344_maybe_inner(o) {
    case .Some(got):
        got.n = got.n + 5
    case .None:
    }
}

test_borrow_root_through_payload := test() {
    mut o := Bp344Outer()
    bp344_bump_payload(o)
    assert_eq(I64, o.other.n, 5)
    assert_eq(I64, o.inner.n, 0)
}

# --- #351: a write through a ref FIELD credits the borrow's root ---
#
# The borrow is parked in a struct's ref field by the constructor, then
# written through. The root's `mut` is credited across that hop (so the
# redundancy check accepts it), and both backends agree the caller's
# storage was written. The rejection of the non-mut form lands with
# #351's use commit.

Bp351Held := struct { n := 0 }
Bp351Src := struct { held := Bp351Held() }
Bp351Holder := struct { ref r : Bp351Held }

bp351_held_of := func(s: Bp351Src) returns ref Bp351Held {
    return s.held
}

bp351_poke := func(mut s: Bp351Src) {
    mut h := Bp351Holder(r = bp351_held_of(s))
    h.r.n = h.r.n + 1
}

test_borrow_root_through_ref_field := test() {
    mut s := Bp351Src()
    bp351_poke(s)
    bp351_poke(s)
    assert_eq(I64, s.held.n, 2)
}

# --- #352: borrow chains have no depth or round limits ---
#
# Both shapes are deeper than the caps the tracking used to carry. The
# `mut` qualifiers are the proof: if the walks dropped roots past a
# limit, the redundancy check would reject every one of them as "never
# written through", and this file would not compile.

Bp352In := struct { n := 0 }
Bp352Out := struct { inner := Bp352In() }

# Twelve forward-referenced hops: each wrapper is declared BEFORE the
# one it calls, so each summary round can settle only one more level.
# The old 8-round clamp lost the roots past the eighth.
bp352_w12 := func(o: Bp352Out) returns ref Bp352In { return bp352_w11(o) }
bp352_w11 := func(o: Bp352Out) returns ref Bp352In { return bp352_w10(o) }
bp352_w10 := func(o: Bp352Out) returns ref Bp352In { return bp352_w9(o) }
bp352_w9 := func(o: Bp352Out) returns ref Bp352In { return bp352_w8(o) }
bp352_w8 := func(o: Bp352Out) returns ref Bp352In { return bp352_w7(o) }
bp352_w7 := func(o: Bp352Out) returns ref Bp352In { return bp352_w6(o) }
bp352_w6 := func(o: Bp352Out) returns ref Bp352In { return bp352_w5(o) }
bp352_w5 := func(o: Bp352Out) returns ref Bp352In { return bp352_w4(o) }
bp352_w4 := func(o: Bp352Out) returns ref Bp352In { return bp352_w3(o) }
bp352_w3 := func(o: Bp352Out) returns ref Bp352In { return bp352_w2(o) }
bp352_w2 := func(o: Bp352Out) returns ref Bp352In { return bp352_w1(o) }
bp352_w1 := func(o: Bp352Out) returns ref Bp352In { return o.inner }

bp352_deep_chain := func(mut o: Bp352Out) {
    ref mut i : Bp352In = bp352_w12(o)
    i.n = i.n + 1
}

test_borrow_chain_12_forward_hops := test() {
    mut o := Bp352Out()
    bp352_deep_chain(o)
    bp352_deep_chain(o)
    assert_eq(I64, o.inner.n, 2)
}

# An 18-deep nested call expression, past the old per-expression walk
# cap of 16. Both parameters can reach the returned borrow, so both
# `mut` qualifiers are load-bearing.
bp352_pick := func(a: Bp352In, b: Bp352In) returns ref Bp352In {
    if a.n.lt(b.n) { return a }
    return b
}

bp352_deep_expr := func(mut a: Bp352In, mut b: Bp352In) {
    ref mut i : Bp352In = bp352_pick(bp352_pick(bp352_pick(bp352_pick(bp352_pick(bp352_pick(bp352_pick(bp352_pick(bp352_pick(bp352_pick(bp352_pick(bp352_pick(bp352_pick(bp352_pick(bp352_pick(bp352_pick(bp352_pick(bp352_pick(a, b), b), b), b), b), b), b), b), b), b), b), b), b), b), b), b), b), b)
    i.n = i.n + 1
}

test_borrow_expr_18_deep := test() {
    mut a := Bp352In()
    mut b := Bp352In(n = 5)
    bp352_deep_expr(a, b)
    assert_eq(I64, a.n, 1)
    assert_eq(I64, b.n, 5)
}

# --- #354: a clone routes borrows without joining the roots ---
#
# h2's ref field points at s's storage; h was only the value the pointer
# was copied out of. The write through the clone must credit s alone, so
# `mut s` survives the redundancy check, h needs NO mut, and both
# backends agree the caller's storage was written twice.

bp354_poke := func(mut s: Bp351Src) {
    h := Bp351Holder(r = bp351_held_of(s))
    h2 := h.clone()
    h2.r.n = h2.r.n + 1
}

test_borrow_root_through_clone := test() {
    mut s := Bp351Src()
    bp354_poke(s)
    bp354_poke(s)
    assert_eq(I64, s.held.n, 2)
}

# --- #355: each ref field carries its own sources ---
#
# t.p borrows from s1, t.q from s2. The write through p credits s1
# alone: `mut s1` survives the redundancy check, s2 needs NO mut, and
# both backends agree on which storage changed.

Bp355Two := struct {
    ref p : Bp351Held
    ref q : Bp351Held
}

bp355_poke := func(mut s1: Bp351Src, s2: Bp351Src) {
    t := Bp355Two(p = bp351_held_of(s1), q = bp351_held_of(s2))
    t.p.n = t.p.n + 1
}

test_borrow_root_per_field := test() {
    mut s1 := Bp351Src()
    s2 := Bp351Src()
    bp355_poke(s1, s2)
    bp355_poke(s1, s2)
    assert_eq(I64, s1.held.n, 2)
    assert_eq(I64, s2.held.n, 0)
}

# --- #356: the carried tag is a PATH, so nesting stays precise ---
#
# h borrows s1 and k borrows s2, both one level down inside an owned
# field. Writing through h.r credits s1 alone -- the tag records the
# `h.r` path, not just the ref field's name.

Bp356Outer := struct {
    h := Bp351Holder(r = Bp351Held())
    k := Bp351Holder(r = Bp351Held())
}

bp356_poke := func(mut s1: Bp351Src, s2: Bp351Src) {
    o := Bp356Outer(h = Bp351Holder(r = bp351_held_of(s1)),
                    k = Bp351Holder(r = bp351_held_of(s2)))
    o.h.r.n = o.h.r.n + 1
}

test_borrow_root_nested_per_field := test() {
    mut s1 := Bp351Src()
    s2 := Bp351Src()
    bp356_poke(s1, s2)
    bp356_poke(s1, s2)
    assert_eq(I64, s1.held.n, 2)
    assert_eq(I64, s2.held.n, 0)
}

# --- #357: a borrow parked in an owned local survives the round trip ---
#
# mk builds the holder in an owned local and returns it, so the borrow
# reaches the caller through a value, not a `ref`. Two things have to
# hold: the write through it credits s (so `mut s` is not "redundant"),
# and s's parameter is NOT auto-shallow-copied on the way into mk -- a
# copy would leave the returned borrow pointing at a dead value, which
# is what made the backends disagree here.

bp357_mk := func(s: Bp351Src) returns Bp351Holder {
    h := Bp351Holder(r = bp351_held_of(s))
    return h
}

bp357_poke := func(mut s: Bp351Src) {
    h2 := bp357_mk(s)
    h2.r.n = h2.r.n + 1
}

test_borrow_root_through_owned_intermediate := test() {
    mut s := Bp351Src()
    bp357_poke(s)
    bp357_poke(s)
    assert_eq(I64, s.held.n, 2)
}

# --- #393: a deposit into another argument's storage keeps its root ---
#
# The holder rides Vec.push / Map.set / a helper call / a plain field
# assign into other storage; the write through that storage still
# credits s, so the honest `mut s` survives the redundancy check and
# both backends agree the caller's storage was written twice.

bp393_vec := func(mut s: Bp351Src) {
    mut hs := Vec(Bp351Holder).new()
    hs.push(own Bp351Holder(r = bp351_held_of(s)))
    ref mut h : Bp351Holder = hs[0]
    h.r.n = h.r.n + 1
}

test_borrow_root_through_vec_push := test() {
    mut s := Bp351Src()
    bp393_vec(s)
    bp393_vec(s)
    assert_eq(I64, s.held.n, 2)
}

bp393_map := func(mut s: Bp351Src) {
    mut m := Map(Str, Bp351Holder).new()
    m.set("k", own Bp351Holder(r = bp351_held_of(s)))
    ref mut h : Bp351Holder = m.get("k")!
    h.r.n = h.r.n + 1
}

test_borrow_root_through_map_set := test() {
    mut s := Bp351Src()
    bp393_map(s)
    bp393_map(s)
    assert_eq(I64, s.held.n, 2)
}

Bp393Box := struct { h := Bp351Holder(r = Bp351Held()) }

bp393_park := func(mut b: Bp393Box, h: Bp351Holder) { b.h = h }

// The box is seeded from a local, NOT from s, so the write below is
// credited to s only through the park deposit -- and the bare default
// (`Bp393Box()`) is avoided because its ref-field default would malloc
// a Held box nobody owns.
bp393_helper := func(mut s: Bp351Src) {
    mut seed := Bp351Held()
    mut b := Bp393Box(h = Bp351Holder(r = seed))
    bp393_park(b, Bp351Holder(r = bp351_held_of(s)))
    b.h.r.n = b.h.r.n + 1
}

test_borrow_root_through_helper_deposit := test() {
    mut s := Bp351Src()
    bp393_helper(s)
    bp393_helper(s)
    assert_eq(I64, s.held.n, 2)
}

bp393_direct := func(mut s: Bp351Src) {
    mut seed := Bp351Held()
    mut b := Bp393Box(h = Bp351Holder(r = seed))
    b.h = Bp351Holder(r = bp351_held_of(s))
    b.h.r.n = b.h.r.n + 1
}

test_borrow_root_through_field_deposit := test() {
    mut s := Bp351Src()
    bp393_direct(s)
    bp393_direct(s)
    assert_eq(I64, s.held.n, 2)
}

# --- #398: a deposit performed by a CALLEE is credited one level up ---
#
# #393 derived a function's deposit summary only from deposits it made
# directly (an adopt, a field assign). A helper that deposits by CALLING
# something else on its parameter summarised as depositing nothing, so
# every caller of it lost the root. Both shapes below write the caller's
# storage two hops away, and both backends must agree they did.

Bp398Store := struct {
    hs := Vec(Bp351Holder).new()
namespace:
    put := func(mut self: Bp398Store, h: Bp351Holder) {
        self.hs.push(own h.clone())
    }
}

# the deposit goes through a method call on `self.field`
bp398_via_self := func(mut s: Bp351Src) {
    mut st := Bp398Store()
    st.put(Bp351Holder(r = bp351_held_of(s)))
    ref mut h : Bp351Holder = st.hs[0]
    h.r.n = h.r.n + 1
}

test_borrow_root_callee_deposit_self := test() {
    mut s := Bp351Src()
    bp398_via_self(s)
    bp398_via_self(s)
    assert_eq(I64, s.held.n, 2)
}

# a FREE function, whose receiver is a plain parameter: resolvable only
# off its DECLARED type, since nothing is typed when summaries are built
bp398_wrap := func(mut st: Bp398Store, h: Bp351Holder) {
    st.put(h)
}

bp398_via_param := func(mut s: Bp351Src) {
    mut st := Bp398Store()
    bp398_wrap(st, Bp351Holder(r = bp351_held_of(s)))
    ref mut h : Bp351Holder = st.hs[0]
    h.r.n = h.r.n + 1
}

test_borrow_root_callee_deposit_param := test() {
    mut s := Bp351Src()
    bp398_via_param(s)
    bp398_via_param(s)
    assert_eq(I64, s.held.n, 2)
}

# --- #398 link 2: the receiver is a parameter of GENERIC type ---
#
# `hs.push(...)` inside a helper, where hs is the helper's own parameter.
# Nothing is typed when summaries are built, so the callee resolves off
# hs's DECLARED type -- and until it did, the deposit's SOURCE bits came
# back empty, the pair never crossed, and the helper summarised as inert.

bp398_vec_wrap := func(mut hs: Vec(Bp351Holder), h: Bp351Holder) {
    hs.push(own h.clone())
}

bp398_via_generic := func(mut s: Bp351Src) {
    mut hs := Vec(Bp351Holder).new()
    bp398_vec_wrap(hs, Bp351Holder(r = bp351_held_of(s)))
    ref mut h : Bp351Holder = hs[0]
    h.r.n = h.r.n + 1
}

test_borrow_root_callee_deposit_generic := test() {
    mut s := Bp351Src()
    bp398_via_generic(s)
    bp398_via_generic(s)
    assert_eq(I64, s.held.n, 2)
}

# --- #399: a field read through a borrow, in return position ---
#
# The garbager's return-site delete exclusion is textual, so the ref
# temp in the operand was protected but not the container it points
# into: `return ps[0].v` freed ps first and read the element after --
# heap-use-after-free, and the constfolder baked the garbage into BOTH
# backends so they agreed on it. The reads below now happen before the
# deletes (hoisted by the desugarer), and both backends must agree on
# the true values.

Bp399P := struct { v := 0 }

bp399_direct := func() returns I64 {
    mut ps := Vec(Bp399P).new()
    ps.push(own Bp399P(v = 7))
    return ps[0].v
}

test_return_field_through_elem_borrow := test() {
    assert_eq(I64, bp399_direct(), 7)
}

bp399_via_ref := func() returns I64 {
    mut ps := Vec(Bp399P).new()
    ps.push(own Bp399P(v = 7))
    ref mut p : Bp399P = ps[0]
    p.v = p.v + 1
    return p.v
}

# The clone spelling for an aggregate field stays the sanctioned exit
# (the raw `return ss[0].t` is rejected -- terr399_agg_field).
Bp399S := struct { t := "x" }

bp399_agg_clone := func() returns Str {
    mut ss := Vec(Bp399S).new()
    ss.push(own Bp399S(t = format("he", "llo")))
    return ss[0].t.clone()
}

test_return_field_through_ref_binding := test() {
    assert_eq(I64, bp399_via_ref(), 8)
    assert_eq(Str, bp399_agg_clone(), "hello")
}
