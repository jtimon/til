mode test

test_for_in_str := test() {
    // Str.get returns ref I8 -- type inferred
    mut result := Str.with_capacity(10)
    for c in "hello" {
        result.push_str(Str.from_byte(c.cast(I64).band(255).to_u8()))
    }
    assert_eq(Str, result, "hello")
}

test_for_in_str_explicit := test() {
    // Explicit type annotation also works
    mut result := Str.with_capacity(10)
    for c : I8 in "world" {
        result.push_str(Str.from_byte(c.cast(I64).band(255).to_u8()))
    }
    assert_eq(Str, result, "world")
}

test_for_in_vec := test() {
    v := vec(I64, 10, 20, 30)
    mut sum := 0
    for x : I64 in v {
        sum = sum.add(x)
    }
    assert_eq(I64, sum, 60)
}

test_for_in_array := test() {
    a := array(I64, 1, 2, 3, 4, 5)
    mut sum := 0
    for x : I64 in a {
        sum = sum.add(x)
    }
    assert_eq(I64, sum, 15)
}

test_for_in_break := test() {
    mut count := 0
    for _c in "abcdef" {
        if count.eq(3) { break }
        count++
    }
    assert_eq(I64, count, 3)
}

test_for_in_continue := test() {
    // Skip 'b' characters
    mut result := Str.with_capacity(10)
    for c in "abcbd" {
        if c.eq('b') { continue }
        result.push_str(Str.from_byte(c.cast(I64).band(255).to_u8()))
    }
    assert_eq(Str, result, "acd")
}

test_for_in_nested := test() {
    mut count := 0
    for _c1 in "ab" {
        for _c2 in "xy" {
            count++
        }
    }
    assert_eq(I64, count, 4)
}

test_for_in_empty := test() {
    mut count := 0
    for _c in "" {
        count++
    }
    assert_eq(I64, count, 0)

    v := vec(I64)
    mut sum := 0
    for x : I64 in v {
        sum = sum.add(x)
    }
    assert_eq(I64, sum, 0)
}

test_for_in_scope := test() {
    // Loop variable should not leak to outer scope
    // (desugars to anonymous block)
    x := 42
    for _c in "abc" {
        // c is scoped inside the block
    }
    assert_eq(I64, x, 42)
}

test_range_ascending := test() {
    mut sum := 0
    for i in 0..5 {
        sum = sum.add(i)
    }
    assert_eq(I64, sum, 10)
}

test_range_descending := test() {
    mut sum := 0
    for i in 5..0 {
        sum = sum.add(i)
    }
    assert_eq(I64, sum, 15)
}

test_range_empty := test() {
    mut count := 0
    for _i in 3..3 {
        count++
    }
    assert_eq(I64, count, 0)
}

test_range_single := test() {
    mut sum := 0
    for i in 0..1 {
        sum = sum.add(i)
    }
    assert_eq(I64, sum, 0)
}

test_range_break := test() {
    mut last := 0
    for i in 0..100 {
        if i.eq(5) { break }
        last = i
    }
    assert_eq(I64, last, 4)
}

test_range_continue := test() {
    // Sum only even numbers 0..10
    mut sum := 0
    for i in 0..10 {
        if i.mod(2).neq(0) { continue }
        sum = sum.add(i)
    }
    assert_eq(I64, sum, 20)
}

test_range_nested := test() {
    mut sum := 0
    for _i in 0..3 {
        for _j in 0..4 {
            sum++
        }
    }
    assert_eq(I64, sum, 12)
}

test_range_u32_count := test() {
    // #94: loop var is U32 (inferred from count), not U64
    count : U32 = 5
    mut sum := 0
    for i in 0..count {
        sum = sum.add(i.to_i64())
    }
    assert_eq(I64, sum, 10)
}

test_range_u32_both := test() {
    // Both start and end as U32
    start : U32 = 1
    end : U32 = 4
    mut sum := 0
    for i in start..end {
        sum = sum.add(i.to_i64())
    }
    assert_eq(I64, sum, 6)
}

// #100: negative ranges (I64)
test_range_negative := test() {
    mut sum := 0
    for i in -2..3 {
        sum = sum.add(i)
    }
    // -2 + -1 + 0 + 1 + 2 = 0
    assert_eq(I64, sum, 0)
}

test_range_negative_desc := test() {
    mut sum := 0
    for i in 2..-3 {
        sum = sum.add(i)
    }
    // 2 + 1 + 0 + -1 + -2 = 0
    assert_eq(I64, sum, 0)
}

// #100: I32 range
test_range_i32 := test() {
    start : I32 = 1
    end : I32 = 4
    mut sum := 0
    for i in start..end {
        sum = sum.add(i.cast(I64))
    }
    assert_eq(I64, sum, 6)
}

test_while_basic := test() {
    mut i := 0
    while i.lt(5) {
        i++
    }
    assert_eq(I64, i, 5)
}

test_while_false := test() {
    while false {
        panic("unreachable")
    }
}

test_while_break := test() {
    mut i := 0
    while true {
        if i.eq(3) { break }
        i++
    }
    assert_eq(I64, i, 3)
}

test_while_continue := test() {
    mut k := 0
    mut total := 0
    while k.lt(5) {
        k++
        if k.eq(3) { continue }
        total = total.add(k)
    }
    assert_eq(I64, total, 12)
}

// #160: 'for mut x : T in coll' makes the loop variable mutable
test_for_in_mut_collection := test() {
    mut v := vec(I64, 1, 2, 3)
    mut sum := 0
    for mut x : I64 in v {
        x = x.mul(10)
        sum = sum.add(x)
    }
    // 10 + 20 + 30 = 60
    assert_eq(I64, sum, 60)
}

// #160: 'for mut i in <range>' allows mutating the loop variable inside the body
test_for_in_mut_range := test() {
    mut sum := 0
    for mut i in 0..5 {
        i = i.mul(2)
        sum = sum.add(i)
    }
    // 0+2+4+6+8 = 20
    assert_eq(I64, sum, 20)
}

// #287 follow-up: `for mut x in coll` mutates coll's elements through the
// element ref, so a `mut coll` whose ONLY writer is the loop must compile
// (not be flagged "redundant 'mut' ... never written through"). `vec(...)`
// init does not mark the local written, so the loop is the sole writer.
test_for_in_mut_collection_marks_written := test() {
    mut v := vec(I64, 10, 20, 30)
    for mut x in v {
        x = x.add(5)
    }
    mut sum := 0
    for x in v { sum = sum.add(x) }
    // 15 + 25 + 35 = 75
    assert_eq(I64, sum, 75)
}

// Same for the two-variable `for k, mut v in map`: a `mut` map whose only
// writer is the value-mutating loop must compile. The map literal init does
// not count as writing through `m`.
test_for_kv_mut_collection_marks_written := test() {
    mut m := {"a": 1, "b": 2, "c": 3}
    for _, mut val in m {
        val = val.mul(10)
    }
    mut sum := 0
    for v in m.values { sum = sum.add(v) }
    // 10 + 20 + 30 = 60
    assert_eq(I64, sum, 60)
}

// Issue #94: a range over a USER type. `for a..b` needs nothing from the
// element but the methods -- lt/gt to test the bound and inc/dec to step --
// and both derive: lt/gt from cmp, inc/dec from add+unity (doc/auto.org).
// The desugar emits those method calls directly, so a conforming struct
// iterates through the same counter-and-while shape a builtin integer does:
// no Range object, no per-element dispatch.
RangeableVec2 := struct {
    x : I64 = 0
    y : I64 = 0
namespace:
    add := func(a: RangeableVec2, b: RangeableVec2) returns RangeableVec2 {
        return RangeableVec2(x = a.x.add(b.x), y = a.y.add(b.y))
    }
    sub := func(a: RangeableVec2, b: RangeableVec2) returns RangeableVec2 {
        return RangeableVec2(x = a.x.sub(b.x), y = a.y.sub(b.y))
    }
    unity := func(self: RangeableVec2) returns RangeableVec2 {
        return RangeableVec2(x = self.x.sub(self.x).add(1), y = 1)
    }
    cmp := func(a: RangeableVec2, b: RangeableVec2) returns I64 {
        if a.x.lt(b.x) { return -1 }
        if a.x.gt(b.x) { return 1 }
        return a.y.cmp(b.y)
    }
}

test_range_over_user_type_ascending := test() {
    mut sum := 0
    lo := RangeableVec2(x = 0, y = 0)
    hi := RangeableVec2(x = 3, y = 3)
    for v : RangeableVec2 in lo..hi {
        sum = sum.add(v.x).add(v.y)
    }
    // (0,0)->0, (1,1)->2, (2,2)->4
    assert_eq(I64, sum, 6)
}

test_range_over_user_type_descending := test() {
    mut sum := 0
    lo := RangeableVec2(x = 0, y = 0)
    hi := RangeableVec2(x = 3, y = 3)
    for v : RangeableVec2 in hi..lo {
        sum = sum.add(v.x).add(v.y)
    }
    // (3,3)->6, (2,2)->4, (1,1)->2
    assert_eq(I64, sum, 12)
}

// #94's recorded blocker: an INLINE constructor as a range operand. The
// desugar inferred the operand for its element type, which desugars a
// constructor's NamedArgs into positional fields, then cloned that into the
// loop's decls -- so the body walk inferred it a second time and rejected
// its own output ("struct instantiation requires named arguments"). The
// operands are snapshotted before that inference now.
test_range_over_user_type_inline_ctors := test() {
    mut sum := 0
    for v : RangeableVec2 in RangeableVec2(x = 0, y = 0)..RangeableVec2(x = 3, y = 3) {
        sum = sum.add(v.x).add(v.y)
    }
    assert_eq(I64, sum, 6)
}
