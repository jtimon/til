mode test

import("../src/std/dyn_map")

test_i64_map := test() {
    m := DynMap.new(I64, I64)
    m.set(3, own 30)
    m.set(1, own 10)
    m.set(2, own 20)
    assert_eq(USize, m.len(), 3)
    assert(m.has(1))
    assert(m.has(2))
    assert(m.has(3))
    assert(m.has(4).not())

    ref v1 : I64 = m[1]
    ref v2 : I64 = m[2]
    ref v3 : I64 = m[3]
    assert_eq(I64, v1, 10)
    assert_eq(I64, v2, 20)
    assert_eq(I64, v3, 30)

    // overwrite existing key
    m.set(2, own 99)
    assert_eq(USize, m.len(), 3)
    ref v2b : I64 = m[2]
    assert_eq(I64, v2b, 99)
}

test_str_map := test() {
    sm := DynMap.new(Str, I64)
    sm.set("banana", own 2)
    sm.set("apple", own 1)
    sm.set("cherry", own 3)
    assert_eq(USize, sm.len(), 3)
    assert(sm.has("apple"))
    assert(sm.has("banana"))
    assert(sm.has("cherry"))
    assert(sm.has("date").not())
    ref sa : I64 = sm["apple"]
    ref sb : I64 = sm["banana"]
    assert_eq(I64, sa, 1)
    assert_eq(I64, sb, 2)
}

// #323 API symmetry: DynMap.remove mirrors core Map.remove (returns
// whether anything was removed) and keeps the remaining keys ordered.
test_dyn_map_remove := test() {
    mut m := DynMap.new(Str, I64)
    m.set("a", own 1)
    m.set("b", own 2)
    m.set("c", own 3)
    assert(m.remove("missing").not())
    assert_eq(USize, m.len(), 3)
    assert(m.remove("b"))
    assert_eq(USize, m.len(), 2)
    assert(m.has("b").not())
    ref va : I64 = m.get("a")!
    ref vc : I64 = m.get("c")!
    assert_eq(I64, va, 1)
    assert_eq(I64, vc, 3)
    assert(m.remove("a"))
    assert(m.remove("c"))
    assert_eq(USize, m.len(), 0)
}

// DynMap.with_capacity mirrors Map.with_capacity (key/value types are
// runtime arguments, as for new).
test_dyn_map_with_capacity := test() {
    mut m := DynMap.with_capacity(Str, I64, 8)
    assert_eq(USize, m.len(), 0)
    assert(m.keys.cap.gte(8))
    assert(m.values.cap.gte(8))
    for i in 0..8 { m.set(format("k", i.to_str()), own i) }
    assert_eq(USize, m.len(), 8)
    ref v : I64 = m.get("k3")!
    assert_eq(I64, v, 3)
}
