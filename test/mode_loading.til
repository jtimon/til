mode cli

import("../src/std/sys")
import("../src/std/file")

realpath_str := ext_proc(path: Str) returns Str {}

check_mode_loading := proc(compiler: Str, root: Str, command: Str,
    definitions: Str, expected: Str, succeeds: Bool, asan: Bool) {
    cmd := Cmd.new(compiler, command)
    cmd.cwd(root.format("/test"))
    cmd.arg(format("--extra-modes=", root, "/test/", definitions))
    if succeeds {
        // Repeated flags and cyclic imports still load each definition once.
        cmd.arg(format("--extra-modes=", root, "/test/imports/mode_definitions_more.til"))
    }
    if command == "run" {
        cmd.args("-c", root.format("/gen/c/mode_loading_app.c"),
            "-o", root.format("/bin/c/mode_loading_app"))
        if asan { cmd.arg("--asan") }
    }
    cmd.arg("mode_loading_app.til")
    cmd.capture()
    status := cmd.run()
    output := cmd.out()
    errors := cmd.err()
    if succeeds {
        if status.neq(0).or(output.neq(expected)) {
            panic("mode loading ", command, " failed: ", output, errors)
        }
    } else {
        if status.eq(0).or(format(output, errors).contains(expected).not()) {
            panic("missing mode diagnostic for ", definitions, ": ", output, errors)
        }
    }
}

check_mode_policy := proc(compiler: Str, root: Str, command: Str,
    source: Str, expected: Str, succeeds: Bool) {
    cmd := Cmd.new(compiler, command,
        format("--extra-modes=", root, "/test/imports/mode_definitions.til"))
    cmd.cwd(root)
    if command == "translate" {
        cmd.args("-c", format(root, "/gen/c/", source.strip_suffix(".til"), ".c"))
    }
    cmd.arg(format("test/", source))
    cmd.capture()
    status := cmd.run()
    output := format(cmd.out(), cmd.err())
    if succeeds {
        if status != 0 { panic("mode policy ", source, " failed: ", output) }
    } else {
        if status == 0 || output.contains(expected).not() {
            panic("mode policy ", source, " missing diagnostic: ", output)
        }
    }
}

check_gui_link := proc(compiler: Str, root: Str, source: Str, has_gui: Bool) {
    cmd := Cmd.new(compiler, "build", "--target=wasm32", "--cc=echo",
        format("--extra-modes=", root, "/test/imports/mode_definitions.til"))
    cmd.cwd(root)
    cmd.args("-c", format("gen/c/", source.strip_suffix(".til"), ".c"),
        format("test/", source))
    cmd.capture()
    status := cmd.run()
    output := format(cmd.out(), cmd.err())
    // A gui program links wasm32's own raylib (src/modes/gui.til, issue
    // #422), which only a tree that built it has (CI's wasm job does; the
    // suite does not need emscripten). Without it the build stops before
    // compiling, naming the archive and the goal that builds it -- and
    // only a program that loaded gui.til has that link.
    wasm_raylib := "vendor/raylib/build-wasm32/libraylib.a"
    if has_gui.and(File.exists(format(root, "/", wasm_raylib)).not()) {
        if status == 0 || output.contains(format("links ", wasm_raylib, " for --target=wasm32, and it is not built")).not()
            || output.contains(format("bin/make ", wasm_raylib)).not() {
            panic("GUI target ", source, " without the wasm32 raylib: ", output)
        }
        return
    }
    if status != 0 { panic("GUI target ", source, " failed: ", output) }
    // Both wasm32 shapes are single-file emscripten builds (#424), so the
    // GUI marker is the GLFW port, which only the browser page links.
    if output.contains("-sUSE_GLFW") != has_gui {
        panic("GUI target flags for ", source, ": ", output)
    }
    if output.contains("-sSINGLE_FILE").not() {
        panic("wasm32 build of ", source, " is not single-file: ", output)
    }
    mut ext := ".js"
    if has_gui { ext = ".html" }
    if output.contains(format("bin/test/", source.strip_suffix(".til"), ext)).not() {
        panic("GUI output extension for ", source, ": ", output)
    }
}

// Issue #422: a mode's ~targets~ list and link()'s optional target list.
// --cc=echo prints the C commands instead of running them, so the checks
// see which link() flags applied without a cross toolchain.
build_targets := proc(compiler: Str, root: Str, target: Str) returns Cmd {
    cmd := Cmd.new(compiler, "build", format("--target=", target), "--cc=echo",
        format("--extra-modes=", root, "/test/imports/mode_definitions.til"))
    cmd.cwd(root)
    cmd.args("-c", "gen/c/mode_targets.c", "-o", "bin/test/mode_targets", "test/mode_targets.til")
    cmd.capture()
    return cmd
}

check_mode_targets := proc(compiler: Str, root: Str) {
    // An unlisted target is refused before anything is compiled.
    refused := build_targets(compiler, root, "wasm32")
    refused_status := refused.run()
    refused_out := format(refused.out(), refused.err())
    if refused_status == 0 || refused_out.contains("mode loading_targets does not support --target=wasm32").not() {
        panic("mode targets: wasm32 not refused: ", refused_out)
    }
    // linux-x64: only the linux-x64 link applies.
    x64 := build_targets(compiler, root, "linux-x64")
    if x64.run() != 0 { panic("mode targets: linux-x64 build failed: ", x64.out(), x64.err()) }
    if x64.out().contains("-ltilmode422").not().or(x64.out().contains("libtarget_only.a")) {
        panic("mode targets: wrong links for linux-x64: ", x64.out())
    }
    // linux-arm64: its archive is missing, and the report names the
    // mode's build_hint with the path as link() wrote it.
    arm := build_targets(compiler, root, "linux-arm64")
    arm_status := arm.run()
    arm_out := format(arm.out(), arm.err())
    if arm_status == 0
        || arm_out.contains("links test/imports/no_such_dir_422/libtarget_only.a for --target=linux-arm64, and it is not built").not()
        || arm_out.contains("build it first: bin/make test/imports/no_such_dir_422/libtarget_only.a").not()
        || arm_out.contains("-ltilmode422") {
        panic("mode targets: missing linux-arm64 archive not reported: ", arm_out)
    }
}

main := proc(args: ..Str) {
    root := realpath_str(".")
    compiler := realpath_str(args[0])
    asan := args.len() > 1
    for command : Str in array(Str, "interpret", "run") {
        check_mode_loading(compiler, root, command, "imports/mode_definitions.til",
            "mode support initialized\nmode layer initialized\n42\n", true, asan)
        check_mode_loading(compiler, root, command, "imports/no_such_modes_63.til",
            "could not find mode file", false, asan)
        check_mode_loading(compiler, root, command, "imports/mode_missing_import.til",
            "could not find mode import 'no_such_mode_definitions_63.til'", false, asan)
        check_mode_loading(compiler, root, command, "imports/mode_missing_support.til",
            "could not find mode support 'no_such_mode_support_63'", false, asan)
        check_mode_loading(compiler, root, command, "imports/mode_duplicate.til",
            "duplicate mode 'loading_entry'", false, asan)
        check_mode_loading(compiler, root, command, "mode_loading_app.til",
            "is not a 'mode mode' file", false, asan)
        check_mode_loading(compiler, root, command, "imports/mode_bad_targets.til",
            "Unknown target 'linux-x46'", false, asan)
    }
    for command : Str in array(Str, "interpret", "translate") {
        check_mode_policy(compiler, root, command, "mode_decls_only_bad.til",
            "mode allows declarations and imports only", false)
        check_mode_policy(compiler, root, command, "mode_decls_import.til",
            "mode allows declarations and imports only", false)
        check_mode_policy(compiler, root, command, "mode_decls_only_valid.til", "", true)
    }
    check_gui_link(compiler, root, "mode_gui_composed.til", true)
    check_gui_link(compiler, root, "mode_gui_name_only.til", false)
    check_mode_targets(compiler, root)
    println("mode loading passed")
}
