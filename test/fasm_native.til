mode cli
import("../src/std/sys")
import("../src/std/file")
import("../src/self/builder")
realpath_str := ext_proc(path: Str) returns Str {}

// Optional native integration: bootstrap vendor/fasm/fasm first, then:
// bin/til run test/fasm_native.til bin/til
check_shared := proc(compiler: Str, work: Str, source: Str, expected_exit: I64 = 0) {
    input := realpath_str(source)
    for width in array(Str, "32", "64") {
        interpreted := Cmd.new("timeout", "30s", compiler, "interpret", format("--usize=", width), input)
        interpreted.cwd(work).capture()
        interpreted_status := interpreted.run()
        expect(interpreted_status == expected_exit, source, width, interpreted.out(), interpreted.err())
        for backend in array(Str, "c", "fasm") {
            output := format("bin/shared-", backend, "-", width)
            build := Cmd.new(compiler, "build", format("--backend=", backend), format("--usize=", width), "-o", output, input)
            build.cwd(work).capture()
            status := build.run()
            expect(status == 0, source, backend, width, build.out(), build.err())
            run := Cmd.new("timeout", "30s", format("./", output))
            run.cwd(work).capture()
            result := run.run()
            expect(result == expected_exit, source, backend, width, result, run.out(), run.err())
            expect(run.out() == interpreted.out(), source, backend, width, "stdout mismatch", run.out())
            expect(run.err() == interpreted.err(), source, backend, width, "stderr mismatch", run.err())
        }
    }
}

check_test_command := proc(compiler: Str, work: Str) {
    File.writefile(format(work,"/test_library.til"),format(
        "mode lib\nmut total:I64=0\ninitialize:=func() returns I64 { total++; return total }\ninitial:=initialize()\n",
        "imported:=test() { assert(initial==1); assert(total==1); total++ }\n",
        "Library:=struct {\nnamespace:\nmember:=test() { assert(total==2); total++ }\n}\n"))
    File.writefile(format(work,"/tests.til"),format(
        "mode test\nimport(\"./test_library\")\nroot:=test() { assert(total==3); total++ }\n",
        "Local:=struct {\nnamespace:\nmember:=test() { assert(total==4); total++ }\n}\n",
        "Choice:=enum { One,\nnamespace:\nmember:=test() { assert(total==5); total++ }\n}\n",
        "last:=test() { assert(total==6) }\n"))
    File.writefile(format(work,"/cli_tests.til"),"mode cli\nmain:=proc() { panic(\"main must not run\") }\ninline_test:=test() { assert(true) }\n")
    File.writefile(format(work,"/library_tests.til"),"mode pure\nlibrary_test:=test() { assert(true) }\n")
    File.writefile(format(work,"/empty_tests.til"),"mode test\nunused:=func() returns I64 { return 1 }\n")
    File.writefile(format(work,"/failing_tests.til"),format(
        "mode test\nbefore:=test() { assert(true) }\n",
        "failing:=test() { panic(\"expected failure\",loc=\"native-test\") }\n",
        "after:=test() { panic(\"must not run\",loc=\"native-test\") }\n"))
    report := format("  pass: imported\n  pass: Library.member\n  pass: root\n",
        "  pass: Local.member\n  pass: Choice.member\n  pass: last\n6/6 tests passed\n")
    for width in array(Str,"32","64") {
        for backend in array(Str,"c","fasm") {
            for name in array(Str,"tests","cli_tests","library_tests") {
                mut expected := report.clone()
                if name=="cli_tests" { expected="  pass: inline_test\n1/1 tests passed\n" }
                if name=="library_tests" { expected="  pass: library_test\n1/1 tests passed\n" }
                mut output:=format("bin/test-",backend,"-",width)
                // FASM invokes its assembler with argv; exercise its existing
                // space-containing output support separately from C's shell.
                if backend=="fasm" { output=format("bin/test output-",width) }
                command:=Cmd.new(compiler,"test",format("--backend=",backend),format("--usize=",width),"-o",output,format(name,".til"))
                command.cwd(work).capture()
                status:=command.run()
                expect(status==0,name,backend,width,command.out(),command.err())
                expect(command.err()==format("=== interpret ===\n",expected,"=== compile + run ===\n",expected),command.err())
                expect(File.is_file(format(work,"/",output)),"test executable missing")
            }
        }
    }
    check_shared(compiler,work,format(work,"/tests.til"))
    check_shared(compiler,work,format(work,"/empty_tests.til"))
    check_shared(compiler,work,format(work,"/failing_tests.til"),1)
    artifact:=format(work,"/bin/interpreter-failure")
    File.remove(artifact)
    fail:=Cmd.new(compiler,"test","--backend=fasm","-o","bin/interpreter-failure","failing_tests.til")
    fail.cwd(work).capture()
    fail_status:=fail.run()
    expect(fail_status==1,fail.out(),fail.err())
    expect(fail.err()=="=== interpret ===\n  pass: before\n",fail.err())
    expect(fail.out()=="native-test: panic: expected failure\n",fail.out())
    expect(File.is_file(artifact).not(),"compiled after an interpreter failure")
}

check_rebuild := proc(compiler: Str, work: Str) {
    root := compiler.substr(0, compiler.rfind("/bin/").to_usize())
    stage := format(work, "/rebuild tools")
    File.remove_tree(stage)
    mkdir_p(format(stage, "/vendor/fasm"))
    expect(copy_tree(format(root, "/vendor/fasm/source"), format(stage, "/vendor/fasm/source")) == 0, "copy FASM sources")
    tool := format(stage, "/vendor/fasm/fasm")
    expect(copy_file(format(root, "/vendor/fasm/fasm"), tool) == 0, "copy FASM bootstrap")
    stage_root := realpath_str(stage)
    old := Cmd.new("touch", "-d", "2000-01-01", tool)
    old.run_checked()
    old_time := file_mtime(tool)
    expect(fasm_prepare(stage_root, true) == 0, "vendored FASM rebuild failed")
    expect(file_mtime(tool) > old_time, "stale assembler was not rebuilt")
    future := Cmd.new("touch", "-d", "2100-01-01", tool)
    future.run_checked()
    fresh_time := file_mtime(tool)
    expect(fasm_prepare(stage_root, true) == 0, "fresh assembler check failed")
    expect(file_mtime(tool) == fresh_time, "fresh assembler was unnecessarily rebuilt")
    changed_include := Cmd.new("touch", "-d", "2101-01-01", format(stage, "/vendor/fasm/source/version.inc"))
    changed_include.run_checked()
    expect(fasm_prepare(stage_root, true) == 0, "changed assembler include did not rebuild")
    expect(file_mtime(tool) != fresh_time, "assembler include was not tracked")
    original := File.readfile(tool)
    File.appendfile(format(stage, "/vendor/fasm/source/linux/x64/fasm.asm"), "\ninvalid_fasm_instruction\n")
    old_again := Cmd.new("touch", "-d", "2000-01-01", tool)
    old_again.run_checked()
    expect(fasm_prepare(stage_root, true) != 0, "invalid assembler source accepted")
    expect(File.readfile(tool) == original, "failed rebuild replaced the working assembler")
    survivor := Cmd.new(realpath_str(tool), format(work, "/gen/fasm/empty.fasm"), format(work, "/rebuild-survivor"))
    survivor.run_checked()
}

main := proc(compiler_arg: Str) {
    compiler := realpath_str(compiler_arg)
    work := "tmp/fasm_native"
    mkdir_p(work)
    mkdir_p(format(work, "/tmp"))
    // Mutable input prevents compile-time evaluation of the arithmetic/calls.
    File.writefile(format(work, "/main.til"), "mode cli\ncalc := func(a: I64, b: I64) returns I64 { return (a + b) * (a - b) }\nchoose := func(a: I64, b: I64) returns I64 { if a < b { return calc(a,b) } else { return calc(b,a) } }\nmain := proc() { mut x : I64 = 8; x = x + 1; exit(choose(x,5) + choose(2,x-1)) }\n")
    // Independent execution paths must agree on the actual process result.
    for execution in array(Str, "interpret", "c", "fasm") {
        command := Cmd.new(compiler)
        if execution == "interpret" { command.args("interpret", "main.til") }
        else { command.args("run", format("--backend=", execution), "main.til") }
        command.cwd(work).capture()
        status := command.run()
        expect(status == 140, execution, status, command.out(), command.err())
    }
    assembly := File.readfile(format(work, "/gen/fasm/main.fasm"))
    expect(assembly.contains("imul rax, rcx") && assembly.contains("setl al"), "test arithmetic was folded away", assembly)
    // Signed comparison, equality, Bool negation, and wrapping I64 arithmetic.
    File.writefile(format(work, "/wrap.til"), "mode cli\ncheck := func(a: I64, b: I64) returns I64 { if (a + b < 0).not() { return 1 } if a + b == -9223372036854775808 { return 37 } return 2 }\nmain := proc() { mut x : I64 = 0; x = x + 1; exit(check(9223372036854775807,x)) }\n")
    for execution in array(Str, "interpret", "c", "fasm") {
        command := Cmd.new(compiler)
        if execution == "interpret" { command.args("interpret", "wrap.til") }
        else { command.args("run", format("--backend=", execution), "wrap.til") }
        command.cwd(work).capture()
        status := command.run()
        expect(status == 37, execution, status, command.out(), command.err())
    }
    File.writefile(format(work, "/empty.til"), "mode cli\nmain := proc() {}\n")
    File.writefile(format(work, "/arguments.til"), "mode cli\nsum := func(a: I64,b: I64,c: I64,d: I64,e: I64,f: I64) returns I64 { return a+b+c+d+e+f }\nchoose := func(flag: Bool, x: I64) returns I64 { if flag { return x } return 1 }\nmain := proc() { mut x : I64 = 0; x = x + 1; exit(choose(sum(x,2,3,4,5,6) > 20, sum(6,5,4,3,2,x))) }\n")
    for execution in array(Str, "interpret", "c", "fasm") {
        command := Cmd.new(compiler)
        if execution == "interpret" { command.args("interpret", "arguments.til") }
        else { command.args("run", format("--backend=", execution), "arguments.til") }
        command.cwd(work).capture()
        status := command.run()
        expect(status == 21, execution, status, command.out(), command.err())
    }
    build := Cmd.new(compiler, "build", "--backend=fasm", "-o", "bin/custom output", "empty.til")
    build.cwd(work).capture()
    build_status := build.run()
    expect(build_status == 0, build.out(), build.err())
    run := Cmd.new(format(work, "/bin/custom output"))
    expect(run.run() == 0, "empty main failed")
    for source in array(Str, "test/templeos/holyc_continue.til", "examples/fizzbuzz.til", "examples/templeos_scalars.til", "test/scalar_control.til", "examples/templeos_calls.til", "test/aggregate_control.til", "test/reference_rebinding.til", "test/interfaces.til", "test/test_in_namespace.til") {
        check_shared(compiler, work, source)
    }
    check_shared(compiler, work, "test/script_bang_panic_msg.til", 1)
    check_shared(compiler, work, "test/script_bang_store_panic_msg.til", 1)
    check_test_command(compiler,work)
    check_rebuild(compiler, work)
    println("fasm_native PASS")
}
