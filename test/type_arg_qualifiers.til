mode cli

import("../src/std/sys")
import("../src/std/file")

check := proc(cmd: Cmd, expected: Str) {
    cmd.capture()
    status := cmd.run()
    output := format(cmd.out(), cmd.err())
    if status != 0 { panic(cmd.render(), ": ", output) }
    assert_eq(Str, output, expected)
}

reject := proc(cmd: Cmd, expects_arity: Bool = true) {
    cmd.capture()
    status := cmd.run()
    output := format(cmd.out(), cmd.err())
    if status == 0 { panic("accepted invalid qualifier query: ", cmd.render()) }
    expect(output.contains("type_arg_is_ref requires a compile-time type argument"), output)
    if expects_arity { expect(output.contains("type_arg_is_ref expects one compile-time type argument"), output) }
}

reject_generic := proc(compiler: Str, root: Str, source: Str, expected: Str) {
    path := format(root, "/invalid_generic.til")
    File.writefile(path, source)
    for action : Str in array(Str, "interpret", "translate") {
        cmd := Cmd.new(compiler, action, path)
        cmd.capture()
        status := cmd.run()
        output := format(cmd.out(), cmd.err())
        expect(status != 0, source, ": ", output)
        expect(output.contains(expected), source, ": ", output)
    }
}

main := proc(args: ..Str) {
    ref compiler: Str = args[0]
    root := "tmp/type_arg_qualifiers"
    mkdir_p(root)
    // Exercise the real macro source under an unrelated name and file path.
    // The injected method only exposes the qualifier query for assertions;
    // it makes no claim that Vec's borrowed-element operations are complete.
    source := File.readfile("src/core/vec.til")
    renamed := source.replace("Vec", "MyAltVec").replace("vec", "my_alt_vec")
        .replace("import(\"", "import(\"core/")
        .replace("namespace:", "namespace:\n    query_ref := func() returns Bool { return type_arg_is_ref(T) }\n")
    File.writefile(format(root, "/MyAltVec.til"), renamed)
    array_source := File.readfile("src/core/array.til")
        .replace("Array", "MyAltArray").replace("array", "my_alt_array")
        .replace("Vec", "MyAltVec")
        .replace("import(\"", "import(\"core/")
        .replace("import(\"core/vec\")", "import(\"MyAltVec\")")
    File.writefile(format(root, "/MyAltArray.til"), array_source)
    map_source := File.readfile("src/core/map.til")
        .replace("Map", "MyAltMap").replace("map_", "my_alt_map_")
        .replace("Vec", "MyAltVec").replace("import(\"", "import(\"core/")
        .replace("mode lib", "mode lib\nimport(\"MyAltVec\")")
    File.writefile(format(root, "/MyAltMap.til"), map_source)
    set_source := File.readfile("src/core/set.til")
        .replace("Set", "MyAltSet").replace("set_ref_store", "my_alt_set_ref_store")
        .replace("import(\"", "import(\"core/")
    File.writefile(format(root, "/MyAltSet.til"), set_source)
    File.writefile(format(root, "/probe.til"), format(
        "mode cli\nimport(\"MyAltVec\")\n",
        "Contract := interface { value := func(self: Contract) returns I64\n",
        "borrowed_values := func(self: Contract) returns MyAltVec(ref Contract) { mut result := MyAltVec(ref Contract).new(); result.push(self); return result }\n",
        "owned_values := func(self: Contract) returns MyAltVec(own Contract) { mut result := MyAltVec(own Contract).new(); result.push(own self.clone()); return result }\n}\n",
        "Record := struct implements Contract { n := 11\nnamespace:\nvalue := func(self: Record) returns I64 { return self.n } }\n",
        "Choice := enum implements Contract { One\nnamespace:\nvalue := func(self: Choice) returns I64 { switch self { case .One: return 1 } } }\n",
        "ContractAlias := Contract\n",
        "interface_query := macro(T: Type) returns FuncDef {\n",
        "    if type_arg_is_interface(T) { return func() returns Bool { return true } }\n",
        "    else { return func() returns Bool { return false } }\n}\n",
        "query_interface := interface_query(ref ContractAlias)\n",
        "query_record := interface_query(Record)\n",
        "query_choice := interface_query(Choice)\n",
        "InterfaceProbe := macro(T: Type) returns StructDef {\n",
        "    if type_arg_is_interface(T).and(type_arg_is_ref(T)) { return struct { borrowed_interface := true } }\n",
        "    else { return struct { borrowed_interface := false } }\n}\n",
        "InterfaceForward := macro(T: Type) returns StructDef { return struct { probe := InterfaceProbe(T)() } }\n",
        "empty_borrow := func(value: Option(ref Contract)) returns Bool { return value.is_none() }\n",
        "Probe := macro(Element: Type) returns StructDef {\n",
        "    if type_arg_is_ref(Element) { return struct { borrowed := true } }\n",
        "    else { return struct { borrowed := false } }\n}\n",
        "OtherProbe := macro(Item: Type) returns StructDef {\n",
        "    if type_arg_is_ref(Item).not() { return struct { borrowed := false } }\n",
        "    else { return struct { borrowed := true } }\n}\n",
        "Forward := macro(Value: Type) returns StructDef { return struct { probe := Probe(Value)() } }\n",
        "make_query := macro(Value: Type) returns FuncDef { return func() returns Bool { return type_arg_is_ref(Value) } }\n",
        "borrowed_query := make_query(ref Str)\n",
        "owned_query := make_query(Str)\n",
        "Alias := Str\n",
        "StringVec := Vec(Str)\n",
        "borrow_one := func(value: Str) returns MyAltVec(ref Str) { mut result := MyAltVec(ref Str).new(); result.push(value); return result }\n",
        "priv member_factory := macro(Element: Type) returns FuncDef { return func() returns USize { return Element.size() } }\n",
        "MemberProbe := macro(Element: Type) returns StructDef { return struct { namespace:\nwidth := member_factory(Element)\n} }\n",
        "main := proc() {\n",
        "    nested_query := Probe(Vec(Str))()\n",
        "    assert(nested_query.borrowed.not())\n",
        "    nested_ref_query := Probe(ref Vec(Str))()\n",
        "    assert(nested_ref_query.borrowed)\n",
        "    assert_eq(USize, MemberProbe(I64).width(), I64.size())\n",
        "    assert(type_arg_is_ref(ref Str))\n",
        "    assert(type_arg_is_interface(Contract))\n",
        "    assert(type_arg_is_interface(own ContractAlias))\n",
        "    assert(type_arg_is_interface(ref Contract))\n",
        "    assert(type_arg_is_interface(Record).not())\n",
        "    assert(type_arg_is_interface(Choice).not())\n",
        "    assert(type_arg_is_interface(I64).not())\n",
        "    assert(type_arg_is_interface(StructDef).not())\n",
        "    assert(type_arg_is_interface(EnumDef).not())\n",
        "    assert(type_arg_is_interface(Option(ref Contract)).not())\n",
        "    assert(query_interface())\n",
        "    assert(query_record().not())\n",
        "    assert(query_choice().not())\n",
        "    interface_forward := InterfaceForward(ref ContractAlias)()\n",
        "    assert(interface_forward.probe.borrowed_interface)\n",
        "    assert(type_arg_is_ref(Str).not())\n",
        "    assert(type_arg_is_ref(own Str).not())\n",
        "    assert(type_arg_is_ref(Option(ref Str)).not())\n",
        "    borrowed := Probe(ref Alias)()\n",
        "    owned := Probe(Alias)()\n",
        "    other_borrowed := OtherProbe(ref I64)()\n",
        "    other_owned := OtherProbe(I64)()\n",
        "    forwarded_borrowed := Forward(ref Str)()\n",
        "    forwarded_owned := Forward(Str)()\n",
        "    assert(borrowed.borrowed)\n",
        "    assert(owned.borrowed.not())\n",
        "    assert(other_borrowed.borrowed)\n",
        "    assert(other_owned.borrowed.not())\n",
        "    assert(forwarded_borrowed.probe.borrowed)\n",
        "    assert(forwarded_owned.probe.borrowed.not())\n",
        "    assert(borrowed_query())\n",
        "    assert(owned_query().not())\n",
        "    assert(MyAltVec(own I64).query_ref().not())\n",
        "    assert(MyAltVec(I64).query_ref().not())\n",
        "    mut values := MyAltVec(I64).new()\n",
        "    values.push(own 7)\n",
        "    assert_eq(I64, values[0], 7)\n",
        "    mut contracts: MyAltVec(own Contract) = MyAltVec(own Contract).new()\n",
        "    contracts.push(own Record())\n",
        "    assert_eq(I64, contracts[0].value(), 11)\n",
        "    assert(empty_borrow(Option(ref Contract).None))\n",
        "    mut text := format(\"borrowed \", \"text\")\n",
        "    other := format(\"other \", \"text\")\n",
        "    mut texts := MyAltVec(ref Str).with_capacity(2)\n",
        "    texts.push(text)\ntexts.push(other)\n",
        "    text = format(\"changed \", \"text\")\n",
        "    assert_eq(Str, texts[0], \"changed text\")\n",
        "    mut copied_texts := texts.clone()\n",
        "    texts.set(0, other)!\ntexts.unsafe_set(1, text)\n",
        "    ref popped_text: Str = texts.pop()\n",
        "    assert_eq(Str, popped_text, \"changed text\")\n",
        "    texts.remove_at(0)!\nassert_eq(USize, texts.len(), 0)\n",
        "    assert_eq(Str, copied_texts[0], \"changed text\")\n",
        "    prefix := copied_texts.take_prefix(1)\ntexts.append(own prefix)\n",
        "    assert_eq(Str, texts[0], \"changed text\")\n",
        "    texts.push_take(copied_texts, 0)\ncopied_texts.clear()\n",
        "    assert_eq(Str, texts[1], \"other text\")\n",
        "    masks := array(Bool, true, false)\ntexts.delete_marked(masks.data)\n",
        "    assert_eq(USize, texts.len(), 1)\nassert_eq(Str, texts[0], \"other text\")\n",
        "    moved := texts.take()\nassert_eq(USize, texts.len(), 0)\ntexts.move_from(own moved)\n",
        "    texts.truncate(0)\ntexts.push(text)\n",
        "    lent := borrow_one(other)\nassert_eq(Str, lent[0], \"other text\")\n",
        "    mut number: I64 = 12\n",
        "    mut numbers := MyAltVec(ref I64).new()\n",
        "    numbers.push(number)\nnumber = 19\nassert_eq(I64, numbers[0], 19)\n",
        "    mut record := Record()\nchoice := Choice.One\n",
        "    mut records := MyAltVec(ref Record).new()\nrecords.push(record)\n",
        "    mut choices := MyAltVec(ref Choice).new()\nchoices.push(choice)\n",
        "    mut views := MyAltVec(ref Contract).new()\nviews.push(record)\nviews.push(choice)\n",
        "    record.n = 21\nassert_eq(I64, records[0].value(), 21)\nassert_eq(I64, choices[0].value(), 1)\n",
        "    assert_eq(I64, views[0].value(), 21)\nassert_eq(I64, views[1].value(), 1)\n",
        "    mut sum := 0\nfor view in views { sum = sum + view.value() }\nassert_eq(I64, sum, 22)\n",
        "    copied_views := views.clone()\n",
        "    views.set(0, choice)!\nviews.unsafe_set(1, record)\n",
        "    ref popped_view: Contract = views.pop()\nassert_eq(I64, popped_view.value(), 21)\n",
        "    views.clear()\nassert_eq(I64, copied_views[0].value(), 21)\nassert_eq(I64, copied_views[1].value(), 1)\n",
        "    mut self_take := MyAltVec(ref Contract).with_capacity(1)\nself_take.push(record)\nself_take.push_take(self_take, 0)\nassert_eq(I64, self_take[1].value(), 21)\n",
        "    mut strings := Vec(Str).new()\nstrings.push(own format(\"nested\"))\n",
        "    mut nested_refs := MyAltVec(ref StringVec).new()\nnested_refs.push(strings)\nassert_eq(USize, nested_refs[0].len(), 1)\n",
        "    mut disposable := MyAltVec(ref Str).new()\ndisposable.push(text)\nsurviving_copy := disposable.clone()\nown disposable.delete()\nassert_eq(Str, surviving_copy[0], \"changed text\")\n",
        "    factory_refs := borrow_one(text)\ntext = format(\"after clone\")\nassert_eq(Str, factory_refs[0], \"after clone\")\nassert_eq(Str, surviving_copy[0], \"after clone\")\n",
        "    handle: Contract = Record(n = 51)\nhandle_refs: MyAltVec(ref Contract) = handle.borrowed_values()\nmut handle_copies: MyAltVec(own Contract) = handle.owned_values()\nhandle_copies.push(own Choice.One)\nassert_eq(I64, handle_refs[0].value(), 51)\nassert_eq(I64, handle_copies[1].value(), 1)\n",
        "    println(\"qualifiers OK\")\n}\n"))
    check(Cmd.new(compiler, "interpret", format(root, "/probe.til")), "qualifiers OK\n")
    check(Cmd.new(compiler, "run", "--asan", "-o", format(root, "/probe"),
        "-c", format(root, "/probe.c"), format(root, "/probe.til")), "qualifiers OK\n")
    family_imports := "import(\"MyAltArray\")\nimport(\"MyAltMap\")\nimport(\"MyAltSet\")\n"
    family_types := format(
        "Ordered := interface { value := func(self: Ordered) returns I64\ncmp := func(self: Ordered, other: Ordered) returns I64 }\n",
        "Item := struct implements Ordered { n: I64\nnamespace:\n",
        "value := func(self: Item) returns I64 { return self.n }\n",
        "cmp := func(self: Item, other: Item) returns I64 { return I64.cmp(self.n, other.n) } }\n",
        "Entry := enum implements Ordered { Number: I64\nnamespace:\n",
        "value := func(self: Entry) returns I64 { switch self { case .Number(n): return n } }\n",
        "cmp := func(self: Entry, other: Entry) returns I64 { return I64.cmp(self.value(), other.value()) } }\n",
        "RefKey := struct implements Ordered { ref label: Str\nnamespace:\nvalue := func(self: RefKey) returns I64 { return self.label.len().to_i64() }\ncmp := func(self: RefKey, other: RefKey) returns I64 { return Str.cmp(self.label, other.label) } }\n")
    File.writefile(format(root, "/families.til"), format("mode cli\n", family_imports, family_types,
        "concat_local := func(left: MyAltArray(ref Str)) returns USize { local := format(\"local\"); mut right := MyAltArray(ref Str).new(1); right.set(0, local)!; joined := left.concat(right); return joined[left.len()].len() }\n",
        "check_concat := proc(prefix: Str) { noop_proc(); first := prefix.clone(); second := format(prefix, \"second\"); mut left := MyAltArray(ref Str).new(1); mut right := MyAltArray(ref Str).new(1); left.set(0, first)!; right.set(0, second)!; joined := left.concat(right); own left.delete(); own right.delete(); assert_eq(Str, joined[0], prefix); assert_eq(Str, joined[1], format(prefix, \"second\")) }\n",
        "main := proc() {\n",
        "check_concat(\"owner\")\n",
        "mut a := format(\"alpha\")\nb := format(\"beta\")\nc := format(\"charlie\")\n",
        "mut arr := MyAltArray(ref Str).new(2)\narr.set(0, a)!\narr.unsafe_set(1, b)\n",
        "arr_copy := arr.clone()\njoined := arr.concat(arr_copy)\nvector := arr.to_vec()\nown arr.delete()\n",
        "a = format(\"ALPHA\")\nassert_eq(Str, arr_copy[0], a)\nassert_eq(Str, joined[2], a)\nassert_eq(Str, vector[0], a)\n",
        "assert_eq(USize, concat_local(arr_copy), 5)\n",
        "mut nums := MyAltArray(ref I64).new(1)\nmut number := 1\nnums.set(0, number)!\nnumber = 9\nassert_eq(I64, nums[0], 9)\n",
        "mut set := MyAltSet(ref Str).with_capacity(1)\nset.add(c)\nset.add(a)\nset.add(b)\nset.add(b)\nassert_eq(USize, set.len(), 3)\n",
        "assert(set.has(b))\nassert(set.remove(b))\nassert(set.remove(b).not())\nset_copy := set.clone()\nown set.delete()\n",
        "mut joined_keys := format(\"\")\nfor key in set_copy { joined_keys = format(joined_keys, key) }\nassert_eq(Str, joined_keys, \"ALPHAcharlie\")\n",
        "mut borrowed_values := MyAltMap(Str, ref Str).new()\nborrowed_values.set(\"z\", a)\nborrowed_values.set(\"a\", b)\nborrowed_values.set(\"m\", c)\n",
        "borrowed_values.set(\"z\", b)\nassert_eq(Str, borrowed_values[\"z\"], b)\nassert(borrowed_values.remove(\"m\"))\nassert(borrowed_values.remove(\"missing\").not())\n",
        "values_copy := borrowed_values.clone()\nown borrowed_values.delete()\nassert_eq(Str, values_copy[\"a\"], b)\n",
        "mut pairs := format(\"\")\nfor key, value in values_copy { pairs = format(pairs, key, value) }\nassert_eq(Str, pairs, \"abetazbeta\")\n",
        "mut borrowed_keys := MyAltMap(ref Str, Str).new()\nborrowed_keys.set(c, own format(\"third\"))\nborrowed_keys.set(a, own format(\"first\"))\nborrowed_keys.set(b, own format(\"second\"))\n",
        "borrowed_keys.set(b, own format(\"replacement\"))\nkeys_copy := borrowed_keys.clone()\nborrowed_keys.clear()\nassert_eq(Str, keys_copy[b], \"replacement\")\n",
        "mut both := MyAltMap(ref Str, ref Str).new()\nboth.set(c, a)\nboth.set(a, b)\nboth.set(b, c)\nboth_copy := both.clone()\nown both.delete()\nassert_eq(Str, both_copy[c], a)\n",
        "mut pair_count := 0\nfor key, value in both_copy { assert(both_copy.has(key)); assert(value.len() > 0); pair_count++ }\nassert_eq(I64, pair_count, 3)\n",
        "first := Item(n = 1)\nsecond := Item(n = 2)\nmut payload := Item(n = 3)\nchoice := Entry.Number(4)\n",
        "mut iface_array := MyAltArray(ref Ordered).new(2)\niface_array.set(0, payload)!\niface_array.set(1, choice)!\niface_vec := iface_array.to_vec()\nown iface_array.delete()\n",
        "mut iface_values := MyAltMap(Str, ref Ordered).new()\niface_values.set(\"item\", payload)\niface_values.set(\"enum\", choice)\n",
        "payload.n = 8\nassert_eq(I64, iface_vec[0].value(), 8)\nassert_eq(I64, iface_values[\"item\"].value(), 8)\nassert_eq(I64, iface_values[\"enum\"].value(), 4)\n",
        "mut total := 0\nfor key, value in iface_values { assert(key.len() > 0); total = total + value.value() }\nassert_eq(I64, total, 12)\n",
        "mut objects := MyAltMap(ref Item, ref Item).new()\nobjects.set(second, payload)\nobjects.set(first, second)\nassert_eq(I64, objects[second].value(), 8)\n",
        "mut iface_keys := MyAltMap(ref Ordered, Str).new()\niface_keys.set(second, own format(\"two\"))\niface_keys.set(first, own format(\"one\"))\nassert_eq(Str, iface_keys[first], \"one\")\n",
        "mut iface_set := MyAltSet(ref Ordered).new()\niface_set.add(second)\niface_set.add(first)\nassert(iface_set.has(first))\nassert(iface_set.remove(second))\nassert_eq(I64, iface_set.unsafe_get(0).value(), 1)\n",
        "enum_a := Entry.Number(5)\nenum_b := Entry.Number(6)\nmut enum_set := MyAltSet(ref Entry).new()\nenum_set.add(enum_b)\nenum_set.add(enum_a)\nassert_eq(I64, enum_set.unsafe_get(0).value(), 5)\n",
        "one := 1\ntwo := 2\nmut scalar_set := MyAltSet(ref I64).new()\nscalar_set.add(two)\nscalar_set.add(one)\nassert_eq(I64, scalar_set.unsafe_get(0), 1)\nassert(scalar_set.remove(2))\n",
        "mut item_set := MyAltSet(ref Item).new()\nitem_set.add(second)\nitem_set.add(first)\nassert_eq(I64, item_set.unsafe_get(0).n, 1)\n",
        "mut interface_enums := MyAltSet(ref Ordered).new()\ninterface_enums.add(enum_b)\ninterface_enums.add(enum_a)\nassert_eq(I64, interface_enums.unsafe_get(0).value(), 5)\n",
        "mut owned_key := Item(n = 10)\nmut owning_keys := MyAltMap(own Ordered, ref Str).new()\nowning_keys.set(owned_key, c)\nowned_key.n = 11\nquery := Item(n = 10)\nassert_eq(Str, owning_keys[query], c)\n",
        "holder := RefKey(label = b)\nmut mixed := MyAltMap(RefKey, ref RefKey).new()\nmixed.set(RefKey(label = a), holder)\nassert_eq(Str, mixed[RefKey(label = a)].label, b)\n",
        "mut owned_array := MyAltArray(own Str).new(1)\nowned_array.set(0, own format(\"owned\"))!\nassert_eq(Str, owned_array[0], \"owned\")\n",
        "mut owned_set := MyAltSet(own Str).new()\nowned_set.add(own format(\"owned\"))\nassert(owned_set.has(\"owned\"))\n",
        "println(\"container families OK\")\n}\n"))
    check(Cmd.new(compiler, "interpret", format(root, "/families.til")), "container families OK\n")
    check(Cmd.new(compiler, "run", "--asan", "-o", format(root, "/families"),
        "-c", format(root, "/families.c"), format(root, "/families.til")), "container families OK\n")
    native_families := File.readfile(format(root, "/families.til"))
        .replace(family_imports, "")
        .replace("MyAltArray", "Array").replace("MyAltMap", "Map").replace("MyAltSet", "Set")
    File.writefile(format(root, "/native_families.til"), native_families)
    check(Cmd.new(compiler, "interpret", format(root, "/native_families.til")), "container families OK\n")
    check(Cmd.new(compiler, "run", "--asan", "-o", format(root, "/native_families"),
        "-c", format(root, "/native_families.c"), format(root, "/native_families.til")), "container families OK\n")
    for body : Str in array(Str,
        "import(\"MyAltArray\")\nbad := func() returns MyAltArray(ref Str) { value := format(\"local\"); mut a := MyAltArray(ref Str).new(1); a.set(0, value)!; return a.clone() }\nmain := proc() {}",
        "import(\"MyAltArray\")\nbad := func() returns MyAltVec(ref Str) { value := format(\"local\"); mut a := MyAltArray(ref Str).new(1); a.set(0, value)!; return a.to_vec() }\nmain := proc() {}",
        "import(\"MyAltArray\")\nbad := func(left: MyAltArray(ref Str)) returns MyAltArray(ref Str) { value := format(\"local\"); mut right := MyAltArray(ref Str).new(1); right.set(0, value)!; return left.concat(right) }\nmain := proc() {}",
        "import(\"MyAltArray\")\nmain := proc() { mut a := MyAltArray(ref Str).new(1); if true { value := format(\"local\"); a.set(0, value)! } }",
        "import(\"MyAltArray\")\nmain := proc() { mut a := MyAltArray(ref I64).new(1); a.set(0, 7)! }",
        "import(\"MyAltMap\")\nbad := func() returns MyAltMap(ref Str, Str) { key := format(\"local\"); mut m := MyAltMap(ref Str, Str).new(); m.set(key, own format(\"value\")); return m }\nmain := proc() {}",
        "import(\"MyAltMap\")\nbad := func() returns MyAltMap(Str, ref Str) { value := format(\"local\"); mut m := MyAltMap(Str, ref Str).new(); m.set(\"key\", value); return m.clone() }\nmain := proc() {}",
        "import(\"MyAltMap\")\nbad := proc(mut m: MyAltMap(ref Str, I64)) { key := format(\"local\"); m.set(key, own 3) }\nmain := proc() {}",
        "import(\"MyAltMap\")\nmain := proc() { mut m := MyAltMap(Str, ref Str).new(); m.set(\"key\", format(\"temporary\")) }",
        "import(\"MyAltMap\")\nmain := proc() { mut m := MyAltMap(ref Str, I64).new(); m.set(\"temporary\", own 3) }",
        "import(\"MyAltSet\")\nbad := func() returns MyAltSet(ref Str) { value := format(\"local\"); mut s := MyAltSet(ref Str).new(); s.add(value); return s.clone() }\nmain := proc() {}",
        "import(\"MyAltSet\")\nmain := proc() { mut s := MyAltSet(ref Str).new(); if true { value := format(\"local\"); s.add(value) } }",
        "import(\"MyAltSet\")\nmain := proc() { mut s := MyAltSet(ref I64).new(); s.add(7) }",
        "import(\"MyAltSet\")\nmain := proc() { label := format(\"live\"); mut s := MyAltSet(ref RefKey).new(); s.add(RefKey(label = label)) }",
        "import(\"MyAltArray\")\nmain := proc() { label := format(\"live\"); mut a := MyAltArray(ref RefKey).new(1); a.set(0, RefKey(label = label))! }",
        "import(\"MyAltMap\")\nmain := proc() { label := format(\"live\"); mut m := MyAltMap(ref RefKey, I64).new(); m.set(RefKey(label = label), own 7) }",
        "import(\"MyAltMap\")\nmain := proc() { label := format(\"live\"); mut m := MyAltMap(Str, ref Ordered).new(); m.set(\"key\", RefKey(label = label)) }") {
        File.writefile(format(root, "/invalid_family.til"), format("mode cli\n", family_types, body, "\n"))
        for action : Str in array(Str, "interpret", "translate") {
            cmd := Cmd.new(compiler, action, format(root, "/invalid_family.til"))
            cmd.capture()
            status := cmd.run()
            output := format(cmd.out(), cmd.err())
            expect(status != 0, body, ": ", output)
            expect(output.contains("cannot store a borrow").or(output.contains("cannot return a borrow")), body, ": ", output)
        }
    }
    File.writefile(format(root, "/unset_array.til"), "mode cli\nimport(\"MyAltArray\")\nmain := proc() { a := MyAltArray(ref Str).new(1); println(a[0]) }\n")
    for action : Str in array(Str, "interpret", "run") {
        cmd := Cmd.new(compiler, action, format(root, "/unset_array.til"))
        cmd.capture()
        status := cmd.run()
        output := format(cmd.out(), cmd.err())
        expect(status != 0, output)
        expect(output.contains("Array.get: uninitialized borrowed element"), output)
    }
    File.writefile(format(root, "/invalid.til"), format(
        "mode cli\nbad := func(value: Type) returns Bool { return type_arg_is_ref(value) }\n",
        "main := proc() { println(type_arg_is_ref(1)); println(type_arg_is_ref()) }\n"))
    reject(Cmd.new(compiler, "interpret", format(root, "/invalid.til")))
    reject(Cmd.new(compiler, "build", "-o", format(root, "/invalid"),
        "-c", format(root, "/invalid.c"), format(root, "/invalid.til")))
    File.writefile(format(root, "/invalid_generator.til"), format(
        "mode cli\nBad := macro(N: I64) returns StructDef {\n",
        "    if type_arg_is_ref(N) { return struct { value := true } }\n",
        "    else { return struct { value := false } }\n}\n",
        "BadValue := Bad(3)\nmain := proc() { println(\"invalid generator\") }\n"))
    reject(Cmd.new(compiler, "interpret", format(root, "/invalid_generator.til")), false)
    reject(Cmd.new(compiler, "build", "-o", format(root, "/invalid_generator"),
        "-c", format(root, "/invalid_generator.c"), format(root, "/invalid_generator.til")), false)
    for body : Str in array(Str,
        "bad := func(value: Type) returns Bool { return type_arg_is_interface(value) }\nmain := proc() {}",
        "main := proc() { println(type_arg_is_interface(1)) }",
        "main := proc() { println(type_arg_is_interface()) }",
        "main := proc() { println(type_arg_is_interface(I64, Str)) }") {
        File.writefile(format(root, "/invalid_interface_query.til"), format("mode cli\n", body, "\n"))
        for action : Str in array(Str, "interpret", "translate") {
            cmd := Cmd.new(compiler, action, format(root, "/invalid_interface_query.til"))
            cmd.capture()
            status := cmd.run()
            output := format(cmd.out(), cmd.err())
            expect(status != 0, body, ": ", output)
            expect(output.contains("error: type_arg_is_interface"), body, ": ", output)
        }
    }
    contract := "Contract := interface { value := func(self: Contract) returns I64 }\n"
    for body : Str in array(Str,
        "bad := func() returns MyAltVec(ref Str) { text := format(\"local\"); mut v := MyAltVec(ref Str).new(); v.push(text); return v }\nmain := proc() {}",
        "bad := func() returns MyAltVec(ref Str) { text := format(\"local\"); mut v := MyAltVec(ref Str).new(); v.push(text); return v.clone() }\nmain := proc() {}",
        "main := proc() { mut v := MyAltVec(ref Str).new(); if true { text := format(\"local\"); v.push(text) } }",
        "bad := proc(mut v: MyAltVec(ref Str)) { text := format(\"local\"); v.push(text) }\nmain := proc() {}",
        "main := proc() { mut v := MyAltVec(ref Str).new(); if true { ref mut alias: MyAltVec(ref Str) = v; text := format(\"local\"); alias.push(text) } }",
        "Holder := struct { refs := MyAltVec(ref Str).new() }\nmain := proc() { mut holder := Holder(); if true { text := format(\"local\"); holder.refs.push(text) } }",
        "main := proc() { mut v := MyAltVec(ref Str).new(); v.push(format(\"temporary\")) }",
        "main := proc() { mut v := MyAltVec(ref I64).new(); v.push(7) }",
        "bad := func() returns MyAltVec(ref I64) { mut raw: I64 = malloc(I64.size().to_uptr()); raw = 5; mut v := MyAltVec(ref I64).new(); v.push(raw); return v }\nmain := proc() {}",
        "bad := func() returns MyAltVec(ref Contract) { record := Record(); mut v := MyAltVec(ref Contract).new(); v.push(record); return v.clone() }\nmain := proc() {}",
        "main := proc() { mut v := MyAltVec(ref Contract).new(); if true { record := Record(); v.push(record) } }",
        "main := proc() { mut v := MyAltVec(ref Contract).new(); v.push(Record()) }",
        "bad := func() returns MyAltVec(ref Str) { return borrow_one(format(\"temporary\")) }\nmain := proc() {}",
        "main := proc() { mut owner: Contract = Record(); mut v := MyAltVec(ref Contract).new(); v.push(owner); copy := v.clone(); own v.delete(); owner = Record(n = 8); println(copy[0].value()) }",
        "Opt := Option(ref Str)\nbad := func(text: Str) returns MyAltVec(ref Opt) { item := Opt.Some(text); mut v := MyAltVec(ref Opt).new(); v.push(item); return v }\nmain := proc() {}") {
        File.writefile(format(root, "/invalid_borrow.til"), format("mode cli\nimport(\"MyAltVec\")\n", contract,
            "Record := struct implements Contract { n := 3\nnamespace:\nvalue := func(self: Record) returns I64 { return self.n } }\n",
            "borrow_one := func(value: Str) returns MyAltVec(ref Str) { mut result := MyAltVec(ref Str).new(); result.push(value); return result }\n", body, "\n"))
        for action : Str in array(Str, "interpret", "translate") {
            cmd := Cmd.new(compiler, action, format(root, "/invalid_borrow.til"))
            cmd.capture()
            status := cmd.run()
            output := format(cmd.out(), cmd.err())
            expect(status != 0, body, ": ", output)
            expect(output.contains("cannot store a borrow").or(output.contains("cannot return a borrow")).or(output.contains("still borrows its storage")), body, ": ", output)
        }
    }
    for declaration : Str in array(Str,
        "Bad := Vec(Contract)",
        "Bad := Array(Contract)",
        "Bad := Map(Str, Contract)",
        "Bad := MyAltVec(Contract)",
        "Bad := Option(MyAltVec(Contract))",
        "Alias := Contract\nBad := MyAltVec(Alias)",
        "priv Private := interface { value := func(self: Private) returns I64 }\nBad := MyAltVec(Private)",
        "Holder := struct<T: Type> { item: T }\nBad := Holder(Contract)",
        "Bad := Option(Contract)",
        "accept := proc(values: MyAltVec(Contract)) {}",
        "good := proc(values: MyAltVec(own Contract)) {}\nbad := proc(values: MyAltVec(Contract)) {}",
        "bad := proc(values: MyAltVec(Contract)) {}\ngood := proc(values: MyAltVec(own Contract)) {}",
        "Alias := Contract\naccept := proc(values: MyAltVec(Alias)) {}",
        "Good := Option(own Contract)\nBad := Option(Contract)",
        "Good := Option(own Contract)\naccept := proc() { mut bad := Option(Contract).None }") {
        File.writefile(format(root, "/interface_argument.til"), format(
            "mode cli\nimport(\"MyAltVec\")\n", contract, declaration,
            "\nmain := proc() {}\n"))
        for action : Str in array(Str, "interpret", "translate") {
            cmd := Cmd.new(compiler, action, format(root, "/interface_argument.til"))
            cmd.capture()
            status := cmd.run()
            output := format(cmd.out(), cmd.err())
            expect(status != 0, declaration, ": ", output)
            expect(output.contains("requires explicit own or ref"), declaration, ": ", output)
        }
    }
    for declaration : Str in array(Str,
        "Bad := MyAltVec(shallow Contract)",
        "accept := proc(values: MyAltVec(shallow Contract)) {}") {
        File.writefile(format(root, "/interface_argument.til"), format(
            "mode cli\nimport(\"MyAltVec\")\n", contract, declaration,
            "\nmain := proc() {}\n"))
        cmd := Cmd.new(compiler, "interpret", format(root, "/interface_argument.til"))
        cmd.capture()
        status := cmd.run()
        output := format(cmd.out(), cmd.err())
        expect(status != 0, declaration, ": ", output)
        expect(output.contains("error:"), declaration, ": ", output)
    }
    for qualifier : Str in array(Str, "own", "ref") {
        File.writefile(format(root, "/invalid_default.til"), format(
            "mode cli\nimport(\"MyAltVec\")\n",
            "Contract := interface { values := func(self: Contract) returns MyAltVec(", qualifier, " Contract) }\n",
            "Item := struct implements Contract { n := 1\nnamespace:\nvalues := func(_self: Item) returns MyAltVec(", qualifier, " Item) { return MyAltVec(", qualifier, " Item).new() } }\n",
            "main := proc() {}\n"))
        for action : Str in array(Str, "interpret", "translate") {
            cmd := Cmd.new(compiler, action, format(root, "/invalid_default.til"))
            cmd.capture()
            status := cmd.run()
            output := format(cmd.out(), cmd.err())
            expect(status != 0, output)
            expect(output.contains("does not match the signature"), output)
        }
    }
    for method : Str in array(Str, "required", "defaulted") {
        File.writefile(format(root, "/invalid_default.til"), format(
            "mode cli\nimport(\"MyAltVec\")\n",
            "Contract := interface { required := func(self: Contract) returns MyAltVec(ref Contract)\n",
            "defaulted := func(self: Contract) returns MyAltVec(ref Contract) { mut result := MyAltVec(ref Contract).new(); result.push(self); return result } }\n",
            "Item := struct implements Contract { n := 1\nnamespace:\nrequired := func(self: Item) returns MyAltVec(ref Contract) { mut result := MyAltVec(ref Contract).new(); result.push(self); return result } }\n",
            "bad := func() returns MyAltVec(ref Contract) { owner: Contract = Item(); return owner.", method, "() }\n",
            "main := proc() {}\n"))
        for action : Str in array(Str, "interpret", "translate") {
            cmd := Cmd.new(compiler, action, format(root, "/invalid_default.til"))
            cmd.capture()
            status := cmd.run()
            output := format(cmd.out(), cmd.err())
            expect(status != 0, output)
            expect(output.contains("cannot return a borrow of local 'owner'"), output)
        }
    }
    File.writefile(format(root, "/invalid_default.til"), format(
        "mode cli\nContract := interface { borrowed := func(self: Contract) returns Option(ref Contract) { return Option(ref Contract).Some(self) } }\n",
        "Item := struct implements Contract { n := 1 }\nmain := proc() {}\n"))
    for action : Str in array(Str, "interpret", "translate") {
        cmd := Cmd.new(compiler, action, format(root, "/invalid_default.til"))
        cmd.capture()
        status := cmd.run()
        output := format(cmd.out(), cmd.err())
        expect(status != 0, output)
        expect(output.contains("has a 'ref' payload"), output)
    }
    File.writefile(format(root, "/ufcs_api.til"), format(
        "mode lib\nRender := interface { draw := func(self: Render) returns Str }\n",
        "RenderValue := struct implements Render { text: Str\nnamespace:\ndraw := func(self: RenderValue) returns Str { return self.text.clone() } }\n",
        "render := func<T: Type implements Render>(value: T) returns Str { return value.draw() }\n",
        "runtime_type_label := func(value: Type) returns Str { return dyn_type_to_str(value) }\n",
        "render_kind := func<T: Type implements Render>(value: T, kind: Type) returns Str { return format(value.draw(), \"/\", dyn_type_to_str(kind)) }\n",
        "runtime_receiver := func<T: Type implements Render>(kind: Type, value: T) returns Str { return format(dyn_type_to_str(kind), \"/\", value.draw()) }\n"))
    for side : Str in array(Str, "left", "right") {
        File.writefile(format(root, "/ufcs_", side, ".til"), format(
            "mode lib\nimport(\"ufcs_api\")\n", side,
            " := func() returns Str { value := RenderValue(text = \"", side, "\"); return value.render() }\n"))
    }
    File.writefile(format(root, "/ufcs_imports.til"), format(
        "mode cli\nimport(\"ufcs_left\")\nimport(\"ufcs_right\")\nimport(\"ufcs_api\")\n",
        "main := proc() { value := RenderValue(text = \"main\"); kind := Type.Primitive(Primitive.I64);\n",
        "assert_eq(Str, kind.runtime_type_label(), \"I64\"); assert_eq(Str, value.render_kind(kind), \"main/I64\");\n",
        "assert_eq(Str, render_kind(RenderValue, value, kind), \"main/I64\"); assert_eq(Str, render_kind(RenderValue)(value, kind), \"main/I64\");\n",
        "assert_eq(Str, kind.runtime_receiver(value), \"I64/main\");\n",
        "println(left(), \":\", right(), \":\", value.render(), \":\", render(RenderValue)(value)) }\n"))
    check(Cmd.new(compiler, "interpret", format(root, "/ufcs_imports.til")), "left:right:main:main\n")
    check(Cmd.new(compiler, "run", "--asan", "-o", format(root, "/ufcs_imports"),
        "-c", format(root, "/ufcs_imports.c"), format(root, "/ufcs_imports.til")), "left:right:main:main\n")
    bound_prelude := format("mode cli\n",
        "Draw := interface { draw := func(self: Draw) returns Str }\n",
        "Extra := interface { extra := func(self: Extra) returns I64 }\n",
        "Good := struct implements Draw { n := 1\nnamespace:\ndraw := func(_self: Good) returns Str { return \"good\" } }\n")
    for call : Str in array(Str, "check(1)", "check(I64)(1)", "check(I64, 1)", "value.check()") {
        reject_generic(compiler, root, format(bound_prelude,
            "check := func<T: Type implements Draw>(_value: T) returns Bool { return true }\n",
            "main := proc() { value := 1; println(", call, ") }\n"), "does not implement 'Draw'")
    }
    reject_generic(compiler, root, format(bound_prelude,
        "check := func(T: Type implements Draw, _value: T) returns Bool { return true }\n",
        "main := proc() { value := 1; println(value.check()) }\n"), "does not implement 'Draw'")
    reject_generic(compiler, root, format(bound_prelude,
        "check := func<T implements Draw, Extra>(_value: T) returns Bool { return true }\n",
        "main := proc() { value := Good(); println(value.check()) }\n"), "does not implement 'Extra'")
    reject_generic(compiler, root, format(bound_prelude,
        "Box := struct<T: Type implements Draw> { value: T }\nBad := Box(I64)\nmain := proc() {}\n"), "does not implement 'Draw'")
    reject_generic(compiler, root, format(bound_prelude,
        "check := macro(T: Type implements Draw) returns FuncDef { return func(_value: T) returns Bool { return true } }\n",
        "main := proc() { println(check(I64)(1)) }\n"), "does not implement 'Draw'")
    reject_generic(compiler, root, format(bound_prelude,
        "check := func<T: Type implements I64>(_value: T) returns Bool { return true }\n",
        "main := proc() { value := Good(); println(value.check()) }\n"), "which is not an interface")
    reject_generic(compiler, root, format(bound_prelude,
        "action := proc<T: Type implements Draw>(_value: T) returns Bool { noop_proc(); return true }\n",
        "bad := func(value: Good) returns Bool { return value.action() }\nmain := proc() {}\n"), "func cannot call proc")
    reject_generic(compiler, root, format(bound_prelude,
        "runtime_type := func(value: Type) returns Str { return dyn_type_to_str(value) }\n",
        "main := proc() { value := Good(); println(value.runtime_type()) }\n"), "no method 'runtime_type'")
    reject_generic(compiler, root, format(bound_prelude,
        "bad := func<N: I64 implements Draw>() returns I64 { return N }\nmain := proc() {}\n"), "interface bounds require a Type parameter")
    mut many_args := ""
    for _ in 0..62 { many_args = format(many_args, "\"x\", ") }
    reject_generic(compiler, root, format(bound_prelude,
        "many := func<T: Type implements Draw>(value: T, parts: ..Str) returns Str { return format(value.draw(), ..parts) }\n",
        "main := proc() { value := Good(); parts := array(Str, \"end\"); println(value.many(", many_args, "..parts)) }\n"),
        "UFCS receiver insertion would overflow the argument qualifier bitmap")
    println("type argument qualifiers passed")
}
