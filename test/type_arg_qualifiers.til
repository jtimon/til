mode cli

import("../src/std/sys")
import("../src/std/file")

check := proc(cmd: Cmd, expected: Str) {
    cmd.capture()
    status := cmd.run()
    output := format(cmd.out(), cmd.err())
    if status != 0 { panic(cmd.render(), ": ", output) }
    assert_eq(Str, output, expected)
}

reject := proc(cmd: Cmd, expects_arity: Bool = true) {
    cmd.capture()
    status := cmd.run()
    output := format(cmd.out(), cmd.err())
    if status == 0 { panic("accepted invalid qualifier query: ", cmd.render()) }
    expect(output.contains("type_arg_is_ref requires a compile-time type argument"), output)
    if expects_arity { expect(output.contains("type_arg_is_ref expects one compile-time type argument"), output) }
}

main := proc(args: ..Str) {
    ref compiler: Str = args[0]
    root := "tmp/type_arg_qualifiers"
    mkdir_p(root)
    // Exercise the real macro source under an unrelated name and file path.
    // The injected method only exposes the qualifier query for assertions;
    // it makes no claim that Vec's borrowed-element operations are complete.
    source := File.readfile("src/core/vec.til")
    renamed := source.replace("Vec", "MyAltVec").replace("vec", "my_alt_vec")
        .replace("import(\"", "import(\"core/")
        .replace("namespace:", "namespace:\n    query_ref := func() returns Bool { return type_arg_is_ref(T) }\n")
    File.writefile(format(root, "/MyAltVec.til"), renamed)
    File.writefile(format(root, "/probe.til"), format(
        "mode cli\nimport(\"MyAltVec\")\n",
        "Contract := interface { value := func(self: Contract) returns I64 }\n",
        "Record := struct implements Contract { n := 11\nnamespace:\nvalue := func(self: Record) returns I64 { return self.n } }\n",
        "Choice := enum implements Contract { One\nnamespace:\nvalue := func(self: Choice) returns I64 { switch self { case .One: return 1 } } }\n",
        "ContractAlias := Contract\n",
        "interface_query := macro(T: Type) returns FuncDef {\n",
        "    if type_arg_is_interface(T) { return func() returns Bool { return true } }\n",
        "    else { return func() returns Bool { return false } }\n}\n",
        "query_interface := interface_query(ref ContractAlias)\n",
        "query_record := interface_query(Record)\n",
        "query_choice := interface_query(Choice)\n",
        "InterfaceProbe := macro(T: Type) returns StructDef {\n",
        "    if type_arg_is_interface(T).and(type_arg_is_ref(T)) { return struct { borrowed_interface := true } }\n",
        "    else { return struct { borrowed_interface := false } }\n}\n",
        "InterfaceForward := macro(T: Type) returns StructDef { return struct { probe := InterfaceProbe(T)() } }\n",
        "empty_borrow := func(value: Option(ref Contract)) returns Bool { return value.is_none() }\n",
        "Probe := macro(Element: Type) returns StructDef {\n",
        "    if type_arg_is_ref(Element) { return struct { borrowed := true } }\n",
        "    else { return struct { borrowed := false } }\n}\n",
        "OtherProbe := macro(Item: Type) returns StructDef {\n",
        "    if type_arg_is_ref(Item).not() { return struct { borrowed := false } }\n",
        "    else { return struct { borrowed := true } }\n}\n",
        "Forward := macro(Value: Type) returns StructDef { return struct { probe := Probe(Value)() } }\n",
        "make_query := macro(Value: Type) returns FuncDef { return func() returns Bool { return type_arg_is_ref(Value) } }\n",
        "borrowed_query := make_query(ref Str)\n",
        "owned_query := make_query(Str)\n",
        "Alias := Str\n",
        "StringVec := Vec(Str)\n",
        "borrow_one := func(value: Str) returns MyAltVec(ref Str) { mut result := MyAltVec(ref Str).new(); result.push(value); return result }\n",
        "priv member_factory := macro(Element: Type) returns FuncDef { return func() returns USize { return Element.size() } }\n",
        "MemberProbe := macro(Element: Type) returns StructDef { return struct { namespace:\nwidth := member_factory(Element)\n} }\n",
        "main := proc() {\n",
        "    nested_query := Probe(Vec(Str))()\n",
        "    assert(nested_query.borrowed.not())\n",
        "    nested_ref_query := Probe(ref Vec(Str))()\n",
        "    assert(nested_ref_query.borrowed)\n",
        "    assert_eq(USize, MemberProbe(I64).width(), I64.size())\n",
        "    assert(type_arg_is_ref(ref Str))\n",
        "    assert(type_arg_is_interface(Contract))\n",
        "    assert(type_arg_is_interface(own ContractAlias))\n",
        "    assert(type_arg_is_interface(ref Contract))\n",
        "    assert(type_arg_is_interface(Record).not())\n",
        "    assert(type_arg_is_interface(Choice).not())\n",
        "    assert(type_arg_is_interface(I64).not())\n",
        "    assert(type_arg_is_interface(StructDef).not())\n",
        "    assert(type_arg_is_interface(EnumDef).not())\n",
        "    assert(type_arg_is_interface(Option(ref Contract)).not())\n",
        "    assert(query_interface())\n",
        "    assert(query_record().not())\n",
        "    assert(query_choice().not())\n",
        "    interface_forward := InterfaceForward(ref ContractAlias)()\n",
        "    assert(interface_forward.probe.borrowed_interface)\n",
        "    assert(type_arg_is_ref(Str).not())\n",
        "    assert(type_arg_is_ref(own Str).not())\n",
        "    assert(type_arg_is_ref(Option(ref Str)).not())\n",
        "    borrowed := Probe(ref Alias)()\n",
        "    owned := Probe(Alias)()\n",
        "    other_borrowed := OtherProbe(ref I64)()\n",
        "    other_owned := OtherProbe(I64)()\n",
        "    forwarded_borrowed := Forward(ref Str)()\n",
        "    forwarded_owned := Forward(Str)()\n",
        "    assert(borrowed.borrowed)\n",
        "    assert(owned.borrowed.not())\n",
        "    assert(other_borrowed.borrowed)\n",
        "    assert(other_owned.borrowed.not())\n",
        "    assert(forwarded_borrowed.probe.borrowed)\n",
        "    assert(forwarded_owned.probe.borrowed.not())\n",
        "    assert(borrowed_query())\n",
        "    assert(owned_query().not())\n",
        "    assert(MyAltVec(own I64).query_ref().not())\n",
        "    assert(MyAltVec(I64).query_ref().not())\n",
        "    mut values := MyAltVec(I64).new()\n",
        "    values.push(own 7)\n",
        "    assert_eq(I64, values[0], 7)\n",
        "    mut contracts: MyAltVec(own Contract) = MyAltVec(own Contract).new()\n",
        "    contracts.push(own Record())\n",
        "    assert_eq(I64, contracts[0].value(), 11)\n",
        "    assert(empty_borrow(Option(ref Contract).None))\n",
        "    mut text := format(\"borrowed \", \"text\")\n",
        "    other := format(\"other \", \"text\")\n",
        "    mut texts := MyAltVec(ref Str).with_capacity(2)\n",
        "    texts.push(text)\ntexts.push(other)\n",
        "    text = format(\"changed \", \"text\")\n",
        "    assert_eq(Str, texts[0], \"changed text\")\n",
        "    mut copied_texts := texts.clone()\n",
        "    texts.set(0, other)!\ntexts.unsafe_set(1, text)\n",
        "    ref popped_text: Str = texts.pop()\n",
        "    assert_eq(Str, popped_text, \"changed text\")\n",
        "    texts.remove_at(0)!\nassert_eq(USize, texts.len(), 0)\n",
        "    assert_eq(Str, copied_texts[0], \"changed text\")\n",
        "    prefix := copied_texts.take_prefix(1)\ntexts.append(own prefix)\n",
        "    assert_eq(Str, texts[0], \"changed text\")\n",
        "    texts.push_take(copied_texts, 0)\ncopied_texts.clear()\n",
        "    assert_eq(Str, texts[1], \"other text\")\n",
        "    masks := array(Bool, true, false)\ntexts.delete_marked(masks.data)\n",
        "    assert_eq(USize, texts.len(), 1)\nassert_eq(Str, texts[0], \"other text\")\n",
        "    moved := texts.take()\nassert_eq(USize, texts.len(), 0)\ntexts.move_from(own moved)\n",
        "    texts.truncate(0)\ntexts.push(text)\n",
        "    lent := borrow_one(other)\nassert_eq(Str, lent[0], \"other text\")\n",
        "    mut number: I64 = 12\n",
        "    mut numbers := MyAltVec(ref I64).new()\n",
        "    numbers.push(number)\nnumber = 19\nassert_eq(I64, numbers[0], 19)\n",
        "    mut record := Record()\nchoice := Choice.One\n",
        "    mut records := MyAltVec(ref Record).new()\nrecords.push(record)\n",
        "    mut choices := MyAltVec(ref Choice).new()\nchoices.push(choice)\n",
        "    mut views := MyAltVec(ref Contract).new()\nviews.push(record)\nviews.push(choice)\n",
        "    record.n = 21\nassert_eq(I64, records[0].value(), 21)\nassert_eq(I64, choices[0].value(), 1)\n",
        "    assert_eq(I64, views[0].value(), 21)\nassert_eq(I64, views[1].value(), 1)\n",
        "    mut sum := 0\nfor view in views { sum = sum + view.value() }\nassert_eq(I64, sum, 22)\n",
        "    copied_views := views.clone()\n",
        "    views.set(0, choice)!\nviews.unsafe_set(1, record)\n",
        "    ref popped_view: Contract = views.pop()\nassert_eq(I64, popped_view.value(), 21)\n",
        "    views.clear()\nassert_eq(I64, copied_views[0].value(), 21)\nassert_eq(I64, copied_views[1].value(), 1)\n",
        "    mut self_take := MyAltVec(ref Contract).with_capacity(1)\nself_take.push(record)\nself_take.push_take(self_take, 0)\nassert_eq(I64, self_take[1].value(), 21)\n",
        "    mut strings := Vec(Str).new()\nstrings.push(own format(\"nested\"))\n",
        "    mut nested_refs := MyAltVec(ref StringVec).new()\nnested_refs.push(strings)\nassert_eq(USize, nested_refs[0].len(), 1)\n",
        "    mut disposable := MyAltVec(ref Str).new()\ndisposable.push(text)\nsurviving_copy := disposable.clone()\nown disposable.delete()\nassert_eq(Str, surviving_copy[0], \"changed text\")\n",
        "    factory_refs := borrow_one(text)\ntext = format(\"after clone\")\nassert_eq(Str, factory_refs[0], \"after clone\")\nassert_eq(Str, surviving_copy[0], \"after clone\")\n",
        "    println(\"qualifiers OK\")\n}\n"))
    check(Cmd.new(compiler, "interpret", format(root, "/probe.til")), "qualifiers OK\n")
    check(Cmd.new(compiler, "run", "--asan", "-o", format(root, "/probe"),
        "-c", format(root, "/probe.c"), format(root, "/probe.til")), "qualifiers OK\n")
    File.writefile(format(root, "/invalid.til"), format(
        "mode cli\nbad := func(value: Type) returns Bool { return type_arg_is_ref(value) }\n",
        "main := proc() { println(type_arg_is_ref(1)); println(type_arg_is_ref()) }\n"))
    reject(Cmd.new(compiler, "interpret", format(root, "/invalid.til")))
    reject(Cmd.new(compiler, "build", "-o", format(root, "/invalid"),
        "-c", format(root, "/invalid.c"), format(root, "/invalid.til")))
    File.writefile(format(root, "/invalid_generator.til"), format(
        "mode cli\nBad := macro(N: I64) returns StructDef {\n",
        "    if type_arg_is_ref(N) { return struct { value := true } }\n",
        "    else { return struct { value := false } }\n}\n",
        "BadValue := Bad(3)\nmain := proc() { println(\"invalid generator\") }\n"))
    reject(Cmd.new(compiler, "interpret", format(root, "/invalid_generator.til")), false)
    reject(Cmd.new(compiler, "build", "-o", format(root, "/invalid_generator"),
        "-c", format(root, "/invalid_generator.c"), format(root, "/invalid_generator.til")), false)
    for body : Str in array(Str,
        "bad := func(value: Type) returns Bool { return type_arg_is_interface(value) }\nmain := proc() {}",
        "main := proc() { println(type_arg_is_interface(1)) }",
        "main := proc() { println(type_arg_is_interface()) }",
        "main := proc() { println(type_arg_is_interface(I64, Str)) }") {
        File.writefile(format(root, "/invalid_interface_query.til"), format("mode cli\n", body, "\n"))
        for action : Str in array(Str, "interpret", "translate") {
            cmd := Cmd.new(compiler, action, format(root, "/invalid_interface_query.til"))
            cmd.capture()
            status := cmd.run()
            output := format(cmd.out(), cmd.err())
            expect(status != 0, body, ": ", output)
            expect(output.contains("error: type_arg_is_interface"), body, ": ", output)
        }
    }
    contract := "Contract := interface { value := func(self: Contract) returns I64 }\n"
    for body : Str in array(Str,
        "bad := func() returns MyAltVec(ref Str) { text := format(\"local\"); mut v := MyAltVec(ref Str).new(); v.push(text); return v }\nmain := proc() {}",
        "bad := func() returns MyAltVec(ref Str) { text := format(\"local\"); mut v := MyAltVec(ref Str).new(); v.push(text); return v.clone() }\nmain := proc() {}",
        "main := proc() { mut v := MyAltVec(ref Str).new(); if true { text := format(\"local\"); v.push(text) } }",
        "bad := proc(mut v: MyAltVec(ref Str)) { text := format(\"local\"); v.push(text) }\nmain := proc() {}",
        "main := proc() { mut v := MyAltVec(ref Str).new(); if true { ref mut alias: MyAltVec(ref Str) = v; text := format(\"local\"); alias.push(text) } }",
        "Holder := struct { refs := MyAltVec(ref Str).new() }\nmain := proc() { mut holder := Holder(); if true { text := format(\"local\"); holder.refs.push(text) } }",
        "main := proc() { mut v := MyAltVec(ref Str).new(); v.push(format(\"temporary\")) }",
        "main := proc() { mut v := MyAltVec(ref I64).new(); v.push(7) }",
        "bad := func() returns MyAltVec(ref I64) { mut raw: I64 = malloc(I64.size().to_uptr()); raw = 5; mut v := MyAltVec(ref I64).new(); v.push(raw); return v }\nmain := proc() {}",
        "bad := func() returns MyAltVec(ref Contract) { record := Record(); mut v := MyAltVec(ref Contract).new(); v.push(record); return v.clone() }\nmain := proc() {}",
        "main := proc() { mut v := MyAltVec(ref Contract).new(); if true { record := Record(); v.push(record) } }",
        "main := proc() { mut v := MyAltVec(ref Contract).new(); v.push(Record()) }",
        "bad := func() returns MyAltVec(ref Str) { return borrow_one(format(\"temporary\")) }\nmain := proc() {}",
        "main := proc() { mut owner: Contract = Record(); mut v := MyAltVec(ref Contract).new(); v.push(owner); copy := v.clone(); own v.delete(); owner = Record(n = 8); println(copy[0].value()) }",
        "Opt := Option(ref Str)\nbad := func(text: Str) returns MyAltVec(ref Opt) { item := Opt.Some(text); mut v := MyAltVec(ref Opt).new(); v.push(item); return v }\nmain := proc() {}") {
        File.writefile(format(root, "/invalid_borrow.til"), format("mode cli\nimport(\"MyAltVec\")\n", contract,
            "Record := struct implements Contract { n := 3\nnamespace:\nvalue := func(self: Record) returns I64 { return self.n } }\n",
            "borrow_one := func(value: Str) returns MyAltVec(ref Str) { mut result := MyAltVec(ref Str).new(); result.push(value); return result }\n", body, "\n"))
        for action : Str in array(Str, "interpret", "translate") {
            cmd := Cmd.new(compiler, action, format(root, "/invalid_borrow.til"))
            cmd.capture()
            status := cmd.run()
            output := format(cmd.out(), cmd.err())
            expect(status != 0, body, ": ", output)
            expect(output.contains("cannot store a borrow").or(output.contains("cannot return a borrow")).or(output.contains("still borrows its storage")), body, ": ", output)
        }
    }
    for declaration : Str in array(Str,
        "Bad := Vec(Contract)",
        "Bad := Array(Contract)",
        "Bad := Map(Str, Contract)",
        "Bad := MyAltVec(Contract)",
        "Bad := Option(MyAltVec(Contract))",
        "Alias := Contract\nBad := MyAltVec(Alias)",
        "priv Private := interface { value := func(self: Private) returns I64 }\nBad := MyAltVec(Private)",
        "Holder := struct<T: Type> { item: T }\nBad := Holder(Contract)",
        "Bad := Option(Contract)",
        "accept := proc(values: MyAltVec(Contract)) {}",
        "good := proc(values: MyAltVec(own Contract)) {}\nbad := proc(values: MyAltVec(Contract)) {}",
        "bad := proc(values: MyAltVec(Contract)) {}\ngood := proc(values: MyAltVec(own Contract)) {}",
        "Alias := Contract\naccept := proc(values: MyAltVec(Alias)) {}",
        "Good := Option(own Contract)\nBad := Option(Contract)",
        "Good := Option(own Contract)\naccept := proc() { mut bad := Option(Contract).None }") {
        File.writefile(format(root, "/interface_argument.til"), format(
            "mode cli\nimport(\"MyAltVec\")\n", contract, declaration,
            "\nmain := proc() {}\n"))
        for action : Str in array(Str, "interpret", "translate") {
            cmd := Cmd.new(compiler, action, format(root, "/interface_argument.til"))
            cmd.capture()
            status := cmd.run()
            output := format(cmd.out(), cmd.err())
            expect(status != 0, declaration, ": ", output)
            expect(output.contains("requires explicit own or ref"), declaration, ": ", output)
        }
    }
    for declaration : Str in array(Str,
        "Bad := MyAltVec(shallow Contract)",
        "accept := proc(values: MyAltVec(shallow Contract)) {}") {
        File.writefile(format(root, "/interface_argument.til"), format(
            "mode cli\nimport(\"MyAltVec\")\n", contract, declaration,
            "\nmain := proc() {}\n"))
        cmd := Cmd.new(compiler, "interpret", format(root, "/interface_argument.til"))
        cmd.capture()
        status := cmd.run()
        output := format(cmd.out(), cmd.err())
        expect(status != 0, declaration, ": ", output)
        expect(output.contains("error:"), declaration, ": ", output)
    }
    println("type argument qualifiers passed")
}
