mode cli

import("../src/std/sys")
import("../src/std/file")

check := proc(cmd: Cmd, expected: Str) {
    cmd.capture()
    status := cmd.run()
    output := format(cmd.out(), cmd.err())
    if status != 0 { panic(cmd.render(), ": ", output) }
    assert_eq(Str, output, expected)
}

check_run := proc(compiler: Str, root: Str, name: Str, expected: Str, asan: Bool) {
    cmd := Cmd.new(compiler, "run")
    if asan { cmd.arg("--asan") }
    cmd.args("-o", format(root, "/", name), "-c", format(root, "/", name, ".c"), format(root, "/", name, ".til"))
    check(cmd, expected)
}

reject := proc(cmd: Cmd, expects_arity: Bool = true) {
    cmd.capture()
    status := cmd.run()
    output := format(cmd.out(), cmd.err())
    if status == 0 { panic("accepted invalid qualifier query: ", cmd.render()) }
    expect(output.contains("type_arg_is_ref requires a compile-time type argument"), output)
    if expects_arity { expect(output.contains("type_arg_is_ref expects one compile-time type argument"), output) }
}

reject_generic := proc(compiler: Str, root: Str, source: Str, expected: Str) {
    path := format(root, "/invalid_generic.til")
    File.writefile(path, source)
    for action : Str in array(Str, "interpret", "translate") {
        cmd := Cmd.new(compiler, action, path)
        cmd.capture()
        status := cmd.run()
        output := format(cmd.out(), cmd.err())
        expect(status != 0, source, ": ", output)
        expect(output.contains(expected), source, ": ", output)
    }
}

prepare_templates := proc(root: Str) {
    // Exercise the real macro source under an unrelated name and file path.
    // The injected method only exposes the qualifier query for assertions;
    // it makes no claim that Vec's borrowed-element operations are complete.
    source := File.readfile("src/core/vec.til")
    renamed := source.replace("Vec", "MyAltVec").replace("vec", "my_alt_vec")
        .replace("import(\"", "import(\"core/")
        .replace("namespace:", "namespace:\n    query_ref := func() returns Bool { return type_arg_is_ref(T) }\n")
    File.writefile(format(root, "/MyAltVec.til"), renamed)
    array_source := File.readfile("src/core/array.til")
        .replace("Array", "MyAltArray").replace("array", "my_alt_array")
        .replace("Vec", "MyAltVec")
        .replace("import(\"", "import(\"core/")
        .replace("import(\"core/vec\")", "import(\"MyAltVec\")")
    File.writefile(format(root, "/MyAltArray.til"), array_source)
    map_source := File.readfile("src/core/map.til")
        .replace("Map", "MyAltMap").replace("map_", "my_alt_map_")
        .replace("Vec", "MyAltVec").replace("import(\"", "import(\"core/")
        .replace("mode lib", "mode lib\nimport(\"MyAltVec\")")
    File.writefile(format(root, "/MyAltMap.til"), map_source)
    set_source := File.readfile("src/core/set.til")
        .replace("Set", "MyAltSet").replace("set_ref_store", "my_alt_set_ref_store")
        .replace("import(\"", "import(\"core/")
    File.writefile(format(root, "/MyAltSet.til"), set_source)
}

query_checks := proc(compiler: Str, root: Str, asan: Bool) {
    File.writefile(format(root, "/probe.til"), format(
        "mode cli\nimport(\"MyAltVec\")\n",
        "Contract := interface { value := func(self: Contract) returns I64\n",
        "borrowed_values := func(self: Contract) returns MyAltVec(ref Contract) { mut result := MyAltVec(ref Contract).new(); result.push(self); return result }\n",
        "owned_values := func(self: Contract) returns MyAltVec(own Contract) { mut result := MyAltVec(own Contract).new(); result.push(own self.clone()); return result }\n}\n",
        "Record := struct implements Contract { n := 11\nnamespace:\nvalue := func(self: Record) returns I64 { return self.n } }\n",
        "Choice := enum implements Contract { One\nnamespace:\nvalue := func(self: Choice) returns I64 { switch self { case .One: return 1 } } }\n",
        "ContractAlias := Contract\n",
        "interface_query := macro(T: Type) returns FuncDef {\n",
        "    if type_arg_is_interface(T) { return func() returns Bool { return true } }\n",
        "    else { return func() returns Bool { return false } }\n}\n",
        "query_interface := interface_query(ref ContractAlias)\n",
        "query_record := interface_query(Record)\n",
        "query_choice := interface_query(Choice)\n",
        "InterfaceProbe := macro(T: Type) returns StructDef {\n",
        "    if type_arg_is_interface(T).and(type_arg_is_ref(T)) { return struct { borrowed_interface := true } }\n",
        "    else { return struct { borrowed_interface := false } }\n}\n",
        "InterfaceForward := macro(T: Type) returns StructDef { return struct { probe := InterfaceProbe(T)() } }\n",
        "empty_borrow := func(value: Option(ref Contract)) returns Bool { return value.is_none() }\n",
        "Probe := macro(Element: Type) returns StructDef {\n",
        "    if type_arg_is_ref(Element) { return struct { borrowed := true } }\n",
        "    else { return struct { borrowed := false } }\n}\n",
        "OtherProbe := macro(Item: Type) returns StructDef {\n",
        "    if type_arg_is_ref(Item).not() { return struct { borrowed := false } }\n",
        "    else { return struct { borrowed := true } }\n}\n",
        "Forward := macro(Value: Type) returns StructDef { return struct { probe := Probe(Value)() } }\n",
        "make_query := macro(Value: Type) returns FuncDef { return func() returns Bool { return type_arg_is_ref(Value) } }\n",
        "borrowed_query := make_query(ref Str)\n",
        "owned_query := make_query(Str)\n",
        "Alias := Str\n",
        "StringVec := Vec(Str)\n",
        "borrow_one := func(value: Str) returns MyAltVec(ref Str) { mut result := MyAltVec(ref Str).new(); result.push(value); return result }\n",
        "priv member_factory := macro(Element: Type) returns FuncDef { return func() returns USize { return Element.size() } }\n",
        "MemberProbe := macro(Element: Type) returns StructDef { return struct { namespace:\nwidth := member_factory(Element)\n} }\n",
        "main := proc() {\n",
        "    nested_query := Probe(Vec(Str))()\n",
        "    assert(nested_query.borrowed.not())\n",
        "    nested_ref_query := Probe(ref Vec(Str))()\n",
        "    assert(nested_ref_query.borrowed)\n",
        "    assert_eq(USize, MemberProbe(I64).width(), I64.size())\n",
        "    assert(type_arg_is_ref(ref Str))\n",
        "    assert(type_arg_is_interface(Contract))\n",
        "    assert(type_arg_is_interface(own ContractAlias))\n",
        "    assert(type_arg_is_interface(ref Contract))\n",
        "    assert(type_arg_is_interface(Record).not())\n",
        "    assert(type_arg_is_interface(Choice).not())\n",
        "    assert(type_arg_is_interface(I64).not())\n",
        "    assert(type_arg_is_interface(StructDef).not())\n",
        "    assert(type_arg_is_interface(EnumDef).not())\n",
        "    assert(type_arg_is_interface(Option(ref Contract)).not())\n",
        "    assert(query_interface())\n",
        "    assert(query_record().not())\n",
        "    assert(query_choice().not())\n",
        "    interface_forward := InterfaceForward(ref ContractAlias)()\n",
        "    assert(interface_forward.probe.borrowed_interface)\n",
        "    assert(type_arg_is_ref(Str).not())\n",
        "    assert(type_arg_is_ref(own Str).not())\n",
        "    assert(type_arg_is_ref(Option(ref Str)).not())\n",
        "    borrowed := Probe(ref Alias)()\n",
        "    owned := Probe(Alias)()\n",
        "    other_borrowed := OtherProbe(ref I64)()\n",
        "    other_owned := OtherProbe(I64)()\n",
        "    forwarded_borrowed := Forward(ref Str)()\n",
        "    forwarded_owned := Forward(Str)()\n",
        "    assert(borrowed.borrowed)\n",
        "    assert(owned.borrowed.not())\n",
        "    assert(other_borrowed.borrowed)\n",
        "    assert(other_owned.borrowed.not())\n",
        "    assert(forwarded_borrowed.probe.borrowed)\n",
        "    assert(forwarded_owned.probe.borrowed.not())\n",
        "    assert(borrowed_query())\n",
        "    assert(owned_query().not())\n",
        "    assert(MyAltVec(own I64).query_ref().not())\n",
        "    assert(MyAltVec(I64).query_ref().not())\n",
        "    mut values := MyAltVec(I64).new()\n",
        "    values.push(own 7)\n",
        "    assert_eq(I64, values[0], 7)\n",
        "    mut contracts: MyAltVec(own Contract) = MyAltVec(own Contract).new()\n",
        "    contracts.push(own Record())\n",
        "    assert_eq(I64, contracts[0].value(), 11)\n",
        "    assert(empty_borrow(Option(ref Contract).None))\n",
        "    mut text := format(\"borrowed \", \"text\")\n",
        "    other := format(\"other \", \"text\")\n",
        "    mut texts := MyAltVec(ref Str).with_capacity(2)\n",
        "    texts.push(text)\ntexts.push(other)\n",
        "    text = format(\"changed \", \"text\")\n",
        "    assert_eq(Str, texts[0], \"changed text\")\n",
        "    mut copied_texts := texts.clone()\n",
        "    texts.set(0, other)!\ntexts.unsafe_set(1, text)\n",
        "    ref popped_text: Str = texts.pop()\n",
        "    assert_eq(Str, popped_text, \"changed text\")\n",
        "    texts.remove_at(0)!\nassert_eq(USize, texts.len(), 0)\n",
        "    assert_eq(Str, copied_texts[0], \"changed text\")\n",
        "    prefix := copied_texts.take_prefix(1)\ntexts.append(own prefix)\n",
        "    assert_eq(Str, texts[0], \"changed text\")\n",
        "    texts.push_take(copied_texts, 0)\ncopied_texts.clear()\n",
        "    assert_eq(Str, texts[1], \"other text\")\n",
        "    masks := array(Bool, true, false)\ntexts.delete_marked(masks.data)\n",
        "    assert_eq(USize, texts.len(), 1)\nassert_eq(Str, texts[0], \"other text\")\n",
        "    moved := texts.take()\nassert_eq(USize, texts.len(), 0)\ntexts.move_from(own moved)\n",
        "    texts.truncate(0)\ntexts.push(text)\n",
        "    lent := borrow_one(other)\nassert_eq(Str, lent[0], \"other text\")\n",
        "    mut number: I64 = 12\n",
        "    mut numbers := MyAltVec(ref I64).new()\n",
        "    numbers.push(number)\nnumber = 19\nassert_eq(I64, numbers[0], 19)\n",
        "    mut record := Record()\nchoice := Choice.One\n",
        "    mut records := MyAltVec(ref Record).new()\nrecords.push(record)\n",
        "    mut choices := MyAltVec(ref Choice).new()\nchoices.push(choice)\n",
        "    mut views := MyAltVec(ref Contract).new()\nviews.push(record)\nviews.push(choice)\n",
        "    record.n = 21\nassert_eq(I64, records[0].value(), 21)\nassert_eq(I64, choices[0].value(), 1)\n",
        "    assert_eq(I64, views[0].value(), 21)\nassert_eq(I64, views[1].value(), 1)\n",
        "    mut sum := 0\nfor view in views { sum = sum + view.value() }\nassert_eq(I64, sum, 22)\n",
        "    copied_views := views.clone()\n",
        "    views.set(0, choice)!\nviews.unsafe_set(1, record)\n",
        "    ref popped_view: Contract = views.pop()\nassert_eq(I64, popped_view.value(), 21)\n",
        "    views.clear()\nassert_eq(I64, copied_views[0].value(), 21)\nassert_eq(I64, copied_views[1].value(), 1)\n",
        "    mut self_take := MyAltVec(ref Contract).with_capacity(1)\nself_take.push(record)\nself_take.push_take(self_take, 0)\nassert_eq(I64, self_take[1].value(), 21)\n",
        "    mut strings := Vec(Str).new()\nstrings.push(own format(\"nested\"))\n",
        "    mut nested_refs := MyAltVec(ref StringVec).new()\nnested_refs.push(strings)\nassert_eq(USize, nested_refs[0].len(), 1)\n",
        "    mut disposable := MyAltVec(ref Str).new()\ndisposable.push(text)\nsurviving_copy := disposable.clone()\nown disposable.delete()\nassert_eq(Str, surviving_copy[0], \"changed text\")\n",
        "    factory_refs := borrow_one(text)\ntext = format(\"after clone\")\nassert_eq(Str, factory_refs[0], \"after clone\")\nassert_eq(Str, surviving_copy[0], \"after clone\")\n",
        "    handle: Contract = Record(n = 51)\nhandle_refs: MyAltVec(ref Contract) = handle.borrowed_values()\nmut handle_copies: MyAltVec(own Contract) = handle.owned_values()\nhandle_copies.push(own Choice.One)\nassert_eq(I64, handle_refs[0].value(), 51)\nassert_eq(I64, handle_copies[1].value(), 1)\n",
        "    println(\"qualifiers OK\")\n}\n"))
    check(Cmd.new(compiler, "interpret", format(root, "/probe.til")), "qualifiers OK\n")
    check_run(compiler, root, "probe", "qualifiers OK\n", asan)
}

family_type_source := func() returns Str {
    return format(
        "Ordered := interface { value := func(self: Ordered) returns I64\ncmp := func(self: Ordered, other: Ordered) returns I64 }\n",
        "Item := struct implements Ordered { n: I64\nnamespace:\n",
        "value := func(self: Item) returns I64 { return self.n }\n",
        "cmp := func(self: Item, other: Item) returns I64 { return I64.cmp(self.n, other.n) } }\n",
        "Entry := enum implements Ordered { Number: I64\nnamespace:\n",
        "value := func(self: Entry) returns I64 { switch self { case .Number(n): return n } }\n",
        "cmp := func(self: Entry, other: Entry) returns I64 { return I64.cmp(self.value(), other.value()) } }\n",
        "RefKey := struct implements Ordered { ref label: Str\nnamespace:\nvalue := func(self: RefKey) returns I64 { return self.label.len().to_i64() }\ncmp := func(self: RefKey, other: RefKey) returns I64 { return Str.cmp(self.label, other.label) } }\n")
}

container_checks := proc(compiler: Str, root: Str, asan: Bool) {
    family_imports := "import(\"MyAltArray\")\nimport(\"MyAltMap\")\nimport(\"MyAltSet\")\n"
    family_types := family_type_source()
    File.writefile(format(root, "/families.til"), format("mode cli\n", family_imports, family_types,
        "concat_local := func(left: MyAltArray(ref Str)) returns USize { local := format(\"local\"); mut right := MyAltArray(ref Str).new(1); right.set(0, local)!; joined := left.concat(right); return joined[left.len()].len() }\n",
        "check_concat := proc(prefix: Str) { noop_proc(); first := prefix.clone(); second := format(prefix, \"second\"); mut left := MyAltArray(ref Str).new(1); mut right := MyAltArray(ref Str).new(1); left.set(0, first)!; right.set(0, second)!; joined := left.concat(right); own left.delete(); own right.delete(); assert_eq(Str, joined[0], prefix); assert_eq(Str, joined[1], format(prefix, \"second\")) }\n",
        "main := proc() {\n",
        "check_concat(\"owner\")\n",
        "mut a := format(\"alpha\")\nb := format(\"beta\")\nc := format(\"charlie\")\n",
        "mut arr := MyAltArray(ref Str).new(2)\narr.set(0, a)!\narr.unsafe_set(1, b)\n",
        "arr_copy := arr.clone()\njoined := arr.concat(arr_copy)\nvector := arr.to_vec()\nown arr.delete()\n",
        "a = format(\"ALPHA\")\nassert_eq(Str, arr_copy[0], a)\nassert_eq(Str, joined[2], a)\nassert_eq(Str, vector[0], a)\n",
        "assert_eq(USize, concat_local(arr_copy), 5)\n",
        "mut nums := MyAltArray(ref I64).new(1)\nmut number := 1\nnums.set(0, number)!\nnumber = 9\nassert_eq(I64, nums[0], 9)\n",
        "mut set := MyAltSet(ref Str).with_capacity(1)\nset.add(c)\nset.add(a)\nset.add(b)\nset.add(b)\nassert_eq(USize, set.len(), 3)\n",
        "assert(set.has(b))\nassert(set.remove(b))\nassert(set.remove(b).not())\nset_copy := set.clone()\nown set.delete()\n",
        "mut joined_keys := format(\"\")\nfor key in set_copy { joined_keys = format(joined_keys, key) }\nassert_eq(Str, joined_keys, \"ALPHAcharlie\")\n",
        "mut borrowed_values := MyAltMap(Str, ref Str).new()\nborrowed_values.set(\"z\", a)\nborrowed_values.set(\"a\", b)\nborrowed_values.set(\"m\", c)\n",
        "borrowed_values.set(\"z\", b)\nassert_eq(Str, borrowed_values[\"z\"], b)\nassert(borrowed_values.remove(\"m\"))\nassert(borrowed_values.remove(\"missing\").not())\n",
        "values_copy := borrowed_values.clone()\nown borrowed_values.delete()\nassert_eq(Str, values_copy[\"a\"], b)\n",
        "mut pairs := format(\"\")\nfor key, value in values_copy { pairs = format(pairs, key, value) }\nassert_eq(Str, pairs, \"abetazbeta\")\n",
        "mut borrowed_keys := MyAltMap(ref Str, Str).new()\nborrowed_keys.set(c, own format(\"third\"))\nborrowed_keys.set(a, own format(\"first\"))\nborrowed_keys.set(b, own format(\"second\"))\n",
        "borrowed_keys.set(b, own format(\"replacement\"))\nkeys_copy := borrowed_keys.clone()\nborrowed_keys.clear()\nassert_eq(Str, keys_copy[b], \"replacement\")\n",
        "mut both := MyAltMap(ref Str, ref Str).new()\nboth.set(c, a)\nboth.set(a, b)\nboth.set(b, c)\nboth_copy := both.clone()\nown both.delete()\nassert_eq(Str, both_copy[c], a)\n",
        "mut pair_count := 0\nfor key, value in both_copy { assert(both_copy.has(key)); assert(value.len() > 0); pair_count++ }\nassert_eq(I64, pair_count, 3)\n",
        "first := Item(n = 1)\nsecond := Item(n = 2)\nmut payload := Item(n = 3)\nchoice := Entry.Number(4)\n",
        "mut iface_array := MyAltArray(ref Ordered).new(2)\niface_array.set(0, payload)!\niface_array.set(1, choice)!\niface_vec := iface_array.to_vec()\nown iface_array.delete()\n",
        "mut iface_values := MyAltMap(Str, ref Ordered).new()\niface_values.set(\"item\", payload)\niface_values.set(\"enum\", choice)\n",
        "payload.n = 8\nassert_eq(I64, iface_vec[0].value(), 8)\nassert_eq(I64, iface_values[\"item\"].value(), 8)\nassert_eq(I64, iface_values[\"enum\"].value(), 4)\n",
        "mut total := 0\nfor key, value in iface_values { assert(key.len() > 0); total = total + value.value() }\nassert_eq(I64, total, 12)\n",
        "mut objects := MyAltMap(ref Item, ref Item).new()\nobjects.set(second, payload)\nobjects.set(first, second)\nassert_eq(I64, objects[second].value(), 8)\n",
        "mut iface_keys := MyAltMap(ref Ordered, Str).new()\niface_keys.set(second, own format(\"two\"))\niface_keys.set(first, own format(\"one\"))\nassert_eq(Str, iface_keys[first], \"one\")\n",
        "mut iface_set := MyAltSet(ref Ordered).new()\niface_set.add(second)\niface_set.add(first)\nassert(iface_set.has(first))\nassert(iface_set.remove(second))\nassert_eq(I64, iface_set.unsafe_get(0).value(), 1)\n",
        "enum_a := Entry.Number(5)\nenum_b := Entry.Number(6)\nmut enum_set := MyAltSet(ref Entry).new()\nenum_set.add(enum_b)\nenum_set.add(enum_a)\nassert_eq(I64, enum_set.unsafe_get(0).value(), 5)\n",
        "one := 1\ntwo := 2\nmut scalar_set := MyAltSet(ref I64).new()\nscalar_set.add(two)\nscalar_set.add(one)\nassert_eq(I64, scalar_set.unsafe_get(0), 1)\nassert(scalar_set.remove(2))\n",
        "mut item_set := MyAltSet(ref Item).new()\nitem_set.add(second)\nitem_set.add(first)\nassert_eq(I64, item_set.unsafe_get(0).n, 1)\n",
        "mut interface_enums := MyAltSet(ref Ordered).new()\ninterface_enums.add(enum_b)\ninterface_enums.add(enum_a)\nassert_eq(I64, interface_enums.unsafe_get(0).value(), 5)\n",
        "mut owned_key := Item(n = 10)\nmut owning_keys := MyAltMap(own Ordered, ref Str).new()\nowning_keys.set(owned_key, c)\nowned_key.n = 11\nquery := Item(n = 10)\nassert_eq(Str, owning_keys[query], c)\n",
        "holder := RefKey(label = b)\nmut mixed := MyAltMap(RefKey, ref RefKey).new()\nmixed.set(RefKey(label = a), holder)\nassert_eq(Str, mixed[RefKey(label = a)].label, b)\n",
        "mut owned_array := MyAltArray(own Str).new(1)\nowned_array.set(0, own format(\"owned\"))!\nassert_eq(Str, owned_array[0], \"owned\")\n",
        "mut owned_set := MyAltSet(own Str).new()\nowned_set.add(own format(\"owned\"))\nassert(owned_set.has(\"owned\"))\n",
        "println(\"container families OK\")\n}\n"))
    check(Cmd.new(compiler, "interpret", format(root, "/families.til")), "container families OK\n")
    check_run(compiler, root, "families", "container families OK\n", asan)
    native_families := File.readfile(format(root, "/families.til"))
        .replace(family_imports, "")
        .replace("MyAltArray", "Array").replace("MyAltMap", "Map").replace("MyAltSet", "Set")
    File.writefile(format(root, "/native_families.til"), native_families)
    check(Cmd.new(compiler, "interpret", format(root, "/native_families.til")), "container families OK\n")
    check_run(compiler, root, "native_families", "container families OK\n", asan)
}

family_borrow_checks := proc(compiler: Str, root: Str) {
    family_types := family_type_source()
    for body : Str in array(Str,
        "import(\"MyAltArray\")\nbad := func() returns MyAltArray(ref Str) { value := format(\"local\"); mut a := MyAltArray(ref Str).new(1); a.set(0, value)!; return a.clone() }\nmain := proc() {}",
        "import(\"MyAltArray\")\nbad := func() returns MyAltVec(ref Str) { value := format(\"local\"); mut a := MyAltArray(ref Str).new(1); a.set(0, value)!; return a.to_vec() }\nmain := proc() {}",
        "import(\"MyAltArray\")\nbad := func(left: MyAltArray(ref Str)) returns MyAltArray(ref Str) { value := format(\"local\"); mut right := MyAltArray(ref Str).new(1); right.set(0, value)!; return left.concat(right) }\nmain := proc() {}",
        "import(\"MyAltArray\")\nmain := proc() { mut a := MyAltArray(ref Str).new(1); if true { value := format(\"local\"); a.set(0, value)! } }",
        "import(\"MyAltArray\")\nmain := proc() { mut a := MyAltArray(ref I64).new(1); a.set(0, 7)! }",
        "import(\"MyAltMap\")\nbad := func() returns MyAltMap(ref Str, Str) { key := format(\"local\"); mut m := MyAltMap(ref Str, Str).new(); m.set(key, own format(\"value\")); return m }\nmain := proc() {}",
        "import(\"MyAltMap\")\nbad := func() returns MyAltMap(Str, ref Str) { value := format(\"local\"); mut m := MyAltMap(Str, ref Str).new(); m.set(\"key\", value); return m.clone() }\nmain := proc() {}",
        "import(\"MyAltMap\")\nbad := proc(mut m: MyAltMap(ref Str, I64)) { key := format(\"local\"); m.set(key, own 3) }\nmain := proc() {}",
        "import(\"MyAltMap\")\nmain := proc() { mut m := MyAltMap(Str, ref Str).new(); m.set(\"key\", format(\"temporary\")) }",
        "import(\"MyAltMap\")\nmain := proc() { mut m := MyAltMap(ref Str, I64).new(); m.set(\"temporary\", own 3) }",
        "import(\"MyAltSet\")\nbad := func() returns MyAltSet(ref Str) { value := format(\"local\"); mut s := MyAltSet(ref Str).new(); s.add(value); return s.clone() }\nmain := proc() {}",
        "import(\"MyAltSet\")\nmain := proc() { mut s := MyAltSet(ref Str).new(); if true { value := format(\"local\"); s.add(value) } }",
        "import(\"MyAltSet\")\nmain := proc() { mut s := MyAltSet(ref I64).new(); s.add(7) }",
        "import(\"MyAltSet\")\nmain := proc() { label := format(\"live\"); mut s := MyAltSet(ref RefKey).new(); s.add(RefKey(label = label)) }",
        "import(\"MyAltArray\")\nmain := proc() { label := format(\"live\"); mut a := MyAltArray(ref RefKey).new(1); a.set(0, RefKey(label = label))! }",
        "import(\"MyAltMap\")\nmain := proc() { label := format(\"live\"); mut m := MyAltMap(ref RefKey, I64).new(); m.set(RefKey(label = label), own 7) }",
        "import(\"MyAltMap\")\nmain := proc() { label := format(\"live\"); mut m := MyAltMap(Str, ref Ordered).new(); m.set(\"key\", RefKey(label = label)) }") {
        File.writefile(format(root, "/invalid_family.til"), format("mode cli\n", family_types, body, "\n"))
        for action : Str in array(Str, "interpret", "translate") {
            cmd := Cmd.new(compiler, action, format(root, "/invalid_family.til"))
            cmd.capture()
            status := cmd.run()
            output := format(cmd.out(), cmd.err())
            expect(status != 0, body, ": ", output)
            expect(output.contains("cannot store a borrow").or(output.contains("cannot return a borrow")), body, ": ", output)
        }
    }
    File.writefile(format(root, "/unset_array.til"), "mode cli\nimport(\"MyAltArray\")\nmain := proc() { a := MyAltArray(ref Str).new(1); println(a[0]) }\n")
    for action : Str in array(Str, "interpret", "run") {
        cmd := Cmd.new(compiler, action, format(root, "/unset_array.til"))
        cmd.capture()
        status := cmd.run()
        output := format(cmd.out(), cmd.err())
        expect(status != 0, output)
        expect(output.contains("Array.get: uninitialized borrowed element"), output)
    }
}

query_error_checks := proc(compiler: Str, root: Str) {
    File.writefile(format(root, "/invalid.til"), format(
        "mode cli\nbad := func(value: Type) returns Bool { return type_arg_is_ref(value) }\n",
        "main := proc() { println(type_arg_is_ref(1)); println(type_arg_is_ref()) }\n"))
    reject(Cmd.new(compiler, "interpret", format(root, "/invalid.til")))
    reject(Cmd.new(compiler, "build", "-o", format(root, "/invalid"),
        "-c", format(root, "/invalid.c"), format(root, "/invalid.til")))
    File.writefile(format(root, "/invalid_generator.til"), format(
        "mode cli\nBad := macro(N: I64) returns StructDef {\n",
        "    if type_arg_is_ref(N) { return struct { value := true } }\n",
        "    else { return struct { value := false } }\n}\n",
        "BadValue := Bad(3)\nmain := proc() { println(\"invalid generator\") }\n"))
    reject(Cmd.new(compiler, "interpret", format(root, "/invalid_generator.til")), false)
    reject(Cmd.new(compiler, "build", "-o", format(root, "/invalid_generator"),
        "-c", format(root, "/invalid_generator.c"), format(root, "/invalid_generator.til")), false)
    for body : Str in array(Str,
        "bad := func(value: Type) returns Bool { return type_arg_is_interface(value) }\nmain := proc() {}",
        "main := proc() { println(type_arg_is_interface(1)) }",
        "main := proc() { println(type_arg_is_interface()) }",
        "main := proc() { println(type_arg_is_interface(I64, Str)) }") {
        File.writefile(format(root, "/invalid_interface_query.til"), format("mode cli\n", body, "\n"))
        for action : Str in array(Str, "interpret", "translate") {
            cmd := Cmd.new(compiler, action, format(root, "/invalid_interface_query.til"))
            cmd.capture()
            status := cmd.run()
            output := format(cmd.out(), cmd.err())
            expect(status != 0, body, ": ", output)
            expect(output.contains("error: type_arg_is_interface"), body, ": ", output)
        }
    }
}

vector_borrow_checks := proc(compiler: Str, root: Str) {
    contract := "Contract := interface { value := func(self: Contract) returns I64 }\n"
    for body : Str in array(Str,
        "bad := func() returns MyAltVec(ref Str) { text := format(\"local\"); mut v := MyAltVec(ref Str).new(); v.push(text); return v }\nmain := proc() {}",
        "bad := func() returns MyAltVec(ref Str) { text := format(\"local\"); mut v := MyAltVec(ref Str).new(); v.push(text); return v.clone() }\nmain := proc() {}",
        "main := proc() { mut v := MyAltVec(ref Str).new(); if true { text := format(\"local\"); v.push(text) } }",
        "bad := proc(mut v: MyAltVec(ref Str)) { text := format(\"local\"); v.push(text) }\nmain := proc() {}",
        "main := proc() { mut v := MyAltVec(ref Str).new(); if true { ref mut alias: MyAltVec(ref Str) = v; text := format(\"local\"); alias.push(text) } }",
        "Holder := struct { refs := MyAltVec(ref Str).new() }\nmain := proc() { mut holder := Holder(); if true { text := format(\"local\"); holder.refs.push(text) } }",
        "main := proc() { mut v := MyAltVec(ref Str).new(); v.push(format(\"temporary\")) }",
        "main := proc() { mut v := MyAltVec(ref I64).new(); v.push(7) }",
        "bad := func() returns MyAltVec(ref I64) { mut raw: I64 = malloc(I64.size().to_uptr()); raw = 5; mut v := MyAltVec(ref I64).new(); v.push(raw); return v }\nmain := proc() {}",
        "bad := func() returns MyAltVec(ref Contract) { record := Record(); mut v := MyAltVec(ref Contract).new(); v.push(record); return v.clone() }\nmain := proc() {}",
        "main := proc() { mut v := MyAltVec(ref Contract).new(); if true { record := Record(); v.push(record) } }",
        "main := proc() { mut v := MyAltVec(ref Contract).new(); v.push(Record()) }",
        "bad := func() returns MyAltVec(ref Str) { return borrow_one(format(\"temporary\")) }\nmain := proc() {}",
        "main := proc() { mut owner: Contract = Record(); mut v := MyAltVec(ref Contract).new(); v.push(owner); copy := v.clone(); own v.delete(); owner = Record(n = 8); println(copy[0].value()) }",
        "Opt := Option(ref Str)\nbad := func(text: Str) returns MyAltVec(ref Opt) { item := Opt.Some(text); mut v := MyAltVec(ref Opt).new(); v.push(item); return v }\nmain := proc() {}") {
        File.writefile(format(root, "/invalid_borrow.til"), format("mode cli\nimport(\"MyAltVec\")\n", contract,
            "Record := struct implements Contract { n := 3\nnamespace:\nvalue := func(self: Record) returns I64 { return self.n } }\n",
            "borrow_one := func(value: Str) returns MyAltVec(ref Str) { mut result := MyAltVec(ref Str).new(); result.push(value); return result }\n", body, "\n"))
        for action : Str in array(Str, "interpret", "translate") {
            cmd := Cmd.new(compiler, action, format(root, "/invalid_borrow.til"))
            cmd.capture()
            status := cmd.run()
            output := format(cmd.out(), cmd.err())
            expect(status != 0, body, ": ", output)
            expect(output.contains("cannot store a borrow").or(output.contains("cannot return a borrow")).or(output.contains("still borrows its storage")), body, ": ", output)
        }
    }
}

interface_argument_checks := proc(compiler: Str, root: Str) {
    contract := "Contract := interface { value := func(self: Contract) returns I64 }\n"
    for declaration : Str in array(Str,
        "Bad := Vec(Contract)",
        "Bad := Array(Contract)",
        "Bad := Map(Str, Contract)",
        "Bad := MyAltVec(Contract)",
        "Bad := Option(MyAltVec(Contract))",
        "Alias := Contract\nBad := MyAltVec(Alias)",
        "priv Private := interface { value := func(self: Private) returns I64 }\nBad := MyAltVec(Private)",
        "Holder := struct<T: Type> { item: T }\nBad := Holder(Contract)",
        "Bad := Option(Contract)",
        "accept := proc(values: MyAltVec(Contract)) {}",
        "good := proc(values: MyAltVec(own Contract)) {}\nbad := proc(values: MyAltVec(Contract)) {}",
        "bad := proc(values: MyAltVec(Contract)) {}\ngood := proc(values: MyAltVec(own Contract)) {}",
        "Alias := Contract\naccept := proc(values: MyAltVec(Alias)) {}",
        "Good := Option(own Contract)\nBad := Option(Contract)",
        "Good := Option(own Contract)\naccept := proc() { mut bad := Option(Contract).None }") {
        File.writefile(format(root, "/interface_argument.til"), format(
            "mode cli\nimport(\"MyAltVec\")\n", contract, declaration,
            "\nmain := proc() {}\n"))
        for action : Str in array(Str, "interpret", "translate") {
            cmd := Cmd.new(compiler, action, format(root, "/interface_argument.til"))
            cmd.capture()
            status := cmd.run()
            output := format(cmd.out(), cmd.err())
            expect(status != 0, declaration, ": ", output)
            expect(output.contains("requires explicit own or ref"), declaration, ": ", output)
        }
    }
    for declaration : Str in array(Str,
        "Bad := MyAltVec(shallow Contract)",
        "accept := proc(values: MyAltVec(shallow Contract)) {}") {
        File.writefile(format(root, "/interface_argument.til"), format(
            "mode cli\nimport(\"MyAltVec\")\n", contract, declaration,
            "\nmain := proc() {}\n"))
        cmd := Cmd.new(compiler, "interpret", format(root, "/interface_argument.til"))
        cmd.capture()
        status := cmd.run()
        output := format(cmd.out(), cmd.err())
        expect(status != 0, declaration, ": ", output)
        expect(output.contains("error:"), declaration, ": ", output)
    }
    for qualifier : Str in array(Str, "own", "ref") {
        File.writefile(format(root, "/invalid_default.til"), format(
            "mode cli\nimport(\"MyAltVec\")\n",
            "Contract := interface { values := func(self: Contract) returns MyAltVec(", qualifier, " Contract) }\n",
            "Item := struct implements Contract { n := 1\nnamespace:\nvalues := func(_self: Item) returns MyAltVec(", qualifier, " Item) { return MyAltVec(", qualifier, " Item).new() } }\n",
            "main := proc() {}\n"))
        for action : Str in array(Str, "interpret", "translate") {
            cmd := Cmd.new(compiler, action, format(root, "/invalid_default.til"))
            cmd.capture()
            status := cmd.run()
            output := format(cmd.out(), cmd.err())
            expect(status != 0, output)
            expect(output.contains("does not match the signature"), output)
        }
    }
    for method : Str in array(Str, "required", "defaulted") {
        File.writefile(format(root, "/invalid_default.til"), format(
            "mode cli\nimport(\"MyAltVec\")\n",
            "Contract := interface { required := func(self: Contract) returns MyAltVec(ref Contract)\n",
            "defaulted := func(self: Contract) returns MyAltVec(ref Contract) { mut result := MyAltVec(ref Contract).new(); result.push(self); return result } }\n",
            "Item := struct implements Contract { n := 1\nnamespace:\nrequired := func(self: Item) returns MyAltVec(ref Contract) { mut result := MyAltVec(ref Contract).new(); result.push(self); return result } }\n",
            "bad := func() returns MyAltVec(ref Contract) { owner: Contract = Item(); return owner.", method, "() }\n",
            "main := proc() {}\n"))
        for action : Str in array(Str, "interpret", "translate") {
            cmd := Cmd.new(compiler, action, format(root, "/invalid_default.til"))
            cmd.capture()
            status := cmd.run()
            output := format(cmd.out(), cmd.err())
            expect(status != 0, output)
            expect(output.contains("cannot return a borrow of local 'owner'"), output)
        }
    }
    File.writefile(format(root, "/invalid_default.til"), format(
        "mode cli\nContract := interface { borrowed := func(self: Contract) returns Option(ref Contract) { return Option(ref Contract).Some(self) } }\n",
        "Item := struct implements Contract { n := 1 }\nmain := proc() {}\n"))
    for action : Str in array(Str, "interpret", "translate") {
        cmd := Cmd.new(compiler, action, format(root, "/invalid_default.til"))
        cmd.capture()
        status := cmd.run()
        output := format(cmd.out(), cmd.err())
        expect(status != 0, output)
        expect(output.contains("has a 'ref' payload"), output)
    }
}

generic_call_checks := proc(compiler: Str, root: Str, asan: Bool) {
    File.writefile(format(root, "/ufcs_api.til"), format(
        "mode lib\nRender := interface { draw := func(self: Render) returns Str }\n",
        "RenderValue := struct implements Render { text: Str\nnamespace:\ndraw := func(self: RenderValue) returns Str { return self.text.clone() } }\n",
        "render := func<T: Type implements Render>(value: T) returns Str { return value.draw() }\n",
        "runtime_type_label := func(value: Type) returns Str { return dyn_type_to_str(value) }\n",
        "render_kind := func<T: Type implements Render>(value: T, kind: Type) returns Str { return format(value.draw(), \"/\", dyn_type_to_str(kind)) }\n",
        "runtime_receiver := func<T: Type implements Render>(kind: Type, value: T) returns Str { return format(dyn_type_to_str(kind), \"/\", value.draw()) }\n"))
    for side : Str in array(Str, "left", "right") {
        File.writefile(format(root, "/ufcs_", side, ".til"), format(
            "mode lib\nimport(\"ufcs_api\")\n", side,
            " := func() returns Str { value := RenderValue(text = \"", side, "\"); return value.render() }\n"))
    }
    File.writefile(format(root, "/ufcs_imports.til"), format(
        "mode cli\nimport(\"ufcs_left\")\nimport(\"ufcs_right\")\nimport(\"ufcs_api\")\n",
        "main := proc() { value := RenderValue(text = \"main\"); kind := Type.Primitive(Primitive.I64);\n",
        "assert_eq(Str, kind.runtime_type_label(), \"I64\"); assert_eq(Str, value.render_kind(kind), \"main/I64\");\n",
        "assert_eq(Str, render_kind(RenderValue, value, kind), \"main/I64\"); assert_eq(Str, render_kind(RenderValue)(value, kind), \"main/I64\");\n",
        "assert_eq(Str, kind.runtime_receiver(value), \"I64/main\");\n",
        "println(left(), \":\", right(), \":\", value.render(), \":\", render(RenderValue)(value)) }\n"))
    check(Cmd.new(compiler, "interpret", format(root, "/ufcs_imports.til")), "left:right:main:main\n")
    check_run(compiler, root, "ufcs_imports", "left:right:main:main\n", asan)
    bound_prelude := format("mode cli\n",
        "Draw := interface { draw := func(self: Draw) returns Str }\n",
        "Extra := interface { extra := func(self: Extra) returns I64 }\n",
        "Good := struct implements Draw { n := 1\nnamespace:\ndraw := func(_self: Good) returns Str { return \"good\" } }\n")
    for call : Str in array(Str, "check(1)", "check(I64)(1)", "check(I64, 1)", "value.check()") {
        reject_generic(compiler, root, format(bound_prelude,
            "check := func<T: Type implements Draw>(_value: T) returns Bool { return true }\n",
            "main := proc() { value := 1; println(", call, ") }\n"), "does not implement 'Draw'")
    }
    reject_generic(compiler, root, format(bound_prelude,
        "check := func(T: Type implements Draw, _value: T) returns Bool { return true }\n",
        "main := proc() { value := 1; println(value.check()) }\n"), "does not implement 'Draw'")
    reject_generic(compiler, root, format(bound_prelude,
        "check := func<T implements Draw, Extra>(_value: T) returns Bool { return true }\n",
        "main := proc() { value := Good(); println(value.check()) }\n"), "does not implement 'Extra'")
    reject_generic(compiler, root, format(bound_prelude,
        "Box := struct<T: Type implements Draw> { value: T }\nBad := Box(I64)\nmain := proc() {}\n"), "does not implement 'Draw'")
    reject_generic(compiler, root, format(bound_prelude,
        "check := macro(T: Type implements Draw) returns FuncDef { return func(_value: T) returns Bool { return true } }\n",
        "main := proc() { println(check(I64)(1)) }\n"), "does not implement 'Draw'")
    reject_generic(compiler, root, format(bound_prelude,
        "check := func<T: Type implements I64>(_value: T) returns Bool { return true }\n",
        "main := proc() { value := Good(); println(value.check()) }\n"), "which is not an interface")
    reject_generic(compiler, root, format(bound_prelude,
        "action := proc<T: Type implements Draw>(_value: T) returns Bool { noop_proc(); return true }\n",
        "bad := func(value: Good) returns Bool { return value.action() }\nmain := proc() {}\n"), "func cannot call proc")
    reject_generic(compiler, root, format(bound_prelude,
        "runtime_type := func(value: Type) returns Str { return dyn_type_to_str(value) }\n",
        "main := proc() { value := Good(); println(value.runtime_type()) }\n"), "no method 'runtime_type'")
    reject_generic(compiler, root, format(bound_prelude,
        "bad := func<N: I64 implements Draw>() returns I64 { return N }\nmain := proc() {}\n"), "interface bounds require a Type parameter")
    mut many_args := ""
    for _ in 0..62 { many_args = format(many_args, "\"x\", ") }
    reject_generic(compiler, root, format(bound_prelude,
        "many := func<T: Type implements Draw>(value: T, parts: ..Str) returns Str { return format(value.draw(), ..parts) }\n",
        "main := proc() { value := Good(); parts := array(Str, \"end\"); println(value.many(", many_args, "..parts)) }\n"),
        "UFCS receiver insertion would overflow the argument qualifier bitmap")
}

reference_permission_checks := proc(compiler: Str, root: Str, asan: Bool) {
    // Keep the two generic spellings in separate programs: sharing a lifted
    // placeholder can hide a missing late-instantiation dependency (#417/#423).
    for angle in 0..2 {
        for writable in 0..2 {
            mut qualifier := "ref "
            mut expected := "false"
            if writable == 1 { qualifier = "ref mut "; expected = "true" }
            name := format("permissions_", angle.to_str(), "_", writable.to_str())
            path := format(root, "/", name, ".til")
            mut forward := "forward := func(T: Type, box: PermBox(T)) returns PermBox(T)"
            if angle == 1 { forward = "forward := func<T>(box: PermBox(T)) returns PermBox(T)" }
            File.writefile(path, format(
                "mode cli\nPayload := struct { n := 1 }\n",
                "PermBox := struct<T> { permission_value: T\n",
                "const ref permission_read: T\nconst ref mut permission_write: T\nnamespace:\n",
                "borrow := func(self: PermBox(T)) returns T { return self.permission_value }\n}\n",
                "PermChoice := macro(T: Type) returns EnumDef { return enum { Empty, PermissionPayload: T } }\n",
                forward, " { return box.clone() }\n",
                "explicit_forward := func<T>(box: PermBox(", qualifier, "T)) returns PermBox(", qualifier, "T) { return box.clone() }\n",
                "main := proc() {\nmut payload := Payload()\n",
                "box: PermBox(", qualifier, "Payload) = PermBox(", qualifier, "Payload)(permission_value = payload, permission_read = payload, permission_write = payload)\n",
                "copy := forward(", qualifier, "Payload, box)\n",
                "explicit_copy := explicit_forward(", qualifier, "Payload, box)\n",
                "ref result: Payload = copy.borrow()\n",
                "choice := PermChoice(", qualifier, "Payload).PermissionPayload(payload)\n",
                "copied_choice := choice.clone()\npayload.n = 37\n",
                "assert_eq(I64, result.n, 37)\nassert_eq(I64, copy.permission_read.n, 37)\n",
                "assert_eq(I64, explicit_copy.permission_value.n, 37)\n",
                "switch copied_choice { case .PermissionPayload(value): assert_eq(I64, value.n, 37)\ncase: panic(\"missing borrow\") }\n",
                "assert(type_arg_is_ref(", qualifier, "Payload))\nprintln(\"permissions passed\")\n}\n"))
            check(Cmd.new(compiler, "interpret", path), "permissions passed\n")
            check_run(compiler, root, name, "permissions passed\n", asan)
            ast := Cmd.new(compiler, "ast", "--phase=typed", path)
            ast.capture()
            status := ast.run()
            output := format(ast.out(), ast.err())
            expect(status == 0, output)
            mut saw_field := false
            mut saw_payload := false
            mut saw_return := false
            for line : Str in output.split("\n") {
                if line.contains("member_name=\"permission_value\"").and(line.contains("til_type=StructSym(Payload)")) {
                    expect(line.contains(format("referent_mut=", expected)), line)
                    saw_field = true
                }
                if line.contains("member_name=\"permission_read\"") { expect(line.contains("referent_mut=false"), line) }
                if line.contains("member_name=\"permission_write\"") { expect(line.contains("referent_mut=true"), line) }
                if line.contains("name=\"PermissionPayload\"").and(line.contains("payload_type=\"Payload\"")) {
                    expect(line.contains(format("payload_ref_mut=", expected)), line)
                    saw_payload = true
                }
                if line.contains("return_type=\"Payload\"").and(line.contains("return_own_type=ref")) {
                    expect(line.contains(format("return_ref_mut=", expected)), line)
                    saw_return = true
                }
            }
            expect(saw_field.and(saw_payload).and(saw_return), "missing permission metadata in typed AST: ", output)
        }
    }
}

return_signature_checks := proc(compiler: Str, root: Str, asan: Bool) {
    prelude := format("mode cli\nReturnRecord491 := struct { n := 0 }\n",
        "Read491 := func(mut value: ReturnRecord491) returns ref ReturnRecord491\n",
        "Write491 := func(mut value: ReturnRecord491) returns ref mut ReturnRecord491\n",
        "reader491 := func(mut value: ReturnRecord491) returns ref ReturnRecord491 { value.n++; return value }\n",
        "writer491 := func(mut value: ReturnRecord491) returns ref mut ReturnRecord491 { value.n++; return value }\n")
    lookup := format("ReturnOps491 := struct { namespace:\n",
        "read := func(mut value: ReturnRecord491) returns ref ReturnRecord491 { value.n++; return value }\n",
        "write := func(mut value: ReturnRecord491) returns ref mut ReturnRecord491 { value.n++; return value }\n}\n")
    for body : Str in array(Str,
        "main := proc() { mut value := ReturnRecord491(); bad: Write491 = reader491; ref result: ReturnRecord491 = bad(value); println(result.n.to_str()) }\n",
        "Box491 := struct { callback: Write491 }\nmain := proc() { mut value := ReturnRecord491(); box := Box491(callback = reader491); ref result: ReturnRecord491 = box.callback(value); println(result.n.to_str()) }\n",
        "invoke491 := func(callback: Write491, mut value: ReturnRecord491) returns I64 { ref result: ReturnRecord491 = callback(value); return result.n }\nmain := proc() { mut value := ReturnRecord491(); println(invoke491(reader491, value).to_str()) }\n",
        "main := proc() { mut value := ReturnRecord491(); bad: Write491 = func(mut input: ReturnRecord491) returns ref ReturnRecord491 { input.n++; return input }; ref result: ReturnRecord491 = bad(value); println(result.n.to_str()) }\n",
        "main := proc() { seed := 1; mut value := ReturnRecord491(); bad: Write491 = func(mut input: ReturnRecord491) returns ref ReturnRecord491 [seed] { input.n = input.n + seed; return input }; ref result: ReturnRecord491 = bad(value); println(result.n.to_str()) }\n") {
        reject_generic(compiler, root, format(prelude, body), "return differs in 'ref mut'")
    }
    reject_generic(compiler, root, format(prelude,
        "owned491 := func(mut value: ReturnRecord491) returns ReturnRecord491 { value.n++; return value.clone() }\n",
        "main := proc() { mut value := ReturnRecord491(); bad: Read491 = owned491; ref result: ReturnRecord491 = bad(value); println(result.n.to_str()) }\n"),
        "return differs in 'ref'")

    lookup_path := format(root, "/return_lookup_mismatch.til")
    File.writefile(lookup_path, format(prelude, lookup,
        "main := proc() { mut value := ReturnRecord491(); bad: Write491 = dyn_fn(\"ReturnOps491\", \"read\"); ref result: ReturnRecord491 = bad(value); println(result.n.to_str()) }\n"))
    for action : Str in array(Str, "interpret", "run") {
        cmd := Cmd.new(compiler, action)
        if action == "run" {
            if asan { cmd.arg("--asan") }
            cmd.args("-o", format(root, "/return_lookup_mismatch"), "-c", format(root, "/return_lookup_mismatch.c"))
        }
        cmd.arg(lookup_path)
        cmd.capture()
        status := cmd.run()
        output := format(cmd.out(), cmd.err())
        expect(status != 0, "accepted read-only dynamic lookup as a writable-return function: ", output)
        expect(output.contains("dyn_fn: signature mismatch"), output)
    }

    File.writefile(format(root, "/return_signatures.til"), format(prelude, lookup,
        "borrow491 := func<T>(mut value: T) returns ref mut T { value.n++; return value }\n",
        "main := proc() {\nmut value := ReturnRecord491()\n",
        "writable: Write491 = writer491\nref mut first: ReturnRecord491 = writable(value)\nfirst.n = 10\n",
        // A writable implementation may satisfy a read-only result contract.
        "readonly: Read491 = writer491\nref second: ReturnRecord491 = readonly(value)\nassert_eq(I64, second.n, 11)\n",
        "inferred: Write491 = (input) { input.n++; return input }\n",
        "ref third: ReturnRecord491 = inferred(value)\nassert_eq(I64, third.n, 12)\n",
        "seed := 1\ncaptured: Write491 = func(mut input: ReturnRecord491) returns ref mut ReturnRecord491 [seed] { input.n = input.n + seed; return input }\n",
        "ref fourth: ReturnRecord491 = captured(value)\nassert_eq(I64, fourth.n, 13)\n",
        "ref fifth: ReturnRecord491 = borrow491(value)\nassert_eq(I64, fifth.n, 14)\n",
        "dynamic: Write491 = dyn_fn(\"ReturnOps491\", \"write\")\n",
        "ref sixth: ReturnRecord491 = dynamic(value)\nassert_eq(I64, sixth.n, 15)\n",
        "println(\"return signatures passed\")\n}\n"))
    check(Cmd.new(compiler, "interpret", format(root, "/return_signatures.til")), "return signatures passed\n")
    check_run(compiler, root, "return_signatures", "return signatures passed\n", asan)
    ast := Cmd.new(compiler, "ast", "--phase=typed", format(root, "/return_signatures.til"))
    ast.capture()
    status := ast.run()
    output := format(ast.out(), ast.err())
    expect(status == 0, output)
    mut pending := false
    mut saw_generic := false
    for line : Str in output.split("\n") {
        if pending {
            expect(line.contains(" FuncDef ").and(line.contains("return_ref_mut=true")), line)
            saw_generic = true
            pending = false
        }
        if line.contains(" Decl ").and(line.contains("name=\"borrow491__ReturnRecord491\"")) { pending = true }
    }
    expect(saw_generic, "missing inferred writable-return generic instance")
}

priv check_wrong_mutable_view := proc(cmd: Cmd, kind: Str) {
    cmd.capture()
    status := cmd.run()
    output := format(cmd.out(), cmd.err())
    expect(status != 0, output)
    expect(output.contains("mutable-view-site") && output.contains(format("expected ", kind)), output)
}

mutable_ast_view_checks := proc(compiler: Str, root: Str, asan: Bool) {
    File.writefile(format(root, "/mutable_ast_views.til"), format("mode cli\nimport(\"std/tilvm\")\n",
        "Item := struct { n: I64 = 0 }\n",
        "Box491 := struct { cell := Item() }\n",
        "Rows491 := struct { items := Vec(Item).new()\nnamespace:\n",
        "unsafe_get := func(ref[a] self: Rows491, i: USize) returns ref[a] Item { return ptr_add(self.items.data, i.to_uptr().mul(Item.size().to_uptr())) }\n",
        "get := func(ref[a] self: Rows491, i: USize) returns ref[a] Item throws OutOfBounds { if i < self.items.len() { return self.unsafe_get(i) }; throw OutOfBounds() } }\n",
        "read_row := func(rows: Rows491) returns I64 { ref row := rows[0]; return row.n }\n",
        "Linked491 := func(I64, ref[src] Box491) returns ref[src] Item\n",
        "cell491 := func(ref[a] owner: Box491) returns ref[a] Item { return owner.cell }\n",
        "forward491 := func(tag: I64, ref[b] owner: Box491) returns ref[b] Item { assert(tag == 7); return cell491(owner) }\n",
        "write491view := func(mut owner: Box491) returns ref mut Item { return forward491(7, owner) }\n",
        "BorrowedViews := enum { None, Read: ref Item, const Write: ref mut Item }\n",
        "from_optional := func(value: Option(ref mut Item)) returns ref mut Item { switch value { case .Some(item): return item; case: panic(\"missing\") } }\n",
        "from_tagged := func(value: BorrowedViews) returns ref mut Item { switch value { case .Write(item): return item; case: panic(\"wrong variant\") } }\n",
        "direct_option := func(mut value: Item) returns Option(ref mut Item) { return Option(ref mut Item).Some(value) }\n",
        "decl_view := func(mut node: Expr) returns ref mut Declaration { return decl_of_mut(node) }\n",
        "function_view := func(mut node: Expr) returns ref mut FunctionDef { return funcdef_of_mut(node) }\n",
        "member_view := func(mut node: Expr) returns ref mut Declaration { return def_ns_get_mut(node, \"member\").unwrap() }\n",
        "SlotNode := struct { ref view: Item; ref mut fold: Item; history := Vec(Item).new() }\n",
        "main := proc() {\nassert(TilVm.size() > 0)\nmut item := Item()\noptional := safe_ref_mut(item)\n",
        "mut rows := Rows491()\nrows.items.push(own Item(n = 7))\nrows.items.push(own Item(n = 8))\n",
        "mut slots := SlotNode(view = item, fold = item)\nslots.history.push(own Item(n = 27))\nslots.view = slots.history[0]\nslots.fold = slots.history[0]\nslots.fold.n = 31\nassert(slots.view.n == 31 && item.n == 0)\n",
        "ref mut row := rows[1]\nrow.n = 9\nassert(read_row(rows) == 7 && rows.items[1].n == 9)\n",
        "mut caught := false\nrows.get(2)? catch (e: OutOfBounds) { caught = true }\nassert(caught)\n",
        "frozen := Box491()\nmut editable := Box491()\nref read_only := forward491(7, frozen)\nassert(read_only.n == 0)\n",
        "ref mut write_view := write491view(editable)\nwrite_view.n = 8\nref restricted := cell491(editable)\nassert(restricted.n == 8)\n",
        "callback: Linked491 = forward491\nref mut indirect := callback(7, editable)\nindirect.n = 9\nassert(editable.cell.n == 9)\nassert(func_sig_of(\"Linked491\").return_origin_param == 1)\n",
        "const ref mut value: Item = optional.unwrap()\nvalue.n = 1\nassert_eq(I64, item.n, 1)\n",
        "direct := direct_option(item)\nref mut forwarded: Item = direct.unwrap()\nforwarded.n = 2\nassert_eq(I64, item.n, 2)\n",
        "copied := optional.clone()\nref mut cloned: Item = copied.unwrap()\ncloned.n = 3\nassert_eq(I64, item.n, 3)\n",
        "ref mut extracted: Item = from_optional(optional)\nextracted.n = 4\nassert_eq(I64, item.n, 4)\n",
        "tagged := BorrowedViews.Write(item)\ntagged_copy := tagged.clone()\nref mut tagged_value: Item = from_tagged(tagged_copy)\ntagged_value.n = 5\nassert_eq(I64, item.n, 5)\n",
        "mut number: I64 = 3\nscalar := safe_ref_mut(number)\nref mut scalar_value: I64 = scalar.unwrap()\nscalar_value = 4\nassert_eq(I64, number, 4)\n",
        "mut node := Expr.new(own NodeType.Decl(Declaration(name = \"before\")), 0, 0)\n",
        "ref mut declaration: Declaration = decl_view(node)\ndeclaration.name = format(\"after\")\n",
        "declaration.default_value = Option(Expr).Some(own Expr.new(own NodeType.Body, 0, 0))\n",
        "ref mut body: Expr = declaration.default_expr_mut()\nbody.children.push(own Expr.new(own NodeType.Body, 0, 0))\n",
        "assert_eq(Str, decl_of(node).name, \"after\")\nassert_eq(USize, decl_of(node).default_expr().children.len(), 1)\n",
        "mut call := Expr.new(own NodeType.FCall(FCallData()), 0, 0)\n",
        "ref mut flags: FCallData = fcall_of_mut(call)\nflags.is_subscript = true\nassert(fcall_of(call).is_subscript)\n",
        "mut function := Expr.new(own NodeType.FuncDef(FunctionDef()), 0, 0)\n",
        "ref mut definition: FunctionDef = function_view(function)\ndefinition.sig.return_type = format(\"I64\")\nassert_eq(Str, funcdef_of(function).sig.return_type, \"I64\")\n",
        "mut structure := Expr.new(own NodeType.StructDef(StructDef()), 0, 0)\n",
        "ref mut fields: StructDef = structdef_of_mut(structure)\nfields.push_field(own Declaration(name = \"field\"))\n",
        "ref mut field: Declaration = fields.field_at_mut(0)\nfield.is_priv = true\nassert(fields.field_at(0).is_priv)\nassert_eq(Str, fields.field_name_at(0), \"field\")\n",
        "fields.push_member(own Declaration(name = \"member\"))\n",
        "found := member_get_mut(fields.ns_index, fields.ns_decls, \"member\")\nref mut member: Declaration = found.unwrap()\nmember.is_priv = true\n",
        "assert(member_get(fields.ns_index, fields.ns_decls, \"member\").unwrap().is_priv)\n",
        "assert(member_get_mut(fields.ns_index, fields.ns_decls, \"missing\").is_none())\n",
        "ref mut members: Vec(Declaration) = def_ns_decls_mut(structure)\nref mut listed: Declaration = members[0]\nlisted.used = true\nassert(def_ns_get(structure, \"member\").unwrap().used)\n",
        "ref mut named: Declaration = member_view(structure)\nnamed.is_priv = false\nassert(def_ns_get(structure, \"member\").unwrap().is_priv.not())\n",
        "assert(def_ns_get_mut(structure, \"missing\").is_none())\n",
        "mut enumeration := Expr.new(own NodeType.EnumDef(EnumDef()), 0, 0)\n",
        "ref mut enum_data: EnumDef = enumdef_of_mut(enumeration)\nenum_data.tag_type = format(\"U8\")\nenum_data.push_member(own Declaration(name = \"member\"))\n",
        "ref mut enum_member: Declaration = def_ns_get_mut(enumeration, \"member\").unwrap()\nenum_member.used = true\n",
        "ref mut enum_members: Vec(Declaration) = def_ns_decls_mut(enumeration)\nref mut enum_listed: Declaration = enum_members[0]\nenum_listed.is_priv = true\n",
        "assert_eq(Str, enumdef_of(enumeration).tag_type, \"U8\")\nassert(def_ns_get(enumeration, \"member\").unwrap().used)\nassert(def_ns_get(enumeration, \"member\").unwrap().is_priv)\n",
        "mut symbols := SymbolPool()\nmut outer := TypeScope()\n",
        "outer.set(\"parent_only\", Type.Unknown, false, \"outer\", 1, 1, false, OwnType.Shallow, symbols)\n",
        "outer.set(\"shadowed\", Type.Unknown, false, \"outer\", 1, 2, false, OwnType.Shallow, symbols)\n",
        "mut middle := TypeScope(parent = safe_ref_mut(outer))\n",
        "middle.set(\"shadowed\", Type.Unknown, false, \"middle\", 2, 1, false, OwnType.Shallow, symbols)\n",
        "mut leaf := TypeScope(parent = safe_ref_mut(middle))\n",
        "leaf.set(\"local_only\", Type.Unknown, false, \"leaf\", 3, 1, false, OwnType.Shallow, symbols)\n",
        "found_parent := leaf.get_binding_name_mut(\"parent_only\", symbols)\nconst ref mut parent_binding: TypeBinding = found_parent.unwrap()\nparent_binding.used = true\n",
        "found_shadow := leaf.get_binding_sym_mut(symbols.lookup(\"shadowed\").unwrap())\nconst ref mut nearest: TypeBinding = found_shadow.unwrap()\nnearest.written = true\n",
        "found_local := leaf.get_binding_name_mut(\"local_only\", symbols)\nconst ref mut local_binding: TypeBinding = found_local.unwrap()\nlocal_binding.used = true\n",
        "assert(outer.get_binding_name(\"parent_only\", symbols).unwrap().used)\n",
        "assert(middle.get_binding_name(\"shadowed\", symbols).unwrap().written)\nassert(outer.get_binding_name(\"shadowed\", symbols).unwrap().written.not())\n",
        "assert(leaf.get_binding_name(\"local_only\", symbols).unwrap().used)\n",
        "assert(leaf.get_binding_name_mut(\"uninterned_name\", symbols).is_none())\n",
        "absent_sym := symbols.intern(\"interned_but_unbound\")\nassert(leaf.get_binding_sym_mut(absent_sym).is_none())\n",
        "assert_eq(USize, leaf.bindings.len(), 1)\nassert_eq(USize, middle.bindings.len(), 1)\nassert_eq(USize, outer.bindings.len(), 2)\n",
        "println(\"mutable AST views passed\")\n}\n"))
    check(Cmd.new(compiler, "interpret", format(root, "/mutable_ast_views.til")), "mutable AST views passed\n")
    check_run(compiler, root, "mutable_ast_views", "mutable AST views passed\n", asan)
    // Load std/tilvm once per action. A failure on another line must not
    // stand in for the expected rejection of any individual declaration.
    invalid := format(root, "/invalid_mutable_views.til")
    File.writefile(invalid, format("mode cli\nimport(\"std/tilvm\")\nItem := struct { n := 0 }\n",
        "BorrowedViews := enum { None, Read: ref Item, const Write: ref mut Item }\n",
        "bad_payload := func(value: Item) returns Option(ref mut Item) { return Option(ref mut Item).Some(value) }\n",
        "bad_wrap := func(value: Item) returns Option(ref mut Item) { return safe_ref_mut(value) }\n",
        "bad_read_wrap := func(mut value: Item) returns Option(ref Item) { return Option(ref Item).Some(value) }\n",
        "bad_clone := func(mut value: Item) returns ref mut Item { read := safe_ref(value); return read.clone().unwrap() }\n",
        "bad_tagged := func(value: BorrowedViews) returns ref mut Item { switch value { case .Read(item): return item; case: panic(\"wrong variant\") } }\n",
        "bad_none := func(mut value: Item) returns Option(ref mut Item) { if value.n == 0 { return Option(ref mut Item).None }; return Option(ref mut Item).None }\n",
        "bad_decl := func(mut node: Expr) returns ref mut Declaration { return decl_of(node) }\n",
        "bad_func := func(mut node: Expr) returns ref mut FunctionDef { return funcdef_of(node) }\n",
        "bad_default := func(mut declaration: Declaration) returns ref mut Expr { return declaration.default_expr() }\n",
        "bad_field := func(mut definition: StructDef) returns ref mut Declaration { return definition.field_at(0) }\n",
        "bad_member := func(mut node: Expr) returns ref mut Declaration { return def_ns_get(node, \"member\").unwrap() }\n",
        "bad_owner := func(node: Expr) returns ref mut FunctionDef { return funcdef_of_mut(node) }\n",
        "bad_scope_read := func(scope: TypeScope, sym: Sym) returns ref mut TypeBinding { return scope.get_binding_sym(sym).unwrap() }\n",
        "bad_scope_owner := func(scope: TypeScope, sym: Sym) returns Option(ref mut TypeBinding) { return scope.get_binding_sym_mut(sym) }\n",
        "bad_scope_parent := func(scope: TypeScope) returns TypeScope { return TypeScope(parent = safe_ref_mut(scope)) }\n",
        "bad_local := func(ref[a] src: Item) returns ref[a] Item { local := Item(n = src.n); return local }\n",
        "bad_other := func(ref[a] src: Item, other: Item) returns ref[a] Item { assert(src.n == 0); return other }\n",
        "bad_global := func(ref[a] src: Item) returns ref[a] Item { assert(src.n == 0); return origin_global }\n",
        "bad_write := func(ref[a] src: Item) returns ref[a] Item { src.n = 3; return src }\n",
        "bad_actual := func(src: Item) { ref mut bad := identity491(src); bad.n = 1 }\n",
        "bad_restrict := func(mut src: Item) { src.n = 1; ref bad := identity491(src); bad.n = 2 }\n",
        "bad_temp := func() returns ref Item { return identity491(Item()) }\n",
        "bad_escape := func() returns ref Item { local := Item(); return identity491(local) }\n",
        "bad_const := func(ref[a] src: FrozenBox491) returns ref[a] Item { return src.cell }\n",
        "bad_carried := func(ref[a] src: RefBox491) returns ref[a] Item { return src.cell }\n",
        "bad_buffer := func(ref[a] src: Vec(Item), other: Vec(Item)) returns ref[a] Item { assert(src.count == 0); return ptr_add(other.data, 0) }\n",
        "bad_ref_buffer := func(ref[a] src: BufferBorrow491) returns ref[a] Item { return ptr_add(src.data, 0) }\n",
        "bad_loaded := func(ref[a] src: Vec(Item)) returns ref[a] Item { return deref(ptr_add(src.data, 0)) }\n",
        "bad_checked := func(ref[a] src: Vec(Item), other: Item) returns ref[a] Item throws OutOfBounds { if src.len() == 0 { throw OutOfBounds() }; return other }\n",
        "bad_buffer_write := func(src: Vec(Item)) { ref mut v := buffer491(src); v.n = 1 }\n",
        "bad_view := func(mut node: SlotNode) { node.view = node.history[0]; node.view.n = 9 }\n",
        "bad_fold := func(mut node: SlotNode) { node.fold = node.view }\n",
        "bad_local_grant := func(src: Item) { const ref mut value := src; value.n = 9 }\n",
        "SlotNode := struct { ref view: Item; ref mut fold: Item; history := Vec(Item).new() }\n",
        "buffer491 := func(ref[a] src: Vec(Item)) returns ref[a] Item { return ptr_add(src.data, 0) }\nBufferBorrow491 := struct { ref mut data: U8 }\n",
        "FrozenBox491 := struct { const cell := Item() }\nRefBox491 := struct { const ref mut cell: Item }\n",
        "origin_global := Item()\nidentity491 := func(ref[a] src: Item) returns ref[a] Item { return src }\n",
        "main := proc() { assert(TilVm.size() > 0) }\n"))
    denied := "cannot return a writable reference"
    redundant := "redundant 'mut' on parameter 'value'"
    expected := array(Str, "cannot return a writable borrowed payload", "'value' is an immutable binding",
        redundant, denied, denied, redundant, denied, denied, denied, denied, denied, denied,
        denied, "'scope' is an immutable binding", "'scope' is an immutable binding",
        "linked return must borrow", "linked return must borrow", "linked return must borrow",
        "cannot assign", "cannot take a writable borrow", "cannot assign", "stable argument storage",
        "cannot return a borrow of local", "linked return must borrow", "linked return must borrow",
        "linked return must borrow", "linked return must borrow", "linked return must borrow", "linked return must borrow", "cannot take a writable borrow",
        "field 'view' is a read-only reference", "cannot bind writable field 'fold'", "cannot take a writable borrow")
    for action: Str in array(Str, "interpret", "translate") {
        cmd := Cmd.new(compiler, action, invalid)
        cmd.capture()
        status := cmd.run()
        output := format(cmd.out(), cmd.err())
        expect(status != 0, output)
        lines := output.split("\n")
        for i, diagnostic in expected {
            site := format(invalid, ":", (i + 5).to_str(), ":")
            mut matched := false
            for line: Str in lines {
                if line.contains(site) && line.contains("error:") && line.contains(diagnostic) { matched = true; break }
            }
            expect(matched, "missing ", diagnostic, " at ", site, "\n", output)
        }
    }

    // Panics terminate execution, so run each arm in its own process, but
    // compile the five arms into one executable instead of five separate builds.
    wrong := format(root, "/wrong_mutable_view.til")
    binary := format(root, "/wrong_mutable_view")
    File.writefile(wrong, format("mode cli\nmain := proc(args: ..Str) {\n",
        "mut node := Expr.new(own NodeType.Body, 0, 0)\nswitch args[0] {\n",
        "case \"Decl\": decl_of_mut(node, loc = \"mutable-view-site\")\n",
        "case \"FCall\": fcall_of_mut(node, loc = \"mutable-view-site\")\n",
        "case \"FuncDef\": funcdef_of_mut(node, loc = \"mutable-view-site\")\n",
        "case \"StructDef\": structdef_of_mut(node, loc = \"mutable-view-site\")\n",
        "case \"EnumDef\": enumdef_of_mut(node, loc = \"mutable-view-site\")\n",
        "case: panic(\"unknown test arm\")\n}\n}\n"))
    build := Cmd.new(compiler, "build", "-o", binary, "-c", format(binary, ".c"), wrong)
    if asan { build.arg("--asan") }
    build.run_checked()
    mut executable := binary.clone()
    if host_os() == "windows" { executable = format(binary, ".exe") }
    for kind: Str in array(Str, "Decl", "FCall", "FuncDef", "StructDef", "EnumDef") {
        check_wrong_mutable_view(Cmd.new(compiler, "interpret", wrong, kind), kind)
        check_wrong_mutable_view(Cmd.new(executable, kind), kind)
    }
}

capture_forwarding_checks := proc(compiler: Str, root: Str, asan: Bool) {
    prelude := format("mode cli\nCounts := struct { drops: I64 = 0 }\n",
        "SimpleCapture := struct { const ref cell: I64; const ref mut counts: Counts }\n",
        "simple_counts := func(capture: SimpleCapture) returns ref mut Counts { return capture.counts }\n",
        "Capture := struct { const ref cell: I64; const ref read: Counts; const ref mut counts: Counts; const ref mut other: Counts }\n",
        "Nested := struct { capture: Capture }\nLinked := struct { const ref mut capture: Capture }\n",
        "capture_counts := func(capture: Capture) returns ref mut Counts { return capture.counts }\n",
        "identity_capture := func(capture: Capture) returns ref Capture { return capture }\n",
        "forward_counts := func(capture: Capture) returns ref mut Counts { return capture_counts(capture) }\n",
        "choose_counts := func(capture: Capture, first: Bool) returns ref mut Counts { if first { return capture.counts }; return capture.other }\n",
        "nested_counts := func(value: Nested) returns ref mut Counts { return value.capture.counts }\n",
        "linked_counts := func(value: Linked) returns ref mut Counts { return value.capture.counts }\n")
    File.writefile(format(root, "/capture_forwarding.til"), format(prelude,
        "main := proc() {\ncell: I64 = 123\nread := Counts()\nmut counts := Counts()\nmut other := Counts()\n",
        "simple := SimpleCapture(cell = cell, counts = counts)\nref mut original: Counts = simple_counts(simple)\noriginal.drops++\n",
        "capture := Capture(cell = cell, read = read, counts = counts, other = other)\n",
        "ref mut target: Counts = capture_counts(capture)\ntarget.drops++\n",
        "const ref mut fixed: Counts = forward_counts(capture)\nfixed.drops++\n",
        "capture_counts(capture).drops++\nforward_counts(capture).drops++\n",
        "ref whole: Capture = identity_capture(capture)\nref mut through_whole: Counts = capture_counts(whole)\nthrough_whole.drops++\n",
        "ref mut selected: Counts = choose_counts(capture, true)\nselected.drops++\n",
        "ref mut alternative: Counts = choose_counts(capture, false)\nalternative.drops++\n",
        "nested := Nested(capture = capture.clone())\nref mut inner: Counts = nested_counts(nested)\ninner.drops++\n",
        "linked := Linked(capture = capture)\nref mut indirect: Counts = linked_counts(linked)\nindirect.drops++\n",
        "assert(cell == 123 && read.drops == 0 && counts.drops == 9 && other.drops == 1)\n",
        "println(\"capture forwarding passed\")\n}\n"))
    check(Cmd.new(compiler, "interpret", format(root, "/capture_forwarding.til")), "capture forwarding passed\n")
    check_run(compiler, root, "capture_forwarding", "capture forwarding passed\n", asan)
    reject_generic(compiler, root, format(prelude,
        "bad := func(capture: Capture) returns ref mut Counts { return capture.read }\nmain := proc() {}\n"),
        "cannot return a writable reference")
    reject_generic(compiler, root, format(prelude,
        "main := proc() { cell: I64 = 123; read := Counts(); counts := Counts(); mut other := Counts();\n",
        "capture := Capture(cell = cell, read = read, counts = counts, other = other);\n",
        "ref mut target: Counts = capture_counts(capture); target.drops++; other.drops++ }\n"),
        "'counts' is an immutable binding")
    reject_generic(compiler, root, format(prelude,
        "main := proc() { cell: I64 = 123; read := Counts(); mut counts := Counts(); other := Counts();\n",
        "capture := Capture(cell = cell, read = read, counts = counts, other = other);\n",
        "ref mut target: Counts = choose_counts(capture, true); target.drops++ }\n"),
        "'other' is an immutable binding")
    reject_generic(compiler, root, format(prelude,
        "main := proc() { mut cell: I64 = 123; read := Counts(); mut counts := Counts(); mut other := Counts();\n",
        "capture := Capture(cell = cell, read = read, counts = counts, other = other);\n",
        "ref mut target: Counts = forward_counts(capture); target.drops++; other.drops++; println(cell) }\n"),
        "redundant 'mut' on local 'cell'")
    reject_generic(compiler, root, format(prelude,
        "Opaque := func(Capture) returns ref mut Counts\n",
        "mixed := func(action: Opaque, capture: Capture, known: Bool) returns ref mut Counts { if known { return capture_counts(capture) }; return action(capture) }\n",
        "main := proc() { cell: I64 = 123; read := Counts(); mut counts := Counts(); mut other := Counts();\n",
        "capture := Capture(cell = cell, read = read, counts = counts, other = other);\n",
        "ref mut target: Counts = mixed(capture_counts, capture, true); target.drops++; other.drops++ }\n"),
        "'cell' is an immutable binding")
    reject_generic(compiler, root, format(prelude,
        "Opaque := func(Capture) returns ref mut Counts\n",
        "mixed := func(action: Opaque, known: Capture, unknown: Capture, first: Bool) returns ref mut Counts { if first { return known.counts }; return action(unknown) }\n",
        "main := proc() { left_cell: I64 = 1; right_cell: I64 = 2; read := Counts(); mut counts := Counts(); mut other := Counts();\n",
        "left := Capture(cell = left_cell, read = read, counts = counts, other = other);\n",
        "right := Capture(cell = right_cell, read = read, counts = counts, other = other);\n",
        "ref mut target: Counts = mixed(capture_counts, left, right, true); target.drops++; other.drops++ }\n"),
        "'right_cell' is an immutable binding")
}

writable_accessor_checks := proc(compiler: Str, root: Str, asan: Bool) {
    prelude := format("mode cli\n",
        "MutableItem := interface { value := func(self: MutableItem) returns I64\nset_value := func(mut self: MutableItem, n: I64) }\n",
        "Item := struct implements MutableItem { n: I64 = 0\nnamespace:\n",
        "value := func(self: Item) returns I64 { return self.n }\nset_value := func(mut self: Item, n: I64) { self.n = n } }\n",
        "vec_item := func(mut items: Vec(Item), index: USize) returns ref mut Item { return items[index] }\n",
        "array_item := func(mut items: Array(Item), index: USize) returns ref mut Item { return items[index] }\n",
        "map_item := func(mut items: Map(Str, Item), key: Str) returns ref mut Item { return items[key] }\n")
    source := format(prelude,
        "main := proc() {\n",
        "mut items := Vec(Item).new()\nitems.push(own Item(n = 1))\n",
        "ref mut first: Item = vec_item(items, 0)\nfirst.n = 2\n",
        "ref mut unchecked: Item = items.unsafe_get(0)\nunchecked.n = 3\nassert_eq(I64, items[0].n, 3)\n",
        "mut fixed := Array(Item).new(1)\nfixed.set(0, own Item(n = 4))!\n",
        "ref mut array_value: Item = array_item(fixed, 0)\narray_value.n = 5\n",
        "ref mut array_unchecked: Item = fixed.unsafe_get(0)\narray_unchecked.n = 6\nassert_eq(I64, fixed[0].n, 6)\n",
        "for mut entry in fixed { entry.n++ }\nassert_eq(I64, fixed[0].n, 7)\n",
        "mut values := Map(Str, Item).new()\nvalues.set(\"b\", own Item(n = 7))\nvalues.set(\"a\", own Item(n = 8))\n",
        "ref mut map_value: Item = map_item(values, \"b\")\nmap_value.n = 9\nassert_eq(I64, values[\"b\"].n, 9)\nassert_eq(I64, values[\"a\"].n, 8)\n",
        "mut owned_numbers := vec(I64, 1)\nref mut owned_scalar: I64 = owned_numbers[0]\nowned_scalar = 2\nassert_eq(I64, owned_numbers[0], 2)\n",
        "mut owned_scalar_array := array(I64, 3)\nref mut owned_array_scalar: I64 = owned_scalar_array.unsafe_get(0)\nowned_array_scalar = 4\nassert_eq(I64, owned_scalar_array[0], 4)\n",
        "mut owned_scalar_map := Map(Str, I64).new()\nowned_scalar_map.set(\"n\", own 5)\nref mut owned_map_scalar: I64 = owned_scalar_map[\"n\"]\nowned_map_scalar = 6\nassert_eq(I64, owned_scalar_map[\"n\"], 6)\n",
        "mut owned_handles := Vec(own MutableItem).new()\nowned_handles.push(own Item(n = 7))\nref mut owned_handle: MutableItem = owned_handles[0]\nowned_handle.set_value(8)\nassert_eq(I64, owned_handles[0].value(), 8)\n",
        "mut number: I64 = 10\nmut numbers := Vec(ref mut I64).new()\nnumbers.push(number)\n",
        "ref mut scalar: I64 = numbers[0]\nscalar = 11\nassert_eq(I64, number, 11)\n",
        "mut scalar_array := Array(ref mut I64).new(1)\nscalar_array.set(0, number)!\n",
        "ref mut array_scalar: I64 = scalar_array.unsafe_get(0)\narray_scalar = 12\nassert_eq(I64, number, 12)\n",
        "mut scalar_map := Map(Str, ref mut I64).new()\nscalar_map.set(\"n\", number)\n",
        "ref mut map_scalar: I64 = scalar_map[\"n\"]\nmap_scalar = 13\nassert_eq(I64, number, 13)\n",
        "mut original := Item(n = 14)\nmut refs := Vec(ref mut Item).new()\nrefs.push(original)\n",
        "refs_copy := refs.clone()\nref mut borrowed: Item = refs_copy[0]\nborrowed.n = 15\nassert_eq(I64, original.n, 15)\n",
        "for mut entry in refs_copy { entry.n++ }\nassert_eq(I64, original.n, 16)\n",
        "mut ref_array := Array(ref mut Item).new(1)\nref_array.set(0, original)!\n",
        "ref mut borrowed_array: Item = ref_array[0]\nborrowed_array.n = 16\nassert_eq(I64, original.n, 16)\n",
        "mut ref_map := Map(Str, ref mut Item).new()\nref_map.set(\"item\", original)\n",
        "ref mut borrowed_map: Item = ref_map[\"item\"]\nborrowed_map.n = 17\nassert_eq(I64, original.n, 17)\n",
        "mut handles := Vec(ref mut MutableItem).new()\nhandles.push(original)\n",
        "ref mut handle: MutableItem = handles[0]\nhandle.set_value(18)\nassert_eq(I64, original.n, 18)\n",
        "mut handle_array := Array(ref mut MutableItem).new(1)\nhandle_array.set(0, original)!\n",
        "ref mut array_handle: MutableItem = handle_array[0]\narray_handle.set_value(19)\nassert_eq(I64, original.n, 19)\n",
        "mut handle_map := Map(Str, ref mut MutableItem).new()\nhandle_map.set(\"item\", original)\n",
        "ref mut map_handle: MutableItem = handle_map[\"item\"]\nmap_handle.set_value(20)\nassert_eq(I64, original.n, 20)\n",
        "mut readonly := Vec(ref Item).new()\nreadonly.push(original)\nread_copy := readonly.clone()\n",
        "ref read: Item = read_copy[0]\nassert_eq(I64, read.n, 20)\n",
        "mut readonly_array := Array(ref Item).new(1)\nreadonly_array.set(0, original)!\nref array_read: Item = readonly_array[0]\nassert_eq(I64, array_read.n, 20)\n",
        "mut readonly_map := Map(Str, ref Item).new()\nreadonly_map.set(\"item\", original)\nref map_read: Item = readonly_map[\"item\"]\nassert_eq(I64, map_read.n, 20)\n",
        "mut bounds: I64 = 0\n",
        "items.get(1)? catch (err: OutOfBounds) { bounds = bounds + 1 }\n",
        "fixed.get(1)? catch (err: OutOfBounds) { bounds = bounds + 1 }\n",
        "refs.get(1)? catch (err: OutOfBounds) { bounds = bounds + 1 }\n",
        "ref_array.get(1)? catch (err: OutOfBounds) { bounds = bounds + 1 }\n",
        "read_copy.get(1)? catch (err: OutOfBounds) { bounds = bounds + 1 }\n",
        "assert_eq(I64, bounds, 5)\n",
        "mut missing := false\nvalues.get(\"missing\")? catch (err: KeyNotFound) { missing = true }\nassert(missing)\n",
        "println(\"writable accessors passed\")\n}\n")
    File.writefile(format(root, "/writable_accessors.til"), source)
    check(Cmd.new(compiler, "interpret", format(root, "/writable_accessors.til")), "writable accessors passed\n")
    check_run(compiler, root, "writable_accessors", "writable accessors passed\n", asan)
    alternate := source.replace("Vec", "MyAltVec").replace("Array", "MyAltArray").replace("Map", "MyAltMap")
        .replace("mode cli", "mode cli\nimport(\"MyAltArray\")\nimport(\"MyAltMap\")")
    File.writefile(format(root, "/alternate_writable_accessors.til"), alternate)
    check(Cmd.new(compiler, "interpret", format(root, "/alternate_writable_accessors.til")), "writable accessors passed\n")
    check_run(compiler, root, "alternate_writable_accessors", "writable accessors passed\n", asan)
    for definition: Str in array(Str,
        "bad := func(items: Vec(Item)) returns ref mut Item { return items.get(0)! }\n",
        "bad := func(items: Array(Item)) returns ref mut Item { return items.unsafe_get(0) }\n",
        "bad := func(items: Map(Str, Item)) returns ref mut Item { return items.get(\"key\")! }\n",
        "bad := func(mut items: Vec(ref Item)) returns ref mut Item { return items[0] }\n",
        "bad := func(mut items: Vec(ref Item)) returns ref mut Item { return items.unsafe_get(0) }\n",
        "bad := func(mut items: Vec(ref Item)) returns ref mut Item { copy := items.clone(); return copy[0] }\n",
        "bad := func(mut items: Array(ref Item)) returns ref mut Item { return items[0] }\n",
        "bad := func(mut items: Array(ref Item)) returns ref mut Item { return items.unsafe_get(0) }\n",
        "bad := func(mut items: Map(Str, ref Item)) returns ref mut Item { return items[\"key\"] }\n",
        "bad := func(mut items: Vec(ref MutableItem)) returns ref mut MutableItem { return items[0] }\n") {
        reject_generic(compiler, root, format(prelude, definition, "main := proc() {}\n"), "cannot return a writable reference")
    }
    reject_generic(compiler, root, format(prelude,
        "bad := func(mut items: Vec(ref Item), index: USize) returns ref mut Item { return items[index] }\nmain := proc() {}\n"),
        "call to 'get' has no 'returns ref mut' contract")
    reject_generic(compiler, root, format(prelude,
        "bad := func(items: Vec(ref Item)) { ref mut item: Item = items[0]; item.n++ }\nmain := proc() {}\n"),
        "call to 'get' has no 'returns ref mut' contract")
    reject_generic(compiler, root, format(prelude,
        "bad := func(mut items: Vec(ref mut Item), value: Item) { items.push(value) }\nmain := proc() {}\n"),
        "cannot supply a writable reference for 'val'")
    File.writefile(format(root, "/unset_writable_array.til"), format(prelude,
        "main := proc() { items := Array(ref mut Item).new(1); ref value: Item = items[0]; println(value.n) }\n"))
    for action: Str in array(Str, "interpret", "run") {
        cmd := Cmd.new(compiler, action, format(root, "/unset_writable_array.til"))
        cmd.capture()
        status := cmd.run()
        output := format(cmd.out(), cmd.err())
        expect(status != 0, output)
        expect(output.contains("Array.get: uninitialized borrowed element"), output)
    }
}

template_ownership_checks := proc(compiler: Str, root: Str, asan: Bool) {
    File.writefile(format(root, "/template_ownership_helpers.til"), format("mode lib\n",
        "make_read := macro(T: Type) returns FuncDef { return func(items: Array(T)) returns ref T { index: USize = items.len().sub(1); if index < items.len() { return items.unsafe_get(index) }; panic(\"empty\") } }\n",
        "make_write := macro(T: Type) returns FuncDef { return func(mut items: Array(T)) returns ref mut T { index: USize = items.len().sub(1); if index < items.len() { return ptr_add(items.data, index.to_uptr().mul(T.size().to_uptr())) }; panic(\"empty\") } }\n",
        "make_value := macro(T: Type) returns FuncDef { return func() returns I64 { local := T(); return local.n } }\n",
        "Namespace := macro(T: Type) returns StructDef { return struct { namespace:\nfirst := func(items: Array(T)) returns ref T { index: USize = items.len().sub(1); return items.unsafe_get(index) } } }\n",
        "EnumNamespace := macro(T: Type) returns EnumDef { return enum { None\nnamespace:\nfirst := func(items: Array(T)) returns ref T { index: USize = items.len().sub(1); return items.unsafe_get(index) } } }\n"))
    File.writefile(format(root, "/template_ownership.til"), format("mode cli\nimport(\"template_ownership_helpers\")\n",
        "Item := struct { n: I64 = 7; label := format(\"owned\") }\n",
        "read := make_read(Item)\nwrite := make_write(Item)\nowned_reader := make_value(Item)\n",
        "ItemNamespace := Namespace(Item)\nItemEnumNamespace := EnumNamespace(Item)\n",
        "main := proc() {\nmut items := Array(Item).new(1)\nitems.set(0, own Item())!\n",
        "ref before: Item = read(items)\nassert_eq(I64, before.n, 7)\n",
        "ref mut selected: Item = write(items)\nselected.n = 9\nassert_eq(I64, items[0].n, 9)\n",
        "ref struct_result: Item = ItemNamespace.first(items)\nassert_eq(I64, struct_result.n, 9)\n",
        "ref enum_result: Item = ItemEnumNamespace.first(items)\nassert_eq(I64, enum_result.n, 9)\n",
        "assert_eq(I64, owned_reader(), 7)\nprintln(\"template ownership passed\")\n}\n"))
    check(Cmd.new(compiler, "interpret", format(root, "/template_ownership.til")), "template ownership passed\n")
    check_run(compiler, root, "template_ownership", "template ownership passed\n", asan)
    reject_generic(compiler, root, format("mode cli\nItem := struct { label := format(\"owned\") }\n",
        "make_bad := macro(T: Type) returns FuncDef { return func(own local: T) returns ref T { return local } }\n",
        "bad := make_bad(Item)\nmain := proc() {}\n"), "cannot return a reference into owned parameter")
}

private_permission_query_checks := proc(compiler: Str, root: Str, asan: Bool) {
    helpers := format("mode lib\npriv type_arg_is_ref_mut := core_func(type: Type) returns Bool {}\n",
        "PermissionProbe := macro(T: Type) returns StructDef {\n",
        "if type_arg_is_ref_mut(T) { return struct { writable := true } }\n",
        "else { return struct { writable := false } }\n}\n",
        "PermissionForward := macro(T: Type) returns StructDef { return struct { probe := PermissionProbe(T)() } }\n",
        "PermissionQuery := macro(T: Type) returns FuncDef { return func() returns Bool { return type_arg_is_ref_mut(T) } }\n",
        "PermissionReadQuery := macro(T: Type) returns FuncDef { return func() returns Bool { return type_arg_is_ref(T) } }\n")
    File.writefile(format(root, "/permission_helpers.til"), helpers)
    File.writefile(format(root, "/permission_helpers_copy.til"), helpers.replace("Permission", "OtherPermission"))
    File.writefile(format(root, "/private_permission.til"), format("mode cli\nimport(\"permission_helpers\")\nimport(\"permission_helpers_copy\")\n",
        "Alias := I64\n",
        "writable_query := PermissionQuery(ref mut Alias)\n",
        "read_query := PermissionQuery(ref Alias)\n",
        "owned_query := PermissionQuery(Alias)\n",
        "nested_query := PermissionQuery(ref mut Vec(Str))\n",
        "ordinary_ref_query := PermissionReadQuery(ref mut Alias)\n",
        "main := proc() {\n",
        "assert(writable_query())\nassert(read_query().not())\nassert(owned_query().not())\nassert(nested_query())\nassert(ordinary_ref_query())\n",
        "writable := PermissionProbe(ref mut Alias)()\nassert(writable.writable)\n",
        "readonly := PermissionProbe(ref Alias)()\nassert(readonly.writable.not())\n",
        "owned := PermissionProbe(Alias)()\nassert(owned.writable.not())\n",
        "forward_writable := PermissionForward(ref mut Alias)()\nassert(forward_writable.probe.writable)\n",
        "forward_readonly := PermissionForward(ref Alias)()\nassert(forward_readonly.probe.writable.not())\n",
        "other_writable := OtherPermissionProbe(ref mut Alias)()\nassert(other_writable.writable)\n",
        "other_readonly := OtherPermissionProbe(ref Alias)()\nassert(other_readonly.writable.not())\n",
        "println(\"private permissions passed\")\n}\n"))
    check(Cmd.new(compiler, "interpret", format(root, "/private_permission.til")), "private permissions passed\n")
    check_run(compiler, root, "private_permission", "private permissions passed\n", asan)
    File.writefile(format(root, "/private_permission_shadow.til"), format("mode cli\n",
        "priv type_arg_is_ref_mut := func(type: Type) returns Bool { return type.is(Type.Unknown).not() }\n",
        "main := proc() { assert(type_arg_is_ref_mut(I64)); println(\"ordinary private function passed\") }\n"))
    check(Cmd.new(compiler, "interpret", format(root, "/private_permission_shadow.til")), "ordinary private function passed\n")
    check_run(compiler, root, "private_permission_shadow", "ordinary private function passed\n", asan)
    reject_generic(compiler, root, format("mode cli\nimport(\"permission_helpers\")\n",
        "main := proc() { assert(type_arg_is_ref_mut(I64)) }\n"), "undefined function 'type_arg_is_ref_mut'")
    reject_generic(compiler, root, format("mode cli\npriv type_arg_is_ref_mut := core_func(type: Type) returns Bool {}\n",
        "bad := func(value: Type) returns Bool { return type_arg_is_ref_mut(value) }\nmain := proc() {}\n"),
        "type_arg_is_ref_mut requires a compile-time type argument")
}

writable_return_source_checks := proc(compiler: Str, root: Str, asan: Bool) {
    prelude := format("mode cli\nItem491 := struct { n := 0 }\n",
        "ReadHolder491 := struct { ref value: Item491 }\n",
        "WriteHolder491 := struct { const ref mut value: Item491 }\n",
        "OwnedHolder491 := struct { value := Item491() }\n",
        "ConstHolder491 := struct { const value := Item491() }\n",
        "ReadMaybe491 := enum { None, Some: ref Item491 }\n",
        "WriteMaybe491 := enum { None, const Some: ref mut Item491 }\n",
        "WriteZero491 := func() returns ref mut Item491\n",
        "ReadView491 := func(mut Item491) returns ref Item491\n",
        "WriteView491 := func(mut Item491) returns ref mut Item491\n",
        "CallbackHolder491 := struct { action: WriteView491 }\n",
        "read491 := func(value: Item491) returns ref Item491 { return value }\n",
        "write491 := func(mut value: Item491) returns ref mut Item491 { return value }\n")
    for definition : Str in array(Str,
        "bad := func(value: Item491) returns ref mut Item491 { return value }\n",
        "bad := func(mut value: Item491) returns ref mut Item491 { ref alias: Item491 = value; return alias }\n",
        "bad := func(mut value: Item491) returns ref mut Item491 { const ref mut alias: Item491 = read491(value); return alias }\n",
        "bad := func(mut holder: ReadHolder491) returns ref mut Item491 { return holder.value }\n",
        "bad := func(mut holder: ReadHolder491) returns ref mut Item491 { ref mut alias: Item491 = holder.value; return alias }\n",
        "bad := func(mut value: Item491) returns ref mut Item491 { return read491(value) }\n",
        "bad := func(mut value: Item491) returns ref mut Item491 { mut ref alias: Item491 = value; return alias }\n",
        "bad := func(mut value: Item491) returns ref mut Item491 { mut ref alias: Item491 = value; return write491(alias) }\n",
        "bad := func(mut value: Item491) returns ref mut Item491 { ref mut alias: Item491 = write491(value); alias = read491(value); return alias }\n",
        "bad := func(mut value: Item491) returns ref mut Item491 { ref mut alias: Item491 = read491(value); alias = write491(value); return alias }\n",
        "bad := func(mut holder: ReadHolder491, flag: Bool) returns ref mut Item491 { if flag { return holder.value }; while flag { return holder.value }; return holder.value }\n",
        "bad := func(mut holder: ConstHolder491) returns ref mut Item491 { return holder.value }\n",
        "bad := func(mut value: ReadMaybe491) returns ref mut Item491 { switch value { case .Some(data): return data; case: panic(\"empty\") } }\n",
        "bad := func(mut value: Item491) returns ref mut Item491 { view: ReadView491 = write491; return view(value) }\n",
        "bad := func(mut value: Item491) returns ref mut Item491 { callback: WriteZero491 = func() returns ref mut Item491 [value] { return value }; return callback() }\n",
        "bad := func(mut value: Item491) returns ref mut Item491 { return ptr_add(to_ptr(read491(value)), 0) }\n") {
        reject_generic(compiler, root, format(prelude, definition, "main := proc() {}\n"), "cannot return a writable reference")
    }
    reject_generic(compiler, root, format(prelude,
        "global_read := Item491()\nbad := func() returns ref mut Item491 { return global_read }\nmain := proc() {}\n"),
        "cannot return a writable reference")
    reject_generic(compiler, root, format(prelude,
        "ReadError491 := struct {}\nread_throw := func(value: Item491) returns ref Item491 throws ReadError491 { return value }\n",
        "bad := func(mut value: Item491) returns ref mut Item491 { return read_throw(value)! }\nmain := proc() {}\n"),
        "cannot return a writable reference")
    reject_generic(compiler, root, format("mode cli\nItem491 := struct { n := 0 }\n",
        "read := func(mut value: Item491) returns ref Item491 { return value }\nmain := proc() {}\n"),
        "redundant 'mut' on parameter 'value'")
    reject_generic(compiler, root, format(prelude,
        "redundant := func(mut holder: WriteHolder491) returns ref mut Item491 { return holder.value }\nmain := proc() {}\n"),
        "redundant 'mut' on parameter 'holder'")
    reject_generic(compiler, root, format(prelude,
        "redundant_slot := func(mut value: Item491) returns ref mut Item491 { mut ref mut alias: Item491 = value; return alias }\nmain := proc() {}\n"),
        "redundant 'mut' on local 'alias'")
    File.writefile(format(root, "/writable_returns.til"), format(prelude,
        "ReturnError491 := struct {}\n",
        "primitive491 := func(mut value: I64) returns ref mut I64 { return value }\n",
        "throwing491 := func(mut value: Item491, fail: Bool) returns ref mut Item491 throws ReturnError491 { if fail { throw ReturnError491() }; return value }\n",
        "forward_throw491 := func(mut value: Item491) returns ref mut Item491 { return throwing491(value, false)! }\n",
        "owned_field := func(mut holder: OwnedHolder491) returns ref mut Item491 { return holder.value }\n",
        "ref_field := func(holder: WriteHolder491) returns ref mut Item491 { return holder.value }\n",
        "callback_field491 := func(holder: CallbackHolder491, mut value: Item491) returns ref mut Item491 { return holder.action(value) }\n",
        "alias491 := func(mut value: Item491) returns ref mut Item491 { ref mut alias: Item491 = value; return alias }\n",
        "fixed491 := func(mut value: Item491) returns ref mut Item491 { const ref mut alias: Item491 = write491(value); return alias }\n",
        "nested491 := func(mut value: Item491, flag: Bool) returns ref mut Item491 { if flag { const ref mut alias: Item491 = value; return alias }; return value }\n",
        "payload491 := func(value: WriteMaybe491) returns ref mut Item491 { switch value { case .Some(data): return data; case: panic(\"empty\") } }\n",
        "shadow491 := func(value: WriteMaybe491) returns ref mut Item491 { switch value { case .Some(value): return value; case: panic(\"empty\") } }\n",
        "capture491 := func(mut value: Item491) returns ref mut Item491 { callback: WriteZero491 = func() returns ref mut Item491 [mut value] { return value }; return callback() }\n",
        "mut global491 := Item491()\nglobal_ref491 := func() returns ref mut Item491 { return global491 }\n",
        "const ref mut global_alias491: Item491 = global491\n",
        "global_alias_ref491 := func() returns ref mut Item491 { return global_alias491 }\n",
        "main := proc() {\nmut item := Item491()\n",
        "mut number: I64 = 0\nref mut scalar: I64 = primitive491(number)\nscalar = 9\nassert_eq(I64, number, 9)\n",
        "ref mut direct: Item491 = write491(item)\ndirect.n = 1\n",
        "ref mut alias: Item491 = alias491(item)\nalias.n = 2\n",
        "ref fixed: Item491 = fixed491(item)\nassert_eq(I64, fixed.n, 2)\n",
        "ref nested: Item491 = nested491(item, true)\nassert_eq(I64, nested.n, 2)\n",
        "ref throwing: Item491 = forward_throw491(item)\nassert_eq(I64, throwing.n, 2)\n",
        "holder := WriteHolder491(value = item)\nref field: Item491 = ref_field(holder)\nassert_eq(I64, field.n, 2)\n",
        "callback_holder := CallbackHolder491(action = write491)\nref callback_value: Item491 = callback_field491(callback_holder, item)\nassert_eq(I64, callback_value.n, 2)\n",
        "mut owned := OwnedHolder491()\nref mut inner: Item491 = owned_field(owned)\ninner.n = 3\n",
        "maybe := WriteMaybe491.Some(item)\nref payload: Item491 = payload491(maybe)\nassert_eq(I64, payload.n, 2)\n",
        "ref shadow: Item491 = shadow491(maybe)\nassert_eq(I64, shadow.n, 2)\n",
        "ref captured: Item491 = capture491(item)\nassert_eq(I64, captured.n, 2)\n",
        "ref mut global: Item491 = global_ref491()\nglobal.n = 4\n",
        "ref fixed_global: Item491 = global_alias_ref491()\nassert_eq(I64, fixed_global.n, 4)\n",
        "println(\"writable returns passed\")\n}\n"))
    check(Cmd.new(compiler, "interpret", format(root, "/writable_returns.til")), "writable returns passed\n")
    check_run(compiler, root, "writable_returns", "writable returns passed\n", asan)
}

main := proc(args: ..Str) {
    if args.len() > 3 { panic("expected compiler, optional family, and optional --asan") }
    ref compiler: Str = args[0]
    mut family := "all"
    if args.len() > 1 { family = args[1].borrowed_view() }
    // TEMPORARY (#464): sanitizer coverage is selected by the suite.
    mut asan := false
    if args.len() > 2 {
        if args[2] != "--asan" { panic("unknown qualifier test option: ", args[2]) }
        asan = true
    }
    if family.eq("all").or(family.eq("success")).or(family.eq("borrows")).or(family.eq("generics")).or(family.eq("mutable_views")).not() {
        panic("unknown qualifier test family: ", family)
    }
    mut root := "tmp/type_arg_qualifiers"
    if family != "all" { root = format(root, "_", family) }
    mkdir_p(root)
    if family != "mutable_views" { prepare_templates(root) }
    switch family {
    case "all":
        // Keep the standalone command's original case order.
        query_checks(compiler, root, asan)
        reference_permission_checks(compiler, root, asan)
        container_checks(compiler, root, asan)
        family_borrow_checks(compiler, root)
        query_error_checks(compiler, root)
        vector_borrow_checks(compiler, root)
        interface_argument_checks(compiler, root)
        generic_call_checks(compiler, root, asan)
        return_signature_checks(compiler, root, asan)
        private_permission_query_checks(compiler, root, asan)
        template_ownership_checks(compiler, root, asan)
        writable_accessor_checks(compiler, root, asan)
        capture_forwarding_checks(compiler, root, asan)
        mutable_ast_view_checks(compiler, root, asan)
        writable_return_source_checks(compiler, root, asan)
    case "success":
        query_checks(compiler, root, asan)
        reference_permission_checks(compiler, root, asan)
        container_checks(compiler, root, asan)
    case "borrows":
        family_borrow_checks(compiler, root)
        vector_borrow_checks(compiler, root)
    case "mutable_views":
        mutable_ast_view_checks(compiler, root, asan)
    case "generics":
        query_error_checks(compiler, root)
        interface_argument_checks(compiler, root)
        generic_call_checks(compiler, root, asan)
        return_signature_checks(compiler, root, asan)
        private_permission_query_checks(compiler, root, asan)
        template_ownership_checks(compiler, root, asan)
        writable_accessor_checks(compiler, root, asan)
        capture_forwarding_checks(compiler, root, asan)
        writable_return_source_checks(compiler, root, asan)
    }
    println("type argument qualifiers passed")
}
