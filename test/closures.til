mode test

// --- Block captures: scope restriction (issue #54) ---
// A bare `[names] { ... }` block limits which outer-scope locals the
// block body may touch. Captures follow parameter modifier rules:
// `[x]` is a const-by-reference capture, `[mut x]` a mutable one.
// Globals, top-level functions and types need no capture. The block
// stays inline at runtime, so the only effect is the compile-time check.

GLOBAL_SCALE := 10

helper_double := func(n: I64) returns I64 { return n.mul(2) }

// Const capture: read a captured outer local, write a captured mut local.
test_block_capture_const_read := test() {
    base := 10
    mut result := 0
    [base, mut result] {
        result = base.add(5)
    }
    assert_eq(I64, result, 15)
}

// A global is always visible without being captured.
test_block_capture_global_allowed := test() {
    mut r := 0
    [mut r] {
        r = GLOBAL_SCALE.add(2)
    }
    assert_eq(I64, r, 12)
}

// A top-level function is always callable without being captured.
test_block_capture_func_allowed := test() {
    seed := 6
    mut out := 0
    [seed, mut out] {
        out = helper_double(seed)
    }
    assert_eq(I64, out, 12)
}

// Block-local declarations are free to use inside the block.
test_block_capture_block_local := test() {
    seed := 3
    mut out := 0
    [seed, mut out] {
        doubled := seed.mul(2)
        out = doubled.add(1)
    }
    assert_eq(I64, out, 7)
}

// A for-loop inside a capture block, accumulating into a captured mut.
test_block_capture_loop := test() {
    mut total := 0
    [mut total] {
        for i in 1..4 {
            total = total.add(i)
        }
    }
    assert_eq(I64, total, 6)
}

// Nested capture blocks each restrict to their own list.
test_block_capture_nested := test() {
    a := 1
    b := 2
    mut sum := 0
    [a, b, mut sum] {
        [a, mut sum] {
            sum = sum.add(a)
        }
        sum = sum.add(b)
    }
    assert_eq(I64, sum, 3)
}

// A capture block leaves untouched outer locals genuinely untouched.
test_block_capture_isolation := test() {
    mut touched := 0
    untouched := 99
    [mut touched] {
        touched++
    }
    assert_eq(I64, touched, 1)
    assert_eq(I64, untouched, 99)
}

// #54: block capture MODES. `[x]` / `[mut x]` borrow (writes reach the outer
// binding); `[shallow x]` gives the block a PRIVATE value copy (writes stay
// inside); `[own x]` transfers the binding to the block (the enclosing scope
// stands down its cleanup and a later use is a use-after-move error, checked
// in test/capture_block_error.til).

// shallow + mut: the block writes its own copy, the outer binding is untouched.
// `mut` here describes the COPY, so the source need not be mut.
test_block_capture_shallow_private := test() {
    total := 10
    [shallow mut total] {
        total = 99
    }
    assert_eq(I64, total, 10)
}

// A shallow capture still READS the value it copied at block entry.
test_block_capture_shallow_read := test() {
    n := 7
    mut seen := 0
    [shallow n, mut seen] {
        seen = n
    }
    assert_eq(I64, seen, 7)
}

// Contrast: a `mut` BORROW capture writes through to the outer binding.
test_block_capture_mut_writes_through := test() {
    mut total := 1
    [mut total] {
        total = 42
    }
    assert_eq(I64, total, 42)
}

// A shallow capture of a heap type (Str), written inside the block: this is
// the shape #325 blocked (the private copy is reassigned to a literal and
// then moved out), fixed alongside.
test_block_capture_shallow_str := test() {
    s := "abc"
    mut out := ""
    [shallow mut s, mut out] {
        s = "zz"
        out = s
    }
    assert_eq(Str, out, "zz")
    assert_eq(Str, s, "abc")
}

// own: the block consumes the binding (owned Str; ASAN proves no leak/double
// free -- the enclosing scope must not also delete it).
test_block_capture_own := test() {
    s := "hello"
    mut n : USize = 0
    [own s, mut n] {
        n = s.len()
    }
    assert_eq(USize, n, 5)
}

// own of a struct with an owned field.
OwnBox54 := struct { name := "" }
test_block_capture_own_struct := test() {
    h := OwnBox54(name = "boxed")
    mut ln : USize = 0
    [own h, mut ln] {
        ln = h.name.len()
    }
    assert_eq(USize, ln, 5)
}

// #295: a capturing closure is first-class -- callable by its own local name,
// not only when passed through a parameter. (Previously the by-name call
// typed as 'unknown' because the initer mis-registered it as a named func.)
// Captures a runtime value (compile-time-constant captures hit a separate
// const-folding edge tracked in #295).
Adder295 := func(x: I64) returns I64
mk_base295 := func() returns I64 { return 5 }
test_capturing_closure_by_name := test() {
    base := mk_base295()
    add1 : Adder295 = func(x: I64) returns I64 [base] { return base.add(x) }
    assert_eq(I64, add1(10), 15)
    // also still works through a parameter
    apply := func(f: Adder295) returns I64 { return f(10) }
    assert_eq(I64, apply(add1), 15)
}

// #295/#262: a struct with a funcptr field, built from a constant-arg
// constructor, must not be mishandled by the const-folder (which folds a
// struct value field by field). Guards the funcptr-field const-fold path.
Thunk295 := func() returns I64
Box295 := struct { t : Thunk295 }
forty_two295 := func() returns I64 { return 42 }
test_funcptr_field_constfold := test() {
    b := Box295(t = forty_two295)
    assert_eq(I64, b.t(), 42)
}

// #223: a capturing closure returning a PRIMITIVE, passed as an arg to a
// function whose RESULT is a UFCS method receiver, must not spuriously error
// with "redundant 'shallow' on primitive return". The UFCS path re-infers its
// receiver (and thus the closure arg); the auto-shallow pass had already
// normalized the closure's Own return to Shallow, so the redundant-shallow
// check -- which now keys off the parser's explicit-shallow flag, not the
// normalized return_own_type -- stays idempotent across the re-inference.
BoolThunk223 := func() returns Bool
callthunk223 := func(f: BoolThunk223) returns Bool { return f() }
test_capturing_closure_ufcs_receiver_arg := test() {
    x := true
    expect(callthunk223(func() returns Bool [x] { return x }).not().not(), "shallow check idempotent")
}

// #346: a capturing closure's call trampoline and its FuncSig cast must agree
// with the ordinary by-value aggregate return ABI.
ClosureBox346 := struct { value := "" }
ClosureBoxMaker346 := func() returns ClosureBox346

test_capturing_closure_owned_aggregate_return := test() {
    prefix := "captured"
    make : ClosureBoxMaker346 = func() returns ClosureBox346 [prefix] {
        return ClosureBox346(value = prefix.clone())
    }
    box := make()
    assert_eq(Str, box.value, "captured")
}

ClosureOwnedBoxFn346 := func(own ClosureBox346) returns USize

make_closure_owned_box_consumer346 := func(offset: USize) returns ClosureOwnedBoxFn346 {
    return func(own box: ClosureBox346) returns USize [shallow offset] {
        return box.value.len().add(offset)
    }
}

test_capturing_closure_owned_aggregate_parameter := test() {
    consume := make_closure_owned_box_consumer346(3)
    box := ClosureBox346(value = "value")
    assert_eq(USize, consume(own box), 8)
}
