mode cli

import("../src/std/sys")
import("../src/std/file")
import("../src/self/install")

// One central build prerequisite creates the native libraries and ASAN host.
// Normal suite jobs then run families synchronously in fresh processes with
// private library copies, guest directories and HOME.

realpath_str := ext_proc(path: Str) returns Str {}

native_fixture_known := func(fixture: Str) returns Bool {
    return fixture.eq("tilvm_native").or(fixture.eq("tilvm_native_state"))
        .or(fixture.eq("tilvm_native_config")).or(fixture.eq("tilvm_native_prelude"))
        .or(fixture.eq("tilvm_native_reload"))
}

check_native_output := func(fixture: Str, output: Str, errors: Str) {
    state_family := fixture.eq("tilvm_native").or(fixture.eq("tilvm_native_state"))
    prelude_family := fixture.eq("tilvm_native").or(fixture.eq("tilvm_native_prelude"))
    reload_family := fixture.eq("tilvm_native").or(fixture.eq("tilvm_native_reload"))
    config_family := fixture.eq("tilvm_native").or(fixture.eq("tilvm_native_config"))
    if native_fixture_known(fixture).not() { panic("unknown native TilVm fixture: ", fixture) }
    if state_family.and(output.contains("installed native TilVm shared state PASS: 41 -> 48").not()) {
        panic("native TilVm did not finish: ", output, errors)
    }
    if reload_family.and(output.contains("installed TilVm text buffer and reload PASS").not()) {
        panic("native TilVm buffer/reload test did not finish: ", output, errors)
    }
    if config_family.and(output.contains("installed TilVm mutable native config PASS").not()) {
        panic("native TilVm config test did not finish: ", output, errors)
    }
    if prelude_family.and(output.contains("installed TilVm host prelude PASS").not()) {
        panic("native TilVm prelude test did not finish: ", output, errors)
    }
    if prelude_family.and(output.contains("installed TilVm native enum PASS").not()) {
        panic("native TilVm enum test did not finish: ", output, errors)
    }
}

run_native_family := proc(work: Str, fixture: Str, family: Str) {
    directory := format(work, "/", family)
    File.remove_tree(directory)
    mkdir_p(format(directory, "/gen/til"))
    mkdir_p(format(directory, "/home"))
    File.writefile(format(directory, "/gen/til/vm_native.til"), File.readfile(format(work, "/gen/til/vm_native.til")))
    // Keep bindings and relative paths intact. Host and guest must load the
    // SAME private library copies, or they would see different native globals.
    assert_eq(I32, copy_tree(format(work, "/gen/lib"), format(directory, "/gen/lib")), 0)
    assert_eq(I32, copy_tree(format(work, "/bin"), format(directory, "/bin")), 0)
    library_dir := realpath_str(format(directory, "/gen/lib"))
    child := Cmd.new("./bin/tilvm_native", format("../../install_", fixture, "/lib/til"), family)
    child.cwd(directory)
    child.env("PATH", "")
    child.env("HOME", realpath_str(format(directory, "/home")))
    child.env("LD_LIBRARY_PATH", library_dir)
    child.env("DYLD_LIBRARY_PATH", library_dir)
    child.capture()
    if child.run() != 0 { panic("installed native TilVm ", family, " failed: ", child.out(), child.err()) }
    check_native_output(format("tilvm_native_", family), child.out(), child.err())
    println("install TilVm native ", family, " PASS")
}

main := proc(args: ..Str) returns I64 {
    if args.len() > 3 { panic("expected fixture, optional build/family action, and optional --asan") }
    mut fixture := "tilvm_native"
    mut action := "all"
    // TEMPORARY (#464): libraries and host inherit explicit suite ASAN mode.
    mut asan := false
    if args.len() > 0 { fixture = args[0].borrowed_view() }
    if args.len() > 1 { action = args[1].borrowed_view() }
    if args.len() > 2 {
        if args[2] != "--asan" { panic("unknown native TilVm build option: ", args[2]) }
        asan = true
    }
    if native_fixture_known(fixture).not() { panic("unknown native TilVm fixture: ", fixture) }
    prefix := format("tmp/install_", fixture)
    work := format(prefix, "_work")
    if action.eq("all").or(action.eq("build")).not() {
        if fixture != "tilvm_native" { panic("family action requires the shared native TilVm host") }
        switch action {
        case "state", "config", "prelude", "reload":
            run_native_family(work, fixture, action)
            return 0
        case: panic("unknown native TilVm family: ", action)
        }
    }
    File.remove_tree(prefix)
    File.remove_tree(work)
    mkdir_p(work)
    if install_executable("bin/til", format(prefix, "/bin/til"), ".", prefix) != 0 {
        panic("copy-only TilVm compiler installation failed")
    }
    installed_til := format("../install_", fixture, "/bin/til")

    // A prebuilt Til library, consumed through its generated bindings by BOTH
    // the compiled host and the guest. Library construction is a test setup
    // step; runtime loading must work with an empty PATH.
    File.writefile(format(work, "/vm_native.til"), format(
        "mode lib\nmut native_counter : I64 = 0\n",
        "native_set := proc(value: I64) { noop_proc(); native_counter = value }\n",
        "native_increment := proc() { noop_proc(); native_counter++ }\n",
        "native_get := proc() returns I64 { noop_proc(); return native_counter }\n",
        "native_echo := func(value: Str) returns Str { return value.clone() }\n",
        "priv mut native_buffer := \"\"\n",
        "native_buffer_set := proc(text: Str) { noop_proc(); native_buffer = text.clone() }\n",
        "native_buffer_insert := proc(text: Str) { noop_proc(); native_buffer = format(native_buffer, text) }\n",
        "native_buffer_snapshot := proc() returns Str { noop_proc(); return native_buffer.clone() }\n",
        "NativeConfig := struct { width : I32 = 640; enabled := false; title := \"\" }\n",
        "mut native_config_state := NativeConfig()\n",
        "native_config_ref := proc() returns ref NativeConfig { noop_proc(); return native_config_state }\n",
        "native_config_identity := proc(mut value: NativeConfig) returns ref NativeConfig { noop_proc(); value.width++; return value }\n",
        "native_config_reset := proc() { noop_proc(); native_config_state = NativeConfig(title = format(\"host \", \"title\")) }\n",
        "native_config_take := proc(own title: Str) { noop_proc(); native_config_state.title = title }\n",
        "NativeChoice := enum { Empty, Number: I64, Real: F64, Text: Str, Config: NativeConfig }\n",
        "NativeMaybeConfig := enum { None, Some: NativeConfig }\n",
        "NativeAction := proc()\nNativeCallableChoice := enum { None, Action: NativeAction }\n",
        "native_callable_choice := func() returns NativeCallableChoice { return NativeCallableChoice.None }\n",
        "mut native_choice_state := NativeChoice.Empty\nmut native_maybe_state := NativeMaybeConfig.None\n",
        "native_choice_echo := func(shallow value: NativeChoice) returns NativeChoice { return value.clone() }\n",
        "native_choice_store := proc(own value: NativeChoice) { noop_proc(); native_choice_state = value }\n",
        "native_maybe_store := proc(own value: NativeMaybeConfig) { noop_proc(); native_maybe_state = value }\n",
        "native_choice_title := proc() returns Str { noop_proc(); switch native_choice_state { case .Config(value): return value.title.clone(); case: panic(\"not config\") } }\n",
        "native_maybe_title := proc() returns Str { noop_proc(); switch native_maybe_state { case .Some(value): return value.title.clone(); case: panic(\"no config\") } }\n",
        "native_enum_reset := proc() { noop_proc(); native_choice_state = NativeChoice.Empty; native_maybe_state = NativeMaybeConfig.None }\n",
        "NativeError := struct { code : I64 = 0 }\n",
        "native_fail := func() throws NativeError { throw NativeError(code = 7) }\n"))
    // Match the host, libraries and plugin's toolchain, including ASAN runtime.
    native_build := Cmd.new(installed_til, "build", "--cc=clang")
    if asan { native_build.arg("--asan") }
    native_build.arg("vm_native.til")
    native_build.cwd(work)
    native_build.run_checked()
    File.writefile(format(work, "/vm_plugin.til"),
        "mode lib\nplugin_value := func() returns I64 { return 73 }\n")
    plugin_build := Cmd.new(installed_til, "build", "--cc=clang")
    if asan { plugin_build.arg("--asan") }
    plugin_build.arg("vm_plugin.til")
    plugin_build.cwd(work)
    plugin_build.run_checked()
    // Force shared linking on platforms where a .a would otherwise take
    // precedence over the DLL; two static/dynamic copies are not shared state.
    File.remove(format(work, "/gen/lib/libvm_native.a"))
    library_dir := realpath_str(format(work, "/gen/lib"))
    File.writefile(format(work, "/tilvm_native_cases.til"), File.readfile("test/tilvm_native_cases.til"))
    File.writefile(format(work, "/tilvm_native.til"), File.readfile(format("test/", fixture, ".til")))
    native_host := Cmd.new(installed_til, "build", "--cc=clang")
    if asan { native_host.arg("--asan") }
    native_host.args("-o", "bin/tilvm_native", "tilvm_native.til")
    native_host.cwd(work)
    native_host.env("LIBRARY_PATH", library_dir)
    native_host.run_checked()
    // Windows searches the executable directory with PATH empty. Copy the
    // fixture's DLLs (and matching core/runtime dependencies) alongside it.
    if host_os() == "windows" {
        assert_eq(I32, copy_tree(format(work, "/gen/lib"), format(work, "/bin")), 0)
    }
    if action == "build" {
        println("install TilVm native build PASS")
        return 0
    }
    native_run := Cmd.new("./bin/tilvm_native", format("../install_", fixture, "/lib/til"))
    native_run.cwd(work)
    native_run.env("PATH", "")
    mkdir_p(format(work, "/home"))
    native_run.env("HOME", realpath_str(format(work, "/home")))
    native_run.env("LD_LIBRARY_PATH", library_dir)
    native_run.env("DYLD_LIBRARY_PATH", library_dir)
    native_run.capture()
    if native_run.run() != 0 { panic("installed native TilVm failed: ", native_run.out(), native_run.err()) }
    check_native_output(fixture, native_run.out(), native_run.err())
    println("install TilVm native PASS")
    return 0
}
