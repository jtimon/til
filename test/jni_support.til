mode lib

// #463: the JVM half of the generated-binding checks, shared by test/jni.til,
// test/library_namespace.til and test/install.til: find the JDK, build a
// library with `til build --jni`, compile Java callers against its jar, and
// run them.

import("../src/std/sys")
import("../src/std/file")

// APK checks are optional on SDK-less producers. A configured SDK is not an
// excuse to skip broken/missing tools: the ordinary build validates those.
android_apk_sdk := proc() returns Str {
    configured := get_env("ANDROID_HOME")
    if configured.len() > 0 {
        if File.is_dir(configured).not() { panic("ANDROID_HOME is not a directory: ", configured) }
        return configured
    }
    mut sdk := format(get_env("HOME"), "/Android/Sdk")
    if host_os() == "macos" { sdk = format(get_env("HOME"), "/Library/Android/sdk") }
    if File.is_dir(sdk) { return sdk }
    return ""
}

android_apk_stage := func(c_path: Str, target: Str, width: Str) returns Str {
    return format(c_path.strip_suffix(".c"), "_android/", target, "/U", width)
}

// The cross-build producers and the runtime test build independently with
// the same relative C path (part of the native library's debug info).
android_smoke_stage := func(width: Str) returns Str { return format("tmp/android_smoke/U", width) }

// The signed apk at stem.apk is the one passed to adb. Hash the exact
// aligned file that apksigner consumed, before the per-job key matters.
build_checkers_record := proc(compiler: Str, target: Str, width: Str, level: Str) returns Str {
    stage := android_smoke_stage(width)
    if mkdir_p(stage) != 0 { panic("cannot create ", stage) }
    c_path := format(stage, "/checkers.c")
    Cmd.new(compiler, "build", "--force-rebuild", format("--target=", target), format("--usize=", width),
        "-o", format(stage, "/checkers.apk"), "-c", c_path, "examples/checkers.til").run_checked()
    payload := format(android_apk_stage(c_path, target, width), "/aligned.apk")
    mut hash := Cmd.new("sha256sum")
    if host_os() == "macos" { hash = Cmd.new("shasum", "-a", "256") }
    hash.arg(payload)
    hash.capture_out()
    hash.run_checked()
    words := hash.out().split(" ")
    digest := words[0].clone()
    if digest.len() != 64 { panic("invalid SHA-256 for ", payload, ": ", digest) }
    return format(digest, " ", level, " ", target, " c ", width, " examples/checkers.til aligned.apk")
}

android_apk_inputs := proc(sdk: Str) {
    println("APK SDK: ", sdk)
    for kind : Str in array(Str, "build-tools", "platforms") {
        for name : Str in Dir.list(format(sdk, "/", kind)) {
            properties := format(sdk, "/", kind, "/", name, "/source.properties")
            if File.is_file(properties) { println(kind, "/", name, ":\n", File.readfile(properties)) }
        }
    }
    java := Cmd.new(format(jni_java_home(), "/bin/java"), "-version")
    java.capture()
    if java.run() != 0 { panic("cannot record APK JDK: ", java.err()) }
    println(java.out(), java.err())
    println("Local signed-APK comparisons share ", get_env("HOME"), "/.android/debug.keystore")
    println("Cross-producer APK comparison: exact aligned, unsigned payload")
}

// The JDK the checks use: $JAVA_HOME, else the one the javac on PATH belongs
// to (on macOS, /usr/libexec/java_home's answer). The suite needs a JDK the
// way library_namespace needs python3: without one the test fails.
jni_java_home := proc() returns Str {
    from_env := get_env("JAVA_HOME")
    if from_env.len() > 0 { return from_env }
    if host_os() == "macos" {
        mac := Cmd.new("/usr/libexec/java_home")
        mac.capture_out()
        if mac.run() != 0 { panic("JVM check: no JDK found; install one or set JAVA_HOME") }
        return mac.out().trim().clone()
    }
    which := Cmd.new("sh", "-c", "readlink -f \"$(command -v javac)\"")
    which.capture_out()
    if which.run() != 0 { panic("JVM check: no JDK found; set JAVA_HOME or put javac on PATH") }
    javac := which.out().trim().clone()
    if javac.ends_with("/bin/javac").not() { panic("JVM check: unexpected javac location: ", javac) }
    return javac.strip_suffix("/bin/javac").clone()
}

// `til build --jni`: the library, its bridge (gen/lib/lib<name>_jni) and
// its jar (gen/lib/<name>.jar, carrying both and the til runtime); `asan`
// builds them sanitized for the leak run.
jni_til_build := proc(source: Str, asan: Bool) {
    cmd := Cmd.new("bin/til", "build")
    if asan { cmd.arg("--asan") }
    cmd.args("--jni", source)
    cmd.run_checked()
}

// A Java caller compiled against the binding's jar, at --release 8 like the
// binding; -Xlint:-options mutes the JDK's notice about release 8. The
// callers are UTF-8 (JniLibTest's jni_str_len argument), and javac otherwise
// reads them in the platform's charset: windows-1252 on Windows, where
// jni_str_len then counted 8 bytes for that 6-byte word (CI run 3186).
jni_javac := proc(java_home: Str, classes: Str, jar: Str, sources: ..Str) {
    File.remove_tree(classes)
    cmd := Cmd.new(format(java_home, "/bin/javac"), "--release", "8", "-encoding", "UTF-8", "-Xlint:all", "-Xlint:-options",
        "-Werror", "-cp", jar, "-d", classes)
    for source : Str in sources { cmd.arg(source) }
    cmd.run_checked()
}

// A java -cp value: Windows separates the entries with ';', every other
// host with ':'.
jni_class_path := proc(entries: ..Str) returns Str {
    mut sep := ":"
    if host_os() == "windows" { sep = ";" }
    mut out := ""
    for entry : Str in entries {
        if out.len() > 0 { out = format(out, sep) }
        out = format(out, entry)
    }
    return out
}

// What a Java program printed, its lines ended with "\n": println ends
// them with line.separator, which is CR LF on Windows.
jni_lines := proc(out: Str) returns Str {
    if host_os() == "windows" { return out.replace("\r\n", "\n") }
    return out.clone()
}

// No java.library.path: the binding loads the natives its jar carries.
jni_run := proc(java_home: Str, class_path: Str, main_class: Str) returns Str {
    run := Cmd.new(format(java_home, "/bin/java"), "-Xcheck:jni", "-cp", class_path, main_class)
    run.capture_out()
    if run.run() != 0 { panic(main_class, " failed:\n", run.out()) }
    return jni_lines(run.out())
}

// The caller again with the library and bridge built with --asan: the
// cage's exit-time report fails the run if anything til allocated is left
// unreachable. LeakSanitizer itself is pointed away from the JVM's own
// allocations, which it cannot tell from leaks. Linux only: preloading
// libasan into the JVM is how the sanitizer gets in, and macOS's signed JDK
// launchers drop injected libraries.
jni_run_asan := proc(java_home: Str, class_path: Str, main_class: Str) returns Str {
    find := Cmd.new("cc", "-print-file-name=libasan.so")
    find.capture_out()
    if find.run() != 0 { panic("cc cannot locate libasan.so") }
    // One suppressions file per caller: the two tests run concurrently.
    // libzip.so: JDK 17 leaves the native state of java.util.zip.Inflater
    // objects (reading the jar) to a Cleaner that never runs before exit, so
    // LeakSanitizer reports 40040 bytes from Java_java_util_zip_Inflater_*
    // (CI's Temurin 17; JDK 21 frees them).
    supp := format("tmp/", main_class, ".lsan.supp")
    File.writefile(supp, "leak:libjvm.so\nleak:libjli.so\nleak:libjava.so\nleak:libzip.so\n")
    run := Cmd.new(format(java_home, "/bin/java"), "-cp", class_path, main_class)
    run.env("LD_PRELOAD", find.out().trim())
    run.env("ASAN_OPTIONS", "detect_leaks=1:handle_segv=0:allow_user_segv_handler=1:detect_odr_violation=0")
    run.env("LSAN_OPTIONS", format("suppressions=", supp, ":print_suppressions=0"))
    run.capture_out()
    if run.run() != 0 { panic(main_class, " failed under ASAN:\n", run.out()) }
    return run.out()
}
