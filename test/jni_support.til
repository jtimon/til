mode lib

// #463: the JVM half of the generated-binding checks, shared by test/jni.til
// and test/library_namespace.til: find the JDK, build a library's JNI bridge
// with the command doc/ffi.org documents, compile Java callers, and run them.

import("../src/std/sys")
import("../src/std/file")

// The JDK the checks use: $JAVA_HOME, else the one the javac on PATH belongs
// to (on macOS, /usr/libexec/java_home's answer). The suite needs a JDK the
// way library_namespace needs python3: without one the test fails.
jni_java_home := proc() returns Str {
    from_env := get_env("JAVA_HOME")
    if from_env.len() > 0 { return from_env }
    if host_os() == "macos" {
        mac := Cmd.new("/usr/libexec/java_home")
        mac.capture_out()
        if mac.run() != 0 { panic("JVM check: no JDK found; install one or set JAVA_HOME") }
        return mac.out().trim().clone()
    }
    which := Cmd.new("sh", "-c", "readlink -f \"$(command -v javac)\"")
    which.capture_out()
    if which.run() != 0 { panic("JVM check: no JDK found; set JAVA_HOME or put javac on PATH") }
    javac := which.out().trim().clone()
    if javac.ends_with("/bin/javac").not() { panic("JVM check: unexpected javac location: ", javac) }
    return javac.strip_suffix("/bin/javac").clone()
}

// lib<name>_jni next to lib<name> in gen/lib, as doc/ffi.org builds it;
// `asan` adds -fsanitize=address for the leak run.
jni_build_bridge := proc(java_home: Str, name: Str, asan: Bool) {
    mut os_include := "linux"
    mut shared_ext := ".so"
    mut origin := "$ORIGIN"
    if host_os() == "macos" {
        os_include = "darwin"
        shared_ext = ".dylib"
        origin = "@loader_path"
    }
    // -fsigned-char: ext.h requires it, as on every til compile (plain char
    // is unsigned on arm64 Linux).
    cmd := Cmd.new("cc", "-Wall", "-Wextra", "-Werror", "-fsigned-char", "-shared", "-fPIC")
    if asan { cmd.arg("-fsanitize=address") }
    cmd.args(format("-I", java_home, "/include"), format("-I", java_home, "/include/", os_include),
        "-Igen/til", "-Isrc/self/codegen", format("gen/til/", name, "_jni.c"), "-Lgen/lib", format("-l", name),
        format("-Wl,-rpath,", origin), "-o", format("gen/lib/lib", name, "_jni", shared_ext))
    // Mach-O binds each symbol to a named library: the bridge's calls into
    // the til runtime (allocator, cage) resolve at load time from the
    // libraries lib<name> brings in, as ELF does by default.
    if host_os() == "macos" { cmd.arg("-Wl,-undefined,dynamic_lookup") }
    cmd.run_checked()
}

// --release 8: the generated classes stay usable from every JVM toolchain
// (doc/ffi.org); -Xlint:-options mutes the JDK's notice about release 8.
jni_javac := proc(java_home: Str, classes: Str, sources: ..Str) {
    File.remove_tree(classes)
    cmd := Cmd.new(format(java_home, "/bin/javac"), "--release", "8", "-Xlint:all", "-Xlint:-options",
        "-Werror", "-d", classes)
    for source : Str in sources { cmd.arg(source) }
    cmd.run_checked()
}

jni_run := proc(java_home: Str, classes: Str, main_class: Str) returns Str {
    run := Cmd.new(format(java_home, "/bin/java"), "-Xcheck:jni", "-Djava.library.path=gen/lib",
        "-cp", classes, main_class)
    run.capture_out()
    if run.run() != 0 { panic(main_class, " failed:\n", run.out()) }
    return run.out()
}

// The caller again with the library and bridge built with --asan: the
// cage's exit-time report fails the run if anything til allocated is left
// unreachable. LeakSanitizer itself is pointed away from the JVM's own
// allocations, which it cannot tell from leaks. Linux only: preloading
// libasan into the JVM is how the sanitizer gets in, and macOS's signed JDK
// launchers drop injected libraries.
jni_run_asan := proc(java_home: Str, classes: Str, main_class: Str) returns Str {
    find := Cmd.new("cc", "-print-file-name=libasan.so")
    find.capture_out()
    if find.run() != 0 { panic("cc cannot locate libasan.so") }
    // One suppressions file per caller: the two tests run concurrently.
    supp := format("tmp/", main_class, ".lsan.supp")
    File.writefile(supp, "leak:libjvm.so\nleak:libjli.so\nleak:libjava.so\n")
    run := Cmd.new(format(java_home, "/bin/java"), "-Djava.library.path=gen/lib", "-cp", classes, main_class)
    run.env("LD_PRELOAD", find.out().trim())
    run.env("ASAN_OPTIONS", "detect_leaks=1:handle_segv=0:allow_user_segv_handler=1:detect_odr_violation=0")
    run.env("LSAN_OPTIONS", format("suppressions=", supp, ":print_suppressions=0"))
    run.capture_out()
    if run.run() != 0 { panic(main_class, " failed under ASAN:\n", run.out()) }
    return run.out()
}
