mode lib

// #463: the JVM half of the generated-binding checks, shared by test/jni.til,
// test/library_namespace.til and test/install.til: find the JDK, build a
// library with `til build --jni`, compile Java callers against its jar, and
// run them.

import("../src/std/sys")
import("../src/std/file")

// The JDK the checks use: $JAVA_HOME, else the one the javac on PATH belongs
// to (on macOS, /usr/libexec/java_home's answer). The suite needs a JDK the
// way library_namespace needs python3: without one the test fails.
jni_java_home := proc() returns Str {
    from_env := get_env("JAVA_HOME")
    if from_env.len() > 0 { return from_env }
    if host_os() == "macos" {
        mac := Cmd.new("/usr/libexec/java_home")
        mac.capture_out()
        if mac.run() != 0 { panic("JVM check: no JDK found; install one or set JAVA_HOME") }
        return mac.out().trim().clone()
    }
    which := Cmd.new("sh", "-c", "readlink -f \"$(command -v javac)\"")
    which.capture_out()
    if which.run() != 0 { panic("JVM check: no JDK found; set JAVA_HOME or put javac on PATH") }
    javac := which.out().trim().clone()
    if javac.ends_with("/bin/javac").not() { panic("JVM check: unexpected javac location: ", javac) }
    return javac.strip_suffix("/bin/javac").clone()
}

// `til build --jni`: the library, its bridge (gen/lib/lib<name>_jni) and
// its jar (gen/lib/<name>.jar, carrying both and the til runtime); `asan`
// builds them sanitized for the leak run.
jni_til_build := proc(source: Str, asan: Bool) {
    cmd := Cmd.new("bin/til", "build")
    if asan { cmd.arg("--asan") }
    cmd.args("--jni", source)
    cmd.run_checked()
}

// A Java caller compiled against the binding's jar, at --release 8 like the
// binding; -Xlint:-options mutes the JDK's notice about release 8.
jni_javac := proc(java_home: Str, classes: Str, jar: Str, sources: ..Str) {
    File.remove_tree(classes)
    cmd := Cmd.new(format(java_home, "/bin/javac"), "--release", "8", "-Xlint:all", "-Xlint:-options",
        "-Werror", "-cp", jar, "-d", classes)
    for source : Str in sources { cmd.arg(source) }
    cmd.run_checked()
}

// No java.library.path: the binding loads the natives its jar carries.
jni_run := proc(java_home: Str, class_path: Str, main_class: Str) returns Str {
    run := Cmd.new(format(java_home, "/bin/java"), "-Xcheck:jni", "-cp", class_path, main_class)
    run.capture_out()
    if run.run() != 0 { panic(main_class, " failed:\n", run.out()) }
    return run.out()
}

// The caller again with the library and bridge built with --asan: the
// cage's exit-time report fails the run if anything til allocated is left
// unreachable. LeakSanitizer itself is pointed away from the JVM's own
// allocations, which it cannot tell from leaks. Linux only: preloading
// libasan into the JVM is how the sanitizer gets in, and macOS's signed JDK
// launchers drop injected libraries.
jni_run_asan := proc(java_home: Str, class_path: Str, main_class: Str) returns Str {
    find := Cmd.new("cc", "-print-file-name=libasan.so")
    find.capture_out()
    if find.run() != 0 { panic("cc cannot locate libasan.so") }
    // One suppressions file per caller: the two tests run concurrently.
    // libzip.so: JDK 17 leaves the native state of java.util.zip.Inflater
    // objects (reading the jar) to a Cleaner that never runs before exit, so
    // LeakSanitizer reports 40040 bytes from Java_java_util_zip_Inflater_*
    // (CI's Temurin 17; JDK 21 frees them).
    supp := format("tmp/", main_class, ".lsan.supp")
    File.writefile(supp, "leak:libjvm.so\nleak:libjli.so\nleak:libjava.so\nleak:libzip.so\n")
    run := Cmd.new(format(java_home, "/bin/java"), "-cp", class_path, main_class)
    run.env("LD_PRELOAD", find.out().trim())
    run.env("ASAN_OPTIONS", "detect_leaks=1:handle_segv=0:allow_user_segv_handler=1:detect_odr_violation=0")
    run.env("LSAN_OPTIONS", format("suppressions=", supp, ":print_suppressions=0"))
    run.capture_out()
    if run.run() != 0 { panic(main_class, " failed under ASAN:\n", run.out()) }
    return run.out()
}
