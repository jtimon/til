mode cli

import("../src/std/sys")
import("../src/std/file")
import("../src/self/install")

// Installed API rejection checks run independently of the two ASAN hosts.
// Each driver owns its installation and scratch files so cleanup cannot race.
PREFIX := "tmp/install_tilvm_errors"
WORK := "tmp/install_tilvm_errors_work"

main := proc() returns I64 {
    File.remove_tree(PREFIX)
    File.remove_tree(WORK)
    mkdir_p(WORK)
    if install_executable("bin/til", format(PREFIX, "/bin/til"), ".", PREFIX) != 0 {
        panic("copy-only TilVm compiler installation failed")
    }
    installed_til := "../install_tilvm_errors/bin/til"

    // Load and type the installed SDK once for all three privacy rejections.
    // Separate functions keep each case's VM/callback lifetime independent.
    File.writefile(format(WORK, "/tilvm_private.til"), format(
        "mode cli\nimport(\"std/tilvm\")\n",
        "reject_vm_close := func(root: Str) {\n",
        "    mut vm := TilVm.new(root)\n    vm.close()\n}\n",
        "reject_vm_clone := func(root: Str) {\n",
        "    vm := TilVm.new(root)\n    vm.clone()\n}\n",
        "reject_callback_close := proc(root: Str) {\n",
        "    mut vm := TilVm.new(root)\n    vm.load_file(\"guest.til\")!\n",
        "    mut callback := vm.lookup(\"on_key\")!\n    callback.close()\n}\n",
        "main := proc(root: Str) {\n",
        "    reject_vm_close(root)\n    reject_vm_clone(root)\n    reject_callback_close(root)\n}\n"))
    private_build := Cmd.new(installed_til, "build", "tilvm_private.til")
    private_build.cwd(WORK)
    private_build.capture()
    if private_build.run() == 0 { panic("TilVm private-member violations compiled") }
    for member : Str in vec(Str, "TilVm.close", "TilVm.clone", "TilVmCallback.close") {
        diagnostic := format("'", member, "' is private to its struct")
        if private_build.out().contains(diagnostic).not() {
            panic("TilVm private-member rejection missing: ", diagnostic, "\n", private_build.out(), private_build.err())
        }
    }
    if private_build.out().split(": error: ").len() != 4 {
        panic("expected three TilVm private-member errors: ", private_build.out(), private_build.err())
    }

    File.writefile(format(WORK, "/tilvm_lifetime_error.til"), File.readfile("test/tilvm_lifetime_error.til"))
    lifetime_build := Cmd.new(installed_til, "build", "tilvm_lifetime_error.til")
    lifetime_build.cwd(WORK)
    lifetime_build.capture()
    if lifetime_build.run() == 0 { panic("callback lifetime violations compiled") }
    for diagnostic : Str in vec(Str, "cannot return a borrow of local 'vm'", "use of 'vm' after ownership transfer", "use of 'callback' after ownership transfer", "use of 'second' after ownership transfer", "cannot reassign 'vm'",
        "cannot return a borrow of local 'shared_vm'", "use of 'shared_vm' after ownership transfer", "cannot reassign 'shared_vm'") {
        if lifetime_build.out().contains(diagnostic).not() {
            panic("callback lifetime diagnostic missing: ", diagnostic, "\n", lifetime_build.out(), lifetime_build.err())
        }
    }
    if lifetime_build.out().split(": error: ").len() != 11 {
        panic("expected ten callback/cell lifetime errors: ", lifetime_build.out(), lifetime_build.err())
    }

    println("install TilVm errors PASS")
    return 0
}
