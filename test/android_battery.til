mode gui

import("../src/std/android_jni")

// Android's native logger is only the output channel for the smoke driver.
__android_log_write := ext_proc(shallow priority: I32, tag: I8, text: I8) returns shallow I32 {}

main := proc() {
    AndroidJni.with_frame(proc() {
        battery := AndroidJni.find_class("android/os/BatteryManager")
        manager := AndroidJni.call_object(AndroidJni.activity(), "getSystemService", "(Ljava/lang/Class;)Ljava/lang/Object;", battery)
        if manager.is_null() { panic("BatteryManager service not available") }
        property := AndroidJni.static_int(battery, "BATTERY_PROPERTY_CAPACITY")
        capacity := AndroidJni.call_int(manager, "getIntProperty", "(I)I", property)
        if capacity < 0 || capacity > 100 { panic("invalid BatteryManager capacity: ", capacity.to_str()) }
        message := format("BatteryManager capacity: ", capacity.to_str())
        __android_log_write(4, "TilAndroidSmoke".c_str, message.c_str)
    })
}
