mode cli
import("../src/std/sys")
import("../src/std/file")
import("../src/self/targets")
realpath_str := ext_proc(path: Str) returns Str {}

main := proc(compiler_arg: Str) {
    compiler := realpath_str(compiler_arg)
    work := "tmp/mlir_options"
    mkdir_p(work)
    File.writefile(format(work, "/add.til"), "mode pure\nF4 := Simd(F32,4)\nadd := func(a: F4, b: F4) returns F4 { return a + b }\n")
    if detect_current_target().is(Target.LinuxX64) {
        command := Cmd.new(compiler, "translate", "--backend=mlir", "add.til")
        command.cwd(work).capture()
        status := command.run()
        expect(status == 0, command.out(), command.err())
        ir := File.readfile(format(work, "/gen/mlir/add.mlir"))
        expect(ir.contains("arith.addf"), ir)
        expect(ir.contains("vector<4xf32>"), ir)
        expect(ir.contains("llvm.insertvalue"), ir)
        File.writefile(format(work, "/ops.til"), "mode pure\nF4 := Simd(F32,4)\ndot := func(a: F4,b: F4) returns F32 { return (a*b).reduce_add() }\nmake := func(a: F32,b: F32,c: F32,d: F32) returns F4 { return F4.new(a,b,c,d) }\nsplat := func(a: F32) returns F4 { return F4.splat(a) }\nlane := func(a: F4) returns F32 { return a[2] }\n")
        File.writefile(format(work, "/flow.til"), "mode pure\ncount := func(n: USize) returns USize { mut i: USize = 0; mut total: USize = 0; while i < n { i++; if i == 2 { continue }; total = total + i; if total > 100 { break } }; return total }\n")
        File.writefile(format(work, "/buffers.til"), "mode pure\nF4 := Simd(F32,4)\nload_values := func(a: Array(F32),i: USize) returns F4 throws OutOfBounds { return F4.load(a,i)? }\nstore_values := func(mut a: Array(F32),i: USize,v: F4) throws OutOfBounds { v.store(a,i)? }\nscalar_read := func(a: Array(F32),i: USize) returns F32 throws OutOfBounds { ref value: F32 = a.get(i)?; return value.clone() }\n")
        File.writefile(format(work, "/masks.til"), "mode pure\nF4:=Simd(F32,4)\nM4:=Simd(Bool,4)\ncompare:=func(a:F4,b:F4) returns M4 { return a!=b }\nchoose:=func(m:M4,a:F4,b:F4) returns F4 { return F4.select(m,a,b) }\nevery:=func(m:M4) returns Bool { return m.all() }\n")
        File.writefile(format(work, "/strings.til"), "mode lib\ndecorate:=func(s:Str) returns Str {return format(\"[\",s,\"]\")}\n")
        File.writefile(format(work, "/extrema.til"), "mode pure\nF4:=Simd(F32,4)\nS4:=Simd(I32,4)\nU4:=Simd(U32,4)\nfmin:=func(a:F4) returns F32 {return a.reduce_min()}\nfmax:=func(a:F4) returns F32 {return a.reduce_max()}\nsmin:=func(a:S4) returns I32 {return a.reduce_min()}\nsmax:=func(a:S4) returns I32 {return a.reduce_max()}\numin:=func(a:U4) returns U32 {return a.reduce_min()}\numax:=func(a:U4) returns U32 {return a.reduce_max()}\n")
        File.writefile(format(work, "/integer_vectors.til"), "mode pure\nS4:=Simd(I32,4)\nU4:=Simd(U32,4)\nM4:=Simd(Bool,4)\nsigned_div:=func(a:S4,b:S4) returns S4 {return a/b}\nunsigned_div:=func(a:U4,b:U4) returns U4 {return a/b}\nsigned_less:=func(a:S4,b:S4) returns M4 {return a<b}\nunsigned_less:=func(a:U4,b:U4) returns M4 {return a<b}\nload:=func(a:Array(I32),i:USize) returns S4 throws OutOfBounds {return S4.load(a,i)?}\n")
        for width in array(Str, "32", "64") {
            extrema := Cmd.new(compiler, "translate", "--backend=mlir", format("--usize=", width), "extrema.til")
            extrema.cwd(work).capture()
            extrema_status := extrema.run()
            expect(extrema_status == 0, extrema.out(), extrema.err())
            extrema_ir := File.readfile(format(work, "/gen/mlir/extrema.mlir"))
            expect(extrema_ir.contains("arith.cmpf uno") && extrema_ir.contains("arith.cmpi ult") && extrema_ir.contains("arith.cmpi slt"), extrema_ir)
            expect(extrema_ir.contains("fastmath").or(extrema_ir.contains("vector.reduction")).not(), extrema_ir)
            integers := Cmd.new(compiler, "translate", "--backend=mlir", format("--usize=", width), "integer_vectors.til")
            integers.cwd(work).capture()
            integers_status := integers.run()
            expect(integers_status == 0, integers.out(), integers.err())
            integers_ir := File.readfile(format(work, "/gen/mlir/integer_vectors.mlir"))
            expect(integers_ir.contains("!llvm.struct<(i64, i64)>") && integers_ir.contains("arith.divsi") && integers_ir.contains("arith.divui"), integers_ir)
            expect(integers_ir.contains("arith.cmpi slt") && integers_ir.contains("arith.cmpi ult") && integers_ir.contains("alignment = 4 : i64} : !llvm.ptr -> vector<4xi32>"), integers_ir)
            strings := Cmd.new(compiler, "translate", "--backend=mlir", format("--usize=", width), "strings.til")
            strings.cwd(work).capture()
            strings_status := strings.run()
            expect(strings_status == 0, strings.out(), strings.err())
            strings_ir := File.readfile(format(work, "/gen/mlir/strings.mlir"))
            expect(strings_ir.contains("__format\"") && strings_ir.contains("__Array__Str_set\""), strings_ir)
            assert_eq(Bool, strings_ir.contains("llvm.sret"), width=="64")
            support := File.readfile(format(work, "/gen/til/strings.c"))
            expect(support.contains("TIL_CORE_ONLY"), support)
            masks := Cmd.new(compiler, "translate", "--backend=mlir", format("--usize=", width), "masks.til")
            masks.cwd(work).capture()
            masks_status := masks.run()
            expect(masks_status == 0, masks.out(), masks.err())
            masks_ir := File.readfile(format(work, "/gen/mlir/masks.mlir"))
            expect(masks_ir.contains("arith.cmpf une") && masks_ir.contains("arith.select") && masks_ir.contains("vector.reduction <and>"), masks_ir)
            expect(masks_ir.contains("vector<4xi8> to i32") && masks_ir.contains("i32 to vector<4xi8>"), masks_ir)
            ops := Cmd.new(compiler, "translate", "--backend=mlir", format("--usize=", width), "ops.til")
            ops.cwd(work).capture()
            ops_status := ops.run()
            expect(ops_status == 0, ops.out(), ops.err())
            ops_ir := File.readfile(format(work, "/gen/mlir/ops.mlir"))
            expect(ops_ir.contains("arith.mulf") && ops_ir.contains("vector.broadcast") && ops_ir.contains("vector.extract"), ops_ir)
            expect(ops_ir.contains("vector.reduction").or(ops_ir.contains("fastmath")).or(ops_ir.contains("panic")).not(), ops_ir)
            flow := Cmd.new(compiler, "translate", "--backend=mlir", format("--usize=", width), "flow.til")
            flow.cwd(work).capture()
            flow_status := flow.run()
            expect(flow_status == 0, flow.out(), flow.err())
            flow_ir := File.readfile(format(work, "/gen/mlir/flow.mlir"))
            expect(flow_ir.contains(format("%p0: i", width)), flow_ir)
            expect(flow_ir.contains("llvm.alloca") && flow_ir.contains("llvm.cond_br") && flow_ir.contains("arith.cmpi ult"), flow_ir)
            buffers := Cmd.new(compiler, "translate", "--backend=mlir", format("--usize=", width), "buffers.til")
            buffers.cwd(work).capture()
            buffer_status := buffers.run()
            expect(buffer_status == 0, buffers.out(), buffers.err())
            memory_ir := File.readfile(format(work, "/gen/mlir/buffers.mlir"))
            expect(memory_ir.contains(format("!llvm.struct<(!llvm.ptr, i", width, ")>")), memory_ir)
            expect(memory_ir.contains("arith.cmpi ule") && memory_ir.contains("arith.cmpi uge"), memory_ir)
            expect(memory_ir.contains("alignment = 4 : i64} : !llvm.ptr -> vector<4xf32>"), memory_ir)
            expect(memory_ir.contains("inbounds").or(memory_ir.contains("noalias")).not(), memory_ir)
            if width == "32" { expect(memory_ir.contains("arith.extui"), memory_ir) }
        }
        File.writefile(format(work, "/buffer_bang.til"), "mode pure\nF4:=Simd(F32,4)\nload_bang := func(a: Array(F32),i: USize) returns F4 { return F4.load(a,i)! }\n")
        buffer_bang := Cmd.new(compiler, "translate", "--backend=mlir", "buffer_bang.til")
        buffer_bang.cwd(work).capture()
        buffer_bang_status := buffer_bang.run()
        expect(buffer_bang_status == 0, buffer_bang.out(), buffer_bang.err())
        bang_ir := File.readfile(format(work, "/gen/mlir/buffer_bang.mlir"))
        expect(bang_ir.contains("__panic\"") && bang_ir.contains("__Array__Str_set\"") && bang_ir.contains("llvm.unreachable"), bang_ir)
        expect(bang_ir.contains("til.mlir.panic.").not(), bang_ir)
        File.writefile(format(work, "/helper_bang.til"), "mode pure\nF4:=Simd(F32,4)\nload_values := func(a: Array(F32)) returns F4 throws OutOfBounds { return F4.load(a,0)? }\nunsafe_caller := func(a: Array(F32)) returns F32 { v:=load_values(a)!; return v[0] }\n")
        helper_bang := Cmd.new(compiler, "translate", "--backend=mlir", "helper_bang.til")
        helper_bang.cwd(work).capture()
        helper_bang_status := helper_bang.run()
        expect(helper_bang_status == 0, helper_bang.out(), helper_bang.err())
        File.writefile(format(work, "/buffer_own.til"), "mode pure\nconsume := func(own a: Array(F32)) returns USize { return a.len() }\n")
        buffer_own := Cmd.new(compiler, "translate", "--backend=mlir", "buffer_own.til")
        buffer_own.cwd(work).capture()
        expect(buffer_own.run() != 0, "unsupported buffer ownership accepted")
        expect(buffer_own.out().contains("parameters must be borrowed"), buffer_own.out(), buffer_own.err())
        File.writefile(format(work, "/bad_lane.til"), "mode pure\nF4 := Simd(F32,4)\nbad_lane := func(a: F4) returns F32 { return a[4] }\n")
        bad_lane := Cmd.new(compiler, "translate", "--backend=mlir", "bad_lane.til")
        bad_lane.cwd(work).capture()
        bad_lane_status := bad_lane.run()
        expect(bad_lane_status == 0, bad_lane.out(), bad_lane.err())
        bad_lane_ir := File.readfile(format(work, "/gen/mlir/bad_lane.mlir"))
        expect(bad_lane_ir.contains("arith.cmpi ult") && bad_lane_ir.contains("__panic\""), bad_lane_ir)
        File.writefile(format(work, "/lane_update.til"), "mode pure\nF4:=Simd(F32,4)\nupdate:=func(a:F4,i:USize,x:F32) returns F32 throws OutOfBounds { mut v:=a.clone(); v.set(i,own x)?; return v.get(i)? }\n")
        lane_update := Cmd.new(compiler, "translate", "--backend=mlir", "lane_update.til")
        lane_update.cwd(work).capture()
        lane_update_status := lane_update.run()
        expect(lane_update_status == 0, lane_update.out(), lane_update.err())
        lane_update_ir := File.readfile(format(work, "/gen/mlir/lane_update.mlir"))
        expect(lane_update_ir.contains("llvm.insertelement") && lane_update_ir.contains("llvm.extractelement") && lane_update_ir.contains("arith.cmpi ult"), lane_update_ir)
        File.writefile(format(work, "/float_ops.til"), "mode pure\nF4:=Simd(F32,4)\ndivide:=func(a:F32,b:F32) returns F32 {return a/b}\ndivide4:=func(a:F4,b:F4) returns F4 {return a/b}\nfused:=func(a:F32,b:F32,c:F32) returns F32 {return a.fma(b,c)}\nfused4:=func(a:F4,b:F4,c:F4) returns F4 {return a.fma(b,c)}\n")
        float_ops := Cmd.new(compiler, "translate", "--backend=mlir", "float_ops.til")
        float_ops.cwd(work).capture()
        float_status := float_ops.run()
        expect(float_status == 0, float_ops.out(), float_ops.err())
        float_ir := File.readfile(format(work, "/gen/mlir/float_ops.mlir"))
        expect(float_ir.contains("arith.divf") && float_ir.contains("llvm.intr.fma"), float_ir)
        expect(float_ir.contains("fastmath").not(), float_ir)
        File.writefile(format(work, "/bad.til"), "mode pure\nbad := func(a: I32, b: I32) returns I32 { return a / b }\n")
        bad := Cmd.new(compiler, "translate", "--backend=mlir", "bad.til")
        bad.cwd(work).capture()
        expect(bad.run() != 0, "unsupported division accepted")
        expect(bad.out().contains("unsupported operation 'div'"), bad.out(), bad.err())
        expect(bad.out().contains("bad.til:2:"), bad.out())
        File.writefile(format(work, "/integer_spill.til"), "mode pure\nS4:=Simd(I32,4)\nspill:=func(a:I32,b:I32,c:I32,d:I32,e:I32,v:S4) returns S4 {return v+S4.splat(a+b+c+d+e)}\n")
        spill := Cmd.new(compiler, "translate", "--backend=mlir", "integer_spill.til")
        spill.cwd(work).capture()
        expect(spill.run() != 0, "unsupported integer SIMD stack ABI accepted")
        expect(spill.out().contains("more than six INTEGER argument slots"), spill.out(), spill.err())
    }
    for command_name in array(Str, "interpret", "test", "ast", "doc", "install", "bindings") {
        bad := Cmd.new(compiler, command_name, "--backend=mlir", "add.til")
        bad.cwd(work).capture()
        expect(bad.run() != 0, command_name)
        expect(bad.out().contains("--backend requires translate, build or run"), bad.out(), bad.err())
    }
    for option in array(Str, "--backend=unknown", "--backend") {
        bad := Cmd.new(compiler, "translate", option, "add.til")
        bad.cwd(work).capture()
        expect(bad.run() != 0, option)
        expect(bad.out().contains("error: --backend"), bad.out(), bad.err())
    }
    bad_target := Cmd.new(compiler, "translate", "--backend=mlir", "--target=linux-arm64", "add.til")
    bad_target.cwd(work).capture()
    expect(bad_target.run() != 0, "unsupported MLIR target accepted")
    expect(bad_target.out().contains("Linux x86-64 hosts and targets only"), bad_target.out(), bad_target.err())
    println("mlir_options PASS")
}
