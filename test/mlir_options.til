mode cli
import("../src/std/sys")
import("../src/std/file")
import("../src/self/targets")
realpath_str := ext_proc(path: Str) returns Str {}

main := proc(compiler_arg: Str) {
    compiler := realpath_str(compiler_arg)
    work := "tmp/mlir_options"
    mkdir_p(work)
    File.writefile(format(work, "/add.til"), "mode pure\nF4 := Simd(F32,4)\nadd := func(a: F4, b: F4) returns F4 { return a + b }\n")
    if detect_current_target().is(Target.LinuxX64) {
        command := Cmd.new(compiler, "translate", "--backend=mlir", "add.til")
        command.cwd(work).capture()
        status := command.run()
        expect(status == 0, command.out(), command.err())
        ir := File.readfile(format(work, "/gen/mlir/add.mlir"))
        expect(ir.contains("arith.addf"), ir)
        expect(ir.contains("vector<4xf32>"), ir)
        expect(ir.contains("llvm.insertvalue"), ir)
        File.writefile(format(work, "/ops.til"), "mode pure\nF4 := Simd(F32,4)\ndot := func(a: F4,b: F4) returns F32 { return (a*b).reduce_add() }\nmake := func(a: F32,b: F32,c: F32,d: F32) returns F4 { return F4.new(a,b,c,d) }\nsplat := func(a: F32) returns F4 { return F4.splat(a) }\nlane := func(a: F4) returns F32 { return a[2] }\n")
        File.writefile(format(work, "/flow.til"), "mode pure\ncount := func(n: USize) returns USize { mut i: USize = 0; mut total: USize = 0; while i < n { i++; if i == 2 { continue }; total = total + i; if total > 100 { break } }; return total }\n")
        for width in array(Str, "32", "64") {
            ops := Cmd.new(compiler, "translate", "--backend=mlir", format("--usize=", width), "ops.til")
            ops.cwd(work).capture()
            ops_status := ops.run()
            expect(ops_status == 0, ops.out(), ops.err())
            ops_ir := File.readfile(format(work, "/gen/mlir/ops.mlir"))
            expect(ops_ir.contains("arith.mulf") && ops_ir.contains("vector.broadcast") && ops_ir.contains("vector.extract"), ops_ir)
            expect(ops_ir.contains("vector.reduction").or(ops_ir.contains("fastmath")).or(ops_ir.contains("panic")).not(), ops_ir)
            flow := Cmd.new(compiler, "translate", "--backend=mlir", format("--usize=", width), "flow.til")
            flow.cwd(work).capture()
            flow_status := flow.run()
            expect(flow_status == 0, flow.out(), flow.err())
            flow_ir := File.readfile(format(work, "/gen/mlir/flow.mlir"))
            expect(flow_ir.contains(format("%p0: i", width)), flow_ir)
            expect(flow_ir.contains("llvm.alloca") && flow_ir.contains("llvm.cond_br") && flow_ir.contains("arith.cmpi ult"), flow_ir)
        }
        File.writefile(format(work, "/bad_lane.til"), "mode pure\nF4 := Simd(F32,4)\nbad_lane := func(a: F4) returns F32 { return a[4] }\n")
        bad_lane := Cmd.new(compiler, "translate", "--backend=mlir", "bad_lane.til")
        bad_lane.cwd(work).capture()
        expect(bad_lane.run() != 0, "invalid SIMD lane accepted")
        expect(bad_lane.out().contains("SIMD lane index must be statically known and in 0..3"), bad_lane.out(), bad_lane.err())
        File.writefile(format(work, "/bad.til"), "mode pure\nbad := func(a: F32, b: F32) returns F32 { return a / b }\n")
        bad := Cmd.new(compiler, "translate", "--backend=mlir", "bad.til")
        bad.cwd(work).capture()
        expect(bad.run() != 0, "unsupported division accepted")
        expect(bad.out().contains("unsupported operation 'div'"), bad.out(), bad.err())
        expect(bad.out().contains("bad.til:2:"), bad.out())
    }
    for command_name in array(Str, "interpret", "test", "ast", "doc", "install", "bindings") {
        bad := Cmd.new(compiler, command_name, "--backend=mlir", "add.til")
        bad.cwd(work).capture()
        expect(bad.run() != 0, command_name)
        expect(bad.out().contains("--backend requires translate, build or run"), bad.out(), bad.err())
    }
    for option in array(Str, "--backend=unknown", "--backend") {
        bad := Cmd.new(compiler, "translate", option, "add.til")
        bad.cwd(work).capture()
        expect(bad.run() != 0, option)
        expect(bad.out().contains("error: --backend"), bad.out(), bad.err())
    }
    bad_target := Cmd.new(compiler, "translate", "--backend=mlir", "--target=linux-arm64", "add.til")
    bad_target.cwd(work).capture()
    expect(bad_target.run() != 0, "unsupported MLIR target accepted")
    expect(bad_target.out().contains("Linux x86-64 hosts and targets only"), bad_target.out(), bad_target.err())
    println("mlir_options PASS")
}
