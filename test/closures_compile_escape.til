mode test

UnaryOp := func(I64) returns I64
StrSupplier := func() returns Str

WordBox := struct {
    text := ""
}

BoxSupplier := func() returns WordBox

make_multiplier := func(factor: I64) returns UnaryOp {
    local_factor := factor
    return func(x: I64) returns I64 [own local_factor] { return x.mul(local_factor) }
}

test_closure_return_captures_local := test() {
    triple := make_multiplier(3)
    assert_eq(I64, triple(6), 18)
}

make_str_supplier := func() returns StrSupplier {
    msg := "hello"
    return func() returns Str [own msg] { return msg.clone() }
}

test_closure_return_owns_str := test() {
    get_msg := make_str_supplier()
    assert_eq(Str, get_msg(), "hello")
}

// An `own` closure parameter is the callee's to drop: a capturing closure
// passed this way used to leak its environment and box (the --asan cage
// report catches it).
take_supplier := func(own f: StrSupplier) returns Str { return f() }

// Assigning a fresh closure to a `mut` closure parameter writes the
// caller's slot and drops the closure it held (it used to emit invalid C).
swap_unary := func(mut f: UnaryOp, k: I64) {
    kk := k
    f = func(x: I64) returns I64 [own kk] { return x.mul(kk) }
}

swap_and_call := func(mut f: UnaryOp, k: I64, x: I64) returns I64 {
    swap_unary(f, k)
    return f(x)
}

UnaryHolder := struct {
    f : UnaryOp = func(x: I64) returns I64 { return x }
}

test_mut_closure_param_assigned := test() {
    mut h := UnaryHolder()
    assert_eq(I64, swap_and_call(h.f, 3, 5), 15)
    assert_eq(I64, swap_and_call(h.f, 4, 5), 20)
}

// #480: a `mut` local initialised with a capture-free func is a variable,
// not a lifted definition: it can be swapped through a `mut` parameter,
// reassigned, and handed on through a callback.
MutUnaryOp := func(mut UnaryOp)

pass_mut := func(g: MutUnaryOp, mut f: UnaryOp) { g(f) }

apply_unary := func(f: UnaryOp, x: I64) returns I64 { return f(x) }

test_mut_closure_local := test() {
    mut f : UnaryOp = func(x: I64) returns I64 { return x.add(1) }
    assert_eq(I64, f(1), 2)
    swap_unary(f, 3)
    assert_eq(I64, f(5), 15)
    seven := 7
    f = func(x: I64) returns I64 [own seven] { return x.add(seven) }
    assert_eq(I64, apply_unary(f, 1), 8)
    pass_mut(func(mut h: UnaryOp) { swap_unary(h, 10) }, f)
    assert_eq(I64, f(2), 20)
}

test_own_closure_param_dropped := test() {
    for _ in 0..3 { assert_eq(Str, take_supplier(own make_str_supplier()), "hello") }
    assert_eq(Str, take_supplier(own func() returns Str { return "static" }), "static")
}

make_box_supplier := func() returns BoxSupplier {
    box := WordBox(text = "boxed")
    return func() returns WordBox [own box] { return box.clone() }
}

test_closure_return_owns_struct_with_str := test() {
    get_box := make_box_supplier()
    box := get_box()
    assert_eq(Str, box.text, "boxed")
}
