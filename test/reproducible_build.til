mode cli

import("../src/std/sys")
import("../src/std/file")
import("jni_support")

// #472, level 3 (L3a): what til itself contributes to a binary does not
// depend on where the checkout is or on when the build runs. This driver
// builds one program and one library three times -- in this checkout, and
// twice, a second apart, in a second root holding a copy of the compiler,
// of src/ and of the runtime's forward header -- and compares every file
// byte for byte, and what the compiler holds before a backend
// (`ast --phase=prepared`) between the two roots.
//
// What used to differ: the C compiler recorded the checkout's absolute path
// in debug info, the executable's reuse stamp hashed it, and on Mach-O the
// linker recorded the names and times of clang's temporary object files.
//
// Arguments: the compiler under test, and optionally a target. With no
// target the host's own is built.

realpath_str := ext_proc(path: Str) returns Str {}

WORK := "tmp/reproducible_build"
SECOND := "tmp/reproducible_build/root"

copy_checked := proc(source: Str, destination: Str) {
    if copy_file(source, destination) != 0 { panic("cannot copy ", source, " to ", destination) }
}

copy_tree_checked := proc(source: Str, destination: Str) {
    if copy_tree(source, destination) != 0 { panic("cannot copy ", source, " to ", destination) }
}

// Run the compiler at its path relative to `root`, from `root`.
compile := proc(root: Str, compiler: Str, target_flag: Str, width: Str, jni: Bool, what: Str, arguments: ..Str) returns Str {
    command := Cmd.new(format("./", compiler))
    for argument : Str in arguments { command.arg(argument) }
    if target_flag.len() > 0 { command.arg(target_flag) }
    if width.len() > 0 { command.arg(format("--usize=", width)) }
    if jni { command.arg("--jni") }
    command.arg(what)
    command.cwd(root)
    command.capture()
    if command.run() != 0 {
        panic(command.render(), " in ", root, ": ", command.out(), command.err())
    }
    return command.out()
}

// What the compiler holds for `source` just before a backend (#472 level 1).
observation := proc(root: Str, compiler: Str, target_flag: Str, width: Str, source: Str) returns Str {
    command := Cmd.new(format("./", compiler), "ast", "--phase=prepared")
    if target_flag.len() > 0 { command.arg(target_flag) }
    if width.len() > 0 { command.arg(format("--usize=", width)) }
    command.arg(source)
    command.cwd(root)
    command.capture()
    if command.run() != 0 {
        panic(command.render(), " in ", root, ": ", command.err())
    }
    return command.out()
}

same_file := proc(what: Str, first: Str, second: Str) {
    if File.is_file(first).not() { panic("not built: ", first) }
    if File.is_file(second).not() { panic("not built: ", second) }
    if File.readfile(first) != File.readfile(second) {
        panic(what, ": ", first, " and ", second, " differ")
    }
}

check_layout := proc(compiler: Str, target_flag: Str, width: Str) {
    android := target_flag.contains("android-")
    program := "mode script\nwords := vec(Str, \"same\", \"bytes\")\nprintln(words[0], \" \", words[1])\n"
    library := "mode lib\nreproducible_sum := func(a: I64, b: I64) returns I64 { return a + b }\n"
    for root : Str in array(Str, ".", SECOND) {
        mkdir_p(format(root, "/", WORK, "/case"))
        File.writefile(format(root, "/", WORK, "/case/program.til"), program)
        File.writefile(format(root, "/", WORK, "/case/reproducible_lib.til"), library)
    }
    program_source := format(WORK, "/case/program.til")
    library_source := format(WORK, "/case/reproducible_lib.til")
    binary := format(WORK, "/case/program.bin")
    generated := format(WORK, "/case/program.c")
    mut shared_extension := ".so"
    if target_flag.contains("macos") { shared_extension = ".dylib" }
    if target_flag.contains("windows") { shared_extension = ".dll" }
    mut library_outputs := vec(Str, "gen/lib/libreproducible_lib.a", "gen/lib/reproducible_lib.o",
        format("gen/lib/libreproducible_lib", shared_extension))

    // Here, then twice in the second root with a pause between: file
    // times are whole seconds on some file systems.
    compile(".", compiler, target_flag, width, false, program_source, "build", "-o", binary, "-c", generated)
    built := compile(".", compiler, target_flag, width, android, library_source, "build")
    if android {
        // Read this build's exact dependency names, not stale revisions left
        // in gen/lib by previous builds. The jar's ZIP metadata is separate
        // from the native-library comparison exercised here.
        mut dependencies : USize = 0
        for line : Str in built.split("\n") {
            if line.starts_with("Generated: gen/lib/libtilrt-").or(line.starts_with("Generated: gen/lib/libtilcore-")) {
                library_outputs.push(own line.strip_prefix("Generated: ").clone())
                dependencies++
            }
        }
        if dependencies != 2 { panic("Android library did not report its runtime and core:\n", built) }
        library_outputs.push(own "gen/lib/libreproducible_lib_jni.so")
        library_outputs.push(own "gen/til/reproducible_lib_jni.c")
        library_outputs.push(own "gen/til/java/til/reproducible_lib/ReproducibleLib.java")
    }
    compile(SECOND, compiler, target_flag, width, false, program_source, "build", "-o", binary, "-c", generated)
    compile(SECOND, compiler, target_flag, width, android, library_source, "build")
    mkdir_p(format(WORK, "/first"))
    copy_checked(format(SECOND, "/", binary), format(WORK, "/first/program.bin"))
    for output : Str in library_outputs {
        copy_checked(format(SECOND, "/", output), format(WORK, "/first/", output.replace("/", "_")))
    }
    sleep_ms(1100)
    compile(SECOND, compiler, target_flag, width, false, program_source, "build", "--force-rebuild", "-o", binary, "-c", generated)
    compile(SECOND, compiler, target_flag, width, android, library_source, "build", "--force-rebuild")

    if observation(".", compiler, target_flag, width, program_source) != observation(SECOND, compiler, target_flag, width, program_source) {
        panic("two checkout roots: the observations of ", program_source, " before a backend differ")
    }
    same_file("two checkout roots", binary, format(SECOND, "/", binary))
    same_file("two checkout roots", generated, format(SECOND, "/", generated))
    same_file("two build times", format(WORK, "/first/program.bin"), format(SECOND, "/", binary))
    for output : Str in library_outputs {
        same_file("two checkout roots", output, format(SECOND, "/", output))
        same_file("two build times", format(WORK, "/first/", output.replace("/", "_")), format(SECOND, "/", output))
    }
}

compile_apk := proc(root: Str, compiler: Str, target: Str, width: Str, source: Str,
    binary: Str, generated: Str, sdk: Str, home: Str = "") {
    command := Cmd.new(format("./", compiler), "build", "--force-rebuild", format("--target=", target),
        format("--usize=", width), "-o", binary, "-c", generated, source)
    command.cwd(root)
    if home.len() > 0 {
        command.env("HOME", home)
        command.env("ANDROID_HOME", sdk)
    }
    command.capture()
    if command.run() != 0 { panic(command.render(), " in ", root, ": ", command.out(), command.err()) }
}

check_apk := proc(compiler: Str, target: Str, width: Str, sdk: Str) {
    source := format(WORK, "/case/apk_program.til")
    binary := format(WORK, "/case/apk_program.apk")
    generated := format(WORK, "/case/apk_program.c")
    aligned := format(android_apk_stage(generated, target, width), "/aligned.apk")
    program := "mode gui\nmain := proc() {\nInitWindow(320, 240, \"reproducible APK\".c_str)\nwhile WindowShouldClose().not() {\nBeginDrawing()\nEndDrawing()\n}\nCloseWindow()\n}\n"
    for root : Str in array(Str, ".", SECOND) { File.writefile(format(root, "/", source), program) }
    compile_apk(".", compiler, target, width, source, binary, generated, sdk)
    compile_apk(SECOND, compiler, target, width, source, binary, generated, sdk)
    same_file("APK checkout roots, signed", binary, format(SECOND, "/", binary))
    same_file("APK checkout roots, unsigned/aligned", aligned, format(SECOND, "/", aligned))
    copy_checked(format(SECOND, "/", binary), format(WORK, "/first/program.apk"))
    copy_checked(format(SECOND, "/", aligned), format(WORK, "/first/aligned.apk"))
    sleep_ms(1100)
    compile_apk(SECOND, compiler, target, width, source, binary, generated, sdk)
    same_file("APK build times, signed", format(WORK, "/first/program.apk"), format(SECOND, "/", binary))
    same_file("APK build times, unsigned/aligned", format(WORK, "/first/aligned.apk"), format(SECOND, "/", aligned))
    // A separate HOME gets its own debug key. The signature must change,
    // while the exact pre-signing payload must remain byte-identical.
    compile_apk(SECOND, compiler, target, width, source, binary, generated, sdk, realpath_str(SECOND))
    same_file("APK signing boundary", format(WORK, "/first/aligned.apk"), format(SECOND, "/", aligned))
    if File.readfile(format(WORK, "/first/program.apk")) == File.readfile(format(SECOND, "/", binary)) {
        panic("APK signed with an independent debug key unexpectedly matched")
    }
    println("APK root/time checks passed: ", target, " U", width)
}

prepare_apk_root := proc(target: Str) {
    archive := format("vendor/raylib/build-", target, "/libraylib.a")
    // Refresh the first build program before copying it into the other root.
    Cmd.new("bin/make", archive).run_checked()
    // Use the existing build program in the second checkout, with independent
    // archives. Copy it last so its inputs do not trigger a self-rebuild there.
    for path : Str in array(Str, "vendor/raylib/src", "vendor/bindings", "examples/lib") {
        copy_tree_checked(path, format(SECOND, "/", path))
    }
    copy_checked("make.til", format(SECOND, "/make.til"))
    copy_checked("bin/make", format(SECOND, "/bin/make"))
    Cmd.new("chmod", "+x", format(SECOND, "/bin/make")).run_checked()
    second := Cmd.new("./bin/make", archive)
    second.cwd(SECOND)
    second.run_checked()
}

main := proc(args: ..Str) {
    if args.len() < 1 || args.len() > 2 { panic("usage: reproducible_build <compiler under test> [target]") }
    compiler := args[0].clone()
    if File.is_absolute(compiler) { panic("the compiler has to be named relative to the checkout: ", compiler) }
    mut target_flag := ""
    if args.len() == 2 { target_flag = format("--target=", args[1]) }

    File.remove_tree(WORK)
    slash := compiler.rfind("/")
    if slash < 0 { panic("the compiler has to be under a directory of the checkout: ", compiler) }
    mkdir_p(format(SECOND, "/", compiler.substr(0, slash.to_usize())))
    copy_checked(compiler, format(SECOND, "/", compiler))
    // REM A copy does not carry the executable bit.
    if Cmd.new("chmod", "+x", format(SECOND, "/", compiler)).run() != 0 { panic("chmod failed") }
    copy_tree_checked("src", format(SECOND, "/src"))
    mkdir_p(format(SECOND, "/boot"))
    copy_checked("boot/til_forward.h", format(SECOND, "/boot/til_forward.h"))
    // REM Cross toolchains read their headers/stubs/builtins from the checkout.
    if target_flag.contains("macos") { copy_tree_checked("vendor/macos", format(SECOND, "/vendor/macos")) }
    // #504: the linux targets' pinned C library, where this checkout has
    // it unpacked (bin/make vendor/linux/<target>): til builds a linux
    // target against it then, and the second root has to as well. A link:
    // it is read, not written, and it is 75 MB a target.
    if File.is_dir("vendor/linux") {
        mkdir_p(format(SECOND, "/vendor"))
        Cmd.new("ln", "-s", realpath_str("vendor/linux"), format(SECOND, "/vendor/linux")).run_checked()
    }
    if target_flag.contains("android-") {
        copy_tree_checked("vendor/android", format(SECOND, "/vendor/android"))
        sdk := android_apk_sdk()
        if sdk.len() > 0 {
            android_apk_inputs(sdk)
            prepare_apk_root(args[1])
        } else {
            println("APK checks not run: no Android SDK; checking native artifacts only")
        }
        for width : Str in array(Str, "32", "64") {
            check_layout(compiler, target_flag, width)
            if sdk.len() > 0 { check_apk(compiler, args[1], width, sdk) }
        }
    } else {
        check_layout(compiler, target_flag, "")
    }
    println("reproducible build passed")
}
