mode test

# Issue #51: test() decls inline in struct/enum namespaces are
# discovered and run by both `til interpret` (run_tests via mode test)
# and `til build` (emit_test_main).

Counter := struct {
    value : I64 = 0
    namespace:
    bump := func(self: Counter) returns I64 { return self.value.add(1) }

    test_bump_default := test() {
        c := Counter(value = 0)
        assert_eq(I64, c.bump(), 1)
    }

    test_bump_seeded := test() {
        c := Counter(value = 10)
        assert_eq(I64, c.bump(), 11)
    }
}

Sign := enum {
    Pos
    Zero
    Neg
    namespace:
    classify := func(x: I64) returns I64 {
        if x.gt(0) { return 1 }
        if x.lt(0) { return -1 }
        return 0
    }

    test_classify_pos := test() {
        assert_eq(I64, Sign.classify(7), 1)
    }

    test_classify_neg := test() {
        assert_eq(I64, Sign.classify(-3), -1)
    }

    test_classify_zero := test() {
        assert_eq(I64, Sign.classify(0), 0)
    }
}

# Sanity: a top-level test in the same file still runs.
test_top_level_still_works := test() {
    c := Counter(value = 41)
    assert_eq(I64, c.bump(), 42)
}

// No case refers to either containing type. Test reachability must retain
// the containers themselves, not just their qualified member names.
mut otherwise_unused_cases:I64=0
OtherwiseUnusedStruct:=struct {
namespace:
    discovered:=test() { otherwise_unused_cases++ }
}
OtherwiseUnusedEnum:=enum {
    Value,
namespace:
    discovered:=test() { otherwise_unused_cases++ }
}
test_unused_namespace_tests_were_run:=test() {
    assert_eq(I64,otherwise_unused_cases,2)
}

NamespaceSized := struct {
    size : U64 = 0
    marker : U64 = 7
}

test_instance_field_named_size := test() {
    source := NamespaceSized(size = 4294967301)
    mut target := NamespaceSized()
    target.size = source.size
    assert_eq(U64, target.size, 4294967301)
    assert_eq(U64, target.marker, 7)
    ref mut alias : NamespaceSized = target
    alias.size = alias.size + 9
    assert_eq(U64, target.size, 4294967310)
    assert_eq(USize, NamespaceSized.size(), 16)
    assert_eq(U64, source.size, 4294967301)
}

NamespaceShared := struct {
namespace:
    mut count : I64 = 3
    mut enabled : Bool = false
    mut fraction : F32 = 1.5
    mut precision : F64 = -2.5
    mut width : USize = 7
    mut wide : U64 = 4294967301
    mut pointer : Dynamic = 0
    FIXED : I64 = 11
    read_count := func() returns I64 { return NamespaceShared.count }
    forward_count := func() returns I64 { return NamespaceShared.read_count() }
    bump := func(mut value: I64) { value = value + 1 }
}

priv namespace_count_forward := func() returns I64 { return NamespaceShared.forward_count() }

NamespaceMode := enum {
    Idle, Active,
namespace:
    mut limit : I64 = 13
}

test_namespace_scalar_values := test() {
    assert_eq(I64, NamespaceShared.read_count(), 3)
    assert_eq(I64, namespace_count_forward(), 3)
    assert(NamespaceShared.enabled.not())
    assert_eq(F32, NamespaceShared.fraction, 1.5)
    assert_eq(F64, NamespaceShared.precision, -2.5)
    assert_eq(USize, NamespaceShared.width, 7)
    assert_eq(U64, NamespaceShared.wide, 4294967301)
    assert_eq(I64, NamespaceShared.FIXED, 11)
    assert(NamespaceShared.pointer.is_null())
    NamespaceShared.count = 29
    NamespaceShared.enabled = true
    NamespaceShared.fraction = -1.25
    NamespaceShared.precision = NamespaceShared.precision.mul(2.0)
    NamespaceShared.width = NamespaceShared.width + 1
    NamespaceShared.wide = NamespaceShared.wide + 9
    assert_eq(I64, NamespaceShared.read_count(), 29)
    assert_eq(I64, namespace_count_forward(), 29)
    assert(NamespaceShared.enabled)
    assert_eq(F32, NamespaceShared.fraction, -1.25)
    assert_eq(F64, NamespaceShared.precision, -5.0)
    assert_eq(USize, NamespaceShared.width, 8)
    assert_eq(U64, NamespaceShared.wide, 4294967310)
    NamespaceShared.bump(NamespaceShared.count)
    assert_eq(I64, namespace_count_forward(), 30)
    mut pointee : I64 = 19
    NamespaceShared.pointer = to_ptr(pointee)
    assert(ptr_eq(NamespaceShared.pointer, to_ptr(pointee)))
    NamespaceShared.pointer = 0
    assert(NamespaceShared.pointer.is_null())
    assert_eq(I64, NamespaceMode.limit, 13)
    NamespaceMode.limit = 31
    assert_eq(I64, NamespaceMode.limit, 31)
    assert(NamespaceMode.Idle.neq(NamespaceMode.Active))
}

test_namespace_scalar_storage_is_shared := test() {
    assert_eq(I64, NamespaceShared.read_count(), 30)
    assert_eq(I64, NamespaceMode.limit, 31)
}

NicheSwitchLink := enum { Link: ref I64, Missing }

test_borrowed_niche_switch_alias := test() {
    mut value : I64 = 4294967301
    mut option := NicheSwitchLink.Link(to_ptr(value))
    switch option {
    case .Link(item): item = item + 1
    case .Missing: panic("expected a borrowed niche payload")
    }
    assert_eq(I64, value, 4294967302)
    option = NicheSwitchLink.Missing
    mut missing := false
    switch option {
    case .Link(_): panic("expected an empty borrowed niche")
    case .Missing: missing = true
    }
    assert(missing)
    // The payload variant is declared first: its tag is zero, but its
    // pointer-presence discriminant is one in both C-family emitters.
    assert_eq(USize, NicheSwitchLink.size(), UPtr.size())
}

priv niche_switch_pick := func(mut calls: I64, option: NicheSwitchLink) returns NicheSwitchLink {
    calls++
    return option
}

priv niche_delete_flag := func(mut calls: I64) returns Bool { calls++; return false }

test_borrowed_niche_delete_preserves_operands := test() {
    mut calls : I64 = 0
    value : I64 = 23
    option := NicheSwitchLink.Link(to_ptr(value))
    NicheSwitchLink.delete(own niche_switch_pick(calls, option), niche_delete_flag(calls))
    assert_eq(I64, calls, 2)
    assert_eq(I64, value, 23)
    switch option {
    case .Link(item): assert_eq(I64, item, 23)
    case .Missing: panic("deleting a copy changed the borrowed niche")
    }
}

test_borrowed_niche_switch_evaluates_once := test() {
    mut calls : I64 = 0
    value : I64 = 19
    option := NicheSwitchLink.Link(to_ptr(value))
    switch niche_switch_pick(calls, option) {
    case .Link(item): assert_eq(I64, item, 19)
    case .Missing: panic("missing side-effecting switch payload")
    }
    assert_eq(I64, calls, 1)
    switch niche_switch_pick(calls, NicheSwitchLink.Missing) {
    case .Link(_): panic("unexpected side-effecting switch payload")
    case: assert_eq(I64, calls, 2)
    }
    assert_eq(I64, calls, 2)
}

NicheSwitchScope := struct {
    name : Str = ""
    parent : Option(ref NicheSwitchScope) = Option(ref NicheSwitchScope).None
namespace:
    active_name := func(self: NicheSwitchScope) returns ref Str {
        if self.name.len() > 0 { return self.name }
        switch self.parent {
        case .Some(parent): return parent.active_name()
        case .None: return self.name
        }
    }
}

test_borrowed_niche_recursive_ref_return := test() {
    mut root := NicheSwitchScope(name = Str.with_capacity(32))
    root.name.push_str("root")
    middle := NicheSwitchScope(parent = safe_ref(root))
    leaf := NicheSwitchScope(parent = safe_ref(middle))
    ref inherited : Str = leaf.active_name()
    assert_eq(Str, inherited, "root")
    root.name.push_str(" changed")
    assert_eq(Str, inherited, "root changed")
    assert_eq(Str, leaf.active_name(), "root changed")
    empty := NicheSwitchScope()
    assert_eq(Str, empty.active_name(), "")
}

test_borrowed_niche_nested_switch_and_continue := test() {
    first : I64 = 7
    second : I64 = 11
    outer := NicheSwitchLink.Link(to_ptr(first))
    inner := NicheSwitchLink.Link(to_ptr(second))
    mut total : I64 = 0
    switch outer {
    case .Link(item):
        switch inner {
        case .Link(item): total = total + item
        case .Missing: panic("missing inner niche payload")
        }
        total = total + item
    case .Missing: panic("missing outer niche payload")
    }
    assert_eq(I64, total, 18)
    mut calls : I64 = 0
    for _ in 0..3 {
        switch niche_switch_pick(calls, NicheSwitchLink.Missing) {
        case .Link(_): panic("unexpected loop niche payload")
        case .Missing: continue
        }
        total = total + 100
    }
    assert_eq(I64, total, 18)
    assert_eq(I64, calls, 3)
}

CallFieldInner := struct { number: I64 = 0; text: Str = "" }
CallFieldItem := struct {
    name: Str = ""
    inner: CallFieldInner = CallFieldInner()
    words: Vec(Str) = Vec(Str).new()
}

priv call_field_pick := func(items: Vec(CallFieldItem), shallow index: USize, mut calls: I64) returns ref CallFieldItem {
    calls++
    return items.unsafe_get(index)
}

priv call_field_name := func(items: Vec(CallFieldItem), mut calls: I64) returns ref Str {
    return call_field_pick(items, 0, calls).name
}

test_ref_call_field_reads_and_borrows := test() {
    mut items := Vec(CallFieldItem).new()
    items.push(own CallFieldItem(name = Str.with_capacity(32), inner = CallFieldInner(number = 7, text = Str.clone("nested"))))
    Str.push_str(items.unsafe_get(0).name, "first")
    mut calls : I64 = 0
    assert_eq(Str, call_field_pick(items, 0, calls).name, "first")
    assert_eq(I64, calls, 1)
    assert_eq(I64, call_field_pick(items, 0, calls).inner.number, 7)
    assert_eq(I64, calls, 2)
    assert_eq(Str, call_field_pick(items, 0, calls).inner.text, "nested")
    assert_eq(I64, calls, 3)
    ref borrowed : Str = call_field_name(items, calls)
    assert_eq(I64, calls, 4)
    Str.push_str(items.unsafe_get(0).name, " changed")
    assert_eq(Str, borrowed, "first changed")
}

test_ref_call_field_writes := test() {
    mut items := Vec(CallFieldItem).new()
    items.push(own CallFieldItem(name = Str.with_capacity(32), inner = CallFieldInner(number = 7)))
    Str.push_str(items.unsafe_get(0).name, "old")
    mut calls : I64 = 0
    call_field_pick(items, 0, calls).inner.number = 41
    assert_eq(I64, calls, 1)
    assert_eq(I64, items.unsafe_get(0).inner.number, 41)
    Str.push_str(call_field_pick(items, 0, calls).name, " value")
    assert_eq(I64, calls, 2)
    assert_eq(Str, items.unsafe_get(0).name, "old value")
    Vec(Str).push(call_field_pick(items, 0, calls).words, own Str.clone("stored"))
    assert_eq(I64, calls, 3)
    assert_eq(Str, items.unsafe_get(0).words.unsafe_get(0), "stored")
    call_field_pick(items, 0, calls).name = Str.clone("replacement")
    assert_eq(I64, calls, 4)
    assert_eq(Str, items.unsafe_get(0).name, "replacement")
}

CallFieldGetter := func(Vec(CallFieldItem), shallow USize, mut I64) returns ref CallFieldItem

priv call_field_indirect := func(getter: CallFieldGetter, items: Vec(CallFieldItem), mut calls: I64) returns I64 {
    return getter(items, 0, calls).inner.number
}

test_ref_call_field_indirect := test() {
    mut items := Vec(CallFieldItem).new()
    items.push(own CallFieldItem(inner = CallFieldInner(number = 4294967301)))
    mut calls : I64 = 0
    getter : CallFieldGetter = call_field_pick
    assert_eq(I64, call_field_indirect(getter, items, calls), 4294967301)
    assert_eq(I64, calls, 1)
    assert_eq(I64, getter(items, 0, calls).inner.number, 4294967301)
    assert_eq(I64, calls, 2)
}
