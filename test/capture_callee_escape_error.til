mode test

// Negative test (issue #54): globally retaining a closure must not outlive
// its captured referents. Cloning or owning the closure is not ownership of
// a borrowed capture. Check the actual caller's local, not just whether the
// callee owns its closure parameter; an owned capture would be valid here.

Thunk := func() returns I64
zero := func() returns I64 { return 0 }
mut g_slot : Thunk = zero

stash := func(f: Thunk) { g_slot = f }

leak := func() {
    local := 42
    stash(func() returns I64 [local] { return local })
}

test_escape := test() {
    leak()
    assert_eq(I64, g_slot(), 42)
}
