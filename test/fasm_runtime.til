mode cli
import("../src/std/sys")
import("../src/std/file")
realpath_str := ext_proc(path: Str) returns Str {}

// Optional runtime conformance. The SAME sources run through interpretation,
// C and FASM; assembly/compiler output is separate from program output.
check := proc(compiler: Str, work: Str, name: Str, source: Str,
    output: Str, errors: Str = "", result: I64 = 0, interpret_source: Bool = true, cage_allocation_failure: Bool = false) {
    File.writefile(format(work, "/", name, ".til"), source)
    for width in array(Str, "32", "64") {
        if interpret_source {
            interpreted := Cmd.new(compiler, "interpret", format("--usize=", width), format(name, ".til"))
            interpreted.cwd(work).capture()
            interpreted_status := interpreted.run()
            expect(interpreted_status == result, name, " interpret ", interpreted_status, interpreted.out(), interpreted.err())
            expect(interpreted.out() == output, name, " interpreter stdout mismatch", interpreted.out())
            expect(interpreted.err() == errors, name, " interpreter stderr mismatch", interpreted.err())
        }
        for backend in array(Str, "c", "fasm") {
            artifact := format("bin/", name, "-", backend, "-", width)
            build := Cmd.new(compiler, "build", format("--backend=", backend), format("--usize=", width), "-o", artifact, format(name, ".til"))
            build.cwd(work).capture()
            status := build.run()
            expect(status == 0, name, backend, width, build.out(), build.err())
            run := Cmd.new(format("./", artifact))
            run.cwd(work).capture()
            code := run.run()
            if cage_allocation_failure && backend == "c" && width == "32" {
                // --usize=32 now selects the C allocation cage. Oversized
                // allocations fail loudly instead of returning a null pointer.
                expect(code == 1 && run.out() == "" && run.err().contains("allocation larger than the cage"), name, code, run.out(), run.err())
                continue
            }
            expect(code == result, name, backend, width, code, run.out(), run.err())
            expect(run.out() == output, name, backend, width, " stdout mismatch", run.out())
            expect(run.err() == errors, name, backend, width, " stderr mismatch", run.err())
        }
    }
}

failure := proc(compiler: Str, work: Str, name: Str, source: Str) {
    File.writefile(format(work, "/", name, ".til"), source)
    for width in array(Str, "32", "64") {
        for backend in array(Str, "c", "fasm") {
            artifact := format("bin/", name, "-", backend, "-", width)
            build := Cmd.new(compiler, "build", format("--backend=", backend), format("--usize=", width), "-o", artifact, format(name, ".til"))
            build.cwd(work).capture()
            status := build.run()
            expect(status == 0, build.out(), build.err())
            run := Cmd.new(format("./", artifact))
            run.cwd(work).capture()
            code := run.run()
            expect(code == 1, name, backend, code, run.out(), run.err())
            expect(run.err().len() > 0, name, backend, "missing runtime diagnostic")
        }
    }
}

check_allocations := proc(compiler: Str, work: Str, name: Str, source: Str, allocations: I64, frees: I64, interpret_source: Bool = true) {
    check(compiler, work, name, source, "", interpret_source = interpret_source)
    root := compiler.substr(0, compiler.rfind("/bin/").to_usize())
    runtime_path := format(root,"/src/self/codegen/ext.fasm")
    counted_path := format(realpath_str(work),"/counted-runtime.fasm")
    runtime := File.readfile(runtime_path)
        .replace("rt_malloc:\n", "rt_malloc:\n    inc qword [fasm_test_allocations]\n")
        .replace("rt_free:\n", "rt_free:\n    inc qword [fasm_test_frees]\n")
        .replace("rt_exit:\n", format(
            "rt_exit:\n    test rdi,rdi\n    jnz .count_done\n",
            "    mov rax,[fasm_test_allocations]\n    cmp rax,[fasm_test_expected_allocations]\n    je .check_frees\n",
            "    lea rdi,[rax+80]\n    jmp .count_done\n.check_frees:\n",
            "    mov rax,[fasm_test_frees]\n    cmp rax,[fasm_test_expected_frees]\n    je .count_done\n",
            "    lea rdi,[rax+160]\n.count_done:\n"))
    File.writefile(counted_path,runtime)
    for width in array(Str,"32","64") {
        translate := Cmd.new(compiler,"translate","--backend=fasm",format("--usize=",width),format(name,".til"))
        translate.cwd(work).capture()
        status := translate.run()
        expect(status == 0,name,translate.out(),translate.err())
        path := format(work,"/gen/fasm/",name,".fasm")
        assembly := File.readfile(path).replace(runtime_path.replace("'","''"),counted_path.replace("'","''"))
        instrumented := format(work,"/",name,"-counted-",width,".fasm")
        artifact := format(work,"/",name,"-counted-",width)
        File.writefile(instrumented,format(assembly,
            "\nsegment readable writeable\nfasm_test_allocations dq 0\nfasm_test_frees dq 0\n",
            "fasm_test_expected_allocations dq ",allocations.to_str(),"\nfasm_test_expected_frees dq ",frees.to_str(),"\n"))
        assemble := Cmd.new(format(root,"/vendor/fasm/fasm"),instrumented,artifact)
        assemble.capture()
        assembled := assemble.run()
        expect(assembled == 0,name,assemble.out(),assemble.err())
        permissions := Cmd.new("chmod","+x",artifact)
        expect(permissions.run() == 0,"chmod counted allocation probe")
        run := Cmd.new(artifact)
        run.capture()
        result := run.run()
        // Allocation mismatch returns 80+actual, free mismatch 160+actual.
        expect(result == 0,name,width,"allocation probe status=",result.to_str(),run.out(),run.err())
    }
}

check_unboxed := proc(compiler: Str, work: Str) {
    check(compiler,work,"unboxed_lifecycle",format(
        "mode cli\nCounts := struct { drops:I64=0; flags:I64=0 }\n",
        "Value := struct { ref counts:Counts; text:Str=\"\"\nnamespace:\n",
        "delete := func(own self:Value,call_free:Bool=true) { self.counts.drops++; if call_free { self.counts.flags++ }; Str.delete(own self.text,false); if call_free { free(own self) } }\n}\n",
        "Drop := func(own value:Value,call_free:Bool)\n",
        "drop_value := func(own value:Value,call_free:Bool) { Value.delete(own value,call_free) }\n",
        "forward_value := func(own value:Value,call_free:Bool) returns Value { if call_free { assert(value.text.len()>0) }; return value }\n",
        "flag := func(mut calls:I64) returns Bool { calls++; return true }\n",
        "run := func(counts:Counts) { mut calls:I64=0; value:=Value(counts=counts,text=\"frame\"); Value.delete(own value,flag(calls));\n",
        "assert(calls==1); assert(counts.drops==1); assert(counts.flags==0);\n",
        "other:=Value(counts=counts,text=\"indirect\"); drop:Drop=drop_value; drop(own other,flag(calls));\n",
        "assert(calls==2); assert(counts.drops==2); assert(counts.flags==1);\n",
        "mut allocated:Value=calloc(1,Value.size().to_uptr()); allocated.counts=counts; allocated.text=\"heap return\";\n",
        "returned:=forward_value(own allocated,true); assert(returned.text.eq(\"heap return\")); assert(counts.drops==3) }\n",
        "main := proc() { counts:=Counts(); run(counts); println(\"unboxed lifecycle passed\") }\n"),"unboxed lifecycle passed\n")
    check_allocations(compiler,work,"unboxed_values",format(
        "mode cli\nPair := struct { first: I64 = 0; last: I64 = 0 }\n",
        "Maker := func(a:I64,b:I64,c:I64,d:I64,e:I64,f:I64) returns Pair\n",
        "make := func(a:I64,b:I64,c:I64,d:I64,e:I64,f:I64) returns Pair { return Pair(first=a+b+c,last=d+e+f) }\n",
        "consume := func(own value:Pair) returns I64 { return value.first + value.last }\n",
        "Wrapped := enum { Empty, Number:I64, PairValue:Pair }\n",
        "main := proc() { mut n:I64=0; n++; maker:Maker=make; value:=maker(n,2,3,4,5,6);\n",
        "assert(consume(own value)==21); wrapped:=Wrapped.PairValue(make(n,2,3,4,5,6));\n",
        "switch wrapped { case .PairValue(pair): assert(pair.first==6 && pair.last==15); case: panic(\"wrong unboxed enum\") } }\n"),0,0)
    check_allocations(compiler,work,"unboxed_views",format(
        "mode cli\nmain := proc() { mut index:USize=0; index++; text:=\"abcdef\";\n",
        "view:=text.substr(index,3); assert(view.eq(\"bcd\")); whole:=text.borrowed_view(); assert(whole.eq(text));\n",
        "ref bytes:Dynamic=to_ptr(text.c_str); from_c:=Str.from_c_str(bytes); assert(from_c.eq(text));\n",
        "empty:=Str.with_capacity(0); assert(empty.len()==0) }\n"),0,0)
    check_allocations(compiler,work,"unboxed_string", "mode cli\nmain := proc() { mut n:I64=40; n=n+2; text:=n.to_str(); assert(text.eq(\"42\")) }\n",1,1)
    check_allocations(compiler,work,"unboxed_heap_return",format(
        "mode cli\nPair := struct { first:I64=0; last:I64=0 }\n",
        "forward := func(own value:Pair,call_free:Bool) returns Pair { if call_free { assert(value.first==3) }; return value }\n",
        "main := proc() { mut allocated:Pair=calloc(1,Pair.size().to_uptr()); allocated.first=3; allocated.last=4;\n",
        "returned:=forward(own allocated,true); assert(returned.first+returned.last==7) }\n"),1,1)
}

check_closure_allocations := proc(compiler: Str, work: Str) {
    check_allocations(compiler,work,"closure_private",format(
        "mode cli\nAction := func() returns I64\nHolder := struct { action:Action }\n",
        "make := func(start:I64,step:I64) returns Action { state:=start; delta:=step.to_u8();\n",
        "return func() returns I64 [own mut state,own delta] { state=state+delta.to_i64(); return state } }\n",
        "main := proc() { mut seed:I64=9; seed++; original:=Holder(action=make(seed,2)); copy:=original.clone();\n",
        "assert(original.action()==12); assert(original.action()==14); assert(copy.action()==12); assert(copy.action()==14) }\n"),2,2)
    check_allocations(compiler,work,"closure_borrowed",format(
        "mode cli\nAction := func() returns I64\nHolder := struct { action:Action }\n",
        "main := proc() { mut value:I64=1; original:=Holder(action=func() returns I64 [mut value] { value++; return value }); copy:=original.clone();\n",
        "assert(original.action()==2); assert(copy.action()==3); assert(original.action()==4); assert(value==4) }\n"),2,2)
    // The interpreter clones captured records structurally without invoking
    // their custom clone; pin that lifecycle hook against native C here.
    check_allocations(compiler,work,"closure_resource",format(
        "mode cli\nCounts := struct { drops:I64=0; clones:I64=0; flags:I64=0 }\nAction := func() returns I64\nHolder := struct { action:Action }\n",
        "Tracked := struct { ref counts:Counts; number:I64=0\nnamespace:\n",
        "delete := func(own self:Tracked,call_free:Bool=true) { self.counts.drops++; if call_free { self.counts.flags++; free(own self) } }\n",
        "clone := func(self:Tracked) returns Tracked { self.counts.clones++; return Tracked(counts=self.counts,number=self.number) }\n}\n",
        "make := func(counts:Counts,start:I64) returns Action { value:=Tracked(counts=counts,number=start);\n",
        "return func() returns I64 [own value] { return value.number } }\n",
        "main := proc() { counts:=Counts(); mut seed:I64=9; seed++; original:=Holder(action=make(counts,seed)); copy:=original.clone();\n",
        "assert(counts.clones==1);\nassert(original.action()==10);\nassert(copy.action()==10);\nassert(counts.drops==2); assert(counts.flags==2) }\n"),2,2,interpret_source=false)
    check_allocations(compiler,work,"closure_nested",format(
        "mode cli\nAction := func() returns I64\nHolder := struct { action:Action }\n",
        "counter := func(start:I64) returns Action { state:=start; return func() returns I64 [own mut state] { state++; return state } }\n",
        "make := func(start:I64) returns Action { inner:Action=counter(start); return func() returns I64 [own inner] { return inner() } }\n",
        "main := proc() { mut seed:I64=0; seed++; original:=Holder(action=make(seed)); copy:=original.clone();\n",
        "assert(original.action()==2); assert(original.action()==3); assert(copy.action()==2); assert(copy.action()==3) }\n"),4,4)
    check_allocations(compiler,work,"closure_heap_capture",format(
        "mode cli\nAction := func() returns I64\nPair := struct { first:I64=0; last:I64=0 }\n",
        "main := proc() { mut seed:I64=9; seed++; mut value:Pair=calloc(1,Pair.size().to_uptr()); value.first=seed;\n",
        "action:Action=func() returns I64 [own value] { return value.first };\n",
        "assert(action()==10) }\n"),2,2)
    check_allocations(compiler,work,"closure_strings",format(
        "mode cli\nAction := func(change:Bool) returns Bool\nHolder := struct { action:Action }\n",
        "make := func(capacity:USize) returns Action { mut text:=Str.with_capacity(capacity); text.push_str(\"ab\");\n",
        "return func(change:Bool) returns Bool [own mut text] { if change { memset(text.c_str,88,1) }; return text.eq(\"ab\") } }\n",
        "main := proc() { mut capacity:USize=7; capacity++; original:=Holder(action=make(capacity)); copy:=original.clone();\n",
        "assert(original.action(true).not()); assert(copy.action(false)); assert(original.action(false).not()) }\n"),4,4)
}

check_globals := proc(compiler: Str, work: Str) {
    // A diamond import must initialize the shared state once, before either
    // dependent module. Resource-bearing values must outlive the init frames.
    File.writefile(format(work, "/globals_base.til"), format(
        "mode lib\nmut init_count : I64 = 0\n",
        "initialize := proc() returns I64 { init_count++; println(\"base\"); return 7 }\n",
        "mut counter : I64 = initialize()\nmut narrow : U8 = 250\nmut width : USize = 0\n",
        "mut text := Str.with_capacity(32)\n",
        "Cell := struct { mark: U8 = 0; number: I64 = 0; text: Str = \"\"\nnamespace:\n",
        "mut drops : I64 = 0\n",
        "delete := func(own self: Cell, call_free: Bool = true) { Cell.drops++; Str.delete(own self.text,false); if call_free { free(own self) } }\n}\n",
        "mut cell := Cell(mark=3, number=counter, text=format(\"old\",\"!\"))\n",
        "read_count := func() returns I64 { return counter }\n",
        "bump := func() { counter++; narrow++; width++; text.push_str(\"x\"); cell.number = counter }\n",
        "replace_cell := func() { cell = Cell(mark=4, number=counter, text=text.clone()) }\n",
        "borrow_cell := func() returns ref Cell { return cell }\n",
        "write_narrow := func(mut value: U8) { value++ }\n",
        "Stats := struct {\nnamespace:\nmut total : I64 = 5\nmut label := \"\"\n}\n",
        "namespace_bump := func() { Stats.total++; Stats.label = format(Stats.label,\"n\") }\n"))
    File.writefile(format(work, "/globals_left.til"), "mode lib\nimport(\"./globals_base\")\nleft_init := proc() returns I64 { println(\"left\"); bump(); return read_count() }\nleft_value := left_init()\n")
    File.writefile(format(work, "/globals_right.til"), "mode lib\nimport(\"./globals_base\")\nright_init := proc() returns I64 { println(\"right\"); bump(); return read_count() }\nright_value := right_init()\n")
    declarations := format(
        "import(\"./globals_left\")\nimport(\"./globals_right\")\n",
        "mut root_count : I64 = 0\nroot_init := proc() returns I64 { println(\"root\"); root_count++; return read_count() }\n",
        "root_value := root_init()\n",
        "shadow := func(counter: I64) returns I64 { return counter + 1 }\n",
        "shadow_aggregate := func(text: I64) returns I64 { return text + 1 }\n",
        "recurse := func(n: I64) { if n > 0 { bump(); recurse(n-1) } }\n",
        "verify := proc() { assert(init_count == 1); assert(root_count == 1); assert(left_value == 8); assert(right_value == 9); assert(root_value == 9);\n",
        "assert(text.eq(\"xx\")); assert(cell.text.eq(\"old!\")); recurse(2); assert(shadow(100) == 101); assert(shadow_aggregate(40) == 41); assert(read_count() == 11);\n",
        "write_narrow(narrow); assert(narrow == 255); bump(); assert(narrow == 0); assert(width == 5);\n",
        "ref mut alias : Cell = borrow_cell(); alias.number = 90; assert(cell.number == 90);\n",
        "copy := cell.clone(); replace_cell(); assert(Cell.drops == 1); assert(copy.text.eq(\"old!\")); assert(cell.text.eq(\"xxxxx\"));\n",
        "namespace_bump(); namespace_bump(); assert(Stats.total == 7); assert(Stats.label.eq(\"nn\"));\n",
        "{ mut text := Str.with_capacity(8); text.push_str(\"local\"); assert(text.eq(\"local\")) }\n",
        "assert(text.eq(\"xxxxx\")); println(read_count().to_str(),\":\",text,\":\",Stats.label) }\n")
    expected := "base\nleft\nright\nroot\n12:xxxxx:nn\n"
    check(compiler, work, "globals_cli", format("mode cli\n", declarations, "main := proc() { verify() }\n"), expected)
    check(compiler, work, "globals_script", format("mode script\n", declarations, "verify()\n"), expected)
    check(compiler, work, "globals_references", format(
        "mode cli\nmut first : I64 = 1\nmut second : I64 = 2\n",
        "borrow_number := func(value: I64) returns ref I64 { return value }\n",
        "ref mut target : I64 = borrow_number(first)\nref mut source : I64 = borrow_number(second)\n",
        "mut raw : I8 = calloc(8,1)\nref mut byte : I8 = ptr_add(raw,0)\n",
        "change := func() { target = source; target = 9; byte = 65 }\n",
        "main := proc() { change(); assert(first == 1); assert(second == 9); assert(raw == 65); assert(byte == 65); free(own raw); println(target.to_str()) }\n"), "9\n")
    check(compiler, work, "empty_script", "mode script\n", "")
    // Namespace dependency order is independent of member declaration order.
    check(compiler, work, "globals_namespace_init", format(
        "mode cli\ninitialize := func() returns I64 { return 9 }\n",
        "Values := struct {\nnamespace:\nmut earlier : I64 = Values.later + 1\nmut later : I64 = initialize()\n}\n",
        "root_init := proc() returns I64 { println(\"root\"); return Values.earlier }\nmut runtime : I64 = root_init()\n",
        "main := proc() { assert(Values.earlier == 10); assert(Values.later == 9); assert(runtime == 10); println(\"namespace globals passed\") }\n"),
        "root\nnamespace globals passed\n")
    // The interpreter currently resolves the nested call through the caller's
    // shadow (200). Native functions must still read their lexical global (111).
    check(compiler, work, "globals_lexical_calls", format(
        "mode cli\nmut counter : I64 = 11\nread_count := func() returns I64 { return counter }\n",
        "shadow := func(counter: I64) returns I64 { return counter + read_count() }\n",
        "main := proc() { println(shadow(100).to_str()) }\n"), "111\n", interpret_source = false)
}

main := proc(compiler_arg: Str) {
    compiler := realpath_str(compiler_arg)
    work := "tmp/fasm_runtime"
    mkdir_p(work)
    check_globals(compiler, work)
    check_unboxed(compiler, work)
    check_closure_allocations(compiler, work)
    check(compiler, work, "global_callables", format(
        "mode cli\nAction := func(value: I64) returns I64\nSaved := struct { action: Action }\n",
        "make := func(start: I64) returns Action { state := start; return func(value: I64) returns I64 [own mut state] { state = state + value; return state } }\n",
        "save := func(action: Action) returns Saved { return Saved(action=action) }\n",
        "mut current : Action = make(10)\n",
        "main := proc() { assert(current(1) == 11); saved := save(current); assert(saved.action(1) == 12);\n",
        "assert(current(1) == 12); own saved.delete(); current = make(20); assert(current(1) == 21); println(\"global callbacks passed\") }\n"),
        "global callbacks passed\n")
    // Raw callable cells are a native ABI boundary. The interpreter's owning
    // Dynamic bookkeeping requires its typed-container path for these values.
    check(compiler, work, "callable_slots", format(
        "mode cli\nAction := func() returns I64\n",
        "make := func(start: I64) returns Action { state := start; return func() returns I64 [own mut state] { state++; return state } }\n",
        "main := proc() { mut slot : U8 = malloc(8); ref mut raw : Dynamic = to_ptr(slot); owner : Dynamic = make(1);\n",
        "til_closure_slot_take(raw,owner); assert(cast(raw,Action)() == 2); assert(cast(raw,Action)() == 3);\n",
        "mut copy : Dynamic = til_closure_slot_clone(raw); assert(cast(copy,Action)() == 4); assert(cast(raw,Action)() == 4);\n",
        "mut second : U8 = calloc(8,1); ref mut second_raw : Dynamic = to_ptr(second); popped : Dynamic = til_closure_slot_pop(copy);\n",
        "assert(deref(copy).is_null()); til_closure_slot_take(second_raw,popped); til_closure_slot_delete(copy); free(own copy);\n",
        "til_closure_slot_delete(raw); free(own slot); assert(cast(second_raw,Action)() == 5);\n",
        "til_closure_slot_delete(second_raw); free(own second); println(\"callable slots passed\") }\n"),
        "callable slots passed\n", interpret_source = false)
    // Use the existing hello-world source unchanged, rather than a FASM copy.
    check(compiler, work, "hello", File.readfile("examples/hello_script.til"), "Hello World!\n")
    check(compiler, work, "output", "mode cli\nmain := proc() { print_single(\"a\\x00Z\\x80Z\"); eprint_single(\"err%\\n\"); println(\"x\",\"y\") }\n", "a\x00Z\x80Zxy\n", "err%\n")
    check(compiler, work, "panic", "mode cli\nmain := proc() { panic(\"bad\",\" news\", loc = \"probe:7:3\") }\n", "probe:7:3: panic: bad news\n", "", 1)
    check(compiler, work, "assertion", "mode cli\nmain := proc() { mut n : I64 = 0; n = n + 1; assert(n == 2, loc = \"probe:2:1\") }\n", "probe:2:1: panic: assert failed\n", "", 1)
    check(compiler, work, "expectation", "mode cli\nmain := proc() { mut n : I64 = 0; n = n + 1; expect(n == 2, \"wrong\", loc = \"probe:3:1\") }\n", "probe:3:1: panic: assert failed: wrong\n", "", 1)
    check(compiler, work, "strings", "mode cli\nmain := proc() { mut s := Str.with_capacity(8); s.push_str(\"ab\\x00Z\"); copy := s.clone(); assert(copy.eq(s)); print_single(copy); print_flush(); joined := format(\"<\",s,\">\"); print_single(joined); print_flush(); empty := Str.with_capacity(0); assert(empty.len() == 0); mut n : I64 = -9223372036854775807; n = n - 1; println(n.to_str()) }\n", "ab\x00Z\n<ab\x00Z>\n-9223372036854775808\n")
    check(compiler, work, "memory", "mode cli\nmain := proc() { mut buf : I8 = calloc(8,1); memset(buf,65,7); text := Str.from_c_str(buf); println(text); mut grown : I8 = realloc(own buf,16); memset(ptr_add(grown,7),66,1); memset(ptr_add(grown,8),0,1); text2 := Str.from_c_str(grown); println(text2); memmove(ptr_add(grown,1),grown,7); text3 := Str.from_c_str(grown); println(text3); assert(memcmp(grown,ptr_add(grown,1),7) == 0); free(own grown) }\n", "AAAAAAA\nAAAAAAAB\nAAAAAAAA\n")
    check(compiler, work, "pointer_values", "mode cli\nmain := proc() { mut slot : I64 = malloc(8); slot = 123; ref mut alias : I64 = ptr_add(slot,0); alias = alias + 1; println(slot.to_str()); free(own slot); mut value : I64 = 7; memset(to_ptr(value),0,8); assert(value == 0); mut s := Str.with_capacity(2); s.push_str(\"Z\"); assert(c_str_len(s.c_str) == 1); mut signed_value : I32 = -1; signed_value = signed_value + 0; unsigned_value := signed_value.cast(U32); println(unsigned_value.to_str()) }\n", "124\n4294967295\n")
    // ASAN deliberately aborts rather than returning NULL for huge requests.
    // Compare the two native allocator contracts without ASAN's interposition.
    check(compiler, work, "allocation_failure", "mode cli\nfails := func(n: UPtr) returns Bool { p : I8 = malloc(n); mut failed := p.is_null(); free(own p); q : I8 = calloc(n,2); if q.is_null().not() { failed = false } free(own q); return failed }\nmain := proc() { mut n : UPtr = 0; n = n - 1; assert(fails(n)) }\n", "", interpret_source = false, cage_allocation_failure = true)
    check(compiler, work, "counted_path", "mode cli\nimport(\"std/file\")\nmain := proc() { mut path := Str.with_capacity(16); path.push_str(\"sampleZZ\"); view := path.substr(0,6); ref h : Dynamic = cfile_open(view,true); cfile_write_str(h,\"ok\"); cfile_close(h); assert(cfile_exists(\"sample\")); assert(cfile_exists(\"sampleZZ\").not()); cfile_remove(view) }\n", "")
    mut large := "x"
    for _ in 0..17 { large = format(large, large) }
    File.writefile(format(work, "/large"), large.substr(0, 130000))
    check(compiler, work, "files", "mode cli\nimport(\"std/file\")\nmain := proc() { ref h : Dynamic = cfile_open(\"sample\",true); cfile_write_str(h,\"ab\\x00Z\"); cfile_close(h); assert(cfile_exists(\"sample\")); ref a : Dynamic = cfile_open_append(\"sample\"); cfile_write_str(a,\"!\"); cfile_close(a); ref r : Dynamic = cfile_open_update(\"sample\"); cfile_seek(r,1); cfile_write_str(r,\"B\"); cfile_seek_end(r,-1); last := cfile_read_n(r,9); assert(last.eq(\"!\")); assert(cfile_tell(r) == 5); cfile_seek_cur(r,-5); empty := cfile_read_n(r,-1); assert(empty.len() == 0); all := cfile_read_all(r); print_single(all); print_flush(); cfile_close(r); cfile_remove(\"sample\"); assert(cfile_exists(\"sample\").not()); assert(cfile_exists(\".\")); ref big : Dynamic = cfile_open(\"large\",false); grown := cfile_read_all(big); println(grown.len().to_str()); cfile_close(big) }\n", "aB\x00Z!\n130000\n")
    // /proc advertises length zero; read_all must still read to EOF.
    check(compiler, work, "proc", "mode cli\nimport(\"std/file\")\nmain := proc() { ref h : Dynamic = cfile_open(\"/proc/version\",false); s := cfile_read_all(h); print_single(s); cfile_close(h) }\n", File.readfile("/proc/version"))
    failure(compiler, work, "missing", "mode cli\nimport(\"std/file\")\nmain := proc() { mut path := Str.with_capacity(16); path.push_str(\"not-created\"); ref h : Dynamic = cfile_open(path,false); cfile_close(h) }\n")
    failure(compiler, work, "full", "mode cli\nimport(\"std/file\")\nmain := proc() { mut path := Str.with_capacity(16); path.push_str(\"/dev/full\"); ref h : Dynamic = cfile_open(path,true); cfile_write_str(h,\"not lost silently\"); cfile_close(h) }\n")
    mkdir_p(format(work, "/directory"))
    failure(compiler, work, "remove_directory", "mode cli\nimport(\"std/file\")\nmain := proc() { mut path := Str.with_capacity(16); path.push_str(\"directory\"); File.remove(path) }\n")
    expect(File.is_dir(format(work, "/directory")), "File.remove removed a directory")
    // realloc's old block survives failure. Check this at the native ABI:
    // til's `own old` transfer deliberately prevents subsequent source uses.
    root := compiler.substr(0, compiler.rfind("/bin/").to_usize())
    File.writefile(format(work, "/realloc.fasm"), format("format ELF64 executable 3\nentry start\nUSIZE_BYTES=8\nSTR_SIZE=24\nSTR_CAP=16\nCAP_VIEW=-2\nCAP_LIT=-1\nsegment readable executable\ninclude '", root, "/src/self/codegen/ext.fasm'\nsegment readable executable\nstart:\nmov edi,4\ncall rt_malloc\nmov r12,rax\nmov dword [rax],123456\nmov rdi,rax\nmov rsi,-1\ncall rt_realloc\ntest rax,rax\njnz bad\ncmp dword [r12],123456\njne bad\nmov rdi,r12\ncall rt_free\nxor edi,edi\njmp rt_exit\nbad:\nmov edi,1\njmp rt_exit\n"))
    assemble := Cmd.new(format(root, "/vendor/fasm/fasm"), format(work, "/realloc.fasm"), format(work, "/realloc"))
    assemble.capture()
    assembly_status := assemble.run()
    expect(assembly_status == 0, assemble.out(), assemble.err())
    permissions := Cmd.new("chmod", "+x", format(work, "/realloc"))
    expect(permissions.run() == 0, "chmod failed")
    reallocation := Cmd.new(format(work, "/realloc"))
    expect(reallocation.run() == 0, "failed realloc damaged the old block")
    println("fasm_runtime PASS")
}
