mode script

// Issue #313 regression, COMPILE-ONLY: the native opt-out of the default
// cage. Built with --usize=32 --cptr=64, every own pointer field is a real
// 8-byte pointer (ext.h TIL_OWN_PTR natively), so on a 64-bit host
// Str = c_str(8)+count(4)+cap(4) = 16 and Vec has the same layout; the
// default cage build is 12 (test/cptr32_sizes.til). Map holds two Vecs
// inline: 32.
//
// Driven ONLY as a compiled binary by make.til's check_cptr64 target -- NOT
// interpreted: the compile-time interpreter manipulates the compiler's own
// HOST structs, so X.size() is the host width under the interpreter.

check := proc(label: Str, got: USize, want: USize) {
    if got.neq(want) {
        println(format("FAIL: ", label, " = ", got.to_str(), ", want ", want.to_str()))
        exit(1)
    }
}

check("Str.size()", Str.size(), 16)
check("Vec(Str).size()", Vec(Str).size(), 16)
check("Vec(I64).size()", Vec(I64).size(), 16)
check("Map(Str, I64).size()", Map(Str, I64).size(), 32)
check("dyn_size_of Str", dyn_size_of("Str"), 16)

// Elements stride at the native width: 3 pushes stay addressable.
mut v := Vec(Str).new()
v.push(own "a")
v.push(own "bb")
v.push(own "ccc")
check("vec len", v.len(), 3)
ref e0 : Str = v.unsafe_get(0)
ref e2 : Str = v.unsafe_get(2)
if e0.eq("a").and(e2.eq("ccc")).not() { println("FAIL: vec stride"); exit(1) }

// A view into the middle of a buffer is a plain pointer here.
whole := format("abc", "defgh")
mid := whole.substr(3, 4)
if mid.eq("defg").not() { println("FAIL: substr view"); exit(1) }

println("cptr64 sizes OK")
