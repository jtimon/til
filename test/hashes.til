mode test

import("../src/core/dyn")
import("../src/std/hash")

// Issue #236: a file-level `mut X : HashFn = fnv1a` decl was emitted as
// a fresh function-local in main() that shadowed the global. The fix in
// src/self/builder.til detects script-global FuncPtr decls and emits a
// plain assignment instead. The two tests below pin the working
// behaviour: declare a file-level FuncPtr, observe the default, swap it
// from another scope, observe the swap.
mut TEST_FILE_LEVEL_HASHER : HashFn = fnv1a

test_file_level_funcptr_default := test() {
    h := TEST_FILE_LEVEL_HASHER("abc", 3)
    expected := fnv1a("abc", 3)
    assert(h.eq(expected))
}

test_file_level_funcptr_swap := test() {
    TEST_FILE_LEVEL_HASHER = knuth_bytes
    h := TEST_FILE_LEVEL_HASHER("abc", 3)
    expected := knuth_bytes("abc", 3)
    assert(h.eq(expected))
    // Restore so the test pair is order-independent.
    TEST_FILE_LEVEL_HASHER = fnv1a
}

test_hash_i64_deterministic := test() {
    a := hash_i64(42)
    b := hash_i64(42)
    assert(a.eq(b))
}

test_hash_i64_distinct := test() {
    a := hash_i64(0)
    b := hash_i64(1)
    c := hash_i64(2)
    assert(a.eq(b).not())
    assert(b.eq(c).not())
    assert(a.eq(c).not())
}

test_hash_i64_negative_does_not_panic := test() {
    h := hash_i64(-1)
    g := hash_i64(-42)
    assert(h.eq(g).not())
}

test_hash_u64_deterministic := test() {
    a := hash_u64(99)
    b := hash_u64(99)
    assert(a.eq(b))
}

test_hash_u64_distinct := test() {
    a := hash_u64(0)
    b := hash_u64(1)
    assert(a.eq(b).not())
}

test_hash_str_deterministic := test() {
    a := hash_str("hello")
    b := hash_str("hello")
    assert(a.eq(b))
}

test_hash_str_distinct := test() {
    a := hash_str("hello")
    b := hash_str("world")
    assert(a.eq(b).not())
}

test_hash_str_one_char_diff := test() {
    // Avalanche check: a single-byte change must alter the hash.
    a := hash_str("abc")
    b := hash_str("abd")
    assert(a.eq(b).not())
}

test_hash_str_empty := test() {
    h := hash_str("")
    // Empty input collapses to the FNV offset basis.
    assert(h.eq(FNV_OFFSET))
}

test_fnv1a_standard_vectors := test() {
    // Published FNV-1a 64-bit vectors, written as 0 - (2^64 - expected)
    // when the unsigned result exceeds the signed literal range.
    hash_a : U64 = 0.sub(5808556873153909620)
    hash_abc : U64 = 0.sub(1792535898324117685)
    hash_foobar : U64 = 0.sub(8821353812377114648)
    assert_eq(U64, hash_str("a"), hash_a)
    assert_eq(U64, hash_str("abc"), hash_abc)
    assert_eq(U64, hash_str("foobar"), hash_foobar)

    // Lengths four and five exercise the unrolled body and its scalar tail.
    hash_1234 : U64 = 2282126479029740061
    hash_12345 : U64 = 0.sub(1912366794928059912)
    assert_eq(U64, hash_str("1234"), hash_1234)
    assert_eq(U64, hash_str("12345"), hash_12345)

    // FNV hashes octets, not signed chars. Pin 0xff explicitly.
    mut high_byte := Str.with_capacity(1)
    ref mut byte : I8 = high_byte.c_str
    byte = -1
    high_byte.count = 1
    hash_ff : U64 = 0.sub(5808391946409677970)
    assert_eq(U64, hash_str(high_byte), hash_ff)
}

test_fnv1a_unaligned_blocks_and_tails := test() {
    mut bytes := Str.with_capacity(66)
    mut octet : I8 = 19
    for i in 0..bytes.cap {
        ref mut byte : I8 = ptr_add(bytes.c_str, i.to_uptr())
        byte = octet
        octet = octet + 73
    }
    bytes.count = 66
    ref mut nul : I8 = ptr_add(bytes.c_str, 17)
    nul = 0
    // Start one byte into a buffer containing a NUL and high-bit octets.
    // Fixed reference values cover empty input, block boundaries and tails.
    ref start : U8 = ptr_add(bytes.c_str, 1)
    lengths := array(USize, 0, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65)
    zero : U64 = 0
    expected := array(U64,
        FNV_OFFSET, zero.sub(5808498599037614437),
        670934123012774746, zero.sub(5787765325149580580),
        zero.sub(6411396087937211055), zero.sub(299750214297648605),
        4649656994029033188, 2886877171246360205, 7386479515647416235,
        5659021545637964660, 8864225518955740757, 6278684176491670127,
        3523728802823422880, 3634789006931186377,
        6301751478826961295, 6033111077508075168,
        zero.sub(7153822116625471767), zero.sub(9065767969908926257))
    for i in 0..lengths.len() {
        assert_eq(U64, fnv1a(start, lengths[i]), expected[i])
    }
}

test_bucket_in_range := test() {
    cap : USize = 16
    for i in 0..100 {
        bi := bucket(hash_i64(i), cap)
        assert(bi.lt(cap))
    }
}

test_bucket_covers_all_with_enough_keys := test() {
    // 1000 distinct I64 keys against 16 buckets should hit every bucket
    // if the hash spreads at all. Tracked in a 16-byte stack-style flag
    // vector built out of an I64 bitset to avoid pulling in Array here.
    cap : USize = 16
    mut seen : I64 = 0
    for i in 0..1000 {
        bi := bucket(hash_i64(i), cap)
        mask : I64 = 1.mul(pow2(bi.to_i64()))
        seen = seen.bor(mask)
    }
    // 16 buckets -> low 16 bits all set -> 0xFFFF.
    assert_eq(I64, seen, 65535)
}

// Local helper: 2^n for small n (n < 16). Cheap stand-in for a missing
// shift-left intrinsic.
pow2 := func(n: I64) returns I64 {
    mut r := 1
    for _ in 0..n {
        r = r.mul(2)
    }
    return r
}
