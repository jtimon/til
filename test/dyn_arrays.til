mode test

import("../src/std/dyn_array")

test_dyn_array_new_get_set := test() {
    mut a := DynArray.new(I64, 3)
    a.set(0, own 10)!
    a.set(1, own 20)!
    a.set(2, own 30)!

    ref x : I64 = a.get(0)!
    ref y : I64 = a.get(1)!
    ref z : I64 = a.get(2)!

    assert_eq(I64, x, 10)
    assert_eq(I64, y, 20)
    assert_eq(I64, z, 30)
    assert_eq(USize, a.len(), 3)
}

test_dyn_array_subscript := test() {
    mut a := DynArray.new(I64, 3)
    a.set(0, own 10)!
    a.set(1, own 20)!
    a.set(2, own 30)!

    ref x : I64 = a[0]
    ref y : I64 = a[1]
    ref z : I64 = a[2]

    assert_eq(I64, x, 10)
    assert_eq(I64, y, 20)
    assert_eq(I64, z, 30)

    i : USize = 1
    ref w : I64 = a[i.add(1)]
    assert_eq(I64, w, 30)
}

// Issue #225 (Dyn* follow-up): subscript assignment now works on
// DynArray too -- `a[i] = x` -> `a.set(i, own x)!`.
test_dyn_array_subscript_assign := test() {
    mut a := DynArray.new(I64, 3)
    a[0] = 10
    a[1] = 20
    a[2] = 30
    a[0] = 100
    idx : USize = 1
    a[idx.add(1)] = 300
    ref x : I64 = a[0]
    ref y : I64 = a[1]
    ref z : I64 = a[2]
    assert_eq(I64, x, 100)
    assert_eq(I64, y, 20)
    assert_eq(I64, z, 300)
}

// OOB set throws; Str element so the owned value's throw-path cleanup
// runs under ASAN.
test_dyn_array_subscript_assign_oob := test() {
    mut a := DynArray.new(Str, 2)
    mut caught := false
    a.set(5, own "unstored")?
    catch (err: OutOfBounds) {
        caught = true
    }
    assert(caught)
}

test_dyn_array_strings := test() {
    mut a := DynArray.new(Str, 2)
    a.set(0, own "hello")!
    a.set(1, own "world")!

    ref s0 : Str = a.get(0)!
    ref s1 : Str = a.get(1)!

    assert_eq(Str, s0, "hello")
    assert_eq(Str, s1, "world")
}

test_dyn_array_overwrite := test() {
    mut a := DynArray.new(I64, 2)
    a.set(0, own 1)!
    a.set(1, own 2)!
    a.set(0, own 99)!

    ref v : I64 = a.get(0)!
    assert_eq(I64, v, 99)
}

test_dyn_array_body_call_set := test() {
    mut x := 0
    mut a := DynArray.new(Body, 1)
    assert_eq(USize, a.elem_kind, ELEM_FN)
    b : Body = [mut x] { x = x.add(1) }
    a.set(0, own b)!
    ref raw : Dynamic = a[0]
    cast(raw, Body)()
    assert_eq(I64, x, 1)

    b2 : Body = [mut x] { x = x.add(2) }
    a.set(0, own b2)!
    ref raw2 : Dynamic = a[0]
    cast(raw2, Body)()
    assert_eq(I64, x, 3)
}

// DynArray.concat -- a fresh DynArray with self's elements then other's,
// every element cloned so both sources stay intact (Array.concat's
// counterpart, with the element type checked at runtime).
test_dyn_array_concat := test() {
    mut a := DynArray.new(Str, 2)
    a.set(0, own "a")!
    a.set(1, own "b")!
    mut b := DynArray.new(Str, 1)
    b.set(0, own "c")!

    c := a.concat(b)

    assert_eq(USize, c.len(), 3)
    ref c0 : Str = c[0]
    ref c1 : Str = c[1]
    ref c2 : Str = c[2]
    assert_eq(Str, c0, "a")
    assert_eq(Str, c1, "b")
    assert_eq(Str, c2, "c")
    // sources keep their own elements
    ref a0 : Str = a[0]
    ref b0 : Str = b[0]
    assert_eq(Str, a0, "a")
    assert_eq(Str, b0, "c")
    assert_eq(USize, a.len(), 2)
}

test_dyn_array_concat_empty := test() {
    mut a := DynArray.new(I64, 2)
    a.set(0, own 1)!
    a.set(1, own 2)!
    e := DynArray.new(I64, 0)
    c := a.concat(e)
    assert_eq(USize, c.len(), 2)
    d := e.concat(a)
    assert_eq(USize, d.len(), 2)
    ref d1 : I64 = d[1]
    assert_eq(I64, d1, 2)
}

// DynArray.to_vec -- a fresh DynVec with a clone of every element, self
// intact (Array.to_vec's counterpart).
test_dyn_array_to_vec := test() {
    mut a := DynArray.new(Str, 2)
    a.set(0, own "a")!
    a.set(1, own "b")!

    mut v := a.to_vec()

    assert_eq(USize, v.len(), 2)
    ref v0 : Str = v[0]
    ref v1 : Str = v[1]
    assert_eq(Str, v0, "a")
    assert_eq(Str, v1, "b")
    ref a0 : Str = a[0]
    assert_eq(Str, a0, "a")
    assert_eq(USize, a.len(), 2)
    // the result is a real DynVec, so it still grows
    v.push(own "c")
    ref v2 : Str = v[2]
    assert_eq(Str, v2, "c")
}

test_dyn_array_to_vec_empty := test() {
    e := DynArray.new(I64, 0)
    mut v := e.to_vec()
    assert_eq(USize, v.len(), 0)
    v.push(own 7)
    ref v0 : I64 = v[0]
    assert_eq(I64, v0, 7)
}
