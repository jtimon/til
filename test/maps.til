mode test

test_i64_map := test() {
    mut m := Map(I64, I64).new()
    m.set(3, own 30)
    m.set(1, own 10)
    m.set(2, own 20)
    assert_eq(USize, m.len(), 3)
    assert(m.has(1))
    assert(m.has(2))
    assert(m.has(3))
    assert(m.has(4).not())

    ref v1 : I64 = m[1]
    ref v2 : I64 = m[2]
    ref v3 : I64 = m[3]
    assert_eq(I64, v1, 10)
    assert_eq(I64, v2, 20)
    assert_eq(I64, v3, 30)

    // overwrite existing key
    m.set(2, own 99)
    assert_eq(USize, m.len(), 3)
    ref v2b : I64 = m[2]
    assert_eq(I64, v2b, 99)
}

test_str_map := test() {
    mut sm := Map(Str, I64).new()
    sm.set("banana", own 2)
    sm.set("apple", own 1)
    sm.set("cherry", own 3)
    assert_eq(USize, sm.len(), 3)
    assert(sm.has("apple"))
    assert(sm.has("banana"))
    assert(sm.has("cherry"))
    assert(sm.has("date").not())
    ref sa : I64 = sm["apple"]
    ref sb : I64 = sm["banana"]
    assert_eq(I64, sa, 1)
    assert_eq(I64, sb, 2)
}

test_map_remove := test() {
    mut m := Map(Str, I64).new()
    m.set("a", own 1)
    m.set("b", own 2)
    m.set("c", own 3)
    m.set("d", own 4)

    assert(m.remove("missing").not())
    assert_eq(USize, m.len(), 4)

    assert(m.remove("a"))
    assert(m.has("a").not())
    assert_eq(I64, m["b"], 2)

    assert(m.remove("c"))
    assert(m.has("c").not())
    assert_eq(I64, m["d"], 4)

    assert(m.remove("d"))
    assert(m.has("d").not())
    assert_eq(USize, m.len(), 1)
    assert_eq(I64, m["b"], 2)
}

// --- Map literal tests ---

test_map_literal_str_i64 := test() {
    m := {"a": 1, "b": 2, "c": 3}
    assert_eq(USize, m.len(), 3)
    assert(m.has("a"))
    assert(m.has("b"))
    assert(m.has("c"))
    ref va : I64 = m["a"]
    ref vb : I64 = m["b"]
    assert_eq(I64, va, 1)
    assert_eq(I64, vb, 2)
}

test_map_literal_i64_i64 := test() {
    m := {0: 100, 1: 200, 2: 300}
    assert_eq(USize, m.len(), 3)
    ref v0 : I64 = m[0]
    ref v2 : I64 = m[2]
    assert_eq(I64, v0, 100)
    assert_eq(I64, v2, 300)
}

test_map_literal_i64_str := test() {
    m := {1: "one", 2: "two"}
    assert_eq(USize, m.len(), 2)
    ref v1 : Str = m[1]
    assert_eq(Str, v1, "one")
}

// --- Issue #287: key-value for-in (`for k, v in map`) ---

// `for k, v in map` visits every entry with the right key/value pairing.
// Map iterates in sorted key order, so the concatenated keys are exact.
// An ANNOTATED map literal. The literal node has no type of its own
// (Expr.til_type answers the bare Map constant for it), so the annotation
// is checked against the instance the ELEMENTS name; this form was
// rejected as "declared as Map__Str_I64 but value is Map" before.
test_map_literal_typed := test() {
    m : Map(Str, I64) = {"a": 1, "b": 2}
    assert_eq(USize, m.len(), 2)
    assert_eq(I64, m["b"], 2)
}

test_map_for_in_kv := test() {
    mut m := Map(Str, I64).new()
    m.set("b", own 2)
    m.set("a", own 1)
    m.set("c", own 3)
    mut order := Str.with_capacity(8)
    mut sum := 0
    mut pairs_ok := true
    for k, v in m {
        order.push_str(k)
        sum = sum.add(v)
        if k.eq("a").and(v.eq(1).not()) { pairs_ok = false }
        if k.eq("b").and(v.eq(2).not()) { pairs_ok = false }
        if k.eq("c").and(v.eq(3).not()) { pairs_ok = false }
    }
    assert_eq(Str, order, "abc")
    assert_eq(I64, sum, 6)
    assert(pairs_ok)
}

// `for k, mut v in map` mutates values in place through the value ref.
test_map_for_in_kv_mut := test() {
    mut m := Map(Str, I64).new()
    m.set("x", own 10)
    m.set("y", own 20)
    for k, mut v in m {
        assert(k.len().gt(0))
        v = v.mul(2)
    }
    ref vx : I64 = m["x"]
    ref vy : I64 = m["y"]
    assert_eq(I64, vx, 20)
    assert_eq(I64, vy, 40)
}

// `for k, mut v in <mut map>`: read the key and mutate the paired value in
// place (the key drives a different update per entry). Confirms the key/value
// pairing holds during a value-mutating walk and that `mut m` is accepted.
test_map_for_in_kv_mut_uses_key := test() {
    mut m := Map(Str, I64).new()
    m.set("a", own 1)
    m.set("b", own 2)
    for k, mut v in m {
        if k.eq("a") { v = v.mul(100) }
        else { v = v.mul(10) }
    }
    ref a : I64 = m["a"]
    ref b : I64 = m["b"]
    assert_eq(I64, a, 100)
    assert_eq(I64, b, 20)
}

// The key binding may be `_` when only values are needed.
test_map_for_in_kv_ignore_key := test() {
    mut m := Map(I64, I64).new()
    m.set(1, own 100)
    m.set(2, own 200)
    m.set(3, own 300)
    mut sum := 0
    for _, v in m {
        sum = sum.add(v)
    }
    assert_eq(I64, sum, 600)
}

// Both bindings may be `_` (count-only walk). Each `_` is a discard that
// emits no element decl, so the two do not collide as duplicate C locals.
test_map_for_in_kv_ignore_both := test() {
    mut m := Map(Str, I64).new()
    m.set("a", own 1)
    m.set("b", own 2)
    m.set("c", own 3)
    mut n := 0
    for _, _ in m {
        n++
    }
    assert_eq(I64, n, 3)
}

// Map.with_capacity mirrors Vec.with_capacity: both backing Vecs are
// pre-sized, so inserting up to n reallocs neither.
test_map_with_capacity := test() {
    mut m := Map(Str, I64).with_capacity(8)
    assert_eq(USize, m.len(), 0)
    assert(m.keys.cap.gte(8))
    assert(m.values.cap.gte(8))
    for i in 0..8 { m.set(format("k", i.to_str()), own i) }
    assert_eq(USize, m.len(), 8)
    ref v : I64 = m["k3"]
    assert_eq(I64, v, 3)
}

test_map_with_capacity_zero_is_lazy := test() {
    mut m := Map(Str, I64).with_capacity(0)
    assert_eq(USize, m.len(), 0)
    assert_eq(USize, m.keys.cap, 0)
    m.set("a", own 1)
    ref v : I64 = m["a"]
    assert_eq(I64, v, 1)
}

test_map_dynamic_pointer_slots := test() {
    mut payload : I64 = 41
    mut other : I64 = 73
    mut values := Map(Str, Dynamic).with_capacity(0)
    // Dynamic containers consume a pointer-sized cell, not the pointee.
    mut cell : UPtr = malloc(UPtr.size())
    write_ptr(cell, to_ptr(payload))
    values.set("middle", own cell)
    mut first : UPtr = malloc(UPtr.size())
    write_ptr(first, to_ptr(other))
    values.set("first", own first)
    ref mut slot : Dynamic = values.get("middle")!
    assert(ptr_eq(deref(slot), to_ptr(payload)))
    write_i64(deref(slot), 99)
    assert_eq(I64, payload, 99)
    mut snapshot := values.clone()
    ref saved : Dynamic = snapshot.get("middle")!
    assert(ptr_eq(deref(saved), to_ptr(payload)))
    assert(ptr_eq(slot, saved).not())
    mut replacement : UPtr = malloc(UPtr.size())
    write_ptr(replacement, to_ptr(other))
    values.set("middle", own replacement)
    assert_eq(USize, values.len(), 2)
    ref replaced : Dynamic = values.get("middle")!
    assert(ptr_eq(deref(replaced), to_ptr(other)))
    assert(ptr_eq(deref(saved), to_ptr(payload)))
    assert(values.remove("first"))
    assert(values.remove("absent").not())
    values.clear()
    snapshot.clear()
    // Removing the slots never destroys the independently owned pointees.
    assert_eq(I64, payload, 99)
    assert_eq(I64, other, 73)
    mut empty : UPtr = malloc(UPtr.size())
    memset(empty, 0, UPtr.size())
    values.set("reused", own empty)
    ref null_slot : Dynamic = values.get("reused")!
    assert(deref(null_slot).is_null())
    assert(values.remove("reused"))
    mut caught := false
    ref _ : Dynamic = values.get("reused")?
    catch (err: KeyNotFound) { caught = true }
    assert(caught)
}

test_map_dynamic_growth_and_pointer_width := test() {
    mut values := Map(I64, Dynamic).with_capacity(2)
    zero : Dynamic = 0
    // USize32 must still preserve the entire native pointer word.
    for i in 0..16 {
        mut cell : UPtr = malloc(UPtr.size())
        write_ptr(cell, ptr_add(zero, UPtr.MAX.sub(i.to_usize().to_uptr())))
        values.set(15 - i, own cell)
    }
    mut snapshot := values.clone()
    for i in 0..16 {
        ref slot : Dynamic = values.get(i)!
        assert(ptr_eq(deref(slot), ptr_add(zero, UPtr.MAX.sub(15.sub(i).to_usize().to_uptr()))))
    }
    for i in 0..8 { assert(values.remove(i)) }
    values.clear()
    for i in 0..16 {
        ref slot : Dynamic = snapshot.get(i)!
        assert(ptr_eq(deref(slot), ptr_add(zero, UPtr.MAX.sub(15.sub(i).to_usize().to_uptr()))))
    }
    snapshot.clear()
}

MapNames := Set(Str)
MapPointers := Map(Str, Dynamic)
OrderedMapPayload := enum { Empty, Names: MapNames, Pointers: MapPointers }

test_map_ordered_container_payloads := test() {
    mut names := Set(Str).new()
    names.add(own format("alpha"))
    names.add(own format("beta"))
    mut payload : I64 = 123
    mut pointers := Map(Str, Dynamic).new()
    mut cell : UPtr = malloc(UPtr.size())
    write_ptr(cell, to_ptr(payload))
    pointers.set("payload", own cell)
    mut values := Map(I64, OrderedMapPayload).new()
    values.set(1, own OrderedMapPayload.Names(names.clone()))
    values.set(2, own OrderedMapPayload.Pointers(pointers.clone()))
    mut snapshot := values.clone()
    names.clear()
    pointers.clear()
    values.clear()
    ref saved_names : OrderedMapPayload = snapshot.get(1)!
    switch saved_names {
    case .Names(saved):
        assert_eq(USize, saved.len(), 2)
        assert(saved.has("alpha"))
        assert(saved.has("beta"))
    case: panic("ordered Set payload tag")
    }
    ref saved_pointers : OrderedMapPayload = snapshot.get(2)!
    switch saved_pointers {
    case .Pointers(saved):
        ref slot : Dynamic = saved.get("payload")!
        assert(ptr_eq(deref(slot), to_ptr(payload)))
    case: panic("ordered Map payload tag")
    }
    snapshot.clear()
    assert_eq(I64, payload, 123)
}

MapLifecycleCounts := struct {
    created : I64 = 0
    cloned : I64 = 0
    dropped : I64 = 0
    freed_outer : I64 = 0
}

// Lifecycle instrumentation is external to the read-only values being cloned.
// Each test resets this ledger before constructing its resources.
mut map_lifecycle_counts := MapLifecycleCounts()

MapHookedResource := struct {
    own bytes : U8
namespace:
    new := func(value: I64) returns MapHookedResource {
        map_lifecycle_counts.created++
        mut bytes : U8 = malloc(I64.size())
        write_i64(bytes, value)
        return MapHookedResource(bytes = bytes)
    }
    clone := func(self: MapHookedResource) returns MapHookedResource {
        map_lifecycle_counts.cloned++
        // The raw buffer is a full I64, not the U8 field label's one byte.
        mut bytes : U8 = malloc(I64.size())
        memcpy(bytes, self.bytes, I64.size())
        return MapHookedResource(bytes = bytes)
    }
    read := func(self: MapHookedResource) returns I64 {
        ref value : I64 = to_ptr(self.bytes)
        return value.clone()
    }
    set := func(mut self: MapHookedResource, value: I64) { write_i64(self.bytes, value) }
    delete := func(own self: MapHookedResource, call_free: Bool = true) {
        map_lifecycle_counts.dropped++
        free(own self.bytes)
        if call_free { map_lifecycle_counts.freed_outer++; free(own self) }
    }
}

MapHookedWrapper := struct { value: MapHookedResource }
MapHookedPayload := enum { Empty, Direct: MapHookedResource, Wrapped: MapHookedWrapper }
MapOwnedHookedWrapper := struct { own value: MapHookedResource }
MapOwnedHookedPayload := enum { Empty, Wrapped: MapOwnedHookedWrapper }

test_map_nested_custom_resource_hooks := test() {
    map_lifecycle_counts = MapLifecycleCounts()
    ref counts : MapLifecycleCounts = to_ptr(map_lifecycle_counts)
    {
        mut items := Vec(MapHookedResource).new()
        items.push(own MapHookedResource.new(4294967301))
        items.push(own MapHookedResource.new(73))
        mut values := Map(I64, Vec(MapHookedResource)).new()
        values.set(1, own items)
        before_clone := counts.cloned.clone()
        mut snapshot := values.clone()
        assert_eq(I64, counts.cloned, before_clone + 2)
        ref mut stored_items : Vec(MapHookedResource) = values.get(1)!
        ref mut original : MapHookedResource = stored_items.get(0)!
        original.set(99)
        ref copied_items : Vec(MapHookedResource) = snapshot.get(1)!
        assert_eq(I64, copied_items.get(0)!.read(), 4294967301)
        before_drop := counts.dropped.clone()
        assert(values.remove(1))
        assert_eq(I64, counts.dropped, before_drop + 2)
        assert_eq(I64, copied_items.get(1)!.read(), 73)
        snapshot.clear()
        assert_eq(I64, counts.dropped, before_drop + 4)
    }
    assert_eq(I64, counts.created, 2)
    assert_eq(I64, counts.dropped, counts.created + counts.cloned)
    assert_eq(I64, counts.freed_outer, 0)
}

test_map_custom_resource_enum_payloads := test() {
    map_lifecycle_counts = MapLifecycleCounts()
    ref counts : MapLifecycleCounts = to_ptr(map_lifecycle_counts)
    {
        mut values := Map(I64, MapHookedPayload).new()
        values.set(1, own MapHookedPayload.Direct(MapHookedResource.new(4294967301)))
        wrapped := MapHookedWrapper(value = MapHookedResource.new(17))
        values.set(2, own MapHookedPayload.Wrapped(wrapped))
        before_clone := counts.cloned.clone()
        mut snapshot := values.clone()
        assert_eq(I64, counts.cloned, before_clone + 2)
        before_drop := counts.dropped.clone()
        values.clear()
        assert_eq(I64, counts.dropped, before_drop + 2)
        ref direct : MapHookedPayload = snapshot.get(1)!
        switch direct {
        case .Direct(resource): assert_eq(I64, resource.read(), 4294967301)
        case: panic("custom resource payload tag")
        }
        ref nested : MapHookedPayload = snapshot.get(2)!
        switch nested {
        case .Wrapped(wrapper): assert_eq(I64, wrapper.value.read(), 17)
        case: panic("custom nested resource payload tag")
        }
        snapshot.clear()
        assert_eq(I64, counts.dropped, before_drop + 4)
    }
    assert_eq(I64, counts.created, 2)
    assert_eq(I64, counts.dropped, counts.created + counts.cloned)
    assert_eq(I64, counts.freed_outer, 0)
}

test_map_custom_owned_payload_outer := test() {
    map_lifecycle_counts = MapLifecycleCounts()
    ref counts : MapLifecycleCounts = to_ptr(map_lifecycle_counts)
    {
        mut values := Map(I64, MapOwnedHookedPayload).new()
        wrapped := MapOwnedHookedWrapper(value = MapHookedResource.new(4294967301))
        values.set(1, own MapOwnedHookedPayload.Wrapped(wrapped))
        before_clone := counts.cloned.clone()
        mut snapshot := values.clone()
        assert_eq(I64, counts.cloned, before_clone + 1)
        before_drop := counts.dropped.clone()
        before_free := counts.freed_outer.clone()
        values.clear()
        assert_eq(I64, counts.dropped, before_drop + 1)
        assert_eq(I64, counts.freed_outer, before_free + 1)
        ref nested : MapOwnedHookedPayload = snapshot.get(1)!
        switch nested {
        case .Wrapped(wrapper): assert_eq(I64, wrapper.value.read(), 4294967301)
        case: panic("custom owned payload tag")
        }
        snapshot.clear()
        assert_eq(I64, counts.dropped, before_drop + 2)
        assert_eq(I64, counts.freed_outer, before_free + 2)
    }
    assert_eq(I64, counts.created, 1)
    assert_eq(I64, counts.dropped, counts.created + counts.cloned)
    assert_eq(I64, counts.freed_outer, counts.dropped)
}

mut map_enum_clones : I64 = 0
mut map_enum_drops : I64 = 0
MapCustomLifecycle := enum {
    Empty, Number: I64,
namespace:
    clone := func(self: MapCustomLifecycle) returns MapCustomLifecycle {
        map_enum_clones++
        switch self {
        case .Empty: return MapCustomLifecycle.Empty
        case .Number(value): return MapCustomLifecycle.Number(value + 1)
        }
    }
    delete := func(own self: MapCustomLifecycle, call_free: Bool = true) {
        map_enum_drops++
        if call_free { free(own self) }
    }
}

MapCustomLiteralClone := enum {
    Empty, Number: I64,
namespace:
    clone := func(self: MapCustomLiteralClone) returns MapCustomLiteralClone {
        map_enum_clones++
        if self.is(MapCustomLiteralClone.Empty) { return MapCustomLiteralClone.Number(99) }
        return MapCustomLiteralClone.Empty
    }
}

test_map_custom_enum_lifecycle := test() {
    map_enum_clones = 0
    map_enum_drops = 0
    {
        mut values := Map(I64, MapCustomLifecycle).new()
        values.set(1, own MapCustomLifecycle.Number(7))
        mut snapshot := values.clone()
        assert_eq(I64, map_enum_clones, 1)
        ref copied : MapCustomLifecycle = snapshot.get(1)!
        switch copied {
        case .Number(value): assert_eq(I64, value, 8)
        case: panic("custom enum clone result")
        }
        values.set(1, own MapCustomLifecycle.Number(9))
        assert_eq(I64, map_enum_drops, 1)
        values.clear()
        snapshot.clear()
        assert_eq(I64, map_enum_drops, 3)
        // The container above reaches its hooks implicitly. This separate
        // type checks that cloning a literal cannot bypass a custom hook.
        literal := MapCustomLiteralClone.Empty.clone()
        assert_eq(I64, map_enum_clones, 2)
        switch literal {
        case .Number(value): assert_eq(I64, value, 99)
        case: panic("custom literal clone result")
        }
    }
    assert_eq(I64, map_enum_drops, 3)
}
