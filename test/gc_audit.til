mode test

// Issue #302 stage 0: frozen fixture for the garbager decision-audit golden.
//
// Each function below pins one shape of the asap pass's output contract
// (see doc/garbager.org). The golden test runs
//     TIL_GC_AUDIT=test/gc_audit.til bin/til translate test/gc_audit.til
// and byte-compares stdout against test/gc_audit.expected, so any change
// to the pass's per-binding decisions or destructor placement for these
// shapes shows up as a reviewable diff instead of only as an ASAN outcome.
//
// When a #302 stage intentionally changes a decision, regenerate with:
//     TIL_GC_AUDIT=test/gc_audit.til bin/til translate test/gc_audit.til \
//         > test/gc_audit.expected
// and review the diff as part of the change. Do not edit the fixture
// casually: every edit shifts statement indexes in the golden.

// Ownership sink for Str: callers transfer at the call site.
consume := func(own s: Str) returns I64 {
    return s.len().to_i64()
}

// Ownership sink for a container, for the conditional-transfer shape.
consume_vec := func(own v: Vec(I64)) returns I64 {
    return v.len().to_i64()
}

// Shape 1: stack Str-literal locals (stay heap=0 by design), an owned
// heap local dying at its last use (the second push_str), and an owned
// local handed out by the return.
last_use_and_scope_end := func() returns Str {
    lit := "left"
    b_lit := "right"
    b := b_lit.clone()
    mut a := Str.with_capacity(16)
    a.push_str(lit)
    a.push_str(b)
    return a
}

// Shape 2: reassignment of an owned aggregate -- the old value's delete
// rides the Assign as save_old_delete.
reassign_old := func() returns I64 {
    first := "first"
    mut s := first.clone()
    second := "second"
    s = second.clone()
    return s.len().to_i64()
}

// Shape 3: ownership transfer at a call site -- the pass stands down,
// no delete for s in this body.
transfer_out := func() returns I64 {
    lit := "moved"
    s := lit.clone()
    return consume(own s)
}

// Shape 4: transfer inside one if-branch only -- the sink grafts the
// non-transfer path's delete.
conditional_transfer := func(flag: Bool) returns I64 {
    mut v := Vec(I64).new()
    v.push(own 1)
    if flag {
        return consume_vec(own v)
    }
    return 0
}

// Shape 5: early exit while another owned local is still live -- the
// nested return edge must free s.
early_exit := func(flag: Bool) returns I64 {
    lit := "live"
    s := lit.clone()
    if flag { return 1 }
    return s.len().to_i64()
}

// Shape 6: a ref borrow owns nothing (skip=1) and extends the source's
// last_use to cover the borrower.
borrow_local := func() returns I64 {
    lit := "source"
    s := lit.clone()
    ref view : Str = s
    return view.len().to_i64()
}

// Shape 7: an exit edge inside a loop, before the owned local's last use
// on the fall-through path.
loop_return := func(n: I64) returns I64 {
    lit := "loop"
    s := lit.clone()
    mut i := 0
    while i < n {
        if i == 2 { return 100 }
        i++
    }
    return s.len().to_i64()
}

// Shape 8: a variadic call -- the _va_Array build with its ek/eo error
// slots and the array's own-transfer into the callee.
varargs_build := func() returns Str {
    a := "aa"
    b := "bb"
    return format(a, b)
}

// Shape 9: own param transferred on one branch only -- the sink covers
// ordinary params (#302); only destructor self-transfers stand down.
cond_param := func(own s: Str, flag: Bool) returns I64 {
    if flag {
        return consume(own s)
    }
    return 0
}

// Shape 10: early exit before the param's transfer -- the exit edge
// must free the still-owned param (#302).
early_param := func(own s: Str, flag: Bool) returns I64 {
    if flag { return 1 }
    return consume(own s)
}

// Shape 11: a typed local from a raw allocator (raw_alloc provenance,
// #302): heap-promoted, and the pass inserts a bare free -- never a
// deep delete -- with no hand-written free in sight.
raw_alloc_auto := func() returns I64 {
    buf : U8 = malloc(8)
    write_u8(buf, 9)
    return 0
}

// Shape 11b: the same raw_alloc provenance, but the pointer is stored
// into raw memory with write_ptr. That storage is opaque to the pass, so
// the block stays reachable past `esc`'s last textual mention and its
// cleanup must STAND DOWN (skip=1, no free site) -- scheduling the free
// at the last mention made every later read through the slot a
// use-after-free (ASAN: heap-use-after-free). Whoever holds the slot
// owns the block from that point on; the fixture leaks it deliberately,
// exactly as the hand-written contract does today.
raw_alloc_escapes := func() returns I64 {
    slot : U8 = malloc(UPtr.size())
    esc : U8 = malloc(8)
    write_u8(esc, 9)
    write_ptr(slot, esc)
    return 0
}

// Shape 12: switch-with-break inside a loop (#302 stage 3; FIXED by
// the sink's Body gate, was the "known deferred leak" while stage 3
// was in flight). A switch whose transferring case carries a `break`
// (targeting the While) is not C-like, so it desugars to a
// Body-wrapped if/elif chain and own_transfer points at the Body
// wrapper; the pure index gate only recognized If/Switch there and
// every non-transfer iteration leaked the loop-local `s`. The sink's
// Body gate (Mixed-at-exit dataflow + the transfer_lex_inside_while
// iteration hazard check) now grafts the missing arm deletes: the
// golden pins the grafted `Str.delete(s)` in the default arm, and an
// ASAN run of this exact shape is leak-clean. The loop-body view's
// exit stays X, not M -- the graft moves both ARM paths to Moved, but
// the view is also exited from the hoisted while-condition path where
// `s` was never declared, and Uninit meets Moved as Mixed.
switch_break_transfer := func(n: I64) returns I64 {
    mut r : I64 = 0
    mut i : I64 = 0
    while i < n {
        base := "swbrk"
        s := Str.clone(base)
        switch i {
        case 1:
            r = consume(own s)
            break
        case:
            r = r + 1
        }
        i++
    }
    return r
}

// Shape 13: use after a DIVERGED transfer (#302 stage 3, deferred case
// 2, now valid). The transfer path returns, so only still-owning paths
// reach the use: the dataflow proves s Owned at the use statement, the
// old index-model rejection (last_use > own_transfer) clears, and the
// local reverts to ordinary owned cleanup on the surviving paths. The
// transfer path's nested return does NOT re-delete s: the transfer
// sits in a preceding sibling (the hoisted call decl), which the
// nested-exit scan now recognizes as Moved-on-this-path.
diverged_use := proc(n: I64) returns I64 {
    lit := "divheap"
    s := Str.clone(lit)
    switch n {
    case 1: return consume(own s)
    case: print_flush()
    }
    return s.len().to_i64() + 1
}

// Shape 14: conditional transfer of a heap-promoted SCALAR (#272 step 4
// slice 1 fallout). A literal-RHS scalar decl is not clone-wrapped by
// the typer, so a recorded own transfer heap-promotes it to a decl-site
// box (promote_own_transferred_locals) -- unlike an ident-RHS scalar,
// whose shallow clone wrap keeps it on the stack with the builder's
// inline box at the transfer consuming itself on every path. With the
// transfer in one branch, the sink must graft the box's delete on the
// non-transfer path exactly as it does for aggregates; it used to stand
// down on non-aggregates and leak one box per non-transfer pass
// (gc_live_solve's own fixpoint scratch hit it first: 3575 one-byte
// leaks on a gc_audit translate under ASAN).
scalar_cond_transfer := func(n: I64, mut outs: Array(U8)) {
    mut o : U8 = 0
    if n == 1 { o = 1 }
    if o.neq(outs[0]) {
        outs[0] = o
    }
}

// Shape 15: kwargs-ctor adopt. `Str(c_str = to_ptr(buf), ...)` moves
// buf's block into the Str -- c_str is an own field -- so buf's own
// cleanup must stand down (own_transfer records the ctor statement).
// Ctor args are NamedArg-wrapped, and the own-arg detectors used to zip
// fields against the raw children positionally: arg_addressed_ident
// saw the wrapper, never the value, so NO kwargs ctor ever registered
// a transfer. buf kept its scheduled free while s2 pointed at the
// block, and consuming s2 double-freed (ASAN-verified before the
// by-name NamedArg mapping fix in fcall_has_own_arg /
// fcall_collect_own_arg_names).
ctor_adopt := func() returns I64 {
    buf : U8 = malloc(4)
    memset(buf, 65, 1)
    s2 := Str(c_str = to_ptr(buf), count = 1, cap = 1)
    return consume(own s2)
}

// Plain assert only: assert_eq is a type-generic func, and generic
// instantiation clones the body into this unit with the DEFINITION
// file's line numbers -- the audit dump would then couple the golden to
// core/exit.til's line layout. assert is a plain func typed in its own
// unit, so it never appears in this unit's dump.
// Shape 21 (#368): the SAME owned local transferred on an EARLY-RETURN
// path and again on the fall-through. LocalInfo holds ONE own_transfer
// index; check_use_after_own_transfer clears it when the recorded
// transfer diverged (returned before the later use), which is right --
// but the later "use" here IS the second transfer, and clearing to -1
// said "never transferred" and handed the local an ordinary exit delete
// on top of the value it had just given away. The record below pins the
// surviving path's transfer index, so a regression shows as -1.
diverged_then_transfer := func(flag: Bool) returns I64 {
    mut s := format("x", "y")
    if flag {
        return consume(own s)
    }
    return consume(own s)
}

test_gc_audit_shapes := test() {
    joined := last_use_and_scope_end()
    assert(joined == "leftright")
    assert(reassign_old() == 6)
    assert(transfer_out() == 5)
    assert(conditional_transfer(true) == 1)
    assert(conditional_transfer(false) == 0)
    assert(early_exit(true) == 1)
    assert(early_exit(false) == 4)
    assert(borrow_local() == 6)
    assert(loop_return(5) == 100)
    assert(loop_return(0) == 4)
    assert(varargs_build() == "aabb")
    lit := "hello"
    a := lit.clone()
    assert(cond_param(own a, true) == 5)
    b := lit.clone()
    assert(cond_param(own b, false) == 0)
    c := lit.clone()
    assert(early_param(own c, false) == 5)
    d := lit.clone()
    assert(early_param(own d, true) == 1)
    assert(raw_alloc_auto() == 0)
    assert(raw_alloc_escapes() == 0)
    assert(switch_break_transfer(0) == 0)
    assert(switch_break_transfer(1) == 1)
    assert(switch_break_transfer(3) == 5)
    assert(diverged_use(1) == 7)
    assert(diverged_use(2) == 8)
    assert(diverged_then_transfer(true) == 2)
    assert(diverged_then_transfer(false) == 2)
    mut sco := Array(U8).new(1)
    scalar_cond_transfer(1, sco)
    assert(sco[0] == 1)
    scalar_cond_transfer(0, sco)
    assert(sco[0] == 0)
    assert(ctor_adopt() == 1)
}
