mode test

test_array_new_get_set := test() {
    mut a := Array(I64).new(3)
    a.set(0, own 10)!
    a.set(1, own 20)!
    a.set(2, own 30)!

    ref x : I64 = a.get(0)!
    ref y : I64 = a.get(1)!
    ref z : I64 = a.get(2)!

    assert_eq(I64, x, 10)
    assert_eq(I64, y, 20)
    assert_eq(I64, z, 30)
    assert_eq(USize, a.len(), 3)
}

// Issue #284: collection for-in iterates via the unchecked unsafe_get
// accessor; results must match the old checked-get path.
test_array_for_in := test() {
    mut a := Array(I64).new(4)
    a.set(0, own 5)!
    a.set(1, own 6)!
    a.set(2, own 7)!
    a.set(3, own 8)!
    mut sum : I64 = 0
    mut idx : USize = 0
    for x : I64 in a {
        ref expect_x : I64 = a.get(idx)!
        assert_eq(I64, x, expect_x)
        sum = sum.add(x)
        idx++
    }
    assert_eq(USize, idx, 4)
    assert_eq(I64, sum, 26)
}

// a[i] desugars to a.get(i)! in the parser (generic over any type
// whose get throws), so subscript and explicit get(i)! agree.
test_array_subscript := test() {
    mut a := Array(I64).new(3)
    a.set(0, own 10)!
    a.set(1, own 20)!
    a.set(2, own 30)!

    ref x : I64 = a[0]
    ref y : I64 = a[1]
    ref z : I64 = a[2]

    assert_eq(I64, x, 10)
    assert_eq(I64, y, 20)
    assert_eq(I64, z, 30)

    // Subscript with a computed index expression.
    i : USize = 1
    assert_eq(I64, a[i.add(1)], 30)
}

// Issue #225: subscript assignment `a[i] = x` desugars to
// `a.set(i, own x)!`, the write-side mirror of `a[i] -> a.get(i)!`.
// Literal and computed indices, round-trip asserted under interp and
// compile.
test_array_subscript_assign := test() {
    mut a := Array(I64).new(3)
    a[0] = 10
    a[1] = 20
    a[2] = 30

    a[0] = 100            // literal index
    idx : USize = 1
    a[idx.add(1)] = 300   // computed index

    ref x : I64 = a[0]
    ref y : I64 = a[1]
    ref z : I64 = a[2]
    assert_eq(I64, x, 100)
    assert_eq(I64, y, 20)
    assert_eq(I64, z, 300)
}

test_array_subscript_assign_str := test() {
    mut a := Array(Str).new(2)
    a[0] = "hello"
    a[1] = "world"
    a[0] = "zzz"
    ref s0 : Str = a[0]
    ref s1 : Str = a[1]
    assert_eq(Str, s0, "zzz")
    assert_eq(Str, s1, "world")
}

// Out-of-bounds set throws OutOfBounds. The bang form (`a[i] = x`)
// panics; the explicit `a.set(i, own x)?` form lets a catch handle it.
// Str element so the owned value's throw-path cleanup runs under ASAN.
test_array_subscript_assign_oob := test() {
    mut a := Array(Str).new(2)
    mut caught := false
    a.set(5, own "unstored")?
    catch (err: OutOfBounds) {
        caught = true
    }
    assert(caught)
}

test_array_strings := test() {
    mut a := Array(Str).new(2)
    a.set(0, own "hello")!
    a.set(1, own "world")!

    ref s0 : Str = a.get(0)!
    ref s1 : Str = a.get(1)!

    assert_eq(Str, s0, "hello")
    assert_eq(Str, s1, "world")
}

test_array_overwrite := test() {
    mut a := Array(I64).new(2)
    a.set(0, own 1)!
    a.set(1, own 2)!
    a.set(0, own 99)!

    ref v : I64 = a.get(0)!
    assert_eq(I64, v, 99)
}

// --- merged from test/array_lit.til ---

test_i64_array_literal := test() {
    arr := array(I64, 1, 2, 3)
    assert_eq(USize, arr.len(), 3)
    assert_eq(I64, arr[0], 1)
    assert_eq(I64, arr[1], 2)
    assert_eq(I64, arr[2], 3)
}

test_i64_vec_literal := test() {
    myvec := vec(I64, 10, 20, 30)
    assert_eq(USize, myvec.len(), 3)
    assert_eq(I64, myvec[0], 10)
    assert_eq(I64, myvec[1], 20)
    assert_eq(I64, myvec[2], 30)
}

test_str_array_literal := test() {
    sarr := array(Str, "hello", "world")
    assert_eq(USize, sarr.len(), 2)
    ref s0 : Str = sarr[0]
    ref s1 : Str = sarr[1]
    assert_eq(Str, s0, "hello")
    assert_eq(Str, s1, "world")
}

test_str_vec_literal := test() {
    svec := vec(Str, "foo", "bar", "baz")
    assert_eq(USize, svec.len(), 3)
    assert_eq(Str, svec[0], "foo")
    assert_eq(Str, svec[1], "bar")
    assert_eq(Str, svec[2], "baz")
}

// #342: Array.concat -- a fresh Array with self's elements then other's, every
// element cloned so both sources stay intact. The mixed-splat variadic
// lowering is built on it (fixed args become one Array, the splatted Array is
// the other, and the call becomes the pure-splat form the desugar handles).
test_concat := test() {
    a := array(Str, "a", "b")
    b := array(Str, "c")
    c := a.concat(b)
    assert_eq(USize, c.len(), 3)
    ref c0 : Str = c[0]
    ref c1 : Str = c[1]
    ref c2 : Str = c[2]
    assert_eq(Str, c0, "a")
    assert_eq(Str, c1, "b")
    assert_eq(Str, c2, "c")
    // sources keep their own elements
    ref a0 : Str = a[0]
    ref b0 : Str = b[0]
    assert_eq(Str, a0, "a")
    assert_eq(Str, b0, "c")
    assert_eq(USize, a.len(), 2)
}

test_concat_empty := test() {
    a := array(I64, 1, 2)
    e := Array(I64).new(0)
    c := a.concat(e)
    assert_eq(USize, c.len(), 2)
    d := e.concat(a)
    assert_eq(USize, d.len(), 2)
}

// #342: Array.to_vec -- a fresh Vec with a clone of every element, self
// intact. The `vec(T, x, ..arr)` lowering ends here: the literal's block is
// folded into one Array and converted.
test_to_vec := test() {
    a := array(Str, "a", "b")
    v := a.to_vec()
    assert_eq(USize, v.len(), 2)
    assert_eq(Str, v[0], "a")
    assert_eq(Str, v[1], "b")
    ref a0 : Str = a[0]
    assert_eq(Str, a0, "a")
    assert_eq(USize, a.len(), 2)
}

test_to_vec_empty := test() {
    e := Array(I64).new(0)
    v := e.to_vec()
    assert_eq(USize, v.len(), 0)
}

// #342: `array()` and `vec()` are declared variadic (`elements: ..Dynamic`),
// so their element list is a variadic block and a `..` splat expands in place
// among the other elements. Before this the splatted Array was stored as ONE
// element and the reader took its header bytes for an element -- no error, no
// crash, garbage output.
test_array_literal_splat := test() {
    inner := array(I64, 7, 8)
    mixed := array(I64, 1, ..inner, 9)
    assert_eq(USize, mixed.len(), 4)
    assert_eq(I64, mixed[0], 1)
    assert_eq(I64, mixed[1], 7)
    assert_eq(I64, mixed[2], 8)
    assert_eq(I64, mixed[3], 9)
    // a lone splat has no concat to clone for it, so it is clone-wrapped
    pure := array(I64, ..inner)
    assert_eq(USize, pure.len(), 2)
    assert_eq(I64, pure[0], 7)
    // and the source survives both
    assert_eq(USize, inner.len(), 2)
    assert_eq(I64, inner[0], 7)
    assert_eq(I64, inner[1], 8)
}

test_vec_literal_splat := test() {
    inner := array(Str, "b", "c")
    mixed := vec(Str, "a", ..inner, "d")
    assert_eq(USize, mixed.len(), 4)
    assert_eq(Str, mixed[0], "a")
    assert_eq(Str, mixed[1], "b")
    assert_eq(Str, mixed[3], "d")
    pure := vec(Str, ..inner)
    assert_eq(USize, pure.len(), 2)
    assert_eq(Str, pure[0], "b")
    ref i0 : Str = inner[0]
    assert_eq(Str, i0, "b")
}

// The same literals away from a declaration's right-hand side: the decl fast
// path binds the fold to the user's variable, the general path to a temp.
priv arg_array_len := func(xs: Array(I64)) returns USize { return xs.len() }
priv arg_vec_len := func(xs: Vec(I64)) returns USize { return xs.len() }

test_collection_literal_splat_in_arg := test() {
    inner := array(I64, 7, 8)
    assert_eq(USize, arg_array_len(array(I64, 1, ..inner, 9)), 4)
    assert_eq(USize, arg_vec_len(vec(I64, 1, ..inner, 9)), 4)
    assert_eq(USize, inner.len(), 2)
}

// #361: a boxed scalar gets at least a WORD of storage, whatever its own width
// is. A value crossing into a Dynamic slot is copied at Dynamic's width --
// adopt's `memcpy(dest, src, T.size())` with T = Dynamic -- so a 1-byte Bool
// box or a 4-byte I32 box was read past its own end. Harmless with a real
// allocator, whose smallest chunk is far larger, but UB that ASAN reports, and
// BOTH backends did it. The values were always read back correctly and still
// are; what changed is that the copy now stays inside the allocation.
test_dynamic_element_widths := test() {
    mut a := Array(Dynamic).new(5)
    flag : Bool = true
    tiny : I8 = -3
    small : I16 = -300
    mid : I32 = 70000
    frac : F32 = 1.5
    a.set(0, own flag)!
    a.set(1, own tiny)!
    a.set(2, own small)!
    a.set(3, own mid)!
    a.set(4, own frac)!
    ref r0 : Bool = a[0]
    ref r1 : I8 = a[1]
    ref r2 : I16 = a[2]
    ref r3 : I32 = a[3]
    ref r4 : F32 = a[4]
    assert(r0)
    assert_eq(I8, r1, -3)
    assert_eq(I16, r2, -300)
    assert_eq(I32, r3, 70000)
    assert_eq(F32, r4, 1.5)
}
