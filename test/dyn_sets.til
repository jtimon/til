mode test

import("../src/std/dyn_set")

test_i64_set := test() {
    s := DynSet.new(I64)
    s.add(own 3)
    s.add(own 1)
    s.add(own 2)
    assert_eq(USize, s.len(), 3)
    assert(s.has(1))
    assert(s.has(2))
    assert(s.has(3))
    assert(s.has(4).not())

    // Duplicates ignored
    s.add(own 2)
    assert_eq(USize, s.len(), 3)
}

test_str_set := test() {
    ss := DynSet.new(Str)
    ss.add(own "banana")
    ss.add(own "apple")
    ss.add(own "cherry")
    assert_eq(USize, ss.len(), 3)
    assert(ss.has("apple"))
    assert(ss.has("banana"))
    assert(ss.has("cherry"))
    assert(ss.has("date").not())
    ss.add(own "apple")
    assert_eq(USize, ss.len(), 3)
}

// --- DynSet literal tests ---

test_dyn_set_literal_i64 := test() {
    s := {3, 1, 2}
    assert_eq(USize, s.len(), 3)
    assert(s.has(1))
    assert(s.has(2))
    assert(s.has(3))
    assert(s.has(4).not())
}

test_dyn_set_literal_str := test() {
    s := {"apple", "banana", "cherry"}
    assert_eq(USize, s.len(), 3)
    assert(s.has("apple"))
    assert(s.has("banana"))
    assert(s.has("cherry"))
    assert(s.has("date").not())
}

// #323 API symmetry: DynSet.remove mirrors Set.remove.
test_dyn_set_remove := test() {
    mut s := DynSet.new(I64)
    s.add(own 3)
    s.add(own 1)
    s.add(own 2)
    assert(s.remove(2))
    assert_eq(USize, s.len(), 2)
    assert(s.has(2).not())
    assert(s.has(1))
    assert(s.has(3))
    assert(s.remove(2).not())
    assert_eq(USize, s.len(), 2)
    assert(s.remove(1))
    assert(s.remove(3))
    assert_eq(USize, s.len(), 0)
}

test_dyn_set_remove_str_frees_elem := test() {
    mut s := DynSet.new(Str)
    s.add(own "alpha")
    s.add(own "beta")
    assert(s.remove("alpha"))
    assert(s.has("alpha").not())
    assert(s.has("beta"))
}

// DynSet.with_capacity mirrors Set.with_capacity (element type is a
// runtime argument, as for new).
test_dyn_set_with_capacity := test() {
    mut s := DynSet.with_capacity(I64, 8)
    assert_eq(USize, s.len(), 0)
    assert(s.cap.gte(8))
    for i in 0..8 { s.add(own i) }
    assert_eq(USize, s.len(), 8)
    assert(s.has(0))
    assert(s.has(7))
    assert(s.has(8).not())
}
