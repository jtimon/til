mode script

// Negative test (issue #407): the use after an ownership transfer below is
// the garbager's diagnostic, raised while it inserts deletes -- after a
// clean typing pass. The error used to be printed and then ignored: `til
// build` exited 0 and wrote a binary that printed "ab" and then the freed
// buffer, and `til interpret` ran the program too. Both backends must refuse
// it before running anything.

eat := proc(own s: Str) {
    println(s)
}

doomed := format("a", "b")
eat(own doomed)
println(doomed)

// Interface dispatch must preserve both the owned receiver and owned
// argument bits so the same post-typing transfer check sees these moves.
TransferredInterface := interface {
    consume := ext_proc(own self: TransferredInterface) {}
    take := ext_func(self: TransferredInterface, own text: Str) returns Str {}
    read := ext_func(self: TransferredInterface) returns Str {}
}
TransferredValue := struct implements TransferredInterface {
    text: Str
namespace:
    consume := proc(own self: TransferredValue) { println(self.text) }
    take := func(_self: TransferredValue, own text: Str) returns Str { return text }
    read := func(self: TransferredValue) returns Str { return self.text.clone() }
}

receiver: TransferredInterface = TransferredValue(text = "receiver")
TransferredInterface.consume(own receiver)
println(receiver.read())

view: TransferredInterface = TransferredValue(text = "argument")
argument := format("owned ", "argument")
result := view.take(own argument)
println(result)
println(argument)
