mode test

// Issue #452: names C reserves -- its keywords, and the macros gcc and
// clang predefine -- are ordinary til names. The C backend must spell
// them differently for the declaration and for every use; before, it
// wrote them out as they were and the generated C did not compile, while
// the interpreter ran the same program.

Pair := struct {
    short: I64 = 1
    auto: I64 = 2
namespace:
    register := func(self: Pair) returns I64 { return self.short + self.auto }
    double := func(mut self: Pair) { self.short = self.short * 2 }
}

// A top-level function, its parameters, and named arguments to them.
unsigned := func(short: I64, long: I64) returns I64 { return short - long }

// A proc: never folded away, so the C really declares and calls it.
volatile := proc(mut int: Vec(I64), char: I64) {
    noop_proc()
    int.push(own char.clone())
}

// A capturing closure: the captured name is a field of its environment.
Counter452 := proc(I64) returns I64
make_counter452 := func() returns Counter452 {
    extern := 0
    return proc(typeof: I64) returns I64 [own mut extern] {
        noop_proc()
        extern = extern + typeof
        return extern
    }
}

Kind := enum { static, extern, inline: I64 }

test_locals := test() {
    mut register := 2
    restrict := 1
    register = register + restrict
    assert_eq(I64, register, 3)
    mut float := "a"
    float = format(float, "b")
    assert_eq(Str, float, "ab")
}

test_macro_names := test() {
    linux := 3
    mut unix := 4
    i386 := 5
    unix = unix + linux + i386
    assert_eq(I64, unix, 12)
}

test_params_and_named_args := test() {
    mut values := Vec(I64).new()
    volatile(values, 4)
    volatile(int = values, char = 5)
    assert_eq(USize, values.len(), 2)
    goto := values.len().to_i64()
    assert_eq(I64, unsigned(goto, 1), 1)
    assert_eq(I64, unsigned(long = goto, short = 10), 8)
}

test_fields_and_methods := test() {
    mut union := Pair(short = 5)
    union.auto = 7
    assert_eq(I64, union.register(), 12)
    union.double()
    assert_eq(I64, union.short, 10)
}

test_loop_variables := test() {
    mut signed := 0
    for void in 0..4 {
        signed = signed + void
    }
    assert_eq(I64, signed, 6)
    mut typedef := Vec(Str).new()
    typedef.push(own "x")
    typedef.push(own "y")
    mut sizeof := ""
    for restrict : Str in typedef {
        sizeof = format(sizeof, restrict)
    }
    assert_eq(Str, sizeof, "xy")
}

test_closure_captures := test() {
    asm := make_counter452()
    assert_eq(I64, asm(4), 4)
    assert_eq(I64, asm(5), 9)
    mut thread_local := 1
    nullptr := 6
    [nullptr, mut thread_local] {
        thread_local = thread_local + nullptr
    }
    assert_eq(I64, thread_local, 7)
}

test_enum_variants := test() {
    mut do := Kind.static
    do = Kind.inline(7)
    mut seen := 0
    switch do {
    case .inline(alignof): seen = alignof
    case: seen = -1
    }
    assert_eq(I64, seen, 7)
}

// --- Nested fields, globals, function values, throws, variadics ---

Inner := struct { long: I64 = 3 }
Outer := struct {
    signed: Inner = Inner()
    char: Str = "c"
    float: Vec(I64) = Vec(I64).new()
}

Err452 := struct { msg: Str = "" }

// Globals, a keyword and a predefined macro each.
static := 5
mut extern := 6
mut unix := 4
// And a libc object: every generated file sees stdio.h.
mut stdin := 2

goto := func(x: I64) returns I64 { return x + 1 }
Unary452 := func(I64) returns I64

apply452 := func(f: Unary452, x: I64) returns I64 { return f(x) }

thrower := proc(int: I64) returns I64 throws Err452 {
    noop_proc()
    if int > 2 { throw Err452(msg = "big") }
    return int
}

sum_all := proc(short: ..I64) returns I64 {
    noop_proc()
    mut total := 0
    for void : I64 in short { total = total + void }
    return total
}

with_default := proc(x: I64, unsigned: I64 = 10) returns I64 {
    noop_proc()
    return x + unsigned
}

Shape := enum { union: Inner, auto }

test_nested_fields := test() {
    mut register := Outer()
    register.signed.long = 9
    register.float.push(own 4)
    register.char = format(register.char, "d")
    assert_eq(I64, register.signed.long, 9)
    assert_eq(USize, register.float.len(), 1)
    assert_eq(Str, register.char, "cd")
    restrict := register.clone()
    assert_eq(I64, restrict.signed.long, 9)
}

test_globals := test() {
    extern = extern + static
    assert_eq(I64, extern, 11)
    unix = unix + static
    assert_eq(I64, unix, 9)
    stderr := 1
    stdin = stdin + stderr
    assert_eq(I64, stdin, 3)
    errno := stdin + 1
    assert_eq(I64, errno, 4)
}

test_function_values := test() {
    typeof : Unary452 = goto
    assert_eq(I64, typeof(1), 2)
    assert_eq(I64, apply452(goto, 2), 3)
}

test_throw_and_catch := test() {
    mut seen := ""
    volatile := thrower(5)? catch (inline: Err452) { seen = inline.msg.clone() }
    assert_eq(Str, seen, "big")
    assert_eq(I64, volatile, 0)
}

test_variadic_and_defaults := test() {
    assert_eq(I64, sum_all(1, 2, 3), 6)
    assert_eq(I64, with_default(1), 11)
    assert_eq(I64, with_default(1, unsigned = 2), 3)
}

test_enum_struct_payload := test() {
    do := Shape.union(Inner(long = 8))
    mut seen := 0
    switch do {
    case .union(sizeof): seen = sizeof.long
    case .auto: seen = -1
    }
    assert_eq(I64, seen, 8)
}

test_ref_binding := test() {
    mut values := Vec(Inner).new()
    values.push(own Inner(long = 2))
    ref mut double : Inner = values[0]
    double.long = 7
    assert_eq(I64, values[0].long, 7)
}
