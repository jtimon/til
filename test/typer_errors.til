mode script

// undefined symbol
println(missing_x)

// undefined function
foo(1)

// undefined type in explicit declaration
y : Blah = 35

// type mismatch: declared Str but value is I64
z : Str = 35

// if condition must be Bool
if 69 {
    println("FAIL")
}

if "hello" {
    println("FAIL")
}

// while condition must be Bool
while 1 {
    println("FAIL")
}

// variable not visible outside block scope
{
    inner := "scoped"
}
println(inner)

// func cannot call proc
bad_func := func(x: I64) returns I64 {
    println("side effect!")
    return x
}


// cannot assign to immutable variable
immut := 42
immut = 43

// cannot assign to function parameter
assign_param := proc(a: I64) {
    a = 99
}

// assignment type mismatch
mut m := 42
m = "oops"

// cannot assign to const struct field (#211: fields are mut by default)
ImmutStruct := struct {
    const id := 0
    name := "x"
}
immut_struct := ImmutStruct()
immut_struct.id = 5

// struct instantiation: unknown field
bad1 := ImmutStruct(bogus=1)

// struct instantiation: positional arg not allowed
bad2 := ImmutStruct(42)

// wrong explicit type on func def
bad_fn : Str = func(n: I64) returns I64 { return n }

// wrong explicit type on struct def
bad_st : I64 = struct { x := 0 }

// cannot assign to immutable namespace field
NsStruct := struct {
    x := 0
    namespace:
    mut count := 0
    label := "fixed"
}
NsStruct.label = "oops"

// struct instantiation should not accept namespace field as named arg
bad_ns := NsStruct(count=5)

// ufcs: no such method on type
x := 42
x.nonexistent()

// ufcs: method call on type with no namespace
s := "hello"
s.nonexistent()

// ufcs: method call on literal
"hello".nonexistent()

// cannot assign to non-mut parameter (mut keyword exists)
assign_nonmut := proc(mut a: I64, b: I64) {
    a = 1
    b = 2
}

// own: missing 'own' at call site
take := proc(own x: I64) {
    println(x.to_str())
}
take(42)

// own: 'own' at call site but param is not own
regular := proc(x: I64) {
    println(x.to_str())
}
ov := 1
regular(own ov)

// own: use after ownership transfer
eat := proc(own v: I64) {
    println(v.to_str())
}
doomed := 99
eat(own doomed)
println(doomed.to_str())

// own: missing 'own' on UFCS call to own-taking method
OwnTest := struct {
    val := 0
}
ot1 := OwnTest(val=1)
ot1.delete()

// own: missing 'own' on direct namespace call to own-taking method
ot2 := OwnTest(val=2)
OwnTest.delete(ot2)

// struct literal: non-ref fields consume variables
CtorOwn := struct {
    name := "default"
}
ctor_name := "hello"
co := CtorOwn(name=ctor_name)
println(ctor_name)

// break outside loop
break

// continue outside loop
continue

// ref: declaration requires ref-returning function or ref/param variable
ref bad_ref := 42

// ref: function must return a parameter or ref variable
bad_ref_fn := func(a: I64) returns ref I64 {
    mut b := a
    return b
}

// #164 step 2: redundant 'mut' on a parameter that is never written
// through (no `p = ...`, no `p.f = ...`, never passed to a mut/own/
// Dynamic callee). The body only reads it.
terr_redundant_mut_param := func(mut redundant_p: I64) returns I64 {
    return redundant_p
}

// cannot return ref variable from non-ref function; use .clone() or 'returns ref'
TERR_ARR := array(I64, 1, 2, 3)
bad_ret_ref := func(i: I64) returns I64 {
    ref v : I64 = TERR_ARR[i]
    return v
}

// cannot own result of ref-returning function; use 'ref' or Type.clone()
good_ref_fn := func(a: I64) returns ref I64 { return a }
bad_own := good_ref_fn(42)

// cannot own result of ref-returning function (Vec.get returns ref Dynamic)
ref_vec := vec(I64, 10, 20)
bad_vec_own : I64 = ref_vec[0]

// #282 follow-up: a by-value return of a ref-returning ?-call is rejected the
// same way as the Decl form above (previously it compiled and DEREF'd a null
// ref on the throw path). Use `returns ref I64` or `.clone()` instead.
bad_ret_ref_q := func(i: USize) returns I64 throws OutOfBounds {
    return ref_vec.get(i)?
}

// no need for explicit own on typed local
own bad_own_local : U8 = 0

// no need for explicit own on typed mutable local
own mut bad_own_mut_local : U8 = 0

// no need for explicit own on Dynamic local
own bad_dyn : Dynamic = 0

// cannot store Dynamic: inferred from malloc
bad_dyn2 := malloc(32)

// #319: raw allocation must initialize a concrete local, not a borrowed ref.
ref bad_raw_alloc_ref : U8 = malloc(8)

// #319: Dynamic is for type-erased/dynamic dispatch, not raw allocation owners.
bad_raw_alloc_dynamic : Dynamic = malloc(8)

// dyn_call: method must be a string literal
method_var := "clone"
dyn_call_ret("I64", method_var, 1, 42)

// argument type mismatch: I64 method with Bool arg
32.add(true)

// argument type mismatch: Bool top-level func with I64 arg
and(true, 42)

// argument type mismatch: user-defined function
type_test := func(a: I64, _b: Bool) returns I64 { return a }
type_test(1, 2)

// #157 argument type mismatch: variadic ..Str called with a type that
// has no to_str method (auto-coerce only fires when to_str exists)
NoToStr := struct { x : I64 = 0 }
println(NoToStr())
str_va := proc(_parts: ..Str) { print_flush() }
str_va(NoToStr())

// cannot call method on Dynamic value (namespace UFCS ambiguous)
dyn_vec := vec(I64, 10, 20)
dyn_bad := dyn_vec.get(0).add(35)

// map literal: key type must implement cmp. #335 derives cmp for a
// struct whose fields are all comparable, so this fixture needs a field
// that disqualifies the derivation -- an `own` one, same rule eq and
// to_str already follow.
NoCmp := struct { own buf : Str = "" }
bad_map := {NoCmp(): "one"}

// #380: provisional field inference may learn a generated method's return
// type, but the original default must still fail strict lookup when the field
// shape disqualifies that method.
BadGeneratedDefault := struct { text := NoCmp().to_str() }

// set literal: element type must implement cmp
bad_set := {NoCmp(), NoCmp()}

// Provisional return types used during field inference must not make
// unsupported generated methods permanent. NoCmp's owned field disqualifies
// cmp.
ForwardUnsupportedGeneratedMethod := struct {
    comparison := NoCmp().cmp(NoCmp())
}

// for-in: Dynamic collection without explicit type
forin_vec := vec(I64, 1, 2, 3)
for x in forin_vec { }

// for-in: type has no get method
NoGet := struct {
    namespace:
    len := func(_self: NoGet) returns I64 { return 0 }
}
for x in NoGet() { }

// for-in: type has no len method
NoLen := struct {
    namespace:
    get := func(_self: NoLen, i: I64) returns ref I64 { return i }
}
for x in NoLen() { }

// (The NULL fixtures that lived here -- non-ref decl init, own/shallow
// params -- left with the keyword: #321 removed NULL from the language,
// so the rules they pinned are unreachable from source. The checks
// survive in the typer as guards over compiler-generated null nodes.)

// #99: struct with new() -- literal outside namespace is an error
HasNew := struct {
    x := 0
namespace:
    new := func(x: I64) returns HasNew { return HasNew(x = x) }
}
hn := HasNew(x = 1)

// #86: unused function parameter (prefix with _ to suppress)
unused_param := func(a: I64, b: I64) returns I64 { return a }
unused_param(1, 2)

// #86: unused local variable (prefix with _ to suppress)
unused_local := func() returns I64 {
    unused := 99
    return 0
}
unused_local()

// #161: 'ref mut' cannot launder mutability from an immutable ref local
TerrLaunder := struct { field := 0 }
terr_launder_local := TerrLaunder(field=1)
ref terr_launder_r : TerrLaunder = terr_launder_local
ref mut terr_launder_rm : TerrLaunder = terr_launder_r

// #161: 'ref mut' cannot launder mutability from an immutable param
terr_launder_fn := proc(p: TerrLaunder) {
    ref mut leaked : TerrLaunder = p
    leaked.field = 99
}
terr_launder_fn(terr_launder_local)

// #113: non-exhaustive switch on enum (simple, no payload)
TerrColor := enum { Red, Green, Blue }
terr_color := TerrColor.Green
switch terr_color {
case TerrColor.Red: println("red")
case TerrColor.Green: println("green")
}

// #113: non-exhaustive switch on enum (payload variants)
TerrTok := enum { Num: I64, Name: Str, Eof }
terr_tok := TerrTok.Eof
switch terr_tok {
case TerrTok.Num: println("num")
case TerrTok.Eof: println("eof")
}

// #148: unqualified namespace member access from sibling method
NsUnqualified := namespace {
    mut urmom := 69
    get := func() returns I64 { return urmom }
}

// proc without any proc/ext_proc calls should be a func
useless_proc := proc(_x: I64) {
    return
}
useless_proc(1)

// #168 step 1: ref binding cannot be initialized from .clone()
TerrCloneRefSrc := struct { field := 0 }
terr_clone_ref_src := TerrCloneRefSrc(field=1)
ref terr_clone_ref : TerrCloneRefSrc = terr_clone_ref_src.clone()
ref mut terr_clone_ref_mut : TerrCloneRefSrc = terr_clone_ref_src.clone()

// #168 step 2: predicate generalised from literal `.clone()` to any
// FCall whose callee returns OwnType.Own. Catches struct constructors,
// factory funcs, and any user func declared `returns own ...`.
ref terr_step2_ctor : TerrCloneRefSrc = TerrCloneRefSrc(field=2)
terr_make_owned_str := func() returns Str { return "owned" }
ref terr_step2_func : Str = terr_make_owned_str()

// #168 step 5: ref-typed function cannot return an owned value.
terr_step5_bad_ret := func(f: TerrCloneRefSrc) returns ref TerrCloneRefSrc {
    return f.clone()
}

// #168 step 3: ref struct field default cannot be an owned value.
// #321 step 2: the old NULL exception is closed too -- both lines
// error now; the nullable-borrow shape is an Option(ref T) field.
TerrStep3 := struct {
    ref bad_field : TerrCloneRefSrc = TerrCloneRefSrc(field=3)
}

// #168 step 2 follow-up: enum variant constructors are caught too,
// because the initer registers each variant as a namespace decl with
// a FuncDef whose default return_own_type is Own.
TerrStep2Enum := enum { TerrPayload: I64, TerrEmpty }
ref terr_step2_enum : TerrStep2Enum = TerrStep2Enum.TerrPayload(5)

// #168 step 4: assignment to a ref-typed lvalue cannot accept an owned
// RHS. Catches both plain Assign and FieldAssign shapes. (data is
// mandatory -- no default -- since #321 step 2 retired `= NULL`.)
TerrStep4Field := struct {
    ref data : Str
namespace:
    set_clone := func(mut self: TerrStep4Field, src: Str) returns I64 {
        self.data = src.clone()
        return 0
    }
}
terr_step4_assign := func() returns I64 {
    ref mut x : Str = "borrow"
    x = "fresh".clone()
    return 0
}
terr_step4_assign()

// (#168 step 1b / #177's ref-init-to-NULL fixtures left with the
// keyword; #321 removed NULL from the language entirely.)

// #191: macro argument must be known at compile time
macro_test := macro(x: I64) returns I64 { return x }
runtime_val := func() returns I64 { return 42 }
_ = macro_test(runtime_val())

// #184: bare get_payload(...) in user code is rejected;
// switch case bindings are the only legitimate way to extract
// an enum payload.
TerrGetPayloadEnum := enum { TerrI: I64, TerrZ }
terr_get_payload_val := TerrGetPayloadEnum.TerrI(7)
get_payload(terr_get_payload_val)

// #93: a nested struct/enum/func is private to its parent function.
// init_declarations_unit (src/self/initer.til) hoists it to the top
// level under a mangled name `<parent>_<orig>` and marks it priv.
// Two checks fall out of that:
//   - if no sibling reference touches it, the existing unused-priv
//     check flags it (the lift also rewrites references to the
//     mangled name, so an originally-unused decl ends up with zero refs).
//   - the original name doesn't exist outside the parent body, so a
//     reference from another function or top-level scope errors as
//     "undefined".
unused_nested_struct_parent := func() returns I64 {
    UnusedLocalStruct := struct { mut x := 0 }
    return 0
}
unused_nested_struct_parent()

uses_nested := func() returns I64 {
    HiddenInUses := struct { mut x := 0 }
    h := HiddenInUses()
    return h.x
}
uses_nested()
// Trying to reach the nested type by its original name from outside
// the parent: the symbol doesn't exist at file scope.
reach_outside := func() returns I64 {
    h := HiddenInUses()
    return h.x
}
reach_outside()

// And trying to reach the SAME nested type by its mangled name from
// another function in the same file: function-scope priv kicks in.
reach_outside_mangled := func() returns I64 {
    h := uses_nested_HiddenInUses()
    return h.x
}
reach_outside_mangled()

// dead arm: duplicate bare variant -- second arm unreachable.
TerrDeadColor := enum { Red, Green, Blue }
terr_dead_color := TerrDeadColor.Red
switch terr_dead_color {
case TerrDeadColor.Red: println("red")
case TerrDeadColor.Red: println("red-dup")
case TerrDeadColor.Green: println("green")
case TerrDeadColor.Blue: println("blue")
}

// dead arm: a binding case fully covers the variant, so a later more
// specific arm on the same variant is unreachable.
TerrDeadTok := enum { Num: I64, Name: Str, Eof }
terr_dead_tok := TerrDeadTok.Num(1)
switch terr_dead_tok {
case TerrDeadTok.Num(n): println(n.to_str())
case TerrDeadTok.Num(_z): println("dup")
case TerrDeadTok.Name(_s): println("name")
case TerrDeadTok.Eof: println("eof")
}

// dead arm: anything after a default arm is unreachable.
switch terr_dead_color {
case TerrDeadColor.Red: println("red")
case: println("other")
case TerrDeadColor.Blue: println("blue")
}

// dead arm: two `case:` defaults in the same switch -- second is dead.
switch terr_dead_color {
case TerrDeadColor.Red: println("red")
case: println("other")
case: println("dup-default")
}

// unnecessary `case:` -- every variant of a bare enum is already listed.
switch terr_dead_color {
case TerrDeadColor.Red: println("red")
case TerrDeadColor.Green: println("green")
case TerrDeadColor.Blue: println("blue")
case: println("other")
}

// unnecessary `case:` -- every variant of a payload enum is also covered.
TerrExhaustTok := enum { Num: I64, Name: Str, Eof }
terr_exhaust_tok := TerrExhaustTok.Eof
switch terr_exhaust_tok {
case TerrExhaustTok.Num(_n): println("num")
case TerrExhaustTok.Name(_s): println("name")
case TerrExhaustTok.Eof:     println("eof")
case: println("other")
}

// struct pattern that omits a field without `..` is rejected; either
// bind all fields or use `..` to make the partial match explicit.
TerrRestPoint := struct {
    x := 0
    y := 0
    namespace:
    eq := func(a: TerrRestPoint, b: TerrRestPoint) returns Bool { return a.x.eq(b.x).and(a.y.eq(b.y)) }
    to_str := func(self: TerrRestPoint) returns Str { return format(self.x.to_str(), ",", self.y.to_str()) }
}
terr_rest_p := TerrRestPoint(x = 0, y = 0)
switch terr_rest_p {
case TerrRestPoint(x = 0): println("origin-x")
case TerrRestPoint(x = _nx, y = _ny): println("any")
}

// `.clone()` on a literal receiver is always redundant -- the literal
// is already a fresh value. Reject at the typer level so callers fix
// the source instead of paying for the copy.
terr_clone_lit_str   := "urmom".clone()
terr_clone_lit_nl    := "\n".clone()
terr_clone_lit_num   := 32.clone()
terr_clone_lit_char  := '\n'.clone()
terr_clone_lit_bool  := true.clone()

// Calling `to_<self>` on a value that is already of that type is a
// redundant self-conversion. Reported with a message that names the
// mistake directly rather than the generic "no method 'to_i64' for
// type 'I64'". Core defines no identity converters (no `to_i64` on
// I64, no `to_str` on Str), so the check fires purely on the call
// shape -- it works uniformly for primitives, Str, and user types.
// #192: to_u32/to_u64 are EXEMPT (a target-dependent USize/UPtr value
// needs `.to_u32()` on 32-bit and `.to_u64()` on 64-bit for one source
// to typecheck on both), so they are not tested here.
terr_self_conv_i64 := func() returns I64 {
    val : I64 = 7
    return val.to_i64()
}
terr_self_conv_str := func() returns Str {
    val : Str = "hello"
    return val.to_str()
}
TerrSelfAaa := struct { field := 0 }
terr_self_conv_struct := func() returns TerrSelfAaa {
    val := TerrSelfAaa(field = 1)
    return val.to_terrselfaaa()
}

// =====================================================
// Issue #198 follow-up: throw/catch validation diagnostics
// =====================================================
// Throwing function for the next batch of cases.
TerrErrA := struct {}
TerrErrB := struct {}

terr_throws_a := func() throws TerrErrA {
    throw TerrErrA()
}

terr_throws_b := func() throws TerrErrB {
    throw TerrErrB()
}

terr_no_throws := func() returns I64 { return 0 }

// missing '?' on a throwing call -- caller does not catch.
terr_missing_question := func() throws TerrErrA {
    terr_throws_a()
}

// '?' on a non-throwing call.
terr_question_on_non_throwing := func() {
    _ := terr_no_throws()?
}

// catch type that is not among the pending thrown types.
terr_catch_not_thrown := func() {
    terr_throws_a()?
    catch (err: TerrErrA) {
    }
    catch (err: TerrErrB) {  // never thrown
    }
}

// throw of type not in the function's throws clause, not caught.
terr_uncaught_undeclared_throw := func() {
    throw TerrErrA()
}

// throws clause declares TerrErrA but body never raises it.
terr_declared_never_thrown := func() throws TerrErrA {
}

// '!' on a non-throwing call -- same error category as '?' on
// non-throwing.
terr_bang_on_non_throwing := func() {
    _ := terr_no_throws()!
}

// Calling these so the unused-priv-func diagnostic doesn't mask
// the throw/catch diagnostics above.
terr_missing_question()
terr_question_on_non_throwing()
terr_catch_not_thrown()
terr_uncaught_undeclared_throw()
terr_declared_never_thrown()
terr_bang_on_non_throwing()

// Issue #223 step 2: redundant 'shallow' on a primitive parameter --
// primitives are passed by value automatically, so the qualifier is rejected.
terr_redundant_shallow_param := func(shallow x: I64) returns I64 {
    return x
}

// Issue #223 step 2: redundant 'shallow' on a primitive return type.
terr_redundant_shallow_return := func() returns shallow I64 {
    return 0
}

// is() compares only the outer enum tag, so a payload-carrying variant is
// rejected -- it would silently match any value of that variant. Use a bare
// variant or a switch to discriminate the inner variant.
TErrIsColor := enum {
    Red,
    Tagged: I64,
}
terr_is_payload := func(c: TErrIsColor) returns Bool {
    return c.is(TErrIsColor.Tagged(5))
}
terr_is_payload(TErrIsColor.Red)

// #242: a struct field with no default is required at instantiation;
// omitting it is a type error.
TErrReq := struct {
    a : U16 = 0
    b : Str
    c := -1
}
terr_req_missing := TErrReq()

// #242: defaulted fields stay optional, but a required field must be
// supplied -- omitting it errors.
TErrMixedReq := struct {
    x := 1
    label : Str
}
terr_mixed_req_missing := TErrMixedReq()

// #244: switch is statement-only; using it in value position errors and
// points at match.
TErrMatchColor := enum { Red, Green }
terr_switch_in_value := switch TErrMatchColor.Red {
case TErrMatchColor.Red:   1
case TErrMatchColor.Green: 2
}

// #244: a bare match statement discards its value; the error points at switch.
match TErrMatchColor.Red {
case TErrMatchColor.Red:   1
case TErrMatchColor.Green: 2
}

// #244: all match arms must yield the same type.
terr_match_arms := match TErrMatchColor.Red {
case TErrMatchColor.Red:   1
case TErrMatchColor.Green: "two"
}

// #289: array/vec take a bare type token (like assert_eq's `T: Type`), not a
// Str literal. The old array("I64", ...) / vec("Str", ...) string-first-arg
// form is rejected with a type error.
terr_arr_str_type := array("I64", 1, 2, 3)
terr_vec_str_type := vec("Str", "a")

// #244: a non-enum match with no `case:` default is non-exhaustive.
terr_match_nonexhaustive := match 9 {
case 1: "a"
case 2: "b"
}

// #251: an interface is fieldless -- a non-func member is rejected.
TErrInterfaceField := interface {
    x := 0
}

// #251: an interface has no `namespace:` marker (no fields to separate
// from the methods).
TErrInterfaceNamespace := interface {
    a := ext_func(self: TErrInterfaceNamespace) returns I64 {}
namespace:
    b := ext_func(self: TErrInterfaceNamespace) returns I64 {}
}

// #251: a member must be func/proc (concrete) or ext_func/ext_proc
// (abstract) -- a test()/macro member is rejected.
TErrInterfaceBadKind := interface {
    t := test() {}
}

// #251: `implements` conformance. An interface for the cases below.
TErrConfIface := interface {
    must := ext_func(self: TErrConfIface) returns I64 {}
}

// missing abstract method: TErrConfMissing implements TErrConfIface but
// does not provide `must`.
TErrConfMissing := struct implements TErrConfIface {
    x := 0
}

// wrong signature: provides `must` but returns Str, not I64.
TErrConfBadSig := struct implements TErrConfIface {
namespace:
    must := func(_self: TErrConfBadSig) returns Str { return "" }
}

// implements a non-interface (a plain struct).
TErrConfNotIface := struct { y := 0 }
TErrConfImplNonIface := struct implements TErrConfNotIface {
    z := 0
}

// #251: the same conformance rules apply to `enum implements Iface`. Enums
// carry methods in their namespace, so the three failure modes mirror the
// struct ones exactly.

// missing abstract method: the enum names the interface but omits `must`.
TErrConfEnumMissing := enum implements TErrConfIface {
    A,
    B,
}

// wrong signature: provides `must` but returns Str, not I64.
TErrConfEnumBadSig := enum implements TErrConfIface {
    A,
namespace:
    must := func(_self: TErrConfEnumBadSig) returns Str { return "" }
}

// implements a non-interface (a plain struct).
TErrConfEnumImplNonIface := enum implements TErrConfNotIface {
    A,
}

// #287: the key binding of a two-variable for-in cannot be `mut` -- mutating
// a key in place would corrupt the map's key ordering / bucket placement.
// Values may be mutated (`for k, mut v`); keys may not.
terr_kvmut_map := Map(Str, I64).new()
terr_kvmut_map.set("a", own 1)
for mut k, v in terr_kvmut_map {
    println(k)
    println(v.to_str())
}

// #262: the thunk fallback lowers non-inlinable lazy bodies (loops, early
// returns) to ordinary thunk-taking functions -- including bodies that
// SHADOW a param (scope-aware auto-force). What it cannot express is
// ASSIGNING a lazy param: a thunk cannot be assigned, and the by-name splice
// would write into the caller's argument, which a forced temporary cannot.
// Such a def stays lazy and hard-errors as non-inlinable (lazy_thunk_blocked,
// src/self/loader.til). Here the body assigns the param `b`.
terr_bad_lazy := lazy_func(a: Bool, mut b: Bool) returns Bool {
    while a { b = false }
    return b
}

// #294: a numeric conversion on a numeric literal is redundant -- the bare
// literal already narrows to the target through its declaration type, an
// argument/field type, or any numeric context. Every form below is rejected.
// Out-of-range conversions (300.to_u8() truncation, -1.to_usize() wraparound)
// stay legal and are deliberately NOT listed here.
terr_conv_decl : U32 = 5.to_u32()                    // declaration type
terr_conv_cast : U16 = 7.cast(U16)                   // cast form
terr_conv_nested : F32 = 5.to_f32() / 100.to_f32()   // nested operands, typed decl
mut terr_conv_assign : I32 = 0
terr_conv_assign = 9.to_i32()                        // assignment target type
terr_conv_infer := 5.to_u8()                         // inferred -- needs explicit type
terr_conv_arg_fn := func(terr_cv: U16) returns U16 { return terr_cv }
terr_conv_arg_fn(42.to_u16())                        // argument type
terr_conv_op_fn := func(terr_b: I16) returns Bool { return terr_b > 0.to_i16() }
terr_conv_op_fn(1)                                   // operator-operand type
terr_conv_ret_fn := func() returns F32 { return 3.to_f32() }
terr_conv_ret_fn()                                   // return type

// #302: transferring ownership inside a loop, of a binding declared
// outside the loop -- the second iteration would move an already-moved
// value (previously compiled silently into use-after-free C). Loops
// that REASSIGN the binding before transferring stay legal.
terr_loop_sink := func(own terr_ls: Str) returns I64 { return terr_ls.len().to_i64() }
terr_loop_transfer := func() returns I64 {
    terr_lt_lit := "hello"
    terr_lt_s := terr_lt_lit.clone()
    mut terr_lt_total := 0
    mut terr_lt_i := 0
    while terr_lt_i < 2 {
        terr_lt_total = terr_lt_total + terr_loop_sink(own terr_lt_s)
        terr_lt_i++
    }
    return terr_lt_total
}

// non-void function whose body can fall off the end without returning: til's
// own all-paths-return check (not left to the C backend's -Werror=return-type).
// `if` with no else -- the false path reaches the end.
terr_missing_return_if := func(terr_mr_x: I64) returns I64 {
    if terr_mr_x > 0 { return 1 }
}
// no return at all -- ends in an assignment.
terr_missing_return_none := func(terr_mr_y: I64) returns I64 {
    mut terr_mr_z := terr_mr_y
    terr_mr_z = terr_mr_z + 1
}

// #303 regression (produces NO errors): a non-void function whose last
// path ends in a call to an inferred-noreturn function needs no trailing
// return. terr_nr_abort ends in panic (itself inferred noreturn from core
// exit), so fn_never_returns marks it and the direct call in terr_nr_pick
// resolves that FunctionDef -- the all-paths-return check accepts the missing
// else-path return. If the inference or resolution breaks, terr_nr_pick
// starts erroring and the expected count catches it.
terr_nr_abort := func(terr_nr_code: I64) {
    panic("terr_nr_abort: ", terr_nr_code.to_str())
}
terr_nr_pick := func(terr_nr_b: Bool) returns I64 {
    if terr_nr_b { return 41 }
    terr_nr_abort(3)
}

// A runtime callable that shadows the noreturn global `panic` is not direct
// and therefore cannot make this non-void function count as diverging.
terr_nr_returns := func() returns I64 { return 0 }
terr_nr_shadow := func() returns I64 {
    panic := terr_nr_returns
    panic()
}

// #286 follow-up: a ref-returning call's result is BORROWED. The Decl
// form was already rejected; plain reassignment and by-value AGGREGATE
// returns slipped past the typer and compiled into double frees.
terr_ref_result_src := func(terr_rr_s: Str) returns ref Str {
    return terr_rr_s
}
// storing the borrowed result in an owned (non-ref) binding
terr_ref_result_assign := func(terr_ra_s: Str) returns I64 {
    mut terr_ra_t := "x"
    terr_ra_t = terr_ref_result_src(terr_ra_s)
    return terr_ra_t.len().to_i64()
}
// returning the borrowed aggregate by value from an owned-returning func
terr_ref_result_return := func(terr_rt_s: Str) returns Str {
    return terr_ref_result_src(terr_rt_s)
}

// #320: a ref-payload ctor arg is a borrow that escapes into the enum
// value, so a temporary (ctor result here) is rejected
RefPayErrSrc := struct { n := 0 }
RefPayErr := enum { NoneV, SomeRef: ref RefPayErrSrc }
rp_bad := RefPayErr.SomeRef(RefPayErrSrc(n = 1))

// #320: the ref argument qualifier is only valid on type arguments of
// type templates; a surviving ref bit on an ordinary call is rejected
ref_arg_misuse := func(x: I64) returns I64 { return x }
rp_bad2 := ref_arg_misuse(ref 5)

// #187: a priv function whose ONLY reference is its own recursive call
// is unused -- the recursion kept it looking alive, so unreachable
// recursive helpers accumulated silently (desugarer.til's
// has_prior_throw_type was one). A recursive priv that IS called from
// elsewhere stays fine: unused_rec_live below is called at the bottom.
priv unused_rec_dead := func(n: I64) returns I64 {
    if n <= 0 { return 0 }
    return unused_rec_dead(n - 1)
}

priv unused_rec_live := func(n: I64) returns I64 {
    if n <= 0 { return 0 }
    return unused_rec_live(n - 1).add(1)
}

rec_live_result := unused_rec_live(2)

// #187: a dead CYCLE is dead code too. Each of these references the
// other, which the per-site `used` flag accepted as proof of life, so
// mutually-recursive helpers survived even with no caller at all.
// Usedness now propagates from the real roots along recorded reference
// edges, so a cycle nothing reaches stays unreached. cyc_live_a/b below
// form the same shape but are rooted by the call at the bottom.
priv cyc_dead_a := func(n: I64) returns I64 {
    if n <= 0 { return 0 }
    return cyc_dead_b(n - 1)
}

priv cyc_dead_b := func(n: I64) returns I64 {
    if n <= 0 { return 1 }
    return cyc_dead_a(n - 1)
}

priv cyc_live_a := func(n: I64) returns I64 {
    if n <= 0 { return 0 }
    return cyc_live_b(n - 1)
}

priv cyc_live_b := func(n: I64) returns I64 {
    if n <= 0 { return 1 }
    return cyc_live_a(n - 1)
}

cyc_live_result := cyc_live_a(3)

// #328: omitted generic type arguments that cannot be deduced. Each of
// these must produce exactly ONE focused diagnostic telling the caller to
// spell the type argument; the explicit form of every one still works.

// A type parameter used only by the return type has no value operand to
// deduce it from, and an UNTYPED destination gives the expected-type
// evidence (which now exists -- test_generic_expected_type_infer) nothing
// to say either. The diagnostic names both ways out.
g328_return_only := func(T: Type) returns T { return T() }
g328_return_only_result := g328_return_only()

// A source that DECLARES a type in its body needs init's full
// declaration pipeline (layout, generated methods, registration), which
// late instantiation cannot provide.
g328_local_struct := func(T: Type, v: T) returns I64 {
    Inner328 := struct { n := 0 }
    box := Inner328(n = 1)
    if v.eq(v) { return box.n }
    return 0
}
g328_local_struct_result := g328_local_struct(7)

// A nested type argument IS deduced now (`Vec(T)` against a `Vec__I64`
// operand), but only from a value argument. A parameter that appears
// solely in the RETURN type has nothing to line up against.
g328_nested_return_only := func(T: Type, n: USize) returns Vec(T) {
    if n.gt(0) { return Vec(T).new() }
    return Vec(T).new()
}
g328_nested_return_result := g328_nested_return_only(1)

// Dynamic establishes no type.
g328_dyn_id := func(T: Type, v: T) returns T { return v }
g328_dyn_arg : Dynamic = 0
g328_dyn_result := g328_dyn_id(g328_dyn_arg)

// Two operands of one type parameter must denote the SAME type: no
// widening, no interface conformance, no wildcard funcptr match.
g328_pick := func(T: Type, a: T, b: T) returns T {
    if a.eq(b) { return b }
    return a
}
g328_conflict_i32 : I32 = 5
g328_conflict_result := g328_pick(g328_conflict_i32, true)

// A literal narrows against hard evidence, and the ordinary range check
// still applies.
g328_range_i8 : I8 = 3
g328_range_result := g328_pick(g328_range_i8, 9000)

// #328 task 9: inference changes TYPE application only -- ownership
// mistakes on an inferred call get exactly the diagnostics an explicit
// one gets, from the ordinary concrete path.
G328Item := struct { n := 0 }
g328_consume := func(T: Type, own v: T) returns I64 {
    if v.eq(v) { return 1 }
    return 0
}
g328_borrow := func(T: Type, v: T) returns I64 {
    if v.eq(v) { return 1 }
    return 0
}
g328_missing_own_arg := G328Item(n = 1)
g328_missing_own := g328_consume(g328_missing_own_arg)
g328_extra_own_arg := G328Item(n = 2)
g328_extra_own := g328_borrow(own g328_extra_own_arg)

// A `ref` qualifier belongs on a TYPE argument; on a value argument of an
// inferred call it is still the hard error.
g328_ref_value_arg := G328Item(n = 3)
g328_ref_value := g328_borrow(ref g328_ref_value_arg)

// #328 task 11: a generic whose `throws` clause names a type parameter
// cannot be lowered before inference resolves it, so it requires explicit
// type application -- one focused diagnostic, no throw cascade.
g328_dep_throw := func(T: Type, v: T, fail: Bool) returns T throws T {
    if fail.not() { return v }
    throw v
}
g328_dep_throw_v : I64 = 5
g328_dep_throw_result := g328_dep_throw(g328_dep_throw_v, false)?
catch (e: I64) { }

// #321/#147: a `ref`-payload variant ctor in return position must not borrow
// an OWNED local -- the address escapes inside the returned enum and dangles,
// and gcc cannot see it through the struct the way -Werror=return-local-addr
// sees a bare `return local` from a `returns ref` function. Borrowing a param
// stays legal (test/option.til pins that control).
BorrowEscCell := struct { besc_n := 0 }
borrow_esc_bad := func() returns Option(ref BorrowEscCell) {
    borrow_esc_local := BorrowEscCell(besc_n = 7)
    return Option(ref BorrowEscCell).Some(borrow_esc_local)
}

borrow_esc_safe_ref_bad := func() returns Option(ref BorrowEscCell) {
    borrow_esc_safe_ref_local := BorrowEscCell(besc_n = 8)
    return safe_ref(borrow_esc_safe_ref_local)
}

// #324: a `ref` FIELD names storage its holder does not own, so passing
// it to an `own` parameter transfers an ownership the field never had --
// the callee (or a drain) would free through a borrow. The Ident arm has
// rejected this for ref VARIABLES all along; fields used to slip past.
RefField324 := struct { ref cell : BorrowEscCell }
consume_cell324 := proc(own c: BorrowEscCell) { println(c.besc_n.to_str()) }
pass_ref_field324 := proc(h: RefField324) {
    consume_cell324(own h.cell)
}

// #321 step 3: is_null is the Dynamic quarantine's raw-pointer probe;
// on a typed value the nullability question is answered by Option(ref T),
// so both the direct and UFCS spellings are rejected. (Deliberate raw
// probes launder through to_ptr -- see Expr.delete.)
NullProbe321 := struct { np_n := 0 }
probe_direct321 := func(p: NullProbe321) returns Bool { return is_null(p) }
probe_ufcs321 := func(p: NullProbe321) returns Bool { return p.is_null() }

// (#321 step 4's NULL-literal fixtures left with the keyword: nothing can
// utter NULL from source anymore. The typer's four write-side checks stay
// as guards over compiler-generated null nodes.)

// Omitting a required argument of a callee that ALSO declares a variadic
// used to CRASH the compiler right after printing this error: argument
// alignment bails without rebuilding the arg list, and the variadic desugar
// then derived its count by subtracting the param count from the SHORTER
// list -- USize, so it underflowed and the setter loop read past the end.
// `expect()` reaches it the same way. One error, then the run continues.
// #342: the mixed splat this once had to work around (the nested
// `format(mv_head, format(..mv_rest))`) lowers directly again.
mv_variadic_callee := func(mv_head: Str, mv_rest: ..Str) returns Str {
    return format(mv_head, ..mv_rest)
}
mv_missing_required := mv_variadic_callee()

// A struct field's default has to agree with its explicit type, exactly
// like a local declaration's. The check was missing on the field path, so
// these typed clean and died in the C compiler instead ("assignment to
// 'FieldDefCell *' from incompatible pointer type" for the ref case) or
// silently built a nonsense value.
FieldDefCell := struct { fdc_n := 0 }
FieldDefStruct := struct { fdc : FieldDefCell = 0 }
FieldDefRef := struct { ref fdc : FieldDefCell = 0 }
FieldDefStr := struct { fds : Str = 0 }
FieldDefNum := struct { fdn : I64 = "x" }

// #341: a leading-dot pattern elides the enum name, so the subject has to
// BE an enum -- there is nothing else the name could come from. A dotted
// name that is not a variant of the subject's enum reports against that
// enum, exactly as the written-out spelling does.
dot_non_enum_subject := 3
switch dot_non_enum_subject {
case .Nope: println("no")
case: println("d")
}
DotErrColor341 := enum { DRed, DGreen }
dot_err_c := DotErrColor341.DRed
switch dot_err_c {
case .DPurple: println("no")
case: println("d")
}

// #341 follow-up: a leading dot in a position with no known enum type has
// nothing to resolve against. Says so, rather than reporting a symbol named
// "" -- which is what the empty receiver the parser builds would otherwise
// surface as. A variadic callee is deliberately included: the positional
// arg-to-param mapping is not reliable there, so the name stays required.
dot_no_expected_type := .Nowhere
dot_va341 := func(a: DotErrColor341, _rest: ..Str) returns Str { return a.to_str() }
dot_va_call341 := dot_va341(.DRed, "x")

// Calling something that is not a function. Every callable shape is
// recognised before this check -- functions and signatures have a
// func_def, funcptr and Body values carry their own type, constructors
// and cast/array/vec return earlier -- so what reaches it is a plain
// value with a call's syntax. The typer used to accept it silently and
// the interpreter then walked into a NULL callee def and SEGFAULTED.
not_callable_int := 0
not_callable_int_result := not_callable_int(5)

NotCallableP := struct { n := 0 }
not_callable_struct := NotCallableP()
not_callable_struct_result := not_callable_struct(5)

not_callable_str := "hi"
not_callable_str_result := not_callable_str(5)

// #344: a write must land in storage the writer may change. A plain
// parameter is a READ-ONLY borrow of the caller's value (doc/concepts/qualifiers.org
// "Arguments"), so writing through one was never a legal program -- the
// typer just accepted it, and the two backends then disagreed about what
// it meant: interpreted the caller's local changed, compiled the write
// landed in a copy and vanished. Rejected at the write now, in every form
// that used to launder it.

// Probe 1: the direct write through a non-mut parameter.
Terr344Flat := struct { n := 0 }
terr344_poke := func(f: Terr344Flat) {
    f.n = f.n + 1
}

// The same write reached through an accessor's returned `ref`. The borrow
// carries provenance now, so the write is credited to `o` -- and rejected
// for the same reason the direct one is.
Terr344Inner := struct { n := 0 }
Terr344Outer := struct { inner := Terr344Inner() }
terr344_inner_of := func(o: Terr344Outer) returns ref Terr344Inner {
    return o.inner
}
terr344_bump := func(o: Terr344Outer) {
    ref mut i : Terr344Inner = terr344_inner_of(o)
    i.n = i.n + 1
}

// Wrapping the borrow in an Option payload and unwrapping it in a switch
// does not launder it either: the case binding inherits the scrutinee's
// roots.
terr344_maybe := func(o: Terr344Outer) returns Option(ref Terr344Inner) {
    return safe_ref(o.inner)
}
terr344_bump_payload := func(o: Terr344Outer) {
    switch terr344_maybe(o) {
    case .Some(got):
        got.n = got.n + 1
    case .None:
    }
}

// An immutable argument handed to a `mut` parameter, plainly and through a
// method receiver: the callee's signature says it writes, the caller's
// binding says it may not be written.
terr344_takes_mut := func(mut f: Terr344Flat) {
    f.n = 0
}
terr344_pass_immutable := func(f: Terr344Flat) {
    terr344_takes_mut(f)
}
terr344_pass_immutable_local := func() returns I64 {
    local := Terr344Flat()
    terr344_takes_mut(local)
    return local.n
}
Terr344Box := struct {
    n := 0
namespace:
    bump := func(mut self: Terr344Box) { self.n = self.n + 1 }
}
terr344_immutable_receiver := func(b: Terr344Box) {
    b.bump()
}

// `for mut x in coll` mutates the collection's elements through the
// element ref, so an immutable collection cannot supply them.
terr344_for_mut_immutable := func(v: Vec(Terr344Flat)) {
    for mut e : Terr344Flat in v {
        e.n = 0
    }
}

// #351: a ref FIELD is a borrow out of the value that holds it, so a
// write through it lands in the storage the borrow points at -- not in
// the holder. Parking an accessor's result there was the last typed
// route around a parameter's read-only qualifier: the write reached the
// caller's local, the two backends disagreed about whether it stuck
// (interpreted yes, compiled no), and nothing rejected it.
Terr351Held := struct { n := 0 }
Terr351Src := struct { held := Terr351Held() }
Terr351Holder := struct {
    ref r : Terr351Held
    tag := 0
}

terr351_held_of := func(s: Terr351Src) returns ref Terr351Held {
    return s.held
}
terr351_poke := func(s: Terr351Src) {
    mut h := Terr351Holder(r = terr351_held_of(s))
    h.r.n = h.r.n + 1
}

// The mirror image, which pins the precision: `tag` is an OWNED field,
// so writing it is the holder's own state. It needs `mut h` and must NOT
// implicate `s` -- crediting every borrow a value happens to hold to a
// write that never crossed one is what made this check unusable.
terr351_owned_field := func(s: Terr351Src) {
    h := Terr351Holder(r = terr351_held_of(s))
    h.tag = 1
}

// #354: the clone hop neither launders the write past the source NOR
// drags the intermediate holder into the verdict. Exactly one error,
// naming `s`: h2.r points at s's storage, and h -- the value the pointer
// was copied out of -- is not written by writing through it.
terr354_clone_poke := func(s: Terr351Src) {
    h := Terr351Holder(r = terr351_held_of(s))
    h2 := h.clone()
    h2.r.n = h2.r.n + 1
}

// #355: writing through ONE ref field names that field's source alone.
// s2 feeds q, which the write never crosses; dragging it into the
// verdict was the per-value lumping this issue closed.
Terr355Two := struct {
    ref p : Terr351Held
    ref q : Terr351Held
}
terr355_poke := func(s1: Terr351Src, s2: Terr351Src) {
    t := Terr355Two(p = terr351_held_of(s1), q = terr351_held_of(s2))
    t.p.n = t.p.n + 1
}

// #356: one level down, the write through h.r still names only h's
// source. Before the tag became a path, k's source came along too.
Terr356Outer := struct {
    h := Terr351Holder(r = Terr351Held())
    k := Terr351Holder(r = Terr351Held())
}
terr356_poke := func(s1: Terr351Src, s2: Terr351Src) {
    o := Terr356Outer(h = Terr351Holder(r = terr351_held_of(s1)),
                      k = Terr351Holder(r = terr351_held_of(s2)))
    o.h.r.n = o.h.r.n + 1
}

// #342: a `..` splat stands for the whole variadic run, so what has to match
// the parameter is its container's ELEMENT type. The block used to skip
// validation entirely as soon as any argument carried `..` (checking a splat
// AS an element would have rejected every one of them), so a mismatched splat
// reached the callee unchecked -- `format(..ints)` against `parts: ..Str` had
// the callee read each I64 as a Str pointer and segfault. Four shapes: wrong
// element type pure and mixed, a splat of something that is not a container at
// all, and the same against a user variadic.
terr342_ints := array(I64, 7, 8)
terr342_strs := array(Str, "a", "b")
terr342_plain := "abc"

terr342_pure := format(..terr342_ints)
terr342_mixed := format("x", ..terr342_ints)
terr342_noncontainer := format("x", ..terr342_plain)

terr342_sum := func(nums: ..I64) returns I64 {
    mut t := 0
    for n : I64 in nums { t = t.add(n) }
    return t
}
terr342_user := terr342_sum(1, ..terr342_strs)

// array() / vec() are declared `..Dynamic`, so the variadic check skips their
// block and the element type the literal NAMES is what a splat is measured
// against instead. This folded an Array(Str) into an Array(I64) and printed
// the pointers as numbers.
terr342_array_lit := array(I64, 1, ..terr342_strs, 9)
terr342_vec_lit := vec(I64, ..terr342_strs)

// A Vec is not a splat source: the block is folded with Array.concat, whose
// parameters are Arrays. This used to pass the typer and then split the
// backends -- the interpreter ran it on the coincidence that a Vec's data and
// count sit where an Array's data and cap do, while the C backend rejected
// `Array__I64_concat(a, v)` outright.
terr342_vec_src := vec(I64, 1, 2)
terr342_vec_splat := terr342_sum(..terr342_vec_src)

// A ..Dynamic variadic exempts every ELEMENT from the check, but not a splat:
// converting one would mean converting each element over a runtime length. This
// used to pass the typer and then split the backends -- the interpreter ran it
// while the C backend refused `Array__Dynamic_concat(collector, Array__Str)`.
terr342_dyn := func(xs: ..Dynamic) returns USize { return xs.len() }
terr342_dyn_splat := terr342_dyn(1, ..terr342_strs)

// #360: parking the borrow in an OWNED local and returning it does not
// launder the write either. mk hands back a Holder whose ref field
// points into s, so writing through it writes s -- and s is a read-only
// borrow here. This was the last shape that compiled while the two
// backends disagreed about where the write landed.
terr360_mk := func(s: Terr351Src) returns Terr351Holder {
    h := Terr351Holder(r = terr351_held_of(s))
    return h
}
terr360_poke := func(s: Terr351Src) {
    h2 := terr360_mk(s)
    h2.r.n = h2.r.n + 1
}

// #393: a borrow deposited into ANOTHER argument's storage keeps its
// root. The holder rides Vec.push into hs, so the write through the
// element writes s -- a read-only borrow here. This compiled while the
// backends disagreed about where the write landed (the compiled copy of
// s took it). Exactly one error, naming s.
terr393_vec_poke := func(s: Terr351Src) {
    mut hs := Vec(Terr351Holder).new()
    hs.push(own Terr351Holder(r = terr351_held_of(s)))
    ref mut h : Terr351Holder = hs[0]
    h.r.n = h.r.n + 1
}

// #393: the helper-deposit form -- the (sink, source) pair is computed
// on the callee's body and mapped onto the caller's arguments.
Terr393Box := struct { h := Terr351Holder(r = Terr351Held()) }
terr393_park := func(mut b: Terr393Box, h: Terr351Holder) { b.h = h }
terr393_helper_poke := func(s: Terr351Src) {
    mut b := Terr393Box()
    terr393_park(b, Terr351Holder(r = terr351_held_of(s)))
    b.h.r.n = b.h.r.n + 1
}

// #393: the direct field-assign form of the same deposit, no call
// involved -- only Decl RHSes used to record carried roots.
terr393_direct_poke := func(s: Terr351Src) {
    mut b := Terr393Box()
    b.h = Terr351Holder(r = terr351_held_of(s))
    b.h.r.n = b.h.r.n + 1
}

// #357 family: a `ref` FIELD holding a pointer-to-scalar is a borrow, so
// binding it needs `ref` too. Unlabelled, the interpreter bound the ADDRESS
// and read through it while codegen emitted `U8 x = h.buf` -- gcc's "makes
// integer from pointer without a cast", so the program did not build at
// all. `ref x : U8 = h.buf` (used by terr357_ok below) is the spelling that
// always worked in both backends.
Terr357Holder := struct {
    ref buf : U8
}

terr357_bad := proc(h: Terr357Holder) {
    x : U8 = h.buf
    ref v : U8 = ptr_add(x, 0)
    println(v.to_i64().to_str())
}

terr357_ok := proc(h: Terr357Holder) {
    ref x : U8 = h.buf
    ref v : U8 = ptr_add(x, 0)
    println(v.to_i64().to_str())
}

// #357 family: a Dynamic parameter takes any raw WORD -- `memcpy(buf, byte,
// 1)` in str.til passes a U8 value on purpose -- so a scalar there is not
// wrong by itself. It IS wrong in an ADDRESS position, where the callee
// dereferences it: the two backends did not even agree on the garbage,
// compiled C reading through the value while the interpreter yielded 0.
// terr357b_ok covers the three spellings that carry an address.
terr357b_bad_param := proc(q : U8) {
    ref z : U8 = ptr_add(q, 1)
    println(z.to_i64().to_str())
}

terr357b_bad_local := proc() {
    x : U8 = 5
    ref z : U8 = ptr_add(x, 1)
    println(z.to_i64().to_str())
}

terr357b_ok := proc() {
    mut b : U8 = malloc(4)
    memset(b, 65, 4)
    memcpy(ptr_add(b, 1), 66, 1)
    ref v : U8 = ptr_add(b, 0)
    d : Dynamic = b
    ref z1 : U8 = ptr_add(b, 1)
    ref z2 : U8 = ptr_add(v, 1)
    ref z3 : U8 = ptr_add(d, 1)
    println(z1.to_i64().to_str())
    println(z2.to_i64().to_str())
    println(z3.to_i64().to_str())
    free(own b)
}

// #275 step 3: copying a managed aggregate's BYTES duplicates every owned
// pointer inside it -- the source keeps its own and the destination now
// holds the same addresses, so `delete` runs twice over one buffer. Both
// the naked form and the `to_ptr` laundering the issue recorded ("once a
// value is a Dynamic the typer sees memcpy(Dynamic, Dynamic, n) with no
// idea those bytes contain an owned c_str") are rejected.
terr275_dup_managed := proc() {
    s := format("dup", "licate")
    mut d : I8 = malloc(16)
    memcpy(d, s, 16)
    println(s)
    free(own d)
}

terr275_dup_laundered := proc() {
    s := format("dup", "licate")
    mut d : I8 = malloc(16)
    memcpy(d, to_ptr(s), 16)
    println(s)
    free(own d)
}

// #372: returning a Str VIEW of a local hands the caller storage that dies
// with the frame. The view shares the local's buffer, the garbager frees
// that buffer at the return, and the caller reads freed memory -- ASAN
// says heap-use-after-free on both backends. #350's taint pass extends a
// base's life WITHIN a body and cannot reach past the body's own return,
// so nothing caught this. The legal shapes (a param receiver, a view of a
// param, a cloned result, a literal) are pinned by test/strings.til.
terr372_view_of_local := func(n: USize) returns Str {
    base := format("DANGLE_BASE_", n.to_str())
    return base.substr(0, 6)
}

// Two hops: a view OF a view still bottoms out at the owned local, and the
// diagnostic names that local rather than the intermediate.
terr372_view_of_view := func(n: USize) returns Str {
    base := format("abcdefgh", n.to_str())
    v := base.substr(0, 6)
    return v.substr(0, 3)
}

// Chained in one expression, through a different view-returning method.
terr372_chained_view := func(n: USize) returns Str {
    base := format("  padded  ", n.to_str())
    return base.trim().substr(0, 3)
}

// #373: dyn_call dispatching `delete` over an owned LOCAL releases it
// twice -- the dispatched body runs, and the garbager's own scheduled
// delete for the local runs as well (abort compiled, segfault
// interpreted). The transfer cannot be spelled either: `own r` is
// rejected because dyn_call's parameter is not `own`. A raw address (what
// Tuple.delete passes) or a field is untracked and stays legal.
Terr373Res := struct {
    name := ""
namespace:
    delete := proc(own self: Terr373Res, call_free: Bool = true) {
        println("delete ran")
        // `false`: `name` is an INLINE field, so its storage belongs to this
        // struct and only its contents are ours to release. `true` would
        // free the middle of the holder -- what #389 now rejects, and what
        // this fixture wrongly modelled when it was written.
        Str.delete(own self.name, false)
        if call_free { free(own self) }
    }
}

terr373_dyn_call_delete_local := proc() {
    r := Terr373Res(name = "ab")
    dyn_call("Terr373Res", "delete", 2, r, true)
    println("unreached")
}

// #358: array()/vec() are declared ..Dynamic, but their plain elements must
// match the element type named by the literal. The Str case pins that literals
// are exact containers: they do not inherit a ..Str parameter's to_str coercion.
terr358_bad_array := array(I64, 1, "a", 9)
terr358_bad_vec := vec(I64, 1, "a", 9)
terr358_no_to_str := array(Str, 1)

// #358 made Dynamic the deliberate exception: each element converts
// independently. #392 stage C is the limit of that -- converting
// independently still means each converted value has to FIT, and a raw
// Dynamic slot is one word. This literal read its first element back as a
// Str whose count came from the SECOND element, on both backends. The
// exception survives for words; it never held for a Str.
terr358_dynamic := array(Dynamic, 1, "a")

// #389: `T.delete(own <inline field>, true)` frees a pointer into the MIDDLE
// of the holder. An inline (non-`own`) field is stored by value, so
// `self.name` is not a heap box, but call_free=true makes the callee's tail
// run `free(own self)` over that interior address -- glibc aborts on BOTH
// backends, and only when the field's contents were heap-allocated, which is
// what makes it look intermittent. `false` is the fix and is what the tree
// already writes (loader.til's `Str.delete(own self.mode_str, false)`).
//
// The legal neighbours are pinned by test/own_fields.til rather than here: an
// `own` field IS a real box, so `true` is correct there, and `false` on an
// inline field is the everyday spelling.
Terr389Holder := struct {
    name := ""
namespace:
    delete := func(own self: Terr389Holder, call_free: Bool = true) {
        Str.delete(own self.name, true)
        if call_free { free(own self) }
    }
}

// #390: `free(own <managed field>)` reached through a FIELD, the spelling
// #389's rule did not cover. `free` takes a raw address and a managed field
// is not one. Both kinds are wrong, for different reasons and with different
// fixes, so both are pinned:
//
//   - INLINE: stored by value, so this hands free an address inside the
//     holder. Interpreted it aborted with "free(): double free detected in
//     tcache 2" and no diagnostic; compiled it did not build, leaking raw
//     gcc text ("invalid type argument of '->'") where a til error belongs.
//     Fix: T.delete(own <field>, false).
//   - OWN: a real box, so the free succeeds and then leaks whatever the
//     field owned in turn -- the same complaint the local form already
//     makes. Fix: T.delete(own <field>, true).
Terr390Inline := struct {
    name := ""
namespace:
    delete := func(own self: Terr390Inline, call_free: Bool = true) {
        free(own self.name)
        if call_free { free(own self) }
    }
}

Terr390Owned := struct {
    own buf : Str = ""
namespace:
    delete := func(own self: Terr390Owned, call_free: Bool = true) {
        free(own self.buf)
        if call_free { free(own self) }
    }
}

// #391: an OWN pointer field (`own c_str : I8` in Str, `own data : U8` in
// Vec/Array) bound BY VALUE -- the #357 case above, one qualifier over.
// The til type says scalar and the C storage is a pointer, so codegen
// wrote `I8 a = s.c_str;`: gcc rejects it outright, so the failure was a
// -Werror line against gen/til/*.c with nothing pointing at the til
// source, while the interpreter ran the same program and printed the
// right answer. The two spellings that DO work on both backends are `ref`
// (borrow the pointer) and `: Dynamic` (the raw address); the diagnostic
// names both, and test_pointer_field_spellings in test/strings.til runs
// them as positive cases.
terr391_lit := "hello"
terr391_s := terr391_lit.clone()
terr391_by_value := terr391_s.c_str
mut terr391_mut := terr391_s.c_str
terr391_mut = terr391_s.c_str

mut terr391_v := Vec(Str).new()
terr391_v.push(own terr391_lit.clone())
terr391_data := terr391_v.data

// #328 follow-up: the Unknown-valued RHS of a typed decl. The
// initializer's own failure (conflicting evidence) is the ONE error; the
// "'x' declared as GNoEv328 but value is " follow-up -- with nothing to
// print after "is" -- is suppressed noise, not a second diagnostic.
GNoEv328 := struct { n := 0 }
gpair_noev328 := func(T: Type, a: T, b: T) returns T { return a }
gnoev_conflict : GNoEv328 = gpair_noev328("s", GNoEv328())

// #328 follow-up: a bare function argument has no NAME for T to be. The
// answer would have to be a registered type and `func(...)` written
// inline never got one, so the diagnostic points at the fix (declare it
// through a FuncSig) rather than blaming Dynamic, which is a different
// reason with a different remedy.
gbare_apply328 := func(T: Type, f: T, a: I64, b: I64) returns I64 { return f(a, b) }
gbare_fn328 := func(a: I64, b: I64) returns I64 { return a + b }
gbare_call328 := gbare_apply328(gbare_fn328, 2, 5)
// #396: the same address reaching the OTHER slots. #391 closed the Decl;
// expr_is_address / slot_takes_address are now one rule consulted by each
// site, and each keeps its own message because the fix differs by slot.
// An ext binding's unqualified pointer parameter still takes `s.c_str` --
// that is doc/ffi.org's rule that `shallow` marks the by-value ones, and
// test/cstr_view.til holds it.
terr396_takes_scalar := func(b: I8) returns Bool {
    return b == 0
}

terr396_returns_scalar := func(s: Str) returns I8 {
    return s.c_str
}

terr396_arg := terr396_takes_scalar(terr391_s.c_str)

// #392 stage B: a raw Dynamic slot is ONE WORD, and a wider value going into
// one used to be unreported. `Array(Dynamic).set(own s)` handed adopt a
// 16-byte Str box; adopt copied Dynamic.size() = 8 bytes out of it and freed
// the box, so `ref back : Str = a[0]` read an empty string -- both backends
// agreeing on the wrong answer. `d : Dynamic = s` split them instead:
// interpreted it kept the erased pointer (#362) and read back fine, compiled
// it emitted `void *d = DEREF(s)` and died inside the C compiler with
// "incompatible types when initializing type 'void *'", pointing at gen/c
// rather than at the til line. Tuple keeps every element at its true size, so
// that is where a wide value belongs; both diagnostics say so.
terr392_s := format("run", "time")
terr392_wide_binding : Dynamic = terr392_s

terr392_store := func(s: Str) {
    mut a := Array(Dynamic).new(1)
    a.set(0, own s.clone())!
}

// #398: a deposit the CALLEE performs is credited one level up. #393
// summarised only deposits a function made directly, so a helper that
// deposits by calling something else on its parameter looked inert and
// its callers lost the root -- the non-mut form below compiled while
// the two backends disagreed about where the write landed. Two errors,
// each naming s.
Terr398Store := struct {
    hs := Vec(Terr351Holder).new()
namespace:
    put := func(mut self: Terr398Store, h: Terr351Holder) {
        self.hs.push(own h.clone())
    }
}

terr398_via_self := func(s: Terr351Src) {
    mut st := Terr398Store()
    st.put(Terr351Holder(r = terr351_held_of(s)))
    ref mut h : Terr351Holder = st.hs[0]
    h.r.n = h.r.n + 1
}

// The receiver is a plain parameter of a FREE function, resolvable only
// off its declared type -- nothing is typed when summaries are built.
terr398_wrap := func(mut st: Terr398Store, h: Terr351Holder) {
    st.put(h)
}

terr398_via_param := func(s: Terr351Src) {
    mut st := Terr398Store()
    terr398_wrap(st, Terr351Holder(r = terr351_held_of(s)))
    ref mut h : Terr351Holder = st.hs[0]
    h.r.n = h.r.n + 1
}

// Stage B checked the WIDTH, and a struct that FITS in a word slipped
// through: `void * d = e;` is the same cc error for an 8-byte struct as for a
// Str, and the interpreter accepted every spelling of it. Exactly one shape
// escaped, and by accident -- an immutable binding of an immutable local
// Ident is turned into a borrow by the aliasing rule in infer_decl_stmt, so
// it emitted `&e` and worked, while `mut` on the same line, or a constructor
// or a call on the right, did not. Which one you wrote decided whether your
// program compiled. Four spellings of one mistake, reported at the til line
// now; `ref` remains the way to bind the address.
TerrWord := struct {
    a : U32 = 7
    b : U32 = 8
}

terr392_mk := func() returns TerrWord { return TerrWord() }

terr392_narrow_alias := proc() {
    e := TerrWord()
    d : Dynamic = e
    println(d.is_null().to_str())
}

terr392_narrow_mut := proc() {
    e := TerrWord()
    mut d : Dynamic = e
    println(d.is_null().to_str())
}

terr392_narrow_ctor := proc() {
    d : Dynamic = TerrWord()
    println(d.is_null().to_str())
}

terr392_narrow_call := proc() {
    mut d : Dynamic = terr392_mk()
    println(d.is_null().to_str())
}

// #398 link 2: the same deposit where the helper's receiver parameter has
// a GENERIC type. The callee resolves off hs's DECLARED type, since
// nothing is typed when summaries are built; until it did, the deposit's
// source bits came back empty and the pair never crossed. One error,
// naming s.
terr398_vec_wrap := func(mut hs: Vec(Terr351Holder), h: Terr351Holder) {
    hs.push(own h.clone())
}

terr398_via_generic := func(s: Terr351Src) {
    mut hs := Vec(Terr351Holder).new()
    terr398_vec_wrap(hs, Terr351Holder(r = terr351_held_of(s)))
    ref mut h : Terr351Holder = hs[0]
    h.r.n = h.r.n + 1
}

// #396, the last two slots: ASSIGN to a scalar local, and the CONSTRUCTOR
// spelling of a field. The FieldAssign spelling (`bx.p = s.c_str`) was
// already rejected; the constructor reaches the builder as that same
// assign but is an FCall named argument at typer time, so it needed the
// ctor's own field/value pairing.
Terr396Box := struct {
    p : I8 = 0
}

terr396_assign := proc() {
    mut a : I8 = 0
    a = terr391_s.c_str
    if a == 0 { println("z") }
}

terr396_ctor := proc() {
    bx := Terr396Box(p = terr391_s.c_str)
    if bx.p == 0 { println("z") }
}

// #399: the aggregate FIELD of a borrowed element, returned by value,
// shares heap that dies with the container -- a hoist copies the
// pointers, not the bytes behind them, so this is rejected the way #286
// rejects returning the element itself. The clone spelling is pinned by
// test/ref.til's bp399_agg_clone.
Terr399S := struct { t := "x" }
terr399_agg_field := func() returns Str {
    mut ss := Vec(Terr399S).new()
    ss.push(own Terr399S(t = format("he", "llo")))
    return ss[0].t
}
