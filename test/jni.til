mode cli

// #463: the JNI binding generated for every `mode lib` library. Checks the
// generated Java class and C bridge for test/jni_lib.til as text, then
// builds it with `til build --jni` and runs test/JniLibTest.java against the
// jar and bridge; on Linux
// again under explicit --asan with the library and bridge sanitized, so the
// cage's leak report covers every bridge path. Needs a JDK (test/jni_support.til finds
// it). test/library_namespace.til drives library_namespace_a the same way.

import("../src/std/sys")
import("../src/std/file")
import("jni_support")

JAVA := "gen/til/java/til/jni_lib/JniLib.java"
BRIDGE := "gen/til/jni_lib_jni.c"
JAR := "gen/lib/jni_lib.jar"
CLASS_PATH := "gen/lib/jni_lib.jar:tmp/jni_classes"

require_contains := func(text: Str, expected: Str) returns Bool {
    if text.contains(expected).not() { panic("missing generated JNI text: ", expected) }
    return true
}

check_text := proc() {
    java := File.readfile(JAVA)
    c := File.readfile(BRIDGE)
    require_contains(java, "package til.jni_lib;")
    require_contains(java, "public final class JniLib {")
    require_contains(java, "static { System.loadLibrary(\"jni_lib_jni\"); }")
    require_contains(java, "public static byte jni_add_u8(byte a, byte b) {")
    require_contains(java, "public static int jni_add_usize(int a, int b) {")
    require_contains(java, "public static boolean jni_not(boolean a) {")
    require_contains(java, "public static long JniCounter_twice(long x) {")
    require_contains(java, "public static String jni_greet(String name) {")
    require_contains(java, "return tilStr(n_jni_greet(tilUtf8(name)));")
    require_contains(java, "public static long jni_safe_div(long a, long b) throws TilError {")
    require_contains(java, "public static void jni_bump(long[] n) {")
    require_contains(java, "public static void jni_append(String[] s, String suffix) {")
    require_contains(java, "public static JniShape JniShape_Label(String val) {")
    require_contains(java, "public static JniPerson jni_holder_person(JniHolder h) {")
    require_contains(java, "return new JniPerson(n_jni_holder_person(h.tilHandle()), false);")
    require_contains(java, "public interface JniMapFn {")
    require_contains(java, "public static long jni_apply(JniMapFn f, long x) {")
    require_contains(java, "public static String[] jni_split(String text) {")
    require_contains(java, "public JniHolder() { this(h_JniHolder_new(), true); }")
    require_contains(java, "public static long jni_sum(long[] xs) {")
    require_contains(java, "public static void jni_scale(double[][] xs, double k) {")
    require_contains(java, "return JniPerson.tilArray(n_jni_people(tilUtf8All(names)));")
    require_contains(java, "public static void jni_age_all(JniPerson[][] people) {")
    require_contains(java, "long[][] tilMut0 = { JniPerson.tilTakeAll(people[0]) };")
    require_contains(java, "void call(JniPerson[][] a0);")
    // Callbacks: a throwing one declares TilError; mut values cross in
    // one-element holders, an own handle as one Java owns.
    require_contains(java, "long call(long a0) throws TilError;")
    require_contains(java, "void call(long[] a0, String[] a1, boolean[] a2, long[][] a3, String[][] a4);")
    require_contains(java, "a1[0] = tilUtf8(java.util.Objects.requireNonNull(tilMut1[0], \"tilMut1[0]\"));")
    require_contains(java, "return f.call(tilStr(a0), new JniPerson(a1, true), a2);")
    require_contains(java, "public TilError(String type, String detail) {")
    require_contains(java, "return JniPerson.tilTakeAll(f.call(JniPerson.tilViews(a0), JniPerson.tilArray(a1)));")
    if java.contains("JniCounter_delete") { panic("generated lifecycle member bound through JNI") }
    require_contains(java, "public static final class JniPerson implements AutoCloseable {")
    require_contains(java, "public JniPerson() { this(h_JniPerson_new(), true); }")
    require_contains(java, "return tilStr(h_JniPerson_get_name(tilHandle()));")
    require_contains(java, "public static JniPerson jni_person(String name, long age) {")
    require_contains(java, "return n_jni_person_consume(p.tilTake());")
    require_contains(java, "n_jni_person_birthday(p.tilHandle());")

    require_contains(c, "#include \"jni_lib.h\"")
    require_contains(c, "JNICALL Java_til_jni_1lib_JniLib_n_1jni_1greet(JNIEnv *env, jclass cls, jbyteArray a0)")
    // Borrowed Str: a bridge temporary, deleted after the call.
    require_contains(c, "TilJniStr r = til_jni_x5flib__jni_greet(&t0);\n    TIL_JNI_STR_DELETE(&t0, 0);")
    // Owned Str: a heap box the library frees.
    require_contains(c, "TilJniStr r = til_jni_x5flib__jni_take(t0);\n    jbyteArray out")
    require_contains(c, "    Bool r = til_jni_x5flib__jni_not((Bool)(a0 != JNI_FALSE));")
    require_contains(c, "if (err_kind == 3LL) {")
    require_contains(c, "til_jni_throw(env, \"DivideByZero\", &err_3.msg);")
    require_contains(c, "til_jni_throw(env, \"JniBad\", NULL);")
    require_contains(c, "abort();")
    // Struct handles: literal defaults copied into the box, own boxes
    // handed to the library, close() through the type's delete.
    require_contains(c, "(*p).name = til_jni_str_lit(\"anon\", 4);")
    require_contains(c, "(*p).active = 1;")
    // An own field's default gets its own box.
    require_contains(c, "TIL_OWN_SET((*p).person, b1);")
    require_contains(c, "I64 r = til_jni_x5flib__jni_person_consume(p0);")
    require_contains(c, "til_jni_x5flib__JniPerson_delete((til_jni_x5flib__JniPerson *)(intptr_t)h, 1);")
    // A TilError from a callback becomes the declared throw, its payload
    // the type's default with the detail as msg.
    require_contains(c, "char *thrown = til_jni_cb_caught(env, \"JniTryFn\", &detail);")
    require_contains(c, "if (strcmp(thrown, \"DivideByZero\") == 0) {\n            *x1 = 3LL;")
    require_contains(c, "(*x2).code = 7;")
    require_contains(c, "threw TilError %s, which its til type does not declare")
}

// Everything the class lists as not bound is also a note when the library is
// built.
check_notes := proc(err: Str) {
    for line : Str in File.readfile(JAVA).split("\n") {
        if line.contains(" not bound: ").not() { continue }
        reason := line.substr(line.find(" not bound: ").to_usize(), line.len() - line.find(" not bound: ").to_usize())
        if err.contains(reason).not() { panic("no build note for: ", line, "\nstderr:\n", err) }
    }
    require_contains(err, "note: JNI binding til.jni_lib.JniLib: field JniTeam.people not bound: type Vec__JniPerson\n")
    require_contains(err, "note: JNI binding til.jni_lib.JniLib: JniTeam() not bound: ")
    require_contains(err, "note: JNI binding til.jni_lib.JniLib: adopt__F64 not bound: parameter 'dest' of type Dynamic\n")
}

EXPECTED := "127\n250\n-2000\n65000\n1999999999\n4294967295\n1099511627783\n18446744073709551615\n42\n1.5\n2.5\nfalse true\n42\n6\nhello, jvm\n<owned>\n42\ncaught DivideByZero / DivideByZero: b is zero\ncaught JniBad / JniBad\nada:36\ngrace:37 true\nanon 0 true\n5\nmoved: JniPerson handle is closed or moved\n42 false\nholder: n: a mut parameter takes a one-element array\n49 12 0\n7 own 0\npayload: JniShape is not Label\n2 held held\n5 renamed\nborrowed: cannot move a borrowed JniPerson\n90\n[cb]\n36\nmade:9\ntrue\nx|y||z\np|q\n303\nanon 0\n46\n[0, 1, 4, 9, 16] 0\n[3.0, 4.0, 2.0]\n2\n3 ccc 2 ccc\n3 a\nq [0, 1]\n[4, 5, 6]\n121\n42\nJniErr neg -1 7\nDivideByZero []\nJniBad\n42 abc true 2:9 p|q\nmm:11\n504\nkept 30\n2 z b\n3 new a false\nmut vec: JniPerson handle is closed or moved\nborrowed vec: cannot move a borrowed JniPerson\n2 z\nloop ok\n"

main := proc(args: ..Str) {
    // TEMPORARY (#464): make test passes no sanitizer flag; test_asan does.
    mut asan := false
    mut run_jvm := true
    for arg : Str in args {
        if arg == "--no-jvm" { run_jvm = false }
        else if arg == "--asan" { asan = true }
        else { panic("test/jni.til: unknown argument ", arg) }
    }
    // --no-jvm (bin/tests --no-jvm): a host without a JDK builds without
    // --jni and stops at the text.
    build := Cmd.new("bin/til", "build")
    if run_jvm { build.arg("--jni") }
    build.arg("test/jni_lib.til")
    build.capture()
    if build.run() != 0 { panic("building test/jni_lib.til failed:\n", build.out(), build.err()) }
    check_text()
    check_notes(build.err())
    println("jni text ok")
    if run_jvm.not() { return }

    java_home := jni_java_home()
    jni_javac(java_home, "tmp/jni_classes", JAR, "test/JniLibTest.java")
    out := jni_run(java_home, CLASS_PATH, "JniLibTest")
    if out != EXPECTED { panic("JniLibTest output mismatch:\n", out) }
    println("jni jvm ok")

    if asan.and(host_os() == "linux") {
        jni_til_build("test/jni_lib.til", true)
        out_asan := jni_run_asan(java_home, CLASS_PATH, "JniLibTest")
        if out_asan != EXPECTED { panic("JniLibTest output mismatch under ASAN:\n", out_asan) }
        println("jni jvm asan ok")
    }
}
