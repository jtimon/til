mode script

// Issue #313 regression, COMPILE-ONLY. Built with --usize=32 --cptr=32, every
// own pointer field is a 4-byte cage offset (ext.h TIL_OWN_PTR), so on a
// 64-bit host Str = c_str(4)+count(4)+cap(4) = 12 and Vec has the same
// layout; a native build is 16. Map holds two Vecs inline: 24.
//
// Driven ONLY as a compiled binary by make.til's check_cptr32 target -- NOT
// interpreted: the compile-time interpreter manipulates the compiler's own
// native HOST structs, so X.size() is the host width under the interpreter.

check := proc(label: Str, got: USize, want: USize) {
    if got.neq(want) {
        println(format("FAIL: ", label, " = ", got.to_str(), ", want ", want.to_str()))
        exit(1)
    }
}

check("Str.size()", Str.size(), 12)
check("Vec(Str).size()", Vec(Str).size(), 12)
check("Vec(I64).size()", Vec(I64).size(), 12)
check("Map(Str, I64).size()", Map(Str, I64).size(), 24)
check("dyn_size_of Str", dyn_size_of("Str"), 12)

// Elements stride at the compressed width: 3 pushes stay addressable.
mut v := Vec(Str).new()
v.push(own "a")
v.push(own "bb")
v.push(own "ccc")
check("vec len", v.len(), 3)
ref e0 : Str = v.unsafe_get(0)
ref e2 : Str = v.unsafe_get(2)
if e0.eq("a").and(e2.eq("ccc")).not() { println("FAIL: vec stride"); exit(1) }

// A view stores a pointer into the middle of its buffer: byte offsets, not
// 16-byte units, are what make that representable.
whole := format("abc", "defgh")
mid := whole.substr(3, 4)
if mid.eq("defg").not() { println("FAIL: substr view"); exit(1) }

println("cptr32 sizes OK")
