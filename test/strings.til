mode test

test_eq := test() {
    assert("hello".eq("hello"))
    assert("hello".eq("world").not())
    assert("same first".eq("same fries").not())
    assert("same endpoints".eq("some endpoints").not())
    assert("".eq(""))
    assert("a".eq("a"))
    assert("ab".eq("ab"))
    assert("a".eq("ab").not())
}

test_cmp := test() {
    // Regression: memcmp returns the raw byte difference, but cmp must
    // normalise to -1/0/1 -- the auto-derived lt/gt are cmp(a,b).eq(-1) /
    // .eq(1), so a raw diff (e.g. 'a'-'z' = -25) would break ordering for
    // strings whose first differing bytes are not adjacent.
    assert("apple".lt("zebra"))
    assert("zebra".gt("apple"))
    assert("apple".lt("apricot"))
    assert("apricot".gt("apple"))
    assert("app".lt("apple"))
    assert("apple".gt("app"))
    assert("abc".lt("abz"))
    assert("abz".gt("abc"))
    assert("abc".lte("abc"))
    assert("abc".gte("abc"))
    assert("abc".lte("abz"))
    assert("abz".gte("abc"))
}

test_concat := test() {
    assert_eq(Str, format("hello", " world"), "hello world")
    assert_eq(Str, format("", "abc"), "abc")
    assert_eq(Str, format("abc", ""), "abc")
    assert_eq(Str, format("", ""), "")
}

test_clone := test() {
    s := "hello"
    s2 := s.clone()
    assert_eq(Str, s2, "hello")
    assert_eq(Str, s, "hello")
}

test_len := test() {
    assert_eq(USize, "hello".len(), 5)
    assert_eq(USize, "".len(), 0)
    assert_eq(USize, "a".len(), 1)
    assert_eq(USize, "hello world".len(), 11)
}

test_substr := test() {
    assert_eq(Str, "hello".substr(1, 3), "ell")
    assert_eq(Str, "hello".substr(0, 5), "hello")
    assert_eq(Str, "hello".substr(0, 0), "")
    assert_eq(Str, "hello".substr(4, 1), "o")
    assert_eq(Str, "hello".substr(0, 1), "h")
}

test_contains := test() {
    assert("hello world".contains("world"))
    assert("hello".contains("hello"))
    assert("hello".contains(""))
    assert("hello".contains("ell"))
    assert("hello".contains("xyz").not())
    assert("".contains("a").not())
    assert("".contains(""))
}

test_starts_with := test() {
    assert("hello".starts_with("hel"))
    assert("hello".starts_with("hello"))
    assert("hello".starts_with(""))
    assert("hello".starts_with("world").not())
    assert("hi".starts_with("hello").not())
}

test_ends_with := test() {
    assert("hello".ends_with("llo"))
    assert("hello".ends_with("hello"))
    assert("hello".ends_with(""))
    assert("hello".ends_with("world").not())
    assert("hi".ends_with("hello").not())
}

test_neq := test() {
    assert("hello".neq("world"))
    assert("hello".neq("hello").not())
    assert("".neq("").not())
    assert("a".neq("b"))
}

test_is_empty := test() {
    assert("".is_empty())
    assert("a".is_empty().not())
    assert("hello".is_empty().not())
}

test_find := test() {
    assert_eq(I64, "hello world".find("world"), 6)
    assert_eq(I64, "hello".find("ell"), 1)
    assert_eq(I64, "hello".find("hello"), 0)
    assert_eq(I64, "hello".find("xyz"), -1)
    assert_eq(I64, "hello".find(""), -1)
    assert_eq(I64, "".find("a"), -1)
    assert_eq(I64, "aaa".find("a"), 0)
    assert_eq(I64, "abcabc".find("bc"), 1)
}

test_rfind := test() {
    assert_eq(I64, "abcabc".rfind("bc"), 4)
    assert_eq(I64, "abcabc".rfind("a"), 3)
    assert_eq(I64, "hello".rfind("ell"), 1)
    assert_eq(I64, "hello".rfind("xyz"), -1)
    assert_eq(I64, "hello".rfind(""), -1)
    assert_eq(I64, "aaa".rfind("a"), 2)
}

test_replace := test() {
    assert_eq(Str, "hello world".replace("world", "til"), "hello til")
    assert_eq(Str, "aaa".replace("a", "bb"), "bbbbbb")
    assert_eq(Str, "hello".replace("xyz", "abc"), "hello")
    assert_eq(Str, "hello".replace("", "abc"), "hello")
    assert_eq(Str, "abab".replace("ab", "c"), "cc")
    assert_eq(Str, "hello".replace("hello", ""), "")
    assert_eq(Str, "a.b.c".replace(".", "/"), "a/b/c")
}

test_get_char := test() {
    assert_eq(Str, "hello".get_char(0), "h")
    assert_eq(Str, "hello".get_char(4), "o")
    assert_eq(Str, "abc".get_char(1), "b")
}

test_strip_prefix := test() {
    assert_eq(Str, "hello world".strip_prefix("hello "), "world")
    assert_eq(Str, "hello".strip_prefix("xyz"), "hello")
    assert_eq(Str, "hello".strip_prefix(""), "hello")
    assert_eq(Str, "hello".strip_prefix("hello"), "")
}

test_strip_suffix := test() {
    assert_eq(Str, "hello world".strip_suffix(" world"), "hello")
    assert_eq(Str, "hello".strip_suffix("xyz"), "hello")
    assert_eq(Str, "hello".strip_suffix(""), "hello")
    assert_eq(Str, "hello".strip_suffix("hello"), "")
}

test_from_byte := test() {
    assert_eq(Str, Str.from_byte(65), "A")
    assert_eq(Str, Str.from_byte(48), "0")
    assert_eq(Str, Str.from_byte(97), "a")
}

test_to_i64 := test() {
    assert_eq(I64, "42".to_i64(), 42)
    assert_eq(I64, "0".to_i64(), 0)
    assert_eq(I64, "123456".to_i64(), 123456)
    assert_eq(I64, "-7".to_i64(), -7)
    assert_eq(I64, "-100".to_i64(), -100)
    assert_eq(I64, "9223372036854775807".to_i64(), I64.MAX)
    assert_eq(I64, "-9223372036854775808".to_i64(), I64.MIN)
    assert_eq(Str, "18446744073709551615".to_u64().to_str(), "18446744073709551615")
    assert_eq(Str, "0xffffffffffffffff".to_u64().to_str(), "18446744073709551615")
}

test_to_u8 := test() {
    assert_eq(I64, "42".to_u8().to_i64(), 42)
    assert_eq(I64, "0".to_u8().to_i64(), 0)
    assert_eq(I64, "255".to_u8().to_i64(), 255)
}

test_to_i32 := test() {
    assert_eq(I64, "42".to_i32().cast(I64), 42)
    assert_eq(I64, "0".to_i32().cast(I64), 0)
    assert_eq(I64, "-7".to_i32().cast(I64), -7)
    assert_eq(I64, "123456".to_i32().cast(I64), 123456)
}

test_to_f32 := test() {
    assert_eq(Str, "3.14".to_f32().to_str(), "3.14")
    assert_eq(Str, "-2.5".to_f32().to_str(), "-2.5")
    assert_eq(Str, "7".to_f32().to_str(), "7")
    assert_eq(Str, "0.25".to_f32().to_str(), "0.25")
}

test_split := test() {
    parts := "a,b,c".split(",")
    assert_eq(USize, parts.len(), 3)
    assert_eq(Str, parts[0], "a")
    assert_eq(Str, parts[1], "b")
    assert_eq(Str, parts[2], "c")

    parts2 := "hello".split(",")
    assert_eq(USize, parts2.len(), 1)
    assert_eq(Str, parts2[0], "hello")

    parts3 := "a::b".split("::")
    assert_eq(USize, parts3.len(), 2)
    assert_eq(Str, parts3[0], "a")
    assert_eq(Str, parts3[1], "b")

    parts4 := ",a,".split(",")
    assert_eq(USize, parts4.len(), 3)
    assert_eq(Str, parts4[0], "")
    assert_eq(Str, parts4[1], "a")
    assert_eq(Str, parts4[2], "")
}

test_substr_view := test() {
    // substr returns a view, not a copy
    s := "hello world"
    view := s.substr(6, 5)
    assert_eq(Str, view, "world")

    // Issue #366: BOTH backends alias. The interpreter used to copy a
    // by-value Str returned from a til function into a fresh owned buffer,
    // so substr came back with cap == count and its own bytes while the
    // compiled run returned a real CAP_VIEW into `s`. That made every
    // view-lifetime and missing-NUL bug unreproducible interpreted -- which
    // is most of the suite. These two lines are the pin: they fail the
    // moment either backend starts copying again.
    assert_eq(USize, view.cap, CAP_VIEW)
    assert(view.c_str.ptr_eq(ptr_add(s.c_str, 6)))

    // clone materializes a view into an owned string
    owned := view.clone()
    assert_eq(Str, owned, "world")

    // views work with comparison
    assert(view.eq("world"))

    // views work with concat
    assert_eq(Str, format("say ", view), "say world")

    // get_char returns a 1-byte view
    assert_eq(Str, "abc".get_char(1), "b")

    // strip_prefix/suffix return views
    assert_eq(Str, "hello world".strip_prefix("hello "), "world")
    assert_eq(Str, "hello world".strip_suffix(" world"), "hello")

    mut v := Str.with_capacity(11)
    v.push_str("hello")
    v.push_str(" world")
    assert_eq(Str, v, "hello world")
}

test_join := test() {
    parts := "a,b,c".split(",")
    assert_eq(Str, join(parts, ","), "a,b,c")
    assert_eq(Str, join(parts, " - "), "a - b - c")

    mut single := Vec(Str).new()
    single.push(own "hello")
    assert_eq(Str, join(single, ","), "hello")

    empty := Vec(Str).new()
    assert_eq(Str, join(empty, ","), "")

    // Join with newline separator (escape sequence in literal)
    mut lines := Vec(Str).new()
    lines.push(own "aaa")
    lines.push(own "bbb")
    lines.push(own "ccc")
    result := join(lines, "\n")
    assert_eq(USize, result.len(), 11)
    assert_eq(Str, result, "aaa\nbbb\nccc")
}

// mut param concat -- reproduces use-after-free bug
greet := func(mut out: Str) {
    out = format(out, " world")
}

test_mut_param_concat := test() {
    mut s := "hello"
    greet(s)
    assert_eq(Str, s, "hello world")
}

// Issue #238: reassigning a heap-backed local from a substring VIEW of itself
// (`s = s.substr(...).clone()`). The substr view aliases s's buffer; the old-
// value delete must run AFTER the clone copies from the view, and the clone
// must not be elided into a move. Use a grown with_capacity buffer (a literal
// is CAP_LIT and never freed, so it would hide the bug).
test_self_substr_reassign := test() {
    mut s := Str.with_capacity(32)
    s.push_str("int foo ( int x ) ;")
    s = s.substr(0, s.len().sub(1)).clone()
    assert_eq(Str, s, "int foo ( int x ) ")

    mut t := Str.with_capacity(16)
    t.push_str("abcdefgh")
    t = t.substr(2, 4).clone()
    assert_eq(Str, t, "cdef")

    // Repeated self-reassign from a view.
    mut u := Str.with_capacity(16)
    u.push_str("hello world")
    u = u.substr(0, 5).clone()
    u = u.substr(1, 3).clone()
    assert_eq(Str, u, "ell")
}

// Issue #250: cross-variable sibling of #238. `holder.field = src.substr(...)
// .clone()` where `src` is a grown heap buffer freed at end of scope and the
// clone result outlives src (stored in a returned struct, read after src dies).
// The substr view aliases src's buffer; src's asap-delete must run AFTER the
// clone copies from the view, not at the view-producing substr. A grown
// with_capacity buffer is required (a literal is CAP_LIT and never freed).
Holder250 := struct {
    own s : Str = ""
}

make_holder250 := func() returns Holder250 {
    mut arg := Str.with_capacity(64)
    arg.push_str("--cc=hello_world_value")
    mut h := Holder250()
    h.s = arg.substr(5, arg.len().sub(5)).clone()
    return h
}

test_self_substr_field_clone := test() {
    h := make_holder250()
    assert_eq(Str, h.s, "hello_world_value")
}

// Issue #203 point 4 / #238: Str.replace on a grown buffer, including a `from`
// longer than the whole string (the `self.count.sub(from.count)` USize
// underflow guard) and a self-reassign through replace.
test_self_replace := test() {
    mut s := Str.with_capacity(32)
    s.push_str("hello world foo")
    s = s.replace("foo", "bar")
    assert_eq(Str, s, "hello world bar")

    assert_eq(Str, "ab".replace("abcdef", "x"), "ab")
    assert_eq(Str, "".replace("abc", "x"), "")
}

// #325: a `mut` heap Str local declared inside a NESTED block, reassigned to
// a literal and then moved into an outer binding, used to emit a `free` of
// the literal's static storage -- the generated C failed to compile with
// "'free' called on unallocated object '_til_str_lits'". The literal assign
// repoints the local's WRAPPER at static storage, so the clone-elision move
// path (whose `free(local)` assumes a heap wrapper) must not fire for it. A
// literal DECL stays safe: such a local is static/stack from the start. The
// same code at function top level always worked; both nesting forms below
// (bare block and `if` body) reproduced it.
test_nested_block_literal_reassign_move := test() {
    s := "abc"
    mut out := ""
    {
        mut t := s
        t = "zz"
        out = t
    }
    assert_eq(Str, out, "zz")
    assert_eq(Str, s, "abc")
}

test_if_body_literal_reassign_move := test() {
    s := "abc"
    mut out := ""
    if true {
        mut t := s
        t = "zz"
        out = t
    }
    assert_eq(Str, out, "zz")
}

// Passing a Str to a C `char *` parameter: a VIEW (substr/trim) has no
// NUL at count, so `view.c_str` would pass C the view's bytes plus
// whatever follows. clone() is the fix -- an owned Str always carries the
// terminator. from_c_str walks to the NUL, so round-tripping through it
// proves the terminator is where C expects it. See doc/ffi.org, "Passing
// a Str to a C string parameter".
test_clone_terminates_views := test() {
    backed := "abcdefZZZ"
    // A CAP_VIEW into backed on both backends since #366, so both runs
    // exercise the unterminated case: c_str[6] is 'Z', not a NUL.
    view := backed.substr(0, 6)

    // BIND the clone, never chain: `view.clone().c_str` reads the field of
    // a temporary the garbager frees at that same last use, so the pointer
    // dangles by the time C sees it (compiled only -- the interpreter keeps
    // the temporary alive, so the chained form passes there and fails in
    // the binary).
    c := view.clone()
    assert_eq(Str, Str.from_c_str(c.c_str), "abcdef")
    // The backing buffer is untouched by the copy.
    assert_eq(Str, backed, "abcdefZZZ")

    // Literals already carry the NUL, so they need no copy.
    assert_eq(Str, Str.from_c_str("literal".c_str), "literal")
}

/// #391: the two spellings that carry `Str.c_str`'s ADDRESS into a local.
/// Binding it by value is a typer error (test/typer_errors.til pins that);
/// these are the fixes the diagnostic names, and both must keep agreeing
/// across the backends -- the value form was accepted by the typer, ran
/// correctly interpreted, and failed at `cc` with `I8 a = s.c_str;`.
test_pointer_field_spellings := test() {
    lit := "hello"
    s := lit.clone()

    // `ref`: borrow the pointer. The holder still owns the buffer.
    ref borrowed : I8 = s.c_str
    assert_eq(USize, c_str_len(borrowed), 5)
    assert(borrowed.ptr_eq(s.c_str))

    // `Dynamic`: the raw address, which is what a `void *` already is.
    raw : Dynamic = s.c_str
    assert_eq(USize, c_str_len(raw), 5)
    assert(raw.ptr_eq(s.c_str))

    // Unchanged by all of this: the field feeding a call directly.
    assert_eq(USize, c_str_len(s.c_str), 5)
    assert_eq(Str, s, "hello")
}

test_borrowed_view := test() {
    s := format("bor", "rowed")
    v := s.borrowed_view()
    assert_eq(Str, v, "borrowed")
    assert_eq(USize, v.len(), s.len())

    // Byte sharing IS a cross-mode property since #366 -- true of substr
    // and from_c_str too, not just this method. Before it, the interpreter
    // copied a Str returned by value out of a til function, so this
    // assertion would have failed interpreted and passed compiled.
    assert(v.c_str.ptr_eq(s.c_str))

    // Whole-string view == substr over the whole range, and an empty
    // string views as empty.
    assert_eq(Str, v, s.substr(0, s.len()))
    assert_eq(USize, "".borrowed_view().len(), 0)

    // Views compare and search like any other Str: nothing downstream
    // needs to know the bytes are borrowed.
    assert(v.starts_with("bor"))
    assert(v.eq(s))
    assert_eq(I64, v.find("rowed"), 3)
    assert_eq(Str, v.substr(3, 5), "rowed")

    // Dropping the view leaves the source intact -- delete frees neither
    // the shared bytes nor a buffer it never owned.
    Str.delete(own v.clone(), true)
    assert_eq(Str, s, "borrowed")
}

// #372: returning a view is LEGAL whenever the storage it borrows outlives
// the call, and the typer must not reject those. Only a view of an OWNED
// local dangles (that rejection is pinned in test/typer_errors.til); these
// four shapes are the ones that must keep compiling, on both backends.
str372_param_view := func(s: Str) returns Str { return s.substr(0, 3) }

str372_param_chain := func(s: Str) returns Str { return s.trim().substr(0, 2) }

// A local that is itself a view of a PARAM borrows the caller's storage,
// so a view of it is fine -- the check follows the chain to its base
// instead of stopping at the intermediate local.
str372_view_of_param_local := func(s: Str) returns Str {
    v := s.borrowed_view()
    return v.substr(0, 2)
}

// Cloning breaks the sharing, so an owned local's substr may be returned
// once it has been copied out.
str372_cloned_local := func(n: USize) returns Str {
    base := format("abcdef", n.to_str())
    return base.substr(0, 3).clone()
}

test_view_return_legal_shapes := test() {
    assert_eq(Str, str372_param_view("abcdef"), "abc")
    assert_eq(Str, str372_param_chain("  xy  "), "xy")
    assert_eq(Str, str372_view_of_param_local("relayed"), "re")
    assert_eq(Str, str372_cloned_local(1), "abc")
    // A literal receiver is static storage, so its view outlives anything.
    assert_eq(Str, "static".substr(0, 3), "sta")
}

test_borrowed_view_in_container := test() {
    // The case this exists for: a set of names borrowed from strings that
    // outlive it. Teardown frees the set's boxes, not the shared bytes.
    owner := format("na", "me")
    mut names := Set(Str).new()
    names.add(own owner.borrowed_view())
    assert(names.has("name"))
    assert_eq(USize, names.len(), 1)
    names.clear()
    assert_eq(Str, owner, "name")
}

test_own_arg_literal_tagged_local := test() {
    // A stack local still carrying the CAP_LIT tag at runtime, passed to
    // an own param. The builder heap-boxes the value, and the callee's
    // box release exempts CAP_LIT (that exemption is for true static
    // literal args, passed unboxed) -- so the box leaked 16 bytes per
    // call until the wrap learned the LIT -> VIEW retag the own-return
    // box path already used. ASAN (the suite's test build) pins it.
    mut v := Vec(Str).new()
    v.push(own "lit")
    mut s := ""
    v.push(own s)
    assert_eq(USize, v.len(), 2)
    assert_eq(Str, v[0], "lit")
    assert_eq(Str, v[1], "")
}
