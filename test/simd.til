mode test

F4 := Simd(F32, 4)
F2 := Simd(F32, 2)
I4 := Simd(I32, 4)
SIMD_TEST_WIDTH : I64 = 2 * 2
I4Alias := Simd(I32, SIMD_TEST_WIDTH)
NativeF := Simd(F32, simd_width(F32))
I1 := Simd(I64, 1)
F8 := Simd(F32, 8)
I32x32 := Simd(I32, 32)
F64x16 := Simd(F64, 16)

// An ordinary constructor whose name resembles the intrinsic dispatch names.
Simd__ordinary_add := struct { value: I64 = 0 }

test_simd_dispatch_identity := test() {
    value := Simd__ordinary_add(value = 7)
    assert_eq(I64, value.value, 7)
}

test_simd_arithmetic := test() {
    a := F4.new(1.0, 2.0, 3.0, 4.0)
    b := F4.splat(10.0)
    c := a + b
    assert_eq(F32, c[0], 11.0)
    assert_eq(F32, c[3], 14.0)
    assert_eq(F32, a.reduce_add(), 10.0)
    assert((a == a).all())
    assert((a == b).any().not())
}

FMA_F32_FOLDED : F32 = F32.fma(1.00000011920928955078125, 0.99999988079071044921875, -1.0)
FMA_F64_FOLDED : F64 = F64.fma(1.0000000000000002, 0.9999999999999998, -1.0)

fma_runtime := proc(T: Type, a: T, b: T, c: T) returns T {
    noop_proc()
    return a.fma(b, c)
}

simd_fma_rounding := proc(T: Type, V: Type, delta: T, shape: V) {
    noop_proc()
    one := T.from_i64(1)
    a := one + delta
    b := one - delta
    c := T.from_i64(-1)
    expected := c * delta * delta
    assert_eq(T, fma_runtime(T, a, b, c), expected)
    assert_eq(T, a * b + c, T.from_i64(0))
    mut x := V.splat(a)
    mut y := V.splat(b)
    mut z := V.splat(c)
    fused := x.fma(y, z)
    assert(fused.eq(V.splat(expected)).all())
    assert((x * y + z).eq(V.zero()).all())
    // A distinct last lane catches truncation/chunk-boundary mistakes.
    last := shape.len() - 1
    x.set(last, own T.from_i64(2))!
    y.set(last, own T.from_i64(3))!
    z.set(last, own T.from_i64(4))!
    mixed := x.fma(y, z)
    for i in 0..last { assert_eq(T, mixed[i], expected) }
    assert_eq(T, mixed[last], T.from_i64(10))
    // The exact product overflows the format, but the fused result does not.
    cancelled := V.splat(T.MAX).fma(V.splat(T.from_i64(2)), V.splat(c * T.MAX))
    assert(cancelled.eq(V.splat(T.MAX)).all())
}

test_fma_rounding := test() {
    delta32 : F32 = 1.1920928955078125e-7
    delta64 : F64 = 2.220446049250313e-16
    assert_eq(F32, FMA_F32_FOLDED, delta32 * delta32 * F32.from_i64(-1))
    assert_eq(F64, FMA_F64_FOLDED, -1.0 * delta64 * delta64)
    simd_fma_rounding(F32, F4, delta32, F4.zero())
    simd_fma_rounding(F32, Simd(F32, 32), delta32, Simd(F32, 32).zero())
    simd_fma_rounding(F64, Simd(F64, 1), delta64, Simd(F64, 1).zero())
    simd_fma_rounding(F64, F64x16, delta64, F64x16.zero())
}

test_fma_special_values := test() {
    tiny32 := "1.401298464324817e-45".to_f32()
    tiny64 := "4.9406564584124654e-324".to_f64()
    assert_eq(F32, fma_runtime(F32, tiny32, 0.5, tiny32), tiny32 + tiny32)
    assert_eq(F64, fma_runtime(F64, tiny64, 0.5, tiny64), tiny64 + tiny64)
    assert_eq(Str, fma_runtime(F32, -0.0, 2.0, -0.0).to_repr(), "-0")
    assert_eq(Str, fma_runtime(F64, -0.0, 2.0, 0.0).to_repr(), "0")
    inf32 := "inf".to_f32()
    inf64 := "inf".to_f64()
    invalid32 := fma_runtime(F32, inf32, 0.0, 1.0)
    invalid64 := fma_runtime(F64, inf64, 1.0, 0.0 - inf64)
    assert(invalid32.neq(invalid32))
    assert(invalid64.neq(invalid64))
    propagated := fma_runtime(F64, 2.0, 3.0, "nan".to_f64())
    assert(propagated.neq(propagated))
    lanes := F4.new(tiny32, -0.0, inf32, inf32).fma(
        F4.new(0.5, 2.0, 2.0, 0.0), F4.new(tiny32, -0.0, 1.0, 1.0))
    assert_eq(F32, lanes[0], tiny32 + tiny32)
    assert_eq(Str, lanes[1].to_repr(), "-0")
    assert_eq(Str, lanes[2].to_repr(), "inf")
    assert(lanes[3].neq(lanes[3]))
}

fma_counted := proc(mut calls: I64, digit: I64) returns F32 {
    noop_proc()
    calls = calls * 10 + digit
    return digit.to_f32()
}

fma_vector_counted := proc(mut calls: I64, digit: I64) returns F4 {
    return F4.splat(fma_counted(calls, digit))
}

fma_replace_source := proc(mut source: F4) returns F4 {
    noop_proc()
    source = F4.splat(99.0)
    return F4.splat(3.0)
}

fma_replace_scalar := proc(mut source: F32) returns F32 {
    noop_proc()
    source = 99.0
    return 3.0
}

test_fma_evaluation_order := test() {
    mut calls : I64 = 0
    value := fma_counted(calls, 2).fma(fma_counted(calls, 3), fma_counted(calls, 4))
    assert_eq(I64, calls, 234)
    assert_eq(F32, value, 10.0)
    calls = 0
    vector := fma_vector_counted(calls, 2).fma(fma_vector_counted(calls, 3), fma_vector_counted(calls, 4))
    assert_eq(I64, calls, 234)
    assert(vector.eq(F4.splat(10.0)).all())
    mut source := F4.splat(2.0)
    snapshot := source.fma(fma_replace_source(source), F4.splat(4.0))
    assert(snapshot.eq(F4.splat(10.0)).all())
    assert(source.eq(F4.splat(99.0)).all())
    mut scalar : F32 = 2.0
    scalar_snapshot := scalar.fma(fma_replace_scalar(scalar), 4.0)
    assert_eq(F32, scalar_snapshot, 10.0)
    assert_eq(F32, scalar, 99.0)
    mut values := array(F4, F4.splat(2.0))
    borrowed_snapshot := values.unsafe_get(0).fma(fma_replace_source(values.unsafe_get(0)), F4.splat(4.0))
    assert(borrowed_snapshot.eq(F4.splat(10.0)).all())
    assert(values[0].eq(F4.splat(99.0)).all())
}

test_simd_argument_snapshots := test() {
    mut source := F4.splat(2.0)
    sum := source + fma_replace_source(source)
    assert(sum.eq(F4.splat(5.0)).all())
    source = F4.splat(2.0)
    mask := source.eq(source)
    selected := mask.select(source, fma_replace_source(source))
    assert(selected.eq(F4.splat(2.0)).all())
    assert(source.eq(F4.splat(99.0)).all())
}

test_simd_masks := test() {
    a := I4.new(1, 5, 3, 8)
    b := I4.new(2, 4, 3, 9)
    mask := a < b
    assert(mask[0])
    assert(mask[1].not())
    assert(mask[2].not())
    assert(mask[3])
    assert(mask.any())
    assert(mask.all().not())
    assert(a.eq(b).any())
    assert(a.neq(b).all().not())
}

test_simd_copy := test() {
    a := I4.new(1, 2, 3, 4)
    mut b := a
    b[0] = 9
    assert_eq(I32, a[0], 1)
    assert_eq(I32, b[0], 9)
}

test_simd_selection := test() {
    a := F4.new(-2.0, 3.0, -1.0, 4.0)
    zero := F4.zero()
    positive := a > zero
    clipped := positive.select(a, zero)
    assert_eq(F32, clipped.reduce_add(), 7.0)
    assert(positive.bnot().any())
    assert((positive | positive.bnot()).all())
}

simd_select_bits := proc(T: Type, V: Type, M: Type, B: Type,
    bits: Array(B), shape: V, mask_shape: M) {
    noop_proc()
    assert_eq(USize, T.size(), B.size())
    width := shape.len()
    bytes := T.size().to_uptr()
    mut a := Array(T).new(width)
    mut b := Array(T).new(width)
    mut output := Array(T).new(width)
    for i in 0..width {
        memcpy(ptr_add(a.data, i.to_uptr() * bytes),
            ptr_add(bits.data, (i % bits.len()).to_uptr() * bytes), bytes)
        memcpy(ptr_add(b.data, i.to_uptr() * bytes),
            ptr_add(bits.data, ((i + 1) % bits.len()).to_uptr() * bytes), bytes)
    }
    x := V.load(a, 0)!
    y := V.load(b, 0)!
    // Independent runtime masks, including all-false/all-true and patterns
    // crossing register boundaries. Compare bytes, not floating equality.
    for pattern in 0..5 {
        mut mask := mask_shape
        for i in 0..width {
            mask.set(i, own (pattern == 1 || (pattern > 1 && i % 3 == (pattern - 2).to_usize())))!
        }
        selected := mask.select(x, y)
        selected.store(output, 0)!
        for i in 0..width {
            if mask[i] {
                assert_eq(I32, memcmp(ptr_add(output.data, i.to_uptr() * bytes), ptr_add(a.data, i.to_uptr() * bytes), bytes), 0)
            } else {
                assert_eq(I32, memcmp(ptr_add(output.data, i.to_uptr() * bytes), ptr_add(b.data, i.to_uptr() * bytes), bytes), 0)
            }
        }
    }
}

test_simd_select_float_bits := test() {
    f32bits := array(U32, 0x80000000, 0x7f800001, 0x7fc12345, 0xff800000,
        0x7f800000, 1, 0x7f7fffff, 0)
    f64bits := array(U64, 0x8000000000000000, 0x7ff0000000000001,
        0x7ff8123456789abc, 0xfff0000000000000,
        0x7ff0000000000000, 1, 0x7fefffffffffffff, 0)
    simd_select_bits(F32, F4, Simd(Bool, 4), U32, f32bits, F4.zero(), Simd(Bool, 4).zero())
    simd_select_bits(F32, Simd(F32, 32), Simd(Bool, 32), U32, f32bits,
        Simd(F32, 32).zero(), Simd(Bool, 32).zero())
    simd_select_bits(F64, Simd(F64, 1), Simd(Bool, 1), U64, f64bits,
        Simd(F64, 1).zero(), Simd(Bool, 1).zero())
    simd_select_bits(F64, F64x16, Simd(Bool, 16), U64, f64bits, F64x16.zero(), Simd(Bool, 16).zero())
}

test_simd_select_integer_bits := test() {
    simd_select_bits(I8, Simd(I8, 32), Simd(Bool, 32), U8, array(U8, 0, 255, 128, 1),
        Simd(I8, 32).zero(), Simd(Bool, 32).zero())
    simd_select_bits(U16, Simd(U16, 16), Simd(Bool, 16), U16, array(U16, 0, 65535, 32768, 1),
        Simd(U16, 16).zero(), Simd(Bool, 16).zero())
    simd_select_bits(I32, I32x32, Simd(Bool, 32), U32, array(U32, 0, U32.MAX, 0x80000000, 1),
        I32x32.zero(), Simd(Bool, 32).zero())
    simd_select_bits(U64, Simd(U64, 16), Simd(Bool, 16), U64, array(U64, 0, U64.MAX, 0x8000000000000000, 1),
        Simd(U64, 16).zero(), Simd(Bool, 16).zero())
    simd_select_bits(Bool, Simd(Bool, 32), Simd(Bool, 32), Bool, array(Bool, false, true),
        Simd(Bool, 32).zero(), Simd(Bool, 32).zero())
}

test_simd_memory := test() {
    mut values := array(I32, 10, 20, 30, 40, 50, 60)
    v := I4.load(values, 1)!
    assert_eq(I32, v[0], 20)
    assert_eq(I32, v[3], 50)
    v.store(values, 2)!
    assert_eq(I32, values[2], 20)
    assert_eq(I32, values[5], 50)
}

// Runtime calls keep the byte-copy path under test instead of folding the
// entire round trip. Test scalar alignment, guard elements and copy isolation.
simd_memory_roundtrip := proc(T: Type, V: Type, value: T, sentinel: T, shape: V) {
    noop_proc()
    width := shape.len()
    mut source := Array(T).new(width + 2)
    mut output := Array(T).new(width + 2)
    for i in 0..(width + 2) {
        source.set(i, own sentinel.clone())!
        output.set(i, own sentinel.clone())!
    }
    for i in 1..(width + 1) { source.set(i, own value.clone())! }
    loaded := V.load(source, 1)!
    source.set(1, own sentinel.clone())!
    assert(loaded.eq(V.splat(value)).all())
    loaded.store(output, 1)!
    assert_eq(T, output[0], sentinel)
    assert_eq(T, output[width + 1], sentinel)
    for i in 1..(width + 1) { assert_eq(T, output[i], value) }
    output.set(1, own sentinel.clone())!
    assert_eq(T, loaded[0], value)
}

test_simd_memory_lane_sizes := test() {
    simd_memory_roundtrip(I8, Simd(I8, 16), -7, 3, Simd(I8, 16).zero())
    simd_memory_roundtrip(U8, Simd(U8, 32), 251, 3, Simd(U8, 32).zero())
    simd_memory_roundtrip(I16, Simd(I16, 4), -1234, 3, Simd(I16, 4).zero())
    simd_memory_roundtrip(U16, Simd(U16, 8), 60000, 3, Simd(U16, 8).zero())
    simd_memory_roundtrip(I32, I4, -123456, 3, I4.zero())
    simd_memory_roundtrip(U32, Simd(U32, 8), 4000000000, 3, Simd(U32, 8).zero())
    simd_memory_roundtrip(U32, Simd(U32, 16), 4000000000, 3, Simd(U32, 16).zero())
    simd_memory_roundtrip(I64, I1, I64.MIN, 3, I1.zero())
    simd_memory_roundtrip(U64, Simd(U64, 4), U64.MAX, 3, Simd(U64, 4).zero())
    simd_memory_roundtrip(F32, F8, -1.25, 3.0, F8.zero())
    simd_memory_roundtrip(F64, Simd(F64, 2), -1.25, 3.0, Simd(F64, 2).zero())
    simd_memory_roundtrip(Bool, Simd(Bool, 16), true, false, Simd(Bool, 16).zero())
    assert_eq(I16, Simd(I16, 4).splat(-1234).bnot()[0], 1233)
    assert_eq(U16, Simd(U16, 8).splat(60000).bnot()[0], 5535)
}

test_simd_memory_bounds_matrix := test() {
    for count in array(USize, 0, 1, 3, 4, 5, 17) {
        mut values := Array(I32).new(count)
        for start in array(USize, 0, 1, count, USize.MAX) {
            for i in 0..count { values.set(i, own 7)! }
            mut valid := start <= count
            if valid { valid = count - start >= 4 }
            mut load_failed := false
            _loaded := I4.load(values, start)?
            catch (err: OutOfBounds) { load_failed = true }
            assert_eq(Bool, load_failed, valid.not())
            mut store_failed := false
            I4.splat(9).store(values, start)?
            catch (err: OutOfBounds) { store_failed = true }
            assert_eq(Bool, store_failed, valid.not())
            for i in 0..count {
                mut expected : I32 = 7
                if valid.and(i >= start).and(i - start < 4) { expected = 9 }
                assert_eq(I32, values[i], expected)
            }
        }
    }
    values := array(I32, 1, 2, 3, 4, 5, 6)
    end := I4.load(values, 2)!
    assert(end.eq(I4.new(3, 4, 5, 6)).all())
}

simd_memory_word := proc(value: U32) returns U32 {
    noop_proc()
    return value
}

test_simd_memory_float_bits := test() {
    bits := array(U32, simd_memory_word(0x80000000), simd_memory_word(0x7fc12345),
        simd_memory_word(0xff800000), simd_memory_word(0x3f800000))
    mut values := array(F32, 13.0, 0.0, 0.0, 0.0, 0.0, 13.0)
    mut output := array(F32, 13.0, 0.0, 0.0, 0.0, 0.0, 13.0)
    memcpy(ptr_add(values.data, 4), bits.data, 16)
    loaded := F4.load(values, 1)!
    loaded.store(output, 1)!
    assert_eq(I32, memcmp(ptr_add(output.data, 4), bits.data, 16), 0)
    assert_eq(F32, output[0], 13.0)
    assert_eq(F32, output[5], 13.0)
}

test_simd_memory_wide_float_bits := test() {
    // Bit copies must not quiet signaling NaNs or normalize negative zero.
    bits := array(U64, 0x8000000000000000, 0x7ff0000000000001,
        0x7ff8123456789abc, 0xfff0000000000000,
        0x7ff0000000000000, 1, 0x7fefffffffffffff, 0)
    mut values := Array(F64).new(18)
    mut output := Array(F64).new(18)
    for i in 0..values.len() {
        values.set(i, own 13.0)!
        output.set(i, own 13.0)!
    }
    memcpy(ptr_add(values.data, 8), bits.data, 64)
    memcpy(ptr_add(values.data, 72), bits.data, 64)
    loaded := F64x16.load(values, 1)!
    loaded.store(output, 1)!
    assert_eq(I32, memcmp(ptr_add(output.data, 8), bits.data, 64), 0)
    assert_eq(I32, memcmp(ptr_add(output.data, 72), bits.data, 64), 0)
    assert_eq(F64, output[0], 13.0)
    assert_eq(F64, output[17], 13.0)
}

simd_memory_source := proc(mut calls: I64) returns Array(I32) {
    noop_proc()
    calls++
    return array(I32, 10, 20, 30, 40, 50, 60)
}

simd_memory_start := proc(mut calls: I64, start: USize) returns USize {
    noop_proc()
    calls++
    return start
}

test_simd_memory_argument_evaluation := test() {
    mut calls := 0
    loaded := I4.load(simd_memory_source(calls), simd_memory_start(calls, 1))!
    assert_eq(I64, calls, 2)
    assert(loaded.eq(I4.new(20, 30, 40, 50)).all())
    mut output := array(I32, 7, 7, 7, 7, 7, 7)
    simd_counted(calls, 9).store(output, simd_memory_start(calls, 1))!
    assert_eq(I64, calls, 4)
    mut caught := false
    simd_counted(calls, 13).store(output, simd_memory_start(calls, USize.MAX))?
    catch (err: OutOfBounds) { caught = true }
    assert(caught)
    assert_eq(I64, calls, 6)
    assert(I4.load(output, 1)!.eq(I4.splat(9)).all())
    assert_eq(I32, output[0], 7)
    assert_eq(I32, output[5], 7)
}

// A borrowed vector view still passes its VALUE to store. Overlapping scalar
// storage must therefore observe the complete source snapshot in both modes.
test_simd_memory_overlapping_source := test() {
    mut values := array(I32, 1, 2, 3, 4, 5, 6)
    ref prefix : I4 = ptr_add(values.data, 0)
    prefix.store(values, 1)!
    assert(I4.load(values, 1)!.eq(I4.new(1, 2, 3, 4)).all())
    assert_eq(I32, values[0], 1)
    assert_eq(I32, values[5], 6)
    ref middle : I4 = ptr_add(values.data, 4)
    middle.store(values, 0)!
    assert(I4.load(values, 0)!.eq(I4.new(1, 2, 3, 4)).all())
    assert_eq(I32, values[4], 4)
    assert_eq(I32, values[5], 6)
}

simd_memory_snapshot := func(value: I4, mut storage: Array(I32)) returns I32 {
    storage.set(0, own 99)!
    return value[0]
}

simd_memory_view := func(storage: Array(I32)) returns ref I4 {
    return ptr_add(storage.data, 0)
}

test_simd_memory_parameter_snapshot := test() {
    mut values := array(I32, 1, 2, 3, 4)
    ref view : I4 = ptr_add(values.data, 0)
    assert_eq(I32, simd_memory_snapshot(view, values), 1)
    assert_eq(I32, values[0], 99)
    values.set(0, own 7)!
    assert_eq(I32, simd_memory_snapshot(simd_memory_view(values), values), 7)
    assert_eq(I32, values[0], 99)
}

test_simd_memory_c_temporary_names := test() {
    mut til_simd_values := Array(I32).new(34)
    for i in 0..til_simd_values.len() { til_simd_values.set(i, own i.to_i32())! }
    til_simd_start : USize = 1
    til_simd_value := I32x32.load(til_simd_values, til_simd_start)!
    til_simd_value.store(til_simd_values, 2)!
    assert(I32x32.load(til_simd_values, 2)!.eq(til_simd_value).all())
    assert_eq(I32, til_simd_values[0], 0)
    assert_eq(I32, til_simd_values[33], 32)
    for start in array(USize, 3, 34, USize.MAX) {
        mut load_failed := false
        _invalid := I32x32.load(til_simd_values, start)?
        catch (err: OutOfBounds) { load_failed = true }
        assert(load_failed)
        mut store_failed := false
        I32x32.splat(99).store(til_simd_values, start)?
        catch (err: OutOfBounds) { store_failed = true }
        assert(store_failed)
        assert(I32x32.load(til_simd_values, 2)!.eq(til_simd_value).all())
        assert_eq(I32, til_simd_values[0], 0)
    }
}

test_simd_wide_integer_chunks := test() {
    lanes : USize = 32
    mut lhs := Array(I32).new(34)
    mut rhs := Array(I32).new(34)
    for i in 0..34 {
        lhs.set(i, own i.to_i32() - 17)!
        rhs.set(i, own I32.MAX - i.to_i32())!
        if i.mod(3) == 0 { rhs.set(i, own -40)! }
    }
    a := I32x32.load(lhs, 1)!
    b := I32x32.load(rhs, 1)!
    sum := a + b
    difference := a - b
    product := a * b
    bits := a.bxor(b)
    mask := a < b
    selected := mask.select(a, b)
    for i in 0..lanes {
        ref l : I32 = lhs[i + 1]
        ref r : I32 = rhs[i + 1]
        assert_eq(I32, sum[i], l.cast(U32).add(r.cast(U32)).cast(I32))
        assert_eq(I32, difference[i], l.cast(U32).sub(r.cast(U32)).cast(I32))
        assert_eq(I32, product[i], l.cast(U32).mul(r.cast(U32)).cast(I32))
        assert_eq(I32, bits[i], l.bxor(r))
        assert_eq(Bool, mask[i], l < r)
        if l < r { assert_eq(I32, selected[i], l) }
        else { assert_eq(I32, selected[i], r) }
    }
}

test_simd_wide_float_chunks := test() {
    lanes : USize = 16
    mut lhs := Array(F64).new(18)
    mut rhs := Array(F64).new(18)
    for i in 0..18 {
        lhs.set(i, own i.to_f64() * 1.25)!
        rhs.set(i, own (18 - i).to_f64())!
    }
    lhs.set(9, own "nan".to_f64())!
    a := F64x16.load(lhs, 1)!
    b := F64x16.load(rhs, 1)!
    sum := a + b
    mask := a < b
    for i in 0..lanes {
        ref l : F64 = lhs[i + 1]
        ref r : F64 = rhs[i + 1]
        if i == 8 { assert(sum[i].neq(sum[i])) }
        else { assert_eq(F64, sum[i], l + r) }
        assert_eq(Bool, mask[i], l < r)
    }
}

test_simd_matrix := test() {
    a0 := F2.new(1.0, 2.0)
    a1 := F2.new(3.0, 4.0)
    b0 := F2.new(5.0, 6.0)
    b1 := F2.new(7.0, 8.0)
    c0 := F2.splat(a0[0]) * b0 + F2.splat(a0[1]) * b1
    c1 := F2.splat(a1[0]) * b0 + F2.splat(a1[1]) * b1
    assert_eq(F32, c0[0], 19.0)
    assert_eq(F32, c0[1], 22.0)
    assert_eq(F32, c1[0], 43.0)
    assert_eq(F32, c1[1], 50.0)
}

test_simd_width_and_reductions := test() {
    a := I4Alias.new(4, -3, 9, 2)
    b := I4.splat(1)
    c := a + b
    assert_eq(I32, c.reduce_min(), -2)
    assert_eq(I32, c.reduce_max(), 10)
    assert_eq(USize, NativeF.zero().len(), simd_width(F32))
    f := F4.new(8.0, -5.0, 2.0, 6.0)
    assert_eq(F32, f.reduce_min(), -5.0)
    assert_eq(F32, f.reduce_max(), 8.0)
}

test_simd_container := test() {
    mut vectors := Vec(Simd(I32, 4)).new()
    original := I4.new(1, 2, 3, 4)
    vectors.push(own original)
    mut copy := vectors[0].clone()
    copy[2] = 99
    assert_eq(I32, vectors[0].get(2)!, 3)
    assert_eq(I32, copy[2], 99)
}

test_simd_conversion := test() {
    a := I4.new(-1, 2, -3, 4)
    wide := a.cast(I64)
    assert_eq(I64, wide[0], -1)
    assert_eq(I64, wide[2], -3)
    f := F4.new(1.5, 2.5, 3.5, 4.5)
    lanes64 := f.cast(F64)
    assert_eq(F64, lanes64[0], 1.5)
    assert_eq(F64, lanes64.reduce_add(), 12.0)
    single := lanes64.cast(F32)
    assert(single.eq(f).all())
}

test_simd_integer_edges := test() {
    max := I1.splat(I64.MAX)
    one := I1.splat(1)
    wrapped := max + one
    assert_eq(I64, wrapped[0], I64.MIN)
    quotient := wrapped / I1.splat(-1)
    assert_eq(I64, quotient[0], I64.MIN)
    zero_divisor := max / I1.zero()
    assert_eq(I64, zero_divisor[0], 0)
    assert((max == max).all())
    assert_eq(USize, (max == max).len(), 1)
    wide := F8.splat(3.0) * F8.splat(2.0)
    assert_eq(F32, wide.reduce_add(), 48.0)
}

test_simd_float_edges := test() {
    ordered := F4.new(100000000000000000000.0, 1.0, -100000000000000000000.0, 1.0)
    assert_eq(F32, ordered.reduce_add(), 2.0)
    zeros := F4.new(0.0, -0.0, 0.0, -0.0)
    assert_eq(Str, zeros.reduce_min().to_repr(), "-0")
    assert_eq(Str, zeros.reduce_max().to_repr(), "0")
    nan := "nan".to_f32()
    values := F4.new(nan, 1.0, 2.0, 3.0)
    assert(values.eq(values)[0].not())
    assert(values.neq(values)[0])
    assert(values.lt(values)[0].not())
    minimum := values.reduce_min()
    assert(minimum.neq(minimum))
    nan64 := values.cast(F64)
    assert(nan64.eq(nan64)[0].not())
    assert(nan64.neq(nan64)[0])
}

test_simd_bounds := test() {
    mut values := array(I32, 1, 2, 3, 4, 5)
    v := I4.splat(9)
    mut caught := false
    v.store(values, 2)?
    catch (err: OutOfBounds) { caught = true }
    assert(caught)
    assert_eq(I32, values[2], 3)
    caught = false
    _loaded := I4.load(values, USize.MAX)?
    catch (err: OutOfBounds) { caught = true }
    assert(caught)
    caught = false
    _lane := v.get(4)?
    catch (err: OutOfBounds) { caught = true }
    assert(caught)
}

simd_counted := proc(mut calls: I64, value: I32) returns I4 {
    noop_proc()
    calls++
    return I4.splat(value)
}

test_simd_select_eager := test() {
    mut calls := 0
    mask := I4.splat(1) == I4.splat(1)
    selected := mask.select(simd_counted(calls, 7), simd_counted(calls, 8))
    assert_eq(I64, calls, 2)
    assert_eq(I32, selected[3], 7)
}

simd_runtime_float := proc(value: F4) returns F4 {
    noop_proc()
    return value
}

test_simd_ieee_division := test() {
    numerator := simd_runtime_float(F4.new(1.0, 1.0, -1.0, 0.0))
    denominator := simd_runtime_float(F4.new(0.0, -0.0, 0.0, 0.0))
    result := numerator / denominator
    assert_eq(Str, result[0].to_repr(), "inf")
    assert_eq(Str, result[1].to_repr(), "-inf")
    assert_eq(Str, result[2].to_repr(), "-inf")
    assert(result.neq(result)[3])
    result64 := numerator.cast(F64) / denominator.cast(F64)
    assert_eq(Str, result64[0].to_repr(), "inf")
    assert_eq(Str, result64[1].to_repr(), "-inf")
    assert_eq(Str, result64[2].to_repr(), "-inf")
    assert(result64.neq(result64)[3])
}
