mode cli

import("../src/std/sys")
import("../src/std/file")
import("../src/self/targets")
import("../test/jni_support")

// CI comparison of what different producers make of the same source
// (issue #473, decisions 2 and 3; issue #472, levels 1 and 2 across hosts).
//
//   ci_collect produce <producer> <list file> <compiler>
//       Run the compiler over the corpus and write a HASH LIST: one line
//       per compared item,
//           <sha256> <level> <target> <backend> <width> <case> <item>
//       level "frontend": what the compiler holds at each phase boundary
//       (`til ast --phase=...`), for target linux-x64 at width 32, hashed
//       per source unit so a difference names the phase and the file. Read
//       as text: a Windows host's CR LF line ends count as LF.
//       level "source": the files a translate emits, a library's bindings
//       included, for every target at both widths, without the reuse stamp
//       line (which names the compiler binary). A program a target refuses
//       is listed as "refused", so producers have to refuse alike.
//
//   ci_collect produce-binary <producer> <list file> <compiler> <target>...
//       Level "binary" (#472 level 3): build two programs and a library for
//       each target and list the hash of every artifact (executables, the
//       static archive, its object, the shared library), plus one
//       "toolchain" item per target: the hash of the version lines of the
//       compiler, linker, archiver and debug-symbol tool that built it.
//       What has to agree is the binaries, from every host, whatever
//       toolchain each used (the toolchain rule, end of
//       issues/open/472.org); the toolchain item is listed at level
//       "binary-trial" only, so that different toolchains show up next to
//       any difference they explain and never fail by themselves. Also at
//       "binary-trial": every artifact of a target not yet shown equal.
//       Android's proven native artifacts use "binary"; SDK producers list
//       the aligned unsigned APK and its native library in a separate "apk"
//       group, so SDK-less hosts do not participate in that comparison.
//
//   ci_collect produce-binary-trial <producer> <list file> <compiler> <target>...
//       The same list with binary/APK lines at "binary-trial"/"apk-trial": for a host whose
//       build of a target is not (yet) the other hosts'.
//
//   ci_collect collect <directory> [report]
//       Read every *.txt hash list under the directory; the file's name is
//       the producer's. Items are compared between the producers that
//       took part in the same level, target, backend and width; a
//       "binary-trial" line is compared with the "binary" lines of the same
//       item (they are one level, on trial or not). Prints what differs,
//       what a producer left out, and what only one producer has (which is
//       not compared, never "equal"). A difference that any trial line is
//       part of is printed and does not fail, nor does an item missing
//       from a producer with no strict line in the group: trial is for
//       artifacts, and producers, not yet shown equal. Exits 1 on a
//       difference, a missing item or a line it cannot read; with `report`
//       a difference or a missing item is printed but does not fail.
//
// The lists are all that travels between CI jobs. Nothing reads them back
// into a build.

WORK := "tmp/ci_collect"

Entry := struct {
    producer := ""
    hash := ""
    group := ""
    item := ""
    // REM Listed at a "-trial" level: compared with the same level's
    // strict lines, but a difference it is part of never fails.
    trial := false
}

realpath_str := ext_proc(path: Str) returns Str {}

fail := proc(message: Str) {
    println("ci_collect: ", message)
    exit(1)
}

// The SHA-256 of each file, in order, from the host's own tool.
sha256_of := proc(paths: Vec(Str)) returns Vec(Str) {
    mut hashes := Vec(Str).new()
    if paths.len() == 0 { return hashes }
    mut tool := Cmd.new("sha256sum")
    if host_os() == "macos" { tool = Cmd.new("shasum", "-a", "256") }
    for path : Str in paths { tool.arg(path) }
    tool.capture()
    if tool.run() != 0 { fail(format("cannot hash: ", tool.err())) }
    for line : Str in tool.out().split("\n") {
        if line.len() < 64 { continue }
        hashes.push(own line.substr(0, 64).clone())
    }
    if hashes.len() != paths.len() { fail("the hash tool answered for fewer files than it was given") }
    return hashes
}

// The text without its trailing reuse stamp line (#442).
without_stamp := func(text: Str) returns Str {
    at := text.rfind("/* til-translation-stamp: ")
    if at < 0 { return text.clone() }
    start := at.to_usize()
    rest := text.substr(start, text.len() - start)
    if rest.find("\n") != rest.len().to_i64() - 1 { return text.clone() }
    return text.substr(0, start).clone()
}

file_stem := func(source: Str) returns Str {
    slash := source.rfind("/").to_usize()
    name := source.substr(slash + 1, source.len() - slash - 1)
    return name.strip_suffix(".til").clone()
}

// One observation, cut at its `unit` lines; each piece is an item.
produce_frontend := proc(compiler: Str, source: Str, phase: Str, mut lines: Vec(Str)) {
    observed := format(WORK, "/observed.txt")
    command := Cmd.new(compiler, "ast", format("--phase=", phase), "--target=linux-x64", "--usize=32", source)
    command.stdout_to(observed)
    command.stderr_to_stdout()
    if command.run() != 0 { fail(format(command.render(), " failed:\n", File.readfile(observed))) }
    // REM An observation is text on the compiler's standard output, and a
    // Windows process ends the lines it writes there with CR LF. The records
    // are compared, not the host's line ending. (The files a translate
    // writes are compared byte for byte below.)
    text := File.readfile(observed).replace("\r\n", "\n")
    mut names := Vec(Str).new()
    mut paths := Vec(Str).new()
    mut piece := 0
    mut rest := text.clone()
    mut name := "header"
    while true {
        next := rest.find("\nunit ")
        mut body := rest.clone()
        if next >= 0 { body = rest.substr(0, next.to_usize() + 1).clone() }
        path := format(WORK, "/piece_", piece.to_str())
        File.writefile(path, body)
        names.push(own name.clone())
        paths.push(own path)
        piece++
        if next < 0 { break }
        after := next.to_usize() + 1
        rest = rest.substr(after, rest.len() - after).clone()
        line_end := rest.find("\n")
        if line_end < 0 { fail("an observation ends inside a unit line") }
        name = rest.substr(5, line_end.to_usize() - 5).clone()
    }
    hashes := sha256_of(paths)
    for i, hash in hashes {
        lines.push(own format(hash, " frontend linux-x64 c 32 ", source, " ", phase, ":", names[i]))
    }
}

produce_source := proc(compiler: Str, source: Str, target: Str, width: Str, mut lines: Vec(Str)) {
    stem := file_stem(source)
    directory := format(WORK, "/source")
    File.remove_tree(directory)
    mkdir_p(directory)
    emitted := format(directory, "/", stem, ".c")
    command := Cmd.new(compiler, "translate", format("--target=", target), format("--usize=", width), "-c", emitted, source)
    command.stdout_to(format(WORK, "/translate.log"))
    command.stderr_to_stdout()
    key := format(" source ", target, " c ", width, " ", source, " ")
    if command.run() != 0 {
        lines.push(own format("refused", key, "-"))
        return
    }
    mut names := Vec(Str).new()
    mut paths := Vec(Str).new()
    for file : Str in array(Str, format(stem, ".c"), format(stem, "_forward.h")) {
        path := format(directory, "/", file)
        if File.is_file(path).not() { continue }
        stripped := format(path, ".compared")
        File.writefile(stripped, without_stamp(File.readfile(path)))
        names.push(own file.clone())
        paths.push(own stripped)
    }
    if paths.len() == 0 { fail(format(source, " for ", target, ": translated, but wrote no ", stem, ".c")) }
    // A library's translate also writes its bindings under gen/til/: the C
    // header, the til and Python bindings, the JNI bridge and the Java
    // class. Compared like its C, so that every host's jar carries one Java
    // class and one bridge source (#483). The log is read as text: a
    // Windows host ends its lines with CR LF.
    for line : Str in File.readfile(format(WORK, "/translate.log")).split("\n") {
        if line.starts_with("Generated: gen/til/").not() { continue }
        path := line.strip_prefix("Generated: ").trim()
        stripped := format(directory, "/binding_", names.len().to_str(), ".compared")
        File.writefile(stripped, without_stamp(File.readfile(path)))
        names.push(own path.strip_prefix("gen/til/").clone())
        paths.push(own stripped)
    }
    hashes := sha256_of(paths)
    for i, hash in hashes { lines.push(own format(hash, key, names[i])) }
}

// The first line of what `tool` prints for --version, or of `--help` style
// failure: the tool's identity, without the install directory the later
// lines of clang's output name.
version_line := proc(tool: Str) returns Str {
    command := Cmd.new(tool, "--version")
    command.capture()
    if command.run() != 0 { fail(format("cannot run ", tool, " --version: ", command.err())) }
    output := command.out()
    end := output.find("\n")
    // REM trim: a Windows tool ends its lines with CR LF, and the line is
    // compared with the other hosts' (CI run 3178, the windows-x64
    // toolchain item).
    if end < 0 { return output.trim().clone() }
    return output.substr(0, end.to_usize()).trim().clone()
}

// The first line `tool argument` prints on either stream (Apple's ld -v
// writes its version to stderr).
first_line_of := proc(tool: Str, argument: Str) returns Str {
    command := Cmd.new(tool, argument)
    command.capture()
    if command.run() != 0 { fail(format("cannot run ", tool, " ", argument, ": ", command.err())) }
    output := format(command.out(), command.err())
    end := output.find("\n")
    if end < 0 { return output.clone() }
    return output.substr(0, end.to_usize()).clone()
}

// What `tool` prints for one argument, trimmed.
tool_output := proc(tool: Str, argument: Str) returns Str {
    command := Cmd.new(tool, argument)
    command.capture()
    if command.run() != 0 { fail(format("cannot run ", tool, " ", argument, ": ", command.err())) }
    return command.out().trim().clone()
}

// #504: is this linux target built with its pinned C library, i.e. is that
// unpacked (bin/make vendor/linux/<target>)? til asks the same of the same
// directory (targets.til, linux_is_pinned): it then builds with clang and
// lld, and the tools that read its output here are llvm's, the same on
// every host.
linux_pinned := proc(target: Str) returns Bool {
    return target.starts_with("linux-") && File.is_dir(format("vendor/linux/", target))
}

// The prefix of the GNU tools for a linux or windows target, as Debian
// names them on every host, the target's own included. A windows target's
// are the pinned llvm-mingw's on every host, Windows too (issue #483), by
// the names targets.til's toolchain_command runs.
gnu_tool_prefix := proc(target: Str) returns Str {
    if target == "linux-arm64" { return "aarch64-linux-gnu-" }
    if target == "linux-x64" { return "x86_64-linux-gnu-" }
    if target == "windows-x64" { return "x86_64-w64-mingw32-" }
    if target == "windows-x86" { return "i686-w64-mingw32-" }
    fail(format("produce-binary does not know the tools of ", target))
    return ""
}

// `compiler build --force-rebuild --target=<target>` with no --cc: til
// picks the compiler for the target on every host (targets.til,
// toolchain_command), so every producer runs the same command line. The
// caller adds the outputs and the source.
build_command := proc(compiler: Str, target: Str) returns Cmd {
    return Cmd.new(compiler, "build", "--force-rebuild", format("--target=", target))
}

// The identity of the toolchain this host uses for `target`, recorded for
// diagnosis: it does not have to match between hosts, the binaries do (the
// toolchain rule, end of issues/open/472.org). Version level, not the
// distribution's package string, so that a native and a cross compiler of
// one version read the same.
// REM The tools are the ones til runs for the target (targets.til,
// toolchain_command; builder.til, compile_c).
toolchain_identity := proc(target: Str) returns Str {
    if target.starts_with("android-") {
        mut archiver := "ar"
        if host_os() == "macos" { archiver = "llvm-ar" }
        return format(version_line("clang"), "\n", version_line("ld.lld"), "\n",
            version_line(archiver), "\n", version_line("llvm-objcopy"), "\n",
            "sysroot: vendor/android (NDK r30, API 28)\n")
    }
    if target.starts_with("macos-").and(host_os() == "macos").and(version_line("clang").contains("Apple clang")) {
        // A mac whose clang is Apple's builds its own target with Apple's
        // tools and SDK; with the pinned LLVM first on PATH it builds as
        // every other host does (targets.til, macos_is_cross).
        return format(version_line("clang"), "\n", first_line_of("ld", "-v"), "\n",
            "SDK ", tool_output("xcrun", "--show-sdk-version"), "\n")
    }
    if target.starts_with("macos-") {
        // Headers and libraries are the repository's vendor/macos.
        // REM A Windows host finds "ld.lld" only with its extension:
        // CreateProcess adds .exe to a name without a dot (CI run 3182).
        mut lld := "ld.lld"
        if host_os() == "windows" { lld = "ld.lld.exe" }
        return format(version_line("clang"), "\n", version_line(lld), "\n", version_line("llvm-ar"), "\n", version_line("dsymutil"), "\n")
    }
    if linux_pinned(target) {
        mut lld := "ld.lld"
        if host_os() == "windows" { lld = "ld.lld.exe" }
        return format(version_line("clang"), "\n", version_line(lld), "\n", version_line("llvm-ar"), "\n",
            "C library: vendor/linux/", target, " (Bootlin, glibc 2.34)\n")
    }
    if target.starts_with("linux-") || target.starts_with("windows-") {
        prefix := gnu_tool_prefix(target)
        // REM On a linux-x64 host til runs plain "gcc" for linux-x64, which
        // a Debian gcc package installs as this same triplet-named driver.
        compiler := format(prefix, "gcc")
        // The C library version the compiler's headers declare: glibc's,
        // or the mingw-w64 runtime's.
        probe := format(WORK, "/libc_version.c")
        mut probe_text := "#include <features.h>\nglibc __GLIBC__ __GLIBC_MINOR__\n"
        if target.starts_with("windows-") { probe_text = "#include <_mingw.h>\nmingw-w64 __MINGW64_VERSION_STR\n" }
        File.writefile(probe, probe_text)
        preprocess := Cmd.new(compiler, "-E", "-P", probe)
        preprocess.capture()
        if preprocess.run() != 0 { fail(format("cannot read the C library version: ", preprocess.err())) }
        // REM The last line: mingw's header also declares things.
        preprocessed := preprocess.out().trim()
        mut libc_version := preprocessed.clone()
        last_break := preprocessed.rfind("\n")
        if last_break >= 0 {
            libc_version = preprocessed.substr(last_break.to_usize() + 1, preprocessed.len() - last_break.to_usize() - 1).clone()
        }
        // REM clang, which a windows toolchain's "gcc" may be (llvm-mingw),
        // has no -dumpfullversion; its --version line says which it is.
        mut compiler_identity := format(compiler, " ", version_line(compiler))
        if target.starts_with("linux-") {
            compiler_identity = format(compiler, " ", tool_output(compiler, "-dumpfullversion"), " ", tool_output(compiler, "-dumpmachine"))
        }
        // REM llvm-mingw's Windows package has no x86_64-w64-mingw32-ld (CI
        // run 3188), the wrapper its Linux package runs ld.lld through: there
        // the linker clang runs is ld.lld.exe, named with its .exe because
        // Windows adds one only to a name without a dot.
        mut linker := format(prefix, "ld")
        if target.starts_with("windows-").and(host_os() == "windows") { linker = "ld.lld.exe" }
        return format(compiler_identity, "\n",
            version_line(linker), "\n", version_line(format(prefix, "ar")), "\n",
            libc_version.trim(), "\n")
    }
    fail(format("produce-binary does not know the toolchain of ", target))
    return ""
}

// The sections of a target's executable worth telling apart.
binary_sections := func(target: Str) returns Vec(Str) {
    if target.starts_with("macos-") {
        return vec(Str, "__TEXT,__text", "__TEXT,__const", "__TEXT,__cstring", "__TEXT,__unwind_info",
            "__DATA,__data", "__DATA,__const", "__DATA_CONST,__const", "__DATA_CONST,__got")
    }
    if target.starts_with("windows-") {
        return vec(Str, ".text", ".data", ".rdata", ".pdata", ".xdata", ".edata", ".idata", ".CRT", ".tls",
            ".reloc", ".debug_info", ".debug_abbrev", ".debug_line", ".debug_str", ".debug_line_str")
    }
    return vec(Str, ".interp", ".note.gnu.build-id", ".dynsym", ".dynstr", ".rela.dyn", ".text", ".rodata",
        ".eh_frame", ".init_array", ".data.rel.ro", ".data", ".comment", ".debug_info", ".debug_abbrev",
        ".debug_line", ".debug_str", ".debug_line_str")
}

// A binary by section, so that a difference between producers names the
// part of it: code, constants, data, debug info, the dynamic tables, the
// build id. A section the binary does not have is listed as such.
list_sections := proc(target: Str, level: Str, binary: Str, label: Str, scratch: Str, mut lines: Vec(Str), width: Str = "32") {
    mut objcopy := "llvm-objcopy"
    if target.starts_with("macos-").or(target.starts_with("android-")).or(linux_pinned(target)).not() {
        objcopy = format(gnu_tool_prefix(target), "objcopy")
    }
    mut section_names := Vec(Str).new()
    mut section_paths := Vec(Str).new()
    for section : Str in binary_sections(target) {
        dumped := format(scratch, "_", section_names.len().to_str())
        dump := Cmd.new(objcopy, format("--dump-section=", section, "=", dumped), binary, format(scratch, "_copy"))
        dump.capture()
        if dump.run() != 0 || File.is_file(dumped).not() {
            lines.push(own format("refused ", level, " ", target, " c ", width, " ", label, ":", section))
            continue
        }
        section_names.push(own section.clone())
        section_paths.push(own dumped)
    }
    section_hashes := sha256_of(section_paths)
    for i, hash in section_hashes { lines.push(own format(hash, " ", level, " ", target, " c ", width, " ", label, ":", section_names[i])) }
}

// A Mach-O executable's debug map: the source and object paths the linker
// records for the debugger (N_SO, N_OSO; an OSO line's last number is the
// object's modification time). It is in no section, so list_sections
// cannot show it: in CI run 3186 a Windows host's mac executables differed
// from every other host's with all their sections, objects and archives
// equal. One item, and the lines printed, to read the paths from each
// producer's log. The item's name is one word: a list line is seven
// fields, and "debug map" made eight, which collect refused (CI run 3190).
list_debug_map := proc(producer: Str, target: Str, level: Str, binary: Str, label: Str, scratch: Str, mut lines: Vec(Str)) {
    nm := Cmd.new("llvm-nm", "-ap", binary)
    nm.capture()
    if nm.run() != 0 { fail(format(nm.render(), " failed: ", nm.err())) }
    mut kept := Vec(Str).new()
    for line : Str in nm.out().split("\n") {
        if line.contains(" SO ") || line.contains(" OSO ") {
            println("ci_collect: ", producer, " ", target, " ", label, " debug map: ", line)
            kept.push(own line.clone())
        }
    }
    path := format(scratch, "_debug_map")
    File.writefile(path, format(join(kept, "\n"), "\n"))
    hashes := sha256_of(vec(Str, path.clone()))
    lines.push(own format(hashes[0], " ", level, " ", target, " c 32 ", label, ":debug-map"))
}

// An archive by member, for the same reason.
list_members := proc(target: Str, level: Str, archive: Str, label: Str, scratch: Str, mut lines: Vec(Str), width: Str = "32") {
    File.remove_tree(scratch)
    mkdir_p(scratch)
    // REM Apple's ar has no --output; a mac host uses llvm-ar (see the
    // workflow's mac jobs for where it comes from). A mac target's archive
    // is read with llvm-ar on every host: GNU ar extracts its symbol table
    // (__.SYMDEF) as one more member and llvm-ar does not, so the Mac's
    // list lacked a line the Linux hosts had (CI run 3142). The table is
    // still compared, in the hash of the whole archive.
    mut archiver := "ar"
    if host_os() == "macos" || target.starts_with("macos-") || target.starts_with("android-") || linux_pinned(target) {
        archiver = "llvm-ar"
    }
    extract := Cmd.new(archiver, "x", format("--output=", scratch), archive)
    extract.capture()
    if extract.run() != 0 { fail(format(extract.render(), " failed: ", extract.err())) }
    // REM ar restores each member's recorded mode, and a Mach-O archive's
    // symbol table (__.SYMDEF) is recorded with none: unreadable to anyone
    // but root (CI run 3113).
    readable := Cmd.new("chmod", "-R", "u+r", scratch)
    readable.capture()
    if readable.run() != 0 { fail(format(readable.render(), " failed: ", readable.err())) }
    mut names := Vec(Str).new()
    mut paths := Vec(Str).new()
    for name : Str in Dir.list(scratch) {
        paths.push(own format(scratch, "/", name))
        names.push(own name.clone())
    }
    hashes := sha256_of(paths)
    for i, hash in hashes { lines.push(own format(hash, " ", level, " ", target, " c ", width, " ", label, ":", names[i])) }
}

// Android is a cross-only program/library target (#473), not a til host.
// Compare its native corpus at both layouts, including the libraries an APK
// or Java app actually loads. SDK-capable producers additionally compare the
// exact aligned APK before signing; their per-host debug keys may differ.
produce_android_binary := proc(compiler: Str, target: Str, mut lines: Vec(Str), trial: Bool) {
    identity := toolchain_identity(target)
    println("toolchain for ", target, ":\n", identity)
    identity_path := format(WORK, "/toolchain_", target)
    File.writefile(identity_path, identity)
    directory := format(WORK, "/binary_", target)
    mkdir_p(directory)
    // CI run 3167: native artifacts agree on Linux x64/arm64 and macOS
    // arm64; the exact unsigned APK agrees on both SDK-capable producers.
    mut level := "binary"
    mut apk_level := "apk"
    if trial {
        level = "binary-trial"
        apk_level = "apk-trial"
    }
    archive := format("vendor/raylib/build-", target, "/libraylib.a")
    if File.is_file(archive).not() { fail(format(archive, " is not built; run bin/make ", archive, " first")) }
    sdk := android_apk_sdk()
    if sdk.len() > 0 { android_apk_inputs(sdk) }
    else { println("ci_collect: ", target, " APK payload not produced: no Android SDK") }
    for width : Str in array(Str, "32", "64") {
        mut paths := vec(Str, identity_path.clone(), archive.clone())
        mut items := vec(Str, "- toolchain", "vendor libraylib.a")
        for source : Str in array(Str, "examples/hello_script.til", "test/layout_corpus.til") {
            stem := file_stem(source)
            binary := format(directory, "/", stem, "_", width)
            emitted := format(binary, ".c")
            build := build_command(compiler, target)
            build.args(format("--usize=", width), "-o", binary, "-c", emitted, source)
            build.capture()
            if build.run() != 0 { fail(format(build.render(), " failed:\n", build.out(), build.err())) }
            paths.push(own binary.clone())
            items.push(own format(source, " ", stem))
            compared := format(emitted, ".compared")
            File.writefile(compared, without_stamp(File.readfile(emitted)))
            paths.push(own compared)
            items.push(own format(source, " ", stem, ".c"))
            paths.push(own format(binary, "_forward.h"))
            items.push(own format(source, " ", stem, "_forward.h"))
            list_sections(target, level, binary, format(source, " ", stem), format(binary, "_section"), lines, width)
        }
        build := build_command(compiler, target)
        emitted := format(directory, "/jni_lib_", width, ".c")
        build.args(format("--usize=", width), "--jni", "-c", emitted, "test/jni_lib.til")
        build.capture()
        if build.run() != 0 { fail(format(build.render(), " failed:\n", build.out(), build.err())) }
        mut dependencies : USize = 0
        for line : Str in build.out().split("\n") {
            if line.starts_with("Generated: gen/lib/libtilrt-").or(line.starts_with("Generated: gen/lib/libtilcore-")) {
                path := line.strip_prefix("Generated: ")
                name := path.strip_prefix("gen/lib/")
                paths.push(own path.clone())
                items.push(own format("test/jni_lib.til ", name))
                list_sections(target, level, path, format("test/jni_lib.til ", name), format(directory, "/dependency_", dependencies.to_str()), lines, width)
                dependencies++
            }
        }
        if dependencies != 2 { fail(format("Android library did not report its runtime and core:\n", build.out())) }
        for name : Str in array(Str, "jni_lib.o", "libjni_lib.a", "libjni_lib.so", "libjni_lib_jni.so") {
            path := format("gen/lib/", name)
            paths.push(own path.clone())
            items.push(own format("test/jni_lib.til ", name))
            if name.ends_with(".so") {
                list_sections(target, level, path, format("test/jni_lib.til ", name), format(directory, "/", name, "_section"), lines, width)
            }
        }
        compared := format(emitted, ".compared")
        File.writefile(compared, without_stamp(File.readfile(emitted)))
        paths.push(own compared)
        items.push(own "test/jni_lib.til jni_lib.c")
        for path : Str in array(Str, "gen/til/jni_lib.h", "gen/til/jni_lib_jni.c", "gen/til/java/til/jni_lib/JniLib.java") {
            paths.push(own path.clone())
            items.push(own format("test/jni_lib.til ", path.strip_prefix("gen/til/")))
        }
        if sdk.len() > 0 {
            apk := format(directory, "/hello_gui_", width, ".apk")
            c_path := format(directory, "/hello_gui_", width, ".c")
            package := build_command(compiler, target)
            package.args(format("--usize=", width), "-o", apk, "-c", c_path, "examples/hello_gui.til")
            package.capture()
            if package.run() != 0 { fail(format(package.render(), " failed:\n", package.out(), package.err())) }
            // Keep packaging output exactly as the builder made it: no
            // extracting, stripping or ZIP rewriting before hashing.
            stage := android_apk_stage(c_path, target, width)
            mut abi := "x86_64"
            if target == "android-arm64" { abi = "arm64-v8a" }
            // The library is part of the proven APK payload. Its record also
            // keeps an SDK producer in the group if its APK record is lost,
            // so missing APKs fail rather than becoming single-producer data.
            apk_paths := vec(Str, format(stage, "/aligned.apk"), format(stage, "/lib/", abi, "/libhello_gui.so"))
            apk_items := array(Str, "aligned.apk", "libhello_gui.so")
            apk_hashes := sha256_of(apk_paths)
            for i, hash in apk_hashes {
                lines.push(own format(hash, " ", apk_level, " ", target, " c ", width, " examples/hello_gui.til ", apk_items[i]))
            }
        }
        hashes := sha256_of(paths)
        for i, hash in hashes {
            mut item_level := level.clone()
            if i == 0 { item_level = "binary-trial" }
            lines.push(own format(hash, " ", item_level, " ", target, " c ", width, " ", items[i]))
        }
        list_members(target, level, archive, "vendor libraylib.a", format(directory, "/raylib_members"), lines, width)
        list_members(target, level, "gen/lib/libjni_lib.a", "test/jni_lib.til libjni_lib.a", format(directory, "/library_members"), lines, width)
    }
}

// #472/#473: the til a host builds with `make` and runs the suite on is
// bin/til, and a host that cross-builds til for that target has to write
// those bytes: then the cross build needs no test of its own. The
// generated C's path and the sources' are in the debug info as seen from
// the build's directory, so the cross build is made the way make makes it
// (make.til, build_til) -- the same command at the same relative paths --
// in a root of its own: a copy of src/, the forward header and this
// compiler as bin/til_boot, and the checkout's vendor/. Measured on one
// host: a build in such a root is bin/til byte for byte. On the target's
// own host nothing is built: the file listed is the one the suite ran.
// Returns the binary's path.
make_til := proc(compiler: Str, target: Str, directory: Str, extension: Str) returns Str {
    name := format("bin/til", extension)
    if target_to_str(detect_current_target()) == target {
        if File.is_file(name).not() { fail(format(name, " is not built; run make first")) }
        return name
    }
    root := format(directory, "/root")
    mkdir_p(format(root, "/bin"))
    mkdir_p(format(root, "/boot"))
    if copy_tree("src", format(root, "/src")) != 0 { fail(format("cannot copy src to ", root)) }
    if copy_file("boot/til_forward.h", format(root, "/boot/til_forward.h")) != 0 { fail("cannot copy boot/til_forward.h") }
    // REM bin/til_boot is the compiler make builds bin/til with; its name
    // is not in til, which carries no build stamp.
    own_extension := executable_extension(detect_current_target())
    boot := format("bin/til_boot", own_extension)
    if copy_file(compiler, format(root, "/", boot)) != 0 { fail(format("cannot copy ", compiler)) }
    // REM A copy does not carry the executable bit.
    executable := Cmd.new("chmod", "+x", format(root, "/", boot))
    executable.capture()
    if executable.run() != 0 { fail(format(executable.render(), " failed: ", executable.err())) }
    // REM The target's archives, headers and stubs: read, not written.
    mut link := Cmd.new("ln", "-s", realpath_str("vendor"), format(root, "/vendor"))
    // REM MSYS2's ln -s copies the tree, the unpacked compilers included; a
    // junction is the directory itself and needs no privilege. mklink is
    // cmd.exe's own and reads / as an option: backslashes.
    if host_os() == "windows" {
        link = Cmd.new("cmd", "/c", "mklink", "/J", format(root, "/vendor").replace("/", "\\"),
            realpath_str("vendor").replace("/", "\\"))
    }
    link.capture()
    if link.run() != 0 { fail(format(link.render(), " failed: ", link.err())) }
    build := Cmd.new(format("./", boot), "build", format("--target=", target), "--usize=32", "-o", name,
        "-c", "gen/til/til.c", "src/til.til")
    build.cwd(root)
    build.capture()
    if build.run() != 0 { fail(format(build.render(), " in ", root, " failed:\n", build.out(), build.err())) }
    return format(root, "/", name)
}

// wasm32 (#473) is a program target only: no til for it, no vendored
// archive til links by default. til runs the vendored emsdk's emcc
// through --cc, as the wasm32 CI job does (bin/make installs it with any
// wasm32 archive), and emcc writes one .js with the module inside. Two
// programs at both widths, on trial. Measured on one host: a build at the
// same paths is the same file every time, and the paths in it are
// relative to the checkout.
produce_wasm_binary := proc(compiler: Str, mut lines: Vec(Str)) {
    emsdk := realpath_str("vendor/emscripten")
    emcc := format(emsdk, "/upstream/emscripten/emcc")
    if File.is_file(emcc).not() {
        fail(format(emcc, " is not installed; run bin/make vendor/secp256k1/build-wasm32/lib/libsecp256k1.a first"))
    }
    config := format(emsdk, "/.emscripten")
    version := Cmd.new(emcc, "--version")
    version.env("EM_CONFIG", config)
    version.capture()
    if version.run() != 0 { fail(format("cannot run ", emcc, " --version: ", version.err())) }
    identity := version.out()
    println("toolchain for wasm32:\n", identity)
    identity_path := format(WORK, "/toolchain_wasm32")
    File.writefile(identity_path, identity)
    directory := format(WORK, "/binary_wasm32")
    mkdir_p(directory)
    for width : Str in array(Str, "32", "64") {
        mut paths := vec(Str, identity_path.clone())
        mut items := vec(Str, "- toolchain")
        for source : Str in array(Str, "examples/hello_script.til", "test/layout_corpus.til") {
            stem := file_stem(source)
            binary := format(directory, "/", stem, "_", width, ".js")
            build := build_command(compiler, "wasm32")
            build.env("EM_CONFIG", config)
            build.args(format("--cc=", emcc), format("--usize=", width), "-o", binary,
                "-c", format(directory, "/", stem, "_", width, ".c"), source)
            build.capture()
            if build.run() != 0 { fail(format(build.render(), " failed:\n", build.out(), build.err())) }
            if File.is_file(binary).not() { fail(format(build.render(), " wrote no ", binary)) }
            paths.push(own binary)
            items.push(own format(source, " ", stem, ".js"))
        }
        hashes := sha256_of(paths)
        for i, hash in hashes { lines.push(own format(hash, " binary-trial wasm32 c ", width, " ", items[i])) }
    }
}

// A producer's list, written. A line is seven fields (read_list): one with
// more or fewer is refused here, in the job that wrote it, not by collect
// after every producer has run (CI run 3190: an item named with a space).
write_list := proc(list: Str, lines: Vec(Str)) {
    for line : Str in lines {
        if line.split(" ").len() != 7 { fail(format("a list line is seven fields, this one is not: ", line)) }
    }
    File.writefile(list, format(join(lines, "\n"), "\n"))
}

/// til's own build for one target, beyond the binary: the C it was built
/// from, the native-layout til, and the binary's sections.
list_til_build := proc(compiler: Str, target: Str, target_level: Str, directory: Str, extension: Str,
        mut lines: Vec(Str)) {
    til_binary := format(directory, "/til")
    // The C til was built from, without its reuse stamp line: if this
    // differs between producers the compilers disagree, not the
    // toolchains. (#472: it did, by one constant folded on the host.)
    generated := format(directory, "/til.c.compared")
    File.writefile(generated, without_stamp(File.readfile(format(directory, "/til.c"))))
    mut generated_paths := Vec(Str).new()
    generated_paths.push(own generated)
    generated_paths.push(own format(directory, "/til_forward.h"))
    generated_hashes := sha256_of(generated_paths)
    lines.push(own format(generated_hashes[0], " ", target_level, " ", target, " c 32 src/til.til til.c"))
    lines.push(own format(generated_hashes[1], " ", target_level, " ", target, " c 32 src/til.til til_forward.h"))

    // til again in the native layout (--usize=64): the other width a
    // user can build, and it has to be the same from every host too.
    wide_binary := format(directory, "/til64")
    wide_build := build_command(compiler, target)
    wide_build.args("--usize=64", "-o", wide_binary, "-c", format(directory, "/til64.c"), "src/til.til")
    wide_build.capture()
    if wide_build.run() != 0 { fail(format(wide_build.render(), " failed:\n", wide_build.out(), wide_build.err())) }
    wide_generated := format(directory, "/til64.c.compared")
    File.writefile(wide_generated, without_stamp(File.readfile(format(directory, "/til64.c"))))
    mut wide_paths := Vec(Str).new()
    wide_paths.push(own format(wide_binary, extension))
    wide_paths.push(own wide_generated)
    wide_hashes := sha256_of(wide_paths)
    lines.push(own format(wide_hashes[0], " ", target_level, " ", target, " c 64 src/til.til til"))
    lines.push(own format(wide_hashes[1], " ", target_level, " ", target, " c 64 src/til.til til.c"))

    list_sections(target, target_level, format(til_binary, extension), "src/til.til til", format(directory, "/til_section"), lines)
}

// Level "binary": artifacts a run has shown equal between producers; a
// difference fails the collect job. Level "binary-trial": artifacts being
// tried; compared and printed the same way, never failing. An artifact
// moves from trial to binary in the commit after a run showed it equal.
produce_binary := proc(producer: Str, list: Str, compiler: Str, targets: Vec(Str), trial: Bool) {
    File.remove_tree(WORK)
    mkdir_p(WORK)
    mut lines := Vec(Str).new()
    for target : Str in targets {
        if target.starts_with("android-") {
            produce_android_binary(compiler, target, lines, trial)
            continue
        }
        if target == "wasm32" {
            produce_wasm_binary(compiler, lines)
            continue
        }
        identity := toolchain_identity(target)
        println("toolchain for ", target, ":\n", identity)
        identity_path := format(WORK, "/toolchain_", target)
        File.writefile(identity_path, identity)
        // REM Every producer builds at these paths: the generated C's path,
        // relative to the checkout, is in the binary's debug info.
        directory := format(WORK, "/binary_", target)
        mkdir_p(directory)
        // A target is strict once a run has shown it equal from its own
        // host and from the others, with its pinned compiler (#472).
        // windows-x64: the Windows host's tested bin/til.exe, til.exe at
        // both widths, the programs, the library and the vendored archives
        // are the two Linux hosts' (CI runs 3159 to 3166). The two mac
        // targets: the same from the two Linux hosts and the two Macs (CI
        // runs 3167, 3173 and 3178), and so is the bin/til each Mac's own
        // job builds and runs its suite with, since those jobs build it
        // with the pinned compiler (CI run 3190: de027be6bf73 for
        // macos-arm64 and ae117fc4fd92 for macos-x64, from all four).
        // The six linux targets, built against the pinned C library
        // (#504): the same from the two Linux hosts, each host's own
        // bin/til included (CI run 3205; 0d732a2689bc for linux-x64 in run
        // 3203, from three builds). A host that lists with
        // produce-binary-trial is on trial for everything.
        mut target_level := "binary-trial"
        if trial.not() && (target == "windows-x64" || target.starts_with("macos-") || target.starts_with("linux-")) {
            target_level = "binary"
        }
        mut levels := Vec(Str).new()
        mut items := Vec(Str).new()
        mut paths := Vec(Str).new()
        levels.push(own "binary-trial")
        items.push(own "- toolchain")
        paths.push(own identity_path.clone())
        mut extension := ""
        if target.starts_with("windows-") { extension = ".exe" }
        // Two programs: the smallest one, and one with every kind of type
        // layout in it.
        for source : Str in array(Str, "examples/hello_script.til", "test/layout_corpus.til") {
            stem := file_stem(source)
            binary := format(directory, "/", stem)
            build := build_command(compiler, target)
            build.args("-o", binary, "-c", format(directory, "/", stem, ".c"), source)
            build.capture()
            if build.run() != 0 { fail(format(build.render(), " failed:\n", build.out(), build.err())) }
            // REM til adds the target's extension to the -o name.
            levels.push(own target_level.clone())
            items.push(own format(source, " ", stem))
            paths.push(own format(binary, extension))
        }
        // A library: its static archive, the object in it and the shared
        // library. A library build writes to gen/lib/, named after the
        // source file.
        library := format(directory, "/ci_binary_lib.til")
        File.writefile(library, "mode lib\nci_binary_sum := func(a: I64, b: I64) returns I64 { return a + b }\n")
        build := build_command(compiler, target)
        build.arg(library)
        build.capture()
        if build.run() != 0 { fail(format(build.render(), " failed:\n", build.out(), build.err())) }
        mut shared := "libci_binary_lib.so"
        if target.starts_with("macos-") { shared = "libci_binary_lib.dylib" }
        if target.starts_with("windows-") { shared = "libci_binary_lib.dll" }
        for file : Str in array(Str, "libci_binary_lib.a", "ci_binary_lib.o", shared) {
            built := format("gen/lib/", file)
            if File.is_file(built).not() { fail(format("the library build for ", target, " wrote no ", built)) }
            // REM The next target's build writes the same names.
            kept := format(directory, "/", file)
            if copy_file(built, kept) != 0 { fail(format("cannot copy ", built)) }
            levels.push(own target_level.clone())
            items.push(own format("ci_binary_lib.til ", file))
            paths.push(own kept)
        }
        // The vendored archives til links, as bin/make built them for the
        // target, and then til itself (#472: the binary that matters).
        // If an archive differs between producers, til cannot match.
        for archive : Str in array(Str, format("vendor/libffi/build-", target, "/.libs/libffi.a"),
            format("vendor/nng/build-", target, "/libnng.a")) {
            if File.is_file(archive).not() { fail(format(archive, " is not built; run bin/make ", archive, " first")) }
            levels.push(own target_level.clone())
            items.push(own format("vendor ", file_stem(format(archive, ".til"))))
            paths.push(own archive.clone())
        }
        // REM til itself is a 64-bit program: its source does not type-check
        // for a target whose pointers are 32 bits (casts between U64 and
        // UPtr). Such a target's list is its programs, its library and
        // the archives.
        builds_til := target_uptr_name(target_from_str(target)) == "U64"
        til_binary := format(directory, "/til")
        if builds_til {
            til_build := build_command(compiler, target)
            til_build.args("-o", til_binary, "-c", format(directory, "/til.c"), "src/til.til")
            til_build.capture()
            if til_build.run() != 0 { fail(format(til_build.render(), " failed:\n", til_build.out(), til_build.err())) }
            levels.push(own target_level.clone())
            items.push(own "src/til.til til")
            paths.push(own format(til_binary, extension))
            // The til make builds: the tested file on this target's own host,
            // the same build in a root of its own on every other.
            levels.push(own target_level.clone())
            items.push(own "make bin/til")
            paths.push(own make_til(compiler, target, directory, extension))
        }

        hashes := sha256_of(paths)
        for i, hash in hashes { lines.push(own format(hash, " ", levels[i], " ", target, " c 32 ", items[i])) }

        if builds_til { list_til_build(compiler, target, target_level, directory, extension, lines) }
        list_sections(target, target_level, format(directory, "/hello_script", extension), "examples/hello_script.til hello_script",
            format(directory, "/hello_section"), lines)
        if target.starts_with("macos-") {
            list_debug_map(producer, target, target_level, format(til_binary, extension), "src/til.til til",
                format(directory, "/til"), lines)
            list_debug_map(producer, target, target_level, format(directory, "/hello_script", extension),
                "examples/hello_script.til hello_script", format(directory, "/hello"), lines)
        }
        list_members(target, target_level, format("vendor/libffi/build-", target, "/.libs/libffi.a"), "vendor libffi.a",
            format(directory, "/libffi_members"), lines)
        list_members(target, target_level, format("vendor/nng/build-", target, "/libnng.a"), "vendor libnng.a",
            format(directory, "/libnng_members"), lines)
    }
    write_list(list, lines)
    // The til binaries' own lines, in this job's log: the binary that
    // matters can be compared between hosts as soon as their jobs end,
    // without waiting for the collect job (which waits for every producer).
    for line : Str in lines {
        if line.ends_with(" src/til.til til") || line.ends_with(" make bin/til") { println("ci_collect: ", producer, " ", line) }
    }
    println("ci_collect: ", producer, " wrote ", lines.len().to_str(), " lines to ", list)
}

produce := proc(producer: Str, list: Str, compiler: Str) {
    File.remove_tree(WORK)
    mkdir_p(WORK)
    mut lines := Vec(Str).new()
    // REM The corpus of test/observe.til: control flow, a diamond of
    // imports, generics, closures, ownership, layouts, constant evaluation.
    for source : Str in array(Str, "examples/hello_script.til", "test/loops.til", "test/import_diamond.til",
        "test/templ_vec.til", "test/closures.til", "test/ownership_shapes.til", "test/layout_corpus.til",
        "test/constfold.til") {
        for phase : Str in array(Str, "tokens", "parsed", "typed", "owned", "prepared") {
            produce_frontend(compiler, source, phase, lines)
        }
    }
    // REM The corpus of test/translate_layouts.til, and the JNI test library
    // (its bindings above).
    for target : Str in target_names() {
        for width : Str in array(Str, "32", "64") {
            for source : Str in array(Str, "examples/hello_script.til", "test/layout_corpus.til",
                "test/float_fold.til", "test/option.til", "test/hashmaps.til", "test/jni_lib.til") {
                produce_source(compiler, source, target, width, lines)
            }
        }
    }
    write_list(list, lines)
    println("ci_collect: ", producer, " wrote ", lines.len().to_str(), " lines to ", list)
}

// Every *.txt under `directory`, however deep: CI puts each producer's
// artifact in a directory of its own.
list_files := proc(directory: Str, mut found: Vec(Str)) {
    for name : Str in Dir.list(directory) {
        path := format(directory, "/", name)
        if File.is_dir(path) { list_files(path, found) }
        else if name.ends_with(".txt") { found.push(own path) }
    }
}

read_list := proc(path: Str, mut entries: Vec(Entry)) {
    producer := file_stem(path.strip_suffix(".txt").format(".til"))
    mut number := 0
    for line : Str in File.readfile(path).split("\n") {
        number++
        if line.len() == 0 { continue }
        fields := line.split(" ")
        if fields.len() != 7 {
            fail(format(path, ":", number.to_str(), ": expected 7 fields, found ", fields.len().to_str()))
        }
        if fields[0].len() != 64 && fields[0] != "refused" {
            fail(format(path, ":", number.to_str(), ": not a sha256 or \"refused\": ", fields[0]))
        }
        trial := fields[1].ends_with("-trial")
        entries.push(own Entry(producer = producer.clone(), hash = fields[0].clone(),
            group = format(fields[1].strip_suffix("-trial"), " ", fields[2], " ", fields[3], " ", fields[4]),
            item = format(fields[5], " ", fields[6]), trial = trial))
    }
}

collect := proc(directory: Str, report_only: Bool) {
    mut files := Vec(Str).new()
    list_files(directory, files)
    if files.len() == 0 { fail(format("no hash list (*.txt) under ", directory)) }
    mut entries := Vec(Entry).new()
    for path : Str in files { read_list(path, entries) }

    // Who took part in each group, and who has each item of it.
    mut group_producers := Map(Str, Set(Str)).new()
    mut item_hashes := Map(Str, Map(Str, Str)).new()
    // Who listed each item on trial, and who has a strict line in a group.
    mut item_trial := Map(Str, Set(Str)).new()
    mut group_strict := Map(Str, Set(Str)).new()
    for entry : Entry in entries {
        if group_producers.has(entry.group).not() { group_producers.set(entry.group, own Set(Str).new()) }
        ref mut producers : Set(Str) = group_producers[entry.group]
        producers.add(own entry.producer.clone())
        key := format(entry.group, " ", entry.item)
        if item_hashes.has(key).not() { item_hashes.set(key, own Map(Str, Str).new()) }
        ref mut by_producer : Map(Str, Str) = item_hashes[key]
        if by_producer.has(entry.producer) {
            fail(format(entry.producer, " lists ", key, " twice"))
        }
        by_producer.set(entry.producer, own entry.hash.clone())
        if item_trial.has(key).not() { item_trial.set(key, own Set(Str).new()) }
        if group_strict.has(entry.group).not() { group_strict.set(entry.group, own Set(Str).new()) }
        if entry.trial {
            ref mut on_trial : Set(Str) = item_trial[key]
            on_trial.add(own entry.producer.clone())
        } else {
            ref mut strict : Set(Str) = group_strict[entry.group]
            strict.add(own entry.producer.clone())
        }
    }

    mut equal : USize = 0
    mut different : USize = 0
    mut missing : USize = 0
    mut alone : USize = 0
    mut trial_different : USize = 0
    for group, producers in group_producers {
        mut group_equal : USize = 0
        mut group_alone : USize = 0
        prefix := format(group, " ")
        for key, by_producer in item_hashes {
            if key.starts_with(prefix).not() { continue }
            item := key.substr(prefix.len(), key.len() - prefix.len())
            ref on_trial : Set(Str) = item_trial[key]
            ref strict : Set(Str) = group_strict[group]
            for producer : Str in producers {
                if by_producer.has(producer).not() {
                    // REM A producer only on trial in this group, or an item
                    // someone lists on trial, is reported and does not fail.
                    if strict.has(producer).and(on_trial.len() == 0) {
                        println("MISSING ", group, ": ", producer, " has no ", item)
                        missing++
                    } else {
                        println("MISSING (trial, does not fail) ", group, ": ", producer, " has no ", item)
                    }
                }
            }
            if by_producer.len() == 1 {
                group_alone++
                continue
            }
            // The strict lines are compared among themselves, and that alone
            // decides a failure; trial lines only add a trial difference.
            mut first := ""
            mut same := true
            mut strict_first := ""
            mut strict_same := true
            for producer, hash in by_producer {
                if first.len() == 0 { first = hash.clone() }
                else if hash != first { same = false }
                if on_trial.has(producer) { continue }
                if strict_first.len() == 0 { strict_first = hash.clone() }
                else if hash != strict_first { strict_same = false }
            }
            if same {
                group_equal++
                continue
            }
            if strict_same {
                trial_different++
                println("DIFFERENT (trial, does not fail) ", group, ": ", item)
            } else {
                different++
                println("DIFFERENT ", group, ": ", item)
            }
            for producer, hash in by_producer { println("    ", producer, " ", hash) }
        }
        equal = equal + group_equal
        alone = alone + group_alone
        mut producer_names := ""
        for producer : Str in producers {
            if producer_names.len() > 0 { producer_names = format(producer_names, ", ") }
            producer_names = format(producer_names, producer)
        }
        println(group, ": ", producers.len().to_str(), " producers (", producer_names, "), ",
            group_equal.to_str(), " items equal, ", group_alone.to_str(), " from one producer only (not compared)")
    }
    println("ci_collect: ", equal.to_str(), " equal, ", different.to_str(), " different, ", missing.to_str(),
        " missing, ", alone.to_str(), " not compared, ", trial_different.to_str(), " different on trial")
    if different + missing > 0 && report_only.not() { exit(1) }
}

main := proc(args: ..Str) {
    if args.len() == 4 && args[0] == "produce" {
        produce(args[1], args[2], args[3])
        return
    }
    if args.len() >= 5 && (args[0] == "produce-binary" || args[0] == "produce-binary-trial") {
        mut targets := Vec(Str).new()
        for i in 4..args.len() { targets.push(own args[i].clone()) }
        produce_binary(args[1], args[2], args[3], targets, args[0] == "produce-binary-trial")
        return
    }
    if args.len() == 2 && args[0] == "collect" {
        collect(args[1], false)
        return
    }
    if args.len() == 3 && args[0] == "collect" && args[2] == "report" {
        collect(args[1], true)
        return
    }
    fail("usage: ci_collect produce <producer> <list file> <compiler> | ci_collect produce-binary[-trial] <producer> <list file> <compiler> <target>... | ci_collect collect <directory> [report]")
}
