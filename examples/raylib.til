mode script

// Direct raylib FFI -- no companion .c needed. Bindings come from
// `vendor/bindings/raylib.til` (auto-generated by src/self/binder.til;
// see `bin/til bindings` and the Makefile `bindings` target). Each
// importer adds the matching link() lines next to the import.
import("../vendor/bindings/raylib")
// The linux targets' own raylib builds (issue #422); src/modes/gui.til
// lists every target's.
link("vendor/raylib/build-linux-x64/libraylib.a", "linux-x64")
link("vendor/raylib/build-linux-arm64/libraylib.a", "linux-arm64")
link("vendor/raylib/build-linux-riscv64/libraylib.a", "linux-riscv64")
link("vendor/raylib/build-linux-x86/libraylib.a", "linux-x86")
link("vendor/raylib/build-linux-arm32/libraylib.a", "linux-arm32")
link("vendor/raylib/build-linux-riscv32/libraylib.a", "linux-riscv32")
link("m")
link("pthread")
link("rt")

InitWindow(800, 450, "hello from til!".c_str)
SetTargetFPS(60)

BLACK := Color(r = 0, g = 0, b = 0, a = 255)
RED := Color(r = 230, g = 41, b = 55, a = 255)

mut x : I32 = 0
mut y : I32 = 0
while !WindowShouldClose() {
    BeginDrawing()
    ClearBackground(BLACK)
    DrawRectangle(x, y, 50, 50, RED)
    EndDrawing()
    x++
    y++
}
CloseWindow()
