mode gui
import("../src/modes/gui", Colors.*)

import("lib/music")

// Music mode viewer. Defaults to 7 Greek modes; the top selector switches to
// the 5 Global modes or experimental nathex while keeping the staff and piano
// area fixed.

// -- Layout --
WINDOW_WIDTH : I32 = 1920
WINDOW_HEIGHT : I32 = 1080
FPS : I32 = 320
PRACTICAL_MAX_FREQ : I64 = 4435

SEVEN_NATURAL_COUNT : USize = 7
SEVEN_ONCE_SCALE_NOTES : USize = 8
SEVEN_FULL_SCALE_NOTES : USize = 15
FIVE_FULL_SCALE_NOTES : USize = 16
NATHEX_FULL_SCALE_NOTES : USize = 11
MAX_SCALE_NOTES : USize = 16
SEVEN_CYCLE : I32 = 12

// -- Derived metrics --
MARGIN : I32 = WINDOW_WIDTH / 48
BTN_W : I32 = (WINDOW_WIDTH - MARGIN * 2) / SEVEN_NATURAL_COUNT.to_i32()
SYSTEM_BTN_W : I32 = (WINDOW_WIDTH - MARGIN * 2) / 6
BTN_H : I32 = WINDOW_HEIGHT / 27
GAP : I32 = WINDOW_HEIGHT / 90
FONT : I32 = WINDOW_HEIGHT / 45
FONT_SM : I32 = WINDOW_HEIGHT / 54
PAD_X : I32 = BTN_W / 25
PAD_Y : I32 = BTN_H / 4
LANG_BTN_W : I32 = BTN_W * 2 / 5
NOTE_LABEL_BTN_W : I32 = BTN_W
NOTE_LABEL_ROW_X : I32 = MARGIN + LANG_BTN_W * 3 + GAP
SPAN_ROW_X : I32 = NOTE_LABEL_ROW_X + NOTE_LABEL_BTN_W * 2 + GAP
SPAN_BTN_W : I32 = BTN_W * 3 / 2

// Row Y positions. Both systems use the same language row so the pentagram
// and piano stay fixed when switching systems.
SYSTEM_ROW_Y : I32 = GAP
PLAYBACK_ROW_Y : I32 = SYSTEM_ROW_Y + BTN_H + GAP
QUALITY_ROW_Y : I32 = PLAYBACK_ROW_Y + BTN_H
NOTE_ROW_Y : I32 = QUALITY_ROW_Y + BTN_H + GAP
MODE_ROW_Y : I32 = NOTE_ROW_Y + BTN_H * 3 + GAP
RADIO_ROW_Y : I32 = MODE_ROW_Y + BTN_H + GAP

// Staff/pentagram
BUTTONS_END_Y : I32 = RADIO_ROW_Y + BTN_H
STAFF_SP : I32 = WINDOW_HEIGHT / 76
NOTE_R : I32 = WINDOW_HEIGHT / 82
STAFF_BASE_Y : I32 = BUTTONS_END_Y + GAP + STAFF_SP * 26
STAFF_X : I32 = MARGIN * 3
STAFF_W : I32 = WINDOW_WIDTH - STAFF_X * 2
NOTE_X0 : I32 = WINDOW_WIDTH / 8
LABEL_Y : I32 = STAFF_BASE_Y + STAFF_SP * 2 + NOTE_R + GAP

// Piano roll
PIANO_Y : I32 = LABEL_Y + WINDOW_HEIGHT / 45 + GAP
WHITE_H : I32 = WINDOW_HEIGHT / 8
BLACK_H : I32 = WHITE_H * 2 / 3
HINT_Y : I32 = PIANO_Y + WHITE_H + GAP

// Mode INTERVALS (7 modes x 7 steps = 49), brightest to darkest.
SEVEN_MODE_INTERVALS := array(I32,
    2, 2, 2, 1, 2, 2, 1,
    2, 2, 1, 2, 2, 2, 1,
    2, 2, 1, 2, 2, 1, 2,
    2, 1, 2, 2, 2, 1, 2,
    2, 1, 2, 2, 1, 2, 2,
    1, 2, 2, 2, 1, 2, 2,
    1, 2, 2, 1, 2, 2, 2,
)

// 5 Global mode rows, brightest to darkest:
// America 2 2 1 2 1; Europe 2 1 2 2 1; Africa 2 1 2 1 2;
// Asia 1 2 2 1 2; Oceania 1 2 1 2 2.
// All-natural roots are ca Europe, de Asia, fi America, go Africa, lu Oceania.

// Chord symbol suffixes for major, minor, diminished, augmented triads.
TRIAD_SUFFIXES := array(Str, "", "m", "dim", "aug")

// Language data: [name, mode0..mode6]
LANG_PT := array(Str, "PT", "Lidio", "Jonio", "Mixolidio", "Dorico", "Eolio", "Frigio", "Locrio")
LANG_ES := array(Str, "ES", "Lidio", "Jonico", "Mixolidio", "Dorico", "Eolico", "Frigio", "Locrio")
LANG_EN := array(Str, "EN", "Lydian", "Ionian", "Mixolydian", "Dorian", "Aeolian", "Phrygian", "Locrian")
LANGS := array(Array__Str, LANG_PT, LANG_ES, LANG_EN)

NOTE_LABELS := array(Str, "Nota", "Nota", "Note")
TRIAD_LABELS := array(Str, "Triade", "Triada", "Triad")
DYAD_LABELS := array(Str, "Diade", "Diada", "Dyad")
FOUR_LABELS := array(Str, "Tetrade", "Tetrada", "Tetrad")
DYAD_KIND : I32 = -2
voicing_label := func(choice: USize, lang: USize) returns ref Str {
    if choice.eq(0) { return NOTE_LABELS[lang] }
    if choice.eq(1) { return DYAD_LABELS[lang] }
    if choice.eq(2) { return TRIAD_LABELS[lang] }
    return FOUR_LABELS[lang]
}
// First choice: stack degrees in the current mode. Other choices specify
// root-relative chromatic intervals, independent of that mode.
FOUR_PT := array(Str, "Da escala", "Setima maior", "Setima da dominante", "Setima menor", "Meio diminuto", "Setima diminuta", "Triade aumentada com setima maior", "Sexta adicionada")
FOUR_ES := array(Str, "De la escala", "Septima mayor", "Septima de dominante", "Septima menor", "Semidisminuido", "Septima disminuida", "Triada aumentada con septima mayor", "Sexta agregada")
FOUR_EN := array(Str, "From scale", "Major seventh", "Dominant seventh", "Minor seventh", "Half-diminished seventh", "Diminished seventh", "Augmented major seventh", "Added sixth")
FOUR_SYMBOLS := array(Str, "1-3-5-7", "maj7", "7", "m7", "m7b5", "dim7", "maj7#5", "6")
FOUR_NAMES := array(Array__Str, FOUR_PT, FOUR_ES, FOUR_EN)
FOUR_INTERVALS := array(I32, 0,4,7,11, 0,4,7,10, 0,3,7,10, 0,3,6,10, 0,3,6,9, 0,4,8,11, 0,4,7,9)
FOUR_COUNT : USize = 8
FOUR_W : I32 = (WINDOW_WIDTH - MARGIN * 2) / FOUR_COUNT.to_i32()
QUALITY_PT := array(Str, "Maior", "Menor", "Diminuta", "Aumentada")
QUALITY_ES := array(Str, "Mayor", "Menor", "Disminuida", "Aumentada")
QUALITY_EN := array(Str, "Major", "Minor", "Diminished", "Augmented")
QUALITY_LABELS := array(Array__Str, QUALITY_PT, QUALITY_ES, QUALITY_EN)
DEGREE_LABELS := array(Str, "Graus 1-3-5", "Grados 1-3-5", "Degrees 1-3-5")
STEP_LABELS := array(Str, "passos", "pasos", "steps")
CHORD_HINTS := array(Str,
    "Triades nas notas da escala exibida; outras teclas tocam notas individuais",
    "Triadas en las notas de la escala mostrada; otras teclas tocan notas individuales",
    "Triads on displayed scale notes; other keys play single notes")

// One mixed sound gives all voices exactly the same onset and envelope.
mut viewer_sound := Sound()
mut viewer_sound_loaded := false
mut active_keys := array(I32, -1, -1, -1, -1)

// -- Helper functions --

seven_triad_type := func(sc_chrom: Array(I32), ti: USize) returns U32 {
    ref root_c : I32 = sc_chrom[ti]
    i3 := (sc_chrom[(ti + 2) % SEVEN_NATURAL_COUNT] - root_c + SEVEN_CYCLE) % SEVEN_CYCLE
    i5 := (sc_chrom[(ti + 4) % SEVEN_NATURAL_COUNT] - root_c + SEVEN_CYCLE) % SEVEN_CYCLE
    if i3.eq(3).and(i5.eq(7)) { return 1 }
    if i3.eq(3).and(i5.eq(6)) { return 2 }
    if i3.eq(4).and(i5.eq(8)) { return 3 }
    return 0
}

seven_note_name := func(use_letters: Bool, diat_idx: USize) returns ref Str {
    if use_letters {
        ref s : Str = LETTER_DIATONIC_NOTE_NAMES[diat_idx]
        return s
    }
    ref s : Str = SOLFEGE_NOTE_NAMES[diat_idx]
    return s
}

active_note_name := func(use_five: Bool, use_letters: Bool, diat_idx: USize) returns ref Str {
    if use_five {
        ref s : Str = FIVE_NATURAL_NAMES[diat_idx]
        return s
    }
    return seven_note_name(use_letters, diat_idx)
}

active_five_system := func(use_five: Bool, use_nathex: Bool) returns Bool {
    return use_five.or(use_nathex)
}

lang_str := func(lang_idx: USize, label_idx: USize) returns ref Str {
    ref lang : Array(Str) = LANGS[lang_idx]
    ref s : Str = lang[label_idx]
    return s
}

five_mode_name := func(lang_idx: USize, mode_idx: USize) returns ref Str {
    if lang_idx.eq(2) {
        ref s : Str = FIVE_MODE_NAMES_EN[mode_idx]
        return s
    }
    ref s : Str = FIVE_MODE_NAMES[mode_idx]
    return s
}

acc_text := func(acc: I64) returns Str {
    if acc.eq(1) { return "#" }
    if acc.eq(-1) { return "b" }
    if acc.eq(2) { return "##" }
    if acc.eq(-2) { return "bb" }
    return ""
}

active_note_count := func(use_five: Bool, use_nathex: Bool, full_span: Bool) returns USize {
    if full_span {
        if use_nathex { return NATHEX_FULL_SCALE_NOTES }
        if use_five { return FIVE_FULL_SCALE_NOTES }
        return SEVEN_FULL_SCALE_NOTES
    }
    if use_five.or(use_nathex) { return FIVE_SCALE_NOTES }
    return SEVEN_ONCE_SCALE_NOTES
}

active_root_count := func(use_five: Bool) returns USize {
    if use_five { return FIVE_NATURAL_COUNT }
    return SEVEN_NATURAL_COUNT
}

scale_degree_key := func(five_system: Bool, sc_chrom: Array(I32), degree: USize) returns I32 {
    count := active_root_count(five_system)
    mut cycle := SEVEN_CYCLE
    if five_system { cycle = FIVE_CYCLE.to_i32() }
    return sc_chrom[degree % count] + (degree / count).to_i32() * cycle
}

key_is_active := func(key: I32) returns Bool {
    for i : USize in 0..active_keys.len() {
        if active_keys[i].eq(key) { return true }
    }
    return false
}

clear_active_keys := func() {
    for i : USize in 0..active_keys.len() { active_keys[i] = -1 }
}

stop_viewer_sound := proc() {
    if viewer_sound_loaded {
        StopSound(viewer_sound)
        UnloadSound(viewer_sound)
        viewer_sound_loaded = false
    }
    clear_active_keys()
}

viewer_freq := func(use_nathex: Bool, key: I32) returns I64 {
    // Upper Global chords can exceed the stored C4-B6 table. Extend its
    // last octave by exact doubling, rather than dropping a chord voice.
    mut table_key := key
    mut multiplier : I64 = 1
    if use_nathex.not() {
        while table_key.gte(36) {
            table_key = table_key - 12
            multiplier = multiplier * 2
        }
    }
    return music_modes_key_freq(use_nathex, table_key.to_usize()) * multiplier
}

mixed_sample := func(freqs: Array(F32), phase: F32) returns F32 {
    mut sample : F32 = 0
    for v : USize in 0..freqs.len() {
        sample = sample + sinf(freqs[v] * phase)
    }
    amplitude : F32 = 0.3
    return sample * amplitude / freqs.len().to_f32()
}

play_keys := proc(use_nathex: Bool, keys: Array(I32), voice_count: USize) {
    stop_viewer_sound()
    mut freqs := Array(F32).new(voice_count)
    for v : USize in 0..voice_count {
        active_keys[v] = keys[v].clone()
        freqs[v] = viewer_freq(use_nathex, keys[v]).to_f32()
    }
    play_freqs(freqs)
}

play_freqs := proc(freqs: Array(F32)) {
    if sound_enabled.not() { return }
    sr : I64 = 44100
    samples : I64 = sr * 250 / 1000
    attack := sr / 100
    release := sr / 100
    mut buf : U8 = malloc((samples * 4).to_usize().to_uptr())
    pi2 : F32 = 6.283185307179586
    for i : USize in 0..samples.to_usize() {
        mut envelope : F32 = 1
        if i.to_i64().lt(attack) { envelope = i.to_f32() / attack.to_f32() }
        if i.to_i64().gt(samples - release) {
            envelope = (samples - i.to_i64()).to_f32() / release.to_f32()
        }
        sample := mixed_sample(freqs, pi2 * i.to_f32() / sr.to_f32()) * envelope
        memcpy(ptr_add(buf, i.to_uptr() * 4), sample, 4)
    }
    wave := Wave(frameCount = samples.to_u32(), sampleRate = sr.to_u32(),
                 sampleSize = 32, channels = 1, data = to_ptr(buf))
    viewer_sound = LoadSoundFromWave(wave)
    free(own buf)
    viewer_sound_loaded = true
    PlaySound(viewer_sound)
}

voice_count_for := func(chord_mode: Bool, kind: I32) returns USize {
    if kind.eq(DYAD_KIND) { return 2 }
    if kind.gte(0) { return 4 }
    if chord_mode { return 3 }
    return 1
}

voice_degree := func(root: USize, v: USize, kind: I32) returns USize {
    if kind.eq(7).and(v.eq(3)) { return root + 5 }
    return root + v * 2
}

voice_key := func(five: Bool, nathex: Bool, chrom: Array(I32), root: USize, v: USize, kind: I32) returns I32 {
    if kind.lte(0) { return scale_degree_key(five, chrom, root + v * 2) }
    mut offset := FOUR_INTERVALS[(kind - 1).to_usize() * 4 + v].clone()
    if nathex { offset = (offset * 8 + 6) / 12 }
    return scale_degree_key(five, chrom, root) + offset
}

StaffTone := struct {
    name : I32 = 0
    register : I32 = 0
    accidental : I32 = 0
}

staff_tone := func(five: Bool, nathex: Bool, root: USize, v: USize, kind: I32, chrom: Array(I32),
                   diat: Array(I32), span: Array(I32), acc: Array(I32)) returns StaffTone {
    count := active_root_count(five)
    d := voice_degree(root, v, kind)
    idx := d % count
    mut a := acc[idx].clone()
    if kind.gt(0).and(v.gt(0)) {
        key := voice_key(five, nathex, chrom, root, v, kind)
        if five {
            pc := key.to_usize() % FIVE_CYCLE
            // Spell chromatic targets in the local five-name grid. Use the
            // root's displayed register as anchor (also for altered roots).
            root_key := scale_degree_key(true, chrom, root)
            root_idx := root % count
            correction := (FIVE_NATURALS[diat[root_idx].to_usize()] + acc[root_idx] - root_key) / FIVE_CYCLE.to_i32() + span[root_idx] + (root / count).to_i32()
            return StaffTone(name = FIVE_DIATONIC_BY_CHROM[pc], register = key / FIVE_CYCLE.to_i32() + correction, accidental = FIVE_ACC_BY_CHROM[pc])
        }
        a = a + key - scale_degree_key(false, chrom, d)
    }
    return StaffTone(name = diat[idx], register = span[idx] + (d / count).to_i32(), accidental = a)
}

play_degree := proc(chord_mode: Bool, five_system: Bool, use_nathex: Bool,
                    sc_chrom: Array(I32), degree: USize, kind: I32 = -1) {
    voices := voice_count_for(chord_mode, kind)
    mut keys := Array(I32).new(voices)
    for v : USize in 0..voices {
        keys[v] = voice_key(five_system, use_nathex, sc_chrom, degree, v, kind)
    }
    play_keys(use_nathex, keys, voices)
}

note_x := func(dni: USize, note_count: USize) returns I32 {
    dx := (WINDOW_WIDTH - NOTE_X0 * 2) / (note_count.to_i32() - 1)
    return NOTE_X0 + dni.to_i32() * dx
}

staff_y := func(use_five: Bool, diat_idx: I32, span: I32) returns I32 {
    mut staff_pos := diat_idx - 2 + span * SEVEN_NATURAL_COUNT.to_i32()
    if use_five { staff_pos = five_staff_pos(diat_idx, span) }
    return STAFF_BASE_Y - staff_pos * STAFF_SP
}

start_scale := func(mut playing: Bool, mut play_idx: USize, mut play_timer: I64) {
    playing = true
    play_idx = 0
    play_timer = 300
}

draw_note := proc(use_five: Bool, use_nathex: Bool, use_letters: Bool, dni: USize, note_count: USize,
                  sc_diat: Array(I32), sc_span: Array(I32), sc_acc: Array(I32),
                  sc_triad: Array(U32), playing: Bool, play_idx: USize,
                  clicked_note: I32, voice: USize, fnt: Font, sc_chrom: Array(I32), kind: I32) {
    five_system := active_five_system(use_five, use_nathex)
    dnx := note_x(dni, note_count)
    tone := staff_tone(five_system, use_nathex, dni, voice, kind, sc_chrom, sc_diat, sc_span, sc_acc)
    nd := tone.name
    ns := tone.register
    mut staff_pos := nd - 2 + ns * SEVEN_NATURAL_COUNT.to_i32()
    if five_system { staff_pos = five_staff_pos(nd, ns) }
    dny := staff_y(five_system, nd, ns)


    // Ledger lines.
    if staff_pos.lt(0) {
        mut lp : I32 = -2
        while lp.gte(staff_pos) {
            lly := STAFF_BASE_Y - lp * STAFF_SP
            DrawRectangle(dnx - NOTE_R * 2, lly, NOTE_R * 4, 2, GRAY_100)
            lp = lp - 2
        }
    }
    if staff_pos.gt(8) {
        mut lp : I32 = 10
        while lp.lte(staff_pos) {
            lly := STAFF_BASE_Y - lp * STAFF_SP
            DrawRectangle(dnx - NOTE_R * 2, lly, NOTE_R * 4, 2, GRAY_100)
            lp = lp + 2
        }
    }

    mut note_color := YELLOW
    if playing.and(play_idx.gt(dni)) {
        note_color = OLIVE
    }
    if clicked_note.eq(dni.to_i32()) {
        note_color = TEAL
    }

    DrawCircle(dnx, dny, NOTE_R.to_f32(), note_color)

    na := tone.accidental
    if !na.eq(0) {
        mut aw := NOTE_R
        if na.abs().eq(2) { aw = NOTE_R * 2 }
        at := acc_text(na.cast(I64))
        DrawTextEx(fnt, at.c_str, Vector2(x = (dnx - (FONT + aw)).to_f32(), y = (dny - FONT / 2).to_f32()), FONT.to_f32(), 1, WHITE)
    }

    // A chord column has three noteheads but only one root/chord label.
    if voice.gt(0) { return }
    mut label := ""
    if five_system {
        if use_nathex { label = nathex_full_note_name(nd, na, ns) }
        else { label = five_full_note_name(nd, na, ns) }
    } else {
        ref nn_base : Str = seven_note_name(use_letters, nd.to_usize())
        nn_acc := acc_text(na.cast(I64))
        label = format(nn_base, nn_acc)
        if kind.eq(-1).and(dni.lt(SEVEN_NATURAL_COUNT)) {
            ref trt2 : U32 = sc_triad[dni]
            chord := format(LETTER_DIATONIC_NOTE_NAMES[nd.to_usize()], nn_acc, TRIAD_SUFFIXES[trt2.cast(USize)])
            if use_letters {
                label = chord
            } else {
                label = format(label, " ", chord)
            }
        }
    }
    DrawTextEx(fnt, label.c_str, Vector2(x = (dnx - NOTE_R).to_f32(), y = LABEL_Y.to_f32()), FONT_SM.to_f32(), 1, HINT_GRAY)
}

recompute_seven_scale := func(sel_diatonic: USize, sel_accidental: I32, sel_mode: USize,
                              note_count: USize,
                              mut sc_chrom: Array(I32), mut sc_diat: Array(I32), mut sc_span: Array(I32),
                              mut sc_acc: Array(I32), mut sc_freq: Array(I64), mut sc_triad: Array(U32)) {
    root_chromatic := (NATURALS[sel_diatonic] + sel_accidental + SEVEN_CYCLE) % SEVEN_CYCLE
    mut chrom_total := root_chromatic
    mut diat_pos := sel_diatonic.to_i32()
    mut diat_oct : I32 = 0
    mut prev_diat := sel_diatonic.to_i32()

    for k : USize in 0..note_count {
        chrom_mod := chrom_total % SEVEN_CYCLE
        sc_chrom[k] = chrom_total.clone()
        sc_diat[k] = diat_pos.clone()
        sc_span[k] = diat_oct.clone()

        mut acc := chrom_mod - NATURALS[diat_pos.to_usize()]
        if acc.gt(6) { acc = acc - SEVEN_CYCLE }
        if acc.lt(-6) { acc = acc + SEVEN_CYCLE }
        sc_acc[k] = acc

        ref freq : I64 = music_modes_key_freq(false, chrom_total.to_usize())
        sc_freq[k] = freq.clone()

        if (k + 1).lt(note_count) {
            step_idx := k % SEVEN_NATURAL_COUNT
            ref step : I32 = SEVEN_MODE_INTERVALS[sel_mode * SEVEN_NATURAL_COUNT + step_idx]
            chrom_total = chrom_total + step
            prev_diat = diat_pos
            diat_pos = (diat_pos + 1) % SEVEN_NATURAL_COUNT.to_i32()
            if diat_pos.lt(prev_diat) {
                diat_oct = diat_oct + 1
            }
        }
    }

    for ti : USize in 0..SEVEN_NATURAL_COUNT {
        sc_triad[ti] = seven_triad_type(sc_chrom, ti)
    }
}

audition_key := proc(key_idx: I32, chord_mode: Bool, five_system: Bool, use_nathex: Bool,
                     note_count: USize, sc_chrom: Array(I32),
                     mut clicked_note: I32, mut clicked_timer: I32, kind: I32 = -1) {
    clicked_note = -1
    clicked_timer = 300
    for ci : USize in 0..note_count {
        if sc_chrom[ci].eq(key_idx) {
            clicked_note = ci.to_i32()
            play_degree(chord_mode, five_system, use_nathex, sc_chrom, ci, kind)
            return
        }
    }
    // Keys outside the displayed scale are explicitly single-note auditions.
    if viewer_freq(use_nathex, key_idx).lte(PRACTICAL_MAX_FREQ) {
        keys := array(I32, key_idx)
        play_keys(use_nathex, keys, 1)
    } else {
        stop_viewer_sound()
    }
}

piano_last_key := func(five_system: Bool, full_span: Bool, chord_mode: Bool,
                       sc_chrom: Array(I32), note_count: USize, kind: I32 = -1, nathex: Bool = false) returns I32 {
    mut last : I32 = 23
    if five_system.or(full_span) { last = 24 }
    if chord_mode {
        upper := voice_key(five_system, nathex, sc_chrom, note_count - 1, voice_count_for(true, kind) - 1, kind)
        if upper.gt(last) { last = upper }
    }
    return last
}

piano_natural := func(five_system: Bool, white_idx: USize) returns I32 {
    if five_system {
        return (white_idx / FIVE_NATURAL_COUNT).to_i32() * FIVE_CYCLE.to_i32() + FIVE_NATURALS[white_idx % FIVE_NATURAL_COUNT]
    }
    return (white_idx / SEVEN_NATURAL_COUNT).to_i32() * SEVEN_CYCLE + NATURALS[white_idx % SEVEN_NATURAL_COUNT]
}

piano_white_count := func(five_system: Bool, last_key: I32) returns USize {
    mut count : USize = 0
    while piano_natural(five_system, count).lte(last_key) { count++ }
    // Leave room for a final accidental between its two surrounding whites.
    if piano_natural(five_system, count - 1).lt(last_key) { count++ }
    return count
}

piano_hit_key := func(five_system: Bool, last_key: I32, mx: I32, my: I32) returns I32 {
    white_count := piano_white_count(five_system, last_key)
    white_w := STAFF_W / white_count.to_i32()
    black_w := white_w / 2
    if mx.lt(STAFF_X).or(mx.gte(STAFF_X + white_w * white_count.to_i32())).or(my.lt(PIANO_Y)).or(my.gte(PIANO_Y + WHITE_H)) { return -1 }
    if my.lt(PIANO_Y + BLACK_H) {
        for i : USize in 0..(white_count - 1) {
            key := piano_natural(five_system, i)
            if (piano_natural(five_system, i + 1) - key).eq(2) {
                bx := STAFF_X + (i + 1).to_i32() * white_w - black_w / 2
                if mx.gte(bx).and(mx.lt(bx + black_w)) { return key + 1 }
            }
        }
    }
    return piano_natural(five_system, ((mx - STAFF_X) / white_w).to_usize())
}

piano_key_label := func(five_system: Bool, key: I32) returns Str {
    if key.lt(PIANO_C4_KEY_COUNT.to_i32()) {
        return PIANO_KEY_LABELS[PIANO_C4_KEY_OFFSET + key.to_usize()].clone()
    }
    if five_system {
        return format(FIVE_NAMES[key.mod(FIVE_CYCLE.to_i32()).to_usize()], (key / FIVE_CYCLE.to_i32() + 4).to_str())
    }
    return freqs_letter_note_name(PIANO_C4_FREQ_OFFSET.to_i32() + key)
}

draw_piano := proc(five_system: Bool, last_key: I32, fnt: Font) {
    KEY_WHITE_PRESSED := TEAL
    KEY_WHITE := GRAY_240
    KEY_LABEL_COLOR := GRAY_80
    KEY_BLACK_PRESSED := DARK_TEAL
    KEY_BLACK := GRAY_20
    KEY_LABEL_BLACK := HINT_GRAY

    white_count := piano_white_count(five_system, last_key)
    white_w := STAFF_W / white_count.to_i32()
    black_w := white_w / 2
    for i : USize in 0..white_count {
        key := piano_natural(five_system, i)
        x := STAFF_X + i.to_i32() * white_w
        mut color := KEY_WHITE
        if key_is_active(key) { color = KEY_WHITE_PRESSED }
        DrawRectangle(x, PIANO_Y, white_w - 2, WHITE_H, color)
        label := piano_key_label(five_system, key)
        DrawTextEx(fnt, label.c_str, Vector2(x = (x + white_w / 4).to_f32(), y = (PIANO_Y + WHITE_H - 30).to_f32()), 18, 1, KEY_LABEL_COLOR)
    }
    for i : USize in 0..(white_count - 1) {
        key := piano_natural(five_system, i)
        if (piano_natural(five_system, i + 1) - key).eq(2) {
            x := STAFF_X + (i + 1).to_i32() * white_w - black_w / 2
            mut color := KEY_BLACK
            if key_is_active(key + 1) { color = KEY_BLACK_PRESSED }
            DrawRectangle(x, PIANO_Y, black_w, BLACK_H, color)
            label := piano_key_label(five_system, key + 1)
            DrawTextEx(fnt, label.c_str, Vector2(x = (x + black_w / 4).to_f32(), y = (PIANO_Y + BLACK_H - 20).to_f32()), 14, 1, KEY_LABEL_BLACK)
        }
    }
}

chord_description := func(five_system: Bool, use_nathex: Bool, use_letters: Bool,
                          lang: USize, degree: USize, sc_chrom: Array(I32),
                          sc_diat: Array(I32), sc_span: Array(I32), sc_acc: Array(I32),
                          sc_triad: Array(U32), kind: I32 = -1) returns Str {
    count := active_root_count(five_system)
    mut text := ""
    mut offsets := ""
    root := scale_degree_key(five_system, sc_chrom, degree)
    for v : USize in 0..voice_count_for(true, kind) {
        tone := staff_tone(five_system, use_nathex, degree, v, kind, sc_chrom, sc_diat, sc_span, sc_acc)
        delta := voice_key(five_system, use_nathex, sc_chrom, degree, v, kind) - root
        if v.gt(0) { offsets = format(offsets, ",") }
        offsets = format(offsets, delta.to_str())
        mut label := ""
        if five_system {
            label = five_full_note_name(tone.name, tone.accidental, tone.register)
        } else {
            label = format(seven_note_name(use_letters, tone.name.to_usize()), acc_text(tone.accidental.cast(I64)), (tone.register + 4).to_str())
        }
        if v.gt(0) { text = format(text, " + ") }
        text = format(text, label)
    }
    mut quality := DEGREE_LABELS[lang].clone()
    if kind.eq(DYAD_KIND) { quality = format(DYAD_LABELS[lang], " 1-3") }
    else if kind.gte(0) {
        ref names : Array(Str) = FOUR_NAMES[lang]
        quality = names[kind.to_usize()].clone()
        if kind.eq(0) { quality = format(quality, " 1-3-5-7") }
        if use_nathex.and(kind.gt(0)) { quality = format("~", quality) }
    } else if five_system.not() {
        ref labels : Array(Str) = QUALITY_LABELS[lang]
        quality = labels[sc_triad[degree % count].cast(USize)].clone()
    }
    mut tuning := "12-TET"
    if use_nathex { tuning = "8-TET" }
    return format(text, " | ", quality, " | ", STEP_LABELS[lang], " ", offsets, " (", tuning, ")")
}

log2f := ext_func(shallow value: F32) returns shallow F32 {}
exp2f := ext_func(shallow value: F32) returns shallow F32 {}

// Eight 12-TET steps span 2/D; eight Nathex steps span 2. Their endpoint
// ratio is the Delian constant D, the real solution to D^3 = 2.
delian_ratio := macro() returns F32 {
    mut d : F32 = 1
    two : F32 = 2
    for _ in 0..6 { d = (d * two + two / (d * d)) / 3 }
    return d
}
DELIAN := delian_ratio()
SERIES_C4 : F32 = 261.625565
SERIES_TUNINGS := array(I32, 8, 12, 16, 24, 32)
SERIES_TITLES := array(Str, "Comparar afinacoes", "Comparar afinaciones", "Tuning comparison")
JUST_TITLES := array(Str, "Harmonicos e escala justa", "Armonicos y escala justa", "Harmonics and just scale")
JUST_PLAY := array(Str, "Tocar", "Tocar", "Play")
JUST_STOP := array(Str, "Parar", "Parar", "Stop")
JUST_KEY := array(Str, "Do maior (Jonio)", "Do mayor (Jonico)", "C major (Ionian)")
FIRST_EIGHT := array(Str, "Harmonicos 1-8", "Armonicos 1-8", "Harmonics 1-8")
FIRST_SIXTEEN := array(Str, "Harmonicos 1-16", "Armonicos 1-16", "Harmonics 1-16")
FIRST_THIRTY_TWO := array(Str, "Harmonicos 1-32", "Armonicos 1-32", "Harmonics 1-32")
SERIES_B2 : F32 = 123.470825
// Nearest staff spelling (use flats for Eb, Ab and Bb); never quantize audio.
STAFF_PC := array(I32, 0,0,1,2,2,3,3,4,5,5,6,6)
STAFF_ACC := array(Str, "","#","","b","","","#","","b","","b","")
JUST_NUM := array(I32, 1, 9, 5, 4, 3, 5, 15)
JUST_DEN := array(I32, 1, 8, 4, 3, 2, 3, 8)

// Five-limit major scale. All pitches are ratios to the same C4 tonic.
just_multiplier := func(degree: USize) returns I32 {
    mut m : I32 = 1
    for _ in 0..(degree / SEVEN_NATURAL_COUNT) { m = m * 2 }
    return m
}
just_frequency := func(degree: USize) returns F32 {
    i := degree % SEVEN_NATURAL_COUNT
    return SERIES_C4 * JUST_NUM[i].to_f32() / JUST_DEN[i].to_f32() * just_multiplier(degree).to_f32()
}

JustStaff := struct {
    partials : USize = 8  // 0 selects just Ionian.
    full : Bool = true
    playing : Bool = false
    selected : I32 = -1
    timer : I32 = 0
    low_base : Bool = true
    voices : USize = 1
}

staff_frequency := func(harmonics: Bool, degree: USize, low_base: Bool = false) returns F32 {
    if harmonics {
        if low_base { return SERIES_B2 * (degree + 1).to_f32() }
        return SERIES_C4 * (degree + 1).to_f32()
    }
    return just_frequency(degree)
}

staff_voicing := func(s: JustStaff, degree: USize) returns Array(F32) {
    mut freqs := Array(F32).new(s.voices)
    for v : USize in 0..s.voices {
        freqs[v] = staff_frequency(s.partials.gt(0), degree + v * 2, s.low_base)
    }
    return freqs
}
just_play := proc(mut s: JustStaff, degree: USize) {
    stop_viewer_sound()
    play_freqs(staff_voicing(s, degree))
    s.selected = degree.to_i32()
    s.timer = 350
}

SPAN_PT := array(Str, "1 hextave (800 c)", "1 oitava (1200 c)", "2 hextaves (1600 c)", "2 oitavas (2400 c)")
SPAN_ES := array(Str, "1 hextava (800 c)", "1 octava (1200 c)", "2 hextavas (1600 c)", "2 octavas (2400 c)")
SPAN_EN := array(Str, "1 hextave (800 c)", "1 octave (1200 c)", "2 hextaves (1600 c)", "2 octaves (2400 c)")
SERIES_SPANS := array(Array__Str, SPAN_PT, SPAN_ES, SPAN_EN)

just_frame := proc(mut s: JustStaff, fnt: Font, mut lang: USize, dt: I32) {
    ref spans : Array(Str) = SERIES_SPANS[lang]
    if series_button(fnt, FIRST_EIGHT[lang], MARGIN, QUALITY_ROW_Y + GAP, BTN_W, s.partials.eq(8)) {
        s.partials = 8; s.selected = -1; s.playing = false; stop_viewer_sound()
    }
    if series_button(fnt, FIRST_SIXTEEN[lang], MARGIN + BTN_W, QUALITY_ROW_Y + GAP, BTN_W, s.partials.eq(16)) {
        s.partials = 16; s.selected = -1; s.playing = false; stop_viewer_sound()
    }
    if series_button(fnt, FIRST_THIRTY_TWO[lang], MARGIN + BTN_W * 2, QUALITY_ROW_Y + GAP, BTN_W, s.partials.eq(32)) {
        s.partials = 32; s.selected = -1; s.playing = false; stop_viewer_sound()
    }
    if series_button(fnt, JUST_KEY[lang], MARGIN + BTN_W * 3, QUALITY_ROW_Y + GAP, BTN_W, s.partials.eq(0)) {
        s.partials = 0; s.selected = -1; s.playing = false; stop_viewer_sound()
    }
    harmonics := s.partials.gt(0)
    for i : USize in 0..2 {
        mut label := spans[i * 2 + 1].clone()
        mut on := s.full.eq(i.eq(1))
        if harmonics {
            label = "f0 = B2 (Si2)"
            if i.eq(1) { label = "f0 = C4 (Do4)" }
            on = s.low_base.eq(i.eq(0))
        }
        if series_button(fnt, label, MARGIN + i.to_i32() * BTN_W, PLAYBACK_ROW_Y, BTN_W, on) {
            if harmonics { s.low_base = i.eq(0) } else { s.full = i.eq(1) }
            s.playing = false; s.selected = -1; stop_viewer_sound()
        }
    }
    mut count := SEVEN_ONCE_SCALE_NOTES
    if harmonics { count = s.partials }
    else if s.full { count = SEVEN_FULL_SCALE_NOTES }
    mut action := JUST_PLAY[lang].clone()
    if s.playing { action = JUST_STOP[lang].clone() }
    if series_button(fnt, action, MARGIN + BTN_W * 2 + GAP, PLAYBACK_ROW_Y, BTN_W, s.playing) {
        s.playing = s.playing.not(); s.selected = -1; s.timer = 0; stop_viewer_sound()
    }
    for li : USize in 0..3 {
        if series_button(fnt, lang_str(li, 0), MARGIN + BTN_W * 3 + GAP * 2 + li.to_i32() * LANG_BTN_W, PLAYBACK_ROW_Y, LANG_BTN_W, lang.eq(li)) { lang = li }
    }
    for v : USize in 0..4 {
        if series_button(fnt, voicing_label(v, lang), MARGIN + v.to_i32() * BTN_W, NOTE_ROW_Y + GAP, BTN_W, s.voices.eq(v + 1)) {
            s.voices = v + 1; s.playing = false; s.selected = -1; stop_viewer_sound()
        }
    }
    if s.playing {
        s.timer = s.timer - dt
        if s.timer.lte(0) {
            mut next := (s.selected + 1).to_usize()
            if harmonics.and(s.voices.gt(1)).and(s.selected.gte(0)) { next++ }
            if (next + (s.voices - 1) * 2).lt(count) { just_play(s, next) }
            else { s.playing = false }
        }
    }
    mut title := JUST_KEY[lang].clone()
    if s.partials.eq(8) { title = FIRST_EIGHT[lang].clone() }
    if s.partials.eq(16) { title = FIRST_SIXTEEN[lang].clone() }
    if s.partials.eq(32) { title = FIRST_THIRTY_TWO[lang].clone() }
    series_text(fnt, format(title, "  |  1/1 = ", staff_frequency(harmonics, 0, s.low_base).to_str(), " Hz"), MARGIN, NOTE_ROW_Y + BTN_H + GAP)
    mut baseline := STAFF_BASE_Y
    if harmonics.and(s.low_base) { baseline = baseline - STAFF_SP * 8 }
    for line : USize in 0..5 {
        DrawRectangle(STAFF_X, baseline - line.to_i32() * 2 * STAFF_SP, STAFF_W, 2, GRAY_115)
    }
    for d : USize in 0..count {
        mut pos := d.to_i32() + 28
        mut accidental := ""
        if harmonics {
            mut base := 48
            if s.low_base { base = 35 }
            chrom := base.to_i32() + nearest_step((d + 1).to_f32(), 12)
            pc := (chrom % 12).to_usize()
            pos = (chrom / 12) * 7 + STAFF_PC[pc]
            accidental = STAFF_ACC[pc].clone()
        }
        i := (pos % 7).to_usize()
        x := note_x(d, count)
        y := baseline - (pos - 30) * STAFF_SP
        mut ledger := baseline + STAFF_SP * 2
        while ledger.lte(y) { DrawRectangle(x - NOTE_R * 2, ledger, NOTE_R * 4, 2, GRAY_115); ledger = ledger + STAFF_SP * 2 }
        ledger = baseline - STAFF_SP * 10
        while ledger.gte(y) { DrawRectangle(x - NOTE_R * 2, ledger, NOTE_R * 4, 2, GRAY_115); ledger = ledger - STAFF_SP * 2 }
        if (d + (s.voices - 1) * 2).lt(count).and(IsMouseButtonPressed(0)).and((GetMouseX() - x).abs().lt(NOTE_R * 2)).and((GetMouseY() - y).abs().lt(NOTE_R * 2)) {
            s.playing = false; just_play(s, d)
        }
        mut color := AMBER
        if s.selected.gte(0) {
            for v : USize in 0..s.voices {
                if d.eq(s.selected.to_usize() + v * 2) { color = CYAN_ACCENT }
            }
        }
        DrawCircle(x, y, NOTE_R.to_f32(), color)
        mut name := SOLFEGE_NOTE_NAMES[i].clone()
        if accidental.is_empty().not() {
            name = format(name, accidental)
            series_text(fnt, accidental, x - NOTE_R * 2, y - NOTE_R)
        }
        series_text(fnt, format(name, (pos / 7).to_str()), x - NOTE_R, LABEL_Y)
        mut ratio := format((JUST_NUM[i] * just_multiplier(d)).to_str(), "/", JUST_DEN[i].to_str())
        if harmonics { ratio = format((d + 1).to_str(), "/1") }
        series_text(fnt, ratio, x - NOTE_R, LABEL_Y + BTN_H)
    }
    if s.selected.gte(0) { series_text(fnt, format(staff_frequency(harmonics, s.selected.to_usize(), s.low_base).to_str(), " Hz"), MARGIN, LABEL_Y + BTN_H * 2) }
}

test_harmonics_vs_ionian := test() {
    assert_eq(F32, staff_frequency(true, 6), SERIES_C4 * 7)
    assert_eq(F32, staff_frequency(true, 7), SERIES_C4 * 8)
    assert_eq(F32, staff_frequency(true, 15), SERIES_C4 * 16)
    assert_eq(F32, staff_frequency(true, 31, true), SERIES_B2 * 32)
    assert_eq(F32, staff_frequency(false, 7), SERIES_C4 * 2)
    assert_eq(F32, staff_frequency(false, 14), SERIES_C4 * 4)
    assert_eq(F32, staff_frequency(false, 4), SERIES_C4 * 1.5)
}
EXACT_LABEL := array(Str, "Ouvir: harmonicos", "Oir: armonicos", "Play harmonics")
GRID_LABEL := array(Str, "Ouvir: temperado", "Oir: temperado", "Play approximation")

series_ratio := func(span: USize) returns F32 {
    two : F32 = 2
    regular := two / DELIAN
    if span.eq(0) { return regular }
    if span.eq(1) { return 2 }
    if span.eq(2) { return regular * regular }
    return 4
}

// The window starts at C4. first=4 means the fourth partial of C2;
// first=1 means the fundamental C4 itself. The grid stays anchored to C4.
partial_ratio := func(h: I32, first: I32) returns F32 { return h.to_f32() / first.to_f32() }
nearest_step := func(ratio: F32, n: I32) returns I32 {
    return (log2f(ratio) * n.to_f32() + 0.5).to_i64().to_i32()
}
grid_ratio := func(step: I32, n: I32) returns F32 { return exp2f(step.to_f32() / n.to_f32()) }

series_note_name := func(step: I32, n: I32) returns Str {
    if n.eq(12).or(n.eq(24)) {
        index := step / (n / 12)
        mut suffix := ""
        if n.eq(24).and(step.mod(2).eq(1)) { suffix = "t" }
        return format(SOLFEGE_CHROMATIC_NAMES[(index % 12).to_usize()], suffix, (index / 12 + 4).to_str())
    }
    subdivisions := n / 8
    index := step / subdivisions
    mut micro := ""
    part := step % subdivisions
    if (part * 2).eq(subdivisions) { micro = "t" }
    base := format(FIVE_NAMES[(index % 8).to_usize()], micro, (index / 8 + 4).to_str())
    if n.eq(32).and(part.mod(2).eq(1)) { return format(base, "+", part.to_str(), "/4") }
    return base
}

SeriesView := struct {
    span : USize = 3
    tuning : USize = 1  // Start with the 12-TET reference.
    first : I32 = 4
    current : I32 = 0
    timer : I32 = 0
    running : Bool = false
    grid : Bool = false
}

series_text := proc(fnt: Font, s: Str, x: I32, y: I32) {
    DrawTextEx(fnt, s.c_str, Vector2(x = x.to_f32(), y = y.to_f32()), FONT_SM.to_f32(), 1, GRAY_235)
}

series_button := proc(fnt: Font, label: Str, x: I32, y: I32, w: I32, active: Bool) returns Bool {
    mut color := GRAY_50
    if active { color = BUTTON_TEAL }
    DrawRectangle(x, y, w - 2, BTN_H - 2, color)
    series_text(fnt, label, x + PAD_X, y + PAD_Y)
    return IsMouseButtonPressed(0).and(GetMouseX().gte(x)).and(GetMouseX().lt(x + w)).and(GetMouseY().gte(y)).and(GetMouseY().lt(y + BTN_H))
}

series_tone := proc(h: I32, first: I32, n: I32, grid: Bool) {
    mut ratio := partial_ratio(h, first)
    if grid { ratio = grid_ratio(nearest_step(ratio, n), n) }
    stop_viewer_sound()
    freqs := array(F32, SERIES_C4 * ratio)
    play_freqs(freqs)
}

series_frame := proc(mut s: SeriesView, fnt: Font, mut lang: USize, dt: I32) {
    ref spans : Array(Str) = SERIES_SPANS[lang]
    mut changed := false
    for i : USize in 0..4 {
        span_w := (WINDOW_WIDTH - MARGIN * 2) / 4
        if series_button(fnt, spans[i], MARGIN + i.to_i32() * span_w, PLAYBACK_ROW_Y, span_w, s.span.eq(i)) {
            s.span = i
            changed = true
        }
    }
    y := PLAYBACK_ROW_Y + BTN_H + GAP
    for i : USize in 0..SERIES_TUNINGS.len() {
        label := format(SERIES_TUNINGS[i].to_str(), "-TET")
        if series_button(fnt, label, MARGIN + i.to_i32() * 140, y, 140, s.tuning.eq(i)) { s.tuning = i; changed = true }
    }
    base_x := MARGIN + SERIES_TUNINGS.len().to_i32() * 140 + GAP
    if series_button(fnt, "f0 = C2", base_x, y, 170, s.first.eq(4)) { s.first = 4; changed = true }
    if series_button(fnt, "f0 = C4", base_x + 170, y, 170, s.first.eq(1)) { s.first = 1; changed = true }
    for i : USize in 0..3 {
        if series_button(fnt, lang_str(i, 0), base_x + 340 + GAP + i.to_i32() * 90, y, 90, lang.eq(i)) { lang = i }
    }
    if changed { s.running = false; s.current = 0; stop_viewer_sound() }
    n := SERIES_TUNINGS[s.tuning].clone()
    limit := series_ratio(s.span)
    last := (limit * s.first.to_f32()).to_i64().to_i32()
    play_y := y + BTN_H + GAP
    for mode : USize in 0..2 {
        mut label := EXACT_LABEL[lang].clone()
        if mode.eq(1) { label = GRID_LABEL[lang].clone() }
        if series_button(fnt, label, MARGIN + mode.to_i32() * 260, play_y, 260, s.running.and(s.grid.eq(mode.eq(1)))) {
            s.grid = mode.eq(1); s.running = true; s.current = s.first - 1; s.timer = 0
        }
    }
    if s.running {
        s.timer = s.timer - dt
        if s.timer.lte(0) {
            next := s.current + 1
            if next.gt(last) { s.running = false }
            else { s.current = next; series_tone(s.current, s.first, n, s.grid); s.timer = 350 }
        }
    }
    // Linear Hz plot. Include the nearest grid point even if it falls just
    // outside the partial selection window (e.g. 10th harmonic in 8-TET).
    right := WINDOW_WIDTH - MARGIN - 100
    left := MARGIN + 770
    mut max_ratio := limit
    high := grid_ratio(nearest_step(partial_ratio(last, s.first), n), n)
    if high.gt(max_ratio) { max_ratio = high }
    scale := (right - left).to_f32() / (max_ratio - 1)
    header := play_y + BTN_H + GAP
    series_text(fnt, "n", MARGIN, header)
    series_text(fnt, "n * f0 (Hz)", MARGIN + 85, header)
    series_text(fnt, format(n.to_str(), "-TET (Hz)"), MARGIN + 305, header)
    series_text(fnt, "TET - n*f0 (cents)", MARGIN + 525, header)
    series_text(fnt, "C4: 261.63 Hz", left, header)
    series_text(fnt, format((SERIES_C4 * max_ratio).to_i64().to_str(), " Hz"), right - 60, header)
    for h : USize in s.first.to_usize()..(last + 1).to_usize() {
        i := h.to_i32()
        r := partial_ratio(i, s.first)
        step := nearest_step(r, n)
        g := grid_ratio(step, n)
        row := header + BTN_H + (i - s.first) * (BTN_H + GAP)
        series_text(fnt, h.to_str(), MARGIN, row + PAD_Y)
        if series_button(fnt, (SERIES_C4 * r).to_str(), MARGIN + 75, row, 210, s.current.eq(i).and(s.grid.not())) {
            s.running = false; s.current = i; s.grid = false; series_tone(i, s.first, n, false)
        }
        grid_label := format(series_note_name(step, n), "  ", (SERIES_C4 * g).to_str())
        if series_button(fnt, grid_label, MARGIN + 295, row, 210, s.current.eq(i).and(s.grid)) {
            s.running = false; s.current = i; s.grid = true; series_tone(i, s.first, n, true)
        }
        cents := log2f(g / r) * 1200
        series_text(fnt, cents.to_str(), MARGIN + 525, row + PAD_Y)
        cy := row + BTN_H / 2
        DrawRectangle(left, cy, right - left, 1, GRAY_75)
        DrawCircle(left + ((r - 1) * scale).to_i64().to_i32(), cy, 8, AMBER)
        DrawCircle(left + ((g - 1) * scale).to_i64().to_i32(), cy, 4, CYAN_ACCENT)
    }
}

CIRCLE_TITLE := array(Str, "Ciclo de quintas/quartas", "Circulo de quintas/cuartas", "Circle of fifths/fourths")
FIFTH_LABEL := array(Str, "Quinta ->", "Quinta ->", "Fifth ->")
FOURTH_LABEL := array(Str, "<- Quarta", "<- Cuarta", "<- Fourth")
CIRCLE_NAMES := array(Str, "C", "G", "D", "A", "E", "B", "F#/Gb", "Db", "Ab", "Eb", "Bb", "F")
CIRCLE_SOLFEGE := array(Str, "Do", "Sol", "Re", "La", "Mi", "Si", "Fa#/Solb", "Reb", "Lab", "Mib", "Sib", "Fa")

CircleView := struct {
    index : I32 = 0
    next_key : I32 = -1
    timer : I32 = 0
}

circle_key := func(i: I32) returns I32 { return i.mul(7).mod(12) }
circle_sound := proc(key: I32) {
    stop_viewer_sound()
    play_freqs(array(F32, SERIES_C4 * grid_ratio(key, 12)))
}

circle_move := proc(mut c: CircleView, fifth: Bool) {
    root := circle_key(c.index)
    circle_sound(root)
    c.timer = 320
    if fifth { c.index = (c.index + 1) % 12; c.next_key = root + 7 }
    else { c.index = (c.index + 11) % 12; c.next_key = root + 5 }
}

test_fifths_and_fourths := test() {
    sound_enabled = false
    mut c := CircleView()
    mut seen := Array(Bool).new(12)
    for _ in 0..12 {
        root := circle_key(c.index)
        assert(seen[root.to_usize()].not())
        seen[root.to_usize()] = true
        circle_move(c, true)
        assert_eq(I32, c.next_key, root + 7)
        assert_eq(I32, circle_key(c.index), c.next_key.mod(12))
        circle_move(c, false)
        assert_eq(I32, circle_key(c.index), root)
        assert_eq(I32, c.next_key.mod(12), root)
        circle_move(c, true)
    }
    assert_eq(I32, c.index, 0)
    sound_enabled = true
}

test_skip_one_voicings := test() {
    mut s := JustStaff(partials = 32, voices = 2)
    pair := staff_voicing(s, 2)
    assert_eq(F32, pair[0], SERIES_B2 * 3)
    assert_eq(F32, pair[1], SERIES_B2 * 5)
    s.voices = 4
    upper := staff_voicing(s, 25)
    assert_eq(F32, upper[3], SERIES_B2 * 32)
    s.partials = 0
    chord := staff_voicing(s, 0)
    assert_eq(F32, chord[3], SERIES_C4 * 15 / 8)
    sound_enabled = false
    major := array(I32, 0, 2, 4, 5, 7, 9, 11)
    play_degree(true, false, false, major, 6, DYAD_KIND)
    assert_eq(I32, active_keys[0], 11)
    assert_eq(I32, active_keys[1], 14)
    assert_eq(I32, active_keys[2], -1)
    stop_viewer_sound()
    sound_enabled = true
}

circle_frame := proc(mut c: CircleView, fnt: Font, mut lang: USize, dt: I32) {
    if c.next_key.gte(0) {
        c.timer = c.timer - dt
        if c.timer.lte(0) { circle_sound(c.next_key); c.next_key = -1 }
    }
    if series_button(fnt, FOURTH_LABEL[lang], MARGIN, PLAYBACK_ROW_Y, BTN_W, false) { circle_move(c, false) }
    if series_button(fnt, FIFTH_LABEL[lang], MARGIN + BTN_W, PLAYBACK_ROW_Y, BTN_W, false) { circle_move(c, true) }
    for li : USize in 0..3 {
        if series_button(fnt, lang_str(li, 0), MARGIN + BTN_W * 2 + GAP + li.to_i32() * LANG_BTN_W, PLAYBACK_ROW_Y, LANG_BTN_W, lang.eq(li)) { lang = li }
    }
    cx := WINDOW_WIDTH / 2
    cy := WINDOW_HEIGHT / 2
    radius := WINDOW_HEIGHT / 3
    DrawCircleLines(cx, cy, radius.to_f32(), GRAY_128)
    for i : I32 in 0..12 {
        angle : F32 = i.to_f32() * 0.5235987756
        x := cx + (radius.to_f32() * sinf(angle)).to_i64().to_i32()
        y := cy - (radius.to_f32() * sinf(angle + 1.5707963268)).to_i64().to_i32()
        label := format(CIRCLE_NAMES[i.to_usize()], " / ", CIRCLE_SOLFEGE[i.to_usize()])
        if series_button(fnt, label, x - 88, y - BTN_H / 2, 176, c.index.eq(i)) {
            c.index = i; c.next_key = -1; circle_sound(circle_key(i))
        }
    }
    series_text(fnt, format("12-TET: ", CIRCLE_NAMES[c.index.to_usize()]), cx - 60, cy)
}

main := proc() {
    init_window(WINDOW_WIDTH, WINDOW_HEIGHT, "music modes")
    SetTargetFPS(FPS)
    InitAudioDevice()

    fnt := LoadFontEx("img/DejaVuSans.ttf".c_str, 48, Option(ref I32).None, 0)

    // Scale result arrays. Once uses the first 8/6 slots; full span uses 15/16.
    mut sc_chrom := Array(I32).new(MAX_SCALE_NOTES)
    mut sc_diat := Array(I32).new(MAX_SCALE_NOTES)
    mut sc_span := Array(I32).new(MAX_SCALE_NOTES)
    mut sc_acc := Array(I32).new(MAX_SCALE_NOTES)
    mut sc_freq := Array(I64).new(MAX_SCALE_NOTES)
    mut sc_triad := Array(U32).new(SEVEN_NATURAL_COUNT)

    // State. Default is 7 Greek modes.
    mut use_five := false
    mut active_tab : USize = 0
    mut circle := CircleView()
    mut just := JustStaff()
    mut series := SeriesView()
    mut use_nathex := false
    mut seven_sel_diatonic : USize = 0
    mut seven_sel_accidental : I32 = 0
    mut seven_sel_mode : USize = 1
    mut five_sel_diatonic : USize = 0
    mut five_sel_accidental : I32 = 0
    mut five_sel_mode : USize = 1
    mut sel_lang : USize = 0
    mut use_letters := false
    mut chord_mode := false
    mut kind : I32 = -1
    mut full_span := false
    mut need_recompute := true
    mut playing := false
    mut play_idx : USize = 0
    mut play_timer : I64 = 0
    mut clicked_note : I32 = -1
    mut described_note : I32 = -1
    mut clicked_timer : I32 = 0

    TICK_GRAY := GRAY_60

    BTN_ACTIVE := TEAL
    BTN_INACTIVE := GRAY_50
    BUTTON_LABEL := GRAY_220
    TICK_LABEL := GRAY_80

    while !WindowShouldClose() {
        dt : I32 = (GetFrameTime() * 1000).to_i64().to_i32()
        mut five_system := active_five_system(use_five, use_nathex)
        mut note_count := active_note_count(use_five, use_nathex, full_span)

        if IsMouseButtonPressed(0).and(GetMouseY().gte(SYSTEM_ROW_Y)).and(GetMouseY().lt(SYSTEM_ROW_Y + BTN_H)).and(GetMouseX().gte(MARGIN)).and(GetMouseX().lt(MARGIN + SYSTEM_BTN_W * 6)) {
            circle.next_key = -1
            active_tab = ((GetMouseX() - MARGIN) / SYSTEM_BTN_W).to_usize()
            just.playing = false; just.selected = -1
            series.running = false
            series.current = 0
            stop_viewer_sound()
        }

        if need_recompute {
            need_recompute = false
            if five_system {
                five_recompute_scale(five_sel_diatonic, five_sel_accidental, five_sel_mode, note_count, use_nathex, sc_chrom, sc_diat, sc_span, sc_acc, sc_freq)
            } else {
                recompute_seven_scale(seven_sel_diatonic, seven_sel_accidental, seven_sel_mode, note_count,
                                      sc_chrom, sc_diat, sc_span, sc_acc, sc_freq, sc_triad)
            }
        }

        // Input: mouse clicks.
        if IsMouseButtonPressed(0).and(active_tab.lt(3)) {
            mx := GetMouseX()
            my := GetMouseY()

            // System buttons: 7 Greek modes / 5 Global modes / 5 Nathex modes.
            if my.gte(SYSTEM_ROW_Y).and(my.lt(SYSTEM_ROW_Y + BTN_H)) {
                if mx.gte(MARGIN).and(mx.lt(MARGIN + SYSTEM_BTN_W * 3)) {
                    sys_col : USize = (mx - MARGIN).div(SYSTEM_BTN_W).to_usize()
                    if sys_col.lt(3) {
                        use_nathex = sys_col.eq(2)
                        use_five = sys_col.eq(1)
                        five_system = active_five_system(use_five, use_nathex)
                        note_count = active_note_count(use_five, use_nathex, full_span)
                        need_recompute = true
                        playing = false
                        play_idx = 0
                        play_timer = 0
                        clicked_note = -1
                        described_note = -1
                        stop_viewer_sound()
                    }
                }
            }

            root_count := active_root_count(five_system)

            if my.gte(PLAYBACK_ROW_Y).and(my.lt(PLAYBACK_ROW_Y + BTN_H)).and(mx.gte(MARGIN)).and(mx.lt(MARGIN + BTN_W * 4)) {
                chord_mode = mx.gte(MARGIN + BTN_W)
                kind = -1
                if ((mx - MARGIN) / BTN_W).eq(1) { kind = DYAD_KIND }
                if mx.gte(MARGIN + BTN_W * 3) { kind = 0 }
                playing = false
                clicked_note = -1
                described_note = -1
                clicked_timer = 0
                stop_viewer_sound()
            }

            if kind.gte(0).and(my.gte(QUALITY_ROW_Y)).and(my.lt(QUALITY_ROW_Y + BTN_H)).and(mx.gte(MARGIN)).and(mx.lt(MARGIN + FOUR_W * FOUR_COUNT.to_i32())) {
                kind = (mx - MARGIN) / FOUR_W
                playing = false
                if described_note.lt(0) { described_note = 0 }
                clicked_note = described_note
                clicked_timer = 300
                play_degree(true, five_system, use_nathex, sc_chrom, clicked_note.to_usize(), kind)
            }

            // Root buttons: max 7 cols x 3 rows. 5-mode leaves two cols empty.
            if my.gte(NOTE_ROW_Y).and(my.lt(NOTE_ROW_Y + BTN_H * 3)) {
                col : USize = (mx - MARGIN).div(BTN_W).to_usize()
                row := (my - NOTE_ROW_Y) / BTN_H
                if col.lt(root_count).and(row.gte(0)).and(row.lt(3)).and(mx.gte(MARGIN)) {
                    mut acc : I32 = 0
                    if row.eq(0) { acc = -1 }
                    if row.eq(2) { acc = 1 }
                    if five_system {
                        five_sel_diatonic = col
                        five_sel_accidental = acc
                    } else {
                        seven_sel_diatonic = col
                        seven_sel_accidental = acc
                    }
                    need_recompute = true
                    start_scale(playing, play_idx, play_timer)
                }
            }

            // Mode buttons: max 7 cols x 1 row. 5-mode leaves two cols empty.
            if my.gte(MODE_ROW_Y).and(my.lt(MODE_ROW_Y + BTN_H)) {
                col : USize = (mx - MARGIN).div(BTN_W).to_usize()
                if col.lt(root_count).and(mx.gte(MARGIN)) {
                    if five_system {
                        five_sel_mode = col
                    } else {
                        seven_sel_mode = col
                    }
                    need_recompute = true
                    start_scale(playing, play_idx, play_timer)
                }
            }

            if my.gte(RADIO_ROW_Y).and(my.lt(RADIO_ROW_Y + BTN_H)) {
                if mx.gte(MARGIN).and(mx.lt(MARGIN + LANG_BTN_W * 3)) {
                    lang_col : USize = (mx - MARGIN).div(LANG_BTN_W).to_usize()
                    if lang_col.lt(3) { sel_lang = lang_col }
                }
                // Note-label buttons only apply to 7 Greek modes.
                if !five_system {
                    if mx.gte(NOTE_LABEL_ROW_X).and(mx.lt(NOTE_LABEL_ROW_X + NOTE_LABEL_BTN_W * 2)) {
                        label_col : USize = (mx - NOTE_LABEL_ROW_X).div(NOTE_LABEL_BTN_W).to_usize()
                        if label_col.eq(0) { use_letters = false }
                        if label_col.eq(1) { use_letters = true }
                    }
                }
                if mx.gte(SPAN_ROW_X).and(mx.lt(SPAN_ROW_X + SPAN_BTN_W * 2)) {
                    span_col : USize = (mx - SPAN_ROW_X).div(SPAN_BTN_W).to_usize()
                    if span_col.lt(2) {
                        full_span = span_col.eq(1)
                        note_count = active_note_count(use_five, use_nathex, full_span)
                        need_recompute = true
                        playing = false
                        play_idx = 0
                        play_timer = 0
                        clicked_note = -1
                        described_note = -1
                        stop_viewer_sound()
                    }
                }
            }

            // Click on pentagram notes.
            for ci : USize in 0..note_count {
                cnx := note_x(ci, note_count)
                voices := voice_count_for(chord_mode, kind)
                for voice : USize in 0..voices {
                    tone := staff_tone(five_system, use_nathex, ci, voice, kind, sc_chrom, sc_diat, sc_span, sc_acc)
                    cny := staff_y(five_system, tone.name, tone.register)
                    hit := NOTE_R * 2
                    if (mx - cnx).abs().lt(hit).and((my - cny).abs().lt(hit)) {
                        playing = false
                        play_degree(chord_mode, five_system, use_nathex, sc_chrom, ci, kind)
                        clicked_note = ci.to_i32()
                        clicked_timer = 300
                        break
                    }
                }
            }

            // Drawing and hit testing share the same expanded chord keyboard.
            last_key := piano_last_key(five_system, full_span, chord_mode, sc_chrom, note_count, kind, use_nathex)
            piano_key := piano_hit_key(five_system, last_key, mx, my)
            if piano_key.gte(0) {
                playing = false
                audition_key(piano_key, chord_mode, five_system, use_nathex, note_count, sc_chrom, clicked_note, clicked_timer, kind)
                if clicked_note.lt(0) { described_note = -1 }
            }
        }

        // Input: keyboard piano keys matching examples/piano.til C4..B5.
        for ki : USize in 0..PIANO_C4_KEY_COUNT {
            if active_tab.gte(3) { break }
            if IsKeyPressed(PIANO_KEYCODES[PIANO_C4_KEY_OFFSET + ki]) {
                playing = false
                audition_key(ki.to_i32(), chord_mode, five_system, use_nathex, note_count, sc_chrom, clicked_note, clicked_timer, kind)
                if clicked_note.lt(0) { described_note = -1 }
            }
        }

        if need_recompute {
            need_recompute = false
            stop_viewer_sound()
            clicked_note = -1
            described_note = -1
            clicked_timer = 0
            if five_system {
                five_recompute_scale(five_sel_diatonic, five_sel_accidental, five_sel_mode, note_count, use_nathex, sc_chrom, sc_diat, sc_span, sc_acc, sc_freq)
            } else {
                recompute_seven_scale(seven_sel_diatonic, seven_sel_accidental, seven_sel_mode, note_count,
                                      sc_chrom, sc_diat, sc_span, sc_acc, sc_freq, sc_triad)
            }
            note_count = active_note_count(use_five, use_nathex, full_span)
        }

        if clicked_timer.gt(0) {
            clicked_timer = clicked_timer - dt
            if clicked_timer.lte(0) {
                clicked_note = -1
                stop_viewer_sound()
            }
        }

        if active_tab.gte(3) { playing = false; clicked_timer = 0; clicked_note = -1 }
        if playing {
            play_timer = play_timer + dt.cast(I64)
            if play_timer.gte(300) {
                play_timer = 0
                if play_idx.lt(note_count) {
                    play_degree(chord_mode, five_system, use_nathex, sc_chrom, play_idx, kind)
                    clicked_note = play_idx.to_i32()
                    clicked_timer = 300
                    play_idx = play_idx + 1
                } else {
                    playing = false
                }
            }
        }

        // Draw.
        if clicked_note.gte(0) { described_note = clicked_note }
        BeginDrawing()
        ClearBackground(BLACK)

        // -- System buttons --
        for si : USize in 0..6 {
            sx := MARGIN + si.to_i32() * SYSTEM_BTN_W
            mut s_color := BTN_INACTIVE
            if si.eq(active_tab) { s_color = BTN_ACTIVE }
            DrawRectangle(sx, SYSTEM_ROW_Y, SYSTEM_BTN_W - 2, BTN_H - 2, s_color)
            mut slabel := "7 Greek modes"
            if si.eq(1) { slabel = "5 Global modes" }
            if si.eq(2) { slabel = "5 Nathex modes" }
            if si.eq(3) { slabel = SERIES_TITLES[sel_lang].clone() }
            if si.eq(4) { slabel = JUST_TITLES[sel_lang].clone() }
            if si.eq(5) { slabel = CIRCLE_TITLE[sel_lang].clone() }
            DrawTextEx(fnt, slabel.c_str, Vector2(x = (sx + PAD_X).to_f32(), y = (SYSTEM_ROW_Y + PAD_Y).to_f32()), FONT_SM.to_f32(), 1, BUTTON_LABEL)
        }

        if active_tab.gte(3) {
            if active_tab.eq(3) { series_frame(series, fnt, sel_lang, dt) }
            else if active_tab.eq(4) { just_frame(just, fnt, sel_lang, dt) }
            else { circle_frame(circle, fnt, sel_lang, dt) }
            EndDrawing()
            continue
        }
        root_count := active_root_count(five_system)
        // -- Note / Triad radio buttons, shared by all three systems --
        for choice : USize in 0..4 {
            x := MARGIN + choice.to_i32() * BTN_W
            mut color := BTN_INACTIVE
            if choice.eq(voice_count_for(chord_mode, kind) - 1) { color = BTN_ACTIVE }
            DrawRectangle(x, PLAYBACK_ROW_Y, BTN_W - 2, BTN_H - 2, color)
            ref label : Str = voicing_label(choice, sel_lang)
            DrawTextEx(fnt, label.c_str, Vector2(x = (x + PAD_X).to_f32(), y = (PLAYBACK_ROW_Y + PAD_Y).to_f32()), FONT.to_f32(), 1, BUTTON_LABEL)
        }
        if chord_mode.and(described_note.gte(0)) {
            description := chord_description(five_system, use_nathex, use_letters, sel_lang,
                described_note.to_usize(), sc_chrom, sc_diat, sc_span, sc_acc, sc_triad, kind)
            DrawTextEx(fnt, description.c_str, Vector2(x = (MARGIN + BTN_W * 4 + GAP).to_f32(), y = (PLAYBACK_ROW_Y + PAD_Y).to_f32()), FONT_SM.to_f32(), 1, BUTTON_LABEL)
        }
        if kind.gte(0) {
            ref names : Array(Str) = FOUR_NAMES[sel_lang]
            for q : USize in 0..FOUR_COUNT {
                x := MARGIN + q.to_i32() * FOUR_W
                mut color := BTN_INACTIVE
                if kind.eq(q.to_i32()) { color = BTN_ACTIVE }
                DrawRectangle(x, QUALITY_ROW_Y, FOUR_W - 2, BTN_H - 2, color)
                mut label := FOUR_SYMBOLS[q].clone()
                if q.eq(0) { label = names[q].clone() }
                DrawTextEx(fnt, label.c_str, Vector2(x = (x + PAD_X).to_f32(), y = (QUALITY_ROW_Y + PAD_Y).to_f32()), FONT_SM.to_f32(), 1, BUTTON_LABEL)
            }
        }
        mut sel_diatonic := seven_sel_diatonic
        mut sel_accidental := seven_sel_accidental
        mut sel_mode := seven_sel_mode
        if five_system {
            sel_diatonic = five_sel_diatonic
            sel_accidental = five_sel_accidental
            sel_mode = five_sel_mode
        }

        // -- Root buttons --
        for row : USize in 0..3 {
            for col : USize in 0..root_count {
                bx := MARGIN + col.to_i32() * BTN_W
                by := NOTE_ROW_Y + row.to_i32() * BTN_H
                mut b_color := BTN_INACTIVE
                mut acc_match := 0
                if row.eq(0) { acc_match = -1 }
                if row.eq(1) { acc_match = 0 }
                if row.eq(2) { acc_match = 1 }
                if col.eq(sel_diatonic).and(acc_match.eq(sel_accidental.cast(I64))) {
                    b_color = BTN_ACTIVE
                }
                DrawRectangle(bx, by, BTN_W - 2, BTN_H - 2, b_color)

                ref ln : Str = active_note_name(five_system, use_letters, col)
                mut label := ln.clone()
                if five_system {
                    if row.eq(0) { label = format("b", ln) }
                    if row.eq(2) { label = format("#", ln) }
                } else {
                    if row.eq(0) { label = format(ln, "b") }
                    if row.eq(2) { label = format(ln, "#") }
                }
                DrawTextEx(fnt, label.c_str, Vector2(x = (bx + PAD_X).to_f32(), y = (by + PAD_Y).to_f32()), FONT.to_f32(), 1, BUTTON_LABEL)
            }
        }

        // -- Mode buttons --
        for mi : USize in 0..root_count {
            mbx := MARGIN + mi.to_i32() * BTN_W
            mby := MODE_ROW_Y
            mut mb_color := BTN_INACTIVE
            if mi.eq(sel_mode) { mb_color = BTN_ACTIVE }
            DrawRectangle(mbx, mby, BTN_W - 2, BTN_H - 2, mb_color)

            mut mlabel := ""
            if five_system {
                ref ml : Str = five_mode_name(sel_lang, mi)
                mlabel = ml.clone()
            } else {
                ref ml : Str = lang_str(sel_lang, mi + 1)
                mlabel = ml.clone()
            }
            DrawTextEx(fnt, mlabel.c_str, Vector2(x = (mbx + PAD_X).to_f32(), y = (mby + PAD_Y).to_f32()), FONT.to_f32(), 1, BUTTON_LABEL)
        }

        // -- Language buttons --
        for li : USize in 0..3 {
            lx := MARGIN + li.to_i32() * LANG_BTN_W
            mut lr_color := GRAY_40
            if li.eq(sel_lang) { lr_color = BTN_ACTIVE }
            DrawRectangle(lx, RADIO_ROW_Y, LANG_BTN_W - 2, BTN_H - 2, lr_color)
            ref ll : Str = lang_str(li, 0)
            DrawTextEx(fnt, ll.c_str, Vector2(x = (lx + PAD_X).to_f32(), y = (RADIO_ROW_Y + PAD_Y).to_f32()), FONT.to_f32(), 1, BUTTON_LABEL)
        }

        // -- Note-label buttons, only for 7 Greek modes --
        if !five_system {
            for ni : USize in 0..2 {
                nx := NOTE_LABEL_ROW_X + ni.to_i32() * NOTE_LABEL_BTN_W
                mut nr_color := GRAY_40
                if ni.eq(0).and(!use_letters) { nr_color = BTN_ACTIVE }
                if ni.eq(1).and(use_letters) { nr_color = BTN_ACTIVE }
                DrawRectangle(nx, RADIO_ROW_Y, NOTE_LABEL_BTN_W - 2, BTN_H - 2, nr_color)
                mut nlabel := "Solfege"
                if ni.eq(1) { nlabel = "Letters" }
                DrawTextEx(fnt, nlabel.c_str, Vector2(x = (nx + PAD_X).to_f32(), y = (RADIO_ROW_Y + PAD_Y).to_f32()), FONT.to_f32(), 1, BUTTON_LABEL)
            }
        }

        // -- Span buttons --
        for spi : USize in 0..2 {
            spx := SPAN_ROW_X + spi.to_i32() * SPAN_BTN_W
            mut sp_color := GRAY_40
            if spi.eq(0).and(!full_span) { sp_color = BTN_ACTIVE }
            if spi.eq(1).and(full_span) { sp_color = BTN_ACTIVE }
            DrawRectangle(spx, RADIO_ROW_Y, SPAN_BTN_W - 2, BTN_H - 2, sp_color)
            mut sp_label := "Once"
            if spi.eq(1) { sp_label = "2 full octaves" }
            DrawTextEx(fnt, sp_label.c_str, Vector2(x = (spx + PAD_X).to_f32(), y = (RADIO_ROW_Y + PAD_Y).to_f32()), FONT.to_f32(), 1, BUTTON_LABEL)
        }

        // -- Pentagram --
        for sli : USize in 0..5 {
            line_pos := sli.to_i32() * 2
            ly := STAFF_BASE_Y - line_pos * STAFF_SP
            DrawRectangle(STAFF_X, ly, STAFF_W, 2, GRAY_100)
        }

        for ri : USize in 0..9 {
            ry := STAFF_BASE_Y - ri.to_i32() * STAFF_SP
            rd := (ri + 2) % root_count
            ref rn : Str = active_note_name(five_system, use_letters, rd)
            DrawTextEx(fnt, rn.c_str, Vector2(x = (STAFF_X - MARGIN * 2).to_f32(), y = (ry - FONT_SM / 2).to_f32()), FONT_SM.to_f32(), 1, TICK_LABEL)
            DrawTextEx(fnt, rn.c_str, Vector2(x = (STAFF_X + STAFF_W + MARGIN / 2).to_f32(), y = (ry - FONT_SM / 2).to_f32()), FONT_SM.to_f32(), 1, TICK_LABEL)
            if ri.mod(2).eq(1) {
                DrawRectangle(STAFF_X - NOTE_R * 2, ry, NOTE_R * 2, 1, TICK_GRAY)
                DrawRectangle(STAFF_X + STAFF_W, ry, NOTE_R * 2, 1, TICK_GRAY)
            }
        }

        for dni : USize in 0..note_count {
            voices := voice_count_for(chord_mode, kind)
            for voice : USize in 0..voices {
                draw_note(use_five, use_nathex, use_letters, dni, note_count, sc_diat, sc_span, sc_acc, sc_triad,
                          playing, play_idx, clicked_note, voice, fnt, sc_chrom, kind)
            }
        }

        last_key := piano_last_key(five_system, full_span, chord_mode, sc_chrom, note_count, kind, use_nathex)
        draw_piano(five_system, last_key, fnt)

        mut hint := "7 Greek modes: click note + mode to play scale; piano keys E-M play C4-B5"
        if use_five {
            hint = "5 Global modes: click root spelling + mode to play scale; final ca is mouse-only"
        }
        if use_nathex {
            hint = "5 Nathex modes: separate 8-step doubling table, ca1=do1"
        }
        if chord_mode { hint = CHORD_HINTS[sel_lang].clone() }
        if chord_mode {
            for lang : USize in 0..3 {
                mut name := TRIAD_LABELS[lang].clone()
                if kind.eq(DYAD_KIND) { name = format(DYAD_LABELS[lang], ": 1-3") }
                else if kind.gte(0) {
                    ref names : Array(Str) = FOUR_NAMES[lang]
                    name = names[kind.to_usize()].clone()
                } else if described_note.gte(0).and(five_system.not()) {
                    ref names : Array(Str) = QUALITY_LABELS[lang]
                    name = format(name, ": ", names[sc_triad[described_note.to_usize() % root_count].cast(USize)])
                } else if five_system {
                    name = format(name, ": ", DEGREE_LABELS[lang])
                }
                legend := format(lang_str(lang, 0), ": ", name)
                DrawTextEx(fnt, legend.c_str, Vector2(x = (MARGIN + (WINDOW_WIDTH - MARGIN * 2) / 3 * lang.to_i32()).to_f32(), y = HINT_Y.to_f32()), FONT_SM.to_f32(), 1, BUTTON_LABEL)
            }
        } else {
            DrawTextEx(fnt, hint.c_str, Vector2(x = MARGIN.to_f32(), y = HINT_Y.to_f32()), FONT.to_f32(), 1, TICK_LABEL)
        }

        EndDrawing()
    }

    UnloadFont(fnt)
    stop_viewer_sound()
    CloseAudioDevice()
    CloseWindow()
}

test_harmonic_series_reference := test() {
    assert_eq(I32, nearest_step(partial_ratio(13, 4), 8), nearest_step(partial_ratio(14, 4), 8))
    assert_eq(I32, (series_ratio(0) * 4).to_i64().to_i32(), 6)
    assert_eq(I32, (series_ratio(1) * 4).to_i64().to_i32(), 8)
    assert_eq(I32, (series_ratio(2) * 4).to_i64().to_i32(), 10)
    assert_eq(I32, (series_ratio(3) * 4).to_i64().to_i32(), 16)
    assert_eq(I32, nearest_step(partial_ratio(6, 4), 12), 7)
    assert_eq(I32, nearest_step(partial_ratio(6, 4), 8), 5)
    assert_eq(I32, nearest_step(partial_ratio(6, 4), 16), 9)
    assert_eq(Str, series_note_name(9, 16), "#fit4")
    // Harmonic 11 (relative to partial 8): the two finer grids pick
    // different pitches, 550 and 562.5 cents above the octave boundary.
    assert_eq(I32, nearest_step(partial_ratio(11, 8), 24), 11)
    assert_eq(I32, nearest_step(partial_ratio(11, 8), 32), 15)
    assert_eq(Str, series_note_name(11, 24), "Fat4")
    assert_eq(Str, series_note_name(15, 32), "fi4+3/4")
    for n : I32 in SERIES_TUNINGS {
        assert_eq(F32, grid_ratio(nearest_step(partial_ratio(16, 4), n), n), 4)
    }
}

test_music_triad_voicing := test() {
    c_major := array(I32, 0, 2, 4, 5, 7, 9, 11)
    assert_eq(I32, scale_degree_key(false, c_major, 0), 0)
    assert_eq(I32, scale_degree_key(false, c_major, 2), 4)
    assert_eq(I32, scale_degree_key(false, c_major, 4), 7)
    // B diminished must rise through D5 and F5, not wrap down to D4/F4.
    assert_eq(I32, scale_degree_key(false, c_major, 6), 11)
    assert_eq(I32, scale_degree_key(false, c_major, 8), 14)
    assert_eq(I32, scale_degree_key(false, c_major, 10), 17)
    assert_eq(U32, seven_triad_type(c_major, 6), 2)
    europe := array(I32, 0, 2, 3, 5, 7)
    assert_eq(I32, scale_degree_key(true, europe, 4), 7)
    assert_eq(I32, scale_degree_key(true, europe, 6), 10)
    assert_eq(I32, scale_degree_key(true, europe, 8), 13)
    assert_eq(I32, scale_degree_key(true, europe, 15), 24)
    assert_eq(I32, scale_degree_key(true, europe, 19), 31)
}

test_music_chord_languages := test() {
    mut chrom := Array(I32).new(MAX_SCALE_NOTES)
    mut diat := Array(I32).new(MAX_SCALE_NOTES)
    mut span := Array(I32).new(MAX_SCALE_NOTES)
    mut acc := Array(I32).new(MAX_SCALE_NOTES)
    mut freq := Array(I64).new(MAX_SCALE_NOTES)
    mut triad := Array(U32).new(SEVEN_NATURAL_COUNT)
    recompute_seven_scale(0, 0, 1, 8, chrom, diat, span, acc, freq, triad)
    assert_eq(Str, chord_description(false, false, false, 0, 6, chrom, diat, span, acc, triad),
        "Si4 + Re5 + Fa5 | Diminuta | passos 0,3,6 (12-TET)")
    assert_eq(Str, chord_description(false, false, false, 1, 6, chrom, diat, span, acc, triad),
        "Si4 + Re5 + Fa5 | Disminuida | pasos 0,3,6 (12-TET)")
    assert_eq(Str, chord_description(false, false, true, 2, 6, chrom, diat, span, acc, triad),
        "B4 + D5 + F5 | Diminished | steps 0,3,6 (12-TET)")
    five_recompute_scale(0, 0, 1, 6, true, chrom, diat, span, acc, freq)
    assert_eq(Str, chord_description(true, true, false, 2, 4, chrom, diat, span, acc, triad),
        "lu4 + de5 + go5 | Degrees 1-3-5 | steps 0,3,6 (8-TET)")
}

test_music_chord_ranges := test() {
    mut chrom := Array(I32).new(MAX_SCALE_NOTES)
    mut diat := Array(I32).new(MAX_SCALE_NOTES)
    mut span := Array(I32).new(MAX_SCALE_NOTES)
    mut acc := Array(I32).new(MAX_SCALE_NOTES)
    mut freq := Array(I64).new(MAX_SCALE_NOTES)
    mut triad := Array(U32).new(SEVEN_NATURAL_COUNT)
    // Exercise every mode/root/spelling/span, including the last chord.
    for system : USize in 0..3 {
        five := system.gt(0)
        nathex := system.eq(2)
        count := active_root_count(five)
        for root : USize in 0..count {
            for accidental : I32 in array(I32, -1, 0, 1) {
                for mode_idx : USize in 0..count {
                    for full : Bool in array(Bool, false, true) {
                        notes := active_note_count(system.eq(1), nathex, full)
                        if five {
                            five_recompute_scale(root, accidental, mode_idx, notes, nathex, chrom, diat, span, acc, freq)
                        } else {
                            recompute_seven_scale(root, accidental, mode_idx, notes, chrom, diat, span, acc, freq, triad)
                        }
                        last := piano_last_key(five, full, true, chrom, notes)
                        whites := piano_white_count(five, last)
                        width := STAFF_W / whites.to_i32()
                        for d : USize in 0..notes {
                            assert_eq(I32, scale_degree_key(five, chrom, d), chrom[d])
                            a := scale_degree_key(five, chrom, d)
                            b := scale_degree_key(five, chrom, d + 2)
                            c := scale_degree_key(five, chrom, d + 4)
                            assert(a.lt(b).and(b.lt(c)))
                            assert(c.lte(last))
                            assert(viewer_freq(nathex, c).lte(PRACTICAL_MAX_FREQ))
                            // All upper voices fit above the staff controls.
                            idx := (d + 4) % count
                            register := span[idx] + ((d + 4) / count).to_i32()
                            assert(staff_y(five, diat[idx], register).gt(BUTTONS_END_Y + NOTE_R))
                        }
                        for white : USize in 0..whites {
                            key := piano_natural(five, white)
                            x := STAFF_X + white.to_i32() * width + width / 2
                            assert_eq(I32, piano_hit_key(five, last, x, PIANO_Y + WHITE_H - 5), key)
                            if (white + 1).lt(whites) {
                                if (piano_natural(five, white + 1) - key).eq(2) {
                                    bx := STAFF_X + (white + 1).to_i32() * width
                                    assert_eq(I32, piano_hit_key(five, last, bx, PIANO_Y + 5), key + 1)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    assert(HINT_Y + FONT < WINDOW_HEIGHT)
}

test_music_chord_selection := test() {
    sound_enabled = false
    c_major := array(I32, 0, 2, 4, 5, 7, 9, 11, 12)
    mut selected : I32 = -1
    mut timer : I32 = 0
    audition_key(11, true, false, false, 8, c_major, selected, timer)
    assert_eq(I32, selected, 6)
    assert_eq(I32, active_keys[0], 11)
    assert_eq(I32, active_keys[1], 14)
    assert_eq(I32, active_keys[2], 17)
    audition_key(1, true, false, false, 8, c_major, selected, timer)
    assert_eq(I32, selected, -1)
    assert_eq(I32, active_keys[0], 1)
    assert_eq(I32, active_keys[1], -1)
    assert_eq(I32, active_keys[2], -1)
    audition_key(0, false, false, false, 8, c_major, selected, timer)
    assert_eq(I32, active_keys[0], 0)
    assert_eq(I32, active_keys[1], -1)
    stop_viewer_sound()
    assert_eq(I32, active_keys[0], -1)
    sound_enabled = true
}

test_four_note_selection := test() {
    sound_enabled = false
    major := array(I32, 0, 2, 4, 5, 7, 9, 11, 12)
    // B-D-F-A is the diatonic half-diminished seventh in C major.
    play_degree(true, false, false, major, 6, 0)
    assert_eq(I32, active_keys[0], 11)
    assert_eq(I32, active_keys[1], 14)
    assert_eq(I32, active_keys[2], 17)
    assert_eq(I32, active_keys[3], 21)
    play_degree(true, false, false, major, 6, 5)
    assert_eq(I32, active_keys[3], 20)
    europe := array(I32, 0, 2, 3, 5, 7)
    play_degree(true, true, true, europe, 0, 0)
    assert_eq(I32, active_keys[3], 10)
    play_degree(true, true, true, europe, 0, 1)
    assert_eq(I32, active_keys[3], 7)
    play_degree(true, true, true, europe, 0)
    assert_eq(I32, active_keys[3], -1)
    stop_viewer_sound()
    sound_enabled = true
}

test_music_chord_mix := test() {
    // Project a 0.1-second signal onto three component frequencies and an
    // absent frequency. This detects lost/replaced voices, not just peak gain.
    freqs := array(F32, 200, 300, 500)
    probes := array(F32, 200, 300, 500, 700)
    mut energy := array(F32, 0, 0, 0, 0)
    for i : USize in 0..4410 {
        phase : F32 = 6.283185307179586 * i.to_f32() / 44100
        sample := mixed_sample(freqs, phase)
        assert(sample.gte(-0.301).and(sample.lte(0.301)))
        for p : USize in 0..4 {
            energy[p] = energy[p] + sample * sinf(probes[p] * phase)
        }
    }
    for p : USize in 0..3 {
        assert(energy[p].gt(220).and(energy[p].lt(221)))
    }
    assert(energy[3].gt(-0.1).and(energy[3].lt(0.1)))
}
