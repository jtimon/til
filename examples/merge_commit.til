mode cli

import("../src/core/io")
import("../src/core/str")
import("../src/std/sys")
import("../src/std/file")

run := proc(cmd: Str) returns I64 {
    pid := spawn_cmd(cmd)
    return wait_cmd(pid)
}

capture := proc(cmd: Str) returns Str {
    _mk := run("mkdir -p tmp >/dev/null 2>&1")
    if _mk.lt(0) { }
    tmpf := format("tmp/_mc_", clock_ms().to_str())
    pid := spawn_cmd(format(cmd, " > ", tmpf, " 2>&1"))
    _ec := wait_cmd(pid)
    content := File.readfile(tmpf)
    return content
}

// How much of the build log to show when the suite fails.
LOG_TAIL_LINES : USize = 40
LOG_MAX_MARKED : USize = 40

// Lines carrying a failure marker, up to LOG_MAX_MARKED of them.
//
// This scans line by line with unsafe_get rather than find()-ing over the
// remaining text: the old reporter called `remaining.find("FAIL")` on the
// whole tail of the log, so a single hit anywhere dumped the entire log,
// and -- far worse -- a failure whose output says neither "FAIL" nor
// "error:" (a mismatch, a make error, a panic) matched nothing and exited
// with "Tests: FAILED" as the only output.
collect_marked_lines := func(log: Str) returns Str {
    mut out := ""
    mut found : USize = 0
    mut start : USize = 0
    mut i : USize = 0
    while i.lt(log.len()) {
        ref ch : I8 = log.unsafe_get(i)
        if ch.eq('\n') {
            line := log.substr(start, i.sub(start))
            if line.find("FAIL").neq(-1).or(line.find("error:").neq(-1))
                .or(line.find("Error ").neq(-1)).or(line.find("panic").neq(-1))
                .or(line.find("mismatch").neq(-1)).or(line.find("Assertion").neq(-1)) {
                if found.lt(LOG_MAX_MARKED) {
                    out = format(out, line, "\n")
                    found = found.add(1)
                }
            }
            start = i.add(1)
        }
        i = i.add(1)
    }
    if found == 0 { return "" }
    return out
}

// The last `n` lines of `log`. Walks backwards from the end so a multi-MB
// build log costs one pass, not one substr per line.
tail_lines := func(log: Str, n: USize) returns Str {
    if log.len() == 0 { return "" }
    mut seen : USize = 0
    mut i : USize = log.len()
    while i.gt(0) {
        i = i.sub(1)
        ref ch : I8 = log.unsafe_get(i)
        if ch.eq('\n') {
            seen = seen.add(1)
            if seen.gt(n) {
                return log.substr(i.add(1), log.len().sub(i).sub(1))
            }
        }
    }
    return log.clone()
}

count_subject_end := func(s: Str) returns USize {
    nl := s.find("\n")
    if nl.eq(-1) { return s.len() }
    return nl.to_usize()
}

trim_spaces := func(s: Str) returns Str {
    mut start : USize = 0; mut end : USize = s.len()
    while start.lt(end) {
        c := s.substr(start, 1)
        if c.eq(" ").not() { break }
        start++
    }
    while end.gt(start) {
        c := s.substr(end.sub(1), 1)
        if c.eq(" ").not() { break }
        end--
    }
    return s.substr(start, end.sub(start)).clone()
}

trim_leading_whitespace := func(s: Str) returns Str {
    mut start : USize = 0
    while start.lt(s.len()) {
        c := s.substr(start, 1)
        if c.eq(" ").or(c.eq("\n")).or(c.eq("\r")).or(c.eq("\t")).not() {
            break
        }
        start++
    }
    return s.substr(start, s.len().sub(start)).clone()
}

trim_quotes := func(s: Str) returns Str {
    mut start : USize = 0; mut end : USize = s.len()
    while start.lt(end) {
        c := s.substr(start, 1)
        if c.eq("\"").or(c.eq("'")).not() { break }
        start++
    }
    while end.gt(start) {
        c := s.substr(end.sub(1), 1)
        if c.eq("\"").or(c.eq("'")).not() { break }
        end--
    }
    return s.substr(start, end.sub(start)).clone()
}

main := proc(args: ..Str) {
    mut hash := "HEAD"
    if args.len().gte(1) {
        hash = args[0].clone()
    }

    // ---- Step 2: capture commit message + stat ----
    msg := capture(format("git show ", hash.clone(), " --format=\"%B\" --no-patch"))
    File.writefile("tmp/commit_msg.txt", msg)

    stat := capture(format("git show ", hash.clone(), " --stat"))
    print(stat.clone())
    print("\n")

    clean_msg := trim_leading_whitespace(msg)
    raw_subject := clean_msg.substr(0, count_subject_end(clean_msg)).clone()
    if clean_msg.len().lt(0) { }
    subject := trim_quotes(trim_spaces(raw_subject))

    mut test_target := "make test"
    mut is_two_pass := false
    if subject.starts_with("Two-pass:") { is_two_pass = true }
    if subject.starts_with("Two-Pass:") { is_two_pass = true }
    if subject.starts_with("two-pass:") { is_two_pass = true }
    if subject.starts_with("Two-pass: ") { is_two_pass = true }
    if subject.starts_with("Two-Pass: ") { is_two_pass = true }
    if subject.starts_with("two-pass: ") { is_two_pass = true }
    if is_two_pass { test_target = "make test_two_pass" }

    // ---- Step 4: soft reset + revert totals ----
    run("git reset --soft HEAD~1")
    run("git restore --staged doc/totals.csv img/totals.svg")
    run("git restore doc/totals.csv img/totals.svg")

    // ---- Step 5: full test suite ----
    print("Running: make clean && ", test_target, "\n")
    run(format(
        "bash -c 'make clean > tmp/build.log 2>&1 && ",
        test_target, " >> tmp/build.log 2>&1'"))

    build_log := File.readfile("tmp/build.log")
    if build_log.find("all tests passed").eq(-1) {
        eprint_single("Tests: FAILED\n")
        marked := collect_marked_lines(build_log)
        if marked.len() > 0 {
            eprint_single("\n--- lines mentioning a failure ---\n")
            eprint_single(marked)
        } else {
            eprint_single("\n(no line mentions FAIL/error:/panic/mismatch)\n")
        }
        // Always show the tail, even when a marker matched: the marked lines
        // say WHAT broke, the tail says where the run stopped. Reporting only
        // the markers is how a failure with no marker printed nothing at all.
        eprint_single("\n--- last 40 lines of tmp/build.log ---\n")
        eprint_single(tail_lines(build_log, LOG_TAIL_LINES))
        eprint_single("\n(full log: tmp/build.log)\n")
        exit(1)
    }
    print("Tests: PASSED\n")

    // ---- Step 6: commit ----
    run("git add -A")
    ec := run(format("git commit -F tmp/commit_msg.txt > tmp/commit.log 2>&1"))
    if ec.neq(0) {
        eprint_single("Commit: FAILED\n")
        eprint_single(File.readfile("tmp/commit.log"))
        exit(1)
    }

    print("\n=== Committed. Review the diff for correctness. ===\n")
}
