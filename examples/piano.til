mode gui
import("../src/modes/gui", Colors.*)

import("lib/music")

// Playable piano with scrolling piano roll
// QWERTY keyboard maps to 3 octaves (C3-B5).
// Solfege display is the default. Letters changes only labels. Hextaves keeps
// the same sounds and physical key mapping but redraws labels and key layout.
// Nathex keeps the key mapping and plays the separate 8-step doubling table.

WINDOW_WIDTH : I32 = 1920
WINDOW_HEIGHT : I32 = 1080
FPS : I32 = 60
NUM_KEYS : USize = PIANO_KEY_COUNT
MAX_NOTES : USize = 256
STANDARD_WHITE_KEYS : USize = 21
HEXTAVE_WHITE_KEYS : USize = 23
HEXTAVE_DRAW_CYCLES : USize = 5

// Layout
MARGIN : F32 = 40
ROLL_H : I32 = WINDOW_HEIGHT / 2
PIANO_Y : I32 = WINDOW_HEIGHT - WINDOW_HEIGHT / 3
WHITE_H : I32 = WINDOW_HEIGHT - PIANO_Y
BLACK_H : I32 = WHITE_H * 2 / 3
FONT : F32 = 20
SCROLL_SPEED : I32 = 300
TOGGLE_X : I32 = 40
TOGGLE_Y : I32 = PIANO_Y - 70
TOGGLE_W : I32 = 160
TOGGLE_H : I32 = 34
TOGGLE_GAP : I32 = 10
SONG_BTN_X : I32 = TOGGLE_X + (TOGGLE_W + TOGGLE_GAP) * 5
SONG_BTN_W : I32 = 240
MAP_BTN_X : I32 = SONG_BTN_X + SONG_BTN_W + TOGGLE_GAP
PUZZLE_X : I32 = MAP_BTN_X + SONG_BTN_W + TOGGLE_GAP
PUZZLE_Y : I32 = TOGGLE_Y - TOGGLE_H - TOGGLE_GAP

PuzzleQuality := struct {
    name : Str = ""
    middle : USize = 0
    upper : USize = 0
}
PUZZLE_QUALITIES := array(PuzzleQuality,
    PuzzleQuality(name="Minor", middle=3, upper=7),
    PuzzleQuality(name="Major", middle=4, upper=7),
    PuzzleQuality(name="Diminished", middle=3, upper=6),
    PuzzleQuality(name="Augmented", middle=4, upper=8),
    PuzzleQuality(name="Sus2", middle=2, upper=7),
    PuzzleQuality(name="Sus4", middle=5, upper=7))

// Grade the held pitch classes, independent of doubling, octave or inversion.
puzzle_matches := func(held: Array(I32), root: USize, quality: PuzzleQuality) returns Bool {
    mut found := Array(Bool).new(12)
    for i : USize in 0..held.len() {
        if held[i].eq(0) { continue }
        interval := (i + 12 - root % 12) % 12
        if interval.eq(0).or(interval.eq(quality.middle)).or(interval.eq(quality.upper)).not() { return false }
        found[interval] = true
    }
    return found[0].and(found[quality.middle]).and(found[quality.upper])
}

puzzle_note_name := func(i: USize, mode: I32) returns Str {
    if mode.eq(DISPLAY_MODE_LETTERS) { return LETTER_NOTE_NAMES[i % 12].clone() }
    return SOLFEGE_CHROMATIC_NAMES[i % 12].clone()
}

puzzle_check := func(held: Array(I32), root: USize, quality: PuzzleQuality, mode: I32) returns Str {
    mut seen := Array(Bool).new(12)
    mut notes := ""
    for i : USize in 0..held.len() {
        if held[i].eq(0).or(seen[i % 12]) { continue }
        seen[i % 12] = true
        if notes.is_empty().not() { notes = format(notes, " - ") }
        notes = format(notes, puzzle_note_name(i, mode))
    }
    if notes.is_empty() { return "Play your chord first, then release it and press Check." }
    if puzzle_matches(held, root, quality) { return format("Correct! You played ", notes, ". Choose New root to try another.") }
    return format("Last check: you played ", notes, ". Listen again, then try changing one note.")
}

// Snapshot on a new note, not on release: lifting fingers one at a time
// must not turn the last chord into its last remaining note.
remember_puzzle_chord := func(mut saved: Array(I32), down: Array(I32), previous: Array(I32)) {
    for i : USize in 0..down.len() {
        if down[i].eq(1).and(previous[i].eq(0)) {
            for k : USize in 0..down.len() { saved[k] = down[k].clone() }
            break
        }
    }
}

test_puzzle_release_before_check := test() {
    mut saved := array(I32, 0, 0, 0)
    silent := array(I32, 0, 0, 0)
    chord := array(I32, 1, 1, 1)
    tail := array(I32, 0, 1, 0)
    remember_puzzle_chord(saved, chord, silent)
    remember_puzzle_chord(saved, tail, chord)
    remember_puzzle_chord(saved, silent, tail)
    for k : USize in 0..3 { assert_eq(I32, saved[k], 1) }
    remember_puzzle_chord(saved, tail, silent)
    for k : USize in 0..3 { assert_eq(I32, saved[k], tail[k]) }
}

test_puzzle_minor := test() {
    mut held := Array(I32).new(NUM_KEYS)
    held[5] = 1; held[9] = 1; held[14] = 1; held[26] = 1
    assert(puzzle_matches(held, 14, PUZZLE_QUALITIES[0]))
    assert(puzzle_matches(held, 14, PUZZLE_QUALITIES[1]).not())
    held[6] = 1
    assert(puzzle_matches(held, 14, PUZZLE_QUALITIES[0]).not())
    held[5] = 0
    assert(puzzle_matches(held, 14, PUZZLE_QUALITIES[1]))
    held[9] = 0
    assert(puzzle_matches(held, 14, PUZZLE_QUALITIES[1]).not())
}

// Four-row QWERTY adaptation of Janko's six-row keyboard. In 12-TET
// Q/Z start at C4, 1/A at C#4; each horizontal move is a whole tone.
// https://en.wikipedia.org/wiki/Jank%C3%B3_keyboard
janko_note := func(key: USize) returns USize {
    if key.lt(10) { return PIANO_C4_KEY_OFFSET + key * 2 + 1 }
    if key.lt(20) { return PIANO_C4_KEY_OFFSET + (key - 10) * 2 }
    if key.lt(29) { return PIANO_C4_KEY_OFFSET + (key - 20) * 2 + 1 }
    return PIANO_C4_KEY_OFFSET + (key - 29) * 2
}

test_janko_chords := test() {
    // Q-E-F and W-R-G: the same major triad translated one column.
    for k : USize in array(USize, 10, 12, 23) {
        assert_eq(USize, janko_note(k + 1), janko_note(k) + 2)
    }
    assert_eq(USize, janko_note(12) - janko_note(10), 4)
    assert_eq(USize, janko_note(23) - janko_note(10), 7)
    assert_eq(USize, janko_note(10), janko_note(29))
    assert_eq(USize, janko_note(0), janko_note(20))
}

// Keep the clue and its highlighted keys in the playable keyboard range.
puzzle_clue_keys := func(root: USize, quality: PuzzleQuality, janko: Bool) returns Array(USize) {
    mut bottom := root
    mut limit := NUM_KEYS
    if janko {
        limit = janko_note(9) + 1
        if bottom.lt(PIANO_C4_KEY_OFFSET) { bottom = bottom + 12 }
    }
    if (bottom + quality.upper).gte(limit) { bottom = bottom - 12 }
    return array(USize, bottom, bottom + quality.middle, bottom + quality.upper)
}

test_puzzle_clue_voicing := test() {
    for root in 0..NUM_KEYS {
        for q, quality : PuzzleQuality in PUZZLE_QUALITIES {
            for janko : Bool in array(Bool, false, true) {
                notes := puzzle_clue_keys(root, quality, janko)
                mut held := Array(I32).new(NUM_KEYS)
                for i : USize in notes {
                    if janko { assert(i.gte(PIANO_C4_KEY_OFFSET).and(i.lte(janko_note(9)))) }
                    held[i] = 1
                }
                for other, puzzle_quality : PuzzleQuality in PUZZLE_QUALITIES {
                    assert_eq(Bool, puzzle_matches(held, root, puzzle_quality), q.eq(other))
                }
            }
        }
    }
}

main := proc() {
    InitWindow(WINDOW_WIDTH, WINDOW_HEIGHT, "piano".c_str)
    SetTargetFPS(FPS)
    InitAudioDevice()
    fnt := LoadFontEx("img/DejaVuSans.ttf".c_str, 48, Option(ref I32).None, 0)

    // Key state tracking
    mut key_down := Array(I32).new(NUM_KEYS)
    mut prev_down := Array(I32).new(NUM_KEYS)
    for i in 0..NUM_KEYS {
        key_down[i] = 0
        prev_down[i] = 0
    }

    // Note events (circular buffer)
    mut ev_note := Array(I32).new(MAX_NOTES)
    mut ev_start := Array(I64).new(MAX_NOTES)
    mut ev_end := Array(I64).new(MAX_NOTES)
    for i in 0..MAX_NOTES {
        ev_note[i] = 0
        ev_start[i] = 0
        ev_end[i] = 0
    }
    mut ev_count : I64 = 0
    mut ev_head : I64 = 0
    mut display_mode : I32 = DISPLAY_MODE_SOLFEGE
    mut song_playing := false
    mut song_idx : USize = 0
    mut song_timer : I64 = 0
    mut janko := false
    mut puzzle := false
    mut puzzle_root : I32 = -1
    mut last_chord := Array(I32).new(NUM_KEYS)
    mut reveal := false
    mut answer_keys := Array(Bool).new(NUM_KEYS)
    mut quality_idx : USize = 0
    mut feedback := ""
    mut clue := Array(Sound).new(3)
    mut clue_loaded := false
    mut janko_labels := Array(Str).new(NUM_KEYS)
    for k : USize in 0..NUM_KEYS {
        note := janko_note(k)
        if janko_labels[note].is_empty() {
            janko_labels[note] = PIANO_KEY_LABELS[k].clone()
        } else {
            janko_labels[note] = format(janko_labels[note], "/", PIANO_KEY_LABELS[k])
        }
    }

    // Pre-generate all 36 sounds for polyphony.
    mut sounds := Array(Sound).new(NUM_KEYS)
    mut nathex_sounds := Array(Sound).new(NUM_KEYS)
    for i in 0..NUM_KEYS {
        ref freq : I64 = piano_key_freq(false, i)
        s := make_tone(freq, 10000, 0.1)
        sounds[i] = s
        ref nathex_freq : I64 = piano_key_freq(true, i)
        ns := make_tone(nathex_freq, 10000, 0.1)
        nathex_sounds[i] = ns
    }

    mut timer : I64 = 0

    BG_COLOR := DARK_SLATE
    ROLL_BG := MIDNIGHT
    GRID_BLACK := MIDNIGHT_GRID
    GRID_LINE := SLATE_GRID
    KEY_WHITE_PRESSED := TEAL
    KEY_WHITE := GRAY_240
    KEY_LABEL_COLOR := GRAY_80
    KEY_BLACK_PRESSED := DARK_TEAL
    KEY_BLACK := GRAY_20
    KEY_LABEL_BLACK := HINT_GRAY
    LABEL_COLOR := SLATE_LABEL
    BTN_ACTIVE := TEAL
    BTN_INACTIVE := GRAY_50
    BUTTON_LABEL := GRAY_220

    while !WindowShouldClose() {
        mut check_now := false
        mut listen_now := false
        mut cheat_now := false
        dt := (GetFrameTime() * 1000).to_i64()
        timer = timer + dt

        nathex_display := display_mode.eq(DISPLAY_MODE_NATHEX)
        hextave_display := display_mode.eq(DISPLAY_MODE_HEXTAVES).or(nathex_display)
        mut white_key_count := STANDARD_WHITE_KEYS
        if hextave_display { white_key_count = HEXTAVE_WHITE_KEYS }
        white_w := WINDOW_WIDTH / white_key_count.to_i32()
        black_w := white_w * 3 / 5

        if IsMouseButtonPressed(0) {
            mx := GetMouseX()
            my := GetMouseY()
            if my >= TOGGLE_Y && my < TOGGLE_Y + TOGGLE_H {
                if mx >= PUZZLE_X && mx < PUZZLE_X + SONG_BTN_W {
                    puzzle = puzzle.not(); puzzle_root = -1; feedback = ""; reveal = false
                    song_playing = false
                    if puzzle.and(nathex_display) { display_mode = DISPLAY_MODE_SOLFEGE }
                }
                if mx >= MAP_BTN_X && mx < MAP_BTN_X + SONG_BTN_W { janko = janko.not(); reveal = false }
                if mx >= TOGGLE_X && mx < TOGGLE_X + TOGGLE_W {
                    display_mode = DISPLAY_MODE_SOLFEGE
                }
                hx := TOGGLE_X + TOGGLE_W + TOGGLE_GAP
                if mx >= hx && mx < hx + TOGGLE_W {
                    display_mode = DISPLAY_MODE_LETTERS
                }
                lx := hx + TOGGLE_W + TOGGLE_GAP
                if mx >= lx && mx < lx + TOGGLE_W {
                    display_mode = DISPLAY_MODE_HEXTAVES
                }
                nx := lx + TOGGLE_W + TOGGLE_GAP
                if mx >= nx && mx < nx + TOGGLE_W {
                    display_mode = DISPLAY_MODE_NATHEX
                    puzzle = false
                }
                if mx >= SONG_BTN_X && mx < SONG_BTN_X + SONG_BTN_W {
                    puzzle = false
                    song_playing = true
                    song_idx = 0
                    song_timer = 0
                }
            }
            if puzzle.and(my.gte(PUZZLE_Y)).and(my.lt(PUZZLE_Y + TOGGLE_H)).and(mx.gte(TOGGLE_X)) {
                col := (mx - TOGGLE_X) / (TOGGLE_W + TOGGLE_GAP)
                if ((mx - TOGGLE_X) % (TOGGLE_W + TOGGLE_GAP)).lt(TOGGLE_W) {
                    if col.eq(0) { puzzle_root = -1; feedback = ""; reveal = false }
                    if col.eq(1) {
                        quality_idx = (quality_idx + 1) % PUZZLE_QUALITIES.len(); feedback = ""; reveal = false
                        for i : USize in 0..NUM_KEYS { last_chord[i] = 0 }
                    }
                    if col.eq(2) { listen_now = true }
                    if col.eq(3) { cheat_now = true }
                    if col.eq(4) { check_now = true }
                }
            }
        }

        // OR all held keys into note state so releasing an alias does not
        // silence its pitch while another touch point is still held.
        for i in 0..NUM_KEYS { key_down[i] = 0 }
        for i in 0..NUM_KEYS {
            if IsKeyDown(PIANO_KEYCODES[i]) {
                mut note := i
                if janko { note = janko_note(i) }
                key_down[note] = 1
            }
        }

        // Mouse click on piano keys
        if IsMouseButtonDown(0) {
            mx := GetMouseX()
            my := GetMouseY()
            if my >= PIANO_Y {
                mut mouse_note : I32 = -1
                // Check black keys first (they're on top)
                if my < PIANO_Y + BLACK_H {
                    if hextave_display {
                        for cycle : USize in 0..HEXTAVE_DRAW_CYCLES {
                            for j : USize in 0..3 {
                                ref bpos : I32 = FIVE_BLACK_KEY_POS[j]
                                ref bchrom_off : I32 = FIVE_BLACKS[j]
                                chrom := bchrom_off + cycle.to_i32() * FIVE_CYCLE.to_i32()
                                bx := (cycle.to_i32() * FIVE_NATURAL_COUNT.to_i32() + bpos + 1) * white_w - black_w / 2
                                if chrom.to_usize() < NUM_KEYS && mx >= bx && mx < bx + black_w {
                                    mouse_note = chrom
                                }
                            }
                        }
                    } else {
                        for oct : USize in 0..3 {
                            for j : USize in 0..5 {
                                ref bpos : I32 = BLACK_KEY_POS[j]
                                ref bchrom_off : I32 = BLACK_CHROMS[j]
                                chrom := bchrom_off + oct.to_i32() * 12
                                bx := (oct.to_i32() * 7 + bpos + 1) * white_w - black_w / 2
                                if chrom.to_usize() < NUM_KEYS && mx >= bx && mx < bx + black_w {
                                    mouse_note = chrom
                                }
                            }
                        }
                    }
                }
                // If no black key hit, check white keys
                if mouse_note < 0 {
                    wk := mx / white_w
                    if wk >= 0 && wk < white_key_count.to_i32() {
                        if hextave_display {
                            cycle := wk / FIVE_NATURAL_COUNT.to_i32()
                            ref nat : I32 = FIVE_NATURALS[wk.mod(FIVE_NATURAL_COUNT.to_i32()).to_usize()]
                            mouse_note = nat + cycle * FIVE_CYCLE.to_i32()
                        } else {
                            oct := wk / 7
                            ref nat : I32 = NATURALS[wk.mod(7).to_usize()]
                            mouse_note = nat + oct * 12
                        }
                    }
                }
                if mouse_note >= 0 && mouse_note.to_usize() < NUM_KEYS {
                    key_down[mouse_note.to_usize()] = 1
                }
            }
        }

        if song_playing {
            ref note_ms : I64 = HAPPY_BIRTHDAY_DURATIONS[song_idx]
            if song_timer.lt(note_ms) {
                key_idx := HAPPY_BIRTHDAY_FREQ_NOTES[song_idx] - PIANO_C3_FREQ_OFFSET.to_i32()
                key_down[key_idx.to_usize()] = 1
            }
            song_timer = song_timer + dt
            if song_timer.gte(note_ms + HAPPY_BIRTHDAY_GAP_MS) {
                song_timer = 0
                song_idx = song_idx + 1
                if song_idx.gte(HAPPY_BIRTHDAY_NOTE_COUNT) {
                    song_playing = false
                }
            }
        }

        // Detect press/release by comparing with prev_down
        if puzzle {
            if puzzle_root.lt(0) {
                for i : USize in 0..NUM_KEYS { last_chord[i] = 0 }
                for i : USize in 0..NUM_KEYS {
                    if key_down[i].eq(1).and(prev_down[i].eq(0)) { puzzle_root = i.to_i32(); break }
                }
            } else {
                remember_puzzle_chord(last_chord, key_down, prev_down)
            }
            if puzzle_root.gte(0) {
                if listen_now.or(cheat_now) {
                    // Both use independent clue sounds; Cheat also shows the keys.
                    reveal = cheat_now
                    for i in 0..NUM_KEYS { answer_keys[i] = false }
                    notes := puzzle_clue_keys(puzzle_root.to_usize(), PUZZLE_QUALITIES[quality_idx], janko)
                    for v : USize in 0..3 {
                        if clue_loaded { UnloadSound(clue[v]) }
                        index := notes[v].clone()
                        answer_keys[index] = true
                        ref hz : I64 = piano_key_freq(false, index)
                        clue[v] = make_tone(hz, 700, 0.1)
                    }
                    clue_loaded = true
                    for v : USize in 0..3 { PlaySound(clue[v]) }
                }
                if check_now.or(IsKeyPressed(257)) {
                    feedback = puzzle_check(last_chord, puzzle_root.to_usize(), PUZZLE_QUALITIES[quality_idx], display_mode)
                }
            }
        }
        for i in 0..NUM_KEYS {
            ref kd : I32 = key_down[i]
            ref pd : I32 = prev_down[i]
            // Newly pressed
            if kd == 1 && pd == 0 {
                if nathex_display {
                    ref s : Sound = nathex_sounds[i]
                    PlaySound(s)
                } else {
                    ref s : Sound = sounds[i]
                    PlaySound(s)
                }
                // Add note event
                ev_note[ev_head.to_usize()] = i.to_i32()
                t_val := timer
                ev_start[ev_head.to_usize()] = t_val
                ev_end[ev_head.to_usize()] = -1
                ev_head = (ev_head + 1) % MAX_NOTES.to_i64()
                if ev_count < MAX_NOTES.to_i64() {
                    ev_count = ev_count + 1
                }
            }
            // Just released
            if kd == 0 && pd == 1 {
                ref s : Sound = sounds[i]
                StopSound(s)
                ref ns : Sound = nathex_sounds[i]
                StopSound(ns)
                // Close the note event
                for j in 0..ev_count.to_u32() {
                    idx := (ev_head - 1 - j.to_i64() + MAX_NOTES.to_i64()) % MAX_NOTES.to_i64()
                    ref en : I32 = ev_note[idx.to_usize()]
                    ref ee : I64 = ev_end[idx.to_usize()]
                    if en == i.to_i32() && ee == -1 {
                        t_val := timer
                        ev_end[idx.to_usize()] = t_val
                        break
                    }
                }
            }
        }

        // Copy current state to prev
        for i in 0..NUM_KEYS {
            ref kd : I32 = key_down[i]
            kd_val := kd
            prev_down[i] = kd_val
        }

        // -- Draw --
        BeginDrawing()
        ClearBackground(BG_COLOR)

        // Piano roll background
        DrawRectangle(0, 0, WINDOW_WIDTH, ROLL_H, ROLL_BG)

        // Piano roll grid lines (one per note, horizontal)
        note_h := ROLL_H / NUM_KEYS.to_i32()
        for i in 0..NUM_KEYS {
            ny := i.to_i32() * note_h
            mut ib : I32 = 0
            if hextave_display {
                ib = FIVE_IS_BLACK[i.mod(FIVE_CYCLE)].clone()
            } else {
                ib = IS_BLACK[i.mod(12)].clone()
            }
            if ib == 1 {
                DrawRectangle(0, ny, WINDOW_WIDTH, note_h, GRID_BLACK)
            }
            if hextave_display {
                if i % FIVE_CYCLE == 0 && i > 0 {
                    DrawRectangle(0, ny, WINDOW_WIDTH, 1, GRID_LINE)
                }
            } else {
                if i % 12 == 0 && i > 0 {
                    DrawRectangle(0, ny, WINDOW_WIDTH, 1, GRID_LINE)
                }
            }
        }

        // Draw note events
        for j in 0..ev_count.to_u32() {
            idx := (ev_head - ev_count + j.to_i64() + MAX_NOTES.to_i64()) % MAX_NOTES.to_i64()
            ref en : I32 = ev_note[idx.to_usize()]
            ref ee : I64 = ev_end[idx.to_usize()]

            // x positions (time -> x, scrolling left)
            mut x_right : I32 = WINDOW_WIDTH - ((timer - ev_start[idx.to_usize()]) * SCROLL_SPEED.cast(I64) / 1000).to_i32()
            mut x_left : I32 = WINDOW_WIDTH
            if ee >= 0 {
                x_left = WINDOW_WIDTH - ((timer - ee) * SCROLL_SPEED.cast(I64) / 1000).to_i32()
            }

            // Skip if fully off-screen
            if x_left < 0 { continue }
            if x_right < 0 { x_right = 0 }
            if x_left > WINDOW_WIDTH { x_left = WINDOW_WIDTH }

            // y position: note 0 at bottom of roll, note 35 at top
            ey := ROLL_H - (en + 1) * note_h
            mut ew := x_left - x_right
            if ew < 2 { ew = 2 }

            // Color: teal with brightness per display cycle.
            mut note_color := DARK_TEAL
            mut cycle : I32 = en / 12
            if hextave_display { cycle = en / FIVE_CYCLE.to_i32() }
            if cycle == 1 { note_color = NOTE_TEAL_1 }
            if cycle == 2 { note_color = NOTE_TEAL_2 }
            if cycle == 3 { note_color = NOTE_TEAL_3 }
            if cycle == 4 { note_color = NOTE_TEAL_4 }

            DrawRectangle(x_right, ey, ew, note_h - 1, note_color)
        }

        // Note labels on left side of roll
        for i in 0..NUM_KEYS {
            ny := ROLL_H - (i.to_i32() + 1) * note_h
            note_label := piano_note_label(display_mode, i.to_i32())
            DrawTextEx(fnt, note_label.c_str, Vector2(x = 4, y = ny.to_f32()), (note_h - 2).to_f32(), 1, LABEL_COLOR)
        }

        // -- Piano keyboard --
        if hextave_display {
            // Draw 23 white keys over the same 36-semitone sound range.
            for i : USize in 0..HEXTAVE_WHITE_KEYS {
                kx := i.to_i32() * white_w
                cycle := i / FIVE_NATURAL_COUNT
                ref nat : I32 = FIVE_NATURALS[i.mod(FIVE_NATURAL_COUNT)]
                chrom := nat + cycle.to_i32() * FIVE_CYCLE.to_i32()
                mut k_color := KEY_WHITE
                if chrom.to_usize() < NUM_KEYS {
                    ref kd : I32 = key_down[chrom.to_usize()]
                    if kd == 1 { k_color = KEY_WHITE_PRESSED }
                    if puzzle.and(reveal).and(answer_keys[chrom.to_usize()]) { k_color = GOLD }
                }
                DrawRectangle(kx, PIANO_Y, white_w - 2, WHITE_H, k_color)
                if chrom.to_usize() < NUM_KEYS {
                    mut lbl := PIANO_KEY_LABELS[chrom.to_usize()].clone()
                    if janko { lbl = janko_labels[chrom.to_usize()].clone() }
                    DrawTextEx(fnt, lbl.c_str, Vector2(x = (kx + white_w / 4).to_f32(), y = (PIANO_Y + WHITE_H - 30).to_f32()), 18, 1, KEY_LABEL_COLOR)
                }
            }
            for cycle : USize in 0..HEXTAVE_DRAW_CYCLES {
                for j : USize in 0..3 {
                    ref bpos : I32 = FIVE_BLACK_KEY_POS[j]
                    ref bchrom_off : I32 = FIVE_BLACKS[j]
                    chrom := bchrom_off + cycle.to_i32() * FIVE_CYCLE.to_i32()
                    bx := (cycle.to_i32() * FIVE_NATURAL_COUNT.to_i32() + bpos + 1) * white_w - black_w / 2
                    mut kb_color := KEY_BLACK
                    if chrom.to_usize() < NUM_KEYS {
                        ref kd : I32 = key_down[chrom.to_usize()]
                        if kd == 1 { kb_color = KEY_BLACK_PRESSED }
                        if puzzle.and(reveal).and(answer_keys[chrom.to_usize()]) { kb_color = GOLD }
                    }
                    DrawRectangle(bx, PIANO_Y, black_w, BLACK_H, kb_color)
                    if chrom.to_usize() < NUM_KEYS {
                        mut lbl := PIANO_KEY_LABELS[chrom.to_usize()].clone()
                        if janko { lbl = janko_labels[chrom.to_usize()].clone() }
                        DrawTextEx(fnt, lbl.c_str, Vector2(x = (bx + black_w / 4).to_f32(), y = (PIANO_Y + BLACK_H - 20).to_f32()), 14, 1, KEY_LABEL_BLACK)
                    }
                }
            }
        } else {
            // Draw 21 white keys (3 octaves).
            for i : USize in 0..STANDARD_WHITE_KEYS {
                kx := i.to_i32() * white_w
                oct := i / 7
                ref nat : I32 = NATURALS[i.mod(7)]
                chrom := nat + oct.to_i32() * 12
                mut k_color := KEY_WHITE
                if chrom.to_usize() < NUM_KEYS {
                    ref kd : I32 = key_down[chrom.to_usize()]
                    if kd == 1 { k_color = KEY_WHITE_PRESSED }
                    if puzzle.and(reveal).and(answer_keys[chrom.to_usize()]) { k_color = GOLD }
                }
                DrawRectangle(kx, PIANO_Y, white_w - 2, WHITE_H, k_color)
                if chrom.to_usize() < NUM_KEYS {
                    mut lbl := PIANO_KEY_LABELS[chrom.to_usize()].clone()
                    if janko { lbl = janko_labels[chrom.to_usize()].clone() }
                    DrawTextEx(fnt, lbl.c_str, Vector2(x = (kx + white_w / 4).to_f32(), y = (PIANO_Y + WHITE_H - 30).to_f32()), 18, 1, KEY_LABEL_COLOR)
                }
            }
            for oct : USize in 0..3 {
                for j : USize in 0..5 {
                    ref bpos : I32 = BLACK_KEY_POS[j]
                    ref bchrom_off : I32 = BLACK_CHROMS[j]
                    chrom := bchrom_off + oct.to_i32() * 12
                    bx := (oct.to_i32() * 7 + bpos + 1) * white_w - black_w / 2
                    mut kb_color := KEY_BLACK
                    if chrom.to_usize() < NUM_KEYS {
                        ref kd : I32 = key_down[chrom.to_usize()]
                        if kd == 1 { kb_color = KEY_BLACK_PRESSED }
                        if puzzle.and(reveal).and(answer_keys[chrom.to_usize()]) { kb_color = GOLD }
                    }
                    DrawRectangle(bx, PIANO_Y, black_w, BLACK_H, kb_color)
                    if chrom.to_usize() < NUM_KEYS {
                        mut lbl := PIANO_KEY_LABELS[chrom.to_usize()].clone()
                        if janko { lbl = janko_labels[chrom.to_usize()].clone() }
                        DrawTextEx(fnt, lbl.c_str, Vector2(x = (bx + black_w / 4).to_f32(), y = (PIANO_Y + BLACK_H - 20).to_f32()), 14, 1, KEY_LABEL_BLACK)
                    }
                }
            }
        }

        mut sol_color := BTN_ACTIVE
        mut letter_color := BTN_INACTIVE
        mut hex_color := BTN_INACTIVE
        mut nathex_color := BTN_INACTIVE
        if display_mode.eq(DISPLAY_MODE_LETTERS) {
            sol_color = BTN_INACTIVE
            letter_color = BTN_ACTIVE
        }
        if display_mode.eq(DISPLAY_MODE_HEXTAVES) {
            sol_color = BTN_INACTIVE
            hex_color = BTN_ACTIVE
        }
        if nathex_display {
            sol_color = BTN_INACTIVE
            nathex_color = BTN_ACTIVE
        }
        DrawRectangle(TOGGLE_X, TOGGLE_Y, TOGGLE_W, TOGGLE_H, sol_color)
        DrawRectangle(TOGGLE_X + TOGGLE_W + TOGGLE_GAP, TOGGLE_Y, TOGGLE_W, TOGGLE_H, letter_color)
        DrawRectangle(TOGGLE_X + (TOGGLE_W + TOGGLE_GAP) * 2, TOGGLE_Y, TOGGLE_W, TOGGLE_H, hex_color)
        DrawRectangle(TOGGLE_X + (TOGGLE_W + TOGGLE_GAP) * 3, TOGGLE_Y, TOGGLE_W, TOGGLE_H, nathex_color)
        mut song_color := BTN_INACTIVE
        if song_playing { song_color = BTN_ACTIVE }
        DrawRectangle(SONG_BTN_X, TOGGLE_Y, SONG_BTN_W, TOGGLE_H, song_color)
        DrawTextEx(fnt, "Solfege".c_str, Vector2(x = (TOGGLE_X + 14).to_f32(), y = (TOGGLE_Y + 7).to_f32()), FONT, 1, BUTTON_LABEL)
        DrawTextEx(fnt, "Letters".c_str, Vector2(x = (TOGGLE_X + TOGGLE_W + TOGGLE_GAP + 14).to_f32(), y = (TOGGLE_Y + 7).to_f32()), FONT, 1, BUTTON_LABEL)
        DrawTextEx(fnt, "Hextaves".c_str, Vector2(x = (TOGGLE_X + (TOGGLE_W + TOGGLE_GAP) * 2 + 14).to_f32(), y = (TOGGLE_Y + 7).to_f32()), FONT, 1, BUTTON_LABEL)
        DrawTextEx(fnt, "Nathex".c_str, Vector2(x = (TOGGLE_X + (TOGGLE_W + TOGGLE_GAP) * 3 + 14).to_f32(), y = (TOGGLE_Y + 7).to_f32()), FONT, 1, BUTTON_LABEL)
        DrawTextEx(fnt, "Happy Birthday".c_str, Vector2(x = (SONG_BTN_X + 14).to_f32(), y = (TOGGLE_Y + 7).to_f32()), FONT, 1, BUTTON_LABEL)
        mut map_label := "QWERTY: Linear"
        mut map_color := BTN_INACTIVE
        if janko { map_label = "QWERTY: Janko"; map_color = BTN_ACTIVE }
        DrawRectangle(MAP_BTN_X, TOGGLE_Y, SONG_BTN_W, TOGGLE_H, map_color)
        DrawTextEx(fnt, map_label.c_str, Vector2(x = (MAP_BTN_X + 14).to_f32(), y = (TOGGLE_Y + 7).to_f32()), FONT, 1, BUTTON_LABEL)

        // Hint
        mut puzzle_color := BTN_INACTIVE
        if puzzle { puzzle_color = BTN_ACTIVE }
        DrawRectangle(PUZZLE_X, TOGGLE_Y, SONG_BTN_W, TOGGLE_H, puzzle_color)
        DrawTextEx(fnt, "Chord puzzle".c_str, Vector2(x=(PUZZLE_X + 14).to_f32(), y=(TOGGLE_Y + 7).to_f32()), FONT, 1, BUTTON_LABEL)
        if puzzle {
            ref quality : PuzzleQuality = PUZZLE_QUALITIES[quality_idx]
            labels := array(Str, "New root", format(quality.name, " >"), "Listen", "Cheat", "Check (Enter)")
            for col : USize in 0..labels.len() {
                x := TOGGLE_X + col.to_i32() * (TOGGLE_W + TOGGLE_GAP)
                DrawRectangle(x, PUZZLE_Y, TOGGLE_W, TOGGLE_H, BTN_INACTIVE)
                DrawTextEx(fnt, labels[col].c_str, Vector2(x=(x + 12).to_f32(), y=(PUZZLE_Y + 7).to_f32()), FONT, 1, BUTTON_LABEL)
            }
            mut middle_c := "E"
            if janko { middle_c = "Q or Z" }
            mut prompt := format("1. Tap a piano key to choose the root. Try Do (C4): press ", middle_c, ".")
            if puzzle_root.gte(0) {
                prompt = format("Build a ", puzzle_note_name(puzzle_root.to_usize(), display_mode), " ", quality.name, " chord (three notes).")
                guide := "2. Listen by ear, or click Cheat to see the gold keys.   3. Play your chord, release it, then Check."
                DrawTextEx(fnt, guide.c_str, Vector2(x=MARGIN, y=(ROLL_H + 5).to_f32()), FONT, 1, BUTTON_LABEL)
                DrawTextEx(fnt, feedback.c_str, Vector2(x=MARGIN, y=(ROLL_H + 32).to_f32()), FONT, 1, BUTTON_LABEL)
            }
            DrawTextEx(fnt, prompt.c_str, Vector2(x=(TOGGLE_X + (TOGGLE_W + TOGGLE_GAP) * labels.len().to_i32()).to_f32(), y=(PUZZLE_Y + 7).to_f32()), FONT, 1, BUTTON_LABEL)
        }
        mut hint := "Solfege display: same keys and sounds"
        if display_mode.eq(DISPLAY_MODE_LETTERS) {
            hint = "Letters display: same keys and sounds"
        }
        if display_mode.eq(DISPLAY_MODE_HEXTAVES) {
            hint = "Hextaves display: same keys and sounds, C5=ca5 labels"
        }
        if nathex_display {
            hint = "Nathex: same keys, separate 8-step doubling sounds, C4 key=ca4"
        }
        if janko { hint = "Janko: Q/Z share a pitch; 1/A are one step higher. Move right for two steps." }
        if song_playing {
            hint = "Playing Happy Birthday"
        }
        DrawTextEx(fnt, hint.c_str, Vector2(x = MARGIN, y = (PIANO_Y - 30).to_f32()), FONT, 1, KEY_LABEL_COLOR)

        EndDrawing()
    }

    for s : Sound in sounds {
        UnloadSound(s)
    }
    for s : Sound in nathex_sounds {
        UnloadSound(s)
    }
    UnloadFont(fnt)
    if clue_loaded { for v : USize in 0..3 { UnloadSound(clue[v]) } }
    CloseAudioDevice()
    CloseWindow()
}
