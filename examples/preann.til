mode cli

import("../src/std/sys")

// Portable preann-style float-layer accumulation. No preann library is needed.
// Run compiled timings: bin/til run --opt=2 examples/preann.til
// Run only correctness: bin/til test --opt=2 examples/preann.til
// Existing --cpu=baseline|x86-64-v3|x86-64-v4 and --cc select the backend.
// Interpret mode is useful for correctness, not performance measurements.
//
// Rows are padded to four floats. All kernels keep FOUR lane sums per output
// and reduce (lane0+lane2)+(lane1+lane3), then add to the existing result.
// Blocking shares each input load across 2/4/8 outputs; it does not widen the
// sums, fuse multiply/add, or reassociate an output's arithmetic.
// Inputs, weights and results must occupy disjoint storage, as constructed
// below. This example measures accumulation, not activation or training.

F4 := Simd(F32, 4)
F2 := Simd(F32, 2)
Kernel := func(inputs: Array(F32), weights: Array(F32), mut results: Array(F32), rows: USize)
Variant := struct { name: Str; run: Kernel }
LayerCase := struct {
    inputs: Array(F32)
    weights: Array(F32)
    initial: Array(F32)
    rows: USize
}

priv validate_layout := func(inputs: Array(F32), weights: Array(F32), results: Array(F32), rows: USize) {
    stride := inputs.len()
    if stride == 0 || stride % 4 != 0 { panic("input storage must have positive four-float padding") }
    if rows > results.len() { panic("result range") }
    if rows > weights.len() / stride { panic("weight range") }
}

// The caller proves a complete four-float range. memcpy permits ordinary
// scalar alignment; the kernels require no native-vector-aligned storage.
priv load4 := func(values: Array(F32), start: USize) returns F4 {
    mut result := F4.zero()
    memcpy(result, ptr_add(values.data, start.to_uptr() * F32.size().to_uptr()), 16)
    return result
}

// Borrowed raw row base, with a byte displacement within its validated span.
priv load4_bytes := func(base: Dynamic, offset: UPtr) returns F4 {
    mut result := F4.zero()
    memcpy(result, ptr_add(base, offset), 16)
    return result
}

priv load2 := func(values: Array(F32), start: USize) returns F2 {
    mut result := F2.zero()
    memcpy(result, ptr_add(values.data, start.to_uptr() * F32.size().to_uptr()), 8)
    return result
}

priv add_result := func(mut results: Array(F32), row: USize, sum: F32) {
    ref previous : F32 = results.unsafe_get(row)
    results.unsafe_set(row, own (previous + sum))
}

// A local value view of the documented consecutive-scalar SIMD storage.
// memcpy avoids aliasing type-puns and repeated checked lane lookups.
priv Lanes4 := struct { x: F32; y: F32; z: F32; w: F32 }
priv lanes4 := func(value: F4) returns Lanes4 {
    mut lanes := Lanes4(x = 0, y = 0, z = 0, w = 0)
    memcpy(lanes, value, F4.size().to_uptr())
    return lanes
}

priv dot4 := func(inputs: Array(F32), weights: Array(F32), row_start: USize) returns F32 {
    mut accum := F4.zero()
    mut i : USize = 0
    while i < inputs.len() {
        accum = accum + load4(inputs, i) * load4(weights, row_start + i)
        i = i + 4
    }
    return accum.reduce_add()
}

layer_reference := func(inputs: Array(F32), weights: Array(F32), mut results: Array(F32), rows: USize) {
    validate_layout(inputs, weights, results, rows)
    for row in 0..rows { add_result(results, row, dot4(inputs, weights, row * inputs.len())) }
}

priv blocked_kernel := macro(B: I64, packed: Bool) returns FuncDef {
return func(inputs: Array(F32), weights: Array(F32), mut results: Array(F32), rows: USize) {
    if B != 2 && B != 4 && B != 8 { panic("supported output blocks are 2, 4 and 8") }
    validate_layout(inputs, weights, results, rows)
    stride := inputs.len()
    block : USize = B
    bulk_rows := rows - rows % block
    mut row : USize = 0
    while row < bulk_rows {
        first := row * stride
        second := first + stride
        third := second + stride
        fourth := third + stride
        mut a0 := Simd(F32, 4).zero()
        mut a1 := Simd(F32, 4).zero()
        mut a2 := Simd(F32, 4).zero()
        mut a3 := Simd(F32, 4).zero()
        mut a4 := Simd(F32, 4).zero()
        mut a5 := Simd(F32, 4).zero()
        mut a6 := Simd(F32, 4).zero()
        mut a7 := Simd(F32, 4).zero()
        if B == 8 {
            // The complete eight-row block is valid. Form each row base
            // once, then advance a shared byte offset across all rows.
            row_bytes := stride.to_uptr() * F32.size().to_uptr()
            ref w0 : U8 = ptr_add(weights.data, first.to_uptr() * F32.size().to_uptr())
            ref w1 : U8 = ptr_add(w0, row_bytes)
            ref w2 : U8 = ptr_add(w1, row_bytes)
            ref w3 : U8 = ptr_add(w2, row_bytes)
            ref w4 : U8 = ptr_add(w3, row_bytes)
            ref w5 : U8 = ptr_add(w4, row_bytes)
            ref w6 : U8 = ptr_add(w5, row_bytes)
            ref w7 : U8 = ptr_add(w6, row_bytes)
            mut offset : UPtr = 0
            while offset < row_bytes {
                x := load4_bytes(inputs.data, offset)
                // Interleave independent output rows so Clang retains row
                // bases instead of rebuilding a serial address walk here.
                // Each row still visits input vectors in the same order.
                a0 = a0 + x * load4_bytes(w0, offset)
                a4 = a4 + x * load4_bytes(w4, offset)
                a1 = a1 + x * load4_bytes(w1, offset)
                a5 = a5 + x * load4_bytes(w5, offset)
                a2 = a2 + x * load4_bytes(w2, offset)
                a6 = a6 + x * load4_bytes(w6, offset)
                a3 = a3 + x * load4_bytes(w3, offset)
                a7 = a7 + x * load4_bytes(w7, offset)
                offset = offset + 16
            }
        } else {
            mut i : USize = 0
            while i < stride {
                x := load4(inputs, i)
                a0 = a0 + x * load4(weights, first + i)
                a1 = a1 + x * load4(weights, second + i)
                if B >= 4 {
                    a2 = a2 + x * load4(weights, third + i)
                    a3 = a3 + x * load4(weights, fourth + i)
                }
                i = i + 4
            }
        }
        if packed {
            // These lanes belong to different outputs: packing the final
            // additions does not change any output's reduction tree.
            if B == 2 {
                sums := Simd(F32, 2).new(a0.reduce_add(), a1.reduce_add())
                updated := load2(results, row) + sums
                memcpy(ptr_add(results.data, row.to_uptr() * F32.size().to_uptr()), updated, 8)
            } else if B == 4 {
                // The existing form measured better for Clang baseline at
                // this block size; keep it as the four-row specialization.
                sums := Simd(F32, 4).new(a0.reduce_add(), a1.reduce_add(), a2.reduce_add(), a3.reduce_add())
                updated := load4(results, row) + sums
                memcpy(ptr_add(results.data, row.to_uptr() * F32.size().to_uptr()), updated, 16)
            } else {
                // Interleave two rows at a time, preserving (0+2)+(1+3).
                // Keep this in the generated body: a reduction helper made GCC
                // spill the accumulators throughout the preceding dot loop.
                r0 := lanes4(a0)
                r1 := lanes4(a1)
                r2 := lanes4(a2)
                r3 := lanes4(a3)
                ab_low := Simd(F32, 4).new(r0.x, r1.x, r0.y, r1.y)
                ab_high := Simd(F32, 4).new(r0.z, r1.z, r0.w, r1.w)
                cd_low := Simd(F32, 4).new(r2.x, r3.x, r2.y, r3.y)
                cd_high := Simd(F32, 4).new(r2.z, r3.z, r2.w, r3.w)
                ab := lanes4(ab_low + ab_high)
                cd := lanes4(cd_low + cd_high)
                even := Simd(F32, 4).new(ab.x, ab.y, cd.x, cd.y)
                odd := Simd(F32, 4).new(ab.z, ab.w, cd.z, cd.w)
                sums := even + odd
                updated := load4(results, row) + sums
                memcpy(ptr_add(results.data, row.to_uptr() * F32.size().to_uptr()), updated, 16)
            }
            if B == 8 {
                r0 := lanes4(a4)
                r1 := lanes4(a5)
                r2 := lanes4(a6)
                r3 := lanes4(a7)
                ab_low := Simd(F32, 4).new(r0.x, r1.x, r0.y, r1.y)
                ab_high := Simd(F32, 4).new(r0.z, r1.z, r0.w, r1.w)
                cd_low := Simd(F32, 4).new(r2.x, r3.x, r2.y, r3.y)
                cd_high := Simd(F32, 4).new(r2.z, r3.z, r2.w, r3.w)
                ab := lanes4(ab_low + ab_high)
                cd := lanes4(cd_low + cd_high)
                even := Simd(F32, 4).new(ab.x, ab.y, cd.x, cd.y)
                odd := Simd(F32, 4).new(ab.z, ab.w, cd.z, cd.w)
                sums := even + odd
                updated := load4(results, row + 4) + sums
                memcpy(ptr_add(results.data, (row + 4).to_uptr() * F32.size().to_uptr()), updated, 16)
            }
        } else {
            add_result(results, row, a0.reduce_add())
            add_result(results, row + 1, a1.reduce_add())
            if B >= 4 {
                add_result(results, row + 2, a2.reduce_add())
                add_result(results, row + 3, a3.reduce_add())
            }
            if B == 8 {
                add_result(results, row + 4, a4.reduce_add())
                add_result(results, row + 5, a5.reduce_add())
                add_result(results, row + 6, a6.reduce_add())
                add_result(results, row + 7, a7.reduce_add())
            }
        }
        row = row + block
    }
    while row < rows {
        add_result(results, row, dot4(inputs, weights, row * stride))
        row++
    }
}
}

// Retain the original scalar-output four-row kernel as a control. The block
// size and output form are constants in each generated function; optimized
// builds eliminate unused accumulators and branches.
layer_blocked := blocked_kernel(4, false)
layer_packed4 := blocked_kernel(4, true)
layer_blocked2 := blocked_kernel(2, true)
layer_blocked8 := blocked_kernel(8, true)

priv kernel_variants := func() returns Array(Variant) {
    return array(Variant, Variant(name = "reference", run = layer_reference),
        Variant(name = "blocked4_scalar", run = layer_blocked),
        Variant(name = "blocked4_packed", run = layer_packed4),
        Variant(name = "blocked2_packed", run = layer_blocked2),
        Variant(name = "blocked8_packed", run = layer_blocked8))
}

// Independent scalar oracle for the same four-lane order, not the usual
// single-accumulator scalar dot product (which has different rounding).
priv layer_scalar4 := func(inputs: Array(F32), weights: Array(F32), mut results: Array(F32), rows: USize) {
    validate_layout(inputs, weights, results, rows)
    for row in 0..rows {
        base := row * inputs.len()
        mut a0 : F32 = 0
        mut a1 : F32 = 0
        mut a2 : F32 = 0
        mut a3 : F32 = 0
        mut i : USize = 0
        while i < inputs.len() {
            a0 = a0 + inputs.unsafe_get(i) * weights.unsafe_get(base + i)
            a1 = a1 + inputs.unsafe_get(i + 1) * weights.unsafe_get(base + i + 1)
            a2 = a2 + inputs.unsafe_get(i + 2) * weights.unsafe_get(base + i + 2)
            a3 = a3 + inputs.unsafe_get(i + 3) * weights.unsafe_get(base + i + 3)
            i = i + 4
        }
        add_result(results, row, (a0 + a2) + (a1 + a3))
    }
}

priv next_value := func(mut state: U32) returns F32 {
    state = state * 1664525 + 1013904223
    return ((state % 2001).to_i64() - 1000).to_f32() * 0.001
}

priv make_case := func(n: USize, rows: USize) returns LayerCase {
    if n == 0 { panic("positive logical input size required") }
    stride := ((n - 1) / 4 + 1) * 4
    mut inputs := Array(F32).new(stride)
    mut weights := Array(F32).new(stride * rows)
    mut initial := Array(F32).new(rows + 2)
    mut state : U32 = 1234567
    for i in 0..n { inputs.set(i, own next_value(state))! }
    for row in 0..rows {
        for i in 0..n { weights.set(row * stride + i, own next_value(state))! }
        initial.set(row, own ((row % 13).to_i64() - 6).to_f32().mul(0.007))!
    }
    // Zero padding comes from Array.new; guard outputs must never be written.
    initial.set(rows, own 12345.0)!
    initial.set(rows + 1, own -6789.0)!
    return LayerCase(inputs = inputs, weights = weights, initial = initial, rows = rows)
}

priv same_bits := func(a: Array(F32), b: Array(F32)) {
    assert_eq(USize, a.len(), b.len())
    assert_eq(I32, memcmp(a.data, b.data, a.len().to_uptr() * F32.size().to_uptr()), 0)
}

priv verify_case := proc(c: LayerCase) {
    noop_proc()
    inputs_before := c.inputs.clone()
    weights_before := c.weights.clone()
    variants := kernel_variants()
    mut outputs := Array(Array(F32)).new(variants.len())
    for k in 0..variants.len() { outputs.set(k, own c.initial.clone())! }
    mut expected := c.initial.clone()
    for _ in 0..3 {
        layer_scalar4(c.inputs, c.weights, expected, c.rows)
        for k in 0..variants.len() {
            ref mut result : Array(F32) = outputs.unsafe_get(k)
            variants[k].run(c.inputs, c.weights, result, c.rows)
            same_bits(result, expected)
            assert_eq(F32, result[c.rows], c.initial[c.rows])
            assert_eq(F32, result[c.rows + 1], c.initial[c.rows + 1])
        }
    }
    same_bits(c.inputs, inputs_before)
    same_bits(c.weights, weights_before)
}

priv check_shapes := proc() {
    for n : USize in array(USize, 1, 3, 4, 5, 15, 16, 17, 33) {
        for rows : USize in array(USize, 0, 1, 3, 4, 5, 7, 8, 9, 15, 16, 17) {
            verify_case(make_case(n, rows))
        }
    }
}

priv check_cancellation := proc() {
    mut c := make_case(13, 9)
    values := array(F32, 1.0e20, 1.0, -1.0e20, -1.0, 1.0e-30, -1.0e-30, 0.0, -0.0)
    for i in 0..13 { c.inputs.set(i, own 1.0)! }
    for row in 0..c.rows {
        for i in 0..13 {
            index := i.to_usize()
            c.weights.set(row * c.inputs.len() + index, own values[(row + index) % values.len()].clone())!
        }
    }
    verify_case(c)
}

test_preann_shapes := test() { check_shapes() }
test_preann_cancellation := test() { check_cancellation() }

priv reset_results := func(c: LayerCase, mut results: Array(F32)) {
    memcpy(results.data, c.initial.data, c.initial.len().to_uptr() * F32.size().to_uptr())
}

priv run_batch := proc(kernel: Kernel, c: LayerCase, mut results: Array(F32), repetitions: USize) returns I64 {
    // The runtime-selected callback keeps a real kernel call inside the
    // repetition loop. Inspect that loop when comparing optimized builds.
    start := clock_ms()
    for _ in 0..repetitions { kernel(c.inputs, c.weights, results, c.rows) }
    return clock_ms() - start
}

priv median5 := func(values: Array(F64), offset: USize) returns F64 {
    mut sorted := Array(F64).new(5)
    for i in 0..sorted.len() { sorted.set(i, own values[offset + i].clone())! }
    for i in 1..5 {
        mut j := i
        while j > 0 && sorted[j] < sorted[j - 1] {
            value := sorted[j].clone()
            sorted.set(j, own sorted[j - 1].clone())!
            sorted.set(j - 1, own value)!
            j--
        }
    }
    return sorted[2].clone()
}

priv measure := proc(n: USize, rows: USize) {
    c := make_case(n, rows)
    verify_case(c)
    variants := kernel_variants()
    mut results := c.initial.clone()
    mut repetitions := Array(USize).new(variants.len())
    mut times := Array(F64).new(variants.len() * 5)
    // Warm up and calibrate before collecting samples. The existing monotonic
    // millisecond clock is adequate for >=100 ms batches, not individual calls.
    for k in 0..variants.len() {
        repetitions.set(k, own 1)!
        variants[k].run(c.inputs, c.weights, results, rows)
        mut elapsed : I64 = 0
        while elapsed < 100 {
            reset_results(c, results)
            elapsed = run_batch(variants[k].run, c, results, repetitions[k])
            if elapsed < 100 { repetitions.set(k, own (repetitions[k] * 2))! }
        }
    }
    for sample in 0..5 {
        for order in 0..variants.len() {
            mut k := order
            if sample % 2 != 0 { k = variants.len() - 1 - order }
            reset_results(c, results)
            elapsed := run_batch(variants[k].run, c, results, repetitions[k])
            us := elapsed.to_f64() * 1000.0 / repetitions[k].to_u64().to_f64()
            times.set(k * 5 + sample.to_usize(), own us.clone())!
            assert_eq(F32, results[rows], c.initial[rows])
            assert_eq(F32, results[rows + 1], c.initial[rows + 1])
            // Counts are calibrated separately, so result0 need not match
            // between timing rows. Correctness checks use equal call counts.
            println("sample,", n, ",", rows, ",", variants[k].name, ",", sample, ",",
                repetitions[k], ",", elapsed, ",", us, ",", results[0])
        }
    }
    ref_median := median5(times, 0)
    for k in 1..variants.len() {
        candidate := median5(times, k * 5)
        println("median,", n, ",", rows, ",", variants[k].name, ",", ref_median, ",", candidate, ",", ref_median / candidate)
    }
}

main := proc() {
    check_shapes()
    check_cancellation()
    println("correctness: passed")
    println("sample,inputs,outputs,kernel,index,repetitions,elapsed_ms,us_per_layer,result0")
    println("median,inputs,outputs,kernel,reference_us,kernel_us,speedup")
    measure(17, 33)
    measure(512, 512)
    measure(4097, 513)
    measure(8193, 4096)
}
