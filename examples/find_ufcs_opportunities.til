mode cli

import("../src/core/io")
import("../src/core/str")
import("../src/core/vec")
import("../src/core/numbers")
import("../src/std/file")
import("../src/self/lexer")
import("../src/self/parser")

TARGETS := Vec(Str).new()
TARGETS.push(own "is_null")
TARGETS.push(own "til_type")
TARGETS.push(own "ident_name")
TARGETS.push(own "set_til_type")
TARGETS.push(own "field_access_name")
TARGETS.push(own "ptr_eq")
TARGETS.push(own "literal_num_text")

mut count : I64 = 0

is_target := func(name: Str) returns Bool {
    for t : Str in TARGETS {
        if name.eq(t) { return true }
    }
    return false
}

// #292 interned the AST's identifiers: IdentData.name is a Sym into the
// parse's SymbolPool, not the spelling, so the pool has to come along to
// read a name back out.
walk := proc(e: Expr, path: Str, symbols: SymbolPool) {
    switch e.node_type {
    case .FCall(_):
        if e.children.len().gt(1) {
            switch e.children[0].node_type {
            case .Ident(id):
                ref name : Str = id.ident_name(symbols.names)
                if is_target(name) {
                    if e.children.len().gt(2) {
                        println(path, ":", e.line.to_str(), ":", e.col.to_str(),
                            ": ", name, "(first, ...) -> first.", name, "(...)")
                    } else {
                        println(path, ":", e.line.to_str(), ":", e.col.to_str(),
                            ": ", name, "() -> .", name, "()")
                    }
                    count++
                }
            case:
            }
        }
    case:
    }
    for c : Expr in e.children {
        walk(c, path, symbols)
    }
}

main := proc(args: ..Str) {
    if args.len().eq(0) {
        println("Usage: til examples/find_ufcs_opportunities.til <file.til> ...")
        println("  or:  find src/ -name '*.til' -exec til examples/find_ufcs_opportunities.til {} +")
        return
    }
    for fp : Str in args {
        src := File.readfile(fp)
        tokens := tokenize(src, fp)
        mut mode_out := ""
        mut anon_type_counter : I64 = 0
        symbols := SymbolPool()
        root := parse(tokens, src, fp, mode_out, anon_type_counter, symbols)
        walk(root, fp, symbols)
    }
    println("Total: ", count.to_str())
}
