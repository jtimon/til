mode cli

// SVG line chart generator for non-negative integer CSV data.
// Usage: plot <csv_path> <svg_output_path> [last_n] [options]
//
// The first CSV column supplies X-axis labels. Each plotted numeric column is
// selected with --series column:label:left|right. Series order determines
// color. Axis units are optional; --right-divisor converts right-axis values.

import("../src/std/file")

NL := "\n"
Q := "\""

// Chart layout constants
W := 800
H := 400
MARGIN_LEFT := 70
MARGIN_RIGHT := 70
MARGIN_TOP := 40
MARGIN_BOTTOM := 60
CHART_W := W.sub(MARGIN_LEFT).sub(MARGIN_RIGHT)
CHART_H := H.sub(MARGIN_TOP).sub(MARGIN_BOTTOM)

BG_COLOR := "white"
AXIS_COLOR := "#333"
X_LABEL_COLOR := "#666"

Row := struct {
    const label := ""
    const values := Vec(I64).new()
}

Series := struct {
    const column_index : USize = 0
    const label := ""
    const right_axis := false
    const color := ""
}

qa := func(val: Str) returns Str {
    return format(Q, val, Q)
}

series_color := func(index: USize) returns Str {
    switch index.mod(9) {
    case 0: return "#0072B2"
    case 1: return "#CC79A7"
    case 2: return "#D55E00"
    case 3: return "#009E73"
    case 4: return "#984EA3"
    case 5: return "#56B4E9"
    case 6: return "#E69F00"
    case 7: return "#C44E52"
    case:   return "#8C564B"
    }
}

parse_headers := func(content: Str) returns Vec(Str) {
    lines := content.split(NL)
    if lines.len().eq(0).or(lines[0].is_empty()) {
        panic(__LOC__, "plot: CSV has no header")
    }
    return lines[0].split(",")
}

parse_csv := func(content: Str) returns Vec(Row) {
    mut rows := Vec(Row).new()
    lines := content.split(NL)
    mut i : USize = 1
    while i.lt(lines.len()) {
        ref line : Str = lines[i]
        if line.is_empty() {
            i++
            continue
        }
        cols := line.split(",")
        mut values := Vec(I64).new()
        mut c : USize = 1
        while c.lt(cols.len()) {
            values.push(own cols[c].to_i64())
            c++
        }
        rows.push(own Row(label = cols[0].clone(), values = values))
        i++
    }
    return rows
}

resolve_series := func(specs: Vec(Str), headers: Vec(Str)) returns Vec(Series) {
    mut series := Vec(Series).new()
    mut si : USize = 0
    while si.lt(specs.len()) {
        ref spec : Str = specs[si]
        parts := spec.split(":")
        if parts.len().eq(3).not() {
            panic(__LOC__, "plot: invalid --series '", spec,
                  "' (expected column:label:left|right)")
        }
        ref column : Str = parts[0]
        ref label : Str = parts[1]
        ref axis : Str = parts[2]
        if column.is_empty().or(label.is_empty()) {
            panic(__LOC__, "plot: --series column and label must not be empty")
        }

        mut found := false
        mut column_index : USize = 0
        mut hi : USize = 1
        while hi.lt(headers.len()) {
            if headers[hi].eq(column) {
                found = true
                column_index = hi.sub(1)
                break
            }
            hi++
        }
        if found.not() {
            panic(__LOC__, "plot: CSV has no numeric column '", column, "'")
        }

        mut right_axis := false
        if axis.eq("right") {
            right_axis = true
        } else if axis.eq("left").not() {
            panic(__LOC__, "plot: invalid axis '", axis, "' in --series '", spec, "'")
        }
        series.push(own Series(
            column_index = column_index,
            label = label.clone(),
            right_axis = right_axis,
            color = series_color(si)
        ))
        si++
    }
    return series
}

// Map a data value to Y pixel coordinate (top = high value, bottom = low).
y_px := func(val: I64, y_max: I64) returns I64 {
    scaled := val.mul(CHART_H).div(y_max)
    return MARGIN_TOP.add(CHART_H).sub(scaled)
}

x_px := func(idx: I64, count: I64) returns I64 {
    if count.lte(1) { return MARGIN_LEFT.add(CHART_W.div(2)) }
    return MARGIN_LEFT.add(idx.mul(CHART_W).div(count.sub(1)))
}

raw_series_value := func(row: Row, series: Series) returns I64 {
    return row.values[series.column_index].clone()
}

display_series_value := func(row: Row, series: Series, right_divisor: I64) returns I64 {
    val := raw_series_value(row, series)
    if series.right_axis { return val.div(right_divisor) }
    return val
}

build_points := func(rows: Vec(Row), series: Series, y_max: I64, right_divisor: I64) returns Str {
    mut pts := ""
    mut i : USize = 0
    while i.lt(rows.len()) {
        ref row : Row = rows[i]
        val := display_series_value(row, series, right_divisor)
        x := x_px(i.to_i64(), rows.len().to_i64())
        y := y_px(val, y_max)
        if i.gt(0) { pts = format(pts, " ") }
        pts = format(pts, x.to_str(), ",", y.to_str())
        i++
    }
    return pts
}

svg_line := func(x1: I64, y1: I64, x2: I64, y2: I64, color: Str) returns Str {
    return format("<line x1=", qa(x1.to_str()), " y1=", qa(y1.to_str()),
                  " x2=", qa(x2.to_str()), " y2=", qa(y2.to_str()),
                  " stroke=", qa(color), " stroke-width=", qa("1"), "/>", NL)
}

svg_circle := func(cx: I64, cy: I64, r: I64, color: Str) returns Str {
    return format("<circle cx=", qa(cx.to_str()), " cy=", qa(cy.to_str()),
                  " r=", qa(r.to_str()), " fill=", qa(color), "/>", NL)
}

svg_text := func(x: I64, y: I64, anchor: Str, size: I64, color: Str, body: Str) returns Str {
    return format("<text x=", qa(x.to_str()), " y=", qa(y.to_str()),
                  " text-anchor=", qa(anchor), " font-size=", qa(size.to_str()),
                  " fill=", qa(color), ">", body, "</text>", NL)
}

svg_polyline := func(points: Str, color: Str) returns Str {
    return format("<polyline points=", qa(points),
                  " fill=", qa("none"), " stroke=", qa(color),
                  " stroke-width=", qa("2"), "/>", NL)
}

series_has_data := func(rows: Vec(Row), series: Series) returns Bool {
    for row : Row in rows {
        if raw_series_value(row, series).gt(0) { return true }
    }
    return false
}

round_axis_max := func(value: I64) returns I64 {
    if value.lte(0) { return 1 }
    mut step := 1
    while value.div(step).gt(10) {
        step = step.mul(10)
    }
    if value.mod(step).gt(0) {
        return value.div(step).add(1).mul(step)
    }
    return value
}

series_legend_width := func(series: Series) returns I64 {
    return series.label.len().to_i64().mul(7).add(25)
}

generate_svg := func(rows: Vec(Row), series: Vec(Series), left_unit: Str,
                     right_unit: Str, right_divisor: I64,
                     show_x_labels: Bool = true,
                     show_y_labels: Bool = true) returns Str {
    mut left_max := 0
    mut right_max := 0
    mut has_left := false
    mut has_right := false
    for row : Row in rows {
        for item : Series in series {
            val := display_series_value(row, item, right_divisor)
            if item.right_axis {
                if val.gt(right_max) { right_max = val }
                if raw_series_value(row, item).gt(0) { has_right = true }
            } else {
                if val.gt(left_max) { left_max = val }
                if val.gt(0) { has_left = true }
            }
        }
    }
    left_max = round_axis_max(left_max)
    right_max = round_axis_max(right_max)

    mut svg := ""
    svg = format(svg, "<svg width=", qa(W.to_str()), " height=", qa(H.to_str()),
                        " xmlns=", qa("http://www.w3.org/2000/svg"), ">", NL)
    svg = format(svg, "<rect width=", qa(W.to_str()), " height=", qa(H.to_str()),
                        " fill=", qa(BG_COLOR), "/>", NL)

    svg = format(svg, svg_line(MARGIN_LEFT, MARGIN_TOP, MARGIN_LEFT,
                              MARGIN_TOP.add(CHART_H), AXIS_COLOR))
    svg = format(svg, svg_line(MARGIN_LEFT, MARGIN_TOP.add(CHART_H),
                              MARGIN_LEFT.add(CHART_W), MARGIN_TOP.add(CHART_H), AXIS_COLOR))
    if has_right {
        svg = format(svg, svg_line(MARGIN_LEFT.add(CHART_W), MARGIN_TOP,
                                  MARGIN_LEFT.add(CHART_W), MARGIN_TOP.add(CHART_H), AXIS_COLOR))
    }

    if show_y_labels {
        ym := MARGIN_TOP.add(CHART_H.div(2))
        if has_left {
            mid_val := left_max.div(2)
            lx := MARGIN_LEFT.sub(5)
            svg = format(svg, svg_text(lx, MARGIN_TOP.add(CHART_H).add(4), "end", 11, AXIS_COLOR, "0"))
            svg = format(svg, svg_text(lx, y_px(mid_val, left_max).add(4), "end", 11, AXIS_COLOR, mid_val.to_str()))
            svg = format(svg, svg_text(lx, MARGIN_TOP.add(4), "end", 11, AXIS_COLOR, left_max.to_str()))
            if left_unit.is_empty().not() {
                rot := format("rotate(-90 15 ", ym.to_str(), ")")
                svg = format(svg, "<text x=", qa("15"), " y=", qa(ym.to_str()),
                                    " text-anchor=", qa("middle"), " font-size=", qa("12"),
                                    " fill=", qa(AXIS_COLOR), " transform=", qa(rot),
                                    ">", left_unit, "</text>", NL)
            }
        }
        if has_right {
            rmid := right_max.div(2)
            rx := MARGIN_LEFT.add(CHART_W).add(5)
            svg = format(svg, svg_text(rx, MARGIN_TOP.add(CHART_H).add(4), "start", 11, AXIS_COLOR, "0"))
            svg = format(svg, svg_text(rx, y_px(rmid, right_max).add(4), "start", 11, AXIS_COLOR, rmid.to_str()))
            svg = format(svg, svg_text(rx, MARGIN_TOP.add(4), "start", 11, AXIS_COLOR, right_max.to_str()))
            if right_unit.is_empty().not() {
                rlabel_x := W.sub(15)
                rrot := format("rotate(90 ", rlabel_x.to_str(), " ", ym.to_str(), ")")
                svg = format(svg, "<text x=", qa(rlabel_x.to_str()), " y=", qa(ym.to_str()),
                                    " text-anchor=", qa("middle"), " font-size=", qa("12"),
                                    " fill=", qa(AXIS_COLOR), " transform=", qa(rrot),
                                    ">", right_unit, "</text>", NL)
            }
        }
    }

    if rows.len().gt(0) {
        mut si : USize = 0
        while si.lt(series.len()) {
            ref item : Series = series[si]
            if series_has_data(rows, item) {
                mut axis_max := left_max
                if item.right_axis { axis_max = right_max }
                svg = format(svg, svg_polyline(
                    build_points(rows, item, axis_max, right_divisor), item.color))
            }
            si++
        }

        mut ri : USize = 0
        while ri.lt(rows.len()) {
            ref row : Row = rows[ri]
            x := x_px(ri.to_i64(), rows.len().to_i64())
            si = 0
            while si.lt(series.len()) {
                ref item : Series = series[si]
                if series_has_data(rows, item) {
                    mut axis_max := left_max
                    if item.right_axis { axis_max = right_max }
                    y := y_px(display_series_value(row, item, right_divisor), axis_max)
                    svg = format(svg, svg_circle(x, y, 3, item.color))
                }
                si++
            }
            ri++
        }

        if show_x_labels {
            ri = 0
            while ri.lt(rows.len()) {
                ref row : Row = rows[ri]
                x := x_px(ri.to_i64(), rows.len().to_i64())
                svg = format(svg, svg_text(x, MARGIN_TOP.add(CHART_H).add(15),
                                          "middle", 10, X_LABEL_COLOR, row.label))
                ri++
            }
        }
    }

    ly := 20
    mut leg_total := 0
    for item : Series in series {
        if series_has_data(rows, item) {
            leg_total = leg_total.add(series_legend_width(item))
        }
    }
    mut lx_pos := W.sub(leg_total).div(2)
    if lx_pos.lt(MARGIN_LEFT) { lx_pos = MARGIN_LEFT }
    for item : Series in series {
        if series_has_data(rows, item) {
            svg = format(svg, svg_circle(lx_pos, ly, 4, item.color))
            svg = format(svg, svg_text(lx_pos.add(8), ly.add(4), "start", 12,
                                      item.color, item.label))
            lx_pos = lx_pos.add(series_legend_width(item))
        }
    }

    svg = svg.format("</svg>", NL)
    return svg
}

plot_csv := proc(csv_path: Str, svg_path: Str, specs: Vec(Str),
                 left_unit: Str = "", right_unit: Str = "",
                 right_divisor: I64 = 1, last_n: I64 = 0,
                 show_x_labels: Bool = true, show_y_labels: Bool = true) {
    content := File.readfile(csv_path)
    headers := parse_headers(content)
    series := resolve_series(specs, headers)
    all_rows := parse_csv(content)

    mut rows := Vec(Row).new()
    if last_n.gt(0) {
        last_n_us : USize = last_n.to_usize()
        mut start : USize = 0
        if all_rows.len().gt(last_n_us) {
            start = all_rows.len().sub(last_n_us)
        }
        mut i := start
        while i.lt(all_rows.len()) {
            ref row : Row = all_rows[i]
            rows.push(own row.clone())
            i++
        }
    } else {
        rows = all_rows
    }

    svg := generate_svg(rows, series, left_unit, right_unit, right_divisor,
                        show_x_labels, show_y_labels)
    File.writefile(svg_path, svg)
}

main := proc(args: ..Str) {
    if args.len().lt(2) {
        println("usage: plot <csv_path> <svg_output_path> [last_n]",
                " [--no-x-labels] [--left-unit unit] [--right-unit unit]",
                " [--right-divisor n] --series column:label:left|right ...")
        exit(1)
    }
    ref csv_path : Str = args[0]
    ref svg_path : Str = args[1]
    mut specs := Vec(Str).new()
    mut left_unit := ""
    mut right_unit := ""
    mut right_divisor := 1
    mut last_n := 0
    mut show_x := true
    mut i : USize = 2
    while i.lt(args.len()) {
        ref arg : Str = args[i]
        if arg.eq("--no-x-labels") {
            show_x = false
        } else if arg.eq("--series") {
            if i.add(1).eq(args.len()) { panic(__LOC__, "plot: --series needs a value") }
            i++
            specs.push(own args[i].clone())
        } else if arg.eq("--left-unit") {
            if i.add(1).eq(args.len()) { panic(__LOC__, "plot: --left-unit needs a value") }
            i++
            left_unit = args[i].clone()
        } else if arg.eq("--right-unit") {
            if i.add(1).eq(args.len()) { panic(__LOC__, "plot: --right-unit needs a value") }
            i++
            right_unit = args[i].clone()
        } else if arg.eq("--right-divisor") {
            if i.add(1).eq(args.len()) { panic(__LOC__, "plot: --right-divisor needs a value") }
            i++
            right_divisor = args[i].to_i64()
            if right_divisor.lte(0) { panic(__LOC__, "plot: --right-divisor must be positive") }
        } else if arg.starts_with("--") {
            panic(__LOC__, "plot: unknown option '", arg, "'")
        } else {
            last_n = arg.to_i64()
        }
        i++
    }
    if specs.len().eq(0) { panic(__LOC__, "plot: at least one --series is required") }
    plot_csv(csv_path, svg_path, specs, left_unit, right_unit,
             right_divisor, last_n, show_x_labels=show_x)
}
