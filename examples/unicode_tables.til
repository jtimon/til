mode cli
import("std/sys")
import("std/file")

// Regeneration only; ordinary builds/tests use the checked-in output offline.
fetch := proc(path: Str) returns Str {
    cmd := Cmd.new("curl", "--fail", "--silent", "--show-error", "--location", format("https://www.unicode.org/Public/17.0.0/ucd/", path))
    cmd.capture_out(); cmd.run_checked(); return cmd.out()
}
UnicodeRange := struct {
    first : I64; last : I64; value : I64
namespace:
    cmp := func(a: UnicodeRange, b: UnicodeRange) returns I64 { return a.first.cmp(b.first) }
}
hex := func(text: Str) returns I64 {
    mut result : I64 = 0
    for i in 0..text.len() {
        digit := "0123456789ABCDEF".find(text.substr(i, 1)); assert(digit >= 0)
        result = result * 16 + digit
    }
    return result
}
tree := func(ranges: Vec(UnicodeRange), lo: USize, hi: USize, indent: Str) returns Str {
    if lo == hi { return format(indent, "return 0\n") }
    mid := lo + (hi - lo) / 2
    ref range : UnicodeRange = ranges[mid]
    return format(indent, "if code < ", range.first.to_str(), " {\n", tree(ranges, lo, mid, format(indent, "    ")),
        indent, "} else if code <= ", range.last.to_str(), " { return ", range.value.to_str(), " } else {\n",
        tree(ranges, mid + 1, hi, format(indent, "    ")), indent, "}\n")
}
table := func(source: Str, name: Str, properties: Vec(Str), field: USize = 1) returns Str {
    mut sorted := Set(UnicodeRange).new()
    for line : Str in source.split("\n") {
        comments := line.split("#")
        body := comments[0].trim()
        if body.len() == 0 { continue }
        parts := body.split(";")
        if parts.len() <= field { continue }
        if field == 2 { if parts[1].trim() != "InCB" { continue } }
        property := parts[field].trim()
        for index in 0..properties.len() {
            if property != properties[index] { continue }
            range := parts[0].trim().split("..")
            first := hex(range[0]); mut last := first
            if range.len() == 2 { last = hex(range[1]) }
            sorted.add(own UnicodeRange(first = first, last = last, value = (index + 1).to_i64()))
        }
    }
    if sorted.len() == 0 { panic("no properties parsed for ", name) }
    mut ranges := Vec(UnicodeRange).new()
    for range : UnicodeRange in sorted {
        if ranges.len() > 0 {
            ref mut last : UnicodeRange = ranges[ranges.len() - 1]
            assert(last.last < range.first)
            if last.last + 1 == range.first && last.value == range.value { last.last = range.last; continue }
        }
        ranges.push(own range.clone())
    }
    return format(name, " := func(code: I64) returns I64 {\n", tree(ranges, 0, ranges.len(), "    "), "}\n")
}
main := proc() {
    gcb := fetch("auxiliary/GraphemeBreakProperty.txt")
    emoji := fetch("emoji/emoji-data.txt")
    derived := fetch("DerivedCoreProperties.txt")
    tests := fetch("auxiliary/GraphemeBreakTest.txt")
    File.writefile("tmp/unicode-gcb.txt", gcb)
    File.writefile("tmp/unicode-emoji.txt", emoji)
    File.writefile("tmp/unicode-derived.txt", derived)
    assert(gcb.contains("GraphemeBreakProperty-17.0.0") && tests.contains("GraphemeBreakTest-17.0.0"))
    properties := array(Str, "CR", "LF", "Control", "Extend", "ZWJ", "Regional_Indicator", "Prepend", "SpacingMark", "L", "V", "T", "LV", "LVT")
    mut names := Vec(Str).new(); for name : Str in properties { names.push(own name.clone()) }
    mut ep := Vec(Str).new(); ep.push(own "Extended_Pictographic")
    mut incb := Vec(Str).new(); incb.push(own "Consonant"); incb.push(own "Extend"); incb.push(own "Linker")
    mut ignorable := Vec(Str).new(); ignorable.push(own "Default_Ignorable_Code_Point")
    output := format("mode lib\n// Generated by examples/unicode_tables.til from Unicode 17.0.0.\n",
        "// Copyright (c) 2025 Unicode, Inc. See LICENSE/unicode.txt in the Til SDK root (Unicode License v3).\n",
        table(gcb, "unicode_grapheme_property", names), table(emoji, "unicode_pictographic", ep), table(derived, "unicode_incb", incb, 2), table(derived, "unicode_ignorable", ignorable))
    File.writefile("src/std/unicode/grapheme_data.til", output)
    // Preserve every case and notice, normalizing only surrounding whitespace.
    mut fixture := ""
    for line : Str in tests.trim().split("\n") { fixture = format(fixture, line.trim(), "\n") }
    File.writefile("test/unicode_grapheme_cases.txt", fixture)
    println("Generated Unicode 17.0.0 properties and grapheme conformance cases")
}
