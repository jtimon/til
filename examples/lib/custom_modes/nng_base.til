import("../../../vendor/bindings/nng")
// Each target links its own nng build (issue #422): bin/make builds
// vendor/nng/build-<target>/libnng.a for every target the server modes
// list in examples/custom_modes.til, and the mode's build_hint names it.
link("vendor/nng/build-linux-x64/libnng.a", "linux-x64")
link("vendor/nng/build-linux-arm64/libnng.a", "linux-arm64")
link("vendor/nng/build-linux-riscv64/libnng.a", "linux-riscv64")
link("vendor/nng/build-linux-x86/libnng.a", "linux-x86")
link("vendor/nng/build-linux-arm32/libnng.a", "linux-arm32")
link("vendor/nng/build-linux-riscv32/libnng.a", "linux-riscv32")
link("vendor/nng/build-windows-x64/libnng.a", "windows-x64")
link("vendor/nng/build-windows-x86/libnng.a", "windows-x86")
link("vendor/nng/build-macos-x64/libnng.a", "macos-x64")
link("vendor/nng/build-macos-arm64/libnng.a", "macos-arm64")
// nng on windows calls winsock. Built against msvcrt, NOT the UCRT: a
// -lucrtbase here would pull ucrtbase.dll in beside mingw's msvcrt.dll
// startup, and that dual-CRT binary fails to load on real Windows (issue
// #25); ext.c supplies the one missing C11 function, timespec_get.
link("ws2_32", "windows-x64 windows-x86")
link("mswsock", "windows-x64 windows-x86")
link("advapi32", "windows-x64 windows-x86")
link("pthread")
link("atomic")

// Read a NUL-terminated C nng_recv_buffer into an owned til Str.
read_cstr := func(p: Dynamic) returns Str {
    mut n : USize = 0
    while true {
        ref b : I8 = ptr_add(p, n.to_uptr())
        if b.eq(0) { break }
        n++
    }
    ref start : I8 = ptr_add(p, 0)
    view := Str(c_str = start, count = n, cap = CAP_VIEW)
    return view.clone()
}

// Abort with the nng error string if rc is non-zero.
check := proc(rc: I32, what: Str) {
    if rc.eq(0) { return }
    ref msg : I8 = nng_strerror(rc)
    println(format(what, ": ", read_cstr(msg)))
    panic("nng call failed")
}
