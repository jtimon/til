import("../../../vendor/bindings/nng")
// Each target links its own nng build (issues #422, #486): bin/make builds
// vendor/nng/build-<target>/libnng.a for every target the server modes list
// in examples/custom_modes.til, and the mode's build_hint names it. Then the
// system libraries nng calls into. On windows that is winsock. Built against
// msvcrt, NOT the UCRT: a -lucrtbase here would pull ucrtbase.dll in beside
// mingw's msvcrt.dll startup, and that dual-CRT binary fails to load on real
// Windows (issue #25); ext.c supplies the one missing C11 function,
// timespec_get. macOS needs nothing beyond libSystem.
switch TARGET_OS {
case .Linux:
    switch TARGET_ARCH {
    case .X64: link("vendor/nng/build-linux-x64/libnng.a")
    case .Arm64: link("vendor/nng/build-linux-arm64/libnng.a")
    case .Riscv64: link("vendor/nng/build-linux-riscv64/libnng.a")
    case .X86: link("vendor/nng/build-linux-x86/libnng.a")
    case .Arm32: link("vendor/nng/build-linux-arm32/libnng.a")
    case .Riscv32: link("vendor/nng/build-linux-riscv32/libnng.a")
    case:
    }
    link("pthread")
    link("atomic")
case .Windows:
    switch TARGET_ARCH {
    case .X64: link("vendor/nng/build-windows-x64/libnng.a")
    case .X86: link("vendor/nng/build-windows-x86/libnng.a")
    case:
    }
    link("ws2_32")
    link("mswsock")
    link("advapi32")
case .Macos:
    switch TARGET_ARCH {
    case .X64: link("vendor/nng/build-macos-x64/libnng.a")
    case .Arm64: link("vendor/nng/build-macos-arm64/libnng.a")
    case:
    }
case:
}

// Read a NUL-terminated C string (nng's own, such as nng_version() and
// nng_strerror(), or a recv buffer) into an owned til Str. Through
// Str.from_c_str, never a hand-built view: a Str's c_str is an own field,
// and under the cage (#313) it cannot hold a pointer into nng's image --
// the first real-winsock run died on nng_version() with "an own pointer
// outside the cage cannot be compressed". from_c_str copies there.
read_cstr := func(p: Dynamic) returns Str {
    return Str.from_c_str(p).clone()
}

// Abort with the nng error string if rc is non-zero.
check := proc(rc: I32, what: Str) {
    if rc.eq(0) { return }
    ref msg : I8 = nng_strerror(rc)
    println(format(what, ": ", read_cstr(msg)))
    panic("nng call failed")
}
