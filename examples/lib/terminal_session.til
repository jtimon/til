mode lib

link_c("examples/lib/terminal_session.c")

terminal_session_new := ext_proc() returns ref Dynamic {}
terminal_session_arg := ext_proc(handle: Dynamic, arg: Str) {}
terminal_session_start := ext_proc(handle: Dynamic, shallow columns: I64, shallow rows: I64) {}
terminal_session_send := ext_proc(handle: Dynamic, bytes: Str) returns shallow Bool {}
terminal_session_pump := ext_proc(handle: Dynamic) returns Str {}
terminal_session_state := ext_proc(handle: Dynamic) returns shallow I64 {}
terminal_session_status := ext_proc(handle: Dynamic) returns shallow I64 {}
terminal_session_error := ext_proc(handle: Dynamic) returns Str {}
terminal_session_resize := ext_proc(handle: Dynamic, shallow columns: I64, shallow rows: I64) {}
terminal_session_close := ext_proc(handle: Dynamic) {}
terminal_session_free := ext_func(handle: Dynamic) {}

TerminalSession := struct {
    ref handle : U8
namespace:
    new := proc(args: ..Str) returns TerminalSession {
        ref handle : Dynamic = terminal_session_new()
        s := TerminalSession(handle = handle)
        for arg in args { s.arg(arg) }
        return s
    }
    check := proc(s: TerminalSession) {
        error := terminal_session_error(s.handle)
        if error.len() > 0 { panic("tilminal: ", error) }
    }
    arg := proc(s: TerminalSession, arg: Str) { terminal_session_arg(s.handle, arg); s.check() }
    start := proc(s: TerminalSession, columns: I64, rows: I64) {
        terminal_session_start(s.handle, columns, rows); s.check()
    }
    // False means a normal child exit raced the caller's input event.
    send := proc(s: TerminalSession, bytes: Str) returns Bool {
        accepted := terminal_session_send(s.handle, bytes); s.check(); return accepted
    }
    pump := proc(s: TerminalSession) returns Str {
        bytes := terminal_session_pump(s.handle); s.check(); return bytes
    }
    // 0 configured, 1 running, 2 draining final output, 3 exited, 4 closed.
    state := proc(s: TerminalSession) returns I64 { return terminal_session_state(s.handle) }
    status := proc(s: TerminalSession) returns I64 {
        status := terminal_session_status(s.handle); s.check(); return status
    }
    resize := proc(s: TerminalSession, columns: I64, rows: I64) {
        terminal_session_resize(s.handle, columns, rows); s.check()
    }
    close := proc(s: TerminalSession) { terminal_session_close(s.handle); s.check() }
    clone := func(s: TerminalSession) returns TerminalSession {
        panic("TerminalSession cannot be cloned")
        return TerminalSession(handle = s.handle)
    }
    delete := func(own s: TerminalSession, call_free: Bool = true) {
        terminal_session_free(s.handle)
        if call_free { free(own s) }
    }
}
