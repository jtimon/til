terminal_byte := func(n: I64) returns Str { return Str.from_byte(n.to_u8()) }
terminal_escape := func(s: Str) returns Str { return format(terminal_byte(27), s) }
terminal_utf8 := func(c: I64) returns Str {
    if c < 0 || c > 0x10ffff || (c >= 0xd800 && c <= 0xdfff) { panic("invalid Unicode scalar") }
    if c < 128 { return terminal_byte(c) }
    if c < 2048 { return format(terminal_byte(192 + c / 64), terminal_byte(128 + c.mod(64))) }
    if c < 65536 { return format(terminal_byte(224 + c / 4096), terminal_byte(128 + (c / 64).mod(64)), terminal_byte(128 + c.mod(64))) }
    return format(terminal_byte(240 + c / 262144), terminal_byte(128 + (c / 4096).mod(64)), terminal_byte(128 + (c / 64).mod(64)), terminal_byte(128 + c.mod(64)))
}

// Decode one scalar. -1 means incomplete input (unless final); malformed
// sequences consume their valid prefix, leaving the next starter untouched.
terminal_decode := func(s: Str, mut pos: USize, final: Bool = false) returns I64 {
    if pos >= s.len() { return -1 }
    first := s[pos].cast(U8).to_i64()
    if first < 128 { pos++; return first }
    mut count : USize = 0
    mut value : I64 = 0
    mut minimum : I64 = 0
    if first >= 194 && first <= 223 { count = 2; value = first - 192; minimum = 128 }
    if first >= 224 && first <= 239 { count = 3; value = first - 224; minimum = 2048 }
    if first >= 240 && first <= 244 { count = 4; value = first - 240; minimum = 65536 }
    if count == 0 { pos++; return 0xfffd }
    mut i : USize = 1
    while i < count {
        if pos + i >= s.len() {
            if final { pos = s.len(); return 0xfffd }
            return -1
        }
        b := s[pos + i].cast(U8).to_i64()
        if b < 128 || b > 191 { pos = pos + i; return 0xfffd }
        if i == 1 && ((first == 224 && b < 160) || (first == 237 && b > 159) || (first == 240 && b < 144) || (first == 244 && b > 143)) {
            pos++; return 0xfffd
        }
        value = value * 64 + b - 128
        i++
    }
    pos = pos + count
    if value < minimum || value > 0x10ffff || (value >= 0xd800 && value <= 0xdfff) { return 0xfffd }
    return value
}
